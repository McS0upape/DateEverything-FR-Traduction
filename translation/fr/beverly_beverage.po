#: beverly_beverage/beverly_hate_return/0/c-2/25/g-0/24/g-0/0
msgctxt "Beverly"
msgid "That's a good drink."
msgstr ""

#: beverly_beverage/beverly_hate_return/0/c-2/25/g-0/24/g-0/8
msgctxt "Beverly"
msgid "All right, you. You're forgiven."
