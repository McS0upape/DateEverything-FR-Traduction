# Traduction IA – à relire
#: holly_holidays/1
msgctxt "Tag Nom d'objet (MAJUSCULES)"
msgid "HOLIDAY DECORATIONS"
msgstr "DÉCORATIONS DE FÊTES"

# Traduction IA – à relire
#: holly_holidays/holly1B/0/0
msgctxt "Holly"
msgid "Oh."
msgstr "Oh."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/8
msgctxt "Holly"
msgid "You came!"
msgstr "Tu es {{venu|venue|venu·e}} !"

# Traduction IA – à relire
#: holly_holidays/holly1B/0/16/s/0
msgctxt "Choix"
msgid "I said I would."
msgstr "J'avais dit que je viendrais."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/17/s/0
msgctxt "Choix"
msgid "Did you think I wouldn't?"
msgstr "Tu pensais que je ne viendrais pas ?"

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-0/0
msgctxt "Holly"
msgid "Well it's not that I didn't think that you would. It's just... I've got a tricky schedule."
msgstr "Eh bien ce n'est pas que je ne le pensais pas. C'est juste que... j'ai un emploi du temps compliqué."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-0/8
msgctxt "Holly"
msgid "So..."
msgstr "Donc..."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-0/16
msgctxt "Holly"
msgid "It's easier to presume that people have to cancel."
msgstr "C'est plus simple de partir du principe que les gens vont annuler."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-0/24
msgctxt "Holly"
msgid "Or they'll forget."
msgstr "Ou oublier."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-0/32
msgctxt "Holly"
msgid "Or they'll just... have their own lives."
msgstr "Ou tout simplement... avoir leur propre vie."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-0/48
msgctxt "Holly"
msgid "Which is me. I'm \"people\"."
msgstr "Ce qui, c'est moi. Les « gens », c'est moi."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-0/56
msgctxt "Holly"
msgid "I cancel or forget or I have my own life."
msgstr "J'annule, j'oublie, ou j'ai ma propre vie."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-0/64/s/0
msgctxt "Choix"
msgid "You're here now."
msgstr "Tu es là maintenant."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-0/65/s/0
msgctxt "Choix"
msgid "You seem kinda hard on yourself."
msgstr "Tu as l'air un peu dure avec toi-même."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-0/66/s/0
msgctxt "Choix"
msgid "So you're a bit flakey?"
msgstr "Donc tu poses des lapins de temps en temps ?"

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-0/c-2/7
msgctxt "Holly"
msgid "I know. Crazy right? Blissmas miracle. Is it Blissmas?"
msgstr "Je sais, hein ? Dingue ! Un miracle de Blissmas. On est à Blissmas ?"

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-0/c-2/15/0/s/0
msgctxt "Choix"
msgid "No."
msgstr "Non."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-0/c-2/15/1/s/0
msgctxt "Choix"
msgid "Yes."
msgstr "Oui."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-0/c-2/15/2/s/0
msgctxt "Choix"
msgid "Nearly."
msgstr "Presque."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-0/c-2/15/c-0/7
msgctxt "Holly"
msgid "Damn. Just lucky then."
msgstr "Zut. Alors juste de la chance."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-0/c-2/15/c-1/7
msgctxt "Holly"
msgid "See!"
msgstr "Tu vois !"

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-0/c-2/15/c-2/7
msgctxt "Holly"
msgid "Exactly!"
msgstr "Exactement !"

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-0/c-3/7
msgctxt "Holly"
msgid "I'm just realistic."
msgstr "Je suis juste réaliste."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-0/c-4/7
msgctxt "Holly"
msgid "A little. I try not to be. But I've never been good at that. \"Trying not to be.\""
msgstr "Un peu. J'essaie de ne pas l'être. Mais je n'ai jamais été douée pour ça. « Essayer de ne pas l'être. »"

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-1/0/s/0
msgctxt "Choix"
msgid "Did work go okay?"
msgstr "Le boulot s'est bien passé ?"

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-1/1/s/0
msgctxt "Choix"
msgid "What was the gig?"
msgstr "C'était quoi, le contrat ?"

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-1/c-5/7
msgctxt "Holly"
msgid "Yeah! It was great!"
msgstr "Ouais ! C'était génial !"

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-1/c-5/23
msgctxt "Holly"
msgid "Wait you said okay, right?"
msgstr "Attends, tu as dit « bien », hein ?"

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-1/c-5/31
msgctxt "Holly"
msgid "Yeah... it was okay."
msgstr "Ouais... c'était correct."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-1/c-6/7
msgctxt "Holly"
msgid "The gig... was..."
msgstr "Le contrat... c'était..."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-2/0
msgctxt "Holly"
msgid "Hard. Underpaid. Fun. Just a local fete. My favourite kind. The little ones."
msgstr "Dur. Mal payé. Marrant. Juste une kermesse du coin. Mon genre préféré. Les petites."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-2/8
msgctxt "Holly"
msgid "<w>Yawn.</w>"
msgstr "<w>Bâillement.</w>"

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-2/16
msgctxt "Holly"
msgid "Sorry. It's not you."
msgstr "Pardon. C'est pas toi."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-2/24/s/0
msgctxt "Choix"
msgid "Tired?"
msgstr "Fatiguée ?"

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-2/25/s/0
msgctxt "Choix"
msgid "Bored?"
msgstr "Tu t'ennuies ?"

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-2/c-7/7
msgctxt "Holly"
msgid "A little. But who isn't?"
msgstr "Un peu. Mais qui ne l'est pas ?"

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-2/c-8/7
msgctxt "Holly"
msgid "No! No! Not at all!"
msgstr "Non ! Non ! Pas du tout !"

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-2/c-8/18
msgctxt "Holly"
msgid "That was a joke, right?"
msgstr "C'était une blague, hein ?"

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-2/c-8/26/0/s/0
msgctxt "Choix"
msgid "No. I'm deeply offended."
msgstr "Non. Je suis {{profondément vexé|profondément vexée|profondément vexé·e}}."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-2/c-8/26/1/s/0
msgctxt "Choix"
msgid "Obviously."
msgstr "Évidemment."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-2/c-8/26/c-0/7
msgctxt "Holly"
msgid "Well that's silly. Silly season."
msgstr "Mais c'est idiot, ça. Période idiote."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-2/c-8/26/c-1/7
msgctxt "Holly"
msgid "HAHAHA! Woke me right up."
msgstr "HAHAHA ! Ça m'a réveillée d'un coup."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-3/0
msgctxt "Holly"
msgid "I, uhh. Usually when I finish a shift most of the others are asleep. I never really get to talk about my work so... it's strange."
msgstr "Je, euh. D'habitude, quand je finis mon service, la plupart des autres dorment. Je n'ai jamais vraiment l'occasion de parler de mon travail, alors... c'est bizarre."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-3/8
msgctxt "Holly"
msgid "It's nice."
msgstr "C'est agréable."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-3/16
msgctxt "Holly"
msgid "The shift wasn't, but this is."
msgstr "Le service ne l'était pas, mais ça, si."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-3/24/s/0
msgctxt "Choix"
msgid "Why do you work so much?"
msgstr "Pourquoi tu travailles autant ?"

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-3/25/s/0
msgctxt "Choix"
msgid "Happy to help."
msgstr "Avec plaisir."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-3/c-9/7
msgctxt "Holly"
msgid "Someone has to. It's my job. It's always a holiday somewhere and someone has to do the work to bring the wonder to everyone else."
msgstr "Il faut bien que quelqu'un le fasse. C'est mon boulot. C'est toujours la fête quelque part, et il faut bien que quelqu'un s'occupe d'apporter la magie à tous les autres."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-3/c-10/7
msgctxt "Holly"
msgid "Happy to be helped. Nice change of pace."
msgstr "Ravie qu'on m'aide. Ça change."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-4/0
msgctxt "Holly"
msgid "I'm a helper, most of the time."
msgstr "Je suis une aidante, la plupart du temps."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-4/8
msgctxt "Holly"
msgid "\"Essential\"... so they say."
msgstr "« Essentielle »... à ce qu'on dit."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-4/16 holly_holidays/holly_office/0/g-5/c-15/7
msgctxt "Holly"
msgid "Sometimes."
msgstr "Parfois."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-4/24
msgctxt "Holly"
msgid "When it's useful to say so."
msgstr "Quand ça arrange de le dire."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-4/32
msgctxt "Holly"
msgid "<i>Yawn.</i>"
msgstr "<i>Bâillement.</i>"

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-4/40
msgctxt "Holly"
msgid "Sorry."
msgstr "Pardon."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-4/48
msgctxt "Holly"
msgid "Here I am complaining I never have anyone to talk to, and now I'm yawning in your face."
msgstr "Me voilà à me plaindre de n'avoir personne à qui parler, et je te bâille au nez."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-4/56
msgctxt "Holly"
msgid "I guess I should knock off. I've got a shift in the morning. But thanks... I really appreciate it."
msgstr "Je crois que je ferais mieux de débaucher. J'ai un service demain matin. Mais merci... vraiment."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-4/64/s/0
msgctxt "Choix"
msgid "Get some rest."
msgstr "Repose-toi bien."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-4/65/s/0
msgctxt "Choix"
msgid "See you next time."
msgstr "À la prochaine."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-4/c-11/7
msgctxt "Holly"
msgid "NO! You get some rest..."
msgstr "NON ! Repose-TOI bien..."

# Traduction IA – à relire
#: holly_holidays/holly1B/0/g-4/c-12/7 holly_holidays/hollyreturnhate/0/c-1/69/c-0/55
msgctxt "Holly"
msgid "Happy holidays."
msgstr "Joyeuses fêtes."

# Traduction IA – à relire
#: holly_holidays/holly2_fail/0
msgctxt "Holly"
msgid "I'm not here right now! Work work work!"
msgstr "Je ne suis pas là en ce moment ! Boulot boulot boulot !"

# Traduction IA – à relire
#: holly_holidays/holly2_fail/11
msgctxt "Holly"
msgid "If you see me, that's not really me - it is an <w>ILLUSION!</w>"
msgstr "Si tu me vois, ce n'est pas vraiment moi, c'est une <w>ILLUSION !</w>"

# Traduction IA – à relire
#: holly_holidays/holly2_fail/19
msgctxt "Holly"
msgid "I'm free in the morning if you want to chat!"
msgstr "Je suis libre demain matin si tu veux discuter !"

# Traduction IA – à relire
#: holly_holidays/holly2_fail/27
msgctxt "Holly"
msgid "<w>ILLUSION AWAY!</w>"
msgstr "<w>ILLUSION, DISPARAIS !</w>"

# Traduction IA – à relire
#: holly_holidays/hollyshipsinthenightshift/0/0
msgctxt "Holly"
msgid "HEY! Sorry I missed you the other day. I picked up another double for Venetian's day, but I'm free tomorrow morning if you wanna swing by? I'd stay and chat now but I've gotta bounce for a Gleester in July gig."
msgstr "HÉ ! Désolée de t'avoir ratée l'autre jour. J'ai pris un double pour la Saint-Vénitien, mais je suis libre demain matin si tu veux passer ? Je resterais discuter là, mais je dois filer pour un contrat de Gleester en juillet."

# Traduction IA – à relire
#: holly_holidays/hollyshipsinthenightshift/0/8/s/0
msgctxt "Choix"
msgid "Best be hoppin."
msgstr "Faut sauter, alors."

# Traduction IA – à relire
#: holly_holidays/hollyshipsinthenightshift/0/9/s/0
msgctxt "Choix"
msgid "I'll try!"
msgstr "J'essaierai !"

# Traduction IA – à relire
#: holly_holidays/hollyshipsinthenightshift/0/10/s/0
msgctxt "Choix"
msgid "You work a lot."
msgstr "Tu travailles beaucoup."

# Traduction IA – à relire
#: holly_holidays/hollyshipsinthenightshift/0/11/s/0
msgctxt "Choix"
msgid "Have an eggcelent time!"
msgstr "Passe un moment oeuf-ficace !"

# Traduction IA – à relire
#: holly_holidays/hollyshipsinthenightshift/0/c-0/7
msgctxt "Holly"
msgid "Officer Bounce, bounding off! <w>BYEEEE!</w> Bye, bye, byyyeee!!!"
msgstr "Agent Rebond, je rebondis ! <w>BYEEEE !</w> Bye, bye, byyyeee !!!"

# Traduction IA – à relire
#: holly_holidays/hollyshipsinthenightshift/0/c-1/7
msgctxt "Holly"
msgid "Sorry my schedule's so haywire! <w>BYEEEE!</w>"
msgstr "Désolée que mon emploi du temps soit si détraqué ! <w>BYEEEE !</w>"

# Traduction IA – à relire
#: holly_holidays/hollyshipsinthenightshift/0/c-2/7
msgctxt "Holly"
msgid "<w>I KNOW RIGHT!? BYEEEE!</w>"
msgstr "<w>JE SAIS, HEIN !? BYEEEE !</w>"

# Traduction IA – à relire
#: holly_holidays/hollyshipsinthenightshift/0/c-3/7
msgctxt "Holly"
msgid "Huh? ...OH! EGG! That was funny! Okayy. <w>BYEEEE!</w>"
msgstr "Hein ? ...OH ! OEUF ! C'était drôle ! Okayy. <w>BYEEEE !</w>"

# Traduction IA – à relire
#: holly_holidays/holly1/0/6
msgctxt "Narrator"
msgid "It takes you just a moment to properly evaluate the figure standing before you—her hair and clothing are such a jumble of various holiday decorations it throws you."
msgstr "Il vous faut un instant pour bien évaluer la silhouette qui se tient devant vous : ses cheveux et ses vêtements sont un tel fouillis de décorations de fêtes en tout genre que vous en perdez vos repères."

# Traduction IA – à relire
#: holly_holidays/holly1/0/14
msgctxt "Narrator"
msgid "What time of year is it again? Have you truly been locked in your house for so long that time has lost all meaning?"
msgstr "En quelle saison est-on, déjà ? Êtes-vous vraiment {{enfermé|enfermée|enfermé·e}} chez vous depuis si longtemps que le temps a perdu tout sens ?"

# Traduction IA – à relire
#: holly_holidays/holly1/0/22
msgctxt "Narrator"
msgid "She is adorable though, and her energetic greeting shocks you right out of your quiet contemplation."
msgstr "Elle est adorable, cela dit, et son salut énergique vous arrache d'un coup à votre contemplation tranquille."

# Traduction IA – à relire
#: holly_holidays/holly1/0/30
msgctxt "Holly"
msgid "HEY BOSS. You've caught me at a bad time. Heading to work. The other work. Or is it the other other work? What day IS it anyway?"
msgstr "HÉ CHEF. Tu tombes mal. Je file au boulot. L'autre boulot. Ou c'est l'autre autre boulot ? On est quel jour, déjà ?"

# Traduction IA – à relire
#: holly_holidays/holly1/0/38
msgctxt "Holly"
msgid "Oh! What's up? What do you need?"
msgstr "Oh ! Quoi de neuf ? Qu'est-ce qu'il te faut ?"

# Traduction IA – à relire
#: holly_holidays/holly1/0/46/s/0
msgctxt "Choix"
msgid "I can come back later?"
msgstr "Je peux repasser plus tard ?"

# Traduction IA – à relire
#: holly_holidays/holly1/0/47/s/0
msgctxt "Choix"
msgid "Just wanted to introduce myself."
msgstr "Je voulais juste me présenter."

# Traduction IA – à relire
#: holly_holidays/holly1/0/c-0/7
msgctxt "Holly"
msgid "Oh you're so sweet! I'm working a double though... and then I'm opening tomorow..."
msgstr "Oh, c'est trop gentil ! Mais je fais un double... et après j'ouvre demain..."

# Traduction IA – à relire
#: holly_holidays/holly1/0/c-1/7
msgctxt "Holly"
msgid "AND I TO YOU! So many things and so little time. Makes you wanna cry cry cry."
msgstr "ET MOI DE MÊME ! Tant de choses et si peu de temps. Ça donne envie de pleurer pleurer pleurer."

# Traduction IA – à relire
#: holly_holidays/holly1/0/c-1/15
msgctxt "Holly"
msgid "That was bad. HAHA."
msgstr "C'était nul. HAHA."

# Traduction IA – à relire
#: holly_holidays/holly1/0/g-0/0
msgctxt "Holly"
msgid "I'm Holly by the way!"
msgstr "Moi, c'est Holly, au fait !"

# Traduction IA – à relire
#: holly_holidays/holly1/0/g-0/19
msgctxt "Holly"
msgid "OH. And who are you? Did you already say? Sorry."
msgstr "OH. Et toi, qui es-tu ? Tu l'as déjà dit ? Pardon."

# Traduction IA – à relire
#: holly_holidays/holly1/0/g-0/27
msgctxt "Holly"
msgid "In a little rish rash rush for the dish dash dosh. Rat race, all that."
msgstr "Je suis dans un petit tourni-tourna-tourbillon pour le pèse-pèze-pognon. La course de rats, tout ça."

# Traduction IA – à relire
#: holly_holidays/holly1/0/g-0/35/s/0
msgctxt "Choix"
msgid "I'm"
msgstr "Moi, c'est"

# Traduction IA – à relire
#: holly_holidays/holly1/0/g-0/36/s/0
msgctxt "Choix"
msgid "I own the house."
msgstr "C'est ma maison."

# Traduction IA – à relire
#: holly_holidays/holly1/0/g-0/37/s/0
msgctxt "Choix"
msgid "I'm Holly!"
msgstr "Moi, c'est Holly !"

# Traduction IA – à relire
#: holly_holidays/holly1/0/g-0/c-2/7
msgctxt "Holly"
msgid "OH! I've heard about you! That is such a funny name!"
msgstr "OH ! On m'a parlé de toi ! Quel nom rigolo !"

# Traduction IA – à relire
#: holly_holidays/holly1/0/g-0/c-3/7
msgctxt "Holly"
msgid "Oh... the boss of my boss!"
msgstr "Oh... le chef de mon chef !"

# Traduction IA – à relire
#: holly_holidays/holly1/0/g-0/c-3/15
msgctxt "Holly"
msgid "You're Big Boss!"
msgstr "Tu es le Grand Chef !"

# Traduction IA – à relire
#: holly_holidays/holly1/0/g-0/c-3/23 holly_holidays/holly1/0/g-0/c-4/18
msgctxt "Holly"
msgid "I've heard about you!"
msgstr "On m'a parlé de toi !"

# Traduction IA – à relire
#: holly_holidays/holly1/0/g-0/c-4/7
msgctxt "Holly"
msgid "Twinning!"
msgstr "Jumelage !"

# Traduction IA – à relire
#: holly_holidays/holly1/0/g-1/0/s/0
msgctxt "Choix"
msgid "From who?"
msgstr "Qui ça ?"

# Traduction IA – à relire
#: holly_holidays/holly1/0/g-1/1/s/0
msgctxt "Choix"
msgid "What have you heard?"
msgstr "Qu'est-ce qu'on t'a dit ?"

# Traduction IA – à relire
#: holly_holidays/holly1/0/g-1/2/s/0
msgctxt "Choix"
msgid "That sounds foreboding."
msgstr "Ça sonne comme un mauvais présage."

# Traduction IA – à relire
#: holly_holidays/holly1/0/g-1/c-5/7
msgctxt "Holly"
msgid "From everyone! I'm social butter, so they say."
msgstr "De tout le monde ! Je suis une chenille sociale, qu'ils disent."

# Traduction IA – à relire
#: holly_holidays/holly1/0/g-1/c-5/15/0/s/0
msgctxt "Choix"
msgid "A social butterfly?"
msgstr "Un papillon social ?"

# Traduction IA – à relire
#: holly_holidays/holly1/0/g-1/c-5/15/1/s/0
msgctxt "Choix"
msgid "Butter, but social?"
msgstr "Une chenille, mais sociale ?"

# Traduction IA – à relire
#: holly_holidays/holly1/0/g-1/c-5/15/2/s/0
msgctxt "Choix"
msgid "That makes sense."
msgstr "Ça se tient."

# Traduction IA – à relire
#: holly_holidays/holly1/0/g-1/c-5/15/c-0/7
msgctxt "Holly"
msgid "OH! That makes more sense..."
msgstr "OH ! Ça a plus de sens, comme ça..."

# Traduction IA – à relire
#: holly_holidays/holly1/0/g-1/c-5/15/c-1/7
msgctxt "Holly"
msgid "Yeah... I don't really get it either, truth be told. But it seems like a compliment when they say it."
msgstr "Ouais... moi non plus je ne comprends pas trop, à vrai dire. Mais ils ont l'air de le dire comme un compliment."

# Traduction IA – à relire
#: holly_holidays/holly1/0/g-1/c-5/15/c-2/7
msgctxt "Holly"
msgid "Does it? I could never figure it out."
msgstr "Tu trouves ? Je n'ai jamais réussi à comprendre."

# Traduction IA – à relire
#: holly_holidays/holly1/0/g-1/c-6/7
msgctxt "Holly"
msgid "Just some tidbits!"
msgstr "Juste des bribes !"

# Traduction IA – à relire
#: holly_holidays/holly1/0/g-1/c-7/7
msgctxt "Holly"
msgid "OH nothing like that!"
msgstr "OH rien de tel !"

# Traduction IA – à relire
#: holly_holidays/holly1/0/g-2/0
msgctxt "Holly"
msgid "Anywho, I'm so sorry, but I'm already running late. Love to chat more, though. I'm working a double in opening/closing tomorrow, but swing by first thing in the morning?"
msgstr "Enfin bref, je suis vraiment désolée, mais je suis déjà en retard. J'adorerais discuter plus longtemps. Je fais un double ouverture/fermeture demain, mais passe à la première heure ?"

# Traduction IA – à relire
#: holly_holidays/holly1/0/g-2/8
msgctxt "Holly"
msgid "That's when I'm usually able to sleep."
msgstr "C'est le moment où j'arrive d'habitude à dormir."

# Traduction IA – à relire
#: holly_holidays/holly1/0/g-2/16
msgctxt "Holly"
msgid "That work?"
msgstr "Ça te va ?"

# Traduction IA – à relire
#: holly_holidays/holly1/0/g-2/24/s/0
msgctxt "Choix"
msgid "No..."
msgstr "Non..."

# Traduction IA – à relire
#: holly_holidays/holly1/0/g-2/25/s/0
msgctxt "Choix"
msgid "Sure!"
msgstr "Bien sûr !"

# Traduction IA – à relire
#: holly_holidays/holly1/0/g-3/0
msgctxt "Holly"
msgid "Great!"
msgstr "Super !"

# Traduction IA – à relire
#: holly_holidays/holly1/0/g-3/8
msgctxt "Holly"
msgid "Okay!"
msgstr "Okay !"

# Traduction IA – à relire
#: holly_holidays/holly1/0/g-3/16
msgctxt "Holly"
msgid "<w>BYEEEEE!</w>"
msgstr "<w>BYEEEEE !</w>"

# Traduction IA – à relire
#: holly_holidays/holly2/0/6
msgctxt "Narrator"
msgid "Holly greets you with a spirited wave, the bells and ornaments in her hair jingling with every energetic shake of her hand."
msgstr "Holly vous salue avec entrain, les clochettes et les ornements de ses cheveux tintant à chaque secousse énergique de sa main."

# Traduction IA – à relire
#: holly_holidays/holly2/0/14
msgctxt "Holly"
msgid "You made it! Thanks for making the time."
msgstr "Tu as réussi à venir ! Merci d'avoir pris le temps."

# Traduction IA – à relire
#: holly_holidays/holly2/0/22/s/0
msgctxt "Choix"
msgid "I've got plenty of it."
msgstr "J'en ai à revendre."

# Traduction IA – à relire
#: holly_holidays/holly2/0/23/s/0
msgctxt "Choix"
msgid "You too!"
msgstr "Toi aussi !"

# Traduction IA – à relire
#: holly_holidays/holly2/0/24/s/0
msgctxt "Choix"
msgid "It's hard to pin you down."
msgstr "On a du mal à te coincer."

# Traduction IA – à relire
#: holly_holidays/holly2/0/25/s/0
msgctxt "Choix"
msgid "How was work?"
msgstr "Et ce boulot ?"

# Traduction IA – à relire
#: holly_holidays/holly2/0/c-0/7
msgctxt "Holly"
msgid "Sounds like a dream."
msgstr "On dirait un rêve."

# Traduction IA – à relire
#: holly_holidays/holly2/0/c-1/7
msgctxt "Holly"
msgid "Gotta rest sometime!"
msgstr "Il faut bien se reposer de temps en temps !"

# Traduction IA – à relire
#: holly_holidays/holly2/0/c-2/7
msgctxt "Holly"
msgid "I know right!? I don't even know where I am sometimes."
msgstr "Je sais, hein !? Parfois je ne sais même plus où je suis."

# Traduction IA – à relire
#: holly_holidays/holly2/0/c-3/7
msgctxt "Holly"
msgid "<w>Loooonnnggggggg.</w> But great! Mostly."
msgstr "<w>Looooonnnnnnng.</w> Mais super ! Surtout."

# Traduction IA – à relire
#: holly_holidays/holly2/0/c-3/15/0/s/0
msgctxt "Choix"
msgid "Mostly?"
msgstr "Surtout ?"

# Traduction IA – à relire
#: holly_holidays/holly2/0/c-3/15/1/s/0
msgctxt "Choix"
msgid "Another double?"
msgstr "Encore un double ?"

# Traduction IA – à relire
#: holly_holidays/holly2/0/c-3/15/c-0/7
msgctxt "Holly"
msgid "Well. You know... someone spat in my face. But besides that!"
msgstr "Eh bien. Tu sais... quelqu'un m'a craché au visage. Mais à part ça !"

# Traduction IA – à relire
#: holly_holidays/holly2/0/c-3/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "I'm so sorry."
msgstr "Je suis vraiment {{désolé|désolée|désolé·e}}."

# Traduction IA – à relire
#: holly_holidays/holly2/0/c-3/15/c-0/15/1/s/0 holly_holidays/HollyBruce/0/g-0/60/s/0
msgctxt "Choix"
msgid "Merry Blissmas."
msgstr "Joyeux Blissmas."

# Traduction IA – à relire
#: holly_holidays/holly2/0/c-3/15/c-0/15/2/s/0
msgctxt "Choix"
msgid "That sounds terrible."
msgstr "Ça a l'air terrible."

# Traduction IA – à relire
#: holly_holidays/holly2/0/c-3/15/c-0/15/c-0/7
msgctxt "Holly"
msgid "It's ok. Spit happens."
msgstr "C'est pas grave. Ça postillonne, c'est la vie."

# Traduction IA – à relire
#: holly_holidays/holly2/0/c-3/15/c-0/15/c-1/7
msgctxt "Holly"
msgid "Spits the season to be jolly."
msgstr "C'est la saison des crachats joyeux."

# Traduction IA – à relire
#: holly_holidays/holly2/0/c-3/15/c-0/15/c-2/7
msgctxt "Holly"
msgid "That's the gig."
msgstr "C'est le métier."

# Traduction IA – à relire
#: holly_holidays/holly2/0/c-3/15/c-1/7
msgctxt "Holly"
msgid "Nah. Well... legally, no. But technically, yes."
msgstr "Nan. Enfin... légalement, non. Mais techniquement, oui."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/0/s/0
msgctxt "Choix"
msgid "Seems like you're always working?"
msgstr "On dirait que tu travailles tout le temps ?"

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/1/s/0
msgctxt "Choix"
msgid "What do you actually do?"
msgstr "Tu fais quoi, au juste ?"

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/2/s/0
msgctxt "Choix"
msgid "Gig work then?"
msgstr "Des contrats ponctuels, alors ?"

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/c-0/7
msgctxt "Holly"
msgid "Almost! There's always something happening somewhere."
msgstr "Presque ! Il se passe toujours quelque chose quelque part."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/c-1/7
msgctxt "Holly"
msgid "Everything! I've got a five page resume which I know you're not supposed to have but I'm secretly very proud of it. I've been a waiter, a maitre-de, a caddy, an usher, a valet, a pinata, a mascot, a pinata mascot, a bartender..."
msgstr "Tout ! J'ai un CV de cinq pages, ce qu'on n'est pas censé avoir, je sais, mais j'en suis secrètement très fière. J'ai été serveuse, maîtresse d'hôtel, caddie, placeuse, voiturier, piñata, mascotte, mascotte piñata, barmaid..."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/c-1/15
msgctxt "Holly"
msgid "...a line chef, a runner, a ticketer, a seat-holder, an election official, a zamboni driver, a scuba diver, a pick-packer, a mail carrier, a time-keeper, and an eisteddfod judge for a local junior yodeling competition."
msgstr "...commis de cuisine, coursière, contrôleuse de billets, gardienne de place, scrutatrice, conductrice de Zamboni, plongeuse sous-marine, préparatrice de commandes, factrice, chronométreuse, et juge d'eisteddfod pour un concours local de yodel junior."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/c-2/7
msgctxt "Holly"
msgid "Oh, the giggiest. The best kind of work for me, personally. Always something new. I can't sit still for too long. Bores me to tears. I need fifty things to focus on or absolutely none at all."
msgstr "Oh, le plus gigantesque des gigs. Le meilleur type de travail pour moi, personnellement. Toujours du nouveau. Je ne tiens pas en place longtemps. Ça m'ennuie à pleurer. Il me faut cinquante trucs sur lesquels me concentrer, ou absolument aucun."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/c-2/15/0/s/0
msgctxt "Choix"
msgid "Sounds... hectic."
msgstr "Ça a l'air... mouvementé."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/c-2/15/1/s/0
msgctxt "Choix"
msgid "Does it pay well?"
msgstr "Ça paie bien ?"

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/c-2/15/c-0/7
msgctxt "Holly"
msgid "It is. It's perfect."
msgstr "Oui. C'est parfait."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/c-2/15/c-1/7
msgctxt "Holly"
msgid "NOPE. But I work a lotta hours. But you already know that."
msgstr "NON. Mais je fais beaucoup d'heures. Mais ça, tu le sais déjà."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-0/0
msgctxt "Holly"
msgid "It's joyful too, bringing joy. Someone's always celebrating something, and I get to be a part of that, all the time. It doesn't even have to be a holiday for me, or about me. I just enjoy joy. You know?"
msgstr "C'est joyeux aussi, de répandre la joie. Il y a toujours quelqu'un qui fête quelque chose, et je peux en faire partie, tout le temps. Pas besoin que ce soit une fête pour moi, ou à mon sujet. J'aime juste la joie. Tu vois ?"

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-0/8
msgctxt "Holly"
msgid "Better than punching numbers all day, unless that's part of the gig."
msgstr "Mieux que d'aligner des chiffres toute la journée, sauf si ça fait partie du contrat."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-0/16
msgctxt "Holly"
msgid "NO OFFENSE TO NUMBER PUNCHERS! Just not for me."
msgstr "SANS OFFENSE POUR LES ALIGNEURS DE CHIFFRES ! Juste, pas pour moi."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-0/27/s/0
msgctxt "Choix"
msgid "None taken."
msgstr "Aucune offense."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-0/28/s/0
msgctxt "Choix"
msgid "No, that makes sense."
msgstr "Non, ça se comprend."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-0/29/s/0
msgctxt "Choix"
msgid "Not every holiday is joyful."
msgstr "Toutes les fêtes ne sont pas joyeuses."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-0/c-5/7
msgctxt "Holly"
msgid "No. They aren't."
msgstr "Non. Elles ne le sont pas."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-0/c-5/15
msgctxt "Holly"
msgid "But every holiday has a purpose."
msgstr "Mais chaque fête a une raison d'être."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/0
msgctxt "Holly"
msgid "What about you!? What do you do!?"
msgstr "Et toi alors !? Tu fais quoi !?"

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/8/s/0
msgctxt "Choix"
msgid "I punch numbers."
msgstr "J'aligne des chiffres."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/9/s/0
msgctxt "Choix"
msgid "I talk to objects."
msgstr "Je parle aux objets."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/10/s/0
msgctxt "Choix"
msgid "I work in conflict resolution."
msgstr "Je travaille dans la résolution de conflits."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/11/s/0
msgctxt "Choix"
msgid "Nothing, really. Got fired my second day."
msgstr "Rien, en fait. Je me suis fait virer le deuxième jour."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/c-6/7
msgctxt "Holly"
msgid "...ah. Ahhhh. Hmm. Yep. My bad."
msgstr "...ah. Ahhhh. Hmm. Ouais. Mon mauvais."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/c-6/15/0/s/0
msgctxt "Choix"
msgid "No offense taken. It's not for me either."
msgstr "Aucune offense. Ce n'est pas pour moi non plus."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/c-6/15/1/s/0
msgctxt "Choix"
msgid "I happen to quite enjoy numbers."
msgstr "Il se trouve que j'aime plutôt bien les chiffres."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/c-6/15/c-0/7
msgctxt "Holly"
msgid "Well that was awkward..."
msgstr "Ça a jeté un froid..."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/c-6/15/c-1/7
msgctxt "Holly"
msgid "Well at least we're not competing for jobs!"
msgstr "Eh bien au moins on ne se dispute pas les mêmes jobs !"

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/c-6/15/g-0/0
msgctxt "Holly"
msgid "It's good to have a job around here, keep your mind off the drama. You'd think it was always the holidays with what we've got going on."
msgstr "C'est bien d'avoir un boulot ici, ça change les idées du drame ambiant. On croirait que c'est tout le temps les fêtes, avec ce qui se passe."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/c-6/15/g-0/8/b/1
msgctxt "Holly"
msgid "That said, I've heard your name flung around with a bit of a bitter bite lately."
msgstr "Cela dit, j'ai entendu ton nom balancé avec un certain mordant, ces derniers temps."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/c-6/15/g-0/11/b/1
msgctxt "Holly"
msgid "Everyone seems to love you though."
msgstr "Tout le monde a l'air de t'adorer, pourtant."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/c-6/15/g-0/14/b/1
msgctxt "Holly"
msgid "I've heard you've been diving into the mix, for better or worse."
msgstr "Il paraît que tu as plongé dans le bain, pour le meilleur ou pour le pire."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/c-6/15/g-0/17
msgctxt "Holly"
msgid "So it goes..."
msgstr "Ainsi va la vie..."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/c-7/7
msgctxt "Holly"
msgid "AHH. You're good at that. Or, I can see you being good at that."
msgstr "AHH. Tu as du talent pour ça. Enfin, je vois bien que tu pourrais en avoir."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/c-7/15/0/s/0 holly_holidays/hollyreturnhate/0/c-1/69/0/s/0
msgctxt "Choix"
msgid "I am."
msgstr "C'est le cas."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/c-7/15/1/s/0
msgctxt "Choix"
msgid "I'm not."
msgstr "Non."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/c-7/15/2/s/0
msgctxt "Choix"
msgid "I get by."
msgstr "Je me débrouille."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/c-7/15/c-0/7
msgctxt "Holly"
msgid "I agree."
msgstr "Je suis d'accord."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/c-7/15/c-1/7
msgctxt "Holly"
msgid "Sure you are! Look at us right now, chit chattering like old chums."
msgstr "Bien sûr que oui ! Regarde-nous, là, à papoter comme de vieux copains."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/c-7/15/g-0/0
msgctxt "Holly"
msgid "I think you're great at talking to objects!"
msgstr "Je trouve que tu es super pour parler aux objets !"

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/c-7/15/g-0/8/b/1
msgctxt "Holly"
msgid "Nevermind what everyone else says."
msgstr "Peu importe ce que disent les autres."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/c-7/15/g-0/11/b/1
msgctxt "Holly"
msgid "At least that's the word around town."
msgstr "Du moins c'est ce qu'on dit en ville."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/c-7/15/g-0/14/b/1
msgctxt "Holly"
msgid "...even if the jury's out for everyone else."
msgstr "...même si les avis des autres sont partagés."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/c-8/7
msgctxt "Holly"
msgid "OHH. Sounds high stakes! Must come in handy round here."
msgstr "OHH. Ça a l'air d'avoir de gros enjeux ! Ça doit servir, par ici."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/c-8/15/0/s/0
msgctxt "Choix"
msgid "Most of you seem beyond resolution."
msgstr "La plupart d'entre vous semblent irrécupérables."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/c-8/15/1/s/0
msgctxt "Choix"
msgid "Disturbingly so."
msgstr "À un degré inquiétant."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/c-8/15/g-0/0
msgctxt "Holly"
msgid "Motley bunch, we are. Best way to be, keeps things lively like a holiday punch!"
msgstr "On est une drôle de bande, nous. C'est la meilleure façon d'être, ça garde les choses animées, comme un punch de fêtes !"

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/c-8/15/g-0/8/b/1
msgctxt "Holly"
msgid "...and I hear you've been stirring the bowl."
msgstr "...et il paraît que c'est toi qui remues le bol."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/c-8/15/g-0/11/b/1 holly_holidays/holly2alwaysworking/0/g-1/c-8/15/g-0/14/b/1
msgctxt "Holly"
msgid "From what I hear, you've been fitting in well!"
msgstr "D'après ce que j'entends, tu t'intègres très bien !"

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/c-8/15/g-0/17/b/1
msgctxt "Holly"
msgid "I hear you've been a divisive addition to the mix!"
msgstr "J'entends dire que tu es un ajout qui divise !"

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/c-9/7
msgctxt "Holly"
msgid "Sounds nice."
msgstr "Ça a l'air sympa."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/c-9/15/0/s/0
msgctxt "Choix"
msgid "It pays the bills... oddly."
msgstr "Ça paie les factures... étrangement."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/c-9/15/1/s/0
msgctxt "Choix"
msgid "It is. I get time to enjoy life."
msgstr "Oui. J'ai le temps de profiter de la vie."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/c-9/15/c-0/7
msgctxt "Holly"
msgid "Odd jobs... can relate!"
msgstr "Les petits boulots... je connais !"

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/c-9/15/g-0/0
msgctxt "Holly"
msgid "It's good to have something simple around here. There's enough crazy to go around, but you know that."
msgstr "C'est bien d'avoir quelque chose de simple, par ici. Il y a déjà assez de folie pour tout le monde, mais ça, tu le sais."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/c-9/15/g-0/8/b/1
msgctxt "Holly"
msgid "I hear you've been starting some social warfare yourself."
msgstr "J'entends dire que tu lances toi-même une guerre sociale."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/c-9/15/g-0/11/b/1
msgctxt "Holly"
msgid "I hear you're making a good impression so far."
msgstr "J'entends dire que tu fais bonne impression jusqu'ici."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-1/c-9/15/g-0/14/b/1
msgctxt "Holly"
msgid "I hear you're striking a steady balance between Claus and Krampus."
msgstr "J'entends dire que tu tiens un équilibre stable entre le Père Noël et Krampus."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-2/0/s/0
msgctxt "Choix"
msgid "So what ARE the others saying?"
msgstr "Alors, qu'est-ce que disent les autres ?"

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-2/1/s/0
msgctxt "Choix"
msgid "You know. I'm actually ok not knowing the talk of the town."
msgstr "Tu sais quoi. Je suis très bien sans connaître les rumeurs du coin."

# Traduction IA – à relire
#: holly_holidays/holly2alwaysworking/0/g-2/c-11/7
msgctxt "Holly"
msgid "Okie dokie. Whatever you say, boss. Eyes on the prize."
msgstr "Okie dokie. Comme tu veux, chef. Les yeux sur le prix."

# Traduction IA – à relire
#: holly_holidays/HollyHouseHate/0/0
msgctxt "Holly"
msgid "Oh, you know. Things. Stuff. Nothing really."
msgstr "Oh, tu sais. Des trucs. Des machins. Rien de spécial."

# Traduction IA – à relire
#: holly_holidays/HollyHouseHate/0/8/b/1
msgctxt "Holly"
msgid "Rebel had some choice words, but that's Rebel. They are... multifauceted."
msgstr "Rebel a eu quelques mots choisis, mais bon, c'est Rebel. Iel est... multifacette."

# Traduction IA – à relire
#: holly_holidays/HollyHouseHate/0/11
msgctxt "Holly"
msgid "In general, I suppose, the consensus... might be... that you have so far had a net negative impact on the \"holiday spirit\"."
msgstr "En général, je suppose, le consensus... serait peut-être... que tu as eu jusqu'ici un impact net négatif sur « l'esprit des fêtes »."

# Traduction IA – à relire
#: holly_holidays/HollyHouseHate/0/19
msgctxt "Holly"
msgid "NOT THAT THAT'S A BAD THING!"
msgstr "CE QUI N'EST PAS FORCÉMENT MAUVAIS !"

# Traduction IA – à relire
#: holly_holidays/HollyHouseHate/0/30/s/0
msgctxt "Choix"
msgid "It's not?"
msgstr "Non ?"

# Traduction IA – à relire
#: holly_holidays/HollyHouseHate/0/31/s/0
msgctxt "Choix"
msgid "Exactly!"
msgstr "Exactement !"

# Traduction IA – à relire
#: holly_holidays/HollyHouseHate/0/c-0/7
msgctxt "Holly"
msgid "I don't know. I think sometimes hate is the healthiest relationship you can hope for. Not everyone was made to get along. Might as well be honest about it."
msgstr "Je ne sais pas. Je crois que parfois la haine est la relation la plus saine qu'on puisse espérer. On n'est pas tous faits pour s'entendre. Autant être honnête là-dessus."

# Traduction IA – à relire
#: holly_holidays/HollyHouseHate/0/c-0/15
msgctxt "Holly"
msgid "I've worked with plenty of antagonists."
msgstr "J'ai travaillé avec plein d'antagonistes."

# Traduction IA – à relire
#: holly_holidays/HollyHouseHate/0/c-1/7
msgctxt "Holly"
msgid "Exactly! Yeah... that makes sense."
msgstr "Exactement ! Ouais... ça se tient."

# Traduction IA – à relire
#: holly_holidays/HollyHouseHate/0/g-0/0/s/0
msgctxt "Choix"
msgid "I'm glad we agree."
msgstr "Tant mieux, on est d'accord."

# Traduction IA – à relire
#: holly_holidays/HollyHouseHate/0/g-0/1/s/0
msgctxt "Choix"
msgid "You're just trying to make me feel better."
msgstr "Tu essaies juste de me remonter le moral."

# Traduction IA – à relire
#: holly_holidays/HollyHouseHate/0/g-0/2/s/0
msgctxt "Choix"
msgid "Can't wait to get you to hate me."
msgstr "J'ai hâte de te faire me détester."

# Traduction IA – à relire
#: holly_holidays/HollyHouseHate/0/g-0/c-2/7
msgctxt "Holly"
msgid "You are stalwart."
msgstr "Tu es coriace."

# Traduction IA – à relire
#: holly_holidays/HollyHouseHate/0/g-0/c-3/7
msgctxt "Holly"
msgid "Mostly yep. I'm not lying though."
msgstr "Surtout oui. Je ne mens pas, pourtant."

# Traduction IA – à relire
#: holly_holidays/HollyHouseHate/0/g-0/c-4/23
msgctxt "Holly"
msgid "We can skip right over that!"
msgstr "On peut passer là-dessus !"

# Traduction IA – à relire
#: holly_holidays/HollyHouseLove/0/0 holly_holidays/HollyHouseBalance/0/6
msgctxt "Holly"
msgid "Depends on who you ask..."
msgstr "Ça dépend à qui tu demandes..."

# Traduction IA – à relire
#: holly_holidays/HollyHouseLove/0/8/b/1
msgctxt "Holly"
msgid "Seems you're still finding your feet, but they seem to like you or love you. That line gets really blurry around here sometimes."
msgstr "On dirait que tu cherches encore tes marques, mais ils ont l'air de t'apprécier ou de t'adorer. La frontière est très floue, par ici, parfois."

# Traduction IA – à relire
#: holly_holidays/HollyHouseLove/0/11/b/1
msgctxt "Holly"
msgid "Let's just say Venetian's Day might be a busy day for you. Let me know if you need some help! I have a side gig running roses to \"side-gigs\" every year."
msgstr "Disons que la Saint-Vénitien pourrait être chargée pour toi. Dis-moi si tu as besoin d'aide ! J'ai un petit boulot annexe : chaque année, je livre des roses aux « boulots annexes »."

# Traduction IA – à relire
#: holly_holidays/HollyHouseLove/0/14/b/1
msgctxt "Holly"
msgid "Everyone's your best friend, apparently. So many besties, so little time. Watch out for June 8th, bestie."
msgstr "Tout le monde est ton meilleur ami, apparemment. Tant de besties, si peu de temps. Fais gaffe au 8 juin, bestie."

# Traduction IA – à relire
#: holly_holidays/HollyHouseBalance/0/0/b/1
msgctxt "Holly"
msgid "I mean it's not that many around here talking, but..."
msgstr "Enfin, ils ne sont pas si nombreux à parler par ici, mais..."

# Traduction IA – à relire
#: holly_holidays/HollyHouseBalance/0/3/b/1
msgctxt "Holly"
msgid "There's a healthy balance of general enjoyment and hate your guts. Really it's just smack down the center. It's kind of wild how precise it is."
msgstr "Il y a un bel équilibre entre l'affection générale et l'envie de t'étrangler. En vrai, c'est pile au milieu. C'est dingue de précision."

# Traduction IA – à relire
#: holly_holidays/HollyHowDoYouFeelAboutMe/0/0/s/0
msgctxt "Choix"
msgid "That said, how do you feel about me?"
msgstr "Cela dit, tu m'aimes comment, toi ?"

# Traduction IA – à relire
#: holly_holidays/HollyHowDoYouFeelAboutMe/0/c-0/7
msgctxt "Holly"
msgid "Well you waded through my busted schedule, so you can't be that bad."
msgstr "Eh bien tu as réussi à t'aventurer dans mon planning détraqué, donc tu ne peux pas être si terrible."

# Traduction IA – à relire
#: holly_holidays/HollyHowDoYouFeelAboutMe/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "I'm hardly running for office."
msgstr "Je ne me présente pas aux élections."

# Traduction IA – à relire
#: holly_holidays/HollyHowDoYouFeelAboutMe/0/c-0/15/1/s/0
msgctxt "Choix"
msgid "Sounds like you're dodging the question."
msgstr "On dirait que tu esquives la question."

# Traduction IA – à relire
#: holly_holidays/HollyHowDoYouFeelAboutMe/0/c-0/15/c-0/7
msgctxt "Holly"
msgid "I'd vote for you. I think. I mean, you made the time to see me with my busted schedule, so maybe you'd actually get things done around here."
msgstr "Je voterais pour toi. Je crois. Enfin, tu as trouvé le temps de me voir malgré mon planning détraqué, alors peut-être que tu ferais vraiment avancer les choses, par ici."

# Traduction IA – à relire
#: holly_holidays/HollyHowDoYouFeelAboutMe/0/c-0/15/c-0/15
msgctxt "Holly"
msgid "Don't tell Celia, though!"
msgstr "Ne le dis pas à Celia, par contre !"

# Traduction IA – à relire
#: holly_holidays/HollyHowDoYouFeelAboutMe/0/c-0/15/c-1/7
msgctxt "Holly"
msgid "Yes, I am!!"
msgstr "Oui, j'esquive !!"

# Traduction IA – à relire
#: holly_holidays/HollyHowDoYouFeelAboutMe/0/g-0/0
msgctxt "Holly"
msgid "Speaking of which, I gotta bounce to another shift. Gleester in July is really hopping this year."
msgstr "À ce propos, je dois filer à un autre service. Gleester en juillet bat son plein cette année."

# Traduction IA – à relire
#: holly_holidays/HollyHowDoYouFeelAboutMe/0/g-0/8/s/0
msgctxt "Choix"
msgid "Ew."
msgstr "Beurk."

# Traduction IA – à relire
#: holly_holidays/HollyHowDoYouFeelAboutMe/0/g-0/9/s/0
msgctxt "Choix"
msgid "It's not July."
msgstr "On n'est pas en juillet."

# Traduction IA – à relire
#: holly_holidays/HollyHowDoYouFeelAboutMe/0/g-0/c-1/7/b/1
msgctxt "Holly"
msgid "See! This is why things around here don't like you."
msgstr "Tu vois ! C'est pour ça que les choses, ici, ne t'aiment pas."

# Traduction IA – à relire
#: holly_holidays/HollyHowDoYouFeelAboutMe/0/g-0/c-1/10
msgctxt "Holly"
msgid "Don't be a hot cross bunny."
msgstr "Fais pas ton lapin de mauvais poil."

# Traduction IA – à relire
#: holly_holidays/HollyHowDoYouFeelAboutMe/0/g-0/c-1/18/0/s/0
msgctxt "Choix"
msgid "That's not bunny."
msgstr "Ce n'est pas la bonne expression."

# Traduction IA – à relire
#: holly_holidays/HollyHowDoYouFeelAboutMe/0/g-0/c-1/18/1/s/0
msgctxt "Choix"
msgid "<i>Sigh</i>."
msgstr "<i>Soupir</i>."

# Traduction IA – à relire
#: holly_holidays/HollyHowDoYouFeelAboutMe/0/g-0/c-1/18/c-0/7
msgctxt "Holly"
msgid "Oh, that was good, that was good..."
msgstr "Oh, celle-là était bien, elle était bien..."

# Traduction IA – à relire
#: holly_holidays/HollyHowDoYouFeelAboutMe/0/g-0/c-1/18/c-1/7
msgctxt "Holly"
msgid "Gesundheit!"
msgstr "À tes souhaits !"

# Traduction IA – à relire
#: holly_holidays/HollyHowDoYouFeelAboutMe/0/g-0/c-2/7
msgctxt "Holly"
msgid "I KNOW RIGHT!? THAT'S WHAT I SAID!"
msgstr "JE SAIS, HEIN !? C'EST CE QUE J'AI DIT !"

# Traduction IA – à relire
#: holly_holidays/HollyHowDoYouFeelAboutMe/0/g-1/0
msgctxt "Holly"
msgid "ANYWAY. OKAY. <w>BYEEEEEE!</w> Bye bye bye!"
msgstr "BREF. OKAY. <w>BYEEEEEE !</w> Bye bye bye !"

# Traduction IA – à relire
#: holly_holidays/holly3/0/6
msgctxt "Holly"
msgid "PERFECT TIMING!"
msgstr "PILE À L'HEURE !"

# Traduction IA – à relire
#: holly_holidays/holly3/0/17
msgctxt "Narrator"
msgid "You've come to expect Holly's spirited greetings, but this one still manages to startle you just a little."
msgstr "Vous avez fini par vous habituer aux salutations enthousiastes de Holly, mais celle-ci parvient quand même à vous faire sursauter un peu."

# Traduction IA – à relire
#: holly_holidays/holly3/0/25/s/0
msgctxt "Choix"
msgid "Umm..."
msgstr "Euh..."

# Traduction IA – à relire
#: holly_holidays/holly3/0/26/s/0
msgctxt "Choix"
msgid "Knew it."
msgstr "Je le savais."

# Traduction IA – à relire
#: holly_holidays/holly3/0/27/s/0
msgctxt "Choix"
msgid "I'm just here when the prophecy tells me to be."
msgstr "Je suis là uniquement quand la prophétie me l'ordonne."

# Traduction IA – à relire
#: holly_holidays/holly3/0/c-0/7
msgctxt "Holly"
msgid "You know, umm is the start of many a great adventure."
msgstr "Tu sais, « euh » est le début de bien des grandes aventures."

# Traduction IA – à relire
#: holly_holidays/holly3/0/c-1/7
msgctxt "Holly"
msgid "I knew you'd know!"
msgstr "Je savais que tu saurais !"

# Traduction IA – à relire
#: holly_holidays/holly3/0/c-2/7
msgctxt "Holly"
msgid "OHHHHHHHH! Let's get PROPHETIC."
msgstr "OHHHHHHHH ! Passons au PROPHÉTIQUE."

# Traduction IA – à relire
#: holly_holidays/holly3/0/c-2/15
msgctxt "Holly"
msgid "<w>SPOOOOOOKEEEEEEEEEYYYYYYYYYYYYY.</w>"
msgstr "<w>FLAGEOLAAAAAAAANT.</w>"

# Traduction IA – à relire
#: holly_holidays/holly3/0/c-2/23 holly_holidays/holly_office/0/g-0/43
msgctxt "Holly"
msgid "ANYWAY!"
msgstr "BREF !"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-0/0
msgctxt "Holly"
msgid "How."
msgstr "Qu'est-ce."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-0/8
msgctxt "Holly"
msgid "Do."
msgstr "Que."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-0/16
msgctxt "Holly"
msgid "You."
msgstr "Tu."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-0/24
msgctxt "Holly"
msgid "Feel."
msgstr "Penses."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-0/32
msgctxt "Holly"
msgid "About..."
msgstr "Des..."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-0/43
msgctxt "Holly"
msgid "...flyers...?"
msgstr "...tracts... ?"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-0/51/s/0
msgctxt "Choix"
msgid "Ambivalent."
msgstr "De l'ambivalence."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-0/52/s/0
msgctxt "Choix"
msgid "They're... nice?"
msgstr "Ils sont... sympas ?"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-0/53/s/0
msgctxt "Choix"
msgid "I FUCKING LOVE FLYERS."
msgstr "J'ADORE LES PUTAINS DE TRACTS."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-0/c-3/7
msgctxt "Holly"
msgid "Well get ready to feel VALENT about them!"
msgstr "Eh bien prépare-toi à ressentir de la VALENCE pour eux !"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-0/c-4/7
msgctxt "Holly"
msgid "I KNOW RIGHT!?"
msgstr "JE SAIS, HEIN !?"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-0/c-5/7
msgctxt "Holly"
msgid "SO. DO. I!"
msgstr "MOI. AUSSI !"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-1/0
msgctxt "Holly"
msgid "So I've got a mail drop shift, and I figured why not do MOOOOOOREEEE!?"
msgstr "Donc j'ai un service de dépôt de courrier, et j'ai pensé : pourquoi pas en faire PLUUUUUS !?"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-1/8
msgctxt "Holly"
msgid "You know!?"
msgstr "Tu vois !?"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-1/16
msgctxt "Holly"
msgid "So I picked up a flyer drop shift."
msgstr "Alors j'ai pris un service de distribution de tracts."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-1/24
msgctxt "Holly"
msgid "And I figure since you're here, you're wanting to hang out anyway?"
msgstr "Et je me dis que, puisque tu es là, tu as sûrement envie de traîner avec moi ?"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-1/32
msgctxt "Holly"
msgid "So... keep me company?"
msgstr "Alors... tiens-moi compagnie ?"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-1/43/s/0
msgctxt "Choix"
msgid "Sounds gre-"
msgstr "Ça a l'air gé-"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-1/44/s/0
msgctxt "Choix"
msgid "Actual-"
msgstr "En fait-"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-1/45/s/0
msgctxt "Choix"
msgid "I me-"
msgstr "Je vou-"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-2/0
msgctxt "Holly"
msgid "-GREAT! Race you to the kitchen!"
msgstr "-NIAL ! Le dernier à la cuisine paie sa tournée !"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-2/11/s/0
msgctxt "Choix"
msgid "Uh-"
msgstr "Eu-"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-2/12/s/0
msgctxt "Choix"
msgid "Wai-"
msgstr "Atten-"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-2/13/s/0
msgctxt "Choix"
msgid "I wa-"
msgstr "Je ve-"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-3/0
msgctxt "Narrator"
msgid "Holly takes off before you can even finish your sentence, fleeing towards the kitchen."
msgstr "Holly détale avant même que vous ayez fini votre phrase, fonçant vers la cuisine."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-3/8
msgctxt "Holly"
msgid "SORRY! I can't hear you over me <w>winniinnnnnnng.</w>"
msgstr "DÉSOLÉE ! Je ne t'entends pas, je suis trop occupée à <w>gagnaaaaaaaaaaaaaaaaaant.</w>"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-3/19
msgctxt "Holly"
msgid "Tortoise and hare we are."
msgstr "La tortue et le lièvre, c'est nous."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-3/27/s/0
msgctxt "Choix"
msgid "I'm deeply unfit."
msgstr "Je suis en très mauvaise forme."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-3/28/s/0
msgctxt "Choix"
msgid "Hey I caught up just fine!"
msgstr "Hé, je t'ai rattrapée sans problème !"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-3/c-12/7
msgctxt "Holly"
msgid "You should work hospo. Free gym membership."
msgstr "Tu devrais faire dans l'hôtellerie-restauration. Abonnement gratuit à la salle de sport."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-3/c-13/7
msgctxt "Holly"
msgid "I'm proud of you!"
msgstr "Je suis fière de toi !"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-3/c-13/15
msgctxt "Holly"
msgid "But nothing's faster than an unexpected HOLIDAY!"
msgstr "Mais rien ne va plus vite qu'une FÊTE inattendue !"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-4/0/s/0
msgctxt "Choix"
msgid "So what are we actually doing?"
msgstr "Alors, on fait quoi, exactement ?"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-4/c-14/7
msgctxt "Holly"
msgid "If you're going to be my helper - you need to know the basics."
msgstr "Si tu veux être mon aide, il faut que tu connaisses les bases."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-4/c-14/15
msgctxt "Holly"
msgid "There is a Mirthday festival next week. I get $0.50 a flyer for handing out 100 flyers. And that is?"
msgstr "Il y a un festival de Mirthday la semaine prochaine. Je touche 0,50 $ par tract pour en distribuer 100. Et ça fait ?"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-4/c-14/23/3/s/0
msgctxt "Choix"
msgid "I didn't go to fuckin school for math."
msgstr "J'ai pas fait des études pour me farcir des putains de maths."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-4/c-14/23/c-0/7/b/1 holly_holidays/holly3/0/g-4/c-14/23/c-2/7/b/1 holly_holidays/holly3/0/g-4/c-14/23/c-3/7/b/1
msgctxt "Holly"
msgid "I thought you said you punched numbers?"
msgstr "Je croyais que tu avais dit que tu alignais des chiffres ?"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-4/c-14/23/c-0/8/b/1 holly_holidays/holly3/0/g-4/c-14/23/c-2/8/b/1
msgctxt "Holly"
msgid "I WISH."
msgstr "SI SEULEMENT."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-4/c-14/23/c-1/7/b/1
msgctxt "Holly"
msgid "You really do punch numbers!"
msgstr "Tu aimes vraiment aligner les chiffres !"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-4/c-14/23/c-1/8/b/1
msgctxt "Holly"
msgid "Bingo!"
msgstr "Bingo !"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-5/0
msgctxt "Holly"
msgid "It's $50. Which isn't bad, to be honest. And it just so happens that between you, me, and 98 roommates, we've got 100 folks to fly through."
msgstr "50 $. Ce qui n'est pas mal, à vrai dire. Et il se trouve qu'entre toi, moi et 98 colocataires, on a 100 personnes à qui en refiler."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-5/8
msgctxt "Holly"
msgid "And we're gonna start."
msgstr "Et on va commencer."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-5/16
msgctxt "Holly"
msgid "Right."
msgstr "Tout."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-5/24
msgctxt "Holly"
msgid "HERE."
msgstr "DE SUITE."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-5/35
msgctxt "Holly"
msgid "<w>KOPIIIIIIII! I'M BAAACKKKK!</w>"
msgstr "<w>KOPIIIIIIII ! JE SUIS DE RETOUUUUR !</w>"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-5/58
msgctxt "Kopi"
msgid "<w>HOLLLLLLLLY!</w>"
msgstr "<w>HOLLLLLLLLY !</w>"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-5/69
msgctxt "Holly"
msgid "<w>Kooopiiiii!</w> Be my favourite customer and take a flyer? I gotta get rid of a hundred of em and they KNOW when I don't."
msgstr "<w>Kooopiiiii !</w> Sois mon client préféré et prends un tract ? Il faut que je m'en débarrasse de cent et ils SAVENT quand je n'y arrive pas."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-5/77
msgctxt "Holly"
msgid "I don't know how, but they know."
msgstr "Je ne sais pas comment, mais ils savent."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-5/85
msgctxt "Kopi"
msgid "You got an intern?"
msgstr "Tu as un stagiaire ?"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-5/93
msgctxt "Holly"
msgid "Something like that."
msgstr "Quelque chose comme ça."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-5/101/b/1
msgctxt "Kopi"
msgid "This one's a good brew."
msgstr "Celui-ci est un bon cru."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-5/104/b/1
msgctxt "Kopi"
msgid "Don't pin your hopes on them."
msgstr "Ne mise pas tout sur cette personne."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-5/107/b/1
msgctxt "Kopi"
msgid "Holly works hard. You might need a coffee to keep up."
msgstr "Holly travaille dur. Il te faudra peut-être un café pour suivre."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-5/110
msgctxt "Kopi"
msgid "And on that note, I better get back to work! Pick up a shift Holly! I miss youuuuuu."
msgstr "Et sur ce, je ferais mieux de retourner bosser ! Prends un service, Holly ! Tu me manques."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-5/118
msgctxt "Holly"
msgid "Sooon! I promise."
msgstr "Bientôôôt ! Promis."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-5/126
msgctxt "Kopi"
msgid "You said that LAST month!"
msgstr "Tu disais déjà ça le mois DERNIER !"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-5/134
msgctxt "Holly"
msgid "But now I actually have time!"
msgstr "Mais là j'ai vraiment le temps !"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-5/148
msgctxt "Holly"
msgid "I think!"
msgstr "Je crois !"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-5/156/b/1
msgctxt "Holly"
msgid "Seems your reputation precedes you."
msgstr "On dirait que ta réputation te précède."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-5/159/s/0
msgctxt "Choix"
msgid "What's the festival about anyway?"
msgstr "Il s'agit de quoi, ce festival, au fait ?"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-5/160/s/0
msgctxt "Choix"
msgid "So... \"Mirthday\"?"
msgstr "Alors... le « Mirthday » ?"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-5/c-15/7
msgctxt "Holly"
msgid "Did you even read the flyer, silly?!"
msgstr "Tu as seulement lu le tract, bêta ?!"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-5/c-15/15
msgctxt "Holly"
msgid "Kidding!"
msgstr "Je plaisante !"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-5/c-16/7
msgctxt "Holly"
msgid "Mirthday!"
msgstr "Mirthday !"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-6/3
msgctxt "Holly"
msgid "Well... it's like... a bulk birthday! For everyone, all at once! You get a mirthday, YOU get a Mirthday. YOU'RE. ALL. GETTING. A. MIRTHDAY."
msgstr "Eh bien... c'est comme... un anniversaire en gros ! Pour tout le monde, d'un coup ! Toi, tu as un mirthday, TOI, tu as un Mirthday. VOUS. AVEZ. TOUS. UN. MIRTHDAY."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-6/14
msgctxt "Holly"
msgid "It was nice. None of us objects have a real birthday on account of not being \"born\". But I love birthdays, even if I've never seen one. So it was nice to have our own version."
msgstr "C'était sympa. Aucun de nous, les objets, n'a de vrai anniversaire, vu qu'on n'est pas « nés ». Mais j'adore les anniversaires, même si je n'en ai jamais vu un. Alors c'était chouette d'avoir notre propre version."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-6/22/s/0
msgctxt "Choix"
msgid "Nice or \"nice\"?"
msgstr "Sympa ou « sympa » ?"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-6/23/s/0
msgctxt "Choix"
msgid "Was?"
msgstr "C'était ?"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-6/24/s/0
msgctxt "Choix"
msgid "You don't seem too excited."
msgstr "Tu n'as pas l'air très enthousiaste."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-6/c-17/7
msgctxt "Holly"
msgid "The first one!"
msgstr "Le premier !"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-6/c-18/7
msgctxt "Holly"
msgid "Ahhhh, good catch!!"
msgstr "Ahhhh, bien vu !!"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-6/c-19/7
msgctxt "Holly"
msgid "Ha! I'm not!"
msgstr "Ha ! Je ne le suis pas !"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-7/0
msgctxt "Holly"
msgid "It's a lot of effort, everyone organising that many presents for that many people. I don't blame them for phoning it in eventually."
msgstr "Ça demande beaucoup d'efforts, que tout le monde organise autant de cadeaux pour autant de monde. Je ne leur en veux pas d'avoir fini par faire le service minimum."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-7/8
msgctxt "Holly"
msgid "Folks used to put in the effort, as much as it was. They tried. They cared. But caring is hard, and trying is... trying, and Mirthday just... petered out."
msgstr "Avant, les gens y mettaient de l'énergie, autant que ça en demandait. Ils essayaient. Ils s'en souciaient. Mais se soucier, c'est dur, et essayer, c'est... essayer, et le Mirthday s'est juste... essoufflé."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-7/16
msgctxt "Holly"
msgid "I can make the holidays happen, but I can't MAKE people celebrate. That's up to them."
msgstr "Je peux faire en sorte que les fêtes aient lieu, mais je ne peux pas OBLIGER les gens à faire la fête. Ça, c'est leur affaire."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-7/24/b/1
msgctxt "Holly"
msgid "And to them, nowadays it's an excuse to drink. Which is fine, and it pays the bills-"
msgstr "Et pour eux, aujourd'hui, c'est une excuse pour boire. Ce qui est très bien, et ça paie les factures..."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-7/24/b/9
msgctxt "Holly"
msgid "OH HEY CAM!"
msgstr "OH SALUT CAM !"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-7/24/b/26
msgctxt "Cam"
msgid "Very lame."
msgstr "Très nul."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-7/24/b/34
msgctxt "Cam"
msgid "All of this."
msgstr "Tout ça."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-7/24/b/45
msgctxt "Cam"
msgid "Very."
msgstr "Très."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-7/24/b/56
msgctxt "Holly"
msgid "Hasn't had his coffee grounds yet."
msgstr "Il n'a pas encore pris son café."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-7/24/b/64
msgctxt "Holly"
msgid "He's actually very polite. Cam always waits until everyone else has finished theirs first."
msgstr "Il est en fait très poli. Cam attend toujours que tous les autres aient fini le leur avant de se servir."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-7/27
msgctxt "Holly"
msgid "Now where were we?"
msgstr "Alors, où en étions-nous ?"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-7/35
msgctxt "Holly"
msgid "OH! Yes. Yeah. Drinking on Mirthday. It's fine. People celebrate how they want to."
msgstr "OH ! Oui. Ouais. Boire pendant le Mirthday. C'est bien. Chacun fête comme il veut."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-7/43/s/0
msgctxt "Choix"
msgid "Fine, or 'fine?'"
msgstr "Bien, ou « bien » ?"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-7/c-20/7
msgctxt "Holly"
msgid "Both."
msgstr "Les deux."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-7/c-20/15
msgctxt "Holly"
msgid "Chew on THAT!"
msgstr "Mâche-moi ÇA !"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-7/c-20/23
msgctxt "Holly"
msgid "And while you chew. Next stop: Beddy BYES!"
msgstr "Et pendant que tu mâches. Prochain arrêt : Dodo BYEEES !"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-7/c-20/31
msgctxt "Holly"
msgid "<w>RACE YOU AGAIN!</w>"
msgstr "<w>ON REFAIT LA COURSE !</w>"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-8/3
msgctxt "Narrator"
msgid "This time you beat Holly at her own game, arriving at your bedroom just a few moments before her."
msgstr "Cette fois, vous battez Holly à son propre jeu et arrivez à votre chambre quelques instants avant elle."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-8/11
msgctxt "Holly"
msgid "Holy smokes, whizbot! You're a real speedster!"
msgstr "Mince alors, fusée ! Tu es un vrai bolide !"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-8/19/s/0
msgctxt "Choix"
msgid "You started it."
msgstr "C'est toi qui as commencé."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-8/20/s/0
msgctxt "Choix"
msgid "Feel free to pick up the pace."
msgstr "N'hésite pas à accélérer le rythme."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-8/21/s/0
msgctxt "Choix"
msgid "Barely."
msgstr "À peine."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-8/22/s/0
msgctxt "Choix"
msgid "You set your pace, I set mine."
msgstr "Tu fixes ton rythme, je fixe le mien."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-8/c-21/7
msgctxt "Holly"
msgid "And you finished it. At least THIS time! I'll get you yet, you dastardly demon dasher you!"
msgstr "Et toi, tu y as mis fin. Cette fois-ci, au moins ! Je t'aurai, démon de la vitesse !"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-8/c-22/7
msgctxt "Holly"
msgid "Ohhhhhhh! I'll get you yet, you dastardly dasher you!"
msgstr "Ohhhhhhh ! Je t'aurai, démon de la vitesse !"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-8/c-23/7
msgctxt "Holly"
msgid "Barely's still keeping up. Still is what it is. Kudos to you, I'm pretty quick on my feet."
msgstr "À peine, c'est quand même suivre. Ça reste ce que c'est. Bravo à toi, je suis plutôt rapide sur mes jambes."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-8/c-24/7
msgctxt "Holly"
msgid "Sounds like a challenge."
msgstr "On dirait un défi."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-9/6 holly_holidays/holly3/0/g-9/160
msgctxt "Betty"
msgid "HOLLY!"
msgstr "HOLLY !"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-9/14
msgctxt "Holly"
msgid "Ughhh."
msgstr "Ughhh."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-9/25
msgctxt "Holly"
msgid "Um."
msgstr "Euh."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-9/33
msgctxt "Holly"
msgid "Hi Betty!"
msgstr "Salut Betty !"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-9/41
msgctxt "Holly"
msgid "You look SO GOOD!"
msgstr "Tu as TELLEMENT bonne mine !"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-9/55/b/4
msgctxt "Lux"
msgid "<w>Draaaamaaaaaa!</w>"
msgstr "<w>Draaaamee !</w>"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-9/58
msgctxt "Holly"
msgid "It's been like, too long! I've just been, you know, resting a lot."
msgstr "Ça fait genre, trop longtemps ! J'ai juste, tu sais, beaucoup dormi."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-9/66
msgctxt "Holly"
msgid "Getting lots of rest."
msgstr "Beaucoup de repos."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-9/74
msgctxt "Holly"
msgid "It's been like, super restful."
msgstr "C'était genre, super reposant."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-9/82
msgctxt "Holly"
msgid "I'm just feeling like. Very rested. You know?"
msgstr "Je me sens juste genre. Très reposée. Tu vois ?"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-9/93
msgctxt "Betty"
msgid "PLEASE don't tell me you picked up another shift."
msgstr "Dis-moi PAS que tu as encore pris un service."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-9/117
msgctxt "Holly"
msgid "I picked up another shift."
msgstr "J'ai pris un autre service."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-9/128
msgctxt "Betty"
msgid "...seriously?"
msgstr "...sérieusement ?"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-9/144
msgctxt "Betty"
msgid "When was your last day off?"
msgstr "C'était quand, ton dernier jour de congé ?"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-9/152
msgctxt "Holly"
msgid "I refuse to answer on the grounds that it may incriminate me."
msgstr "Je refuse de répondre, au motif que cela pourrait m'incriminer."

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-9/171
msgctxt "Holly"
msgid "ANYWAY THERE'S THIS SUPER SWEET MIRTHDAY FESTIVAL YOU SHOULD TOTALLY CHECK IT OUT OH MY GOD WE SHOULD GO TOGETHER WOULDN'T THAT BE GREAT?"
msgstr "BREF IL Y A CE FESTIVAL DE MIRTHDAY SUPER SYMPA TU DEVRAIS VRAIMENT Y ALLER OH MON DIEU ON DEVRAIT Y ALLER ENSEMBLE CE SERAIT GÉNIAL NON ?"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-9/185
msgctxt "Holly"
msgid "HERE, TAKE A FLYER! TAKE SOME FOR EVERYONE! OKAY I'M GONNA GO FINISH MY SHIFT AND GET SOME REST LOVE YOU <w>BYEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE.</w>"
msgstr "TIENS, PRENDS UN TRACT ! PRENDS-EN POUR TOUT LE MONDE ! BON JE VAIS FINIR MON SERVICE ET ME REPOSER JE T'AIME <w>BYEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE.</w>"

# Traduction IA – à relire
#: holly_holidays/holly3/0/g-9/193
msgctxt "Holly"
msgid "Meet me in the bathroom."
msgstr "Rejoins-moi dans la salle de bains."

# Traduction IA – à relire
#: holly_holidays/HollyBathroom/0/3
msgctxt "Narrator"
msgid "Holly is in such a rush to escape Betty's potential scolding, she forgets all about racing you—you both make it to the bathroom without losing your breath."
msgstr "Holly est si pressée d'échapper à une éventuelle réprimande de Betty qu'elle en oublie complètement de vous faire courir : vous arrivez toutes deux à la salle de bains sans perdre haleine."

# Traduction IA – à relire
#: holly_holidays/HollyBathroom/0/11
msgctxt "Holly"
msgid "Who-weeeeee. That was close."
msgstr "Ouuuuuf. C'était moins une."

# Traduction IA – à relire
#: holly_holidays/HollyBathroom/0/19/s/0
msgctxt "Choix"
msgid "When WAS your last day off?"
msgstr "C'était QUAND, ton dernier jour de congé ?"

# Traduction IA – à relire
#: holly_holidays/HollyBathroom/0/20/s/0
msgctxt "Choix"
msgid "She seemed concerned."
msgstr "Elle avait l'air inquiète."

# Traduction IA – à relire
#: holly_holidays/HollyBathroom/0/21/s/0
msgctxt "Choix"
msgid "She seemed mad."
msgstr "Elle avait l'air en colère."

# Traduction IA – à relire
#: holly_holidays/HollyBathroom/0/c-0/7
msgctxt "Holly"
msgid "Long enough ago that she'd have a fit, and I actually lied to her about it last time as well."
msgstr "Il y a assez longtemps pour qu'elle fasse une crise, et la dernière fois, je lui ai carrément menti là-dessus aussi."

# Traduction IA – à relire
#: holly_holidays/HollyBathroom/0/c-0/15
msgctxt "Holly"
msgid "So, in essence, I wasn't really lying, at least this time, because I simply refused to answer on the grounds that it may have incriminated me."
msgstr "Donc, au fond, je ne mentais pas vraiment, du moins cette fois, parce que j'ai simplement refusé de répondre au motif que ça aurait pu m'incriminer."

# Traduction IA – à relire
#: holly_holidays/HollyBathroom/0/c-0/23
msgctxt "Holly"
msgid "Confusing enough?"
msgstr "Assez confus ?"

# Traduction IA – à relire
#: holly_holidays/HollyBathroom/0/c-1/7
msgctxt "Holly"
msgid "She's always concerned."
msgstr "Elle est toujours inquiète."

# Traduction IA – à relire
#: holly_holidays/HollyBathroom/0/c-2/7
msgctxt "Holly"
msgid "She's just worried."
msgstr "Elle s'inquiète, c'est tout."

# Traduction IA – à relire
#: holly_holidays/HollyBathroom/0/g-0/0
msgctxt "Holly"
msgid "Betty's a sweetheart. She just gets paranoid I'm getting enough rest. Last Blissmas she gave me the silent treatment until I took a day off work. Everyone said she was worried about me burning out."
msgstr "Betty est un amour. Elle a juste la hantise que je ne me repose pas assez. Au dernier Blissmas, elle m'a fait la tête jusqu'à ce que je prenne un jour de congé. Tout le monde disait qu'elle avait peur que je craque."

# Traduction IA – à relire
#: holly_holidays/HollyBathroom/0/g-0/8
msgctxt "Holly"
msgid "Which is CRAZY by the way. How do you get burnt out over Blissmas? It's way too cold for that."
msgstr "Ce qui est DINGUE, d'ailleurs. Comment on peut être cramée à Blissmas ? Il fait bien trop froid pour ça."

# Traduction IA – à relire
#: holly_holidays/HollyBathroom/0/g-0/16
msgctxt "Holly"
msgid "Betty's a real angel, though."
msgstr "Betty est un vrai ange, cela dit."

# Traduction IA – à relire
#: holly_holidays/HollyBathroom/0/g-0/24/s/0
msgctxt "Choix"
msgid "I've been on the receiving end of Betty's wrath."
msgstr "J'ai déjà fait les frais de la colère de Betty."

# Traduction IA – à relire
#: holly_holidays/HollyBathroom/0/g-0/25/s/0
msgctxt "Choix"
msgid "Yeah, she's just got lots of love to give."
msgstr "Ouais, elle a juste beaucoup d'amour à donner."

# Traduction IA – à relire
#: holly_holidays/HollyBathroom/0/g-0/26/s/0
msgctxt "Choix"
msgid "She is. I understand her, I just had to set some boundaries myself."
msgstr "Oui. Je la comprends, j'ai juste dû poser mes propres limites."

# Traduction IA – à relire
#: holly_holidays/HollyBathroom/0/g-0/27/s/0
msgctxt "Choix"
msgid "She's got a point though."
msgstr "Elle n'a pas tort, pourtant."

# Traduction IA – à relire
#: holly_holidays/HollyBathroom/0/g-0/28/s/0
msgctxt "Choix"
msgid "She can be a little overbearing sometimes."
msgstr "Elle peut être un peu envahissante, parfois."

# Traduction IA – à relire
#: holly_holidays/HollyBathroom/0/g-0/c-3/7
msgctxt "Holly"
msgid "Haven't we all."
msgstr "On l'est tous un peu."

# Traduction IA – à relire
#: holly_holidays/HollyBathroom/0/g-0/c-4/7
msgctxt "Holly"
msgid "And I love that. Mostly!"
msgstr "Et j'adore ça. Surtout !"

# Traduction IA – à relire
#: holly_holidays/HollyBathroom/0/g-0/c-5/7
msgctxt "Holly"
msgid "Come on BOUNDARIES."
msgstr "Allez, LIMITES."

# Traduction IA – à relire
#: holly_holidays/HollyBathroom/0/g-0/c-6/7
msgctxt "Holly"
msgid "Maybe!"
msgstr "Peut-être !"

# Traduction IA – à relire
#: holly_holidays/HollyBathroom/0/g-0/c-7/7
msgctxt "Holly"
msgid "It's all well-intentioned."
msgstr "Tout ça part d'une bonne intention."

# Traduction IA – à relire
#: holly_holidays/HollyBathroom/0/g-1/6
msgctxt "Rebel"
msgid "What's up duckwads!?"
msgstr "Quoi de neuf, bande de canards !?"

# Traduction IA – à relire
#: holly_holidays/holly_duck_hate/0
msgctxt "Rebel"
msgid "Oh."
msgstr "Oh."

# Traduction IA – à relire
#: holly_holidays/holly_duck_hate/8
msgctxt "Rebel"
msgid "It's the human."
msgstr "C'est {{l'humain|l'humaine|l'humain·e}}."

# Traduction IA – à relire
#: holly_holidays/holly_duck_hate/16 holly_holidays/holly_duck_love_friendship/0/g-0/30 holly_holidays/holly_duck_null/19
msgctxt "Rebel"
msgid "Ew."
msgstr "Beurk."

# Traduction IA – à relire
#: holly_holidays/holly_duck_hate/27
msgctxt "Holly"
msgid "Ahh. Already on Rebel's bad side. Don't worry, it's not that hard."
msgstr "Ahh. Déjà dans les mauvaises grâces de Rebel. T'inquiète, c'est pas bien dur."

# Traduction IA – à relire
#: holly_holidays/holly_duck_hate/35
msgctxt "Rebel"
msgid "This one's on some next level high horse Holly."
msgstr "Cette personne est sur un très, très haut cheval, Holly."

# Traduction IA – à relire
#: holly_holidays/holly_duck_hate/43
msgctxt "Rebel"
msgid "Some real sticky beak bullshit."
msgstr "Des conneries de fouine, quoi."

# Traduction IA – à relire
#: holly_holidays/holly_duck_hate/51
msgctxt "Rebel"
msgid "Nose so brown they're frontlining the local scat band."
msgstr "Le nez tellement marron qu'iel est en tête d'affiche du groupe de scat du coin."

# Traduction IA – à relire
#: holly_holidays/holly_duck_hate/59
msgctxt "Rebel"
msgid "Sci be de bu bah bah bunt. I am a motherducking cunt."
msgstr "Chi bi di bou ba ba bou. Je suis une foutue connasse de canard."

# Traduction IA – à relire
