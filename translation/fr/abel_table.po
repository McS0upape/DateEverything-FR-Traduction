# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/8
msgctxt "Narrator"
msgid "Abel appears to be in a state of distress when you come across him."
msgstr "Abel semble en pleine détresse quand vous tombez sur lui."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/16
msgctxt "Narrator"
msgid "He's drumming his fingers along his leg, crossing and uncrossing his arms... something is clearly on his mind."
msgstr "Il pianote sur sa jambe, croise et décroise les bras... quelque chose le tracasse, c'est évident."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/24
msgctxt "Abel"
msgid "Oh hello. I'm just... uh..."
msgstr "Oh, salut. J'suis juste... euh..."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/32
msgctxt "Abel"
msgid "Why do you look so serious?"
msgstr "Pourquoi t'as l'air si sérieux ?"

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/40/s/0
msgctxt "Choix"
msgid "Abel, you have to ask Dasha out."
msgstr "Abel, tu dois inviter Dasha à sortir."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/c-0/7
msgctxt "Narrator"
msgid "Abel does a double-take that would be comical if he didn't look so sincerely alarmed."
msgstr "Abel a un mouvement de recul qui serait comique s'il n'avait pas l'air sincèrement paniqué."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/c-0/18
msgctxt "Abel"
msgid "Dasha? Why?"
msgstr "Dasha ? Pourquoi ?"

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/c-0/26/0/s/0
msgctxt "Choix"
msgid "Don't play dumb."
msgstr "Fais pas l'innocent."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/c-0/26/1/s/0
msgctxt "Choix"
msgid "Why not?"
msgstr "Pourquoi pas ?"

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/c-0/26/2/s/0
msgctxt "Choix"
msgid "Because you're obviously in love with her."
msgstr "Parce que t'es clairement amoureux d'elle."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/c-0/26/c-0/7
msgctxt "Abel"
msgid "I ain't playin' at nothin', amigo."
msgstr "J'fais pas l'innocent du tout, amigo."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/c-0/26/c-0/15
msgctxt "Abel"
msgid "I was just surprised to hear you say 'er name, that's all."
msgstr "J'étais juste surpris de t'entendre dire son nom, c'est tout."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/c-0/26/c-1/7
msgctxt "Abel"
msgid "I, uh, look, you can't just come up to a table and start in with all that kind of talking out the gate."
msgstr "J'... écoute, tu peux pas débarquer comme ça devant une table et lui sortir tout ce baratin d'entrée de jeu."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/c-0/26/c-1/15
msgctxt "Abel"
msgid "I ain't built for all that."
msgstr "J'suis pas taillé pour ça."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/c-0/26/c-2/7
msgctxt "Abel"
msgid "Obviously? In <i>love</i>?"
msgstr "Clairement ? <i>Amoureux</i> ?"

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/c-0/26/c-2/15
msgctxt "Abel"
msgid "Y'all really comin' in HOT today, ain'tcha?"
msgstr "Ben dis donc, t'y vas pas avec le dos de la cuillère aujourd'hui !"

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-0/0/s/0
msgctxt "Choix"
msgid "Look. It's obvious to anyone who spends any amount of time around the two of you."
msgstr "Écoute. Ça saute aux yeux de quiconque passe un peu de temps avec vous deux."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-0/c-1/7
msgctxt "Abel"
msgid "I understand ya mean well, but you can't just walk right up here and start tellin' me who I gotsta ask out."
msgstr "J'sais bien que tu veux bien faire, mais tu peux pas débarquer ici et m'dire qui j'dois inviter."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-0/c-1/15/0/s/0
msgctxt "Choix"
msgid "Are you telling me you don't feel anything for Dasha at all?"
msgstr "Tu veux dire que tu ressens rien du tout pour Dasha ?"

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-0/c-1/15/c-0/7
msgctxt "Abel"
msgid "Well now I ain't said none of that neither."
msgstr "Ben, j'ai jamais dit ça non plus."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-0/c-1/15/c-0/15
msgctxt "Abel"
msgid "I'm just sayin'... there's a reason cowboys ride alone."
msgstr "J'dis juste... c'est pas pour rien que les cow-boys chevauchent seuls."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-0/c-1/15/c-0/23
msgctxt "Abel"
msgid "A reason the sun and the moon never meet in the sky. You know?"
msgstr "C'est pas pour rien que le soleil et la lune se croisent jamais dans le ciel. Tu vois ?"

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-0/c-1/15/c-0/31
msgctxt "Abel"
msgid "A reason the clouds and the mountains can't never be together."
msgstr "C'est pas pour rien que les nuages et les montagnes peuvent jamais être ensemble."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/0/s/0
msgctxt "Choix"
msgid "First of all, none of that makes sense."
msgstr "Premièrement, tout ça n'a aucun sens."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/7
msgctxt "Abel"
msgid "Oh, it makes a ton of sense."
msgstr "Oh, ça a plein de sens, si."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/0/s/0
msgctxt "Choix"
msgid "Second, stop hiding behind your folksy sayings."
msgstr "Deuxièmement, arrête de te cacher derrière tes dictons de terroir."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/7
msgctxt "Abel"
msgid "I ain't hidin'!"
msgstr "J'me cache pas !"

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "I know you're afraid..."
msgstr "Je sais que t'as peur..."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/1/s/0
msgctxt "Choix"
msgid "I'll just tell her you hate her."
msgstr "Je vais juste lui dire que tu la détestes."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/2/s/0
msgctxt "Choix"
msgid "Are you really going to let yourself miss out on happiness?"
msgstr "Tu vas vraiment te laisser passer à côté du bonheur ?"

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/3/s/0
msgctxt "Choix"
msgid "I don't care about you two - what about us?"
msgstr "Vous deux, je m'en fiche. Et nous, alors ?"

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-0/7
msgctxt "Abel"
msgid "Afraid? Me? What?"
msgstr "Peur ? Moi ? Quoi ?"

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-0/15
msgctxt "Abel"
msgid "I ain't never been afeared of nothin'!"
msgstr "J'ai jamais eu peur de rien, moi !"

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-0/23/0/s/0
msgctxt "Choix"
msgid "Getting hurt, for one."
msgstr "D'être blessé, déjà."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-0/23/c-0/7
msgctxt "Abel"
msgid "Oh, it ain't about me. What if she gets hurt?"
msgstr "Oh, c'est pas pour moi. Et si c'est elle qui est blessée ?"

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-0/23/c-0/15/0/s/0
msgctxt "Choix"
msgid "See, you are afraid. Connection brings pain to yourself and others."
msgstr "Tu vois, t'as peur. Le lien qu'on crée fait souffrir soi-même et les autres."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-0/23/c-0/15/c-0/7
msgctxt "Abel"
msgid "Ah, so you get it then."
msgstr "Ah, alors tu comprends."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-0/23/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "But it also brings joy and comfort. You can't have the good without the bad, Abel."
msgstr "Mais il apporte aussi de la joie et du réconfort. On peut pas avoir le bon sans le mauvais, Abel."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-0/23/c-0/15/c-0/15/c-0/7
msgctxt "Abel"
msgid "Hm... ain't followin' ya'..."
msgstr "Hm... j'te suis pas, là..."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-0/23/c-0/15/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "Oh. Uh... it's like... you can't have a horse without having to clean up a little horse poop."
msgstr "Oh. Euh... c'est comme... on peut pas avoir un cheval sans ramasser un peu de crottin."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-0/23/c-0/15/c-0/15/c-0/15/c-0/7
msgctxt "Abel"
msgid "...so even though there's some bad times muckin' out the stables... the bond a cowboy feels with his horse transcends those moments. Is that it?"
msgstr "... alors même s'il y a des mauvais moments à curer l'écurie... le lien entre un cow-boy et son cheval dépasse tout ça. C'est ça ?"

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-0/23/c-0/15/c-0/15/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "Yeah, totally. That."
msgstr "Ouais, carrément. Ça."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-0/23/c-0/15/c-0/15/c-0/15/c-0/15/c-0/7
msgctxt "Narrator"
msgid "Abel sighs, shaking his head. It seems your words have finally hit home."
msgstr "Abel soupire en secouant la tête. On dirait que vos paroles ont fini par faire mouche."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-0/23/c-0/15/c-0/15/c-0/15/c-0/15/c-0/15
msgctxt "Abel"
msgid "...you're right. God, you're right."
msgstr "... t'as raison. Bon sang, t'as raison."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-0/23/c-0/15/c-0/15/c-0/15/c-0/15/c-0/23
msgctxt "Abel"
msgid "I been such a yellow-bellied dadgum FOOL... I almost let an incredible desk like Dasha slip through my got dang fingers."
msgstr "J'ai été un fichu TROUILLARD de première... J'ai failli laisser filer un bureau aussi incroyable que Dasha entre mes sacrés doigts."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-0/23/c-0/15/c-0/15/c-0/15/c-0/15/c-0/31
msgctxt "Abel"
msgid "I... I gotta go. There's somethin' I need to do."
msgstr "Je... faut que j'y aille. J'ai quelque chose à faire."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-0/23/c-0/15/c-0/15/c-0/15/c-0/15/c-0/39/0/s/0
msgctxt "Choix"
msgid "Go get her, Abel."
msgstr "Fonce, Abel."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-1/7 abel_table/us/0/c-2/10
msgctxt "Narrator"
msgid "There's a cold look in Abel's eyes that you've never seen before."
msgstr "Il y a dans le regard d'Abel une froideur que vous ne lui avez jamais vue."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-1/18 abel_table/us/0/c-2/21
msgctxt "Abel"
msgid "...I don't hate her, but I'm startin' to develop some less than kind feelings about you."
msgstr "... j'la déteste pas, mais j'commence à avoir des sentiments pas très aimables à ton égard."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-1/26/0/s/0 abel_table/us/0/c-2/29/0/s/0
msgctxt "Choix"
msgid "Feel free to change my mind."
msgstr "Libre à toi de me faire changer d'avis."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-1/26/c-0/7 abel_table/us/0/c-2/29/g-0/0
msgctxt "Abel"
msgid "Just leave her out of this, and leave me alone."
msgstr "Laisse-la en dehors de ça, et fiche-moi la paix."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-1/26/c-0/15 abel_table/us/0/c-2/29/g-0/8
msgctxt "Abel"
msgid "Ain't no talkin' about a matter this serious with someone like you."
msgstr "On cause pas d'une affaire aussi sérieuse avec quelqu'un comme toi."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-1/26/c-0/20 abel_table/us/0/c-2/29/g-0/13
msgctxt "Abel"
msgid "You ain't got a lick of sensitivity to ya."
msgstr "T'as pas une once de délicatesse."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-1/26/c-0/28/0/s/0 abel_table/us/0/c-2/29/g-0/21/1/s/0
msgctxt "Choix"
msgid "I'm just trying to help you two out."
msgstr "J'essaie juste de vous aider, tous les deux."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-1/26/c-0/28/c-0/7 abel_table/us/0/c-2/29/g-0/21/c-1/7
msgctxt "Abel"
msgid "I got no need for 'help' like yours."
msgstr "J'ai pas besoin d'« aide » comme la tienne."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-1/26/c-0/28/c-0/18 abel_table/us/0/c-2/29/g-0/21/g-0/0
msgctxt "Abel"
msgid "Do me a favor 'n get lost."
msgstr "Rends-moi service et va voir ailleurs."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-1/26/c-0/28/c-0/26/0/s/0 abel_table/us/0/c-2/29/g-0/21/g-0/8/0/s/0
msgctxt "Choix"
msgid "Alright..."
msgstr "D'accord..."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-1/26/c-0/28/c-0/26/c-0/44 abel_table/us/0/c-2/29/g-0/21/g-0/8/c-0/44
msgctxt "Reggie"
msgid "What a dependable guy... Guess you had to <i>table</i> that relationship."
msgstr "Un type si fiable... Faut croire que cette relation n'était pas <i>sur la table</i>."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-1/26/c-0/28/c-0/26/c-0/52 abel_table/us/0/c-2/29/g-0/21/g-0/8/c-0/52
msgctxt "Reggie"
msgid "Pity."
msgstr "Dommage."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-2/7
msgctxt "Abel"
msgid "It ain't about missin' out on happiness!"
msgstr "C'est pas de passer à côté du bonheur, le problème !"

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-2/15
msgctxt "Abel"
msgid "Who wants to miss out on happiness!?"
msgstr "Qui voudrait passer à côté du bonheur !?"

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-2/23
msgctxt "Abel"
msgid "I'm missin' out on PAIN."
msgstr "Moi, j'passe à côté de la SOUFFRANCE."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-2/31
msgctxt "Abel"
msgid "Ya, see... I been in love before. I know what comes at the end."
msgstr "Tu vois... j'ai déjà été amoureux. J'sais comment ça finit."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-2/39
msgctxt "Abel"
msgid "I know what it's like to look in the eyes of someone who looks up to ya and see nothin' but emptiness."
msgstr "J'sais c'que c'est de regarder dans les yeux quelqu'un qui t'admire et d'y voir rien d'autre que du vide."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-2/47/0/s/0
msgctxt "Choix"
msgid "What about the good times, Abel? Don't let the fear of pain overshadow those."
msgstr "Et les bons moments, Abel ? Ne laisse pas la peur de souffrir les éclipser."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-2/47/c-0/7
msgctxt "Abel"
msgid "...I been alone so long now it's hard to remember the good times."
msgstr "... ça fait si longtemps que j'suis seul que j'ai du mal à m'souvenir des bons moments."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-2/47/c-0/15/0/s/0
msgctxt "Choix"
msgid "Then think of all the new, amazing experiences you could have with Dasha."
msgstr "Alors pense à toutes les nouvelles expériences incroyables que tu pourrais vivre avec Dasha."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-2/47/c-0/15/c-0/7
msgctxt "Abel"
msgid "...you're right."
msgstr "... t'as raison."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-2/47/c-0/15/c-0/15
msgctxt "Abel"
msgid "You're... sure she wants me too?"
msgstr "T'es... sûr qu'elle veut de moi, elle aussi ?"

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-2/47/c-0/15/c-0/23/0/s/0
msgctxt "Choix"
msgid "Positive."
msgstr "Certain."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-2/47/c-0/15/c-0/23/c-0/7
msgctxt "Abel"
msgid "Well, how do you know?"
msgstr "Ben, comment tu le sais ?"

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-2/47/c-0/15/c-0/23/c-0/15/0/s/0
msgctxt "Choix"
msgid "She's literally just waiting for you to make the first move."
msgstr "Elle attend littéralement que tu fasses le premier pas."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-2/47/c-0/15/c-0/23/c-0/15/c-0/7
msgctxt "Narrator"
msgid "Abel takes his hat off, scratches his head, then puts his hat back on."
msgstr "Abel ôte son chapeau, se gratte la tête, puis le remet."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-2/47/c-0/15/c-0/23/c-0/15/c-0/15
msgctxt "Abel"
msgid "Huh. I thought we was done with that sorta thing in these modern times."
msgstr "Tiens donc. J'croyais qu'on avait laissé ce genre de chose derrière nous, à notre époque moderne."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-2/47/c-0/15/c-0/23/c-0/15/c-0/23/0/s/0
msgctxt "Choix"
msgid "She's not, Abel."
msgstr "Pas elle, Abel."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-2/47/c-0/15/c-0/23/c-0/15/c-0/23/c-0/7
msgctxt "Abel"
msgid "Sheesh, well, you reckon I should go see her then?"
msgstr "Bon sang, ben... m'est avis que j'devrais aller la voir, alors ?"

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-2/47/c-0/15/c-0/23/c-0/15/c-0/23/c-0/15/0/s/0
msgctxt "Choix"
msgid "I reckon so."
msgstr "M'est avis que oui."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-2/47/c-0/15/c-0/23/c-0/15/c-0/23/c-0/15/c-0/7
msgctxt "Abel"
msgid "All right. I'll mosey right on over there."
msgstr "D'accord. J'traîne mes bottes jusque là-bas."

# Traduction IA – à relire
#: abel_table/abel_cometojesus/0/g-1/c-2/15/c-0/15/c-2/47/c-0/15/c-0/23/c-0/15/c-0/23/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "Let's mosey."
msgstr "Allons traîner nos bottes."

# Traduction IA – à relire
#: abel_table/us/0/10
msgctxt "Abel"
msgid "Us? Ya, mean... You 'n me?"
msgstr "Nous ? Tu veux dire... toi et moi ?"

# Traduction IA – à relire
#: abel_table/us/0/18
msgctxt "Abel"
msgid "Oh... uh... well. I ain't a real decisive guy."
msgstr "Oh... euh... ben. J'suis pas du genre à trancher vite."

# Traduction IA – à relire
#: abel_table/us/0/26
msgctxt "Abel"
msgid "What is it yer lookin' for 'us' to be?"
msgstr "Qu'est-ce que tu voudrais qu'on soit, « nous » ?"

# Traduction IA – à relire
#: abel_table/us/0/34/s/0
msgctxt "Choix"
msgid "I love you, Abel! Do you love me back?"
msgstr "Je t'aime, Abel ! Tu m'aimes aussi ?"

# Traduction IA – à relire
#: abel_table/us/0/35/s/0
msgctxt "Choix"
msgid "I just want us to be friends."
msgstr "Je veux juste qu'on soit amis."

# Traduction IA – à relire
#: abel_table/us/0/36/s/0
msgctxt "Choix"
msgid "Dasha says you hate her. Also I just remembered that tables are boring."
msgstr "Dasha dit que tu la détestes. Et je viens de me rappeler que les tables, c'est barbant."

# Traduction IA – à relire
#: abel_table/us/0/c-0/7
msgctxt "Abel"
msgid "Oh. Well... alright. I aim to please..."
msgstr "Oh. Ben... d'accord. J'suis là pour faire plaisir..."

# Traduction IA – à relire
#: abel_table/us/0/c-0/15
msgctxt "Abel"
msgid "I love you too."
msgstr "Je t'aime aussi."

# Traduction IA – à relire
#: abel_table/us/0/c-0/23
msgctxt "Abel"
msgid "Done and done."
msgstr "Marché conclu."

# Traduction IA – à relire
#: abel_table/us/0/c-0/31 abel_table/us/0/c-1/27
msgctxt "Abel"
msgid "Guess it can be just that easy, huh?"
msgstr "Faut croire que ça peut être aussi simple que ça, hein ?"

# Traduction IA – à relire
#: abel_table/us/0/c-1/11
msgctxt "Abel"
msgid "Can do, buddy."
msgstr "Ça marche, mon pote."

# Traduction IA – à relire
#: abel_table/us/0/c-1/19
msgctxt "Abel"
msgid "You 'n me, amigos 'til the end of time."
msgstr "Toi et moi, amigos jusqu'à la fin des temps."

# Traduction IA – à relire
#: abel_table/us/0/c-2/29/1/s/0
msgctxt "Choix"
msgid "Just sayin' bro."
msgstr "Je dis ça, je dis rien, mon pote."

# Traduction IA – à relire
#: abel_table/us/0/c-2/29/g-0/21/0/s/0
msgctxt "Choix"
msgid "Don't shoot the messenger!"
msgstr "Ne tire pas sur le messager !"

# Traduction IA – à relire
#: abel_table/courage_return/0
msgctxt "Abel"
msgid "Awright awright I'm moseying over to Dasha. Give me a dang minute..."
msgstr "Ça va, ça va, j'y vais, chez Dasha. Laisse-moi une fichue minute..."

# Traduction IA – à relire
#: abel_table/console_table_intro/0/4
msgctxt "Abel"
msgid "Hey there. You wanna watch some TV?"
msgstr "Salut toi. Ça te dit de regarder la télé ?"

# Traduction IA – à relire
#: abel_table/console_table_intro/0/12/s/0
msgctxt "Choix"
msgid "No actually, I came here to see you."
msgstr "Non, en fait, je suis {{venu|venue|venu·e}} te voir."

# Traduction IA – à relire
#: abel_table/console_table_intro/0/c-0/7
msgctxt "Abel"
msgid "Oh wow, that's a real surprise."
msgstr "Oh ben ça, pour une surprise."

# Traduction IA – à relire
#: abel_table/console_table_intro/0/c-0/15
msgctxt "Abel"
msgid "You know, bein' here in the living room... there's all kinda fun stuff to do here that ain't me."
msgstr "Tu sais, ici, dans le salon... y a plein de trucs amusants à faire qui sont pas moi."

# Traduction IA – à relire
#: abel_table/console_table_intro/0/c-0/23
msgctxt "Abel"
msgid "Sure I might hold yer drinks for ya, but you got so many fine options."
msgstr "Bon, j'peux tenir tes boissons, mais t'as plein d'autres options bien plus chouettes."

# Traduction IA – à relire
#: abel_table/console_table_intro/0/c-0/31
msgctxt "Abel"
msgid "Telly's always got all kinds of programs on."
msgstr "Telly passe toujours des tas de programmes."

# Traduction IA – à relire
#: abel_table/console_table_intro/0/g-0/0/b/1
msgctxt "Abel"
msgid "You ought to introduce yerself to 'im when you get a chance. Nice TV... a little energetic, mind. But nice."
msgstr "Tu devrais aller te présenter à lui quand t'auras l'occasion. Gentille télé... un peu agitée, remarque. Mais gentille."

# Traduction IA – à relire
#: abel_table/console_table_intro/0/g-0/3/b/1
msgctxt "Abel"
msgid "But I guess you know all about that—saw you two talkin' just the other day!"
msgstr "Mais j'imagine que tu sais déjà tout ça... j'vous ai vus causer l'autre jour !"

# Traduction IA – à relire
#: abel_table/console_table_intro/0/g-0/6
msgctxt "Abel"
msgid "Connie's another great way to spend yer time here."
msgstr "Connie, c'est une autre super façon de passer ton temps ici."

# Traduction IA – à relire
#: abel_table/console_table_intro/0/g-0/14/s/0 abel_table/landing_spill/0/c-0/15/c-0/37/c-0/50/0/s/0 abel_table/abel_jacques_return/0/g-0/10/s/0
msgctxt "Choix"
msgid "Who?"
msgstr "Qui ?"

# Traduction IA – à relire
#: abel_table/console_table_intro/0/g-0/15/s/0
msgctxt "Choix"
msgid "Yeah we've already met."
msgstr "Ouais, on se connaît déjà."

# Traduction IA – à relire
#: abel_table/console_table_intro/0/g-0/c-1/7
msgctxt "Abel"
msgid "Yer vidya game machine! Dang new-fangled entertainment contraptions... I can barely keep up with TV."
msgstr "Ta machine à jeux vidéo ! Fichues machines à divertissement modernes... J'arrive déjà à peine à suivre la télé."

# Traduction IA – à relire
#: abel_table/console_table_intro/0/g-0/c-2/7
msgctxt "Abel"
msgid "Oh, well that's great. She seems, uh, real nice. But, you know, uh..."
msgstr "Oh, ben c'est chouette. Elle a l'air, euh, bien gentille. Mais, tu sais, euh..."

# Traduction IA – à relire
#: abel_table/console_table_intro/0/g-0/c-2/15
msgctxt "Abel"
msgid "A table like me needs some stability. I can't abide all that chaos 'n repeatin' herself."
msgstr "Une table comme moi a besoin de stabilité. J'supporte pas tout ce chaos et sa manie de se répéter."

# Traduction IA – à relire
#: abel_table/console_table_intro/0/g-1/0
msgctxt "Abel"
msgid "Anyway listen to me go on! All I mean to say is..."
msgstr "Bref, écoute-moi radoter ! Tout c'que j'veux dire, c'est..."

# Traduction IA – à relire
#: abel_table/console_table_intro/0/g-1/8
msgctxt "Abel"
msgid "You got all kinds of things to do in a place like this, and here you are, jawin' with me!"
msgstr "T'as des tas de choses à faire dans un endroit pareil, et te voilà, à tailler une bavette avec moi !"

# Traduction IA – à relire
#: abel_table/console_table_intro/0/g-1/16
msgctxt "Abel"
msgid "I appreciate ya. Ahem. Now then."
msgstr "Ça m'touche. Hum. Bon, alors."

# Traduction IA – à relire
#: abel_table/console_table_intro/0/g-1/24 abel_table/landing_table_no_keith/0/c-0/52 abel_table/kitchen_table_intro/0/g-0/8 abel_table/foyer_table_intro/52 abel_table/coffee_table_intro/0/g-1/32
msgctxt "Abel"
msgid "What can I do ya for?"
msgstr "Qu'est-ce que j'peux faire pour toi ?"

# Traduction IA – à relire
#: abel_table/dining_table_intro/0/4
msgctxt "Abel"
msgid "Hey there. Fancy a meal?"
msgstr "Salut toi. Un petit creux ?"

# Traduction IA – à relire
#: abel_table/dining_table_intro/0/12/s/0
msgctxt "Choix"
msgid "Just here to see you."
msgstr "Je suis juste {{venu|venue|venu·e}} te voir."

# Traduction IA – à relire
#: abel_table/dining_table_intro/0/c-0/7
msgctxt "Abel"
msgid "Hard to have a proper conversation in here."
msgstr "Dur d'avoir une vraie conversation, ici."

# Traduction IA – à relire
#: abel_table/dining_table_intro/0/c-0/15
msgctxt "Abel"
msgid "Location's less'n ideal, y'know."
msgstr "L'emplacement est pas idéal, tu vois."

# Traduction IA – à relire
#: abel_table/dining_table_intro/0/c-0/23
msgctxt "Abel"
msgid "That dang fool Scandalabra NEVER shuts his yap."
msgstr "Ce fichu imbécile de Scandalabra la ferme JAMAIS."

# Traduction IA – à relire
#: abel_table/dining_table_intro/0/c-0/31/0/s/0
msgctxt "Choix"
msgid "I'm sorry, who?"
msgstr "Pardon, qui ?"

# Traduction IA – à relire
#: abel_table/dining_table_intro/0/c-0/31/1/s/0
msgctxt "Choix"
msgid "I can imagine."
msgstr "J'imagine."

# Traduction IA – à relire
#: abel_table/dining_table_intro/0/c-0/31/c-0/7
msgctxt "Abel"
msgid "The dang candelabra. Absolute maniac."
msgstr "Ce fichu chandelier. Un vrai cinglé."

# Traduction IA – à relire
#: abel_table/dining_table_intro/0/g-0/0
msgctxt "Abel"
msgid "Always goin' ON and ON about scandal this'n scandal that."
msgstr "Toujours à causer scandale par-ci, scandale par-là."

# Traduction IA – à relire
#: abel_table/dining_table_intro/0/g-0/8
msgctxt "Abel"
msgid "And effulgin' his got dang knop!"
msgstr "Et à faire reluire son sacré nœud !"

# Traduction IA – à relire
#: abel_table/dining_table_intro/0/g-0/16
msgctxt "Abel"
msgid "Like we ain't all sittin' here in full view."
msgstr "Comme si on était pas tous assis là, aux premières loges."

# Traduction IA – à relire
#: abel_table/dining_table_intro/0/g-0/24
msgctxt "Abel"
msgid "Get a room for that, buddy!"
msgstr "Va faire ça dans ta chambre, mon gars !"

# Traduction IA – à relire
#: abel_table/dining_table_intro/0/g-0/32/s/0
msgctxt "Choix"
msgid "It's a pretty innocent part of his anatomy though, isn't it?"
msgstr "C'est une partie assez innocente de son anatomie, non ?"

# Traduction IA – à relire
#: abel_table/dining_table_intro/0/g-0/33/s/0
msgctxt "Choix"
msgid "Sorry, what? Knop? Effulging?"
msgstr "Pardon, quoi ? Son nœud ? Reluire ?"

# Traduction IA – à relire
#: abel_table/dining_table_intro/0/g-0/c-1/7
msgctxt "Abel"
msgid "Tell that to HIM. He won't stop moanin' and groanin' about it!"
msgstr "Va lui dire, à LUI. Il arrête pas de gémir et de soupirer en le faisant !"

# Traduction IA – à relire
#: abel_table/dining_table_intro/0/g-0/c-1/15
msgctxt "Abel"
msgid "He's like a got dang ghost with a bellyache."
msgstr "On dirait un sacré fantôme qui a mal au ventre."

# Traduction IA – à relire
#: abel_table/dining_table_intro/0/g-0/c-2/7
msgctxt "Abel"
msgid "Ugh... just a fancy way 'o sayin' he's polishin' the little ridge above his base."
msgstr "Pff... c'est juste une façon chic de dire qu'il astique le petit renflement au-dessus de son pied."

# Traduction IA – à relire
#: abel_table/dining_table_intro/0/g-0/c-2/19
msgctxt "Abel"
msgid "He just likes to make it sound as filthy as possible."
msgstr "Il aime juste rendre ça aussi cochon que possible."

# Traduction IA – à relire
#: abel_table/dining_table_intro/0/g-0/c-2/27
msgctxt "Abel"
msgid "Always moanin' and groanin' about it... like a ghost with a bellyache."
msgstr "Toujours à gémir et à soupirer en le faisant... comme un fantôme qui a mal au ventre."

# Traduction IA – à relire
#: abel_table/dining_table_intro/0/g-0/c-2/35/0/s/0
msgctxt "Choix"
msgid "Sounds... interesting."
msgstr "Ça a l'air... intéressant."

# Traduction IA – à relire
#: abel_table/dining_table_intro/0/g-1/0
msgctxt "Abel"
msgid "Guess it ain't all bad though, at least we got Rainey's sweet music here."
msgstr "Faut dire que tout est pas noir, on a la douce musique de Rainey, ici."

# Traduction IA – à relire
#: abel_table/dining_table_intro/0/g-1/8/s/0
msgctxt "Choix"
msgid "Rainey?"
msgstr "Rainey ?"

# Traduction IA – à relire
#: abel_table/dining_table_intro/0/g-1/9/s/0
msgctxt "Choix"
msgid "Love that music she plays."
msgstr "J'adore la musique qu'elle passe."

# Traduction IA – à relire
#: abel_table/dining_table_intro/0/g-1/c-3/7
msgctxt "Abel"
msgid "Record player! Lovely gal, big partier. Always has great music goin'."
msgstr "Le tourne-disque ! Une fille adorable, grande fêtarde. Toujours de la bonne musique."

# Traduction IA – à relire
#: abel_table/dining_table_intro/0/g-2/0
msgctxt "Abel"
msgid "Yup! Makes puttin' up with Scandalabra a little easier."
msgstr "Ouaip ! Ça rend Scandalabra un peu plus supportable."

# Traduction IA – à relire
#: abel_table/dining_table_intro/0/g-2/8
msgctxt "Abel"
msgid "Aw, but look at me, jawin' about all that like we ain't got nothin' but time."
msgstr "Oh, mais regarde-moi, à causer de tout ça comme si on avait tout le temps du monde."

# Traduction IA – à relire
#: abel_table/dining_table_intro/0/g-2/16/s/0
msgctxt "Choix"
msgid "Don't we?"
msgstr "Ce n'est pas le cas ?"

# Traduction IA – à relire
#: abel_table/dining_table_intro/0/g-2/17/s/0
msgctxt "Choix"
msgid "Is everything okay?"
msgstr "Tout va bien ?"

# Traduction IA – à relire
#: abel_table/dining_table_intro/0/g-3/11 abel_table/end_table_intro/0/g-4/11 abel_table/abel_fourth_chat/0/g-3/0
msgctxt "Abel"
msgid "Let me get back to work."
msgstr "Faut que j'retourne au boulot."

# Traduction IA – à relire
#: abel_table/end_table_intro/0/4
msgctxt "Abel"
msgid "Someone there?"
msgstr "Y a quelqu'un ?"

# Traduction IA – à relire
#: abel_table/end_table_intro/0/12/s/0
msgctxt "Choix"
msgid "Yeah, it's me, Abel!"
msgstr "Oui, c'est moi, Abel !"

# Traduction IA – à relire
#: abel_table/end_table_intro/0/13/s/0
msgctxt "Choix"
msgid "Just little old me."
msgstr "Juste ma petite personne."

# Traduction IA – à relire
#: abel_table/end_table_intro/0/g-0/0
msgctxt "Abel"
msgid "Heh. Wasn't expectin' to see ya here."
msgstr "Héhé. J'm'attendais pas à te voir ici."

# Traduction IA – à relire
#: abel_table/end_table_intro/0/g-0/8
msgctxt "Abel"
msgid "The End Table is where I like to go when I want to be all alone with my thoughts."
msgstr "La table de chevet, c'est là que j'aime venir quand j'veux être seul avec mes pensées."

# Traduction IA – à relire
#: abel_table/end_table_intro/0/g-0/16
msgctxt "Abel"
msgid "The view here's pretty nice, makes me feel real thoughtful."
msgstr "La vue est plutôt jolie, d'ici, ça m'rend tout songeur."

# Traduction IA – à relire
#: abel_table/end_table_intro/0/g-0/24/s/0
msgctxt "Choix"
msgid "It sure is."
msgstr "C'est vrai."

# Traduction IA – à relire
#: abel_table/end_table_intro/0/g-0/25/s/0
msgctxt "Choix"
msgid "You mean the view of me sleeping?"
msgstr "Tu veux dire la vue sur moi en train de dormir ?"

# Traduction IA – à relire
#: abel_table/end_table_intro/0/g-0/c-2/7
msgctxt "Abel"
msgid "Oh, glad you understand."
msgstr "Oh, content que tu comprennes."

# Traduction IA – à relire
#: abel_table/end_table_intro/0/g-0/c-3/7
msgctxt "Abel"
msgid "W-what!? Tarnation! No!"
msgstr "Q-quoi !? Sacrebleu ! Non !"

# Traduction IA – à relire
#: abel_table/end_table_intro/0/g-0/c-3/15
msgctxt "Abel"
msgid "I was just sayin'... y'know, the view... the expanse o' blanket. The windows."
msgstr "J'disais juste... tu vois, la vue... l'étendue de la couverture. Les fenêtres."

# Traduction IA – à relire
#: abel_table/end_table_intro/0/g-0/c-3/23
msgctxt "Abel"
msgid "Makes ya appreciate nature's majesty."
msgstr "Ça fait apprécier la majesté de la nature."

# Traduction IA – à relire
#: abel_table/end_table_intro/0/g-1/0
msgctxt "Abel"
msgid "You came at the best time for a talk."
msgstr "Tu tombes pile au bon moment pour causer."

# Traduction IA – à relire
#: abel_table/end_table_intro/0/g-1/8
msgctxt "Abel"
msgid "Much as I like to be in here to think, sometimes it's tough."
msgstr "J'ai beau aimer venir réfléchir ici, des fois c'est dur."

# Traduction IA – à relire
#: abel_table/end_table_intro/0/g-1/16
msgctxt "Abel"
msgid "Betty is sweet as pie, but sometimes a table's got to think on his own."
msgstr "Betty est douce comme un agneau, mais des fois une table a besoin de réfléchir seule."

# Traduction IA – à relire
#: abel_table/end_table_intro/0/g-1/24
msgctxt "Abel"
msgid "But Betty's company's a darn sight better for thinkin' than those dang Hanks."
msgstr "Mais pour réfléchir, la compagnie de Betty vaut cent fois mieux que ces fichus Hanks."

# Traduction IA – à relire
#: abel_table/end_table_intro/0/g-1/32/s/0
msgctxt "Choix"
msgid "Hanks?"
msgstr "Hanks ?"

# Traduction IA – à relire
#: abel_table/end_table_intro/0/g-1/33/s/0
msgctxt "Choix"
msgid "Haha I know what you mean."
msgstr "Haha, je vois ce que tu veux dire."

# Traduction IA – à relire
#: abel_table/end_table_intro/0/g-1/c-4/7
msgctxt "Abel"
msgid "The hangers!"
msgstr "Les cintres !"

# Traduction IA – à relire
#: abel_table/end_table_intro/0/g-2/0
msgctxt "Abel"
msgid "There's so goddang many of them, and they're always jumpin', jumpin', jumpin'."
msgstr "Y en a un sacré paquet, et ils arrêtent pas de sauter, sauter, sauter."

# Traduction IA – à relire
#: abel_table/end_table_intro/0/g-2/11
msgctxt "Abel"
msgid "Crashing round in that closet like five bulls on a trampoline."
msgstr "Ils font un boucan dans ce placard, on dirait cinq taureaux sur un trampoline."

# Traduction IA – à relire
#: abel_table/end_table_intro/0/g-2/19
msgctxt "Abel"
msgid "It's just too dang much."
msgstr "C'est juste beaucoup trop, bon sang."

# Traduction IA – à relire
#: abel_table/end_table_intro/0/g-2/27
msgctxt "Abel"
msgid "And then you got Ben-hwa."
msgstr "Et puis y a Ben-hwa."

# Traduction IA – à relire
#: abel_table/end_table_intro/0/g-2/35/s/0
msgctxt "Choix"
msgid "Ben-what-now?"
msgstr "Ben-quoi ?"

# Traduction IA – à relire
#: abel_table/end_table_intro/0/g-2/36/s/0 abel_table/end_spill/0/g-0/52/s/0
msgctxt "Choix"
msgid "What's wrong with Ben-hwa?"
msgstr "Qu'est-ce qui cloche avec Ben-hwa ?"

# Traduction IA – à relire
#: abel_table/end_table_intro/0/g-2/c-6/7
msgctxt "Abel"
msgid "Oak almighty don't make me say it."
msgstr "Chêne tout-puissant, m'oblige pas à le dire."

# Traduction IA – à relire
#: abel_table/end_table_intro/0/g-2/c-6/18
msgctxt "Abel"
msgid "They're a... you know."
msgstr "C'est des... tu vois."

# Traduction IA – à relire
#: abel_table/end_table_intro/0/g-2/c-6/23
msgctxt "Abel"
msgid "Eh, one of them, then, yeah."
msgstr "Euh, un de ceux-là, ouais."

# Traduction IA – à relire
#: abel_table/end_table_intro/0/g-2/c-6/31
msgctxt "Abel"
msgid "Uh, Intimate Marital Aids."
msgstr "Euh, des accessoires d'intimité conjugale."

# Traduction IA – à relire
#: abel_table/end_table_intro/0/g-3/0
msgctxt "Narrator"
msgid "Abel looks like he'd rather talk about anything else. He lowers his voice like he's speaking of something truly scandalous."
msgstr "Abel a l'air de préférer parler de n'importe quoi d'autre. Il baisse la voix comme s'il évoquait un véritable scandale."

# Traduction IA – à relire
#: abel_table/end_table_intro/0/g-3/8
msgctxt "Abel"
msgid "Oh, that one never stops talking about S.E.X."
msgstr "Oh, ce machin-là arrête jamais de parler de S.E.X.E."

# Traduction IA – à relire
#: abel_table/end_table_intro/0/g-3/16
msgctxt "Abel"
msgid "Askin' me if anyone's polishin' my surfaces lately..."
msgstr "À m'demander si quelqu'un m'a astiqué le plateau ces temps-ci..."

# Traduction IA – à relire
#: abel_table/end_table_intro/0/g-3/21
msgctxt "Abel"
msgid "Tellin' me stories about their... conquests..."
msgstr "À m'raconter ses... conquêtes..."

# Traduction IA – à relire
#: abel_table/end_table_intro/0/g-3/29
msgctxt "Abel"
msgid "I'm an old-fashioned kinda table, dang it! That kinda talk's s'posed to be private!"
msgstr "J'suis une table à l'ancienne, nom d'une pipe ! Ce genre de discussion, ça reste privé !"

# Traduction IA – à relire
#: abel_table/end_table_intro/0/g-3/34
msgctxt "Abel"
msgid "Oh, but look at me, you came here to talk to me, not any of those guys."
msgstr "Oh, mais regarde-moi, t'es {{venu|venue|venu·e}} me parler à moi, pas à ces zigotos."

# Traduction IA – à relire
#: abel_table/end_table_intro/0/g-3/42/s/0
msgctxt "Choix"
msgid "Are you okay?"
msgstr "Ça va ?"

# Traduction IA – à relire
#: abel_table/end_table_intro/0/g-3/43/s/0
msgctxt "Choix"
msgid "Bro. Spill."
msgstr "Mec. Crache le morceau."

# Traduction IA – à relire
#: abel_table/landing_table_no_keith/0/4
msgctxt "Abel"
msgid "...hm..."
msgstr "... hm..."

# Traduction IA – à relire
#: abel_table/landing_table_no_keith/0/12/s/0
msgctxt "Choix"
msgid "Hi Abel."
msgstr "Salut, Abel."

# Traduction IA – à relire
#: abel_table/landing_table_no_keith/0/c-0/7
msgctxt "Abel"
msgid "Oh, hey there."
msgstr "Oh, salut toi."

# Traduction IA – à relire
#: abel_table/landing_table_no_keith/0/c-0/15
msgctxt "Abel"
msgid "Surprised t'see ya here in the hallway."
msgstr "Surpris de te voir ici, dans le couloir."

# Traduction IA – à relire
#: abel_table/landing_table_no_keith/0/c-0/20
msgctxt "Abel"
msgid "Oh, the places we could chat, and you came here."
msgstr "Avec tous les endroits où on pourrait causer, t'es {{venu|venue|venu·e}} ici."

# Traduction IA – à relire
#: abel_table/landing_table_no_keith/0/c-0/28
msgctxt "Abel"
msgid "To the... hallway."
msgstr "Dans le... couloir."

# Traduction IA – à relire
#: abel_table/landing_table_no_keith/0/c-0/36
msgctxt "Abel"
msgid "There's nothing to do here but wait for someone to pass you by."
msgstr "Y a rien à faire ici, à part attendre que quelqu'un passe."

# Traduction IA – à relire
#: abel_table/landing_table_no_keith/0/c-0/44
msgctxt "Abel"
msgid "But hey. You're here now, and I ain't about to take up all your time complainin'."
msgstr "Mais bon. T'es là maintenant, et j'vais pas te prendre tout ton temps à me plaindre."

# Traduction IA – à relire
#: abel_table/landing_table_keith/4
msgctxt "Abel"
msgid "Hey you!"
msgstr "Salut toi !"

# Traduction IA – à relire
#: abel_table/landing_table_keith/12/b/1
msgctxt "Abel"
msgid "Things've changed since we last talked here."
msgstr "Les choses ont changé depuis la dernière fois qu'on a causé ici."

# Traduction IA – à relire
#: abel_table/landing_table_keith/12/b/9
msgctxt "Abel"
msgid "The hallway ain't too bad now with ol' keith around."
msgstr "Le couloir est pas si mal maintenant que le vieux Keith est là."

# Traduction IA – à relire
#: abel_table/landing_table_keith/12/b/17
msgctxt "Abel"
msgid "Oh, he gives the best advice... he's really seen it all."
msgstr "Oh, c'est lui qui donne les meilleurs conseils... il en a vu de toutes les couleurs."

# Traduction IA – à relire
#: abel_table/landing_table_keith/12/b/25
msgctxt "Abel"
msgid "I'm real fond of a lotta the objects in this house, but Keith? Ooh, he's got my full respect."
msgstr "J'aime bien plein d'objets dans cette maison, mais Keith ? Hou, il a tout mon respect."

# Traduction IA – à relire
#: abel_table/landing_table_keith/12/b/33
msgctxt "Abel"
msgid "Ain't never met a key like him."
msgstr "J'ai jamais rencontré une clé comme lui."

# Traduction IA – à relire
#: abel_table/landing_table_keith/12/b/41
msgctxt "Abel"
msgid "But enough about him."
msgstr "Mais assez parlé de lui."

# Traduction IA – à relire
#: abel_table/landing_table_keith/15
msgctxt "Abel"
msgid "What's goin' on?"
msgstr "Quoi de neuf ?"

# Traduction IA – à relire
#: abel_table/kitchen_table_intro/0/4
msgctxt "Abel"
msgid "Hey there! I'd say fancy seein' you here... but you're here all the time, ain'tcha?"
msgstr "Salut toi ! J'dirais bien « quelle surprise de te voir ici »... mais t'es tout le temps ici, pas vrai ?"

# Traduction IA – à relire
#: abel_table/kitchen_table_intro/0/12
msgctxt "Abel"
msgid "Lots to do in the kitchen, after all... lots to eat n' drink. But I gotta tell ya..."
msgstr "Faut dire, y a de quoi faire dans la cuisine... de quoi manger et boire à volonté. Mais j'vais te dire..."

# Traduction IA – à relire
#: abel_table/kitchen_table_intro/0/20
msgctxt "Abel"
msgid "Kitchen table's real unique among all the other tables in this house."
msgstr "La table de la cuisine, c'est vraiment une table unique parmi toutes celles de cette maison."

# Traduction IA – à relire
#: abel_table/kitchen_table_intro/0/28
msgctxt "Abel"
msgid "You know this'n's the only one with three legs?"
msgstr "Tu savais que c'est la seule qui a trois pieds ?"

# Traduction IA – à relire
#: abel_table/kitchen_table_intro/0/36
msgctxt "Abel"
msgid "And it's the most stable of all. Really tells you something, don't it?"
msgstr "Et c'est la plus stable de toutes. Ça en dit long, hein ?"

# Traduction IA – à relire
#: abel_table/kitchen_table_intro/0/44
msgctxt "Abel"
msgid "A beautiful lesson in independence... and relyin' only on yerself."
msgstr "Une belle leçon d'indépendance... et de compter que sur soi-même."

# Traduction IA – à relire
#: abel_table/kitchen_table_intro/0/52
msgctxt "Abel"
msgid "Ah heck, look at me! Goin' on and on about table legs!"
msgstr "Ah, flûte, regarde-moi ! À causer pieds de table pendant des heures !"

# Traduction IA – à relire
#: abel_table/kitchen_table_intro/0/60/s/0
msgctxt "Choix"
msgid "I love it when you talk about tables."
msgstr "J'adore quand tu parles de tables."

# Traduction IA – à relire
#: abel_table/kitchen_table_intro/0/61/s/0
msgctxt "Choix"
msgid "It's okay. You can be weird sometimes."
msgstr "C'est pas grave. T'as le droit d'être bizarre, des fois."

# Traduction IA – à relire
#: abel_table/kitchen_table_intro/0/c-0/7
msgctxt "Abel"
msgid "Gosh, thanks."
msgstr "Ben, merci."

# Traduction IA – à relire
#: abel_table/kitchen_table_intro/0/c-1/7
msgctxt "Abel"
msgid "<i>cough</i>"
msgstr "<i>tousse</i>"

# Traduction IA – à relire
#: abel_table/kitchen_table_intro/0/g-0/0
msgctxt "Abel"
msgid "I'm sure you wanted somethin', so tell me..."
msgstr "J'suis sûr que tu voulais quelque chose, alors dis-moi..."

# Traduction IA – à relire
#: abel_table/foyer_table_intro/4
msgctxt "Abel"
msgid "Well well well, look who it is."
msgstr "Tiens, tiens, tiens, regardez qui voilà."

# Traduction IA – à relire
#: abel_table/foyer_table_intro/12
msgctxt "Abel"
msgid "Y'know it's funny, bein' here in the foyer... I got the best seat in the house to keep an eye on everybody's comings and goings."
msgstr "Tu sais, c'est marrant, ici dans l'entrée... j'ai la meilleure place de la maison pour surveiller les allées et venues de tout le monde."

# Traduction IA – à relire
#: abel_table/foyer_table_intro/20
msgctxt "Abel"
msgid "But you ain't left the house in so dang long... seems like I only see ya here when it's time to pick up a package."
msgstr "Mais ça fait une sacrée paye que t'es pas {{sorti|sortie|sorti·e}} de la maison... j'ai l'impression de te voir ici que quand faut récupérer un colis."

# Traduction IA – à relire
#: abel_table/foyer_table_intro/28
msgctxt "Abel"
msgid "Not that I'm judgin', mind—just ain't exactly livin' up to the full potential of the position here, am I?"
msgstr "Attention, j'juge pas, hein... mais j'exploite pas vraiment tout le potentiel du poste, pas vrai ?"

# Traduction IA – à relire
#: abel_table/foyer_table_intro/36
msgctxt "Abel"
msgid "But hey, I do my job no matter the circumstances. So don't you worry about me!"
msgstr "Mais bon, j'fais mon boulot quelles que soient les circonstances. Alors t'en fais pas pour moi !"

# Traduction IA – à relire
#: abel_table/foyer_table_intro/44
msgctxt "Abel"
msgid "Now then... I'm sure you got somethin' on your mind."
msgstr "Bon, alors... j'suis sûr que t'as quelque chose en tête."

# Traduction IA – à relire
#: abel_table/coffee_table_intro/0/4
msgctxt "Abel"
msgid "Hey there, partner! Nice of you to drop by this place."
msgstr "Salut, partenaire ! C'est gentil de passer par ici."

# Traduction IA – à relire
#: abel_table/coffee_table_intro/0/12
msgctxt "Abel"
msgid "It's real easy to overlook a coffee table, y'know..."
msgstr "C'est vite fait d'oublier une table basse, tu sais..."

# Traduction IA – à relire
#: abel_table/coffee_table_intro/0/20
msgctxt "Abel"
msgid "Coffee table's got to play host to all kinds 'a beverages and snacks while the main event's goin' on... ain't nobody interested in ya as long as you're gettin' the job done."
msgstr "La table basse doit accueillir toutes sortes de boissons et d'en-cas pendant le spectacle... personne fait attention à toi tant que tu fais le boulot."

# Traduction IA – à relire
#: abel_table/coffee_table_intro/0/28
msgctxt "Abel"
msgid "And speakin' of the main event..."
msgstr "Et en parlant de spectacle..."

# Traduction IA – à relire
#: abel_table/coffee_table_intro/0/36
msgctxt "Abel"
msgid "I'm more of a radio guy myself but I been real into this show lately... Real Houseknives of Dallas."
msgstr "Moi, j'suis plutôt radio, mais j'me suis pris de passion pour une émission ces temps-ci... Les Vraies Couteaux au foyer de Dallas."

# Traduction IA – à relire
#: abel_table/coffee_table_intro/0/44
msgctxt "Abel"
msgid "Oh, you wouldn't believe what those utensils argue about. Charity events and who ended up in who's drawer. Hoo-wee! Ridiculous."
msgstr "Oh, tu croirais pas pourquoi ces ustensiles se disputent. Des galas de charité, qui a fini dans le tiroir de qui. Hou là ! Ridicule."

# Traduction IA – à relire
#: abel_table/coffee_table_intro/0/52
msgctxt "Abel"
msgid "Talk about sharp tongues! Heh heh. Woo!"
msgstr "Elles ont la langue bien affûtée, j'te dis ! Héhé. Hou !"

# Traduction IA – à relire
#: abel_table/coffee_table_intro/0/60/s/0
msgctxt "Choix"
msgid "You don't strike me as a Real Houseknives kinda guy, Abel."
msgstr "Je t'imaginais pas fan des Vraies Couteaux au foyer, Abel."

# Traduction IA – à relire
#: abel_table/coffee_table_intro/0/c-0/7
msgctxt "Abel"
msgid "That's what Koa says. Try as I might, I can't seem to get him to see the appeal of the wives."
msgstr "C'est c'que dit Koa. J'ai beau essayer, j'arrive pas à lui faire voir le charme de ces dames."

# Traduction IA – à relire
#: abel_table/coffee_table_intro/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "Koa?"
msgstr "Koa ?"

# Traduction IA – à relire
#: abel_table/coffee_table_intro/0/c-0/15/1/s/0
msgctxt "Choix"
msgid "Koa's fun in his own way, though."
msgstr "Koa est marrant à sa manière, cela dit."

# Traduction IA – à relire
#: abel_table/coffee_table_intro/0/c-0/15/c-0/7
msgctxt "Abel"
msgid "You know, that lovely comfy couch. Nice feller."
msgstr "Tu sais, ce joli canapé tout confortable. Un brave type."

# Traduction IA – à relire
#: abel_table/coffee_table_intro/0/c-0/15/c-1/7
msgctxt "Abel"
msgid "Right you are. Though sometimes I feel he's shut tighter than a clam, and that's coming from me."
msgstr "T'as raison. Même si des fois j'le trouve plus fermé qu'une huître, et c'est moi qui dis ça."

# Traduction IA – à relire
#: abel_table/coffee_table_intro/0/g-0/0
msgctxt "Abel"
msgid "At least Kopi's into 'em."
msgstr "Au moins, Kopi est fan."

# Traduction IA – à relire
#: abel_table/coffee_table_intro/0/g-0/8/s/0
msgctxt "Choix"
msgid "Kopi?"
msgstr "Kopi ?"

# Traduction IA – à relire
#: abel_table/coffee_table_intro/0/g-0/9/s/0
msgctxt "Choix"
msgid "I wouldn't have thought Kopi liked reality tv."
msgstr "J'aurais pas cru que Kopi aimait la téléréalité."

# Traduction IA – à relire
#: abel_table/coffee_table_intro/0/g-0/c-1/7
msgctxt "Abel"
msgid "Coffeemaker! Makes a mean cuppa joe."
msgstr "La cafetière ! Elle fait un sacré bon jus de chaussette."

# Traduction IA – à relire
#: abel_table/coffee_table_intro/0/g-0/c-1/18
msgctxt "Abel"
msgid "Fancy ones too. But that ain't for me."
msgstr "Des trucs chics aussi. Mais c'est pas pour moi."

# Traduction IA – à relire
#: abel_table/coffee_table_intro/0/g-0/c-2/7
msgctxt "Abel"
msgid "I wouldn'ta guessed myself, but ya see what happens when ya judge a book by its cover!"
msgstr "J'l'aurais pas deviné non plus, mais tu vois c'qui arrive quand on juge un livre à sa couverture !"

# Traduction IA – à relire
#: abel_table/coffee_table_intro/0/g-0/c-2/15
msgctxt "Abel"
msgid "Anyway, she's real big on Houseknives."
msgstr "Bref, elle est super fan des Couteaux au foyer."

# Traduction IA – à relire
#: abel_table/coffee_table_intro/0/g-1/0
msgctxt "Abel"
msgid "She didn't used to be... But she'd be comin' and goin' makin' drinks."
msgstr "Elle l'était pas, avant... Mais elle faisait des allers-retours pour préparer des boissons."

# Traduction IA – à relire
#: abel_table/coffee_table_intro/0/g-1/8
msgctxt "Abel"
msgid "Askin' me about why this one don't like the other one..."
msgstr "À m'demander pourquoi celle-ci aime pas celle-là..."

# Traduction IA – à relire
#: abel_table/coffee_table_intro/0/g-1/16
msgctxt "Abel"
msgid "Next thing you know, she's joining me on the couch and having her own opinions. Heh heh heh."
msgstr "Et avant que tu t'en rendes compte, la voilà sur le canapé avec moi, avec ses propres avis. Héhéhé."

# Traduction IA – à relire
#: abel_table/coffee_table_intro/0/g-1/24
msgctxt "Abel"
msgid "But you ain't come here to talk to me about Houseknives, didja. So tell me..."
msgstr "Mais t'es pas {{venu|venue|venu·e}} me parler des Couteaux au foyer, hein. Alors dis-moi..."

# Traduction IA – à relire
#: abel_table/record_table_intro/4
msgctxt "Abel"
msgid "Real decent of you to come see me here, with a beauty like Rainey around."
msgstr "C'est bien chic de ta part de venir me voir ici, avec une beauté comme Rainey dans les parages."

# Traduction IA – à relire
#: abel_table/record_table_intro/12
msgctxt "Abel"
msgid "Well hell, I wouldn't blame ya for not even knowin' I was here!"
msgstr "Ben sapristi, j't'en voudrais même pas de pas savoir que j'étais là !"

# Traduction IA – à relire
#: abel_table/record_table_intro/20
msgctxt "Abel"
msgid "I don't mind, though. Supportin' Rainey while she makes her beautiful music is a real pleasure."
msgstr "Ça m'dérange pas, remarque. Soutenir Rainey pendant qu'elle fait sa belle musique, c'est un vrai plaisir."

# Traduction IA – à relire
#: abel_table/record_table_intro/28
msgctxt "Abel"
msgid "The nicest record player too—always thankin' me for holdin' her up and lettin' her do her thing."
msgstr "Le plus gentil des tourne-disques, en plus... toujours à me remercier de la tenir et de la laisser faire son truc."

# Traduction IA – à relire
#: abel_table/record_table_intro/36
msgctxt "Abel"
msgid "Ah, nice to see a star like her be so humble."
msgstr "Ah, ça fait plaisir de voir une star comme elle rester si modeste."

# Traduction IA – à relire
#: abel_table/record_table_intro/44
msgctxt "Abel"
msgid "But you don't look like you're here for a song today, are ya?"
msgstr "Mais t'as pas l'air d'être là pour une chanson aujourd'hui, si ?"

# Traduction IA – à relire
#: abel_table/record_table_intro/52
msgctxt "Abel"
msgid "Heh, what can I do ya for?"
msgstr "Hé, qu'est-ce que j'peux faire pour toi ?"

# Traduction IA – à relire
#: abel_table/dining_jobs_done/0
msgctxt "Narrator"
msgid "Abel does a funny little dance, sticking his leg out and shaking it at you."
msgstr "Abel fait une drôle de petite danse, tendant la jambe pour la secouer devant vous."

# Traduction IA – à relire
#: abel_table/dining_jobs_done/8
msgctxt "Abel"
msgid "Hahahah! Look at that! My leg's still doin' great thanks to you."
msgstr "Hahahah ! Regarde-moi ça ! Ma jambe tient toujours le coup grâce à toi."

# Traduction IA – à relire
#: abel_table/dining_jobs_done/16
msgctxt "Abel"
msgid "All's well here, amigo. I'm gonna get back to doin' my job."
msgstr "Tout va bien par ici, amigo. J'retourne à mon boulot."

# Traduction IA – à relire
#: abel_table/kitchen_alls_good/0
msgctxt "Abel"
msgid "All's well here in the kitchen!"
msgstr "Tout va bien par ici, dans la cuisine !"

# Traduction IA – à relire
#: abel_table/kitchen_alls_good/8
msgctxt "Abel"
msgid "Well, mostly. I... I <i>am</i> feelin' a mite peckish. Might get a bite to eat."
msgstr "Enfin, presque. J'ai... j'ai <i>un</i> petit creux. J'vais p't-être grignoter un bout."

# Traduction IA – à relire
#: abel_table/kitchen_alls_good/16
msgctxt "Abel"
msgid "But everything's great otherwise."
msgstr "Mais à part ça, tout est au poil."

# Traduction IA – à relire
#: abel_table/foyer_alls_good/0
msgctxt "Abel"
msgid "All's well here in the foyer, amigo!"
msgstr "Tout va bien par ici, dans l'entrée, amigo !"

# Traduction IA – à relire
#: abel_table/foyer_alls_good/8
msgctxt "Abel"
msgid "Would be nice if more folks came over... I'd love to see more of 'em comin' through here."
msgstr "Ce serait bien que plus de gens passent... J'adorerais en voir défiler davantage par ici."

# Traduction IA – à relire
#: abel_table/foyer_alls_good/16
msgctxt "Abel"
msgid "Oh, but don't you worry about that. Just keep doing what you're doing."
msgstr "Oh, mais t'en fais pas pour ça. Continue ce que tu fais."

# Traduction IA – à relire
#: abel_table/landing_jobs_done/0
msgctxt "Abel"
msgid "All's well up here in the landing!"
msgstr "Tout va bien là-haut, sur le palier !"

# Traduction IA – à relire
#: abel_table/landing_jobs_done/8
msgctxt "Abel"
msgid "Always a pleasure to see ya comin' up to get some rest."
msgstr "Toujours un plaisir de te voir monter te reposer."

# Traduction IA – à relire
#: abel_table/landing_jobs_done/16
msgctxt "Abel"
msgid "Not that I'm watchin you sleep or nothin, I'm just a fan of rest. Heh heh."
msgstr "Attention, j'te regarde pas dormir ni rien, j'suis juste un grand fan du repos. Héhé."

# Traduction IA – à relire
#: abel_table/coffee_alls_good/0
msgctxt "Abel"
msgid "All's well here in the living room!"
msgstr "Tout va bien par ici, dans le salon !"

# Traduction IA – à relire
#: abel_table/coffee_alls_good/8/b/1
msgctxt "Abel"
msgid "Been workin' real hard today... think I might take five and go get some coffee with Koa."
msgstr "J'ai trimé dur aujourd'hui... j'vais p't-être faire une pause et aller boire un café avec Koa."

# Traduction IA – à relire
#: abel_table/end_alls_good/4 abel_table/end_alls_good_2/0
msgctxt "Abel"
msgid "All's well here at the end table."
msgstr "Tout va bien par ici, à la table de chevet."

# Traduction IA – à relire
#: abel_table/end_alls_good/15
msgctxt "Ben-hwa"
msgid "Don't listen to him. He's only just calmed down."
msgstr "L'écoute pas. Il vient tout juste de se calmer."

# Traduction IA – à relire
#: abel_table/end_alls_good/26
msgctxt "Abel"
msgid "Now don't you start..."
msgstr "Tu vas pas recommencer..."

# Traduction IA – à relire
#: abel_table/end_alls_good/34
msgctxt "Ben-hwa"
msgid "He was laying into me about keeping a lid on my lubes... and I told him if he was so interested in what I do with my lube-"
msgstr "Il me sermonnait pour que je range mes lubrifiants... et je lui ai dit que si ce que je fais avec mon lubrifiant l'intéressait tant que ça..."

# Traduction IA – à relire
#: abel_table/end_alls_good/42
msgctxt "Abel"
msgid "ALL'S WELL HERE AT THE END TABLE! NOTHIN' TO SEE HERE, FRIEND!"
msgstr "TOUT VA BIEN PAR ICI, À LA TABLE DE CHEVET ! Y A RIEN À VOIR, L'AMI !"

# Traduction IA – à relire
#: abel_table/end_alls_good/56
msgctxt "Ben-hwa"
msgid "You can tell all is well by how loud he's screaming it."
msgstr "Tu vois que tout va bien à la force avec laquelle il le hurle."

# Traduction IA – à relire
#: abel_table/end_alls_good/64
msgctxt "Abel"
msgid "TAKE CARE NOW!"
msgstr "PORTE-TOI BIEN !"

# Traduction IA – à relire
#: abel_table/end_alls_good_2/8
msgctxt "Abel"
msgid "Don't work too hard now, ya hear? I better see ya turnin' in soon."
msgstr "Travaille pas trop, hein ? J'veux te voir aller te coucher bientôt."

# Traduction IA – à relire
#: abel_table/end_alls_good_2/16
msgctxt "Abel"
msgid "You gotta take care of yourself."
msgstr "Faut prendre soin de toi."

# Traduction IA – à relire
#: abel_table/console_alls_good/0/0
msgctxt "Abel"
msgid "All's well here at the console table!"
msgstr "Tout va bien par ici, à la console !"

# Traduction IA – à relire
#: abel_table/console_alls_good/0/8
msgctxt "Abel"
msgid "Well, mostly. I wanna watch YellowSewn.. but nobody else does."
msgstr "Enfin, presque. J'veux regarder YellowSewn... mais personne d'autre veut."

# Traduction IA – à relire
#: abel_table/console_alls_good/0/16
msgctxt "Abel"
msgid "How'm I supposed to relax when I could be watchin' the greatest TV show ever made?"
msgstr "Comment j'suis censé me détendre quand j'pourrais regarder la meilleure série de tous les temps ?"

# Traduction IA – à relire
#: abel_table/console_alls_good/0/24/s/0
msgctxt "Choix"
msgid "Is it really the greatest?"
msgstr "C'est vraiment la meilleure ?"

# Traduction IA – à relire
#: abel_table/console_alls_good/0/25/s/0
msgctxt "Choix"
msgid "That show doesn't seem up my alley..."
msgstr "Cette série n'a pas l'air d'être mon truc..."

# Traduction IA – à relire
#: abel_table/console_alls_good/0/c-0/7
msgctxt "Abel"
msgid "Listen t'this... a hard-workin' pair of jeans has to balance life in the dresser, sharin' a border with other pants and USB cables."
msgstr "Écoute-moi ça... un jean qui trime dur doit tenir sa vie dans la commode, coincé entre d'autres pantalons et des câbles USB."

# Traduction IA – à relire
#: abel_table/console_alls_good/0/c-0/15
msgctxt "Abel"
msgid "It's a clash of civilizations! Old n' new! Must-see TV!"
msgstr "C'est le choc des civilisations ! L'ancien et le moderne ! Un incontournable !"

# Traduction IA – à relire
#: abel_table/console_alls_good/0/c-0/23
msgctxt "Narrator"
msgid "When you seem less than enthused, Abel's cheeks flush."
msgstr "Face à votre manque d'enthousiasme, Abel rougit."

# Traduction IA – à relire
#: abel_table/console_alls_good/0/g-0/0
msgctxt "Abel"
msgid "Anyway, yeah. Fine here. Just... waitin' for my turn on the TV."
msgstr "Bref, ouais. Ça va. J'attends juste... mon tour à la télé."

# Traduction IA – à relire
#: abel_table/record_alls_good/0/0
msgctxt "Abel"
msgid "All's well here, amigo."
msgstr "Tout va bien par ici, amigo."

# Traduction IA – à relire
#: abel_table/record_alls_good/0/8
msgctxt "Abel"
msgid "Though it'd be nice if I could get Rainey to play me a little country music... in the mood for a good tune."
msgstr "Même si ce serait bien que Rainey me passe un peu de country... j'ai envie d'un bon air."

# Traduction IA – à relire
#: abel_table/record_alls_good/0/16/s/0
msgctxt "Choix"
msgid "Okay - just checkin' on ya."
msgstr "D'accord, je venais juste voir si ça allait."

# Traduction IA – à relire
#: abel_table/record_alls_good/0/c-0/7
msgctxt "Abel"
msgid "Nothin' to complain about here otherwise."
msgstr "À part ça, rien à redire par ici."

# Traduction IA – à relire
#: abel_table/abel_intro/0/0
msgctxt "Narrator"
msgid "The first word that comes to mind when you see the large cowboy standing before you is 'solid'—this guy is big, and he looks built to last."
msgstr "Le premier mot qui vous vient à l'esprit en voyant le grand cow-boy devant vous, c'est « solide » : ce type est massif, et il a l'air bâti pour durer."

# Traduction IA – à relire
#: abel_table/abel_intro/0/8
msgctxt "Narrator"
msgid "You might be intimidated were it not for the kind expression on his face and the sweet way he doffs his hat at you."
msgstr "Vous pourriez être {{intimidé|intimidée|intimidé·e}}, n'était l'expression bienveillante de son visage et la douceur avec laquelle il vous salue d'un coup de chapeau."

# Traduction IA – à relire
#: abel_table/abel_intro/0/16
msgctxt "Narrator"
msgid "No one's ever asked you this, but if you HAD been asked to imagine what your table might look like as a human you think this would be pretty close."
msgstr "Personne ne vous l'a jamais demandé, mais si l'on vous AVAIT demandé d'imaginer votre table en humain, vous auriez visé quelque chose de très proche."

# Traduction IA – à relire
#: abel_table/abel_intro/0/21
msgctxt "Abel"
msgid "We've known each other for a real long time now, but we ain't never been properly introduced."
msgstr "Ça fait une sacrée paye qu'on se connaît, mais on a jamais été présentés dans les règles."

# Traduction IA – à relire
#: abel_table/abel_intro/0/29
msgctxt "Abel"
msgid "So first things first—name's Abel, and I'm yer table."
msgstr "Alors, d'abord, j'm'appelle Abel, et j'suis ta table."

# Traduction IA – à relire
#: abel_table/abel_intro/0/37/b/1
msgctxt "Abel"
msgid "And second. That is one fantastic red shirt you've got on."
msgstr "Et ensuite. C'est une fantastique chemise rouge que tu portes là."

# Traduction IA – à relire
#: abel_table/abel_intro/0/51/s/0
msgctxt "Choix"
msgid "Nice to meet you."
msgstr "{{Enchanté|Enchantée|Enchanté·e}}."

# Traduction IA – à relire
#: abel_table/abel_intro/0/52/s/0
msgctxt "Choix"
msgid "I'm"
msgstr "Moi, c'est"

# Traduction IA – à relire
#: abel_table/abel_intro/0/52/s/5
msgctxt "Choix"
msgid "and I'm your human?"
msgstr "et je suis {{ton humain|ton humaine|ton humain·e}} ?"

# Traduction IA – à relire
#: abel_table/abel_intro/0/53/s/0
msgctxt "Choix"
msgid "Okay..."
msgstr "D'accord..."

# Traduction IA – à relire
#: abel_table/abel_intro/0/c-0/7
msgctxt "Abel"
msgid "Pleasure's all mine!"
msgstr "Tout le plaisir est pour moi !"

# Traduction IA – à relire
#: abel_table/abel_intro/0/c-1/7
msgctxt "Abel"
msgid "I know it! But it sure is nice to hear it from ya face to face like this."
msgstr "Je sais ! Mais ça fait drôlement plaisir de te l'entendre dire en face comme ça."

# Traduction IA – à relire
#: abel_table/abel_intro/0/c-2/7
msgctxt "Abel"
msgid "Nice to meet you too."
msgstr "Enchanté aussi."

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-0/0
msgctxt "Abel"
msgid "Ya know, as a table it's my job to hold things up all over the house."
msgstr "Tu sais, en tant que table, mon boulot c'est de soutenir des choses partout dans la maison."

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-0/8
msgctxt "Abel"
msgid "And I take my job real serious."
msgstr "Et je prends mon boulot très au sérieux."

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-0/16
msgctxt "Abel"
msgid "So if you're here talkin' to me now... you must need somethin' more than just my support."
msgstr "Alors si tu viens me causer maintenant... c'est que t'as besoin de plus que mon simple soutien."

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-0/24
msgctxt "Abel"
msgid "And if there's one thing Abel's gonna do, it's make sure everyone in this house has what they need."
msgstr "Et s'il y a une chose qu'Abel va faire, c'est s'assurer que tout le monde dans cette maison a c'qu'il lui faut."

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-0/32
msgctxt "Abel"
msgid "So what can I do ya for? There's gotta be somethin'."
msgstr "Alors qu'est-ce que j'peux faire pour toi ? Y a forcément quelque chose."

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-0/40/s/0
msgctxt "Choix"
msgid "I'm just getting to know everyone around the house."
msgstr "J'apprends juste à connaître tout le monde dans la maison."

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-0/41/s/0
msgctxt "Choix"
msgid "Do you have any dating advice?"
msgstr "Tu aurais des conseils de drague ?"

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-0/42/s/0
msgctxt "Choix"
msgid "You're assuming I'm here for you and not just... walking around my house."
msgstr "Tu pars du principe que je suis là pour toi, et pas juste... en train de me promener chez moi."

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-0/c-3/7
msgctxt "Abel"
msgid "Oh yeah? Skylar told me you was gettin' to know everybody real good."
msgstr "Ah ouais ? Skylar m'a dit que t'apprenais à bien connaître tout le monde."

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-0/c-3/15
msgctxt "Abel"
msgid "Maybe lookin' to gettin' back into datin' and all that."
msgstr "Que tu cherchais p't-être à te remettre à fréquenter du monde, et tout ça."

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-0/c-4/7
msgctxt "Abel"
msgid "Heck! You're askin' me that?"
msgstr "Sapristi ! C'est à moi que tu demandes ça ?"

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-0/c-5/7
msgctxt "Abel"
msgid "Aww c'mon now, no need to be shy about it."
msgstr "Allez, voyons, pas besoin d'être timide."

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-0/c-5/15
msgctxt "Abel"
msgid "Skylar told me you're gettin' back into datin' around the house here."
msgstr "Skylar m'a dit que tu te remettais à draguer dans la maison."

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-1/0
msgctxt "Abel"
msgid "Datin', huh... hoo-whee."
msgstr "La drague, hein... hou là là."

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-1/8
msgctxt "Abel"
msgid "Datin' ain't really my area of expertise, you know... me personally I never was one for casual stuff."
msgstr "La drague, c'est pas vraiment mon rayon, tu sais... moi, perso, j'ai jamais été porté sur les trucs sans lendemain."

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-1/16
msgctxt "Abel"
msgid "If you're lookin' for someone who knows people, you might wanna talk to Kopi."
msgstr "Si tu cherches quelqu'un qui connaît les gens, tu devrais p't-être aller voir Kopi."

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-1/24/b/1
msgctxt "Abel"
msgid "She's good with that sorta thing."
msgstr "Elle s'y connaît, en ce genre de choses."

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-1/27/b/1
msgctxt "Abel"
msgid "You'll find her nearby."
msgstr "Tu la trouveras pas loin."

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-1/30/s/0
msgctxt "Choix"
msgid "What do you mean by 'casual stuff'?"
msgstr "Comment ça, « les trucs sans lendemain » ?"

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-1/31/s/0
msgctxt "Choix"
msgid "You the old-fashioned type?"
msgstr "T'es du genre vieux jeu ?"

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-1/32/s/0
msgctxt "Choix"
msgid "Don't pawn me off onto somebody else!"
msgstr "Ne me refile pas à quelqu'un d'autre !"

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-1/c-6/7
msgctxt "Abel"
msgid "Ah, heck, I dunno..."
msgstr "Ah, ben, j'sais pas..."

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-1/c-7/7
msgctxt "Abel"
msgid "Heh, I guess you could say so."
msgstr "Héhé, faut croire, ouais."

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-1/c-8/7
msgctxt "Abel"
msgid "I ain't! That ain't what I'm about."
msgstr "Pas du tout ! C'est pas mon genre."

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-1/c-8/15
msgctxt "Abel"
msgid "It's just the new-fangled datin' ain't really somethin' I'm..."
msgstr "C'est juste que la drague à la mode d'aujourd'hui, c'est pas vraiment un truc que j'..."

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-2/0
msgctxt "Abel"
msgid "All that talkin' and whatnot. Heh."
msgstr "Tout ce blabla et compagnie. Héhé."

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-2/8
msgctxt "Abel"
msgid "Tryin' to fit each others' history into bite-sized portions..."
msgstr "Essayer de faire tenir le passé de chacun en petites bouchées..."

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-2/16
msgctxt "Abel"
msgid "Aw, it just ain't my speed."
msgstr "Oh, c'est juste pas mon rythme."

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-2/24/s/0
msgctxt "Choix"
msgid "Me neither."
msgstr "Moi non plus."

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-2/25/s/0
msgctxt "Choix"
msgid "I mean hey... that's why I'm here."
msgstr "Ben quoi... c'est pour ça que je suis là."

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-2/26/s/0
msgctxt "Choix"
msgid "You should catch up to the times!"
msgstr "Tu devrais vivre avec ton temps !"

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-2/c-9/7
msgctxt "Abel"
msgid "Well I'm just glad I ain't the only one who feels a little left behind by the whole thing."
msgstr "Ben, j'suis content de pas être le seul à m'sentir un peu largué par tout ça."

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-2/c-9/15
msgctxt "Abel"
msgid "But don't you worry."
msgstr "Mais t'en fais pas."

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-2/c-10/7
msgctxt "Abel"
msgid "Then you really gotta talk to somebody who knows what's what with datin' these days."
msgstr "Alors faut vraiment que t'ailles voir quelqu'un qui sait comment ça se passe, la drague, de nos jours."

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-2/c-11/7
msgctxt "Abel"
msgid "I'm fine where I am! We're talkin' about you now."
msgstr "Moi, j'suis très bien comme j'suis ! C'est de toi qu'on parle."

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-2/c-11/15
msgctxt "Abel"
msgid "But you'll make it there."
msgstr "Mais tu vas y arriver."

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-3/0
msgctxt "Abel"
msgid "Kopi'll get you on the right path."
msgstr "Kopi te mettra sur le bon chemin."

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-3/8
msgctxt "Abel"
msgid "Oh, and uh, tell her I said hey when you see her."
msgstr "Oh, et, euh, passe-lui le bonjour de ma part quand tu la verras."

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-3/22/s/0
msgctxt "Choix"
msgid "Will do!"
msgstr "Ça marche !"

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-3/23/s/0
msgctxt "Choix"
msgid "Thanks, Abel."
msgstr "Merci, Abel."

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-3/24/s/0
msgctxt "Choix"
msgid "We'll see..."
msgstr "On verra..."

# Traduction IA – à relire
#: abel_table/abel_intro/0/g-4/0 abel_table/help_abel_towel/0/g-2/13 abel_table/fantina_abel_sad/0/g-0/28 abel_table/fantina_abel_meh/0/g-0/37
msgctxt "Abel"
msgid "You take care now."
msgstr "Prends soin de toi, hein."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/4
msgctxt "Narrator"
msgid "Abel was friendly the last time you saw him, but he seems downright cheerful today."
msgstr "La dernière fois que vous l'avez vu, Abel était aimable, mais aujourd'hui il semble carrément guilleret."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/12
msgctxt "Narrator"
msgid "He's whistling when you walk up on him, though he stops when he sees you, greeting you with a broad grin."
msgstr "Il sifflote quand vous arrivez, mais il s'arrête en vous voyant et vous accueille d'un large sourire."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/20/s/0
msgctxt "Choix"
msgid "Hey Abel. How you doin' today?"
msgstr "Salut, Abel. Comment ça va aujourd'hui ?"

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/c-0/7
msgctxt "Abel"
msgid "Oh, hey yourself, sunshine."
msgstr "Oh, salut à toi, mon rayon de soleil."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "You seem peppy today."
msgstr "T'as l'air en pleine forme aujourd'hui."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/c-0/15/1/s/0
msgctxt "Choix"
msgid "Sunshine?"
msgstr "Rayon de soleil ?"

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/c-0/15/2/s/0
msgctxt "Choix"
msgid "Sunshine? Who even are you?"
msgstr "Rayon de soleil ? Mais t'es qui, toi ?"

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/c-0/15/c-0/7
msgctxt "Abel"
msgid "Ah, well... you know... sometimes a table just wants to feel heard."
msgstr "Ah, ben... tu sais... des fois, une table a juste besoin de se sentir écoutée."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/c-0/15/c-1/7
msgctxt "Abel"
msgid "Didn't mean no offense. Just in a real swell mood today."
msgstr "Je voulais pas te vexer. J'suis juste de super bonne humeur aujourd'hui."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/c-0/15/c-2/7
msgctxt "Abel"
msgid "What? What's the matter with sunshine?"
msgstr "Quoi ? Qu'est-ce qu'il a, « rayon de soleil » ?"

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/c-0/15/c-2/15
msgctxt "Abel"
msgid "Is this world so cynical a table can't even greet his pals with a smile on his face and a song in his heart?"
msgstr "Le monde est donc si cynique qu'une table peut même plus accueillir ses amis avec le sourire aux lèvres et une chanson dans le cœur ?"

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/c-0/15/c-2/23
msgctxt "Abel"
msgid "I ain't mean no offense, I was just in a swell mood."
msgstr "J'voulais pas te vexer, j'étais juste de super bonne humeur."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/0
msgctxt "Abel"
msgid "Had a long talk with Dasha before ya got here."
msgstr "J'ai eu une longue discussion avec Dasha avant que t'arrives."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/11/b/1
msgctxt "Abel"
msgid "Dasha... the desk, y'know? Real close to tables... but also real different world."
msgstr "Dasha... le bureau, tu vois ? Très proche des tables... mais un tout autre monde, aussi."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/14
msgctxt "Abel"
msgid "Goin' over the finer points of liftin', supportin'... and you know, just the good ol' basics."
msgstr "On a passé en revue les subtilités du levage, du soutien... et puis, tu sais, les bonnes vieilles bases."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/22
msgctxt "Abel"
msgid "Just feels nice to be understood, ya know?"
msgstr "Ça fait du bien d'être compris, tu vois ?"

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/30/s/0
msgctxt "Choix"
msgid "I wish I knew what that was like."
msgstr "J'aimerais savoir ce que ça fait."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/31/s/0
msgctxt "Choix"
msgid "It's so nice that she gets you."
msgstr "C'est trop bien qu'elle te comprenne."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/32/s/0
msgctxt "Choix"
msgid "For someone who said they are supportive, you sure are talking a lot about yourself."
msgstr "Pour quelqu'un qui se dit si attentionné, tu parles beaucoup de toi."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-1/13
msgctxt "Abel"
msgid "You feel misunderstood? Tell me about it."
msgstr "Tu t'sens {{incompris|incomprise|incompris·e}} ? Raconte-moi ça."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-1/21
msgctxt "Abel"
msgid "You know ol' Abel's got ya."
msgstr "Tu sais que l'vieil Abel est là pour toi."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-1/29/0/s/0
msgctxt "Choix"
msgid "I just feel so lonely, you know?"
msgstr "Je me sens tellement {{seul|seule|seul·e}}, tu vois ?"

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-1/29/c-0/7
msgctxt "Abel"
msgid "Go on."
msgstr "Vas-y."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-1/29/c-0/15/0/s/0
msgctxt "Choix"
msgid "I have things to talk to, sure, but no one really understands me on that deeper level."
msgstr "J'ai des choses à qui parler, d'accord, mais personne ne me comprend vraiment en profondeur."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-1/29/c-0/15/c-0/7
msgctxt "Abel"
msgid "I know just what ya mean. It's hard to feel like yer swimmin' against the tide... like a salmon tryin' to swim up a garden hose."
msgstr "J'vois exactement c'que tu veux dire. C'est dur d'avoir l'impression de nager à contre-courant... comme un saumon qui essaie de remonter un tuyau d'arrosage."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-1/29/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "Oh wow. That's... I mean, I guess, sure, yeah. That's how it feels."
msgstr "Oh, waouh. C'est... enfin, j'imagine, oui, d'accord. C'est ce que je ressens."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-1/29/c-0/15/c-0/15/c-0/7
msgctxt "Abel"
msgid "Say no more, pal. I've been there more times'n I can count."
msgstr "Pas besoin d'en dire plus, mon pote. J'suis passé par là plus de fois que j'peux compter."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-1/29/c-0/15/c-0/15/c-0/15
msgctxt "Abel"
msgid "Anytime you feel like you gotta unburden yourself you come 'n find me."
msgstr "Chaque fois que t'as besoin de vider ton sac, tu viens me trouver."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-1/29/c-0/15/c-0/15/c-0/23
msgctxt "Abel"
msgid "Liftin' your burdens's what I was made for, y'know?"
msgstr "Porter tes fardeaux, c'est pour ça que j'ai été fabriqué, tu vois ?"

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-1/29/c-0/15/c-0/15/c-0/31
msgctxt "Abel"
msgid "Come 'n lay yer troubles on my shoulders."
msgstr "Viens déposer tes soucis sur mes épaules."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-1/29/c-0/15/c-0/15/c-0/39/0/s/0
msgctxt "Choix"
msgid "I'll remember that. Thanks, Abel."
msgstr "Je m'en souviendrai. Merci, Abel."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-1/29/c-0/15/c-0/15/c-0/39/c-0/7
msgctxt "Abel"
msgid "Just remember ain't none of us ever really alone."
msgstr "Rappelle-toi juste qu'aucun de nous est jamais vraiment seul."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-1/29/c-0/15/c-0/15/c-0/39/c-0/15
msgctxt "Abel"
msgid "Even a cowboy's got the dirt at his feet'n the stars in the sky to keep him company."
msgstr "Même un cow-boy a la terre sous ses pieds et les étoiles dans le ciel pour lui tenir compagnie."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-1/29/c-0/15/c-0/15/c-0/39/c-0/23
msgctxt "Abel"
msgid "You just gotta make sure you know it too."
msgstr "Faut juste que tu le saches, toi aussi."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-1/29/c-0/15/c-0/15/c-0/39/c-0/31/0/s/0
msgctxt "Choix"
msgid "You really do have a little saying for everything, don't you?"
msgstr "T'as vraiment un petit dicton pour tout, hein ?"

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-1/29/c-0/15/c-0/15/c-0/39/c-0/31/c-0/7
msgctxt "Abel"
msgid "Darn tootin'."
msgstr "Un peu, mon neveu."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-1/29/c-0/15/c-0/15/c-0/39/c-0/31/c-0/15/0/s/0
msgctxt "Choix"
msgid "Well I guess I better mosey for now. Can't afford to stand around here cluckin' like two hens in a coop."
msgstr "Bon, je crois que je vais traîner mes bottes ailleurs. On va pas rester plantés là à caqueter comme deux poules dans un poulailler."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-1/29/c-0/15/c-0/15/c-0/39/c-0/31/c-0/15/1/s/0 abel_table/fantina_help_alone/0/g-0/16/s/0
msgctxt "Choix"
msgid "See ya, Abel."
msgstr "À plus, Abel."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-1/29/c-0/15/c-0/15/c-0/39/c-0/31/c-0/15/c-0/7
msgctxt "Abel"
msgid "Whoah."
msgstr "Ouah."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-1/29/c-0/15/c-0/15/c-0/39/c-0/31/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "Oh my god, that just came out of me. It's infectious."
msgstr "Oh mon dieu, c'est sorti tout seul. C'est contagieux."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-1/29/c-0/15/c-0/15/c-0/39/c-0/31/c-0/15/c-0/15/c-0/7
msgctxt "Abel"
msgid "Ha! Ya see? Later days, partner."
msgstr "Ha ! Tu vois ? À la revoyure, partenaire."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-1/29/c-0/15/c-0/15/c-0/39/c-0/31/c-0/15/c-1/7
msgctxt "Abel"
msgid "Stay steady!"
msgstr "Reste stable !"

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-2/13
msgctxt "Abel"
msgid "...it is, ain't it? Liftin's no easy job."
msgstr "... c'est vrai, hein ? Soulever des choses, c'est pas un boulot facile."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-2/21
msgctxt "Abel"
msgid "We got a lotta folks in this house who do a damn fine job at what it is they do."
msgstr "On a plein de monde dans cette maison qui fait sacrément bien son boulot."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-2/29
msgctxt "Abel"
msgid "But how many people's job is it to lift?"
msgstr "Mais combien ont pour boulot de soulever ?"

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-2/37
msgctxt "Abel"
msgid "To make sure everyone's got what they need, to make sure they know they can rely on ya day in and day out."
msgstr "De s'assurer que tout le monde a c'qu'il lui faut, que tout le monde sait qu'il peut compter sur toi jour après jour."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-2/45
msgctxt "Abel"
msgid "It's a lonely lot in the life of a table, but I knew what the job was when I signed up."
msgstr "C'est une vie solitaire, celle de table, mais j'savais à quoi j'm'engageais quand j'ai signé."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-2/53/0/s/0
msgctxt "Choix"
msgid "Did you sign up for it? I feel like it was assigned to you."
msgstr "T'as vraiment signé ? J'ai l'impression qu'on t'a plutôt imposé le poste."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-2/53/c-0/7
msgctxt "Abel"
msgid "Semantics, pal. Semantics. I know who I am and what I do."
msgstr "Question de vocabulaire, mon pote. Question de vocabulaire. J'sais qui j'suis et c'que j'fais."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-2/53/c-0/15
msgctxt "Abel"
msgid "But sometimes ya just wish someone knew exactly what in tarnation yer even thinkin' about without havin' to explain yerself."
msgstr "Mais des fois, on aimerait juste que quelqu'un sache exactement à quoi diable on pense, sans avoir à s'expliquer."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-2/53/c-0/23
msgctxt "Abel"
msgid "Huh, that's Dasha."
msgstr "Tiens, ça, c'est Dasha."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-2/53/c-0/35/0/s/0
msgctxt "Choix"
msgid "I see... maybe you should talk to her more often."
msgstr "Je vois... tu devrais peut-être lui parler plus souvent."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-2/53/c-0/35/c-0/7
msgctxt "Abel"
msgid "Ya think so?"
msgstr "Tu crois ?"

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-2/53/c-0/35/c-0/15/0/s/0
msgctxt "Choix"
msgid "She's had a real positive effect on you."
msgstr "Elle a vraiment une bonne influence sur toi."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-2/53/c-0/35/c-0/15/c-0/7
msgctxt "Abel"
msgid "Ah, well... shucks! I don't know, I'd hate to bother her."
msgstr "Ah, ben... oh, flûte ! J'sais pas, j'voudrais pas la déranger."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-2/53/c-0/35/c-0/15/c-0/15
msgctxt "Abel"
msgid "She's got a lotta liftin' to do herself."
msgstr "Elle a déjà beaucoup à soulever de son côté."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-2/53/c-0/35/c-0/15/c-0/23
msgctxt "Abel"
msgid "I can't be distractin' her from her very important job, now."
msgstr "J'peux pas la distraire de son boulot si important, voyons."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-2/53/c-0/35/c-0/15/c-0/31/0/s/0
msgctxt "Choix"
msgid "I think you should at least consider it."
msgstr "Je pense que tu devrais au moins y réfléchir."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-2/53/c-0/35/c-0/15/c-0/31/c-0/7
msgctxt "Abel"
msgid "I'll... consider it, yeah."
msgstr "J'vais... y réfléchir, ouais."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-2/53/c-0/35/c-0/15/c-0/31/c-0/15
msgctxt "Abel"
msgid "Anyway, I can't take up too much more of yer time today talkin' about myself."
msgstr "Bref, j'peux pas te prendre plus de temps aujourd'hui à parler de moi."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-2/53/c-0/35/c-0/15/c-0/31/c-0/23
msgctxt "Abel"
msgid "Just remember what I said before, kay'—I'm here if ya need me."
msgstr "Rappelle-toi juste c'que j'ai dit tout à l'heure, d'accord ? J'suis là si t'as besoin de moi."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-2/53/c-0/35/c-0/15/c-0/31/c-0/31/0/s/0
msgctxt "Choix"
msgid "I will. You remember what I said too, please."
msgstr "Promis. Et toi, rappelle-toi ce que j'ai dit aussi, s'il te plaît."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-2/53/c-0/35/c-0/15/c-0/31/c-0/31/c-0/7
msgctxt "Abel"
msgid "I will. You take care now."
msgstr "Promis. Prends soin de toi, hein."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-3/13
msgctxt "Abel"
msgid "Am I? Oh, my apologies, friend."
msgstr "Ah bon ? Oh, toutes mes excuses, l'ami."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-3/21
msgctxt "Abel"
msgid "I lost focus. Here you are, needin' my support, and I'm yammerin' on about myself."
msgstr "J'ai perdu le fil. Te voilà qui as besoin de mon soutien, et moi j'jacasse sur moi-même."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-3/29
msgctxt "Abel"
msgid "Tell me what I can do to help."
msgstr "Dis-moi c'que j'peux faire pour t'aider."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-3/37/0/s/0
msgctxt "Choix"
msgid "I don't always need help, Abel. Sometimes I just want to talk."
msgstr "Je n'ai pas toujours besoin d'aide, Abel. Parfois, j'ai juste envie de discuter."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-3/37/1/s/0
msgctxt "Choix"
msgid "I'm just here to make sure you're doing your job right."
msgstr "Je suis juste là pour vérifier que tu fais bien ton boulot."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-3/37/2/s/0
msgctxt "Choix"
msgid "Relax, I'm kidding."
msgstr "Détends-toi, je rigole."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-3/37/c-0/7
msgctxt "Abel"
msgid "Well, that's a help in itself, ain't it?"
msgstr "Ben, ça aide déjà en soi, pas vrai ?"

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-3/37/c-0/15
msgctxt "Abel"
msgid "I'm happy to listen to yer troubles anytime ya need me."
msgstr "J'suis toujours content d'écouter tes soucis quand t'as besoin de moi."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-3/37/c-0/23
msgctxt "Abel"
msgid "...well, most anytime, anyway."
msgstr "... enfin, presque toujours."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-3/37/c-0/31
msgctxt "Abel"
msgid "You caught me at an awkward time... gotta make rounds and check on some folks."
msgstr "Tu tombes mal... faut que j'fasse ma tournée pour voir comment vont certains."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-3/37/c-0/39
msgctxt "Abel"
msgid "Lotta things need lifting around here. Maybe I'll catch ya later?"
msgstr "Y a plein de trucs à soulever par ici. On s'voit plus tard, p't-être ?"

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-3/37/c-0/47
msgctxt "Abel"
msgid "We can talk then."
msgstr "On pourra causer à ce moment-là."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-3/37/c-0/52/0/s/0
msgctxt "Choix"
msgid "Sure... alright."
msgstr "Bien sûr... d'accord."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-3/37/c-0/52/c-0/7
msgctxt "Abel"
msgid "Great. You take care now, and I'll see ya next time."
msgstr "Super. Prends soin de toi, et à la prochaine."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-3/37/c-1/7
msgctxt "Abel"
msgid "Here to make sure I'm doin' my job right?"
msgstr "T'es là pour vérifier que j'fais bien mon boulot ?"

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-3/37/c-1/15
msgctxt "Abel"
msgid "Oh, you always trusted me to handle things till now. What's going on here?"
msgstr "Oh, jusqu'ici tu m'as toujours fait confiance pour gérer les choses. Qu'est-ce qui se passe ?"

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-3/37/c-1/23/0/s/0
msgctxt "Choix"
msgid "Your leg's been a little wobbly lately. Just making sure everything's shipshape."
msgstr "Ta jambe est un peu bancale ces temps-ci. Je vérifie juste que tout est en ordre."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-3/37/c-1/23/c-0/7
msgctxt "Abel"
msgid "W-w-w... <w>WOBBLY?</w>"
msgstr "B-b-b... <w>BANCALE ?</w>"

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-3/37/c-1/23/c-0/18
msgctxt "Abel"
msgid "Them's fightin' words, partner. You do me a favor and take a hike."
msgstr "Ça, c'est des mots à se battre, partenaire. Rends-moi service et va faire un tour."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-3/37/c-1/23/c-0/26
msgctxt "Abel"
msgid "Cause if you keep pushin' me like this I'm liable to say somethin' downright unkind!"
msgstr "Parce que si tu continues à m'chercher comme ça, j'risque de dire quelque chose de franchement pas gentil !"

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-3/37/c-1/23/c-0/34/0/s/0
msgctxt "Choix"
msgid "Is that really-"
msgstr "C'est vraiment..."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-3/37/c-1/23/c-0/34/c-0/7 abel_table/tony_arrive/0/g-3/8
msgctxt "Abel"
msgid "Go on! Git!"
msgstr "Allez ! Du balai !"

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-3/37/c-1/23/c-0/34/c-0/15/0/s/0
msgctxt "Choix"
msgid "Alright... I'm going. Yeesh."
msgstr "D'accord... j'y vais. Pfiou."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-3/37/c-2/13
msgctxt "Abel"
msgid "Are ya, tho? Y'know, it strikes me that a joke ya gotta explain ain't really all that funny now, is it?"
msgstr "Ah ouais, vraiment ? Tu sais, m'est avis qu'une blague qu'on doit expliquer, c'est pas vraiment drôle, hein ?"

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-3/37/c-2/21
msgctxt "Abel"
msgid "If yer only here for jokes, I'm afraid I'm gonna have to just catch up with ya later. Lots of work to do and all."
msgstr "Si t'es là que pour les blagues, j'crains qu'on doive se voir plus tard. J'ai plein de boulot et tout."

# Traduction IA – à relire
#: abel_table/abel_second_chat/0/g-0/c-3/37/c-2/29
msgctxt "Abel"
msgid "Happy Trails to you."
msgstr "Bonne route à toi."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/4
msgctxt "Narrator"
msgid "Abel is normally so even-keeled and sweet when you see him—the alarmed look on his face really takes you by surprise."
msgstr "D'habitude, Abel est si posé et si gentil quand vous le voyez : son air paniqué vous prend vraiment de court."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/12/s/0
msgctxt "Choix"
msgid "You alright?"
msgstr "Ça va ?"

# Traduction IA – à relire
#: abel_table/dining_wobble/0/13/s/0
msgctxt "Choix"
msgid "Hey there, Abel."
msgstr "Salut, Abel."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/14/s/0
msgctxt "Choix"
msgid "What the hell happened to you?"
msgstr "Mais qu'est-ce qui t'est arrivé, bon sang ?"

# Traduction IA – à relire
#: abel_table/dining_wobble/0/c-2/7
msgctxt "Abel"
msgid "Oh, dang it all. Was really hoping you wouldn't see me like this."
msgstr "Oh, sapristi. J'espérais vraiment que tu me verrais pas dans cet état."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-0/3
msgctxt "Beverly"
msgid "Oh you shoulda seen him last night, he was <w>HAMMERED</w>."
msgstr "Oh, t'aurais dû le voir hier soir, il était complètement <w>MARTELÉ</w>."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-0/14 abel_table/end_spill/0/c-0/15/c-0/24
msgctxt "Abel"
msgid "I beg yer PARDON?!"
msgstr "PLAÎT-IL ?!"

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-0/22
msgctxt "Beverly"
msgid "Hahaha, sorry, no, kidding. That was the rest of us."
msgstr "Hahaha, pardon, non, je rigole. Ça, c'était nous autres."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-0/30
msgctxt "Beverly"
msgid "Abel was just here making sure everyone else was good as per usual."
msgstr "Abel était juste là pour vérifier que tout le monde allait bien, comme d'hab."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-0/38
msgctxt "Beverly"
msgid "Unfortunately we kinda left a mess here last night, and I swear I was just coming to help him clean it up."
msgstr "Malheureusement, on a un peu laissé le bazar ici hier soir, et je te jure que je venais justement l'aider à ranger."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-0/46
msgctxt "Beverly"
msgid "But I kinda grabbed for this cup a little too fast..."
msgstr "Mais j'ai attrapé ce gobelet un poil trop vite..."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-0/54
msgctxt "Beverly"
msgid "And I fell a little... hard... onto him..."
msgstr "Et je suis tombée un peu... fort... sur lui..."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-0/62
msgctxt "Abel"
msgid "Next thing you know I'm a'wobblin' like a newborn fawn!"
msgstr "Et avant que j'm'en rende compte, j'flageolais comme un faon nouveau-né !"

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-0/70
msgctxt "Beverly"
msgid "I got most of the beer off of him, but his leg is just... like that now."
msgstr "Je lui ai enlevé presque toute la bière, mais sa jambe est juste... comme ça, maintenant."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-0/78/0/s/0
msgctxt "Choix"
msgid "Explains why it smells like a brewery in here."
msgstr "Ça explique pourquoi ça sent la brasserie ici."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-0/78/1/s/0
msgctxt "Choix"
msgid "I'm not sure how I feel about you guys having parties without me."
msgstr "Je ne sais pas trop ce que je pense du fait que vous fassiez la fête sans moi."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-0/78/2/s/0
msgctxt "Choix"
msgid "You weren't drinking with them, Abel?"
msgstr "Tu ne buvais pas avec eux, Abel ?"

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-0/78/c-3/7
msgctxt "Abel"
msgid "It ain't on my account, that's for dang sure."
msgstr "C'est pas d'mon fait, ça, c'est sûr et certain."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-0/78/c-4/7
msgctxt "Beverly"
msgid "Hey, we've got lives too!"
msgstr "Hé, on a une vie, nous aussi !"

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-0/78/c-4/18
msgctxt "Abel"
msgid "I ain't the partyin' type no more. I just came to make sure everyone else was alright."
msgstr "J'suis plus du genre fêtard. J'étais juste venu vérifier que tout le monde allait bien."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-0/78/c-5/7
msgctxt "Abel"
msgid "Me? Naw."
msgstr "Moi ? Nan."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-2/0
msgctxt "Abel"
msgid "I ain't touched a drop o' drink in years..."
msgstr "J'ai pas touché une goutte d'alcool depuis des années..."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-2/8
msgctxt "Beverly"
msgid "And you still managed to get hosed anyway, haha."
msgstr "Et t'as quand même réussi à finir arrosé, haha."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-2/16
msgctxt "Abel"
msgid "Ain't got a problem or nothin'. Just never liked the way it made me feel."
msgstr "J'ai pas de problème ni rien. J'ai juste jamais aimé l'effet que ça m'faisait."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-2/24
msgctxt "Abel"
msgid "When a table ain't got his mind right he can't mind others, ya know what I mean?"
msgstr "Quand une table a pas les idées claires, elle peut pas veiller sur les autres, tu vois c'que j'veux dire ?"

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-2/32
msgctxt "Beverly"
msgid "Oh boy, don't get him started on all that."
msgstr "Oh là là, le lance pas là-dessus."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-2/40
msgctxt "Beverly"
msgid "Every group needs a party dad, and that's Abel to a tee."
msgstr "Toute bande a besoin d'un papa de soirée, et c'est Abel tout craché."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-2/48
msgctxt "Beverly"
msgid "You're just in time honestly, I could really use your help getting him fixed up."
msgstr "Tu tombes à pic, franchement, j'aurais bien besoin de ton aide pour le réparer."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-2/56
msgctxt "Abel"
msgid "I don't need your help!"
msgstr "J'ai pas besoin de ton aide !"

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-2/64
msgctxt "Beverly"
msgid "Don't blow a gasket, Abel! Or whatever you cowboy types say."
msgstr "Pète pas un joint de culasse, Abel ! Ou je sais pas ce que vous dites, vous les cow-boys."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-2/72
msgctxt "Beverly"
msgid "'Don't oversteer yer steed, lady!' I don't know..."
msgstr "« Cabre pas ton destrier, ma p'tite dame ! » J'en sais rien..."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-2/80
msgctxt "Abel"
msgid "Beverly!"
msgstr "Beverly !"

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-2/91
msgctxt "Beverly"
msgid "Alright, alright. I'll just go get Tony."
msgstr "Ça va, ça va. Je vais juste chercher Tony."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-2/102
msgctxt "Abel"
msgid "Oh for the love of-! Not him!"
msgstr "Oh, pour l'amour de... ! Pas lui !"

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-2/113/0
msgctxt "Narrator"
msgid "Abel sighs, looking deeply frustrated. He leans against the floor with one hand, steadying himself."
msgstr "Abel soupire, l'air profondément agacé. Il s'appuie au sol d'une main pour se stabiliser."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-2/113/8/s/0
msgctxt "Choix"
msgid "You gonna be alright?"
msgstr "Ça va aller ?"

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-2/113/9/s/0
msgctxt "Choix"
msgid "I hope you know how funny all this is."
msgstr "J'espère que tu te rends compte à quel point tout ça est drôle."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-2/113/10/s/0
msgctxt "Choix"
msgid "Here, let me help you."
msgstr "Tiens, laisse-moi t'aider."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-2/113/c-6/13
msgctxt "Abel"
msgid "I'll be fine. Don't you worry about me."
msgstr "Ça ira. T'en fais pas pour moi."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-2/113/c-6/21/b/1
msgctxt "Abel"
msgid "Tony ain't much of a carpenter, but he can tighten a few screws."
msgstr "Tony est pas vraiment menuisier, mais il sait resserrer quelques vis."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-2/113/c-6/24/b/1
msgctxt "Abel"
msgid "I'd be better if Tony weren't gonna be the one t'fix me... but I guess I shouldn't talk bad about him before y'all have even met."
msgstr "J'irais mieux si c'était pas Tony qui devait me réparer... mais j'devrais p't-être pas dire du mal de lui avant même que vous vous soyez rencontrés."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-2/113/c-7/13
msgctxt "Narrator"
msgid "Abel's expression darkens."
msgstr "Le visage d'Abel s'assombrit."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-2/113/c-7/21
msgctxt "Abel"
msgid "Ain't funny to me... but glad you can be happy about this."
msgstr "Moi, ça m'fait pas rire... mais content que ça te mette en joie."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-2/113/c-8/13 abel_table/end_spill/0/g-3/c-10/13
msgctxt "Abel"
msgid "Oh. Well..."
msgstr "Oh. Ben..."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-2/113/c-8/21 abel_table/end_spill/0/g-3/c-10/21
msgctxt "Abel"
msgid "I hate to impose, but if you wouldn't mind..."
msgstr "J'aime pas m'imposer, mais si ça t'dérange pas..."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-4/0
msgctxt "Narrator"
msgid "Abel looks away from you, visibly uncomfortable at being caught this vulnerable."
msgstr "Abel détourne le regard, visiblement mal à l'aise d'être surpris dans un tel état de faiblesse."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-4/8
msgctxt "Narrator"
msgid "The silence that stretches between you is awkward and overwhelming."
msgstr "Le silence qui s'étire entre vous est gênant et pesant."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-4/13/s/0
msgctxt "Choix"
msgid "You sure you don't need any help, Abel?"
msgstr "Tu es sûr de ne pas avoir besoin d'aide, Abel ?"

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-4/14/s/0
msgctxt "Choix"
msgid "I'm sorry this is happening."
msgstr "Je suis {{désolé|désolée|désolé·e}} que ça t'arrive."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-4/15/s/0
msgctxt "Choix"
msgid "Try not to fall down."
msgstr "Essaie de ne pas tomber."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-4/c-9/13
msgctxt "Abel"
msgid "I'll be right as rain soon enough."
msgstr "J'serai frais comme un gardon bien assez tôt."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-4/c-9/21
msgctxt "Abel"
msgid "Hey, don't worry about me."
msgstr "Hé, t'en fais pas pour moi."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-4/c-11/13
msgctxt "Abel"
msgid "Thanks. Real decent of ya."
msgstr "Merci. C'est bien chic de ta part."

# Traduction IA – à relire
#: abel_table/dining_wobble/0/g-5/0
msgctxt "Abel"
msgid "Just... don't look at me when I'm like this."
msgstr "Juste... me regarde pas quand j'suis comme ça."

# Traduction IA – à relire
#: abel_table/hold_abel_wobble/0/0/s/0
msgctxt "Choix"
msgid "Come here."
msgstr "Viens là."

# Traduction IA – à relire
#: abel_table/hold_abel_wobble/0/1/s/0
msgctxt "Choix"
msgid "Sure, just hold onto me."
msgstr "Bien sûr, accroche-toi à moi."

# Traduction IA – à relire
#: abel_table/hold_abel_wobble/0/2/s/0
msgctxt "Choix"
msgid "I'd love to help."
msgstr "Avec plaisir."

# Traduction IA – à relire
#: abel_table/hold_abel_wobble/0/g-0/0
msgctxt "Narrator"
msgid "You take Abel's hand, steadying him and draping his arm around your shoulder."
msgstr "Vous prenez la main d'Abel pour le stabiliser et passez son bras autour de vos épaules."

# Traduction IA – à relire
#: abel_table/hold_abel_wobble/0/g-0/8
msgctxt "Abel"
msgid "Oh... dang. Wasn't expectin' you to get so close."
msgstr "Oh... sapristi. J'm'attendais pas à ce que tu t'approches autant."

# Traduction IA – à relire
#: abel_table/hold_abel_wobble/0/g-0/16
msgctxt "Abel"
msgid "Been a real long time since I was this close to someone else."
msgstr "Ça fait une sacrée paye que j'ai pas été aussi près de quelqu'un."

# Traduction IA – à relire
#: abel_table/hold_abel_wobble/0/g-0/21/s/0
msgctxt "Choix"
msgid "Am I making you uncomfortable?"
msgstr "Je te mets mal à l'aise ?"

# Traduction IA – à relire
#: abel_table/hold_abel_wobble/0/g-0/22/s/0
msgctxt "Choix"
msgid "I hope you don't mind my helping you..."
msgstr "J'espère que ça ne te dérange pas que je t'aide..."

# Traduction IA – à relire
#: abel_table/hold_abel_wobble/0/g-0/23/s/0
msgctxt "Choix"
msgid "Are you embarrassed?"
msgstr "T'es gêné ?"

# Traduction IA – à relire
#: abel_table/hold_abel_wobble/0/g-1/0
msgctxt "Abel"
msgid "Oh no, no. Not at all. It's... it's nice."
msgstr "Oh non, non. Pas du tout. C'est... c'est agréable."

# Traduction IA – à relire
#: abel_table/hold_abel_wobble/0/g-1/8
msgctxt "Abel"
msgid "I got so used to just doin' things on my own, you know."
msgstr "J'ai tellement pris l'habitude de tout faire tout seul, tu sais."

# Traduction IA – à relire
#: abel_table/hold_abel_wobble/0/g-1/16
msgctxt "Abel"
msgid "A feller can do with some reminders of how good it can be to rely on others every now and again."
msgstr "Ça fait pas d'mal à un gars de se rappeler de temps en temps à quel point c'est bon de pouvoir compter sur les autres."

# Traduction IA – à relire
#: abel_table/hold_abel_wobble/0/g-1/24
msgctxt "Abel"
msgid "You're a real decent sort. I won't forget this."
msgstr "T'es quelqu'un de bien. J'oublierai pas ça."

# Traduction IA – à relire
#: abel_table/tony_arrive/0/0
msgctxt "Narrator"
msgid "Tony's arrival leaves no room for further conversation—he struts in twirling a screwdriver in each hand and grinning like a used car salesman."
msgstr "L'arrivée de Tony coupe court à toute conversation : il entre en se pavanant, un tournevis tournoyant dans chaque main, avec un sourire de vendeur de voitures d'occasion."

# Traduction IA – à relire
#: abel_table/tony_arrive/0/14
msgctxt "Tony"
msgid "Tony to the rescue! Oof, boy, look at you, Abel."
msgstr "Tony à la rescousse ! Ouh là, mon gars, regarde-toi, Abel."

# Traduction IA – à relire
#: abel_table/tony_arrive/0/25
msgctxt "Narrator"
msgid "Abel turns away from the two of you, humiliated to his very core."
msgstr "Abel se détourne de vous deux, humilié jusqu'au fond de l'âme."

# Traduction IA – à relire
#: abel_table/tony_arrive/0/33
msgctxt "Abel"
msgid "Why'd it have to be him..."
msgstr "Pourquoi fallait-il que ce soit lui..."

# Traduction IA – à relire
#: abel_table/tony_arrive/0/41
msgctxt "Tony"
msgid "Ayy, ayyy, c'mon now guy. Ain't nothin' wrong with bein' rescued by Tony."
msgstr "Eh, eh, allez, mon gars. Y a pas de honte à se faire sauver par Tony."

# Traduction IA – à relire
#: abel_table/tony_arrive/0/49
msgctxt "Tony"
msgid "I can't tell ya how many times I get summoned all over this house to fix our friends up."
msgstr "Si tu savais combien de fois on m'appelle aux quatre coins de la maison pour réparer nos potes."

# Traduction IA – à relire
#: abel_table/tony_arrive/0/57
msgctxt "Tony"
msgid "'Fix me, Tony! Please!'"
msgstr "« Répare-moi, Tony ! Pitié ! »"

# Traduction IA – à relire
#: abel_table/tony_arrive/0/65
msgctxt "Tony"
msgid "And I come through every time."
msgstr "Et j'assure à chaque fois."

# Traduction IA – à relire
#: abel_table/tony_arrive/0/73
msgctxt "Abel"
msgid "YOU BREAK MORE'N YOU FIX!"
msgstr "TU CASSES PLUS QUE TU RÉPARES !"

# Traduction IA – à relire
#: abel_table/tony_arrive/0/84
msgctxt "Tony"
msgid "Tsk tsk tsk... you keep talkin' shit like that and I won't fix your leg."
msgstr "Tss tss tss... continue à dire des conneries comme ça et j'te répare pas la jambe."

# Traduction IA – à relire
#: abel_table/tony_arrive/0/92
msgctxt "Tony"
msgid "You wanna do your job wobblin' all the live long day? That what you want?"
msgstr "Tu veux faire ton boulot en tanguant toute la sainte journée ? C'est ça que tu veux ?"

# Traduction IA – à relire
#: abel_table/tony_arrive/0/100
msgctxt "Abel"
msgid "What I want... <i>mumbled grumblings</i>."
msgstr "Ce que je veux... <i>grommellements inaudibles</i>."

# Traduction IA – à relire
#: abel_table/tony_arrive/0/108
msgctxt "Tony"
msgid "Huh?"
msgstr "Hein ?"

# Traduction IA – à relire
#: abel_table/tony_arrive/0/116
msgctxt "Abel"
msgid "...no."
msgstr "... non."

# Traduction IA – à relire
#: abel_table/tony_arrive/0/124
msgctxt "Tony"
msgid "Just say the words: 'fix me, Tony!'"
msgstr "Dis juste les mots : « Répare-moi, Tony ! »"

# Traduction IA – à relire
#: abel_table/tony_arrive/0/132
msgctxt "Tony"
msgid "That's all it takes!"
msgstr "C'est tout ce qu'il faut !"

# Traduction IA – à relire
#: abel_table/tony_arrive/0/140/s/0
msgctxt "Choix"
msgid "<i>'Fix me, Tony!'</i>"
msgstr "<i>« Répare-moi, Tony ! »</i>"

# Traduction IA – à relire
#: abel_table/tony_arrive/0/141/s/0
msgctxt "Choix"
msgid "Don't be a dick, Tony. Just fix him."
msgstr "Fais pas le connard, Tony. Répare-le, c'est tout."

# Traduction IA – à relire
#: abel_table/tony_arrive/0/142/s/0
msgctxt "Choix"
msgid "C'mon Abel, just say it."
msgstr "Allez, Abel, dis-le."

# Traduction IA – à relire
#: abel_table/tony_arrive/0/c-0/13
msgctxt "Narrator"
msgid "Tony looks disappointed when the magic words come from you and not Abel, but he shrugs."
msgstr "Tony semble déçu que ce soit vous, et non Abel, qui prononciez les mots magiques, mais il hausse les épaules."

# Traduction IA – à relire
#: abel_table/tony_arrive/0/c-0/24
msgctxt "Tony"
msgid "Well... guess that works too. Ain't nearly as fun, though."
msgstr "Bon... ça marche aussi, j'imagine. C'est loin d'être aussi marrant, par contre."

# Traduction IA – à relire
#: abel_table/tony_arrive/0/c-1/13
msgctxt "Tony"
msgid "Hey! I ain't bein' a dick. Just askin' for some basic respect."
msgstr "Hé ! J'fais pas le connard. J'demande juste un minimum de respect."

# Traduction IA – à relire
#: abel_table/tony_arrive/0/c-1/21
msgctxt "Tony"
msgid "But whatever... I'm not gonna waste my breath."
msgstr "Mais bon... j'vais pas gaspiller ma salive."

# Traduction IA – à relire
#: abel_table/tony_arrive/0/c-1/29
msgctxt "Tony"
msgid "I'm a professional and I'm gonna do the job."
msgstr "J'suis un pro et j'vais faire le boulot."

# Traduction IA – à relire
#: abel_table/tony_arrive/0/c-2/29
msgctxt "Abel"
msgid "...fix me, Tony."
msgstr "... répare-moi, Tony."

# Traduction IA – à relire
#: abel_table/tony_arrive/0/c-2/40
msgctxt "Tony"
msgid "Ayyy! There it is! Wazzat so hard?"
msgstr "Eyyy ! Voilà ! C'était si dur que ça ?"

# Traduction IA – à relire
#: abel_table/tony_arrive/0/c-2/51
msgctxt "Tony"
msgid "Alright, time to get to work."
msgstr "Bon, au boulot."

# Traduction IA – à relire
#: abel_table/tony_arrive/0/g-0/0
msgctxt "Narrator"
msgid "Tony bends down under the table, getting to work tightening a screw."
msgstr "Tony se penche sous la table et se met au travail pour resserrer une vis."

# Traduction IA – à relire
#: abel_table/tony_arrive/0/g-0/8
msgctxt "Narrator"
msgid "Tony whistles as he works, but there's not much to it—he's back up after a few moments, pocketing the screwdriver."
msgstr "Tony sifflote en travaillant, mais il n'y a pas grand-chose à faire : il se relève au bout de quelques instants et empoche son tournevis."

# Traduction IA – à relire
#: abel_table/tony_arrive/0/g-0/19
msgctxt "Tony"
msgid "Alright, let's see you stand on that leg now."
msgstr "Bon, voyons voir si tu tiens sur cette jambe, maintenant."

# Traduction IA – à relire
#: abel_table/tony_arrive/0/g-0/27
msgctxt "Narrator"
msgid "Abel tests his weight on his leg, sighing with relief when he stands steady."
msgstr "Abel teste son poids sur sa jambe et soupire de soulagement quand il tient debout sans vaciller."

# Traduction IA – à relire
#: abel_table/tony_arrive/0/g-0/35
msgctxt "Abel"
msgid "Well, thanks, Tony. Good as new."
msgstr "Ben, merci, Tony. Comme neuf."

# Traduction IA – à relire
#: abel_table/tony_arrive/0/g-0/43
msgctxt "Tony"
msgid "Well, you're welcome! At least gettin' a thank you out of ya ain't so hard."
msgstr "Ben, de rien ! Au moins, t'arracher un merci, c'est pas si dur."

# Traduction IA – à relire
#: abel_table/tony_arrive/0/g-0/51
msgctxt "Narrator"
msgid "Abel's smile grows rigid."
msgstr "Le sourire d'Abel se fige."

# Traduction IA – à relire
#: abel_table/tony_arrive/0/g-0/59
msgctxt "Abel"
msgid "Sure ain't. Ooh, bet you must have lots else to fix around the house now."
msgstr "Ça, non. Ooh, j'parie que t'as plein d'autres trucs à réparer dans la maison, maintenant."

# Traduction IA – à relire
#: abel_table/tony_arrive/0/g-0/67
msgctxt "Tony"
msgid "No, not really... I mean uh, yeah. Tons of work to do."
msgstr "Non, pas vraiment... enfin, euh, si. Des tonnes de boulot."

# Traduction IA – à relire
#: abel_table/tony_arrive/0/g-0/78
msgctxt "Tony"
msgid "Busy busy busy! Off to fix more shit."
msgstr "Débordé, débordé, débordé ! J'file réparer d'autres merdes."

# Traduction IA – à relire
#: abel_table/tony_arrive/0/g-0/89
msgctxt "Narrator"
msgid "Tony struts back out of the room, leaving silence in his wake."
msgstr "Tony ressort de la pièce en se pavanant, laissant le silence dans son sillage."

# Traduction IA – à relire
#: abel_table/tony_arrive/0/g-0/94
msgctxt "Narrator"
msgid "Abel takes his hat off and wipes his brow, quietly calming himself."
msgstr "Abel ôte son chapeau et s'essuie le front, retrouvant son calme en silence."

# Traduction IA – à relire
#: abel_table/tony_arrive/0/g-0/102
msgctxt "Abel"
msgid "Tarnation...! That toolbox really gets my goat!"
msgstr "Sacrebleu... ! Cette boîte à outils me tape sur le système !"

# Traduction IA – à relire
#: abel_table/tony_arrive/0/g-0/110/s/0
msgctxt "Choix"
msgid "What's so wrong with him?"
msgstr "Qu'est-ce qui cloche autant avec lui ?"

# Traduction IA – à relire
#: abel_table/tony_arrive/0/g-0/111/s/0
msgctxt "Choix"
msgid "But he helped you..."
msgstr "Mais il t'a aidé..."

# Traduction IA – à relire
#: abel_table/tony_arrive/0/g-0/112/s/0
msgctxt "Choix"
msgid "I think he's hot."
msgstr "Je le trouve canon."

# Traduction IA – à relire
#: abel_table/tony_arrive/0/g-0/c-3/7
msgctxt "Abel"
msgid "What ain't wrong with him!"
msgstr "Qu'est-ce qui cloche PAS, avec lui !"

# Traduction IA – à relire
#: abel_table/tony_arrive/0/g-0/c-4/7
msgctxt "Abel"
msgid "THIS time!"
msgstr "CETTE fois !"

# Traduction IA – à relire
#: abel_table/tony_arrive/0/g-0/c-5/7
msgctxt "Abel"
msgid "That's between you 'n him, not me!"
msgstr "Ça, c'est entre lui et toi, pas moi !"

# Traduction IA – à relire
#: abel_table/tony_arrive/0/g-0/c-5/15
msgctxt "Abel"
msgid "If you want someone like that then you enjoy!"
msgstr "Si c'est ce genre de type que tu veux, grand bien te fasse !"

# Traduction IA – à relire
#: abel_table/tony_arrive/0/g-1/0
msgctxt "Abel"
msgid "He walks around this house actin' like he's god's gift for doin' what anyone <i>should</i> do!"
