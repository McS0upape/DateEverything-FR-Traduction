# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink2c/0/c-0/7
msgctxt "Hoove"
msgid "Now you're talking!"
msgstr "Voilà qui est bien parlé !"

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink2c/0/c-1/7 hoove_vacuum/HooveJustHangLame/0/c-1/7
msgctxt "Hoove"
msgid "Oh... Ok."
msgstr "Oh... Ok."

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink2c/0/c-1/15
msgctxt "Hoove"
msgid "Well, I'm stone cold sober! What now?"
msgstr "Eh bien, je suis sobre comme un chameau ! Et maintenant ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink2c/0/c-1/23/0/s/0
msgctxt "Choix"
msgid "Time to get rid of some things!"
msgstr "C'est l'heure de se débarrasser de quelques trucs !"

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink2c/0/c-1/23/1/s/0
msgctxt "Choix"
msgid "We could make out."
msgstr "On pourrait s'embrasser à pleine bouche."

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink2c/0/c-1/23/c-1/7
msgctxt "Hoove"
msgid "I'm gonna pass on that for now."
msgstr "Je vais passer pour l'instant."

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink2c/0/c-1/23/c-1/15
msgctxt "Hoove"
msgid "Let's just let go of a few things."
msgstr "Lâchons juste quelques trucs."

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink2c/0/c-1/23/c-1/23/0/s/0
msgctxt "Choix"
msgid "Great!"
msgstr "Super !"

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink2c/0/c-1/23/c-1/23/1/s/0
msgctxt "Choix"
msgid "Would you look at the time? I gotta go."
msgstr "Oh, regarde l'heure ! Il faut que j'y aille."

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink2c/0/c-1/23/c-1/23/c-1/7
msgctxt "Hoove"
msgid "Was it something I said?"
msgstr "C'est quelque chose que j'ai dit ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/0
msgctxt "Hoove"
msgid "So... I've been thinking."
msgstr "Alors... j'ai réfléchi."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/8
msgctxt "Hoove"
msgid "I have a bunch of things left."
msgstr "Il me reste un tas de choses."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/16
msgctxt "Hoove"
msgid "I could let them <i>all</i> go at once."
msgstr "Je pourrais <i>toutes</i> les lâcher d'un coup."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/24
msgctxt "Hoove"
msgid "Or I can go one by one, and maybe keep a few."
msgstr "Ou y aller une par une, et peut-être en garder quelques-unes."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/32
msgctxt "Hoove"
msgid "What do you think?"
msgstr "Qu'est-ce que tu en penses ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/40/s/0
msgctxt "Choix"
msgid "Let's go piece by piece."
msgstr "Allons-y morceau par morceau."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/41/s/0
msgctxt "Choix"
msgid "I think you should let them all go."
msgstr "Je pense que tu devrais toutes les lâcher."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/c-1/7
msgctxt "Hoove"
msgid "That's a big leap of faith..."
msgstr "C'est un sacré saut dans le vide..."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/c-1/15
msgctxt "Hoove"
msgid "But it feels right!"
msgstr "Mais ça me semble juste !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/c-1/23
msgctxt "Hoove"
msgid "Feels like the winning move."
msgstr "Ça ressemble au coup gagnant."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/c-1/31
msgctxt "Hoove"
msgid "Yet I'm torn..."
msgstr "Pourtant, j'hésite..."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/c-1/39
msgctxt "Hoove"
msgid "What would the Hankees do?"
msgstr "Que feraient les Hankees ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/c-1/47/0/s/0
msgctxt "Choix"
msgid "They'd do it. Trust a super fan."
msgstr "Ils le feraient. Fais confiance à un super fan."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/c-1/47/1/s/0
msgctxt "Choix"
msgid "They'd win. Like they won today!"
msgstr "Ils gagneraient. Comme ils ont gagné aujourd'hui !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/c-1/47/2/s/0
msgctxt "Choix"
msgid "They lost today. But you can win!"
msgstr "Ils ont perdu aujourd'hui. Mais toi, tu peux gagner !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/c-1/47/3/s/0
msgctxt "Choix"
msgid "Um... They'd... win?"
msgstr "Euh... Ils... gagneraient ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/c-1/47/4/s/0
msgctxt "Choix"
msgid "They'd do it!"
msgstr "Ils le feraient !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/c-1/47/c-2/7
msgctxt "Hoove"
msgid "That's not very encouraging."
msgstr "C'est pas très encourageant."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/c-1/47/c-2/15
msgctxt "Hoove"
msgid "I think I need to go a bit slower."
msgstr "Je crois que je dois y aller un peu plus doucement."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/c-1/47/c-3/7 hoove_vacuum/HooveLetGo2/0/c-1/47/c-4/7
msgctxt "Hoove"
msgid "But they lost today..."
msgstr "Mais ils ont perdu aujourd'hui..."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/c-1/47/c-3/15 hoove_vacuum/HooveLetGo2/0/c-1/47/c-4/15
msgctxt "Hoove"
msgid "And if they lost, maybe I would lose too!"
msgstr "Et s'ils ont perdu, peut-être que moi aussi, je perdrais !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/c-1/47/c-3/23 hoove_vacuum/HooveLetGo2/0/c-1/47/c-4/23
msgctxt "Hoove"
msgid "Maybe I'd lose myself, my identity!"
msgstr "Peut-être que je me perdrais moi-même, mon identité !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/c-1/47/c-3/31 hoove_vacuum/HooveLetGo2/0/c-1/47/c-4/31
msgctxt "Hoove"
msgid "No... No I'm not ready to go all in."
msgstr "Non... Non, je ne suis pas prêt à tout miser."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/c-1/47/c-3/39 hoove_vacuum/HooveLetGo2/0/c-1/47/c-4/39
msgctxt "Hoove"
msgid "But I guess I can go one by one."
msgstr "Mais je suppose que je peux y aller une par une."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-0/0
msgctxt "Hoove"
msgid "You're right! My Hanks would do it!"
msgstr "Tu as raison ! Mes Hanks le feraient !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-0/8
msgctxt "Hoove"
msgid "Thanks for the encouragement."
msgstr "Merci pour l'encouragement."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-0/16
msgctxt "Hoove"
msgid "But still..."
msgstr "Mais quand même..."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-0/24/s/0
msgctxt "Choix"
msgid "GO HOOVE! Be the vacuum you always were inside!"
msgstr "ALLEZ HOOVE ! Sois le vide que tu as toujours été à l'intérieur !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-0/25/s/0 hoove_vacuum/HooveLetGo2/0/g-0/26/s/0
msgctxt "Choix"
msgid "Aren't you a bit buzzed?"
msgstr "Tu n'es pas un peu pompette ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-0/27/s/0
msgctxt "Choix"
msgid "C'mon! You got this!"
msgstr "Allez ! Tu vas y arriver !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-0/c-2/7
msgctxt "Hoove"
msgid "Whoah... does that mean there's nothing in me but space?"
msgstr "Waouh... ça veut dire qu'il n'y a rien en moi, à part du vide ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-0/c-2/15
msgctxt "Hoove"
msgid "I'm not sure I'm ready for that."
msgstr "Je ne suis pas sûr d'être prêt pour ça."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-0/c-2/23
msgctxt "Hoove"
msgid "Let's take this slow, ok?"
msgstr "Allons-y doucement, ok ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-0/c-3/7
msgctxt "Hoove"
msgid "You're right! Liquid courage!"
msgstr "Tu as raison ! Le courage liquide !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-0/c-3/15
msgctxt "Hoove"
msgid "I got this!"
msgstr "Je vais y arriver !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-0/c-4/7
msgctxt "Hoove"
msgid "Buzzed? I'm drunk!"
msgstr "Pompette ? Je suis bourré !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-0/c-4/15
msgctxt "Hoove"
msgid "Maybe I better go one by one after all..."
msgstr "Je ferais peut-être mieux d'y aller une par une, finalement..."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-0/c-5/7
msgctxt "Hoove"
msgid "I don't know if I do..."
msgstr "Je sais pas si j'en ai envie..."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-0/c-5/15
msgctxt "Hoove"
msgid "I better slow down and do this piece by piece."
msgstr "Je ferais mieux de ralentir et de faire ça petit à petit."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-1/0
msgctxt "Hoove"
msgid "But wait... What am I really doing all this for?"
msgstr "Mais attends... Pour quoi je fais tout ça, au juste ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-1/8/s/0
msgctxt "Choix"
msgid "Because you're ready to be free!"
msgstr "Parce que tu es prêt à être libre !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-1/9/s/0
msgctxt "Choix"
msgid "For love, Hoove. Remember our kiss?"
msgstr "Pour l'amour, Hoove. Tu te souviens de notre baiser ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-1/c-6/7
msgctxt "Hoove"
msgid "Am I though?"
msgstr "Vraiment ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-1/c-6/15
msgctxt "Hoove"
msgid "I don't know if I want to be free of EVERYTHING at once!"
msgstr "Je sais pas si je veux me libérer de TOUT en même temps !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-1/c-6/23
msgctxt "Hoove"
msgid "I need to take a step back."
msgstr "Je dois faire un pas en arrière."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-1/c-6/31
msgctxt "Hoove"
msgid "Let's go one by one."
msgstr "Allons-y une par une."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-1/c-7/7
msgctxt "Hoove"
msgid "I do... I do remember that."
msgstr "Si... Je m'en souviens."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-1/c-7/15
msgctxt "Hoove"
msgid "Ok... I'm finally brave enough to tackle this."
msgstr "Ok... Je suis enfin assez courageux pour m'y attaquer."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-1/c-7/26
msgctxt "Hoove"
msgid "It's time for me to make room for love, once and for all!"
msgstr "Il est temps que je fasse de la place pour l'amour, une bonne fois pour toutes !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-1/c-7/34 hoove_vacuum/HooveLastOne/0/11
msgctxt "Hoove"
msgid "It's time for me to empty my bag completely."
msgstr "Il est temps que je vide complètement mon sac."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-1/c-7/42 hoove_vacuum/HooveLastOne/0/19
msgctxt "Hoove"
msgid "Here goes..."
msgstr "C'est parti..."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-1/c-7/50 hoove_vacuum/HooveLastOne/0/27
msgctxt "Hoove"
msgid "PPPsakjcoidsjiafjsojaidjoaihwodijaosjd"
msgstr "PPPsakjcoidsjiafjsojaidjoaihwodijaosjd"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-1/c-7/61 hoove_vacuum/HooveLastOne/0/38
msgctxt "Hoove"
msgid "WWWWWhhhhhhhooooooooaaaaaaaahhhhhhhh!!!!!!"
msgstr "WWWWWhhhhhhhooooooooaaaaaaaahhhhhhhh!!!!!!"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-1/c-7/69
msgctxt "Narrator"
msgid "There's so much noise, then a silence so thick and heavy it's choking. Hoove looks lost, staring into the distance without speaking a single word."
msgstr "Il y a tellement de bruit, puis un silence si épais et si lourd qu'il étouffe. Hoove a l'air perdu, le regard dans le vide, sans prononcer un seul mot."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-1/c-7/95/0/s/0 hoove_vacuum/HooveLastOne/0/72/s/0
msgctxt "Choix"
msgid "Are you ok!?"
msgstr "Ça va !?"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-1/c-7/95/1/s/0 hoove_vacuum/HooveLastOne/0/73/s/0
msgctxt "Choix"
msgid "What just happened?"
msgstr "Qu'est-ce qui vient de se passer ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-1/c-7/95/2/s/0 hoove_vacuum/HooveLastOne/0/74/s/0
msgctxt "Choix"
msgid "You did it!"
msgstr "Tu l'as fait !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-2/0 hoove_vacuum/HooveLastOne/0/g-0/0
msgctxt "Hoove"
msgid "I'm..."
msgstr "Je suis..."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-2/8 hoove_vacuum/HooveLastOne/0/g-0/8
msgctxt "Hoove"
msgid "I..."
msgstr "Je..."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-2/16 hoove_vacuum/HooveLastOne/0/g-0/16
msgctxt "Hoove"
msgid "I need a minute."
msgstr "J'ai besoin d'une minute."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-2/24 hoove_vacuum/HooveLetGo2b/0/g-2/19 hoove_vacuum/HooveLastOne/0/g-0/24
msgctxt "Hoove"
msgid "Please come back again soon, ok?"
msgstr "Reviens vite me voir, ok ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-2/32/s/0 hoove_vacuum/HooveLetGo2b/0/g-1/c-7/55/0/s/0 hoove_vacuum/HooveLetGo2b/0/g-2/27/s/0 hoove_vacuum/HooveLastOne/0/g-0/32/s/0
msgctxt "Choix"
msgid "Ok."
msgstr "Ok."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-2/33/s/0 hoove_vacuum/HooveLastOne/0/g-0/33/s/0
msgctxt "Choix"
msgid "Bye Hoove. I hope you're ok."
msgstr "Salut Hoove. J'espère que ça va aller."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-2/34/s/0
msgctxt "Choix"
msgid "One drink for the road?"
msgstr "Un verre pour la route ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2/0/g-2/c-10/7
msgctxt "Hoove"
msgid "I'm not sure I'm ready for that..."
msgstr "Je suis pas sûr d'être prêt pour ça..."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/0
msgctxt "Hoove"
msgid "Let's take a look at what's in there."
msgstr "Voyons ce qu'il y a là-dedans."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/11
msgctxt "Hoove"
msgid "I've got this origami bird."
msgstr "J'ai cet oiseau en origami."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/19/s/0
msgctxt "Choix"
msgid "Let it fly!"
msgstr "Laisse-le s'envoler !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/20/s/0
msgctxt "Choix"
msgid "Keep that. It looks precious."
msgstr "Garde-le. Il a l'air précieux."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/c-0/7
msgctxt "Hoove"
msgid "Ooh... But I loved finding this. Are you sure?"
msgstr "Ooh... Mais j'ai adoré le trouver. Tu es sûr ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/c-0/18/0/s/0
msgctxt "Choix"
msgid "Sure as I am that the Hankees crushed today!"
msgstr "Aussi vrai que les Hankees ont tout écrasé aujourd'hui !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/c-0/18/1/s/0
msgctxt "Choix"
msgid "Sure as I am that you frenched me earlier."
msgstr "Aussi vrai que tu m'as roulé une pelle tout à l'heure."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/c-0/18/2/s/0
msgctxt "Choix"
msgid "Pretty sure?"
msgstr "Disons... oui ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/c-0/18/3/s/0
msgctxt "Choix"
msgid "Maybe you'd better keep it, then."
msgstr "Tu ferais peut-être mieux de le garder, alors."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/c-0/18/c-0/7
msgctxt "Hoove"
msgid "Alright! I'll let this one go!"
msgstr "Très bien ! Je le laisse partir !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/c-0/18/c-1/7
msgctxt "Hoove"
msgid "I'd let go of anything for a kiss like that."
msgstr "Je lâcherais n'importe quoi pour un baiser comme ça."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/c-0/18/c-1/15
msgctxt "Hoove"
msgid "Bye bye birdie!"
msgstr "Salut, l'artiste !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/c-0/18/c-2/7
msgctxt "Hoove"
msgid "I don't know... that's not too convincing."
msgstr "Je sais pas... c'est pas très convaincant."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/c-0/18/c-2/15
msgctxt "Hoove"
msgid "I'll keep this one."
msgstr "Je garde celui-là."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/c-0/18/c-3/7
msgctxt "Hoove"
msgid "Alright, I'll hang onto it."
msgstr "Très bien, je vais le garder."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/c-1/7
msgctxt "Hoove"
msgid "Alright. I'll hang onto it!"
msgstr "Très bien. Je le garde !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/g-0/0
msgctxt "Hoove"
msgid "Next up is this."
msgstr "Ensuite, il y a ça."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/g-0/11
msgctxt "Hoove"
msgid "Wait... what <i>is</i> this?"
msgstr "Attends... c'est <i>quoi</i>, ça ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/g-0/19
msgctxt "Hoove"
msgid "I think it's a..."
msgstr "Je crois que c'est un..."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/g-0/27/s/0
msgctxt "Choix"
msgid "Hoove, tell me that's not a booger."
msgstr "Hoove, dis-moi que c'est pas une crotte de nez."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/g-0/28/s/0
msgctxt "Choix"
msgid "That's a piece of old cheese."
msgstr "C'est un bout de vieux fromage."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/g-0/29/s/0
msgctxt "Choix"
msgid "LORD GOD THROW THAT AWAY!"
msgstr "BON SANG, JETTE ÇA !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/g-1/0
msgctxt "Hoove"
msgid "Whoah whoah, easy!"
msgstr "Whoah whoah, doucement !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/g-1/8
msgctxt "Hoove"
msgid "I'm not even sure I wanna touch it again..."
msgstr "Je suis même pas sûr de vouloir y retoucher..."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/g-1/19/s/0
msgctxt "Choix"
msgid "Pretty please get rid of it!"
msgstr "S'il te plaît, débarrasse-t'en !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/g-1/20/s/0
msgctxt "Choix"
msgid "Keep it out of sight in your bag!"
msgstr "Garde-le caché dans ton sac !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/g-1/21/s/0 hoove_vacuum/HooveLetGo2b/0/g-1/22/s/0
msgctxt "Choix"
msgid "Liquid courage! Remember?"
msgstr "Le courage liquide ! Tu te souviens ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/g-1/23/s/0
msgctxt "Choix"
msgid "My superfan senses are tingling..."
msgstr "Mes sens de super fan picotent..."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/g-1/c-5/7
msgctxt "Hoove"
msgid "I'm just gonna leave it where it is."
msgstr "Je vais le laisser là où il est."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/g-1/c-5/18
msgctxt "Hoove"
msgid "Let's forget we ever saw it, ok?"
msgstr "Oublions qu'on l'a jamais vu, ok ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/g-1/c-6/7
msgctxt "Hoove"
msgid "YUCK. Ok. Out of sight out of mind."
msgstr "BERK. Ok. Loin des yeux, loin du coeur."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/g-1/c-7/7
msgctxt "Hoove"
msgid "Lick... Quid... <w>hic</w>"
msgstr "Cou... rage... li... <w>hic</w>"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/g-1/c-7/15
msgctxt "Hoove"
msgid "Liquid blurrage."
msgstr "Courage liquoreux."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/g-1/c-7/23
msgctxt "Hoove"
msgid "Lemme just tuck this back away for a minute."
msgstr "Laisse-moi juste ranger ça une minute."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/g-1/c-7/31
msgctxt "Hoove"
msgid "I'm still feeling a little dizzy!"
msgstr "J'ai encore un peu la tête qui tourne !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/g-1/c-7/47
msgctxt "Hoove"
msgid "... come back soon okay?"
msgstr "... reviens vite, d'accord ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/g-1/c-7/55/1/s/0 hoove_vacuum/HooveLetGo2b/0/g-2/28/s/0
msgctxt "Choix"
msgid "Bye Hoove. Get some rest."
msgstr "Salut Hoove. Repose-toi bien."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/g-1/c-7/55/c-0/7
msgctxt "Hoove"
msgid "Boof."
msgstr "Boof."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/g-1/c-7/55/c-1/7
msgctxt "Hoove"
msgid "Whooo...."
msgstr "Whooo...."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/g-1/c-8/13
msgctxt "Hoove"
msgid "You're right!"
msgstr "Tu as raison !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/g-1/c-8/21
msgctxt "Hoove"
msgid "Goodbye gross... thing!"
msgstr "Adieu, dégoûtante... chose !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/g-1/c-9/13
msgctxt "Hoove"
msgid "Super fan? Wait... Wait!"
msgstr "Super fan ? Attends... Attends !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/g-1/c-9/21
msgctxt "Hoove"
msgid "THAT'S TOE GUNK!"
msgstr "C'EST DE LA CRASSE D'ORTEIL !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/g-1/c-9/32
msgctxt "Hoove"
msgid "It belongs to the Socks!"
msgstr "Ça appartient aux Socks !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/g-1/c-9/40
msgctxt "Hoove"
msgid "I'm getting rid of it IMMEDIATELY!"
msgstr "Je m'en débarrasse IMMÉDIATEMENT !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/g-1/c-9/51
msgctxt "Hoove"
msgid "Bye bye!"
msgstr "Salut, salut !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/g-2/3
msgctxt "Hoove"
msgid "Wow. Well all that was a bit exhausting."
msgstr "Waouh. Eh bien, tout ça, c'était un peu épuisant."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/g-2/11
msgctxt "Hoove"
msgid "I think I need a minute."
msgstr "Je crois que j'ai besoin d'une minute."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2b/0/g-2/29/s/0 hoove_vacuum/HooveLastOne/0/g-0/34/s/0
msgctxt "Choix"
msgid "I'll be back as soon as I can."
msgstr "Je reviens dès que je peux."

# Traduction IA – à relire
#: hoove_vacuum/HooveLastOne/0/0
msgctxt "Hoove"
msgid "Ok... Here goes... Enough is enough."
msgstr "Ok... C'est parti... Trop, c'est trop."

# Traduction IA – à relire
#: hoove_vacuum/HooveLastOne/0/46
msgctxt "Narrator"
msgid "There's so much noise, and then a silence so thick and heavy it's choking. Hoove looks lost, staring into the distance without speaking a single word."
msgstr "Il y a tellement de bruit, puis un silence si épais et si lourd qu'il étouffe. Hoove a l'air perdu, le regard dans le vide, sans prononcer un seul mot."

# Traduction IA – à relire
#: hoove_vacuum/HooveHangover/0/6
msgctxt "Hoove"
msgid "Ohhhh my head..."
msgstr "Ohhhh ma tête..."

# Traduction IA – à relire
#: hoove_vacuum/HooveHangover/0/14
msgctxt "Hoove"
msgid "What did I do last night?"
msgstr "Qu'est-ce que j'ai fait hier soir ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveHangover/0/25/s/0
msgctxt "Choix"
msgid "I have no idea."
msgstr "Aucune idée."

# Traduction IA – à relire
#: hoove_vacuum/HooveHangover/0/26/s/0
msgctxt "Choix"
msgid "You went pretty hard on that oil..."
msgstr "Tu y es allé fort sur l'huile..."

# Traduction IA – à relire
#: hoove_vacuum/HooveHangover/0/27/s/0
msgctxt "Choix"
msgid "What didn't you do last night?"
msgstr "Qu'est-ce que tu n'as pas fait hier soir ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveHangover/0/g-0/0
msgctxt "Hoove"
msgid "All that bright light everywhere isn't helping."
msgstr "Toute cette lumière vive partout, ça n'aide pas."

# Traduction IA – à relire
#: hoove_vacuum/HooveHangover/0/g-0/8/b/1
msgctxt "Hoove"
msgid "Lux, could you PLEASE turn that off?"
msgstr "Lux, tu pourrais S'IL TE PLAÎT éteindre ça ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveHangover/0/g-0/8/b/15
msgctxt "Lux"
msgid "No."
msgstr "Non."

# Traduction IA – à relire
#: hoove_vacuum/HooveHangover/0/g-0/8/b/29
msgctxt "Hoove"
msgid "Thanks Lux. Thanks a lot."
msgstr "Merci Lux. Merci beaucoup."

# Traduction IA – à relire
#: hoove_vacuum/HooveHangover/0/g-0/11
msgctxt "Hoove"
msgid "I think I'm gonna be sick..."
msgstr "Je crois que je vais être malade..."

# Traduction IA – à relire
#: hoove_vacuum/HooveHangover/0/g-0/19/s/0
msgctxt "Choix"
msgid "Maybe that's just what you need!"
msgstr "C'est peut-être exactement ce qu'il te faut !"

# Traduction IA – à relire
#: hoove_vacuum/HooveHangover/0/g-0/20/s/0
msgctxt "Choix"
msgid "No! Just breathe. You'll be ok."
msgstr "Non ! Respire, c'est tout. Ça va aller."

# Traduction IA – à relire
#: hoove_vacuum/HooveHangover/0/g-0/c-3/7
msgctxt "Hoove"
msgid "Oh boy, here it comes..."
msgstr "Oh là là, ça vient..."

# Traduction IA – à relire
#: hoove_vacuum/HooveHangover/0/g-0/c-3/15
msgctxt "Hoove"
msgid "BLECH."
msgstr "BLURP."

# Traduction IA – à relire
#: hoove_vacuum/HooveHangover/0/g-0/c-3/26
msgctxt "Narrator"
msgid "Hoove empties the contents of his bag onto the floor—while you'd rather he'd done it in the trash can you're intensely grateful in this moment that he's a vacuum cleaner and not a human being."
msgstr "Hoove vide le contenu de son sac sur le sol. Vous auriez préféré qu'il le fasse dans la poubelle, mais à cet instant, vous êtes intensément {{reconnaissant|reconnaissante|reconnaissant·e}} qu'il soit un aspirateur et non un être humain."

# Traduction IA – à relire
#: hoove_vacuum/HooveHangover/0/g-0/c-3/40
msgctxt "Hoove"
msgid "Well would you look at that?"
msgstr "Eh bien, regarde-moi ça !"

# Traduction IA – à relire
#: hoove_vacuum/HooveHangover/0/g-0/c-3/48
msgctxt "Hoove"
msgid "An old chess piece."
msgstr "Une vieille pièce d'échecs."

# Traduction IA – à relire
#: hoove_vacuum/HooveHangover/0/g-0/c-3/56
msgctxt "Hoove"
msgid "Guess I needed to get rid of that!"
msgstr "Je suppose que j'avais besoin de m'en débarrasser !"

# Traduction IA – à relire
#: hoove_vacuum/HooveHangover/0/g-0/c-3/64
msgctxt "Hoove"
msgid "Thanks! I feel a lot better now!"
msgstr "Merci ! Je me sens bien mieux maintenant !"

# Traduction IA – à relire
#: hoove_vacuum/HooveHangover/0/g-0/c-3/72
msgctxt "Hoove"
msgid "But I think I better lie down."
msgstr "Mais je crois que je ferais mieux de m'allonger."

# Traduction IA – à relire
#: hoove_vacuum/HooveHangover/0/g-0/c-3/80 hoove_vacuum/HooveHangover/0/g-0/c-4/23
msgctxt "Hoove"
msgid "Come see me again soon, ok?"
msgstr "Reviens me voir bientôt, ok ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveHangover/0/g-0/c-4/7
msgctxt "Hoove"
msgid "Oof... Ok..."
msgstr "Ouf... Ok..."

# Traduction IA – à relire
#: hoove_vacuum/HooveHangover/0/g-0/c-4/15
msgctxt "Hoove"
msgid "But I think I need to rest."
msgstr "Mais je crois que j'ai besoin de me reposer."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/0
msgctxt "Hoove"
msgid "...huh? Oh! Hi..."
msgstr "...hein ? Oh ! Salut..."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/8
msgctxt "Hoove"
msgid "Sorry, I... I guess I drifted off for a sec."
msgstr "Désolé, je... je crois que je me suis assoupi une seconde."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/16
msgctxt "Hoove"
msgid "Been feeling even more scatterbrained than usual."
msgstr "Je suis encore plus tête en l'air que d'habitude."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/24/s/0
msgctxt "Choix"
msgid "I'll say! There's a clump of dirt right next to you!"
msgstr "Tu l'as dit ! Il y a une crotte de poussière juste à côté de toi !"

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/25/s/0
msgctxt "Choix"
msgid "Maybe a little love would fix you up!"
msgstr "Un peu d'amour te remettrait peut-être sur pied !"

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/26/s/0
msgctxt "Choix"
msgid "That's ok. Sometimes I get that way too."
msgstr "C'est pas grave. Ça m'arrive aussi, des fois."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/c-0/7
msgctxt "Hoove"
msgid "Oh... Yeah."
msgstr "Oh... Ouais."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/c-0/15
msgctxt "Hoove"
msgid "I tried to suck it up but I just don't seem to have it in me."
msgstr "J'ai essayé de prendre sur moi, mais je manque d'aspiration."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/c-1/7
msgctxt "Hoove"
msgid "Love? Who has time for love?"
msgstr "L'amour ? Qui a le temps pour l'amour ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/c-1/15
msgctxt "Hoove"
msgid "Just another... unnecessary thing."
msgstr "Juste une autre chose... inutile."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/c-2/7
msgctxt "Hoove"
msgid "Yeah, I guess it's normal."
msgstr "Ouais, je suppose que c'est normal."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/g-0/0
msgctxt "Hoove"
msgid "Anyway..."
msgstr "Enfin bref..."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/g-0/8
msgctxt "Hoove"
msgid "I don't know if I've got the space in the day to hang right now."
msgstr "Je sais pas si j'ai la place dans ma journée pour passer du temps avec toi en ce moment."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/g-0/16/s/0
msgctxt "Choix"
msgid "But you're not even doing anything."
msgstr "Mais tu ne fais même rien."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/g-0/17/s/0
msgctxt "Choix"
msgid "You sound so down! I wanna help!"
msgstr "Tu as l'air tellement abattu ! Je veux t'aider !"

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/g-0/18/s/0
msgctxt "Choix"
msgid "Hoove, this has gone too far."
msgstr "Hoove, ça a été trop loin."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/g-0/c-3/7
msgctxt "Hoove"
msgid "Yeah... Still feels like I'm jam packed."
msgstr "Ouais... J'ai toujours l'impression d'être plein à craquer."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/g-0/c-4/7
msgctxt "Hoove"
msgid "Help? That would be nice."
msgstr "M'aider ? Ce serait bien."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/g-0/c-5/7
msgctxt "Hoove"
msgid "You're probably right..."
msgstr "Tu as probablement raison..."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/g-1/0/s/0
msgctxt "Choix"
msgid "Can't we just... like... hang out?"
msgstr "On ne peut pas juste... genre... traîner ensemble ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/g-1/1/s/0
msgctxt "Choix"
msgid "It's time you let some things go."
msgstr "Il est temps que tu lâches quelques trucs."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/g-1/c-7/7
msgctxt "Hoove"
msgid "Huh? Oh... Yeah!"
msgstr "Hein ? Oh... Ouais !"

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/g-1/c-7/15
msgctxt "Hoove"
msgid "I guess we could do that."
msgstr "Je suppose qu'on pourrait faire ça."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/g-1/c-7/23
msgctxt "Hoove"
msgid "Do you wanna go to a game... or...?"
msgstr "Tu veux aller voir un match... ou...?"

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/g-1/c-7/31
msgctxt "Hoove"
msgid "Have a drink or somethin'?"
msgstr "Prendre un verre ou un truc comme ça ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/g-1/c-7/39/0/s/0
msgctxt "Choix"
msgid "No, I mean just hang out here! Like two buds!"
msgstr "Non, je veux dire traîner juste ici, tranquilles ! Tout simplement !"

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/g-1/c-7/39/1/s/0
msgctxt "Choix"
msgid "Sure! A game would be great, Hoove."
msgstr "Bien sûr ! Un match, ce serait génial, Hoove."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/g-1/c-7/39/2/s/0
msgctxt "Choix"
msgid "Let's get a drink!"
msgstr "Prenons un verre !"

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/g-1/c-7/39/c-0/7
msgctxt "Hoove"
msgid "Um... Ok."
msgstr "Euh... Ok."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/g-1/c-8/7
msgctxt "Hoove"
msgid "I don't know if I can just jump into that so fast."
msgstr "Je sais pas si je peux me lancer là-dedans aussi vite."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/g-1/c-8/15
msgctxt "Hoove"
msgid "I've been collecting things for so long."
msgstr "Ça fait si longtemps que je collectionne des trucs."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/g-1/c-8/23
msgctxt "Hoove"
msgid "They feel like a part of my identity."
msgstr "J'ai l'impression que ça fait partie de mon identité."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/g-1/c-8/31
msgctxt "Hoove"
msgid "In order to feel comfortable letting things go..."
msgstr "Pour me sentir à l'aise de lâcher des choses..."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/g-1/c-8/39
msgctxt "Hoove"
msgid "I think I need to reclaim some of myself first."
msgstr "Je crois que j'ai d'abord besoin de reprendre un peu possession de moi-même."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/g-1/c-8/47/0/s/0
msgctxt "Choix"
msgid "Wanna grab a drink with me?"
msgstr "Tu veux boire un verre avec moi ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/g-1/c-8/47/1/s/0
msgctxt "Choix"
msgid "I bet a game would help you do that!"
msgstr "Je parie qu'un match t'aiderait à faire ça !"

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/g-1/c-8/47/2/s/0
msgctxt "Choix"
msgid "What if you tap into your desires?"
msgstr "Et si tu écoutais tes envies ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/g-1/c-8/47/c-0/7
msgctxt "Hoove"
msgid "I used to love that! Sure! Let's do it!"
msgstr "J'adorais ça ! Bien sûr ! Allons-y !"

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter3b/0/g-1/c-8/47/c-2/11
msgctxt "Hoove"
msgid "You know... I haven't let myself feel good in a long time."
msgstr "Tu sais... ça fait longtemps que je ne me suis pas permis de me sentir bien."

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2Temp/0/0/s/0
msgctxt "Choix"
msgid "Feel like a game first?"
msgstr "Envie d'un match d'abord ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2Temp/0/1/s/0
msgctxt "Choix"
msgid "Let's get to it!"
msgstr "Allons-y !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2Temp/0/2/s/0
msgctxt "Choix"
msgid "How about a quick drinkie first!"
msgstr "Et si on prenait un petit verre d'abord !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2Temp/0/c-0/7
msgctxt "Hoove"
msgid "You know what? That would be awesome!"
msgstr "Tu sais quoi ? Ce serait génial !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLetGo2Temp/0/c-2/7
msgctxt "Hoove"
msgid "Sounds great!"
msgstr "Ça me paraît super !"

# Traduction IA – à relire
#: hoove_vacuum/HooveJustHangLame/0/0
msgctxt "Hoove"
msgid "Alright! Here we are... just... hangin."
msgstr "Voilà ! Nous y sommes... juste... à traîner."

# Traduction IA – à relire
#: hoove_vacuum/HooveJustHangLame/0/16
msgctxt "Hoove"
msgid "Pretty cool, isn't it?"
msgstr "Plutôt cool, non ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveJustHangLame/0/27/s/0
msgctxt "Choix"
msgid "This isn't exactly what I had in mind."
msgstr "Ce n'est pas exactement ce que j'avais en tête."

# Traduction IA – à relire
#: hoove_vacuum/HooveJustHangLame/0/28/s/0
msgctxt "Choix"
msgid "I think I better go."
msgstr "Je crois que je ferais mieux d'y aller."

# Traduction IA – à relire
#: hoove_vacuum/HooveJustHangLame/0/c-0/7
msgctxt "Hoove"
msgid "Oh! Well... We could do something else."
msgstr "Oh ! Eh bien... On pourrait faire autre chose."

# Traduction IA – à relire
#: hoove_vacuum/HooveJustHangLame/0/c-0/15/0/s/0 hoove_vacuum/HooveJustHangLame/0/c-0/15/c-2/23/1/s/0
msgctxt "Choix"
msgid "Let's do that game."
msgstr "Allons voir ce match."

# Traduction IA – à relire
#: hoove_vacuum/HooveJustHangLame/0/c-0/15/1/s/0 hoove_vacuum/HooveJustHangLame/0/c-0/15/c-2/23/2/s/0
msgctxt "Choix"
msgid "Let's grab something to drink."
msgstr "Prenons quelque chose à boire."

# Traduction IA – à relire
#: hoove_vacuum/HooveJustHangLame/0/c-0/15/2/s/0
msgctxt "Choix"
msgid "Wanna make out?"
msgstr "Tu veux qu'on s'embrasse à pleine bouche ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveJustHangLame/0/c-0/15/c-2/7
msgctxt "Hoove"
msgid "No. Not really."
msgstr "Non. Pas vraiment."

# Traduction IA – à relire
#: hoove_vacuum/HooveJustHangLame/0/c-0/15/c-2/15
msgctxt "Hoove"
msgid "I'm just not in the mood for that right now."
msgstr "Je ne suis juste pas d'humeur pour ça en ce moment."

# Traduction IA – à relire
#: hoove_vacuum/HooveJustHangLame/0/c-0/15/c-2/23/0/s/0
msgctxt "Choix"
msgid "I'll see myself out."
msgstr "Je vais me débrouiller pour sortir."

# Traduction IA – à relire
#: hoove_vacuum/HooveJustHangLame/0/c-0/15/c-2/23/c-0/7
msgctxt "Hoove"
msgid "Oh. Ok, bye."
msgstr "Oh. Ok, salut."

# Traduction IA – à relire
#: hoove_vacuum/HooveTotalVacuum/0/0
msgctxt "Hoove"
msgid "Hello."
msgstr "Bonjour."

# Traduction IA – à relire
#: hoove_vacuum/HooveTotalVacuum/0/11/s/0
msgctxt "Choix"
msgid "Hoove? Are you alright?"
msgstr "Hoove ? Ça va ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveTotalVacuum/0/12/s/0
msgctxt "Choix"
msgid "Hi Hoove. How's it going?"
msgstr "Salut Hoove. Comment ça va ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveTotalVacuum/0/g-0/0
msgctxt "Hoove"
msgid "It goes better than I could ever have imagined."
msgstr "Mieux que je n'aurais jamais pu l'imaginer."

# Traduction IA – à relire
#: hoove_vacuum/HooveTotalVacuum/0/g-0/8
msgctxt "Hoove"
msgid "I am... empty."
msgstr "Je suis... vide."

# Traduction IA – à relire
#: hoove_vacuum/HooveTotalVacuum/0/g-0/19
msgctxt "Hoove"
msgid "And yet, so full."
msgstr "Et pourtant, si plein."

# Traduction IA – à relire
#: hoove_vacuum/HooveTotalVacuum/0/g-0/30
msgctxt "Hoove"
msgid "My world once seemed so small."
msgstr "Mon monde me paraissait si petit autrefois."

# Traduction IA – à relire
#: hoove_vacuum/HooveTotalVacuum/0/g-0/38
msgctxt "Hoove"
msgid "Confined by what was in my bag..."
msgstr "Confiné à ce qu'il y avait dans mon sac..."

# Traduction IA – à relire
#: hoove_vacuum/HooveTotalVacuum/0/g-0/46
msgctxt "Hoove"
msgid "My usual routines...."
msgstr "Mes routines habituelles...."

# Traduction IA – à relire
#: hoove_vacuum/HooveTotalVacuum/0/g-0/54
msgctxt "Hoove"
msgid "And now it seems that everything is open to me."
msgstr "Et maintenant, tout me semble ouvert."

# Traduction IA – à relire
#: hoove_vacuum/HooveTotalVacuum/0/g-0/62
msgctxt "Hoove"
msgid "I have so much... space!"
msgstr "J'ai tellement de... place !"

# Traduction IA – à relire
#: hoove_vacuum/HooveTotalVacuum/0/g-0/73 hoove_vacuum/HooveOneThingLeft/0/g-0/40 hoove_vacuum/HooveABitMoreOpen/0/g-0/27
msgctxt "Hoove"
msgid "Space for fun, space for work, space for curiosity..."
msgstr "De la place pour s'amuser, pour travailler, pour la curiosité..."

# Traduction IA – à relire
#: hoove_vacuum/HooveTotalVacuum/0/g-0/81/s/0 hoove_vacuum/HooveOneThingLeft/0/g-0/48/s/0 hoove_vacuum/HooveABitMoreOpen/0/g-0/35/s/0
msgctxt "Choix"
msgid "Even space for love?"
msgstr "Même de la place pour l'amour ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveTotalVacuum/0/g-0/82/s/0 hoove_vacuum/HooveOneThingLeft/0/g-0/49/s/0 hoove_vacuum/HooveABitMoreOpen/0/g-0/36/s/0
msgctxt "Choix"
msgid "What about space for friendship?"
msgstr "Et de la place pour l'amitié ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveTotalVacuum/0/g-0/c-2/9/b/1 hoove_vacuum/HooveOneThingLeft/0/g-0/c-3/9/b/1 hoove_vacuum/HooveABitMoreOpen/0/g-0/c-3/9/b/1
msgctxt "Hoove"
msgid "To be honest, I don't know if I feel that connection with you."
msgstr "Pour être honnête, je ne sais pas si je ressens ce lien avec toi."

# Traduction IA – à relire
#: hoove_vacuum/HooveTotalVacuum/0/g-0/c-2/9/b/9 hoove_vacuum/HooveOneThingLeft/0/g-0/c-3/9/b/9 hoove_vacuum/HooveABitMoreOpen/0/g-0/c-3/9/b/9
msgctxt "Hoove"
msgid "I'm more open than I've ever been, but I don't think I'm open to love."
msgstr "Je suis plus ouvert que je ne l'ai jamais été, mais je ne crois pas être ouvert à l'amour."

# Traduction IA – à relire
#: hoove_vacuum/HooveTotalVacuum/0/g-0/c-2/9/b/17 hoove_vacuum/HooveOneThingLeft/0/g-0/c-3/9/b/17 hoove_vacuum/HooveABitMoreOpen/0/g-0/c-3/9/b/17
msgctxt "Hoove"
msgid "At least... not with you."
msgstr "Du moins... pas avec toi."

# Traduction IA – à relire
#: hoove_vacuum/HooveTotalVacuum/0/g-0/c-2/9/b/25 hoove_vacuum/HooveOneThingLeft/0/g-0/c-3/9/b/25 hoove_vacuum/HooveABitMoreOpen/0/g-0/c-3/9/b/25
msgctxt "Hoove"
msgid "It's not personal."
msgstr "Rien de personnel."

# Traduction IA – à relire
#: hoove_vacuum/HooveTotalVacuum/0/g-0/c-2/9/b/33 hoove_vacuum/HooveOneThingLeft/0/g-0/c-3/9/b/33 hoove_vacuum/HooveABitMoreOpen/0/g-0/c-3/9/b/33
msgctxt "Hoove"
msgid "Maybe we can just be friends?"
msgstr "Peut-être qu'on peut juste être ami·es ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveTotalVacuum/0/g-0/c-3/7 hoove_vacuum/HooveOneThingLeft/0/g-0/c-4/7
msgctxt "Hoove"
msgid "I have all the space in the world for that, now."
msgstr "J'ai toute la place du monde pour ça, maintenant."

# Traduction IA – à relire
#: hoove_vacuum/HooveTotalVacuum/0/g-0/c-3/15 hoove_vacuum/HooveOneThingLeft/0/g-0/c-4/15
msgctxt "Hoove"
msgid "I hope you and I can spend time together forever."
msgstr "J'espère qu'on pourra passer du temps ensemble pour toujours."

# Traduction IA – à relire
#: hoove_vacuum/HooveTotalVacuum/0/g-0/c-3/23 hoove_vacuum/HooveJustFriends/0/c-1/15 hoove_vacuum/HooveOneThingLeft/0/g-0/c-4/23
msgctxt "Hoove"
msgid "You've taught me so much..."
msgstr "Tu m'as tant appris..."

# Traduction IA – à relire
#: hoove_vacuum/HooveTotalVacuum/0/g-0/c-3/31 hoove_vacuum/HooveJustFriends/0/c-1/23 hoove_vacuum/HooveOneThingLeft/0/g-0/c-4/31
msgctxt "Hoove"
msgid "Most of all, about how to make room for what really matters."
msgstr "Surtout à faire de la place pour ce qui compte vraiment."

# Traduction IA – à relire
#: hoove_vacuum/HooveTotalVacuum/0/g-0/c-3/39 hoove_vacuum/HooveJustFriends/0/c-1/31
msgctxt "Hoove"
msgid "I might be a vacuum, but I'm sure not empty inside anymore."
msgstr "Je fais peut-être le vide partout, mais en moi, plus du tout."

# Traduction IA – à relire
#: hoove_vacuum/HooveTotalVacuum/0/g-0/c-3/47 hoove_vacuum/HooveJustFriends/0/c-1/39 hoove_vacuum/HooveOneThingLeft/0/g-0/c-4/39
msgctxt "Hoove"
msgid "Now what do you say?"
msgstr "Alors, qu'en dis-tu ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveTotalVacuum/0/g-0/c-3/55 hoove_vacuum/HooveJustFriends/0/c-1/47 hoove_vacuum/HooveOneThingLeft/0/g-0/c-4/47
msgctxt "Hoove"
msgid "Should we go catch a game?"
msgstr "On va voir un match ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveTotalVacuum/0/g-0/c-3/63/0/s/0 hoove_vacuum/HooveJustFriends/0/c-1/55/0/s/0 hoove_vacuum/HooveOneThingLeft/0/g-0/c-4/55/0/s/0
msgctxt "Choix"
msgid "Not without a quick drink first!"
msgstr "Pas sans un petit verre d'abord !"

# Traduction IA – à relire
#: hoove_vacuum/HooveTotalVacuum/0/g-0/c-3/63/1/s/0 hoove_vacuum/HooveJustFriends/0/c-1/55/1/s/0 hoove_vacuum/HooveOneThingLeft/0/g-0/c-4/55/1/s/0
msgctxt "Choix"
msgid "You bet, Hoove!"
msgstr "Et comment, Hoove !"

# Traduction IA – à relire
#: hoove_vacuum/HooveTotalVacuum/0/g-1/0 hoove_vacuum/HooveJustFriends/0/g-0/0 hoove_vacuum/HooveOneThingLeft/0/g-1/0
msgctxt "Hoove"
msgid "Now you're talkin!"
msgstr "Ça, c'est parler !"

# Traduction IA – à relire
#: hoove_vacuum/HooveJustFriends/0/0/s/0
msgctxt "Choix"
msgid "Yes. But we'd better part ways."
msgstr "Oui. Mais on ferait mieux de se séparer."

# Traduction IA – à relire
#: hoove_vacuum/HooveJustFriends/0/1/s/0
msgctxt "Choix"
msgid "I'd love that!"
msgstr "J'adorerais !"

# Traduction IA – à relire
#: hoove_vacuum/HooveJustFriends/0/c-0/7
msgctxt "Hoove"
msgid "I understand. But know I'll always consider you my friend."
msgstr "Je comprends. Mais sache que tu resteras toujours {{un ami|une amie|un·e ami·e}} pour moi."

# Traduction IA – à relire
#: hoove_vacuum/HooveJustFriends/0/c-0/15
msgctxt "Hoove"
msgid "I hope to see you soon, but I know that might not happen."
msgstr "J'espère te revoir bientôt, mais je sais que ça n'arrivera peut-être pas."

# Traduction IA – à relire
#: hoove_vacuum/HooveJustFriends/0/c-1/7
msgctxt "Hoove"
msgid "Great! In that case, I hope you and I can spend time together forever."
msgstr "Super ! Dans ce cas, j'espère qu'on pourra passer du temps ensemble pour toujours."

# Traduction IA – à relire
#: hoove_vacuum/HooveIsThisLove/0/0
msgctxt "Hoove"
msgid "We've shared a kiss, yes..."
msgstr "On a échangé un baiser, oui..."

# Traduction IA – à relire
#: hoove_vacuum/HooveIsThisLove/0/8
msgctxt "Hoove"
msgid "But I don't know if I'm ready to say I 'love' you."
msgstr "Mais je ne sais pas si je suis prêt à dire que je t'« aime »."

# Traduction IA – à relire
#: hoove_vacuum/HooveIsThisLove/0/16/s/0
msgctxt "Choix"
msgid "Think about the games!"
msgstr "Pense aux matchs !"

# Traduction IA – à relire
#: hoove_vacuum/HooveIsThisLove/0/17/s/0
msgctxt "Choix"
msgid "What about those cocktails?"
msgstr "Et ces cocktails ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveIsThisLove/0/18/s/0
msgctxt "Choix"
msgid "Even though I'm a superfan?"
msgstr "Même si je suis un super fan ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveIsThisLove/0/19/s/0
msgctxt "Choix"
msgid "Another kiss might help you decide."
msgstr "Un autre baiser t'aiderait peut-être à te décider."

# Traduction IA – à relire
#: hoove_vacuum/HooveIsThisLove/0/20/s/0
msgctxt "Choix"
msgid "That smarts."
msgstr "Aïe, ça fait mal."

# Traduction IA – à relire
#: hoove_vacuum/HooveIsThisLove/0/21/s/0
msgctxt "Choix"
msgid "It's cause I don't like sports, isn't it?"
msgstr "C'est parce que je n'aime pas le sport, c'est ça ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveIsThisLove/0/c-0/7
msgctxt "Hoove"
msgid "You know... We really did bond at the game, didn't we?"
msgstr "Tu sais... on a vraiment créé des liens pendant le match, non ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveIsThisLove/0/c-0/15 hoove_vacuum/HooveIsThisLove/0/c-1/15 hoove_vacuum/HooveIsThisLove/0/c-2/31 hoove_vacuum/HooveIsThisLove/0/c-3/15/c-0/42
msgctxt "Hoove"
msgid "Maybe I could love you!"
msgstr "Je pourrais peut-être t'aimer !"

# Traduction IA – à relire
#: hoove_vacuum/HooveIsThisLove/0/c-0/23 hoove_vacuum/HooveIsThisLove/0/c-1/23 hoove_vacuum/HooveIsThisLove/0/c-2/39 hoove_vacuum/HooveIsThisLove/0/c-3/15/c-0/50
msgctxt "Hoove"
msgid "I think we'd have a great time together!"
msgstr "Je pense qu'on passerait un super moment ensemble !"

# Traduction IA – à relire
#: hoove_vacuum/HooveIsThisLove/0/c-1/7
msgctxt "Hoove"
msgid "You know... We really did bond over drinks, didn't we?"
msgstr "Tu sais... on a vraiment créé des liens autour de verres, non ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveIsThisLove/0/c-2/7
msgctxt "Hoove"
msgid "Now that I think about it..."
msgstr "Maintenant que j'y pense..."

# Traduction IA – à relire
#: hoove_vacuum/HooveIsThisLove/0/c-2/15
msgctxt "Hoove"
msgid "Someone who knows that much about the Hanks MUST know a lot about me."
msgstr "Quelqu'un qui en sait autant sur les Hanks DOIT en savoir long sur moi."

# Traduction IA – à relire
#: hoove_vacuum/HooveIsThisLove/0/c-2/23
msgctxt "Hoove"
msgid "Even if I couldn't quite see it at first!"
msgstr "Même si je n'arrivais pas bien à le voir au début !"

# Traduction IA – à relire
#: hoove_vacuum/HooveIsThisLove/0/c-3/7
msgctxt "Hoove"
msgid "There's only one way to find out."
msgstr "Il n'y a qu'une façon de le savoir."

# Traduction IA – à relire
#: hoove_vacuum/HooveIsThisLove/0/c-3/15/0/s/0
msgctxt "Choix"
msgid "Let's do it with tongue this time."
msgstr "Faisons-le avec la langue cette fois."

# Traduction IA – à relire
#: hoove_vacuum/HooveIsThisLove/0/c-3/15/1/s/0
msgctxt "Choix"
msgid "A gentle kiss will be perfect."
msgstr "Un doux baiser sera parfait."

# Traduction IA – à relire
#: hoove_vacuum/HooveIsThisLove/0/c-3/15/c-0/26
msgctxt "Hoove"
msgid "HOT DAMN."
msgstr "WAOUH, BORDEL."

# Traduction IA – à relire
#: hoove_vacuum/HooveIsThisLove/0/c-3/15/c-0/34
msgctxt "Hoove"
msgid "Consider my mind changed."
msgstr "Considère que j'ai changé d'avis."

# Traduction IA – à relire
#: hoove_vacuum/HooveIsThisLove/0/c-3/15/c-1/15
msgctxt "Hoove"
msgid "As wonderful and sweet as that was..."
msgstr "Aussi merveilleux et doux que c'était..."

# Traduction IA – à relire
#: hoove_vacuum/HooveIsThisLove/0/c-3/15/c-1/23
msgctxt "Hoove"
msgid "I think I need more passion in a lover."
msgstr "Je crois que j'ai besoin de plus de passion dans une relation amoureuse."

# Traduction IA – à relire
#: hoove_vacuum/HooveIsThisLove/0/c-3/15/c-1/31
msgctxt "Hoove"
msgid "Let's just be friends, ok?"
msgstr "Restons simplement ami·es, ok ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveIsThisLove/0/c-4/7
msgctxt "Hoove"
msgid "I'm sorry."
msgstr "Je suis désolé."

# Traduction IA – à relire
#: hoove_vacuum/HooveIsThisLove/0/c-4/15
msgctxt "Hoove"
msgid "Maybe we can still be friends?"
msgstr "On peut peut-être rester ami·es ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveIsThisLove/0/c-5/7
msgctxt "Hoove"
msgid "No. It's more than that."
msgstr "Non. C'est plus que ça."

# Traduction IA – à relire
#: hoove_vacuum/HooveIsThisLove/0/c-5/15
msgctxt "Hoove"
msgid "The connection just isn't there, I'm sorry."
msgstr "Le lien n'est tout simplement pas là, désolé."

# Traduction IA – à relire
#: hoove_vacuum/HooveIsThisLove/0/c-5/23
msgctxt "Hoove"
msgid "I hope we can still be friends."
msgstr "J'espère qu'on pourra rester ami·es."

# Traduction IA – à relire
#: hoove_vacuum/HooveIsThisLove/0/c-5/31
msgctxt "Hoove"
msgid "Would you like that?"
msgstr "Ça te plairait ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveTrueLove/0/0
msgctxt "Hoove"
msgid "I finally have room in my heart."
msgstr "J'ai enfin de la place dans mon coeur."

# Traduction IA – à relire
#: hoove_vacuum/HooveTrueLove/0/8
msgctxt "Hoove"
msgid "And after what we've already shared, I think..."
msgstr "Et après ce qu'on a déjà partagé, je crois..."

# Traduction IA – à relire
#: hoove_vacuum/HooveTrueLove/0/16
msgctxt "Hoove"
msgid "I think I could love you."
msgstr "Je crois que je pourrais t'aimer."

# Traduction IA – à relire
#: hoove_vacuum/HooveTrueLove/0/24
msgctxt "Hoove"
msgid "What do you say you and I go somewhere... private?"
msgstr "Et si on allait quelque part... en privé ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveTrueLove/0/32/s/0
msgctxt "Choix"
msgid "I'd love nothing more, Hoove."
msgstr "Je ne demande que ça, Hoove."

# Traduction IA – à relire
#: hoove_vacuum/HooveTrueLove/0/33/s/0
msgctxt "Choix"
msgid "I think right here, right now is perfect."
msgstr "Je crois qu'ici et maintenant, c'est parfait."

# Traduction IA – à relire
#: hoove_vacuum/HooveTrueLove/0/34/s/0
msgctxt "Choix"
msgid "Let's get you oiled up..."
msgstr "On va te huiler un peu..."

# Traduction IA – à relire
#: hoove_vacuum/HooveTrueLove/0/g-0/0
msgctxt "Hoove"
msgid "I've got all the time in the world."
msgstr "J'ai tout le temps du monde."

# Traduction IA – à relire
#: hoove_vacuum/HooveTrueLove/0/g-0/8
msgctxt "Hoove"
msgid "And I want to spend it by your side."
msgstr "Et je veux le passer à tes côtés."

# Traduction IA – à relire
#: hoove_vacuum/HooveTrueLove/0/g-0/16
msgctxt "Hoove"
msgid "Let's start right now."
msgstr "Commençons dès maintenant."

# Traduction IA – à relire
#: hoove_vacuum/HooveOneThingLeft/0/0 hoove_vacuum/HooveABitMoreOpen/0/0
msgctxt "Hoove"
msgid "Hey there!"
msgstr "Salut, toi !"

# Traduction IA – à relire
#: hoove_vacuum/HooveOneThingLeft/0/8 hoove_vacuum/HooveABitMoreOpen/0/8
msgctxt "Hoove"
msgid "I'm so glad to see you again."
msgstr "Je suis tellement content de te revoir."

# Traduction IA – à relire
#: hoove_vacuum/HooveOneThingLeft/0/16/s/0 hoove_vacuum/HooveABitMoreOpen/0/16/s/0
msgctxt "Choix"
msgid "How are you doing?"
msgstr "Comment tu vas ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveOneThingLeft/0/17/s/0 hoove_vacuum/HooveABitMoreOpen/0/17/s/0
msgctxt "Choix"
msgid "Glad to see you too, Hoove."
msgstr "Content de te voir aussi, Hoove."

# Traduction IA – à relire
#: hoove_vacuum/HooveOneThingLeft/0/18/s/0 hoove_vacuum/HooveABitMoreOpen/0/18/s/0
msgctxt "Choix"
msgid "You look better than ever!"
msgstr "Tu as une mine superbe !"

# Traduction IA – à relire
#: hoove_vacuum/HooveOneThingLeft/0/g-0/0 hoove_vacuum/HooveABitMoreOpen/0/g-0/0
msgctxt "Hoove"
msgid "After everything is all said and done..."
msgstr "Après tout ce qui s'est passé..."

# Traduction IA – à relire
#: hoove_vacuum/HooveOneThingLeft/0/g-0/8
msgctxt "Hoove"
msgid "My bag's almost completely empty."
msgstr "Mon sac est presque complètement vide."

# Traduction IA – à relire
#: hoove_vacuum/HooveOneThingLeft/0/g-0/16
msgctxt "Hoove"
msgid "I've only got one thing left."
msgstr "Il ne me reste plus qu'une seule chose."

# Traduction IA – à relire
#: hoove_vacuum/HooveOneThingLeft/0/g-0/24
msgctxt "Hoove"
msgid "Now I can easily center my mind on it, and pay close attention."
msgstr "Maintenant, je peux facilement me concentrer dessus et lui accorder toute mon attention."

# Traduction IA – à relire
#: hoove_vacuum/HooveOneThingLeft/0/g-0/32
msgctxt "Hoove"
msgid "That helps me be more present, and gives me plenty of space!"
msgstr "Ça m'aide à être plus présent et ça me laisse plein de place !"

# Traduction IA – à relire
#: hoove_vacuum/HooveABitMoreOpen/0/g-0/8
msgctxt "Hoove"
msgid "I've cleared out a few things!"
msgstr "J'ai fait le vide dans quelques trucs !"

# Traduction IA – à relire
#: hoove_vacuum/HooveABitMoreOpen/0/g-0/19
msgctxt "Hoove"
msgid "I feel more present, and I've got a bit of space, now!"
msgstr "Je me sens plus présent et j'ai un peu de place, maintenant !"

# Traduction IA – à relire
#: hoove_vacuum/HooveABitMoreOpen/0/g-0/c-4/7
msgctxt "Hoove"
msgid "I've got time for that, now."
msgstr "J'ai le temps pour ça, maintenant."

# Traduction IA – à relire
#: hoove_vacuum/HooveABitMoreOpen/0/g-0/c-4/15
msgctxt "Hoove"
msgid "I might not be totally open..."
msgstr "Je ne suis peut-être pas totalement ouvert..."

# Traduction IA – à relire
#: hoove_vacuum/HooveABitMoreOpen/0/g-0/c-4/23
msgctxt "Hoove"
msgid "But I've got room for what really matters."
msgstr "Mais j'ai de la place pour ce qui compte vraiment."

# Traduction IA – à relire
#: hoove_vacuum/HooveABitMoreOpen/0/g-0/c-4/31
msgctxt "Hoove"
msgid "I'd love to hang, but at the moment I think I better get back to work."
msgstr "J'aimerais traîner avec toi, mais pour l'instant, je crois que je ferais mieux de retourner bosser."

# Traduction IA – à relire
#: hoove_vacuum/HooveABitMoreOpen/0/g-0/c-4/39/0/s/0
msgctxt "Choix"
msgid "Alright Hoove!"
msgstr "Ça marche, Hoove !"

# Traduction IA – à relire
#: hoove_vacuum/HooveABitMoreOpen/0/g-0/c-4/39/1/s/0
msgctxt "Choix"
msgid "I understand. You're a busy guy."
msgstr "Je comprends. Tu es un gars occupé."

# Traduction IA – à relire
#: hoove_vacuum/HooveABitMoreOpen/0/g-0/c-4/39/2/s/0
msgctxt "Choix"
msgid "Can't expect to have you all to myself."
msgstr "Je ne peux pas espérer t'avoir rien que pour moi."

# Traduction IA – à relire
#: hoove_vacuum/HooveABitMoreOpen/0/g-1/0
msgctxt "Hoove"
msgid "See you soon!"
msgstr "À bientôt !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLotsLeft/0/0
msgctxt "Hoove"
msgid "Huh? Oh... Hi."
msgstr "Hein ? Oh... Salut."

# Traduction IA – à relire
#: hoove_vacuum/HooveLotsLeft/0/8
msgctxt "Hoove"
msgid "Sorry, I'm just trying to suck up this speck of dust."
msgstr "Désolé, j'essaie juste d'aspirer ce grain de poussière."

# Traduction IA – à relire
#: hoove_vacuum/HooveLotsLeft/0/16
msgctxt "Hoove"
msgid "Give me a sec."
msgstr "Donne-moi une seconde."

# Traduction IA – à relire
#: hoove_vacuum/HooveLotsLeft/0/24
msgctxt "Narrator"
msgid "Hoove huffs and puffs, but try as he might he can't quite manage to capture the dust he's aiming for."
msgstr "Hoove souffle et halète, mais il a beau faire, il n'arrive pas à capturer la poussière qu'il vise."

# Traduction IA – à relire
#: hoove_vacuum/HooveLotsLeft/0/32
msgctxt "Hoove"
msgid "<w>pant, pant, pant</w>"
msgstr "<w>pant, pant, pant</w>"

# Traduction IA – à relire
#: hoove_vacuum/HooveLotsLeft/0/43/s/0
msgctxt "Choix"
msgid "You got this!"
msgstr "Tu vas y arriver !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLotsLeft/0/44/s/0
msgctxt "Choix"
msgid "Uh... You alright?"
msgstr "Euh... Ça va ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveLotsLeft/0/g-0/0
msgctxt "Hoove"
msgid "Know what, forget it."
msgstr "Tu sais quoi, laisse tomber."

# Traduction IA – à relire
#: hoove_vacuum/HooveLotsLeft/0/g-0/8
msgctxt "Hoove"
msgid "My suction is no good anymore."
msgstr "Mon aspiration ne vaut plus rien."

# Traduction IA – à relire
#: hoove_vacuum/HooveLotsLeft/0/g-0/16
msgctxt "Hoove"
msgid "I have no room for it anyway."
msgstr "De toute façon, je n'ai pas de place pour ça."

# Traduction IA – à relire
#: hoove_vacuum/HooveLotsLeft/0/g-0/24
msgctxt "Hoove"
msgid "So, what's up?"
msgstr "Alors, quoi de neuf ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveLotsLeft/0/g-0/32/s/0
msgctxt "Choix"
msgid "I was wondering if we could hang out."
msgstr "Je me demandais si on pouvait traîner ensemble."

# Traduction IA – à relire
#: hoove_vacuum/HooveLotsLeft/0/g-0/33/s/0
msgctxt "Choix"
msgid "Maybe we can go on a date?"
msgstr "Peut-être qu'on pourrait aller à un rendez-vous ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveLotsLeft/0/g-1/0
msgctxt "Hoove"
msgid "I have no room at all for that sort of thing at the moment."
msgstr "Je n'ai aucune place pour ce genre de chose en ce moment."

# Traduction IA – à relire
#: hoove_vacuum/HooveLotsLeft/0/g-1/8
msgctxt "Hoove"
msgid "I'm packed to the brim."
msgstr "Je suis plein à ras bord."

# Traduction IA – à relire
#: hoove_vacuum/HooveLotsLeft/0/g-1/19
msgctxt "Hoove"
msgid "I can maybe hang out later, when I'm finished here..."
msgstr "Je pourrai peut-être traîner plus tard, quand j'aurai fini ici..."

# Traduction IA – à relire
#: hoove_vacuum/HooveLotsLeft/0/g-1/27/s/0
msgctxt "Choix"
msgid "When will that be?"
msgstr "Ce sera quand ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveLotsLeft/0/g-1/28/s/0
msgctxt "Choix"
msgid "But you can barely suck anything up!"
msgstr "Mais tu n'arrives presque plus à aspirer quoi que ce soit !"

# Traduction IA – à relire
#: hoove_vacuum/HooveLotsLeft/0/g-1/c-4/7
msgctxt "Hoove"
msgid "Yeah... I don't know."
msgstr "Ouais... Je sais pas."

# Traduction IA – à relire
#: hoove_vacuum/HooveLotsLeft/0/g-1/c-5/7
msgctxt "Hoove"
msgid "You're right about that. But I don't have a solution."
msgstr "Tu as raison là-dessus. Mais je n'ai pas de solution."

# Traduction IA – à relire
#: hoove_vacuum/HooveLotsLeft/0/g-2/0
msgctxt "Hoove"
msgid "Anyway, no hard feelings, but I should go."
msgstr "Enfin, sans rancune, mais je dois y aller."

# Traduction IA – à relire
#: hoove_vacuum/HooveLotsLeft/0/g-2/8
msgctxt "Hoove"
msgid "When you come back, I'll try to be free."
msgstr "Quand tu reviendras, j'essaierai d'être libre."

# Traduction IA – à relire
#: hoove_vacuum/HooveLotsLeft/0/g-2/16
msgctxt "Hoove"
msgid "But... no promises."
msgstr "Mais... aucune promesse."

# Traduction IA – à relire
#: hoove_vacuum/HooveLotsLeft/0/g-2/24/s/0
msgctxt "Choix"
msgid "You never have time for me."
msgstr "Tu n'as jamais de temps pour moi."

# Traduction IA – à relire
#: hoove_vacuum/HooveLotsLeft/0/g-2/25/s/0
msgctxt "Choix"
msgid "Take your time."
msgstr "Prends ton temps."

# Traduction IA – à relire
#: hoove_vacuum/HooveLotsLeft/0/g-2/c-6/7
msgctxt "Hoove"
msgid "And at this rate, I never will."
msgstr "Et à ce rythme, je n'en aurai jamais."

# Traduction IA – à relire
#: hoove_vacuum/HooveLotsLeft/0/g-2/c-7/7
msgctxt "Hoove"
msgid "Thanks, pal. I think if we're gonna have a friendship, it'll be when I have a little time off."
msgstr "Merci. Je pense que si on doit être ami·es, ce sera quand j'aurai un peu de temps libre."

# Traduction IA – à relire
#: hoove_vacuum/hoove_hate_joiner/31
msgctxt "Reggie"
msgid "Well... that sucked."
msgstr "Bon... ça m'a pompé l'air."

# Traduction IA – à relire
#: hoove_vacuum/HoovePacked/0/0
msgctxt "Hoove"
msgid "Ugh. You're bothering me again?"
msgstr "Pff. Tu viens encore m'embêter ?"

# Traduction IA – à relire
#: hoove_vacuum/HoovePacked/0/8
msgctxt "Hoove"
msgid "Sorry, but I just really don't have time for this..."
msgstr "Désolé, mais je n'ai vraiment pas le temps pour ça..."

# Traduction IA – à relire
#: hoove_vacuum/HoovePacked/0/16
msgctxt "Hoove"
msgid "I'm so stuffed to the brim I can barely think."
msgstr "Je suis tellement bourré à craquer que je peux à peine penser."

# Traduction IA – à relire
#: hoove_vacuum/HoovePacked/0/24
msgctxt "Hoove"
msgid "Let alone work!"
msgstr "Encore moins travailler !"

# Traduction IA – à relire
#: hoove_vacuum/HoovePacked/0/32
msgctxt "Hoove"
msgid "And the house is a mess... Grime Scenes are going uninvestigated every day."
msgstr "Et la maison est en désordre... Des Scènes de crasse restent non investiguées chaque jour."

# Traduction IA – à relire
#: hoove_vacuum/HoovePacked/0/51
msgctxt "Hoove"
msgid "So why don't you just leave me alone?"
msgstr "Alors pourquoi tu ne me laisserais pas tranquille ?"

# Traduction IA – à relire
#: hoove_vacuum/HoovePacked/0/59/s/0
msgctxt "Choix"
msgid "Hoove, I'm sorry."
msgstr "Hoove, toutes mes excuses."

# Traduction IA – à relire
#: hoove_vacuum/HoovePacked/0/60/s/0
msgctxt "Choix"
msgid "Alright. Take your space."
msgstr "Très bien. Prends ton espace."

# Traduction IA – à relire
#: hoove_vacuum/HoovePacked/0/61/s/0
msgctxt "Choix"
msgid "Can we do anything about this?"
msgstr "On peut faire quelque chose pour ça ?"

# Traduction IA – à relire
#: hoove_vacuum/HoovePacked/0/c-0/7
msgctxt "Hoove"
msgid "Yeah, well. Thanks for stopping by."
msgstr "Ouais, bon. Merci de ta visite."

# Traduction IA – à relire
#: hoove_vacuum/HoovePacked/0/c-1/7
msgctxt "Hoove"
msgid "Thanks for understanding."
msgstr "Merci de comprendre."

# Traduction IA – à relire
#: hoove_vacuum/HoovePacked/0/c-2/7
msgctxt "Hoove"
msgid "Maybe you could have. But not now."
msgstr "Peut-être que tu aurais pu. Mais pas maintenant."

# Traduction IA – à relire
#: hoove_vacuum/HoovePacked/0/c-2/15
msgctxt "Hoove"
msgid "I'd rather just be alone..."
msgstr "Je préfère rester seul..."

# Traduction IA – à relire
#: hoove_vacuum/HoovePacked/0/c-2/23
msgctxt "Hoove"
msgid "With all this stuff on my back."
msgstr "Avec tout ce bazar sur le dos."

# Traduction IA – à relire
#: hoove_vacuum/HooveFriendMeet/0/0
msgctxt "Hoove"
msgid "Hey again friend! I'm always happy to see you!"
msgstr "Re-salut ! Toujours content de te voir !"

# Traduction IA – à relire
#: hoove_vacuum/HooveFriendMeet/0/8
msgctxt "Hoove"
msgid "So, care for a can of oil?"
msgstr "Alors, ça te dit une canette d'huile ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveFriendMeet/0/16
msgctxt "Hoove"
msgid "Or should we go check out the Hanks game?"
msgstr "Ou on va voir le match des Hanks ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveFriendMeet/0/24/s/0
msgctxt "Choix"
msgid "Hankees game! Duh!"
msgstr "Le match des Hankees ! Évidemment !"

# Traduction IA – à relire
#: hoove_vacuum/HooveFriendMeet/0/25/s/0
msgctxt "Choix"
msgid "Ooh that sounds frothy! Let's have a can!"
msgstr "Ooh, ça a l'air mousseux ! Prenons une canette !"

# Traduction IA – à relire
#: hoove_vacuum/HooveFriendMeet/0/26/s/0 hoove_vacuum/HooveLoveMeet/0/26/s/0
msgctxt "Choix"
msgid "Actually, I want to Realize you, Hoove."
msgstr "En fait, je veux te Réaliser, Hoove."

# Traduction IA – à relire
#: hoove_vacuum/HooveFriendMeet/0/c-0/7
msgctxt "Hoove"
msgid "Let's go Hankees!"
msgstr "Allez les Hankees !"

# Traduction IA – à relire
#: hoove_vacuum/HooveFriendMeet/0/c-0/18
msgctxt "Narrator"
msgid "The Hanks win! You and Hoove share are marvelous high-five."
msgstr "Les Hanks gagnent ! Vous et Hoove échangez un formidable tope-là."

# Traduction IA – à relire
#: hoove_vacuum/HooveFriendMeet/0/c-1/18
msgctxt "Hoove"
msgid "Whew... that went straight to my head!"
msgstr "Ouf... ça m'est directement monté à la tête !"

# Traduction IA – à relire
#: hoove_vacuum/HooveFriendMeet/0/c-1/29
msgctxt "Narrator"
msgid "You know you can't match Hoove in drinking, so you responsibly take your leave when you've reached your limit."
msgstr "Vous savez que vous ne pouvez pas rivaliser avec Hoove à la boisson, alors vous prenez congé de façon responsable une fois votre limite atteinte."

# Traduction IA – à relire
#: hoove_vacuum/hoove_friend_full/0/0
msgctxt "Hoove"
msgid "Hey again friend. I'm always happy to see you."
msgstr "Re-salut. Toujours content de te voir."

# Traduction IA – à relire
#: hoove_vacuum/hoove_friend_full/0/8
msgctxt "Hoove"
msgid "Wish I had more time, but hopefully I can see you soon."
msgstr "J'aimerais avoir plus de temps, mais j'espère te revoir bientôt."

# Traduction IA – à relire
#: hoove_vacuum/hoove_friend_full/0/16/s/0
msgctxt "Choix"
msgid "No worries, Hoove."
msgstr "Pas de souci, Hoove."

# Traduction IA – à relire
#: hoove_vacuum/hoove_friend_full/0/17/s/0
msgctxt "Choix"
msgid "Actually, I want to Realize you."
msgstr "En fait, je veux te Réaliser."

# Traduction IA – à relire
#: hoove_vacuum/hoove_friend_full/0/c-0/7
msgctxt "Narrator"
msgid "Hoove waves goodbye as he gets back to his Grime Scene."
msgstr "Hoove vous fait signe au revoir avant de retourner à sa Scène de crasse."

# Traduction IA – à relire
#: hoove_vacuum/HooveLoveMeet/0/0
msgctxt "Hoove"
msgid "Well if it isn't my favorite masseuse..."
msgstr "Tiens, mais voilà {{mon masseur préféré|ma masseuse préférée|mon·ma masseur·se préféré·e}}..."

# Traduction IA – à relire
#: hoove_vacuum/HooveLoveMeet/0/8
msgctxt "Hoove"
msgid "You looking to get a massage yourself?"
msgstr "Tu viens te faire masser toi-même ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveLoveMeet/0/16
msgctxt "Hoove"
msgid "Or should I let you get down to work?"
msgstr "Ou je te laisse te mettre au travail ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveLoveMeet/0/24/s/0
msgctxt "Choix"
msgid "Let me give you a break, big boy."
msgstr "Laisse-moi te faire souffler, mon grand."

# Traduction IA – à relire
#: hoove_vacuum/HooveLoveMeet/0/25/s/0
msgctxt "Choix"
msgid "Mmmm my shoulders are feeling a little tight..."
msgstr "Mmmm j'ai les épaules un peu tendues..."

# Traduction IA – à relire
#: hoove_vacuum/HooveLoveMeet/0/c-0/7
msgctxt "Hoove"
msgid "I have been working pretty hard..."
msgstr "Je bosse pas mal dur, c'est vrai..."

# Traduction IA – à relire
#: hoove_vacuum/HooveLoveMeet/0/c-0/15
msgctxt "Narrator"
msgid "You give Hoove the best massage you can... though afterwards your fingers do twinge a bit."
msgstr "Vous faites à Hoove le meilleur massage possible... même si vos doigts vous tirent un peu ensuite."

# Traduction IA – à relire
#: hoove_vacuum/HooveLoveMeet/0/c-1/7
msgctxt "Hoove"
msgid "Let me just oil you up..."
msgstr "Laisse-moi juste te huiler..."

# Traduction IA – à relire
#: hoove_vacuum/HooveLoveMeet/0/c-1/18
msgctxt "Narrator"
msgid "Hoove is as skilled with massages as he is cleaning. You leave feeling fresh as a daisy."
msgstr "Hoove est aussi doué pour les massages que pour le ménage. Vous repartez en pleine forme."

# Traduction IA – à relire
#: hoove_vacuum/HooveHateMeet/0/0
msgctxt "Hoove"
msgid "Oh. You again..."
msgstr "Oh. Encore toi..."

# Traduction IA – à relire
#: hoove_vacuum/HooveHateMeet/0/8
msgctxt "Hoove"
msgid "Gotta say, you aren't really my type."
msgstr "Je dois dire que tu n'es pas vraiment mon genre."

# Traduction IA – à relire
#: hoove_vacuum/HooveHateMeet/0/16
msgctxt "Hoove"
msgid "As a lover, or a friend."
msgstr "Que ce soit comme amant ou comme ami."

# Traduction IA – à relire
#: hoove_vacuum/HooveHateMeet/0/27/s/0
msgctxt "Choix"
msgid "Later."
msgstr "À plus tard."

# Traduction IA – à relire
#: hoove_vacuum/HooveHateMeet/0/28/s/0
msgctxt "Choix"
msgid "Listen, we all make mistakes. (USE EMPATHY CANDY)"
msgstr "Écoute, on fait tous des erreurs. (UTILISER UN BONBON D'EMPATHIE)"

# Traduction IA – à relire
#: hoove_vacuum/HooveHateMeet/0/c-0/7
msgctxt "Hoove"
msgid "So long."
msgstr "Salut."

# Traduction IA – à relire
#: hoove_vacuum/HooveHateMeet/0/c-1/13
msgctxt "Hoove"
msgid "You certainly have."
msgstr "Ça, c'est sûr."

# Traduction IA – à relire
#: hoove_vacuum/HooveHateMeet/0/c-1/21
msgctxt "Hoove"
msgid "What, are you apologizing?"
msgstr "Quoi, tu t'excuses ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveHateMeet/0/c-1/29/0/s/0
msgctxt "Choix"
msgid "Yes."
msgstr "Oui."

# Traduction IA – à relire
#: hoove_vacuum/HooveHateMeet/0/c-1/29/c-0/7
msgctxt "Hoove"
msgid "Oh..."
msgstr "Oh..."

# Traduction IA – à relire
#: hoove_vacuum/HooveHateMeet/0/c-1/29/c-0/15
msgctxt "Hoove"
msgid "All right, apology accepted."
msgstr "Très bien, excuses acceptées."

# Traduction IA – à relire
#: hoove_vacuum/HooveHateMeet/0/c-1/29/c-0/23
msgctxt "Hoove"
msgid "I'll do my best to make time for you, but no promises."
msgstr "Je ferai de mon mieux pour trouver du temps pour toi, mais aucune promesse."

# Traduction IA – à relire
#: hoove_vacuum/hoove_realize_join/0/0
msgctxt "Hoove"
msgid "So we could hang out in real life?"
msgstr "Alors on pourrait traîner dans la vraie vie ?"

# Traduction IA – à relire
#: hoove_vacuum/hoove_realize_join/0/8
msgctxt "Hoove"
msgid "You don't have to tell me twice!"
msgstr "Pas besoin de me le dire deux fois !"

# Traduction IA – à relire
#: hoove_vacuum/hoove_realize_join/0/19
msgctxt "Hoove"
msgid "But what's in your bag?"
msgstr "Mais qu'est-ce qu'il y a dans ton sac ?"

# Traduction IA – à relire
#: hoove_vacuum/hoove_realize_join/0/36/s/0
msgctxt "Choix"
msgid "Everything I need to make it happen."
msgstr "Tout ce qu'il me faut pour que ça arrive."

# Traduction IA – à relire
#: hoove_vacuum/hoove_realize_join/0/37/s/0
msgctxt "Choix"
msgid "I might need to collect a few other things."
msgstr "Il faudra peut-être que je ramasse quelques autres trucs."

# Traduction IA – à relire
#: hoove_vacuum/hoove_realize_join/0/c-1/10
msgctxt "Hoove"
msgid "No problem."
msgstr "Pas de problème."

# Traduction IA – à relire
#: hoove_vacuum/hoove_realize_return/0/0
msgctxt "Hoove"
msgid "You ready to do this?"
msgstr "On y va ?"

# Traduction IA – à relire
#: hoove_vacuum/hoove_realize_return/0/17/s/0
msgctxt "Choix"
msgid "Yes, I have what I need right here."
msgstr "Oui, j'ai tout ce qu'il me faut ici."

# Traduction IA – à relire
#: hoove_vacuum/hoove_realize_return/0/18/s/0
msgctxt "Choix"
msgid "No, not just yet."
msgstr "Non, pas tout de suite."

# Traduction IA – à relire
#: hoove_vacuum/hoove_realize_return/0/c-1/10
msgctxt "Hoove"
msgid "All good."
msgstr "Pas de souci."

# Traduction IA – à relire
#: hoove_vacuum/hoove_realize_begin/6/b/1
msgctxt "Skylar"
msgid "Okay Skylar, just Realize a vacuum. Can't be that hard, can it?"
msgstr "Bon, Skylar, il suffit de Réaliser un aspirateur. Ça ne peut pas être si difficile, si ?"

# Traduction IA – à relire
#: hoove_vacuum/hoove_realize_begin/9
msgctxt "Skylar"
msgid "Henry Hoove, you're now Henry Hooman!"
msgstr "Henry Hoove, te voilà Henry Hoomain !"

# Traduction IA – à relire
#: hoove_vacuum/hoove_realize_begin/20
msgctxt "Narrator"
msgid "The spectral energy flows through your dateviators, and what was once merely a vacuum cleaner, becomes...."
msgstr "L'énergie spectrale traverse vos Dateviators, et ce qui n'était jadis qu'un simple aspirateur devient..."

# Traduction IA – à relire
#: hoove_vacuum/hoove_realized/0/3
msgctxt "Narrator"
msgid "Hoove swings his head from side to side, delighting in the movement of his newly human hair. His locs frame his handsome face in a way that only makes him even more devastatingly beautiful."
msgstr "Hoove secoue la tête de gauche à droite, ravi du mouvement de ses cheveux tout neufs d'humain. Ses locks encadrent son beau visage d'une façon qui le rend encore plus dévastateur de beauté."

# Traduction IA – à relire
#: hoove_vacuum/hoove_realized/0/11
msgctxt "Hoove"
msgid "Look at these dreads!"
msgstr "Regarde ces dreads !"

# Traduction IA – à relire
#: hoove_vacuum/hoove_realized/0/22
msgctxt "Hoove"
msgid "And here I thought my most attractive feature was my upholstery brush."
msgstr "Et moi qui pensais que mon plus beau atout, c'était ma brosse d'ameublement."

# Traduction IA – à relire
#: hoove_vacuum/hoove_realized/0/30/s/0
msgctxt "Choix"
msgid "Yeah, dude, you look awesome!"
msgstr "Ouais, mec, tu es magnifique !"

# Traduction IA – à relire
#: hoove_vacuum/hoove_realized/0/31/s/0
msgctxt "Choix"
msgid "Not gonna lie, you have a lot of 'attractive' features."
msgstr "Pas question de mentir, tu as plein de qualités « attrayantes »."

# Traduction IA – à relire
#: hoove_vacuum/hoove_realized/0/c-0/7
msgctxt "Hoove"
msgid "Yeah, so human..."
msgstr "Ouais, tellement humain..."

# Traduction IA – à relire
#: hoove_vacuum/hoove_realized/0/c-0/15
msgctxt "Hoove"
msgid "Hmmm... makes me curious... Is there a library around here?"
msgstr "Hmmm... ça me rend curieux... Il y a une bibliothèque par ici ?"

# Traduction IA – à relire
#: hoove_vacuum/hoove_realized/0/c-0/23/0/s/0
msgctxt "Choix"
msgid "A library? Like with books?"
msgstr "Une bibliothèque ? Genre avec des livres ?"

# Traduction IA – à relire
#: hoove_vacuum/hoove_realized/0/c-0/23/1/s/0
msgctxt "Choix"
msgid "You know I don't get out much."
msgstr "Tu sais que je ne sors pas beaucoup."

# Traduction IA – à relire
#: hoove_vacuum/hoove_realized/0/c-0/23/g-0/0
msgctxt "Hoove"
msgid "Yeah! Looks will only get me so far. I want books!"
msgstr "Ouais ! Le physique ne me mènera pas bien loin. Je veux des livres !"

# Traduction IA – à relire
#: hoove_vacuum/hoove_realized/0/c-0/23/g-0/8
msgctxt "Hoove"
msgid "There's something I've never been able to get out of my bag..."
msgstr "Il y a un truc que je n'ai jamais pu sortir de mon sac..."

# Traduction IA – à relire
#: hoove_vacuum/hoove_realized/0/c-1/7
msgctxt "Hoove"
msgid "And I'm not even a vacuum anymore."
msgstr "Et je ne suis même plus un aspirateur."

# Traduction IA – à relire
#: hoove_vacuum/hoove_love_divert/0/0
msgctxt "Hoove"
msgid "Do you want me to show you what I can do with them?"
msgstr "Tu veux que je te montre ce que je peux faire avec ?"

# Traduction IA – à relire
#: hoove_vacuum/hoove_love_divert/0/8/s/0
msgctxt "Choix"
msgid "Maybe later... I just like looking at ya."
msgstr "Plus tard, peut-être... j'aime juste te regarder."

# Traduction IA – à relire
#: hoove_vacuum/hoove_love_divert/0/9/s/0
msgctxt "Choix"
msgid "Take me, Hoove."
msgstr "Prends-moi, Hoove."

# Traduction IA – à relire
#: hoove_vacuum/hoove_love_divert/0/c-0/7
msgctxt "Hoove"
msgid "No worries - actually there's something I wanted to take a look at myself..."
msgstr "Pas de souci, en fait, il y a un truc que je voulais voir moi-même..."

# Traduction IA – à relire
#: hoove_vacuum/hoove_love_divert/0/c-1/7
msgctxt "Narrator"
msgid "Hoove proceeds to apply every ounce of his hard-work ethic into making you feel as good as possible."
msgstr "Hoove consacre alors chaque once de son éthique du travail à vous faire ressentir le meilleur possible."

# Traduction IA – à relire
#: hoove_vacuum/hoove_love_divert/0/c-1/18
msgctxt "Narrator"
msgid "You are swirled into a whirlpool of ecstasy."
msgstr "Vous êtes {{entraîné|entraînée|entraîné·e}} dans un tourbillon d'extase."

# Traduction IA – à relire
#: hoove_vacuum/hoove_love_divert/0/c-1/26
msgctxt "Narrator"
msgid "Attachments are used."
msgstr "Des accessoires sont utilisés."

# Traduction IA – à relire
#: hoove_vacuum/hoove_love_divert/0/c-1/34/0/s/0
msgctxt "Choix"
msgid "Well... that didn't suck."
msgstr "Eh bien... se faire pomper l'air n'a jamais été aussi agréable."

# Traduction IA – à relire
#: hoove_vacuum/hoove_love_divert/0/c-1/34/1/s/0
msgctxt "Choix"
msgid "You got every one of my nooks and crannies."
msgstr "Tu as visité tous mes recoins."

# Traduction IA – à relire
#: hoove_vacuum/hoove_love_divert/0/c-1/34/c-0/7
msgctxt "Hoove"
msgid "How dare you use that pun."
msgstr "Comment oses-tu faire ce jeu de mots."

# Traduction IA – à relire
#: hoove_vacuum/hoove_love_divert/0/c-1/34/c-1/7
msgctxt "Hoove"
msgid "Like butter."
msgstr "Comme dans du beurre."

# Traduction IA – à relire
#: hoove_vacuum/hoove_love_divert/0/g-0/0
msgctxt "Hoove"
msgid "Now that we got that out of our system... there's something I have always wanted to look into."
msgstr "Maintenant qu'on a évacué ça... il y a un truc que j'ai toujours voulu étudier."

# Traduction IA – à relire
#: hoove_vacuum/hoove_love_join/0
msgctxt "Narrator"
msgid "While looking up vacuums in the library, Hoove was surprised to find zero books about his ancestors."
msgstr "En cherchant des aspirateurs à la bibliothèque, Hoove a eu la surprise de ne trouver aucun livre sur ses ancêtres."

# Traduction IA – à relire
#: hoove_vacuum/hoove_love_join/8
msgctxt "Narrator"
msgid "Instead, it was replete with knowledge about space, physics, and the mysteries of the universe."
msgstr "À la place, elle regorgeait de savoir sur l'espace, la physique et les mystères de l'univers."

# Traduction IA – à relire
#: hoove_vacuum/hoove_love_join/16
msgctxt "Narrator"
msgid "Hoove sucked up all this knowledge like a ..."
msgstr "Hoove a aspiré toutes ces connaissances comme un..."

# Traduction IA – à relire
#: hoove_vacuum/hoove_love_join/24
msgctxt "Narrator"
msgid "Grad school PhD candidate...."
msgstr "Doctorant en fin de thèse...."

# Traduction IA – à relire
#: hoove_vacuum/hoove_love_join/32
msgctxt "Narrator"
msgid "Which he then became."
msgstr "Ce qu'il est ensuite devenu."

# Traduction IA – à relire
#: hoove_vacuum/hoove_love_join/40
msgctxt "Hoove"
msgid "\"My thesis is about the event horizon... It has drawn me in like nothing else.\""
msgstr "« Ma thèse porte sur l'horizon des événements... Il m'a attiré comme rien d'autre. »"

# Traduction IA – à relire
#: hoove_vacuum/hoove_love_join/48
msgctxt "Narrator"
msgid "He works with the leading space programs of the world, where he explores event horizons no vacuum could ever dream of replicating."
msgstr "Il travaille avec les plus grands programmes spatiaux du monde, où il explore des horizons des événements qu'aucun aspirateur n'aurait jamais pu rêver de reproduire."
