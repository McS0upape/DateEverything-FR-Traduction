#: tim_clock/timmy_hate_return/0/c-0/7
msgctxt "Timmy"
msgid "YOU leave TIMMY ALONE!"
msgstr ""

#: tim_clock/timmy_hate_return/0/c-0/18
msgctxt "Timmy"
msgid "TIMMY WAS RELAXING ON HIS OWN BEFORE YOU CAME HERE, NYA!"
msgstr ""

#: tim_clock/timmy_hate_return/0/c-0/29
msgctxt "Timmy"
msgid "LEAVE NOW BEFORE TIMMY SHREDS YOUR MOST PRECIOUS POSSESSIONS WITH HIS ADORABLE CLAWS!"
msgstr ""

#: tim_clock/timmy_hate_return/0/c-0/37/0/s/0
msgctxt "Choix"
msgid "What claws? Stay away from my stuff, cat boy!"
msgstr ""

#: tim_clock/timmy_hate_return/0/c-0/37/c-0/7
msgctxt "Timmy"
msgid "TIMMY HAS HIS WAYS! JUST GO, NYA!"
msgstr ""

#: tim_clock/timmy_hate_return/0/c-1/7
msgctxt "Timmy"
msgid "Hmm...."
msgstr ""

#: tim_clock/timmy_hate_return/0/c-1/15
msgctxt "Narrator"
msgid "The catboy narrows his eyes at you."
msgstr ""

#: tim_clock/timmy_hate_return/0/c-1/23
msgctxt "Timmy"
msgid "You do look pretty sorry, nya..."
msgstr ""

#: tim_clock/timmy_hate_return/0/c-1/31
msgctxt "Timmy"
msgid "Fine. You can be Timmy's friend again."
msgstr ""

#: tim_clock/timmy_hate_return/0/c-1/39/0/s/0
msgctxt "Choix"
msgid "Thank you, Timmy. I'm glad we can be cool again."
msgstr ""

#: tim_clock/timmy_hate_return/0/c-1/39/c-0/7
msgctxt "Timmy"
msgid "Timmy will forget how you wronged him... starting now."
msgstr ""

#: tim_clock/timmy_hate_return/0/c-1/39/c-0/15
msgctxt "Timmy"
msgid "Bye bye!"
msgstr ""

#: tim_clock/timmy_love_return/0/0
msgctxt "Timmy"
msgid "Ohhh, look who it is, nya."
msgstr ""

#: tim_clock/timmy_love_return/0/11
msgctxt "Narrator"
msgid "Timothy is purring up a storm, looking at you with the biggest, shiniest eyes you've ever seen outside of a cartoon."
msgstr ""

#: tim_clock/timmy_love_return/0/19
msgctxt "Timmy"
msgid "Timmy's day is better whenever you come by."
msgstr ""

#: tim_clock/timmy_love_return/0/27
msgctxt "Timmy"
msgid "Timmy hopes your day is better too when you see him..."
msgstr ""

#: tim_clock/timmy_love_return/0/35/s/0
msgctxt "Choix"
msgid "Of course it is."
msgstr ""

#: tim_clock/timmy_love_return/0/c-0/7
msgctxt "Timmy"
msgid "Uwaaaa... Timmy is so happy he could sing, nya!"
msgstr ""

#: tim_clock/timmy_love_return/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "Oh, well... you probably don't have to do that."
msgstr ""

#: tim_clock/timmy_love_return/0/c-0/15/c-0/7
msgctxt "Timmy"
msgid "If you say so... but still."
msgstr ""

#: tim_clock/timmy_love_return/0/c-0/15/c-0/15
msgctxt "Timmy"
msgid "Timmy has many adorable things to do, but... maybe Timmy will find you later?"
msgstr ""

#: tim_clock/timmy_love_return/0/c-0/15/c-0/23/0/s/0
msgctxt "Choix"
msgid "Hold that thought—I'm ready to realize you."
msgstr ""

#: tim_clock/timmy_love_return/0/c-0/15/c-0/23/1/s/0
msgctxt "Choix"
msgid "I'd like that!"
msgstr ""

#: tim_clock/timmy_love_return/0/c-0/15/c-0/23/c-1/7
msgctxt "Timmy"
msgid "Purrfect. See you soon, nya..."
msgstr ""

#: tim_clock/timmy_friend_return/0/0
