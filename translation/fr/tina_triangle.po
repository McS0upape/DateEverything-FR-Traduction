msgstr "Ils reviennent toujours !"

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/9
msgctxt "Narrator"
msgid "Once again, Tina appears to be mentally somewhere else entirely—but this time she's writing something in a small book."
msgstr "Une fois de plus, Tina semble être mentalement ailleurs, mais cette fois elle écrit quelque chose dans un petit carnet."

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/25/s/0
msgctxt "Choix"
msgid "Hey Tina. What are you doing?"
msgstr "Salut Tina. Tu fais quoi ?"

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/26/s/0
msgctxt "Choix"
msgid "Boo!"
msgstr "Bouh !"

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/27/s/0
msgctxt "Choix"
msgid "Busy today?"
msgstr "Occupée aujourd'hui ?"

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-0/0
msgctxt "Tina"
msgid "OH! God, you scared the angles right offa me."
msgstr "OH ! Mon Dieu, tu m'as fait tomber les angles de peur."

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-0/11
msgctxt "Tina"
msgid "I'm journalin', what's it look like?"
msgstr "J'écris mon journal, ça se voit pas ?"

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-0/19/s/0
msgctxt "Choix"
msgid "Oh I see."
msgstr "Ah, je vois."

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-0/20/s/0
msgctxt "Choix"
msgid "That's surprising."
msgstr "C'est surprenant."

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-1/0
msgctxt "Tina"
msgid "The hell's that supposed to mean!?"
msgstr "C'est censé vouloir dire quoi, ça !?"

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-1/8/s/0
msgctxt "Choix"
msgid "I just never imagined you writing all your thoughts in a diary."
msgstr "Je t'aurais jamais imaginée écrire toutes tes pensées dans un journal intime."

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-1/9/s/0
msgctxt "Choix"
msgid "It's so sensitive of you."
msgstr "C'est tellement sensible de ta part."

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-1/10/s/0
msgctxt "Choix"
msgid "Let me see that."
msgstr "Fais voir ça."

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-1/c-5/13
msgctxt "Tina"
msgid "It ain't a diary, it's a JOURNAL!"
msgstr "C'est pas un journal intime, c'est un JOURNAL !"

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-1/c-6/13
msgctxt "Tina"
msgid "It is, ain't it? I'm a complex, layered triangle!"
msgstr "C'en est un, non ? Je suis un triangle complexe, aux multiples facettes !"

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-1/c-6/24
msgctxt "Tina"
msgid "I'm every triangle, it's all in me!"
msgstr "Je suis tous les triangles, tout est en moi !"

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-1/c-6/32/0/s/0
msgctxt "Choix"
msgid "I don't remember the song going that way but sure."
msgstr "Je me souviens pas que la chanson disait ça, mais bon."

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-1/c-7/13
msgctxt "Tina"
msgid "NO!"
msgstr "NON !"

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-1/c-7/21
msgctxt "Tina"
msgid "If you wanna know what's on my mind just ASK me, ding-a-ling!"
msgstr "Si tu veux savoir ce que j'ai en tête, DEMANDE-MOI, patate !"

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-2/0
msgctxt "Tina"
msgid "This right here's all my innermost thoughts."
msgstr "Ce que t'as là, c'est toutes mes pensées les plus intimes."

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-2/8
msgctxt "Tina"
msgid "You want the secrets to a sexy and exciting life?"
msgstr "Tu veux les secrets d'une vie sexy et excitante ?"

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-2/16
msgctxt "Tina"
msgid "This is it, baby."
msgstr "Les voilà, bébé."

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-2/24/s/0
msgctxt "Choix"
msgid "So did you... want me to read it?"
msgstr "Donc tu... voulais que je le lise ?"

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-2/25/s/0
msgctxt "Choix"
msgid "But it is a secret, right?"
msgstr "Mais c'est un secret, non ?"

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-2/26/s/0
msgctxt "Choix"
msgid "If I want the secret to being alone forever I'll ask you."
msgstr "Si je veux le secret pour rester seule à jamais, je te demanderai."

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-2/c-8/7
msgctxt "Tina"
msgid "Are you crazy? You think I'm just gonna give ya the keys to the kingdom?"
msgstr "T'es malade ? Tu crois que je vais te donner les clés du royaume comme ça ?"

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-2/c-8/15
msgctxt "Tina"
msgid "You think you can just get to know a complex, sensitive, triangle like me just by readin' my diary!?"
msgstr "Tu crois que tu peux apprendre à connaître un triangle complexe et sensible comme moi juste en lisant mon journal intime !?"

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-2/c-8/23/0/s/0
msgctxt "Choix"
msgid "I thought you said it was a journal."
msgstr "Je croyais que tu avais dit que c'était un journal."

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-2/c-8/23/c-0/13
msgctxt "Tina"
msgid "DON'T CHANGE THE SUBJECT!"
msgstr "CHANGE PAS DE SUJET !"

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-2/c-9/13
msgctxt "Tina"
msgid "'COURSE IT IS! No matter how bad you wish you could read it!"
msgstr "BIEN SÛR QUE OUI ! Même si tu rêves de pouvoir le lire !"

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-2/c-10/13
msgctxt "Tina"
msgid "OOOOOH! YOU LOW DOWN... DIRTY... SEXY..."
msgstr "OOOOH ! ESPÈCE DE VILAIN{{|E|·E}}... DE SALE... DE SEXY..."

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-2/c-10/24/0/s/0
msgctxt "Choix"
msgid "...'sexy'?"
msgstr "...« sexy » ?"

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-2/c-10/24/1/s/0
msgctxt "Choix"
msgid "Sorry, what?"
msgstr "Pardon, quoi ?"

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-2/c-10/24/c-0/7
msgctxt "Tina"
msgid "YEAH I SAID IT! SO WHAT!"
msgstr "OUAIS JE L'AI DIT ! ET ALORS !"

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-2/c-10/24/c-0/15
msgctxt "Tina"
msgid "STOP TRYIN' TO CHANGE THE SUBJECT FROM MY DIARY!"
msgstr "ARRÊTE DE CHANGER DE SUJET À PROPOS DE MON JOURNAL INTIME !"

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-2/c-10/24/c-1/7
msgctxt "Tina"
msgid "YOU HEARD ME, ASSHOLE!"
msgstr "T'AS BIEN ENTENDU, ESPÈCE DE TROU DU CUL !"

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-2/c-10/24/c-1/15
msgctxt "Tina"
msgid "GET OUTTA MY FACE!"
msgstr "DÉGAGE DE MA VUE !"

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-3/0
msgctxt "Tina"
msgid "I'm gonna put this RIGHT here, where nobody can reach it!"
msgstr "Je vais poser ça JUSTE ici, là où personne peut l'atteindre !"

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-3/8/s/0
msgctxt "Choix"
msgid "What, just there on the table?"
msgstr "Quoi, là, sur la table ?"

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-3/9/s/0
msgctxt "Choix"
msgid "You know I can reach that easily, right?"
msgstr "Tu sais que je peux l'atteindre facilement, hein ?"

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-3/10/s/0
msgctxt "Choix"
msgid "I'm not going to read your diary, Tina."
msgstr "Je vais pas lire ton journal intime, Tina."

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-3/c-11/7
msgctxt "Tina"
msgid "EXACTLY!"
msgstr "EXACTEMENT !"

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-3/c-11/15/c-0/7
msgctxt "Tina"
msgid "I'm gonna leave you now... don't try nothin' funny!"
msgstr "Je te laisse... tente rien de louche !"

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-3/c-11/15/c-0/15
msgctxt "Tina"
msgid "I got my eye on you!"
msgstr "J'ai l'œil sur toi !"

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-3/c-12/7
msgctxt "Tina"
msgid "LA - LALALA!!!! I'm not listening to a word you say!"
msgstr "LA - LALALA !!!! J'écoute pas un mot de ce que tu dis !"

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-3/c-12/15
msgctxt "Tina"
msgid "Leaving now! Don't touch that diary!"
msgstr "Je m'en vais ! Touche pas à ce journal intime !"

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-3/c-13/7
msgctxt "Tina"
msgid "A likely story!"
msgstr "Tu parles !"

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-3/c-13/15
msgctxt "Tina"
msgid "I got my eye on ya, so no funny business!"
msgstr "J'ai l'œil sur toi, alors pas d'entourloupe !"

# Traduction IA – à relire
#: tina_triangle/tina_second_encounter/0/g-3/c-13/23
msgctxt "Tina"
msgid "Do NOT touch that journal!"
msgstr "NE TOUCHE PAS à ce journal !"

# Traduction IA – à relire
#: tina_triangle/tina_third_encounter/0/6
msgctxt "Narrator"
msgid "Silence greets you. Tina must be out."
msgstr "Le silence vous accueille. Tina doit être sortie."

# Traduction IA – à relire
#: tina_triangle/tina_third_encounter/0/11/s/0
msgctxt "Choix"
msgid "Hello? Tina?"
msgstr "Allô ? Tina ?"

# Traduction IA – à relire
#: tina_triangle/tina_third_encounter/0/c-0/10
msgctxt "Narrator"
msgid "Her journal—which is NOT a diary—is still on the table where she left it the last time."
msgstr "Son journal, qui n'est PAS un journal intime, est toujours sur la table là où elle l'a laissé la dernière fois."

# Traduction IA – à relire
#: tina_triangle/tina_third_encounter/0/c-0/15
msgctxt "Narrator"
msgid "This might be your chance to find out a little more about her."
msgstr "C'est peut-être l'occasion d'en apprendre un peu plus sur elle."

# Traduction IA – à relire
#: tina_triangle/tina_third_encounter/0/c-0/20
msgctxt "Narrator"
msgid "Then again, it is a little invasive, isn't it?"
msgstr "Cela dit, c'est un peu indiscret, non ?"

# Traduction IA – à relire
#: tina_triangle/tina_third_encounter/0/c-0/25
msgctxt "Narrator"
msgid "It's almost like she was goading you into reading it. Could it be a trap?"
msgstr "C'est presque comme si elle vous poussait à le lire. Serait-ce un piège ?"

# Traduction IA – à relire
#: tina_triangle/tina_third_encounter/0/g-0/0/s/0
msgctxt "Choix"
msgid "<i>Read the diary.</i>"
msgstr "<i>Lire le journal.</i>"

# Traduction IA – à relire
#: tina_triangle/tina_third_encounter/0/g-0/1/s/0
msgctxt "Choix"
msgid "<i>Don't read the diary.</i>"
msgstr "<i>Ne pas lire le journal.</i>"

# Traduction IA – à relire
#: tina_triangle/tina_third_encounter/0/g-0/2/s/0
msgctxt "Choix"
msgid "<i>Pretend to read the diary.</i>"
msgstr "<i>Faire semblant de lire le journal.</i>"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/0
msgctxt "Narrator"
msgid "These are the ramblings of a mad triangle."
msgstr "Ce sont les divagations d'un triangle dément."

# Traduction IA – à relire
#: tina_triangle/read_diary/0/5
msgctxt "Narrator"
msgid "Sorry, a complex, sensitive, sensual triangle."
msgstr "Pardon, d'un triangle complexe, sensible et sensuel."

# Traduction IA – à relire
#: tina_triangle/read_diary/0/10
msgctxt "Narrator"
msgid "You see page after page of meditation on the benefits of threesomes..."
msgstr "Vous voyez page après page de méditations sur les bienfaits des plans à trois..."

# Traduction IA – à relire
#: tina_triangle/read_diary/0/15
msgctxt "Narrator"
msgid "...recaps on the latest episodes of Love on Triangle Island..."
msgstr "...des résumés des derniers épisodes de L'Amour sur l'Île du Triangle..."

# Traduction IA – à relire
#: tina_triangle/read_diary/0/20
msgctxt "Narrator"
msgid "...and Tina's innermost thoughts on what makes a triangle complete."
msgstr "...et les pensées les plus intimes de Tina sur ce qui rend un triangle complet."

# Traduction IA – à relire
#: tina_triangle/read_diary/0/25/0/0 tina_triangle/read_diary/0/g-2/c-5/7
msgctxt "Narrator"
msgid "You begin to read."
msgstr "Vous commencez à lire."

# Traduction IA – à relire
#: tina_triangle/read_diary/0/25/0/5/s/0
msgctxt "Choix"
msgid "<i>Read about threesomes.</i>"
msgstr "<i>Lire sur les plans à trois.</i>"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/25/0/6/s/0
msgctxt "Choix"
msgid "<i>Read about Love on Triangle Island.</i>"
msgstr "<i>Lire sur L'Amour sur l'Île du Triangle.</i>"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/25/0/7/s/0
msgctxt "Choix"
msgid "<i>Read about what completes Tina.</i>"
msgstr "<i>Lire sur ce qui complète Tina.</i>"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/25/0/c-0/13
msgctxt "Tina"
msgid "Threesomes are triangles, and triangles are the strongest shape in nature."
msgstr "Les plans à trois sont des triangles, et les triangles sont la forme la plus solide de la nature."

# Traduction IA – à relire
#: tina_triangle/read_diary/0/25/0/c-0/18
msgctxt "Tina"
msgid "What's better than two people bonin'? Three!"
msgstr "Mieux que deux personnes qui baisent ? Trois !"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/25/0/c-0/23
msgctxt "Tina"
msgid "One of 'em starts borin' ya you turn to the next one!"
msgstr "L'un des deux commence à t'ennuyer, tu te tournes vers l'autre !"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/25/0/c-0/28
msgctxt "Tina"
msgid "Or they both worship ya like the queen of the universe you are!"
msgstr "Ou alors ils te vénèrent tous les deux comme la reine de l'univers que t'es !"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/25/0/c-0/33
msgctxt "Tina"
msgid "At this point in my life I'm done settlin' for less."
msgstr "À ce stade de ma vie, j'en ai fini de me contenter de moins."

# Traduction IA – à relire
#: tina_triangle/read_diary/0/25/0/c-0/38
msgctxt "Tina"
msgid "This ride's a two-seater, baby!"
msgstr "Ce manège a deux places, bébé !"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/25/0/c-0/43
msgctxt "Tina"
msgid "If you ain't got a friend I ain't into it!"
msgstr "Si t'as pas un ami, ça m'intéresse pas !"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/25/0/c-1/13
msgctxt "Tina"
msgid "Love on Triangle Island is the absolute PEAK of television."
msgstr "L'Amour sur l'Île du Triangle, c'est le SOMMET absolu de la télévision."

# Traduction IA – à relire
#: tina_triangle/read_diary/0/25/0/c-1/18
msgctxt "Tina"
msgid "Why the hell nobody in this goddamn house understands I'll never know."
msgstr "Pourquoi putain personne dans cette maison comprend ça, je le saurai jamais."

# Traduction IA – à relire
#: tina_triangle/read_diary/0/25/0/c-1/23
msgctxt "Tina"
msgid "Just last week, Isocelina was tellin' Pythagoras he was the only one for her."
msgstr "Pas plus tard que la semaine dernière, Isocelina disait à Pythagore qu'il était le seul pour elle."

# Traduction IA – à relire
#: tina_triangle/read_diary/0/25/0/c-1/28
msgctxt "Tina"
msgid "Not five minutes later Heron's got her on her hypotenuse in the boom boom room, and she's in the confessionals talkin' bout she's an equilateral lover..."
msgstr "Même pas cinq minutes après, Héron l'a sur son hypoténuse dans la chambre des câlins, et elle est au confessionnal à dire qu'elle est une amante équilatérale..."

# Traduction IA – à relire
#: tina_triangle/read_diary/0/25/0/c-1/33
msgctxt "Tina"
msgid "CINEMA! GENIUS!"
msgstr "DU CINÉMA ! DU GÉNIE !"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/25/0/c-1/38
msgctxt "Tina"
msgid "Honestly, why can't anyone understand that's just the kinda triangle I am?"
msgstr "Franchement, pourquoi personne comprend que c'est juste le genre de triangle que je suis ?"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/25/0/c-1/43
msgctxt "Tina"
msgid "I need EXCITEMENT! I need STIMULATION!"
msgstr "J'ai besoin d'EXCITATION ! J'ai besoin de STIMULATION !"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/25/0/c-1/48
msgctxt "Tina"
msgid "I need TWO PARTNERS!"
msgstr "J'ai besoin de DEUX PARTENAIRES !"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/25/0/c-2/13
msgctxt "Tina"
msgid "I'm always tellin' people all the time what a complex triangle I am and nobody gets it."
msgstr "Je dis tout le temps aux gens quel triangle complexe je suis et personne pige."

# Traduction IA – à relire
#: tina_triangle/read_diary/0/25/0/c-2/18
msgctxt "Tina"
msgid "You know a triangle's gotta have an opening at one end to resonate properly... we can't make beautiful music without bein' incomplete."
msgstr "Tu sais, un triangle doit avoir une ouverture à un bout pour bien résonner... on peut pas faire de la belle musique sans être incomplet."

# Traduction IA – à relire
#: tina_triangle/read_diary/0/25/0/c-2/23
msgctxt "Tina"
msgid "So what if I got a little gap in me... it's just the way I was made, baby!"
msgstr "Alors quoi, j'ai un petit trou en moi... c'est juste comme ça que j'ai été faite, bébé !"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/25/0/c-2/28
msgctxt "Tina"
msgid "I am a complex, complicated, beautiful object!"
msgstr "Je suis un objet complexe, compliqué et magnifique !"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/25/0/c-2/33
msgctxt "Tina"
msgid "Ya can't hold onto a triangle directly—you gotta hold 'em at a distance so they can make their beautiful noise."
msgstr "On peut pas tenir un triangle directement, faut le tenir à distance pour qu'il fasse son beau bruit."

# Traduction IA – à relire
#: tina_triangle/read_diary/0/25/0/c-2/38
msgctxt "Tina"
msgid "I'm a free-spirit that can't be tied down! Unless two extremely hot people wanna make me the center of their universe."
msgstr "Je suis un esprit libre qu'on peut pas attacher ! Sauf si deux personnes ultra canon veulent faire de moi le centre de leur univers."

# Traduction IA – à relire
#: tina_triangle/read_diary/0/25/0/c-2/43
msgctxt "Tina"
msgid "In which case hello! I'm right here, dummy! What are ya waitin' for!?"
msgstr "Auquel cas bonjour ! Je suis juste là, andouille ! Vous attendez quoi !?"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/g-1/0
msgctxt "Narrator"
msgid "Do you keep reading?"
msgstr "Continuez-vous à lire ?"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/g-1/5/s/0
msgctxt "Choix"
msgid "<i>Keep reading the diary.</i>"
msgstr "<i>Continuer à lire le journal.</i>"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/g-1/6/s/0
msgctxt "Choix"
msgid "<i>Stop reading the diary.</i>"
msgstr "<i>Arrêter de lire le journal.</i>"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/g-2/0
msgctxt "Narrator"
msgid "The diary continues on like this for some time. As you page through the rest of it, your name catches your eye."
msgstr "Le journal continue ainsi pendant un moment. En feuilletant la suite, votre prénom attire votre regard."

# Traduction IA – à relire
#: tina_triangle/read_diary/0/g-2/5/s/0
msgctxt "Choix"
msgid "<i>I read it, obviously.</i>"
msgstr "<i>Je le lis, évidemment.</i>"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/g-2/6/s/0
msgctxt "Choix"
msgid "<i>I decide to respect her privacy.</i>"
msgstr "<i>Je décide de respecter son intimité.</i>"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/g-2/c-5/16
msgctxt "Tina"
msgid "There's someone new in my life... they keep comin' around to talk to me."
msgstr "Y'a quelqu'un de nouveau dans ma vie... cette personne n'arrête pas de venir me parler."

# Traduction IA – à relire
#: tina_triangle/read_diary/0/g-2/c-6/11
msgctxt "Narrator"
msgid "A bit late for that now, but sure, you decide to 'respect her privacy'."
msgstr "C'est un peu tard pour ça maintenant, mais bon, vous décidez de « respecter son intimité »."

# Traduction IA – à relire
#: tina_triangle/read_diary/0/g-2/c-6/19
msgctxt "Narrator"
msgid "You close the journal and set it down."
msgstr "Vous refermez le journal et le reposez."

# Traduction IA – à relire
#: tina_triangle/read_diary/0/g-2/c-6/27
msgctxt "Tina"
msgid "AHA!"
msgstr "AHA !"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/g-2/c-6/38/0/s/0
msgctxt "Choix"
msgid "Hi Tina."
msgstr "Salut Tina."

# Traduction IA – à relire
#: tina_triangle/read_diary/0/g-2/c-6/38/1/s/0
msgctxt "Choix"
msgid "AHHH!"
msgstr "AHHH !"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/g-2/c-6/38/2/s/0
msgctxt "Choix"
msgid "I knew you were there the entire time."
msgstr "Je savais que tu étais là depuis le début."

# Traduction IA – à relire
#: tina_triangle/read_diary/0/g-2/c-6/38/c-0/7
msgctxt "Tina"
msgid "Hi nothin'! I caught ya red-handed!"
msgstr "Salut, mon œil ! Je t'ai pris la main dans le sac !"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/g-2/c-6/38/c-1/7
msgctxt "Tina"
msgid "Don't get cute now! I caught ya!"
msgstr "Fais pas ton intéressant maintenant ! Je t'ai eu !"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/g-2/c-6/38/c-2/7
msgctxt "Tina"
msgid "Yeah right! I got ya dead to rights!"
msgstr "Mais bien sûr ! Je te tiens, c'est foutu pour toi !"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/g-3/0
msgctxt "Tina"
msgid "You read my diary! And ya didn't even have the decency to commit to readin' the whole thing!"
msgstr "T'as lu mon journal intime ! Et t'as même pas eu la décence de t'engager à tout lire !"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/g-3/11/s/0
msgctxt "Choix"
msgid "Did you want me to read it or not?"
msgstr "Tu voulais que je le lise, oui ou non ?"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/g-3/12/s/0 tina_triangle/dont_read/0/g-0/24/1/s/0
msgctxt "Choix"
msgid "I don't know what you want from me."
msgstr "Je sais pas ce que tu attends de moi."

# Traduction IA – à relire
#: tina_triangle/read_diary/0/g-3/13/s/0
msgctxt "Choix"
msgid "So?"
msgstr "Alors ?"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/g-3/c-7/7
msgctxt "Tina"
msgid "It's not my job to tell you how to treat me!"
msgstr "C'est pas mon boulot de t'expliquer comment me traiter !"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/g-3/c-7/15
msgctxt "Tina"
msgid "If you can't read my mind then you ain't the one!"
msgstr "Si tu peux pas lire dans mes pensées, c'est pas toi l'élu !"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/g-3/c-8/7
msgctxt "Tina"
msgid "I keep tellin' ya I'm a complicated triangle!"
msgstr "J'arrête pas de te dire que je suis un triangle compliqué !"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/g-3/c-8/15
msgctxt "Tina"
msgid "If you don't wanna try an' unravel the sexy enigma that I am I ain't about to tell ya how to do it!"
msgstr "Si tu veux pas essayer de percer l'énigme sexy que je suis, je vais pas te dire comment faire !"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/g-3/c-9/7
msgctxt "Tina"
msgid "How can ya get SO close and still flub it up!?"
msgstr "Comment on peut s'approcher d'AUTANT et quand même foirer !?"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/g-3/c-9/15
msgctxt "Tina"
msgid "GOD you are the worst!"
msgstr "MON DIEU, t'es insupportable !"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/g-4/0
msgctxt "Tina"
msgid "Just go on and leave me alone, will ya!"
msgstr "Va-t'en et fiche-moi la paix, tu veux !"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/g-4/8
msgctxt "Tina"
msgid "I thought you had potential but you couldn't even pass the tiniest little test!"
msgstr "Je croyais que t'avais du potentiel mais t'as même pas réussi le plus petit des tests !"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/g-4/16
msgctxt "Tina"
msgid "I shoulda known true love only happens on Love Triangle Island!"
msgstr "J'aurais dû savoir que le grand amour, ça existe que sur L'Amour sur l'Île du Triangle !"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/g-4/24
msgctxt "Tina"
msgid "My life SUCKS!"
msgstr "MA VIE EST NULLE !"

# Traduction IA – à relire
#: tina_triangle/read_diary/0/g-4/38 tina_triangle/diary_not_full_talk/0/g-0/1/c-3/50/c-1/27 tina_triangle/diary_not_full_talk/0/g-0/1/c-4/23/c-1/26 tina_triangle/diary_not_full_talk/0/g-0/1/c-4/23/c-1/57/c-0/26
msgctxt "Narrator"
msgid "Tina runs out of the room, sobbing and wailing dramatically."
msgstr "Tina sort de la pièce en courant, sanglotant et gémissant de façon théâtrale."

# Traduction IA – à relire
#: tina_triangle/tina_love_d/0
msgctxt "Tina"
msgid "They're almost perfect... they really kinda get me."
msgstr "Cette personne est presque parfaite... elle me comprend vraiment un peu."

# Traduction IA – à relire
#: tina_triangle/tina_love_d/5
msgctxt "Tina"
msgid "It ain't easy lovin' me right where I am—but they're kinda doin' it anyway."
msgstr "C'est pas facile de m'aimer là où j'en suis, mais elle le fait quand même, un peu."

# Traduction IA – à relire
#: tina_triangle/tina_love_d/10
msgctxt "Tina"
msgid "But when all ya got is one lover it's so easy to see how annoying they are."
msgstr "Mais quand t'as qu'un seul amant, c'est trop facile de voir à quel point il est agaçant."

# Traduction IA – à relire
#: tina_triangle/tina_love_d/15
msgctxt "Tina"
msgid "If I just had one more person to keep things spicy I know things'd be so perfect between us."
msgstr "Si j'avais juste une personne de plus pour pimenter les choses, je sais que ce serait tellement parfait entre nous."

# Traduction IA – à relire
#: tina_triangle/tina_love_d/20
msgctxt "Tina"
msgid "But how do I tell 'em..."
msgstr "Mais comment je lui dis..."

# Traduction IA – à relire
#: tina_triangle/tina_love_d/25 tina_triangle/tina_friend_d/35 tina_triangle/tina_hate_d/30
msgctxt "Narrator"
msgid "The entry ends there."
msgstr "L'entrée s'arrête là."

# Traduction IA – à relire
#: tina_triangle/tina_love_d/30 tina_triangle/tina_friend_d/40 tina_triangle/tina_hate_d/35
msgctxt "Narrator"
msgid "Having read as much as you can stand, you decide that's probably enough."
msgstr "Ayant lu tout ce que vous pouvez supporter, vous décidez que ça suffit probablement."

# Traduction IA – à relire
#: tina_triangle/tina_love_d/35 tina_triangle/tina_friend_d/45 tina_triangle/tina_hate_d/40
msgctxt "Narrator"
msgid "You return the journal to its place on the table, walking away before you get into any real trouble."
msgstr "Vous remettez le journal à sa place sur la table, en vous éloignant avant de vous attirer de vrais ennuis."

# Traduction IA – à relire
#: tina_triangle/tina_friend_d/0
msgctxt "Tina"
msgid "It might sound crazy but I ain't really the type to keep a lotta friends around."
msgstr "Ça va peut-être te paraître fou mais je suis pas vraiment du genre à garder plein d'amis autour de moi."

# Traduction IA – à relire
#: tina_triangle/tina_friend_d/5
msgctxt "Tina"
msgid "Not cause there's anything wrong with me or nothin'."
msgstr "Pas parce qu'il y aurait un problème avec moi ou quoi."

# Traduction IA – à relire
#: tina_triangle/tina_friend_d/10
msgctxt "Tina"
msgid "No no, it's that I'm TOO amazing, actually."
msgstr "Non non, c'est que je suis TROP géniale, en fait."

# Traduction IA – à relire
#: tina_triangle/tina_friend_d/15
msgctxt "Tina"
msgid "A triangle like me's gotta have a love triangle as complicated and sexy as she is if she wants to be happy."
msgstr "Un triangle comme moi doit avoir un triangle amoureux aussi compliqué et sexy qu'elle si elle veut être heureuse."

# Traduction IA – à relire
#: tina_triangle/tina_friend_d/20
msgctxt "Tina"
msgid "Been nice havin' someone who gets me around, even if we ain't connectin' romantically."
msgstr "C'est agréable d'avoir quelqu'un qui me comprend dans le coin, même si on se connecte pas sentimentalement."

# Traduction IA – à relire
#: tina_triangle/tina_friend_d/25
msgctxt "Tina"
msgid "Not really used to that. Wasn't lookin' for a friend, but..."
msgstr "J'ai pas trop l'habitude. Je cherchais pas d'ami, mais..."

# Traduction IA – à relire
#: tina_triangle/tina_friend_d/30
msgctxt "Tina"
msgid "I ain't mad at havin' one now."
msgstr "Je suis pas fâchée d'en avoir un maintenant."

# Traduction IA – à relire
#: tina_triangle/tina_hate_d/0
msgctxt "Tina"
msgid "I HATE 'EM! And not in the SEXY WAY where I just want 'em to chokeslam me through a wall!"
msgstr "JE LA DÉTESTE ! Et pas de la façon SEXY où j'aimerais juste qu'elle me projette à travers un mur !"

# Traduction IA – à relire
#: tina_triangle/tina_hate_d/5
msgctxt "Tina"
msgid "I ain't never met somebody so goddamn square in my LIFE!"
msgstr "J'ai JAMAIS rencontré quelqu'un d'aussi putain de carré de TOUTE ma vie !"

# Traduction IA – à relire
#: tina_triangle/tina_hate_d/10
msgctxt "Tina"
msgid "They don't get me, not even a little bit! Talkin' to 'em is actual torture!"
msgstr "Elle me comprend pas, même pas un tout petit peu ! Lui parler, c'est de la vraie torture !"

# Traduction IA – à relire
#: tina_triangle/tina_hate_d/15
msgctxt "Tina"
msgid "I'd rather bend myself into a pretzel than talk to that person!"
msgstr "Je préférerais me plier en bretzel plutôt que de parler à cette personne !"

# Traduction IA – à relire
#: tina_triangle/tina_hate_d/20
msgctxt "Tina"
msgid "And look, that's sayin' somethin, 'cause hello? Triangle? Solid metal shape here?"
msgstr "Et crois-moi, c'est pas rien, parce que allô ? Triangle ? Forme en métal massif, ici ?"

# Traduction IA – à relire
#: tina_triangle/tina_hate_d/25
msgctxt "Tina"
msgid "Anyway I hope all the worst things in life happen to 'em and they never speak to me again. <3"
msgstr "Bref, j'espère que tout ce qu'il y a de pire dans la vie lui arrive et qu'elle me parlera plus jamais. <3"

# Traduction IA – à relire
#: tina_triangle/dont_read/0/6
msgctxt "Narrator"
msgid "Tina bursts into the room with absolute fire in her eyes. She points her finger at you, and accosts you, her nostrils flaring."
msgstr "Tina déboule dans la pièce avec du feu dans les yeux. Elle pointe le doigt vers vous et vous interpelle, les narines dilatées."

# Traduction IA – à relire
#: tina_triangle/dont_read/0/14
msgctxt "Tina"
msgid "Are you kidding me!?"
msgstr "Tu te fous de moi !?"

# Traduction IA – à relire
#: tina_triangle/dont_read/0/25/s/0 tina_triangle/diary_full_talk/0/9/s/0 tina_triangle/diary_not_full_talk/0/9/s/0
msgctxt "Choix"
msgid "I knew you were there the whole time."
msgstr "Je savais que tu étais là depuis le début."

# Traduction IA – à relire
#: tina_triangle/dont_read/0/26/s/0
msgctxt "Choix"
msgid "Oh yeah, totally. You should see the look on your face."
msgstr "Ah ouais, carrément. Tu devrais voir ta tête."

# Traduction IA – à relire
#: tina_triangle/dont_read/0/27/s/0
msgctxt "Choix"
msgid "No?"
msgstr "Non ?"

# Traduction IA – à relire
#: tina_triangle/dont_read/0/c-0/7
msgctxt "Tina"
msgid "SO YOU'RE BORING AND DISRESPECTFUL, HUH?"
msgstr "DONC TU ES CHIANT ET IRRESPECTUEUX, HEIN ?"

# Traduction IA – à relire
#: tina_triangle/dont_read/0/c-1/7
msgctxt "Tina"
msgid "THIS AIN'T ABOUT MY GORGEOUS FACE!"
msgstr "IL S'AGIT PAS DE MON SUPERBE VISAGE !"

# Traduction IA – à relire
#: tina_triangle/dont_read/0/c-2/7
msgctxt "Tina"
msgid "YOU'RE SO BORING YOU CAN'T EVEN TAKE THE EASY OUT?!"
msgstr "T'ES TELLEMENT CHIANT QUE TU PEUX MÊME PAS PRENDRE LA SORTIE FACILE ?!"

# Traduction IA – à relire
#: tina_triangle/dont_read/0/g-0/0
msgctxt "Tina"
msgid "I can't BELIEVE you!"
msgstr "J'Y CROIS PAS !"

# Traduction IA – à relire
#: tina_triangle/dont_read/0/g-0/8
msgctxt "Tina"
msgid "I left my diary right there for you where you could see it."
msgstr "J'ai laissé mon journal intime là pour toi, bien en vue."

# Traduction IA – à relire
#: tina_triangle/dont_read/0/g-0/16
msgctxt "Tina"
msgid "And you couldn't even pick it up and read it!?"
msgstr "Et t'as même pas pu le prendre et le lire !?"

# Traduction IA – à relire
#: tina_triangle/dont_read/0/g-0/24/0/s/0
msgctxt "Choix"
msgid "So you DO want me to read it?"
msgstr "Donc tu VEUX que je le lise ?"

# Traduction IA – à relire
#: tina_triangle/dont_read/0/g-0/24/2/s/0
msgctxt "Choix"
msgid "I didn't want to, so..."
msgstr "Je voulais pas, alors..."

# Traduction IA – à relire
#: tina_triangle/dont_read/0/g-0/24/c-0/7
msgctxt "Tina"
msgid "I don't want ANYTHING from you, square!"
msgstr "Je veux RIEN de toi, carré !"

# Traduction IA – à relire
#: tina_triangle/dont_read/0/g-0/24/c-1/7
msgctxt "Tina"
msgid "NOTHIN' ANYMORE NOW!"
msgstr "PLUS RIEN DU TOUT !"

# Traduction IA – à relire
#: tina_triangle/dont_read/0/g-0/24/c-2/7
msgctxt "Tina"
msgid "WELL GOOD, CAUSE I DON'T WANT YOU TO EITHER!"
msgstr "EH BEN TANT MIEUX, PARCE QUE MOI NON PLUS JE VEUX RIEN DE TOI !"

# Traduction IA – à relire
#: tina_triangle/dont_read/0/g-0/24/g-0/0
msgctxt "Tina"
msgid "GET LOST, SQUARE!"
msgstr "DÉGAGE, CARRÉ !"

# Traduction IA – à relire
#: tina_triangle/pretend_read/0/0
msgctxt "Narrator"
msgid "You put on a big show of flipping through the pages, and saying things that make it sound like you're reading."
msgstr "Vous faites toute une comédie en feuilletant les pages, et en disant des choses qui donnent l'impression que vous lisez."

# Traduction IA – à relire
#: tina_triangle/pretend_read/0/5/s/0
msgctxt "Choix"
msgid "Hmm. I see. Wow. Fascinating."
msgstr "Hmm. Je vois. Wow. Fascinant."

# Traduction IA – à relire
#: tina_triangle/pretend_read/0/c-0/7
msgctxt "Narrator"
msgid "You're rewarded with a sneaky-sounding giggle from somewhere nearby."
msgstr "Vous êtes récompensé par un gloussement sournois venant de quelque part tout près."

# Traduction IA – à relire
#: tina_triangle/pretend_read/0/c-0/12
msgctxt "Narrator"
msgid "Now that you know you have an audience, you could, uh, switch things up a bit..."
msgstr "Maintenant que vous savez que vous avez du public, vous pourriez, euh, changer un peu les choses..."

# Traduction IA – à relire
#: tina_triangle/pretend_read/0/c-0/17/0/s/0
msgctxt "Choix"
msgid "<i>Make fun of the contents of the diary.</i>"
msgstr "<i>Se moquer du contenu du journal.</i>"

# Traduction IA – à relire
#: tina_triangle/pretend_read/0/c-0/17/1/s/0
msgctxt "Choix"
msgid "<i>Pretend to be moved to tears.</i>"
msgstr "<i>Faire semblant d'être ému aux larmes.</i>"

# Traduction IA – à relire
#: tina_triangle/pretend_read/0/c-0/17/2/s/0
msgctxt "Choix"
msgid "<i>Keep up the intrigue.</i>"
msgstr "<i>Entretenir le mystère.</i>"

# Traduction IA – à relire
#: tina_triangle/pretend_read/0/c-0/17/c-0/7
msgctxt "Narrator"
msgid "You give it your best, reading bits and pieces out loud before you dissolve into cruel laughter."
msgstr "Vous donnez tout, lisant des bribes à voix haute avant de vous écrouler dans un rire cruel."

# Traduction IA – à relire
#: tina_triangle/pretend_read/0/c-0/17/c-0/12
msgctxt "Narrator"
msgid "You successfully channel your inner bully—you're not sure if you should be proud of yourself or not."
msgstr "Vous canalisez avec succès votre petite brute intérieure, et vous ne savez pas trop si vous devez en être fier."

# Traduction IA – à relire
#: tina_triangle/pretend_read/0/c-0/17/c-1/7
msgctxt "Narrator"
msgid "You think of the saddest situation you've ever experienced until the tears begin to well in your eyes."
msgstr "Vous pensez à la situation la plus triste que vous ayez jamais vécue jusqu'à ce que les larmes montent."

# Traduction IA – à relire
#: tina_triangle/pretend_read/0/c-0/17/c-1/12
msgctxt "Narrator"
msgid "Finally, when you've made yourself good and depressed, a single tear rolls down your cheek. It's beautiful, honestly."
msgstr "Finalement, quand vous vous êtes bien plombé le moral, une larme roule sur votre joue. Elle est belle, franchement."

# Traduction IA – à relire
#: tina_triangle/pretend_read/0/c-0/17/c-2/7
msgctxt "Narrator"
msgid "You see no need to change things up now. You continue making thoughtful sounds, nodding and saying 'Mmm, I understand now' every now and again."
msgstr "Vous ne voyez pas l'intérêt de changer quoi que ce soit maintenant. Vous continuez à faire des bruits pensifs, en hochant la tête et en disant « Mmm, je comprends maintenant » de temps en temps."

# Traduction IA – à relire
#: tina_triangle/pretend_read/0/g-0/0
msgctxt "Narrator"
msgid "Despite your incredible performance, Tina—or whoever is giggling nearby—never emerges."
msgstr "Malgré votre performance incroyable, Tina, ou quiconque glousse dans les parages, ne sort jamais de sa cachette."

# Traduction IA – à relire
#: tina_triangle/pretend_read/0/g-0/5
msgctxt "Narrator"
msgid "You decide that's probably enough for now, and wander off to do something else."
msgstr "Vous décidez que ça suffit pour le moment, et vous partez faire autre chose."

# Traduction IA – à relire
#: tina_triangle/tina_boring_ending/0/0
msgctxt "Tina"
msgid "Well well well."
msgstr "Eh ben eh ben eh ben."

# Traduction IA – à relire
#: tina_triangle/tina_boring_ending/0/8
msgctxt "Tina"
msgid "If it ain't the single most boring individual in this goddamn house."
msgstr "Si c'est pas l'individu le plus chiant de toute cette putain de maison."

# Traduction IA – à relire
#: tina_triangle/tina_boring_ending/0/16 tina_triangle/tina_boring_ending/0/g-0/23/6
msgctxt "Tina"
msgid "I served you up a feast of angles and you said 'oh no thanks, we got angles at home!'"
msgstr "Je t'ai servi un festin d'angles et tu m'as dit « oh non merci, on a des angles à la maison ! »"

# Traduction IA – à relire
#: tina_triangle/tina_boring_ending/0/24/s/0
msgctxt "Choix"
msgid "I don't remember saying that."
msgstr "Je me souviens pas d'avoir dit ça."

# Traduction IA – à relire
#: tina_triangle/tina_boring_ending/0/25/s/0
msgctxt "Choix"
msgid "I feel like you're doing an awful lot of projecting here."
msgstr "J'ai l'impression que tu projettes pas mal, là."

# Traduction IA – à relire
#: tina_triangle/tina_boring_ending/0/26/s/0
msgctxt "Choix"
msgid "I DON'T CARE ABOUT YOUR SHIT."
msgstr "J'M'EN FOUS DE TES CONNERIES."

# Traduction IA – à relire
#: tina_triangle/tina_boring_ending/0/borings/0
msgctxt "Tina"
msgid "SHUT UP! You can't even give me the decency of one good argument before I break up with ya?!"
msgstr "FERME-LA ! Tu peux même pas me donner la décence d'une seule bonne dispute avant que je rompe avec toi ?!"

# Traduction IA – à relire
#: tina_triangle/tina_boring_ending/0/borings/11
msgctxt "Tina"
msgid "I HATE YOU!"
msgstr "JE TE DÉTESTE !"

# Traduction IA – à relire
#: tina_triangle/tina_boring_ending/0/borings/19/s/0
msgctxt "Choix"
msgid "Break up? Did we date and I didn't know it?"
msgstr "Rompre ? On sortait ensemble et je le savais pas ?"

# Traduction IA – à relire
#: tina_triangle/tina_boring_ending/0/borings/20/s/0
msgctxt "Choix"
msgid "Your delusions aren't funny anymore."
msgstr "Tes délires sont plus drôles du tout."

# Traduction IA – à relire
#: tina_triangle/tina_boring_ending/0/borings/21/s/0
msgctxt "Choix"
msgid "I'm just gonna go now."
msgstr "Je vais juste y aller."

# Traduction IA – à relire
#: tina_triangle/tina_boring_ending/0/borings/c-3/7
msgctxt "Tina"
msgid "Uhuh... uhuh..."
msgstr "Mouais... mouais..."

# Traduction IA – à relire
#: tina_triangle/tina_boring_ending/0/borings/c-4/7
msgctxt "Tina"
msgid "Least I was funny once! You ain't NEVER been anything more than a SQUARE!"
msgstr "Moi au moins j'ai été drôle une fois ! Toi t'as JAMAIS été plus qu'un CARRÉ !"

# Traduction IA – à relire
#: tina_triangle/tina_boring_ending/0/borings/c-5/7
msgctxt "Tina"
msgid "Yeah, leave! I was tired of lookin' at your <w>DUMB BORING FACE ANYWAY!</w>"
msgstr "Ouais, pars ! J'en avais marre de regarder ta <w>STUPIDE TÊTE ENNUYEUSE DE TOUTE FAÇON !</w>"

# Traduction IA – à relire
#: tina_triangle/tina_boring_ending/0/g-0/23/14/s/0
msgctxt "Choix"
msgid "You're still mad about your stupid diary?"
msgstr "T'es encore fâchée à cause de ton stupide journal intime ?"

# Traduction IA – à relire
#: tina_triangle/tina_boring_ending/0/g-0/23/c-6/7
msgctxt "Tina"
msgid "IT'S NOT A DIARY, IT'S-"
msgstr "C'EST PAS UN JOURNAL INTIME, C'EST-"

# Traduction IA – à relire
#: tina_triangle/tina_boring_ending/0/g-0/23/c-6/15/0/s/0
msgctxt "Choix"
msgid "'A JOURNAL'? News flash, drama queen: it sucks the same no matter what you call it!"
msgstr "« UN JOURNAL » ? Flash info, reine du drame : ça craint pareil quel que soit le nom que tu lui donnes !"

# Traduction IA – à relire
#: tina_triangle/tina_boring_ending/0/g-0/23/c-6/15/c-0/7
msgctxt "Tina"
msgid "Hmph."
msgstr "Hmph."

# Traduction IA – à relire
#: tina_triangle/tina_boring_ending/0/g-0/23/c-6/15/c-0/18/0/s/0
msgctxt "Choix"
msgid "I didn't read it because you've got about as much depth as a puddle."
msgstr "Je l'ai pas lu parce que t'as à peu près autant de profondeur qu'une flaque."

# Traduction IA – à relire
#: tina_triangle/tina_boring_ending/0/g-0/23/c-6/15/c-0/18/c-0/7
msgctxt "Tina"
msgid "A PUDDLE?!"
msgstr "UNE FLAQUE ?!"

# Traduction IA – à relire
#: tina_triangle/tina_boring_ending/0/g-0/23/c-6/15/c-0/18/c-0/18/0/s/0
msgctxt "Choix"
msgid "So yeah, I didn't read your stupid diary! BECAUSE IT'S DUMB AND SO ARE YOU!"
msgstr "Alors ouais, j'ai pas lu ton stupide journal intime ! PARCE QU'IL EST NUL ET TOI AUSSI !"

# Traduction IA – à relire
#: tina_triangle/tina_boring_ending/0/g-0/23/c-6/15/c-0/18/c-0/18/c-0/7
msgctxt "Narrator"
msgid "Tina stands in shocked silence, mouth agape, hand on her ample, triangular chest."
msgstr "Tina reste là, muette de stupeur, la bouche ouverte, la main sur sa généreuse poitrine triangulaire."

# Traduction IA – à relire
#: tina_triangle/tina_boring_ending/0/g-0/23/c-6/15/c-0/18/c-0/18/c-0/15/0/s/0
msgctxt "Choix"
msgid "Yeah well I gotta million other dates to get back to, so..."
msgstr "Ouais ben j'ai un million d'autres rendez-vous où retourner, alors..."

# Traduction IA – à relire
#: tina_triangle/tina_boring_ending/0/g-0/23/c-6/15/c-0/18/c-0/18/c-0/15/1/s/0
msgctxt "Choix"
msgid "Is this the part where we live happily ever after?"
msgstr "C'est là qu'on vit heureux pour toujours ?"

# Traduction IA – à relire
#: tina_triangle/tina_boring_ending/0/g-0/23/c-6/15/c-0/18/c-0/18/c-0/15/c-0/7
msgctxt "Narrator"
msgid "Tina surges forward, yanking you by your shirt collar into a fiery kiss."
msgstr "Tina se jette en avant, vous attrape par le col de votre chemise et vous tire dans un baiser enflammé."

# Traduction IA – à relire
#: tina_triangle/tina_boring_ending/0/g-0/23/c-6/15/c-0/18/c-0/18/c-0/15/c-0/15
msgctxt "Narrator"
msgid "For a few moments of blessed silence, there is no more talk about the diary. There's only the two of you, and whatever this is."
msgstr "Pendant quelques instants de silence béni, il n'y a plus de discussion sur le journal intime. Il n'y a que vous deux, et ce que c'est que ça."

# Traduction IA – à relire
#: tina_triangle/tina_boring_ending/0/g-0/23/c-6/15/c-0/18/c-0/18/c-0/15/c-0/23
msgctxt "Tina"
msgid "God you're the worst. You wanna get outta here?"
msgstr "Mon Dieu, t'es insupportable. Tu veux qu'on se tire d'ici ?"

# Traduction IA – à relire
#: tina_triangle/tina_boring_ending/0/g-0/23/c-6/15/c-0/18/c-0/18/c-0/15/c-0/34/0/s/0
msgctxt "Choix"
msgid "Let's go."
msgstr "Allons-y."

# Traduction IA – à relire
#: tina_triangle/tina_boring_ending/0/g-0/23/c-6/15/c-0/18/c-0/18/c-0/15/c-0/34/c-0/7
msgctxt "Narrator"
msgid "Tina takes you by the hand, leading you off for an encounter that can only be described as intense and volatile... but satisfying nonetheless."
msgstr "Tina vous prend par la main et vous entraîne vers une rencontre qu'on ne peut décrire que comme intense et volatile... mais satisfaisante malgré tout."

# Traduction IA – à relire
#: tina_triangle/tina_boring_ending/0/g-0/23/c-6/15/c-0/18/c-0/18/c-0/15/c-1/7
msgctxt "Tina"
msgid "HOW DELUSIONAL CAN YOU BE?!"
msgstr "À QUEL POINT TU PEUX ÊTRE DANS TON DÉLIRE ?!"

# Traduction IA – à relire
#: tina_triangle/tina_shoot_shot/0/3
msgctxt "Narrator"
msgid "Tina bats her eyelashes at you as you approach."
msgstr "Tina bat des cils en vous voyant approcher."

# Traduction IA – à relire
#: tina_triangle/tina_shoot_shot/0/19/s/0
msgctxt "Choix"
msgid "Hey Tina... uh, what's that look for?"
msgstr "Hé Tina... euh, c'est quoi ce regard ?"

# Traduction IA – à relire
#: tina_triangle/tina_shoot_shot/0/c-0/7
msgctxt "Tina"
msgid "Oh, it's you... don't act all shy now."
msgstr "Oh, c'est toi... fais pas le timide maintenant."

# Traduction IA – à relire
#: tina_triangle/tina_shoot_shot/0/c-0/15
msgctxt "Tina"
msgid "Ain't you tired?"
msgstr "Tu fatigues pas ?"

# Traduction IA – à relire
#: tina_triangle/tina_shoot_shot/0/c-0/23/0/s/0
msgctxt "Choix"
msgid "Tired?"
msgstr "Si je fatigue ?"

# Traduction IA – à relire
#: tina_triangle/tina_shoot_shot/0/c-0/23/1/s/0
msgctxt "Choix"
msgid "Let me guess... I've been running through your mind-"
msgstr "Laisse-moi deviner... j'ai couru dans ta tête..."

# Traduction IA – à relire
#: tina_triangle/tina_shoot_shot/0/c-0/23/g-0/0
msgctxt "Tina"
msgid "'cause you've been running through my fantasies ALL night long, baby."
msgstr "Parce que tu cours dans mes fantasmes TOUTE la nuit, bébé."

# Traduction IA – à relire
#: tina_triangle/diary_full_talk/0/0 tina_triangle/diary_not_full_talk/0/0
msgctxt "Tina"
msgid "I saw you readin' my diary. I knew you couldn't resist."
msgstr "Je t'ai vu lire mon journal intime. Je savais que tu pourrais pas résister."

# Traduction IA – à relire
#: tina_triangle/diary_full_talk/0/8/s/0
msgctxt "Choix"
msgid "I wish I didn't."
msgstr "J'aurais aimé."

# Traduction IA – à relire
#: tina_triangle/diary_full_talk/0/10/s/0 tina_triangle/diary_not_full_talk/0/10/s/0
msgctxt "Choix"
msgid "I really couldn't, you got me."
msgstr "Je pouvais vraiment pas, tu m'as eu."

# Traduction IA – à relire
#: tina_triangle/diary_full_talk/0/c-0/7
msgctxt "Tina"
msgid "But ya did! Now I'm all in your mind and you can't stop thinkin' about me!"
msgstr "Mais tu l'as fait ! Maintenant je suis dans ta tête et tu peux pas arrêter de penser à moi !"

# Traduction IA – à relire
#: tina_triangle/diary_full_talk/0/c-1/7 tina_triangle/diary_not_full_talk/0/c-1/7
msgctxt "Tina"
msgid "Yeah right. I was hidden REAL good. Just accept you lost."
msgstr "Mais oui. J'étais CACHÉE super bien. Accepte juste que t'as perdu."

# Traduction IA – à relire
#: tina_triangle/diary_full_talk/0/c-2/7
msgctxt "Tina"
msgid "You're goddamn right I did! Ahhahahahahah!"
msgstr "Tu parles que je l'ai fait ! Ahhahahahahah !"

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/8/s/0
msgctxt "Choix"
msgid "I didn't actually read it."
msgstr "En fait, je l'ai pas lu."

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/c-0/7
msgctxt "Tina"
msgid "What do you think I'm STUPID!? I saw you readin' it. I HEARD YOU."
msgstr "Tu crois que je suis STUPIDE !? Je t'ai vu le lire. JE T'AI ENTENDU."

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/c-0/15
msgctxt "Tina"
msgid "You were INTO IT, like I knew ya would be."
msgstr "T'ÉTAIS À FOND dedans, comme je savais que tu le serais."

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/c-0/23
msgctxt "Tina"
msgid "Can't blame ya though. I am a real page-turner."
msgstr "Je peux pas t'en vouloir. Je suis un livre qu'on peut plus lâcher."

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/c-2/7
msgctxt "Tina"
msgid "You're goddamn right I did!"
msgstr "Tu parles que je l'ai fait !"

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/0
msgctxt "Tina"
msgid "Now look. It's real obvious there's a spark between me n' you."
msgstr "Bon, regarde. C'est clair qu'il y a une étincelle entre toi et moi."

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/8
msgctxt "Tina"
msgid "Question is are you gonna nut up and make me yours?"
msgstr "La question, c'est : tu vas te sortir les tripes et faire de moi la tienne ?"

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/16
msgctxt "Tina"
msgid "Or ya gonna be a <w>COWARD?!</w>"
msgstr "Ou tu vas être <w>LÂCHE ?!</w>"

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/27
msgctxt "Narrator"
msgid "She pokes you in the chest, way too hard, as if she were trying to goad you into attacking her."
msgstr "Elle vous pique la poitrine du doigt, beaucoup trop fort, comme si elle essayait de vous pousser à l'attaquer."

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/35
msgctxt "Tina"
msgid "Why dontcha DO somethin' about it, loser!"
msgstr "Pourquoi tu FAIS pas quelque chose, minable !"

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/44/s/0
msgctxt "Choix"
msgid "I really do just want to be friends, you know."
msgstr "Je veux vraiment juste qu'on soit amis, tu sais."

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/45/s/0
msgctxt "Choix"
msgid "I don't know how much clearer I can make it that I'm not into you."
msgstr "Je sais pas comment être plus clair sur le fait que tu m'intéresses pas."

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/46/s/0
msgctxt "Choix"
msgid "I'm gonna go now."
msgstr "Je vais y aller."

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-3/7
msgctxt "Narrator"
msgid "When your lips meet hers, you can feel Tina melt in your embrace. For once, she is speechless."
msgstr "Quand vos lèvres rencontrent les siennes, vous sentez Tina fondre dans votre étreinte. Pour une fois, elle est sans voix."

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-3/15
msgctxt "Tina"
msgid "Wow, uh... wow. Okay."
msgstr "Wow, euh... wow. Okay."

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-3/26
msgctxt "Tina"
msgid "So..."
msgstr "Donc..."

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-3/34
msgctxt "Tina"
msgid "Me 'n you, huh?"
msgstr "Toi et moi, hein ?"

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-3/42
msgctxt "Tina"
msgid "We're doin' this, right?"
msgstr "On le fait, c'est ça ?"

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-3/50/0/s/0
msgctxt "Choix"
msgid "Hell yeah."
msgstr "Et comment."

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-3/50/1/s/0
msgctxt "Choix"
msgid "Naw I just wanted to kiss you."
msgstr "Non, je voulais juste t'embrasser."

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-3/50/c-0/7
msgctxt "Tina"
msgid "Why don't we get outta here, baby?"
msgstr "Et si on se tirait d'ici, bébé ?"

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-3/50/c-0/15
msgctxt "Tina"
msgid "I'll even letcha figure out my cosine."
msgstr "Je te laisserai même découvrir mon cosinus."

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-3/50/c-0/23/0/s/0
msgctxt "Choix"
msgid "Your what?"
msgstr "Ton quoi ?"

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-3/50/c-0/23/1/s/0
msgctxt "Choix"
msgid "Oh, the ratio of your base to your hypotenuse?"
msgstr "Oh, le rapport entre ta base et ton hypoténuse ?"

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-3/50/c-0/23/c-0/7
msgctxt "Tina"
msgid "The ratio of my base to my hypotenuse, dummy."
msgstr "Le rapport entre ma base et mon hypoténuse, andouille."

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-3/50/c-0/23/c-0/15
msgctxt "Tina"
msgid "Now shut up and take me."
msgstr "Maintenant tais-toi et prends-moi."

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-3/50/c-0/23/c-1/7
msgctxt "Tina"
msgid "You got it, nerd. Now shut up and take me."
msgstr "Bien vu, l'intello. Maintenant tais-toi et prends-moi."

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-3/50/c-1/7/b/1
msgctxt "Tina"
msgid "I TOLD YOU I'M CELIBATE FOR MY CLARITY!"
msgstr "JE T'AI DIT QUE JE SUIS CÉLIBATAIRE VOLONTAIRE POUR MA CLARTÉ D'ESPRIT !"

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-3/50/c-1/8/b/1
msgctxt "Tina"
msgid "I'M NOT HERE FOR FREE KISSES, DING-A-LING!"
msgstr "JE SUIS PAS LÀ POUR DES BISOUS GRATUITS, PATATE !"

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-3/50/c-1/11
msgctxt "Tina"
msgid "If you ain't here for the entire Tina experience, we are done, dickhead."
msgstr "Si t'es pas là pour l'expérience Tina complète, c'est terminé, tête de nœud."

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-3/50/c-1/19
msgctxt "Tina"
msgid "I HATE YOUUUU!"
msgstr "JE TE DÉTESTEUUUH !"

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-4/7
msgctxt "Tina"
msgid "Yeah? Well I DON'T!"
msgstr "Ouais ? Ben MOI NON !"

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-4/15
msgctxt "Tina"
msgid "I GOT ALL THE FRIENDS I NEED!"
msgstr "J'AI TOUS LES AMIS QU'IL ME FAUT !"

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-4/23/0/s/0
msgctxt "Choix"
msgid "We both know you have zero friends."
msgstr "On sait très bien que t'as zéro ami."

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-4/23/1/s/0
msgctxt "Choix"
msgid "If you say so."
msgstr "Si tu le dis."

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-4/23/c-0/7
msgctxt "Tina"
msgid "WHADDAYA MEAN I DON'T GOT FRIENDS!"
msgstr "COMMENT ÇA J'AI PAS D'AMIS !"

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-4/23/c-0/15/0/s/0
msgctxt "Choix"
msgid "All you do is watch tv and write in your diary! You have no one to talk to!"
msgstr "Tu fais que regarder la télé et écrire dans ton journal intime ! T'as personne à qui parler !"

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-4/23/c-0/15/c-0/7
msgctxt "Tina"
msgid "YOU AIN'T GOT NO PROOF OF THAT! I TALK TO PEOPLE ALL DAY!"
msgstr "T'AS AUCUNE PREUVE DE ÇA ! JE PARLE À DES GENS TOUTE LA JOURNÉE !"

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-4/23/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "I'M LITERALLY THE ONLY PERSON IN THIS HOUSE!"
msgstr "JE SUIS LITTÉRALEMENT LA SEULE PERSONNE DANS CETTE MAISON !"

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-4/23/c-0/15/c-0/15/c-0/7
msgctxt "Tina"
msgid "Ha Ha ha ha ha!"
msgstr "Ha Ha ha ha ha !"

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-4/23/c-0/15/c-0/15/c-0/15
msgctxt "Tina"
msgid "And that's what I'm talkin' about! That's friendship, right there."
msgstr "Et voilà de quoi je parle ! Ça, c'est de l'amitié."

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-4/23/c-0/15/c-0/15/c-0/23
msgctxt "Tina"
msgid "Come by anytime, friendo."
msgstr "Passe quand tu veux, poussin."

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-4/23/c-1/7
msgctxt "Tina"
msgid "I DO SAY SO, DICKHEAD!"
msgstr "C'EST ÇA, TÊTE DE NŒUD !"

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-4/23/c-1/18 tina_triangle/diary_not_full_talk/0/g-0/1/c-4/23/c-1/57/c-0/18 tina_triangle/diary_not_full_talk/0/g-0/1/c-5/23/c-0/18/c-0/31/c-0/7
msgctxt "Tina"
msgid "LEAVE ME ALONE!"
msgstr "FICHE-MOI LA PAIX !"

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-4/23/c-1/57/0/s/0
msgctxt "Choix"
msgid "I'm sorry Tina..."
msgstr "Je suis {{désolé|désolée|désolé·e}}, Tina..."

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-4/23/c-1/57/c-0/7
msgctxt "Tina"
msgid "YOU ARE SORRY! THE SORRIEST LOSER I EVER LAID EYES ON!"
msgstr "TU ES DÉSOLANT ! LE SPÉCIMEN LE PLUS PITOYABLE QUE J'AIE JAMAIS VU !"

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-5/7
msgctxt "Tina"
msgid "Wait you... you actually don't like me?"
msgstr "Attends, tu... tu m'aimes vraiment pas ?"

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-5/15
msgctxt "Tina"
msgid "You weren't— you weren't playin' hard to get?"
msgstr "Tu... tu faisais pas la difficile ?"

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-5/23/0/s/0
msgctxt "Choix"
msgid "I was 100% serious, yeah."
msgstr "C'était 100 % sérieux, ouais."

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-5/23/c-0/7
msgctxt "Tina"
msgid "...oh. Okay."
msgstr "...oh. Okay."

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-5/23/c-0/18/0/s/0
msgctxt "Choix"
msgid "Can we just be friends?"
msgstr "On peut juste être {{amis|amies|ami·es}} ?"

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-5/23/c-0/18/c-0/7
msgctxt "Tina"
msgid "No... no."
msgstr "Non... non."

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-5/23/c-0/18/c-0/15
msgctxt "Tina"
msgid "I don't need a friend like you."
msgstr "J'ai pas besoin d'{{un ami|une amie|un·e ami·e}} comme toi."

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-5/23/c-0/18/c-0/23
msgctxt "Tina"
msgid "A STUPID SQUARE WHO COULDN'T HANDLE ALL THE TRIANGLE THAT I AM!"
msgstr "{{UN STUPIDE CARRÉ|UNE STUPIDE CARRÉE|UN·E STUPIDE CARRÉ·E}} QUI A PAS SU GÉRER TOUT LE TRIANGLE QUE JE SUIS !"

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-5/23/c-0/18/c-0/31/0/s/0 tina_triangle/tina_hate_parade/0/g-0/29/s/0
msgctxt "Choix"
msgid "Tina..."
msgstr "Tina..."

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-6/7
msgctxt "Tina"
msgid "YEAH GO! JUST WALK AWAY, LOSER!"
msgstr "OUAIS VAS-Y ! PARS, C'EST ÇA, MINABLE !"

# Traduction IA – à relire
#: tina_triangle/diary_not_full_talk/0/g-0/1/c-6/15
msgctxt "Tina"
msgid "I DON'T NEED YA! I NEVER NEEDED YOU!"
msgstr "J'AI PAS BESOIN DE TOI ! J'AI JAMAIS EU BESOIN DE TOI !"

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/3
msgctxt "Narrator"
msgid "Tina is standing there with a smirk on her face."
msgstr "Tina est plantée là avec un sourire en coin."

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/11/b/1
msgctxt "Narrator"
msgid "It's clear that she knows you've read her full diary, and her mind has been made up about you."
msgstr "Il est clair qu'elle sait que vous avez lu son journal intime en entier, et que son opinion sur vous est faite."

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/12/b/1
msgctxt "Narrator"
msgid "It's clear that she knows you've wussed out on reading her entire diary, and her mind has been made up about you."
msgstr "Il est clair qu'elle sait que vous avez flanché et pas lu son journal intime en entier, et que son opinion sur vous est faite."

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/15
msgctxt "Tina"
msgid "Heh heh heh."
msgstr "Hé hé hé."

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/23/s/0 tina_triangle/tina_relationship_quest/0/19/s/0 tina_triangle/tina_dump/0/15/s/0
msgctxt "Choix"
msgid "Hey Tina."
msgstr "Salut Tina."

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/c-0/7
msgctxt "Tina"
msgid "Well well well!"
msgstr "Eh ben eh ben eh ben !"

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/c-0/15
msgctxt "Tina"
msgid "If it ain't the weirdo who just can't stop talkin' to me!"
msgstr "Tiens, si c'est pas ce phénomène qui peut pas s'arrêter de me parler !"

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/c-0/23/0/s/0
msgctxt "Choix"
msgid "I don't get it. Do you like me or not?"
msgstr "Je comprends pas. Tu m'aimes bien ou pas ?"

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/c-0/23/1/s/0
msgctxt "Choix"
msgid "You're the one who keeps talking to me."
msgstr "C'est toi qui arrêtes pas de me parler."

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/c-0/23/2/s/0
msgctxt "Choix"
msgid "What are we exactly?"
msgstr "On est quoi, exactement ?"

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/c-0/23/c-0/7
msgctxt "Tina"
msgid "OBVIOUSLY I like you, loser!"
msgstr "ÉVIDEMMENT que je t'aime bien, minable !"

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/c-0/23/c-0/18
msgctxt "Tina"
msgid "Just because I ain't on a romantic-type level don't mean I don't like ya!"
msgstr "C'est pas parce que c'est pas de l'amour amoureux que je t'aime pas !"

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/c-0/23/c-0/26
msgctxt "Tina"
msgid "You're just gonna have to live with being hopelessly in love with me, though."
msgstr "Tu vas juste devoir vivre avec ton amour désespéré pour moi, par contre."

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/c-0/23/c-0/34/0/s/0
msgctxt "Choix"
msgid "I'm not, though..."
msgstr "Je le suis pas, pourtant..."

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/c-0/23/c-0/34/1/s/0
msgctxt "Choix"
msgid "I really do love you, Tina."
msgstr "Je t'aime vraiment, Tina."

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/c-0/23/c-0/34/2/s/0
msgctxt "Choix"
msgid "I'll just have to carry on, somehow..."
msgstr "Il faudra que je continue, d'une façon ou d'une autre..."

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/c-0/23/c-0/34/c-0/7
msgctxt "Tina"
msgid "Uh huh. Sure you ain't."
msgstr "Ouais ouais. Tu l'es pas, c'est ça."

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/c-0/23/c-0/34/c-0/15
msgctxt "Tina"
msgid "I totally believe ya. Really!"
msgstr "Je te crois complètement. Vraiment !"

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/c-0/23/c-0/34/c-1/7
msgctxt "Tina"
msgid "Aww, of course you do."
msgstr "Aww, bien sûr que si."

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/c-0/23/c-0/34/c-1/15
msgctxt "Tina"
msgid "That's YOUR goddamn problem, though. Not mine!"
msgstr "C'est TON putain de problème, par contre. Pas le mien !"

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/c-0/23/c-0/34/c-2/7
msgctxt "Tina"
msgid "Yeah, yeah. Not my problem."
msgstr "Ouais, ouais. C'est pas mon problème."

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/c-0/23/c-0/34/c-2/15
msgctxt "Tina"
msgid "Do your carryin' on somewhere else."
msgstr "Va continuer ailleurs."

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/c-0/23/c-0/34/c-2/23
msgctxt "Tina"
msgid "But you can still hang out with me. You might be a weirdo but I like ya just fine."
msgstr "Mais tu peux quand même traîner avec moi. T'es peut-être un phénomène mais je t'aime bien."

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/c-0/23/c-1/7
msgctxt "Tina"
msgid "What? I am NOT!"
msgstr "Quoi ? C'est PAS vrai !"

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/c-0/23/c-1/15
msgctxt "Tina"
msgid "YOU'RE the one who keeps comin' around ME!"
msgstr "C'est TOI qui arrêtes pas de venir me voir, MOI !"

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/c-0/23/c-1/26
msgctxt "Tina"
msgid "And sure, hey! I like ya just fine! You're good for a laugh."
msgstr "Et bien sûr, hé ! Je t'aime bien ! Tu me fais bien rire."

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/c-0/23/c-1/34
msgctxt "Tina"
msgid "Just don't go gettin' no ideas about what this is."
msgstr "Va juste pas te faire des idées sur ce que c'est."

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/c-0/23/c-2/7
msgctxt "Tina"
msgid "We're friends, dummy!"
msgstr "On est amis, andouille !"

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/c-0/23/c-2/15
msgctxt "Tina"
msgid "You ain't exactly enough for me to date, but you're good for a laugh."
msgstr "T'es pas franchement assez pour que je sorte avec toi, mais tu me fais bien rire."

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/c-0/23/c-2/23
msgctxt "Tina"
msgid "And you know how hard I rule, which is like... harder'n you'd think to find in this dump."
msgstr "Et tu sais à quel point je déchire, ce qui est genre... plus dur à trouver que tu crois dans ce trou à rats."

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/c-0/23/g-0/0
msgctxt "Tina"
msgid "It's a real shame you couldn't help me in my quest for love... but lucky you."
msgstr "C'est vraiment dommage que tu aies pas pu m'aider dans ma quête de l'amour... mais t'as de la chance."

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/c-0/23/g-0/8
msgctxt "Tina"
msgid "You get a front row seat to the Tina show. You can watch me find love with someone who ain't you."
msgstr "T'as une place au premier rang pour le Tina show. Tu peux me regarder trouver l'amour avec quelqu'un d'autre que toi."

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/c-0/23/g-0/16/0/s/0
msgctxt "Choix"
msgid "Wow... I truly am lucky."
msgstr "Wow... j'ai vraiment de la chance."

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/c-0/23/g-0/16/1/s/0
msgctxt "Choix"
msgid "Can't wait."
msgstr "J'ai hâte."

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/c-0/23/g-0/16/2/s/0
msgctxt "Choix"
msgid "You're a lost cause, Tina."
msgstr "T'es une cause perdue, Tina."

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/c-0/23/g-0/16/g-0/0
msgctxt "Tina"
msgid "Alright that's enough outta you. Love on Triangle Island is on in ten."
msgstr "Bon, ça suffit. L'Amour sur l'Île du Triangle commence dans dix minutes."

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/c-0/23/g-0/16/g-0/8
msgctxt "Tina"
msgid "You can watch with me if ya want."
msgstr "Tu peux regarder avec moi si tu veux."

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/c-0/23/g-0/16/g-0/16/1/s/0
msgctxt "Choix"
msgid "Let's do it."
msgstr "Allons-y."

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/c-0/23/g-0/16/g-0/16/c-0/7
msgctxt "Tina"
msgid "Whatever, I didn't want you to come anyway. Bye loser!"
msgstr "Peu importe, je voulais pas que tu viennes de toute façon. Salut, minable !"

# Traduction IA – à relire
#: tina_triangle/tina_friendzone/0/c-0/23/g-0/16/g-0/16/c-1/7
msgctxt "Tina"
msgid "Hell yeah."
msgstr "Et comment."

# Traduction IA – à relire
#: tina_triangle/tina_hate_parade/0/3
msgctxt "Tina"
msgid "Ohhh look who it is!"
msgstr "Ohhh regardez qui voilà !"

# Traduction IA – à relire
#: tina_triangle/tina_hate_parade/0/11
msgctxt "Tina"
msgid "The biggest loser in the house here to ruin everything like always!"
msgstr "Le plus gros minable de la maison, venu tout gâcher comme d'habitude !"

# Traduction IA – à relire
#: tina_triangle/tina_hate_parade/0/19/s/0
msgctxt "Choix"
msgid "Are you talking to me?"
msgstr "C'est à moi que tu parles ?"

# Traduction IA – à relire
#: tina_triangle/tina_hate_parade/0/20/s/0
msgctxt "Choix"
msgid "Doing your morning affirmations, Tina?"
msgstr "Tu fais tes affirmations positives du matin, Tina ?"

# Traduction IA – à relire
#: tina_triangle/tina_hate_parade/0/21/s/0
msgctxt "Choix"
msgid "I know YOU aren't calling ME a loser."
msgstr "Je sais que TOI tu m'traites pas de minable, MOI."

# Traduction IA – à relire
#: tina_triangle/tina_hate_parade/0/c-0/7
msgctxt "Tina"
msgid "You see any other losers here!?"
msgstr "Tu vois d'autres minables ici !?"

# Traduction IA – à relire
#: tina_triangle/tina_hate_parade/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "Do you actually want me to answer that?"
msgstr "Tu veux vraiment que je réponde à ça ?"

# Traduction IA – à relire
#: tina_triangle/tina_hate_parade/0/c-0/15/1/s/0
msgctxt "Choix"
msgid "I'm looking at one as we speak, so..."
msgstr "J'en regarde un en ce moment même, alors..."

# Traduction IA – à relire
#: tina_triangle/tina_hate_parade/0/c-0/15/c-0/7
msgctxt "Tina"
msgid "NO I DON'T! I DON'T WANNA HEAR SHIT FROM YOU!"
msgstr "NON, J'VEUX PAS ! J'VEUX RIEN ENTENDRE DE TOI !"

# Traduction IA – à relire
#: tina_triangle/tina_hate_parade/0/c-0/15/c-0/18
msgctxt "Tina"
msgid "YOU AIN'T NEVER SAID A SINGLE WORTHWHILE THING TO ME! YOU CAN KEEP IT!"
msgstr "TU M'AS JAMAIS DIT UNE SEULE CHOSE QUI VAUT LE COUP ! GARDE-LES POUR TOI !"

# Traduction IA – à relire
#: tina_triangle/tina_hate_parade/0/c-0/15/c-1/7
msgctxt "Tina"
msgid "HOW DARE YOU!"
msgstr "NON MAIS OSE !"

# Traduction IA – à relire
#: tina_triangle/tina_hate_parade/0/c-1/7
msgctxt "Tina"
msgid "OOOH, you think you're so goddamn CLEVER dontcha!"
msgstr "OOOH, tu te crois super {{FUTÉ|FUTÉE|FUTÉ·E}}, hein !"

# Traduction IA – à relire
#: tina_triangle/tina_hate_parade/0/c-2/7
msgctxt "Tina"
msgid "I AM AND I DID, BABY!"
msgstr "JE LE SUIS ET JE L'AI FAIT, BÉBÉ !"

# Traduction IA – à relire
#: tina_triangle/tina_hate_parade/0/g-0/0
msgctxt "Tina"
msgid "I never met anybody who sucks as bad as you, and nothin' you got to say is gonna change that!"
msgstr "J'ai jamais rencontré personne d'aussi nul que toi, et rien de ce que t'as à dire va changer ça !"

# Traduction IA – à relire
#: tina_triangle/tina_hate_parade/0/g-0/8
msgctxt "Tina"
msgid "So scram and stay scrammed, square!"
msgstr "Alors dégage et reste dégagé, carré !"

# Traduction IA – à relire
#: tina_triangle/tina_hate_parade/0/g-0/19
msgctxt "Tina"
msgid "Beat it!"
msgstr "Fous le camp !"

# Traduction IA – à relire
#: tina_triangle/tina_hate_parade/0/g-0/27/s/0
msgctxt "Choix"
msgid "I'm leaving, but not because you told me to."
msgstr "Je pars, mais pas parce que tu me l'as dit."

# Traduction IA – à relire
#: tina_triangle/tina_hate_parade/0/g-0/28/s/0
msgctxt "Choix"
msgid "Bye I guess."
msgstr "Salut, je suppose."

# Traduction IA – à relire
#: tina_triangle/tina_hate_parade/0/g-0/c-3/7
msgctxt "Tina"
msgid "JUST GO!"
msgstr "VA-T'EN !"

# Traduction IA – à relire
#: tina_triangle/tina_hate_parade/0/g-0/c-4/7
msgctxt "Tina"
msgid "BYE LOSER!"
msgstr "SALUT, MINABLE !"

# Traduction IA – à relire
#: tina_triangle/tina_hate_parade/0/g-0/c-5/7
msgctxt "Tina"
msgid "I SAID BEAT IT!"
msgstr "J'AI DIT FOUS LE CAMP !"

# Traduction IA – à relire
#: tina_triangle/tina_relationship_quest/0/c-0/7
msgctxt "Tina"
msgid "Huh? Oh. Hey."
msgstr "Hein ? Oh. Salut."

# Traduction IA – à relire
#: tina_triangle/tina_relationship_quest/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "What, no kiss?"
msgstr "Quoi, pas de bisou ?"

# Traduction IA – à relire
#: tina_triangle/tina_relationship_quest/0/c-0/15/1/s/0
msgctxt "Choix"
msgid "Are you upset?"
msgstr "T'es contrariée ?"

# Traduction IA – à relire
#: tina_triangle/tina_relationship_quest/0/c-0/15/2/s/0
msgctxt "Choix"
msgid "Are we breaking up already?"
msgstr "On rompt déjà ?"

# Traduction IA – à relire
#: tina_triangle/tina_relationship_quest/0/c-0/15/c-0/7
msgctxt "Tina"
msgid "Eww, no."
msgstr "Beurk, non."

# Traduction IA – à relire
#: tina_triangle/tina_relationship_quest/0/c-0/15/c-0/15
msgctxt "Tina"
msgid "Cantcha see I'm upset?"
msgstr "Tu vois pas que je suis contrariée ?"

# Traduction IA – à relire
#: tina_triangle/tina_relationship_quest/0/c-0/15/c-1/7
msgctxt "Tina"
msgid "Yes, god! Ain't it obvious?"
msgstr "Oui, mon Dieu ! C'est pas évident ?"

# Traduction IA – à relire
#: tina_triangle/tina_relationship_quest/0/c-0/15/c-2/7
msgctxt "Tina"
msgid "What? Look, just listen."
msgstr "Quoi ? Écoute, juste écoute."

# Traduction IA – à relire
#: tina_triangle/tina_relationship_quest/0/c-0/15/g-0/0
msgctxt "Tina"
msgid "Look. What we did last time..."
