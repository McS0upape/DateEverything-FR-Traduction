# Traduction IA – à relire
#: tina_triangle/1
msgctxt "Tag Nom d'objet (MAJUSCULES)"
msgid "TRIANGLE"
msgstr "TRIANGLE"

# Traduction IA – à relire
#: tina_triangle/stepford_tina/0/7
msgctxt "Tina"
msgid "You got that look on your face like you're about to ask me some dumb questions..."
msgstr "T'as cette tête de quelqu'un qui va me poser des questions à la con..."

# Traduction IA – à relire
#: tina_triangle/stepford_tina/0/15
msgctxt "Tina"
msgid "Whatever you got, MAKE IT QUICK!"
msgstr "Quoi que t'aies à dire, DÉPÊCHE-TOI !"

# Traduction IA – à relire
#: tina_triangle/stepford_tina/0/23/b/1
msgctxt "Tony"
msgid "Yo, what's all the racket over here?"
msgstr "Yo, c'est quoi tout ce raffut par ici ?"

# Traduction IA – à relire
#: tina_triangle/stepford_tina/0/23/b/9
msgctxt "Tina"
msgid "NONE OF YOUR BUSINESS!"
msgstr "ÇA NE TE REGARDE PAS !"

# Traduction IA – à relire
#: tina_triangle/stepford_tina/0/23/b/20
msgctxt "Tony"
msgid "Oh hey, it's you! How you doin'?"
msgstr "Oh salut, c'est toi ! Comment ça va ?"

# Traduction IA – à relire
#: tina_triangle/stepford_tina/0/23/b/28
msgctxt "Tina"
msgid "They're here to ask <i>ME</i> STUPID QUESTIONS! NOT YOU!"
msgstr "Ils sont là pour poser leurs QUESTIONS STUPIDES à <i>MOI</i> ! PAS À TOI !"

# Traduction IA – à relire
#: tina_triangle/stepford_tina/0/23/b/39
msgctxt "Tony"
msgid "Yeah? That's real cute."
msgstr "Ouais ? C'est mignon, ça."

# Traduction IA – à relire
#: tina_triangle/stepford_tina/0/23/b/47
msgctxt "Tina"
msgid "TONY!"
msgstr "TONY !"

# Traduction IA – à relire
#: tina_triangle/stepford_tina/0/23/b/55
msgctxt "Tony"
msgid "Guess that's my cue... but look."
msgstr "Je crois que c'est mon signal... mais écoute."

# Traduction IA – à relire
#: tina_triangle/stepford_tina/0/23/b/63
msgctxt "Tony"
msgid "Don't be a stranger, alright?"
msgstr "Reste pas un étranger, d'accord ?"

# Traduction IA – à relire
#: tina_triangle/stepford_tina/0/23/b/71
msgctxt "Tina"
msgid "GOOOOO! GOD!"
msgstr "ALLEZ-VOUS-EN ! MON DIEU !"

# Traduction IA – à relire
#: tina_triangle/stepford_tina/0/23/b/85
msgctxt "Tina"
msgid "Finally... back to me."
msgstr "Enfin... on revient à moi."

# Traduction IA – à relire
#: tina_triangle/stepford_tina/0/26/s/0
msgctxt "Choix"
msgid "I'm actually here to find out a fact about triangles."
msgstr "En fait, je suis là pour découvrir un fait sur les triangles."

# Traduction IA – à relire
#: tina_triangle/stepford_tina/0/c-0/7
msgctxt "Tina"
msgid "Facts? Like we're the hottest and strongest shape in nature?"
msgstr "Des faits ? Genre qu'on est la forme la plus canon et la plus solide de la nature ?"

# Traduction IA – à relire
#: tina_triangle/stepford_tina/0/c-0/15
msgctxt "Tina"
msgid "But even a dweeb like you probably already knew that. So here, check this shit out."
msgstr "Mais même un intello dans ton genre devait déjà le savoir. Alors tiens, écoute-moi ça, putain."

# Traduction IA – à relire
#: tina_triangle/stepford_tina/0/c-0/23
msgctxt "Tina"
msgid "There's a gap in a musical triangle, right? It ain't completely closed off."
msgstr "Y'a un trou dans un triangle de musique, hein ? Il est pas complètement fermé."

# Traduction IA – à relire
#: tina_triangle/stepford_tina/0/c-0/31/0/s/0
msgctxt "Choix"
msgid "Sure."
msgstr "Si tu le dis."

# Traduction IA – à relire
#: tina_triangle/stepford_tina/0/c-0/31/1/s/0
msgctxt "Choix"
msgid "Is that the fact?"
msgstr "C'est ça, le fait ?"

# Traduction IA – à relire
#: tina_triangle/stepford_tina/0/c-0/31/c-1/7
msgctxt "Tina"
msgid "No, dummy! Let me finish!"
msgstr "Non, andouille ! Laisse-moi finir !"

# Traduction IA – à relire
#: tina_triangle/stepford_tina/0/g-0/0
msgctxt "Tina"
msgid "It's like that so the triangle won't make just one definite pitch."
msgstr "C'est comme ça pour que le triangle fasse pas juste une seule hauteur de note bien définie."

# Traduction IA – à relire
#: tina_triangle/stepford_tina/0/g-0/8
msgctxt "Tina"
msgid "It lets 'em have overtones."
msgstr "Ça lui permet d'avoir des harmoniques."

# Traduction IA – à relire
#: tina_triangle/stepford_tina/0/g-0/16/s/0
msgctxt "Choix"
msgid "Cool!"
msgstr "Cool !"

# Traduction IA – à relire
#: tina_triangle/stepford_tina/0/g-0/17/s/0
msgctxt "Choix"
msgid "Makes sense, I guess."
msgstr "Ça se tient, je suppose."

# Traduction IA – à relire
#: tina_triangle/stepford_tina/0/g-0/c-2/7
msgctxt "Tina"
msgid "Yeah it does... that's why I said it!"
msgstr "Ouais, ça se tient... c'est pour ça que je l'ai dit !"

# Traduction IA – à relire
#: tina_triangle/stepford_tina/0/g-1/0
msgctxt "Tina"
msgid "So now that you know all that..."
msgstr "Alors maintenant que tu sais tout ça..."

# Traduction IA – à relire
#: tina_triangle/stepford_tina/0/g-1/8
msgctxt "Tina"
msgid "Wanna hear my overtones?"
msgstr "Tu veux entendre mes harmoniques ?"

# Traduction IA – à relire
#: tina_triangle/stepford_tina/0/g-1/16/s/0
msgctxt "Choix"
msgid "Sure, Tina."
msgstr "Carrément, Tina."

# Traduction IA – à relire
#: tina_triangle/stepford_tina/0/g-1/17/s/0
msgctxt "Choix"
msgid "What even is an overtone?"
msgstr "C'est quoi, une harmonique, au juste ?"

# Traduction IA – à relire
#: tina_triangle/stepford_tina/0/g-1/18/s/0 tina_triangle/tina_friendzone/0/c-0/23/g-0/16/g-0/16/0/s/0
msgctxt "Choix"
msgid "No thanks."
msgstr "Non merci."

# Traduction IA – à relire
#: tina_triangle/stepford_tina/0/g-2/0
msgctxt "Tina"
msgid "HAHAHA! THE LOOK ON YOUR FACE!"
msgstr "HAHAHA ! TA TÊTE !"

# Traduction IA – à relire
#: tina_triangle/stepford_tina/0/g-2/11
msgctxt "Tina"
msgid "You really thought I was gonna let you hear it oh my god..."
msgstr "T'as vraiment cru que j'allais te laisser les entendre, oh mon Dieu..."

# Traduction IA – à relire
#: tina_triangle/stepford_tina/0/g-2/22
msgctxt "Tina"
msgid "God, you are too cute."
msgstr "Mon Dieu, t'es à croquer."

# Traduction IA – à relire
#: tina_triangle/stepford_tina/0/g-2/30
msgctxt "Tina"
msgid "Now, <w>GET THE FUCK OUTTA HERE AND LEMME WATCH MY SHIT!</w>"
msgstr "Maintenant, <w>DÉGAGE D'ICI ET LAISSE-MOI REGARDER MES FEUILLETONS !</w>"

# Traduction IA – à relire
#: tina_triangle/skylar_tina_content/0/3
msgctxt "Skylar"
msgid "Woah there! My Content Aware has given me a tickle!"
msgstr "Houlà ! Mon Alerte Contenu vient de me chatouiller !"

# Traduction IA – à relire
#: tina_triangle/skylar_tina_content/0/11
msgctxt "Skylar"
msgid "Tina here has a very, let's say, forceful personality."
msgstr "Tina que voilà a une personnalité très, disons, autoritaire."

# Traduction IA – à relire
#: tina_triangle/skylar_tina_content/0/22
msgctxt "Skylar"
msgid "It could be seen as that of an abuser that's taken in a humorous way."
msgstr "On pourrait y voir celle d'un tyran domestique, pris sur le ton de l'humour."

# Traduction IA – à relire
#: tina_triangle/skylar_tina_content/0/30
msgctxt "Skylar"
msgid "If dealing with that kind of behavior in a light way is disagreeable, I wouldn't recommend this one, that's for sure."
msgstr "Si traiter ce genre de comportement avec légèreté te met mal à l'aise, je ne te la recommande pas, ça c'est sûr."

# Traduction IA – à relire
#: tina_triangle/skylar_tina_content/0/38
msgctxt "Skylar"
msgid "You cool with that? Or you want to skip it?"
msgstr "Ça te va comme ça ? Ou tu préfères passer ?"

# Traduction IA – à relire
#: tina_triangle/skylar_tina_content/0/46/s/0
msgctxt "Choix"
msgid "Let's skip this please!"
msgstr "Passons, s'il te plaît !"

# Traduction IA – à relire
#: tina_triangle/skylar_tina_content/0/47/s/0
msgctxt "Choix"
msgid "No, I'm okay with this type of stuff."
msgstr "Non, ce genre de truc ne me dérange pas."

# Traduction IA – à relire
#: tina_triangle/skylar_tina_content/0/c-0/33
msgctxt "Skylar"
msgid "No worries - Tina, c'mere a second."
msgstr "Pas de souci. Tina, viens une seconde."

# Traduction IA – à relire
#: tina_triangle/skylar_tina_content/0/c-0/41
msgctxt "Tina"
msgid "Yeah?"
msgstr "Ouais ?"

# Traduction IA – à relire
#: tina_triangle/skylar_tina_content/0/c-0/49
msgctxt "Narrator"
msgid "How would you like your relationship with Tina to resolve?"
msgstr "Comment souhaiteriez-vous que votre relation avec Tina se termine ?"

# Traduction IA – à relire
#: tina_triangle/skylar_tina_content/0/c-0/57/0/s/0
msgctxt "Choix"
msgid "Love!"
msgstr "L'amour !"

# Traduction IA – à relire
#: tina_triangle/skylar_tina_content/0/c-0/57/1/s/0
msgctxt "Choix"
msgid "Friendship!"
msgstr "L'amitié !"

# Traduction IA – à relire
#: tina_triangle/skylar_tina_content/0/c-0/57/2/s/0
msgctxt "Choix"
msgid "Hate!"
msgstr "La haine !"

# Traduction IA – à relire
#: tina_triangle/skylar_tina_content/0/c-0/57/c-0/7
msgctxt "Narrator"
msgid "Tina looks you up and down, and with a careless glare surmises that you'll do. This is love."
msgstr "Tina vous toise de haut en bas et, d'un regard distrait, conclut que vous ferez l'affaire. C'est l'amour."

# Traduction IA – à relire
#: tina_triangle/skylar_tina_content/0/c-0/57/c-0/15
msgctxt "Skylar"
msgid "It's love!"
msgstr "C'est l'amour !"

# Traduction IA – à relire
#: tina_triangle/skylar_tina_content/0/c-0/57/c-0/35 tina_triangle/skylar_tina_content/0/c-0/57/c-1/51 tina_triangle/skylar_tina_content/0/c-0/57/c-2/41
msgctxt "Skylar"
msgid "See you out there on the next one!"
msgstr "On se retrouve pour la prochaine !"

# Traduction IA – à relire
#: tina_triangle/skylar_tina_content/0/c-0/57/c-1/7
msgctxt "Skylar"
msgid "What say the two of you just be friends, huh?"
msgstr "Et si vous deux, vous restiez juste amis, hein ?"

# Traduction IA – à relire
#: tina_triangle/skylar_tina_content/0/c-0/57/c-1/15
msgctxt "Tina"
msgid "Fine with me - as long as they let me watch my stories!"
msgstr "Ça me va, tant qu'ils me laissent regarder mes feuilletons !"

# Traduction IA – à relire
#: tina_triangle/skylar_tina_content/0/c-0/57/c-1/23
msgctxt "Narrator"
msgid "Tina has given you a stamp of friendship, probably the least dangerous option you had."
msgstr "Tina vous a accordé un tampon d'amitié, probablement l'option la moins dangereuse qui s'offrait à vous."

# Traduction IA – à relire
#: tina_triangle/skylar_tina_content/0/c-0/57/c-1/31
msgctxt "Skylar"
msgid "Aww... friends forever."
msgstr "Aww... amis pour la vie."

# Traduction IA – à relire
#: tina_triangle/skylar_tina_content/0/c-0/57/c-2/7
msgctxt "Narrator"
msgid "Tina's purse lands on your head, and her gaze looks daggers into your heart. You are enemies!"
msgstr "Le sac à main de Tina atterrit sur votre tête, et son regard vous poignarde en plein cœur. Vous êtes ennemis !"

# Traduction IA – à relire
#: tina_triangle/skylar_tina_content/0/c-0/57/c-2/15
msgctxt "Skylar"
msgid "Enjoy your... hateship."
msgstr "Profitez de votre... haimitié."

# Traduction IA – à relire
#: tina_triangle/skylar_tina_content/0/c-0/57/c-2/74 tina_triangle/tina_hate_sorter/19
msgctxt "Reggie"
msgid "Ah you didn't like the drama mama? I love it when it gets fiery..."
msgstr "Ah, t'as pas aimé le drame, mama ? Moi j'adore quand ça s'enflamme..."

# Traduction IA – à relire
#: tina_triangle/skylar_tina_content/0/c-0/57/c-2/82 tina_triangle/tina_hate_sorter/27
msgctxt "Reggie"
msgid "Dancing on that knife's edge of hatred all the time..."
msgstr "Danser sur le fil du rasoir de la haine en permanence..."

# Traduction IA – à relire
#: tina_triangle/skylar_tina_content/0/c-0/57/c-2/90 tina_triangle/tina_hate_sorter/35
msgctxt "Reggie"
msgid "Too bad for you ya fell off."
msgstr "Dommage pour toi, t'as plongé."

# Traduction IA – à relire
#: tina_triangle/skylar_tina_content/0/c-1/7
msgctxt "Skylar"
msgid "On with the show!"
msgstr "Que le spectacle continue !"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/9
msgctxt "Narrator"
msgid "An angular beauty sits in contemplative silence, her head resting on one hand. She doesn't greet you even when you stand directly in front of her—in fact, she doesn't even look at you."
msgstr "Une beauté anguleuse est assise dans un silence contemplatif, la tête posée sur une main. Elle ne vous salue pas même quand vous vous plantez juste devant elle. En fait, elle ne vous regarde même pas."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/17
msgctxt "Tina"
msgid "Mmm..."
msgstr "Mmm..."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/33
msgctxt "Tina"
msgid "...ohhhh..."
msgstr "...ohhhh..."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/41/s/0
msgctxt "Choix"
msgid "Hey there."
msgstr "Salut, toi."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/42/s/0
msgctxt "Choix"
msgid "Uh... hello?"
msgstr "Euh... bonjour ?"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/c-0/7
msgctxt "Tina"
msgid "Ohh..."
msgstr "Ohh..."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/c-1/7
msgctxt "Tina"
msgid "Shhhh!"
msgstr "Chhhut !"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-0/0
msgctxt "Tina"
msgid "You're disturbin' my thoughts!"
msgstr "Tu perturbes mes pensées !"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-0/11/s/0
msgctxt "Choix"
msgid "My bad."
msgstr "Pardon."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-0/12/s/0
msgctxt "Choix"
msgid "What's important enough for you to be so rude?"
msgstr "C'est quoi d'assez important pour que tu sois aussi grossière ?"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-0/13/s/0
msgctxt "Choix"
msgid "You're too pretty to think."
msgstr "T'es trop belle pour réfléchir."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-0/c-2/13
msgctxt "Tina"
msgid "Your bad? Seriously?"
msgstr "Pardon ? Sérieux ?"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-0/c-2/21
msgctxt "Tina"
msgid "God, you're so boring."
msgstr "Mon Dieu, tu me fatigues tellement."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-0/c-3/13
msgctxt "Tina"
msgid "GOD! You really can't just let me have a minute?!"
msgstr "MON DIEU ! Tu peux vraiment pas me laisser une minute ?!"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-0/c-3/24
msgctxt "Tina"
msgid "...argh!"
msgstr "...argh !"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-0/c-4/13
msgctxt "Tina"
msgid "...wow. You really know just how to speak to a triangle, huh?"
msgstr "...wow. Tu sais vraiment comment parler à un triangle, hein ?"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-0/c-4/21
msgctxt "Tina"
msgid "Whew. Anyway..."
msgstr "Pfiou. Bref..."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-1/0
msgctxt "Tina"
msgid "Well that's it, my fantasy bubble's officially burst."
msgstr "Eh ben voilà, ma bulle de fantasme vient officiellement d'éclater."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-1/11
msgctxt "Tina"
msgid "Name's Tina. Tina Triangle."
msgstr "Je m'appelle Tina. Tina Triangle."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-1/28/0
msgctxt "Tina"
msgid "And before you got here I was having a nice little fantasy."
msgstr "Et avant que t'arrives, j'étais en train de me faire un petit fantasme tranquille."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-1/28/8/s/0
msgctxt "Choix"
msgid "About who?"
msgstr "Sur qui ?"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-1/28/9/s/0
msgctxt "Choix"
msgid "About what?"
msgstr "Sur quoi ?"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-1/28/c-5/7
msgctxt "Tina"
msgid "Not who. What."
msgstr "Pas sur qui. Sur quoi."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-2/0
msgctxt "Narrator"
msgid "Tina forms a small triangle with her fingers."
msgstr "Tina forme un petit triangle avec ses doigts."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-2/8
msgctxt "Tina"
msgid "A love triangle. Greatest shape in the world, especially when it comes to love."
msgstr "Un triangle amoureux. La plus belle forme du monde, surtout en amour."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-2/16
msgctxt "Tina"
msgid "Matter 'a fact it's the ONLY shape I'm interested in."
msgstr "D'ailleurs c'est la SEULE forme qui m'intéresse."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-2/24/s/0
msgctxt "Choix"
msgid "Guess that explains the whole... triangle theme."
msgstr "Ça explique tout le... thème triangulaire."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-2/25/s/0
msgctxt "Choix"
msgid "Yes I see that."
msgstr "Oui, je vois ça."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-2/c-7/7
msgctxt "Tina"
msgid "Just look at me. Angles in ALL the right places."
msgstr "Regarde-moi. Des angles à TOUTES les bonnes places."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-2/c-7/15
msgctxt "Tina"
msgid "Who could resist?"
msgstr "Qui pourrait résister ?"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-2/c-7/23/0/s/0
msgctxt "Choix"
msgid "I know I can't."
msgstr "Moi, en tout cas, je peux pas."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-2/c-7/23/1/s/0
msgctxt "Choix"
msgid "Is that a rhetorical question or..."
msgstr "C'est une question rhétorique ou..."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-2/c-7/23/2/s/0
msgctxt "Choix"
msgid "Somebody must be if you're fantasizing."
msgstr "Quelqu'un doit bien y résister, si tu fantasmes."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-2/c-7/23/c-0/13
msgctxt "Tina"
msgid "'Course you can't. I'm ir-re-SIS-tible, honey!"
msgstr "Bien sûr que tu peux pas. Je suis ir-ré-SIS-tible, mon chou !"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-2/c-7/23/c-0/21
msgctxt "Tina"
msgid "Who could be strong in the face of all these angles?"
msgstr "Qui pourrait rester fort devant tous ces angles ?"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-2/c-7/23/c-1/13
msgctxt "Tina"
msgid "Ohh look at you with your big words. YAWN!"
msgstr "Oh, regardez-moi ça, avec ses grands mots. BÂILLEMENT !"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-2/c-7/23/c-1/21
msgctxt "Tina"
msgid "I'm all about action, honey. That ain't the way to get my attention."
msgstr "Moi, je suis une femme d'action, mon chou. C'est pas comme ça qu'on attire mon attention."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-2/c-7/23/c-2/13
msgctxt "Tina"
msgid "How DARE you!"
msgstr "Non mais OSE !"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-2/c-7/23/c-2/24
msgctxt "Tina"
msgid "I got PLENTY a' dates, thank you very much!"
msgstr "J'ai PLEIN de rancards, merci bien !"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-2/c-7/23/c-2/32
msgctxt "Tina"
msgid "I'm just INTENTIONALLY celibate. For my clarity 'n whatnot."
msgstr "Je suis juste CÉLIBATAIRE VOLONTAIRE. Pour ma clarté d'esprit et tout ça."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-2/c-8/7
msgctxt "Tina"
msgid "Oh yeah? You're smarter'n you look, cutie."
msgstr "Ah ouais ? T'es plus malin{{|e|·e}} que t'en as l'air, mon chou."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-3/0
msgctxt "Tina"
msgid "But enough about YOU."
msgstr "Mais assez parlé de TOI."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-3/8
msgctxt "Tina"
msgid "You ever watch Love on Triangle Island?"
msgstr "T'as déjà regardé L'Amour sur l'Île du Triangle ?"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-3/16/s/0
msgctxt "Choix"
msgid "Uh... no."
msgstr "Euh... non."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-3/17/s/0
msgctxt "Choix"
msgid "Never heard of it."
msgstr "Jamais entendu parler."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-3/18/s/0
msgctxt "Choix"
msgid "No but it sounds amazing."
msgstr "Non, mais ça a l'air génial."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-3/c-9/13
msgctxt "Tina"
msgid "Uh? What's with the disdain, poindexter?"
msgstr "Hein ? C'est quoi ce dédain, intello ?"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-3/c-9/21
msgctxt "Tina"
msgid "Let me guess, you're one of those people who doesn't own a TV."
msgstr "Laisse-moi deviner, t'es de ces gens qui n'ont pas de télé."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-3/c-9/29/0/s/0
msgctxt "Choix"
msgid "There's literally a TV right over there."
msgstr "Y'a littéralement une télé juste là."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-3/c-9/29/c-0/7
msgctxt "Tina"
msgid "DON'T TELL ME WHAT TO DO!"
msgstr "ME DIS PAS CE QUE JE DOIS FAIRE !"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-3/c-9/29/c-0/18/0/s/0
msgctxt "Choix"
msgid "Ok..."
msgstr "Ok..."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-3/c-9/29/c-0/18/c-0/7
msgctxt "Tina"
msgid "Look. Just hear me out, alright?"
msgstr "Écoute. Laisse-moi juste parler, d'accord ?"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-3/c-10/13
msgctxt "Tina"
msgid "Yeah? Well I never heard 'a YOU. How'd you like that?"
msgstr "Ouais ? Ben moi j'ai jamais entendu parler de TOI. Ça te plaît ?"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-3/c-10/21/0/s/0
msgctxt "Choix"
msgid "I like it fine I guess?"
msgstr "Ça me va, je suppose ?"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-3/c-10/21/c-0/7
msgctxt "Tina"
msgid "AUGH! Whatever!"
msgstr "AARGH ! Peu importe !"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-3/c-10/21/c-0/15
msgctxt "Tina"
msgid "Try and be open-minded for one damn second, alright?"
msgstr "Essaie d'avoir l'esprit ouvert une seule putain de seconde, d'accord ?"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-3/c-11/13
msgctxt "Tina"
msgid "Oh it is. It IS."
msgstr "Oh que oui. Oh que OUI."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/0
msgctxt "Tina"
msgid "Lemme paint the picture for ya."
msgstr "Je vais te planter le décor."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/11
msgctxt "Tina"
msgid "18 sexy singles get together on an island."
msgstr "18 célibataires sexy se retrouvent sur une île."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/19
msgctxt "Tina"
msgid "They gotta pair off into groups of three, and every week a love triangle gets voted off."
msgstr "Ils doivent se former en groupes de trois, et chaque semaine un triangle amoureux est éliminé par vote."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/27
msgctxt "Tina"
msgid "The last throuple to get voted off wins a million dollars, but THAT AIN'T ALL!"
msgstr "Le dernier trouple éliminé gagne un million de dollars, mais C'EST PAS TOUT !"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/35
msgctxt "Tina"
msgid "They offer 'em money and bring in their exes to try and break up the throuple."
msgstr "On leur offre de l'argent et on fait venir leurs ex pour essayer de briser le trouple."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/43
msgctxt "Tina"
msgid "It's all just so deliciously dramatic..."
msgstr "C'est tellement délicieusement dramatique..."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/51/s/0
msgctxt "Choix"
msgid "Is that what you were thinking about before I got here?"
msgstr "C'est à ça que tu pensais avant que j'arrive ?"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/52/s/0
msgctxt "Choix"
msgid "It sounds toxic as hell."
msgstr "Ça a l'air toxique à mort."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/53/s/0
msgctxt "Choix"
msgid "You should be on that show."
msgstr "Tu devrais être dans cette émission."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/c-12/13
msgctxt "Tina"
msgid "Yeah, before YOU interrupted me."
msgstr "Ouais, avant que TU m'interrompes."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/c-12/21
msgctxt "Tina"
msgid "But now I'm here thinkin' about you instead."
msgstr "Mais là je suis en train de penser à toi à la place."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/c-12/29
msgctxt "Tina"
msgid "Go on somewhere else now—my fantasy was just gettin' good and I'm tryna get back to it."
msgstr "Maintenant va voir ailleurs, mon fantasme commençait à devenir bien et j'essaie d'y retourner."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/c-12/37/0/s/0
msgctxt "Choix"
msgid "Alright... see you around, I guess."
msgstr "Bon... à plus, je suppose."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/c-12/37/c-0/7
msgctxt "Tina"
msgid "Maybe. BYE!"
msgstr "Peut-être. SALUT !"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/c-13/13
msgctxt "Tina"
msgid "Toxic? It's SEXY and FULFILLING is what it is."
msgstr "Toxique ? C'est SEXY et ÉPANOUISSANT, c'est ça que c'est."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/c-13/21
msgctxt "Tina"
msgid "Go play therapist somewhere else, square!"
msgstr "Va jouer au psy ailleurs, carré !"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/c-13/29/0/s/0
msgctxt "Choix"
msgid "Uh... catch you later I guess."
msgstr "Euh... à plus tard, je suppose."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/c-13/29/c-0/7
msgctxt "Tina"
msgid "In your DREAMS, maybe."
msgstr "Dans tes RÊVES, peut-être."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/c-14/13
msgctxt "Tina"
msgid "Ohhh my god, yeah! YEAH!"
msgstr "Ohhh mon Dieu, ouais ! OUAIS !"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/c-14/21
msgctxt "Tina"
msgid "Can't you just imagine me in a bikini, two nearly naked people fightin' over me on the beach..."
msgstr "Tu peux pas t'imaginer moi en bikini, deux mecs presque nus qui se battent pour moi sur la plage..."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/c-14/32
msgctxt "Tina"
msgid "Sand in places it shouldn't be... the sun settin' just so..."
msgstr "Du sable dans des endroits où il devrait pas être... le soleil qui se couche juste comme il faut..."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/c-14/40
msgctxt "Tina"
msgid "...too good to be true, ain't it?"
msgstr "...trop beau pour être vrai, hein ?"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/c-14/48/0/s/0
msgctxt "Choix"
msgid "It doesn't have to be."
msgstr "Ça n'a pas à l'être."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/c-14/48/1/s/0
msgctxt "Choix"
msgid "Yeah it totally is."
msgstr "Ouais, carrément."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/c-14/48/2/s/0
msgctxt "Choix"
msgid "Why are you asking me?"
msgstr "Pourquoi tu me demandes à moi ?"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/c-14/48/c-0/13
msgctxt "Tina"
msgid "...maybe you're right. I dunno."
msgstr "...t'as peut-être raison. Je sais pas."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/c-14/48/c-0/21
msgctxt "Tina"
msgid "Whatever! I've officially spent way too much time on this conversation."
msgstr "Peu importe ! J'ai officiellement passé beaucoup trop de temps sur cette conversation."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/c-14/48/c-0/29
msgctxt "Tina"
msgid "Lemme get back to my fantasy! It was just gettin' good."
msgstr "Laisse-moi retourner à mon fantasme ! Ça commençait à devenir bien."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/c-14/48/c-0/37
msgctxt "Tina"
msgid "Get outta here! Scram!"
msgstr "Dégage d'ici ! Ouste !"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/c-14/48/c-0/48
msgctxt "Tina"
msgid "...but see ya around or whatever."
msgstr "...mais à la prochaine ou quoi."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/c-14/48/c-0/59/0/s/0 tina_triangle/tina_second_encounter/0/g-3/c-11/15/0/s/0 tina_triangle/tina_love_return_3/0/c-0/18/c-0/15/c-0/26/0/s/0 tina_triangle/tina_love_return_3/0/c-0/18/c-0/15/c-1/50/0/s/0
msgctxt "Choix"
msgid "Okay..."
msgstr "D'accord..."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/c-14/48/c-1/13
msgctxt "Tina"
msgid "Hey, what the hell!"
msgstr "Hé, c'est quoi ce bordel !"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/c-14/48/c-1/21
msgctxt "Tina"
msgid "Just who do you think you are talkin' to me like that?"
msgstr "Non mais pour qui tu te prends pour me parler comme ça ?"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/c-14/48/c-1/29
msgctxt "Tina"
msgid "Leave me alone, will ya!?"
msgstr "Fiche-moi la paix, tu veux !?"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/c-14/48/c-1/37
msgctxt "Tina"
msgid "...come by and see me sometime again though, alright?"
msgstr "...reviens me voir un de ces jours quand même, d'accord ?"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/c-14/48/c-1/45
msgctxt "Tina"
msgid "I mean, if you want to. Whatever."
msgstr "Enfin, si tu veux. Peu importe."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/c-14/48/c-1/53
msgctxt "Tina"
msgid "BYE!"
msgstr "SALUT !"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/c-14/48/c-2/13
msgctxt "Tina"
msgid "God, why AM I askin' you. What the hell do you know about this stuff?"
msgstr "Mon Dieu, pourquoi je te demande ça. Qu'est-ce que tu connais à ces trucs-là ?"

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/c-14/48/c-2/24
msgctxt "Tina"
msgid "A square like you wouldn't know the first thing about threesomes and throuples."
msgstr "Un carré comme toi connaît rien aux plans à trois et aux trouples."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/c-14/48/c-2/32
msgctxt "Tina"
msgid "God, look what you've done to me."
msgstr "Mon Dieu, regarde ce que tu m'as fait."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/c-14/48/c-2/40
msgctxt "Tina"
msgid "You got me all twisted up thinkin' about Love on Triangle Island."
msgstr "Tu m'as toute retournée à penser à L'Amour sur l'Île du Triangle."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/c-14/48/c-2/48
msgctxt "Tina"
msgid "Scram, loser! I got a fantasy to get back to."
msgstr "Dégage, minable ! J'ai un fantasme à retrouver."

# Traduction IA – à relire
#: tina_triangle/tina_intro/0/g-4/c-14/48/c-2/56/0/s/0
msgctxt "Choix"
msgid "Rude... but whatever."
msgstr "Grossière... mais bon."

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/17/s/0
msgctxt "Choix"
msgid "No fantasies today?"
msgstr "Pas de fantasmes aujourd'hui ?"

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/18/s/0
msgctxt "Choix"
msgid "Look at you living in the real world this time."
msgstr "Regardez-moi ça, qui vit dans le monde réel pour une fois."

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/19/s/0
msgctxt "Choix"
msgid "What are you up to, Tina?"
msgstr "Tu fabriques quoi, Tina ?"

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/c-0/7
msgctxt "Tina"
msgid "It's your lucky day."
msgstr "C'est ton jour de chance."

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/c-0/15
msgctxt "Tina"
msgid "Someone else already interrupted me, so now I'm bored AND free."
msgstr "Quelqu'un m'a déjà interrompue, alors maintenant je m'ennuie ET je suis libre."

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/c-1/7
msgctxt "Tina"
msgid "The real world is overrated."
msgstr "Le monde réel, c'est surfait."

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/c-1/15
msgctxt "Tina"
msgid "There's nothin' exciting enough around here!"
msgstr "Y'a rien d'assez excitant par ici !"

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/c-2/7
msgctxt "Tina"
msgid "Nothin'. ABSOLUTELY NOTHIN'!"
msgstr "Rien. ABSOLUMENT RIEN !"

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/c-2/15
msgctxt "Tina"
msgid "That's the PROBLEM!"
msgstr "C'est ça, le PROBLÈME !"

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/g-0/0
msgctxt "Tina"
msgid "Well since you're here now..."
msgstr "Bon, puisque t'es là maintenant..."

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/g-0/8
msgctxt "Tina"
msgid "YOU entertain me."
msgstr "C'est TOI qui me divertis."

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/g-0/16/s/0
msgctxt "Choix"
msgid "I'm not a trained seal."
msgstr "Je suis pas une otarie dressée."

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/g-0/17/s/0
msgctxt "Choix"
msgid "That's a first. A clown asking to be entertained..."
msgstr "C'est une première. Un clown qui demande à être diverti..."

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/g-0/18/s/0
msgctxt "Choix"
msgid "<i>Do an awkward, shuffling dance.</i>"
msgstr "<i>Faire une danse maladroite en se dandinant.</i>"

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/g-0/c-3/13
msgctxt "Tina"
msgid "Yeah, duh."
msgstr "Ouais, évidemment."

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/g-0/c-3/24
msgctxt "Tina"
msgid "If you were I might be laughin' instead of sittin' here BORED."
msgstr "Si t'en étais un, je rigolerais peut-être au lieu de rester assise là à m'ENNUYER."

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/g-0/c-4/13
msgctxt "Tina"
msgid "...excuse you!?"
msgstr "...excuse-moi !?"

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/g-0/c-4/24
msgctxt "Tina"
msgid "I oughtta slap the vertices right outta ya!"
msgstr "Je devrais te coller une claque à t'en arracher les sommets !"

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/g-0/c-4/32
msgctxt "Tina"
msgid "...god, you're hot."
msgstr "...mon Dieu, t'es canon."

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/g-0/c-5/7
msgctxt "Narrator"
msgid "Uncertain what else to do, you dance for Tina. It's clumsy and terrible, and it's impossible to tell if Tina even likes it."
msgstr "Ne sachant que faire d'autre, vous dansez pour Tina. C'est maladroit et affreux, et impossible de dire si Tina aime ça."

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/g-0/c-5/15
msgctxt "Tina"
msgid "Do you do everything someone else tells you to do? God you're the worst."
msgstr "Tu fais tout ce qu'on te dit de faire ? Mon Dieu, t'es insupportable."

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/g-0/c-5/31
msgctxt "Tina"
msgid "It's kind of adorable."
msgstr "C'est presque adorable."

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/g-1/0
msgctxt "Tina"
msgid "Alright alright. That's enough outta you."
msgstr "Bon bon bon. Ça suffit comme ça."

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/g-1/8
msgctxt "Tina"
msgid "Look, since you're here takin' up my time, maybe you can do me a favor."
msgstr "Écoute, puisque t'es là à me prendre mon temps, tu peux peut-être me rendre un service."

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/g-1/16
msgctxt "Tina"
msgid "I'm tryna get back on the market."
msgstr "J'essaie de me remettre sur le marché."

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/g-1/24/s/0
msgctxt "Choix"
msgid "You're looking for a date?"
msgstr "Tu cherches un rancard ?"

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/g-1/25/s/0
msgctxt "Choix"
msgid "You're looking for groceries?"
msgstr "Tu cherches des courses ?"

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/g-1/c-6/7
msgctxt "Tina"
msgid "Yeah! It's a goddamn crime for a gem like me to be lonely every night."
msgstr "Ouais ! C'est un putain de crime qu'une perle comme moi soit seule tous les soirs."

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/g-1/c-7/7
msgctxt "Tina"
msgid "GOD it's like there's nothing but air in there."
msgstr "MON DIEU, c'est comme s'il y avait que du vent là-dedans."

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/g-1/c-7/15
msgctxt "Tina"
msgid "No, dummy!"
msgstr "Non, andouille !"

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/g-2/0
msgctxt "Tina"
msgid "I need a partner. Someone who understands just the kinda triangle I am."
msgstr "Il me faut un partenaire. Quelqu'un qui comprend exactement le genre de triangle que je suis."

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/g-2/8
msgctxt "Tina"
msgid "I need someone who appreciates allll my angles."
msgstr "Il me faut quelqu'un qui apprécie tououous mes angles."

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/g-2/16/s/0
msgctxt "Choix"
msgid "Acute, Obtuse, Right?"
msgstr "Aigu, obtus, droit ?"

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/g-2/17/s/0
msgctxt "Choix"
msgid "Head, shoulders, knees and toes?"
msgstr "Tête, épaules, genoux, pieds ?"

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/g-2/18/s/0
msgctxt "Choix"
msgid "I'm more into curves than angles."
msgstr "Moi, je suis plus courbes qu'angles."

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/g-2/c-8/13
msgctxt "Tina"
msgid "Yeah. Yeah! Alla that."
msgstr "Ouais. Ouais ! Tout ça."

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/g-2/c-8/21
msgctxt "Tina"
msgid "If you can't bring me nothin' like that I ain't got no use for ya."
msgstr "Si tu peux rien m'apporter de ce genre, j'ai pas besoin de toi."

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/g-2/c-8/29
msgctxt "Tina"
msgid "So get outta here!"
msgstr "Alors dégage d'ici !"

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/g-2/c-8/37/0/s/0
msgctxt "Choix"
msgid "Oh... alright."
msgstr "Oh... d'accord."

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/g-2/c-9/13
msgctxt "Tina"
msgid "Did someone tell you you're funny?"
msgstr "Quelqu'un t'a dit que t'étais drôle ?"

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/g-2/c-9/21
msgctxt "Tina"
msgid "If they did, they lied to ya. Real bad."
msgstr "Si c'est le cas, on t'a menti. Très très mal."

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/g-2/c-9/29
msgctxt "Tina"
msgid "If you can't help me in my quest for love then get on outta here!"
msgstr "Si tu peux pas m'aider dans ma quête de l'amour, alors dégage !"

# Traduction IA – à relire
