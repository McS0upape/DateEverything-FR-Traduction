#: dasha_desk/crit_dasha_love_end/0/c-0/15/c-1/15
msgctxt "Dasha"
msgid "Forgive me for bringing down the mood... but our conversation has made me think of many things."
msgstr ""

#: dasha_desk/crit_dasha_love_end/0/c-0/15/c-1/23/c-0/31/c-0/15/0/s/0
msgctxt "Choix"
msgid "I will."
