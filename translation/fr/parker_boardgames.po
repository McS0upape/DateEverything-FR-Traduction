#: parker_boardgames/euro_middle/0/16/0/s/0
msgctxt "Choix"
msgid "<i>Purchase a Bottling Plant by only spending 7 Bulk Cooling Tank tokens rather than 8.</i>"
msgstr ""

#: parker_boardgames/euro_middle/0/16/1/s/0
msgctxt "Choix"
msgid "<i>Take a full 24 hours to think your way through your a move in an attempt to outlast his patience.</i>"
