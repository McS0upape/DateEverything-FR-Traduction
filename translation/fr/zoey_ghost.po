msgid "I'm holding out hope."
msgstr "Je garde espoir."

# Traduction IA – à relire
#: zoey_ghost/attic_almost/32
msgctxt "Zoey"
msgid "She's all I got left at this point..."
msgstr "C'est tout ce qu'il me reste à ce stade..."

# Traduction IA – à relire
#: zoey_ghost/attic_one/0
msgctxt "Zoey"
msgid "Hm... That's just one...."
msgstr "Hm... Ça fait juste un...."

# Traduction IA – à relire
#: zoey_ghost/attic_one/8
msgctxt "Zoey"
msgid "We definitely need more than that."
msgstr "Il nous en faut clairement plus que ça."

# Traduction IA – à relire
#: zoey_ghost/attic_one/16
msgctxt "Zoey"
msgid "Which is okay! Because we have time!"
msgstr "Ce qui est ok ! Parce qu'on a le temps !"

# Traduction IA – à relire
#: zoey_ghost/attic_one/24
msgctxt "Zoey"
msgid "Well... I have time."
msgstr "Enfin... j'ai le temps."

# Traduction IA – à relire
#: zoey_ghost/attic_one/32
msgctxt "Zoey"
msgid "Who knows how long <i>you</i> have left."
msgstr "Qui sait combien de temps il <i>te</i> reste."

# Traduction IA – à relire
#: zoey_ghost/attic_one/40
msgctxt "Zoey"
msgid "Sorry. Morbid."
msgstr "Pardon. Morbide."

# Traduction IA – à relire
#: zoey_ghost/attic_one/51
msgctxt "Zoey"
msgid "Kinda my thing though."
msgstr "C'est un peu mon truc, pourtant."

# Traduction IA – à relire
#: zoey_ghost/attic_tableau/0/3
msgctxt "Zoey"
msgid "You did it."
msgstr "Tu l'as fait."

# Traduction IA – à relire
#: zoey_ghost/attic_tableau/0/14
msgctxt "Zoey"
msgid "You actually did it. The energy in this room is so amazing, I haven't felt this good in decades!"
msgstr "Tu l'as vraiment fait. L'énergie dans cette pièce est tellement incroyable, je me suis pas sentie aussi bien depuis des décennies !"

# Traduction IA – à relire
#: zoey_ghost/attic_tableau/0/22/0
msgctxt "Narrator"
msgid "Your recruitment has paid off—the room is positively buzzing with vitality, even if you're the only technically living being present."
msgstr "Votre recrutement a porté ses fruits : la pièce bourdonne littéralement de vitalité, même si vous êtes techniquement le seul être vivant présent."

# Traduction IA – à relire
#: zoey_ghost/attic_tableau/0/22/14/b/1 zoey_ghost/attic_tableau/0/22/15/b/1
msgctxt "Skips"
msgid "Wow... it's so dark in here."
msgstr "Waouh... il fait tellement sombre ici."

# Traduction IA – à relire
#: zoey_ghost/attic_tableau/0/22/16/b/1
msgctxt "xxXOmegaShadowl0rd42069Xxx"
msgid "Darkness calls me!"
msgstr "Les ténèbres m'appellent !"

# Traduction IA – à relire
#: zoey_ghost/attic_tableau/0/22/17/b/1
msgctxt "xxXShadowl0rd420Xxx"
msgid "Darkness... just where I belong."
msgstr "Les ténèbres... exactement là où est ma place."

# Traduction IA – à relire
#: zoey_ghost/attic_tableau/0/22/20/b/4
msgctxt "Doug"
msgid "Cool digs. Where's the ghost."
msgstr "Sympa, le coin. Il est où, le fantôme."

# Traduction IA – à relire
#: zoey_ghost/attic_tableau/0/22/23/b/4
msgctxt "Nightmare"
msgid "The realm between the living and the dead - my favorite."
msgstr "Le royaume entre les vivants et les morts, mon préféré."

# Traduction IA – à relire
#: zoey_ghost/attic_tableau/0/22/26/b/4
