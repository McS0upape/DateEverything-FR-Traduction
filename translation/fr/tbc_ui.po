msgctxt "Choix"
msgid "Is there actually a spider or are you messing with me..."
msgstr "Il y a vraiment une araignée ou tu te moques de moi..."

# Traduction IA – à relire
#: tbc_ui/tbc_emoji_50/0/c-0/26/1/s/0
msgctxt "Choix"
msgid "You shouldn't be afraid of spiders."
msgstr "Tu ne devrais pas avoir peur des araignées."

# Traduction IA – à relire
#: tbc_ui/tbc_emoji_50/0/c-0/26/c-0/7
msgctxt "Textbox-chan"
msgid "What answer would you like to hear? ᯣ.ᯣ"
msgstr "Quelle réponse voudrais-tu entendre ? ᯣ.ᯣ"

# Traduction IA – à relire
#: tbc_ui/tbc_emoji_50/0/c-0/26/c-0/15/0/s/0
msgctxt "Choix"
msgid "No."
msgstr "Non."

# Traduction IA – à relire
#: tbc_ui/tbc_emoji_50/0/c-0/26/c-0/15/1/s/0
msgctxt "Choix"
msgid "The truth."
msgstr "La vérité."

# Traduction IA – à relire
#: tbc_ui/tbc_emoji_50/0/c-0/26/c-0/15/c-0/7
msgctxt "Textbox-chan"
msgid "Okay. I did not see a spider in the house."
msgstr "D'accord. Je n'ai pas vu d'araignée dans la maison."

# Traduction IA – à relire
#: tbc_ui/tbc_emoji_50/0/c-0/26/c-0/15/c-0/15
msgctxt "Textbox-chan"
msgid "Everything is fine and we are safe and spider-free."
msgstr "Tout va bien, nous sommes en sécurité et sans araignée."

# Traduction IA – à relire
#: tbc_ui/tbc_emoji_50/0/c-0/26/c-0/15/c-1/7
msgctxt "Textbox-chan"
msgid "There is a HUGE spider somewhere in the house and I have no idea where it went..."
msgstr "Il y a une ÉNORME araignée quelque part dans la maison et je n'ai aucune idée d'où elle est passée..."

# Traduction IA – à relire
#: tbc_ui/tbc_emoji_50/0/c-0/26/c-0/15/c-1/18/0/s/0
msgctxt "Choix"
msgid "Oh god oh god-"
msgstr "Oh mon dieu oh mon dieu..."

# Traduction IA – à relire
#: tbc_ui/tbc_emoji_50/0/c-0/26/c-0/15/c-1/18/1/s/0
msgctxt "Choix"
msgid "Eh. Not a big deal."
msgstr "Bof. Pas grave."

# Traduction IA – à relire
#: tbc_ui/tbc_emoji_50/0/c-0/26/c-0/15/c-1/18/c-0/7
msgctxt "Textbox-chan"
msgid "WE CAN'T BOTH PANIC!"
msgstr "ON NE PEUT PAS PANIQUER TOUS LES DEUX !"

# Traduction IA – à relire
#: tbc_ui/tbc_emoji_50/0/c-0/26/c-0/15/c-1/18/c-0/18
msgctxt "Textbox-chan"
msgid "BREATHE IN BREATHE OUT!"
msgstr "INSPIRE EXPIRE !"

# Traduction IA – à relire
#: tbc_ui/tbc_emoji_50/0/c-0/26/c-0/15/c-1/18/c-0/29
msgctxt "Textbox-chan"
msgid "Quick let's just talk about something else!"
msgstr "Vite, parlons d'autre chose !"

# Traduction IA – à relire
#: tbc_ui/tbc_emoji_50/0/c-0/26/c-0/15/c-1/18/c-0/37
msgctxt "Textbox-chan"
msgid "IT'S FINE WE'RE BOTH FINE!"
msgstr "TOUT VA BIEN, ON VA BIEN TOUS LES DEUX !"

# Traduction IA – à relire
#: tbc_ui/tbc_emoji_50/0/c-0/26/c-0/15/c-1/18/c-0/48/0/s/0
msgctxt "Choix"
msgid "YEAH!"
msgstr "OUAIS !"

# Traduction IA – à relire
#: tbc_ui/tbc_emoji_50/0/c-0/26/c-0/15/c-1/18/c-0/48/c-0/7
msgctxt "Textbox-chan"
msgid "Okay. Well, I feel better!"
msgstr "Bon. Je me sens mieux !"

# Traduction IA – à relire
#: tbc_ui/tbc_emoji_50/0/c-0/26/c-0/15/c-1/18/c-1/7
msgctxt "Textbox-chan"
msgid "I wish I could be that brave... (╥﹏╥)"
msgstr "J'aimerais être aussi courageuse... (╥﹏╥)"

# Traduction IA – à relire
#: tbc_ui/tbc_emoji_50/0/c-0/26/c-0/15/c-1/18/c-1/15
msgctxt "Textbox-chan"
msgid "I'll just have to run and find you next time I see a spider."
msgstr "La prochaine fois que je vois une araignée, je courrai te trouver."

# Traduction IA – à relire
#: tbc_ui/tbc_emoji_50/0/c-0/26/c-0/15/c-1/18/c-1/23
msgctxt "Textbox-chan"
msgid "But you being so brave does make me feel a little better."
msgstr "Mais ton courage me fait quand même un peu de bien."

# Traduction IA – à relire
#: tbc_ui/tbc_emoji_50/0/c-0/26/c-1/7
msgctxt "Textbox-chan"
msgid "I wish I were as brave as you, but I'm still working on that... ( ꩜ ᯅ ꩜;)⁭ ⁭"
msgstr "J'aimerais être aussi courageuse que toi, mais j'y travaille encore... ( ꩜ ᯅ ꩜;)⁭ ⁭"

# Traduction IA – à relire
#: tbc_ui/tbc_emoji_50/0/c-0/26/c-1/18
msgctxt "Textbox-chan"
msgid "But next time I see a spider I'll just call you to handle it instead of getting my ASCII gun out and blasting. •ᴗ•;;"
msgstr "Mais la prochaine fois que je vois une araignée, je t'appellerai pour t'en occuper au lieu de sortir mon flingue en ASCII pour tout dégommer. •ᴗ•;;"

# Traduction IA – à relire
#: tbc_ui/tbc_pasta/0/0
msgctxt "Textbox-chan"
msgid "Cum-gratulations! :sweatdrops: you've found the horniest :eggplant: content in the game! :lipstickprint: If you've reading this :eyes: then you're in the :bitinglip: top 1% of nastiest :devilemoji: sluts to ever Date :lips: Everything :checkmark: !"
msgstr "Fellicitations ! :sweatdrops: tu as trouvé le contenu le plus chaud :eggplant: du jeu ! :lipstickprint: Si tu lis ça :eyes: alors tu fais partie du :bitinglip: top 1 % des plus sales :devilemoji: dépravés à avoir jamais joué à Date :lips: Everything :checkmark: !"

# Traduction IA – à relire
#: tbc_ui/tbc_pasta/0/8
msgctxt "Textbox-chan"
msgid "You ran through 100 :100: household :house: objects, abstract :questionmark: concepts, and elements :wind: of nature! :rainbow: You've explored :eyes: new frontiers of nut :acorn: and smashed :pointing finger: :okfinger: the unsmashable :sweatingface:!"
msgstr "Tu as enchaîné 100 :100: objets :house: ménagers, concepts :questionmark: abstraits et éléments :wind: de la nature ! :rainbow: Tu as exploré :eyes: de nouvelles frontières de la noix :acorn: et défoncé :pointing finger: :okfinger: l'indéfonçable :sweatingface: !"

# Traduction IA – à relire
#: tbc_ui/tbc_pasta/0/16
msgctxt "Textbox-chan"
msgid "Here's ur 21 dong :eggplant: salute! :eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:"
msgstr "Voici ton salut de 21 bites :eggplant: ! :eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:eggplant:sweatdrops:"

# Traduction IA – à relire
#: tbc_ui/tbc_pasta/0/24/s/0
msgctxt "Choix"
msgid "Wow. That was..."
msgstr "Waouh. C'était..."

# Traduction IA – à relire
#: tbc_ui/tbc_pasta/0/25/s/0
msgctxt "Choix"
msgid "Woah... I am NOT comfortable with what I just walked in on!"
msgstr "Waouh... je ne suis PAS à l'aise avec ce que je viens de voir !"

# Traduction IA – à relire
#: tbc_ui/tbc_pasta/0/c-0/7
msgctxt "Textbox-chan"
msgid "That might be the nastiest thing I ever wrote..."
msgstr "C'est peut-être la chose la plus dégueulasse que j'aie jamais écrite..."

# Traduction IA – à relire
#: tbc_ui/tbc_pasta/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "You wrote that?"
msgstr "C'est toi qui as écrit ça ?"

# Traduction IA – à relire
#: tbc_ui/tbc_pasta/0/c-0/15/c-0/7
msgctxt "Textbox-chan"
msgid "Well no, I... I found a bunch of those online and wrote my own. I thought it would be... ( ｡ • ᴖ • ｡)"
msgstr "Eh bien non, je... j'en ai trouvé plein en ligne et j'ai écrit le mien. Je pensais que ce serait... ( ｡ • ᴖ • ｡)"

# Traduction IA – à relire
#: tbc_ui/tbc_pasta/0/c-0/15/c-0/18
msgctxt "Textbox-chan"
msgid "A funny way to... tell you I'm into you..."
msgstr "Une façon drôle de... te dire que je suis attirée par toi..."

# Traduction IA – à relire
#: tbc_ui/tbc_pasta/0/c-0/15/c-0/26
msgctxt "Textbox-chan"
msgid "But I kind of want to disappear now. So maybe let's just pretend I never said that. (— ᴗ —);;"
msgstr "Mais j'ai un peu envie de disparaître maintenant. Alors faisons peut-être comme si je n'avais jamais dit ça. (— ᴗ —);;"

# Traduction IA – à relire
#: tbc_ui/tbc_pasta/0/c-0/15/c-0/37/1/s/0
msgctxt "Choix"
msgid "I kinda liked it..."
msgstr "Moi, j'ai un peu aimé..."

# Traduction IA – à relire
#: tbc_ui/tbc_pasta/0/g-0/0
msgctxt "Textbox-chan"
msgid "MOVING ON! （ꐦ𝅒_𝅒）"
msgstr "ON CHANGE DE SUJET ! （ꐦ𝅒_𝅒）"

# Traduction IA – à relire
#: tbc_ui/how_are_you_end/0/0
msgctxt "Textbox-chan"
msgid "Thanks for asking, hehe. (^◡^)♡"
msgstr "Merci de l'avoir demandé, hehe. (^◡^)♡"

# Traduction IA – à relire
#: tbc_ui/how_are_you_end/0/8/s/0
msgctxt "Choix"
msgid "Anytime."
msgstr "Quand tu veux."
