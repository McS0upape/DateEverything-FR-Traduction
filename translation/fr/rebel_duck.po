# Traduction IA – à relire
#: rebel_duck/Rebel_Breakthrough_3/0/g-10/56
msgctxt "Rebel"
msgid "Exhibitionism in the summer, but never in the winter."
msgstr "L'exhibitionnisme l'été, mais jamais l'hiver."

# Traduction IA – à relire
#: rebel_duck/Rebel_Breakthrough_3/0/g-10/64
