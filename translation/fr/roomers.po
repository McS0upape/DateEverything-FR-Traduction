# Traduction IA – à relire
#: roomers/roomer_abel/1
msgctxt "Tag Roomers"
msgid "Strong Sturdy Type"
msgstr "Le Costaud à Quatre Pieds"

# Traduction IA – à relire
#: roomers/roomer_abel/4
msgctxt "Tag Roomers"
msgid "The next best thing for holding objects aloft than the floor itself."
msgstr "Le meilleur support après le sol pour tenir des objets en l'air."

# Traduction IA – à relire
#: roomers/roomer_abel/10
msgctxt "Tag Roomers"
msgid "In order to Realize Ben-hwa, it seems you need to speak with Abel."
msgstr "Pour Réaliser Ben-hwa, il semble que vous deviez parler à Abel."

# Traduction IA – à relire
#: roomers/roomer_abel/16
