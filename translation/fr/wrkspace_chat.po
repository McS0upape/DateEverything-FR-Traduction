# Traduction IA – à relire
#: wrkspace_chat/tom_2/0/g-1/15
msgctxt "Tom"
msgid "So no muck! I'm over here doing my best too."
msgstr "Donc pas de bourde ! Moi aussi, je fais de mon mieux de mon côté."

# Traduction IA – à relire
#: wrkspace_chat/tom_2/0/g-1/23
