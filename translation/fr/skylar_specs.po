#: skylar_specs/skylar_wherenext/0/20/s/0
msgctxt "Choix"
msgid "Okay, sounds good."
msgstr "D'accord, ça marche."

# Traduction IA – à relire
#: skylar_specs/skylar_wherenext/0/21/s/0
