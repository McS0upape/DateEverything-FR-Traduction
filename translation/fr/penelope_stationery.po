#: penelope_stationery/penelope_friend_return/0/c-1/15
msgctxt "Penelope"
msgid "Let's hang later, alright? I'm sorting through these old calendars..."
msgstr ""

#: penelope_stationery/penelope_love_return/0/0
msgctxt "Penelope"
msgid "Hey there lover!"
msgstr ""

#: penelope_stationery/penelope_love_return/0/8
msgctxt "Penelope"
msgid "Oh god, it sounds so weird outside of my head..."
