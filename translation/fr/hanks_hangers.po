msgstr "C'EST NOTRE PREMIÈRE FOIS !!"

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-3/0/s/0
msgctxt "Choix"
msgid "Are you sure you're ready for this? I mean, aren't you even a little bit scared?"
msgstr "Vous êtes sûrs d'être prêts ? Enfin, vous avez même pas un peu peur ?"

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-3/1/s/0
msgctxt "Choix"
msgid "But Red Bowl isn't even sponsoring you!"
msgstr "Mais Red Bowl vous sponsorise même plus !"

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-3/c-8/7
msgctxt "Hanks"
msgid "No way!"
msgstr "Pas du tout !"

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-3/c-8/30
msgctxt "Hank 4"
msgid "We know what we're up against!"
msgstr "On sait à quoi on s'attaque !"

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-3/c-8/38
msgctxt "Hank 1"
msgid "Yeah, we've been training years for this!"
msgstr "Ouais, on s'entraîne depuis des années pour ça !"

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-3/c-8/46
msgctxt "Hank 2"
msgid "Gotta take the leap some day!"
msgstr "Faut bien se jeter à l'eau un jour !"

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-3/c-8/57
msgctxt "Hank 3"
msgid "We know it's going to be the most epic thing we've done to date."
msgstr "On sait que ce sera la chose la plus épique qu'on ait faite à ce jour."

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-3/c-8/65
msgctxt "Hank 5"
msgid "And we'd love to share that experience with you!"
msgstr "Et on adorerait partager cette expérience avec toi !"

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-3/c-9/7
msgctxt "Hank 1"
msgid "Yeah! We're doing it for LOVE!"
msgstr "Ouais ! On le fait par AMOUR !"

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-3/c-9/18
msgctxt "Hank 5"
msgid "Love is the ultimate experience! Love is the ultimate rush!"
msgstr "L'amour est l'expérience ultime ! L'amour est l'ultime décharge !"

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-4/0
msgctxt "Hanks"
msgid "This is it, House Homie!!"
msgstr "C'est maintenant, coloc !!"

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-4/23
msgctxt "Hank 1"
msgid "Yes or no!"
msgstr "Oui ou non !"

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-4/34
msgctxt "Hank 2"
msgid "The final moment."
msgstr "Le moment final."

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-4/45
msgctxt "Hank 3"
msgid "The last dance."
msgstr "La dernière danse."

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-4/56
msgctxt "Hank 4"
msgid "It's now or never!!"
msgstr "C'est maintenant ou jamais !!"

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-4/67
msgctxt "Hank 5"
msgid "The leap of faith!"
msgstr "Le saut de la foi !"

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-4/78
msgctxt "Hanks"
msgid "WANNA COME?"
msgstr "TU VIENS ?"

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-4/113/0/s/0
msgctxt "Choix"
msgid "YES!"
msgstr "OUI !"

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-4/113/1/s/0
msgctxt "Choix"
msgid "NO!"
msgstr "NON !"

# Traduction IA – à relire
#: hanks_hangers/hanks_friendshippostjump/0/3 hanks_hangers/hanks_friendshipall/0/3
msgctxt "Hanks"
msgid "That was siiiiiick!!!"
msgstr "C'était de oufffff !!!"

# Traduction IA – à relire
#: hanks_hangers/hanks_friendshippostjump/0/41/s/0 hanks_hangers/hanks_friendshipall/0/41/s/0
msgctxt "Choix"
msgid "Oh my god! I've never felt so alive!!"
msgstr "Oh mon dieu ! Je me suis jamais {{senti|sentie|senti·e}} aussi {{vivant|vivante|vivant·e}} !!"

# Traduction IA – à relire
#: hanks_hangers/hanks_friendshippostjump/0/42/s/0 hanks_hangers/hanks_friendshipall/0/42/s/0
msgctxt "Choix"
msgid "That. Was. AWESOME!!!"
msgstr "C'était. Génial. !!!"

# Traduction IA – à relire
#: hanks_hangers/hanks_friendshippostjump/0/43/s/0 hanks_hangers/hanks_friendshipall/0/43/s/0
msgctxt "Choix"
msgid "Am I dead?"
msgstr "Je suis {{mort|morte|mort·e}} ?"

# Traduction IA – à relire
#: hanks_hangers/hanks_friendshippostjump/0/44/s/0 hanks_hangers/hanks_friendshipall/0/44/s/0
msgctxt "Choix"
msgid "I think I peed my wingsuit."
msgstr "Je crois que j'ai fait pipi dans ma wingsuit."

# Traduction IA – à relire
#: hanks_hangers/hanks_friendshippostjump/0/g-0/0
msgctxt "Hank 1"
msgid "You're so rad, House Homie."
msgstr "T'es trop radical, coloc."

# Traduction IA – à relire
