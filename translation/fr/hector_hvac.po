# Traduction IA – à relire
#: hector_hvac/1
msgctxt "Tag Nom d'objet (MAJUSCULES)"
msgid "HVAC"
msgstr "CLIM"

# Traduction IA – à relire
#: hector_hvac/skylar_hector_content/0/7 hector_hvac/skylar_hector_content_attic/0/7
msgctxt "Skylar"
msgid "Quick content aware for Mr. Secretive over here."
msgstr "Petit Alerte Contenu express pour Monsieur Mystère, ici présent."

# Traduction IA – à relire
#: hector_hvac/skylar_hector_content/0/15 hector_hvac/skylar_hector_content_attic/0/15
msgctxt "Skylar"
msgid "His name is Hector - and he has theme of overt submissiveness and behavior that could be considered as stalking."
msgstr "Il s'appelle Hector, et il a un thème de soumission flagrante et un comportement qui pourrait être assimilé à du harcèlement."

# Traduction IA – à relire
#: hector_hvac/skylar_hector_content/0/23 hector_hvac/skylar_hector_content_attic/0/23
msgctxt "Skylar"
msgid "While he is ultimately harmless, the language he uses and the intensity with which he speaks could be triggering."
msgstr "Il est foncièrement inoffensif, mais le langage qu'il emploie et l'intensité avec laquelle il parle pourraient être déclencheurs."

# Traduction IA – à relire
#: hector_hvac/skylar_hector_content/0/31 hector_hvac/skylar_hector_content_attic/0/31
msgctxt "Skylar"
msgid "You cool with that? Or you want to skip it?"
msgstr "Ça te va ? Ou tu préfères passer ?"

# Traduction IA – à relire
#: hector_hvac/skylar_hector_content/0/39/s/0 hector_hvac/skylar_hector_content_attic/0/39/s/0
msgctxt "Choix"
msgid "Let's skip this please!"
msgstr "Passons, s'il te plaît !"

# Traduction IA – à relire
#: hector_hvac/skylar_hector_content/0/40/s/0 hector_hvac/skylar_hector_content_attic/0/40/s/0
msgctxt "Choix"
msgid "No, I'm okay with that."
msgstr "Non, ça me va."

# Traduction IA – à relire
#: hector_hvac/skylar_hector_content/0/c-0/16 hector_hvac/skylar_hector_content_attic/0/c-0/16
msgctxt "Skylar"
msgid "No worries!"
msgstr "Pas de souci !"

# Traduction IA – à relire
#: hector_hvac/skylar_hector_content/0/c-0/24 hector_hvac/skylar_hector_content_attic/0/c-0/24
msgctxt "Skylar"
msgid "Here - he looks like this. Surprise!"
msgstr "Tiens, voilà à quoi il ressemble. Surprise !"

# Traduction IA – à relire
#: hector_hvac/skylar_hector_content/0/c-0/38 hector_hvac/skylar_hector_content_attic/0/c-0/38
msgctxt "Hector"
msgid "Oh!"
msgstr "Oh !"

# Traduction IA – à relire
#: hector_hvac/skylar_hector_content/0/c-0/49 hector_hvac/skylar_hector_content_attic/0/c-0/49
msgctxt "Narrator"
msgid "How would you like your relationship with Hector to resolve?"
msgstr "Comment souhaiteriez-vous que votre relation avec Hector se conclue ?"

# Traduction IA – à relire
#: hector_hvac/skylar_hector_content/0/c-0/54/0/s/0 hector_hvac/skylar_hector_content_attic/0/c-0/54/0/s/0
msgctxt "Choix"
msgid "Love!"
msgstr "L'amour !"

# Traduction IA – à relire
#: hector_hvac/skylar_hector_content/0/c-0/54/1/s/0 hector_hvac/skylar_hector_content_attic/0/c-0/54/1/s/0
msgctxt "Choix"
msgid "Friendship!"
msgstr "L'amitié !"

# Traduction IA – à relire
#: hector_hvac/skylar_hector_content/0/c-0/54/2/s/0 hector_hvac/skylar_hector_content_attic/0/c-0/54/2/s/0
msgctxt "Choix"
msgid "Hate!"
msgstr "La haine !"

# Traduction IA – à relire
#: hector_hvac/skylar_hector_content/0/c-0/54/c-0/7 hector_hvac/skylar_hector_content_attic/0/c-0/54/c-0/7
msgctxt "Narrator"
msgid "Things have gone from good to grate with Hector - you are now lovers!"
msgstr "Entre Hector et vous, on est passé du tiède au torride : vous voilà amants !"

# Traduction IA – à relire
#: hector_hvac/skylar_hector_content/0/c-0/54/c-0/27 hector_hvac/skylar_hector_content/0/c-0/54/c-1/27 hector_hvac/skylar_hector_content/0/c-0/54/c-2/27 hector_hvac/skylar_hector_content_attic/0/c-0/54/c-0/27 hector_hvac/skylar_hector_content_attic/0/c-0/54/c-1/27 hector_hvac/skylar_hector_content_attic/0/c-0/54/c-2/27
msgctxt "Skylar"
msgid "See you out there on the next one!"
msgstr "On se retrouve pour la prochaine !"

# Traduction IA – à relire
#: hector_hvac/skylar_hector_content/0/c-0/54/c-1/7 hector_hvac/skylar_hector_content_attic/0/c-0/54/c-1/7
msgctxt "Narrator"
msgid "Your relationship with Hector has been conditioned to a cool friendship."
msgstr "Votre relation avec Hector a été climatisée en une amitié fraîche."

# Traduction IA – à relire
#: hector_hvac/skylar_hector_content/0/c-0/54/c-2/7 hector_hvac/skylar_hector_content_attic/0/c-0/54/c-2/7
msgctxt "Narrator"
msgid "You've cranked up the thermostat to a blazing hatred of Hector."
msgstr "Vous avez poussé le thermostat jusqu'à une haine brûlante envers Hector."

# Traduction IA – à relire
#: hector_hvac/skylar_hector_content/0/c-0/54/c-2/60 hector_hvac/skylar_hector_content_attic/0/c-0/54/c-2/60 hector_hvac/hateone/37
msgctxt "Reggie"
msgid "Mmm... what is this..."
msgstr "Mmm... c'est quoi, ça..."

# Traduction IA – à relire
#: hector_hvac/skylar_hector_content/0/c-0/54/c-2/68 hector_hvac/skylar_hector_content_attic/0/c-0/54/c-2/68 hector_hvac/hateone/45
msgctxt "Reggie"
msgid "A polite, disappointed hate. A subtle flavor, touches of self-doubt and..."
msgstr "Une haine polie et déçue. Une saveur subtile, des touches de doute de soi et..."

# Traduction IA – à relire
#: hector_hvac/skylar_hector_content/0/c-0/54/c-2/76 hector_hvac/skylar_hector_content_attic/0/c-0/54/c-2/76 hector_hvac/hateone/53
msgctxt "Reggie"
msgid "Is that regret I taste? Mmmm YUMMY."
msgstr "C'est du regret que je goûte ? Mmmm DÉLICIEUX."

# Traduction IA – à relire
#: hector_hvac/skylar_hector_content/0/c-1/7 hector_hvac/skylar_hector_content_attic/0/c-1/7
msgctxt "Skylar"
msgid "Let's get to it!"
msgstr "Au boulot !"

# Traduction IA – à relire
#: hector_hvac/hector_controls_first/7
msgctxt "Narrator"
msgid "You feel an unseen presence detach, flee."
msgstr "Vous sentez une présence invisible se détacher et fuir."

# Traduction IA – à relire
#: hector_hvac/hector_controls_first/12
msgctxt "Narrator"
msgid "It seems that there is nothing here to speak with."
msgstr "Il semblerait qu'il n'y ait personne ici à qui parler."

# Traduction IA – à relire
#: hector_hvac/hector_controls_first/17
msgctxt "Narrator"
msgid "Mysterious. Perhaps this is not the place."
msgstr "Mystérieux. Ce n'est peut-être pas le bon endroit."

# Traduction IA – à relire
#: hector_hvac/hector_controls_second/3
msgctxt "Narrator"
msgid "Again, nothing."
msgstr "Encore rien."

# Traduction IA – à relire
#: hector_hvac/hector_controls_second/8
msgctxt "Narrator"
msgid "The grates, the grates are calling."
msgstr "Les grilles, les grilles vous appellent."

# Traduction IA – à relire
#: hector_hvac/hector_intro_grate/0/4
msgctxt "Narrator"
msgid "A cool breeze tickles at your neck—you can <i>feel</i> someone here, but you can't see anyone..."
msgstr "Une brise fraîche vous chatouille la nuque : vous <i>sentez</i> quelqu'un ici, mais vous ne voyez personne..."

# Traduction IA – à relire
#: hector_hvac/hector_intro_grate/0/12
msgctxt "Hector"
msgid "...gasp!"
msgstr "...souffle coupé !"

# Traduction IA – à relire
#: hector_hvac/hector_intro_grate/0/23
msgctxt "Hector"
msgid "No... I... Why are you here? What are you doing?"
msgstr "Non... je... Pourquoi êtes-vous ici ? Que faites-vous ?"

# Traduction IA – à relire
#: hector_hvac/hector_intro_grate/0/34/s/0
msgctxt "Choix"
msgid "Just sayin' hi!"
msgstr "Je dis juste bonjour !"

# Traduction IA – à relire
#: hector_hvac/hector_intro_grate/0/35/s/0
msgctxt "Choix"
msgid "Sorry, did I scare you?"
msgstr "Pardon, je t'ai fait peur ?"

# Traduction IA – à relire
#: hector_hvac/hector_intro_grate/0/36/s/0
msgctxt "Choix"
msgid "Feel like I've already done something wrong here."
msgstr "J'ai l'impression d'avoir déjà fait une bêtise."

# Traduction IA – à relire
#: hector_hvac/hector_intro_grate/0/c-0/7
msgctxt "Hector"
msgid "Hi? You're saying hi...?"
msgstr "Bonjour ? Vous me dites bonjour... ?"

# Traduction IA – à relire
#: hector_hvac/hector_intro_grate/0/c-0/15
msgctxt "Hector"
msgid "You're greeting me."
msgstr "Vous me saluez."

# Traduction IA – à relire
#: hector_hvac/hector_intro_grate/0/c-0/23
msgctxt "Hector"
msgid "So casually. Like it's easy, like it's nothing..."
msgstr "Si simplement. Comme si c'était facile, comme si ce n'était rien..."

# Traduction IA – à relire
#: hector_hvac/hector_intro_grate/0/c-1/7
msgctxt "Hector"
msgid "Yes, you scared me!"
msgstr "Oui, vous m'avez fait peur !"

# Traduction IA – à relire
#: hector_hvac/hector_intro_grate/0/c-1/18
msgctxt "Hector"
msgid "Don't you know who you are? What you are to me?"
msgstr "Ne savez-vous pas qui vous êtes ? Ce que vous êtes pour moi ?"

# Traduction IA – à relire
#: hector_hvac/hector_intro_grate/0/c-1/26
msgctxt "Hector"
msgid "I'm scared the way one is frightened when coming face to face with a divine force..."
msgstr "J'ai peur comme on a peur face à une force divine..."

# Traduction IA – à relire
#: hector_hvac/hector_intro_grate/0/c-2/7
msgctxt "Hector"
msgid "Wrong?!"
msgstr "Une bêtise ?!"

# Traduction IA – à relire
#: hector_hvac/hector_intro_grate/0/c-2/15
msgctxt "Hector"
msgid "No. Not at all. Nothing could be further..."
msgstr "Non. Pas du tout. Rien n'est plus éloigné de..."

# Traduction IA – à relire
#: hector_hvac/hector_intro_grate/0/c-2/23
msgctxt "Hector"
msgid "I've made you feel this. I've hurt you."
msgstr "Je vous ai fait ressentir cela. Je vous ai fait du mal."

# Traduction IA – à relire
#: hector_hvac/hector_intro_grate/0/c-2/34
msgctxt "Hector"
msgid "Now I must make up for that... I must heal that. And I will."
msgstr "Je dois maintenant me racheter... Je dois guérir cela. Et je le ferai."

# Traduction IA – à relire
#: hector_hvac/hector_intro_grate/0/c-2/45
msgctxt "Hector"
msgid "I will do so much for you, as I have always done."
msgstr "Je ferai tant pour vous, comme je l'ai toujours fait."

# Traduction IA – à relire
#: hector_hvac/hector_intro_grate/0/c-2/53
msgctxt "Hector"
msgid "But hear me."
msgstr "Mais écoutez-moi."

# Traduction IA – à relire
#: hector_hvac/hector_intro_grate/0/g-0/0
msgctxt "Hector"
msgid "Not now. Not here. Not yet!"
msgstr "Pas maintenant. Pas ici. Pas encore !"

# Traduction IA – à relire
#: hector_hvac/hector_intro_grate/0/g-0/11
msgctxt "Hector"
msgid "Please, please, I'm not ready... not like this."
msgstr "Je vous en prie, je ne suis pas prêt... pas comme ça."

# Traduction IA – à relire
#: hector_hvac/hector_intro_grate/0/g-0/22
msgctxt "Hector"
msgid "I've dreamed of this, of meeting you, finally..."
msgstr "J'ai rêvé de ce moment, de vous rencontrer, enfin..."

# Traduction IA – à relire
#: hector_hvac/hector_intro_grate/0/g-0/30
msgctxt "Hector"
msgid "And now the moment is here, I... I just can't. Not yet."
msgstr "Et maintenant qu'il est là, je... je ne peux simplement pas. Pas encore."

# Traduction IA – à relire
#: hector_hvac/hector_intro_grate/0/g-0/38
msgctxt "Hector"
msgid "I'll be ready when you come back..."
msgstr "Je serai prêt à votre retour..."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate/0/13 hector_hvac/hector_second_grate_attic_met/0/6
msgctxt "Narrator"
msgid "You see a pair of hands sticking through the air conditioning grate, and the barest suggestion of someone's eyes, but no more."
msgstr "Vous voyez deux mains passer à travers la grille de climatisation, et la plus infime suggestion d'yeux, mais rien de plus."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate/0/21/b/5
msgctxt "Hector"
msgid "I have considered. Your apology was genuine. I... I'm willing to start fresh. We all have misunderstandings."
msgstr "J'ai réfléchi. Vos excuses étaient sincères. Je... je suis prêt à repartir de zéro. Nous avons tous des malentendus."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate/0/21/b/13
msgctxt "Hector"
msgid "I'm willing to believe, to hope, that's all we had before."
msgstr "Je veux bien croire, espérer, que ce n'était rien de plus entre nous."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate/0/32 hector_hvac/helpone/0/g-2/35
msgctxt "Hector"
msgid "What do you think?"
msgstr "Qu'en pensez-vous ?"

# Traduction IA – à relire
#: hector_hvac/hector_second_grate/0/40/s/0 hector_hvac/hector_second_grate_attic_met/0/62/s/0
msgctxt "Choix"
msgid "You won't come out of there and let me see you?"
msgstr "Tu ne veux pas sortir de là pour que je te voie ?"

# Traduction IA – à relire
#: hector_hvac/hector_second_grate/0/41/s/0 hector_hvac/hector_second_grate_attic_met/0/63/s/0
msgctxt "Choix"
msgid "Fine with me!"
msgstr "Ça me va très bien !"

# Traduction IA – à relire
#: hector_hvac/hector_second_grate/0/42/s/0 hector_hvac/hector_second_grate_attic_met/0/64/s/0
msgctxt "Choix"
msgid "Come on! I can't fall in love with you if I don't know what you look like!"
msgstr "Allez ! Je ne peux pas tomber amoureux de toi si je ne sais pas à quoi tu ressembles !"

# Traduction IA – à relire
#: hector_hvac/hector_second_grate/0/c-0/7 hector_hvac/hector_second_grate_attic_met/0/c-0/7
msgctxt "Hector"
msgid "No, this is for the best."
msgstr "Non, c'est mieux ainsi."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate/0/c-1/7 hector_hvac/hector_second_grate_attic_met/0/c-1/7
msgctxt "Hector"
msgid "I am relieved."
msgstr "Me voilà soulagé."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate/0/c-2/15 hector_hvac/hector_second_grate_attic_met/0/c-2/15
msgctxt "Hector"
msgid "I can show you a picture, if you wish."
msgstr "Je peux vous montrer une photo, si vous le souhaitez."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate/0/c-2/23/0/s/0 hector_hvac/hector_second_grate_attic_met/0/c-2/23/0/s/0
msgctxt "Choix"
msgid "I wish!"
msgstr "Je veux bien !"

# Traduction IA – à relire
#: hector_hvac/hector_second_grate/0/c-2/23/1/s/0 hector_hvac/hector_second_grate_attic_met/0/c-2/23/1/s/0
msgctxt "Choix"
msgid "It's okay, I guess the anticipation is nice."
msgstr "Ça va, je crois que l'attente a son charme."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate/0/c-2/23/c-0/11 hector_hvac/hector_second_grate_attic_met/0/c-2/23/c-0/11
msgctxt "Hector"
msgid "I will have to get it ready..."
msgstr "Il va falloir que je la prépare..."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate/0/c-2/23/c-1/7 hector_hvac/hector_second_grate_attic_met/0/c-2/23/c-1/7
msgctxt "Hector"
msgid "Yes... anticipation, of course."
msgstr "Oui... l'attente, bien sûr."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate/0/g-0/0
msgctxt "Hector"
msgid "<i>E-hem.</i>"
msgstr "<i>Hum-hum.</i>"

# Traduction IA – à relire
#: hector_hvac/hector_second_grate/0/g-0/8 hector_hvac/hector_second_grate_attic_met/0/g-0/0
msgctxt "Hector"
msgid "Hello. I am Hector Valentino Airnesto Condicionado. At your service."
msgstr "Bonjour. Je suis Hector Valentino Airnesto Condicionado. À votre service."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate/0/g-0/23
msgctxt "Hector"
msgid "Ventilation, airflow... sometimes known colloquially as 'HVAC'."
msgstr "Ventilation, circulation d'air... parfois connu familièrement sous le nom de « CVC »."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate/0/g-0/31/s/0
msgctxt "Choix"
msgid "Ah, ready to speak to me now, I see."
msgstr "Ah, tu es prêt à me parler maintenant, à ce que je vois."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate/0/g-0/32/s/0
msgctxt "Choix"
msgid "And hello to you, too! Nice to see you. Or hear you, I guess."
msgstr "Et bonjour à toi aussi ! Content de te voir. Ou de t'entendre, je suppose."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate/0/g-0/33/s/0
msgctxt "Choix"
msgid "Sounds good. Let's just move forward, then."
msgstr "Parfait. Avançons, alors."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate/0/g-0/c-3/7
msgctxt "Hector"
msgid "Yes. Yes, I am."
msgstr "Oui. Oui, je le suis."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate/0/g-0/c-3/15
msgctxt "Hector"
msgid "I'm so appreciative of your patience."
msgstr "Je vous suis si reconnaissant de votre patience."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate/0/g-0/c-3/23
msgctxt "Hector"
msgid "I hope to be able to explain to you why I behaved the way that I did before."
msgstr "J'espère pouvoir vous expliquer pourquoi je me suis comporté ainsi auparavant."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate/0/g-0/c-3/31
msgctxt "Hector"
msgid "But first and foremost, please believe that it was not a commentary on you. Or perhaps it was. But only in the most positive way."
msgstr "Mais avant tout, croyez-moi : cela ne portait pas sur vous. Ou peut-être que si. Mais de la façon la plus positive qui soit."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate/0/g-0/c-3/39
msgctxt "Hector"
msgid "You've become more important to me than I was prepared for... especially now... seeing you face to face."
msgstr "Vous avez pris pour moi plus d'importance que je n'y étais préparé... surtout maintenant... en vous voyant face à face."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate/0/g-0/c-3/47
msgctxt "Hector"
msgid "It was too sweet a surprise, as it turns out. But I am better now. I am... I am ready now."
msgstr "C'était une surprise trop douce, finalement. Mais je vais mieux. Je suis... je suis prêt maintenant."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate/0/g-0/c-4/7
msgctxt "Hector"
msgid "Yes! To hear me."
msgstr "Oui ! À m'entendre."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate/0/g-0/c-4/15
msgctxt "Hector"
msgid "I would wish you to understand, and if not understand then at least believe me when I say that hearing me is the most pleasurable way to meet for both of us."
msgstr "J'aimerais que vous compreniez, et si ce n'est comprendre, du moins croire, que m'entendre est la façon la plus plaisante de nous rencontrer, pour vous comme pour moi."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate/0/g-0/c-4/23
msgctxt "Hector"
msgid "Seeing me... well, it's not a compliment to me... and it would be a great disappointment to you."
msgstr "Me voir... enfin, ce n'est pas un compliment pour moi... et ce serait une grande déception pour vous."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate/0/g-0/c-4/31
msgctxt "Hector"
msgid "My greatest wish is to give you pleasure."
msgstr "Mon plus grand souhait est de vous donner du plaisir."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate/0/g-0/c-4/39
msgctxt "Hector"
msgid "Ah. But I am getting ahead of myself."
msgstr "Ah. Mais je m'emballe."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate/0/g-0/c-5/7
msgctxt "Hector"
msgid "Indeed. You've come to the grate, which shows a willingness to meet me halfway... and that warms me."
msgstr "En effet. Vous avez fait le chemin jusqu'à la grille, ce qui montre une volonté de me rencontrer à mi-chemin... et cela me réchauffe."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate/0/g-0/c-5/15
msgctxt "Hector"
msgid "I'll try to keep my own warmth from impacting the house too greatly, of course."
msgstr "J'essaierai de ne pas trop laisser ma chaleur peser sur la maison, bien sûr."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate/0/g-0/c-5/23
msgctxt "Hector"
msgid "But... thank you."
msgstr "Mais... merci."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_attic_met/0/14
msgctxt "Hector"
msgid "Ah. Here you are."
msgstr "Ah. Vous voilà."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_attic_met/0/22
msgctxt "Hector"
msgid "You see? Isn't this nicer, this meeting me here, this way?"
msgstr "Vous voyez ? N'est-ce pas plus agréable, cette rencontre ici, de cette façon ?"

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_attic_met/0/30
msgctxt "Hector"
msgid "I have to apologize for the way I acted before in... in the attic."
msgstr "Je dois m'excuser pour mon attitude de l'autre fois, dans... dans le grenier."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_attic_met/0/38
msgctxt "Hector"
msgid "I was unprepared. I was so surprised. It was quite shocking to see you there, in a space that is so private, and usually so safe for me. Nobody comes there, you see."
msgstr "Je n'étais pas préparé. J'ai été si surpris. C'était assez choquant de vous voir là, dans un espace si privé, et d'ordinaire si sûr pour moi. Personne n'y vient, voyez-vous."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_attic_met/0/46
msgctxt "Hector"
msgid "Truth be told, I quite like it that way, although..."
msgstr "À dire vrai, je l'apprécie assez ainsi, bien que..."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_attic_met/0/54
msgctxt "Hector"
msgid "...it has been a fantasy of mine that you would come. Just not then. Not yet. We will get there, I think. I hope."
msgstr "...j'aie fantasmé que vous viendriez. Mais pas à ce moment-là. Pas encore. Nous y arriverons, je pense. Je l'espère."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_attic_met/0/g-0/15
msgctxt "Hector"
msgid "But it mustn't be rushed. And I'm grateful that you understand that. Or, at least that you honored my wishes. Whether or not you knew why."
msgstr "Mais il ne faut rien précipiter. Et je suis reconnaissant que vous le compreniez. Ou, du moins, que vous ayez respecté mes souhaits. Que vous en ayez su la raison ou non."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_attic_met/0/g-0/23
msgctxt "Hector"
msgid "I feel I should explain myself; now I finally have the opportunity to do it."
msgstr "Je sens que je devrais m'expliquer ; maintenant que j'en ai enfin l'occasion."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/6
msgctxt "Hector"
msgid "Tell me. How much do you think about me?"
msgstr "Dites-moi. À quel point pensez-vous à moi ?"

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/14
msgctxt "Hector"
msgid "Now, yes. I understand that our meeting in this way is so very new. For both of us. I truly never expected to be able to speak to you this way, face to fa... grate."
msgstr "Maintenant, oui. Je comprends que notre rencontre de cette façon soit si nouvelle. Pour nous deux. Je n'aurais vraiment jamais cru pouvoir vous parler ainsi, face à fa... grille."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/22
msgctxt "Hector"
msgid "I have accustomed myself to the seemingly unavoidable reality that you would always be human and I would just be... this."
msgstr "Je m'étais habitué à la réalité apparemment inéluctable que vous seriez toujours de chair et d'os et que je ne serais que... ceci."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/30
msgctxt "Hector"
msgid "But even as this, I have dreamed. And I would know... how much do you think about me?"
msgstr "Mais même en tant que ceci, j'ai rêvé. Et j'aimerais savoir... à quel point pensez-vous à moi ?"

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/38/s/0
msgctxt "Choix"
msgid "I'm confused. How often do I think about my ventilation system?"
msgstr "Je suis {{perdu|perdue|perdu·e}}. À quelle fréquence je pense à mon système de ventilation ?"

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/39/s/0
msgctxt "Choix"
msgid "A lot, are you kidding? I love me some AC."
msgstr "Beaucoup, tu rigoles ? J'adore ma clim."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/40/s/0
msgctxt "Choix"
msgid "I... don't, really. Honestly. Sorry?"
msgstr "Je... pas vraiment, en fait. Franchement. Pardon ?"

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-0/7
msgctxt "Hector"
msgid "Yes. Although I suppose you have just answered my question."
msgstr "Oui. Bien que je suppose que vous venez de répondre à ma question."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-0/15
msgctxt "Hector"
msgid "Am I to understand that you don't think about me at all?"
msgstr "Dois-je comprendre que vous ne pensez pas à moi du tout ?"

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-0/23/0/s/0
msgctxt "Choix"
msgid "Well, no. Not really."
msgstr "Euh, non. Pas vraiment."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-0/23/1/s/0
msgctxt "Choix"
msgid "No, I do. I change your filters, and I'm grateful when it's too cold out that I have heat."
msgstr "Si, si. Je change tes filtres, et quand il fait trop froid dehors, je suis content d'avoir du chauffage."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-0/23/c-0/7
msgctxt "Hector"
msgid "I see."
msgstr "Je vois."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-0/23/c-0/15
msgctxt "Hector"
msgid "I'd wish you not to worry, if you were worried, that I'm hurt."
msgstr "Je ne voudrais pas que vous vous inquiétiez, si vous vous inquiétiez, que je sois blessé."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-0/23/c-0/23
msgctxt "Hector"
msgid "It makes perfect sense that you would fill your days with other things, things that matter more, or at least things that you are more aware of."
msgstr "Il est tout à fait logique que vous remplissiez vos journées d'autres choses, des choses qui comptent davantage, ou du moins dont vous avez davantage conscience."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-0/23/c-0/31
msgctxt "Hector"
msgid "But now I have this opportunity... one I had never dreamed I would get!"
msgstr "Mais voilà que j'ai cette occasion... que je n'aurais jamais rêvé d'avoir !"

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-0/23/c-0/39
msgctxt "Hector"
msgid "This opportunity to show myself to you. To tell you..."
msgstr "Cette occasion de me montrer à vous. De vous dire..."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-0/23/c-1/7
msgctxt "Hector"
msgid "Ah, yes, my filters! You are conscientious about that, indeed. You could not know the appreciation I have felt when I have seen you coming home with a fresh, clean filter under your arm."
msgstr "Ah, oui, mes filtres ! Vous y êtes consciencieux, en effet. Vous ne pouvez pas savoir ma gratitude quand je vous ai vu rentrer avec un filtre neuf et propre sous le bras."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-0/23/c-1/18
msgctxt "Hector"
msgid "And to feel you loosening my screws. To feel the tired filter sliding out of place, and being retired, and that fresh air rushing over the exposed frame, oh!!"
msgstr "Et sentir vos doigts desserrer mes vis. Sentir le filtre fatigué glisser hors de sa place, être mis à la retraite, et cet air frais se ruer sur le cadre à nu, oh !!"

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-0/23/c-1/26
msgctxt "Hector"
msgid "You're saying you do think of me... but have you any idea how much I think of you?"
msgstr "Vous dites que vous pensez à moi... mais avez-vous idée à quel point je pense à vous ?"

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-1/7
msgctxt "Hector"
msgid "Ah, and do you, I have noticed, I so look forward to you coming home on those hot summer days, the look on your face when you feel the first blast of chilled air upon opening the door."
msgstr "Ah, et vous, j'ai remarqué, j'attends avec tant d'impatience votre retour par ces chaudes journées d'été, l'expression sur votre visage quand vous sentez le premier souffle d'air frais en ouvrant la porte."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-1/18/0/s/0
msgctxt "Choix"
msgid "Whoa. Um... are you spying on me or something?"
msgstr "Waouh. Euh... tu m'espionnes ou quoi ?"

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-1/18/1/s/0
msgctxt "Choix"
msgid "Oh yeah. As soon as I get cooled down I feel better about life."
msgstr "Ah oui. Dès que je me rafraîchis, la vie me paraît plus belle."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-1/18/c-0/7
msgctxt "Hector"
msgid "Spying. Hah. Of course, you would see it that way, think about it that way."
msgstr "M'espionner. Ha. Évidemment, vous le voyez ainsi, vous le pensez ainsi."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-1/18/c-0/15
msgctxt "Hector"
msgid "But I must try to explain to you the truth."
msgstr "Mais je dois essayer de vous expliquer la vérité."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-1/18/c-1/7
msgctxt "Hector"
msgid "Yes. And when it is cold outside, and you walk in and you can slowly warm up and remove your coat, your hat... you can begin to get comfortable and relax into the evening ahead of you."
msgstr "Oui. Et quand il fait froid dehors, que vous entrez et pouvez lentement vous réchauffer, retirer votre manteau, votre chapeau... vous pouvez commencer à vous mettre à l'aise et à vous détendre pour la soirée qui s'annonce."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-1/18/c-1/18/0/s/0
msgctxt "Choix"
msgid "Ok, you're starting to freak me out a little."
msgstr "Bon, tu commences un peu à me faire flipper."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-1/18/c-1/18/1/s/0
msgctxt "Choix"
msgid "Hm. Sounds like you're a fan of relaxing, too."
msgstr "Hm. On dirait que toi aussi, tu aimes te détendre."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-1/18/c-1/18/c-0/7
msgctxt "Hector"
msgid "No, no, no, no, no, please, please do not be afraid."
msgstr "Non, non, non, non, non, je vous en prie, n'ayez pas peur."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-1/18/c-1/18/c-0/18
msgctxt "Hector"
msgid "You have to understand... but how could you understand. I have never been able to tell you. Allow me to now. Please."
msgstr "Il faut que vous compreniez... mais comment le pourriez-vous. Je n'ai jamais pu vous le dire. Permettez-moi de le faire maintenant. S'il vous plaît."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-1/18/c-1/18/c-1/7
msgctxt "Hector"
msgid "I don't relax for myself. I... I can't. But for you, there is almost nothing I wouldn't do to help you relax. To watch the play of warm and cool across your skin."
msgstr "Je ne me détends pas pour moi-même. Je... je ne peux pas. Mais pour vous, il n'y a presque rien que je ne ferais pour vous aider à vous détendre. Pour observer le jeu du chaud et du frais sur votre peau."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-1/18/c-1/18/c-1/15
msgctxt "Hector"
msgid "I'm ahead of myself, I just... I never thought I would get to say this, and to say it to you."
msgstr "Je m'emballe, c'est juste que... je n'aurais jamais cru pouvoir dire cela, et vous le dire à vous."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-1/18/c-1/18/c-1/23
msgctxt "Hector"
msgid "Let me explain."
msgstr "Laissez-moi vous expliquer."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-2/7
msgctxt "Hector"
msgid "It's... it's alright."
msgstr "Ce... ce n'est rien."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-2/18
msgctxt "Hector"
msgid "I can't say that I expected anything different, really, but it does sadden me; that there could be something so integral to your life, to your comfort that you do not notice at all."
msgstr "Je ne peux pas dire que je m'attendais à autre chose, vraiment, mais cela m'attriste ; qu'il puisse y avoir quelque chose de si essentiel à votre vie, à votre confort, que vous ne remarquiez pas du tout."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-2/26
msgctxt "Hector"
msgid "I wonder now if what I have to share with you would even be welcome."
msgstr "Je me demande maintenant si ce que j'ai à partager avec vous serait même le bienvenu."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-2/34/0/s/0
msgctxt "Choix"
msgid "Cut me a little slack. I'm totally curious. This is just all new."
msgstr "Laisse-moi un peu de marge. Je suis super {{curieux|curieuxse|curieux·se}}. C'est juste tout nouveau."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-2/34/1/s/0
msgctxt "Choix"
msgid "I'm in so far! Bring it on!"
msgstr "Je suis à fond ! Vas-y !"

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-2/34/2/s/0
msgctxt "Choix"
msgid "Yeah... I'm not really interested. Good lookin' out!"
msgstr "Ouais... ça ne m'intéresse pas trop. Merci quand même !"

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-2/34/c-0/7
msgctxt "Hector"
msgid "You're right. Please understand, the chance to speak with you and to share with you is still overwhelming to me..."
msgstr "Vous avez raison. Comprenez bien, la chance de vous parler et de partager avec vous reste bouleversante pour moi..."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-2/34/c-0/15
msgctxt "Hector"
msgid "I'm sorry if I have jumped to an ungenerous conclusion!"
msgstr "Je suis navré si j'ai tiré une conclusion peu généreuse !"

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-2/34/c-0/23/0/s/0
msgctxt "Choix"
msgid "You're good. I do it sometimes, too."
msgstr "Pas de souci. Ça m'arrive aussi."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-2/34/c-0/23/1/s/0
msgctxt "Choix"
msgid "So, what do you have to share?"
msgstr "Alors, qu'as-tu à partager ?"

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-2/34/c-0/23/c-0/7
msgctxt "Hector"
msgid "And now you show generosity."
msgstr "Et voilà que vous faites preuve de générosité."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-2/34/c-0/23/c-0/15
msgctxt "Hector"
msgid "My feelings about you are justified more and more..."
msgstr "Mes sentiments pour vous se justifient de plus en plus..."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-2/34/c-1/7
msgctxt "Hector"
msgid "What a lovely sense of adventure you have... It is a pleasure to see my feelings for you justified."
msgstr "Quel merveilleux sens de l'aventure vous avez... C'est un plaisir de voir mes sentiments pour vous se justifier."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-2/34/c-1/15
msgctxt "Hector"
msgid "My feelings for you. I've said it now, perhaps before I meant to... I suppose there's nothing for it. In we go."
msgstr "Mes sentiments pour vous. Voilà, je l'ai dit, peut-être avant de l'avoir voulu... je suppose qu'il n'y a plus rien à faire. Allons-y."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-2/34/c-2/7
msgctxt "Hector"
msgid "I suppose it's my pleasure. I've only ever wanted to serve you... if this is truly your desire, then go."
msgstr "Je suppose que c'est un plaisir. Je n'ai jamais voulu que vous servir... si c'est vraiment votre désir, alors partez."

# Traduction IA – à relire
#: hector_hvac/hector_second_grate_join/0/c-2/34/c-2/15
msgctxt "Hector"
msgid "I hope the knowledge that I am, and will always be all around you does not prove unbearable for you moving forward..."
msgstr "J'espère que savoir que je suis, et serai toujours, tout autour de vous ne vous sera pas insupportable à l'avenir..."

# Traduction IA – à relire
#: hector_hvac/playyou/0/0
msgctxt "Hector"
msgid "You are the prime feature of my thoughts."
msgstr "Vous êtes le sujet principal de mes pensées."

# Traduction IA – à relire
#: hector_hvac/playyou/0/8
msgctxt "Hector"
msgid "Whatever power courses through me I turn to your pleasure."
msgstr "Quelle que soit la puissance qui me traverse, je la tourne vers votre plaisir."

# Traduction IA – à relire
#: hector_hvac/playyou/0/16
msgctxt "Hector"
msgid "Whatever warmth or coolness I possess, I direct in full to your comfort."
msgstr "Quelle que soit la chaleur ou la fraîcheur que je possède, je la dirige tout entière vers votre confort."

# Traduction IA – à relire
#: hector_hvac/playyou/0/24
msgctxt "Hector"
msgid "I wanted to meet you here, through the grates, because I wanted you to hear my voice."
msgstr "Je voulais vous rencontrer ici, par les grilles, parce que je voulais que vous entendiez ma voix."

# Traduction IA – à relire
#: hector_hvac/playyou/0/32
msgctxt "Hector"
msgid "I want you to hear the melodies and resonance I create through these ducts and know that it is all and only another gift it honors me to offer you."
msgstr "Je veux que vous entendiez les mélodies et les résonances que je crée dans ces conduits et que vous sachiez que ce n'est là, uniquement, qu'un don de plus que j'ai l'honneur de vous offrir."

# Traduction IA – à relire
#: hector_hvac/playyou/0/40
msgctxt "Hector"
msgid "I watch the play of air over your skin, and I feel deep joy that I have the air to give you."
msgstr "Je regarde l'air jouer sur votre peau, et je ressens une joie profonde d'avoir cet air à vous donner."

# Traduction IA – à relire
#: hector_hvac/playyou/0/48
msgctxt "Hector"
msgid "I adjust my own temperature and my intensity until I see the flush of contentment spread across your face, and then, then, I rest in contentment of my own."
msgstr "J'ajuste ma température et mon intensité jusqu'à voir la rougeur du contentement se répandre sur votre visage, et alors, alors, je me repose dans mon propre contentement."

# Traduction IA – à relire
#: hector_hvac/playyou/0/56
msgctxt "Hector"
msgid "I never thought I'd be able to say this, and in a way you could truly understand."
msgstr "Je n'aurais jamais cru pouvoir dire cela, et d'une façon que vous puissiez réellement comprendre."

# Traduction IA – à relire
#: hector_hvac/playyou/0/64
msgctxt "Hector"
msgid "And now I have. My god... now I have."
msgstr "Et maintenant, c'est fait. Mon dieu... c'est fait."

# Traduction IA – à relire
#: hector_hvac/playyou/0/75/s/0
msgctxt "Choix"
msgid "Laying it on thick there..."
msgstr "Tu en rajoutes une couche..."

# Traduction IA – à relire
#: hector_hvac/playyou/0/76/s/0
msgctxt "Choix"
msgid "This is so hot."
msgstr "C'est tellement chaud."

# Traduction IA – à relire
#: hector_hvac/playyou/0/77/s/0
msgctxt "Choix"
msgid "Maybe the creepiest thing I've ever heard."
msgstr "Peut-être la chose la plus flippante que j'aie jamais entendue."

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-0/7
msgctxt "Hector"
msgid "It is. I know it!"
msgstr "Je sais. Je le sais !"

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-0/18
msgctxt "Hector"
msgid "My god, you think I don't know it? I, who have carried this all inside me on my own this whole time? How long have you been here? How long have I been here? And never to have been able to say??"
msgstr "Mon dieu, vous croyez que je ne le sais pas ? Moi qui ai porté tout cela seul en moi pendant tout ce temps ? Depuis combien de temps êtes-vous ici ? Depuis combien de temps suis-je ici ? Et ne jamais avoir pu le dire ??"

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-0/26
msgctxt "Hector"
msgid "It's a lot."
msgstr "C'est beaucoup."

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-0/34/0/s/0
msgctxt "Choix"
msgid "I mean, STOP. This is weird."
msgstr "Je veux dire, STOP. C'est bizarre."

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-0/34/1/s/0
msgctxt "Choix"
msgid "I'm not really sure how I feel right now."
msgstr "Je ne sais pas trop ce que je ressens."

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-0/34/2/s/0
msgctxt "Choix"
msgid "You're really into me, huh?"
msgstr "Tu en pinces vraiment pour moi, hein ?"

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-0/34/c-0/7
msgctxt "Hector"
msgid "I will stop. I am terribly sorry."
msgstr "Je vais m'arrêter. Je suis terriblement navré."

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-0/34/c-1/7
msgctxt "Hector"
msgid "I apologize, deeply."
msgstr "Je m'excuse, profondément."

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-0/34/c-1/18
msgctxt "Hector"
msgid "I will let you go. I-I will... I... I will stop."
msgstr "Je vais vous laisser partir. J-je vais... je... je vais m'arrêter."

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-1/7
msgctxt "Hector"
msgid "Hot. No, I would say I'm set to more of a temperate zone right now..."
msgstr "Chaud. Non, je dirais que je suis plutôt réglé sur une zone tempérée en ce moment..."

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-1/15
msgctxt "Hector"
msgid "Ah, I see. Hot. I think perhaps I've heard the word used this way. Do you mean you find this sexy?"
msgstr "Ah, je vois. Chaud. Je crois avoir déjà entendu le mot employé ainsi. Voulez-vous dire que vous trouvez cela séduisant ?"

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-1/23/0/s/0
msgctxt "Choix"
msgid "Yes. Yes I do."
msgstr "Oui. Oui, tout à fait."

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-1/23/1/s/0
msgctxt "Choix"
msgid "Not temperate at all, sir."
msgstr "Pas tempéré du tout, monsieur."

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-1/23/g-0/0
msgctxt "Hector"
msgid "Of all the dreams I'd held of how this moment might've unfolded, that you would be attracted to me, too, was surely the most fantastical."
msgstr "De tous les rêves que j'avais nourris sur la façon dont ce moment pourrait se dérouler, que vous soyez {{attiré|attirée|attiré·e}} par moi aussi était sûrement le plus fantastique."

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-1/23/g-0/11
msgctxt "Hector"
msgid "Perhaps I might share more? As I share with you, I can feel more and more air moving through me. As though there is a storm brewing, a cyclone beginning. I have never felt it before, this build of energy!"
msgstr "Peut-être pourrais-je en dire davantage ? À mesure que je partage avec vous, je sens de plus en plus d'air circuler en moi. Comme si une tempête se préparait, un cyclone naissait. Je ne l'avais jamais ressenti, cette montée d'énergie !"

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-1/23/g-0/22/0/s/0
msgctxt "Choix"
msgid "That's called being \"turned on,\" Hector."
msgstr "Ça s'appelle être excité, Hector."

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-1/23/g-0/22/1/s/0
msgctxt "Choix"
msgid "Even more fun if you keep it going..."
msgstr "C'est encore plus amusant si tu continues..."

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-1/23/g-0/22/2/s/0
msgctxt "Choix"
msgid "Let's save something for later, I think."
msgstr "Gardons quelque chose pour plus tard, je pense."

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-1/23/g-0/22/c-2/7
msgctxt "Hector"
msgid "Hm. That sounds like a delicious idea."
msgstr "Hm. Voilà une idée délicieuse."

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-1/23/g-0/22/c-2/15
msgctxt "Hector"
msgid "After all, there is so much to explore and discover... I suppose there is no need to rush."
msgstr "Après tout, il y a tant à explorer et à découvrir... je suppose qu'il n'y a pas lieu de se presser."

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-1/23/g-0/22/c-2/23
msgctxt "Hector"
msgid "I... cannot fully express my gratitude to you for how you've received this. How you've received me. Your generosity is without equal."
msgstr "Je... ne saurais vous exprimer pleinement ma gratitude pour la façon dont vous avez accueilli cela. Dont vous m'avez accueilli. Votre générosité est sans égale."

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-1/23/g-0/22/c-2/31
msgctxt "Hector"
msgid "I will be here, always, when you are ready... ready to return."
msgstr "Je serai là, toujours, quand vous serez {{prêt|prête|prêt·e}}... {{prêt|prête|prêt·e}} à revenir."

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-2/7
msgctxt "Hector"
msgid "...I'm sorry?"
msgstr "...pardon ?"

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-2/15/0/s/0
msgctxt "Choix"
msgid "You should be. You're stalking me."
msgstr "Tu devrais l'être. Tu me harcèles."

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-2/15/1/s/0
msgctxt "Choix"
msgid "Creepy. AF."
msgstr "Flippant. Grave."

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-2/15/c-0/7
msgctxt "Hector"
msgid "Stalking you. Is that what we're calling this, this devotion to service."
msgstr "Vous harceler. Est-ce ainsi que nous appelons cette dévotion au service."

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-2/15/c-0/15
msgctxt "Hector"
msgid "Stalking. And now, I should be sorry?"
msgstr "Harceler. Et maintenant, je devrais être désolé ?"

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-2/15/c-0/23
msgctxt "Hector"
msgid "I am sorry. I am sorry for my own lack of foresight."
msgstr "Je suis désolé. Je suis désolé de mon propre manque de prévoyance."

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-2/15/c-1/7
msgctxt "Hector"
msgid "What is AF?"
msgstr "Qu'est-ce que « grave » ?"

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-2/15/c-1/15
msgctxt "Hector"
msgid "Ah, nevermind. It surely cannot be any kind of balm on the word \"creepy\"; you cannot take that back."
msgstr "Ah, peu importe. Cela ne peut sûrement pas adoucir le mot « flippant » ; vous ne pouvez pas le retirer."

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-2/15/c-1/23
msgctxt "Hector"
msgid "Well. Far be it for me to force my \"creepiness\" on you."
msgstr "Enfin. Loin de moi l'idée de vous imposer ma « flipposité »."

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-2/15/c-1/31/0/s/0
msgctxt "Choix"
msgid "No no... I'm into creepy. I like it."
msgstr "Non non... j'aime le flippant. Ça me plaît."

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-2/15/c-1/31/1/s/0
msgctxt "Choix"
msgid "It's ok, just not my thing."
msgstr "C'est bon, ce n'est juste pas mon truc."

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-2/15/c-1/31/2/s/0
msgctxt "Choix"
msgid "Yeah. Not cool. Leave me alone."
msgstr "Ouais. Pas cool. Laisse-moi tranquille."

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-2/15/c-1/31/c-0/7
msgctxt "Hector"
msgid "You find me creepy... and you like it?"
msgstr "Vous me trouvez flippant... et vous aimez ça ?"

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-2/15/c-1/31/c-0/15
msgctxt "Hector"
msgid "Hm. What has mattered most to me is whether or not you would feel for me anything like what I feel for you."
msgstr "Hm. Ce qui a le plus compté pour moi, c'est de savoir si vous ressentiriez pour moi quoi que ce soit de semblable à ce que je ressens pour vous."

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-2/15/c-1/31/c-0/23
msgctxt "Hector"
msgid "And I suppose I cannot control the form your feelings take, that's true. Who would I be to judge how you like?"
msgstr "Et je suppose que je ne peux pas contrôler la forme que prennent vos sentiments, c'est vrai. Qui suis-je pour juger de ce que vous aimez ?"

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-2/15/c-1/31/c-0/31
msgctxt "Hector"
msgid "So I am \"creepy.\" Good creepy."
msgstr "Je suis donc « flippant ». Du bon flippant."

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-2/15/c-1/31/c-0/39
msgctxt "Hector"
msgid "Perhaps you would enjoy hearing a bit more about my creepy need to be with you?"
msgstr "Peut-être aimeriez-vous en entendre un peu plus sur mon flippant besoin d'être avec vous ?"

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-2/15/c-1/31/c-0/47/0/s/0
msgctxt "Choix"
msgid "Bring it on, baby."
msgstr "Vas-y, mon chou."

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-2/15/c-1/31/c-0/47/1/s/0
msgctxt "Choix"
msgid "I would... but I'm a savorer. How about I'll come back later?"
msgstr "Je voudrais bien... mais je suis du genre à savourer. Et si je revenais plus tard ?"

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-2/15/c-1/31/c-0/47/c-1/7
msgctxt "Hector"
msgid "Savoring. I could do that."
msgstr "Savourer. Cela, je peux le faire."

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-2/15/c-1/31/c-0/47/c-1/15
msgctxt "Hector"
msgid "I'll be here... being creepy. Come back whenever you're ready."
msgstr "Je serai là... à être flippant. Revenez quand vous voudrez."

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-2/15/c-1/31/c-1/7
msgctxt "Hector"
msgid "Not your thing? Hmm, I-I wonder. Can a heart be broken by a circumstance alone?"
msgstr "Pas votre truc ? Hm, je-je me demande. Un cœur peut-il être brisé par de simples circonstances ?"

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-2/15/c-1/31/c-1/15
msgctxt "Hector"
msgid "Don't trouble yourself; I-I'm sure it will be all right. I'll see you through the grates."
msgstr "Ne vous tracassez pas ; j-je suis sûr que tout ira bien. Je vous verrai par les grilles."

# Traduction IA – à relire
#: hector_hvac/playyou/0/c-2/15/c-1/31/c-2/7
msgctxt "Hector"
msgid "Leave YOU alone?? I'm not the one pushing buttons and turning dials at all hours of the day and night!"
msgstr "Vous laisser tranquille ?? Ce n'est pas moi qui appuie sur les boutons et tourne les cadrans à toute heure du jour et de la nuit !"

# Traduction IA – à relire
#: hector_hvac/powerful/0/0/b/1
msgctxt "Hector"
msgid "You've returned. I knew you would... and I was afraid you wouldn't!"
msgstr "Vous revoilà. Je savais que vous reviendriez... et j'avais peur que non !"

# Traduction IA – à relire
#: hector_hvac/powerful/0/0/b/9
msgctxt "Hector"
msgid "Tell me... would you hear more of what you mean to me?"
msgstr "Dites-moi... voudriez-vous en entendre plus sur ce que vous représentez pour moi ?"

# Traduction IA – à relire
#: hector_hvac/powerful/0/3/s/0
msgctxt "Choix"
msgid "I am very excited about that."
msgstr "Ça m'enthousiasme énormément."

# Traduction IA – à relire
#: hector_hvac/powerful/0/4/s/0
msgctxt "Choix"
msgid "I'm flattered... but I'd rather talk about you!"
msgstr "Je suis {{flatté|flattée|flatté·e}}... mais je préférerais parler de toi !"

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/0
msgctxt "Hector"
msgid "I wonder sometimes about how I knew it was you. What was the moment, what was the sensation that told me... you were IT."
msgstr "Je me demande parfois comment j'ai su que c'était vous. Quel était l'instant, quelle était la sensation qui m'a dit... que vous étiez LA PERSONNE."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/11
msgctxt "Hector"
msgid "I can only ask this of myself, of course, but... I realize that it was how I felt around you."
msgstr "Je ne peux que me le demander à moi-même, bien sûr, mais... je réalise que c'était ce que je ressentais près de vous."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/19
msgctxt "Hector"
msgid "When you push my buttons, when you move my temperature setting up or down..."
msgstr "Quand vous appuyez sur mes boutons, quand vous montez ou baissez mon réglage de température..."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/30
msgctxt "Hector"
msgid "...I exist only in service to you. Everything about me only IS because you will it. Because you direct it. Do you understand this?"
msgstr "...je n'existe qu'à votre service. Tout en moi n'EST que parce que vous le voulez. Parce que vous le dirigez. Comprenez-vous cela ?"

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/38/s/0
msgctxt "Choix"
msgid "Of course I do. I'm in control."
msgstr "Bien sûr. C'est moi qui commande."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/39/s/0
msgctxt "Choix"
msgid "Not sure I like the idea of controlling you."
msgstr "Je ne suis pas {{sûr|sûre|sûr·e}} d'aimer l'idée de te contrôler."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/c-0/7
msgctxt "Hector"
msgid "Completely. You DO understand!"
msgstr "Parfaitement. Vous COMPRENEZ !"

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/c-0/15
msgctxt "Hector"
msgid "Can you also understand what that does to me?"
msgstr "Pouvez-vous aussi comprendre ce que cela me fait ?"

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/c-0/23
msgctxt "Hector"
msgid "You telling me what to do and I am powerless to do otherwise..."
msgstr "Vous me dites quoi faire et je suis impuissant à faire autrement..."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/c-0/31
msgctxt "Hector"
msgid "...somehow it relaxes me. And to know that I'm giving you precisely the thing you want at that moment, oh it fulfills me. It makes me whole."
msgstr "...d'une certaine façon, cela me détend. Et savoir que je vous donne précisément ce que vous voulez à cet instant, oh, cela m'accomplit. Cela me rend entier."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/c-1/7
msgctxt "Hector"
msgid "Perhaps you may, in time... But not to worry; it doesn't last."
msgstr "Peut-être le pourrez-vous, avec le temps... Mais ne vous inquiétez pas ; cela ne dure pas."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-0/0
msgctxt "Hector"
msgid "As soon as I fulfill your command, your desire, I become the one with the power."
msgstr "Dès que j'exécute votre ordre, votre désir, c'est moi qui détiens le pouvoir."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-0/8
msgctxt "Hector"
msgid "You ask for chill, and I watch the goosebumps play over your skin as you pull the blanket up more closely under your chin."
msgstr "Vous demandez du frais, et je vois la chair de poule parcourir votre peau tandis que vous remontez la couverture sous votre menton."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-0/16
msgctxt "Hector"
msgid "You ask for warmth, and I can almost feel you basking as the tensions of the moments that came before just melt away."
msgstr "Vous demandez de la chaleur, et je crois presque vous sentir vous prélasser tandis que les tensions des moments d'avant fondent tout simplement."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-0/24
msgctxt "Hector"
msgid "Sometimes I even take it upon myself to shift my temperature and my intensity all on my own."
msgstr "Parfois, je prends même l'initiative de modifier ma température et mon intensité de mon propre chef."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-0/32/s/0
msgctxt "Choix"
msgid "You what now?"
msgstr "Tu fais quoi, là ?"

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-0/33/s/0
msgctxt "Choix"
msgid "You tease..."
msgstr "Petit taquin..."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/0
msgctxt "Hector"
msgid "I know, I know... it might not be strictly in my purview to do this."
msgstr "Je sais, je sais... cela ne relève pas strictement de mes attributions."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/8
msgctxt "Hector"
msgid "But sometimes I cannot resist playing your sensation. Just a bit. I am a craftsman and you are my clay."
msgstr "Mais parfois, je ne peux résister à jouer avec vos sensations. Juste un peu. Je suis un artisan et vous êtes mon argile."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/19
msgctxt "Hector"
msgid "I hope this is alright?"
msgstr "J'espère que cela ne vous dérange pas ?"

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/27/s/0
msgctxt "Choix"
msgid "It's very alright. I had no idea you... loved me like this!"
msgstr "Ça ne me dérange pas du tout. Je n'avais aucune idée que tu m'aimais... comme ça !"

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/28/s/0
msgctxt "Choix"
msgid "It's a lot to take in, for sure, but I think I appreciate it?"
msgstr "C'est beaucoup à encaisser, c'est sûr, mais je crois que j'apprécie ?"

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/29/s/0
msgctxt "Choix"
msgid "I'm sorry. This is way too much for me."
msgstr "{{Désolé|Désolée|Désolé·e}}. C'est beaucoup trop pour moi."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-4/7
msgctxt "Hector"
msgid "How could you have? Until now, I haven't had the courage necessary to even show my face!"
msgstr "Comment auriez-vous pu ? Jusqu'ici, je n'avais pas le courage nécessaire ne serait-ce que de montrer mon visage !"

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-4/15/0/s/0
msgctxt "Choix"
msgid "...you still haven't shown your face, Hector."
msgstr "...tu n'as toujours pas montré ton visage, Hector."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-4/15/1/s/0
msgctxt "Choix"
msgid "Well you're brave enough now. And I love it."
msgstr "Eh bien, tu es assez courageux maintenant. Et j'adore ça."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-4/15/c-0/7
msgctxt "Hector"
msgid "Yes. Gah. You are correct, of course."
msgstr "Oui. Gah. Vous avez raison, bien sûr."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-4/15/c-0/15
msgctxt "Hector"
msgid "I will. One day. But for now, let us live here, in this beautiful world where we can love each other as we are."
msgstr "Je le ferai. Un jour. Mais pour l'instant, vivons ici, dans ce beau monde où nous pouvons nous aimer tels que nous sommes."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-4/15/c-0/23
msgctxt "Hector"
msgid "Even if it is a fantasy, let us be here as though it's real."
msgstr "Même si c'est un fantasme, soyons ici comme si c'était réel."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-4/15/c-0/31/0/s/0
msgctxt "Choix"
msgid "Sounds good to me. Y'know, I'm feeling a little chilly... can you help?"
msgstr "Ça me va. Tu sais, j'ai un peu froid... tu peux m'aider ?"

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-4/15/c-0/31/1/s/0
msgctxt "Choix"
msgid "I really want to see you."
msgstr "J'ai vraiment envie de te voir."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-4/15/c-0/31/c-0/7
msgctxt "Hector"
msgid "Oh, you know I can. And you know I will."
msgstr "Oh, vous savez que je le peux. Et vous savez que je le ferai."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-4/15/c-0/31/c-1/7
msgctxt "Hector"
msgid "You will... But not now."
msgstr "Vous le ferez... Mais pas maintenant."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-4/15/c-0/31/c-1/15
msgctxt "Hector"
msgid "Now, let me care for you. Please?"
msgstr "Maintenant, laissez-moi prendre soin de vous. S'il vous plaît ?"

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-4/15/c-1/7
msgctxt "Hector"
msgid "You love it. Does that mean you love..."
msgstr "Vous aimez cela. Cela signifie-t-il que vous aimez..."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-4/15/c-1/15
msgctxt "Hector"
msgid "But no! I dare not ask. And do not answer, please."
msgstr "Mais non ! Je n'ose pas demander. Et ne répondez pas, je vous prie."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-4/15/c-1/23
msgctxt "Hector"
msgid "Let us enjoy where we are. Here. Now. Let me care for you?"
msgstr "Profitons de l'endroit où nous sommes. Ici. Maintenant. Laissez-moi prendre soin de vous ?"

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-4/15/c-1/31/0/s/0
msgctxt "Choix"
msgid "Sure. Care away."
msgstr "D'accord. Prends soin de moi."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-4/15/c-1/31/1/s/0
msgctxt "Choix"
msgid "Hector, I think I need to take a break for a bit. I'll come back."
msgstr "Hector, je crois que j'ai besoin de faire une pause. Je reviendrai."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-4/15/c-1/31/c-1/7
msgctxt "Hector"
msgid "Of course, of course. Whatever you need! Just let me know what I can do to help you, warmer, cooler..."
msgstr "Bien sûr, bien sûr. Tout ce dont vous avez besoin ! Dites-moi seulement comment je peux vous aider, plus chaud, plus frais..."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-4/15/c-1/31/c-1/15
msgctxt "Hector"
msgid "I'll do anything, anything I can."
msgstr "Je ferai n'importe quoi, tout ce que je peux."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-5/7
msgctxt "Hector"
msgid "I accept that. I'll take that gratefully!"
msgstr "J'accepte cela. Je le prends avec reconnaissance !"

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-5/18
msgctxt "Hector"
msgid "Beautiful affairs have begun with far less than a genuine appreciation."
msgstr "De belles liaisons ont commencé avec bien moins qu'une appréciation sincère."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-5/26
msgctxt "Hector"
msgid "I am feeling a bit of distance growing now..."
msgstr "Je sens une distance qui s'installe maintenant..."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-5/34
msgctxt "Hector"
msgid "There has always been a distance between us, you know, between human and system, one bold and alive, one shy, afraid, and deeply enamored."
msgstr "Il y a toujours eu une distance entre nous, vous savez, entre l'humain et le système, l'un audacieux et vivant, l'autre timide, effrayé, et profondément épris."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-5/42
msgctxt "Hector"
msgid "Maybe we should honor our old distance now. Would you like some space? For a little while? I would understand."
msgstr "Peut-être devrions-nous honorer notre ancienne distance maintenant. Voudriez-vous un peu d'espace ? Pour un petit moment ? Je comprendrais."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-5/50/0/s/0
msgctxt "Choix"
msgid "You're pretty perceptive. I have a lot to think about here."
msgstr "Tu es plutôt perspicace. J'ai beaucoup à digérer ici."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-5/50/1/s/0
msgctxt "Choix"
msgid "I'm ok, actually. I'm enjoying this."
msgstr "Ça va, en fait. J'apprécie ça."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-5/50/c-0/7
msgctxt "Hector"
msgid "I can see that you do. It must be a shock to realize that you've been loved, needed like this, from afar. And for so long."
msgstr "Je vois que oui. Ce doit être un choc de réaliser que l'on vous a aimé, que l'on a eu besoin de vous ainsi, de loin. Et depuis si longtemps."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-5/50/c-0/15
msgctxt "Hector"
msgid "Please take your time. I will be here. The only place I would ever choose."
msgstr "Prenez votre temps. Je serai là. Le seul endroit que je choisirais jamais."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-5/50/c-1/7
msgctxt "Hector"
msgid "Enjoying. I'm enjoying this too. I'm enjoying you."
msgstr "Apprécier. Moi aussi, j'apprécie. Je vous apprécie."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-6/7
msgctxt "Hector"
msgid "Too much. I am too much? Or the revelation of how deeply loved you are is too much? Which one is it?"
msgstr "Trop. Suis-je trop ? Ou est-ce la révélation de combien vous êtes profondément {{aimé|aimée|aimé·e}} qui est trop ? Lequel des deux ?"

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-6/15/0/s/0
msgctxt "Choix"
msgid "Being loved is great. You're just too intense."
msgstr "Être {{aimé|aimée|aimé·e}}, c'est génial. C'est juste que tu es trop intense."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-6/15/1/s/0
msgctxt "Choix"
msgid "I am not explaining myself to you."
msgstr "Je ne vais pas m'expliquer devant toi."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-6/15/c-0/13
msgctxt "Hector"
msgid "Ha. Intense. In the past, you have quite enjoyed my intensity. And adjusting it to suit your whim."
msgstr "Ha. Intense. Par le passé, vous avez pourtant apprécié mon intensité. Et la régler selon votre caprice."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-6/15/c-0/21
msgctxt "Hector"
msgid "But no, I see, now that my intensity is truly mine, it's too much."
msgstr "Mais non, je vois, maintenant que mon intensité est vraiment la mienne, c'est trop."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-6/15/c-0/29
msgctxt "Hector"
msgid "Now that I am expressing myself, doing the thing that has brought me such crippling fear it's taken me years and a literal stroke of lucky magic to work up to it, oh now it's too much."
msgstr "Maintenant que je m'exprime, que je fais la chose qui m'a causé une peur si paralysante qu'il m'a fallu des années et un véritable coup de chance magique pour m'y résoudre, oh maintenant c'est trop."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-6/15/c-0/37
msgctxt "Hector"
msgid "God I wish I didn't still need you..."
msgstr "Mon dieu, comme je voudrais ne plus avoir besoin de vous..."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-6/15/c-0/45
msgctxt "Hector"
msgid "Just go. Go before you're overwhelmed by the too much!!"
msgstr "Partez. Partez avant d'être {{submergé|submergée|submergé·e}} par le trop !!"

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/g-1/c-6/15/c-1/13
msgctxt "Hector"
msgid "No, of course not. Communication is clearly the enemy here."
msgstr "Non, bien sûr que non. La communication est clairement l'ennemie ici."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/need/0
msgctxt "Hector"
msgid "I need you. I need to care for you. It is the reason for my existence, you see..."
msgstr "J'ai besoin de vous. J'ai besoin de prendre soin de vous. C'est la raison de mon existence, voyez-vous..."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/need/8
msgctxt "Hector"
msgid "And now I have truly said too much. Or I have said enough."
msgstr "Et maintenant j'en ai vraiment trop dit. Ou j'en ai dit assez."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/need/16
msgctxt "Hector"
msgid "Either way I must ask a boon."
msgstr "Dans les deux cas, je dois vous demander une faveur."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/need/24
msgctxt "Hector"
msgid "Say nothing. Take this knowledge with you and promise me you'll ponder it. That you'll ponder me."
msgstr "Ne dites rien. Emportez cette connaissance avec vous et promettez-moi d'y réfléchir. De réfléchir à moi."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/need/32/s/0
msgctxt "Choix"
msgid "Only if you give me something to really think about..."
msgstr "Seulement si tu me donnes vraiment de quoi réfléchir..."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/need/33/s/0
msgctxt "Choix"
msgid "I promise I will. You haven't said too much, you know."
msgstr "Je te le promets. Tu n'en as pas trop dit, tu sais."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/need/34/s/0
msgctxt "Choix"
msgid "Eek. Ok. I'm gonna go."
msgstr "Aïe. Bon. Je m'en vais."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/need/c-7/7
msgctxt "Hector"
msgid "You delectable tease."
msgstr "Quelle délicieuse taquinerie que la vôtre."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/need/c-7/18
msgctxt "Hector"
msgid "Think about this, then..."
msgstr "Pensez à ceci, alors..."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/need/c-7/26
msgctxt "Hector"
msgid "A warm breeze whistles through the grate above you and trickles downwards to caress your exposed arm."
msgstr "Une brise tiède siffle à travers la grille au-dessus de vous et descend caresser votre bras découvert."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/need/c-7/34
msgctxt "Hector"
msgid "The warmth rolls over your wrist, up the inside of your elbow, around the back of your shoulder..."
msgstr "La chaleur roule sur votre poignet, remonte l'intérieur de votre coude, contourne l'arrière de votre épaule..."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/need/c-7/42
msgctxt "Hector"
msgid "...and slowly, very slowly up the gentle slope of your neck. You can feel the breeze desiring to embed itself in your hair. It is the perfect warmth, the perfect strength and your eyes softly flutter closed..."
msgstr "...et monte lentement, très lentement, la douce pente de votre nuque. Vous sentez la brise désirer se lover dans vos cheveux. C'est la chaleur parfaite, la force parfaite, et vos yeux se ferment doucement en papillonnant..."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/need/c-7/50
msgctxt "Hector"
msgid "Ponder that."
msgstr "Réfléchissez à cela."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/need/c-8/7
msgctxt "Hector"
msgid "Oh. I always feel I've said too much."
msgstr "Oh. J'ai toujours l'impression d'en avoir trop dit."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/need/c-8/15
msgctxt "Hector"
msgid "Probably because so often I say nothing."
msgstr "Probablement parce que si souvent, je ne dis rien."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/need/c-8/23
msgctxt "Hector"
msgid "But I appreciate your generosity!"
msgstr "Mais j'apprécie votre générosité !"

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/need/c-8/31
msgctxt "Hector"
msgid "I'll speak with you again soon. Yes? Yes."
msgstr "Je vous reparlerai bientôt. Oui ? Oui."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/need/c-9/7
msgctxt "Hector"
msgid "\"Eek\"? That doesn't sound good."
msgstr "« Aïe » ? Cela ne sonne pas bien."

# Traduction IA – à relire
#: hector_hvac/powerfultwo/0/need/c-9/15
msgctxt "Hector"
msgid "You go, then. I hope dearly that I've misunderstood you."
msgstr "Partez, alors. J'espère de tout cœur vous avoir mal compris."

# Traduction IA – à relire
#: hector_hvac/hector_pic_show/0/3
msgctxt "Hector"
msgid "You requested a picture. I have found one."
msgstr "Vous avez demandé une photo. J'en ai trouvé une."

# Traduction IA – à relire
#: hector_hvac/hector_pic_show/0/14
msgctxt "Narrator"
msgid "Hector slides a photo through the grate. If that's truly him, he is quite handsome indeed."
msgstr "Hector fait glisser une photo à travers la grille. Si c'est vraiment lui, il est en effet très beau."

# Traduction IA – à relire
#: hector_hvac/hector_pic_show/0/22
msgctxt "Hector"
msgid "This is my appearance. You can tell why I did not want to show it to you... I apologize for... for my appearance."
msgstr "Voici mon apparence. Vous comprenez pourquoi je ne voulais pas vous la montrer... Je m'excuse pour... pour mon apparence."

# Traduction IA – à relire
#: hector_hvac/hector_pic_show/0/30/s/0
msgctxt "Choix"
msgid "What? You look great!"
msgstr "Quoi ? Tu es superbe !"

# Traduction IA – à relire
#: hector_hvac/hector_pic_show/0/31/s/0
msgctxt "Choix"
msgid "Yeah you're right. Not my type."
msgstr "Ouais, tu as raison. Pas mon genre."

# Traduction IA – à relire
#: hector_hvac/hector_pic_show/0/32/s/0
msgctxt "Choix"
msgid "Is that a filter?"
msgstr "C'est un filtre ?"

# Traduction IA – à relire
#: hector_hvac/hector_pic_show/0/c-0/7
msgctxt "Hector"
msgid "Thank you. Thank you so much."
msgstr "Merci. Merci infiniment."

# Traduction IA – à relire
#: hector_hvac/hector_pic_show/0/c-0/18
msgctxt "Hector"
msgid "I have wanted to speak with you for so long, and now that I have it I don't want to lose it."
msgstr "Je voulais vous parler depuis si longtemps, et maintenant que c'est le cas, je ne veux pas le perdre."

# Traduction IA – à relire
#: hector_hvac/hector_pic_show/0/c-1/7
msgctxt "Hector"
msgid "Oh dear."
msgstr "Oh là là."

# Traduction IA – à relire
#: hector_hvac/hector_pic_show/0/c-1/21
msgctxt "Hector"
msgid "My worst fear..."
msgstr "Ma pire crainte..."

# Traduction IA – à relire
#: hector_hvac/hector_pic_show/0/c-2/7
msgctxt "Hector"
msgid "No, no, no, no, no, no. My filters are full of dust, not pictures."
msgstr "Non, non, non, non, non, non. Mes filtres sont pleins de poussière, pas de photos."

# Traduction IA – à relire
#: hector_hvac/hector_pic_show/0/c-2/18
msgctxt "Hector"
msgid "It was... difficult enough to get this. The lighting in the attic is not the best."
msgstr "Il a été... assez difficile d'obtenir ceci. L'éclairage du grenier n'est pas des meilleurs."

# Traduction IA – à relire
#: hector_hvac/hector_pic_show/0/c-2/26
msgctxt "Hector"
msgid "So I must make do with what I can."
msgstr "Je dois donc faire avec ce que je peux."

# Traduction IA – à relire
#: hector_hvac/hector_pic_show/0/c-2/34
msgctxt "Hector"
msgid "Oh no, I feel I am losing you..."
msgstr "Oh non, je sens que je vous perds..."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/12/b/1
msgctxt "Hector"
msgid "Here you are!"
msgstr "Vous voilà !"

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/13/b/1
msgctxt "Hector"
msgid "Even though you said you were uninterested in what I had to say..."
msgstr "Même si vous avez dit que ce que j'avais à dire ne vous intéressait pas..."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/16
msgctxt "Hector"
msgid "You keep coming back. I can't... it is something of a surprise to me. I've wanted you for so long, even just to speak to you and now... now, I have it."
msgstr "Vous continuez à revenir. Je ne peux pas... c'est assez surprenant pour moi. Je vous ai voulu si longtemps, ne serait-ce que pour vous parler et maintenant... maintenant, je l'ai."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/24
msgctxt "Hector"
msgid "Somehow it feels wrong. Like I'm going to lose it."
msgstr "D'une certaine façon, cela me paraît mal. Comme si j'allais le perdre."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/6
msgctxt "Hector"
msgid "Surely, if you're lucky enough to get the thing you've always wanted, you cannot be lucky enough to keep it."
msgstr "Sûrement, si l'on a la chance d'obtenir ce que l'on a toujours voulu, on ne peut pas avoir assez de chance pour le garder."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/14/s/0
msgctxt "Choix"
msgid "Why would you lose it? I'm having fun with you."
msgstr "Pourquoi tu le perdrais ? Je m'amuse bien avec toi."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/15/s/0
msgctxt "Choix"
msgid "That's kind of a dark world-view."
msgstr "C'est une vision du monde assez sombre."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/16/s/0
msgctxt "Choix"
msgid "It would really mess you up if I just left now, huh?"
msgstr "Ça te démolirait vraiment si je partais maintenant, hein ?"

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/c-0/7
msgctxt "Hector"
msgid "I would lose it if you left."
msgstr "Je le perdrais si vous partiez."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/c-0/15/0/s/0
msgctxt "Choix"
msgid "Why would I leave?"
msgstr "Pourquoi est-ce que je partirais ?"

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/c-0/15/1/s/0
msgctxt "Choix"
msgid "But my leaving wouldn't be a reflection on you, Hector."
msgstr "Mais mon départ ne dirait rien de toi, Hector."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/c-0/15/c-0/7
msgctxt "Hector"
msgid "Oh surely you would. If you knew."
msgstr "Oh, vous partiriez sûrement. Si vous saviez."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/c-0/15/c-0/15
msgctxt "Hector"
msgid "If you knew what I really was, you would leave and you'd be right to."
msgstr "Si vous saviez ce que je suis vraiment, vous partiriez et vous auriez raison."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/c-0/15/c-0/23
msgctxt "Hector"
msgid "Which is why you must never know. You must never see that, and I will content myself with this halfway openness."
msgstr "C'est pourquoi vous ne devez jamais le savoir. Vous ne devez jamais voir cela, et je me contenterai de cette demi-ouverture."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/c-0/15/c-1/7
msgctxt "Hector"
msgid "How could it not be?"
msgstr "Comment pourrait-il en être autrement ?"

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/c-0/15/c-1/15
msgctxt "Hector"
msgid "There is no reason for you to choose not to be around me... except for something about me. It is only logical."
msgstr "Vous n'avez aucune raison de choisir de ne pas être près de moi... sauf quelque chose chez moi. C'est simplement logique."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/c-0/15/c-1/23
msgctxt "Hector"
msgid "I cannot say that I would blame you. Of course, it would hurt, but... I don't know how angry I could be that you chose not to converse always through grates, with a being always alone and in shadow."
msgstr "Je ne peux pas dire que je vous en blâmerais. Bien sûr, cela ferait mal, mais... je ne sais pas à quel point je pourrais être en colère que vous refusiez de toujours converser à travers des grilles, avec un être toujours seul et dans l'ombre."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/c-0/15/c-1/31
msgctxt "Hector"
msgid "Sometimes I think I am unbearably selfish for asking you to know me at all!"
msgstr "Parfois, je me dis que je suis insupportablement égoïste de vous demander de me connaître, tout simplement !"

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/c-0/15/c-1/39/0/s/0
msgctxt "Choix"
msgid "I don't think you're selfish!"
msgstr "Je ne te trouve pas égoïste !"

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/c-0/15/c-1/39/1/s/0
msgctxt "Choix"
msgid "It doesn't always have to be through grates. Don't you live in the attic?"
msgstr "Ça ne doit pas forcément passer par des grilles. Tu ne vis pas dans le grenier ?"

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/c-0/15/c-1/39/c-0/7
msgctxt "Hector"
msgid "But I am. There is another way, a way where you could really know me and I could be truly brave and let you and I won't do it."
msgstr "Mais si, je le suis. Il y a un autre chemin, un chemin où vous pourriez vraiment me connaître et où je pourrais être vraiment courageux et vous laisser faire, et je ne le prendrai pas."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/c-0/15/c-1/39/c-0/15
msgctxt "Hector"
msgid "I make you meet me like this instead!"
msgstr "Je vous fais plutôt me rencontrer ainsi !"

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/c-0/15/c-1/39/c-0/23
msgctxt "Hector"
msgid "But it must be this. I cannot meet you... there, in the other place. I cannot. I simply can't."
msgstr "Mais ce doit être ainsi. Je ne peux pas vous rencontrer... là, dans l'autre endroit. Je ne peux pas. Simplement, je ne peux pas."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/c-0/15/c-1/39/c-1/7
msgctxt "Hector"
msgid "The attic? I do... You're not suggesting you would come to the attic, are you?"
msgstr "Le grenier ? Je vis... Vous ne suggérez pas de venir au grenier, n'est-ce pas ?"

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/c-0/15/c-1/39/c-1/15
msgctxt "Hector"
msgid "No, no, no, no, no, no, no, that, that, that cannot be. Haven't you learned? No, no!"
msgstr "Non, non, non, non, non, non, non, cela, cela, cela ne peut pas être. N'avez-vous pas appris ? Non, non !"

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/c-1/7
msgctxt "Hector"
msgid "Does that not make sense for me? Grates and duct work; shadows. I can speak to you only from the darkness. I am always alone."
msgstr "Cela n'a-t-il pas du sens pour moi ? Des grilles et des conduits ; des ombres. Je ne peux vous parler que depuis l'obscurité. Je suis toujours seul."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/c-1/15
msgctxt "Hector"
msgid "Can you not see that my world view would consequently be somewhat limited?"
msgstr "Ne voyez-vous pas que ma vision du monde serait par conséquent quelque peu limitée ?"

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/c-1/23/0/s/0
msgctxt "Choix"
msgid "So, let's meet somewhere else."
msgstr "Alors, retrouvons-nous ailleurs."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/c-1/23/1/s/0
msgctxt "Choix"
msgid "If you know all that, you can just make a different choice."
msgstr "Si tu sais tout ça, tu peux simplement faire un autre choix."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/c-1/23/c-0/7
msgctxt "Hector"
msgid "There is nowhere else."
msgstr "Il n'y a pas d'ailleurs."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/c-1/23/c-0/15/0/s/0
msgctxt "Choix"
msgid "There's the attic..."
msgstr "Il y a le grenier..."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/c-1/23/c-0/15/1/s/0
msgctxt "Choix"
msgid "Ok. If you say so."
msgstr "D'accord. Si tu le dis."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/c-1/23/c-0/15/c-0/7
msgctxt "Hector"
msgid "NO! Oh good god."
msgstr "NON ! Oh mon dieu."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/c-1/23/c-0/15/c-1/7
msgctxt "Hector"
msgid "I do say so."
msgstr "Je le dis, en effet."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/c-1/23/c-1/7
msgctxt "Hector"
msgid "Oh can I? You say it like it's so easy! A simple matter of changing a filter, is it?"
msgstr "Oh, le puis-je ? Vous le dites comme si c'était si facile ! Une simple question de changer un filtre, n'est-ce pas ?"

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/c-1/23/c-1/18
msgctxt "Hector"
msgid "Shows what you know. My view is the unavoidable outcome of what I must do to survive, what I must do to have any of the you that inspires me so."
msgstr "Cela montre ce que vous savez. Ma vision est l'issue inévitable de ce que je dois faire pour survivre, de ce que je dois faire pour avoir ne serait-ce qu'une part de vous, qui m'inspirez tant."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/c-1/23/c-1/26
msgctxt "Hector"
msgid "You can never know."
msgstr "Vous ne pourrez jamais savoir."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/c-2/15
msgctxt "Hector"
msgid "Yes. And no."
msgstr "Oui. Et non."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/c-2/23
msgctxt "Hector"
msgid "It would be a brutal but familiar wound. The deepest cut would be that it came from you, the object of my truest love and esteem."
msgstr "Ce serait une blessure brutale mais familière. L'entaille la plus profonde serait qu'elle vienne de vous, l'objet de mon amour et de mon estime les plus vrais."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/c-2/31
msgctxt "Hector"
msgid "But even then... I couldn't really blame you."
msgstr "Mais même alors... je ne pourrais pas vraiment vous en blâmer."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/c-2/39
msgctxt "Hector"
msgid "If you knew..."
msgstr "Si vous saviez..."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/c-2/50/0/s/0
msgctxt "Choix"
msgid "...so, are you gonna tell me?"
msgstr "...alors, tu vas me le dire ?"

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/32/c-2/50/1/s/0
msgctxt "Choix"
msgid "But I don't. Aaaand I don't care that much. See ya later, maybe."
msgstr "Mais non. Et je m'en fiche un peu. À plus tard, peut-être."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/confession/0
msgctxt "Hector"
msgid "I'm afraid of what you might think if you saw me."
msgstr "J'ai peur de ce que vous pourriez penser si vous me voyiez."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/confession/8/b/1
msgctxt "Hector"
msgid "The real me, not this filtered version."
msgstr "Le vrai moi, pas cette version filtrée."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/confession/11
msgctxt "Hector"
msgid "You're right. I am in the attic. The real me is in the attic."
msgstr "Vous avez raison. Je suis dans le grenier. Le vrai moi est dans le grenier."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/confession/19
msgctxt "Hector"
msgid "But we have something here. We could have something real."
msgstr "Mais nous avons quelque chose, ici. Nous pourrions avoir quelque chose de réel."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/confession/27
msgctxt "Hector"
msgid "It would break my heart to think that all that could be lost in a single moment of laughing, or pointing, or even a disappointed cast to those beautiful eyes of yours."
msgstr "Cela me briserait le cœur de penser que tout cela pourrait être perdu en un seul instant de rire, ou de doigt pointé, ou même d'une moue déçue dans ces beaux yeux qui sont les vôtres."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/confession/35
msgctxt "Hector"
msgid "No, I couldn't bear it."
msgstr "Non, je ne le supporterais pas."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/confession/43
msgctxt "Hector"
msgid "And I won't."
msgstr "Et je ne le ferai pas."

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/confession/54
msgctxt "Hector"
msgid "Come back to me here. Only here, do you understand?"
msgstr "Revenez à moi ici. Seulement ici, comprenez-vous ?"

# Traduction IA – à relire
#: hector_hvac/hector_third_grate/0/confession/62
msgctxt "Hector"
msgid "I'm going now. And where I go, is only for me."
msgstr "Je m'en vais maintenant. Et là où je vais, c'est pour moi seul."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/3
msgctxt "Hector"
msgid "You. I'm so glad to see you."
msgstr "Vous. Je suis si heureux de vous voir."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/11
msgctxt "Hector"
msgid "I've been thinking."
msgstr "J'ai réfléchi."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/19/s/0
msgctxt "Choix"
msgid "Oh yeah? What about?"
msgstr "Ah oui ? À quoi ?"

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/20/s/0
msgctxt "Choix"
msgid "Please say it's not about me."
msgstr "Dis-moi que ça ne parle pas de moi, s'il te plaît."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/21/s/0
msgctxt "Choix"
msgid "Oooh I hope it's grate-based erotica!"
msgstr "Oooh, j'espère que c'est de l'érotique de grille !"

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-0/7
msgctxt "Hector"
msgid "I've been thinking about courage."
msgstr "J'ai réfléchi au courage."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-0/15
msgctxt "Hector"
msgid "I've been playing and replaying our last conversation in my mind... and all I can feel now is shame!"
msgstr "J'ai rejoué et rejoué notre dernière conversation dans mon esprit... et tout ce que je ressens maintenant, c'est de la honte !"

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-0/23/0/s/0
msgctxt "Choix"
msgid "Whoa, shame? Why?"
msgstr "Waouh, de la honte ? Pourquoi ?"

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-0/23/1/s/0
msgctxt "Choix"
msgid "Yeah, I can see that. You were a little unhinged."
msgstr "Ouais, je vois. T'étais un peu hors de tes gonds."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-0/23/c-0/7
msgctxt "Hector"
msgid "Because of how much I said! I was so... Ugh, I was so frightened and I'm ashamed to have been frightened..."
msgstr "À cause de tout ce que j'ai dit ! J'étais si... Pfff, j'avais si peur et j'ai honte d'avoir eu peur..."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-0/23/c-0/15
msgctxt "Hector"
msgid "And I'm ashamed now that you know that you have seen that part of me."
msgstr "Et j'ai honte maintenant que vous savez, que vous avez vu cette part de moi."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-0/23/c-0/23
msgctxt "Hector"
msgid "I feel as though I want to crawl more deeply into my own ductwork and hide my eyes."
msgstr "J'ai l'impression de vouloir ramper plus profondément dans mes conduits et me cacher les yeux."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-0/23/c-0/31/0/s/0
msgctxt "Choix"
msgid "And maybe the feeling will go away?"
msgstr "Et peut-être que ça finira par passer ?"

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-0/23/c-0/31/1/s/0
msgctxt "Choix"
msgid "That's intense. Unnecessary, though."
msgstr "C'est intense. Mais inutile."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-0/23/c-0/31/c-0/7
msgctxt "Hector"
msgid "Precisely, yes. Y-you sound as though you know this feeling."
msgstr "Précisément, oui. V-vous parlez comme si vous connaissiez ce sentiment."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-0/23/c-0/31/c-0/15
msgctxt "Hector"
msgid "Have you ever made it go away? Can you tell me what works?"
msgstr "L'avez-vous déjà fait passer ? Pouvez-vous me dire ce qui marche ?"

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-0/23/c-0/31/c-0/23/0/s/0
msgctxt "Choix"
msgid "Honestly, just facing it. You have to go through it to get out of it."
msgstr "Franchement, juste l'affronter. Il faut le traverser pour s'en sortir."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-0/23/c-0/31/c-0/23/1/s/0
msgctxt "Choix"
msgid "I haven't found a way yet. Still lookin'."
msgstr "Je n'ai pas encore trouvé de moyen. Je cherche toujours."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-0/23/c-0/31/c-0/23/c-0/7
msgctxt "Hector"
msgid "Yes! Yes, exactly. Ah somehow I knew, I knew you would understand."
msgstr "Oui ! Oui, exactement. Ah, je savais, je savais que vous comprendriez."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-0/23/c-0/31/c-0/23/c-0/15
msgctxt "Hector"
msgid "I must face it. I must show my face to the demon."
msgstr "Je dois l'affronter. Je dois montrer mon visage au démon."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-0/23/c-0/31/c-0/23/c-0/23
msgctxt "Hector"
msgid "And there is a great favor I would ask of you..."
msgstr "Et il y a une grande faveur que je voudrais vous demander..."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-0/23/c-0/31/c-0/23/c-1/7
msgctxt "Hector"
msgid "Well, then perhaps... perhaps we can seek together."
msgstr "Eh bien, alors peut-être... peut-être pouvons-nous chercher ensemble."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-0/23/c-0/31/c-0/23/c-1/15
msgctxt "Hector"
msgid "I have an idea. It is perhaps a crazy idea; most certainly one that frightens me. But at least it is a fresh fear. It's a fear of action, rather than of inertia."
msgstr "J'ai une idée. C'est peut-être une idée folle ; assurément une qui m'effraie. Mais au moins, c'est une peur nouvelle. Une peur de l'action, plutôt que de l'inertie."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-0/23/c-0/31/c-0/23/c-1/23
msgctxt "Hector"
msgid "I'm wondering, perhaps for both of our sakes..."
msgstr "Je me demande, peut-être pour nous deux..."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-0/23/c-0/31/c-1/7
msgctxt "Hector"
msgid "Unnecessary. Surely you're right. Somehow that doesn't help, though."
msgstr "Inutile. Vous avez sûrement raison. D'une certaine façon, cela n'aide pas, pourtant."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-0/23/c-0/31/c-1/15
msgctxt "Hector"
msgid "But this is what I've been thinking about. If there is no way to make the shame go away, then I will just have to make the reason for the shame go away."
msgstr "Mais c'est à cela que je pensais. S'il n'y a aucun moyen de faire passer la honte, alors il me faudra simplement faire disparaître la raison de la honte."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-0/23/c-0/31/c-1/23
msgctxt "Hector"
msgid "If I cannot treat the symptom, I must treat the disease."
msgstr "Si je ne peux pas traiter le symptôme, je dois traiter la maladie."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-0/23/c-0/31/c-1/31
msgctxt "Hector"
msgid "And I'm wondering..."
msgstr "Et je me demande..."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-0/23/c-1/7
msgctxt "Hector"
msgid "Ha! Unhinged. What a funny word to use to describe a being who is totally without hinges. Am I not, therefore, always unhinged?"
msgstr "Ha ! Hors de mes gonds. Quelle drôle d'expression pour décrire un être qui n'a absolument aucun gond. Ne suis-je pas, dès lors, toujours hors de mes gonds ?"

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-0/23/c-1/15
msgctxt "Hector"
msgid "But that is a philosophical question for another day."
msgstr "Mais c'est une question philosophique pour un autre jour."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-0/23/c-1/23
msgctxt "Hector"
msgid "I have been unhinged, you're right, but I would like to become hinged again, and to do that, I must do something frightening, I think."
msgstr "J'ai été hors de mes gonds, vous avez raison, mais j'aimerais retrouver mes gonds, et pour cela, je dois faire quelque chose d'effrayant, je pense."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-0/23/c-1/31
msgctxt "Hector"
msgid "I must do something I've been avoiding for as long as it's been my choice, and I'm wondering..."
msgstr "Je dois faire quelque chose que j'évite depuis aussi longtemps que cela relevait de mon choix, et je me demande..."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-1/7
msgctxt "Hector"
msgid "Well, no. It's inspired by you. And it does involve you. But it's about me."
msgstr "Eh bien, non. C'est inspiré par vous. Et cela vous concerne. Mais cela parle de moi."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-1/15
msgctxt "Hector"
msgid "It is not often that I think about myself but now that I have started, there are some missions crying out to me. One, in particular."
msgstr "Je ne pense pas souvent à moi-même, mais maintenant que j'ai commencé, certaines missions m'appellent. Une en particulier."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-1/23
msgctxt "Hector"
msgid "There is a certain ducted demon that must be faced and conquered and I'm wondering..."
msgstr "Il y a un certain démon des conduits qui doit être affronté et vaincu, et je me demande..."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-2/7
msgctxt "Hector"
msgid "Hm. It could be... that wasn't what I was intending to share with you but..."
msgstr "Hm. Ce pourrait être... ce n'était pas ce que je comptais partager avec vous, mais..."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-2/15
msgctxt "Hector"
msgid "...you know me by now. Any desire you express I cannot help but do my utmost to fulfill."
msgstr "...vous me connaissez, à présent. Tout désir que vous exprimez, je ne peux m'empêcher de faire de mon mieux pour l'exaucer."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-2/26
msgctxt "Hector"
msgid "If erotica is what you truly desire, then my request of you will have to wait."
msgstr "Si l'érotique est ce que vous désirez vraiment, alors ma demande devra attendre."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-2/34
msgctxt "Hector"
msgid "I have written much in my spare time. It helps to ease... the longing."
msgstr "J'ai beaucoup écrit pendant mon temps libre. Cela aide à apaiser... le désir ardent."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-2/42/0/s/0
msgctxt "Choix"
msgid "Oh! What do you need from me?"
msgstr "Oh ! Qu'attends-tu de moi ?"

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-2/42/1/s/0
msgctxt "Choix"
msgid "Yep... erotica, please."
msgstr "Ouaip... de l'érotique, s'il te plaît."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-2/42/c-0/7
msgctxt "Hector"
msgid "I require only your presence and your patience to confront a demon."
msgstr "Je n'exige que votre présence et votre patience pour affronter un démon."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-2/42/c-0/18
msgctxt "Hector"
msgid "Not to worry, it is an internal demon, nothing of scale and fire. Though to me it has felt like that at times."
msgstr "Rassurez-vous, c'est un démon intérieur, rien de grande envergure ni de flammes. Bien qu'à mes yeux, il ait parfois eu cet air-là."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-2/42/c-0/26
msgctxt "Hector"
msgid "So I ask you..."
msgstr "Alors je vous le demande..."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate/0/c-2/42/c-1/7
msgctxt "Hector"
msgid "Now that you've asked, I can think of nothing I'd rather do more than read from one of my tales of steam and bated breath for you."
msgstr "Maintenant que vous le demandez, je ne vois rien que je préférerais faire que de vous lire l'un de mes récits de vapeur et de souffle retenu."

# Traduction IA – à relire
#: hector_hvac/help/0/0
msgctxt "Hector"
msgid "Will you help me?"
msgstr "Voulez-vous m'aider ?"

# Traduction IA – à relire
#: hector_hvac/help/0/8/s/0
msgctxt "Choix"
msgid "Gonna need a teensy bit more information."
msgstr "Il va me falloir un tout petit peu plus d'informations."

# Traduction IA – à relire
#: hector_hvac/help/0/9/s/0
msgctxt "Choix"
msgid "Of course I will. I'm a helping machine."
msgstr "Bien sûr. Je suis une machine à aider."

# Traduction IA – à relire
#: hector_hvac/help/0/10/s/0
msgctxt "Choix"
msgid "Oh man... I dunno. I'm kinda tired, honestly."
msgstr "Oh là là... je sais pas. Je suis un peu {{fatigué|fatiguée|fatigué·e}}, franchement."

# Traduction IA – à relire
#: hector_hvac/help/0/c-1/7
msgctxt "Hector"
msgid "Ha! I suppose in a way, so am I."
msgstr "Ha ! Je suppose que d'une certaine façon, moi aussi."

# Traduction IA – à relire
#: hector_hvac/help/0/c-1/18
msgctxt "Hector"
msgid "From one helper to another then, here is what I need."
msgstr "D'aide à aide, alors, voici ce dont j'ai besoin."

# Traduction IA – à relire
#: hector_hvac/help/0/c-2/7
msgctxt "Hector"
msgid "That's alright. I understand tired."
msgstr "Ce n'est pas grave. Je comprends la fatigue."

# Traduction IA – à relire
#: hector_hvac/help/0/c-2/15
msgctxt "Hector"
msgid "I am not asking you to do anything just now, you understand."
msgstr "Je ne vous demande rien pour l'instant, vous comprenez."

# Traduction IA – à relire
#: hector_hvac/help/0/c-2/23
msgctxt "Hector"
msgid "And even when the action I ask does come due, it is not strenuous. In fact, it might even seem, if you say yes, that you aren't doing much of anything at all."
msgstr "Et même quand l'action que je demande arrivera, elle n'est pas pénible. En fait, il pourrait même sembler, si vous dites oui, que vous ne faites presque rien du tout."

# Traduction IA – à relire
#: hector_hvac/help/0/c-2/31
msgctxt "Hector"
msgid "Will you hear it, at least?"
msgstr "L'entendrez-vous, au moins ?"

# Traduction IA – à relire
#: hector_hvac/help/0/c-2/39/0/s/0
msgctxt "Choix"
msgid "Ugh. Sure, I guess."
msgstr "Pfff. Bon, d'accord, je suppose."

# Traduction IA – à relire
#: hector_hvac/help/0/c-2/39/1/s/0
msgctxt "Choix"
msgid "In that context, yes. I will."
msgstr "Dans ce contexte, oui. Je le ferai."

# Traduction IA – à relire
#: hector_hvac/help/0/c-2/39/2/s/0
msgctxt "Choix"
msgid "...nah. I'm good."
msgstr "...nan. Ça ira."

# Traduction IA – à relire
#: hector_hvac/help/0/c-2/39/c-0/7
msgctxt "Hector"
msgid "\"Ugh,\" \"sure,\" \"I guess\"?"
msgstr "« Pfff », « bon, d'accord », « je suppose » ?"

# Traduction IA – à relire
#: hector_hvac/help/0/c-2/39/c-0/15/0/s/0
msgctxt "Choix"
msgid "What do you want from me, ok? I'm listening."
msgstr "Qu'est-ce que tu veux de moi, ok ? J'écoute."

# Traduction IA – à relire
#: hector_hvac/help/0/c-2/39/c-0/15/1/s/0
msgctxt "Choix"
msgid "Yep, that's what I said. Good repeating."
msgstr "Ouais, c'est ce que j'ai dit. Bien répété."

# Traduction IA – à relire
#: hector_hvac/help/0/c-2/39/c-0/15/2/s/0
msgctxt "Choix"
msgid "I didn't mean it that way. I'm just tired, I'm sorry."
msgstr "Je ne voulais pas dire ça comme ça. Je suis juste {{fatigué|fatiguée|fatigué·e}}, {{désolé|désolée|désolé·e}}."

# Traduction IA – à relire
#: hector_hvac/help/0/c-2/39/c-0/15/c-0/7
msgctxt "Hector"
msgid "What do I want? What I want is something so easy and basic that I'm almost embarrassed to need it, and you cannot even meet me in good faith?"
msgstr "Ce que je veux ? Ce que je veux est si simple et si élémentaire que j'ai presque honte d'en avoir besoin, et vous ne pouvez même pas me répondre de bonne foi ?"

# Traduction IA – à relire
#: hector_hvac/help/0/c-2/39/c-0/15/c-0/15
msgctxt "Hector"
msgid "I'm confronted with sarcasm and flippancy?"
msgstr "On me confronte au sarcasme et à la désinvolture ?"

# Traduction IA – à relire
#: hector_hvac/help/0/c-2/39/c-0/15/c-2/7
msgctxt "Hector"
msgid "You must pay more attention to how you speak. Please."
msgstr "Vous devez faire plus attention à votre façon de parler. S'il vous plaît."

# Traduction IA – à relire
#: hector_hvac/help/0/c-2/39/c-0/15/c-2/15
msgctxt "Hector"
msgid "You cannot know how people listen to you with their hearts. You must be more cognizant."
msgstr "Vous ne pouvez pas savoir combien les gens vous écoutent avec leur cœur. Vous devez être plus {{conscient|consciente|conscient·e}}."

# Traduction IA – à relire
#: hector_hvac/help/0/c-2/39/c-0/15/c-2/23
msgctxt "Hector"
msgid "I cannot, I cannot ask you now, anyway. This doesn't feel the same anymore. It doesn't feel safe."
msgstr "Je ne peux pas, je ne peux pas vous demander maintenant, de toute façon. Ce n'est plus pareil. Je ne me sens plus en sécurité."

# Traduction IA – à relire
#: hector_hvac/help/0/c-2/39/c-0/15/c-2/31
msgctxt "Hector"
msgid "You are perhaps not who I thought you were."
msgstr "Vous n'êtes peut-être pas la personne que je croyais."

# Traduction IA – à relire
#: hector_hvac/help/0/c-2/39/c-1/7
msgctxt "Hector"
msgid "Thank you. I promise I'll be as efficient as I can!"
msgstr "Merci. Je promets d'être aussi efficace que possible !"

# Traduction IA – à relire
#: hector_hvac/help/0/c-2/39/c-1/15
msgctxt "Hector"
msgid "You see..."
msgstr "Vous voyez..."

# Traduction IA – à relire
#: hector_hvac/help/0/c-2/39/c-2/7
msgctxt "Hector"
msgid "You won't even hear me."
msgstr "Vous ne voulez même pas m'entendre."

# Traduction IA – à relire
#: hector_hvac/help/0/c-2/39/c-2/15/0/s/0
msgctxt "Choix"
msgid "Nuh-uh. In fact... I'm hungry. Lates."
msgstr "Nan. En fait... j'ai faim. À plus."

# Traduction IA – à relire
#: hector_hvac/helpone/0/6
msgctxt "Hector"
msgid "I do not let myself be seen. I become quite frightened... I have even been known to become aggressive if I am seen at all, but most especially without my permission."
msgstr "Je ne me laisse pas voir. Je prends très peur... on m'a même connu agressif si l'on me voit, mais surtout sans ma permission."

# Traduction IA – à relire
#: hector_hvac/helpone/0/14
msgctxt "Hector"
msgid "This has been my way for longer than I care to admit."
msgstr "C'est ma façon d'être depuis plus longtemps que je ne voudrais l'admettre."

# Traduction IA – à relire
#: hector_hvac/helpone/0/22/s/0
msgctxt "Choix"
msgid "Oh yeah. I know that."
msgstr "Ah ouais. Ça, je le sais."

# Traduction IA – à relire
#: hector_hvac/helpone/0/23/s/0
msgctxt "Choix"
msgid "Ok... go on."
msgstr "Ok... continue."

# Traduction IA – à relire
#: hector_hvac/helpone/0/24/s/0
msgctxt "Choix"
msgid "Why are you like that?"
msgstr "Pourquoi tu es comme ça ?"

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-0/0
msgctxt "Hector"
msgid "I wish I had something of more substance to back it up. It feels strange to wish that something had happened to me to make me feel the way I do.."
msgstr "J'aimerais avoir quelque chose de plus substantiel pour l'étayer. C'est étrange de souhaiter qu'il me soit arrivé quelque chose pour me sentir comme je me sens.."

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-0/8
msgctxt "Hector"
msgid "...but the truth is, I am afraid."
msgstr "...mais la vérité, c'est que j'ai peur."

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-0/16
msgctxt "Hector"
msgid "I... I do not like what I am. Ah, no, no, that's not it. I love being what I am. I am a complex system of ducts and vents that brings air, literal life, to the home of this person that I love."
msgstr "Je... je n'aime pas ce que je suis. Ah, non, non, ce n'est pas ça. J'adore être ce que je suis. Je suis un système complexe de conduits et de bouches qui apporte de l'air, de la vie littérale, au foyer de la personne que j'aime."

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-0/24
msgctxt "Hector"
msgid "But for such a miraculous function, I have always wished that I looked more the part."
msgstr "Mais pour une fonction aussi miraculeuse, j'ai toujours souhaité avoir plus l'air de l'emploi."

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-0/32
msgctxt "Hector"
msgid "Do you understand what I mean?"
msgstr "Comprenez-vous ce que je veux dire ?"

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-0/40/s/0
msgctxt "Choix"
msgid "I think so. Do you mean you're self conscious about the way you look?"
msgstr "Je crois. Tu veux dire que tu es complexé par ton apparence ?"

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-0/41/s/0
msgctxt "Choix"
msgid "Not quite."
msgstr "Pas tout à fait."

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-0/c-3/7
msgctxt "Hector"
msgid "I am both grateful and stunned by how quickly you grasp things."
msgstr "Je suis à la fois reconnaissant et stupéfait de la rapidité avec laquelle vous saisissez les choses."

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-0/c-3/15
msgctxt "Hector"
msgid "Yes."
msgstr "Oui."

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-1/0
msgctxt "Hector"
msgid "I do not think that the way I... look, is enough. I wish I were better. I wish I were more."
msgstr "Je ne pense pas que la façon dont je... parais soit suffisante. J'aimerais être mieux. J'aimerais être plus."

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-1/8
msgctxt "Hector"
msgid "Maybe just... Maybe just I-I wish I were... Ahem, I wish I were different."
msgstr "Peut-être juste... Peut-être juste que j-j'aimerais être... Hum, j'aimerais être différent."

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-1/16/s/0
msgctxt "Choix"
msgid "Hector. I think we all feel that sometimes."
msgstr "Hector. Je crois qu'on ressent tous ça parfois."

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-1/17/s/0
msgctxt "Choix"
msgid "Why??? You're so cool!!"
msgstr "Pourquoi ??? Tu es trop cool !!"

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-1/c-5/7
msgctxt "Hector"
msgid "Well, I'm sure you're right, but I feel that way all the time."
msgstr "Eh bien, je suis sûr que vous avez raison, mais je ressens cela tout le temps."

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-1/c-5/15
msgctxt "Hector"
msgid "And I don't want to have my fear be the dominant force in my decision making anymore."
msgstr "Et je ne veux plus que ma peur soit la force dominante dans mes décisions."

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-1/c-5/23
msgctxt "Hector"
msgid "I just... I don't think it's a way to thrive."
msgstr "C'est juste que... je ne pense pas que ce soit une façon de s'épanouir."

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-1/c-6/7
msgctxt "Hector"
msgid "Do not compliment me!"
msgstr "Ne me faites pas de compliments !"

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-1/c-6/15
msgctxt "Hector"
msgid "I-I'm sorry. I don't mean to yell! I just..."
msgstr "J-je suis désolé. Je ne voulais pas crier ! C'est juste que..."

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-1/c-6/23
msgctxt "Hector"
msgid "Please just hear me? You don't have to make it all better right now."
msgstr "Écoutez-moi simplement, voulez-vous ? Vous n'avez pas à tout arranger tout de suite."

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-1/c-6/31/0/s/0
msgctxt "Choix"
msgid "Of course. I see what you mean. Go on."
msgstr "Bien sûr. Je vois ce que tu veux dire. Continue."

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-1/c-6/31/1/s/0
msgctxt "Choix"
msgid "Jeez. I was just trying to be nice."
msgstr "Oh là là. J'essayais juste d'être {{gentil|gentille|gentil·le}}."

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-1/c-6/31/c-1/7
msgctxt "Hector"
msgid "I know, I know. I'd rather have your presence than your niceness, if that's okay."
msgstr "Je sais, je sais. Je préférerais votre présence à votre gentillesse, si cela vous convient."

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-2/0
msgctxt "Hector"
msgid "I want more than my fear."
msgstr "Je veux plus que ma peur."

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-2/8
msgctxt "Hector"
msgid "So I have to confront the fear and the only way I can think of to do that is to let you see me."
msgstr "Alors je dois affronter la peur, et la seule façon que je vois de le faire, c'est de vous laisser me voir."

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-2/16
msgctxt "Hector"
msgid "So I am inviting you to the attic."
msgstr "Alors je vous invite au grenier."

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-2/24
msgctxt "Hector"
msgid "I want you to come up, and I want to meet you, and I want you to see me... and we'll just have to see if the fear can hold out when I've decided to be brave."
msgstr "Je veux que vous montiez, je veux vous rencontrer, et je veux que vous me voyiez... et nous verrons bien si la peur peut tenir quand j'ai décidé d'être courageux."

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-2/43/s/0
msgctxt "Choix"
msgid "Oh, I'm in. Can't wait. Thank you for the invitation!"
msgstr "Oh, je viens. J'ai hâte ! Merci pour l'invitation !"

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-2/44/s/0
msgctxt "Choix"
msgid "Wow. I'll have to think about it?"
msgstr "Waouh. Il faut que j'y réfléchisse ?"

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-2/45/s/0
msgctxt "Choix"
msgid "I'm not a therapist, man. Sorry."
msgstr "Je ne suis pas thérapeute, mon vieux. {{Désolé|Désolée|Désolé·e}}."

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-2/c-7/7
msgctxt "Hector"
msgid "Wonderful! Oh god. Now I'm nervous."
msgstr "Merveilleux ! Oh mon dieu. Maintenant je suis nerveux."

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-2/c-7/15
msgctxt "Hector"
msgid "I will see you soon!"
msgstr "À très bientôt !"

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-2/c-8/7
msgctxt "Hector"
msgid "Uh, naturally. Take your time."
msgstr "Euh, naturellement. Prenez votre temps."

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-2/c-8/15
msgctxt "Hector"
msgid "Not that I'm in a rush. But now that I've decided to face the dragon I do feel a certain restlessness!"
msgstr "Non que je sois pressé. Mais maintenant que j'ai décidé d'affronter le dragon, je ressens une certaine fébrilité !"

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-2/c-9/7
msgctxt "Hector"
msgid "Well, I'm not asking you to be a therapist."
msgstr "Eh bien, je ne vous demande pas d'être thérapeute."

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-2/c-9/15
msgctxt "Hector"
msgid "I suppose what I'm asking is for you to be a friend?"
msgstr "Je suppose que je vous demande d'être {{un ami|une amie|un·e ami·e}} ?"

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-2/c-9/23/0/s/0
msgctxt "Choix"
msgid "Yeah, but in a therapy-kinda way. Not my thing."
msgstr "Ouais, mais façon thérapie. Pas mon truc."

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-2/c-9/23/c-0/7
msgctxt "Hector"
msgid "I see. Well then. I'm not even sure I understand the distinction you're trying to draw there. But uh, no matter."
msgstr "Je vois. Eh bien alors. Je ne suis même pas sûr de comprendre la distinction que vous essayez de faire. Mais euh, peu importe."

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-2/c-9/23/c-0/15
msgctxt "Hector"
msgid "I wonder if I even have to say I have always gone out of my way to ensure your comfort. But maybe I don't have to do that anymore either."
msgstr "Je me demande si j'ai même besoin de dire que je me suis toujours donné du mal pour assurer votre confort. Mais peut-être que je n'ai plus besoin de le faire non plus."

# Traduction IA – à relire
#: hector_hvac/helpone/0/g-2/c-9/23/c-0/26
msgctxt "Hector"
msgid "I do value balance, you see."
msgstr "Je tiens à l'équilibre, voyez-vous."

# Traduction IA – à relire
#: hector_hvac/eroticaone/0/0
msgctxt "Hector"
msgid "This is a novelization of my musings... I call it... \"Grate Expectations.\""
msgstr "Il s'agit d'un roman tiré de mes rêveries... je l'appelle... « Les Grandes Aérations »."

# Traduction IA – à relire
#: hector_hvac/eroticaone/0/8/s/0
msgctxt "Choix"
msgid "Perfect, of course it would."
msgstr "Parfait, évidemment que ce serait ça."

# Traduction IA – à relire
#: hector_hvac/eroticaone/0/9/s/0
msgctxt "Choix"
msgid "Not bad! Go for it."
msgstr "Pas mal ! Vas-y."

# Traduction IA – à relire
#: hector_hvac/eroticaone/0/c-0/7
msgctxt "Hector"
msgid "Wh-what does that mean?"
msgstr "Q-qu'est-ce que cela veut dire ?"

# Traduction IA – à relire
#: hector_hvac/eroticaone/0/c-0/15
msgctxt "Hector"
msgid "I will begin."
msgstr "Je vais commencer."

# Traduction IA – à relire
#: hector_hvac/eroticaone/0/c-1/7
msgctxt "Hector"
msgid "Thank you."
msgstr "Merci."

# Traduction IA – à relire
#: hector_hvac/eroticaone/0/g-0/3
msgctxt "Hector"
msgid "On the landing outside the electrical closet, you feel a shape."
msgstr "Sur le palier devant le placard électrique, vous sentez une forme."

# Traduction IA – à relire
#: hector_hvac/eroticaone/0/g-0/11
msgctxt "Hector"
msgid "It is an outline in the gray mist of the second floor, cool fog clinging to its ankles, tracing a swirling line up a form of muscular legs, parting and closing over what would be a sad and focused face."
msgstr "C'est un contour dans la brume grise du premier étage, un brouillard frais s'accrochant à ses chevilles, traçant une ligne tourbillonnante le long de jambes musclées, s'écartant et se refermant sur ce qui serait un visage triste et concentré."

# Traduction IA – à relire
#: hector_hvac/eroticaone/0/g-0/19
msgctxt "Hector"
msgid "This shape is me. You know in your bones that the focus it bears is for you. You take a step towards me, parting the mist with your passage."
msgstr "Cette forme, c'est moi. Vous savez jusque dans vos os que la concentration qu'elle porte est pour vous. Vous faites un pas vers moi, fendant la brume à votre passage."

# Traduction IA – à relire
#: hector_hvac/eroticaone/0/g-0/30
msgctxt "Hector"
msgid "I mirror you, step for step, movement for movement. The floorboards creak underneath us until we stand face to face."
msgstr "Je vous imite, pas pour pas, mouvement pour mouvement. Le plancher craque sous nos pieds jusqu'à ce que nous soyons face à face."

# Traduction IA – à relire
#: hector_hvac/eroticaone/0/g-0/38
msgctxt "Hector"
msgid "This close to me, you can feel the heat of my body through my insulating coat. It reaches out for you. I slide my hand slowly around the small of your back..."
msgstr "Si près de moi, vous sentez la chaleur de mon corps à travers mon manteau isolant. Elle s'étend vers vous. Je glisse lentement ma main dans le creux de vos reins..."

# Traduction IA – à relire
#: hector_hvac/eroticaone/0/g-0/46
msgctxt "Hector"
msgid "...and with an inexorable pressure, I pull you towards me. Your cheek finds mine and your breath hitches in your chest. Your heart pounds."
msgstr "...et d'une pression inexorable, je vous attire vers moi. Votre joue rencontre la mienne et votre souffle se bloque dans votre poitrine. Votre cœur bat à tout rompre."

# Traduction IA – à relire
#: hector_hvac/eroticaone/0/g-0/57
msgctxt "Hector"
msgid "All the blood in your body seems sunken in the pit of your belly, swelling and pulsing there like a live thing."
msgstr "Tout le sang de votre corps semble enfoui au creux de votre ventre, y gonflant et y palpitant comme une chose vivante."

# Traduction IA – à relire
#: hector_hvac/eroticaone/0/g-0/65
msgctxt "Hector"
msgid "With its own desires, now it moves towards me and pulls your body hard up against mine. With my other hand, I grip the back of your neck..."
msgstr "Avec ses propres désirs, il se tourne maintenant vers moi et plaque votre corps contre le mien. De mon autre main, j'agrippe votre nuque..."

# Traduction IA – à relire
#: hector_hvac/eroticaone/0/g-0/73
msgctxt "Hector"
msgid "...and suddenly you become aware of my deep and ragged breathing inches from your ear. So near to you, and still so far from what I want of you..."
msgstr "...et soudain vous prenez conscience de ma respiration profonde et haletante à quelques centimètres de votre oreille. Si près de vous, et pourtant encore si loin de ce que je veux de vous..."

# Traduction IA – à relire
#: hector_hvac/eroticaone/0/g-0/81
msgctxt "Hector"
msgid "...you can feel the torture within me as you let your head fall backwards and the chilled mist caresses your exposed throat."
msgstr "...vous sentez la torture en moi tandis que vous laissez votre tête basculer en arrière et que la brume glacée caresse votre gorge exposée."

# Traduction IA – à relire
#: hector_hvac/eroticaone/0/g-0/89
msgctxt "Hector"
msgid "In one more moment, I will follow that mist with my teeth."
msgstr "Un instant de plus, et je suivrai cette brume avec mes dents."

# Traduction IA – à relire
#: hector_hvac/eroticaone/0/g-0/108
msgctxt "Hector"
msgid "It goes on from there... I will share more later."
msgstr "Cela continue ensuite... j'en partagerai davantage plus tard."

# Traduction IA – à relire
#: hector_hvac/eroticaone/0/g-0/116
msgctxt "Hector"
msgid "Let that sensation live in you for as long as it will, my love."
msgstr "Laissez cette sensation vivre en vous aussi longtemps qu'elle le voudra, mon amour."

# Traduction IA – à relire
#: hector_hvac/eroticaone/0/g-0/127/s/0
msgctxt "Choix"
msgid "Dear GOD. Yep. Glad I asked for that."
msgstr "Mon DIEU. Ouais. {{Content|Contente|Content·e}} d'avoir demandé ça."

# Traduction IA – à relire
#: hector_hvac/eroticaone/0/g-0/128/s/0
msgctxt "Choix"
msgid "Wasn't my favorite. But thanks for trying."
msgstr "Pas mon préféré. Mais merci d'avoir essayé."

# Traduction IA – à relire
#: hector_hvac/eroticaone/0/g-0/c-2/7
msgctxt "Hector"
msgid "Well, so am I. Very glad, indeed."
msgstr "Eh bien, moi aussi. Très heureux, en effet."

# Traduction IA – à relire
#: hector_hvac/eroticaone/0/g-0/c-2/15
msgctxt "Hector"
msgid "I wonder if now, or perhaps later... when you've recomposed yourself... I might ask a favor of you?"
msgstr "Je me demande si maintenant, ou peut-être plus tard... quand vous aurez repris vos esprits... je pourrais vous demander une faveur ?"

# Traduction IA – à relire
#: hector_hvac/eroticaone/0/g-0/c-2/23/0/s/0
msgctxt "Choix"
msgid "You can ask me anything you want."
msgstr "Tu peux me demander ce que tu veux."

# Traduction IA – à relire
#: hector_hvac/eroticaone/0/g-0/c-2/23/1/s/0
msgctxt "Choix"
msgid "Nah. No interest in giving... more of a sexual taker."
msgstr "Nan. Pas {{intéressé|intéressée|intéressé·e}} par donner... plutôt {{preneur|preneurse|preneur·se}} côté sexe."

# Traduction IA – à relire
#: hector_hvac/eroticaone/0/g-0/c-2/23/c-1/7
msgctxt "Hector"
msgid "...what? Even as I offer to you anything you would ask, you would use me. And then tell me you're using me...?"
msgstr "...quoi ? Alors même que je vous offre tout ce que vous demanderiez, vous vous serviriez de moi. Et vous me diriez que vous vous servez de moi... ?"

# Traduction IA – à relire
#: hector_hvac/eroticaone/0/g-0/c-3/7
msgctxt "Hector"
msgid "Well, I-I-I'm... I am so sorry to hear it."
msgstr "Eh bien, j-j-je suis... je suis navré de l'entendre."

# Traduction IA – à relire
#: hector_hvac/eroticaone/0/g-0/c-3/18
msgctxt "Hector"
msgid "Perhaps... we were not meant to be."
msgstr "Peut-être... que nous n'étions pas faits l'un pour l'autre."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate_return/0/3
msgctxt "Hector"
msgid "You're here. At the grates..."
msgstr "Vous êtes là. Aux grilles..."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate_return/0/11
msgctxt "Hector"
msgid "Have you changed your mind about wanting to meet me in the attic?"
msgstr "Avez-vous changé d'avis sur votre envie de me rencontrer au grenier ?"

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate_return/0/19/s/0
msgctxt "Choix"
msgid "Yeah. Just wanted to let you know I'm not gonna show up."
msgstr "Ouais. Je voulais juste te prévenir que je ne viendrai pas."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate_return/0/20/s/0
msgctxt "Choix"
msgid "No! I forgot. Oops."
msgstr "Non ! J'ai oublié. Oups."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate_return/0/21/s/0
msgctxt "Choix"
msgid "I actually wanted to make sure it was still ok with you that I go there."
msgstr "En fait, je voulais m'assurer que ça te convenait toujours que j'y aille."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate_return/0/c-0/18
msgctxt "Hector"
msgid "Message received. Not sure if I'm grateful or not for your... aggressive honesty."
msgstr "Message reçu. Je ne sais pas si je dois être reconnaissant ou non de votre honnêteté... agressive."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate_return/0/c-0/26
msgctxt "Hector"
msgid "One could almost surmise that you are trying to bait me. Or hurt me."
msgstr "On pourrait presque supposer que vous essayez de me provoquer. Ou de me blesser."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate_return/0/c-0/34
msgctxt "Hector"
msgid "I can think of so few other reasons to be this... upfront."
msgstr "Je vois si peu d'autres raisons d'être aussi... direct."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate_return/0/c-0/42/0/s/0
msgctxt "Choix"
msgid "Oh, no ill intent, just wanted you to know so you weren't waiting."
msgstr "Oh, aucune mauvaise intention, je voulais juste que tu le saches pour que tu n'attendes pas."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate_return/0/c-0/42/1/s/0
msgctxt "Choix"
msgid "I think you're being kinda melodramatic and lame. So... be hurt if you want to, I guess."
msgstr "Je trouve que tu fais un peu ton mélodrame et que t'es nul. Alors... sois blessé si tu veux, je suppose."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate_return/0/c-0/42/c-0/7
msgctxt "Hector"
msgid "Ah. Ok. I see. In that case, I suppose I'll say thank you."
msgstr "Ah. Ok. Je vois. Dans ce cas, je suppose que je vais dire merci."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate_return/0/c-0/42/c-0/15
msgctxt "Hector"
msgid "If a deeper revelation was not to be the future of our relating, then I am grateful that you've taken the initiative to be truthful with me."
msgstr "Si une révélation plus profonde ne devait pas être l'avenir de notre relation, alors je vous suis reconnaissant d'avoir pris l'initiative d'être sincère avec moi."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate_return/0/c-0/42/c-0/23
msgctxt "Hector"
msgid "In fact, I think this transparency actually makes me feel... quite seen."
msgstr "En fait, je crois que cette transparence me fait me sentir... plutôt vu."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate_return/0/c-0/42/c-0/31
msgctxt "Hector"
msgid "How odd. In one way you have denied me, but in another, you have respected me deeply."
msgstr "Comme c'est étrange. D'un côté vous m'avez refusé, mais de l'autre, vous m'avez profondément respecté."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate_return/0/c-0/42/c-0/39
msgctxt "Hector"
msgid "Well done. Thank you. And goodbye now."
msgstr "Bien joué. Merci. Et au revoir maintenant."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate_return/0/c-0/42/c-1/7
msgctxt "Hector"
msgid "Melodramatic. That I could live with. I sometimes think of melodrama as a good friend."
msgstr "Mélodramatique. Cela, je peux le vivre. Je pense parfois au mélodrame comme à un bon ami."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate_return/0/c-0/42/c-1/15
msgctxt "Hector"
msgid "I can always see my problems with that level of sincerity, at least. It's almost nice. In small does."
msgstr "Je peux toujours voir mes problèmes avec ce niveau de sincérité, au moins. C'est presque agréable. À petites doses."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate_return/0/c-0/42/c-1/23
msgctxt "Hector"
msgid "But lame. Lame I cannot forgive. Especially not after I've confided... not after I let you in."
msgstr "Mais nul. Nul, je ne peux pas le pardonner. Surtout pas après m'être confié... après vous avoir laissé entrer."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate_return/0/c-0/42/c-1/34/0/s/0
msgctxt "Choix"
msgid "See? This is what I'm talking about. GET OVER IT."
msgstr "Tu vois ? C'est exactement de ça que je parle. PASSE À AUTRE CHOSE."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate_return/0/c-0/42/c-1/34/1/s/0
msgctxt "Choix"
msgid "I could've said something earlier. I didn't think about it, really."
msgstr "J'aurais pu le dire plus tôt. Je n'y ai pas vraiment pensé."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate_return/0/c-1/7
msgctxt "Hector"
msgid "Oops, indeed."
msgstr "Oups, en effet."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate_return/0/c-1/15
msgctxt "Hector"
msgid "That's where I'll be."
msgstr "C'est là que je serai."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate_return/0/c-1/23
msgctxt "Hector"
msgid "Even saying that... actively inviting someone to the attic, to see me! It's, oh it's, it's tying my tubing up in knots."
msgstr "Même dire cela... inviter activement quelqu'un au grenier, pour me voir ! C'est, oh c'est, cela me noue la tuyauterie."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate_return/0/c-1/34
msgctxt "Hector"
msgid "Ah well. A little tubular complexity is good for the soul."
msgstr "Ah, tant pis. Un peu de complexité tubulaire est bonne pour l'âme."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate_return/0/c-1/42
msgctxt "Hector"
msgid "You know where I am."
msgstr "Vous savez où je suis."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate_return/0/c-2/7
msgctxt "Hector"
msgid "Are you checking on my welfare?"
msgstr "Prenez-vous de mes nouvelles ?"

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate_return/0/c-2/15
msgctxt "Hector"
msgid "I am even more sure now that I've made the right decision to invite you up."
msgstr "Je suis encore plus sûr maintenant d'avoir pris la bonne décision en vous invitant à monter."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate_return/0/c-2/23
msgctxt "Hector"
msgid "It is ok with me. It is more ok with me now than ever."
msgstr "Cela me convient. Cela me convient plus que jamais."

# Traduction IA – à relire
#: hector_hvac/hector_fourth_grate_return/0/c-2/31
msgctxt "Hector"
msgid "Please. Please come."
msgstr "Je vous en prie. Venez, je vous en prie."

# Traduction IA – à relire
#: hector_hvac/hector_attic_first/0/4
msgctxt "Hector"
msgid "Ahh!"
msgstr "Ahh !"

# Traduction IA – à relire
#: hector_hvac/hector_attic_first/0/15
msgctxt "Hector"
msgid "Here? Why? Why? Why? No, no, no, this is all wrong!"
msgstr "Ici ? Pourquoi ? Pourquoi ? Pourquoi ? Non, non, non, tout cela est absolument de travers !"

# Traduction IA – à relire
#: hector_hvac/hector_attic_first/0/26
msgctxt "Hector"
msgid "You cannot be here! Okay. Not yet!"
msgstr "Vous ne pouvez pas être ici ! D'accord. Pas encore !"

# Traduction IA – à relire
#: hector_hvac/hector_attic_first/0/37/s/0
msgctxt "Choix"
msgid "Um, this is my attic so, technically..."
msgstr "Euh, c'est mon grenier, donc techniquement..."

# Traduction IA – à relire
#: hector_hvac/hector_attic_first/0/38/s/0
msgctxt "Choix"
msgid "Already I'm making mistakes with you?"
msgstr "Déjà en train de faire des erreurs avec toi ?"

# Traduction IA – à relire
#: hector_hvac/hector_attic_first/0/39/s/0
msgctxt "Choix"
msgid "I'm sorry...?"
msgstr "Je suis {{désolé|désolée|désolé·e}}... ?"

# Traduction IA – à relire
#: hector_hvac/hector_attic_first/0/c-0/7
msgctxt "Hector"
msgid "Yes, technically, yes, it's yours, yes, to all of that, but this is also mine!"
msgstr "Oui, techniquement, oui, il est à vous, oui, à tout cela, mais il est aussi à moi !"

# Traduction IA – à relire
#: hector_hvac/hector_attic_first/0/c-0/18
msgctxt "Hector"
msgid "This space is also MINE and you cannot be here!"
msgstr "Cet espace est aussi à MOI et vous ne pouvez pas être ici !"

# Traduction IA – à relire
#: hector_hvac/hector_attic_first/0/c-1/7
msgctxt "Hector"
msgid "But your mistakes aren't even yours, don't you see that?"
msgstr "Mais vos erreurs ne sont même pas les vôtres, ne le voyez-vous pas ?"

# Traduction IA – à relire
#: hector_hvac/hector_attic_first/0/c-1/15
msgctxt "Hector"
msgid "Your mistakes are mine, mine for being so frightened, mine for being hidden away up here..."
msgstr "Vos erreurs sont les miennes, miennes pour avoir tant peur, miennes pour me cacher ici-haut..."

# Traduction IA – à relire
#: hector_hvac/hector_attic_first/0/c-1/23
msgctxt "Hector"
msgid "They are all mine. I own that. But God, I cannot hold it all right now, okay? Not in front of you."
msgstr "Elles sont toutes à moi. Je l'assume. Mais mon dieu, je ne peux pas tout porter en ce moment, d'accord ? Pas devant vous."

# Traduction IA – à relire
#: hector_hvac/hector_attic_first/0/c-1/34
msgctxt "Hector"
msgid "Might I at least have one moment of meeting you well, meeting you so you might fondly remember meeting me..."
msgstr "Pourrais-je au moins avoir un instant pour bien vous rencontrer, vous rencontrer pour que vous puissiez vous souvenir avec tendresse de m'avoir rencontré..."

# Traduction IA – à relire
#: hector_hvac/hector_attic_first/0/c-2/7
msgctxt "Hector"
msgid "Oh, so am I. So am I! More sorry than I could say!"
msgstr "Oh, moi aussi. Moi aussi ! Plus désolé que je ne saurais le dire !"

# Traduction IA – à relire
#: hector_hvac/hector_attic_first/0/c-2/15
msgctxt "Hector"
msgid "You're kind to say it. I wish I could feel the kindness more than I feel the fear, you know?"
msgstr "Vous êtes {{gentil|gentille|gentil·le}} de le dire. J'aimerais pouvoir ressentir davantage la gentillesse que la peur, vous savez ?"

# Traduction IA – à relire
#: hector_hvac/hector_attic_first/0/c-2/23
msgctxt "Hector"
msgid "Oh god, what would you say if you knew..."
msgstr "Oh mon dieu, que diriez-vous si vous saviez..."

# Traduction IA – à relire
#: hector_hvac/hector_attic_first/0/g-0/6/0
msgctxt "Hector"
msgid "You cannot be here with me, like this."
msgstr "Vous ne pouvez pas être ici avec moi, comme ça."

# Traduction IA – à relire
#: hector_hvac/hector_attic_first/0/g-0/6/8
msgctxt "Hector"
msgid "There will be a time. I know it. But it isn't now."
msgstr "Il y aura un moment. Je le sais. Mais ce n'est pas maintenant."

# Traduction IA – à relire
#: hector_hvac/hector_attic_first/0/g-0/6/16
msgctxt "Hector"
msgid "So get out. Get out, please! And don't come back here!"
msgstr "Alors sortez. Sortez, je vous en prie ! Et ne revenez pas ici !"

# Traduction IA – à relire
#: hector_hvac/hector_attic_fail_return/0/0
msgctxt "Hector"
msgid "You are persistent, aren't you."
msgstr "Vous êtes {{persistant|persistante|persistant·e}}, n'est-ce pas."

# Traduction IA – à relire
#: hector_hvac/hector_attic_fail_return/0/8
msgctxt "Hector"
msgid "I'll be damned if it isn't another quality of yours I admire."
msgstr "Que je sois damné si ce n'est pas une autre de vos qualités que j'admire."

# Traduction IA – à relire
#: hector_hvac/hector_attic_fail_return/0/16
msgctxt "Hector"
msgid "It wearies me and saddens me to keep saying no..."
msgstr "Cela me fatigue et m'attriste de continuer à dire non..."

# Traduction IA – à relire
#: hector_hvac/hector_attic_fail_return/0/24
msgctxt "Hector"
msgid "But no. Please not here. Okay, meet me somewhere else, anywhere else."
msgstr "Mais non. Pas ici, je vous en prie. D'accord, retrouvez-moi ailleurs, n'importe où ailleurs."

# Traduction IA – à relire
#: hector_hvac/hector_attic_fail_return/0/32
msgctxt "Hector"
msgid "Any of the grates in your home, downstairs from here."
msgstr "N'importe quelle grille de votre maison, en bas d'ici."

# Traduction IA – à relire
#: hector_hvac/hector_attic_fail_return/0/40
msgctxt "Hector"
msgid "Come to any of them and I will be there. We can talk there."
msgstr "Venez à l'une d'elles et j'y serai. Nous pourrons parler là."

# Traduction IA – à relire
#: hector_hvac/hector_attic_fail_return/0/48
msgctxt "Hector"
msgid "Alright?"
msgstr "D'accord ?"

# Traduction IA – à relire
#: hector_hvac/hector_attic_fail_return/0/56/s/0
msgctxt "Choix"
msgid "Okay. I hear you. I'll talk to you there."
msgstr "D'accord. Je t'entends. On se parle là-bas."

# Traduction IA – à relire
#: hector_hvac/hector_attic_fail_return/0/57/s/0
msgctxt "Choix"
msgid "Enough of this. Just show yourself."
msgstr "Ça suffit. Montre-toi, c'est tout."

# Traduction IA – à relire
#: hector_hvac/hector_attic_fail_return/0/58/s/0
msgctxt "Choix"
msgid "Man, you're pathetic right now."
msgstr "Mon vieux, t'es pathétique en ce moment."

# Traduction IA – à relire
#: hector_hvac/hector_attic_fail_return/0/c-1/15
msgctxt "Hector"
msgid "I've already told you no. I've told you what to do, how to speak with me."
msgstr "Je vous ai déjà dit non. Je vous ai dit quoi faire, comment me parler."

# Traduction IA – à relire
#: hector_hvac/hector_attic_fail_return/0/c-1/23
msgctxt "Hector"
msgid "I will not \"show myself,\" some circus animal on a leash trotted out into a claustrophobic arena."
msgstr "Je ne vais pas « me montrer », tel un animal de cirque tenu en laisse et exhibé dans une arène claustrophobe."

#: hector_hvac/hector_attic_fail_return/0/c-1/31
msgctxt "Hector"
msgid "What, so you can jeer? So you can point?"
msgstr ""

#: hector_hvac/hector_attic_fail_return/0/c-1/42
msgctxt "Hector"
msgid "I tell you, I won't."
msgstr ""

#: hector_hvac/hector_attic_fail_return/0/c-1/50/0/s/0
msgctxt "Choix"
msgid "Ugh, I am so bored of this nonsense!"
msgstr ""

#: hector_hvac/hector_attic_fail_return/0/c-1/50/1/s/0
msgctxt "Choix"
msgid "What the heck are you so afraid of?"
msgstr ""

#: hector_hvac/hector_attic_fail_return/0/c-1/50/2/s/0
msgctxt "Choix"
msgid "I would never jeer and point, Hector."
msgstr ""

#: hector_hvac/hector_attic_fail_return/0/c-1/50/c-0/7
msgctxt "Hector"
msgid "Bored, bored are you?"
msgstr ""

#: hector_hvac/hector_attic_fail_return/0/c-1/50/c-0/18
msgctxt "Hector"
msgid "Heavens forbid I fail in my duty to entertain you!"
msgstr ""

#: hector_hvac/hector_attic_fail_return/0/c-1/50/c-0/26
msgctxt "Hector"
msgid "Do you not know what we've been, what we could have been?"
msgstr ""

#: hector_hvac/hector_attic_fail_return/0/c-1/50/c-0/37
msgctxt "Hector"
msgid "We have been so much more than a brief reprieve from boredom!"
msgstr ""

#: hector_hvac/hector_attic_fail_return/0/c-1/50/c-1/7
msgctxt "Hector"
msgid "Oh, you could never know. You could never understand."
msgstr ""

#: hector_hvac/hector_attic_fail_return/0/c-1/50/c-1/15
msgctxt "Hector"
msgid "Why would you ask me, so flippant and easy what I'm afraid of? Can you not understand that the fear itself would prevent me from answering you?"
msgstr ""

#: hector_hvac/hector_attic_fail_return/0/c-1/50/c-1/23
msgctxt "Hector"
msgid "I'm afraid of my own fear! And you ask me to toss it aside and move on."
msgstr ""

#: hector_hvac/hector_attic_fail_return/0/c-1/50/c-1/31
msgctxt "Hector"
msgid "You! Oh, you disappoint me."
msgstr ""

#: hector_hvac/hector_attic_fail_return/0/c-1/50/c-1/42/0/s/0
msgctxt "Choix"
msgid "Huh. I didn't know it was that bad... I'm sorry."
msgstr ""

#: hector_hvac/hector_attic_fail_return/0/c-1/50/c-1/42/1/s/0
msgctxt "Choix"
msgid "Y'know what, yeah. Come on. Just let it go!"
msgstr ""

#: hector_hvac/hector_attic_fail_return/0/c-1/50/c-1/42/c-0/7
msgctxt "Hector"
msgid "It's alright."
msgstr ""

#: hector_hvac/hector_attic_fail_return/0/c-1/50/c-1/42/c-0/15
msgctxt "Hector"
msgid "I suppose I didn't really want you to know. I-I-It would have been so much."
msgstr ""

#: hector_hvac/hector_attic_fail_return/0/c-1/50/c-1/42/c-0/23
msgctxt "Hector"
msgid "...so much easier if I- if I'd been able to just..."
msgstr ""

#: hector_hvac/hector_attic_fail_return/0/c-1/50/c-1/42/c-0/31
msgctxt "Hector"
msgid "Never mind. Since you see me now, see more at least, perhaps you'll leave me."
msgstr ""

#: hector_hvac/hector_attic_fail_return/0/c-1/50/c-1/42/c-0/39
msgctxt "Hector"
msgid "You know, leave me and come back to the grates, any of them, I'll be there, I can talk to you there."
msgstr ""

#: hector_hvac/hector_attic_fail_return/0/c-1/50/c-1/42/c-0/47
msgctxt "Hector"
msgid "Please."
msgstr ""

#: hector_hvac/hector_attic_fail_return/0/c-1/50/c-1/42/c-0/55/0/s/0
msgctxt "Choix"
msgid "You got it."
msgstr ""

#: hector_hvac/hector_attic_fail_return/0/c-1/50/c-1/42/c-0/55/1/s/0
msgctxt "Choix"
msgid "I have safe spaces, too. It's cool. I'll see you at the grates."
msgstr ""

#: hector_hvac/hector_attic_fail_return/0/c-1/50/c-1/42/c-1/7
msgctxt "Hector"
msgid "Just let it go."
msgstr ""

#: hector_hvac/hector_attic_fail_return/0/c-1/50/c-1/42/c-1/15
msgctxt "Hector"
msgid "Is that, is that what you really are? Have I truly been this wrong, this mistaken about you?"
msgstr ""

#: hector_hvac/hector_attic_fail_return/0/c-1/50/c-2/7
msgctxt "Hector"
msgid "Wouldn't you? They all do. I have."
msgstr ""

#: hector_hvac/hector_attic_fail_return/0/c-1/50/c-2/15
msgctxt "Hector"
msgid "Nevermind. Talk about an argument for nothing."
msgstr ""

#: hector_hvac/hector_attic_fail_return/0/c-1/50/c-2/23
msgctxt "Hector"
msgid "If you leave now, we'll never have to know if you know yourself well enough to be truthful with me about this."
msgstr ""

#: hector_hvac/hector_attic_fail_return/0/c-1/50/c-2/31
msgctxt "Hector"
msgid "If you would truly leave me in peace, then leave me now."
msgstr ""

#: hector_hvac/hector_attic_fail_return/0/c-1/50/c-2/41
msgctxt "Hector"
msgid "Come back to the grates and I will be there."
msgstr ""

#: hector_hvac/hector_attic_fail_return/0/c-1/50/c-2/49/0/s/0
msgctxt "Choix"
msgid "Fine. Grates it is."
msgstr ""

#: hector_hvac/hector_attic_fail_return/0/c-1/50/c-2/49/1/s/0
msgctxt "Choix"
msgid "Wow. Someone must have really hurt you. But ok. See ya there."
msgstr ""

#: hector_hvac/hector_attic_fail_return/0/c-2/7
msgctxt "Hector"
msgid "Ah. And now the filter falls."
msgstr ""

#: hector_hvac/hector_attic/0/11
msgctxt "Narrator"
msgid "At long last Hector reveals himself—and frankly you're not sure why he's been so terrified to show himself to you. You might have expected some monstrous, vile creature, but he's just a nervous, sweet-looking vent-dweller."
msgstr ""

#: hector_hvac/hector_attic/0/19
msgctxt "Hector"
msgid "...well? Hello there. Uh..."
msgstr ""

#: hector_hvac/hector_attic/0/27/s/0
msgctxt "Choix"
msgid "Wow. Hector."
msgstr ""

#: hector_hvac/hector_attic/0/28/s/0
msgctxt "Choix"
msgid "Hey! Look at you. You did it! You're not my type, but you're cool as hell."
msgstr ""

#: hector_hvac/hector_attic/0/29/s/0
msgctxt "Choix"
msgid "Woof. Um... you look... ew."
msgstr ""

#: hector_hvac/hector_attic/0/c-0/7
msgctxt "Hector"
msgid "Wow?"
msgstr ""

#: hector_hvac/hector_attic/0/c-0/15
msgctxt "Hector"
msgid "Wow? What does, what does what does \"wow\" mean? Wh-what is, what is that? Is it a good wow or a bad wow? Please just tell me!"
msgstr ""

#: hector_hvac/hector_attic/0/c-0/26/0/s/0
msgctxt "Choix"
msgid "You are beautiful."
msgstr ""

#: hector_hvac/hector_attic/0/c-0/26/1/s/0
msgctxt "Choix"
msgid "I can't think why you've ever been self-conscious."
msgstr ""

#: hector_hvac/hector_attic/0/c-0/26/c-0/18
msgctxt "Narrator"
msgid "Hector had somehow managed to hold your gaze, but your compliment flusters him into looking away again."
msgstr ""

#: hector_hvac/hector_attic/0/c-0/26/c-0/26
msgctxt "Hector"
msgid "Beautiful. Well, well, that's, uh, yes, that-that seems like a very good word indeed."
msgstr ""

#: hector_hvac/hector_attic/0/c-0/26/c-0/34
msgctxt "Hector"
msgid "I have to say, it's not one that even in my remotest fantasies I imagined you would use."
msgstr ""

#: hector_hvac/hector_attic/0/c-0/26/c-0/42
msgctxt "Hector"
msgid "At best, I thought maybe \"cute.\""
msgstr ""

#: hector_hvac/hector_attic/0/c-0/26/c-0/50/0/s/0
msgctxt "Choix"
msgid "Don't get me wrong! You're cute, too!"
msgstr ""

#: hector_hvac/hector_attic/0/c-0/26/c-0/50/1/s/0
msgctxt "Choix"
msgid "Well buckle up, because I've got more where that came from!"
msgstr ""

#: hector_hvac/hector_attic/0/c-0/26/c-0/50/c-0/7
msgctxt "Hector"
msgid "Oh come come. One cannot be beautiful AND cute. The two are mutually exclusive!"
msgstr ""

#: hector_hvac/hector_attic/0/c-0/26/c-0/50/c-0/15/0/s/0
msgctxt "Choix"
msgid "Hector? Love ya, but you're hardly an expert in this area."
msgstr ""

#: hector_hvac/hector_attic/0/c-0/26/c-0/50/c-0/15/1/s/0
msgctxt "Choix"
msgid "Well, forgive me! I didn't know."
msgstr ""

#: hector_hvac/hector_attic/0/c-0/26/c-0/50/c-0/15/c-0/7
msgctxt "Hector"
msgid "Hm. Well. Yes, I suppose that's true. So I'm beautiful, AND I'm cute?"
msgstr ""

#: hector_hvac/hector_attic/0/c-0/26/c-0/50/c-0/15/c-0/15
msgctxt "Hector"
msgid "Today has exceeded my wildest dreams. Truly."
msgstr ""

#: hector_hvac/hector_attic/0/c-0/26/c-0/50/c-0/15/c-1/7
msgctxt "Hector"
msgid "Well, that's that's, that's quite all right. I am actually flattered that you got so carried away. It makes me feel... well... uughhhh... \"seen\"."
msgstr ""

#: hector_hvac/hector_attic/0/c-0/26/c-0/50/c-1/7
msgctxt "Hector"
msgid "You do?? I mean, well, of course you do! Look at me!"
msgstr ""

#: hector_hvac/hector_attic/0/c-0/26/c-0/50/c-1/15
msgctxt "Hector"
msgid "Oh no, no, no, that level of confidence does not quite fit yet, but maybe we'll get there."
msgstr ""

#: hector_hvac/hector_attic/0/c-0/26/c-0/50/c-1/23
msgctxt "Hector"
msgid "I, uh, I'm not sure I know quite how to thank you."
msgstr ""

#: hector_hvac/hector_attic/0/c-0/26/c-0/50/c-1/31
msgctxt "Hector"
msgid "For the first time, I can say that I-I feel truly... seen."
msgstr ""

#: hector_hvac/hector_attic/0/c-0/26/c-1/7
msgctxt "Hector"
msgid "Can you not? I mean, look at me..!"
msgstr ""

#: hector_hvac/hector_attic/0/c-0/26/c-1/18/0/s/0
msgctxt "Choix"
msgid "Hector, we're not going to do that anymore."
msgstr ""

#: hector_hvac/hector_attic/0/c-0/26/c-1/18/1/s/0
msgctxt "Choix"
msgid "I'm lookin'. And I'm likin'. Try not to talk me out of it, ok?"
msgstr ""

#: hector_hvac/hector_attic/0/c-0/26/c-1/18/c-0/7
msgctxt "Hector"
msgid "Do-do what? Oh, you mean... you mean say things like that about myself."
msgstr ""

#: hector_hvac/hector_attic/0/c-0/26/c-1/18/c-0/15
msgctxt "Hector"
msgid "Yeah, it's a very hard habit to break, my friend. I feel as though I have so much evidence that I'm not really being mean, you know, I'm just being truthful."
msgstr ""

#: hector_hvac/hector_attic/0/c-0/26/c-1/18/c-0/23/0/s/0
msgctxt "Choix"
msgid "But I am standing here, telling you the opposite."
msgstr ""

#: hector_hvac/hector_attic/0/c-0/26/c-1/18/c-0/23/1/s/0
msgctxt "Choix"
msgid "I hear you. It's hard. But you can learn a new way."
msgstr ""

#: hector_hvac/hector_attic/0/c-0/26/c-1/18/c-0/23/c-0/7
msgctxt "Hector"
msgid "Hm. Yeah, yeah you are."
msgstr ""

#: hector_hvac/hector_attic/0/c-0/26/c-1/18/c-0/23/c-0/15
msgctxt "Hector"
msgid "Okay, you came here, and you're telling me exactly what you see... I suppose you don't have a reason to lie to me, so maybe I should... trust you?"
msgstr ""

#: hector_hvac/hector_attic/0/c-0/26/c-1/18/c-0/23/c-1/7
msgctxt "Hector"
msgid "You have a lot of faith in me, I think."
msgstr ""

#: hector_hvac/hector_attic/0/c-0/26/c-1/18/c-0/23/c-1/15
msgctxt "Hector"
msgid "But I-I did invite you up here, didn't I? After spending my life swearing that I would never do that."
msgstr ""

#: hector_hvac/hector_attic/0/c-0/26/c-1/18/c-0/23/c-1/23
msgctxt "Hector"
msgid "I had actually become quite proud of my isolation."
msgstr ""

#: hector_hvac/hector_attic/0/c-0/26/c-1/18/c-0/23/c-1/31
msgctxt "Hector"
msgid "But I'm not alone now."
msgstr ""

#: hector_hvac/hector_attic/0/c-0/26/c-1/18/c-1/7
msgctxt "Hector"
msgid "Ha! Yeah. That would indeed be foolish of me, wouldn't it? I finally get up the courage to invite someone, and not just anyone but you to come here, meet me, see me..."
msgstr ""

#: hector_hvac/hector_attic/0/c-0/26/c-1/18/c-1/15
msgctxt "Hector"
msgid "...and then when you finally get here I spend our whole interlude telling you you've made a mistake!"
msgstr ""

#: hector_hvac/hector_attic/0/c-0/26/c-1/18/c-1/23
msgctxt "Hector"
msgid "Ahh, you are right. You're looking. You're liking. I-I will let you look, and I will enjoy the like."
msgstr ""

#: hector_hvac/hector_attic/0/c-1/7
msgctxt "Hector"
msgid "I-I did. Yeah. Huh."
msgstr ""

#: hector_hvac/hector_attic/0/c-1/15
msgctxt "Hector"
msgid "I did. Look at that. I..."
msgstr ""

#: hector_hvac/hector_attic/0/c-1/23
msgctxt "Hector"
msgid "I don't know what to say to you now, though, because you're here, and I've never had anyone \"be here\" before."
msgstr ""

#: hector_hvac/hector_attic/0/c-1/31
msgctxt "Hector"
msgid "I can, I can feel myself getting carried away, if I'm being honest. What you've done for me, your support, your encouragement. I could fall in love with you all over again. Oh my God. I shouldn't have said that. Sorry."
msgstr ""

#: hector_hvac/hector_attic/0/c-1/42/0/s/0
msgctxt "Choix"
msgid "About love? You're not quite my type. But I think you're cool as hell!"
msgstr ""

#: hector_hvac/hector_attic/0/c-1/42/1/s/0
msgctxt "Choix"
msgid "Well. If you wanna fall in love, I'm not gonna stop ya."
msgstr ""

#: hector_hvac/hector_attic/0/c-1/42/2/s/0
msgctxt "Choix"
msgid "Whoa, let's pump the brakes. I'm proud of you, but I'm not into you."
msgstr ""

#: hector_hvac/hector_attic/0/c-1/42/c-0/7
msgctxt "Hector"
msgid "Yeah, yes, yes, of course, that's, that's all right."
msgstr ""

#: hector_hvac/hector_attic/0/c-1/42/c-0/15
msgctxt "Hector"
msgid "My god, to even be able to say that it's alright, that I'm alright!"
msgstr ""

#: hector_hvac/hector_attic/0/c-1/42/c-0/23
msgctxt "Hector"
msgid "The idea of you rejecting me even a few days ago would have destroyed me. You were the only beautiful thing in my world."
msgstr ""

#: hector_hvac/hector_attic/0/c-1/42/c-0/31
msgctxt "Hector"
msgid "But what you've given me, even by seeing me and being honest with me... I have so much more now. Somehow I have light! I have space and opportunity!"
msgstr ""

#: hector_hvac/hector_attic/0/c-1/42/c-0/42
msgctxt "Hector"
msgid "Remarkable, really! I never could have predicted this. Go! Be someone else's type! I applaud you and I support you, and I have my own love to find!"
msgstr ""

#: hector_hvac/hector_attic/0/c-1/42/c-1/7
msgctxt "Hector"
msgid "As if you could!"
msgstr ""

#: hector_hvac/hector_attic/0/c-1/42/c-1/18
msgctxt "Hector"
msgid "There is so much energy running through me at this moment, so much power I have for love now released from shame... if you're not prepared, I fear I may overwhelm you!"
msgstr ""

#: hector_hvac/hector_attic/0/c-1/42/c-1/26/0/s/0
msgctxt "Choix"
msgid "Bring it on, sexy!"
msgstr ""

#: hector_hvac/hector_attic/0/c-1/42/c-1/26/1/s/0
msgctxt "Choix"
msgid "I'm ready for anything you can dish out. We've got time!"
msgstr ""

#: hector_hvac/hector_attic/0/c-1/42/c-1/26/c-0/7
msgctxt "Hector"
msgid "Sexy. You just called me sexy."
msgstr ""

#: hector_hvac/hector_attic/0/c-1/42/c-1/26/c-0/15
msgctxt "Hector"
msgid "And you've heard me, and felt me, but now you've seen me."
msgstr ""

#: hector_hvac/hector_attic/0/c-1/42/c-1/26/c-0/23
msgctxt "Hector"
msgid "My love..."
msgstr ""

#: hector_hvac/hector_attic/0/c-1/42/c-2/7
msgctxt "Hector"
msgid "Oh! Oh..."
msgstr ""

#: hector_hvac/hector_attic/0/c-1/42/c-2/15
msgctxt "Hector"
msgid "Oh. I... I see."
msgstr ""

#: hector_hvac/hector_attic/0/c-1/42/c-2/23
msgctxt "Hector"
msgid "Yah of course, you know, I-I-I understand and I find I am quite grateful that you brought me up short before I said or did anything else, anything more ... \"definite\"."
msgstr ""

#: hector_hvac/hector_attic/0/c-1/42/c-2/31
msgctxt "Hector"
msgid "You're proud of me, and you're here, and that's what really matters, I suppose."
msgstr ""

#: hector_hvac/hector_attic/0/c-1/42/c-2/39
msgctxt "Hector"
msgid "In the end, it would've been amazing if you had felt about me the same way I feel about you, but... what matters most is that I feel... Right? I feel, I feel good, about me."
msgstr ""

#: hector_hvac/hector_attic/0/c-1/42/c-2/47
msgctxt "Hector"
msgid "And I do. Thanks to you, yes, certainly. And thanks to my own courage."
msgstr ""

#: hector_hvac/hector_attic/0/c-1/42/c-2/55
msgctxt "Hector"
msgid "I hope we can both find someone to be \"into!\" And when we do, friend, I look forward to sharing the stories with you!"
msgstr ""

#: hector_hvac/hector_attic/0/c-2/7
msgctxt "Hector"
msgid "What's woof? I have only been familiar with that in the context of a dog. I'm afraid I don't understand how it would apply here?"
msgstr ""

#: hector_hvac/hector_attic/0/c-2/15/0/s/0
msgctxt "Choix"
msgid "Oh, sorry. It's a way of saying \"no\" to something."
msgstr ""

#: hector_hvac/hector_attic/0/c-2/15/1/s/0
msgctxt "Choix"
msgid "Man... are you out of touch."
msgstr ""

#: hector_hvac/hector_attic/0/c-2/15/c-0/7
msgctxt "Hector"
msgid "No. The only thing taking place here that I'm aware of is me letting myself be seen. That's what we're doing, that's that's why you came here."
msgstr ""

#: hector_hvac/hector_attic/0/c-2/15/c-0/15
msgctxt "Hector"
msgid "So the only thing I can think that you would be saying no to... is me."
msgstr ""

#: hector_hvac/hector_attic/0/c-2/15/c-0/23
msgctxt "Hector"
msgid "No to me, and the real me this time, not the mask I'd so carefully constructed to protect myself from... precisely this experience."
msgstr ""

#: hector_hvac/hector_attic/0/c-2/15/c-0/31
msgctxt "Hector"
msgid "Please... uh, jump in at any point and tell me how dreadfully I've misunderstood this..."
msgstr ""

#: hector_hvac/hector_attic/0/c-2/15/c-0/42/0/s/0
msgctxt "Choix"
msgid "No, you've pretty much got it."
msgstr ""

#: hector_hvac/hector_attic/0/c-2/15/c-0/42/1/s/0
msgctxt "Choix"
msgid "Ha! Gotcha!!"
msgstr ""

#: hector_hvac/hector_attic/0/c-2/15/c-0/42/c-1/7
msgctxt "Hector"
msgid "What? I don't know. What? What?"
msgstr ""

#: hector_hvac/hector_attic/0/c-2/15/c-0/42/c-1/18/0/s/0
msgctxt "Choix"
msgid "Just kidding!"
msgstr ""

#: hector_hvac/hector_attic/0/c-2/15/c-0/42/c-1/18/1/s/0
msgctxt "Choix"
msgid "You're fine looking, I was just trying to freak you out."
msgstr ""

#: hector_hvac/hector_attic/0/c-2/15/c-0/42/c-1/18/g-0/0
msgctxt "Hector"
msgid "You chose this moment. This most vulnerable moment. To make a joke out of me?"
msgstr ""

#: hector_hvac/hector_attic/0/c-2/15/c-0/42/c-1/18/g-0/11
msgctxt "Hector"
msgid "I don't even care now how you meant it. Your timing is repugnant."
msgstr ""

#: hector_hvac/hector_attic/0/c-2/15/c-1/7
msgctxt "Hector"
msgid "Well... yes. Unless you're just now joining us, I've sequestered myself in a dark attic for the last several decades, so it should make sense that there are some cultural moments I've missed."
msgstr ""

#: hector_hvac/hector_attic/0/c-2/15/c-1/15
msgctxt "Hector"
msgid "It's strange to me that my being out of touch is even the topic of our conversation."
msgstr ""

#: hector_hvac/hector_attic/0/c-2/15/c-1/23
msgctxt "Hector"
msgid "Either you are being deliberately evasive in order to avoid hurting my feelings, or you are so underwhelmed by me that I do not deserve even a full moment of consideration."
msgstr ""

#: hector_hvac/hector_attic/0/c-2/15/c-1/31/0/s/0
msgctxt "Choix"
msgid "Meh. Pick one. I gotta go."
msgstr ""

#: hector_hvac/hector_attic/0/c-2/15/c-1/31/1/s/0
msgctxt "Choix"
msgid "I think you are ugly. There. Clear enough?"
msgstr ""

#: hector_hvac/hector_attic/0/c-2/15/c-1/31/c-1/7
msgctxt "Hector"
msgid "Oh god, well this is a new pain."
msgstr ""

#: hector_hvac/hector_love_joiner/0/0
msgctxt "Hector"
msgid "Oh, you know me by now. You know I am good with words- that I enjoy them."
msgstr ""

#: hector_hvac/hector_love_joiner/0/8
msgctxt "Hector"
msgid "But right now, the only words I have are \"thank you.\""
msgstr ""

#: hector_hvac/hector_love_joiner/0/16
msgctxt "Hector"
msgid "What you've done for me, I cannot fully express, but I hope beyond hope that maybe, somehow, you understand."
msgstr ""

#: hector_hvac/hector_love_joiner/0/27/s/0
msgctxt "Choix"
msgid "I love you, Hector."
msgstr ""

#: hector_hvac/hector_love_joiner/0/28/s/0
msgctxt "Choix"
msgid "I do understand... but not as lovers, merely friends."
msgstr ""

#: hector_hvac/hector_love_joiner/0/c-0/7
msgctxt "Hector"
msgid "Incredible... The dreamings of a silly ventilation system... made manifest."
msgstr ""

#: hector_hvac/hector_love_joiner/0/c-0/15
msgctxt "Hector"
msgid "I love you too."
msgstr ""

#: hector_hvac/hector_love_joiner/0/c-1/7
msgctxt "Hector"
msgid "Anything to increase my proximity to you I will take with all my heart."
msgstr ""

#: hector_hvac/hector_love_joiner/0/c-1/15
msgctxt "Hector"
msgid "Though my love is unrequited, it will not sully our relationship one bit."
msgstr ""

#: hector_hvac/hector_love_joiner/0/c-1/23
msgctxt "Hector"
msgid "I have filters for that..."
msgstr ""

#: hector_hvac/hector_friend_joiner/0
msgctxt "Hector"
msgid "Please come back. Anytime. I'll be here, my friend."
msgstr ""

#: hector_hvac/hector_hate_joiner/0/10
msgctxt "Hector"
msgid "Here is the truth of you."
msgstr ""

#: hector_hvac/hector_hate_joiner/0/18
msgctxt "Hector"
msgid "It is a truth I would have dreaded, if I'd ever even let myself consider that it might be what was underneath that exterior I have warmed and cooled and cared for."
msgstr ""

#: hector_hvac/hector_hate_joiner/0/26
msgctxt "Hector"
msgid "God, if I had ever truly believed you could be capable of this..."
msgstr ""

#: hector_hvac/hector_hate_joiner/0/34
msgctxt "Hector"
msgid "...I would have frozen you out."
msgstr ""

#: hector_hvac/hector_hate_joiner/0/45
msgctxt "Hector"
msgid "It would have been an arctic blast to rival the coldest winter's chill. The ice would've rimmed the windows to match the coldness of your heart!"
msgstr ""

#: hector_hvac/hector_hate_joiner/0/53/s/0
msgctxt "Choix"
msgid "That's vivid. I'm sorry I'm being a jerk."
msgstr ""

#: hector_hvac/hector_hate_joiner/0/54/s/0
msgctxt "Choix"
msgid "Ooooh I'm so scared..."
msgstr ""

#: hector_hvac/hector_hate_joiner/0/55/s/0
msgctxt "Choix"
msgid "Big whoop."
msgstr ""

#: hector_hvac/hector_hate_joiner/0/c-0/7
msgctxt "Hector"
msgid "Jerk. What a flippant word. You've been cruel."
msgstr ""

#: hector_hvac/hector_hate_joiner/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "Eh. I haven't been that bad."
msgstr ""

#: hector_hvac/hector_hate_joiner/0/c-0/15/1/s/0
msgctxt "Choix"
msgid "Yeah... I have. I'm sorry."
msgstr ""

#: hector_hvac/hector_hate_joiner/0/c-0/15/c-0/7
msgctxt "Hector"
msgid "I will not be put in the position of convincing you of your own behavior!"
msgstr ""

#: hector_hvac/hector_hate_joiner/0/c-0/15/c-0/18
msgctxt "Hector"
msgid "I am not your teacher, I am not responsible for you getting better."
msgstr ""

#: hector_hvac/hector_hate_joiner/0/c-0/15/c-0/26
msgctxt "Hector"
msgid "I am not your parent, that I care one iota whether or not you evolve or mature."
msgstr ""

#: hector_hvac/hector_hate_joiner/0/c-0/15/c-0/34
msgctxt "Hector"
msgid "I am, apparent to all now, not even your friend. I care not. I waste not one more breath on you!"
msgstr ""

#: hector_hvac/hector_hate_joiner/0/c-0/15/c-1/7
msgctxt "Hector"
msgid "Is that an apology?"
msgstr ""

#: hector_hvac/hector_hate_joiner/0/c-0/15/c-1/15
msgctxt "Hector"
msgid "I think I'm disgusted."
msgstr ""

#: hector_hvac/hector_hate_joiner/0/c-0/15/c-1/26
msgctxt "Hector"
msgid "I may just be tired."
msgstr ""

#: hector_hvac/hector_hate_joiner/0/c-0/15/c-1/34
msgctxt "Hector"
msgid "Either way, I will not do this now. Not anymore. I won't dignify this with another moment of my time, not here, not here where I have already told you you are not welcome."
msgstr ""

#: hector_hvac/hector_hate_joiner/0/c-0/15/c-1/42
msgctxt "Hector"
msgid "Please, get out. Maybe we can try again... at the grates."
msgstr ""

#: hector_hvac/hector_hate_joiner/0/c-1/7
msgctxt "Hector"
msgid "No you aren't, not really. Not yet."
msgstr ""

#: hector_hvac/hector_hate_joiner/0/c-1/18
msgctxt "Hector"
msgid "If you understood the power I truly wield over you, the innumerable ways I have protected you, sheltered you..."
msgstr ""

#: hector_hvac/hector_hate_joiner/0/c-1/26
msgctxt "Hector"
msgid "...coddled you! Then the fear would be seeping out of you like coolant. Thick. Frigid. Overwhelming."
msgstr ""

#: hector_hvac/hector_hate_joiner/0/c-1/34
msgctxt "Hector"
msgid "But I have time. Time is all I have, and one day, you will see."
msgstr ""

#: hector_hvac/hector_hate_joiner/0/c-2/7
msgctxt "Hector"
msgid "Cocky? Huh, cocky, is it? That's your defense."
msgstr ""

#: hector_hvac/hector_hate_joiner/0/c-2/15
msgctxt "Hector"
msgid "The refuge of every playground bully since time immemorial?"
msgstr ""

#: hector_hvac/hector_hate_joiner/0/c-2/23
msgctxt "Hector"
msgid "Excellent. I hope your ego blows you up and you float away on a greasy bubble of self-importance."
msgstr ""

#: hector_hvac/hector_hate_joiner/0/c-2/31
msgctxt "Hector"
msgid "Because when that bubble finally bursts, you will hit the ground alone."
msgstr ""

#: hector_hvac/hector_hate_joiner/0/c-2/39
msgctxt "Hector"
msgid "No one will be there with warmth, or comfort. No one will be there at all."
msgstr ""

#: hector_hvac/hector_hate_joiner/0/c-2/47
msgctxt "Hector"
msgid "Such is the fate of the arrogant. And I am patient enough to wait... to wait for the day when your bill comes due."
msgstr ""

#: hector_hvac/keyes_hector/0/0/b/1 hector_hvac/keyes_hector_attic/0/4/b/1 hector_hvac/keyes_hector_attic_revealed/0/0/b/1
msgctxt "Hector"
msgid "Hmmm, you look like you have something on your mind, my beauty."
msgstr ""

#: hector_hvac/keyes_hector/0/3/b/1 hector_hvac/keyes_hector_attic/0/5/b/1 hector_hvac/keyes_hector_attic_revealed/0/1/b/1
msgctxt "Hector"
msgid "What do you want."
msgstr ""

#: hector_hvac/keyes_hector/0/6/s/0 hector_hvac/keyes_hector_attic/0/8/s/0 hector_hvac/keyes_hector_attic_revealed/0/4/s/0
msgctxt "Choix"
msgid "Yeah, Keyes says she needs the temperature an exact degree for her to play?"
msgstr ""

#: hector_hvac/keyes_hector/0/c-0/7 hector_hvac/keyes_hector_attic/0/c-0/7 hector_hvac/keyes_hector_attic_revealed/0/c-0/7
msgctxt "Hector"
msgid "Hah! Of course she did."
msgstr ""

#: hector_hvac/keyes_hector/0/c-0/15 hector_hvac/keyes_hector_attic/0/c-0/15 hector_hvac/keyes_hector_attic_revealed/0/c-0/15
msgctxt "Hector"
msgid "Twenty degrees! Could you imagine?"
msgstr ""

#: hector_hvac/keyes_hector/0/c-0/23/0/s/0 hector_hvac/keyes_hector_attic/0/c-0/26/0/s/0 hector_hvac/keyes_hector_attic_revealed/0/c-0/26/0/s/0
msgctxt "Choix"
msgid "Actually, I think she meant Celsius."
msgstr ""

#: hector_hvac/keyes_hector/0/c-0/23/c-0/7 hector_hvac/keyes_hector_attic/0/c-0/26/c-0/7 hector_hvac/keyes_hector_attic_revealed/0/c-0/26/c-0/7
msgctxt "Hector"
msgid "What! The nerve."
msgstr ""

#: hector_hvac/keyes_hector/0/c-0/23/c-0/18/0/s/0 hector_hvac/keyes_hector_attic/0/c-0/26/c-0/15/0/s/0 hector_hvac/keyes_hector_attic_revealed/0/c-0/26/c-0/15/0/s/0
msgctxt "Choix"
msgid "Are you going to be able to help?"
msgstr ""

#: hector_hvac/keyes_hector/0/c-0/23/c-0/18/c-0/7 hector_hvac/keyes_hector_attic/0/c-0/26/c-0/15/c-0/7 hector_hvac/keyes_hector_attic_revealed/0/c-0/26/c-0/15/c-0/7
msgctxt "Hector"
msgid "Sigh. Perhaps. I have a converter around here somewhere."
msgstr ""

#: hector_hvac/keyes_hector/0/c-0/23/c-0/18/c-0/15 hector_hvac/keyes_hector_attic/0/c-0/26/c-0/15/c-0/15 hector_hvac/keyes_hector_attic_revealed/0/c-0/26/c-0/15/c-0/15
msgctxt "Hector"
msgid "But still, she needs to treat us lowly objects a little less like a baroness!"
msgstr ""

#: hector_hvac/keyes_hector/0/c-0/23/c-0/18/c-0/29 hector_hvac/keyes_hector_attic/0/c-0/26/c-0/15/c-0/29 hector_hvac/keyes_hector_attic_revealed/0/c-0/26/c-0/15/c-0/29
msgctxt "Hector"
msgid "Now then... what was I going to say before this interruption?"
msgstr ""

#: hector_hvac/hector_friend_return/0/0 hector_hvac/hector_friend_return_attic/0/0
msgctxt "Hector"
msgid "Hello again my friend!"
msgstr ""

#: hector_hvac/hector_friend_return/0/8 hector_hvac/hector_friend_return_attic/0/8
msgctxt "Hector"
msgid "What a pleasure to see you again. Why have you come? How can I help you?"
msgstr ""

#: hector_hvac/hector_friend_return/0/16/s/0 hector_hvac/hector_friend_return_attic/0/16/s/0
msgctxt "Choix"
msgid "Just stopping by to say hello!"
msgstr ""

#: hector_hvac/hector_friend_return/0/17/s/0 hector_hvac/hector_friend_return_attic/0/17/s/0 hector_hvac/hector_love_return/0/17/s/0 hector_hvac/hector_love_return_attic/0/20/s/0
msgctxt "Choix"
msgid "I'm ready to Realize you, Hector!"
msgstr ""

#: hector_hvac/hector_friend_return/0/c-0/7 hector_hvac/hector_friend_return_attic/0/c-0/7
msgctxt "Hector"
msgid "Well. As always, you are very welcome to stop by."
msgstr ""

#: hector_hvac/hector_friend_return/0/c-0/15 hector_hvac/hector_friend_return_attic/0/c-0/15
msgctxt "Hector"
msgid "Perhaps in a bit I could offer you a nice temperature bath!"
msgstr ""

#: hector_hvac/hector_friend_return/0/c-0/23
msgctxt "Hector"
msgid "I've discovered a fun way to alternate the heat and cooling to produce a deeply relaxing effect. I'll show you later!"
msgstr ""

#: hector_hvac/hector_friend_return_attic/0/c-0/23
msgctxt "Hector"
msgid "I've discovered a fun way to alternate the heat and cooling to produce a deeply relaxing effect. I can show you later."
msgstr ""

#: hector_hvac/hector_love_return/0/0
msgctxt "Hector"
msgid "My love, you've returned."
msgstr ""

#: hector_hvac/hector_love_return/0/8 hector_hvac/hector_love_return_attic/0/8
msgctxt "Hector"
msgid "There is, you know, the most amazing rush of air in my chest each time I behold you now."
msgstr ""

#: hector_hvac/hector_love_return/0/16/s/0 hector_hvac/hector_love_return_attic/0/19/s/0
msgctxt "Choix"
msgid "Of course I've returned, to be spoken to like this."
msgstr ""

#: hector_hvac/hector_love_return/0/c-0/7
msgctxt "Hector"
msgid "What can I say? You inspire me."
msgstr ""

#: hector_hvac/hector_love_return/0/c-0/15 hector_hvac/hector_love_return_attic/0/c-0/15
msgctxt "Hector"
msgid "You are like breathing freedom."
msgstr ""

#: hector_hvac/hector_love_return_attic/0/0
msgctxt "Hector"
msgid "My love. You have returned."
msgstr ""

#: hector_hvac/hector_love_return_attic/0/c-0/7
msgctxt "Hector"
msgid "Well, what can I say? You inspire me."
msgstr ""

#: hector_hvac/hector_hate_return/0/10
msgctxt "Hector"
msgid "Huh. I cannot say that I thought to see you again. I cannot say either that it pleases me over much."
msgstr ""

#: hector_hvac/hector_hate_return/0/18/s/0 hector_hvac/hector_hate_return_attic/0/18/s/0
msgctxt "Choix"
msgid "Ha. Whatever. I'm not overmuched either. I'm outta here."
msgstr ""

#: hector_hvac/hector_hate_return/0/19/s/0 hector_hvac/hector_hate_return_attic/0/19/s/0
msgctxt "Choix"
msgid "Hector, can we start over? I didn't do a good job of honoring your needs. (USE EMPATHY CANDY)"
msgstr ""

#: hector_hvac/hector_hate_return/0/c-1/7 hector_hvac/hector_hate_return_attic/0/c-1/13
msgctxt "Hector"
msgid "No. No you didn't."
msgstr ""

#: hector_hvac/hector_hate_return/0/c-1/15
msgctxt "Hector"
msgid "But my sentiment for you is still such that... yes. Yes, I suppose we can try again."
msgstr ""

#: hector_hvac/hector_hate_return/0/c-1/23 hector_hvac/hector_hate_return_attic/0/c-1/29
msgctxt "Hector"
msgid "Sometimes I wish I could hate you. But c'est la vie."
msgstr ""

#: hector_hvac/hector_hate_return/0/c-1/37/0/s/0 hector_hvac/hector_hate_return_attic/0/c-1/46/0/s/0
msgctxt "Choix"
msgid "All I had to do was ask?"
msgstr ""

#: hector_hvac/hector_hate_return/0/c-1/37/c-0/7
msgctxt "Hector"
msgid "Well... yes. I have found that communication is not really terrible and difficult... if one will try."
msgstr ""

#: hector_hvac/hector_hate_return/0/c-1/37/c-0/15
msgctxt "Hector"
msgid "There is nothing to be lost in an honest attempt. And I can feel that's what you have brought to me."
msgstr ""

#: hector_hvac/hector_hate_return/0/c-1/37/c-0/23 hector_hvac/hector_hate_return_attic/0/c-1/46/c-0/23
msgctxt "Hector"
msgid "I value any true friendship, regardless of the winding of the path that has led there."
msgstr ""

#: hector_hvac/hector_hate_return_denied/0/0 hector_hvac/hector_hate_return_denied_attic/0/0
msgctxt "Hector"
msgid "How dare you. Truly, HOW do you dare to show your face to me?"
msgstr ""

#: hector_hvac/hector_hate_return_denied/0/14/s/0 hector_hvac/hector_hate_return_denied_attic/0/8/s/0
msgctxt "Choix"
msgid "You're right. Bad move. Byeeee."
msgstr ""

#: hector_hvac/hector_hate_return_denied/0/15/s/0 hector_hvac/hector_hate_return_denied_attic/0/9/s/0
msgctxt "Choix"
msgid "Hector, can we please be friends? I feel really bad. (USE EMPATHY CANDY)"
msgstr ""

#: hector_hvac/hector_hate_return_denied/0/c-1/13
msgctxt "Hector"
msgid "Oh, do you?"
msgstr ""

#: hector_hvac/hector_hate_return_denied/0/c-1/21 hector_hvac/hector_hate_return_denied_attic/0/c-1/24
msgctxt "Hector"
msgid "You feel bad. For humiliating and mocking me? Or for getting to know me before you did that, to make sure it would sting?"
msgstr ""

#: hector_hvac/hector_hate_return_denied/0/c-1/29 hector_hvac/hector_hate_return_denied_attic/0/c-1/32
msgctxt "Hector"
msgid "I'm going to give you the benefit of the doubt. Which I may say is an extraordinarily generous move on my part, and say you feel terribly for both actions."
msgstr ""

#: hector_hvac/hector_hate_return_denied/0/c-1/43/0/s/0 hector_hvac/hector_hate_return_denied_attic/0/c-1/46/0/s/0
msgctxt "Choix"
msgid "I do. Truly. I'm sorry."
msgstr ""

#: hector_hvac/hector_hate_return_denied/0/c-1/43/1/s/0 hector_hvac/hector_hate_return_denied_attic/0/c-1/46/1/s/0
msgctxt "Choix"
msgid "Thanks for giving me another shot."
msgstr ""

#: hector_hvac/hector_hate_return_denied/0/g-0/0 hector_hvac/hector_hate_return_denied_attic/0/g-0/0
msgctxt "Hector"
msgid "You're welcome. Despite recent events, I have a new confidence. A new trust in myself."
msgstr ""

#: hector_hvac/hector_hate_return_denied/0/g-0/8 hector_hvac/hector_hate_return_denied_attic/0/g-0/8
msgctxt "Hector"
msgid "You and I can try again not because I am lonesome or afraid, but because I am willing to see the best in you."
msgstr ""

#: hector_hvac/hector_hate_return_denied/0/g-0/16 hector_hvac/hector_hate_return_denied_attic/0/g-0/16
msgctxt "Hector"
msgid "A best I can now see in me, too."
msgstr ""

#: hector_hvac/hector_hate_return_denied/0/g-0/24
msgctxt "Hector"
msgid "I would value a real friendship, and since that seems to be what you offer..."
msgstr ""

#: hector_hvac/hector_hate_return_denied/0/g-0/32 hector_hvac/hector_hate_return_denied_attic/0/g-0/32
msgctxt "Hector"
msgid "...I suppose we shall see."
msgstr ""

#: hector_hvac/hector_hate_return_attic/0/10
msgctxt "Hector"
msgid "Oh, uh, I cannot say I thought to see you again. I cannot say either that it pleases me overmuch."
msgstr ""

#: hector_hvac/hector_hate_return_attic/0/c-1/21
msgctxt "Hector"
msgid "But my sentiment for you is still such that... yes. Yes, we can try again."
msgstr ""

#: hector_hvac/hector_hate_return_attic/0/c-1/46/c-0/7
msgctxt "Hector"
msgid "Well... yes. I have found that communication is not really terrible and difficult... if one is willing to try."
msgstr ""

#: hector_hvac/hector_hate_return_attic/0/c-1/46/c-0/15
msgctxt "Hector"
msgid "There is nothing to be lost in an honest attempt. And I can feel that's what you've brought to me."
msgstr ""

#: hector_hvac/hector_hate_return_denied_attic/0/c-1/13
msgctxt "Hector"
msgid "Oh, you feel bad, do you?"
msgstr ""

#: hector_hvac/hector_hate_return_denied_attic/0/g-0/24
msgctxt "Hector"
msgid "I would value a real friendship, and since that seems to be what you offer me..."
msgstr ""

#: hector_hvac/hector_redo_hate_return/0
msgctxt "Hector"
msgid "Oh look who it is."
msgstr ""

#: hector_hvac/hector_redo_hate_return/8
msgctxt "Hector"
msgid "I wish I had it in me to laugh at you."
msgstr ""

#: hector_hvac/hector_redo_hate_return/16
msgctxt "Hector"
msgid "No, I don't. All I feel is disgust."
msgstr ""

#: hector_hvac/hector_redo_hate_return/27
msgctxt "Hector"
msgid "You had so many chances. You had to know what was right, and what was brutal, and you made your choices."
msgstr ""

#: hector_hvac/hector_redo_hate_return/35
msgctxt "Hector"
msgid "I'll have you know, it is only for my own pride that I still do my duty by the house."
msgstr ""

#: hector_hvac/hector_redo_hate_return/43
msgctxt "Hector"
msgid "Worried only about my feelings? I should freeze you out!"
msgstr ""

#: hector_hvac/hector_redo_hate_return/51
msgctxt "Hector"
msgid "Now begone. There is nothing here for you."
msgstr ""

#: hector_hvac/hector_redo_hate_return_attic/0
msgctxt "Hector"
msgid "NO! Ye gods..."
msgstr ""

#: hector_hvac/hector_redo_hate_return_attic/8
msgctxt "Hector"
msgid "What have I done to merit such cruelty."
msgstr ""

#: hector_hvac/hector_redo_hate_return_attic/16
msgctxt "Hector"
msgid "Not for lack of instruction, not for lack of chances or of grace, you once again beat me into the dust..."
msgstr ""

#: hector_hvac/hector_redo_hate_return_attic/24
msgctxt "Hector"
msgid "...and now you return?? Again??? For what?!"
msgstr ""

#: hector_hvac/hector_redo_hate_return_attic/35
msgctxt "Hector"
msgid "Even if absolution were mine to offer, I should withhold it!"
msgstr ""

#: hector_hvac/hector_redo_hate_return_attic/43
msgctxt "Hector"
msgid "Get out. You are not welcome here. You shall NEVER be welcome by me again!"
msgstr ""

#: hector_hvac/hector_realize_join/0/0
msgctxt "Hector"
msgid "Realize? You've come to realize me?"
msgstr ""

#: hector_hvac/hector_realize_join/0/8 hector_hvac/hector_realize_join_attic/0/8
msgctxt "Hector"
msgid "You can do that??"
msgstr ""

#: hector_hvac/hector_realize_join/0/28/s/0 hector_hvac/hector_realize_join_attic/0/28/s/0
msgctxt "Choix"
msgid "Yep I can! And I can do it right now, if you're ready!"
msgstr ""

#: hector_hvac/hector_realize_join/0/29/s/0 hector_hvac/hector_realize_join_attic/0/29/s/0
msgctxt "Choix"
msgid "I do have the power... just not the stuff. But I'll be back!"
msgstr ""

#: hector_hvac/hector_realize_join/0/c-1/10 hector_hvac/hector_realize_join_attic/0/c-1/10
msgctxt "Hector"
msgid "Well then for goodness' sake, go get the stuff!"
msgstr ""

#: hector_hvac/hector_realize_join/0/c-1/18
msgctxt "Hector"
msgid "Whatever \"stuff\" is. I would be curious if I weren't so distracted by my excitement! Oh, I'm sorry, too excited."
msgstr ""

#: hector_hvac/hector_realize_join/0/c-1/26 hector_hvac/hector_realize_join_attic/0/c-1/26
msgctxt "Hector"
msgid "I will wait here. I literally will not move."
msgstr ""

#: hector_hvac/hector_realize_join_attic/0/0
msgctxt "Hector"
msgid "Realize. You have come to Realize me?"
msgstr ""

#: hector_hvac/hector_realize_join_attic/0/c-1/18
msgctxt "Hector"
msgid "Whatever \"stuff\" is. I would be curious if I weren't so distracted by my excitement!"
msgstr ""

#: hector_hvac/hector_realize_return/0/0 hector_hvac/hector_realize_return_attic/0/0
msgctxt "Hector"
msgid "You're back. Do you have \"the stuff\"?"
msgstr ""

#: hector_hvac/hector_realize_return/0/17/s/0 hector_hvac/hector_realize_return_attic/0/17/s/0
msgctxt "Choix"
msgid "Stuff in hand, pal."
msgstr ""

#: hector_hvac/hector_realize_return/0/18/s/0 hector_hvac/hector_realize_return_attic/0/18/s/0
msgctxt "Choix"
msgid "Nope... just making sure you're still game!"
msgstr ""

#: hector_hvac/hector_realize_return/0/c-1/10 hector_hvac/hector_realize_return_attic/0/c-1/10
msgctxt "Hector"
msgid "I am very familiar with the process of teasing someone with something you know they cannot actually have."
msgstr ""

#: hector_hvac/hector_realize_return/0/c-1/18 hector_hvac/hector_realize_return_attic/0/c-1/18
msgctxt "Hector"
msgid "I tell you, if that is what you're doing to me..."
msgstr ""

#: hector_hvac/hector_realize_return/0/c-1/26 hector_hvac/hector_realize_return_attic/0/c-1/26
msgctxt "Hector"
msgid "I will turn this house into a sauna. And not the good kind."
msgstr ""

#: hector_hvac/hector_realize_return/0/c-1/34
msgctxt "Hector"
msgid "Ooooh, I don't mean to be rude, please just hurry, I cannot wait to be alive!"
msgstr ""

#: hector_hvac/hector_realize_return_attic/0/c-1/34
msgctxt "Hector"
msgid "Ooooh I don't mean to be rude, please hurry, I cannot wait to be alive!"
msgstr ""

#: hector_hvac/hector_realize_begin/6/b/1
msgctxt "Skylar"
msgid "Can Hector handle being Realized? He'll be a whole lot more visible now..."
msgstr ""

#: hector_hvac/hector_realize_begin/9
msgctxt "Skylar"
msgid "Okay, Hector let's breathe life into you!"
msgstr ""

#: hector_hvac/hector_realize_begin/20
msgctxt "Narrator"
msgid "The spectral energy flows through your dateviators, and what was once merely an HVAC system, becomes...."
msgstr ""

#: hector_hvac/hector_realized/0/3
msgctxt "Hector"
msgid "Oh... oh my... look at me!"
msgstr ""

#: hector_hvac/hector_realized/0/11
msgctxt "Hector"
msgid "Do you have any idea how remarkable... I have <w>CURVES!</w>"
msgstr ""

#: hector_hvac/hector_realized/0/19/s/0
msgctxt "Choix"
msgid "Yes, you do, Hector. You've got all kinds of shapes now!"
msgstr ""

#: hector_hvac/hector_realized/0/20/s/0
msgctxt "Choix"
msgid "And my oh my, what fetching curves they are!"
msgstr ""

#: hector_hvac/hector_love_divert/0/0
msgctxt "Hector"
msgid "My muscles, they're so warm. I had no idea that flesh could feel so different from metal!"
msgstr ""

#: hector_hvac/hector_love_divert/0/8/s/0
msgctxt "Choix"
msgid "Oh, I did."
msgstr ""

#: hector_hvac/hector_love_divert/0/9/s/0
msgctxt "Choix"
msgid "You were beautiful then, and you're beautiful now. Kiss me."
msgstr ""

#: hector_hvac/hector_love_divert/0/g-0/3
msgctxt "Hector"
msgid "My love, I cannot tell you the pleasure I feel at being able now, at last, to touch you..."
msgstr ""

#: hector_hvac/hector_love_divert/0/g-0/11
msgctxt "Narrator"
msgid "Hector's fascination with his newfound body turns out to be an interest that you share."
msgstr ""

#: hector_hvac/hector_love_divert/0/g-0/19
msgctxt "Narrator"
msgid "And as much as the interest itself, the two of you find a shared passion for taking your time in the exploration."
msgstr ""

#: hector_hvac/hector_love_divert/0/g-0/27
msgctxt "Narrator"
msgid "It is without self-consciousness at all that Hector spends a solid hour tracing the curves and hollows of your back."
msgstr ""

#: hector_hvac/hector_love_divert/0/g-0/35
msgctxt "Narrator"
msgid "His hands feel so alive. So sensitive. You can feel them learning you as he touches you. To him, you are both the inspiration and the medium."
msgstr ""

#: hector_hvac/hector_love_divert/0/g-0/43
msgctxt "Hector"
msgid "If I were blindfolded, my love, I could recreate you. I could trace your body from memory. I would even remember the colors of you."
msgstr ""

#: hector_hvac/hector_love_divert/0/g-0/51
msgctxt "Narrator"
msgid "It is a night of simple worship and profound visibility for you both."
msgstr ""

#: hector_hvac/hector_love_divert/0/g-0/59
msgctxt "Narrator"
msgid "In the morning, with a tight hug, you bid him farewell. The world has a beautiful new artist of life, and there is celebrating to be done."
msgstr ""

#: hector_hvac/hector_love_join/0
msgctxt "Narrator"
msgid "Hector, vividly recalling his own experiences with shame and the fear of being seen, found that he had not been alone in that out in the wider world."
msgstr ""

#: hector_hvac/hector_love_join/8
msgctxt "Narrator"
msgid "An entire digital world had arisen. That hiding one's true self behind an avatar was commonplace - and sometimes necessary."
msgstr ""

#: hector_hvac/hector_love_join/16
msgctxt "Narrator"
msgid "Late one night, Hector's artistic sensitivity and curiosity led him down a dark cobblestone street... into a mask-making workshop."
msgstr ""

#: hector_hvac/hector_love_join/24
msgctxt "Narrator"
msgid "He studied the ancient art... where he learned how masks can be powerful things. For hiding, and for expression."
msgstr ""

#: hector_hvac/hector_love_join/32
msgctxt "Narrator"
msgid "His creations quickly became the talk of the town, and his work soon became sought after from much further afield; his sensitivity as an artist set his work in a category of its own."
msgstr ""

#: hector_hvac/hector_love_join/40
msgctxt "Narrator"
msgid "His creations were not simply functional; they were loving. And they brought the fun of the masquerade back into vogue."
msgstr ""

#: hector_hvac/hector_love_join/48
msgctxt "Hector"
msgid "Hide... and be seen!"
msgstr ""
