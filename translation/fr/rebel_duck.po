# Traduction IA – à relire
#: rebel_duck/Rebel_Breakthrough_3/0/g-8/10/s/0
msgctxt "Choix"
msgid "Erm. Thanks."
msgstr "Euh. Merci."

# Traduction IA – à relire
#: rebel_duck/Rebel_Breakthrough_3/0/g-9/0
msgctxt "Rebel"
msgid "I mean... your empathy. Your quiet strength."
msgstr "Je veux dire... ton empathie. Ta force tranquille."

# Traduction IA – à relire
#: rebel_duck/Rebel_Breakthrough_3/0/g-9/8
msgctxt "Rebel"
msgid "Your willingness to listen."
msgstr "Ta volonté d'écouter."

# Traduction IA – à relire
#: rebel_duck/Rebel_Breakthrough_3/0/g-9/16
msgctxt "Rebel"
msgid "I'm sorry, I'm trying to keep it together over here."
msgstr "Pardon, j'essaie de me tenir, là."

# Traduction IA – à relire
#: rebel_duck/Rebel_Breakthrough_3/0/g-9/24
msgctxt "Rebel"
msgid "I know you told me to pull back on the sexual stuff so..."
msgstr "Je sais que tu m'as dit de lever le pied sur le côté sexuel donc..."

# Traduction IA – à relire
#: rebel_duck/Rebel_Breakthrough_3/0/g-9/32
msgctxt "Rebel"
