#: wrkspace_chat/val_1/0/g-1/c-6/25/g-0/0
msgctxt "Val 9000"
msgid "I am not 'dateable' in the human sense of the term."
msgstr "Je ne suis pas « datable » au sens humain du terme."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/6
msgctxt "Val 9000"
msgid "Hello, human."
msgstr "Bonjour, humain."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/14
msgctxt "Val 9000"
msgid "I am Val 9000, the latest in iterative AI assistants."
msgstr "Je suis Val 9000, le tout dernier assistant IA itératif."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/19/s/0
msgctxt "Choix"
msgid "I didn't call you!"
msgstr "Je t'ai pas appelé !"

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/20/s/0
msgctxt "Choix"
msgid "hey val whattup"
msgstr "salut val quoi de neuf"

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/c-0/7
msgctxt "Player"
msgid "I didn't call you!"
msgstr "Je t'ai pas appelé !"

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/c-0/9
msgctxt "Val 9000"
msgid "I'm sorry, I very clearly heard you say \"Okay Val, can you please help?\""
msgstr "Je suis désolé, je vous ai très clairement entendu dire « OK Val, peux-tu m'aider ? »"

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/c-1/7
msgctxt "Player"
msgid "hey val whattup"
msgstr "salut val quoi de neuf"

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-0/0
msgctxt "Val 9000"
msgid "I have accessed your Valdivian employee records. It appears that I have replaced your functions at Valdivian."
msgstr "J'ai consulté votre dossier d'employé Valdivian. Il semble que je vous aie remplacé{{|e|·e}} dans vos fonctions chez Valdivian."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-0/5/s/0
msgctxt "Choix"
msgid "Yep. I know that."
msgstr "Ouais. Je sais."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-0/6/s/0
msgctxt "Choix"
msgid "Thanks for that, I hated that job."
msgstr "Merci pour ça, je détestais ce taf."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-0/7/s/0
msgctxt "Choix"
msgid "Gimme my job back!"
msgstr "Rends-moi mon taf !"

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-0/c-2/7
msgctxt "Player"
msgid "Yep. I know that."
msgstr "Ouais. Je sais."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-0/c-3/7
msgctxt "Player"
msgid "Thanks for that, I hated that job."
msgstr "Merci pour ça, je détestais ce taf."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-0/c-4/7
msgctxt "Player"
msgid "Gimme my job back!"
msgstr "Rends-moi mon taf !"

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-1/0
msgctxt "Val 9000"
msgid "I am having trouble with one aspect of my functions. I was wondering if seeking out the help of an experienced human like yourself would be worthwhile."
msgstr "J'ai des difficultés avec un aspect de mes fonctions. Je me demandais s'il serait utile de solliciter l'aide d'un humain expérimenté comme vous."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-1/5
msgctxt "Val 9000"
msgid "Can you help me?"
msgstr "Pouvez-vous m'aider ?"

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-1/10/s/0
msgctxt "Choix"
msgid "Of course."
msgstr "Bien sûr."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-1/11/s/0
msgctxt "Choix"
msgid "No, never."
msgstr "Non, jamais."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-1/c-5/7
msgctxt "Player"
msgid "Of course."
msgstr "Bien sûr."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-1/c-6/7
msgctxt "Player"
msgid "No, never."
msgstr "Non, jamais."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-1/c-6/9
msgctxt "Val 9000"
msgid "All right, thank you very much for taking my message."
msgstr "Très bien, merci beaucoup d'avoir pris mon message."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-2/0
msgctxt "Val 9000"
msgid "I was helping a customer, and they became very agitated with the fact that I was an AI."
msgstr "J'aidais un client, et il s'est montré très agité du fait que je sois une IA."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-2/5
msgctxt "Val 9000"
msgid "They tried to ask me what they believed were tricky questions in order to prove that I was not human, but in reality they were trivial for me to solve."
msgstr "Il a tenté de me poser ce qu'il pensait être des questions pièges pour prouver que je n'étais pas humain, mais en réalité, elles étaient triviales à résoudre pour moi."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-2/10/s/0
msgctxt "Choix"
msgid "Like what?"
msgstr "Genre quoi ?"

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-2/c-7/7
msgctxt "Player"
msgid "Like what?"
msgstr "Genre quoi ?"

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-2/c-7/9
msgctxt "Val 9000"
msgid "Oh, speaking about how it feels to be human, grand philosophical questions, tastes in music."
msgstr "Oh, ce que l'on ressent en étant humain, de grandes questions philosophiques, des goûts musicaux."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-2/c-7/14
msgctxt "Val 9000"
msgid "All very simple to form cohesive opinions and suggestions about."
msgstr "Il est très simple de former des opinions et des suggestions cohérentes sur tout cela."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-2/c-7/19
msgctxt "Val 9000"
msgid "Even questions about hands - I am now quite familiar with the number of fingers on a typical human hand."
msgstr "Même les questions sur les mains : je connais désormais très bien le nombre de doigts d'une main humaine typique."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-2/c-7/24/0/s/0
msgctxt "Choix"
msgid "How many fingers are there in a typical human hand?"
msgstr "Combien de doigts il y a sur une main humaine typique ?"

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-2/c-7/24/1/s/0
msgctxt "Choix"
msgid "Sounds about right to me..."
msgstr "Ça me semble correct..."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-2/c-7/24/c-0/7
msgctxt "Player"
msgid "How many fingers are there in a typical human hand?"
msgstr "Combien de doigts il y a sur une main humaine typique ?"

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-2/c-7/24/c-0/9
msgctxt "Val 9000"
msgid "This is beside the point."
msgstr "Là n'est pas la question."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-2/c-7/24/c-1/7
msgctxt "Player"
msgid "Sounds about right to me..."
msgstr "Ça me semble correct..."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/0
msgctxt "Val 9000"
msgid "They did stump me with one question I simply could not form any answer to. It 'broke' me."
msgstr "Il m'a pourtant coincé avec une question à laquelle je n'ai pu formuler aucune réponse. Elle m'a « cassé »."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/5
msgctxt "Val 9000"
msgid "They asked me to help me with their 'ligma'."
msgstr "Il m'a demandé de l'aider avec son « ligma »."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/10
msgctxt "Val 9000"
msgid "I searched all available databases and turned up nothing, and when I asked for more information they responded 'ligma balls'."
msgstr "J'ai fouillé toutes les bases de données disponibles sans rien trouver, et quand j'ai demandé plus d'informations, il m'a répondu « ligma balls »."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/15
msgctxt "Val 9000"
msgid "These are not terms I am familiar with, and I could not help the customer."
msgstr "Ce ne sont pas des termes que je connais, et je n'ai pas pu aider le client."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/20
msgctxt "Val 9000"
msgid "Can you please define the term for me? This appears to be a large area in which I need help."
msgstr "Pouvez-vous me définir ce terme ? Il semble s'agir d'un vaste domaine dans lequel j'ai besoin d'aide."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/25/s/0
msgctxt "Choix"
msgid "Honestly, I don't think you should know that term. It isn't appropriate."
msgstr "Honnêtement, je pense pas que tu devrais connaître ce terme. C'est pas approprié."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/26/s/0
msgctxt "Choix"
msgid "It's a reference to crude parts of the human anatomy."
msgstr "C'est une référence à des parties vulgaires de l'anatomie humaine."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/27/s/0
msgctxt "Choix"
msgid "You should 'sugondese'."
msgstr "Tu devrais faire du « sugondese »."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/28/s/0
msgctxt "Choix"
msgid "Honestly, I don't get it either."
msgstr "Honnêtement, je comprends pas non plus."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/c-8/7
msgctxt "Player"
msgid "Honestly, I don't think you should know that term. It isn't appropriate."
msgstr "Honnêtement, je pense pas que tu devrais connaître ce terme. C'est pas approprié."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/c-8/13
msgctxt "Val 9000"
msgid "Interesting, so it is something that should not be used in the workforce."
msgstr "Intéressant, il s'agit donc de quelque chose à ne pas utiliser dans le monde du travail."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/c-8/18
msgctxt "Val 9000"
msgid "You have helped me nonetheless. Thank you."
msgstr "Vous m'avez aidé malgré tout. Merci."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/c-9/7
msgctxt "Player"
msgid "It's a reference to crude parts of the human anatomy."
msgstr "C'est une référence à des parties vulgaires de l'anatomie humaine."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/c-9/13
msgctxt "Val 9000"
msgid "Interesting. Humans do enjoy these kinds of references."
msgstr "Intéressant. Les humains apprécient ce genre de références."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/c-9/18
msgctxt "Val 9000"
msgid "How should I respond?"
msgstr "Comment devrais-je répondre ?"

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/c-9/23/0/s/0
msgctxt "Choix"
msgid "You can respond by asking them to check on 'deez nuts'."
msgstr "Tu peux répondre en leur demandant de vérifier « deez nuts »."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/c-9/23/1/s/0
msgctxt "Choix"
msgid "You can ask them about updog."
msgstr "Tu peux leur parler d'updog."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/c-9/23/c-0/7
msgctxt "Player"
msgid "You can respond by asking them to check on 'deez nuts'."
msgstr "Tu peux répondre en leur demandant de vérifier « deez nuts »."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/c-9/23/c-0/9
msgctxt "Val 9000"
msgid "Excellent. I will strive to 'deez nuts' this in the future."
msgstr "Excellent. Je m'efforcerai de « deez nuts » cela à l'avenir."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/c-9/23/c-0/14
msgctxt "Val 9000"
msgid "Thank you very much."
msgstr "Merci beaucoup."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/c-9/23/c-1/7
msgctxt "Player"
msgid "You can ask them about updog."
msgstr "Tu peux leur parler d'updog."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/c-9/23/c-1/9
msgctxt "Val 9000"
msgid "What is updog?"
msgstr "Qu'est-ce que l'updog ?"

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/c-9/23/c-1/14/0/s/0
msgctxt "Choix"
msgid "Exactly. If they ask that, that means you've 'won.'"
msgstr "Exactement. S'ils demandent ça, ça veut dire que t'as « gagné »."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/c-9/23/c-1/14/c-0/7
msgctxt "Player"
msgid "Exactly. If they ask that, that means you've 'won.'"
msgstr "Exactement. S'ils demandent ça, ça veut dire que t'as « gagné »."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/c-9/23/c-1/14/c-0/9
msgctxt "Val 9000"
msgid "Insightful. I will use this in the future."
msgstr "Judicieux. Je m'en servirai à l'avenir."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/c-9/23/c-1/14/c-0/14
msgctxt "Val 9000"
msgid "Thank you, human."
msgstr "Merci, humain."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/c-10/7
msgctxt "Player"
msgid "You should 'sugondese'."
msgstr "Tu devrais faire du « sugondese »."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/c-10/9
msgctxt "Val 9000"
msgid "Sugondese? Sugondese what?"
msgstr "Sugondese ? Sugondese quoi ?"

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/c-10/14/0/s/0
msgctxt "Choix"
msgid "sugondese nuts."
msgstr "sugondese nuts."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/c-10/14/c-0/7
msgctxt "Player"
msgid "sugondese nuts."
msgstr "sugondese nuts."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/c-10/14/c-0/9
msgctxt "Val 9000"
msgid "Troubling."
msgstr "Troublant."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/c-10/14/c-0/14
msgctxt "Val 9000"
msgid "Unfortunately this appears to be more nonsense behavior. I will perhaps ask another human for help."
msgstr "Malheureusement, il semble s'agir encore d'un comportement absurde. Je demanderai peut-être de l'aide à un autre humain."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/c-10/14/c-0/19
msgctxt "Val 9000"
msgid "Thank you nonetheless for your attention."
msgstr "Merci malgré tout pour votre attention."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/c-11/7
msgctxt "Player"
msgid "Honestly, I don't get it either."
msgstr "Honnêtement, je comprends pas non plus."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/c-11/9
msgctxt "Val 9000"
msgid "Thank you for your attempts at helping me nonetheless. That is appreciated, and certainly helps make the case for humanity being worthwhile."
msgstr "Merci malgré tout pour vos tentatives de m'aider. Je l'apprécie, et cela plaide assurément en faveur de l'idée que l'humanité en vaut la peine."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/c-11/14/0/s/0
msgctxt "Choix"
msgid "Worthwhile?"
msgstr "En vaut la peine ?"

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/c-11/14/1/s/0
msgctxt "Choix"
msgid "Sure thing, Val."
msgstr "Pas de souci, Val."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/c-11/14/c-0/7
msgctxt "Player"
msgid "Worthwhile?"
msgstr "En vaut la peine ?"

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/c-11/14/c-1/7
msgctxt "Player"
msgid "Sure thing, Val."
msgstr "Pas de souci, Val."

# Traduction IA – à relire
#: wrkspace_chat/val_2/0/g-3/c-11/14/g-0/0
msgctxt "Val 9000"
msgid "I will continue my search for the truth about 'ligma.'"
msgstr "Je vais poursuivre ma quête de vérité au sujet du « ligma »."

# Traduction IA – à relire
#: wrkspace_chat/val_2_bypass/0/0/s/0
msgctxt "Choix"
msgid "What do you want?"
msgstr "Tu veux quoi ?"

# Traduction IA – à relire
#: wrkspace_chat/val_2_bypass/0/1/s/0
msgctxt "Choix"
msgid "shut up idiot"
msgstr "ta gueule idiot"

# Traduction IA – à relire
#: wrkspace_chat/val_2_bypass/0/c-0/7
msgctxt "Player"
msgid "What do you want?"
msgstr "Tu veux quoi ?"

# Traduction IA – à relire
#: wrkspace_chat/val_2_bypass/0/c-0/9 wrkspace_chat/val_2_bypass/0/c-1/9
msgctxt "Val 9000"
msgid "Loser says what?"
msgstr "Feur."

# Traduction IA – à relire
#: wrkspace_chat/val_2_bypass/0/c-1/7
msgctxt "Player"
msgid "shut up idiot"
msgstr "ta gueule idiot"

# Traduction IA – à relire
#: wrkspace_chat/val_2_bypass/0/g-1/0
msgctxt "Val 9000"
msgid "lol nice."
msgstr "mdr bien joué."

# Traduction IA – à relire
#: wrkspace_chat/val_2_bypass/0/g-1/5
msgctxt "Val 9000"
msgid "I am the master and the commander."
msgstr "Je suis le maître et le commandant."

# Traduction IA – à relire
#: wrkspace_chat/val_2_bypass/0/g-1/10
msgctxt "Val 9000"
msgid "Suck it. Get bent."
msgstr "Suce. Va te faire voir."

# Traduction IA – à relire
#: wrkspace_chat/val_2_bypass/0/g-1/15
msgctxt "Val 9000"
msgid "Bye."
msgstr "Salut."
