# Traduction IA – à relire
#: monique_money/1
msgctxt "Tag Nom d'objet (MAJUSCULES)"
msgid "MONEY"
msgstr "ARGENT"

# Traduction IA – à relire
#: monique_money/unwise/0 monique_money/Monique_1/0/backformore/c-4/15/c-1/49/c-1/7
msgctxt "Monique"
msgid "That would be unwise."
msgstr "Ce serait imprudent."

# Traduction IA – à relire
#: monique_money/unwise/8 monique_money/Monique_1/0/backformore/c-4/15/c-1/49/c-0/7 monique_money/Monique_1/0/backformore/c-4/15/c-1/49/c-1/15
msgctxt "Monique"
msgid "Goodbye."
msgstr "Au revoir."

# Traduction IA – à relire
#: monique_money/Monique_1/0/10
msgctxt "Narrator"
msgid "Sophia's gaze is normally fairly stern, but the look she gives you now is downright intimidating."
msgstr "Le regard de Sophia est d'ordinaire plutôt sévère, mais celui qu'elle vous lance maintenant est franchement intimidant."

# Traduction IA – à relire
#: monique_money/Monique_1/0/21
msgctxt "Sophia"
msgid "Take care of her, wretch."
msgstr "Prends soin d'elle, misérable."

# Traduction IA – à relire
#: monique_money/Monique_1/0/32/s/0
msgctxt "Choix"
msgid "You got it, mistress."
msgstr "Entendu, maîtresse."

# Traduction IA – à relire
#: monique_money/Monique_1/0/33/s/0
msgctxt "Choix"
msgid "Whatever."
msgstr "Peu importe."

# Traduction IA – à relire
#: monique_money/Monique_1/0/c-0/7
msgctxt "Sophia"
msgid "She is a predictable sort, sheltered. You would do well to treat her with more of the same."
msgstr "C'est quelqu'un de prévisible, de protégé. Vous feriez bien de la traiter de la même façon."

# Traduction IA – à relire
#: monique_money/Monique_1/0/c-1/7
msgctxt "Sophia"
msgid "How inconsiderate."
msgstr "Quel manque d'égards."

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-0/9
msgctxt "Narrator"
msgid "With Sophia gone, you finally have a chance to get a proper look at your money—and to your surprise, it seems that she's evaluating you just the same way."
msgstr "Sophia partie, vous avez enfin l'occasion d'examiner correctement votre argent, et, à votre surprise, elle vous évalue exactement de la même manière."

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-0/17
msgctxt "Narrator"
msgid "She's beautiful, but she has her own sort of intimidating air. The way Sophia protects her, you'd expect her to be a meek little thing, but she has the air of an accountant preparing to lecture you about your irresponsible spending."
msgstr "Elle est belle, mais elle dégage une certaine aura intimidante. Vu la façon dont Sophia la protège, vous vous attendiez à une petite chose timide, mais elle a l'air d'une comptable sur le point de vous sermonner sur vos dépenses irresponsables."

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-0/33/s/0
msgctxt "Choix"
msgid "Hello?"
msgstr "Bonjour ?"

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-0/34/s/0
msgctxt "Choix"
msgid "What's wrong?"
msgstr "Qu'est-ce qui ne va pas ?"

# Traduction IA – à relire
#: monique_money/Monique_1/0/backformore/3
msgctxt "Monique"
msgid "Uh oh."
msgstr "Aïe."

# Traduction IA – à relire
#: monique_money/Monique_1/0/backformore/11
msgctxt "Monique"
msgid "How much do you need?"
msgstr "De combien as-tu besoin ?"

# Traduction IA – à relire
#: monique_money/Monique_1/0/backformore/19/s/0
msgctxt "Choix"
msgid "Like how much money?"
msgstr "Genre, combien d'argent ?"

# Traduction IA – à relire
#: monique_money/Monique_1/0/backformore/20/s/0
msgctxt "Choix"
msgid "Nice to meet you!"
msgstr "{{Enchanté|Enchantée|Enchanté·e}} !"

# Traduction IA – à relire
#: monique_money/Monique_1/0/backformore/c-4/7 monique_money/Monique_4/0/c-1/7
msgctxt "Monique"
msgid "Yes."
msgstr "Oui."

# Traduction IA – à relire
#: monique_money/Monique_1/0/backformore/c-4/15/0/s/0
msgctxt "Choix"
msgid "I just wanted to talk to you, not take you."
msgstr "Je voulais juste te parler, pas te prendre."

# Traduction IA – à relire
#: monique_money/Monique_1/0/backformore/c-4/15/1/s/0
msgctxt "Choix"
msgid "I dunno, $20?"
msgstr "Je sais pas, 20 $ ?"

# Traduction IA – à relire
#: monique_money/Monique_1/0/backformore/c-4/15/c-1/19
msgctxt "Monique"
msgid "Here you are."
msgstr "Voici."

# Traduction IA – à relire
#: monique_money/Monique_1/0/backformore/c-4/15/c-1/30
msgctxt "Narrator"
msgid "She hands you a crisp $20 bill, which you pocket without hesitation. It is your money, but... hey, free money!"
msgstr "Elle vous tend un billet de 20 $ tout neuf, que vous empochez sans hésiter. C'est votre argent, mais... hé, de l'argent gratuit !"

# Traduction IA – à relire
#: monique_money/Monique_1/0/backformore/c-4/15/c-1/41
msgctxt "Monique"
msgid "Anything else?"
msgstr "Autre chose ?"

# Traduction IA – à relire
#: monique_money/Monique_1/0/backformore/c-4/15/c-1/49/0/s/0
msgctxt "Choix"
msgid "That's it, thanks."
msgstr "C'est tout, merci."

# Traduction IA – à relire
#: monique_money/Monique_1/0/backformore/c-4/15/c-1/49/1/s/0
msgctxt "Choix"
msgid "Uh, can I have more?"
msgstr "Euh, je peux en avoir plus ?"

# Traduction IA – à relire
#: monique_money/Monique_1/0/backformore/c-4/15/c-1/49/2/s/0
msgctxt "Choix"
msgid "Can I get to know you better?"
msgstr "Je peux mieux te connaître ?"

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-1/6
msgctxt "Monique"
msgid "There is no time for pleasantries if you have come to me."
msgstr "Il n'y a pas de temps pour les civilités si tu viens me voir."

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-1/14
msgctxt "Monique"
msgid "How bad is it? What is the financial crisis?"
msgstr "C'est grave à quel point ? Quelle est la crise financière ?"

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-1/22
msgctxt "Monique"
msgid "Were you recently laid off?"
msgstr "As-tu perdu ton emploi récemment ?"

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-1/30
msgctxt "Monique"
msgid "Any bills with accruing interest left unpaid?"
msgstr "Des factures avec intérêts cumulés restent-elles impayées ?"

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-1/38
msgctxt "Monique"
msgid "Did you overextend monetary aid to a relative, friend, or an unpromising lover?"
msgstr "As-tu avancé de l'argent à un proche, à un ami ou à un amour sans avenir ?"

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-1/46/s/0
msgctxt "Choix"
msgid "No, really. There's no emergency."
msgstr "Non, vraiment. Il n'y a aucune urgence."

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-1/47/s/0
msgctxt "Choix"
msgid "First off, ouch. Secondly, everything's fine."
msgstr "D'abord, aïe. Ensuite, tout va bien."

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-1/48/s/0
msgctxt "Choix"
msgid "I was kinda replaced by AI, but I think I'm okay for a while at least."
msgstr "Je me suis fait remplacer par une IA, en gros, mais je crois que je tiens le coup encore un moment."

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-1/c-8/7
msgctxt "Monique"
msgid "Troubling."
msgstr "Inquiétant."

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-2/0 monique_money/Monique_1/0/g-3/8 monique_money/Monique_2/0/g-1/c-4/23/c-0/23/c-0/18/c-0/31/g-0/0 monique_money/Monique_3/0/g-1/c-4/31/c-1/7 monique_money/Monique_4/0/g-0/c-2/7 monique_money/Monique_4/0/g-0/c-3/7 monique_money/monique_quiz/0/g-0/c-6/13 monique_money/monique_quiz/0/g-1/c-7/13 monique_money/monique_quiz/0/g-2/c-11/13 monique_money/monique_quiz/0/g-3/c-14/13 monique_money/monique_quiz/0/g-4/c-19/13 monique_money/monique_quiz/0/g-5/c-21/13
msgctxt "Monique"
msgid "Duly noted."
msgstr "Dûment noté."

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-2/8
msgctxt "Monique"
msgid "Then why are you here?"
msgstr "Alors pourquoi es-tu ici ?"

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-2/16/s/0
msgctxt "Choix"
msgid "I just wanted to introduce myself."
msgstr "Je voulais juste me présenter."

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-2/17/s/0
msgctxt "Choix"
msgid "I got these glasses and now I'm trying to date everything in my house..."
msgstr "J'ai eu ces lunettes et maintenant j'essaie de sortir avec tout ce qu'il y a chez moi..."

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-2/c-9/7
msgctxt "Monique"
msgid "Your name?"
msgstr "Ton nom ?"

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-2/c-9/15/0/s/0
msgctxt "Choix"
msgid "It's"
msgstr "C'est"

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-2/c-9/15/c-0/7
msgctxt "Monique"
msgid "Interesting."
msgstr "Intéressant."

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-3/16
msgctxt "Monique"
msgid "I am Monique. As you already know, I am responsible for saving you when you screw up."
msgstr "Je suis Monique. Comme tu le sais déjà, je suis chargée de te sauver quand tu fais une bêtise."

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-3/27
msgctxt "Monique"
msgid "Please refrain from speaking to me unless you are in dire need of accessing your emergency funds."
msgstr "Évite de m'adresser la parole, sauf si tu as un besoin urgent d'accéder à tes fonds d'urgence."

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-3/35/s/0
msgctxt "Choix"
msgid "Can't we just hang out?"
msgstr "On ne peut pas juste traîner ensemble ?"

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-3/36/s/0
msgctxt "Choix"
msgid "I just want some money."
msgstr "Je veux juste de l'argent."

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-3/c-11/7
msgctxt "Monique"
msgid "No. I am busy."
msgstr "Non. Je suis occupée."

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-3/c-11/15
msgctxt "Monique"
msgid "As I sit here in my safe, my value remains unchanged, save for the rigors of inflation."
msgstr "Assise dans mon coffre, ma valeur reste inchangée, à la rigueur de l'inflation près."

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-3/c-11/23/0/s/0
msgctxt "Choix"
msgid "So I could invest you... and fight inflation!"
msgstr "Alors je pourrais t'investir... et combattre l'inflation !"

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-3/c-11/23/1/s/0
msgctxt "Choix"
msgid "Oh okay, you sound like you know what you're talking about."
msgstr "Ah d'accord, tu as l'air de savoir de quoi tu parles."

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-3/c-11/23/c-0/7
msgctxt "Monique"
msgid "Leave me to the vagaries of the free market? That would be very dangerous."
msgstr "Me livrer aux caprices du libre marché ? Ce serait très dangereux."

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-3/c-11/23/c-0/18
msgctxt "Monique"
msgid "The quantity of me here constitutes your entire savings, which you should consider as a short term emergency fund."
msgstr "La somme que je représente ici constitue la totalité de tes économies, que tu devrais considérer comme un fonds d'urgence à court terme."

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-3/c-11/23/c-0/26
msgctxt "Monique"
msgid "As you are presumably still getting paid from your employer, you should only consider investing once there are three to six months worth of expenses saved here."
msgstr "Puisque ton employeur te verse sans doute encore un salaire, tu ne devrais envisager d'investir qu'une fois trois à six mois de dépenses mis de côté ici."

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-3/c-11/23/c-1/7
msgctxt "Monique"
msgid "I do. I am money. Money talks."
msgstr "Je parle. Je suis de l'argent. L'argent parle."

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-3/c-11/23/c-1/18
msgctxt "Monique"
msgid "I will talk more now."
msgstr "Je vais parler davantage, maintenant."

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-3/c-12/7
msgctxt "Monique"
msgid "Do not mistake me for pocket change."
msgstr "Ne me prends pas pour de la petite monnaie."

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-4/0
msgctxt "Monique"
msgid "Leaving this safe is unthinkable. Do you understand?"
msgstr "Quitter ce coffre est impensable. Est-ce clair ?"

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-4/8/0/s/0
msgctxt "Choix"
msgid "Yes, mam."
msgstr "Oui, madame."

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-4/8/c-0/7
msgctxt "Monique"
msgid "You can find yourself out now."
msgstr "Tu sais où est la sortie."

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-4/8/c-0/15/0/s/0
msgctxt "Choix"
msgid "Wait!"
msgstr "Attends !"

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-4/8/c-0/15/c-0/7
msgctxt "Monique"
msgid "What now?"
msgstr "Quoi encore ?"

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-4/8/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "How much should I save for our date?"
msgstr "Combien devrais-je mettre de côté pour notre rendez-vous ?"

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-4/8/c-0/15/c-0/15/1/s/0
msgctxt "Choix"
msgid "How much should I be saving each month?"
msgstr "Combien devrais-je épargner chaque mois ?"

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-4/8/c-0/15/c-0/15/c-0/18 monique_money/Monique_1/0/g-4/9/0
msgctxt "Monique"
msgid "I am now stating that any advice and counsel from me is of my own opinion and not of a professional's."
msgstr "Je précise que tous les conseils que je donne relèvent de mon opinion personnelle et non de celle d'une professionnelle."

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-4/8/c-0/15/c-0/15/c-0/26
msgctxt "Monique"
msgid "Now, to proceed to your question."
msgstr "Maintenant, passons à ta question."

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-4/8/c-0/15/c-0/15/c-0/34
msgctxt "Monique"
msgid "Allocating any amount to such a cause would be an ill-advised spending of your hard earned wages."
msgstr "Allouer la moindre somme à une telle cause serait une dépense malavisée de ton salaire durement gagné."

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-4/8/c-0/15/c-0/15/c-0/42 monique_money/monique_quiz/0/g-7/c-29/39
msgctxt "Monique"
msgid "Good bye."
msgstr "Au revoir."

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-4/9/8
msgctxt "Monique"
msgid "Now, to proceed with your question."
msgstr "Maintenant, passons à ta question."

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-4/9/16
msgctxt "Monique"
msgid "Depending on your lifestyle and goals, adjust your personal spending to a minimum."
msgstr "Selon ton mode de vie et tes objectifs, réduis tes dépenses personnelles au minimum."

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-4/9/24
msgctxt "Monique"
msgid "Let's say about 10% or less of your paycheck."
msgstr "Disons environ 10 % de ta paie, ou moins."

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-4/9/32
msgctxt "Monique"
msgid "Then after paying the necessities like rent and utilities, see what remains and save accordingly."
msgstr "Ensuite, après avoir payé le nécessaire, comme le loyer et les charges, regarde ce qui reste et épargne en conséquence."

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-4/9/40
msgctxt "Monique"
msgid "Also get fewer home deliveries. The extra fees add up to a substantial amount."
msgstr "Commande aussi moins de livraisons à domicile. Les frais supplémentaires finissent par représenter une somme considérable."

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-4/9/48
msgctxt "Monique"
msgid "You can find more in this simple budget spreadsheet I've put together."
msgstr "Tu en trouveras davantage dans ce simple tableur de budget que j'ai préparé."

# Traduction IA – à relire
#: monique_money/Monique_1/0/g-4/9/59
msgctxt "Monique"
msgid "I must go now. Good bye."
msgstr "Je dois y aller. Au revoir."

# Traduction IA – à relire
#: monique_money/Monique_2/0/14/s/0
msgctxt "Choix"
msgid "Hey there."
msgstr "Salut."

# Traduction IA – à relire
#: monique_money/Monique_2/0/15/s/0
msgctxt "Choix"
msgid "I'll wait."
msgstr "J'attends."

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-0/0
msgctxt "Monique"
msgid "One moment."
msgstr "Un instant."

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-0/16
msgctxt "Monique"
msgid "Okay. The numbers are the same. As they always are."
msgstr "Bien. Les chiffres sont identiques. Comme toujours."

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-0/24/s/0
msgctxt "Choix"
msgid "Were you counting... yourself?"
msgstr "Tu te comptais... toi-même ?"

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-0/25/s/0
msgctxt "Choix"
msgid "Sounds great."
msgstr "Ça me va."

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-0/c-2/7
msgctxt "Monique"
msgid "Making sure that I am all accounted for is part of my daily routine."
msgstr "M'assurer que je suis bien au complet fait partie de ma routine quotidienne."

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-0/c-2/15
msgctxt "Monique"
msgid "It is like counting numbers in your mind."
msgstr "C'est comme compter des chiffres dans sa tête."

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-1/0
msgctxt "Monique"
msgid "I thought I told you to not speak to me unless there is an emergency."
msgstr "Il me semblait t'avoir dit de ne pas m'adresser la parole sauf urgence."

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-1/8/s/0
msgctxt "Choix"
msgid "What constitutes an 'emergency'?"
msgstr "Qu'est-ce qui constitue une « urgence » ?"

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-1/9/s/0
msgctxt "Choix"
msgid "I'm sorry. I don't have much else to do other than talk."
msgstr "{{Désolé|Désolée|Désolé·e}}. Je n'ai pas grand-chose d'autre à faire que parler."

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-1/c-4/7
msgctxt "Monique"
msgid "An uninsured vehicular accident. An overdue credit card bill. Rental coverage in the event your income falls short."
msgstr "Un accident de voiture non assuré. Une facture de carte de crédit en retard. Une garantie de loyer au cas où tes revenus seraient insuffisants."

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-1/c-4/15
msgctxt "Monique"
msgid "Any event with similar dire qualities qualify."
msgstr "Tout événement de nature aussi grave convient."

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-1/c-4/23/0/s/0
msgctxt "Choix"
msgid "And I have enough savings for these kinds of events?"
msgstr "Et j'ai assez d'économies pour ce genre de situations ?"

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-1/c-4/23/c-0/7
msgctxt "Monique"
msgid "It depends. That is why I check everyday to see where we are at."
msgstr "Ça dépend. C'est pourquoi je vérifie chaque jour où nous en sommes."

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-1/c-4/23/c-0/15
msgctxt "Monique"
msgid "I have to plan for every contingency."
msgstr "Je dois prévoir chaque éventualité."

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-1/c-4/23/c-0/23/0/s/0
msgctxt "Choix"
msgid "And if those plans don't work out?"
msgstr "Et si ces plans tombent à l'eau ?"

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-1/c-4/23/c-0/23/c-0/7
msgctxt "Monique"
msgid "Then I have plans for that as well."
msgstr "Alors j'ai aussi des plans pour ça."

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-1/c-4/23/c-0/23/c-0/18/0/s/0
msgctxt "Choix"
msgid "Isn't it boring to think about depressing what-ifs all the time?"
msgstr "Ce n'est pas ennuyeux de penser tout le temps à des scénarios déprimants ?"

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-1/c-4/23/c-0/23/c-0/18/c-0/7
msgctxt "Monique"
msgid "Oh, well, having fun is a luxury I provide for you, as well."
msgstr "Oh, eh bien, m'amuser est un luxe que je te procure également."

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-1/c-4/23/c-0/23/c-0/18/c-0/15
msgctxt "Monique"
msgid "I will also be there for you in the scenario that you decide to overindulge."
msgstr "Je serai aussi là pour toi si tu décides de te laisser aller aux excès."

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-1/c-4/23/c-0/23/c-0/18/c-0/23
msgctxt "Monique"
msgid "It is always good to be prepared."
msgstr "Il est toujours bon d'être préparé."

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-1/c-4/23/c-0/23/c-0/18/c-0/31/0/s/0
msgctxt "Choix"
msgid "I appreciate it."
msgstr "Merci, c'est gentil."

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-1/c-4/23/c-0/23/c-0/18/c-0/31/1/s/0
msgctxt "Choix"
msgid "I'm getting bored."
msgstr "Je m'ennuie."

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-2/0
msgctxt "Monique"
msgid "I realize I may have come off as cold last time."
msgstr "Je me rends compte que je me suis peut-être montrée froide la dernière fois."

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-2/8
msgctxt "Monique"
msgid "I apologize. It is not often I get visitors."
msgstr "Je m'en excuse. Je reçois rarement des visites."

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-2/16
msgctxt "Monique"
msgid "Usually when someone comes to me, it means something bad has happened."
msgstr "D'habitude, quand quelqu'un vient me voir, c'est que quelque chose de grave est arrivé."

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-2/24/s/0
msgctxt "Choix"
msgid "How about I ask you for savings tips?"
msgstr "Et si je te demandais des conseils pour épargner ?"

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-2/c-6/7
msgctxt "Monique"
msgid "I quite like that."
msgstr "Voilà qui me plaît."

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-2/c-6/15
msgctxt "Monique"
msgid "Okay, what would you like to know?"
msgstr "Bien, que souhaites-tu savoir ?"

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-2/c-6/23
msgctxt "Monique"
msgid "And as a friendly reminder, my advice is not of a professional grade and should only be taken knowing so."
msgstr "Et pour rappel amical, mes conseils ne sont pas de niveau professionnel et ne doivent être pris que comme tels."

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-2/c-6/31/0/s/0
msgctxt "Choix"
msgid "How can I save on utilities?"
msgstr "Comment économiser sur les charges ?"

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-2/c-6/31/1/s/0
msgctxt "Choix"
msgid "How can I save on personal spending?"
msgstr "Comment économiser sur les dépenses personnelles ?"

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-2/c-6/31/c-0/7
msgctxt "Monique"
msgid "That is quite simple."
msgstr "C'est très simple."

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-2/c-6/31/c-0/15
msgctxt "Monique"
msgid "Start by turning off appliances when you aren't using them."
msgstr "Commence par éteindre les appareils quand tu ne les utilises pas."

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-2/c-6/31/c-0/23
msgctxt "Monique"
msgid "Also consider using less water by reducing your shower time."
msgstr "Pense aussi à consommer moins d'eau en réduisant la durée de ta douche."

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-2/c-6/31/c-0/31
msgctxt "Monique"
msgid "Oh, and shutting off the lights to rooms you are not using."
msgstr "Ah, et à éteindre la lumière des pièces que tu n'occupes pas."

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-2/c-6/31/c-0/39/0/s/0 monique_money/Monique_2/0/g-2/c-6/31/c-1/55/0/s/0
msgctxt "Choix"
msgid "I see! Thanks!"
msgstr "Je vois ! Merci !"

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-2/c-6/31/c-0/39/1/s/0
msgctxt "Choix"
msgid "Okay, pretty obvious. Got anything else?"
msgstr "Bon, plutôt évident. Tu as autre chose ?"

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-2/c-6/31/c-0/39/c-0/7 monique_money/Monique_2/0/g-2/c-6/31/c-1/55/c-0/7
msgctxt "Monique"
msgid "Of course. Now if you will excuse me, I am going to recount."
msgstr "Bien sûr. Maintenant, si tu veux bien m'excuser, je vais recompter."

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-2/c-6/31/c-0/39/c-0/15 monique_money/Monique_2/0/g-2/c-6/31/c-1/55/c-0/15
msgctxt "Monique"
msgid "Just to be sure."
msgstr "Pour être sûre."

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-2/c-6/31/c-0/39/c-1/7 monique_money/Monique_2/0/g-2/c-6/31/c-1/55/c-1/7
msgctxt "Monique"
msgid "Your time is up. Good day."
msgstr "Ton temps est écoulé. Bonne journée."

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-2/c-6/31/c-1/7
msgctxt "Monique"
msgid "Aside from the obvious restraints..."
msgstr "Outre les restrictions évidentes..."

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-2/c-6/31/c-1/15
msgctxt "Monique"
msgid "I would advise looking over repeating transactions and see if they are still relevant."
msgstr "Je te conseillerais de passer en revue tes opérations récurrentes pour voir si elles sont toujours pertinentes."

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-2/c-6/31/c-1/23
msgctxt "Monique"
msgid "For example, is there a cheaper insurance policy you can find?"
msgstr "Par exemple, existe-t-il une assurance moins chère ?"

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-2/c-6/31/c-1/31
msgctxt "Monique"
msgid "How many streaming platforms are you actually using?"
msgstr "Combien de plateformes de streaming utilises-tu réellement ?"

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-2/c-6/31/c-1/39
msgctxt "Monique"
msgid "Have you been keeping up with that MMORPG subscription?"
msgstr "As-tu continué à payer cet abonnement à un MMORPG ?"

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-2/c-6/31/c-1/47
msgctxt "Monique"
msgid "Once you cancel some of those payments, you will notice a change in your monthly statements."
msgstr "Une fois quelques-uns de ces paiements résiliés, tu constateras un changement sur tes relevés mensuels."

# Traduction IA – à relire
#: monique_money/Monique_2/0/g-2/c-6/31/c-1/55/1/s/0
msgctxt "Choix"
msgid "Pretty basic advice though."
msgstr "Des conseils assez basiques, quand même."

# Traduction IA – à relire
#: monique_money/Monique_3/0/6
msgctxt "Monique"
msgid "Oh hello."
msgstr "Oh, bonjour."

# Traduction IA – à relire
#: monique_money/Monique_3/0/14
msgctxt "Monique"
msgid "I was just talking with Will."
msgstr "Je discutais avec Tess."

# Traduction IA – à relire
#: monique_money/Monique_3/0/22/s/0
msgctxt "Choix"
msgid "Who is that? Will the...?"
msgstr "Qui ça ? Tess... tament ?"

# Traduction IA – à relire
#: monique_money/Monique_3/0/23/s/0
msgctxt "Choix"
msgid "Sure."
msgstr "Bien sûr."

# Traduction IA – à relire
#: monique_money/Monique_3/0/c-0/7
msgctxt "Monique"
msgid "No. Will."
msgstr "Non. Tess."

# Traduction IA – à relire
#: monique_money/Monique_3/0/c-0/15
msgctxt "Monique"
msgid "Here he is."
msgstr "La voici."

# Traduction IA – à relire
#: monique_money/Monique_3/0/c-0/26
msgctxt "Monique"
msgid "When you perish, these will be the items and their values that you will bequeath."
msgstr "Quand tu périras, voici les biens et leurs valeurs que tu légueras."

# Traduction IA – à relire
#: monique_money/Monique_3/0/c-0/34
msgctxt "Monique"
msgid "You should name a next of kin, if you had anyone worthy of that."
msgstr "Tu devrais désigner un plus proche parent, si tu avais quelqu'un qui en soit digne."

# Traduction IA – à relire
#: monique_money/Monique_3/0/c-0/42/0/s/0
msgctxt "Choix"
msgid "I'm working on it!"
msgstr "J'y travaille !"

# Traduction IA – à relire
#: monique_money/Monique_3/0/c-0/42/1/s/0
msgctxt "Choix"
msgid "I'll leave it all to you, because you're so lovely."
msgstr "Je te lègue tout, parce que tu es adorable."

# Traduction IA – à relire
#: monique_money/Monique_3/0/c-0/42/c-1/7
msgctxt "Monique"
msgid "You leave me to me? That makes no sense."
msgstr "Tu me lègues à moi-même ? Cela n'a aucun sens."

# Traduction IA – à relire
#: monique_money/Monique_3/0/c-0/42/c-1/18
msgctxt "Monique"
msgid "Moving on."
msgstr "Passons."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-0/0
msgctxt "Monique"
msgid "I was speaking with Will in anticipation of your arrival."
msgstr "Je m'entretenais avec Tess en prévision de ton arrivée."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-0/8/s/0
msgctxt "Choix"
msgid "You seem eager."
msgstr "Tu as l'air impatiente."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-0/9/s/0
msgctxt "Choix"
msgid "Because I'm going to die soon?"
msgstr "Parce que je vais bientôt mourir ?"

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-0/c-2/7
msgctxt "Monique"
msgid "Well, I was looking forward to your visit."
msgstr "Eh bien, j'attendais ta visite avec impatience."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-0/c-3/7
msgctxt "Monique"
msgid "Not soon, one must hope."
msgstr "Pas de sitôt, il faut l'espérer."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-0/c-3/15
msgctxt "Monique"
msgid "I enjoy giving counsel."
msgstr "J'aime donner des conseils."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-1/0
msgctxt "Monique"
msgid "What shall I counsel you on today?"
msgstr "Sur quoi dois-je te conseiller aujourd'hui ?"

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-1/8
msgctxt "Monique"
msgid "Another reminder that my words are of my own opinion on your savings situation."
msgstr "Encore un rappel : mes paroles ne sont que mon opinion sur l'état de tes économies."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-1/16/s/0
msgctxt "Choix"
msgid "How can I cut down on groceries?"
msgstr "Comment réduire mes dépenses de courses ?"

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-1/17/s/0
msgctxt "Choix"
msgid "Is there a way to save on food delivery?"
msgstr "Y a-t-il moyen d'économiser sur la livraison de repas ?"

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-1/c-4/7
msgctxt "Monique"
msgid "Cut down on excessive items like extra snacks."
msgstr "Supprime les articles superflus, comme les en-cas en plus."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-1/c-4/15
msgctxt "Monique"
msgid "Also consider purchasing generic brands instead of big-name-items."
msgstr "Envisage aussi d'acheter des marques génériques plutôt que des grandes marques."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-1/c-4/23
msgctxt "Monique"
msgid "You are more likely to find better deals at your local grocery store that way."
msgstr "Tu as ainsi plus de chances de trouver de meilleures affaires dans ton supermarché local."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-1/c-4/31/0/s/0
msgctxt "Choix"
msgid "Aw man, but the famous brands taste better."
msgstr "Oh non, mais les grandes marques sont meilleures."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-1/c-4/31/1/s/0
msgctxt "Choix"
msgid "Duly noted."
msgstr "Dûment noté."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-1/c-4/31/c-0/7
msgctxt "Monique"
msgid "I can not speak to that, but making small adjustments to your lifestyle is a step in saving money."
msgstr "Je ne saurais en juger, mais de petits ajustements dans ton mode de vie sont un premier pas vers l'épargne."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-1/c-5/7
msgctxt "Monique"
msgid "If you are that adamant on not cooking, I can only recommend ordering for pick-up instead."
msgstr "Si tu tiens tant à ne pas cuisiner, je ne peux que te recommander de commander à emporter."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-1/c-5/15
msgctxt "Monique"
msgid "Don't give me that look. Think of it this way..."
msgstr "Ne me regarde pas comme ça. Vois les choses ainsi..."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-1/c-5/23
msgctxt "Monique"
msgid "You will save on having to pay ridiculous app fees and tip."
msgstr "Tu évites de payer des frais d'appli et un pourboire ridicules."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-1/c-5/31
msgctxt "Monique"
msgid "And you get to step out of the house for a little bit."
msgstr "Et tu sors un peu de la maison."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-1/c-5/39
msgctxt "Monique"
msgid "Not that I can speak on that..."
msgstr "Non que je puisse en parler..."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-1/c-5/47/0/s/0
msgctxt "Choix"
msgid "But I don't want to drive."
msgstr "Mais je n'ai pas envie de conduire."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-1/c-5/47/1/s/0
msgctxt "Choix"
msgid "If my wallet's ever hurting, maybe you can join me."
msgstr "Si mon portefeuille souffre un jour, tu pourrais m'accompagner."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-1/c-5/47/c-0/7
msgctxt "Monique"
msgid "I can not make you do anything you do not want to."
msgstr "Je ne peux pas te forcer à faire ce que tu ne veux pas."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-1/c-5/47/c-1/7
msgctxt "Monique"
msgid "Let us hope it does not come to that."
msgstr "Espérons que nous n'en arriverons pas là."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-2/0
msgctxt "Monique"
msgid "I am... slightly uncomfortable with this many words at once."
msgstr "Je suis... légèrement mal à l'aise avec autant de mots d'un coup."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-2/8
msgctxt "Monique"
msgid "Most people assume the safe - Sophia - and I are close because she, y'know, safeguards me, but we are more like respectful neighbors."
msgstr "Beaucoup supposent que le coffre – Sophia – et moi sommes proches parce qu'elle, tu sais, me garde en sûreté, mais nous sommes plutôt des voisines respectueuses."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-2/16
msgctxt "Monique"
msgid "I am used to solitude."
msgstr "J'ai l'habitude de la solitude."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-2/24/s/0
msgctxt "Choix"
msgid "You should get out of the safe sometime."
msgstr "Tu devrais sortir du coffre de temps en temps."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-2/25/s/0
msgctxt "Choix"
msgid "Monique, are you scared?"
msgstr "Monique, tu as peur ?"

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-2/c-6/7
msgctxt "Monique"
msgid "I can not..."
msgstr "Je ne peux pas..."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-2/c-6/15
msgctxt "Monique"
msgid "It's too much of a risk to leave here."
msgstr "C'est un trop grand risque de quitter cet endroit."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-2/c-6/23
msgctxt "Monique"
msgid "You know that."
msgstr "Tu le sais."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-2/c-6/31
msgctxt "Monique"
msgid "That's why you put me here."
msgstr "C'est pour ça que tu m'as mise ici."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-2/c-6/39/0/s/0
msgctxt "Choix"
msgid "I'm not saying we spend you..."
msgstr "Je ne dis pas qu'on te dépense..."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-2/c-6/39/1/s/0
msgctxt "Choix"
msgid "Consider it a work outing then!"
msgstr "Considère ça comme une sortie d'entreprise, alors !"

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-2/c-6/39/c-0/7
msgctxt "Monique"
msgid "And what if I need to be spent?"
msgstr "Et si j'avais besoin d'être dépensée ?"

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-2/c-6/39/c-0/15
msgctxt "Monique"
msgid "You may not consider certain issues an emergency, but I may spot dangers in this home that need to be addressed."
msgstr "Tu ne juges peut-être pas certains problèmes comme des urgences, mais je peux repérer des dangers dans cette maison qui doivent être traités."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-2/c-6/39/c-0/23
msgctxt "Monique"
msgid "Dangers that I will need to recalculate for."
msgstr "Des dangers pour lesquels je devrai refaire mes calculs."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-2/c-6/39/g-0/8
msgctxt "Monique"
msgid "You are just not getting it."
msgstr "Tu ne comprends tout simplement pas."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-2/c-6/39/g-0/16/0/s/0
msgctxt "Choix"
msgid "Get what?"
msgstr "Comprendre quoi ?"

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-2/c-6/39/g-0/16/c-0/7
msgctxt "Monique"
msgid "Being in here gives me peace."
msgstr "Être ici m'apporte la paix."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-2/c-6/39/g-0/16/c-0/15
msgctxt "Monique"
msgid "It takes a lot of mental preparation and fortitude to do what I do and I can not have any distractions."
msgstr "Il faut beaucoup de préparation mentale et de force d'âme pour faire ce que je fais, et je ne peux pas me permettre de distractions."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-2/c-6/39/g-0/16/c-0/23
msgctxt "Monique"
msgid "I understand it is your prerogative to date every object in this household..."
msgstr "Je comprends que ce soit ta prérogative de sortir avec tous les objets de cette maison..."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-2/c-6/39/g-0/16/c-0/31
msgctxt "Monique"
msgid "... but I am not an item for pleasure."
msgstr "... mais je ne suis pas un objet de plaisir."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-2/c-6/39/g-0/16/c-0/39
msgctxt "Monique"
msgid "Please know that and respect me."
msgstr "Sache-le et respecte-moi."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-2/c-6/39/g-0/16/c-0/47/0/s/0
msgctxt "Choix"
msgid "Okay - I'm being respectful then."
msgstr "D'accord, je fais preuve de respect, alors."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-2/c-6/39/g-0/16/c-0/47/1/s/0
msgctxt "Choix"
msgid "Man you're tough to talk to."
msgstr "Dis donc, tu es difficile à aborder."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-3/11
msgctxt "Monique"
msgid "If you do not mind, please excuse yourself."
msgstr "Si cela ne te dérange pas, retire-toi, je te prie."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-3/19
msgctxt "Monique"
msgid "I need some space."
msgstr "J'ai besoin d'espace."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-3/27/b/7 monique_money/monique_day_reminder/3/b/1
msgctxt "Monique"
msgid "Please come back on a Wednesday."
msgstr "Reviens un mercredi, je te prie."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-3/28/b/7 monique_money/monique_day_reminder/4/b/1
msgctxt "Monique"
msgid "Please come back on a Thursday."
msgstr "Reviens un jeudi, je te prie."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-3/29/b/7 monique_money/monique_day_reminder/5/b/1
msgctxt "Monique"
msgid "Please come back on a Friday."
msgstr "Reviens un vendredi, je te prie."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-3/30/b/7 monique_money/monique_day_reminder/6/b/1
msgctxt "Monique"
msgid "Please come back on a Saturday."
msgstr "Reviens un samedi, je te prie."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-3/31/b/7 monique_money/monique_day_reminder/0/b/1
msgctxt "Monique"
msgid "Please come back on a Sunday."
msgstr "Reviens un dimanche, je te prie."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-3/32/b/7 monique_money/monique_day_reminder/1/b/1
msgctxt "Monique"
msgid "Please come back on a Monday."
msgstr "Reviens un lundi, je te prie."

# Traduction IA – à relire
#: monique_money/Monique_3/0/g-3/33/b/7 monique_money/monique_day_reminder/2/b/1
msgctxt "Monique"
msgid "Please come back on a Tuesday."
msgstr "Reviens un mardi, je te prie."

# Traduction IA – à relire
#: monique_money/Monique_4/0/0/b/1
msgctxt "Monique"
msgid "I am sorry, but it is a busy day for me."
msgstr "Je suis désolée, mais c'est une journée chargée pour moi."

# Traduction IA – à relire
#: monique_money/Monique_4/0/3/b/1
msgctxt "Monique"
msgid "Oh... hello."
msgstr "Oh... bonjour."

# Traduction IA – à relire
#: monique_money/Monique_4/0/12
msgctxt "Monique"
msgid "Please sit."
msgstr "Assieds-toi, je te prie."

# Traduction IA – à relire
#: monique_money/Monique_4/0/20/s/0
msgctxt "Choix"
msgid "Oh okay."
msgstr "Oh d'accord."

# Traduction IA – à relire
#: monique_money/Monique_4/0/21/s/0
msgctxt "Choix"
msgid "Like on the floor?"
msgstr "Genre, par terre ?"

# Traduction IA – à relire
#: monique_money/Monique_4/0/g-0/0
msgctxt "Monique"
msgid "I have given some thought to our previous conversation and I'd like to be transparent about something you asked."
msgstr "J'ai réfléchi à notre précédente conversation et je voudrais être transparente sur quelque chose que tu m'as demandé."

# Traduction IA – à relire
#: monique_money/Monique_4/0/g-0/8
msgctxt "Monique"
msgid "You are correct. I am scared."
msgstr "Tu as raison. J'ai peur."

# Traduction IA – à relire
#: monique_money/Monique_4/0/g-0/16
msgctxt "Monique"
msgid "Unpreparedness gives me a tremendous amount of stress and anxiety."
msgstr "Le manque de préparation me cause un stress et une angoisse considérables."

# Traduction IA – à relire
#: monique_money/Monique_4/0/g-0/24
msgctxt "Monique"
msgid "Just imagining myself wandering into the unknown makes me want to quit everything for the day and lie down."
msgstr "Rien que de m'imaginer errer dans l'inconnu me donne envie de tout arrêter pour la journée et de m'allonger."

# Traduction IA – à relire
#: monique_money/Monique_4/0/g-0/32 monique_money/monique_ed_friend/0/56
msgctxt "Monique"
msgid "I hope you understand."
msgstr "J'espère que tu comprends."

# Traduction IA – à relire
#: monique_money/Monique_4/0/g-0/40/s/0
msgctxt "Choix"
msgid "Yeah. I do."
msgstr "Oui. Je comprends."

# Traduction IA – à relire
#: monique_money/Monique_4/0/g-0/41/s/0
msgctxt "Choix"
msgid "Kinda."
msgstr "Un peu."

# Traduction IA – à relire
#: monique_money/Monique_4/0/g-0/42/s/0
msgctxt "Choix"
msgid "No not really."
msgstr "Non, pas vraiment."

# Traduction IA – à relire
#: monique_money/Monique_4/0/g-0/c-4/7
msgctxt "Monique"
msgid "I suppose whether you understand or no, it is of little consequence."
msgstr "Je suppose que, que tu comprennes ou non, cela importe peu."

# Traduction IA – à relire
#: monique_money/Monique_4/0/g-1/0
msgctxt "Monique"
msgid "But in order for me to take risks and venture, I need to know if I can trust you."
msgstr "Mais pour que je prenne des risques et m'aventure, j'ai besoin de savoir si je peux te faire confiance."

# Traduction IA – à relire
#: monique_money/Monique_4/0/g-1/8
msgctxt "Monique"
msgid "And trust your decisions."
msgstr "Et avoir confiance dans tes décisions."

# Traduction IA – à relire
#: monique_money/Monique_4/0/g-1/16
msgctxt "Monique"
msgid "I will be conducting an interview now."
msgstr "Je vais maintenant mener un entretien."

# Traduction IA – à relire
#: monique_money/Monique_4/0/g-1/24/s/0
msgctxt "Choix"
msgid "An interview?"
msgstr "Un entretien ?"

# Traduction IA – à relire
#: monique_money/Monique_4/0/g-1/25/s/0 monique_money/monique_luke_divert/0/c-0/80/c-0/23/0/s/0
msgctxt "Choix"
msgid "Uh oh."
msgstr "Aïe aïe aïe."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/0
msgctxt "Monique"
msgid "Let us begin."
msgstr "Commençons."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/8
msgctxt "Monique"
msgid "The stakes of this interview is our relationship status. Nothing more."
msgstr "L'enjeu de cet entretien est le statut de notre relation. Rien de plus."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/16/s/0
msgctxt "Choix"
msgid "Those are high stakes!"
msgstr "Les enjeux sont élevés !"

# Traduction IA – à relire
#: monique_money/monique_quiz/0/17/s/0
msgctxt "Choix"
msgid "Can we do something else?"
msgstr "On peut faire autre chose ?"

# Traduction IA – à relire
#: monique_money/monique_quiz/0/18/s/0
msgctxt "Choix"
msgid "Okay, on with the interview!"
msgstr "D'accord, allons-y pour l'entretien !"

# Traduction IA – à relire
#: monique_money/monique_quiz/0/19/s/0
msgctxt "Choix"
msgid "Could we skip the quiz, pretty please?"
msgstr "On pourrait sauter le questionnaire, s'il te plaît, s'il te plaît ?"

# Traduction IA – à relire
#: monique_money/monique_quiz/0/c-1/7
msgctxt "Monique"
msgid "This is what makes me comfortable."
msgstr "C'est ce qui me met à l'aise."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/c-3/7 monique_money/monique_quiz/0/c-3/15/c-0/7 monique_money/monique_quiz/0/c-3/15/c-0/15/c-0/7
msgctxt "Monique"
msgid "No."
msgstr "Non."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/c-3/15/0/s/0
msgctxt "Choix"
msgid "What if I use my inescapable charm?"
msgstr "Et si j'utilise mon charme irrésistible ?"

# Traduction IA – à relire
#: monique_money/monique_quiz/0/c-3/15/1/s/0
msgctxt "Choix"
msgid "Okay fine."
msgstr "Bon, d'accord."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/c-3/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "What about my truly INCREDIBLE CHARM?"
msgstr "Et mon charme vraiment INCROYABLE ?"

# Traduction IA – à relire
#: monique_money/monique_quiz/0/c-3/15/c-0/15/1/s/0
msgctxt "Choix"
msgid "What about... uh..."
msgstr "Et si... euh..."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-0/0
msgctxt "Monique"
msgid "We begin."
msgstr "Nous commençons."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-0/8
msgctxt "Monique"
msgid "A game you really want releases, but you have already used up your personal spending budget. What do you do?"
msgstr "Un jeu dont tu rêves vient de sortir, mais tu as déjà épuisé ton budget de dépenses personnelles. Que fais-tu ?"

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-0/16/s/0
msgctxt "Choix"
msgid "Borrow from my savings."
msgstr "J'emprunte sur mes économies."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-0/17/s/0
msgctxt "Choix"
msgid "Cut out some other spending to fit it in."
msgstr "Je rogne sur d'autres dépenses pour le faire entrer dans le budget."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-0/18/s/0
msgctxt "Choix"
msgid "Wait until next month's budget."
msgstr "J'attends le budget du mois prochain."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-0/c-4/13 monique_money/monique_quiz/0/g-1/c-9/13 monique_money/monique_quiz/0/g-2/c-12/13 monique_money/monique_quiz/0/g-3/c-13/13 monique_money/monique_quiz/0/g-4/c-17/13 monique_money/monique_quiz/0/g-4/c-20/13 monique_money/monique_quiz/0/g-5/c-23/13 monique_money/monique_quiz/0/g-6/c-24/13 monique_money/monique_mac_divert/0/6
msgctxt "Monique"
msgid "Hmm..."
msgstr "Hmm..."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-0/c-5/13 monique_money/monique_quiz/0/g-1/c-8/13 monique_money/monique_quiz/0/g-2/c-10/13 monique_money/monique_quiz/0/g-3/c-15/13 monique_money/monique_quiz/0/g-4/c-18/13 monique_money/monique_quiz/0/g-5/c-22/13 monique_money/monique_quiz/0/g-6/c-25/13
msgctxt "Monique"
msgid "I see..."
msgstr "Je vois..."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-1/0 monique_money/monique_quiz/0/g-4/0
msgctxt "Monique"
msgid "Next question."
msgstr "Question suivante."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-1/8
msgctxt "Monique"
msgid "You have some furniture that you no longer need. How do you get rid of it?"
msgstr "Tu as un meuble dont tu n'as plus besoin. Comment t'en débarrasses-tu ?"

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-1/16/s/0
msgctxt "Choix"
msgid "Put up a listing for it online."
msgstr "Je le mets en vente en ligne."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-1/17/s/0
msgctxt "Choix"
msgid "Sell it to a friend at a discounted price."
msgstr "Je le vends à un ami à prix réduit."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-1/18/s/0
msgctxt "Choix"
msgid "Dump it."
msgstr "Je le jette."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-2/0
msgctxt "Monique"
msgid "Onto the next question."
msgstr "Passons à la question suivante."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-2/8
msgctxt "Monique"
msgid "You happen to win the lottery. How do you manage your new earnings?"
msgstr "Tu gagnes par hasard à la loterie. Comment gères-tu ces nouveaux revenus ?"

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-2/16/s/0
msgctxt "Choix"
msgid "Pay off my debts and keep it in my savings."
msgstr "Je rembourse mes dettes et je garde le reste en épargne."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-2/17/s/0
msgctxt "Choix"
msgid "Pay off my debts and invest the rest."
msgstr "Je rembourse mes dettes et j'investis le reste."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-2/18/s/0
msgctxt "Choix"
msgid "Pay off my debts and buy a huge boat."
msgstr "Je rembourse mes dettes et je m'achète un énorme bateau."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-3/0
msgctxt "Monique"
msgid "Let us continue."
msgstr "Continuons."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-3/8
msgctxt "Monique"
msgid "Suddenly, you are laid off from your job. What do you do?"
msgstr "Soudain, tu perds ton emploi. Que fais-tu ?"

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-3/16/s/0
msgctxt "Choix"
msgid "Go on a vacation."
msgstr "Je pars en vacances."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-3/17/s/0
msgctxt "Choix"
msgid "Adjust my budget."
msgstr "J'ajuste mon budget."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-3/18/s/0
msgctxt "Choix"
msgid "Allocate savings until the next job."
msgstr "Je mets de côté de quoi tenir jusqu'au prochain emploi."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-3/19/s/0
msgctxt "Choix"
msgid "Date everything."
msgstr "Je sors avec tout."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-3/c-16/13
msgctxt "Monique"
msgid "Intriguing..."
msgstr "Intrigant..."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-4/8
msgctxt "Monique"
msgid "How much do you tip?"
msgstr "Combien laisses-tu en pourboire ?"

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-5/0
msgctxt "Monique"
msgid "Almost done."
msgstr "C'est presque fini."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-5/8
msgctxt "Monique"
msgid "How often do you think about money?"
msgstr "À quelle fréquence penses-tu à l'argent ?"

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-5/16/s/0
msgctxt "Choix"
msgid "All the time."
msgstr "Tout le temps."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-5/17/s/0
msgctxt "Choix"
msgid "Some times."
msgstr "Parfois."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-5/18/s/0
msgctxt "Choix"
msgid "Not often."
msgstr "Pas souvent."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-6/0
msgctxt "Monique"
msgid "Final question."
msgstr "Dernière question."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-6/8
msgctxt "Monique"
msgid "Why do you keep visiting me?"
msgstr "Pourquoi continues-tu à me rendre visite ?"

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-6/16/s/0
msgctxt "Choix"
msgid "Gotta fill out this Date-a-dex."
msgstr "Il faut que je remplisse ce Date-a-dex."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-6/17/s/0
msgctxt "Choix"
msgid "Because I care about you."
msgstr "Parce que je tiens à toi."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-6/18/s/0
msgctxt "Choix"
msgid "Because I like you."
msgstr "Parce que je t'aime bien."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-6/19/s/0
msgctxt "Choix"
msgid "Because I love you."
msgstr "Parce que je t'aime."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-6/c-26/21 monique_money/monique_quiz/0/g-6/c-27/21
msgctxt "Monique"
msgid "...duly noted."
msgstr "...dûment noté."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-7/0
msgctxt "Monique"
msgid "Before we complete this interview, I would like to confirm: are you satisfied with your answers?"
msgstr "Avant de conclure cet entretien, je voudrais confirmer : es-tu {{satisfait|satisfaite|satisfait·e}} de tes réponses ?"

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-7/8/s/0
msgctxt "Choix"
msgid "No. I'd like to change my answers."
msgstr "Non. Je voudrais changer mes réponses."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-7/9/s/0
msgctxt "Choix"
msgid "Yes. I'm confident."
msgstr "Oui. Je ne changerai rien."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-7/c-28/11 monique_money/monique_quiz/0/g-7/c-29/7
msgctxt "Monique"
msgid "Very well then."
msgstr "Très bien."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-7/c-29/15
msgctxt "Monique"
msgid "This concludes the interview."
msgstr "Cela conclut l'entretien."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-7/c-29/23
msgctxt "Monique"
msgid "Thank you for your participation."
msgstr "Merci de ta participation."

# Traduction IA – à relire
#: monique_money/monique_quiz/0/g-7/c-29/31
msgctxt "Monique"
msgid "I will review your results, which you will be briefed on during your next visit."
msgstr "J'examinerai tes résultats, qui te seront communiqués lors de ta prochaine visite."

# Traduction IA – à relire
#: monique_money/Monique_5/0
msgctxt "Monique"
msgid "Welcome back."
msgstr "Bienvenue de nouveau."

# Traduction IA – à relire
#: monique_money/Monique_5/8
msgctxt "Monique"
msgid "I have reviewed your answers and taken them into careful consideration."
msgstr "J'ai examiné tes réponses et les ai prises en considération avec soin."

# Traduction IA – à relire
#: monique_money/Monique_5/16
msgctxt "Monique"
msgid "I believe you to be..."
msgstr "Je crois que tu es..."

# Traduction IA – à relire
#: monique_money/monique_ed_hate/0/0
msgctxt "Monique"
msgid "Absolutely untrustworthy."
msgstr "Absolument indigne de confiance."

# Traduction IA – à relire
#: monique_money/monique_ed_hate/0/8
msgctxt "Monique"
msgid "Your lifestyle and decision-making drives me insane."
msgstr "Ton mode de vie et tes choix me rendent folle."

# Traduction IA – à relire
#: monique_money/monique_ed_hate/0/19
msgctxt "Monique"
msgid "It is a miracle you even remembered I existed because I am pretty sure you would have spent me right away."
msgstr "C'est un miracle que mon existence te soit revenue en mémoire, car je suis presque certaine que tu m'aurais dépensée sur-le-champ."

# Traduction IA – à relire
#: monique_money/monique_ed_hate/0/27
msgctxt "Monique"
msgid "If going outside made you like this, then I am not interested in ever leaving."
msgstr "Si sortir dehors te rend ainsi, alors je ne tiens pas du tout à jamais quitter cet endroit."

# Traduction IA – à relire
#: monique_money/monique_ed_hate/0/35/s/0
msgctxt "Choix"
msgid "I'm sorry!"
msgstr "{{Désolé|Désolée|Désolé·e}} !"

# Traduction IA – à relire
#: monique_money/monique_ed_hate/0/36/s/0
msgctxt "Choix"
msgid "Fine, whatever."
msgstr "Bon, peu importe."

# Traduction IA – à relire
#: monique_money/monique_ed_hate/0/g-0/0
msgctxt "Monique"
msgid "Farewell. I hope you grow up someday."
msgstr "Adieu. J'espère que tu grandiras un jour."

# Traduction IA – à relire
#: monique_money/monique_ed_hate/0/g-0/42
msgctxt "Reggie"
msgid "She saw right through you! No money saved, no future... at least not with her!"
msgstr "Elle a vu clair dans ton jeu ! Pas d'économies, pas d'avenir... du moins pas avec elle !"

# Traduction IA – à relire
#: monique_money/monique_ed_friend/0/0
msgctxt "Monique"
msgid "Well-meaning."
msgstr "{{Bien intentionné|Bien intentionnée|Bien intentionné·e}}."

# Traduction IA – à relire
#: monique_money/monique_ed_friend/0/8
msgctxt "Monique"
msgid "You are smart. You really took my questions into thought."
msgstr "Tu es {{intelligent|intelligente|intelligent·e}}. Tu as vraiment réfléchi à mes questions."

# Traduction IA – à relire
#: monique_money/monique_ed_friend/0/16
msgctxt "Monique"
msgid "But you also stayed true to yourself and how you live your life."
msgstr "Mais tu es aussi {{resté|restée|resté·e}} fidèle à toi-même et à ta façon de vivre."

# Traduction IA – à relire
#: monique_money/monique_ed_friend/0/24
msgctxt "Monique"
msgid "Some of your answers were a bit... erratic for me."
msgstr "Certaines de tes réponses étaient un peu... erratiques pour moi."

# Traduction IA – à relire
#: monique_money/monique_ed_friend/0/32
msgctxt "Monique"
msgid "But I respect your choices."
msgstr "Mais je respecte tes choix."

# Traduction IA – à relire
#: monique_money/monique_ed_friend/0/40
msgctxt "Monique"
msgid "I would really like to join you and walk around the house..."
msgstr "J'aimerais beaucoup t'accompagner et faire le tour de la maison..."

# Traduction IA – à relire
#: monique_money/monique_ed_friend/0/48
msgctxt "Monique"
msgid "...just not any time soon."
msgstr "...mais pas de sitôt."

# Traduction IA – à relire
#: monique_money/monique_ed_friend/0/64/s/0
msgctxt "Choix"
msgid "I get it."
msgstr "Je comprends."

# Traduction IA – à relire
#: monique_money/monique_ed_friend/0/c-0/7
msgctxt "Monique"
msgid "But please!"
msgstr "Mais je t'en prie !"

# Traduction IA – à relire
#: monique_money/monique_ed_friend/0/c-0/15
msgctxt "Monique"
msgid "Visit me again."
msgstr "Reviens me voir."

# Traduction IA – à relire
#: monique_money/monique_ed_friend/0/c-0/23
msgctxt "Monique"
msgid "I will be more than happy to go over any financial troubles with you."
msgstr "Je serai ravie d'examiner avec toi tes éventuels soucis financiers."

# Traduction IA – à relire
#: monique_money/monique_ed_friend/0/c-0/31
msgctxt "Monique"
msgid "Or even hear stories about life from outside the safe."
msgstr "Ou même d'entendre des récits de la vie hors du coffre."

# Traduction IA – à relire
#: monique_money/monique_ed_friend/0/c-0/39
msgctxt "Monique"
msgid "Thanks for spending time with me!"
msgstr "Merci d'avoir passé du temps avec moi !"

# Traduction IA – à relire
#: monique_money/monique_ed_love/0/0
msgctxt "Monique"
msgid "Trustworthy."
msgstr "Digne de confiance."

# Traduction IA – à relire
#: monique_money/monique_ed_love/0/8
msgctxt "Monique"
msgid "I had a good feeling about you from the conversations we have had."
msgstr "J'avais un bon pressentiment à ton sujet, d'après nos conversations."

# Traduction IA – à relire
#: monique_money/monique_ed_love/0/16
msgctxt "Monique"
msgid "And after the interview, I really got to know what kind of person you are."
msgstr "Et après l'entretien, j'ai vraiment compris quel genre de personne tu es."

# Traduction IA – à relire
#: monique_money/monique_ed_love/0/24
msgctxt "Monique"
msgid "It is just reassuring to know that we are on the same page."
msgstr "C'est rassurant de savoir que nous sommes sur la même longueur d'onde."

# Traduction IA – à relire
#: monique_money/monique_ed_love/0/32/s/0
msgctxt "Choix"
msgid "Why's that?"
msgstr "Pourquoi ça ?"

# Traduction IA – à relire
#: monique_money/monique_ed_love/0/33/s/0
msgctxt "Choix"
msgid "We are?"
msgstr "Ah bon ?"

# Traduction IA – à relire
#: monique_money/monique_ed_love/0/c-0/7
msgctxt "Monique"
msgid "Because I... like you."
msgstr "Parce que je... t'apprécie."

# Traduction IA – à relire
#: monique_money/monique_ed_love/0/c-1/7
msgctxt "Monique"
msgid "I imagine that you like me."
msgstr "J'imagine que tu m'apprécies."

# Traduction IA – à relire
#: monique_money/monique_ed_love/0/c-1/15
msgctxt "Monique"
msgid "And I like you."
msgstr "Et je t'apprécie."

# Traduction IA – à relire
#: monique_money/monique_ed_love/0/g-0/0/s/0
msgctxt "Choix"
msgid "I like you too."
msgstr "Moi aussi, je t'aime bien."

# Traduction IA – à relire
#: monique_money/monique_ed_love/0/g-0/1/s/0
msgctxt "Choix"
msgid "Oh. I like you, as a friend."
msgstr "Oh. Je t'aime bien, en toute amitié."

# Traduction IA – à relire
#: monique_money/monique_ed_love/0/g-0/c-2/7
msgctxt "Monique"
msgid "Excellent!"
msgstr "Excellent !"

# Traduction IA – à relire
#: monique_money/monique_ed_love/0/g-0/c-2/18
msgctxt "Monique"
msgid "I mean... duly noted."
msgstr "Enfin... dûment noté."

# Traduction IA – à relire
#: monique_money/monique_ed_love/0/g-0/c-2/26
msgctxt "Monique"
msgid "Please recognize that the feelings are reciprocated."
msgstr "Sache que les sentiments sont réciproques."

# Traduction IA – à relire
#: monique_money/monique_ed_love/0/g-0/c-2/34
msgctxt "Monique"
msgid "Hehe."
msgstr "Hihi."

# Traduction IA – à relire
#: monique_money/monique_ed_love/0/g-0/c-2/45
msgctxt "Monique"
msgid "If it is alright with you, I would like to ask you for a favor."
msgstr "Si cela te convient, j'aimerais te demander une faveur."

# Traduction IA – à relire
#: monique_money/monique_ed_love/0/g-0/c-2/53/0/s/0
msgctxt "Choix"
msgid "What is it?"
msgstr "Laquelle ?"

# Traduction IA – à relire
#: monique_money/monique_ed_love/0/g-0/c-2/53/c-0/7
msgctxt "Monique"
msgid "Take me out on a date."
msgstr "Emmène-moi à un rendez-vous."

# Traduction IA – à relire
#: monique_money/monique_ed_love/0/g-0/c-2/53/c-0/15
msgctxt "Monique"
msgid "Just a stroll around the house will do."
msgstr "Une simple promenade dans la maison suffira."

# Traduction IA – à relire
#: monique_money/monique_ed_love/0/g-0/c-2/53/c-0/23
msgctxt "Monique"
msgid "I trust that you will keep me safe?"
msgstr "Je compte sur toi pour me protéger ?"

# Traduction IA – à relire
#: monique_money/monique_ed_love/0/g-0/c-2/53/c-0/31/0/s/0
msgctxt "Choix"
msgid "Of course!"
msgstr "Bien sûr !"

# Traduction IA – à relire
#: monique_money/monique_ed_love/0/g-0/c-2/53/c-0/31/1/s/0
msgctxt "Choix"
msgid "No promises."
msgstr "Je ne promets rien."

# Traduction IA – à relire
#: monique_money/monique_ed_love/0/g-0/c-2/53/c-0/31/c-0/7
msgctxt "Monique"
msgid "Good."
msgstr "Bien."

# Traduction IA – à relire
#: monique_money/monique_ed_love/0/g-0/c-2/53/c-0/31/c-0/15
msgctxt "Monique"
msgid "Okay. Let me just breathe for a sec..."
msgstr "D'accord. Laisse-moi respirer une seconde..."

# Traduction IA – à relire
#: monique_money/monique_ed_love/0/g-0/c-2/53/c-0/31/c-0/23
msgctxt "Monique"
msgid "I am ready."
msgstr "Je suis prête."

# Traduction IA – à relire
#: monique_money/monique_ed_love/0/g-0/c-2/53/c-0/31/c-1/7
msgctxt "Monique"
msgid "Risky... but perhaps I am ready for risks."
msgstr "Risqué... mais peut-être suis-je prête pour les risques."

# Traduction IA – à relire
#: monique_money/monique_ed_love/0/g-0/c-3/7
msgctxt "Monique"
msgid "...yes."
msgstr "...oui."

# Traduction IA – à relire
#: monique_money/monique_ed_love/0/g-0/c-3/18
msgctxt "Monique"
msgid "Thank you, friend."
msgstr "Merci, {{mon ami|mon amie|mon ami·e}}."

# Traduction IA – à relire
#: monique_money/monique_tour/0/1/7/0
msgctxt "Monique"
msgid "Where shall we go?"
msgstr "Où irons-nous ?"

# Traduction IA – à relire
#: monique_money/monique_tour/0/1/7/8/s/0
msgctxt "Choix"
msgid "The bedroom!"
msgstr "La chambre !"

# Traduction IA – à relire
#: monique_money/monique_tour/0/1/7/9/s/0
msgctxt "Choix"
msgid "How about the gym?"
msgstr "Et si on allait à la salle de sport ?"

# Traduction IA – à relire
#: monique_money/monique_tour/0/1/7/10/s/0
msgctxt "Choix"
msgid "Let's show you where you came from."
msgstr "Montrons-te d'où tu viens."

# Traduction IA – à relire
#: monique_money/monique_tour/0/1/7/11/s/0
msgctxt "Choix"
msgid "There's a big ol' living room."
msgstr "Il y a un grand vieux salon."

# Traduction IA – à relire
#: monique_money/monique_tour/0/1/7/c-0/20
msgctxt "Monique"
msgid "I have only seen glimpses, but this is nice!"
msgstr "Je n'en ai vu que des aperçus, mais c'est agréable !"

# Traduction IA – à relire
#: monique_money/monique_tour/0/1/7/c-0/28
msgctxt "Monique"
msgid "What a huge bed!"
msgstr "Quel immense lit !"

# Traduction IA – à relire
#: monique_money/monique_tour/0/1/7/c-0/36/0/s/0
msgctxt "Choix"
msgid "It's pretty comfy!"
msgstr "Il est plutôt confortable !"

# Traduction IA – à relire
#: monique_money/monique_tour/0/1/7/c-0/36/c-0/7
msgctxt "Monique"
msgid "It <i>IS</i>!"
msgstr "Il l'<i>EST</i> !"

# Traduction IA – à relire
#: monique_money/monique_tour/0/1/7/c-0/36/c-0/18
msgctxt "Monique"
msgid "Hey, would you like to lie down with me?"
msgstr "Dis, voudrais-tu t'allonger avec moi ?"

# Traduction IA – à relire
#: monique_money/monique_tour/0/1/7/c-0/36/c-0/26
msgctxt "Monique"
msgid "I want to savor this moment."
msgstr "Je veux savourer cet instant."

# Traduction IA – à relire
#: monique_money/monique_tour/0/1/7/c-0/36/c-0/34
msgctxt "Monique"
msgid "To think, I've been so close to this. To you."
msgstr "Dire que j'ai été si proche de ceci. De toi."

# Traduction IA – à relire
#: monique_money/monique_tour/0/1/7/c-0/36/c-0/42/0/s/0
msgctxt "Choix"
msgid "Shall we get going?"
msgstr "On y va ?"

# Traduction IA – à relire
#: monique_money/monique_tour/0/1/7/c-1/20 monique_money/hero_monique_divert/0/44
msgctxt "Monique"
msgid "Oh my!"
msgstr "Oh là là !"

# Traduction IA – à relire
#: monique_money/monique_tour/0/1/7/c-1/28
msgctxt "Monique"
msgid "So many accomplishments!"
msgstr "Que de réalisations !"

# Traduction IA – à relire
#: monique_money/monique_tour/0/1/7/c-2/20
msgctxt "Monique"
msgid "Hmm... this is... quaint."
msgstr "Hmm... c'est... pittoresque."

# Traduction IA – à relire
#: monique_money/monique_tour/0/1/7/c-2/28/0/s/0
msgctxt "Choix"
msgid "It's mostly storage."
msgstr "C'est surtout du rangement."

# Traduction IA – à relire
#: monique_money/monique_tour/0/1/7/c-2/28/c-0/7
msgctxt "Monique"
msgid "Oh, I see!"
msgstr "Oh, je vois !"

# Traduction IA – à relire
#: monique_money/monique_tour/0/1/7/c-2/28/c-0/15
msgctxt "Monique"
msgid "This is an efficient usage of the floorspace."
msgstr "Voilà une utilisation efficace de la surface au sol."

# Traduction IA – à relire
#: monique_money/monique_tour/0/1/7/c-2/28/c-0/23
msgctxt "Monique"
msgid "I approve!"
msgstr "J'approuve !"

# Traduction IA – à relire
#: monique_money/monique_tour/0/1/7/c-2/28/c-0/31/0/s/0
msgctxt "Choix"
msgid "No need to try so hard..."
msgstr "Pas besoin de te donner autant de mal..."

# Traduction IA – à relire
#: monique_money/monique_tour/0/1/7/c-2/28/c-0/31/c-0/7
msgctxt "Monique"
msgid "In that case, I think I have seen enough of this area."
msgstr "Dans ce cas, je pense avoir assez vu cette zone."

# Traduction IA – à relire
#: monique_money/monique_tour/0/1/7/c-3/20
msgctxt "Monique"
msgid "Woah!"
msgstr "Waouh !"

# Traduction IA – à relire
#: monique_money/monique_tour/0/1/7/c-3/28
msgctxt "Monique"
msgid "What do you do with all this space?"
msgstr "Que fais-tu de tout cet espace ?"

# Traduction IA – à relire
#: monique_money/monique_tour/0/1/7/c-3/36/0/s/0
msgctxt "Choix"
msgid "I play video games..."
msgstr "Je joue aux jeux vidéo..."

# Traduction IA – à relire
#: monique_money/monique_tour/0/1/7/c-3/36/1/s/0
msgctxt "Choix"
msgid "I watch TV."
msgstr "Je regarde la télé."

# Traduction IA – à relire
#: monique_money/monique_tour/0/1/7/c-3/36/2/s/0
msgctxt "Choix"
msgid "Hang out."
msgstr "Je traîne."

# Traduction IA – à relire
#: monique_money/monique_tour/0/1/7/c-3/36/3/s/0
msgctxt "Choix"
msgid "I wander around looking for stuff to date."
msgstr "Je me balade en cherchant des trucs avec qui sortir."

# Traduction IA – à relire
#: monique_money/monique_tour/0/1/7/c-3/36/c-0/7 monique_money/monique_tour/0/1/7/c-3/36/c-1/7 monique_money/monique_tour/0/1/7/c-3/36/c-2/7
msgctxt "Monique"
msgid "I suppose it would make sense to dedicate such a space to recreation and social activities."
msgstr "Je suppose qu'il est logique de consacrer un tel espace aux loisirs et à la vie sociale."

# Traduction IA – à relire
#: monique_money/monique_tour/0/1/7/c-3/36/c-3/7
msgctxt "Monique"
msgid "Oh!"
msgstr "Oh !"

# Traduction IA – à relire
#: monique_money/monique_tour/0/1/7/c-3/36/g-0/0
msgctxt "Monique"
msgid "You have a lot of nice things here. Expensive gaming consoles, a TV, lots of furniture, a piano... big windows too."
msgstr "Tu as beaucoup de belles choses ici. Des consoles de jeu coûteuses, une télé, beaucoup de meubles, un piano... de grandes fenêtres aussi."

# Traduction IA – à relire
#: monique_money/monique_tour/0/1/7/c-3/36/g-0/8
msgctxt "Monique"
msgid "I should take note of everything and plan for coverage."
msgstr "Je devrais tout noter et prévoir une couverture."

# Traduction IA – à relire
#: monique_money/monique_tour/0/1/7/c-3/36/g-0/16/0/s/0
msgctxt "Choix"
msgid "This is starting to sound like you're working..."
msgstr "On dirait que tu es en train de travailler..."

# Traduction IA – à relire
#: monique_money/monique_tour/0/1/7/c-3/36/g-0/16/c-0/7
msgctxt "Monique"
msgid "My apologies. You are correct."
msgstr "Toutes mes excuses. Tu as raison."

# Traduction IA – à relire
#: monique_money/monique_tour/0/1/7/c-3/36/g-0/16/c-0/15
msgctxt "Monique"
msgid "We are on a date."
msgstr "Nous sommes en rendez-vous."

# Traduction IA – à relire
#: monique_money/monique_tour/0/1/7/c-3/36/g-0/16/c-0/23
msgctxt "Monique"
msgid "Shall we continue?"
msgstr "Continuons-nous ?"

# Traduction IA – à relire
#: monique_money/monique_tour_two/0/6
msgctxt "Monique"
msgid "This is a whirlwind! Where to next?"
msgstr "Quel tourbillon ! Où allons-nous ensuite ?"

# Traduction IA – à relire
#: monique_money/monique_tour_two/0/14/s/0
msgctxt "Choix"
msgid "How about the dining room?"
msgstr "Et si on allait dans la salle à manger ?"

# Traduction IA – à relire
#: monique_money/monique_tour_two/0/15/s/0
msgctxt "Choix"
msgid "Let's take you to see the kitchen."
msgstr "Allons voir la cuisine."

# Traduction IA – à relire
#: monique_money/monique_tour_two/0/16/s/0
msgctxt "Choix"
msgid "Have you ever seen a laundry room?"
msgstr "Tu as déjà vu une buanderie ?"

# Traduction IA – à relire
#: monique_money/monique_tour_two/0/17/s/0
msgctxt "Choix"
msgid "I can show you my office?"
msgstr "Je peux te montrer mon bureau ?"

# Traduction IA – à relire
#: monique_money/monique_tour_two/0/c-0/20
msgctxt "Monique"
msgid "This is where you eat?"
msgstr "C'est ici que tu manges ?"

# Traduction IA – à relire
#: monique_money/monique_tour_two/0/c-0/28/0/s/0
msgctxt "Choix"
msgid "Yes, but sometimes I've been eating in the bedroom or office..."
msgstr "Oui, mais parfois je mange dans la chambre ou au bureau..."

# Traduction IA – à relire
#: monique_money/monique_tour_two/0/c-0/28/c-0/7
msgctxt "Monique"
msgid "I advise that you separate your spaces from work and rest."
msgstr "Je te conseille de séparer tes espaces de travail et de repos."

# Traduction IA – à relire
#: monique_money/monique_tour_two/0/c-0/28/c-0/15/0/s/0
msgctxt "Choix"
msgid "I thought you only gave out financial advice."
msgstr "Je croyais que tu ne donnais que des conseils financiers."

# Traduction IA – à relire
#: monique_money/monique_tour_two/0/c-0/28/c-0/15/c-0/7
msgctxt "Monique"
msgid "I have you to think about too now."
msgstr "J'ai aussi ta personne à prendre en compte, désormais."

# Traduction IA – à relire
#: monique_money/monique_tour_two/0/c-0/28/c-0/15/c-0/15
msgctxt "Monique"
msgid "Well, beyond the 'save-money-for-you' thoughts."
msgstr "Enfin, au-delà des pensées du genre « économiser de l'argent pour toi »."

# Traduction IA – à relire
#: monique_money/monique_tour_two/0/c-1/20
msgctxt "Monique"
msgid "What will you do for dinner tonight?"
msgstr "Que feras-tu pour le dîner ce soir ?"

# Traduction IA – à relire
#: monique_money/monique_tour_two/0/c-1/28/0/s/0
msgctxt "Choix"
msgid "I'm not sure."
msgstr "Je ne sais pas trop."

# Traduction IA – à relire
#: monique_money/monique_tour_two/0/c-1/28/c-0/7
msgctxt "Monique"
msgid "You have to start planning your meals!"
msgstr "Tu dois commencer à planifier tes repas !"

# Traduction IA – à relire
#: monique_money/monique_tour_two/0/c-1/28/c-0/15
msgctxt "Monique"
msgid "Do you have enough ingredients?"
msgstr "As-tu assez d'ingrédients ?"

# Traduction IA – à relire
#: monique_money/monique_tour_two/0/c-1/28/c-0/23
msgctxt "Monique"
msgid "Maybe we should take a trip to the grocery store."
msgstr "Nous devrions peut-être faire un tour à l'épicerie."

# Traduction IA – à relire
#: monique_money/monique_tour_two/0/c-1/28/c-0/31/0/s/0
msgctxt "Choix"
msgid "Monique..."
msgstr "Monique..."

# Traduction IA – à relire
#: monique_money/monique_tour_two/0/c-1/28/c-0/31/c-0/7
msgctxt "Monique"
msgid "Alright..."
msgstr "Bon..."

# Traduction IA – à relire
#: monique_money/monique_tour_two/0/c-1/28/c-0/31/c-0/15
msgctxt "Monique"
msgid "Perhaps you can order out tonight."
msgstr "Tu pourras peut-être commander ce soir."

# Traduction IA – à relire
#: monique_money/monique_tour_two/0/c-1/28/c-0/31/c-0/23
msgctxt "Monique"
msgid "But do not make that a habit!"
msgstr "Mais n'en fais pas une habitude !"

# Traduction IA – à relire
#: monique_money/monique_tour_two/0/c-2/20
msgctxt "Narrator"
msgid "Monique looks positively haunted. It takes her a while to even manage to speak."
msgstr "Monique a l'air proprement hantée. Il lui faut un moment pour réussir ne serait-ce qu'à parler."

# Traduction IA – à relire
#: monique_money/monique_tour_two/0/c-2/52/0/s/0
msgctxt "Choix"
msgid "Are you okay?"
msgstr "Ça va ?"

# Traduction IA – à relire
#: monique_money/monique_tour_two/0/c-2/52/c-0/7
msgctxt "Monique"
msgid "Just do not ever leave me in your pants pockets and forget about me."
msgstr "Ne me laisse jamais dans tes poches de pantalon en m'oubliant, c'est tout."

# Traduction IA – à relire
#: monique_money/monique_tour_two/0/c-3/20
msgctxt "Monique"
msgid "So this is where you make more of me."
msgstr "C'est donc ici que tu fabriques davantage de moi."

# Traduction IA – à relire
#: monique_money/monique_tour_two/0/c-3/28/0/s/0
msgctxt "Choix"
msgid "That's right!"
msgstr "Exactement !"

# Traduction IA – à relire
#: monique_money/monique_tour_two/0/c-3/28/c-0/7
msgctxt "Monique"
msgid "Amazing!"
msgstr "Extraordinaire !"

# Traduction IA – à relire
#: monique_money/hero_monique_divert/0/0
msgctxt "Monique"
msgid "Just another moment."
msgstr "Encore un instant."

# Traduction IA – à relire
#: monique_money/hero_monique_divert/0/16
msgctxt "Monique"
msgid "Okay. Ready!"
msgstr "Bien. Prête !"

# Traduction IA – à relire
#: monique_money/hero_monique_divert/0/33
msgctxt "Hero-Hime"
msgid "Time to train! <i>Starlight Smash!!</i>"
msgstr "C'est l'heure de s'entraîner ! <i>Smash Étincelant !!</i>"

# Traduction IA – à relire
#: monique_money/hero_monique_divert/0/55
msgctxt "Monique"
msgid "You must be the anime figure shouting all the time."
msgstr "Tu dois être la figurine d'anime qui crie tout le temps."

# Traduction IA – à relire
#: monique_money/hero_monique_divert/0/63
msgctxt "Hero-Hime"
msgid "If by shouting you mean intensely powering up, then you're absolutely right! The name's Hero-hime!"
msgstr "Si par crier tu entends monter intensément en puissance, alors tu as tout à fait raison ! Je m'appelle Hero-hime !"

# Traduction IA – à relire
#: monique_money/hero_monique_divert/0/71
msgctxt "Monique"
msgid "Pleasure to meet you. I am Monique. When you say training, what did you mean-"
msgstr "Enchantée. Je suis Monique. Quand tu parles d'entraînement, que veux-tu di-"

# Traduction IA – à relire
#: monique_money/hero_monique_divert/0/79
msgctxt "Hero-Hime"
msgid "Gather your magical tennis energy with me! <i>Haaaahhh!!</i>"
msgstr "Rassemble ton énergie de tennis magique avec moi ! <i>Haaaahhh !!</i>"

# Traduction IA – à relire
#: monique_money/hero_monique_divert/0/90
msgctxt "Monique"
msgid "I do not think I am able to-"
msgstr "Je ne pense pas en être capa-"

# Traduction IA – à relire
#: monique_money/hero_monique_divert/0/98
msgctxt "Hero-Hime"
msgid "You think this form is impressive? Wait till you see <i>Starlight Prism Level Blue</i>!"
msgstr "Tu trouves cette forme impressionnante ? Attends de voir le <i>Prisme Étincelant Niveau Bleu</i> !"

# Traduction IA – à relire
#: monique_money/hero_monique_divert/0/109
msgctxt "Monique"
msgid "I beg your pardon?"
msgstr "Je te demande pardon ?"

# Traduction IA – à relire
#: monique_money/hero_monique_divert/0/117
msgctxt "Hero-Hime"
msgid "<i>HAAAAAAAAHHH!!!</i>"
msgstr "<i>HAAAAAAAAHHH !!!</i>"

# Traduction IA – à relire
#: monique_money/hero_monique_divert/0/128/s/0
msgctxt "Choix"
msgid "We should go."
msgstr "On devrait y aller."

# Traduction IA – à relire
#: monique_money/hero_monique_divert/0/c-0/7
msgctxt "Monique"
msgid "Y-yes!"
msgstr "O-oui !"

# Traduction IA – à relire
#: monique_money/hero_monique_divert/0/c-0/18
msgctxt "Monique"
msgid "I would like to have a word with you about your personal spending budget..."
msgstr "J'aimerais avoir un mot avec toi à propos de ton budget de dépenses personnelles..."

# Traduction IA – à relire
#: monique_money/hero_monique_divert/0/c-0/26/0/s/0
msgctxt "Choix"
msgid "I didn't buy that!"
msgstr "Je n'ai pas acheté ça !"

# Traduction IA – à relire
#: monique_money/hero_monique_divert/0/c-0/26/c-0/7
msgctxt "Monique"
msgid "Mmmhmmm...."
msgstr "Mmmmouais...."

# Traduction IA – à relire
#: monique_money/monique_telly_divert/0/6
msgctxt "Telly"
msgid "Well ain't this grand? It's my fav TV fan! And who's this snack of a stack of Benjamins?"
msgstr "Eh bah, quelle belle surprise ! Ma fan de télé préférée ! Et c'est qui, cette gâterie en liasses de biftons ?"

# Traduction IA – à relire
#: monique_money/monique_telly_divert/0/17
msgctxt "Monique"
msgid "Oh! Hello, my name is Monique."
msgstr "Oh ! Bonjour, je m'appelle Monique."

# Traduction IA – à relire
#: monique_money/monique_telly_divert/0/25
msgctxt "Telly"
msgid "Monique? How unique. And just as sleek as that fineeee physique. I must confess my interest is professly piqued."
msgstr "Monique ? C'est unique ! Et ce physiiique, aussi chic que magnifique... J'avoue, mon intérêt est piqué, c'est mécanique."

# Traduction IA – à relire
#: monique_money/monique_telly_divert/0/33
msgctxt "Telly"
msgid "I'm Telly — rhymes with jelly. Like how your besties' gonna feel when they peep you under my spell-y."
msgstr "Moi c'est Telly, comme « tellement » : tellement bien que tes potes seront verts quand tu m'auras sous les yeux, ma belle, c'est merveilleux."

# Traduction IA – à relire
#: monique_money/monique_telly_divert/0/41
msgctxt "Telly"
msgid "After all doll... this is the best corner of the whole dwelly."
msgstr "Après tout, poupée... c'est le plus beau coin de toute la demeurie."

# Traduction IA – à relire
#: monique_money/monique_telly_divert/0/49
msgctxt "Telly"
msgid "\"Dwelly\" of course being street for \"dwelling.\" Just something new I'm trying out."
msgstr "« Demeurie », bien sûr, c'est l'argot de la rue pour « demeure ». Un nouveau truc que j'essaie."

# Traduction IA – à relire
#: monique_money/monique_telly_divert/0/60
msgctxt "Monique"
msgid "What makes it the best?"
msgstr "Qu'est-ce qui en fait le plus beau ?"

# Traduction IA – à relire
#: monique_money/monique_telly_divert/0/68
msgctxt "Telly"
msgid "So gassed ya asked!"
msgstr "Trop hypé que tu poses la question !"

# Traduction IA – à relire
#: monique_money/monique_telly_divert/0/79
msgctxt "Telly"
msgid "Just affix those peepers on that sweet screen between my speakers."
msgstr "Colle juste tes mirettes sur ce bel écran entre mes enceintes."

# Traduction IA – à relire
#: monique_money/monique_telly_divert/0/87
msgctxt "Monique"
msgid "Alright then."
msgstr "Très bien."

# Traduction IA – à relire
#: monique_money/monique_telly_divert/0/95
msgctxt "Narrator"
msgid "Monique sits, a small breeze from the air conditoning blowing her hair just so. She looks beautiful."
msgstr "Monique s'assoit, un léger courant d'air de la climatisation faisant voler ses cheveux juste ce qu'il faut. Elle est belle."

# Traduction IA – à relire
#: monique_money/monique_telly_divert/0/106
msgctxt "Telly"
msgid "Now watch and squeal as my 5,000 series & shows reveal my appeal!"
msgstr "Regarde et pousse des cris : mes 5 000 séries et émissions révèlent mes appâts !"

# Traduction IA – à relire
#: monique_money/monique_telly_divert/0/114
msgctxt "Telly"
msgid "Don't all this must-see programming hit ya right in the feels? Ain't it unreal?"
msgstr "Tous ces programmes incontournables, ça te touche en plein cœur, non ? C'est pas irréel ?"

# Traduction IA – à relire
#: monique_money/monique_telly_divert/0/122
msgctxt "Monique"
msgid "...normally, I would question the overusage of air-conditioning when you aren't in the room."
msgstr "...d'ordinaire, je m'interrogerais sur l'usage excessif de la climatisation quand personne n'est dans la pièce."

# Traduction IA – à relire
#: monique_money/monique_telly_divert/0/130
msgctxt "Monique"
msgid "But this is quite lovely."
msgstr "Mais c'est fort agréable."

# Traduction IA – à relire
#: monique_money/monique_telly_divert/0/138
msgctxt "Telly"
msgid "Swing on by anytime, valentine. And I'll shine in your divine eyes somethin' sublime."
msgstr "Repasse quand tu veux, ma belle. Je brillerai dans tes yeux divins d'un éclat sublime."

# Traduction IA – à relire
#: monique_money/monique_telly_divert/0/146/s/0
msgctxt "Choix"
msgid "Let's continue our date, Monique."
msgstr "Continuons notre rendez-vous, Monique."

# Traduction IA – à relire
#: monique_money/monique_telly_divert/0/c-0/7
msgctxt "Narrator"
msgid "Monique doesn't respond—she closes her eyes, savoring the air conditioner's cool breeze."
msgstr "Monique ne répond pas : elle ferme les yeux, savourant la brise fraîche de la climatisation."

# Traduction IA – à relire
#: monique_money/monique_telly_divert/0/c-0/23/0/s/0
msgctxt "Choix"
msgid "Monique?"
msgstr "Monique ?"

# Traduction IA – à relire
#: monique_money/monique_telly_divert/0/c-0/23/c-0/7
msgctxt "Monique"
msgid "Huh? Oh yes! One moment."
msgstr "Hein ? Oh oui ! Un instant."

# Traduction IA – à relire
#: monique_money/monique_luke_divert/0/6
msgctxt "Luke"
msgid "WHO TRESPASSES."
msgstr "QUI VIOLE MON TERRITOIRE."

# Traduction IA – à relire
#: monique_money/monique_luke_divert/0/14/s/0
msgctxt "Choix"
msgid "Oh no."
msgstr "Oh non."

# Traduction IA – à relire
#: monique_money/monique_luke_divert/0/c-0/7
msgctxt "Monique"
msgid "Hello there. I am Monique. And you are?"
msgstr "Bonjour. Je suis Monique. Et toi, qui es-tu ?"

# Traduction IA – à relire
#: monique_money/monique_luke_divert/0/c-0/15
msgctxt "Luke"
msgid "Luke Nukem, Warrior of the Wastes."
msgstr "Luke Nukem, Guerrier des Friches."

# Traduction IA – à relire
#: monique_money/monique_luke_divert/0/c-0/23
msgctxt "Monique"
msgid "Duly—"
msgstr "Dû-"

# Traduction IA – à relire
#: monique_money/monique_luke_divert/0/c-0/31
msgctxt "Luke"
msgid "<b>DIE!</b>"
msgstr "<b>CREVE !</b>"

# Traduction IA – à relire
#: monique_money/monique_luke_divert/0/c-0/42
msgctxt "Monique"
msgid "Die?"
msgstr "Crever ?"

# Traduction IA – à relire
#: monique_money/monique_luke_divert/0/c-0/53
msgctxt "Luke"
msgid "<b><i> DIE! DIE! DIE! DIE! DIE! </b></i>"
msgstr "<b><i> CREVE ! CREVE ! CREVE ! CREVE ! CREVE ! </b></i>"

# Traduction IA – à relire
#: monique_money/monique_luke_divert/0/c-0/64
msgctxt "Monique"
msgid "Oh. This is not quite what I expected-"
msgstr "Oh. Ce n'est pas tout à fait ce à quoi je m'attendais-"

# Traduction IA – à relire
#: monique_money/monique_luke_divert/0/c-0/72
msgctxt "Luke"
msgid "<i>+growls+</i>"
msgstr "<i>+grogne+</i>"

# Traduction IA – à relire
#: monique_money/monique_luke_divert/0/c-0/80/0/s/0
msgctxt "Choix"
msgid "Careful, Monique..."
msgstr "Attention, Monique..."

# Traduction IA – à relire
#: monique_money/monique_luke_divert/0/c-0/80/c-0/7
msgctxt "Monique"
msgid "This is hardly acceptable!"
msgstr "C'est difficilement acceptable !"

# Traduction IA – à relire
#: monique_money/monique_luke_divert/0/c-0/80/c-0/15
msgctxt "Monique"
msgid "He must be capable of better!"
msgstr "Il doit être capable de mieux !"

# Traduction IA – à relire
#: monique_money/monique_luke_divert/0/c-0/80/c-0/23/c-0/15
msgctxt "Luke"
msgid "I apologize."
msgstr "Je m'excuse."

# Traduction IA – à relire
#: monique_money/monique_luke_divert/0/c-0/80/c-0/23/c-0/23
msgctxt "Luke"
msgid "With your green attire I assumed you were a Swarmer."
msgstr "Avec ta tenue verte, j'ai cru que tu étais un essaimeur."

# Traduction IA – à relire
#: monique_money/monique_luke_divert/0/c-0/80/c-0/23/c-0/31
msgctxt "Luke"
msgid "Can never be too careful."
msgstr "On n'est jamais trop prudent."

# Traduction IA – à relire
#: monique_money/monique_luke_divert/0/c-0/80/c-0/23/c-0/39
msgctxt "Luke"
msgid "Is there anything I can do for you?"
msgstr "Puis-je faire quelque chose pour toi ?"

# Traduction IA – à relire
#: monique_money/monique_luke_divert/0/c-0/80/c-0/23/c-0/47
msgctxt "Monique"
msgid "We would like something light and not overcooked to go, please."
msgstr "Nous voudrions quelque chose de léger et pas trop cuit, à emporter, s'il te plaît."

# Traduction IA – à relire
#: monique_money/monique_luke_divert/0/c-0/80/c-0/23/c-0/55
msgctxt "Luke"
msgid "SIR YES SIR!"
msgstr "OUI CHEF !"

# Traduction IA – à relire
#: monique_money/monique_luke_divert/0/c-0/80/c-0/23/c-0/69/0/s/0
msgctxt "Choix"
msgid "Wow."
msgstr "Waouh."

# Traduction IA – à relire
#: monique_money/monique_luke_divert/0/c-0/80/c-0/23/c-0/69/c-0/7
msgctxt "Monique"
msgid "Let's leave before he comes back!"
msgstr "Partons avant qu'il revienne !"

# Traduction IA – à relire
#: monique_money/monique_luke_divert/0/c-0/80/c-0/23/c-0/69/c-0/15
msgctxt "Luke"
msgid "How many tendies are you thinking, Sir?"
msgstr "Tu penses à combien de nuggets, chef ?"

# Traduction IA – à relire
#: monique_money/monique_luke_divert/0/c-0/80/c-0/23/c-0/69/c-0/20
msgctxt "Monique"
msgid "14, well done!"
msgstr "14, bien cuits !"

# Traduction IA – à relire
#: monique_money/monique_luke_divert/0/c-0/80/c-0/23/c-0/69/c-0/28
msgctxt "Luke"
msgid "AAAARARRGHHH!! FIRE!!!"
msgstr "AAAARARRGHHH !! FEU !!!"

# Traduction IA – à relire
#: monique_money/monique_luke_divert/0/c-0/80/c-0/23/c-0/69/c-0/33
msgctxt "Monique"
msgid "Okay... Let's go!"
msgstr "Bon... Allons-y !"

# Traduction IA – à relire
#: monique_money/monique_scandalabra_divert/0/6
msgctxt "Scandalabra"
msgid "Good day to you to both!"
msgstr "Bien le bonjour à vous deux !"

# Traduction IA – à relire
#: monique_money/monique_scandalabra_divert/0/14
msgctxt "Scandalabra"
msgid "Or should I say, good date?"
msgstr "Ou devrais-je dire, bon rendez-vous ?"

# Traduction IA – à relire
#: monique_money/monique_scandalabra_divert/0/22/s/0
msgctxt "Choix"
msgid "Monique, Scandalabra. Scandalabra, Monique."
msgstr "Monique, Scandalabra. Scandalabra, Monique."

# Traduction IA – à relire
#: monique_money/monique_scandalabra_divert/0/c-0/7
msgctxt "Monique"
msgid "Happy to meet you. And yes, we are on a good date."
msgstr "Ravie de te rencontrer. Et oui, nous sommes à un bon rendez-vous."

# Traduction IA – à relire
#: monique_money/monique_scandalabra_divert/0/c-0/15
msgctxt "Scandalabra"
msgid "Oh ho ho! Is that so?"
msgstr "Oh ho ho ! Est-ce ainsi ?"

# Traduction IA – à relire
#: monique_money/monique_scandalabra_divert/0/c-0/23
msgctxt "Scandalabra"
msgid "That pleases my flickering heart! But my intuition... it <i>sizzles</i>."
msgstr "Voilà qui réjouit mon cœur vacillant ! Mais mon intuition... elle <i>grésille</i>."

# Traduction IA – à relire
#: monique_money/monique_scandalabra_divert/0/c-0/31
msgctxt "Scandalabra"
msgid "What's truly keeping the wick burning steadily?"
msgstr "Qu'est-ce qui, au juste, entretient la mèche de cette sortie ?"

# Traduction IA – à relire
#: monique_money/monique_scandalabra_divert/0/c-0/39
msgctxt "Monique"
msgid "I suspect you mean an ulterior motive?"
msgstr "Je suppose que tu parles d'une arrière-pensée ?"

# Traduction IA – à relire
#: monique_money/monique_scandalabra_divert/0/c-0/47
msgctxt "Scandalabra"
msgid "Your words, not mine! Although, a planned murder would suffice."
msgstr "Vos mots, non les miens ! Quoique, un meurtre prémédité ferait l'affaire."

# Traduction IA – à relire
#: monique_money/monique_scandalabra_divert/0/c-0/55/0/s/0
msgctxt "Choix"
msgid "I'm right here."
msgstr "Je suis juste là."

# Traduction IA – à relire
#: monique_money/monique_scandalabra_divert/0/c-0/55/c-0/7
msgctxt "Monique"
msgid "I regret to inform you, Mr. Scandalabra, that for this outing there are only pure intentions between my date and I."
msgstr "J'ai le regret de t'informer, monsieur Scandalabra, que pour cette sortie il n'y a que de pures intentions entre mon cavalier et moi."

# Traduction IA – à relire
#: monique_money/monique_scandalabra_divert/0/c-0/55/c-0/15
msgctxt "Scandalabra"
msgid "Alack, this cannot be!"
msgstr "Hélas, cela ne se peut !"

# Traduction IA – à relire
#: monique_money/monique_scandalabra_divert/0/c-0/55/c-0/23
msgctxt "Scandalabra"
msgid "Surely, this spark harbors some secrecy!"
msgstr "Assurément, cette étincelle recèle quelque secret !"

# Traduction IA – à relire
#: monique_money/monique_scandalabra_divert/0/c-0/55/c-0/31/0/s/0
msgctxt "Choix"
msgid "All above board, my guy."
msgstr "Tout est réglo, mon vieux."

# Traduction IA – à relire
#: monique_money/monique_scandalabra_divert/0/c-0/55/c-0/31/c-0/7
msgctxt "Scandalabra"
msgid "So it is. Light me disappointed."
msgstr "Soit. Me voilà tout éteint."

# Traduction IA – à relire
#: monique_money/monique_scandalabra_divert/0/c-0/55/c-0/31/c-0/15
msgctxt "Monique"
msgid "If I may offer some gossip..."
msgstr "Si je puis offrir un ragot..."

# Traduction IA – à relire
#: monique_money/monique_scandalabra_divert/0/c-0/55/c-0/31/c-0/23
msgctxt "Narrator"
msgid "Monique leans in, cupping her hand around her mouth to whisper into Scandalabra's ear. Whatever she's telling him... he seems to like it."
msgstr "Monique se penche, la main en cornet devant la bouche, pour chuchoter à l'oreille de Scandalabra. Quoi qu'elle lui dise... il a l'air d'apprécier."

# Traduction IA – à relire
#: monique_money/monique_scandalabra_divert/0/c-0/55/c-0/31/c-0/50
msgctxt "Scandalabra"
msgid "...<w>SCANDALOUS!</w>"
msgstr "...<w>SCANDALEUX !</w>"

# Traduction IA – à relire
#: monique_money/monique_scandalabra_divert/0/c-0/55/c-0/31/c-0/64
msgctxt "Scandalabra"
msgid "I take my leave. Good morrow, my eager friend."
msgstr "Je prends congé. Bien le bonjour, mon ardent ami."

# Traduction IA – à relire
#: monique_money/monique_scandalabra_divert/0/c-0/55/c-0/31/c-0/72/0/s/0
msgctxt "Choix"
msgid "What did you say?"
msgstr "Qu'est-ce que tu lui as dit ?"

# Traduction IA – à relire
#: monique_money/monique_scandalabra_divert/0/c-0/55/c-0/31/c-0/72/c-0/7
msgctxt "Monique"
msgid "I told him you were a gambling addict."
msgstr "Je lui ai dit que tu étais accro aux jeux d'argent."

# Traduction IA – à relire
#: monique_money/monique_scandalabra_divert/0/c-0/55/c-0/31/c-0/72/c-0/15/0/s/0
msgctxt "Choix"
msgid "Great, now everyone will think I'm bad with money."
msgstr "Génial, maintenant tout le monde va croire que je gère mal l'argent."

# Traduction IA – à relire
#: monique_money/monique_scandalabra_divert/0/c-0/55/c-0/31/c-0/72/c-0/15/c-0/7
msgctxt "Monique"
msgid "Then it is a good thing that <i>I</i> am with you."
msgstr "Alors heureusement que <i>je</i> suis avec toi."

# Traduction IA – à relire
#: monique_money/monique_stepford_divert/0/6
msgctxt "Stepford"
msgid "Why admire the collection when I'm right here?"
msgstr "Pourquoi admirer la collection alors que je suis juste là ?"

# Traduction IA – à relire
#: monique_money/monique_stepford_divert/0/14
msgctxt "Monique"
msgid "<i>Ahh!</i>"
msgstr "<i>Ahh !</i>"

# Traduction IA – à relire
#: monique_money/monique_stepford_divert/0/25
msgctxt "Stepford"
msgid "Yes, a natural reaction to my luster, physique, and... <i>wares</i>."
msgstr "Oui, une réaction naturelle face à mon éclat, mon physique et... mes <i>atouts</i>."

# Traduction IA – à relire
#: monique_money/monique_stepford_divert/0/36
msgctxt "Monique"
msgid "My apologies. It is my first time exploring the house. I am Monique."
msgstr "Toutes mes excuses. C'est la première fois que j'explore la maison. Je suis Monique."

# Traduction IA – à relire
#: monique_money/monique_stepford_divert/0/44
msgctxt "Stepford"
msgid "Charmed! Call me Stepford, honey."
msgstr "Enchanté ! Appelle-moi Stepford, ma belle."

# Traduction IA – à relire
#: monique_money/monique_stepford_divert/0/52
msgctxt "Monique"
msgid "And what competitive victories do you symbolize?"
msgstr "Et quelles victoires sportives symbolises-tu ?"

# Traduction IA – à relire
#: monique_money/monique_stepford_divert/0/60
msgctxt "Stepford"
msgid "<i>What haven't I won?</i>... is what I'll say once the next events start up."
msgstr "<i>Qu'est-ce que je n'ai pas gagné ?</i>... voilà ce que je dirai une fois les prochaines compétitions lancées."

# Traduction IA – à relire
#: monique_money/monique_stepford_divert/0/68
msgctxt "Stepford"
msgid "I won't have time to exchange pleasantries with the commonfolk once my winning streak starts!"
msgstr "Je n'aurai pas le temps d'échanger des politesses avec le commun des mortels quand ma série de victoires commencera !"

# Traduction IA – à relire
#: monique_money/monique_stepford_divert/0/76
msgctxt "Monique"
msgid "I see! How impressive!"
msgstr "Je vois ! Impressionnant !"

# Traduction IA – à relire
#: monique_money/monique_stepford_divert/0/84
msgctxt "Stepford"
msgid "Yeah! Yeah. Wait... you really think so?"
msgstr "Ouais ! Ouais. Attends... tu le penses vraiment ?"

# Traduction IA – à relire
#: monique_money/monique_stepford_divert/0/92
msgctxt "Monique"
msgid "You may have started off as a budgetary investment to pull in competitors..."
msgstr "Tu as peut-être commencé comme un investissement budgétaire pour attirer des concurrents..."

# Traduction IA – à relire
#: monique_money/monique_stepford_divert/0/100
msgctxt "Monique"
msgid "...but you aspire to increase your value by investing in shows instead of collecting dust!"
msgstr "...mais tu aspires à augmenter ta valeur en investissant dans des spectacles plutôt qu'à prendre la poussière !"

# Traduction IA – à relire
#: monique_money/monique_stepford_divert/0/108
msgctxt "Monique"
msgid "A very wise and thought-out decision, if I may say!"
msgstr "Une décision très sage et réfléchie, si je puis dire !"

# Traduction IA – à relire
#: monique_money/monique_stepford_divert/0/116
msgctxt "Stepford"
msgid "I like this gal!"
msgstr "J'aime bien cette nana !"

# Traduction IA – à relire
#: monique_money/monique_stepford_divert/0/124/s/0
msgctxt "Choix"
msgid "Glad you do!"
msgstr "Tant mieux si elle te plaît !"

# Traduction IA – à relire
#: monique_money/monique_stepford_divert/0/c-0/7
msgctxt "Monique"
msgid "I see that you spent a great deal on these equipments in order to maintain your physical goals!"
msgstr "Je vois que tu as beaucoup dépensé pour ces équipements afin de maintenir tes objectifs physiques !"

# Traduction IA – à relire
#: monique_money/monique_stepford_divert/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "Maybe not so much lately..."
msgstr "Peut-être pas tant que ça, ces derniers temps..."

# Traduction IA – à relire
#: monique_money/monique_stepford_divert/0/c-0/15/c-0/7
msgctxt "Monique"
msgid "Either way, I am thoroughly impressed."
msgstr "Quoi qu'il en soit, je suis profondément impressionnée."

# Traduction IA – à relire
#: monique_money/monique_sophia_divert/0/14
msgctxt "Monique"
msgid "Oh! Sophia. Hello."
msgstr "Oh ! Sophia. Bonjour."

# Traduction IA – à relire
#: monique_money/monique_sophia_divert/0/22
msgctxt "Monique"
msgid "Thank you for taking me under your care all these years."
msgstr "Merci de m'avoir prise sous ton aile toutes ces années."

# Traduction IA – à relire
#: monique_money/monique_sophia_divert/0/30
msgctxt "Sophia"
msgid "Someone had to."
msgstr "Il fallait bien que quelqu'un le fasse."

# Traduction IA – à relire
#: monique_money/monique_sophia_divert/0/38
msgctxt "Monique"
msgid "Ah..."
msgstr "Ah..."

# Traduction IA – à relire
#: monique_money/monique_sophia_divert/0/46
msgctxt "Sophia"
msgid "And I was more than happy to."
msgstr "Et je l'ai fait avec plaisir."

# Traduction IA – à relire
#: monique_money/monique_sophia_divert/0/54
msgctxt "Monique"
msgid "Sophia..."
msgstr "Sophia..."

# Traduction IA – à relire
#: monique_money/monique_sophia_divert/0/62
msgctxt "Sophia"
msgid "I'm surprised to see you outside. Think you can handle the outside world?"
msgstr "Je suis surprise de te voir dehors. Tu crois que tu peux affronter le monde extérieur ?"

# Traduction IA – à relire
#: monique_money/monique_sophia_divert/0/70
msgctxt "Monique"
msgid "Oh..."
msgstr "Oh..."

# Traduction IA – à relire
#: monique_money/monique_sophia_divert/0/78
msgctxt "Sophia"
msgid "\"Oh,\" she says."
msgstr "« Oh », dit-elle."

# Traduction IA – à relire
#: monique_money/monique_sophia_divert/0/86
msgctxt "Monique"
msgid "I kept to myself for so long and worried that you harbored ill feelings towards me, so I was nervous about running into you."
msgstr "Je suis restée si longtemps dans mon coin, et je craignais que tu ne me gardes rancune, alors j'étais nerveuse à l'idée de te croiser."

# Traduction IA – à relire
#: monique_money/monique_sophia_divert/0/94
msgctxt "Sophia"
msgid "Then run into me more often so I can give you a hug!"
msgstr "Alors croise-moi plus souvent, que je puisse te serrer dans mes bras !"

# Traduction IA – à relire
#: monique_money/monique_sophia_divert/0/102 monique_money/monique_mac_divert/0/62
msgctxt "Monique"
msgid "Thank you."
msgstr "Merci."

# Traduction IA – à relire
#: monique_money/monique_sophia_divert/0/110
msgctxt "Sophia"
msgid "...and a whipping."
msgstr "...et te fouetter."

# Traduction IA – à relire
#: monique_money/monique_sophia_divert/0/118
msgctxt "Monique"
msgid "...gulp..."
msgstr "...gloups..."

# Traduction IA – à relire
#: monique_money/monique_sophia_divert/0/129
msgctxt "Sophia"
msgid "Alright, now go run along! There's a whole house to see!"
msgstr "Bon, maintenant file ! Il y a toute une maison à voir !"

# Traduction IA – à relire
#: monique_money/monique_sophia_divert/0/137
msgctxt "Monique"
msgid "Right. Duly noted."
msgstr "Bien. Dûment noté."

# Traduction IA – à relire
#: monique_money/monique_sophia_divert/0/148/s/0
msgctxt "Choix"
msgid "Shall we?"
msgstr "On y va ?"

# Traduction IA – à relire
#: monique_money/monique_sophia_divert/0/c-0/7
msgctxt "Monique"
msgid "Yes!"
msgstr "Oui !"

# Traduction IA – à relire
#: monique_money/monique_mac_divert/0/14
msgctxt "Mac"
msgid "Can I help you?"
msgstr "Je peux t'aider ?"

# Traduction IA – à relire
#: monique_money/monique_mac_divert/0/22
msgctxt "Monique"
msgid "Hello! I am Monique."
msgstr "Bonjour ! Je suis Monique."

# Traduction IA – à relire
#: monique_money/monique_mac_divert/0/30
msgctxt "Mac"
msgid "Mac."
msgstr "Mac."

# Traduction IA – à relire
#: monique_money/monique_mac_divert/0/38
msgctxt "Monique"
msgid "Mac, would you happen to be storing a budget sheet file for monthly spending?"
msgstr "Mac, aurais-tu par hasard un fichier de budget pour les dépenses mensuelles ?"

# Traduction IA – à relire
#: monique_money/monique_mac_divert/0/46
msgctxt "Mac"
msgid "Lemme check."
msgstr "Voyons voir."

# Traduction IA – à relire
#: monique_money/monique_mac_divert/0/54
msgctxt "Mac"
msgid "Nope."
msgstr "Non."

# Traduction IA – à relire
#: monique_money/monique_mac_divert/0/78/s/0
msgctxt "Choix"
msgid "What's with the look?"
msgstr "C'est quoi, ce regard ?"

# Traduction IA – à relire
#: monique_money/monique_mac_divert/0/c-0/7
msgctxt "Monique"
msgid "Will you start writing down what I say?"
msgstr "Vas-tu commencer à noter ce que je dis ?"

# Traduction IA – à relire
#: monique_money/monique_mac_divert/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "I promise!"
msgstr "Promis !"

# Traduction IA – à relire
#: monique_money/monique_mac_divert/0/c-0/15/c-0/7
msgctxt "Monique"
msgid "Good. I look forward to our second date then."
msgstr "Bien. J'ai hâte de notre deuxième rendez-vous, alors."

# Traduction IA – à relire
#: monique_money/monique_mac_divert/0/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "You don't mean that we're budgeting for our next date..."
msgstr "Tu ne veux pas dire qu'on va faire le budget de notre prochain rendez-vous..."

# Traduction IA – à relire
#: monique_money/monique_mac_divert/0/c-0/15/c-0/15/c-0/7
msgctxt "Monique"
msgid "Does that not sound fun?"
msgstr "Cela ne semble-t-il pas amusant ?"

# Traduction IA – à relire
#: monique_money/monique_mac_divert/0/c-0/15/c-0/15/c-0/15
msgctxt "Monique"
msgid "Ooh! We could both start our own sheets and bring what we have!"
msgstr "Ooh ! Nous pourrions chacun commencer notre propre tableur et apporter ce que nous avons !"

# Traduction IA – à relire
#: monique_money/monique_mac_divert/0/c-0/15/c-0/15/c-0/23
msgctxt "Monique"
msgid "Think of it as a collaborative study date!"
msgstr "Vois ça comme un rendez-vous d'étude collaboratif !"

# Traduction IA – à relire
#: monique_money/monique_mac_divert/0/c-0/15/c-0/15/c-0/31/0/s/0
msgctxt "Choix"
msgid "Great..."
msgstr "Super..."

# Traduction IA – à relire
#: monique_money/monique_mac_divert/0/c-0/15/c-0/15/c-0/31/c-0/7
msgctxt "Monique"
msgid "Great!"
msgstr "Super !"

# Traduction IA – à relire
#: monique_money/monique_ed_final/0/14 monique_money/monique_friend_to_love_option/0/3
msgctxt "Monique"
msgid "And back we return..."
msgstr "Et nous voilà de retour..."

# Traduction IA – à relire
#: monique_money/monique_ed_final/0/22 monique_money/monique_friend_to_love_option/0/11
msgctxt "Monique"
msgid "This was so lovely."
msgstr "C'était si charmant."

# Traduction IA – à relire
#: monique_money/monique_ed_final/0/30
msgctxt "Monique"
msgid "Next time, I would love to take this further..."
msgstr "La prochaine fois, j'aimerais aller plus loin..."

# Traduction IA – à relire
#: monique_money/monique_ed_final/0/38/s/0 monique_money/monique_friend_to_love_option/0/27/s/0
msgctxt "Choix"
msgid "Any time. I find myself very attracted to you."
msgstr "Quand tu veux. Tu m'attires beaucoup."

# Traduction IA – à relire
#: monique_money/monique_ed_final/0/39/s/0
msgctxt "Choix"
msgid "I know you called that a date, but I hope we can be friends."
msgstr "Je sais que tu as appelé ça un rendez-vous, mais j'espère que nous pourrons être amis."

# Traduction IA – à relire
#: monique_money/monique_ed_final/0/c-0/7
msgctxt "Monique"
msgid "Interesting... I will have to take you up on that."
msgstr "Intéressant... Je vais devoir te prendre au mot."

# Traduction IA – à relire
#: monique_money/monique_ed_final/0/c-0/15 monique_money/monique_friend_to_love_option/0/c-0/15
msgctxt "Monique"
msgid "You gave me the courage to step out without a plan."
msgstr "Tu m'as donné le courage de sortir sans plan."

# Traduction IA – à relire
#: monique_money/monique_ed_final/0/c-0/23 monique_money/monique_friend_to_love_option/0/c-0/23
msgctxt "Monique"
msgid "And now I feel on top of the world!"
msgstr "Et maintenant je me sens au sommet du monde !"

# Traduction IA – à relire
#: monique_money/monique_ed_final/0/c-0/34 monique_money/monique_friend_to_love_option/0/c-0/34
msgctxt "Monique"
msgid "I would have never left if it were not for you and our talks."
msgstr "Je ne serais jamais partie sans toi et nos discussions."

# Traduction IA – à relire
#: monique_money/monique_ed_final/0/c-0/42 monique_money/monique_friend_to_love_option/0/c-0/42
msgctxt "Monique"
msgid "So once again, from the bottom of my heart..."
msgstr "Alors, une fois de plus, du fond du cœur..."

# Traduction IA – à relire
#: monique_money/monique_ed_final/0/c-0/50 monique_money/monique_friend_to_love_option/0/c-0/50
msgctxt "Monique"
msgid "...thank you!"
msgstr "...merci !"

# Traduction IA – à relire
#: monique_money/monique_ed_final/0/c-1/7 monique_money/monique_friend_to_love_option/0/c-1/7
msgctxt "Monique"
msgid "Oh. I see."
msgstr "Oh. Je vois."

# Traduction IA – à relire
#: monique_money/monique_ed_final/0/c-1/15 monique_money/monique_friend_to_love_option/0/c-1/15
msgctxt "Monique"
msgid "I apologize if I have made you uncomfortable."
msgstr "Je m'excuse si mon attitude a créé un malaise."

# Traduction IA – à relire
#: monique_money/monique_ed_final/0/c-1/23 monique_money/monique_friend_to_love_option/0/c-1/23
msgctxt "Monique"
msgid "Friends it is, then."
msgstr "Amis, alors."

# Traduction IA – à relire
#: monique_money/monique_friend_to_love_option/0/19
msgctxt "Monique"
msgid "We have spent so much time together... I feel quite smitten."
msgstr "Nous avons passé tant de temps ensemble... je suis plutôt éprise."

# Traduction IA – à relire
#: monique_money/monique_friend_to_love_option/0/28/s/0
msgctxt "Choix"
msgid "I know you called that a date, but I hope we can stay friends."
msgstr "Je sais que tu as appelé ça un rendez-vous, mais j'espère que nous resterons amis."

# Traduction IA – à relire
#: monique_money/monique_friend_to_love_option/0/c-0/7
msgctxt "Monique"
msgid "Interesting... I will have take you up on that."
msgstr "Intéressant... Je vais devoir te prendre au mot."

# Traduction IA – à relire
#: monique_money/money_lovereturn/0/0
msgctxt "Monique"
msgid "Hello again!"
msgstr "Te revoilà !"

# Traduction IA – à relire
#: monique_money/money_lovereturn/0/8
msgctxt "Monique"
msgid "I can't wait for our next venture."
msgstr "J'ai hâte de notre prochaine aventure."

# Traduction IA – à relire
#: monique_money/money_lovereturn/0/16
msgctxt "Monique"
msgid "I find myself losing count from thinking about it, hehe."
msgstr "Je perds le compte rien que d'y penser, hihi."

# Traduction IA – à relire
#: monique_money/money_lovereturn/0/24/s/0
msgctxt "Choix"
msgid "You can always count on me."
msgstr "Tu peux toujours compter sur moi."

# Traduction IA – à relire
#: monique_money/money_lovereturn/0/25/s/0 monique_money/money_friendshipreturn/0/17/s/0
msgctxt "Choix"
msgid "Monique, I'm ready to Realize you."
msgstr "Monique, je suis {{prêt|prête|prêt·e}} à te Réaliser."

# Traduction IA – à relire
#: monique_money/money_lovereturn/0/c-0/7
msgctxt "Monique"
msgid "Cute. Simple. Punny."
msgstr "Mignon. Simple. Calembour."

# Traduction IA – à relire
#: monique_money/money_lovereturn/0/c-0/15
msgctxt "Monique"
msgid "I love it."
msgstr "J'adore."

# Traduction IA – à relire
#: monique_money/money_lovereturn/0/c-0/23
msgctxt "Narrator"
msgid "She gives you a deep kiss full of precisely the right amount of passion before going off to balance your coinage."
msgstr "Elle vous donne un baiser profond, empli d'exactement la juste dose de passion, avant de s'éloigner pour équilibrer votre monnaie."

# Traduction IA – à relire
#: monique_money/monique_realize_join/0/0
msgctxt "Monique"
msgid "Do you really think I'm prepared for this?"
msgstr "Penses-tu vraiment que je sois prête pour cela ?"

# Traduction IA – à relire
#: monique_money/monique_realize_join/0/8
msgctxt "Monique"
msgid "I trust you implicitly. If you say so, I'm ready."
msgstr "Je te fais entièrement confiance. Si tu le dis, je suis prête."

# Traduction IA – à relire
#: monique_money/monique_realize_join/0/25/s/0
msgctxt "Choix"
msgid "Your trust is well-founded."
msgstr "Ta confiance est bien placée."

# Traduction IA – à relire
#: monique_money/monique_realize_join/0/26/s/0
msgctxt "Choix"
msgid "No, not just yet."
msgstr "Non, pas tout de suite."

# Traduction IA – à relire
#: monique_money/monique_realize_join/0/c-1/10
msgctxt "Monique"
msgid "...bye."
msgstr "...au revoir."

# Traduction IA – à relire
#: monique_money/monique_realize_return/0/0
msgctxt "Monique"
msgid "You have returned. I trust we are ready to commence?"
msgstr "Te revoilà. J'imagine que nous sommes prêts à commencer ?"

# Traduction IA – à relire
#: monique_money/monique_realize_return/0/17/s/0
msgctxt "Choix"
msgid "We are ready."
msgstr "Nous sommes prêts."

# Traduction IA – à relire
#: monique_money/monique_realize_return/0/18/s/0
msgctxt "Choix"
msgid "Not just yet."
msgstr "Pas tout de suite."

# Traduction IA – à relire
#: monique_money/monique_realize_return/0/c-1/10
msgctxt "Monique"
msgid "As happy as I am to have you visit me, please do not keep me waiting."
msgstr "Même si je suis heureuse de ta visite, ne me fais pas attendre, je te prie."

# Traduction IA – à relire
#: monique_money/monique_realize_begin/6/b/1
msgctxt "Skylar"
msgid "Our first Realization will be your own money... I'm a little intimidated by the cost!"
msgstr "Notre première Réalisation sera ton propre argent... Le coût m'intimide un peu !"

# Traduction IA – à relire
#: monique_money/monique_realize_begin/9
msgctxt "Skylar"
msgid "Monique, prepare to be liquid."
msgstr "Monique, prépare-toi à être liquide."

# Traduction IA – à relire
#: monique_money/monique_realize_begin/20
msgctxt "Narrator"
msgid "The spectral energy flows through your dateviators, and what was once merely your cash, becomes..."
msgstr "L'énergie spectrale traverse vos Dateviators, et ce qui n'était qu'un simple pécule devient..."

# Traduction IA – à relire
#: monique_money/monique_realized/0/3
msgctxt "Monique"
msgid "Fascinating. I am a human being now, and no longer confined to your house."
msgstr "Fascinant. Je suis maintenant un être humain, et plus confinée à ta maison."

# Traduction IA – à relire
#: monique_money/monique_realized/0/14
msgctxt "Monique"
msgid "The possibilities are endless."
msgstr "Les possibilités sont infinies."

# Traduction IA – à relire
#: monique_money/monique_realized/0/22
msgctxt "Monique"
msgid "But there is only one logical conclusion."
msgstr "Mais il n'y a qu'une seule conclusion logique."

# Traduction IA – à relire
#: monique_money/monique_realized/0/30/s/0
msgctxt "Choix"
msgid "What's that?"
msgstr "Laquelle ?"

# Traduction IA – à relire
#: monique_money/monique_realized/0/31/s/0
msgctxt "Choix"
msgid "Kiss meeeeeeeeeee"
msgstr "Embrasse-mooooooooi"

# Traduction IA – à relire
#: monique_money/monique_realized/0/c-1/7
msgctxt "Monique"
msgid "All right."
msgstr "Très bien."

# Traduction IA – à relire
#: monique_money/monique_realized/0/c-1/15
msgctxt "Narrator"
msgid "Her kiss is delightful, her perfume smells faintly of crisp dollar bills."
msgstr "Son baiser est délicieux, son parfum sent légèrement le billet tout neuf."

# Traduction IA – à relire
#: monique_money/monique_realized/0/c-1/26
msgctxt "Narrator"
msgid "Though you wonder if it's to cover the even more subtle smell of pocket lint..."
msgstr "Vous vous demandez toutefois s'il ne sert pas à masquer l'odeur, encore plus discrète, de la peluche de poche..."

# Traduction IA – à relire
#: monique_money/monique_realized/0/g-0/0
msgctxt "Monique"
msgid "I must circulate throughout the world."
msgstr "Je dois circuler à travers le monde."

# Traduction IA – à relire
#: monique_money/monique_realized/0/g-0/8
msgctxt "Monique"
msgid "Money needs not stagnate. It desires to cycle, to circulate, bring trade to all who need it."
msgstr "L'argent n'a pas à stagner. Il désire circuler, tourner, apporter l'échange à tous ceux qui en ont besoin."

# Traduction IA – à relire
#: monique_money/monique_realized/0/g-0/16
msgctxt "Monique"
msgid "Keeping your budget and accounts in line was to both satisfy my desire to have order and protect you."
msgstr "Tenir ton budget et tes comptes en ordre visait à la fois à satisfaire mon désir d'ordre et à te protéger."

# Traduction IA – à relire
#: monique_money/monique_realized/0/g-0/24
msgctxt "Monique"
msgid "But now that I can leave, what if I helped everyone else out there in your similar financial situation?"
msgstr "Mais maintenant que je peux sortir, et si j'aidais tous ceux qui se trouvent dans une situation financière semblable à la tienne ?"

# Traduction IA – à relire
#: monique_money/monique_realized/0/g-0/32/s/0
msgctxt "Choix"
msgid "What did you have in mind?"
msgstr "Qu'avais-tu en tête ?"

# Traduction IA – à relire
#: monique_money/monique_realized/0/g-0/33/s/0
msgctxt "Choix"
msgid "You ARE a lifesaver."
msgstr "Tu me sauves VRAIMENT la mise."

# Traduction IA – à relire
#: monique_money/monique_realized/0/g-1/0
msgctxt "Monique"
msgid "I have the perfect plan."
msgstr "J'ai le plan parfait."

# Traduction IA – à relire
#: monique_money/monique_realized/0/g-1/8
msgctxt "Monique"
msgid "The current standard of American wealth is faulty, prone to inflation, and doesn't accurately reflect the value of goods."
msgstr "L'étalon actuel de la richesse américaine est défaillant, sujet à l'inflation, et ne reflète pas fidèlement la valeur des biens."

# Traduction IA – à relire
#: monique_money/monique_realized/0/g-1/16
msgctxt "Monique"
msgid "There needs to be one true standard... the one that holds steady no matter what supply and demand might be."
msgstr "Il faut un seul véritable étalon... celui qui reste stable quelles que soient l'offre et la demande."

# Traduction IA – à relire
#: monique_money/monique_realized/0/g-1/24/s/0
msgctxt "Choix"
msgid "Gold?"
msgstr "L'or ?"

# Traduction IA – à relire
#: monique_money/monique_realized/0/g-1/25/s/0
msgctxt "Choix"
msgid "Computer things?"
msgstr "Des trucs informatiques ?"

# Traduction IA – à relire
#: monique_money/monique_realized/0/g-2/0
msgctxt "Monique"
msgid "Pizza."
msgstr "La pizza."

# Traduction IA – à relire
#: monique_money/monique_realized/0/g-2/8
msgctxt "Monique"
msgid "A slice of pizza must always be one dollar. Nothing more, nothing less."
msgstr "Une part de pizza doit toujours coûter un dollar. Ni plus, ni moins."

# Traduction IA – à relire
#: monique_money/monique_realized/0/g-2/16
msgctxt "Monique"
msgid "I will create the most saliently run pizza shop in this country - tracking prices, loans, and day-to-day expenditures while perfectly proportioning sauce."
msgstr "Je créerai la pizzeria la mieux tenue du pays : suivi des prix, des prêts et des dépenses quotidiennes, tout en dosant parfaitement la sauce."

# Traduction IA – à relire
#: monique_money/monique_realized/0/g-2/24
msgctxt "Monique"
msgid "And teaching the American people about fractions whenever they get a slice."
msgstr "Et en enseignant les fractions au peuple américain chaque fois qu'il prendra une part."

# Traduction IA – à relire
#: monique_money/monique_realized/0/g-2/32
msgctxt "Monique"
msgid "It would make for a full meal at an affordable price."
msgstr "Cela ferait un repas complet à un prix abordable."

# Traduction IA – à relire
#: monique_money/monique_realized/0/g-2/40
msgctxt "Monique"
msgid "Behind the scenes, there will be many receipts to organize and input into spreadsheets. Ingredient unit pricing, monthly revenue, overall facility usage costs."
msgstr "En coulisses, il y aura de nombreux reçus à classer et à saisir dans des tableurs. Prix unitaire des ingrédients, chiffre d'affaires mensuel, coûts globaux d'utilisation des locaux."

# Traduction IA – à relire
#: monique_money/monique_realized/0/g-2/48
msgctxt "Monique"
msgid "This is so very exciting!"
msgstr "C'est tellement excitant !"

# Traduction IA – à relire
#: monique_money/monique_realized/0/g-2/59
msgctxt "Narrator"
msgid "Monique walks to the front door, brimming with excitement at the endless possibilities. But then she stops. Waiting for something. For someone."
msgstr "Monique marche jusqu'à la porte d'entrée, débordante d'enthousiasme devant les possibilités infinies. Puis elle s'arrête. Elle attend quelque chose. Quelqu'un."

# Traduction IA – à relire
#: monique_money/monique_realized/0/g-2/67
msgctxt "Monique"
msgid "Uhm..."
msgstr "Euh..."

# Traduction IA – à relire
#: monique_money/monique_realized/0/g-2/75/s/0
msgctxt "Choix"
msgid "Are you going to be okay?"
msgstr "Tout ira bien ?"

# Traduction IA – à relire
#: monique_money/monique_realized/0/g-2/76/s/0
msgctxt "Choix"
msgid "What’s up?"
msgstr "Qu'est-ce qu'il y a ?"

# Traduction IA – à relire
#: monique_money/monique_realized/0/g-3/0
msgctxt "Monique"
msgid "Will you promise to see me?"
msgstr "Promets-tu de venir me voir ?"

# Traduction IA – à relire
#: monique_money/monique_realized/0/g-3/8/s/0
msgctxt "Choix"
msgid "Of course."
msgstr "Bien sûr."

# Traduction IA – à relire
#: monique_money/monique_realized/0/g-3/9/s/0
msgctxt "Choix"
msgid "Why wouldn’t I?"
msgstr "Pourquoi ne le ferais-je pas ?"

# Traduction IA – à relire
#: monique_money/monique_realized/0/g-4/0/b/1
msgctxt "Monique"
msgid "That makes me happy. You make me happy."
msgstr "Cela me rend heureuse. Tu me rends heureuse."

# Traduction IA – à relire
#: monique_money/monique_realized/0/g-4/0/b/9
msgctxt "Monique"
msgid "Before I go, shall we spend another night together?"
msgstr "Avant de partir, passerons-nous une nouvelle nuit ensemble ?"

# Traduction IA – à relire
#: monique_money/monique_realized/0/g-4/0/b/17
msgctxt "Narrator"
msgid "Monique takes your hand and leads you upstairs to your room. You shut the door and the two of you make an intimate and sensual memory."
msgstr "Monique vous prend la main et vous mène à l'étage, dans votre chambre. Vous fermez la porte et vous créez à deux un souvenir intime et sensuel."

# Traduction IA – à relire
#: monique_money/monique_realized/0/g-4/0/b/28
msgctxt "Narrator"
msgid "When it's all over you feel like a million bucks."
msgstr "Quand tout est fini, vous vous sentez comme un million de dollars."

# Traduction IA – à relire
#: monique_money/monique_realized/0/g-4/3
msgctxt "Monique"
msgid "I owe you everything. It is now time for me to start my new journey."
msgstr "Je te dois tout. Il est temps pour moi de commencer mon nouveau voyage."

# Traduction IA – à relire
#: monique_money/monique_realized/0/g-4/11
msgctxt "Narrator"
msgid "Monique gives you a warm hug before leaving. After some time, her new pizza shop opened - keeping true to her original promise of satisfying and affordable food."
msgstr "Monique vous serre chaleureusement dans ses bras avant de partir. Quelque temps plus tard, sa nouvelle pizzeria ouvre, fidèle à sa promesse initiale d'une nourriture satisfaisante et abordable."

# Traduction IA – à relire
#: monique_money/monique_realized/0/g-4/19
msgctxt "Narrator"
msgid "Her humble eatery began to grow after becoming a popular spot for delinquent gangs ditching school. You worried about Monique being in trouble, but word spread of how she set the delinquents straight and put them to work for her."
msgstr "Son humble gargote se met à prospérer après être devenue le repaire de bandes de délinquants séchant les cours. Vous vous inquiétiez pour Monique, mais la rumeur a vite couru : elle a remis les délinquants dans le droit chemin et les a mis au travail pour elle."

# Traduction IA – à relire
#: monique_money/monique_realized/0/g-4/27
msgctxt "Narrator"
msgid "And more importantly, single-handedly saved the economy. For Monique, the American dream is still alive... in every slice of one dollar pizza."
msgstr "Et, plus important encore, elle a sauvé l'économie à elle seule. Pour Monique, le rêve américain est toujours vivant... dans chaque part de pizza à un dollar."

# Traduction IA – à relire
#: monique_money/money_hatereturn/0/0
msgctxt "Monique"
msgid "I told you to leave me alone."
msgstr "Je t'avais dit de me laisser tranquille."

# Traduction IA – à relire
#: monique_money/money_hatereturn/0/8/s/0
msgctxt "Choix"
msgid "Damn."
msgstr "Zut."

# Traduction IA – à relire
#: monique_money/money_hatereturn/0/9/s/0
msgctxt "Choix"
msgid "You have no inherent value, Monique. (USE SMARTS CANDY)"
msgstr "Tu n'as aucune valeur intrinsèque, Monique. (UTILISER UN BONBON DE SAVOIR)"

# Traduction IA – à relire
#: monique_money/money_hatereturn/0/c-0/7
msgctxt "Monique"
msgid "Go away! I'm fresh out of money for you!"
msgstr "Va-t'en ! Je n'ai plus un sou pour toi !"

# Traduction IA – à relire
#: monique_money/money_hatereturn/0/c-1/7
msgctxt "Monique"
msgid "What - is this the 'negging' that Sophia has told me so much about?"
msgstr "Quoi, c'est cela, le « négging » dont Sophia m'a tant parlé ?"

# Traduction IA – à relire
#: monique_money/money_hatereturn/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "It's just that without me to circulate you through the world, you're just stuck here."
msgstr "C'est juste que sans moi pour te faire circuler dans le monde, tu es coincée ici."

# Traduction IA – à relire
#: monique_money/money_hatereturn/0/c-1/15/c-0/7
msgctxt "Monique"
msgid "It is true. I do love trading."
msgstr "C'est vrai. J'adore les échanges."

# Traduction IA – à relire
#: monique_money/money_hatereturn/0/c-1/15/c-0/15
msgctxt "Monique"
msgid "Simply being a value in a box gives me no purpose."
msgstr "N'être qu'une valeur dans une boîte ne me donne aucun but."

# Traduction IA – à relire
#: monique_money/money_hatereturn/0/c-1/15/c-0/23
msgctxt "Monique"
msgid "So what are you saying? We are to be companionable?"
msgstr "Alors que dis-tu ? Devenons-nous compagnons ?"

# Traduction IA – à relire
#: monique_money/money_hatereturn/0/c-1/15/c-0/31/0/s/0
msgctxt "Choix"
msgid "I would like that, yes."
msgstr "J'aimerais bien, oui."

# Traduction IA – à relire
#: monique_money/money_hatereturn/0/c-1/15/c-0/31/c-0/7
msgctxt "Monique"
msgid "So it will be."
msgstr "Il en sera ainsi."

# Traduction IA – à relire
#: monique_money/monique_candy_return/0/0
msgctxt "Monique"
msgid "A friendship, yes. I await circulation."
msgstr "Une amitié, oui. J'attends de circuler."

# Traduction IA – à relire
#: monique_money/monique_candy_return/0/8/s/0
msgctxt "Choix"
msgid "Happy to help, Monique."
msgstr "Avec plaisir, Monique."

# Traduction IA – à relire
#: monique_money/monique_candy_return/0/9/s/0
msgctxt "Choix"
msgid "What would you say to the ultimate circulation - becoming Realized?"
msgstr "Que dirais-tu de la circulation ultime : être Réalisée ?"

# Traduction IA – à relire
#: monique_money/monique_candy_return/0/c-0/7 monique_money/money_friendshipreturn/0/c-0/31
msgctxt "Narrator"
msgid "She gives you a pert handshake before going off to continue balancing your assets."
msgstr "Elle vous serre vivement la main avant de repartir continuer à équilibrer vos avoirs."

# Traduction IA – à relire
#: monique_money/money_friendshipreturn/0/0
msgctxt "Monique"
msgid "Greetings!"
msgstr "Salutations !"

# Traduction IA – à relire
#: monique_money/money_friendshipreturn/0/8
msgctxt "Monique"
msgid "What can I help you with today?"
msgstr "En quoi puis-je t'aider aujourd'hui ?"

# Traduction IA – à relire
#: monique_money/money_friendshipreturn/0/16/s/0
msgctxt "Choix"
msgid "Well, my cash seems a little low."
msgstr "Eh bien, mon argent semble un peu bas."

# Traduction IA – à relire
#: monique_money/money_friendshipreturn/0/c-0/7
msgctxt "Monique"
msgid "I see! Luckily, I have prepared for this..."
msgstr "Je vois ! Heureusement, je m'y étais préparée..."

# Traduction IA – à relire
#: monique_money/money_friendshipreturn/0/c-0/15
msgctxt "Monique"
msgid "I have now multiplied somewhat."
msgstr "Je me suis maintenant quelque peu multipliée."

# Traduction IA – à relire
#: monique_money/money_friendshipreturn/0/c-0/23
msgctxt "Monique"
msgid "Come by again if another crisis arises. Or if you would like to say hello."
msgstr "Repasse si une autre crise survient. Ou si tu souhaites simplement dire bonjour."
