msgid "Computer"
msgstr "Ordinateur"

# Traduction IA – à relire
#: DateADex/mac_dex_entry/13
msgctxt "Tag Date-A-Dex"
msgid "Bits, Bytes, Scenic Cities in New Jersey"
msgstr "Les bits, les octets, les villes pittoresques du New Jersey"

# Traduction IA – à relire
