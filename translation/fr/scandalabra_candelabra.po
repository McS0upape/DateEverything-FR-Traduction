msgctxt "Choix"
msgid "Not right now."
msgstr ""

#: scandalabra_candelabra/scandalabra_friend_return_2/0/39/s/0
msgctxt "Choix"
msgid "All right!"
msgstr ""

#: scandalabra_candelabra/scandalabra_friend_return_2/0/40/s/0
msgctxt "Choix"
msgid "I don't want to do this anymore..."
msgstr ""

#: scandalabra_candelabra/scandalabra_friend_return_2/0/41/s/0 scandalabra_candelabra/kiss_quest/0/61/s/0 scandalabra_candelabra/kiss_quest_nokiss/0/35/s/0 scandalabra_candelabra/kiss_quest_return_success/0/56/s/0 scandalabra_candelabra/kiss_quest_return_nokiss/0/34/s/0 scandalabra_candelabra/kiss_quest_return_2/0/g-0/60/s/0 scandalabra_candelabra/kiss_quest_return_3_nokiss/0/30/s/0
