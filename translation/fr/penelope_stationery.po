# Traduction IA – à relire
#: penelope_stationery/1 penelope_stationery/bulletin_sorter/4 penelope_stationery/penelope_sorter/4
msgctxt "Tag Nom d'objet (MAJUSCULES)"
msgid "OFFICE SUPPLIES"
msgstr "FOURNITURES DE BUREAU"

# Traduction IA – à relire
#: penelope_stationery/PenelopeRecruit/0/0
msgctxt "Penelope"
msgid "Oh!"
msgstr "Oh !"

# Traduction IA – à relire
#: penelope_stationery/PenelopeRecruit/0/8
msgctxt "Penelope"
msgid "You look like you need something."
msgstr "T'as l'air d'avoir besoin de quelque chose."

# Traduction IA – à relire
#: penelope_stationery/PenelopeRecruit/0/16
msgctxt "Penelope"
msgid "And I've got plenty of things!"
msgstr "Et moi, j'ai plein de choses !"

# Traduction IA – à relire
#: penelope_stationery/PenelopeRecruit/0/24/s/0
msgctxt "Choix"
msgid "It's actually Stella that needs something."
msgstr "En fait, c'est Stella qui a besoin de quelque chose."

# Traduction IA – à relire
#: penelope_stationery/PenelopeRecruit/0/g-0/0
msgctxt "Penelope"
msgid "Oh..."
msgstr "Oh..."

# Traduction IA – à relire
#: penelope_stationery/PenelopeRecruit/0/g-0/8
msgctxt "Penelope"
msgid "Is it that \"business\" thing?"
msgstr "C'est son truc de « business » ?"

# Traduction IA – à relire
#: penelope_stationery/PenelopeRecruit/0/g-0/16/s/0
msgctxt "Choix"
msgid "Yeah..."
msgstr "Ouais..."

# Traduction IA – à relire
#: penelope_stationery/PenelopeRecruit/0/g-0/17/s/0
msgctxt "Choix"
msgid "It's an opportunity!"
msgstr "C'est une opportunité !"

# Traduction IA – à relire
#: penelope_stationery/PenelopeRecruit/0/g-0/c-1/7
msgctxt "Penelope"
msgid "You noticed I said that in quotes, right?"
msgstr "Tu as remarqué que je disais ça entre guillemets, hein ?"

# Traduction IA – à relire
#: penelope_stationery/PenelopeRecruit/0/g-0/c-2/7
msgctxt "Penelope"
msgid "Right! An opportunity for her, not me."
msgstr "Bien sûr ! Une opportunité pour elle, pas pour moi."

# Traduction IA – à relire
#: penelope_stationery/PenelopeRecruit/0/g-1/8
msgctxt "Penelope"
msgid "I mean I'll help regardless."
msgstr "Enfin, je l'aiderai quand même."

# Traduction IA – à relire
#: penelope_stationery/PenelopeRecruit/0/g-1/16
msgctxt "Penelope"
msgid "She always looks so sad."
msgstr "Elle a toujours l'air tellement triste."

# Traduction IA – à relire
#: penelope_stationery/PenelopeRecruit/0/g-1/24
msgctxt "Penelope"
msgid "It's nice to see her trying something."
msgstr "Ça fait plaisir de la voir essayer quelque chose."

# Traduction IA – à relire
#: penelope_stationery/PenelopeRecruit/0/g-1/40
msgctxt "Penelope"
msgid "Anyway. I'm a supporter of all things that need support. Sign me up."
msgstr "Bref. Je soutiens tout ce qui a besoin de soutien. Inscris-moi."

# Traduction IA – à relire
#: penelope_stationery/PenelopeRecruit/0/g-1/48/b/1
msgctxt "Penelope"
msgid "For her. Not you."
msgstr "Pour elle. Pas pour toi."

# Traduction IA – à relire
#: penelope_stationery/penelope_jerry_quest/0/10
msgctxt "Penelope"
msgid "Hello!"
msgstr "Salut !"

# Traduction IA – à relire
#: penelope_stationery/penelope_jerry_quest/0/18/s/0
msgctxt "Choix"
msgid "I've got these old thumbtacks for you."
msgstr "J'ai ces vieilles punaises pour toi."

# Traduction IA – à relire
#: penelope_stationery/penelope_jerry_quest/0/c-0/10
msgctxt "Penelope"
msgid "My little tackies! Come here you prickly lil' things."
msgstr "Mes petites punaises ! Venez là, petites choses piquantes."

# Traduction IA – à relire
#: penelope_stationery/penelope_jerry_quest/0/c-0/21
msgctxt "Penelope"
msgid "Give Jerry my best, would you?"
msgstr "Transmets mes amitiés à Jerry, tu veux ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_jerry_quest/0/c-0/29
msgctxt "Penelope"
msgid "I know this is tough for him."
msgstr "Je sais que c'est dur pour lui."

# Traduction IA – à relire
#: penelope_stationery/penelope_jerrymission_penelopehatesplayer/0/15/s/0
msgctxt "Choix"
msgid "Hey Penelope, just returning some missing thumbtacks."
msgstr "Salut Penelope, je te rends juste quelques punaises égarées."

# Traduction IA – à relire
#: penelope_stationery/penelope_jerrymission_penelopehatesplayer/0/c-0/7
msgctxt "Penelope"
msgid "Anything else?"
msgstr "Autre chose ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_jerrymission_penelopehatesplayer/0/c-0/18/0/s/0
msgctxt "Choix"
msgid "Nope that was it."
msgstr "Non, c'était tout."

# Traduction IA – à relire
#: penelope_stationery/penelope_jerrymission_penelopehatesplayer/0/c-0/18/c-0/7
msgctxt "Penelope"
msgid "Goodbye then."
msgstr "Alors au revoir."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/6
msgctxt "Narrator"
msgid "The frazzled figure standing before you has the sort of overworked and underpaid coworker energy you've not seen since you started working from home."
msgstr "La silhouette survoltée qui se tient devant vous dégage cette énergie de collègue surmené et sous-payé que vous n'aviez plus croisée depuis que vous travaillez à domicile."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/14
msgctxt "Narrator"
msgid "She startles when she sees you looking at her, dropping a number of office supplies clutched in her arms."
msgstr "Elle sursaute en vous voyant la regarder et laisse tomber plusieurs fournitures de bureau qu'elle serrait dans ses bras."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/22
msgctxt "Penelope"
msgid "Oh my god... you can see me."
msgstr "Oh mon dieu... tu peux me voir."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/30
msgctxt "Penelope"
msgid "You can see me!"
msgstr "Tu peux me voir !"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/38
msgctxt "Penelope"
msgid "Oh my god, you've walked by me for so long without looking at me... !"
msgstr "Oh mon dieu, tu m'as croisée pendant si longtemps sans me regarder... !"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/49
msgctxt "Penelope"
msgid "Office Romance Magazine was right... maybe this really is my year!"
msgstr "Romance de Bureau Magazine avait raison... c'est peut-être vraiment mon année !"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/57/s/0
msgctxt "Choix"
msgid "'Office Romance Magazine?'"
msgstr "« Romance de Bureau Magazine » ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/58/s/0
msgctxt "Choix"
msgid "I'm sorry... what?"
msgstr "Pardon... quoi ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/59/s/0
msgctxt "Choix"
msgid "Uh, sorry... guess I didn't notice you before."
msgstr "Euh, {{désolé|désolée|désolé·e}}... je crois que je ne t'avais pas remarquée avant."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/c-0/7
msgctxt "Penelope"
msgid "Oh yeah! It's the leading publication on office romances for office supplies!"
msgstr "Ouais ! C'est la publication de référence sur les romances de bureau pour fournitures de bureau !"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/c-1/7
msgctxt "Penelope"
msgid "Office Romance Magazine! The number one name in Office Supply Romantic Periodicals!"
msgstr "Romance de Bureau Magazine ! Le numéro un des périodiques romantiques pour fournitures de bureau !"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/c-2/7
msgctxt "Penelope"
msgid "Office Romance Magazine said you'd say that too... it's all happening!"
msgstr "Romance de Bureau Magazine disait que tu dirais ça aussi... tout concorde !"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-0/0
msgctxt "Penelope"
msgid "It said my love life was TOTALLY gonna be on fire this year!"
msgstr "Il disait que ma vie amoureuse allait être TOTALEMENT en feu cette année !"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-0/11
msgctxt "Penelope"
msgid "And fires, as we all know, are a very good thing."
msgstr "Et le feu, comme chacun sait, c'est une très bonne chose."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-0/19
msgctxt "Penelope"
msgid "Oh gosh listen to me babbling at you."
msgstr "Oh là là, écoute-moi te raconter ma vie."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-0/27
msgctxt "Penelope"
msgid "You don't even know my name!"
msgstr "Tu ne connais même pas mon nom !"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-0/35/s/0
msgctxt "Choix"
msgid "I don't need to know it."
msgstr "Je n'ai pas besoin de le connaître."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-0/36/s/0
msgctxt "Choix"
msgid "Probably a good place to start."
msgstr "Ce serait sans doute un bon début."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-0/37/s/0
msgctxt "Choix"
msgid "Go on then."
msgstr "Vas-y, alors."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-0/c-3/7
msgctxt "Penelope"
msgid "What?! I'm gonna pretend I didn't hear that."
msgstr "Quoi ?! Je vais faire comme si je n'avais rien entendu."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-0/c-4/7
msgctxt "Penelope"
msgid "Yes, yes!"
msgstr "Oui, oui !"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-0/c-5/7
msgctxt "Penelope"
msgid "Oh, I'm gettin' to it! Uh..."
msgstr "Oh, j'y viens ! Euh..."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-1/0
msgctxt "Penelope"
msgid "I'm Penelope, and I'm your office supplies!"
msgstr "Je suis Penelope, et je suis tes fournitures de bureau !"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-1/14
msgctxt "Penelope"
msgid "Which boy, let me tell ya—you sure haven't used those in a while!"
msgstr "Et ben dis donc, tu ne nous as pas utilisées depuis un bail !"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-1/22/s/0
msgctxt "Choix"
msgid "Well... everything's online now..."
msgstr "Eh bien... tout se fait en ligne maintenant..."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-1/23/s/0
msgctxt "Choix"
msgid "Sorry?"
msgstr "Pardon ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-1/24/s/0
msgctxt "Choix"
msgid "I dunno what you want me to say about that."
msgstr "Je ne sais pas trop quoi te répondre."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-1/c-6/7
msgctxt "Penelope"
msgid "Yeah, yeah, yeah, yeah, but...!"
msgstr "Ouais, ouais, ouais, ouais, mais... !"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-1/c-7/7
msgctxt "Penelope"
msgid "Thank you!"
msgstr "Merci !"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-1/c-8/7
msgctxt "Penelope"
msgid "Well jeeze, a sorry, or an \"I miss you\" might be nice!"
msgstr "Ben dis donc, un « désolé » ou un « tu me manques » ferait plaisir !"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-2/0
msgctxt "Penelope"
msgid "It's great that you're here now though, cause now you can bear witness..."
msgstr "Mais c'est super que tu sois là maintenant, parce que tu vas pouvoir être témoin..."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-2/8/s/0
msgctxt "Choix"
msgid "To what?"
msgstr "De quoi ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-3/0
msgctxt "Penelope"
msgid "TO THE RESURRECTION OF PENELOPE OFFICE SUPPLIES!"
msgstr "DE LA RÉSURRECTION DE PENELOPE ET DE SES FOURNITURES DE BUREAU !"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-3/14
msgctxt "Penelope"
msgid "So what if no one's using me like they used to?"
msgstr "Et alors si plus personne ne m'utilise comme avant ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-3/22
msgctxt "Penelope"
msgid "I'm not dead yet!"
msgstr "Je ne suis pas encore morte !"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-3/33/s/0
msgctxt "Choix"
msgid "You're so right queen."
msgstr "Tellement vrai, ma reine."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-3/34/s/0
msgctxt "Choix"
msgid "You've got one foot in the grave."
msgstr "Tu as un pied dans la tombe."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-3/35/s/0
msgctxt "Choix"
msgid "You're too cute to be single."
msgstr "Tu es trop mignonne pour être célibataire."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-3/c-11/7
msgctxt "Penelope"
msgid "YEAH!"
msgstr "OUAIS !"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-3/c-12/7
msgctxt "Penelope"
msgid "NO!! NO NEGATIVITY ALLOWED!"
msgstr "NON !! PAS DE NÉGATIVITÉ AUTORISÉE !"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-3/c-13/7
msgctxt "Penelope"
msgid "HELL YEAH!"
msgstr "OUAIS, BORDEL !"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-3/c-13/15
msgctxt "Penelope"
msgid "Wait... what?"
msgstr "Attends... quoi ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-3/c-13/23
msgctxt "Narrator"
msgid "It takes a few seconds for your compliment to register with Penelope—a blush overtakes her face from chin to forehead, but she quickly shakes it off."
msgstr "Il faut quelques secondes à Penelope pour assimiler votre compliment. Une rougeur lui envahit le visage du menton jusqu'au front, mais elle se ressaisit vite."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-3/c-13/31
msgctxt "Penelope"
msgid "That was a real funny joke you just said! HAHAHA!"
msgstr "Elle était vraiment drôle, ta blague ! HAHAHA !"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-4/0
msgctxt "Penelope"
msgid "Anyway your daily motivational office quotes calendar put it best."
msgstr "Enfin bref, le calendrier de citations motivantes du jour l'a dit mieux que personne."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-4/8
msgctxt "Penelope"
msgid "\"Your most important work is always ahead of you, never behind you.\" - Stephen Stovey"
msgstr "« Votre travail le plus important est toujours devant vous, jamais derrière vous. » — Stephen Stovey"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-4/16
msgctxt "Penelope"
msgid "Now what do you think that means?"
msgstr "Alors, d'après toi, ça veut dire quoi ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-4/24/s/0
msgctxt "Choix"
msgid "Lead with your best asset—dat ass."
msgstr "Présente ton meilleur atout : ton derrière."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-4/25/s/0
msgctxt "Choix"
msgid "Time to look to a brighter tomorrow."
msgstr "Il est temps de regarder vers un lendemain meilleur."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-4/26/s/0
msgctxt "Choix"
msgid "I truly don't care."
msgstr "Je m'en fiche complètement."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-4/c-14/7
msgctxt "Penelope"
msgid "EXACTLY!"
msgstr "EXACTEMENT !"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-4/c-15/7
msgctxt "Penelope"
msgid "Oh. Well... I guess that too... yeah, mmmhm."
msgstr "Oh. Eh bien... je suppose que ça aussi... ouais, mmmhm."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-4/c-15/15
msgctxt "Penelope"
msgid "But I'm pretty sure this is saying I've got an ass that won't quit."
msgstr "Mais je crois surtout que ça dit que j'ai un derrière qui ne lâche rien."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-4/c-15/23
msgctxt "Penelope"
msgid "And it's time I make sure everybody knows it."
msgstr "Et qu'il est temps que tout le monde le sache."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-4/c-16/7
msgctxt "Penelope"
msgid "Well neither do I!"
msgstr "Moi non plus !"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-4/c-16/15
msgctxt "Penelope"
msgid "I'm not bothered at all!"
msgstr "Ça ne me dérange pas du tout !"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-5/0
msgctxt "Penelope"
msgid "Anyway to that end I've got a hot hot date with a crosstrainer."
msgstr "Bref, dans ce but, j'ai un rencard torride avec un vélo elliptique."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-5/12
msgctxt "Penelope"
msgid "You got any advice for me?"
msgstr "T'aurais des conseils pour moi ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-5/20/s/0
msgctxt "Choix"
msgid "Just be yourself."
msgstr "Sois juste toi-même."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-5/21/s/0
msgctxt "Choix"
msgid "Match his energy at all times."
msgstr "Adapte-toi à son énergie en toutes circonstances."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-5/22/s/0
msgctxt "Choix"
msgid "No."
msgstr "Non."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-5/c-17/7
msgctxt "Penelope"
msgid "Hmm... a little boring, but alright."
msgstr "Hmm... un peu ennuyeux, mais d'accord."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-5/c-17/21 penelope_stationery/penelope_intro/0/g-5/c-18/21 penelope_stationery/penelope_intro/0/g-5/c-19/21
msgctxt "Kristof"
msgid "I HAVE ARRIVED TO DO BATTLE."
msgstr "JE SUIS VENU LIVRER BATAILLE."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-5/c-17/38 penelope_stationery/penelope_intro/0/g-5/c-19/38
msgctxt "Penelope"
msgid "Oh there he is! I assume he means date."
msgstr "Oh, le voilà ! Je suppose qu'il veut dire rencard."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-5/c-17/46 penelope_stationery/penelope_intro/0/g-5/c-19/46
msgctxt "Kristof"
msgid "I MEANT JUST WHAT I SAID! PREPARE YOURSELF!"
msgstr "JE VOULAIS DIRE EXACTEMENT CE QUE J'AI DIT ! PRÉPARE-TOI !"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-5/c-17/57
msgctxt "Penelope"
msgid "Wow right! Love it!"
msgstr "Ouah, trop bien ! J'adore !"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-5/c-17/65
msgctxt "Penelope"
msgid "See you later!"
msgstr "À plus tard !"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-5/c-18/7
msgctxt "Penelope"
msgid "Okay, cool cool cool cool, cool. I can do that."
msgstr "Okay, cool cool cool cool, cool. Je peux faire ça."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-5/c-18/38
msgctxt "Penelope"
msgid "Uh... I LOVE THAT! LET'S FUCKING FIGHT!"
msgstr "Euh... J'ADORE ÇA ! ON VA SE BATTRE, PUTAIN !"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-5/c-18/49 penelope_stationery/penelope_intro/0/g-5/c-19/73
msgctxt "Kristof"
msgid "TO ARMS!"
msgstr "AUX ARMES !"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-5/c-18/57
msgctxt "Penelope"
msgid "THIS IS GREAT! I'M NOT SCARED AT ALL!"
msgstr "C'EST GÉNIAL ! JE N'AI PAS PEUR DU TOUT !"

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-5/c-18/71 penelope_stationery/penelope_intro/0/g-5/c-19/98 penelope_stationery/penelope_third_encounter/0/g-4/8
msgctxt "Narrator"
msgid "You leave them to it..."
msgstr "Vous les laissez à leurs affaires..."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-5/c-19/7
msgctxt "Penelope"
msgid "Well jeeze, alright."
msgstr "Eh ben dis donc, d'accord."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-5/c-19/57
msgctxt "Penelope"
msgid "Hey so like if I don't come back from this..."
msgstr "Dis, au cas où je ne reviendrais pas de là..."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-5/c-19/65
msgctxt "Penelope"
msgid "Tell everyone I died young and beautiful."
msgstr "Dis à tout le monde que je suis morte jeune et belle."

# Traduction IA – à relire
#: penelope_stationery/penelope_intro/0/g-5/c-19/84
msgctxt "Penelope"
msgid "AAAGH!"
msgstr "AAAAH !"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/6
msgctxt "Penelope"
msgid "\"The secret of getting ahead is getting started.\" - Marker Twain."
msgstr "« Le secret pour aller de l'avant, c'est de commencer. » — Marker Twain."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/14/s/0
msgctxt "Choix"
msgid "What?"
msgstr "Quoi ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/15/s/0
msgctxt "Choix"
msgid "Another 'Quote of the Day'?"
msgstr "Encore une « Citation du jour » ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/16/s/0
msgctxt "Choix"
msgid "Wow yeah totally."
msgstr "Ouah, ouais, tout à fait."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/c-0/7
msgctxt "Penelope"
msgid "That's your quote of the day calendar with the gems again!"
msgstr "C'est encore le calendrier de citations du jour qui balance des perles !"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/c-1/7
msgctxt "Penelope"
msgid "You better believe it!"
msgstr "Tu peux le croire !"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/c-2/7
msgctxt "Penelope"
msgid "I know right?"
msgstr "Je sais, hein ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-0/0
msgctxt "Penelope"
msgid "So the date with Kris was awful. A disaster even."
msgstr "Donc, le rencard avec Kris a été affreux. Un désastre, même."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-0/8/s/0
msgctxt "Choix"
msgid "Tell me about it..."
msgstr "Raconte-moi ça..."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-0/9/s/0
msgctxt "Choix"
msgid "Skip to the point."
msgstr "Va droit au but."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-0/c-3/7
msgctxt "Penelope"
msgid "He spent the night chasing me around with what looked like an axe but was probably just a spare ski or something."
msgstr "Il a passé la soirée à me courir après avec un truc qui ressemblait à une hache mais qui était probablement juste un ski de rechange ou je ne sais quoi."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-0/c-3/15
msgctxt "Penelope"
msgid "At the end of it he asked if he could see me again, but..."
msgstr "À la fin, il m'a demandé s'il pouvait me revoir, mais..."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-0/c-3/23
msgctxt "Penelope"
msgid "Instead of kissing me..."
msgstr "Au lieu de m'embrasser..."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-0/c-3/31
msgctxt "Penelope"
msgid "He leaned in and whispered that I had the calves of a malnourished mountain goat."
msgstr "Il s'est penché et m'a chuchoté que j'avais des mollets de chèvre de montagne sous-alimentée."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-0/c-3/39
msgctxt "Penelope"
msgid "And that he found my scrawniness appealing because of the potential I had..."
msgstr "Et qu'il trouvait ma maigreur séduisante à cause de mon potentiel..."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-0/c-3/47
msgctxt "Penelope"
msgid "If I would just commit to FITNESS!"
msgstr "Si seulement je m'engageais dans le FITNESS !"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-0/c-3/55
msgctxt "Penelope"
msgid "So anyway I'm thinking maybe masculinity is like, not my thing!"
msgstr "Alors bref, je me dis que la masculinité, c'est peut-être pas mon truc !"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-0/c-3/63
msgctxt "Penelope"
msgid "And that's okay!"
msgstr "Et c'est très bien comme ça !"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-1/0
msgctxt "Penelope"
msgid "I've got a date lined up with a real pretty shelf that's just as hot and strong as Kris..."
msgstr "J'ai un rencard de prévu avec une très jolie étagère, aussi canon et costaude que Kris..."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-1/8
msgctxt "Penelope"
msgid "And I'm like 90% sure she won't try to kill me."
msgstr "Et je suis sûre à 90 % qu'elle n'essaiera pas de me tuer."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-1/16/s/0
msgctxt "Choix"
msgid "Hey that's great."
msgstr "Eh, c'est super."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-1/17/s/0
msgctxt "Choix"
msgid "You should date me instead."
msgstr "Tu devrais sortir avec moi, plutôt."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-1/18/s/0
msgctxt "Choix"
msgid "I truly do not care about your love life."
msgstr "Ta vie amoureuse m'est vraiment complètement égale."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-1/c-5/13
msgctxt "Penelope"
msgid "Thanks! I think so too."
msgstr "Merci ! Je pense aussi."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-1/c-6/13
msgctxt "Penelope"
msgid "WOW! You keep saying things like that I might just get the wrong idea!"
msgstr "OUAH ! Si tu continues à dire des trucs comme ça, je vais finir par me faire des idées !"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-1/c-6/21
msgctxt "Penelope"
msgid "Stop teasing me you big old kidder! HAHAHA!"
msgstr "Arrête de me taquiner, toi et tes blagues ! HAHAHA !"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-1/c-7/13
msgctxt "Penelope"
msgid "I don't either! I'm so above all this!"
msgstr "Moi non plus ! Je suis tellement au-dessus de tout ça !"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-1/c-7/21
msgctxt "Penelope"
msgid "Look at us, two cool people who don't care about things!"
msgstr "Regarde-nous, deux personnes cool qui se fichent de tout !"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-1/c-7/32
msgctxt "Penelope"
msgid "But like, let's pretend for a moment we both care about my love life."
msgstr "Mais faisons semblant, un instant, qu'on se soucie toutes les deux de ma vie amoureuse."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-2/0
msgctxt "Penelope"
msgid "You got any tips for this date?"
msgstr "T'aurais des conseils pour ce rencard ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-2/8
msgctxt "Penelope"
msgid "Anything to keep in mind for going out with someone who could totally crush me with a pinkie..."
msgstr "Quelque chose à garder en tête quand on sort avec quelqu'un qui pourrait m'écraser avec le petit doigt..."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-2/16
msgctxt "Penelope"
msgid "But is also feminine and fine?"
msgstr "Mais qui est aussi féminine et canon ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-2/24/s/0
msgctxt "Choix"
msgid "Masc or fem, just be yourself."
msgstr "Masc ou fem, sois juste toi-même."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-2/25/s/0
msgctxt "Choix"
msgid "Feminine and fine? Sounds like you're describing yourself."
msgstr "Féminine et canon ? On dirait que tu te décris."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-2/26/s/0
msgctxt "Choix"
msgid "Try not to be the disaster you are."
msgstr "Essaie de ne pas être le désastre que tu es."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-2/c-8/13
msgctxt "Penelope"
msgid "Sure... okay... I can do that."
msgstr "Bien sûr... d'accord... je peux faire ça."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-2/c-8/21
msgctxt "Penelope"
msgid "I'm gonna remember today's quote too."
msgstr "Je vais retenir la citation du jour aussi."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-2/c-8/29
msgctxt "Penelope"
msgid "\"If you want to go fast, go alone. If you want to go far, go together.\" — African Proverb"
msgstr "« Si tu veux aller vite, marche seul. Si tu veux aller loin, marchons ensemble. » — Proverbe africain"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-2/c-8/37
msgctxt "Penelope"
msgid "Setting aside the whole problematic and most assuredly fake 'African Proverb' attribution..."
msgstr "Mettons de côté l'attribution problématique et très certainement bidon à un « proverbe africain »..."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-2/c-8/45
msgctxt "Penelope"
msgid "Words of wisdom man! That calendar knows what's what!"
msgstr "Quelle sagesse ! Ce calendrier sait de quoi il parle !"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-2/c-9/13
msgctxt "Penelope"
msgid "WOW! YEAH RIGHT!"
msgstr "OUAH ! C'EST ÇA, OUI !"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-2/c-9/24
msgctxt "Penelope"
msgid "You really gotta start watching what you say, you're gonna make me think the wrong things!"
msgstr "Faut vraiment que tu fasses gaffe à ce que tu dis, tu vas me faire penser n'importe quoi !"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-2/c-9/32
msgctxt "Penelope"
msgid "\"Try not to become a man of success but rather try to become a man of value.\" — Albert Finestein..."
msgstr "« Ne cherchez pas à devenir un homme qui réussit, mais plutôt un homme de valeur. » — Albert Finestein..."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-2/c-9/40
msgctxt "Penelope"
msgid "Okay... calm. Cool."
msgstr "Okay... calme. Cool."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-2/c-9/48
msgctxt "Penelope"
msgid "You got this Penelope."
msgstr "Tu gères, Penelope."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-2/c-9/56
msgctxt "Penelope"
msgid "Shout out to that motivational office quotes calendar man!"
msgstr "Un grand merci à ce calendrier de citations motivantes !"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-2/c-9/64
msgctxt "Penelope"
msgid "It always knows just what to say!"
msgstr "Il sait toujours quoi dire !"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-2/c-10/13
msgctxt "Penelope"
msgid "HOW EXACTLY DOES ONE NOT BE A DISASTER?"
msgstr "COMMENT ON FAIT POUR NE PAS ÊTRE UN DÉSASTRE ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-2/c-10/21
msgctxt "Penelope"
msgid "CAN YOU JUST NOT DO THAT?"
msgstr "EST-CE QU'ON PEUT JUSTE NE PAS LE FAIRE ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-2/c-10/29
msgctxt "Penelope"
msgid "DO YOU JUST WAKE UP AND DECIDE TO BE SUCCESSFUL?"
msgstr "ON SE RÉVEILLE ET ON DÉCIDE DE RÉUSSIR, C'EST ÇA ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-2/c-10/37
msgctxt "Penelope"
msgid "I WILL TRY HARDER!"
msgstr "JE VAIS ESSAYER DE MIEUX FAIRE !"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-2/c-10/51
msgctxt "Penelope"
msgid "Okay Penelope... calm down... remember your breathing..."
msgstr "Okay Penelope... calme-toi... pense à ta respiration..."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-2/c-10/59
msgctxt "Penelope"
msgid "\"A successful man is the one who can lay a firm foundation with the bricks others have thrown at him.\" — David Drinkley"
msgstr "« Un homme qui réussit est celui qui sait poser des fondations solides avec les briques que les autres lui ont jetées. » — David Drinkley"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-2/c-10/64
msgctxt "Penelope"
msgid "Whew. Thanks again, Motivational Office Quote of the Day!"
msgstr "Ouf. Merci encore, Citation Motivante de Bureau du Jour !"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-2/c-10/72
msgctxt "Penelope"
msgid "I don't know where I'd be without ya."
msgstr "Je ne sais pas où j'en serais sans toi."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/0
msgctxt "Penelope"
msgid "Oh my god, I think that's her now."
msgstr "Oh mon dieu, je crois que c'est elle."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/14
msgctxt "Shelley"
msgid "HEY HEY HEY!"
msgstr "HÉ HÉ HÉ !"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/25/b/1
msgctxt "Narrator"
msgid "A muscle-bound woman with the greatest set of abs you've ever seen bounds into the room, lifting Penelope up into the air and tossing her like a beach ball."
msgstr "Une femme aux muscles saillants, dotée des plus beaux abdos que vous ayez jamais vus, bondit dans la pièce, soulève Penelope dans les airs et la fait rebondir comme un ballon de plage."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/26/b/1
msgctxt "Narrator"
msgid "Shelley bounds into the room, lifting Penelope up into the air and tossing her like a beach ball."
msgstr "Shelley bondit dans la pièce, soulève Penelope dans les airs et la fait rebondir comme un ballon de plage."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/29
msgctxt "Penelope"
msgid "AHHHH!"
msgstr "AHHHH !"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/40
msgctxt "Shelley"
msgid "Oh, I hope you're ready to get like totally swept off your feet!"
msgstr "Oh, j'espère que t'es prête à être TOTALEMENT emportée !"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/48
msgctxt "Shelley"
msgid "This is a real love connection and not two lonely things desperately clinging to each other in a last shot at love!"
msgstr "C'est une vraie histoire d'amour, pas deux choses seules qui s'accrochent désespérément l'une à l'autre pour une dernière chance d'aimer !"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/56
msgctxt "Penelope"
msgid "Wow, that's just what I was about to say!"
msgstr "Ouah, c'est exactement ce que j'allais dire !"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/64/b/1
msgctxt "Shelley"
msgid "Oh! The human is here!"
msgstr "Oh ! La personne humaine est là !"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/64/b/9
msgctxt "Shelley"
msgid "We're in love too. Hope you're into that."
msgstr "Toi et moi, on s'aime aussi. J'espère que ça te va."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/65/b/1
msgctxt "Penelope"
msgid "We really are on the same page! But also like..."
msgstr "On est vraiment sur la même longueur d'onde ! Mais aussi, genre..."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/68
msgctxt "Penelope"
msgid "Please put me down..."
msgstr "Repose-moi, s'il te plaît..."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/76
msgctxt "Shelley"
msgid "Oh my god am I, am I messing up already!?"
msgstr "Oh mon dieu, je... je suis déjà en train de tout gâcher !?"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/84
msgctxt "Shelley"
msgid "I'M SO SORRY! GOD STUPID STUPID SHELLEY!"
msgstr "JE SUIS TELLEMENT DÉSOLÉE ! BON SANG, STUPIDE STUPIDE SHELLEY !"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/92
msgctxt "Narrator"
msgid "Shelley drops Penelope like a ton of bricks."
msgstr "Shelley lâche Penelope comme une enclume."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/106
msgctxt "Narrator"
msgid "Penelope slowly, painfully climbs to her feet while Shelley berates herself."
msgstr "Penelope se relève lentement, péniblement, pendant que Shelley s'accable de reproches."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/114
msgctxt "Shelley"
msgid "Grr! You always do this Shelley!"
msgstr "Grr ! Tu fais toujours pareil, Shelley !"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/122
msgctxt "Shelley"
msgid "You get too excited and you just go in!"
msgstr "Tu t'emballes trop et tu fonces tête baissée !"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/130/b/1
msgctxt "Shelley"
msgid "Even though your lover already taught you not to!"
msgstr "Alors que ta chérie t'avait déjà appris à ne pas le faire !"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/133/s/0
msgctxt "Choix"
msgid "Maybe you could break from beating yourself up to go on your date?"
msgstr "Tu pourrais peut-être arrêter de t'en vouloir pour aller à votre rencard ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/134/s/0
msgctxt "Choix"
msgid "I'd be excited about dating Penelope too."
msgstr "Moi aussi, je serais {{ravi|ravie|ravi·e}} de sortir avec Penelope."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/135/s/0
msgctxt "Choix"
msgid "This is none of my business."
msgstr "Ce ne sont pas mes affaires."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/c-11/13
msgctxt "Penelope"
msgid "Hey, it's okay... why don't we just start over again, huh?"
msgstr "Hé, ça va... et si on recommençait depuis le début, hein ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/c-11/21 penelope_stationery/penelope_second_encounter/0/g-3/c-12/40
msgctxt "Narrator"
msgid "Shelley turns towards Penelope, wiping away a few tears."
msgstr "Shelley se tourne vers Penelope en essuyant quelques larmes."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/c-11/29 penelope_stationery/penelope_second_encounter/0/g-3/c-12/48
msgctxt "Shelley"
msgid "Huh? Y-yeah... yeah."
msgstr "Hein ? O-ouais... ouais."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/c-12/13
msgctxt "Penelope"
msgid "Oh my god stop! Don't say that now..."
msgstr "Oh mon dieu, arrête ! Ne dis pas ça maintenant..."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/c-12/24
msgctxt "Penelope"
msgid "I mean, thanks... but not in front of my date!"
msgstr "Je veux dire, merci... mais pas devant mon rencard !"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/c-12/32
msgctxt "Penelope"
msgid "Come on Shelley, why don't we just get movin' huh?"
msgstr "Allez Shelley, et si on se mettait en route, hein ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/c-13/13
msgctxt "Penelope"
msgid "Jeeze, alright."
msgstr "Eh ben, d'accord."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/c-13/21
msgctxt "Penelope"
msgid "Look, uh, Shelley..."
msgstr "Écoute, euh, Shelley..."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/c-13/29
msgctxt "Penelope"
msgid "You know, when I feel bad, I try to remember these words:"
msgstr "Tu sais, quand ça ne va pas, j'essaie de me rappeler ces mots :"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/c-13/37
msgctxt "Penelope"
msgid "\"It's amazing how much you can accomplish when it doesn’t matter who gets the credit\". — Harry S. Shoeman"
msgstr "« C'est incroyable tout ce qu'on peut accomplir quand on se fiche de savoir qui en récolte le mérite. » — Harry S. Shoeman"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/c-13/45
msgctxt "Narrator"
msgid "Shelley sniffles."
msgstr "Shelley renifle."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/c-13/53
msgctxt "Shelley"
msgid "I don't... get it?"
msgstr "Je ne... comprends pas ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/c-13/61
msgctxt "Penelope"
msgid "Oh, sure you do, honey. Now come on..."
msgstr "Oh, mais si, tu comprends, ma belle. Allez, viens..."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/c-13/69
msgctxt "Narrator"
msgid "She takes Shelley's arm."
msgstr "Elle prend Shelley par le bras."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-3/c-13/77
msgctxt "Penelope"
msgid "Let's go on that date!"
msgstr "Allons à ce rencard !"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_encounter/0/g-4/10
msgctxt "Narrator"
msgid "As you watch the two of them leave arm-in-arm you have a sinking feeling... you'll have to come back later and see how it went."
msgstr "Alors que vous les regardez partir bras dessus, bras dessous, vous avez un mauvais pressentiment... il faudra revenir plus tard voir comment ça s'est passé."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/6
msgctxt "Penelope"
msgid "\"We are what we repeatedly do. Excellence, therefore, is not an act but a habit.\" — Arispotle."
msgstr "« Nous sommes ce que nous faisons de façon répétée. L'excellence n'est donc pas un acte, mais une habitude. » — Arispotle."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/14
msgctxt "Penelope"
msgid "I'm back in the saddle and that's okay!"
msgstr "Me revoilà en selle, et c'est très bien comme ça !"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/22/s/0
msgctxt "Choix"
msgid "So I take it your date with Shelley didn't go well."
msgstr "J'imagine que ton rencard avec Shelley ne s'est pas bien passé."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/23/s/0
msgctxt "Choix"
msgid "Arispotle really knew his shit."
msgstr "Arispotle, il savait vraiment de quoi il parlait, putain."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/24/s/0
msgctxt "Choix"
msgid "Do you ever come up with your own ideas?"
msgstr "Tu as parfois des idées à toi ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/c-0/7
msgctxt "Penelope"
msgid "Oh BOY didn't it!!!"
msgstr "Ah ça, pour sûr, et comment !!!"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/c-1/7
msgctxt "Penelope"
msgid "He did! He did!"
msgstr "Il savait ! Il savait !"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/c-1/15
msgctxt "Penelope"
msgid "That's why they paid him the big bucks to say that stuff."
msgstr "C'est pour ça qu'on le payait des fortunes pour raconter ce genre de trucs."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/c-1/23
msgctxt "Penelope"
msgid "That's besides the point."
msgstr "Ce n'est pas la question."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/c-1/31 penelope_stationery/penelope_third_encounter/0/c-2/45
msgctxt "Penelope"
msgid "My date with Shelley was AWFUL!"
msgstr "Mon rencard avec Shelley a été AFFREUX !"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/c-2/7
msgctxt "Penelope"
msgid "I do all the time!"
msgstr "Tout le temps !"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/c-2/15
msgctxt "Penelope"
msgid "But unlike you, <i>I</i> haven't abandoned office supplies!"
msgstr "Mais contrairement à toi, <i>moi</i>, je n'ai pas abandonné les fournitures de bureau !"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/c-2/26
msgctxt "Penelope"
msgid "I'm gonna use this amazing calendar!"
msgstr "Je vais utiliser ce calendrier extraordinaire !"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/c-2/37
msgctxt "Penelope"
msgid "BUT ANYWAY!"
msgstr "MAIS BREF !"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-0/0
msgctxt "Penelope"
msgid "It was a complete disaster."
msgstr "Ça a été un désastre complet."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-0/8
msgctxt "Penelope"
msgid "She wouldn't stop crying at dinner."
msgstr "Elle n'arrêtait pas de pleurer pendant le dîner."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-0/16
msgctxt "Penelope"
msgid "She kept talking about how I was her last chance at happiness..."
msgstr "Elle répétait que j'étais sa dernière chance d'être heureuse..."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-0/24/b/1
msgctxt "Penelope"
msgid "Which seemed dramatic because she still is like totally all about you."
msgstr "Ce qui faisait très dramatique, parce qu'elle est toujours complètement à fond sur toi."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-0/27
msgctxt "Penelope"
msgid "And that if we didn't hold onto each other we'd both be old and alone."
msgstr "Et que si on ne s'accrochait pas l'une à l'autre, on finirait toutes les deux vieilles et seules."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-0/35/s/0
msgctxt "Choix"
msgid "She was right."
msgstr "Elle avait raison."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-0/36/s/0
msgctxt "Choix"
msgid "She couldn't be more wrong."
msgstr "Elle ne pouvait pas se tromper davantage."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-0/37/s/0
msgctxt "Choix"
msgid "She had a babe like you on a date and cried the whole time?"
msgstr "Elle avait un canon comme toi en rendez-vous et elle a pleuré tout du long ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-0/c-3/13
msgctxt "Penelope"
msgid "\"Working hard is very important. You're not going to get anywhere without working extremely hard.\" — Forge Lucas!"
msgstr "« Travailler dur est très important. On n'ira nulle part sans travailler extrêmement dur. » — Forge Lucas !"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-0/c-3/18
msgctxt "Penelope"
msgid "YOU'RE WRONG WRONG WRONG WRONG WRONG!"
msgstr "TU AS TORT TORT TORT TORT TORT !"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-0/c-3/29
msgctxt "Penelope"
msgid "I just have to work harder at dating. And that's fine."
msgstr "Il faut juste que je travaille plus dur mes rencards. Et c'est très bien comme ça."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-0/c-4/13
msgctxt "Penelope"
msgid "Yeah... YEAH!"
msgstr "Ouais... OUAIS !"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-0/c-4/21
msgctxt "Penelope"
msgid "Dating is like a job interview, right?"
msgstr "Les rencards, c'est comme un entretien d'embauche, non ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-0/c-4/29
msgctxt "Penelope"
msgid "I just need some more interviews!"
msgstr "Il me faut juste plus d'entretiens !"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-0/c-4/37
msgctxt "Penelope"
msgid "\"We are really competing against ourselves. We have no control over how other people perform.\" — Pete Cashmere."
msgstr "« Nous sommes en réalité en compétition contre nous-mêmes. Nous n'avons aucun contrôle sur la façon dont les autres performent. » — Pete Cashmere."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-0/c-4/45
msgctxt "Penelope"
msgid "I just gotta get back out there."
msgstr "Il faut juste que je me remette sur le marché."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-0/c-5/13
msgctxt "Penelope"
msgid "She definitely cried the whole time..."
msgstr "Elle a vraiment pleuré tout le temps..."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-0/c-5/21
msgctxt "Penelope"
msgid "I gave her all the motivational quotes I had but nothing worked."
msgstr "Je lui ai donné toutes les citations motivantes que j'avais, mais rien n'a marché."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-0/c-5/29
msgctxt "Penelope"
msgid "Like, if <i>I</i> was crying and somebody said to me-"
msgstr "Genre, si <i>moi</i> je pleurais et que quelqu'un me disait..."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-0/c-5/37
msgctxt "Penelope"
msgid "\"It’s not about money or connection — it’s the willingness to outwork and outlearn everyone.\" — Spark Cuban."
msgstr "« Ce n'est pas une question d'argent ni de relations : c'est la volonté de travailler plus et d'apprendre plus que tout le monde. » — Spark Cuban."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-0/c-5/45
msgctxt "Penelope"
msgid "I definitely would have cheered up!"
msgstr "Moi, je me serais sûrement remontée le moral !"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-0/c-5/56
msgctxt "Penelope"
msgid "But I guess we can't all be me."
msgstr "Mais bon, on ne peut pas toutes être moi."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-1/0
msgctxt "Penelope"
msgid "So, Shelley... not the one."
msgstr "Donc, Shelley... pas la bonne."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-1/8
msgctxt "Penelope"
msgid "But hey! I managed to get another date lined up on my way back here!"
msgstr "Mais bon ! J'ai réussi à me dégoter un autre rencard en revenant ici !"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-1/16
msgctxt "Penelope"
msgid "And it was like a totally real and spontaneous connection!"
msgstr "Et c'était genre une rencontre totalement vraie et spontanée !"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-1/24
msgctxt "Penelope"
msgid "Not at all because he was like... around!"
msgstr "Pas du tout parce qu'il était, genre... dans le coin !"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-1/32/s/0
msgctxt "Choix"
msgid "That would be a pretty bad reason to date someone."
msgstr "Ce serait une assez mauvaise raison de sortir avec quelqu'un."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-1/33/s/0
msgctxt "Choix"
msgid "If that's all it takes I'm around... and alive too."
msgstr "Si c'est tout ce qu'il faut, je suis dans le coin, moi aussi... et en vie, en plus."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-1/34/s/0
msgctxt "Choix"
msgid "I don't know if I believe you..."
msgstr "Je ne sais pas si je te crois..."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-1/c-6/13
msgctxt "Penelope"
msgid "It WOULD be, wouldn't it!"
msgstr "Ce SERAIT une mauvaise raison, hein !"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-1/c-6/21
msgctxt "Penelope"
msgid "But that's not it at all! Not at ALL!"
msgstr "Mais ce n'est pas du tout ça ! Pas DU TOUT !"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-1/c-7/13
msgctxt "Penelope"
msgid "HAHAHA! STOP IT, YOU!"
msgstr "HAHAHA ! ARRÊTE, TOI !"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-1/c-7/24
msgctxt "Penelope"
msgid "THAT WAS A REALLY HILARIOUS JOKE YOU JUST TOLD! GAH!"
msgstr "ELLE ÉTAIT VRAIMENT HILARANTE, TA BLAGUE ! GAH !"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-1/c-7/32
msgctxt "Penelope"
msgid "AND I'M TOTALLY IN ON IT!"
msgstr "ET J'AI TOTALEMENT COMPRIS LA BLAGUE !"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-1/c-8/13
msgctxt "Penelope"
msgid "Hey hey! I don't know if I like your tone!"
msgstr "Hé, hé ! Je ne sais pas si j'aime ton ton !"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-1/c-8/24
msgctxt "Penelope"
msgid "\"If you don’t create a great, rewarding place for people to work, they won’t do great work.\" — Ari Weinztwig"
msgstr "« Si vous ne créez pas un lieu de travail formidable et gratifiant, les gens ne feront pas du bon travail. » — Ari Weinztwig"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-1/c-8/32
msgctxt "Penelope"
msgid "I'm gonna need you to create a great and rewarding place for me to work, buddy!"
msgstr "Il va falloir que tu me crées un lieu de travail formidable et gratifiant, hein !"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-1/c-8/40
msgctxt "Penelope"
msgid "Turn that hateration into love and positivity!"
msgstr "Transforme cette haine en amour et en positivité !"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-2/0
msgctxt "Narrator"
msgid "Penelope looks past you to the desk—when you follow her gaze, you see a man wearing dice-chic standing nearby."
msgstr "Penelope regarde au-delà de vous, vers le bureau. En suivant son regard, vous apercevez un homme en tenue chic à base de dés, debout non loin."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-2/8
msgctxt "Penelope"
msgid "Oh my god... Chance! How long have you been standing there?"
msgstr "Oh mon dieu... Chance ! Ça fait combien de temps que tu es là ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-2/22
msgctxt "Chance"
msgid "Ho there, fairest maiden!"
msgstr "Holà, belle damoiselle !"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-2/33
msgctxt "Chance"
msgid "Art thou ready for our date?"
msgstr "Es-tu prête pour notre rendez-vous galant ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-2/41/s/0
msgctxt "Choix"
msgid "Are you dating or LARPing?"
msgstr "Vous êtes en rendez-vous ou vous faites du GN ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-2/42/s/0
msgctxt "Choix"
msgid "You better treat her right."
msgstr "Tu as intérêt à bien la traiter."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-2/43/s/0
msgctxt "Choix"
msgid "This is sad even for you."
msgstr "C'est triste, même pour toi."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-2/c-9/13
msgctxt "Penelope"
msgid "DATING, OBVIOUSLY!"
msgstr "UN RENCARD, ÉVIDEMMENT !"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-2/c-9/24
msgctxt "Chance"
msgid "LARPing of course!"
msgstr "Du GN, bien sûr !"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-2/c-9/35
msgctxt "Penelope"
msgid "Oh... we're not going on a date?"
msgstr "Oh... on ne va pas à un rencard ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-2/c-9/43/b/1
msgctxt "Chance"
msgid "I already have a little thing going on with the human..."
msgstr "J'ai déjà une petite histoire en cours avec la personne humaine..."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-2/c-10/13
msgctxt "Chance"
msgid "How else does one treat a maiden?"
msgstr "Comment traiter autrement une damoiselle ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-2/c-10/21
msgctxt "Chance"
msgid "Never fear! She is in good hands."
msgstr "Ne crains rien ! Elle est en de bonnes mains."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-2/c-10/29
msgctxt "Penelope"
msgid "Yeah! This is gonna be a good date."
msgstr "Ouais ! Ça va être un bon rencard."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-2/c-11/13
msgctxt "Penelope"
msgid "What's sad about this!? It's still a date!"
msgstr "Qu'est-ce qu'il y a de triste là-dedans !? C'est quand même un rencard !"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-3/0
msgctxt "Chance"
msgid "...this is a date?"
msgstr "...c'est un rencard ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-3/8
msgctxt "Penelope"
msgid "Do you... do you not want to date me?"
msgstr "Tu... tu ne veux pas sortir avec moi ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-3/16
msgctxt "Chance"
msgid "No, no, I do! Oh my god oh my GOD!"
msgstr "Non, non, si, je veux ! Oh mon dieu, oh mon DIEU !"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-3/33/b/1
msgctxt "Chance"
msgid "Let's see... love-ending modifier with the human... and..."
msgstr "Voyons... modificateur de fin amoureuse avec la personne humaine... et..."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-3/36
msgctxt "Narrator"
msgid "He rolls a small die, seemingly thrilled with the result."
msgstr "Il lance un petit dé, apparemment ravi du résultat."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-3/44
msgctxt "Chance"
msgid "Okay okay, it's definitely a date. Let's go!"
msgstr "Okay okay, c'est bien un rencard. Allons-y !"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-3/52
msgctxt "Penelope"
msgid "There, see? A real date!"
msgstr "Voilà, tu vois ? Un vrai rencard !"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-3/60
msgctxt "Penelope"
msgid "Not just me dating a guy out of pure convenience!"
msgstr "Pas juste moi qui sors avec un mec par pure commodité !"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-3/68
msgctxt "Penelope"
msgid "This is gonna be the one, I can tell!"
msgstr "Ce sera le bon, je le sens !"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-3/79
msgctxt "Chance"
msgid "Oh yeah definitely—I rolled a 19 on my charisma check..."
msgstr "Oh oui, absolument... j'ai fait un 19 à mon jet de charisme..."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-3/87
msgctxt "Chance"
msgid "This is gonna be truly excellent."
msgstr "Ça va être vraiment excellent."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-3/95/s/0
msgctxt "Choix"
msgid "I'll... leave you to it."
msgstr "Je vais... vous laisser."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-3/96/s/0
msgctxt "Choix"
msgid "I'll see myself out?"
msgstr "Je trouverai la sortie toute seule ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-3/97/s/0
msgctxt "Choix"
msgid "<i>Drop a smoke bomb and escape!</i>"
msgstr "<i>Lance une bombe fumigène et file !</i>"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_encounter/0/g-4/0
msgctxt "Penelope"
msgid "...help."
msgstr "...à l'aide."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/6
msgctxt "Penelope"
msgid "\"Perfection is not attainable, but if we choose perfection, we can catch excellence.\" — Vince Bombardi."
msgstr "« La perfection n'est pas atteignable, mais si nous visons la perfection, nous pouvons attraper l'excellence. » — Vince Bombardi."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/14
msgctxt "Penelope"
msgid "Let me tell ya... Chance? Not perfect."
msgstr "Je te le dis... Chance ? Pas parfait."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/22
msgctxt "Penelope"
msgid "Not even close."
msgstr "Même pas près."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/30
msgctxt "Penelope"
msgid "But through chasing perfection, I have attained excellence with tonight's date."
msgstr "Mais en poursuivant la perfection, j'ai atteint l'excellence avec le rencard de ce soir."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/38/s/0
msgctxt "Choix"
msgid "What was so bad about Chance?"
msgstr "Qu'est-ce qui n'allait pas avec Chance ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/39/s/0
msgctxt "Choix"
msgid "Are you finally ready to give up and date me?"
msgstr "Tu es enfin prête à abandonner et à sortir avec moi ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/40/s/0
msgctxt "Choix"
msgid "Given your track record I find that hard to believe."
msgstr "Vu tes antécédents, j'ai du mal à le croire."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/c-0/13
msgctxt "Penelope"
msgid "Oh my god... well... uuuhhh..."
msgstr "Oh mon dieu... eh bien... euuuh..."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/c-1/13
msgctxt "Penelope"
msgid "You sound so SERIOUS when you say it!"
msgstr "Ça sonne tellement SÉRIEUX quand tu le dis !"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/c-1/21
msgctxt "Penelope"
msgid "Very funny you!"
msgstr "Très drôle, toi !"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/c-1/32
msgctxt "Penelope"
msgid "HAHAHAHA! What a joke you just told!"
msgstr "HAHAHAHA ! Quelle blague !"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/c-1/40
msgctxt "Penelope"
msgid "Maybe if I was that funny my date would have gone better..."
msgstr "Si j'étais aussi drôle, mon rencard se serait peut-être mieux passé..."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/c-2/13
msgctxt "Penelope"
msgid "It's not my fault! I thought he was gonna be nice!"
msgstr "Ce n'est pas ma faute ! Je pensais qu'il serait gentil !"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-0/0
msgctxt "Penelope"
msgid "I thought we'd have so much to talk about..."
msgstr "Je pensais qu'on aurait tellement de choses à se dire..."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-0/8
msgctxt "Penelope"
msgid "So what if he's a nerd, so am I!"
msgstr "Et alors, c'est un nerd, moi aussi !"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-0/16
msgctxt "Penelope"
msgid "But he checked a stat sheet or rolled dice before he did EVERYTHING!"
msgstr "Mais il consultait une feuille de stats ou lançait des dés avant de faire TOUT !"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-0/24
msgctxt "Penelope"
msgid "He ordered breadsticks, pasta, and tiramisu because he had \"proficiency in Italian dining\"."
msgstr "Il a commandé des gressins, des pâtes et un tiramisu parce qu'il avait la « maîtrise de la cuisine italienne »."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-0/32
msgctxt "Penelope"
msgid "When it was time to go he told me he wouldn't see me again..."
msgstr "Au moment de partir, il m'a dit qu'il ne me reverrait pas..."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-0/40
msgctxt "Penelope"
msgid "Because he rolled a 7 and a 1-10 meant he couldn't see me again."
msgstr "Parce qu'il avait fait un 7 et qu'un résultat de 1 à 10 voulait dire qu'il ne pouvait pas me revoir."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-0/48
msgctxt "Penelope"
msgid "I GOT DUMPED BY FATE!"
msgstr "J'AI ÉTÉ PLAQUÉE PAR LE DESTIN !"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-0/59
msgctxt "Penelope"
msgid "THE UNIVERSE IS AGAINST ME!"
msgstr "L'UNIVERS EST CONTRE MOI !"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-0/70/s/0
msgctxt "Choix"
msgid "You deserve someone brave enough to dump you himself."
msgstr "Tu mérites quelqu'un d'assez courageux pour te larguer lui-même."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-0/71/s/0
msgctxt "Choix"
msgid "I wouldn't need a dice to dump you."
msgstr "Moi, je n'aurais pas besoin d'un dé pour te larguer."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-0/72/s/0
msgctxt "Choix"
msgid "You deserve better... you deserve me."
msgstr "Tu mérites mieux... tu mérites de sortir avec moi."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-0/c-3/13
msgctxt "Penelope"
msgid "Okay well... I'd rather not get dumped but I hear you, I hear you..."
msgstr "Okay, eh bien... je préférerais ne pas me faire larguer, mais je t'entends, je t'entends..."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-0/c-3/21
msgctxt "Penelope"
msgid "I understand what you're getting at."
msgstr "Je comprends où tu veux en venir."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-0/c-4/13
msgctxt "Penelope"
msgid "...cause you wouldn't, right?"
msgstr "...parce que toi, tu ne le ferais pas, hein ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-0/c-4/21
msgctxt "Penelope"
msgid "RIGHT?"
msgstr "HEIN ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-0/c-4/29
msgctxt "Penelope"
msgid "...yeah, you wouldn't."
msgstr "...ouais, tu ne le ferais pas."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-0/c-5/13
msgctxt "Penelope"
msgid "I mean does anybody deserve you?"
msgstr "Je veux dire, est-ce que quelqu'un te mérite, au fond ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-0/c-5/21
msgctxt "Penelope"
msgid "Maybe a movie star or a sexy billionaire!"
msgstr "Peut-être une star de cinéma ou un milliardaire sexy !"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-0/c-5/29
msgctxt "Penelope"
msgid "Not a regular bunch of office supplies like me, though!"
msgstr "Pas un simple tas de fournitures de bureau comme moi, en tout cas !"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-0/c-5/40
msgctxt "Penelope"
msgid "HAHAHA!"
msgstr "HAHAHA !"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-1/0
msgctxt "Penelope"
msgid "Okay enough about that!"
msgstr "Bon, assez parlé de ça !"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-1/8
msgctxt "Penelope"
msgid "Um, let me tell you about the absolute BABE I got a date with!"
msgstr "Euh, laisse-moi te parler du PUTAIN DE CANON avec qui j'ai rencard !"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-1/16
msgctxt "Penelope"
msgid "She's so out of my league, honestly I'd think she was gonna say no."
msgstr "Elle est tellement hors de ma portée que, franchement, je pensais qu'elle dirait non."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-1/24
msgctxt "Penelope"
msgid "But Office Romance Magazine says you can't hit a home run if you don't risk striking out!"
msgstr "Mais Romance de Bureau Magazine dit qu'on ne peut pas marquer un home run sans risquer de se faire éliminer !"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-1/32
msgctxt "Penelope"
msgid "And I hit a romantic home run for sure this time!"
msgstr "Et là, à tous les coups, j'ai réussi mon home run romantique !"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-1/46
msgctxt "Narrator"
msgid "As if on cue, Skylar saunters into the office. Penelope lets out a girlish squeal."
msgstr "Comme si elle avait entendu son nom, Skylar entre dans le bureau d'un pas nonchalant. Penelope pousse un petit cri de fillette."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-1/57
msgctxt "Penelope"
msgid "EEEE! THERE SHE IS! THE GLASSES OF MY DREAMS!"
msgstr "IIIII ! LA VOILÀ ! LES LUNETTES DE MES RÊVES !"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-1/71
msgctxt "Skylar"
msgid "Oh, uh... hey... you!"
msgstr "Oh, euh... salut... toi !"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-1/79/s/0
msgctxt "Choix"
msgid "Oh you're about to get dumped."
msgstr "Oh, tu vas te faire larguer."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-1/80/s/0
msgctxt "Choix"
msgid "Wow, you did great."
msgstr "Ouah, tu as assuré."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-1/81/s/0
msgctxt "Choix"
msgid "Hey Skylar! Here for your date?"
msgstr "Salut Skylar ! Tu viens pour ton rencard ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-1/c-6/7
msgctxt "Penelope"
msgid "NO! We're going to FALL IN LOVE!"
msgstr "NON ! On va TOMBER AMOUREUSES !"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-1/c-6/15
msgctxt "Skylar"
msgid "Oh, yeah... about that..."
msgstr "Oh, ouais... à ce sujet..."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-1/c-7/7
msgctxt "Penelope"
msgid "Didn't I? You saw it here first."
msgstr "Pas vrai ? Tu l'as vu ici en premier."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-1/c-7/15
msgctxt "Penelope"
msgid "The beginning of our love story."
msgstr "Le début de notre histoire d'amour."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-1/c-8/7
msgctxt "Skylar"
msgid "Uh... well..."
msgstr "Euh... eh bien..."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-2/3
msgctxt "Narrator"
msgid "Skylar tucks a strand of hair behind her ear, unable to meet either of your gazes."
msgstr "Skylar remet une mèche de cheveux derrière son oreille, incapable de croiser votre regard ou celui de Penelope."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-2/11
msgctxt "Skylar"
msgid "Um... I'm really proud of you for getting out there, Penelope."
msgstr "Hum... je suis vraiment fière de toi d'avoir osé te lancer, Penelope."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-2/19
msgctxt "Skylar"
msgid "And you asked me out, and I did say yes."
msgstr "Et tu m'as invitée, et j'ai bien dit oui."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-2/27
msgctxt "Skylar"
msgid "And I've been trying to get ready for our date but..."
msgstr "Et j'ai essayé de me préparer pour notre rencard, mais..."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-2/35
msgctxt "Skylar"
msgid "I'm sorry I..."
msgstr "Je suis désolée, je..."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-2/43
msgctxt "Skylar"
msgid "I've never liked girls with glasses!"
msgstr "Je n'ai jamais aimé les filles à lunettes !"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-2/57/s/0
msgctxt "Choix"
msgid "But I wear glasses..."
msgstr "Mais moi, je porte des lunettes..."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-2/58/s/0
msgctxt "Choix"
msgid "But you are glasses..."
msgstr "Mais toi, tu es des lunettes..."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-2/59/s/0
msgctxt "Choix"
msgid "Wow... close-minded."
msgstr "Ouah... quelle étroitesse d'esprit."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-2/c-9/7/b/1 penelope_stationery/penelope_fourth_encounter/0/g-2/c-9/8/b/1
msgctxt "Skylar"
msgid "That's... different. I like you."
msgstr "C'est... différent. Je t'aime bien, toi."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-2/c-9/9/b/1
msgctxt "Skylar"
msgid "I was able to overcome that with you!"
msgstr "J'ai réussi à dépasser ça avec toi !"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-2/c-9/10/b/1
msgctxt "Skylar"
msgid "...exactly."
msgstr "...exactement."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-2/c-10/7
msgctxt "Skylar"
msgid "It's not the same thing, okay!"
msgstr "Ce n'est pas la même chose, d'accord !"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-2/c-10/15
msgctxt "Skylar"
msgid "Do you like other humans?"
msgstr "Tu aimes les autres humains ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-2/c-10/23/0/s/0
msgctxt "Choix"
msgid "Um... I'm trying?"
msgstr "Hum... j'essaie ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-2/c-10/23/1/s/0
msgctxt "Choix"
msgid "Nope. Objects only for me."
msgstr "Non. Les objets, uniquement."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-2/c-10/23/2/s/0
msgctxt "Choix"
msgid "That doesn't make any sense!"
msgstr "Ça n'a aucun sens !"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-2/c-10/23/c-0/7
msgctxt "Skylar"
msgid "Ugh this is impossible. You'll never understand."
msgstr "Pfff, c'est impossible. Tu ne comprendras jamais."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-2/c-10/23/c-1/7
msgctxt "Skylar"
msgid "Exactly!"
msgstr "Exactement !"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-2/c-10/23/c-2/7
msgctxt "Skylar"
msgid "Exactly what a human would say."
msgstr "Exactement ce que dirait un humain."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-2/c-11/7
msgctxt "Skylar"
msgid "...it is what it is!"
msgstr "...c'est comme ça !"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-3/0
msgctxt "Skylar"
msgid "SORRY NOT SORRYYY!"
msgstr "DÉSOLÉE PAS DÉSOLÉÉÉE !"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-3/14
msgctxt "Narrator"
msgid "Skylar flees from the two of you, leaving Penelope devastated in her wake."
msgstr "Skylar s'enfuit en vous plantant là toutes les deux, laissant Penelope dévastée dans son sillage."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-3/22/s/0
msgctxt "Choix"
msgid "Quick, get one of your dumb little quotes."
msgstr "Vite, sors une de tes petites citations débiles."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-3/23/s/0
msgctxt "Choix"
msgid "Penelope... I'm so sorry."
msgstr "Penelope... je suis vraiment {{désolé|désolée|désolé·e}}."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-3/24/s/0
msgctxt "Choix"
msgid "Would you like a hug?"
msgstr "Tu veux un câlin ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-3/c-12/13
msgctxt "Penelope"
msgid "...even motivational quotes can't help me now."
msgstr "...même les citations motivantes ne peuvent plus rien pour moi."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-3/c-13/13
msgctxt "Penelope"
msgid "\"Guys don't make passes at girl who wear glasses\" -Some Jerk."
msgstr "« Les garçons ne draguent pas les filles qui portent des lunettes » — Un Connard Quelconque."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-3/c-13/21
msgctxt "Penelope"
msgid "...anyway, thanks."
msgstr "...enfin bref, merci."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-3/c-14/13
msgctxt "Penelope"
msgid "Awww... thank you... but even a warm hug can't save me."
msgstr "Ooooh... merci... mais même un câlin bien chaud ne peut pas me sauver."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-4/0
msgctxt "Penelope"
msgid "I'm going to the kitchen."
msgstr "Je vais à la cuisine."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-4/8
msgctxt "Penelope"
msgid "And I'm gonna see how much cheese I can eat before I die of acute calcium poisoning."
msgstr "Et je vais voir combien de fromage je peux avaler avant de mourir d'une intoxication aiguë au calcium."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-4/16
msgctxt "Penelope"
msgid "Which is a very real and serious thing."
msgstr "Ce qui est une chose très réelle et très sérieuse."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_encounter/0/g-4/24
msgctxt "Penelope"
msgid "...see you later. Maybe."
msgstr "...à plus tard. Peut-être."

# Traduction IA – à relire
#: penelope_stationery/penelope_critical_encounter/0/0
msgctxt "Penelope"
msgid "\"The employer generally gets the employees he deserves.\" — J. Paul Jetty"
msgstr "« L'employeur obtient généralement les employés qu'il mérite. » — J. Paul Jetty"

# Traduction IA – à relire
#: penelope_stationery/penelope_critical_encounter/0/8
msgctxt "Penelope"
msgid "I've been trying so hard to date."
msgstr "J'ai tellement essayé de sortir avec des gens."

# Traduction IA – à relire
#: penelope_stationery/penelope_critical_encounter/0/16
msgctxt "Penelope"
msgid "I thought like... okay, maybe it's just a numbers game."
msgstr "Je me suis dit, genre... okay, c'est peut-être juste une question de nombre."

# Traduction IA – à relire
#: penelope_stationery/penelope_critical_encounter/0/24
msgctxt "Penelope"
msgid "Gotta get some bad dates out of the way to have a good one."
msgstr "Faut se coltiner quelques mauvais rencards pour en avoir un bon."

# Traduction IA – à relire
#: penelope_stationery/penelope_critical_encounter/0/32
msgctxt "Penelope"
msgid "And boy was I wrong."
msgstr "Et ben, que je me trompais."

# Traduction IA – à relire
#: penelope_stationery/penelope_critical_encounter/0/40
msgctxt "Penelope"
msgid "But it's okay. I get it now."
msgstr "Mais c'est pas grave. J'ai compris, maintenant."

# Traduction IA – à relire
#: penelope_stationery/penelope_critical_encounter/0/48
msgctxt "Penelope"
msgid "This is just how it is for someone like me."
msgstr "C'est comme ça pour quelqu'un comme moi."

# Traduction IA – à relire
#: penelope_stationery/penelope_critical_encounter/0/56
msgctxt "Penelope"
msgid "You get what you get and you'd better like it."
msgstr "On prend ce qu'on trouve et on a intérêt à aimer ça."

# Traduction IA – à relire
#: penelope_stationery/penelope_critical_encounter/0/64/s/0
msgctxt "Choix"
msgid "Wow exactly!"
msgstr "Ouah, exactement !"

# Traduction IA – à relire
#: penelope_stationery/penelope_critical_encounter/0/65/s/0
msgctxt "Choix"
msgid "I don't think that's true at all."
msgstr "Je ne pense pas du tout que ce soit vrai."

# Traduction IA – à relire
#: penelope_stationery/penelope_critical_encounter/0/66/s/0
msgctxt "Choix"
msgid "NO! You deserve the best!"
msgstr "NON ! Tu mérites le meilleur !"

# Traduction IA – à relire
#: penelope_stationery/penelope_critical_encounter/0/c-0/13
msgctxt "Penelope"
msgid "Yeah... yeah."
msgstr "Ouais... ouais."

# Traduction IA – à relire
#: penelope_stationery/penelope_critical_encounter/0/c-1/13
msgctxt "Penelope"
msgid "Maybe not for someone like you."
msgstr "Peut-être pas pour quelqu'un comme toi."

# Traduction IA – à relire
#: penelope_stationery/penelope_critical_encounter/0/c-1/21
msgctxt "Penelope"
msgid "But the facts are facts and for someone like me..."
msgstr "Mais les faits sont les faits, et pour quelqu'un comme moi..."

# Traduction IA – à relire
#: penelope_stationery/penelope_critical_encounter/0/c-1/29
msgctxt "Penelope"
msgid "That's just facts."
msgstr "Ce sont juste les faits."

# Traduction IA – à relire
#: penelope_stationery/penelope_critical_encounter/0/c-2/13
msgctxt "Penelope"
msgid "Aw, you're sweet and all, but... I see now that I'm lucky anyone would put up with me."
msgstr "Aww, c'est adorable de ta part, mais... je vois bien maintenant que j'ai de la chance si quelqu'un me supporte."

# Traduction IA – à relire
#: penelope_stationery/penelope_critical_encounter/0/c-2/21
msgctxt "Penelope"
msgid "So I'm just gonna date whoever can stand me."
msgstr "Alors je vais sortir avec n'importe qui pourvu qu'on me supporte."

# Traduction IA – à relire
#: penelope_stationery/penelope_critical_encounter/0/g-0/0
msgctxt "Penelope"
msgid "My date should be here any minute now, actually."
msgstr "Mon rencard devrait arriver d'une minute à l'autre, d'ailleurs."

# Traduction IA – à relire
#: penelope_stationery/penelope_critical_encounter/0/g-0/8
msgctxt "Narrator"
msgid "There's a strange chill in the air, a note of dread that raises goosebumps along your arms."
msgstr "Il y a un froid étrange dans l'air, une pointe d'effroi qui vous hérisse la peau des bras."

# Traduction IA – à relire
#: penelope_stationery/penelope_critical_encounter/0/g-0/16/b/1
msgctxt "Narrator"
msgid "You feel Sinclaire before you see him—but he makes his presence known quickly enough."
msgstr "Vous sentez Sinclaire avant de le voir, mais il ne tarde pas à signaler sa présence."

# Traduction IA – à relire
#: penelope_stationery/penelope_critical_encounter/0/g-0/25
msgctxt "Sinclaire"
msgid "HERE COMES LOVING!"
msgstr "VOICI VENIR L'AMOUR !"

# Traduction IA – à relire
#: penelope_stationery/penelope_critical_encounter/0/g-0/39
msgctxt "Sinclaire"
msgid "CHOO CHOO - LOVE BUS COMES RATTLING INTO THE STATION."
msgstr "TCHOU TCHOU, LE BUS DE L'AMOUR ENTRE EN GARE EN CAHOTANT."

# Traduction IA – à relire
#: penelope_stationery/penelope_critical_encounter/0/g-0/50/b/1
msgctxt "Sinclaire"
msgid "OH! HELLO OTHER LOVE OF MINE!"
msgstr "OH ! SALUT, AUTRE AMOUR DE MA VIE !"

# Traduction IA – à relire
#: penelope_stationery/penelope_critical_encounter/0/g-0/53/s/0
msgctxt "Choix"
msgid "Is this really the best you think you can do?"
msgstr "C'est vraiment le mieux que tu penses pouvoir faire ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_critical_encounter/0/g-0/54/s/0
msgctxt "Choix"
msgid "Are you really gonna date this guy instead of me?"
msgstr "Tu vas vraiment sortir avec ce type plutôt qu'avec moi ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_critical_encounter/0/g-0/55/s/0
msgctxt "Choix"
msgid "Wow you two are perfect for each other."
msgstr "Ouah, vous êtes faits l'un pour l'autre."

# Traduction IA – à relire
#: penelope_stationery/penelope_critical_encounter/0/g-0/c-3/13
msgctxt "Penelope"
msgid "Well... kinda, yeah."
msgstr "Eh bien... un peu, ouais."

# Traduction IA – à relire
#: penelope_stationery/penelope_critical_encounter/0/g-0/c-4/13
msgctxt "Penelope"
msgid "It's not funny to say things like that, you know."
msgstr "C'est pas drôle de dire des choses comme ça, tu sais."

# Traduction IA – à relire
#: penelope_stationery/penelope_critical_encounter/0/g-0/c-5/13
msgctxt "Penelope"
msgid "...yeah..."
msgstr "...ouais..."

# Traduction IA – à relire
#: penelope_stationery/penelope_critical_encounter/0/g-1/4
msgctxt "Penelope"
msgid "Wait... no."
msgstr "Attends... non."

# Traduction IA – à relire
#: penelope_stationery/penelope_critical_encounter/0/g-1/12
msgctxt "Penelope"
msgid "NO!"
msgstr "NON !"

# Traduction IA – à relire
#: penelope_stationery/penelope_critical_encounter/0/g-1/29
msgctxt "Narrator"
msgid "Penelope breaks away from Sinclaire, who continues walking as if she were still holding his arm."
msgstr "Penelope s'écarte de Sinclaire, qui continue de marcher comme si elle lui tenait encore le bras."

# Traduction IA – à relire
#: penelope_stationery/penelope_critical_encounter/0/g-1/40
msgctxt "Penelope"
msgid "I can't believe I didn't think of it before..."
msgstr "Je n'arrive pas à croire que je n'y avais pas pensé plus tôt..."

# Traduction IA – à relire
#: penelope_stationery/penelope_friend_path/0/0
msgctxt "Penelope"
msgid "\"The man who has confidence in himself gains the confidence of others.\"— Hasidic Proverb."
msgstr "« L'homme qui a confiance en lui gagne la confiance des autres. » — Proverbe hassidique."

# Traduction IA – à relire
#: penelope_stationery/penelope_friend_path/0/8
msgctxt "Penelope"
msgid "I've been attracting the worst dates cause I wasn't confident in myself!"
msgstr "J'ai attiré les pires rencards parce que je n'avais pas confiance en moi !"

# Traduction IA – à relire
#: penelope_stationery/penelope_friend_path/0/16
msgctxt "Penelope"
msgid "And all this time... you were right here telling me to believe in me!"
msgstr "Et pendant tout ce temps... tu étais là, à me dire de croire en moi !"

# Traduction IA – à relire
#: penelope_stationery/penelope_friend_path/0/24
msgctxt "Penelope"
msgid "'Cause you believed in me!"
msgstr "Parce que toi, tu croyais en moi !"

# Traduction IA – à relire
#: penelope_stationery/penelope_friend_path/0/32
msgctxt "Penelope"
msgid "I could have been out here dating hotties and babes left and right..."
msgstr "J'aurais pu sortir avec des canons et des bombes à tour de bras..."

# Traduction IA – à relire
#: penelope_stationery/penelope_friend_path/0/40
msgctxt "Penelope"
msgid "Instead, I ignored your friendship... and let my self-esteem stay in the toilet."
msgstr "Au lieu de ça, j'ai ignoré ton amitié... et laissé mon estime de moi traîner dans les toilettes."

# Traduction IA – à relire
#: penelope_stationery/penelope_friend_path/0/48
msgctxt "Penelope"
msgid "Can you ever forgive me... friend?"
msgstr "Pourras-tu un jour me pardonner... {{mon ami|mon amie|mon ami·e}} ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_friend_path/0/56/s/0
msgctxt "Choix"
msgid "Of course."
msgstr "Bien sûr."

# Traduction IA – à relire
#: penelope_stationery/penelope_friend_path/0/57/s/0
msgctxt "Choix"
msgid "Yes... but only if you forgive yourself first."
msgstr "Oui... mais seulement si tu te pardonnes d'abord."

# Traduction IA – à relire
#: penelope_stationery/penelope_friend_path/0/58/s/0
msgctxt "Choix"
msgid "I didn't even... okay, sure. Alright."
msgstr "Je n'ai même pas... bon, d'accord. Ça marche."

# Traduction IA – à relire
#: penelope_stationery/penelope_friend_path/0/g-0/0
msgctxt "Penelope"
msgid "Thank you..."
msgstr "Merci..."

# Traduction IA – à relire
#: penelope_stationery/penelope_friend_path/0/g-0/11
msgctxt "Penelope"
msgid "I am not gonna give up! I'm gonna keep getting out there!"
msgstr "Je n'abandonne pas ! Je vais continuer à me lancer !"

# Traduction IA – à relire
#: penelope_stationery/penelope_friend_path/0/g-0/19
msgctxt "Penelope"
msgid "But this time... I'm gonna do it with a good friend by my side."
msgstr "Mais cette fois... je le ferai avec quelqu'un de précieux à mes côtés."

# Traduction IA – à relire
#: penelope_stationery/penelope_friend_path/0/g-0/27
msgctxt "Penelope"
msgid "I won't put up with anybody's crap!"
msgstr "Je ne laisserai plus personne me marcher dessus !"

# Traduction IA – à relire
#: penelope_stationery/penelope_friend_path/0/g-0/35
msgctxt "Penelope"
msgid "'Cause now I know what real love and support looks like!"
msgstr "Parce que maintenant, je sais à quoi ressemblent le vrai amour et le vrai soutien !"

# Traduction IA – à relire
#: penelope_stationery/penelope_friend_path/0/g-0/43
msgctxt "Penelope"
msgid "But uh, in the meantime..."
msgstr "Mais euh, en attendant..."

# Traduction IA – à relire
#: penelope_stationery/penelope_friend_path/0/g-0/51
msgctxt "Penelope"
msgid "I can't stop thinking about the fact that I almost dated Sinclaire..."
msgstr "Je n'arrête pas de penser au fait que j'ai failli sortir avec Sinclaire..."

# Traduction IA – à relire
#: penelope_stationery/penelope_friend_path/0/g-0/59
msgctxt "Penelope"
msgid "I'm gonna go cry for a while, okay?"
msgstr "Je vais aller pleurer un moment, d'accord ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_friend_path/0/g-0/67/s/0
msgctxt "Choix"
msgid "Have fun!"
msgstr "Amuse-toi bien !"

# Traduction IA – à relire
#: penelope_stationery/penelope_friend_path/0/g-0/68/s/0
msgctxt "Choix"
msgid "Lemme know how it goes!"
msgstr "Tiens-moi au courant !"

# Traduction IA – à relire
#: penelope_stationery/penelope_friend_path/0/g-0/69/s/0
msgctxt "Choix"
msgid "I dunno, that sink-guy was a straight up G."
msgstr "Je sais pas, le mec de l'évier, c'était un vrai boss."

# Traduction IA – à relire
#: penelope_stationery/penelope_friend_path/0/g-0/c-5/7
msgctxt "Penelope"
msgid "Aha ha ha ha!"
msgstr "Aha ha ha ha !"

# Traduction IA – à relire
#: penelope_stationery/penelope_friend_path/0/g-1/0
msgctxt "Penelope"
msgid "Catch you on the flipside, pal!"
msgstr "On se retrouve de l'autre côté !"

# Traduction IA – à relire
#: penelope_stationery/penelope_love_path/0/0
msgctxt "Penelope"
msgid "\"Everyone wants to be appreciated, so if you appreciate someone, don’t keep it a secret.\" — Mary Kay Sash"
msgstr "« Tout le monde veut être apprécié ; alors si vous appréciez quelqu'un, ne le gardez pas secret. » — Mary Kay Sash"

# Traduction IA – à relire
#: penelope_stationery/penelope_love_path/0/8
msgctxt "Penelope"
msgid "I've been keeping my appreciation a secret because I was so scared of rejection..."
msgstr "J'ai gardé mon affection secrète parce que j'avais tellement peur du rejet..."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_path/0/16
msgctxt "Penelope"
msgid "That's why I've been dating all these weirdos."
msgstr "C'est pour ça que je suis sortie avec tous ces cinglés."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_path/0/24
msgctxt "Penelope"
msgid "But even THOSE guys rejected me."
msgstr "Mais même EUX m'ont rejetée."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_path/0/32
msgctxt "Penelope"
msgid "So heck, why not!"
msgstr "Alors, tant pis, pourquoi pas !"

# Traduction IA – à relire
#: penelope_stationery/penelope_love_path/0/40
msgctxt "Penelope"
msgid "What's one more little rejection?"
msgstr "Un petit rejet de plus, qu'est-ce que ça change ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_love_path/0/48
msgctxt "Penelope"
msgid "I mean it'll just shatter my heart into a million pieces but whatever!"
msgstr "Je veux dire, ça va juste me briser le cœur en un million de morceaux, mais bon, peu importe !"

# Traduction IA – à relire
#: penelope_stationery/penelope_love_path/0/56
msgctxt "Penelope"
msgid "I APPRECIATE YOU... LIKE, ROMANTICALLY!"
msgstr "JE T'APPRÉCIE... GENRE, ROMANTIQUEMENT !"

# Traduction IA – à relire
#: penelope_stationery/penelope_love_path/0/67/s/0
msgctxt "Choix"
msgid "Oh... can we just stay friends?"
msgstr "Oh... on peut juste rester amis ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_love_path/0/68/s/0
msgctxt "Choix"
msgid "I appreciate you too... about time you noticed."
msgstr "Je t'apprécie aussi... il était temps que tu le remarques."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_path/0/69/s/0
msgctxt "Choix"
msgid "This is the greatest day of my life."
msgstr "C'est le plus beau jour de ma vie."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_path/0/c-0/7
msgctxt "Penelope"
msgid "Oh... oh..."
msgstr "Oh... oh..."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_path/0/c-0/18
msgctxt "Penelope"
msgid "No, I mean, I get it. I understand."
msgstr "Non, enfin, je comprends. Je comprends."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_path/0/c-0/26
msgctxt "Penelope"
msgid "We did have a good thing going. I mean, we still do."
msgstr "On avait quelque chose de bien. Je veux dire, c'est toujours le cas."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_path/0/c-0/34
msgctxt "Penelope"
msgid "I'd like to stay friends, yeah."
msgstr "J'aimerais rester amis, ouais."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_path/0/c-0/42
msgctxt "Penelope"
msgid "Just like, if you hear me crying for the next eight hours... just don't worry about it."
msgstr "C'est juste que, genre, si tu m'entends pleurer pendant les huit prochaines heures... t'en fais pas pour ça."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_path/0/c-0/50
msgctxt "Penelope"
msgid "I'm crying about something else, not you."
msgstr "Je pleure pour autre chose, pas à cause de toi."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_path/0/c-0/58
msgctxt "Penelope"
msgid "But me and you? Pals for life."
msgstr "Mais toi et moi ? Potes à vie."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_path/0/c-0/66
msgctxt "Penelope"
msgid "I'm gonna go now..."
msgstr "Bon, je vais y aller..."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_path/0/c-1/7
msgctxt "Penelope"
msgid "Wait, seriously?"
msgstr "Attends, sérieusement ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_love_path/0/c-2/7
msgctxt "Penelope"
msgid "Wow, yours too?! What a coincidence!"
msgstr "Ouah, toi aussi ?! Quelle coïncidence !"

# Traduction IA – à relire
#: penelope_stationery/penelope_love_path/0/c-2/15
msgctxt "Penelope"
msgid "WAIT HOLD ON."
msgstr "ATTENDS, ATTENDS."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_path/0/g-0/0
msgctxt "Penelope"
msgid "You're not rejecting me?"
msgstr "Tu ne me rejettes pas ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_love_path/0/g-0/8
msgctxt "Penelope"
msgid "I... I made you watch me date all these other objects when you were right there..."
msgstr "Je... je t'ai fait me regarder sortir avec tous ces autres objets alors que tu étais juste là..."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_path/0/g-0/16
msgctxt "Penelope"
msgid "You know what, no. You will not ruin this one Penelope."
msgstr "Tu sais quoi, non. Tu ne vas pas gâcher ça, Penelope."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_path/0/g-0/24
msgctxt "Penelope"
msgid "Um... would you like to... maybe go on a date with me?"
msgstr "Hum... est-ce que tu voudrais... peut-être sortir avec moi ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_love_path/0/g-0/32/s/0
msgctxt "Choix"
msgid "I'd love to."
msgstr "Avec plaisir."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_path/0/g-0/33/s/0
msgctxt "Choix"
msgid "Only if you got another quote!"
msgstr "Seulement si t'as une autre citation !"

# Traduction IA – à relire
#: penelope_stationery/penelope_love_path/0/g-0/c-3/7
msgctxt "Penelope"
msgid "It's finally happening..."
msgstr "Ça y est, ça arrive enfin..."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_path/0/g-0/c-4/7
msgctxt "Penelope"
msgid "\"There are no shortcuts to any place worth going.\"— Beverly Quills."
msgstr "« Il n'y a pas de raccourci vers un endroit qui vaut le détour. » — Beverly Quills."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_path/0/g-1/0
msgctxt "Penelope"
msgid "It might have taken me a while to get here... but it was all worth it."
msgstr "Il m'a peut-être fallu du temps pour en arriver là... mais ça en valait la peine."

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_path/0/0
msgctxt "Penelope"
msgid "There's a quote that really aptly sums up how I feel about you..."
msgstr "Il y a une citation qui résume vraiment bien ce que je ressens pour toi..."

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_path/0/8
msgctxt "Penelope"
msgid "\"I FUCKING HATE YOU!\" - ME!"
msgstr "« JE TE DÉTESTE, PUTAIN ! » — MOI !"

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_path/0/19/s/0
msgctxt "Choix"
msgid "That doesn't sound like it came from your calendar."
msgstr "Ça n'a pas l'air de venir de ton calendrier."

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_path/0/20/s/0
msgctxt "Choix"
msgid "Whoah... that's exactly how I feel about you."
msgstr "Ouah... c'est exactement ce que je ressens pour toi."

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_path/0/21/s/0
msgctxt "Choix"
msgid "That seems a little harsh."
msgstr "Ça me paraît un peu dur."

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_path/0/c-0/7
msgctxt "Penelope"
msgid "DID YOU FIGURE THAT OUT ALL BY YOURSELF, SMARTIE?!"
msgstr "T'AS TROUVÉ ÇA TOUT SEUL, GÉNIE ?!"

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_path/0/c-0/18
msgctxt "Penelope"
msgid "YOU'RE CORRECT! IT CAME FROM MY BRAIN!"
msgstr "TU AS RAISON ! ÇA VIENT DE MON CERVEAU !"

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_path/0/c-1/7
msgctxt "Penelope"
msgid "GOD YOU CAN'T LET ME HAVE ANYTHING!"
msgstr "PUTAIN, TU ME LAISSES JAMAIS AVOIR QUOI QUE CE SOIT !"

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_path/0/c-2/7
msgctxt "Penelope"
msgid "WELL SO ARE YOU!"
msgstr "ET TOI, ALORS !"

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_path/0/g-0/0
msgctxt "Penelope"
msgid "You watched me struggle with my self-esteem!"
msgstr "Tu m'as regardée me débattre avec mon estime de moi !"

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_path/0/g-0/8
msgctxt "Penelope"
msgid "You watched me go out with loser after loser."
msgstr "Tu m'as regardée sortir avec des losers les uns après les autres."

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_path/0/g-0/16
msgctxt "Penelope"
msgid "And instead of being a friend and trying to help me get back in the saddle..."
msgstr "Et au lieu de me soutenir et d'essayer de m'aider à remonter en selle..."

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_path/0/g-0/24
msgctxt "Penelope"
msgid "YOU POINTED AND LAUGHED WHEN THE BRONCO THAT IS MY LOVE LIFE BUCKED ME OFF!"
msgstr "TU AS POINTÉ DU DOIGT ET RIGOLÉ QUAND LE MUSTANG QUI SERT DE VIE AMOUREUSE M'A DÉSARÇONNÉE !"

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_path/0/g-0/35/s/0
msgctxt "Choix"
msgid "Well it was funny..."
msgstr "Ben, c'était drôle..."

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_path/0/g-0/36/s/0
msgctxt "Choix"
msgid "I'm sorry, should I not have laughed?"
msgstr "{{Désolé|Désolée|Désolé·e}}, je n'aurais pas dû rire ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_path/0/g-0/37/s/0
msgctxt "Choix"
msgid "What's this about a bronco now?"
msgstr "C'est quoi cette histoire de mustang, maintenant ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_path/0/g-0/c-3/7
msgctxt "Penelope"
msgid "OH YEAH YOU'RE RIGHT!"
msgstr "OH OUAIS, TU AS RAISON !"

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_path/0/g-0/c-3/18
msgctxt "Penelope"
msgid "I'M JUST A BIG JOKE TO YOU! HAHAHAHA!"
msgstr "JE SUIS JUSTE UNE GROSSE BLAGUE POUR TOI ! HAHAHAHA !"

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_path/0/g-0/c-4/7
msgctxt "Penelope"
msgid "NO YOU FUCKING SHOULD NOT HAVE!"
msgstr "NON, TU N'AURAIS PAS DÛ, PUTAIN !"

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_path/0/g-0/c-5/7
msgctxt "Penelope"
msgid "IT'S CALLED A METAPHOR, DUMMY!"
msgstr "ÇA S'APPELLE UNE MÉTAPHORE, ESPÈCE DE {{CRÉTIN|CRÉTINE|CRÉTIN·E}} !"

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_path/0/g-1/0
msgctxt "Penelope"
msgid "WHATEVER!"
msgstr "PEU IMPORTE !"

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_path/0/g-1/8
msgctxt "Penelope"
msgid "I'M DONE EXPLAINING MYSELF TO YOU!"
msgstr "J'EN AI FINI AVEC LES EXPLICATIONS !"

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_path/0/g-1/16
msgctxt "Penelope"
msgid "So I got ONE last quote for ya."
msgstr "Alors j'ai UNE dernière citation pour toi."

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_path/0/g-1/24/s/0
msgctxt "Choix"
msgid "Oh great, here it comes."
msgstr "Oh super, ça y est, la voilà."

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_path/0/g-1/c-6/7
msgctxt "Penelope"
msgid "\"The individual who says it is not possible should move out of the way of those doing it.\" — Tricia Cunning Ham."
msgstr "« Celui qui dit que c'est impossible devrait s'écarter du chemin de ceux qui le font. » — Tricia Cunning Ham."

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_path/0/g-1/c-6/15
msgctxt "Penelope"
msgid "SO JUST STAY OUTTA MY WAY FROM NOW ON, CAUSE I’M DOIN’ IT!"
msgstr "ALORS RESTE JUSTE HORS DE MON CHEMIN À PARTIR DE MAINTENANT, PARCE QUE MOI, JE LE FAIS !"

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_path/0/g-2/0
msgctxt "Narrator"
msgid "Penelope pauses for a moment, a lightbulb going off somewhere."
msgstr "Penelope marque une pause, une ampoule semblant s'allumer quelque part."

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_path/0/g-2/8
msgctxt "Penelope"
msgid "AND YOU AIN’T DOIN’ SHIT!"
msgstr "ET TOI, TU FOUS RIEN DU TOUT !"

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_path/0/g-2/25
msgctxt "Narrator"
msgid "She looks entirely too pleased with herself, almost forgetting her anger for a moment."
msgstr "Elle a l'air bien trop contente d'elle, au point d'en oublier un instant sa colère."

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_path/0/g-2/33
msgctxt "Penelope"
msgid "God, nice one Penelope."
msgstr "Mon dieu, bien joué, Penelope."

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_path/0/g-2/41
msgctxt "Narrator"
msgid "She holds one hand up as if for a high-five, then smacks it with her other hand in a self-high-five."
msgstr "Elle lève une main comme pour un tope-là, puis la claque avec son autre main dans un tope-là à elle-même."

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_path/0/g-2/49
msgctxt "Narrator"
msgid "It takes her a moment to see that you’re still here."
msgstr "Il lui faut un moment pour s'apercevoir que vous êtes toujours là."

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_path/0/g-2/57
msgctxt "Penelope"
msgid "Uh... anyway..."
msgstr "Euh... bref..."

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_path/0/g-2/65
msgctxt "Penelope"
msgid "GET OUTTA HERE! GO DO SOME MORE NOTHING! I’M GONNA SUCCEED WITHOUT YOU!"
msgstr "DÉGAGE D'ICI ! VA ENCORE NE RIEN FAIRE ! JE VAIS RÉUSSIR SANS TOI !"

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_joiner/34
msgctxt "Reggie"
msgid "\"The expert in anything was once a beginner.\" — Melon Hayes."
msgstr "« L'expert en quoi que ce soit a un jour été un débutant. » — Melon Hayes."

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_joiner/42
msgctxt "Reggie"
msgid "Another step on the road to becoming an expert in hate. Beautiful."
msgstr "Un pas de plus sur la route de l'expertise en haine. Magnifique."

# Traduction IA – à relire
#: penelope_stationery/penelope_first_bulletin/0/6
msgctxt "Penelope"
msgid "HEY HEY!"
msgstr "HÉ HÉ !"

# Traduction IA – à relire
#: penelope_stationery/penelope_first_bulletin/0/14
msgctxt "Penelope"
msgid "You never told me you were into photography!"
msgstr "Tu ne m'avais jamais dit que tu t'intéressais à la photographie !"

# Traduction IA – à relire
#: penelope_stationery/penelope_first_bulletin/0/22/s/0
msgctxt "Choix"
msgid "What are you talking about?"
msgstr "De quoi tu parles ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_first_bulletin/0/23/s/0
msgctxt "Choix"
msgid "It never came up I don't think."
msgstr "Je crois que le sujet n'est jamais venu sur le tapis."

# Traduction IA – à relire
#: penelope_stationery/penelope_first_bulletin/0/g-0/0
msgctxt "Penelope"
msgid "This showed up on the bulletin board!"
msgstr "Ça est apparu sur le tableau d'affichage !"

# Traduction IA – à relire
#: penelope_stationery/penelope_first_bulletin/0/g-0/11
msgctxt "Narrator"
msgid "Penelope waves a stack of photo film at you."
msgstr "Penelope agite sous votre nez une pile de pellicules photo."

# Traduction IA – à relire
#: penelope_stationery/penelope_first_bulletin/0/g-0/19
msgctxt "Penelope"
msgid "Whatever you did to make this happen... keep it going!"
msgstr "Quoi que tu aies fait pour que ça arrive... continue comme ça !"

# Traduction IA – à relire
#: penelope_stationery/penelope_first_bulletin/0/g-0/27
msgctxt "Penelope"
msgid "Now, with that out of the way..."
msgstr "Bon, maintenant que c'est dit..."

# Traduction IA – à relire
#: penelope_stationery/penelope_first_bulletin/0/g-0/35
msgctxt "Narrator"
msgid "She turns away from the board, psyching herself up with a little sigh."
msgstr "Elle se détourne du tableau, en se donnant du courage d'un petit soupir."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_bulletin/0/6
msgctxt "Penelope"
msgid "Look at that! 25 photos!"
msgstr "Regarde ça ! 25 photos !"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_bulletin/0/14
msgctxt "Penelope"
msgid "Everyone looks so happy, too..."
msgstr "Tout le monde a l'air si heureux, aussi..."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_bulletin/0/22
msgctxt "Penelope"
msgid "Makes me feel hopeful about my own love life, you know?"
msgstr "Ça me donne de l'espoir pour ma propre vie amoureuse, tu vois ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_bulletin/0/30/s/0
msgctxt "Choix"
msgid "Glad to hear it!"
msgstr "Ça me fait plaisir à entendre !"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_bulletin/0/c-0/7
msgctxt "Narrator"
msgid "Penelope places a hand on the bulletin board, studying it with a quiet sigh."
msgstr "Penelope pose une main sur le tableau d'affichage et l'étudie en silence avec un soupir."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_bulletin/0/c-0/15/b/1
msgctxt "Penelope"
msgid "Maybe someday... I'll be happy like that too."
msgstr "Peut-être qu'un jour... je serai heureuse comme ça, moi aussi."

# Traduction IA – à relire
#: penelope_stationery/penelope_second_bulletin/0/c-0/16/b/1
msgctxt "Penelope"
msgid "Glad I have you here by my side!"
msgstr "Je suis contente de t'avoir à mes côtés !"

# Traduction IA – à relire
#: penelope_stationery/penelope_second_bulletin/0/c-0/19 penelope_stationery/penelope_third_bulletin/0/g-0/12 penelope_stationery/penelope_fourth_bulletin/0/g-0/19 penelope_stationery/penelope_final_bulletin/0/g-0/16
msgctxt "Narrator"
msgid "She turns away from the board."
msgstr "Elle se détourne du tableau."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_bulletin/0/6
msgctxt "Penelope"
msgid "LOOK AT THIS!"
msgstr "REGARDE ÇA !"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_bulletin/0/14
msgctxt "Penelope"
msgid "FIFTY PHOTOS!"
msgstr "CINQUANTE PHOTOS !"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_bulletin/0/22
msgctxt "Narrator"
msgid "She smiles from ear to ear, sincerely pleased with your efforts."
msgstr "Elle sourit jusqu'aux oreilles, sincèrement ravie de vos efforts."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_bulletin/0/30
msgctxt "Penelope"
msgid "Just look at all that happiness... all those brand new lives started!"
msgstr "Regarde-moi tout ce bonheur... toutes ces vies toutes neuves qui commencent !"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_bulletin/0/38/s/0
msgctxt "Choix"
msgid "It's progress!"
msgstr "C'est un progrès !"

# Traduction IA – à relire
#: penelope_stationery/penelope_third_bulletin/0/39/s/0
msgctxt "Choix"
msgid "Thanks for your help putting them up."
msgstr "Merci de ton aide pour les accrocher."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_bulletin/0/g-0/0
msgctxt "Penelope"
msgid "I'm just gonna like... meditate on this for a while..."
msgstr "Je vais juste, genre... méditer là-dessus un moment..."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_bulletin/0/g-0/8/b/1
msgctxt "Penelope"
msgid "See if some of that happiness rubs off on me."
msgstr "Voir si un peu de ce bonheur déteint sur moi."

# Traduction IA – à relire
#: penelope_stationery/penelope_third_bulletin/0/g-0/9/b/1
msgctxt "Penelope"
msgid "I like to think that our love helped make that happen."
msgstr "J'aime à penser que notre amour y a contribué."

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_bulletin/0/6
msgctxt "Penelope"
msgid "HELLO?? 75 PHOTOS!?"
msgstr "ALLÔÔÔ ?? 75 PHOTOS !?"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_bulletin/0/14
msgctxt "Penelope"
msgid "That's like most of the house!"
msgstr "C'est genre presque toute la maison !"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_bulletin/0/22/s/0
msgctxt "Choix"
msgid "I know!"
msgstr "Je sais !"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_bulletin/0/23/s/0
msgctxt "Choix"
msgid "Sorry not sorry!"
msgstr "{{Désolé|Désolée|Désolé·e}} pas {{désolé|désolée|désolé·e}} !"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_bulletin/0/g-0/0
msgctxt "Penelope"
msgid "Wow wow wow wow wow wow wow!"
msgstr "Ouah ouah ouah ouah ouah ouah ouah !"

# Traduction IA – à relire
#: penelope_stationery/penelope_fourth_bulletin/0/g-0/11
msgctxt "Penelope"
msgid "Keep up the amazing work! I know you can do it!"
msgstr "Continue ce travail extraordinaire ! Je sais que tu peux le faire !"

# Traduction IA – à relire
#: penelope_stationery/penelope_fifth_bulletin/0/6
msgctxt "Penelope"
msgid "NINETY PHOTOS ON THE BOARD!"
msgstr "QUATRE-VINGT-DIX PHOTOS SUR LE TABLEAU !"

# Traduction IA – à relire
#: penelope_stationery/penelope_fifth_bulletin/0/14/s/0
msgctxt "Choix"
msgid "THE HOUSE IS ALMOST MINE AGAIN!"
msgstr "LA MAISON EST PRESQUE DE NOUVEAU À MOI !"

# Traduction IA – à relire
#: penelope_stationery/penelope_fifth_bulletin/0/15/s/0
msgctxt "Choix"
msgid "It's been kinda quiet lately..."
msgstr "C'est un peu calme, ces derniers temps..."

# Traduction IA – à relire
#: penelope_stationery/penelope_fifth_bulletin/0/g-0/0
msgctxt "Penelope"
msgid "YOU ARE THIS CLOSE TO THE END... KEEP IT UP!"
msgstr "TU ES À DEUX DOIGTS DE LA FIN... CONTINUE !"

# Traduction IA – à relire
#: penelope_stationery/penelope_fifth_bulletin/0/g-0/8
msgctxt "Penelope"
msgid "I KNOW YOU CAN DO IT!"
msgstr "JE SAIS QUE TU PEUX Y ARRIVER !"

# Traduction IA – à relire
#: penelope_stationery/penelope_final_bulletin/0/6/b/1
msgctxt "Penelope"
msgid "We've got 98 photos... that really only leaves me and Skylar."
msgstr "On est à 98 photos... il ne reste vraiment que moi et Skylar."

# Traduction IA – à relire
#: penelope_stationery/penelope_final_bulletin/0/6/b/9 penelope_stationery/penelope_final_bulletin/0/7/b/1
msgctxt "Penelope"
msgid "I... I can't believe you basically saved me for last."
msgstr "Je... je n'arrive pas à croire que tu m'aies pratiquement gardée pour la fin."

# Traduction IA – à relire
#: penelope_stationery/penelope_final_bulletin/0/10/b/1
msgctxt "Penelope"
msgid "You must think I'm really cool..."
msgstr "Tu dois me trouver vraiment cool..."

# Traduction IA – à relire
#: penelope_stationery/penelope_final_bulletin/0/11/b/1
msgctxt "Penelope"
msgid "You must really love me."
msgstr "Tu dois vraiment m'aimer."

# Traduction IA – à relire
#: penelope_stationery/penelope_final_bulletin/0/14/s/0
msgctxt "Choix"
msgid "Oh yeah, totally."
msgstr "Oh ouais, carrément."

# Traduction IA – à relire
#: penelope_stationery/penelope_final_bulletin/0/15/s/0
msgctxt "Choix"
msgid "Pure coincidence."
msgstr "Pure coïncidence."

# Traduction IA – à relire
#: penelope_stationery/penelope_final_bulletin/0/16/s/0
msgctxt "Choix"
msgid "I was just gonna miss you too much."
msgstr "Tu m'aurais trop manqué, c'est tout."

# Traduction IA – à relire
#: penelope_stationery/penelope_final_bulletin/0/g-0/0
msgctxt "Penelope"
msgid "You're too nice to me..."
msgstr "Tu es trop adorable avec moi..."

# Traduction IA – à relire
#: penelope_stationery/penelope_final_bulletin/0/g-0/8
msgctxt "Penelope"
msgid "Only two of us left 'til the board is full. Really makes you think."
msgstr "Plus que deux avant que le tableau soit plein. Ça donne à réfléchir."

# Traduction IA – à relire
#: penelope_stationery/penelope_friend_return/0/0
msgctxt "Penelope"
msgid "Hey there buddy!"
msgstr "Salut, toi !"

# Traduction IA – à relire
#: penelope_stationery/penelope_friend_return/0/8
msgctxt "Penelope"
msgid "I still haven't found <i>the one</i> yet, but that's okay!"
msgstr "Je n'ai toujours pas trouvé <i>la perle rare</i>, mais c'est pas grave !"

# Traduction IA – à relire
#: penelope_stationery/penelope_friend_return/0/16
msgctxt "Penelope"
msgid "I'm still working on myself and you know what they say!"
msgstr "Je travaille encore sur moi-même, et vous savez ce qu'on dit !"

# Traduction IA – à relire
#: penelope_stationery/penelope_friend_return/0/24
msgctxt "Penelope"
msgid "\"The nice thing about teamwork is that you always have others on your side.\" — Margaret Party"
msgstr "« Ce qui est bien dans le travail d'équipe, c'est qu'on a toujours des gens de son côté. » — Margaret Party"

# Traduction IA – à relire
#: penelope_stationery/penelope_friend_return/0/32/s/0
msgctxt "Choix"
msgid "Yeah, totally."
msgstr "Ouais, carrément."

# Traduction IA – à relire
#: penelope_stationery/penelope_friend_return/0/33/s/0
msgctxt "Choix"
msgid "Thanks for the quote!"
msgstr "Merci pour la citation !"

# Traduction IA – à relire
#: penelope_stationery/penelope_friend_return/0/34/s/0 penelope_stationery/penelope_love_return/0/28/s/0
msgctxt "Choix"
msgid "I'm ready to Realize you, Penelope."
msgstr "Je suis {{prêt|prête|prêt·e}} à te Réaliser, Penelope."

# Traduction IA – à relire
#: penelope_stationery/penelope_friend_return/0/c-0/7 penelope_stationery/penelope_friend_return/0/c-1/7
msgctxt "Penelope"
msgid "Yeah! Just glad to know I've got your support on my journey to love."
msgstr "Ouais ! Je suis juste contente de savoir que tu me soutiens dans ma quête de l'amour."

# Traduction IA – à relire
#: penelope_stationery/penelope_friend_return/0/c-0/15
msgctxt "Penelope"
msgid "Let's hang out later, alright? I'm sorting through these old calendars..."
msgstr "On se voit plus tard, d'accord ? Je suis en train de trier ces vieux calendriers..."

# Traduction IA – à relire
#: penelope_stationery/penelope_friend_return/0/c-0/23 penelope_stationery/penelope_friend_return/0/c-1/23
msgctxt "Penelope"
msgid "So many good quotes in here..."
msgstr "Il y a tellement de bonnes citations là-dedans..."

# Traduction IA – à relire
#: penelope_stationery/penelope_friend_return/0/c-0/31 penelope_stationery/penelope_friend_return/0/c-1/31
msgctxt "Narrator"
msgid "You leave her to her quotes, certain that one day she will find the love she was always looking for among them."
msgstr "Vous la laissez à ses citations, avec la certitude que, un jour, elle y trouvera l'amour qu'elle a toujours cherché."

# Traduction IA – à relire
#: penelope_stationery/penelope_friend_return/0/c-1/15
msgctxt "Penelope"
msgid "Let's hang later, alright? I'm sorting through these old calendars..."
msgstr "On se voit plus tard, d'accord ? Je suis en train de trier ces vieux calendriers..."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_return/0/0
msgctxt "Penelope"
msgid "Hey there lover!"
msgstr "Salut, mon amour !"

# Traduction IA – à relire
#: penelope_stationery/penelope_love_return/0/8
msgctxt "Penelope"
msgid "Oh god, it sounds so weird outside of my head..."
msgstr "Oh mon dieu, ça sonne trop bizarre en dehors de ma tête..."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_return/0/16
msgctxt "Penelope"
msgid "JUST PRETEND I NEVER SAID IT! HAHAHA!"
msgstr "FAIS COMME SI JE NE L'AVAIS JAMAIS DIT ! HAHAHA !"

# Traduction IA – à relire
#: penelope_stationery/penelope_love_return/0/27/s/0
msgctxt "Choix"
msgid "It's okay, I like it."
msgstr "Ça va, ça me plaît."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_return/0/c-0/7
msgctxt "Penelope"
msgid "Uh, Oh. Okay!"
msgstr "Euh, oh. Okay !"

# Traduction IA – à relire
#: penelope_stationery/penelope_love_return/0/c-0/15
msgctxt "Penelope"
msgid "Good. Cause that's what we are... lovers..."
msgstr "Bien. Parce que c'est ce qu'on est... des amoureux..."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_return/0/c-0/23
msgctxt "Narrator"
msgid "She shoots you two adorable, if awkward, finger guns."
msgstr "Elle vous adresse deux pistolets-doigts adorables, quoique gauches."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_return/0/c-0/31
msgctxt "Penelope"
msgid "Pew pew... bang bang..."
msgstr "Pioum pioum... bang bang..."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_return/0/c-0/47
msgctxt "Penelope"
msgid "UH BYE!"
msgstr "EUH, SALUT !"

# Traduction IA – à relire
#: penelope_stationery/penelope_love_return/0/c-0/58
msgctxt "Narrator"
msgid "One day you will teach her that love can not be quite so awkward, but today is not that day."
msgstr "Un jour, vous lui apprendrez que l'amour n'a pas à être aussi gauche, mais ce jour n'est pas aujourd'hui."

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_return/0/0
msgctxt "Penelope"
msgid "Well well well!"
msgstr "Tiens, tiens, tiens !"

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_return/0/8
msgctxt "Penelope"
msgid "If isn't Casa Casanova!"
msgstr "Mais voilà Casa Casanova !"

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_return/0/16
msgctxt "Penelope"
msgid "Come to rub the fact that you're dating an entire house in my face?"
msgstr "Tu viens me jeter à la figure que tu sors avec une maison entière ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_return/0/24/s/0
msgctxt "Choix"
msgid "Basically."
msgstr "En gros."

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_return/0/25/s/0
msgctxt "Choix"
msgid "Come on, Penelope... we should be friends. (USE EMPATHY CANDY)"
msgstr "Allez, Penelope... on devrait être amis. (UTILISER UN BONBON D'EMPATHIE)"

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_return/0/c-0/7
msgctxt "Penelope"
msgid "WELL FUCK OFF! YOU DON'T THINK I KNOW THAT?!"
msgstr "ALORS DÉGAGE, PUTAIN ! TU CROIS QUE JE LE SAIS PAS ?!"

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_return/0/c-0/18
msgctxt "Penelope"
msgid "JUST LEAVE ME ALONE!"
msgstr "LAISSE-MOI TRANQUILLE !"

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_return/0/c-1/7
msgctxt "Penelope"
msgid "I've always said that though!"
msgstr "Mais c'est ce que j'ai toujours dit !"

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_return/0/c-1/15
msgctxt "Penelope"
msgid "We SHOULD be friends!"
msgstr "On DEVRAIT être amis !"

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_return/0/c-1/23
msgctxt "Penelope"
msgid "God I'm just so relieved... hating you sucked big time!"
msgstr "Mon dieu, je suis tellement soulagée... te détester, c'était franchement nul !"

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_return/0/c-1/31
msgctxt "Penelope"
msgid "Let's just start over, huh? In the words of Marker Twain..."
msgstr "Repartons de zéro, d'accord ? Pour reprendre les mots de Marker Twain..."

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_return/0/c-1/39
msgctxt "Penelope"
msgid "\"Synergy — the bonus that is achieved when things work together harmoniously.\""
msgstr "« Synergie : le bonus obtenu lorsque les choses fonctionnent ensemble en harmonie. »"

# Traduction IA – à relire
#: penelope_stationery/penelope_hate_return/0/c-1/47
msgctxt "Penelope"
msgid "Let's synergize! Friends!"
msgstr "Synergisons ! Amis !"

# Traduction IA – à relire
#: penelope_stationery/penelope_realize_join/0/0
msgctxt "Penelope"
msgid "Wait, really?! You're gonna Realize <i>me</i>!?"
msgstr "Attends, vraiment ?! Tu vas me Réaliser, <i>moi</i> !?"

# Traduction IA – à relire
#: penelope_stationery/penelope_realize_join/0/20/s/0
msgctxt "Choix"
msgid "Yep! Right now."
msgstr "Ouais ! Tout de suite."

# Traduction IA – à relire
#: penelope_stationery/penelope_realize_join/0/21/s/0
msgctxt "Choix"
msgid "No, sorry. I can't yet."
msgstr "Non, {{désolé|désolée|désolé·e}}. Je ne peux pas encore."

# Traduction IA – à relire
#: penelope_stationery/penelope_realize_join/0/c-1/10
msgctxt "Penelope"
msgid "Oh. Well hey, that's okay."
msgstr "Oh. Ben, c'est pas grave."

# Traduction IA – à relire
#: penelope_stationery/penelope_realize_join/0/c-1/18
msgctxt "Penelope"
msgid "Just let me know if you can later."
msgstr "Dis-moi juste si tu peux plus tard."

# Traduction IA – à relire
#: penelope_stationery/penelope_realize_return/0/0
msgctxt "Penelope"
msgid "Hey! You gonna do the Realization thing now?"
msgstr "Hé ! Tu vas faire le truc de la Réalisation, là ?"

# Traduction IA – à relire
#: penelope_stationery/penelope_realize_return/0/17/s/0
msgctxt "Choix"
msgid "Yep, I'm so ready..."
msgstr "Ouais, je suis tellement {{prêt|prête|prêt·e}}..."

# Traduction IA – à relire
#: penelope_stationery/penelope_realize_return/0/18/s/0
msgctxt "Choix"
msgid "No, sorry. Not yet."
msgstr "Non, {{désolé|désolée|désolé·e}}. Pas encore."

# Traduction IA – à relire
#: penelope_stationery/penelope_realize_return/0/c-1/10
msgctxt "Penelope"
msgid "Dang... really thought this was gonna be it."
msgstr "Mince... je pensais vraiment que c'était le moment."

# Traduction IA – à relire
#: penelope_stationery/penelope_realize_return/0/c-1/18
msgctxt "Penelope"
msgid "Oh well. Let me know when you actually wanna do it."
msgstr "Tant pis. Dis-moi quand tu voudras vraiment le faire."

# Traduction IA – à relire
#: penelope_stationery/penelope_realize_begin/6/b/1
msgctxt "Skylar"
msgid "I hope this Realization thing works with Penelope..."
msgstr "J'espère que ce truc de Réalisation marchera avec Penelope..."

# Traduction IA – à relire
#: penelope_stationery/penelope_realize_begin/9
msgctxt "Skylar"
msgid "Sorry we weren't meant for each other!!"
msgstr "Désolée qu'on n'ait pas été faites l'une pour l'autre !!"

# Traduction IA – à relire
#: penelope_stationery/penelope_realize_begin/23
msgctxt "Narrator"
msgid "The spectral energy flows through your dateviators, and what was once merely your collection of office supplies, becomes...."
msgstr "L'énergie spectrale traverse vos Dateviators, et ce qui n'était jusqu'ici que votre collection de fournitures de bureau devient..."

# Traduction IA – à relire
#: penelope_stationery/penelope_realized/0/3
msgctxt "Penelope"
msgid "Oh my god..."
msgstr "Oh mon dieu..."

# Traduction IA – à relire
#: penelope_stationery/penelope_realized/0/14
msgctxt "Penelope"
msgid "I... I thought being human would make me cooler... more confident."
msgstr "Je... je pensais qu'être humaine me rendrait plus cool... plus sûre de moi."

# Traduction IA – à relire
#: penelope_stationery/penelope_realized/0/22
msgctxt "Penelope"
msgid "But I think I'm MORE awkward?!"
msgstr "Mais je crois que je suis PLUS gauche ?!"

# Traduction IA – à relire
#: penelope_stationery/penelope_realized/0/30
msgctxt "Penelope"
msgid "None of my motivational quotes talked about what it's like to suddenly get a human body!"
msgstr "Aucune de mes citations motivantes ne disait ce que ça fait d'avoir soudain un corps humain !"

# Traduction IA – à relire
#: penelope_stationery/penelope_realized/0/38/s/0
msgctxt "Choix"
msgid "You don't need a quote for this, Penelope. You got this."
msgstr "Tu n'as pas besoin de citation pour ça, Penelope. Tu gères."

# Traduction IA – à relire
#: penelope_stationery/penelope_realized/0/39/s/0
msgctxt "Choix"
msgid "I've got a quote for you—\"wanna bang?\""
msgstr "J'en ai une pour toi : « on baise ? »"

# Traduction IA – à relire
#: penelope_stationery/penelope_realized/0/c-0/7
msgctxt "Penelope"
msgid "You still believe in me, even now..."
msgstr "Tu crois toujours en moi, même maintenant..."

# Traduction IA – à relire
#: penelope_stationery/penelope_realized/0/c-0/15
msgctxt "Narrator"
msgid "Her eyes fill with tears, and she begins to sob loudly."
msgstr "Ses yeux se remplissent de larmes et elle se met à sangloter bruyamment."

# Traduction IA – à relire
#: penelope_stationery/penelope_realized/0/c-0/23
msgctxt "Penelope"
msgid "YOU'RE J-JUST SO... NICE TO ME... WAHHH!"
msgstr "T-TU ES TELLEMENT... ADORABLE AVEC MOI... OUINNN !"

# Traduction IA – à relire
#: penelope_stationery/penelope_realized/0/c-0/34
msgctxt "Narrator"
msgid "She carries on like this for some time, before finally pulling away with a dramatic sniff."
msgstr "Elle continue ainsi un moment, avant de s'écarter enfin d'un reniflement théâtral."

# Traduction IA – à relire
#: penelope_stationery/penelope_realized/0/c-0/45
msgctxt "Penelope"
msgid "I'm g-gonna get outta here.. and make you so proud of me."
msgstr "Je vais m-me tirer d'ici... et te faire honneur."

# Traduction IA – à relire
#: penelope_stationery/penelope_realized/0/c-0/53
msgctxt "Penelope"
msgid "Just wait... just WAIT!"
msgstr "Attends un peu... attends seulement !"

# Traduction IA – à relire
#: penelope_stationery/penelope_love_divert/3
msgctxt "Narrator"
msgid "It takes Penelope a few moments to process your words, but when she does the look on her face is downright devilish."
msgstr "Il faut quelques instants à Penelope pour assimiler vos paroles, mais quand elle y parvient, son expression est carrément diabolique."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_divert/11
msgctxt "Narrator"
msgid "You've never seen her look quite so mischievous."
msgstr "Vous ne l'avez jamais vue avoir l'air aussi espiègle."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_divert/19
msgctxt "Penelope"
msgid "Oh... well..."
msgstr "Oh... eh bien..."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_divert/27
msgctxt "Narrator"
msgid "She looks down at you over the top of her glasses, a coy smile playing at her lips. It's entirely un-Penelope-like."
msgstr "Elle vous regarde par-dessus ses lunettes, un sourire en coin aux lèvres. C'est tout sauf du Penelope."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_divert/35
msgctxt "Penelope"
msgid "I lied... there's a great quote for this moment."
msgstr "J'ai menti... il y a une super citation pour ce moment."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_divert/43
msgctxt "Penelope"
msgid "\"Motivation is the art of getting people to do what you want them to do because they want to do it.\" — Kite D. Eisenhower"
msgstr "« La motivation, c'est l'art de pousser les gens à faire ce que vous voulez qu'ils fassent parce qu'ils ont envie de le faire. » — Kite D. Eisenhower"

# Traduction IA – à relire
#: penelope_stationery/penelope_love_divert/51
msgctxt "Penelope"
msgid "And baby... I want you to do it. To me."
msgstr "Et mon cœur... j'ai envie que tu le fasses. À moi."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_divert/62
msgctxt "Penelope"
msgid "The it being sex."
msgstr "Et ce « le », c'est le sexe."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_divert/70
msgctxt "Penelope"
msgid "...let's just go before I lose my new human confidence."
msgstr "...allons-y avant que je perde ma nouvelle confiance d'humaine."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_divert/78
msgctxt "Narrator"
msgid "Penelope is deeply awkward, as it turns out, but when her glasses come off and the lights go down she manages to find her footing with you."
msgstr "Penelope est profondément gauche, finalement, mais quand ses lunettes tombent et que les lumières s'éteignent, elle finit par trouver ses marques avec vous."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_divert/86
msgctxt "Narrator"
msgid "Motivational office quotes are replaced by impassioned cries of your name, and sounds that would make even the most experienced lover blush."
msgstr "Les citations motivantes de bureau cèdent la place à des cris passionnés de votre nom et à des sons qui feraient rougir même l'amant le plus expérimenté."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_divert/94
msgctxt "Narrator"
msgid "When she leaves in the morning Penelope promises you she'll return as soon as she can. Through tears, she assures you she'll make her mark on the world out there with one last motivational quote:"
msgstr "Quand elle part au matin, Penelope vous promet de revenir dès qu'elle le pourra. À travers ses larmes, elle vous assure qu'elle laissera sa marque sur le monde, là-dehors, avec une dernière citation motivante :"

# Traduction IA – à relire
#: penelope_stationery/penelope_love_divert/102
msgctxt "Narrator"
msgid "\"A dream doesn’t become reality through magic; it takes sweat, determination and hard work.\" — Colon Powell"
msgstr "« Un rêve ne devient pas réalité par magie ; il faut de la sueur, de la détermination et du travail acharné. » — Colon Powell"

# Traduction IA – à relire
#: penelope_stationery/penelope_love_join/0
msgctxt "Narrator"
msgid "Penelope takes up work at a national office supply retailer, but quits soon after, finding it all a bit too close to home."
msgstr "Penelope décroche un poste dans une grande enseigne nationale de fournitures de bureau, mais démissionne peu après, trouvant tout cela un peu trop proche de chez elle."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_join/8
msgctxt "Narrator"
msgid "She tries again as a librarian, but is fired when she can't stop shouting motivational quotes at library patrons."
msgstr "Elle retente sa chance comme bibliothécaire, mais se fait renvoyer car elle ne peut s'empêcher de hurler des citations motivantes aux lecteurs."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_join/16
msgctxt "Narrator"
msgid "It's not until she's hired as a personal assistant to a high-powered CEO at a massive media company that she finally finds her place."
msgstr "Ce n'est que lorsqu'elle est engagée comme assistante personnelle d'un PDG influent dans un énorme groupe de médias qu'elle trouve enfin sa place."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_join/24
msgctxt "Narrator"
msgid "For every motivational quote she shares, the CEO meets her with another—and as a firm believer in using pen, paper, and fax machines her new boss is constantly purchasing and using office supplies."
msgstr "À chaque citation motivante qu'elle partage, le PDG lui en renvoie une autre ; et, fervent adepte du stylo, du papier et du fax, son nouveau patron achète et utilise sans cesse des fournitures de bureau."

# Traduction IA – à relire
#: penelope_stationery/penelope_love_join/32
msgctxt "Penelope"
msgid "It's just nice to know some people still believe in the old ways."
msgstr "C'est juste agréable de savoir que certaines personnes croient encore aux vieilles méthodes."
