#: betty_bed/betty_friendshipending/0/32/s/0
msgctxt "Choix"
msgid "Of course."
msgstr ""

#: betty_bed/betty_friendshipending/0/33/s/0
msgctxt "Choix"
msgid "Take all the time you need."
