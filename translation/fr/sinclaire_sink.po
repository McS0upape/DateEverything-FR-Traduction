msgstr ""

#: sinclaire_sink/SinclaireIsTurtle/0/c-0/21/c-0/7
msgctxt "Sinclaire"
msgid "Since 1987, baby!"
msgstr ""

#: sinclaire_sink/MartinForever/0/12
msgctxt "Sinclaire"
msgid "Hello there!"
msgstr ""

#: sinclaire_sink/MartinForever/0/20
msgctxt "Sinclaire"
msgid "Can I interest you in a claim?"
msgstr ""

#: sinclaire_sink/MartinForever/0/28
msgctxt "Sinclaire"
msgid "Or perhaps an adjustment?"
msgstr ""

#: sinclaire_sink/MartinForever/0/36/s/0
msgctxt "Choix"
msgid "I'll take one of each, please."
msgstr ""

#: sinclaire_sink/MartinForever/0/37/s/0
msgctxt "Choix"
msgid "Just the claim, today."
msgstr ""

#: sinclaire_sink/MartinForever/0/38/s/0
msgctxt "Choix"
msgid "Just an adjustment, thanks."
msgstr ""

#: sinclaire_sink/MartinForever/0/c-0/7
msgctxt "Sinclaire"
msgid "I claim to be a man named Martin Applegate."
msgstr ""

#: sinclaire_sink/MartinForever/0/c-0/15
msgctxt "Sinclaire"
msgid "Now, let me just adjust that..."
msgstr ""

#: sinclaire_sink/MartinForever/0/c-0/23
msgctxt "Sinclaire"
msgid "I claim to be a fish named Steven Brinklemew."
msgstr ""

#: sinclaire_sink/MartinForever/0/c-0/31
msgctxt "Sinclaire"
msgid "Ok! All done!"
msgstr ""

#: sinclaire_sink/MartinForever/0/c-0/39
msgctxt "Sinclaire"
msgid "If you would please remain on the line to take a brief survey."
msgstr ""

#: sinclaire_sink/MartinForever/0/c-0/47
msgctxt "Sinclaire"
msgid "How would you rate my services on a scale of 1 to Crustacean?"
msgstr ""

#: sinclaire_sink/MartinForever/0/c-0/55/2/s/0
msgctxt "Choix"
msgid "Prime numbers are a lie."
msgstr ""

#: sinclaire_sink/MartinForever/0/c-0/55/3/s/0
msgctxt "Choix"
msgid "Shrimp scampi."
msgstr ""

#: sinclaire_sink/MartinForever/0/c-0/55/c-0/7 sinclaire_sink/MartinForever/0/c-0/55/c-1/7
msgctxt "Sinclaire"
msgid "Correct."
msgstr ""

#: sinclaire_sink/MartinForever/0/c-0/55/c-2/7
msgctxt "Sinclaire"
msgid "I always knew I could count on you."
msgstr ""

#: sinclaire_sink/MartinForever/0/c-0/55/c-3/7 sinclaire_sink/MartinForever/0/c-2/18/c-0/7
msgctxt "Sinclaire"
msgid "Goodbye."
msgstr ""

#: sinclaire_sink/MartinForever/0/c-1/7
msgctxt "Sinclaire"
msgid "I claim to be a direct descendent of Big Ben."
msgstr ""

#: sinclaire_sink/MartinForever/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "The clock?"
msgstr ""

#: sinclaire_sink/MartinForever/0/c-1/15/c-0/7
msgctxt "Sinclaire"
msgid "Obviously the clock."
msgstr ""

#: sinclaire_sink/MartinForever/0/c-2/7
msgctxt "Sinclaire"
msgid "Your taxes have been adjusted to reflect 10x more income."
msgstr ""

#: sinclaire_sink/MartinForever/0/c-2/18/0/s/0
msgctxt "Choix"
msgid "Wait, no, I don't—"
msgstr ""

#: sinclaire_sink/martinforever_2/0/0
msgctxt "Sinclaire"
msgid "Hello and welcome to Sinkman's Surplus."
msgstr ""

#: sinclaire_sink/martinforever_2/0/8
msgctxt "Sinclaire"
msgid "May I take your order?"
msgstr ""

#: sinclaire_sink/martinforever_2/0/16
msgctxt "Sinclaire"
msgid "And before you say any thing I MUST ADD..."
msgstr ""

#: sinclaire_sink/martinforever_2/0/35
msgctxt "Sinclaire"
msgid "I'm almost out of pens."
msgstr ""

#: sinclaire_sink/martinforever_2/0/43/s/0
msgctxt "Choix"
msgid "That's okay, I'll come back later."
msgstr ""

#: sinclaire_sink/martinforever_2/0/c-0/7
msgctxt "Sinclaire"
msgid "You have selected \"Come Back Now\"."
msgstr ""

#: sinclaire_sink/martinforever_2/0/c-0/18
msgctxt "Sinclaire"
msgid "To confirm this option, please press 1."
msgstr ""

#: sinclaire_sink/martinforever_2/0/c-0/26
msgctxt "Sinclaire"
msgid "Para espanol, oprima numero dos."
msgstr ""

#: sinclaire_sink/martinforever_2/0/c-0/34/1/s/0
msgctxt "Choix"
msgid "Dos."
msgstr ""

#: sinclaire_sink/martinforever_2/0/c-0/34/c-0/7
msgctxt "Sinclaire"
msgid "We are closed."
msgstr ""

#: sinclaire_sink/martinforever_2/0/c-0/34/c-1/7
msgctxt "Sinclaire"
msgid "Au revoir."
msgstr ""

#: sinclaire_sink/SinclaireNeverSolved/0/0
msgctxt "Sinclaire"
msgid "Hi there, pal."
msgstr ""

#: sinclaire_sink/SinclaireNeverSolved/0/8
msgctxt "Sinclaire"
msgid "Nice to see you."
msgstr ""

#: sinclaire_sink/SinclaireNeverSolved/0/16/s/0
msgctxt "Choix"
msgid "Are you okay?"
msgstr ""

#: sinclaire_sink/SinclaireNeverSolved/0/17/s/0
msgctxt "Choix"
msgid "Actually, Sinclaire. I have interesting news about what these dateviators can do."
msgstr ""

#: sinclaire_sink/SinclaireNeverSolved/0/c-0/7
msgctxt "Sinclaire"
msgid "You caught me in the midst of a bout of longing."
msgstr ""

#: sinclaire_sink/SinclaireNeverSolved/0/c-0/15
msgctxt "Sinclaire"
msgid "Perhaps it would be best if you came back later."
msgstr ""

#: sinclaire_sink/sinclaire_realize_join/0/3
msgctxt "Sinclaire"
msgid "Am I... supposed to do something?"
msgstr ""

#: sinclaire_sink/sinclaire_realize_join/0/11
msgctxt "Sinclaire"
msgid "Dance in a certain manner?"
msgstr ""

#: sinclaire_sink/sinclaire_realize_join/0/19
msgctxt "Sinclaire"
msgid "How about like this?"
msgstr ""

#: sinclaire_sink/sinclaire_realize_join/0/30
msgctxt "Narrator"
msgid "Sinclaire begins dancing erratically."
msgstr ""

#: sinclaire_sink/sinclaire_realize_join/0/47/s/0
msgctxt "Choix"
msgid "Keep that up - it's working!"
msgstr ""

#: sinclaire_sink/sinclaire_realize_join/0/c-1/10
msgctxt "Sinclaire"
msgid "I will keeping working on my moves."
msgstr ""

#: sinclaire_sink/sinclaire_realize_return/0/0
msgctxt "Narrator"
msgid "Sinclaire is still doing the same weird dance he was doing before... is it possible he just never stopped?"
msgstr ""

#: sinclaire_sink/sinclaire_realize_return/0/8
msgctxt "Sinclaire"
msgid "<i>Still dancing... </i>"
msgstr ""

#: sinclaire_sink/sinclaire_realize_return/0/22
msgctxt "Sinclaire"
msgid "<w>Now sweating... profusely... </w>"
msgstr ""

#: sinclaire_sink/sinclaire_realize_return/0/42/s/0
msgctxt "Choix"
msgid "Hope you're ready - this is gonna be fun!"
msgstr ""

#: sinclaire_sink/sinclaire_realize_return/0/43/s/0
msgctxt "Choix"
msgid "Keep going Sinclaire, I'll be back!"
msgstr ""

#: sinclaire_sink/sinclaire_realize_return/0/c-1/10
msgctxt "Sinclaire"
msgid "<i>Vomits</i>"
msgstr ""

#: sinclaire_sink/sinclaire_realize_begin/9/b/1
msgctxt "Skylar"
msgid "First to be Realized is the strangest sink of all..."
msgstr ""

#: sinclaire_sink/sinclaire_realize_begin/12
msgctxt "Skylar"
msgid "Okay Mr. Sink - I can't wait to see what happens!"
msgstr ""

#: sinclaire_sink/sinclaire_realize_begin/23
msgctxt "Narrator"
msgid "The spectral energy flows through your dateviators, and what was once merely a sink, becomes...."
msgstr ""

#: sinclaire_sink/sinclaire_realized_sorter/0/8
msgctxt "Sinclaire"
msgid "I have to say it is astonishing how much being a human feels exactly like being a sink."
msgstr ""

#: sinclaire_sink/sinclaire_realized_sorter/0/16
msgctxt "Sinclaire"
msgid "No wonder I was mistaken for so long!"
msgstr ""

#: sinclaire_sink/sinclaire_realized_sorter/0/24
msgctxt "Sinclaire"
msgid "This... what do you call it... Adam's apple?"
msgstr ""

#: sinclaire_sink/sinclaire_realized_sorter/0/32/s/0
msgctxt "Choix"
msgid "Sure?"
msgstr ""

#: sinclaire_sink/sinclaire_realized_sorter/0/g-0/0
msgctxt "Sinclaire"
msgid "It feels exactly like a strainer flange!"
msgstr ""

#: sinclaire_sink/sinclaire_realized_sorter/0/g-0/11/s/0
msgctxt "Choix"
msgid "I see!"
msgstr ""

#: sinclaire_sink/sinclaire_realized_sorter/0/g-0/12/s/0
msgctxt "Choix"
msgid "I can only imagine..."
msgstr ""

#: sinclaire_sink/sinclaire_realized_sorter/0/g-1/0
msgctxt "Sinclaire"
msgid "Now, you must have more experience with this..."
msgstr ""

#: sinclaire_sink/sinclaire_realized_sorter/0/g-1/8
msgctxt "Sinclaire"
msgid "Which one is my hot water hand?"
msgstr ""

#: sinclaire_sink/sinclaire_realized_sorter/0/g-1/16
msgctxt "Sinclaire"
msgid "They both appear to be the same temperature."
msgstr ""

#: sinclaire_sink/sinclaire_realized_sorter/0/g-1/24/s/0
msgctxt "Choix"
msgid "It's okay, Sinclaire. We'll figure it out eventually."
msgstr ""

#: sinclaire_sink/sinclaire_realized_sorter/0/g-1/25/s/0
msgctxt "Choix"
msgid "I could show you a lot about your new body... if you'll let me."
msgstr ""

#: sinclaire_sink/sinclaire_love_divert/0
msgctxt "Sinclaire"
msgid "Oh I'll let you."
msgstr ""

#: sinclaire_sink/sinclaire_love_divert/8
msgctxt "Narrator"
msgid "It begins with a steady drip of caresses... as Sinclaire begins to use his body for the first time."
msgstr ""

#: sinclaire_sink/sinclaire_love_divert/16
msgctxt "Narrator"
msgid "The energy between you flows naturally and freely."
msgstr ""

#: sinclaire_sink/sinclaire_love_divert/24
msgctxt "Narrator"
msgid "As the pressure mounts, the two of you find yourselves awash in pleasure."
msgstr ""

#: sinclaire_sink/sinclaire_love_divert/32
msgctxt "Sinclaire"
msgid "AUGH!"
msgstr ""

#: sinclaire_sink/sinclaire_love_divert/46
msgctxt "Narrator"
msgid "Sinclaire becomes highly excited... and with an abundant liquid rush, the experience is over, leaving you soaked and eager for more."
msgstr ""

#: sinclaire_sink/sinclaire_love_join/0
msgctxt "Narrator"
msgid "Sinclaire slinks out of your house, and directly into the public eye."
msgstr ""

#: sinclaire_sink/sinclaire_love_join/8
msgctxt "Narrator"
msgid "While accidentally appearing onstage during a political debate, he trounces his baffled opponents. He offers surprisingly fresh perspectives on international trade policy and criminal justice reform."
msgstr ""

#: sinclaire_sink/sinclaire_love_join/16
msgctxt "Sinclaire"
msgid "More broccoli! Less florets!"
msgstr ""

#: sinclaire_sink/sinclaire_love_join/27
msgctxt "Narrator"
msgid "Coining the catchphrase \"Don't Let It All Go Down the Drain\" - he breezes through the primaries and wins the Presidential Election with an overwhelming 80% of the popular vote."
msgstr ""

#: sinclaire_sink/sinclaire_love_join/38
msgctxt "Narrator"
msgid "On Inauguration Day, Sinclaire forgets to show up for the entirety of his first term in office."
msgstr ""

#: sinclaire_sink/sinclaire_love_join/43
msgctxt "Narrator"
msgid "And promptly wins a second."
msgstr ""

#: sinclaire_sink/sinclaire_realized_martin/0/7
msgctxt "Martin Applegate"
msgid "Ah! I can breathe again!"
msgstr ""

#: sinclaire_sink/sinclaire_realized_martin/0/18
msgctxt "Martin Applegate"
msgid "It feels so good to have an esophagus and all that goes with it, like the little dangly thing back there?"
msgstr ""

#: sinclaire_sink/sinclaire_realized_martin/0/26/s/0
msgctxt "Choix"
msgid "A uvula?"
msgstr ""

#: sinclaire_sink/sinclaire_realized_martin/0/27/s/0
msgctxt "Choix"
msgid "A fibula?"
msgstr ""

#: sinclaire_sink/sinclaire_realized_martin/0/28/s/0
msgctxt "Choix"
msgid "A puffed pastry?"
msgstr ""

#: sinclaire_sink/sinclaire_realized_martin/0/29/s/0
msgctxt "Choix"
msgid "A dangler?"
msgstr ""

#: sinclaire_sink/sinclaire_realized_martin/0/c-0/7
msgctxt "Martin Applegate"
msgid "No thank you, I'm quite full."
msgstr ""

#: sinclaire_sink/sinclaire_realized_martin/0/c-1/7
msgctxt "Martin Applegate"
msgid "There are only seven!"
msgstr ""

#: sinclaire_sink/sinclaire_realized_martin/0/c-2/7
msgctxt "Martin Applegate"
msgid "Precisely. A kabocha squash."
msgstr ""

#: sinclaire_sink/sinclaire_realized_martin/0/c-3/7
msgctxt "Martin Applegate"
msgid "Be sure to save your files, first."
msgstr ""

#: sinclaire_sink/sinclaire_realized_martin/0/g-0/0
msgctxt "Martin Applegate"
msgid "Ah, dear companion, you've made my dreams come true!"
msgstr ""

#: sinclaire_sink/sinclaire_realized_martin/0/g-0/11/s/0
msgctxt "Choix"
msgid "Would you like to make one of mine come true?"
msgstr ""

#: sinclaire_sink/sinclaire_realized_martin/0/g-0/12/s/0
msgctxt "Choix"
msgid "You did it, you were a human all along!"
msgstr ""

#: sinclaire_sink/sinclaire_realized_martin/0/g-0/c-4/10
msgctxt "Martin Applegate"
msgid "I thought you'd never ask."
msgstr ""

#: sinclaire_sink/sinclaire_realized_martin/0/g-0/c-4/18
msgctxt "Narrator"
msgid "What follows is astonishingly inventive, and utterly mundane at the same time. If you find that in any way confusing, congratulations. That seems to be the mark Martin has chosen to leave on the world."
msgstr ""

#: sinclaire_sink/sinclaire_realized_martin/0/g-0/c-4/29
msgctxt "Narrator"
msgid "When all is said and done, you feel as if you are a claim..."
msgstr ""

#: sinclaire_sink/sinclaire_realized_martin/0/g-0/c-4/34
msgctxt "Narrator"
msgid "One that has been adjusted to complete satisfaction."
msgstr ""

#: sinclaire_sink/sinclaire_realized_martin/0/g-1/0
msgctxt "Martin Applegate"
msgid "Now I can finally make my way back to Turkleman City."
msgstr ""

#: sinclaire_sink/sinclaire_realized_martin/0/g-1/11
msgctxt "Martin Applegate"
msgid "Do they still have those... winged transportation things?"
msgstr ""

#: sinclaire_sink/sinclaire_realized_martin/0/g-1/19/s/0
msgctxt "Choix"
msgid "Planes?"
msgstr ""

#: sinclaire_sink/sinclaire_realized_martin/0/g-1/c-6/7
msgctxt "Martin Applegate"
msgid "Buses!"
msgstr ""

#: sinclaire_sink/sinclaire_realized_martin/0/g-2/0
msgctxt "Martin Applegate"
msgid "Yes exactly."
msgstr ""

#: sinclaire_sink/sinclaire_realized_martin/0/g-2/8
msgctxt "Martin Applegate"
msgid "Please point me to the nearest Bus Port."
msgstr ""

#: sinclaire_sink/sinclaire_realized_martin/0/g-2/19
msgctxt "Narrator"
msgid "Regardless of the direction you point, Martin climbs out the window, and disappears."
msgstr ""

#: sinclaire_sink/sinclaire_realized_martin/0/g-2/33
msgctxt "Skylar"
msgid "And just like that... he was gone."
msgstr ""

#: sinclaire_sink/sinclaire_realized_martin/0/g-2/44
msgctxt "Narrator"
msgid "Martin returned to his wife and children, who had missed him greatly."
msgstr ""

#: sinclaire_sink/sinclaire_realized_martin/0/g-2/49
msgctxt "Narrator"
msgid "From then on out, they washed hands and dishes in basins only."
msgstr ""

#: sinclaire_sink/sinclaire_realized_martin/0/g-2/54
msgctxt "Narrator"
msgid "Late one night, Martin returned to Vagabonda's shop, determined to even the score."
msgstr ""

#: sinclaire_sink/sinclaire_realized_martin/0/g-2/59
msgctxt "Narrator"
msgid "He ended up purchasing several new shovels instead, and joined Vagabonda's knitting club."
msgstr ""

#: sinclaire_sink/sinclaire_realized_martin/0/g-2/64
msgctxt "Narrator"
msgid "The two of them are fast friends - and Vagabonda's cursing days are over."
msgstr ""

#: sinclaire_sink/sinclaire_turtle_realize/0/7
msgctxt "Sinclaire"
msgid "<w>... tur... </w>"
msgstr ""

#: sinclaire_sink/sinclaire_turtle_realize/0/15
msgctxt "Sinclaire"
msgid "<w>... tle... </w>"
msgstr ""

#: sinclaire_sink/sinclaire_turtle_realize/0/23
msgctxt "Skylar"
msgid "Well... you did it!"
msgstr ""

#: sinclaire_sink/sinclaire_turtle_realize/0/34
msgctxt "Narrator"
msgid "Indeed, Sinclaire's true form was never in doubt: He was a pygmy box turtle all along."
msgstr ""

#: sinclaire_sink/sinclaire_turtle_realize/0/42
msgctxt "Narrator"
msgid "Congratulations, you did it."
msgstr ""

#: sinclaire_sink/sinclaire_turtle_realize/0/50/s/0
msgctxt "Choix"
msgid "Can I kiss it?"
msgstr ""

#: sinclaire_sink/sinclaire_turtle_realize/0/51/s/0
msgctxt "Choix"
msgid "I did it. I win!"
msgstr ""

#: sinclaire_sink/sinclaire_turtle_realize/0/c-0/10
msgctxt "Skylar"
msgid "You can give it a little peck on its turtle-y beak."
msgstr ""

#: sinclaire_sink/sinclaire_turtle_realize/0/c-0/21
msgctxt "Skylar"
msgid "If you like?"
msgstr ""

#: sinclaire_sink/sinclaire_turtle_realize/0/c-0/29/0/s/0
msgctxt "Choix"
msgid "Hell yeah."
msgstr ""

#: sinclaire_sink/sinclaire_turtle_realize/0/c-0/29/1/s/0
msgctxt "Choix"
msgid "Nah, that is weird."
msgstr ""

#: sinclaire_sink/sinclaire_turtle_realize/0/c-0/29/c-0/7
msgctxt "Narrator"
msgid "You do so."
msgstr ""

#: sinclaire_sink/sinclaire_turtle_realize/0/c-0/29/c-0/15
msgctxt "Narrator"
msgid "<i>bip</i>"
msgstr ""

#: sinclaire_sink/sinclaire_turtle_realize/0/c-0/29/c-0/23
msgctxt "Sinclaire"
msgid "<w>... .turtle... </w>"
msgstr ""

#: sinclaire_sink/sinclaire_turtle_realize/0/g-0/0
msgctxt "Narrator"
msgid "In turtle form, Sinclaire sought out greener pastures: a favorable climate zone with swampy vegetation, a better dew point, and at least ten gallons of water per inch of shell length."
msgstr ""
