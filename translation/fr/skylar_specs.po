#: skylar_specs/suspension_explain/0/g-0/36/s/0
msgctxt "Choix"
msgid "I'm sorry to hear that."
msgstr ""

#: skylar_specs/suspension_explain/0/g-0/c-3/7
msgctxt "Skylar"
msgid "Ding, ding!! That's exactly the thing..."
