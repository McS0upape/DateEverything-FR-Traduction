msgstr "Cui cuiiiit cuicui cui."

# Traduction IA – à relire
#: wyndolyn_window/wyndolyn_west_3/0/g-5/c-12/83/c-0/122/c-0/124 wyndolyn_window/wyndolyn_west_3/0/g-5/c-12/83/c-0/122/c-1/99 wyndolyn_window/wyndolyn_west_3/0/g-5/c-12/83/c-1/70/c-0/124 wyndolyn_window/wyndolyn_west_3/0/g-5/c-12/83/c-1/70/c-1/102 wyndolyn_window/wyndolyn_west_3/0/g-5/c-13/21/c-0/133/c-0/121 wyndolyn_window/wyndolyn_west_3/0/g-5/c-13/21/c-0/133/c-1/102
msgctxt "Wyndolyn"
msgid "I am NOT acrylic! How dare you insult me like that."
msgstr "Je ne suis PAS en acrylique ! Comment osez-vous m'insulter comme ça."

# Traduction IA – à relire
#: wyndolyn_window/wyndolyn_west_3/0/g-5/c-12/83/c-0/122/c-0/138 wyndolyn_window/wyndolyn_west_3/0/g-5/c-12/83/c-0/122/c-1/113 wyndolyn_window/wyndolyn_west_3/0/g-5/c-12/83/c-1/70/c-0/138 wyndolyn_window/wyndolyn_west_3/0/g-5/c-12/83/c-1/70/c-1/116 wyndolyn_window/wyndolyn_west_3/0/g-5/c-13/21/c-0/133/c-0/135 wyndolyn_window/wyndolyn_west_3/0/g-5/c-13/21/c-0/133/c-1/116
msgctxt "Wyndolyn"
msgid "Come on. Close me. I don't want to deal with this anymore."
msgstr "Allez. Ferme-moi. Je ne veux plus avoir affaire à ça."

# Traduction IA – à relire
#: wyndolyn_window/wyndolyn_west_3/0/g-5/c-12/83/c-0/122/c-1/7 wyndolyn_window/wyndolyn_west_3/0/g-5/c-12/83/c-1/70/c-1/7 wyndolyn_window/wyndolyn_west_3/0/g-5/c-13/21/c-0/133/c-1/7
msgctxt "Wyndolyn"
