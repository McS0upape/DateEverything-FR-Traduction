#: hime_anime/Hero_Tennis_1_Cont/0/0
msgctxt "Hero-Hime"
msgid "<i>The rival froze.</i>"
msgstr "<i>Le rival se figea.</i>"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/8
msgctxt "Hero-Hime"
msgid "<i>You're the rival by the way sorry.</i>"
msgstr "<i>Au fait, le rival, c'est toi, désolée.</i>"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/16/b/1
msgctxt "Hero-Hime"
msgid "<i>He had never experienced a shot like this before.</i>"
msgstr "<i>Il n'avait jamais connu un tir pareil.</i>"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/17/b/1
msgctxt "Hero-Hime"
msgid "<i>She had never experienced a shot like this before.</i>"
msgstr "<i>Elle n'avait jamais connu un tir pareil.</i>"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/18/b/1
msgctxt "Hero-Hime"
msgid "<i>They had never experienced a shot like this before.</i>"
msgstr "<i>Iel n'avait jamais connu un tir pareil.</i>"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/21
msgctxt "Hero-Hime"
msgid "<i>The ball arced perfectly towards the heavens, eclipsing the sun!</i>"
msgstr "<i>La balle décrivit un arc parfait vers les cieux, éclipsant le soleil !</i>"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/29/b/1
msgctxt "Hero-Hime"
msgid "<i>Aren't we in an indoor court? He thought.</i>"
msgstr "<i>On n'est pas dans une salle couverte ? pensa-t-il.</i>"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/30/b/1
msgctxt "Hero-Hime"
msgid "<i>Aren't we in an indoor court? She thought.</i>"
msgstr "<i>On n'est pas dans une salle couverte ? pensa-t-elle.</i>"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/31/b/1
msgctxt "Hero-Hime"
msgid "<i>Aren't we in an indoor court? They thought.</i>"
msgstr "<i>On n'est pas dans une salle couverte ? pensa iel.</i>"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/34
msgctxt "Hero-Hime"
msgid "<i>And why is she narrating my thoughts?</i>"
msgstr "<i>Et pourquoi elle narre mes pensées ?</i>"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/42
msgctxt "Hero-Hime"
msgid "<i>None of that matters. What matters is how I follow up a slow moving, easy to hit falling target like this.</i>"
msgstr "<i>Peu importe. Ce qui compte, c'est la suite que je donne à une cible tombante, lente et facile à frapper comme celle-ci.</i>"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/50/s/0
msgctxt "Choix"
msgid "<i>Overhead Smash</i>"
msgstr "<i>Smash</i>"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/51/s/0
msgctxt "Choix"
msgid "It's like a spike or dunk, you should blast that ball!"
msgstr "C'est comme un smash de volley ou un dunk, tu dois pulvériser cette balle !"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/c-0/7
msgctxt "Hero-Hime"
msgid "<i>That's right! I should smash it back!</i>"
msgstr "<i>C'est ça ! Je dois la renvoyer en smash !</i>"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/c-1/7
msgctxt "Hero-Hime"
msgid "<i>Bringing in other sports analogies... what an unexpected move!</i>"
msgstr "<i>Faire intervenir d'autres analogies sportives... quelle manoeuvre inattendue !</i>"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-0/0
msgctxt "Hero-Hime"
msgid "<i>But wait! Why is she at the net?</i>"
msgstr "<i>Mais un instant ! Pourquoi est-elle au filet ?</i>"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-0/8
msgctxt "Hero-Hime"
msgid "<i>Why is she trying something so risky?!</i>"
msgstr "<i>Pourquoi tente-t-elle un truc aussi risqué ?!</i>"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-0/16
msgctxt "Hero-Hime"
msgid "<i>Is this the semi-supernatural part of a sports anime?</i>"
msgstr "<i>C'est la partie semi-surnaturelle d'un anime de sport ?</i>"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-0/24
msgctxt "Hero-Hime"
msgid "<i>The protagonist's not-so-unrealistic superpower to show that they're special?</i>"
msgstr "<i>Le superpouvoir pas si irréaliste du protagoniste pour montrer que c'est quelqu'un de spécial ?</i>"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-0/32
msgctxt "Hero-Hime"
msgid "<i>Is all this too much expositional dialogue or does the player not watch enough anime?</i>"
msgstr "<i>Y a-t-il trop de dialogues d'exposition, ou le public ne regarde-t-il pas assez d'anime ?</i>"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-0/40
msgctxt "Hero-Hime"
msgid "You should have kept me back at the baseline!"
msgstr "Il fallait me garder au fond du court !"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-0/48
msgctxt "Hero-Hime"
msgid "Because up at the net, my reactions are sick!"
msgstr "Parce qu'au filet, j'ai des réflexes de malade !"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-0/56
msgctxt "Hero-Hime"
msgid "<i>Galaxy Reaction: Super Volley Counter Cannon!</i>"
msgstr "<i>Réaction Galactique : Super Canon de Contre-Volée !</i>"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-0/64
msgctxt "Hero-Hime"
msgid "<i>And just like that, the match is over. 60 points scored in a single counter-attack.</i>"
msgstr "<i>Et voilà, le match est terminé. 60 points marqués en une seule contre-attaque.</i>"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-0/72
msgctxt "Hero-Hime"
msgid "Woohoo! That was a great rally!"
msgstr "Youhou ! Quel super échange !"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-0/80
msgctxt "Hero-Hime"
msgid "Let's call it for today."
msgstr "On s'arrête là pour aujourd'hui."

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-0/88
msgctxt "Hero-Hime"
msgid "Your footwork already improved so much during that match!"
msgstr "Ton jeu de jambes s'est déjà tellement amélioré pendant ce match !"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-0/107
msgctxt "Hero-Hime"
msgid "See? Even Nekoboru agrees!"
msgstr "Tu vois ? Même Nekoboru est d'accord !"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-0/115
msgctxt "Hero-Hime"
msgid "How was it for you?"
msgstr "Et pour toi, c'était comment ?"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-0/123/s/0
msgctxt "Choix"
msgid "I'm exhausted."
msgstr "J'en peux plus."

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-0/124/s/0
msgctxt "Choix"
msgid "My ribs! Again!"
msgstr "Mes côtes ! Encore !"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-0/125/s/0
msgctxt "Choix"
msgid "I feel great!"
msgstr "Je me sens super bien !"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-0/c-2/7
msgctxt "Hero-Hime"
msgid "Aww... it'll get better the more you practice!"
msgstr "Oh... ça ira de mieux en mieux avec la pratique !"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-0/c-3/11
msgctxt "Hero-Hime"
msgid "Breaking ribs is all part of the process."
msgstr "Se casser des côtes, ça fait partie du processus."

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-0/c-4/7
msgctxt "Hero-Hime"
msgid "Yayy!"
msgstr "Yaaay !"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-1/0
msgctxt "Hero-Hime"
msgid "Let's close out with a light cooldown jog while we chat!"
msgstr "Terminons par un petit footing de récupération en discutant !"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-1/8
msgctxt "Hero-Hime"
msgid "So... what kind of anime protagonists do you like following?"
msgstr "Alors... quel genre de protagonistes d'anime tu aimes suivre ?"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-1/16
msgctxt "Hero-Hime"
msgid "I'll take an underdog klutz over an overrated chosen one any day."
msgstr "Je préfère un outsider maladroit à un élu surcoté, n'importe quel jour."

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-1/24/s/0
msgctxt "Choix"
msgid "I don't really like watching anime <i>that</i> much."
msgstr "Je n'aime pas <i>tant que ça</i> regarder des animes."

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-1/25/s/0
msgctxt "Choix"
msgid "The overpowered isekai hero with zero personality and a harem."
msgstr "Le héros d'isekai surpuissant, sans aucune personnalité, avec un harem."

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-1/26/s/0
msgctxt "Choix"
msgid "The ball of sunshine with big dreams!"
msgstr "La boule de soleil aux grands rêves !"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-1/27/s/0
msgctxt "Choix"
msgid "The delinquent punk with a heart of gold."
msgstr "Le punk délinquant au grand coeur."

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-1/28/s/0
msgctxt "Choix"
msgid "The depressed person whose life keeps getting worse and I can't look away."
msgstr "La personne dépressive dont la vie empire sans cesse, et je n'arrive pas à détourner les yeux."

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-1/29/s/0
msgctxt "Choix"
msgid "The protagonist that's actually an adult for once."
msgstr "Le protagoniste qui est enfin un vrai adulte, pour une fois."

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-1/c-5/7
msgctxt "Hero-Hime"
msgid "Well, I don't like tuning into your life that much either!"
msgstr "Eh bien, moi non plus, je n'aime pas trop suivre ta vie !"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-1/c-6/7
msgctxt "Hero-Hime"
msgid "Oh, you're into those kinds of shows, huh?"
msgstr "Oh, tu aimes ce genre de séries, hein ?"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-1/c-6/15
msgctxt "Hero-Hime"
msgid "Bet you got a lot of vinyl stickers on your car..."
msgstr "Je parie que t'as plein d'autocollants en vinyle sur ta voiture..."

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-1/c-7/7
msgctxt "Hero-Hime"
msgid "Yes, my fave! Seeing them go for their dreams is so inspiring!"
msgstr "Oui, mon préféré ! Les voir poursuivre leurs rêves, c'est tellement inspirant !"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-1/c-7/15
msgctxt "Hero-Hime"
msgid "I can't help but apply their lessons to my life."
msgstr "Je ne peux pas m'empêcher d'appliquer leurs leçons à ma vie."

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-1/c-8/7
msgctxt "Hero-Hime"
msgid "Yes! I love those big ol' secret softies!"
msgstr "Oui ! J'adore ces gros tendres cachés !"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-1/c-8/15
msgctxt "Hero-Hime"
msgid "It just makes their journey so much more endearing!"
msgstr "Ça rend leur parcours tellement plus touchant !"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-1/c-9/7
msgctxt "Hero-Hime"
msgid "It's tough, but some stories are page-turners."
msgstr "C'est dur, mais certaines histoires se dévorent."

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-1/c-9/15
msgctxt "Hero-Hime"
msgid "I just keep hoping their life will get better. But they usually don't."
msgstr "J'espère toujours que leur vie va s'arranger. Mais en général, non."

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-1/c-10/7
msgctxt "Hero-Hime"
msgid "Seriously! Why is it always about high schoolers?"
msgstr "Sérieux ! Pourquoi c'est toujours des lycéens ?"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-1/c-10/15
msgctxt "Hero-Hime"
msgid "Those shows are always such a breath of fresh air."
msgstr "Ces séries sont toujours une vraie bouffée d'air frais."

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-2/0
msgctxt "Hero-Hime"
msgid "Well, I hope my journey still holds up to whatever new series you're into!"
msgstr "Eh bien, j'espère que mon aventure tient encore la comparaison avec la nouvelle série que tu aimes !"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-2/8
msgctxt "Hero-Hime"
msgid "I can't see why not!"
msgstr "Je ne vois pas pourquoi pas !"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-2/19
msgctxt "Hero-Hime"
msgid "After all, I'm going to be the next Tennistar!"
msgstr "Après tout, je vais devenir la prochaine Tennistar !"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-2/27/s/0
msgctxt "Choix"
msgid "You know... in the last episode of your show..."
msgstr "Tu sais... dans le dernier épisode de ta série..."

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-2/28/s/0
msgctxt "Choix"
msgid "Are you sure?"
msgstr "Tu es sûre ?"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-3/0
msgctxt "Hero-Hime"
msgid "Hm? Did you say something?"
msgstr "Hm ? Tu as dit quelque chose ?"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-3/9/s/0
msgctxt "Choix"
msgid "Yes, I have a really bad feeling about this!"
msgstr "Oui, j'ai un très mauvais pressentiment !"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_1_Cont/0/g-3/c-14/7
msgctxt "Hero-Hime"
msgid "Ah that's nothing a protagonist can't handle!"
msgstr "Ah, rien qu'une protagoniste ne puisse gérer !"

# Traduction IA – à relire
#: hime_anime/yosh/0/0
msgctxt "Hero-Hime"
msgid "Yosh! I'm gonna head out then!"
msgstr "Yosh ! Bon, je file alors !"

# Traduction IA – à relire
#: hime_anime/yosh/0/8
msgctxt "Hero-Hime"
msgid "Don't forget to get some good food and rest!"
msgstr "N'oublie pas de bien manger et de te reposer !"

# Traduction IA – à relire
#: hime_anime/yosh/0/16
msgctxt "Hero-Hime"
msgid "Taking care of yourself is also part of tennis training!"
msgstr "Prendre soin de soi fait aussi partie de l'entraînement au tennis !"

# Traduction IA – à relire
#: hime_anime/yosh/0/24
msgctxt "Hero-Hime"
msgid "Sayonara!"
msgstr "Sayonara !"

# Traduction IA – à relire
#: hime_anime/yosh/0/46/s/0
msgctxt "Choix"
msgid "Am I remembering the series wrong?"
msgstr "Je me souviens mal de la série ?"

# Traduction IA – à relire
#: hime_anime/yosh/0/47/s/0
msgctxt "Choix"
msgid "Something feels... off."
msgstr "Quelque chose cloche..."

# Traduction IA – à relire
#: hime_anime/Hero_3/0/6
msgctxt "Hero-Hime"
msgid "<i>... 997... 998... 999... 1000!</i>"
msgstr "<i>... 997... 998... 999... 1000 !</i>"

# Traduction IA – à relire
#: hime_anime/Hero_3/0/14
msgctxt "Hero-Hime"
msgid "Phew!"
msgstr "Ouf !"

# Traduction IA – à relire
#: hime_anime/Hero_3/0/22/s/0
msgctxt "Choix"
msgid "Training again?"
msgstr "Encore à l'entraînement ?"

# Traduction IA – à relire
#: hime_anime/Hero_3/0/23/s/0
msgctxt "Choix"
msgid "How do I know you didn't start at 990 when you heard me coming up to you?"
msgstr "Comment je sais que t'as pas commencé à 990 en m'entendant arriver ?"

# Traduction IA – à relire
#: hime_anime/Hero_3/0/c-0/7
msgctxt "Hero-Hime"
msgid "Yo!"
msgstr "Yo !"

# Traduction IA – à relire
#: hime_anime/Hero_3/0/c-0/15
msgctxt "Hero-Hime"
msgid "You know it!"
msgstr "Tu l'as dit !"

# Traduction IA – à relire
#: hime_anime/Hero_3/0/c-1/7
msgctxt "Hero-Hime"
msgid "Hahahah! Silly!"
msgstr "Hahaha ! Tu es trop drôle !"

# Traduction IA – à relire
#: hime_anime/Hero_3/0/c-1/15
msgctxt "Hero-Hime"
msgid "A Tennistar never cheats, even themselves!"
msgstr "Une Tennistar ne triche jamais, même envers elle-même !"

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-0/0
msgctxt "Hero-Hime"
msgid "I'm rallying against this wall."
msgstr "Je fais des échanges contre ce mur."

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-0/8
msgctxt "Hero-Hime"
msgid "The wall is every tennis player's invincible opponent."
msgstr "Le mur est l'adversaire invincible de tout joueur de tennis."

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-0/16/s/0
msgctxt "Choix"
msgid "How so?"
msgstr "Comment ça ?"

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-0/17/s/0
msgctxt "Choix"
msgid "Seems easy to me."
msgstr "Ça me paraît facile."

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-1/0
msgctxt "Hero-Hime"
msgid "A wall will never drop its shot!"
msgstr "Un mur ne rate jamais sa balle !"

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-1/8
msgctxt "Hero-Hime"
msgid "It's a battle of endurance against the never ending!"
msgstr "C'est un combat d'endurance contre l'interminable !"

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-1/16
msgctxt "Hero-Hime"
msgid "Anyway, my training partner is here so let's wrap it up, Wallace."
msgstr "Bref, mon partenaire d'entraînement est là, alors on conclut, Wallace."

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-1/27 hime_anime/Hero_3/0/g-1/68
msgctxt "Wallace"
msgid "WALL."
msgstr "MUR."

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-1/38/b/1
msgctxt "Wallace"
msgid "An exhilarating show, Hero-Hime! Keep it up and one day you just might crack me!"
msgstr "Quel spectacle exaltant, Hero-Hime ! Persévère et un jour tu finiras peut-être par me fissurer !"

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-1/41
msgctxt "Hero-Hime"
msgid "Aww, thanks Wallace!"
msgstr "Oh, merci Wallace !"

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-1/52
msgctxt "Hero-Hime"
msgid "Say bye, Nekoboru!"
msgstr "Dis au revoir, Nekoboru !"

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-1/76/b/1
msgctxt "Wallace"
msgid "Nekoboru."
msgstr "Nekoboru."

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-1/79/s/0
msgctxt "Choix"
msgid "A conversation between those two would be legendary."
msgstr "Une conversation entre ces deux-là serait légendaire."

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-1/80/s/0
msgctxt "Choix"
msgid "Human!"
msgstr "Humain !"

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-1/81/s/0
msgctxt "Choix"
msgid "Wallace, you speak tennis-ball-cat?"
msgstr "Wallace, tu parles chat-balle-de-tennis ?"

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-1/c-4/7
msgctxt "Hero-Hime"
msgid "Oh you couldn't IMAGINE the things those two get up to."
msgstr "Oh, tu ne peux même pas IMAGINER ce que ces deux-là fabriquent."

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-1/c-5/7
msgctxt "Hero-Hime"
msgid "ANIME STAR!!"
msgstr "STAR D'ANIME !!"

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-1/c-6/7
msgctxt "Wallace"
msgid "Hmm, a smidge. I've picked it up from watching subs."
msgstr "Hmm, un chouïa. Je l'ai appris en regardant du sous-titré."

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-2/7
msgctxt "Hero-Hime"
msgid "So for today's agenda, we're gonna train for something every tennis player needs to have."
msgstr "Alors, au programme d'aujourd'hui, on va s'entraîner pour quelque chose dont tout joueur de tennis a besoin."

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-2/15/s/0
msgctxt "Choix"
msgid "What's that?"
msgstr "C'est quoi ?"

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-2/16/s/0
msgctxt "Choix"
msgid "Oh, uh, I was kind of hoping to just get to know you a bit better without all of the... you know... <i>tennis</i>."
msgstr "Oh, euh, j'espérais plutôt apprendre à mieux te connaître, sans tout ce... tu sais... <i>tennis</i>."

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-2/c-7/7
msgctxt "Hero-Hime"
msgid "A proper serve, of course!"
msgstr "Un vrai service, bien sûr !"

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-2/c-8/7
msgctxt "Hero-Hime"
msgid "Work first, fun later!"
msgstr "D'abord le travail, ensuite le plaisir !"

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-2/c-8/15
msgctxt "Hero-Hime"
msgid "We've got to work on getting you a LETHAL serve."
msgstr "Il faut qu'on bosse pour te donner un service MORTEL."

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-3/0/s/0
msgctxt "Choix"
msgid "What's wrong with tapping the ball in?"
msgstr "Qu'est-ce qui cloche avec le fait de juste pousser la balle ?"

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-3/1/s/0
msgctxt "Choix"
msgid "If we're playing for fun, why would I want to nuke my opponent first thing?"
msgstr "Si on joue pour s'amuser, pourquoi je voudrais atomiser mon adversaire dès le départ ?"

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-3/c-9/7
msgctxt "Hero-Hime"
msgid "We're here to win!"
msgstr "On est là pour gagner !"

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-3/c-9/15
msgctxt "Hero-Hime"
msgid "Concentrating on the bare minimum would just be giving your opponent a huge advantage."
msgstr "Se concentrer sur le strict minimum, ce serait offrir un énorme avantage à ton adversaire."

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-3/c-9/23
msgctxt "Hero-Hime"
msgid "If you're playing against me, and <i>I</i> see a flimsy serve, that's the perfect set up for me to return however I want!"
msgstr "Si tu joues contre moi et que <i>je</i> vois un service mou, c'est l'occasion parfaite pour moi de renvoyer comme je veux !"

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-3/c-9/31
msgctxt "Hero-Hime"
msgid "It means I'd have control of the court. See what I'm saying?!"
msgstr "Ça veut dire que je contrôlerais le court. Tu vois ce que je veux dire ?!"

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-3/c-10/7
msgctxt "Hero-Hime"
msgid "Sure, as long as you make it in, you get to <i>play</i>."
msgstr "Bien sûr, tant que la balle est dedans, tu peux <i>jouer</i>."

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-3/c-10/15
msgctxt "Hero-Hime"
msgid "But if you want to become a Tennistar, a true master of the sport, you've got to give it your all every time."
msgstr "Mais si tu veux devenir une Tennistar, une vraie maîtresse du sport, il faut tout donner à chaque fois."

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-3/c-10/23
msgctxt "Hero-Hime"
msgid "No one likes to be placated, even if it's just a silly <i>game</i>. WHICH IT ISN'T."
msgstr "Personne n'aime qu'on le ménage, même pour un simple <i>jeu</i>. CE QUI N'EST PAS LE CAS."

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-4/0/s/0
msgctxt "Choix"
msgid "Dang. So... my serves are flimsy?"
msgstr "Mince. Donc... mes services sont mous ?"

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-4/1/s/0
msgctxt "Choix"
msgid "What if I go full power, but miss the service square?"
msgstr "Et si je mets toute ma puissance, mais que je rate le carré de service ?"

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-4/c-11/7
msgctxt "Hero-Hime"
msgid "Everyone's starts that way! Nothing to be ashamed of."
msgstr "Tout le monde commence comme ça ! Il n'y a pas de honte."

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-5/0
msgctxt "Hero-Hime"
msgid "In tennis, we have a primary serve and a secondary serve."
msgstr "Au tennis, on a un premier service et un second service."

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-5/8
msgctxt "Hero-Hime"
msgid "Your usual puny, low-effort serve would work as a secondary - like a backup if you're not confident or just need to get the ball in."
msgstr "Ton petit service habituel, sans effort, ferait un très bon second service : un filet de sécurité quand tu manques de confiance ou que tu veux juste mettre la balle en jeu."

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-5/16
msgctxt "Hero-Hime"
msgid "However, you should go ALL OUT on the primary serve and set the tone of the match!"
msgstr "Mais sur le premier service, tu dois TOUT DONNER et imposer le ton du match !"

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-5/24
msgctxt "Hero-Hime"
msgid "Whether it's a tricky spin or just raw power, you can throw off your opponent right away!"
msgstr "Que ce soit un effet vicieux ou de la puissance pure, tu peux déstabiliser ton adversaire d'entrée !"

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-5/32
msgctxt "Hero-Hime"
msgid "And once you get in their head, it's over!!!"
msgstr "Et une fois que tu as pris possession de sa tête, c'est plié !!!"

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-5/40
msgctxt "Hero-Hime"
msgid "Remember: tennis is - above all else - a <i>mental</i> game."
msgstr "N'oublie pas : le tennis est, avant tout, un jeu <i>mental</i>."

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-5/48/s/0
msgctxt "Choix"
msgid "Am I really helping your journey?"
msgstr "Est-ce que j'aide vraiment ton parcours ?"

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-5/49/s/0
msgctxt "Choix"
msgid "I don't think I'm good enough for this."
msgstr "Je ne crois pas être à la hauteur."

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-5/50/s/0
msgctxt "Choix"
msgid "No problem. I'm ready!"
msgstr "Aucun souci. Je suis {{prêt|prête|prêt·e}} !"

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-5/c-13/7
msgctxt "Hero-Hime"
msgid "Of course you are! You're the only one who can help me!"
msgstr "Bien sûr que oui ! Tu es la seule personne qui puisse m'aider !"

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-5/c-14/7
msgctxt "Hero-Hime"
msgid "Just believe in the me that believes in you!"
msgstr "Crois en la moi qui croit en toi !"

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-5/c-15/7
msgctxt "Hero-Hime"
msgid "Yatta! That's the spirit!"
msgstr "Yatta ! Voilà l'esprit !"

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-6/0
msgctxt "Hero-Hime"
msgid "Come on, let's practice your serves!"
msgstr "Allez, on s'entraîne à servir !"

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-6/8
msgctxt "Hero-Hime"
msgid "First, depending on if you're a righty or lefty, you want to stand parallel to the baseline at the center mark."
msgstr "D'abord, selon ta main dominante, place-toi parallèlement à la ligne de fond, sur la marque centrale."

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-6/16
msgctxt "Hero-Hime"
msgid "Then have your front foot pointing diagonally, towards the opposite service box."
msgstr "Ensuite, oriente ton pied avant en diagonale, vers le carré de service opposé."

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-6/24
msgctxt "Hero-Hime"
msgid "Now have both your arms move simultaneously here."
msgstr "Maintenant, fais bouger tes deux bras en même temps."

# Traduction IA – à relire
#: hime_anime/Hero_3/0/g-6/32
msgctxt "Hero-Hime"
msgid "One tossing the ball, the other winding the racket behind you."
msgstr "L'un lance la balle, l'autre arme la raquette derrière toi."

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/0
msgctxt "Hero-Hime"
msgid "Now, when do you think you should hit the ball?"
msgstr "Alors, à ton avis, quand faut-il frapper la balle ?"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/9/0
msgctxt "Hero-Hime"
msgid "Huhuhu!"
msgstr "Hihihi !"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/9/11/0/s/0
msgctxt "Choix"
msgid "<i>Right after I release.</i>"
msgstr "<i>Juste après l'avoir lâchée.</i>"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/9/11/1/s/0
msgctxt "Choix"
msgid "<i>As the ball comes back down.</i>"
msgstr "<i>Quand la balle redescend.</i>"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/9/11/2/s/0
msgctxt "Choix"
msgid "<i>Right at the apex.</i>"
msgstr "<i>Tout en haut, au sommet.</i>"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/9/11/c-0/7
msgctxt "Hero-Hime"
msgid "And it hit the net."
msgstr "Et c'est dans le filet."

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/9/11/c-0/15
msgctxt "Hero-Hime"
msgid "Too soon! Try again!"
msgstr "Trop tôt ! Recommence !"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/9/11/c-1/7
msgctxt "Hero-Hime"
msgid "Too slow!"
msgstr "Trop tard !"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/9/11/c-1/15
msgctxt "Hero-Hime"
msgid "Try a little faster!"
msgstr "Essaie un peu plus vite !"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/9/11/c-2/7
msgctxt "Hero-Hime"
msgid "Nice! That's a great start!"
msgstr "Bien joué ! C'est un super début !"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/9/11/c-2/15
msgctxt "Hero-Hime"
msgid "You. Me. Basket of balls. It's serving time."
msgstr "Toi. Moi. Un panier de balles. C'est l'heure du service."

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/9/11/c-2/31
msgctxt "Hero-Hime"
msgid "Hmm... not enough spin on that one."
msgstr "Hmm... pas assez d'effet sur celle-là."

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/g-0/0/s/0
msgctxt "Choix"
msgid "Why do you yell out names for your shots?"
msgstr "Pourquoi tu cries le nom de tes coups ?"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/g-0/1/s/0
msgctxt "Choix"
msgid "I love the way you do your special moves!"
msgstr "J'adore ta façon de faire tes attaques spéciales !"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/g-0/c-3/7
msgctxt "Hero-Hime"
msgid "It helps to let out a guttural grunt while hitting the ball."
msgstr "Ça aide de pousser un grognement guttural en frappant la balle."

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/g-0/c-3/15
msgctxt "Hero-Hime"
msgid "It's like releasing more excess energy into your shot."
msgstr "C'est comme libérer encore plus d'énergie dans ton coup."

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/g-0/c-3/23
msgctxt "Hero-Hime"
msgid "But naming my moves... is just something I like to do, hehe."
msgstr "Mais nommer mes attaques... c'est juste un truc que j'aime bien faire, hihi."

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/g-1/0
msgctxt "Hero-Hime"
msgid "You should try one!"
msgstr "Tu devrais en essayer une !"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/g-1/8/s/0
msgctxt "Choix"
msgid "<i>Galaxy Arts: Starlight Smash!</i>"
msgstr "<i>Arts Galactiques : Smash Étoilé !</i>"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/g-1/9/s/0
msgctxt "Choix"
msgid "<i>Hyper Liger Driver!</i>"
msgstr "<i>Hyper Liger Driver !</i>"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/g-1/10/s/0
msgctxt "Choix"
msgid "...I've got nothing."
msgstr "...Je n'ai rien."

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/g-1/c-5/11
msgctxt "Hero-Hime"
msgid "Ah... while I'm flattered, you have to train more to use my techniques."
msgstr "Ah... merci, ça me flatte, mais il faut t'entraîner davantage pour utiliser mes techniques."

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/g-1/c-6/11
msgctxt "Hero-Hime"
msgid "That could catch on!"
msgstr "Ça pourrait faire école !"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/g-1/c-7/11
msgctxt "Hero-Hime"
msgid "Aw come on!"
msgstr "Oh, allez !"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/g-2/0
msgctxt "Hero-Hime"
msgid "Let's try it again!"
msgstr "On réessaie !"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/g-2/8
msgctxt "Hero-Hime"
msgid "<i>Galaxy Arts: Meteor Slice!</i>"
msgstr "<i>Arts Galactiques : Tranche Météore !</i>"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/g-2/16/s/0
msgctxt "Choix"
msgid "<i>Galaxy Arts: Starlight Smush!</i>"
msgstr "<i>Arts Galactiques : Smush Étoilé !</i>"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/g-2/17/s/0
msgctxt "Choix"
msgid "<i>Hyper Liger Driver... Again!</i>"
msgstr "<i>Hyper Liger Driver... Encore !</i>"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/g-2/18/s/0
msgctxt "Choix"
msgid "<i>Racket Racket no Pistol!</i>"
msgstr "<i>Raquette Raquette no Pistolet !</i>"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/g-2/19/s/0
msgctxt "Choix"
msgid "...I've still got nothing."
msgstr "...Je n'ai toujours rien."

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/g-2/c-8/7
msgctxt "Hero-Hime"
msgid "Smush? Yeah... I don't think you're ready for the big leagues."
msgstr "Smush ? Ouais... je crois que tu n'es pas {{prêt|prête|prêt·e}} pour la cour des grands."

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/g-2/c-9/7
msgctxt "Hero-Hime"
msgid "Hahaha, love the Again part! Bet your opponents won't see that coming!"
msgstr "Hahaha, j'adore le coup du Encore ! Tes adversaires ne le verront pas venir !"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/g-2/c-10/7
msgctxt "Hero-Hime"
msgid "You brought a gun to a tennis battle? Rude!"
msgstr "Tu as amené un pistolet à un combat de tennis ? Quel manque de savoir-vivre !"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/g-2/c-10/15
msgctxt "Hero-Hime"
msgid "It's a good thing we aren't playing on a seawater court, hehe."
msgstr "Heureusement qu'on dispute un match et pas un duel, hihi."

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/g-2/c-11/7
msgctxt "Hero-Hime"
msgid "At least grunt! It'll help you a lot!"
msgstr "Grogne au moins ! Ça t'aidera beaucoup !"

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/g-3/0
msgctxt "Hero-Hime"
msgid "Looks like we're out of balls."
msgstr "On dirait qu'on n'a plus de balles."

# Traduction IA – à relire
#: hime_anime/Hero_Tennis_2/0/g-3/8
msgctxt "Hero-Hime"
msgid "Grab a basket and let's pick 'em up!"
msgstr "Prends un panier et allons les ramasser !"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/0/s/0
msgctxt "Choix"
msgid "Okie-dokie."
msgstr "Comme tu voudras."

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/1/s/0
msgctxt "Choix"
msgid "Whew!"
msgstr "Ouf !"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-0/0
msgctxt "Hero-Hime"
msgid "So how are you feeling about all this?"
msgstr "Alors, qu'est-ce que tu ressens, avec tout ça ?"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-0/8
msgctxt "Hero-Hime"
msgid "Must be great being able to talk to your cool anime figurine, yeah?"
msgstr "Ça doit être génial de pouvoir parler à ta figurine d'anime, non ?"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-0/16/s/0
msgctxt "Choix"
msgid "It rules!"
msgstr "C'est top !"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-0/17/s/0
msgctxt "Choix"
msgid "I'm a bit overwhelmed."
msgstr "Tout ça me dépasse un peu."

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-0/c-2/7
msgctxt "Hero-Hime"
msgid "It rules talking to you, too! Tee hee!"
msgstr "C'est top de te parler à toi aussi ! Hihi !"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-0/c-3/7
msgctxt "Hero-Hime"
msgid "Hehe, sorry that I can't control my shining aura!"
msgstr "Hihi, désolée de ne pas pouvoir contrôler mon aura rayonnante !"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-1/0
msgctxt "Hero-Hime"
msgid "Bet your anime-loving pals would be jealous to know you're getting trained by a future Tennistar!!"
msgstr "Je parie que tes potes fans d'anime seraient jaloux de savoir que tu t'entraînes avec une future Tennistar !!"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-1/8/s/0
msgctxt "Choix"
msgid "It's true! Sam - your original owner - really wanted to talk to you!"
msgstr "C'est vrai ! Sam, ta première propriétaire, rêvait de te parler !"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-1/9/s/0
msgctxt "Choix"
msgid "I didn't even know what that was until I met you!"
msgstr "Je ne savais même pas ce que c'était avant de te rencontrer !"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-1/10/s/0
msgctxt "Choix"
msgid "I bet Sam - your original owner - would have wanted to talk to you!"
msgstr "Je parie que Sam, ta première propriétaire, aurait adoré te parler !"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-1/c-4/7 hime_anime/Hero_3_2/0/g-1/c-6/7
msgctxt "Hero-Hime"
msgid "Sam-kun? She was awesome!"
msgstr "Sam-kun ? Elle était géniale !"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-1/c-4/18 hime_anime/Hero_3_2/0/g-1/c-6/18
msgctxt "Hero-Hime"
msgid "I do miss her - maybe one day we'll meet again!"
msgstr "Elle me manque, c'est sûr. Peut-être qu'un jour on se reverra !"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-1/c-4/26/0/s/0 hime_anime/Hero_3_2/0/g-1/c-6/26/0/s/0
msgctxt "Choix"
msgid "I'm sure you will."
msgstr "Je n'en doute pas."

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-1/c-4/26/1/s/0 hime_anime/Hero_3_2/0/g-1/c-6/26/1/s/0
msgctxt "Choix"
msgid "No way - you're mine forever!"
msgstr "Pas question, tu es à moi pour toujours !"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-1/c-4/26/c-0/7 hime_anime/Hero_3_2/0/g-1/c-6/26/c-0/7
msgctxt "Hero-Hime"
msgid "Aww you're so sweet!"
msgstr "Aww, c'est adorable !"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-1/c-4/26/c-1/7 hime_anime/Hero_3_2/0/g-1/c-6/26/c-1/7
msgctxt "Hero-Hime"
msgid "Oh wow! A real Overhead Smash of a compliment!"
msgstr "Wouah ! Un vrai Smash en hauteur de compliment !"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-1/c-4/26/g-0/0 hime_anime/Hero_3_2/0/g-1/c-6/26/g-0/0
msgctxt "Hero-Hime"
msgid "So..."
msgstr "Alors..."

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-1/c-5/7
msgctxt "Hero-Hime"
msgid "Oh."
msgstr "Oh."

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-1/c-5/23/0/s/0
msgctxt "Choix"
msgid "N-not that the show wasn't popular!"
msgstr "N-non, pas que la série n'ait pas été populaire !"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-1/c-5/23/1/s/0
msgctxt "Choix"
msgid "Sorry! I didn't mean anything by it. It's just that, well, tennis <i>is</i> an acquired taste!"
msgstr "Pardon ! Je ne voulais pas dire ça. C'est juste que, enfin, le tennis, <i>c'est</i> une affaire de goût !"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-1/c-5/23/c-0/15
msgctxt "Hero-Hime"
msgid "Well, obviously! I mean they DID make me into a figurine after all."
msgstr "Évidemment ! Après tout, ils ont bien fait de moi une figurine."

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-1/c-5/23/c-1/15
msgctxt "Hero-Hime"
msgid "Y-yeah! And we're cookin' together!"
msgstr "O-ouais ! Et on est en pleine forme, tous les deux !"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-1/c-5/23/g-0/0
msgctxt "Hero-Hime"
msgid "Hey, um... I know you said maybe my show wasn't your all-time <i>favorite</i> anime or whatever, but..."
msgstr "Hé, euh... je sais que tu as dit que ma série n'était peut-être pas ton anime <i>préféré</i> de tous les temps ou je ne sais quoi, mais..."

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-2/0
msgctxt "Hero-Hime"
msgid "...what do you like best about <i>me</i>?"
msgstr "...qu'est-ce que tu préfères chez <i>moi</i> ?"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-2/8/s/0
msgctxt "Choix"
msgid "How you make me want to root for you."
msgstr "La façon dont tu me donnes envie de t'encourager."

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-2/9/s/0
msgctxt "Choix"
msgid "Your voice!"
msgstr "Ta voix !"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-2/10/s/0
msgctxt "Choix"
msgid "How well sculpted you are."
msgstr "À quel point tu es bien sculptée."

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-2/11/s/0
msgctxt "Choix"
msgid "Oh, nothing really!"
msgstr "Oh, rien de spécial !"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-2/c-7/7
msgctxt "Hero-Hime"
msgid "Aw! Well, I won't let you down!"
msgstr "Aww ! Eh bien, je ne te décevrai pas !"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-2/c-8/7
msgctxt "Hero-Hime"
msgid "Thank you! I'm happy I got a true legend to give me a voice!"
msgstr "Merci ! Je suis ravie d'avoir une vraie légende pour me prêter sa voix !"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-2/c-9/7
msgctxt "Hero-Hime"
msgid "It's not enough to have any ol' anime figure - it's gotta be a <i>well made</i> one..."
msgstr "Il ne suffit pas d'avoir une figurine d'anime quelconque : il faut qu'elle soit <i>bien faite</i>..."

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-2/c-10/7
msgctxt "Hero-Hime"
msgid "Hmph! Can't blame a star for trying..."
msgstr "Hmph ! On ne peut pas reprocher à une star d'essayer..."

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-3/0
msgctxt "Hero-Hime"
msgid "Alright! We got all the balls."
msgstr "Bon ! On a toutes les balles."

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-3/8
msgctxt "Hero-Hime"
msgid "Let's get back to serving!"
msgstr "Retournons servir !"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-3/16
msgctxt "Hero-Hime"
msgid "Soon, we'll be clashing with each other at equal strength."
msgstr "Bientôt, on s'affrontera à force égale."

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-3/24
msgctxt "Hero-Hime"
msgid "We'll first compete for our positions on the team."
msgstr "On commencera par se disputer nos places dans l'équipe."

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-3/32
msgctxt "Hero-Hime"
msgid "Since there's only two of us, it'll be for First and Second Singles."
msgstr "Comme on n'est que deux, ce sera pour le Premier et le Second Simple."

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-3/40
msgctxt "Hero-Hime"
msgid "Then you'll get drafted by Thorn Slice Institute, which will fuel our rivalry even more."
msgstr "Ensuite, l'Institut Épine-Tranchante te recrutera, ce qui alimentera encore plus notre rivalité."

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-3/48
msgctxt "Hero-Hime"
msgid "After months of training, we'll finally be able to duke it out at Nationals."
msgstr "Après des mois d'entraînement, on pourra enfin en découdre aux Nationaux."

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-3/56
msgctxt "Hero-Hime"
msgid "Then I'll become the Tennistar!"
msgstr "Et là, je deviendrai la Tennistar !"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-3/67/s/0
msgctxt "Choix"
msgid "Sooooo, I just replaced the entire supporting cast?"
msgstr "Doooonc, je viens de remplacer toute la distribution secondaire ?"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-3/68/s/0
msgctxt "Choix"
msgid "I mean, sounds fun, but I have so many things to talk to..."
msgstr "Enfin, ça a l'air sympa, mais j'ai tellement d'autres choses à qui parler..."

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-3/c-11/11
msgctxt "Hero-Hime"
msgid "You got a lot of tennis shoes to fill!"
msgstr "Tu as de grosses baskets à remplir !"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-3/c-12/7
msgctxt "Hero-Hime"
msgid "I'm a full time student and you lost your remote job. Deal with it."
msgstr "Moi, je suis étudiante à plein temps, et toi, tu as perdu ton télétravail. Fais avec."

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-4/0
msgctxt "Hero-Hime"
msgid "Anyway, we'll also have to-"
msgstr "Enfin bref, il va aussi falloir..."

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-4/8
msgctxt "Hero-Hime"
msgid "Hey, wait a minute. Where is Nekoboru?"
msgstr "Hé, attends une minute. Où est Nekoboru ?"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-4/16
msgctxt "???"
msgid "<i>(muffled cry)</i>"
msgstr "<i>(cri étouffé)</i>"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-4/24
msgctxt "Hero-Hime"
msgid "Did you hear something?"
msgstr "Tu as entendu quelque chose ?"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-4/32/s/0
msgctxt "Choix"
msgid "I'M COMING TO SAVE YOU, NEKOBORU!!!"
msgstr "J'ARRIVE POUR TE SAUVER, NEKOBORU !!!"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-4/33/s/0
msgctxt "Choix"
msgid "Uhhhh... nope!"
msgstr "Euhhhh... non !"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-5/0
msgctxt "Hero-Hime"
msgid "I think that was him!"
msgstr "Je crois que c'était lui !"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-5/8
msgctxt "Hero-Hime"
msgid "Nekoboru's cries are coming from—"
msgstr "Les cris de Nekoboru viennent de..."

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-5/16
msgctxt "Hero-Hime"
msgid "There! In the tennis ball basket!"
msgstr "Là ! Dans le panier de balles de tennis !"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-5/24/s/0
msgctxt "Choix"
msgid "<i>DUMP THE BASKET SO FAST</i>"
msgstr "<i>VIDER LE PANIER ULTRA VITE</i>"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-5/25/s/0
msgctxt "Choix"
msgid "I mean, maybe it'd be more intimate if you and I had some time <i>without</i> Nekoboru..."
msgstr "Enfin, ce serait peut-être plus intime si on avait un peu de temps toi et moi <i>sans</i> Nekoboru..."

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-5/c-15/7
msgctxt "Hero-Hime"
msgid "Thank you thank you!"
msgstr "Merci, merci !"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-5/c-16/7
msgctxt "Hero-Hime"
msgid "What?? How can you say that while Nekoboru is in peril!"
msgstr "Quoi ?? Comment peux-tu dire ça alors que Nekoboru est en danger !"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-5/c-16/15
msgctxt "Hero-Hime"
msgid "Here... I'll get that basket."
msgstr "Tiens... je vais prendre ce panier."

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-6/0
msgctxt "Nekoboru"
msgid "Neko... BORU!!!"
msgstr "Neko... BORU !!!"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-6/8
msgctxt "Hero-Hime"
msgid "Oh my gosh! Are you okay, Nekoboru??"
msgstr "Oh là là ! Ça va, Nekoboru ??"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-6/16
msgctxt "Nekoboru"
msgid "Boru-boru."
msgstr "Boru-boru."

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-6/24
msgctxt "Hero-Hime"
msgid "We must have mistaken you for a regular tennis ball from our serving practice..."
msgstr "On a dû te prendre pour une balle de tennis ordinaire pendant l'entraînement au service..."

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-6/32
msgctxt "Hero-Hime"
msgid "I'm so sorry."
msgstr "Je suis vraiment désolée."

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-6/40
msgctxt "Hero-Hime"
msgid "Just rest, okay?"
msgstr "Repose-toi, d'accord ?"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-6/48
msgctxt "Hero-Hime"
msgid "Hey, can you watch Nekoboru while I go fix the basket?"
msgstr "Dis, tu peux surveiller Nekoboru pendant que je vais réparer le panier ?"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-6/56/s/0
msgctxt "Choix"
msgid "Sure..."
msgstr "Bien sûr..."

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-6/57/s/0
msgctxt "Choix"
msgid "No!"
msgstr "Non !"

# Traduction IA – à relire
#: hime_anime/Hero_3_2/0/g-7/0
msgctxt "Hero-Hime"
msgid "Thanks!!"
msgstr "Merci !!"

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/16
msgctxt "Nekoboru"
msgid "Neko..."
msgstr "Neko..."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/24
msgctxt "Nekoboru"
msgid "Now that we are alone, I need you to listen to me."
msgstr "Maintenant que nous sommes seuls, j'ai besoin que tu m'écoutes."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/32/s/0
msgctxt "Choix"
msgid "YOU CAN TALK!?"
msgstr "TU PARLES !?"

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/33/s/0
msgctxt "Choix"
msgid "HAH! I KNEW YOU WERE SOME KIND OF WEIRDO!"
msgstr "HA ! JE SAVAIS QUE TU ÉTAIS UN GENRE DE CINGLÉ !"

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/c-1/7
msgctxt "Nekoboru"
msgid "Silence!"
msgstr "Silence !"

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/c-1/15 hime_anime/Nekoboru_3/0/11
msgctxt "Nekoboru"
msgid "<w>NEKO DESTROYER PUNCH!</w>"
msgstr "<w>NEKO POING DESTRUCTEUR !</w>"

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/c-1/29/0/s/0
msgctxt "Choix"
msgid "OW! MY RIB!"
msgstr "AÏE ! MA CÔTE !"

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-0/0
msgctxt "Nekoboru"
msgid "Quickly, before Hero-hime returns. Listen carefully."
msgstr "Vite, avant que Hero-hime ne revienne. Écoute bien."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-0/8
msgctxt "Nekoboru"
msgid "I am not an average tennis ball cat."
msgstr "Je ne suis pas un chat-balle de tennis ordinaire."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-0/16 hime_anime/Nekoboru_1/0/g-0/c-3/7
msgctxt "Nekoboru"
msgid "I am the former Tennistar."
msgstr "Je suis l'ancien Tennistar."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-0/24/s/0
msgctxt "Choix"
msgid "Holy plot twist..."
msgstr "Quel retournement de situation..."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-0/25/s/0
msgctxt "Choix"
msgid "Say what now?!"
msgstr "Comment ça ?!"

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-0/c-2/7
msgctxt "Nekoboru"
msgid "That indeed, my friend."
msgstr "En effet, mon ami."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-1/0
msgctxt "Nekoboru"
msgid "And I am also the God of Tennis."
msgstr "Et je suis aussi le Dieu du Tennis."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-1/8/s/0
msgctxt "Choix"
msgid "I really need to re-watch the show."
msgstr "Il faut vraiment que je revoie la série."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-1/9/s/0
msgctxt "Choix"
msgid "How have I never seen this show?"
msgstr "Comment ai-je pu ne jamais voir cette série ?"

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-1/10/s/0
msgctxt "Choix"
msgid "Oooohhhh yeah... I never really got that."
msgstr "Ooooh ouais... je n'avais jamais vraiment compris ça."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-1/c-4/7 hime_anime/Nekoboru_1/0/g-1/c-6/7
msgctxt "Nekoboru"
msgid "Most fans tend to forget this part."
msgstr "La plupart des fans ont tendance à oublier ce passage."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-1/c-5/7
msgctxt "Nekoboru"
msgid "It is understandable - there is far too much content these days."
msgstr "C'est compréhensible : il y a beaucoup trop de contenu de nos jours."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-2/0
msgctxt "Nekoboru"
msgid "At the height of my tennisdom, I became one with the ball and was unable to return to my previous form."
msgstr "Au sommet de mon tennisme, je ne faisais plus qu'un avec la balle, et je n'ai pas pu retrouver ma forme d'origine."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-2/8
msgctxt "Nekoboru"
msgid "That's when I noticed Hero-hime."
msgstr "C'est alors que j'ai remarqué Hero-hime."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-2/16
msgctxt "Nekoboru"
msgid "Her potential on the court is limitless."
msgstr "Son potentiel sur le court est illimité."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-2/24
msgctxt "Nekoboru"
msgid "She <i>will</i> become the next Tennistar."
msgstr "Elle <i>deviendra</i> la prochaine Tennistar."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-2/32
msgctxt "Nekoboru"
msgid "However... it is up to <i>you</i> to guide her."
msgstr "Cependant... c'est à <i>toi</i> de la guider."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-2/40/s/0
msgctxt "Choix"
msgid "Guide her? How?"
msgstr "La guider ? Comment ?"

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-2/41/s/0
msgctxt "Choix"
msgid "I accept this quest, oh God of Tennis."
msgstr "J'accepte cette quête, ô Dieu du Tennis."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-2/c-7/7
msgctxt "Nekoboru"
msgid "Preferably, away from the path of darkness."
msgstr "Idéalement, loin de la voie des ténèbres."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-2/c-8/7
msgctxt "Nekoboru"
msgid "I prefer Nekoboru."
msgstr "Je préfère Nekoboru."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-2/c-8/15
msgctxt "Nekoboru"
msgid "You must guide her away from the path of darkness."
msgstr "Tu dois la détourner de la voie des ténèbres."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-3/3
msgctxt "Nekoboru"
msgid "Do you recall the episode where Rival-san gave into the <i>Dread</i>?"
msgstr "Te souviens-tu de l'épisode où Rival-san a cédé à l'<i>Effroi</i> ?"

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-3/11/s/0
msgctxt "Choix"
msgid "Oh, that episode was super sad!"
msgstr "Oh, cet épisode était super triste !"

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-3/12/s/0
msgctxt "Choix"
msgid "Man that art looks so cool..."
msgstr "Ouah, ces dessins ont trop la classe..."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-3/13/s/0
msgctxt "Choix"
msgid "This is silly."
msgstr "C'est ridicule."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-3/c-10/7
msgctxt "Nekoboru"
msgid "I agree."
msgstr "Je suis d'accord."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-3/c-11/7
msgctxt "Nekoboru"
msgid "Sounds like <i>Dread</i> to me."
msgstr "Ça ressemble à de l'<i>Effroi</i>, tout ça."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-4/0
msgctxt "Nekoboru"
msgid "The Dread shattered her entire being and reconstituted her as a wicked player of malicious intent."
msgstr "L'Effroi a brisé tout son être et l'a reconstituée en joueuse perfide, animée d'intentions malveillantes."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-4/8
msgctxt "Nekoboru"
msgid "While Hero-hime is a force of good in her heart, her latent Dread formed the second she picked up a racket."
msgstr "Si Hero-hime est une force du bien dans son cœur, son Effroi latent s'est formé à l'instant où elle a pris une raquette."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-4/16
msgctxt "Nekoboru"
msgid "Anxiety, frustration, self-blame. All these are a part of tennis as well."
msgstr "L'angoisse, la frustration, la culpabilité. Tout cela fait aussi partie du tennis."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-4/24
msgctxt "Nekoboru"
msgid "That is what the Dread is."
msgstr "Voilà ce qu'est l'Effroi."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-4/35
msgctxt "Nekoboru"
msgid "Heart Ace Academy will be reduced to ashes. Or in your case, your home."
msgstr "L'Académie Heart Ace sera réduite en cendres. Ou, dans ton cas, ta maison."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-4/43/s/0
msgctxt "Choix"
msgid "What do I do?"
msgstr "Que dois-je faire ?"

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-4/44/s/0
msgctxt "Choix"
msgid "I'm already trying my best!"
msgstr "Je fais déjà de mon mieux !"

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-5/0
msgctxt "Nekoboru"
msgid "<i>Continue</i> to train with her. Aspire together. Be her friend."
msgstr "<i>Continue</i> à t'entraîner avec elle. Aspirez ensemble. Fais-en ton amie."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-5/8
msgctxt "Nekoboru"
msgid "But when it comes to matches... do not win."
msgstr "Mais quand viendra le moment des matchs... ne gagne pas."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-5/16/s/0
msgctxt "Choix"
msgid "Okay... I think that makes sense."
msgstr "D'accord... je crois que ça se tient."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-5/17/s/0
msgctxt "Choix"
msgid "Nani!?"
msgstr "Nani !?"

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-5/18/s/0
msgctxt "Choix"
msgid "You want me to... cheat?"
msgstr "Tu veux que je... triche ?"

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-5/c-15/7 hime_anime/Nekoboru_1/0/g-5/c-16/7
msgctxt "Nekoboru"
msgid "Do you not understand your role here!?"
msgstr "Ne comprends-tu pas ton rôle ici !?"

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-6/0/b/1
msgctxt "Nekoboru"
msgid "You said it yourself earlier."
msgstr "Tu l'as dit toi-même tout à l'heure."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-6/3
msgctxt "Nekoboru"
msgid "You <i>are</i> the rest of the cast. Meaning you hold the power of everyone else combined."
msgstr "Tu <i>es</i> le reste de la distribution. Ce qui signifie que tu détiens le pouvoir de tous les autres réunis."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-6/11/s/0
msgctxt "Choix"
msgid "Oh snap."
msgstr "Aïe, aïe, aïe."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-6/12/s/0
msgctxt "Choix"
msgid "You're part of the cast, too!"
msgstr "Toi aussi, tu fais partie de la distribution !"

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-6/13/s/0
msgctxt "Choix"
msgid "Damn it Nekoboru, don't you use my own words against me!"
msgstr "Mince, Nekoboru, ne retourne pas mes propres paroles contre moi !"

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-6/c-18/7
msgctxt "Nekoboru"
msgid "But as far as she knows... I can only say..."
msgstr "Mais pour ce qu'elle en sait... je ne peux que dire..."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-6/c-19/7
msgctxt "Nekoboru"
msgid "Do you see now how vital you are?"
msgstr "Vois-tu à présent à quel point ton rôle est vital ?"

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-7/0
msgctxt "Nekoboru"
msgid "You have the power to grant Hero-hime's dreams."
msgstr "Tu as le pouvoir de réaliser les rêves de Hero-hime."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-7/8
msgctxt "Nekoboru"
msgid "As well as destroy them."
msgstr "Comme de les détruire."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-7/16
msgctxt "Nekoboru"
msgid "Think on this."
msgstr "Réfléchis-y."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-7/24/s/0
msgctxt "Choix"
msgid "But what about the ending of the show?"
msgstr "Mais la fin de la série, alors ?"

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-7/25/s/0
msgctxt "Choix"
msgid "I don't know much, but I do know that Hero-Hime wouldn't want to win like this."
msgstr "Je n'en sais pas beaucoup, mais je sais que Hero-Hime ne voudrait pas gagner comme ça."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-8/0
msgctxt "Nekoboru"
msgid "FORGET anything you know!"
msgstr "OUBLIE tout ce que tu sais !"

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-8/8
msgctxt "Nekoboru"
msgid "Her coming here and meeting you never happened in the anime!!!"
msgstr "Sa venue ici et sa rencontre avec toi n'ont jamais eu lieu dans l'anime !!!"

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-8/16
msgctxt "Nekoboru"
msgid "Consider this a... a filler episode or an OVA added to the special edition Blu-Ray collection!"
msgstr "Considère ça comme un... un épisode de remplissage ou un OVA ajouté au coffret Blu-Ray collector !"

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-8/24
msgctxt "Nekoboru"
msgid "Here she comes!"
msgstr "La voilà !"

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-8/32
msgctxt "Nekoboru"
msgid "Remember! Whatever you do, do not win."
msgstr "Souviens-toi ! Quoi que tu fasses, ne gagne pas."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-8/43
msgctxt "Hero-Hime"
msgid "I'm back! How's Nekoboru doing?"
msgstr "Me revoilà ! Comment va Nekoboru ?"

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-8/59
msgctxt "Hero-Hime"
msgid "Thanks for taking care of him! It's getting late, so let's call it for today."
msgstr "Merci d'avoir veillé sur lui ! Il se fait tard, alors on s'arrête là pour aujourd'hui."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-8/67/s/0
msgctxt "Choix"
msgid "Sounds good!"
msgstr "Ça marche !"

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-8/68/s/0
msgctxt "Choix"
msgid "Hey so... about Nekoboru..."
msgstr "Dis, alors... à propos de Nekoboru..."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-9/0
msgctxt "Hero-Hime"
msgid "What's up?"
msgstr "Qu'est-ce qu'il y a ?"

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-9/8
msgctxt "Nekoboru"
msgid "Nekoboorrruuuu...."
msgstr "Nekoboorrruuuu...."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-9/13/0/s/0
msgctxt "Choix"
msgid "You know what. Never mind."
msgstr "Tu sais quoi. Laisse tomber."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-9/13/1/s/0
msgctxt "Choix"
msgid "He's really cute."
msgstr "Il est vraiment mignon."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-9/13/2/s/0
msgctxt "Choix"
msgid "He wanted me to let you know that I should fix the game and let you win!"
msgstr "Il voulait que je te dise que je devrais truquer le jeu pour te laisser gagner !"

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-9/13/c-0/7
msgctxt "Hero-Hime"
msgid "Oh! Okay then!"
msgstr "Oh ! D'accord, alors !"

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-9/13/c-1/7
msgctxt "Hero-Hime"
msgid "Ahh he isss!"
msgstr "Ahh c'est luiii !"

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-9/13/c-2/7
msgctxt "Hero-Hime"
msgid "...what?"
msgstr "...quoi ?"

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-9/13/c-2/15
msgctxt "Nekoboru"
msgid "NEKOBORU!"
msgstr "NEKOBORU !"

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-9/13/c-2/23
msgctxt "Hero-Hime"
msgid "Is... is that true? Nekoboru... were you trying all along to fix my story in place?? To interfere?"
msgstr "Est-ce que... c'est vrai ? Nekoboru... est-ce que tu essayais depuis le début de figer mon histoire ?? D'interférer ?"

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-9/13/c-2/31
msgctxt "Nekoboru"
msgid "WE ARE DONE HERE, HUMAN."
msgstr "NOUS EN AVONS FINI ICI, HUMAIN."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-9/13/c-2/39
msgctxt "Nekoboru"
msgid "I TRIED. BUT THIS KIND OF MEDDLING HAS RUINED THE LORE ONCE AND FOR ALL."
msgstr "J'AI ESSAYÉ. MAIS CE GENRE D'INGÉRENCE A RUINÉ LE LORE UNE FOIS POUR TOUTES."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-9/13/c-2/47
msgctxt "Nekoboru"
msgid "We'll have to retcon this some other time... maybe even switch animation studios..."
msgstr "Il faudra rectifier le scénario une autre fois... peut-être même changer de studio d'animation..."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-9/14/3
msgctxt "Hero-Hime"
msgid "Let me know when you want to get our next training session in."
msgstr "Dis-moi quand tu veux faire notre prochaine séance d'entraînement."

# Traduction IA – à relire
#: hime_anime/Nekoboru_1/0/g-9/14/11
msgctxt "Hero-Hime"
msgid "Until then, sayonara~!"
msgstr "D'ici là, sayonara~ !"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/6
msgctxt "Hero-Hime"
msgid "Hey there! It's training time!"
msgstr "Salut ! C'est l'heure de l'entraînement !"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/14
msgctxt "Hero-Hime"
msgid "But for today..."
msgstr "Mais pour aujourd'hui..."

# Traduction IA – à relire
#: hime_anime/Hero_4/0/22
msgctxt "Hero-Hime"
msgid "We're going to the beach!"
msgstr "On va à la plage !"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/30/s/0
msgctxt "Choix"
msgid "Hell yeah! Beach episode!"
msgstr "Ouais, carrément ! Épisode plage !"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/31/s/0
msgctxt "Choix"
msgid "Ugh, really? A beach episode?"
msgstr "Pfff, sérieux ? Un épisode plage ?"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-0/0
msgctxt "Hero-Hime"
msgid "Kidding!"
msgstr "Je rigole !"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-0/8
msgctxt "Hero-Hime"
msgid "We'll warm up with some mini-tennis!"
msgstr "On va s'échauffer avec un peu de mini-tennis !"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-0/16/s/0
msgctxt "Choix"
msgid "My beach episode..."
msgstr "Mon épisode plage..."

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-0/17/s/0
msgctxt "Choix"
msgid "What's mini-tennis?"
msgstr "C'est quoi, le mini-tennis ?"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-0/c-2/7
msgctxt "Hero-Hime"
msgid "Sorry, no fan-service today!"
msgstr "Désolée, pas de fan-service aujourd'hui !"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-1/0
msgctxt "Hero-Hime"
msgid "Mini-tennis is where we start at the service line and play with half-swings!"
msgstr "Le mini-tennis, c'est quand on part de la ligne de service et qu'on joue avec des demi-swings !"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-1/8
msgctxt "Hero-Hime"
msgid "It's all about learning control."
msgstr "Tout est une question de contrôle."

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-1/16
msgctxt "Hero-Hime"
msgid "Ready?"
msgstr "{{Prêt|Prête|Prêt·e}} ?"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-1/24
msgctxt "Hero-Hime"
msgid "Go!"
msgstr "Partez !"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-1/32/s/0
msgctxt "Choix"
msgid "<i>Swing normally.</i>"
msgstr "<i>Frapper normalement.</i>"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-1/33/s/0
msgctxt "Choix"
msgid "<i>Swing hard.</i>"
msgstr "<i>Frapper fort.</i>"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-1/34/s/0
msgctxt "Choix"
msgid "<i>Swing-halfway.</i>"
msgstr "<i>Frapper à moitié.</i>"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-1/c-4/7
msgctxt "Hero-Hime"
msgid "Too far!"
msgstr "Trop loin !"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-1/c-4/15 hime_anime/Hero_4/0/g-1/c-5/15
msgctxt "Hero-Hime"
msgid "Do your follow-through, but start your swings from the side rather than behind."
msgstr "Termine bien ton geste, mais lance tes swings depuis le côté plutôt que depuis l'arrière."

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-1/c-5/7
msgctxt "Hero-Hime"
msgid "You over-rotated!!"
msgstr "Tu as trop tourné !!"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-1/c-6/7
msgctxt "Hero-Hime"
msgid "There ya go!"
msgstr "Voilà, c'est ça !"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-2/0
msgctxt "Hero-Hime"
msgid "Okay... Nationals are coming up... and I'm a little worried I might overtrain."
msgstr "Bon... les Nationaux approchent... et j'ai un peu peur de m'entraîner trop."

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-2/8
msgctxt "Hero-Hime"
msgid "I want to make sure I win against you!"
msgstr "Je veux être sûre de gagner contre toi !"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-2/16/s/0
msgctxt "Choix"
msgid "Wait... I'm your opponent?"
msgstr "Attends... je suis ton adversaire ?"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-2/17/s/0
msgctxt "Choix"
msgid "Bring it on!"
msgstr "Vas-y, montre-moi !"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-2/c-7/7
msgctxt "Hero-Hime"
msgid "Of course! Rival, best friend, even the spectator extras who don't have interesting features!"
msgstr "Bien sûr ! Rival, meilleure amie, et même les figurants du public sans traits intéressants !"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-2/c-8/7
msgctxt "Hero-Hime"
msgid "I'll do my best!"
msgstr "Je vais faire de mon mieux !"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-3/3
msgctxt "Hero-Hime"
msgid "So let's call it for today!"
msgstr "Alors on s'arrête là pour aujourd'hui !"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-3/11/s/0
msgctxt "Choix"
msgid "Okay, see you next time Hero-Hime!"
msgstr "D'accord, à la prochaine, Hero-Hime !"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-3/12/s/0
msgctxt "Choix"
msgid "Before we go, mind if I ask you something?"
msgstr "Avant qu'on y aille, je peux te demander un truc ?"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-3/c-9/7
msgctxt "Hero-Hime"
msgid "See ya!"
msgstr "À plus !"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-3/c-10/7
msgctxt "Hero-Hime"
msgid "Sure!"
msgstr "Bien sûr !"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-4/0/s/0
msgctxt "Choix"
msgid "Hero-hime, have you ever lost before?"
msgstr "Hero-hime, tu as déjà perdu ?"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-4/1/s/0
msgctxt "Choix"
msgid "Hero-hime, what's more important, raw talent or hard work?"
msgstr "Hero-hime, qu'est-ce qui compte le plus : le talent brut ou le travail acharné ?"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-4/c-11/7
msgctxt "Hero-Hime"
msgid "Wow! Very direct question..."
msgstr "Wouah ! Question très directe..."

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-4/c-11/15
msgctxt "Hero-Hime"
msgid "I've lost several times actually!"
msgstr "J'ai perdu plusieurs fois, en fait !"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-4/c-12/7
msgctxt "Hero-Hime"
msgid "Oh wow, what an interesting question!"
msgstr "Oh là là, quelle question intéressante !"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-4/c-12/15
msgctxt "Hero-Hime"
msgid "You can find success with either, but I'd have to saaayyy..."
msgstr "On peut réussir avec l'un ou l'autre, mais je dirais queeeee..."

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-4/c-12/23
msgctxt "Hero-Hime"
msgid "HARD WORK!"
msgstr "LE TRAVAIL ACHARNÉ !"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-5/0
msgctxt "Hero-Hime"
msgid "Back in high school, I joined the tennis team but didn't fit in very well."
msgstr "Au lycée, j'ai rejoint l'équipe de tennis, mais je ne m'y suis pas très bien intégrée."

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-5/8
msgctxt "Hero-Hime"
msgid "I was so uncomfortable around my teammates that I played really badly."
msgstr "J'étais tellement mal à l'aise avec mes coéquipières que je jouais très mal."

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-5/16
msgctxt "Hero-Hime"
msgid "We played each other for the main team spots. There were five spots to represent the team."
msgstr "On s'est affrontées pour les places de l'équipe principale. Il y avait cinq places pour représenter l'équipe."

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-5/24
msgctxt "Hero-Hime"
msgid "From lowest to highest skill rating, they were 2nd Doubles, 1st Doubles, 3rd Single, 2nd Single, and 1st Single."
msgstr "Du niveau le plus faible au plus fort : 2e Double, 1er Double, 3e Simple, 2e Simple et 1er Simple."

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-5/32
msgctxt "Hero-Hime"
msgid "I desperately wanted a Singles spot, but right at the most pivotal point... I lost."
msgstr "Je voulais désespérément une place en Simple, mais juste au moment le plus décisif... j'ai perdu."

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-5/40
msgctxt "Hero-Hime"
msgid "The coach said I was still a decent enough player to be 1st Doubles, but my nerves kept acting up."
msgstr "L'entraîneuse a dit que j'étais quand même assez bonne pour le 1er Double, mais mes nerfs me lâchaient sans arrêt."

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-5/48
msgctxt "Hero-Hime"
msgid "We ended up losing the most matches out of the whole team."
msgstr "On a fini par perdre le plus de matchs de toute l'équipe."

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-5/56
msgctxt "Hero-Hime"
msgid "Everyone blamed my poor performance and they weren't wrong..."
msgstr "Tout le monde a mis ça sur le dos de ma mauvaise performance, et ils n'avaient pas tort..."

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-5/64
msgctxt "Hero-Hime"
msgid "That's why I decided to train hard and make sure none of my nerves ever got the best of me again."
msgstr "C'est pour ça que j'ai décidé de m'entraîner dur pour que mes nerfs ne prennent plus jamais le dessus."

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-5/72/s/0
msgctxt "Choix"
msgid "It sounds like losing helped you grow."
msgstr "On dirait que perdre t'a aidée à grandir."

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-5/73/s/0
msgctxt "Choix"
msgid "It hurts to lose, huh?"
msgstr "Ça fait mal de perdre, hein ?"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-6/0
msgctxt "Hero-Hime"
msgid "Of course!"
msgstr "Bien sûr !"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-6/8
msgctxt "Hero-Hime"
msgid "But I won't lose anymore. I'm gonna be the Tennistar, after all!"
msgstr "Mais je ne perdrai plus. Je vais devenir la Tennistar, après tout !"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-6/16/s/0
msgctxt "Choix"
msgid "Would you still love tennis if <i>I</i> became the Tennistar?"
msgstr "Tu aimerais toujours le tennis si c'était <i>moi</i> qui devenais la Tennistar ?"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-6/17/s/0
msgctxt "Choix"
msgid "I'm thinking of letting you win the match so you are sure to become Tennistar..."
msgstr "Je pense à te laisser gagner le match pour que tu deviennes sûrement la Tennistar..."

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-6/c-15/7
msgctxt "Hero-Hime"
msgid "Absolutely! If a hero reaches the top in the first cour, that means that the show has nowhere to go!"
msgstr "Absolument ! Si une héroïne atteint le sommet dès le premier cour, ça veut dire que la série n'a plus nulle part où aller !"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-6/c-15/15
msgctxt "Hero-Hime"
msgid "I want tons of seasons with lots to look forward to!"
msgstr "Je veux plein de saisons, avec plein de choses à attendre !"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-6/c-15/23
msgctxt "Hero-Hime"
msgid "Okay... see you on the court... Rival-san!"
msgstr "Bon... on se retrouve sur le court... Rival-san !"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-6/c-16/7
msgctxt "Hero-Hime"
msgid "What?!"
msgstr "Quoi ?!"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-6/c-16/15
msgctxt "Hero-Hime"
msgid "No... I would never want to earn the title if the match was fixed."
msgstr "Non... Je ne voudrais jamais gagner le titre si le match était truqué."

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-6/c-16/23
msgctxt "Hero-Hime"
msgid "Even if I might have feelings for you - it's more important that the player who gave it their all wins in the end."
msgstr "Même si j'éprouve peut-être des sentiments pour toi, ce qui compte, c'est que la personne qui s'est donnée à fond gagne à la fin."

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-6/c-16/31
msgctxt "Hero-Hime"
msgid "...you're not really thinking of doing that... are you?"
msgstr "...tu ne penses pas vraiment faire ça... n'est-ce pas ?"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-6/c-16/39/0/s/0
msgctxt "Choix"
msgid "I am, actually!"
msgstr "Si, en fait !"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-6/c-16/39/1/s/0
msgctxt "Choix"
msgid "No, not at all!"
msgstr "Non, pas du tout !"

# Traduction IA – à relire
#: hime_anime/Hero_4/0/g-6/c-16/39/c-0/7
msgctxt "Hero-Hime"
msgid "Hmph."
msgstr "Hmph."

# Traduction IA – à relire
