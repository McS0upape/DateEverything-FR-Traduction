msgstr "Je demande aux danseuses ce qu'elles recommandent pour commencer."

# Traduction IA – à relire
#: dasha_desk/the_strip_club/0/c-0/13
msgctxt "Dasha"
msgid "Yes, yes, very good."
msgstr "Oui, oui, très bien."

# Traduction IA – à relire
#: dasha_desk/the_strip_club/0/c-0/21
msgctxt "Dasha"
msgid "Generous. Delicious. Spicy, mmm!"
msgstr "Généreux. Délicieux. Épicé, mmm !"

# Traduction IA – à relire
#: dasha_desk/the_strip_club/0/c-0/29
msgctxt "Dasha"
msgid "All the notes you want to hit for date."
msgstr "Toutes les notes qu'il faut toucher pour un rendez-vous."

# Traduction IA – à relire
#: dasha_desk/the_strip_club/0/c-0/37
msgctxt "Dasha"
msgid "We are off to excellent start."
msgstr "Nous partons sur excellente base."

# Traduction IA – à relire
#: dasha_desk/the_strip_club/0/c-1/13
msgctxt "Dasha"
msgid "I am going to turn around and leave."
msgstr "Je vais faire demi-tour et partir."

# Traduction IA – à relire
#: dasha_desk/the_strip_club/0/c-1/24
msgctxt "Dasha"
