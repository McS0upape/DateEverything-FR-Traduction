msgstr "C'est ça ! N'importe quoi ! Pour moi !"

# Traduction IA – à relire
#: tina_triangle/tina_first_encounter/0/g-2/c-10/56/g-0/19/g-0/16/g-0/16/c-1/24
msgctxt "Tina"
