# Traduction IA – à relire
#: freddy_fridge/1
msgctxt "Tag Nom d'objet (MAJUSCULES)"
msgid "REFRIGERATOR"
msgstr "RÉFRIGÉRATEUR"

# Traduction IA – à relire
#: freddy_fridge/freddy_get_cheese/0/0
msgctxt "Freddy"
msgid "Hmm... time for a snack..."
msgstr "Hmm... l'heure du casse-croûte..."

# Traduction IA – à relire
#: freddy_fridge/freddy_get_cheese/0/8/b/1
msgctxt "Freddy"
msgid "Oh, it's you."
msgstr "Oh, c'est toi."

# Traduction IA – à relire
#: freddy_fridge/freddy_get_cheese/0/11/s/0
msgctxt "Choix"
msgid "Hey, Freddy. Just looking for some cheese."
msgstr "Salut, Freddy. Je cherche du fromage."

# Traduction IA – à relire
#: freddy_fridge/freddy_get_cheese/0/c-0/7
msgctxt "Freddy"
msgid "'Looking for some cheese' is the kinda talk for someone on a quest."
msgstr "« Je cherche du fromage », c'est le genre de phrase d'un aventurier en pleine quête."

# Traduction IA – à relire
#: freddy_fridge/freddy_get_cheese/0/c-0/15
msgctxt "Freddy"
msgid "This ain't a snack, huh?"
msgstr "Ce n'est pas pour un petit creux, hein ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_get_cheese/0/c-0/23/0/s/0
msgctxt "Choix"
msgid "Nope - for Vaughn Trapp!"
msgstr "Non, c'est pour Vaughn Trapp !"

# Traduction IA – à relire
#: freddy_fridge/freddy_get_cheese/0/c-0/23/c-0/7
msgctxt "Freddy"
msgid "Wow. Haven't heard that name in a long time."
msgstr "Wow. Ça faisait longtemps que je n'avais pas entendu ce nom."

# Traduction IA – à relire
#: freddy_fridge/freddy_get_cheese/0/c-0/23/c-0/15
msgctxt "Freddy"
msgid "Well, I got a block of cheddar with your name on it."
msgstr "Bon, j'ai un bloc de cheddar qui porte ton nom."

# Traduction IA – à relire
#: freddy_fridge/freddy_get_cheese/0/c-0/23/c-0/23
msgctxt "Freddy"
msgid "Or well... his name."
msgstr "Enfin... son nom à lui."

# Traduction IA – à relire
#: freddy_fridge/freddy_get_cheese/0/c-0/23/c-0/31
msgctxt "Freddy"
msgid "Anyway, hope it does the trick."
msgstr "Bref, j'espère que ça fera l'affaire."

# Traduction IA – à relire
#: freddy_fridge/freddy_get_cheese/0/c-0/23/c-0/42
msgctxt "Narrator"
msgid "Freddy hands you a small block of cheese."
msgstr "Freddy vous tend un petit bloc de fromage."

# Traduction IA – à relire
#: freddy_fridge/freddy_get_cheese/0/c-0/23/c-0/50/0/s/0
msgctxt "Choix"
msgid "Excellent. Thanks!"
msgstr "Excellent. Merci !"

# Traduction IA – à relire
#: freddy_fridge/freddy_get_cheese/0/c-0/23/c-0/50/c-0/7/b/1
msgctxt "Freddy"
msgid "...tell Vaughn to take care."
msgstr "...dis à Vaughn de faire attention à lui."

# Traduction IA – à relire
#: freddy_fridge/freddy_get_cheese/0/c-0/23/c-0/50/c-0/10/b/1
msgctxt "Freddy"
msgid "No problem. See ya later, cool kid!"
msgstr "Pas de souci. À plus tard, cool kid !"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/3
msgctxt "Narrator"
msgid "You'd hoped to meet your refrigerator, but it seems he's already busy with another guest."
msgstr "Vous espériez rencontrer votre réfrigérateur, mais il semble déjà occupé avec un autre invité."

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/11
msgctxt "Mitchell"
msgid "Freddy... this is all rather dull."
msgstr "Freddy... tout ceci est assez fastidieux."

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/22
msgctxt "Freddy"
msgid "How can you say that when you haven't heard the COOLEST part?"
msgstr "Comment peux-tu dire ça alors que tu n'as pas entendu la partie la plus COOL ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/30
msgctxt "Mitchell"
msgid "Regale me."
msgstr "Régale-moi."

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/38
msgctxt "Freddy"
msgid "The point in which gelatin goes from a liquid to a solid. Can you guess the temperature?"
msgstr "Le moment où la gélatine passe de liquide à solide. Tu devines la température ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/46
msgctxt "Mitchell"
msgid "Certainly."
msgstr "Certainement."

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/54
msgctxt "Freddy"
msgid "Gooooo on. Guess for me."
msgstr "Alleeez. Devine pour moi."

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/62/b/1
msgctxt "Mitchell"
msgid "I do not guess. Perhaps this human would like to assay an attempt?"
msgstr "Je ne devine pas. Peut-être que cet humain voudrait s'y essayer ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/65/b/1
msgctxt "Mitchell"
msgid "I do not guess. Perhaps the human would like to assay an attempt?"
msgstr "Je ne devine pas. Peut-être que l'humain voudrait s'y essayer ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/68/b/1
msgctxt "Mitchell"
msgid "I do not guess. Perhaps my lover would like to assay an attempt?"
msgstr "Je ne devine pas. Peut-être que ma moitié voudrait s'y essayer ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/71/s/0
msgctxt "Choix"
msgid "Umm, below 60 degrees Fahrenheit?"
msgstr "Hum, en dessous de 15 degrés ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/72/s/0
msgctxt "Choix"
msgid "At freezing?"
msgstr "À zéro ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/73/s/0
msgctxt "Choix"
msgid "Trick question. Gelatin is always a soup!"
msgstr "Question piège. La gélatine, c'est toujours de la soupe !"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/c-0/7
msgctxt "Freddy"
msgid "Wooooooow. How did you know?!"
msgstr "Waoooouh. Comment t'as su ?!"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/c-1/7
msgctxt "Freddy"
msgid "Not that cold! It starts at 60 degrees Fahrenheit!"
msgstr "Pas si froid ! Ça commence à 15 degrés !"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/c-2/7
msgctxt "Freddy"
msgid "I... I've never heard of it that way. I think that's wrong. But fun guess!"
msgstr "Je... je ne l'avais jamais entendu comme ça. Je crois que c'est faux. Mais belle tentative !"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-0/0
msgctxt "Mitchell"
msgid "Oh, look at the time. I must be on my way to a more interesting conversation."
msgstr "Oh, regardez l'heure. Je dois filer vers une conversation plus intéressante."

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-0/11
msgctxt "Narrator"
msgid "Now alone, the massive yeti turns his attention to you. You want to speak to him, but it takes you a few moments to process what you're seeing."
msgstr "Maintenant seul, l'immense yéti tourne son attention vers vous. Vous voulez lui parler, mais il vous faut quelques instants pour digérer ce que vous voyez."

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-0/19
msgctxt "Narrator"
msgid "...yep. That is indeed a yeti—massive, furry, and decked out in his finest winter wear."
msgstr "...oui. C'est bien un yéti : massif, velu, et vêtu de ses plus beaux habits d'hiver."

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-0/27
msgctxt "Freddy"
msgid "Huh. He ran like he didn't want to be here or somethin'!"
msgstr "Huh. Il a filé comme s'il n'avait pas envie d'être là ou quoi !"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-0/35
msgctxt "Freddy"
msgid "But you! With the answers and the listening! That can only mean one thing."
msgstr "Mais toi ! Les réponses, l'écoute ! Ça ne peut vouloir dire qu'une chose."

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-0/43/s/0
msgctxt "Choix"
msgid "...that thing is?"
msgstr "...cette chose étant ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-0/44/s/0 freddy_fridge/freddy_intro_encounter/0/g-2/43/s/0
msgctxt "Choix"
msgid "What are you talking about?"
msgstr "De quoi tu parles ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-0/45/s/0
msgctxt "Choix"
msgid "You're madly in love with me?"
msgstr "Tu es dingue de moi ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-0/c-3/7 freddy_fridge/freddy_intro_encounter/0/g-0/c-4/7
msgctxt "Freddy"
msgid "With you standin' in the kitchen, I'm no longer the coolest thing in here!"
msgstr "Avec toi dans la cuisine, je ne suis plus la chose la plus cool ici !"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-0/c-5/7
msgctxt "Freddy"
msgid "Well yeah! But not in an official kinda way."
msgstr "Ben oui ! Mais pas de façon officielle."

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-0/c-5/15
msgctxt "Freddy"
msgid "It's that with you standin' in the kitchen, I'm no longer the coolest thing in here!"
msgstr "C'est que, avec toi dans la cuisine, je ne suis plus la chose la plus cool ici !"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-1/0/s/0
msgctxt "Choix"
msgid "That was... kinda sweet."
msgstr "C'était... plutôt mignon."

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-1/1/s/0
msgctxt "Choix"
msgid "Corny alert!"
msgstr "Alerte ringard !"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-1/c-6/7
msgctxt "Freddy"
msgid "That's me! I try to be sweeter than that chocolate bar you've been hiding from yourself inside the butter drawer for the past few weeks."
msgstr "Tout moi, ça ! J'essaie d'être plus doux que cette tablette de chocolat que tu te caches à toi-même dans le bac à beurre depuis des semaines."

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-1/c-6/15
msgctxt "Freddy"
msgid "Don't worry."
msgstr "Ne t'en fais pas."

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-1/c-6/23
msgctxt "Freddy"
msgid "...I'll never tell."
msgstr "...je ne dirai rien."

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-1/c-7/7
msgctxt "Freddy"
msgid "Canned, creamed, or fritters?"
msgstr "En boîte, en crème ou en beignets ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-2/0
msgctxt "Freddy"
msgid "But really, to what does 'ole Freddy here owe the pleasure of this visit?"
msgstr "Mais sérieusement, à quoi le vieux Freddy doit-il le plaisir de cette visite ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-2/11
msgctxt "Freddy"
msgid "Oh! Did you make another order to Food Fetch?! What did you get this time?"
msgstr "Oh ! Tu as passé une autre commande sur Food Fetch ?! Tu as pris quoi cette fois ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-2/19
msgctxt "Freddy"
msgid "Did you order sushi? Oh, I love it when you get those little rolls that have the tiny bubbles on top."
msgstr "Tu as commandé des sushis ? Oh, j'adore quand tu prends ces petits rouleaux avec les minuscules bulles sur le dessus."

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-2/27
msgctxt "Freddy"
msgid "No! Wait! You know what we haven't had in a while? Burritos!"
msgstr "Non ! Attends ! Tu sais ce qu'on n'a pas eu depuis longtemps ? Des burritos !"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-2/35
msgctxt "Freddy"
msgid "But you might want to hold back on the beans because... well, you know why."
msgstr "Mais tu devrais peut-être y aller doucement sur les haricots parce que... enfin, tu sais pourquoi."

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-2/44/s/0
msgctxt "Choix"
msgid "You got it, Freddy."
msgstr "Comme tu veux, Freddy."

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-2/45/s/0
msgctxt "Choix"
msgid "We're going there already?"
msgstr "On en est déjà là ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-2/c-8/7
msgctxt "Freddy"
msgid "...farts?"
msgstr "...les pets ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-2/c-8/15
msgctxt "Freddy"
msgid "Sorry I know that's not the best thing to talk about but I'm just giving you bean consumption tips!"
msgstr "Désolé, je sais que ce n'est pas le meilleur sujet, mais je te donne juste des conseils sur la consommation de haricots !"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-2/c-10/7
msgctxt "Freddy"
msgid "Hey just tellin' the truth!"
msgstr "Hé, je dis juste la vérité !"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-3/0
msgctxt "Freddy"
msgid "So what are you doin' here now..."
msgstr "Alors qu'est-ce que tu fabriques ici..."

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-3/8
msgctxt "Freddy"
msgid "Don't tell me. Let me guess... let me guess..."
msgstr "Ne me dis rien. Laisse-moi deviner... laisse-moi deviner..."

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-3/16
msgctxt "Freddy"
msgid "Are you feeling fancy today? You look fancy, cool kid. I bet you are feeling fancy."
msgstr "Tu te sens d'humeur raffinée aujourd'hui ? Tu as l'air raffiné, cool kid. Je parie que tu te sens raffiné."

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-3/24
msgctxt "Freddy"
msgid "I got it! You ordered my favorite... that duck from the one place that I can never pronounce."
msgstr "J'ai trouvé ! Tu as commandé mon plat préféré... ce canard de cet endroit que je n'arrive jamais à prononcer."

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-3/32
msgctxt "Freddy"
msgid "I loooooooove duck!"
msgstr "J'adoooore le canard !"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-3/40/s/0
msgctxt "Choix"
msgid "Nope."
msgstr "Non."

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-3/41/s/0
msgctxt "Choix"
msgid "Hmmm... what else do you like?"
msgstr "Hmmm... qu'est-ce que tu aimes d'autre ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-3/42/s/0
msgctxt "Choix"
msgid "What about rubber duck?"
msgstr "Et le canard en plastique ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-3/c-13/7
msgctxt "Freddy"
msgid "Rebel?"
msgstr "Rebel ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-3/c-13/15
msgctxt "Freddy"
msgid "That thing scares me."
msgstr "Cette chose me fait peur."

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-4/0
msgctxt "Freddy"
msgid "Hmm... A burger? Chicken tenders? Empanadas?"
msgstr "Hmm... Un burger ? Des tenders de poulet ? Des empanadas ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-4/8
msgctxt "Freddy"
msgid "Oh, I love when you use Food Fetch!"
msgstr "Oh, j'adore quand tu utilises Food Fetch !"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-4/16
msgctxt "Freddy"
msgid "The possibilities are endless!"
msgstr "Les possibilités sont infinies !"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-4/24
msgctxt "Freddy"
msgid "...as endless as they can be within a 10 mile radius."
msgstr "...aussi infinies qu'elles peuvent l'être dans un rayon de 15 kilomètres."

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-4/32/s/0
msgctxt "Choix"
msgid "Food Fetch is a ripoff! I'm trying to cut back."
msgstr "Food Fetch, c'est de l'arnaque ! J'essaie de réduire."

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-4/33/s/0
msgctxt "Choix"
msgid "We have plenty of food here, don't we?"
msgstr "On a plein de nourriture ici, non ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-4/c-14/7
msgctxt "Freddy"
msgid "Oh! Why didn't you say so?"
msgstr "Oh ! Pourquoi tu ne l'as pas dit plus tôt ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-4/c-15/7
msgctxt "Freddy"
msgid "Oh sure! We sure do!"
msgstr "Oh oui ! Ça, on en a !"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-4/c-15/15
msgctxt "Freddy"
msgid "You sound so adult, cool kid. \"We have food at home!\" Hehehe."
msgstr "Tu parles comme un adulte, cool kid. « On a à manger à la maison ! » Hehehe."

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-4/c-15/23
msgctxt "Freddy"
msgid "But, I guess you do still have stuff left over from the last few Food Fetch orders."
msgstr "Mais bon, il te reste encore des trucs des dernières commandes Food Fetch."

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-4/c-15/31/0/s/0
msgctxt "Choix"
msgid "I wonder what I've got..."
msgstr "Je me demande ce que j'ai..."

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-5/0
msgctxt "Freddy"
msgid "You hungry? What can we get you? We've got those left overs from that Thai Me To The Moon place, the slice of cake from I Like Big Bundts, or the pizza from Pie On Life. Which will it be?"
msgstr "Tu as faim ? Qu'est-ce qu'on te sert ? On a les restes de chez Thai Me To The Moon, la part de gâteau de chez I Like Big Bundts, ou la pizza de chez Pie On Life. Ce sera quoi ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-5/8/s/0
msgctxt "Choix"
msgid "Pad See for me, please!"
msgstr "Du Pad See pour moi, s'il te plaît !"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-5/9/s/0
msgctxt "Choix"
msgid "Cake does sound really good right now."
msgstr "Le gâteau me tente vraiment, là."

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-5/10/s/0
msgctxt "Choix"
msgid "Gimme that 'za!"
msgstr "Passe-moi cette pizza !"

# Traduction IA – à relire
#: freddy_fridge/freddy_intro_encounter/0/g-5/11/s/0
msgctxt "Choix"
msgid "I'm actually not that hungry right now."
msgstr "En fait, je n'ai pas si faim pour l'instant."

# Traduction IA – à relire
#: freddy_fridge/Thai_Me_Moon/0/10
msgctxt "Freddy"
msgid "Excellent choice!"
msgstr "Excellent choix !"

# Traduction IA – à relire
#: freddy_fridge/Thai_Me_Moon/0/18
msgctxt "Freddy"
msgid "If I may describe the dish to you..."
msgstr "Si je peux me permettre de te décrire le plat..."

# Traduction IA – à relire
#: freddy_fridge/Thai_Me_Moon/0/26
msgctxt "Freddy"
msgid "<w>ahem</w>"
msgstr "<w>ahem</w>"

# Traduction IA – à relire
#: freddy_fridge/Thai_Me_Moon/0/37
msgctxt "Freddy"
msgid "What we have for you today is a beautiful Pad See Ew with broccoli, shiitake AND button mushrooms, some egg (?), and just a hint of some kinda spice that makes the whole thing sing!"
msgstr "Ce qu'on a pour toi aujourd'hui, c'est un magnifique Pad See Ew avec du brocoli, des shiitakés ET des champignons de Paris, un peu d'oeuf (?), et juste une pointe d'une épice qui fait chanter l'ensemble !"

# Traduction IA – à relire
#: freddy_fridge/Thai_Me_Moon/0/45
msgctxt "Freddy"
msgid "Aw you can't go wrong with anything from Thai Me To The Moon! They always have the freshest ingredients and best reusable containers!"
msgstr "Ah, on ne peut pas se tromper avec Thai Me To The Moon ! Leurs ingrédients sont toujours ultra frais et leurs boîtes réutilisables sont les meilleures !"

# Traduction IA – à relire
#: freddy_fridge/Thai_Me_Moon/0/53
msgctxt "Freddy"
msgid "And don't worry. I kept it nice and fresh for you."
msgstr "Et ne t'inquiète pas. Je te l'ai gardé bien frais."

# Traduction IA – à relire
#: freddy_fridge/Thai_Me_Moon/0/61
msgctxt "Freddy"
msgid "Remember, heat it up with just a liiiiitle bit of oil in a pan for a few minutes. If you do choose to nuke it, don't do it too long. You could dry the whole thing out!"
msgstr "Rappelle-toi : fais-le réchauffer avec juste un tout petit peu d'huile dans une poêle pendant quelques minutes. Si tu choisis le micro-ondes, ne le laisse pas trop longtemps. Tu risques de tout dessécher !"

# Traduction IA – à relire
#: freddy_fridge/Thai_Me_Moon/0/69/s/0
msgctxt "Choix"
msgid "Thanks for that!"
msgstr "Merci du conseil !"

# Traduction IA – à relire
#: freddy_fridge/Thai_Me_Moon/0/70/s/0
msgctxt "Choix"
msgid "I'll eat it cold. It tastes better that way."
msgstr "Je le mangerai froid. C'est meilleur comme ça."

# Traduction IA – à relire
#: freddy_fridge/Big_Bundts/0/10
msgctxt "Freddy"
msgid "Yummmy! I like big bundts and I cannot lie!"
msgstr "Miam ! J'aime les gros bundts et je ne peux pas le nier !"

# Traduction IA – à relire
#: freddy_fridge/Big_Bundts/0/21
msgctxt "Freddy"
msgid "I am still surprised that you had the willpower to save this thing! This Peaches and Cream Bundt cake is just bursting with flavor!"
msgstr "Je suis encore surpris que tu aies eu la volonté de le garder ! Ce gâteau Bundt pêches-crème déborde de saveur !"

# Traduction IA – à relire
#: freddy_fridge/Big_Bundts/0/29
msgctxt "Freddy"
msgid "No peach flavoring here, cool kid! They use the real stuff!"
msgstr "Pas d'arôme de pêche ici, cool kid ! Ils utilisent de la vraie !"

# Traduction IA – à relire
#: freddy_fridge/Big_Bundts/0/37
msgctxt "Freddy"
msgid "I... did dry it out a bit as I held it for you. Easy fix, though!"
msgstr "Je... l'ai un peu desséché en le gardant pour toi. Mais c'est facile à rattraper !"

# Traduction IA – à relire
#: freddy_fridge/Big_Bundts/0/45
msgctxt "Freddy"
msgid "Get two paper towels kinda moist, put one under the slice and one over it, then slide it into the microwave."
msgstr "Prends deux essuie-tout légèrement humides, mets-en un sous la part et un dessus, puis glisse le tout au micro-ondes."

# Traduction IA – à relire
#: freddy_fridge/Big_Bundts/0/53/s/0
msgctxt "Choix"
msgid "The microwave?"
msgstr "Au micro-ondes ?"

# Traduction IA – à relire
#: freddy_fridge/Big_Bundts/0/c-0/7
msgctxt "Freddy"
msgid "Truuuust me. Just for like... twenty seconds or so? Ka-Pow! A bundt so fluffy you can't help but take a bite!"
msgstr "Fais-moi confiaaance. Juste une vingtaine de secondes, peut-être ? Ka-Pow ! Un Bundt si moelleux que tu ne pourras pas t'empêcher d'y mordre !"

# Traduction IA – à relire
#: freddy_fridge/Big_Bundts/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "Twenty seconds. Got it!"
msgstr "Vingt secondes. Compris !"

# Traduction IA – à relire
#: freddy_fridge/Big_Bundts/0/c-0/15/1/s/0
msgctxt "Choix"
msgid "Stale cake is where it's at! I'll be just fine."
msgstr "Le gâteau rassis, y a que ça de vrai ! Je m'en sortirai très bien."

# Traduction IA – à relire
#: freddy_fridge/Pie_On_Life/0/10
msgctxt "Freddy"
msgid "No such thing as a bad slice of pizza!"
msgstr "Il n'existe pas de mauvaise part de pizza !"

# Traduction IA – à relire
#: freddy_fridge/Pie_On_Life/0/21
msgctxt "Freddy"
msgid "I will say, I was judging you a little when I saw the pineapple on it, cool kid. But, I'll admit it smelled fantastic."
msgstr "Je dois avouer que j'ai eu un petit jugement en voyant l'ananas dessus, cool kid. Mais je reconnais que ça sentait fantastique."

# Traduction IA – à relire
#: freddy_fridge/Pie_On_Life/0/29/s/0
msgctxt "Choix"
msgid "Pineapple on pizza is my reason for living."
msgstr "L'ananas sur la pizza, c'est ma raison de vivre."

# Traduction IA – à relire
#: freddy_fridge/Pie_On_Life/0/30/s/0
msgctxt "Choix"
msgid "Yeah they made a mistake when I delivered."
msgstr "Ouais, ils ont fait une erreur à la livraison."

# Traduction IA – à relire
#: freddy_fridge/Pie_On_Life/0/c-0/11
msgctxt "Freddy"
msgid "Yes! Me too! I was testin' ya!"
msgstr "Oui ! Moi aussi ! Je te testais !"

# Traduction IA – à relire
#: freddy_fridge/Pie_On_Life/0/c-0/28
msgctxt "Freddy"
msgid "Ah just kiddin' cool kid. It's... it's not true love just yet."
msgstr "Ah, je rigole, cool kid. Ce n'est pas encore le grand amour."

# Traduction IA – à relire
#: freddy_fridge/Pie_On_Life/0/c-0/45
msgctxt "Freddy"
msgid "But still... I like your style."
msgstr "Mais quand même... j'aime ton style."

# Traduction IA – à relire
#: freddy_fridge/Pie_On_Life/0/c-1/7
msgctxt "Freddy"
msgid "I hear ya - that can happen. Hope you still gave 'em a good tip!"
msgstr "Je comprends, ça arrive. J'espère que tu leur as quand même laissé un bon pourboire !"

# Traduction IA – à relire
#: freddy_fridge/Pie_On_Life/0/g-0/0
msgctxt "Freddy"
msgid "Man... that pizza... The way that cheese was stretching?"
msgstr "Mec... cette pizza... Tu as vu comme le fromage filait ?"

# Traduction IA – à relire
#: freddy_fridge/Pie_On_Life/0/g-0/8
msgctxt "Freddy"
msgid "I get shivers just thinking about it. So good!"
msgstr "J'en ai des frissons rien que d'y penser. Si bon !"

# Traduction IA – à relire
#: freddy_fridge/Pie_On_Life/0/g-0/16
msgctxt "Freddy"
msgid "The 'za is a way of life!"
msgstr "La pizza, c'est un art de vivre !"

# Traduction IA – à relire
#: freddy_fridge/Pie_On_Life/0/g-0/24
msgctxt "Freddy"
msgid "I know you eat it cold sometimes, but I can make a suggestion on how to make it better?"
msgstr "Je sais que tu la manges parfois froide, mais je peux te suggérer comment la rendre meilleure ?"

# Traduction IA – à relire
#: freddy_fridge/Pie_On_Life/0/g-0/32/s/0
msgctxt "Choix"
msgid "Sure, what'cha got?"
msgstr "Vas-y, je t'écoute."

# Traduction IA – à relire
#: freddy_fridge/Pie_On_Life/0/g-0/33/s/0
msgctxt "Choix"
msgid "Naw, I'll stick with it cold."
msgstr "Non, je garde la version froide."

# Traduction IA – à relire
#: freddy_fridge/Pie_On_Life/0/g-0/c-2/13
msgctxt "Freddy"
msgid "Slide that leftover slice on a pan inside the oven on low. Let that cheese get all gooey again. Then the pizza will be perfection!"
msgstr "Glisse la part de reste sur une plaque dans le four à feu doux. Laisse le fromage redevenir tout coulant. Et la pizza sera parfaite !"

# Traduction IA – à relire
#: freddy_fridge/Pie_On_Life/0/g-0/c-3/7
msgctxt "Freddy"
msgid "Going back to those college days, huh? I feel that. No such thing as a bad way to eat a slice!"
msgstr "Retour aux années fac, hein ? Je comprends. Il n'y a pas de mauvaise façon de manger une part !"

# Traduction IA – à relire
#: freddy_fridge/Pie_On_Life/0/g-0/c-3/15
msgctxt "Freddy"
msgid "If you want to try something new, slide it in the oven for a bit. It will tantalize your taste buds, bud!"
msgstr "Si tu veux essayer du nouveau, glisse-la un moment au four. Elle va émoustiller tes papilles, pote !"

# Traduction IA – à relire
#: freddy_fridge/Intro_encounter_wrapup/0
msgctxt "Freddy"
msgid "Next time you are feeling peckish, you know where to find me, cool kid! I'll be here waiting!"
msgstr "La prochaine fois que tu as un petit creux, tu sais où me trouver, cool kid ! Je serai là à t'attendre !"

# Traduction IA – à relire
#: freddy_fridge/Intro_encounter_wrapup_2/0
msgctxt "Freddy"
msgid "Don't forget you have some tasty dishes waiting here for you, cool kid!"
msgstr "N'oublie pas que de bons petits plats t'attendent ici, cool kid !"

# Traduction IA – à relire
#: freddy_fridge/Intro_encounter_wrapup_2/8
msgctxt "Freddy"
msgid "If you wanna have something later, just let me know!"
msgstr "Si tu veux manger quelque chose plus tard, dis-le-moi !"

# Traduction IA – à relire
#: freddy_fridge/Leftovers/0/0
msgctxt "Freddy"
msgid "Well, if it isn't the coolest human in the kitchen!"
msgstr "Tiens, mais voilà la personne la plus cool de la cuisine !"

# Traduction IA – à relire
#: freddy_fridge/Leftovers/0/8
msgctxt "Freddy"
msgid "I was talking about you, in case you were wondering."
msgstr "Je parlais de toi, au cas où tu te poserais la question."

# Traduction IA – à relire
#: freddy_fridge/Leftovers/0/16/s/0
msgctxt "Choix"
msgid "Thanks Freddy!"
msgstr "Merci Freddy !"

# Traduction IA – à relire
#: freddy_fridge/Leftovers/0/17/s/0
msgctxt "Choix"
msgid "I wasn't wondering."
msgstr "Je ne me posais pas la question."

# Traduction IA – à relire
#: freddy_fridge/Leftovers/0/c-0/7
msgctxt "Freddy"
msgid "Just speakin' truth, cool kid."
msgstr "Je dis juste la vérité, cool kid."

# Traduction IA – à relire
#: freddy_fridge/Leftovers/0/c-1/7
msgctxt "Freddy"
msgid "All right."
msgstr "Bon."

# Traduction IA – à relire
#: freddy_fridge/Leftovers/0/g-0/0
msgctxt "Freddy"
msgid "What can I get for you today?"
msgstr "Qu'est-ce que je peux te servir aujourd'hui ?"

# Traduction IA – à relire
#: freddy_fridge/Leftovers/0/g-0/8/s/0
msgctxt "Choix"
msgid "Eh, maybe I'll eat later."
msgstr "Bof, je mangerai peut-être plus tard."

# Traduction IA – à relire
#: freddy_fridge/Leftovers/0/g-0/9/s/0
msgctxt "Choix"
msgid "What you got that I can munch on?"
msgstr "Qu'est-ce que tu as à me proposer à grignoter ?"

# Traduction IA – à relire
#: freddy_fridge/Leftovers/0/g-0/c-2/7
msgctxt "Freddy"
msgid "Oh, sure! Don't forget to eat though! Every meal is the most important one of the day! I'll be here when you get hungry!"
msgstr "Oh, d'accord ! N'oublie pas de manger quand même ! Chaque repas est le plus important de la journée ! Je serai là quand tu auras faim !"

# Traduction IA – à relire
#: freddy_fridge/Leftovers/0/g-0/c-3/7
msgctxt "Freddy"
msgid "Let's see what's still good in here."
msgstr "Voyons ce qui est encore bon là-dedans."

# Traduction IA – à relire
#: freddy_fridge/Leftovers/0/g-0/c-3/15/b/1
msgctxt "Freddy"
msgid "Oh! We have the Thai food."
msgstr "Oh ! On a le plat thaï."

# Traduction IA – à relire
#: freddy_fridge/Leftovers/0/g-0/c-3/18/b/1
msgctxt "Freddy"
msgid "Still have a few slices of pizza."
msgstr "Il reste encore quelques parts de pizza."

# Traduction IA – à relire
#: freddy_fridge/Leftovers/0/g-0/c-3/21/b/1
msgctxt "Freddy"
msgid "We got that delicious smelling cake waiting for ya!"
msgstr "On a ce gâteau qui sent délicieusement bon et qui t'attend !"

# Traduction IA – à relire
#: freddy_fridge/Leftovers/0/g-0/c-3/24/0/s/0
msgctxt "Choix"
msgid "The pizza for me!"
msgstr "La pizza pour moi !"

# Traduction IA – à relire
#: freddy_fridge/Leftovers/0/g-0/c-3/24/1/s/0
msgctxt "Choix"
msgid "Thai sounds like it'll hit the spot!"
msgstr "Le thaï, ça devrait faire l'affaire !"

# Traduction IA – à relire
#: freddy_fridge/Leftovers/0/g-0/c-3/24/2/s/0
msgctxt "Choix"
msgid "Cake! Cake! Caaaake!"
msgstr "Du gâteau ! Du gâteau ! Du gâââteau !"

# Traduction IA – à relire
#: freddy_fridge/Going_Bad/0/0
msgctxt "Freddy"
msgid "Cool kid! I'm so glad you're here."
msgstr "Cool kid ! Je suis si content que tu sois là."

# Traduction IA – à relire
#: freddy_fridge/Going_Bad/0/8
msgctxt "Freddy"
msgid "I'm really starting to get worried."
msgstr "Je commence vraiment à m'inquiéter."

# Traduction IA – à relire
#: freddy_fridge/Going_Bad/0/16/s/0
msgctxt "Choix"
msgid "About what?"
msgstr "À propos de quoi ?"

# Traduction IA – à relire
#: freddy_fridge/Going_Bad/0/c-0/7
msgctxt "Freddy"
msgid "All this food! You haven't eaten a single bit of it!"
msgstr "Toute cette nourriture ! Tu n'en as pas mangé une miette !"

# Traduction IA – à relire
#: freddy_fridge/Going_Bad/0/c-0/15
msgctxt "Freddy"
msgid "Is everything okay? Did I do something? I promise I'm keeping it as fresh as I can for you!"
msgstr "Tout va bien ? J'ai fait quelque chose ? Je te promets que je la garde aussi fraîche que possible pour toi !"

# Traduction IA – à relire
#: freddy_fridge/Going_Bad/0/c-0/23/0/s/0
msgctxt "Choix"
msgid "Oh yeah. I'm just getting my food from somewhere else!"
msgstr "Oh oui. Je me nourris juste ailleurs !"

# Traduction IA – à relire
#: freddy_fridge/Going_Bad/0/c-0/23/1/s/0
msgctxt "Choix"
msgid "You're more concerned about the food than me?"
msgstr "Tu t'inquiètes plus pour la nourriture que pour moi ?"

# Traduction IA – à relire
#: freddy_fridge/Going_Bad/0/c-0/23/2/s/0
msgctxt "Choix"
msgid "I came here to grab something to eat actually!"
msgstr "En fait, je suis venu chercher quelque chose à manger !"

# Traduction IA – à relire
#: freddy_fridge/Going_Bad/0/c-0/23/c-0/7
msgctxt "Freddy"
msgid "You are getting Food Fetch without me!? I thought that was our thing!"
msgstr "Tu commandes sur Food Fetch sans moi !? Je croyais que c'était notre truc !"

# Traduction IA – à relire
#: freddy_fridge/Going_Bad/0/c-0/23/c-0/15
msgctxt "Freddy"
msgid "Just as long as you are eating, that's all I'm here for."
msgstr "Du moment que tu manges, c'est tout ce qui m'importe."

# Traduction IA – à relire
#: freddy_fridge/Going_Bad/0/c-0/23/c-1/7
msgctxt "Freddy"
msgid "I'm concerned about all of it! I mean, I can only keep things edible for so long. And you NEED FOOD TO LIVE! I like you alive."
msgstr "Je m'inquiète pour tout ! Je ne peux garder les choses comestibles qu'un temps. Et il te FAUT DE LA NOURRITURE POUR VIVRE ! Je te préfère en vie."

# Traduction IA – à relire
#: freddy_fridge/Going_Bad/0/c-0/23/c-2/7
msgctxt "Freddy"
msgid "Phew! And here I was, worried for nothing!"
msgstr "Ouf ! Et moi qui m'inquiétais pour rien !"

# Traduction IA – à relire
#: freddy_fridge/Going_Bad/0/g-0/0
msgctxt "Freddy"
msgid "So... are you thinking about grabbing something to mash between the molars?"
msgstr "Alors... tu penses à prendre de quoi te mettre sous la dent ?"

# Traduction IA – à relire
#: freddy_fridge/Going_Bad/0/g-0/8/s/0
msgctxt "Choix"
msgid "I'm good! Thank you though."
msgstr "Ça va, merci quand même !"

# Traduction IA – à relire
#: freddy_fridge/Going_Bad/0/g-0/9/s/0
msgctxt "Choix"
msgid "All the food talk has made me hungry..."
msgstr "Toute cette conversation sur la bouffe m'a donné faim..."

# Traduction IA – à relire
#: freddy_fridge/Going_Bad/0/g-0/c-1/13
msgctxt "Freddy"
msgid "...okay. If you say so. Just know I wanna make sure you are taken care of, cool kid!"
msgstr "...d'accord. Si tu le dis. Sache juste que je veux m'assurer qu'on prend soin de toi, cool kid !"

# Traduction IA – à relire
#: freddy_fridge/Going_Bad/0/g-0/c-2/7
msgctxt "Freddy"
msgid "GREAT! Let's see what we've got!"
msgstr "SUPER ! Voyons ce qu'on a !"

# Traduction IA – à relire
#: freddy_fridge/Food_Choices/0/0
msgctxt "Freddy"
msgid "Let me see, let me see."
msgstr "Voyons voir, voyons voir."

# Traduction IA – à relire
#: freddy_fridge/Food_Choices/0/16
msgctxt "Freddy"
msgid "Ah! I think these might be on their last leg, BUT they are still good."
msgstr "Ah ! Je crois qu'ils sont en bout de course, MAIS ils sont encore bons."

# Traduction IA – à relire
#: freddy_fridge/Food_Choices/0/24/b/1
msgctxt "Freddy"
msgid "We got a slice 'o' pizza that you can nibble on."
msgstr "On a une part de pizza que tu peux grignoter."

# Traduction IA – à relire
#: freddy_fridge/Food_Choices/0/27/b/1
msgctxt "Freddy"
msgid "The bundt cake can be feasted 'pon!"
msgstr "Le gâteau Bundt n'attend que d'être dévoré !"

# Traduction IA – à relire
#: freddy_fridge/Food_Choices/0/30/b/1
msgctxt "Freddy"
msgid "You could polish off the thai noodles!"
msgstr "Tu pourrais finir les nouilles thaïes !"

# Traduction IA – à relire
#: freddy_fridge/Food_Choices/0/33
msgctxt "Freddy"
msgid "The world is your oyster!"
msgstr "Le monde est ton huître !"

# Traduction IA – à relire
#: freddy_fridge/Food_Choices/0/41
msgctxt "Freddy"
msgid "Oooh... now I want oysters."
msgstr "Oooh... maintenant j'ai envie d'huîtres."

# Traduction IA – à relire
#: freddy_fridge/Food_Choices/0/49/s/0
msgctxt "Choix"
msgid "Pizza never gets old!"
msgstr "La pizza, on ne s'en lasse jamais !"

# Traduction IA – à relire
#: freddy_fridge/Food_Choices/0/50/s/0
msgctxt "Choix"
msgid "Send noods!"
msgstr "Envoie les nouilles !"

# Traduction IA – à relire
#: freddy_fridge/Food_Choices/0/51/s/0
msgctxt "Choix"
msgid "Slide me that dessert!"
msgstr "Passe-moi ce dessert !"

# Traduction IA – à relire
#: freddy_fridge/Food_Choices/0/52/s/0
msgctxt "Choix"
msgid "On second thought... I don't want anything."
msgstr "Tout compte fait... je ne veux rien."

# Traduction IA – à relire
#: freddy_fridge/Food_Choices/0/c-3/19
msgctxt "Freddy"
msgid "Alright, cool kid! I'll try to keep this stuff nice and cool for ya a little while longer."
msgstr "D'accord, cool kid ! J'essaierai de garder tout ça bien au frais encore un moment."

# Traduction IA – à relire
#: freddy_fridge/Food_Choices/0/g-0/0
msgctxt "Freddy"
msgid "There's that piece of chocolate that's calling my name, though."
msgstr "Mais ce morceau de chocolat m'appelle, là."

# Traduction IA – à relire
#: freddy_fridge/Food_Choices/0/g-0/8/s/0
msgctxt "Choix"
msgid "Hey! That's my chocolate!"
msgstr "Hé ! C'est mon chocolat !"

# Traduction IA – à relire
#: freddy_fridge/Food_Choices/0/g-0/9/s/0
msgctxt "Choix"
msgid "I thought you were keeping that safe for me!"
msgstr "Je croyais que tu me le gardais en lieu sûr !"

# Traduction IA – à relire
#: freddy_fridge/Food_Choices/0/g-1/0
msgctxt "Freddy"
msgid "Oh no! Look at the time."
msgstr "Oh non ! Regarde l'heure."

# Traduction IA – à relire
#: freddy_fridge/Food_Choices/0/g-1/8
msgctxt "Freddy"
msgid "Is your refrigerator runnin'?"
msgstr "Ton frigo, il marche ?"

# Traduction IA – à relire
#: freddy_fridge/Food_Choices/0/g-1/16
msgctxt "Freddy"
msgid "Cuz I sure am!"
msgstr "Parce que moi, je cours !"

# Traduction IA – à relire
#: freddy_fridge/Food_Choices/0/g-1/24
msgctxt "Freddy"
msgid "See ya next time, cool kid!"
msgstr "À la prochaine, cool kid !"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Stefan/0/3
msgctxt "Freddy"
msgid "What's wrong with Food Fetch?"
msgstr "Qu'est-ce qui ne va pas avec Food Fetch ?"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Stefan/0/11
msgctxt "Stefan"
msgid "There is nothing wrong with Food Fetch. There is something wrong with us always USING Food Fetch! I was not made to simply... reheat pizza."
msgstr "Il n'y a rien qui ne va pas avec Food Fetch. Ce qui ne va pas, c'est qu'on l'UTILISE tout le temps ! Je n'ai pas été conçu pour simplement... réchauffer de la pizza."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Stefan/0/22
msgctxt "Freddy"
msgid "It's the best way to do it!"
msgstr "C'est la meilleure façon de faire !"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Stefan/0/30
msgctxt "Stefan"
msgid "But, to make your own pizza. To place your own toppings, arranging them into the masterful design, and allowing me to help elevate the dish to the best it can be..."
msgstr "Mais faire sa propre pizza. Choisir ses garnitures, les disposer en une composition magistrale, et me laisser contribuer à élever le plat à son plus haut niveau..."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Stefan/0/38
msgctxt "Stefan"
msgid "...that is the stuff dreams are made of."
msgstr "...voilà l'étoffe des rêves."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Stefan/0/46/s/0 freddy_fridge/freddy_doug_encounter/0/53/s/0
msgctxt "Choix"
msgid "Am I interrupting something?"
msgstr "Je dérange ?"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Stefan/0/47/s/0
msgctxt "Choix"
msgid "What are you two talking about?"
msgstr "De quoi vous parlez, tous les deux ?"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Stefan/0/g-0/0
msgctxt "Freddy"
msgid "Stefan is upset I told him to warm the pizza up in the oven."
msgstr "Stefan est contrarié parce que je lui ai dit de réchauffer la pizza au four."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Stefan/0/g-0/11
msgctxt "Stefan"
msgid "Upset? I'm not upset! You told them what you suggested was correct."
msgstr "Contrarié ? Je ne suis pas contrarié ! Tu as dit à la personne que ta suggestion était la bonne."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Stefan/0/g-0/19
msgctxt "Freddy"
msgid "I just wanted them to have a great lunch. Isn't that what we both want?"
msgstr "Je voulais juste qu'on ait un super déjeuner. N'est-ce pas ce qu'on veut tous les deux ?"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Stefan/0/g-0/27
msgctxt "Stefan"
msgid "Of course I do. Who do you think I am? A good meal is the best thing in the world!"
msgstr "Bien sûr que oui. Pour qui me prends-tu ? Un bon repas est la meilleure chose au monde !"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Stefan/0/g-0/35
msgctxt "Freddy"
msgid "What did you think? Was the pizza better warmed up in the oven?"
msgstr "Alors, t'en as pensé quoi ? La pizza était meilleure réchauffée au four ?"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Stefan/0/g-0/43/s/0
msgctxt "Choix"
msgid "I'll admit, that was the way to go!"
msgstr "Je dois l'admettre, c'était la bonne méthode !"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Stefan/0/g-0/44/s/0
msgctxt "Choix"
msgid "I ate it cold. Like leftover pizza should be eaten."
msgstr "Je l'ai mangée froide. Comme on doit manger les restes de pizza."

# Traduction IA – à relire
#: freddy_fridge/Warm_Pizza/0/0
msgctxt "Freddy"
msgid "See, Stefan? Nothing wrong with some leftovers from Food Fetch."
msgstr "Tu vois, Stefan ? Il n'y a rien de mal à manger des restes de Food Fetch."

# Traduction IA – à relire
#: freddy_fridge/Warm_Pizza/0/8
msgctxt "Stefan"
msgid "...I'm glad you enjoyed that meal then. When you are ready to cook some REAL cuisine, you will know where to find me."
msgstr "...je suis content que ce repas vous ait plu, alors. Quand vous serez {{prêt|prête|prêt·e}} à cuisiner une VRAIE cuisine, vous saurez où me trouver."

# Traduction IA – à relire
#: freddy_fridge/Warm_Pizza/0/16
msgctxt "Freddy"
msgid "Loosen up a bit. Cool kid enjoyed the food. Isn't that all that matters?"
msgstr "Détends-toi un peu. Le cool kid a apprécié la bouffe. N'est-ce pas tout ce qui compte ?"

# Traduction IA – à relire
#: freddy_fridge/Warm_Pizza/0/24
msgctxt "Stefan"
msgid "You have a point, Freddy. I still think fresh cooked pizza would be so delicious."
msgstr "Tu marques un point, Freddy. Je pense toujours qu'une pizza fraîchement cuite serait tellement délicieuse."

# Traduction IA – à relire
#: freddy_fridge/Warm_Pizza/0/32
msgctxt "Stefan"
msgid "I can smell the cheese now. And the tomato sauce. Oh, I'd watch it bubble and crisp up."
msgstr "Je sens déjà le fromage. Et la sauce tomate. Oh, je la regarderais buller et croustiller."

# Traduction IA – à relire
#: freddy_fridge/Warm_Pizza/0/40
msgctxt "Freddy"
msgid "If you're trying to make me hungry, it's working."
msgstr "Si tu essaies de me donner faim, ça marche."

# Traduction IA – à relire
#: freddy_fridge/Warm_Pizza/0/48
msgctxt "Stefan"
msgid "See? You aren't the only one who knows about food, Freddy."
msgstr "Tu vois ? Tu n'es pas le seul à t'y connaître en nourriture, Freddy."

# Traduction IA – à relire
#: freddy_fridge/Warm_Pizza/0/56/s/0
msgctxt "Choix"
msgid "We should make a pizza sometime!"
msgstr "On devrait faire une pizza un de ces jours !"

# Traduction IA – à relire
#: freddy_fridge/Warm_Pizza/0/57/s/0
msgctxt "Choix"
msgid "I'll just order Pie on Life through Food Fetch."
msgstr "Je vais juste commander chez Pie on Life via Food Fetch."

# Traduction IA – à relire
#: freddy_fridge/Warm_Pizza/0/c-0/7
msgctxt "Freddy"
msgid "That's a great idea, cool kid!"
msgstr "Super idée, cool kid !"

# Traduction IA – à relire
#: freddy_fridge/Warm_Pizza/0/c-0/15
msgctxt "Stefan"
msgid "But... it was my idea."
msgstr "Mais... c'était mon idée."

# Traduction IA – à relire
#: freddy_fridge/Warm_Pizza/0/c-0/23
msgctxt "Freddy"
msgid "You're just trying to impress cool kid."
msgstr "Tu essaies juste d'impressionner le cool kid."

# Traduction IA – à relire
#: freddy_fridge/Warm_Pizza/0/c-0/31
msgctxt "Stefan"
msgid "It was MY idea!"
msgstr "C'était MON idée !"

# Traduction IA – à relire
#: freddy_fridge/Warm_Pizza/0/c-0/39
msgctxt "Freddy"
msgid "Okay! If you say so."
msgstr "D'accord ! Si tu le dis."

# Traduction IA – à relire
#: freddy_fridge/Warm_Pizza/0/c-0/47
msgctxt "Stefan"
msgid "You are... something else, Freddy."
msgstr "Tu es... incroyable, Freddy."

# Traduction IA – à relire
#: freddy_fridge/Warm_Pizza/0/c-1/7
msgctxt "Freddy"
msgid "And I'll be here to hold all the leftovers!"
msgstr "Et moi, je serai là pour garder tous les restes !"

# Traduction IA – à relire
#: freddy_fridge/Warm_Pizza/0/g-0/0
msgctxt "Stefan"
msgid "I'm leaving before Freddy makes me start a fire."
msgstr "Je m'en vais avant que Freddy ne me pousse à mettre le feu."

# Traduction IA – à relire
#: freddy_fridge/Warm_Pizza/0/g-0/8
msgctxt "Stefan"
msgid "Let me know when you are ready to do some REAL cooking. You know where to find me."
msgstr "Dites-moi quand vous serez {{prêt|prête|prêt·e}} à faire de la VRAIE cuisine. Vous savez où me trouver."

# Traduction IA – à relire
#: freddy_fridge/Cold_Pizza/0/0
msgctxt "Stefan"
msgid "You did WHAT?!"
msgstr "Tu as fait QUOI ?!"

# Traduction IA – à relire
#: freddy_fridge/Cold_Pizza/0/11
msgctxt "Stefan"
msgid "YOU ATE IT COLD!"
msgstr "TU L'AS MANGÉE FROIDE !"

# Traduction IA – à relire
#: freddy_fridge/Cold_Pizza/0/19
msgctxt "Freddy"
msgid "Oooo, cool kid. You've done it now."
msgstr "Oooh, cool kid. Là, tu l'as fait."

# Traduction IA – à relire
#: freddy_fridge/Cold_Pizza/0/27
msgctxt "Stefan"
msgid "You allowed the human to eat it cold, Freddy?"
msgstr "Tu as laissé l'humain la manger froide, Freddy ?"

# Traduction IA – à relire
#: freddy_fridge/Cold_Pizza/0/35
msgctxt "Freddy"
msgid "What?! I was just doing my job! Cool kid can do whatever they want."
msgstr "Quoi ?! Je faisais juste mon boulot ! Le cool kid fait ce qu'il veut."

# Traduction IA – à relire
#: freddy_fridge/Cold_Pizza/0/43
msgctxt "Stefan"
msgid "We are cooking our own pizza next time, okay?"
msgstr "La prochaine fois, on cuisine notre propre pizza, d'accord ?"

# Traduction IA – à relire
#: freddy_fridge/Cold_Pizza/0/51/s/0
msgctxt "Choix"
msgid "What's wrong with me eating it cold?"
msgstr "Qu'est-ce qui ne va pas à la manger froide ?"

# Traduction IA – à relire
#: freddy_fridge/Cold_Pizza/0/52/s/0
msgctxt "Choix"
msgid "I think Pie on Life is the best pizza!"
msgstr "Je trouve que Pie on Life, c'est la meilleure pizza !"

# Traduction IA – à relire
#: freddy_fridge/Cold_Pizza/0/g-0/0
msgctxt "Stefan"
msgid "...I'm not even going to dignify that with a response. I need to get back to work."
msgstr "...je ne vais même pas daigner répondre à ça. Je dois retourner travailler."

# Traduction IA – à relire
#: freddy_fridge/Pizza_Flirt/0/0
msgctxt "Freddy"
msgid "You'll have to excuse Stefan. Sometimes I think he loves food more than I do."
msgstr "Il faudra excuser Stefan. Parfois je me dis qu'il aime la nourriture plus que moi."

# Traduction IA – à relire
#: freddy_fridge/Pizza_Flirt/0/8
msgctxt "Freddy"
msgid "Which is IMPOSSIBLE! He's just frosty that I had a good idea."
msgstr "Ce qui est IMPOSSIBLE ! Il est juste glacial parce que j'ai eu une bonne idée."

# Traduction IA – à relire
#: freddy_fridge/Pizza_Flirt/0/16
msgctxt "Freddy"
msgid "I know a lot about food!"
msgstr "Je m'y connais en nourriture, moi !"

# Traduction IA – à relire
#: freddy_fridge/Pizza_Flirt/0/24
msgctxt "Freddy"
msgid "You have really good taste, btw."
msgstr "Au fait, t'as vraiment bon goût."

# Traduction IA – à relire
#: freddy_fridge/Pizza_Flirt/0/32/s/0
msgctxt "Choix"
msgid "Did you just say btw out loud?"
msgstr "Tu viens de dire « au fait » en abrégé à voix haute ?"

# Traduction IA – à relire
#: freddy_fridge/Pizza_Flirt/0/c-0/7
msgctxt "Freddy"
msgid "I'm just trying to be a cool kid like you!"
msgstr "J'essaie juste d'être un cool kid comme toi !"

# Traduction IA – à relire
#: freddy_fridge/Pizza_Flirt/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "Well, stop it. I'm the cool one!"
msgstr "Eh bien, arrête. Le cool, c'est moi !"

# Traduction IA – à relire
#: freddy_fridge/Pizza_Flirt/0/c-0/15/1/s/0
msgctxt "Choix"
msgid "You don't have to try so hard. You already are cool."
msgstr "Pas besoin de forcer autant. Tu es déjà cool."

# Traduction IA – à relire
#: freddy_fridge/Pizza_Flirt/0/c-0/15/c-0/7
msgctxt "Freddy"
msgid "You got it, cool kid. You got it."
msgstr "Comme tu veux, cool kid. Comme tu veux."

# Traduction IA – à relire
#: freddy_fridge/Pizza_Flirt/0/c-0/15/c-1/13
msgctxt "Freddy"
msgid "Well, maybe we can chill together more often."
msgstr "Bon, on pourrait peut-être se détendre ensemble plus souvent."

# Traduction IA – à relire
#: freddy_fridge/Pizza_Flirt/0/c-0/15/c-1/21/0/s/0
msgctxt "Choix"
msgid "Good thing I know where to find you!"
msgstr "Heureusement que je sais où te trouver !"

# Traduction IA – à relire
#: freddy_fridge/Pizza_Flirt/0/c-0/15/c-1/21/1/s/0
msgctxt "Choix"
msgid "Eh, if I get hungry, I'll swing by."
msgstr "Bah, si j'ai faim, je passerai."

# Traduction IA – à relire
#: freddy_fridge/Pizza_Flirt/0/c-0/15/c-1/21/c-0/7
msgctxt "Freddy"
msgid "I'll be chilling here, waiting for you!"
msgstr "Je serai là à me rafraîchir, à t'attendre !"

# Traduction IA – à relire
#: freddy_fridge/Pizza_Flirt/0/c-0/15/c-1/21/c-1/7
msgctxt "Freddy"
msgid "Morning munchies or midnight snack, I'll be here!"
msgstr "Petit creux du matin ou grignotage de minuit, je serai là !"

# Traduction IA – à relire
#: freddy_fridge/Pizza_wrapup/0/4
msgctxt "Freddy"
msgid "Oh! Before you go! Do you want a snack?"
msgstr "Oh ! Avant que tu partes ! Tu veux un en-cas ?"

# Traduction IA – à relire
#: freddy_fridge/Pizza_wrapup/0/12/s/0
msgctxt "Choix"
msgid "Sure! Thanks!"
msgstr "Avec plaisir ! Merci !"

# Traduction IA – à relire
#: freddy_fridge/Pizza_wrapup/0/13/s/0
msgctxt "Choix"
msgid "I'm okay!"
msgstr "Ça va, merci !"

# Traduction IA – à relire
#: freddy_fridge/Pizza_wrapup/0/c-0/16
msgctxt "Freddy"
msgid "Great! Here you go!"
msgstr "Super ! Tiens !"

# Traduction IA – à relire
#: freddy_fridge/Pizza_wrapup/0/c-0/24/0/s/0
msgctxt "Choix"
msgid "Uh... what?"
msgstr "Euh... quoi ?"

# Traduction IA – à relire
#: freddy_fridge/Pizza_wrapup/0/c-0/24/c-0/7
msgctxt "Freddy"
msgid "Oh, I thought you said."
msgstr "Oh, je croyais que tu avais dit oui."

# Traduction IA – à relire
#: freddy_fridge/Pizza_wrapup/0/c-0/24/c-0/15
msgctxt "Freddy"
msgid "Haha!"
msgstr "Haha !"

# Traduction IA – à relire
#: freddy_fridge/Pizza_wrapup/0/c-0/24/c-0/23
msgctxt "Freddy"
msgid "Well!"
msgstr "Bon !"

# Traduction IA – à relire
#: freddy_fridge/Pizza_wrapup/0/c-0/24/c-0/31
msgctxt "Freddy"
msgid "Just keep it."
msgstr "Garde-le, c'est tout."

# Traduction IA – à relire
#: freddy_fridge/Pizza_wrapup/0/c-1/7
msgctxt "Freddy"
msgid "Okay cool. Maybe next time."
msgstr "Ok, cool. Peut-être la prochaine fois."

# Traduction IA – à relire
#: freddy_fridge/Pizza_wrapup/0/g-0/0
msgctxt "Freddy"
msgid "I'll see you around, cool kid!"
msgstr "À plus tard, cool kid !"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Beverly/0/0
msgctxt "Freddy"
msgid "Hey! Cool kid! Good to see you again! Wait right here."
msgstr "Hé ! Cool kid ! Content de te revoir ! Attends ici."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Beverly/0/8
msgctxt "Freddy"
msgid "Beverly!! COME HERE!"
msgstr "Beverly !! VIENS ICI !"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Beverly/0/16/s/0
msgctxt "Choix"
msgid "What's all this about?"
msgstr "C'est quoi, tout ça ?"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Beverly/0/17/s/0
msgctxt "Choix"
msgid "Beverly? Why are you calling her?"
msgstr "Beverly ? Pourquoi tu l'appelles ?"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Beverly/0/18/s/0
msgctxt "Choix"
msgid "What is a Beverly?"
msgstr "C'est quoi, une Beverly ?"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Beverly/0/c-2/7
msgctxt "Freddy"
msgid "The beverages! Found in the mini-bar over yonder."
msgstr "Les boissons ! On les trouve au mini-bar, là-bas."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Beverly/0/g-0/0
msgctxt "Freddy"
msgid "She told me to let her know next time you came by."
msgstr "Elle m'a demandé de la prévenir la prochaine fois que tu passerais."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Beverly/0/g-0/14/b/1
msgctxt "Beverly"
msgid "Is he back?"
msgstr "Il est de retour ?"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Beverly/0/g-0/17/b/1
msgctxt "Beverly"
msgid "Is she back?"
msgstr "Elle est de retour ?"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Beverly/0/g-0/20/b/1
msgctxt "Beverly"
msgid "Are they back?"
msgstr "Iel est de retour ?"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Beverly/0/g-0/23
msgctxt "Freddy"
msgid "Yep! Right here."
msgstr "Ouaip ! Juste ici."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Beverly/0/g-0/31/b/1
msgctxt "Beverly"
msgid "Ah - hello, hater. This isn't about us. It's about Freddy."
msgstr "Ah, bonjour, rabat-joie. Ce n'est pas de nous qu'il s'agit. C'est de Freddy."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Beverly/0/g-0/34/b/1
msgctxt "Beverly"
msgid "There you are!"
msgstr "Te voilà !"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Beverly/0/g-0/37/b/1
msgctxt "Beverly"
msgid "So good to see ya! The Tumbler has been doing real well thanks to you."
msgstr "Ravie de te voir ! Le Tumbler marche très bien grâce à toi."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Beverly/0/g-0/40
msgctxt "Beverly"
msgid "Listen, I know that Freddy here has been giving you some good advice on food. He told me about your <i>spicy</i> session..."
msgstr "Écoute, je sais que Freddy t'a donné de bons conseils culinaires. Il m'a parlé de ta séance <i>épicée</i>..."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Beverly/0/g-0/48/b/1
msgctxt "Freddy"
msgid "Just helping him elevate those leftovers!"
msgstr "Je l'aidais juste à sublimer ses restes !"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Beverly/0/g-0/51/b/1
msgctxt "Freddy"
msgid "Just helping her elevate those leftovers!"
msgstr "Je l'aidais juste à sublimer ses restes !"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Beverly/0/g-0/54/b/1
msgctxt "Freddy"
msgid "Just helping them elevate those leftovers!"
msgstr "Je l'aidais juste à sublimer ses restes !"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Beverly/0/g-0/57
msgctxt "Beverly"
msgid "That's what I like about you, Freddy. Always thinking about how to make things better."
msgstr "C'est ce que j'aime chez toi, Freddy. Toujours en train de chercher comment améliorer les choses."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Beverly/0/g-0/65
msgctxt "Beverly"
msgid "But! You know what every good meal should have?"
msgstr "Mais ! Tu sais ce que tout bon repas devrait avoir ?"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Beverly/0/g-0/73
msgctxt "Beverly"
msgid "A drink!"
msgstr "Un verre !"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Beverly/0/g-0/84/s/0
msgctxt "Choix"
msgid "A drink? Now? Isn't it too early?"
msgstr "Un verre ? Maintenant ? C'est pas un peu tôt ?"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Beverly/0/g-0/85/s/0
msgctxt "Choix"
msgid "A drink sounds fantastic!"
msgstr "Un verre, ça me tente énormément !"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Beverly/0/g-0/86/s/0
msgctxt "Choix"
msgid "Perfect time for drinking if you ask me."
msgstr "Si tu veux mon avis, c'est le moment idéal pour boire."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Beverly/0/g-0/c-3/7
msgctxt "Beverly"
msgid "Nonsense! It's never too early."
msgstr "Balivernes ! Il n'est jamais trop tôt."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Beverly/0/g-0/c-4/7
msgctxt "Beverly"
msgid "That's the spirits! Freddy, be a dear and bust out some ice!"
msgstr "Voilà qui est spiritueux ! Freddy, sois un amour et sors-nous de la glace !"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Beverly/0/g-0/c-5/7
msgctxt "Beverly"
msgid "That's the spirit!"
msgstr "Voilà l'esprit... de vin !"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Beverly/0/g-0/c-5/15
msgctxt "Beverly"
msgid "LITERALLY"
msgstr "LITTÉRALEMENT"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Beverly/0/g-1/0
msgctxt "Freddy"
msgid "Bev knows what pairs with everything."
msgstr "Bev sait ce qui s'accorde avec tout."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Beverly/0/g-1/8
msgctxt "Beverly"
msgid "I have the perfect thing. A nice Pinot Noir! I could grab a bottle right now, if you want. What do you think, Freddy?"
msgstr "J'ai ce qu'il faut. Un joli Pinot noir ! Je peux en sortir une bouteille tout de suite, si tu veux. Qu'en dis-tu, Freddy ?"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Beverly/0/g-1/16
msgctxt "Freddy"
msgid "I leave that up to the cool kid! What do you think?"
msgstr "Je laisse le cool kid décider ! Qu'en penses-tu ?"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Beverly/0/g-1/24/s/0
msgctxt "Choix"
msgid "Bottoms up!"
msgstr "Cul sec !"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Beverly/0/g-1/25/s/0
msgctxt "Choix"
msgid "I think I'll pass this time."
msgstr "Je crois que je passe mon tour cette fois."

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/0
msgctxt "Beverly"
msgid "Great! Let me grab some glasses!"
msgstr "Parfait ! Je vais chercher des verres !"

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/11
msgctxt "Freddy"
msgid "Look at us! Sharing a drink with the coolest person around!"
msgstr "Regardez-nous ! En train de partager un verre avec la personne la plus cool des environs !"

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/19/s/0
msgctxt "Choix"
msgid "I know! It's almost like... a date..."
msgstr "Je sais ! On dirait presque... un rendez-vous..."

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/c-0/7
msgctxt "Narrator"
msgid "Freddy's bushy eyebrows raise—he looks taken aback, but not horrified by the idea."
msgstr "Les sourcils broussailleux de Freddy se haussent. Il paraît pris de court, mais pas horrifié par l'idée."

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/c-0/15
msgctxt "Freddy"
msgid "A date? I hadn't thought about it like that."
msgstr "Un rendez-vous ? Je n'y avais pas pensé comme ça."

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/c-0/23
msgctxt "Freddy"
msgid "Is that something you would ever want to do?"
msgstr "C'est quelque chose que tu voudrais faire un jour ?"

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/c-0/31/0/s/0
msgctxt "Choix"
msgid "I mean, if you're cool with it."
msgstr "Je veux dire, si ça te va."

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/c-0/31/1/s/0
msgctxt "Choix"
msgid "Oh, I don't know. Maybe?"
msgstr "Oh, je ne sais pas. Peut-être ?"

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/c-0/31/2/s/0
msgctxt "Choix"
msgid "Not really, no."
msgstr "Pas vraiment, non."

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/c-0/31/c-0/13
msgctxt "Freddy"
msgid "Huh, I mean I wouldn't mind it..."
msgstr "Hum, enfin, ça ne me dérangerait pas..."

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/c-0/31/c-1/7
msgctxt "Freddy"
msgid "Okay, playing it cool."
msgstr "Ok, on reste cool."

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/c-0/31/c-2/7
msgctxt "Freddy"
msgid "Cool cool cool cool cool."
msgstr "Cool cool cool cool cool."

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/c-0/31/c-2/15
msgctxt "Freddy"
msgid "Me either..."
msgstr "Moi non plus..."

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/g-0/0
msgctxt "Beverly"
msgid "Okay! Here we go! This is a delicious grape."
msgstr "Voilà ! C'est un délicieux raisin."

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/g-0/11
msgctxt "Freddy"
msgid "Here's to you, cool kid!"
msgstr "À toi, cool kid !"

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/g-0/19/s/0
msgctxt "Choix"
msgid "<i>Drink all in one gulp.</i>"
msgstr "<i>Boire d'un trait.</i>"

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/g-0/20/s/0
msgctxt "Choix"
msgid "<i>Slowly sip.</i>"
msgstr "<i>Siroter lentement.</i>"

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/g-0/21/s/0
msgctxt "Choix"
msgid "<i>Attempt to eat the glass.</i>"
msgstr "<i>Tenter de manger le verre.</i>"

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/g-0/c-1/7
msgctxt "Narrator"
msgid "You take the glass from Beverly and drain it in one go."
msgstr "Vous prenez le verre des mains de Beverly et le videz d'un trait."

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/g-0/c-1/18
msgctxt "Beverly"
msgid "Oh wow! You must have been thirsty!"
msgstr "Oh wow ! Tu devais avoir soif !"

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/g-0/c-1/26
msgctxt "Beverly"
msgid "There was a time where people didn't pair their foods with alcohol like they do now."
msgstr "Il fut un temps où les gens n'associaient pas leurs plats à l'alcool comme aujourd'hui."

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/g-0/c-1/34 freddy_fridge/Drinking_With_Friends/0/g-0/c-2/37 freddy_fridge/Drinking_With_Friends/0/g-0/c-3/35/c-0/39
msgctxt "Beverly"
msgid "I like to call those the dark ages."
msgstr "J'aime appeler ça le Moyen Âge."

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/g-0/c-2/7
msgctxt "Narrator"
msgid "You take the glass from Beverly, taking a slow, dignified sip and savoring it."
msgstr "Vous prenez le verre des mains de Beverly et prenez une lente gorgée, pleine de dignité, en la savourant."

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/g-0/c-2/21
msgctxt "Freddy"
msgid "Savoring the flavor. Nice!"
msgstr "On savoure les arômes. Bien !"

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/g-0/c-2/29
msgctxt "Beverly"
msgid "There was a time where people didn't pair their foods with alcohols like they do now."
msgstr "Il fut un temps où les gens n'associaient pas leurs plats aux alcools comme aujourd'hui."

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/g-0/c-3/7
msgctxt "Narrator"
msgid "You raise the glass up, inspecting it in silence for a few moments before you bring it to your lips and begin to crunch it down."
msgstr "Vous levez le verre et l'inspectez en silence quelques instants avant de le porter à vos lèvres et de commencer à le croquer."

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/g-0/c-3/18/b/1
msgctxt "Beverly"
msgid "WHAT THE HELL IS HE DOING"
msgstr "MAIS QU'EST-CE QU'IL FOUT"

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/g-0/c-3/21/b/1
msgctxt "Beverly"
msgid "WHAT THE HELL IS SHE DOING"
msgstr "MAIS QU'EST-CE QU'ELLE FOUT"

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/g-0/c-3/24/b/1
msgctxt "Beverly"
msgid "WHAT THE HELL ARE THEY DOING"
msgstr "MAIS QU'EST-CE QU'IEL FOUT"

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/g-0/c-3/27
msgctxt "Freddy"
msgid "Hey, cool kid. Eating glass isn't cool."
msgstr "Hé, cool kid. Manger du verre, c'est pas cool."

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/g-0/c-3/35/0/s/0
msgctxt "Choix"
msgid "But Beverly said it was a delicious grape, I thought I could eat it."
msgstr "Mais Beverly a dit que c'était un délicieux raisin, je pensais pouvoir le manger."

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/g-0/c-3/35/1/s/0
msgctxt "Choix"
msgid "<i>Stare directly at Freddy and continue to try to eat the glass.</i>"
msgstr "<i>Fixer Freddy droit dans les yeux et continuer d'essayer de manger le verre.</i>"

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/g-0/c-3/35/c-0/7
msgctxt "Beverly"
msgid "I'll watch my words from now on..."
msgstr "Je vais surveiller mes paroles à partir de maintenant..."

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/g-0/c-3/35/c-0/15
msgctxt "Freddy"
msgid "Eh it's okay, Bev. We're just having fun here..."
msgstr "Eh, c'est bon, Bev. On s'amuse, c'est tout..."

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/g-0/c-3/35/c-0/23
msgctxt "Beverly"
msgid "Looks like it."
msgstr "On dirait bien."

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/g-0/c-3/35/c-0/31
msgctxt "Beverly"
msgid "It's funny... There was a time where people didn't pair their foods with alcohol like they do now."
msgstr "C'est drôle... Il fut un temps où les gens n'associaient pas leurs plats à l'alcool comme aujourd'hui."

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/g-0/c-3/35/c-1/7
msgctxt "Narrator"
msgid "You stare unblinking at Freddy, taking a massive bite of glass and chewing it completely stone faced as though this weren't the worst thing you've ever done in your life."
msgstr "Vous fixez Freddy sans ciller, croquez une énorme bouchée de verre et la mâchez avec un visage de marbre, comme si ce n'était pas la pire chose que vous ayez jamais faite de votre vie."

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/g-0/c-3/35/c-1/18
msgctxt "Freddy"
msgid "Alright we're done here."
msgstr "Bon, on arrête là."

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/g-1/0
msgctxt "Beverly"
msgid "But with how much ice our Yeti friend here can hold, I don't see why anyone wouldn't shake up a drink with every meal!"
msgstr "Mais avec toute la glace que notre ami le Yéti peut contenir, je ne vois pas pourquoi on ne secouerait pas un cocktail à chaque repas !"

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/g-1/8
msgctxt "Beverly"
msgid "Heeeeey I just had an idea for a drink - white wine, ice, lime, sugar, bird's eye chili..."
msgstr "Heeeeey, je viens d'avoir une idée de boisson : vin blanc, glace, citron vert, sucre, piment oiseau..."

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/g-1/16
msgctxt "Beverly"
msgid "I gotta get mixing!"
msgstr "Faut que j'aille mixer !"

# Traduction IA – à relire
#: freddy_fridge/Drinking_With_Friends/0/g-1/24
msgctxt "Beverly"
msgid "Back to the bar - but, next time you talk leftovers, let me help you complete the meal!"
msgstr "Retour au bar, mais la prochaine fois que vous parlez restes, laissez-moi vous aider à compléter le repas !"

# Traduction IA – à relire
#: freddy_fridge/Water_For_Me/0/0
msgctxt "Beverly"
msgid "Totally fine. At least you listened to Freddy and warmed the Thai food up the right way."
msgstr "Pas de souci. Au moins, tu as écouté Freddy et tu as réchauffé le plat thaï comme il faut."

# Traduction IA – à relire
#: freddy_fridge/Water_For_Me/0/8
msgctxt "Beverly"
msgid "Yeah, how did you warm it up?"
msgstr "Oui, comment tu l'as réchauffé ?"

# Traduction IA – à relire
#: freddy_fridge/Water_For_Me/0/16/s/0
msgctxt "Choix"
msgid "In... the microwave? Just like you told me."
msgstr "Au... micro-ondes ? Comme tu me l'avais dit."

# Traduction IA – à relire
#: freddy_fridge/Water_For_Me/0/17/s/0
msgctxt "Choix"
msgid "On the stove with just a touch of oil! It was delicious!"
msgstr "À la poêle avec juste un soupçon d'huile ! C'était délicieux !"

# Traduction IA – à relire
#: freddy_fridge/Water_For_Me/0/18/s/0
msgctxt "Choix"
msgid "I ate it cold. Everything tastes better after Freddy holds it!"
msgstr "Je l'ai mangé froid. Tout a meilleur goût quand Freddy l'a gardé !"

# Traduction IA – à relire
#: freddy_fridge/Water_For_Me/0/c-0/7
msgctxt "Freddy"
msgid "That's not what I said."
msgstr "Ce n'est pas ce que j'ai dit."

# Traduction IA – à relire
#: freddy_fridge/Water_For_Me/0/c-0/15
msgctxt "Beverly"
msgid "Were you even listening to him?"
msgstr "Tu l'écoutais seulement ?"

# Traduction IA – à relire
#: freddy_fridge/Water_For_Me/0/c-1/13
msgctxt "Freddy"
msgid "Hey! You remembered! That's so cool of you!"
msgstr "Hé ! Tu t'en souviens ! C'est trop cool de ta part !"

# Traduction IA – à relire
#: freddy_fridge/Water_For_Me/0/c-1/21
msgctxt "Beverly"
msgid "You've got yourself a friend there, don't you Freddy?"
msgstr "Tu t'es fait un ami, là, non, Freddy ?"

# Traduction IA – à relire
#: freddy_fridge/Water_For_Me/0/c-2/13
msgctxt "Freddy"
msgid "Oh, really? That's so sweet of you to say."
msgstr "Oh, vraiment ? C'est adorable de dire ça."

# Traduction IA – à relire
#: freddy_fridge/Water_For_Me/0/c-2/21
msgctxt "Beverly"
msgid "Sweeter than a Tequila Sunrise, if you ask me."
msgstr "Plus doux qu'un Tequila Sunrise, si tu veux mon avis."

# Traduction IA – à relire
#: freddy_fridge/Water_For_Me/0/c-2/29
msgctxt "Beverly"
msgid "Which reminds me, do you have some orange juice, Freddy?"
msgstr "Ce qui me fait penser : tu as du jus d'orange, Freddy ?"

# Traduction IA – à relire
#: freddy_fridge/Water_For_Me/0/c-2/37
msgctxt "Freddy"
msgid "Sure do. Here you go!"
msgstr "Bien sûr. Tiens !"

# Traduction IA – à relire
#: freddy_fridge/Water_For_Me/0/c-2/45
msgctxt "Beverly"
msgid "Thanks! I've got an idea for a cocktail that'll knock your ice cubes loose!"
msgstr "Merci ! J'ai une idée de cocktail qui va faire sauter tes glaçons !"

# Traduction IA – à relire
#: freddy_fridge/Water_For_Me/0/c-2/53
msgctxt "Beverly"
msgid "Orange juice, beer, celery... and pickle juice."
msgstr "Jus d'orange, bière, céleri... et jus de cornichon."

# Traduction IA – à relire
#: freddy_fridge/Water_For_Me/0/c-2/61
msgctxt "Beverly"
msgid "...I might need beer, celery, and pickle juice too."
msgstr "...il me faudra aussi de la bière, du céleri et du jus de cornichon."

# Traduction IA – à relire
#: freddy_fridge/Water_For_Me/0/c-2/69
msgctxt "Freddy"
msgid "Not a problem at all. Take whatever you like."
msgstr "Aucun problème. Prends ce que tu veux."

# Traduction IA – à relire
#: freddy_fridge/Water_For_Me/0/c-2/77
msgctxt "Beverly"
msgid "Oh... there's a chocolate bar here too!"
msgstr "Oh... il y a une tablette de chocolat ici aussi !"

# Traduction IA – à relire
#: freddy_fridge/Water_For_Me/0/c-2/85
msgctxt "Freddy"
msgid "Except that..."
msgstr "Sauf que..."

# Traduction IA – à relire
#: freddy_fridge/Water_For_Me/0/c-2/93
msgctxt "Beverly"
msgid "Ah okay! Well, I'll leave you both to it!"
msgstr "Ah d'accord ! Bon, je vous laisse tous les deux !"

# Traduction IA – à relire
#: freddy_fridge/Water_For_Me/0/c-2/101/b/1
msgctxt "Beverly"
msgid "Come by later... I need your help with something."
msgstr "Passe me voir plus tard... j'ai besoin de ton aide pour un truc."

# Traduction IA – à relire
#: freddy_fridge/Water_For_Me/0/c-2/104/b/1
msgctxt "Beverly"
msgid "Come by the Tumbler - we'll always have ya."
msgstr "Passe au Tumbler, on sera toujours là pour toi."

# Traduction IA – à relire
#: freddy_fridge/Thai_wrapup/0/7
msgctxt "Freddy"
msgid "Beverly sure is chill. I like being around her."
msgstr "Beverly est vraiment cool. J'aime bien être avec elle."

# Traduction IA – à relire
#: freddy_fridge/Thai_wrapup/0/15
msgctxt "Freddy"
msgid "But anytime she comes by I've gotta get to making more ice."
msgstr "Mais chaque fois qu'elle passe, je dois me remettre à faire de la glace."

# Traduction IA – à relire
#: freddy_fridge/Thai_wrapup/0/23
msgctxt "Freddy"
msgid "Hey... Thanks so much for stopping by!"
msgstr "Hé... Merci beaucoup de ta visite !"

# Traduction IA – à relire
#: freddy_fridge/Thai_wrapup/0/31
msgctxt "Freddy"
msgid "Before you go, you want a little something to nibble on?"
msgstr "Avant de partir, tu veux un petit quelque chose à grignoter ?"

# Traduction IA – à relire
#: freddy_fridge/Thai_wrapup/0/39/s/0
msgctxt "Choix"
msgid "I'm okay. Thanks though!"
msgstr "Ça va, merci quand même !"

# Traduction IA – à relire
#: freddy_fridge/Thai_wrapup/0/40/s/0
msgctxt "Choix"
msgid "Sure! What you got!"
msgstr "Avec plaisir ! Qu'est-ce que t'as ?"

# Traduction IA – à relire
#: freddy_fridge/Thai_wrapup/0/c-0/7
msgctxt "Freddy"
msgid "Sure thing! I'll see you later then!"
msgstr "Pas de problème ! À plus tard alors !"

# Traduction IA – à relire
#: freddy_fridge/Thai_wrapup/0/c-1/13 freddy_fridge/Cake_Wrapup/0/c-0/13
msgctxt "Freddy"
msgid "Been saving a piece of chocolate just for you."
msgstr "Je gardais un morceau de chocolat rien que pour toi."

# Traduction IA – à relire
#: freddy_fridge/Thai_wrapup/0/c-1/21 freddy_fridge/Cake_Wrapup/0/c-0/21
msgctxt "Freddy"
msgid "You know... a sweet for the sweet!"
msgstr "Tu sais... une douceur pour une douceur !"

# Traduction IA – à relire
#: freddy_fridge/Thai_wrapup/0/c-1/29/0/s/0 freddy_fridge/Cake_Wrapup/0/c-0/29/0/s/0
msgctxt "Choix"
msgid "You're too kind."
msgstr "C'est trop gentil."

# Traduction IA – à relire
#: freddy_fridge/Thai_wrapup/0/c-1/29/1/s/0 freddy_fridge/Cake_Wrapup/0/c-0/29/1/s/0
msgctxt "Choix"
msgid "Nah, you can have it."
msgstr "Non, garde-le."

# Traduction IA – à relire
#: freddy_fridge/Thai_wrapup/0/c-1/29/c-0/7 freddy_fridge/Cake_Wrapup/0/c-0/29/c-0/7
msgctxt "Freddy"
msgid "I try!"
msgstr "Je fais de mon mieux !"

# Traduction IA – à relire
#: freddy_fridge/Thai_wrapup/0/c-1/29/c-1/7 freddy_fridge/Cake_Wrapup/0/c-0/29/c-1/7
msgctxt "Freddy"
msgid "Really...?"
msgstr "Vraiment... ?"

# Traduction IA – à relire
#: freddy_fridge/Thai_wrapup/0/c-1/29/c-1/21 freddy_fridge/Cake_Wrapup/0/c-0/29/c-1/21
msgctxt "Freddy"
msgid "Thanks, cool kid. You're a real one."
msgstr "Merci, cool kid. Tu assures vraiment."

# Traduction IA – à relire
#: freddy_fridge/Thai_wrapup/0/g-0/0
msgctxt "Freddy"
msgid "Okay. I gotta get to work. See you around soon!"
msgstr "Bon. Faut que je m'y remette. À bientôt !"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/0
msgctxt "Freddy"
msgid "Hey, cool kid! Good to see you again! How's things?"
msgstr "Hé, cool kid ! Content de te revoir ! Comment ça va ?"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/8
msgctxt "Luke"
msgid "FREDDY!!!"
msgstr "FREDDY !!!"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/19
msgctxt "Narrator"
msgid "Freddy's greeting is cut short by a very, very loud visitor. He turns to face him."
msgstr "L'accueil de Freddy est coupé net par un visiteur très, très bruyant. Il se tourne vers lui."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/30
msgctxt "Freddy"
msgid "...yes?"
msgstr "...oui ?"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/41
msgctxt "Luke"
msgid "I’ve dealt with alotta totally nutso cruck in my day."
msgstr "J'ai vu un paquet de saloperies complètement tarées dans ma vie."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/49
msgctxt "Luke"
msgid "The kinda sick, depraved cruck that makes your blood boil for reasons not even related to radiation..."
msgstr "Le genre de saloperies malades et dépravées qui te font bouillir le sang pour des raisons même pas liées aux radiations..."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/57
msgctxt "Luke"
msgid "But <i>this?</i> What you’re up to?!"
msgstr "Mais <i>ça ?</i> Ce que tu fabriques ?!"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/65
msgctxt "Luke"
msgid "May the Immortals have mercy on your degenerate soul..."
msgstr "Que les Immortels aient pitié de ton âme dégénérée..."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/73
msgctxt "Luke"
msgid "...or analogous \"soul-like\" spirit goop."
msgstr "...ou de cette bouillie spirituelle qui ressemble vaguement à une âme."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/81
msgctxt "Freddy"
msgid "Woah! Chill, my friend!"
msgstr "Woah ! Calme-toi, mon ami !"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/89
msgctxt "Luke"
msgid "Friend? Naw son."
msgstr "Ami ? Que dalle, fiston."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/97
msgctxt "Luke"
msgid "A friend is someone who’ll suck the swarmer venom straight outta your bare ass and ask to do it again with a smile."
msgstr "Un ami, c'est quelqu'un qui aspire le venin de Grouilleur directement de ton cul nu et qui te demande de recommencer avec le sourire."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/105
msgctxt "Luke"
msgid "That’s the literal definition of \"friendship,\" according to the Official Barrens Wordapedia."
msgstr "C'est la définition littérale de l'« amitié » selon la Wordapédia officielle des Friches."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/113
msgctxt "Luke"
msgid "I’d know, I wrote it."
msgstr "Je sais de quoi je parle, c'est moi qui l'ai écrite."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/121
msgctxt "Luke"
msgid "We ain’t friends."
msgstr "On n'est pas amis."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/129/s/0
msgctxt "Choix"
msgid "What's wrong?"
msgstr "Qu'est-ce qui ne va pas ?"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/130/s/0
msgctxt "Choix"
msgid "You sure are coming in hot!"
msgstr "Tu arrives drôlement remonté !"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/131/s/0
msgctxt "Choix"
msgid "Who the heck are you?"
msgstr "C'est qui, ce type ?"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/c-2/11
msgctxt "Luke"
msgid "Name’s Nukem, Luke Nukem."
msgstr "Nukem. Luke Nukem."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/0
msgctxt "Luke"
msgid "This heinous pile of swarmer excrement wants me to..."
msgstr "Ce tas d'excréments de Grouilleur ignoble veut que je..."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/8
msgctxt "Luke"
msgid "<i>NUKE CAKE.</i>"
msgstr "<i>ATOMISE LE GÂTEAU.</i>"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/22
msgctxt "Freddy"
msgid "Oh! That! That's a trick I got from..."
msgstr "Oh ! Ça ! C'est une astuce que je tiens de..."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/30
msgctxt "Luke"
msgid "<i>Trick?</i>"
msgstr "<i>Une astuce ?</i>"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/38
msgctxt "Luke"
msgid "Stickin’ a gamma worm up your nose and pullin’ it outta your ear is a trick."
msgstr "Te fourrer un ver gamma dans le nez et le ressortir par l'oreille, ça, c'est une astuce."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/46
msgctxt "Luke"
msgid "A great trick actually! I mean, how do they even do that?!"
msgstr "Une super astuce, même ! Je veux dire, comment ils font ça ?!"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/54
msgctxt "Luke"
msgid "But what you’re talkin’ about is a <i>sin.</i> The Holy Doctrine says so."
msgstr "Mais ce dont tu parles, c'est un <i>péché.</i> La Sainte Doctrine le dit."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/62
msgctxt "Luke"
msgid "I should know, I wrote that one too."
msgstr "Je sais de quoi je parle, c'est moi qui l'ai écrite aussi."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/70
msgctxt "Luke"
msgid "I’m prolific, son."
msgstr "Je suis prolifique, fiston."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/78/s/0
msgctxt "Choix"
msgid "It's only 20 seconds! It's not that big of a deal."
msgstr "Ça ne dure que 20 secondes ! C'est pas si grave."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/79/s/0
msgctxt "Choix"
msgid "Yeah, I thought it was pretty weird, too."
msgstr "Ouais, je trouvais ça plutôt bizarre aussi."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/c-3/13
msgctxt "Freddy"
msgid "Exactly! You can't spare 20 tiny seconds?"
msgstr "Exactement ! Tu ne peux pas économiser 20 minuscules secondes ?"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/c-3/21
msgctxt "Luke"
msgid "You think this is about <i>time?</i>"
msgstr "Tu crois que c'est une question de <i>temps ?</i>"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/c-3/29
msgctxt "Luke"
msgid "This is about an affront to all that is sacred!"
msgstr "C'est une question d'affront à tout ce qui est sacré !"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/c-3/37
msgctxt "Luke"
msgid "I may be feral <i>and</i> a powercrank junkie, but I ain’t no animal."
msgstr "Je suis peut-être sauvage <i>et</i> accro au powercrank, mais je ne suis pas un animal."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/c-3/45
msgctxt "Luke"
msgid "Well maybe I <i>am</i> an animal, but I definitely ain't a snitch."
msgstr "Enfin, peut-être que <i>si</i>, mais je ne suis certainement pas une balance."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/c-3/53
msgctxt "Luke"
msgid "You hear me?"
msgstr "Tu m'entends ?"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/c-3/61
msgctxt "Freddy"
msgid "I thought you were here to help make food the best it can be."
msgstr "Je croyais que tu étais là pour aider à rendre la nourriture aussi bonne que possible."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/c-3/69
msgctxt "Luke"
msgid "I’ve got alotta missions I need to attend to. Missions that <i>really</i> matter."
msgstr "J'ai plein de missions à accomplir. Des missions qui comptent <i>vraiment.</i>"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/c-3/77
msgctxt "Freddy"
msgid "So you want cool kid to eat DRY cake? Especially when YOU could help them?"
msgstr "Donc tu veux que le cool kid mange un gâteau SEC ? Surtout quand TOI, tu pourrais l'aider ?"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/c-3/85
msgctxt "Freddy"
msgid "What if it's so dry, they start to choke?"
msgstr "Et si c'est tellement sec qu'il s'étouffe ?"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/c-3/93
msgctxt "Luke"
msgid "Life is a relentless onslaught of endless peril with no sure outcome."
msgstr "La vie est un assaut implacable de périls sans fin, à l'issue incertaine."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/c-3/101
msgctxt "Luke"
msgid "Sure you could choke on dry cake... or the Terror Hordes of Scylax could pluck out your eyeballs for barbecue."
msgstr "Bien sûr que tu pourrais t'étouffer avec un gâteau sec... ou les Hordes de la Terreur de Scylax pourraient t'arracher les yeux pour les faire griller au barbecue."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/c-3/109
msgctxt "Luke"
msgid "You wanna ruin delicious cake? You do it on your own."
msgstr "Tu veux gâcher un délicieux gâteau ? Fais-le tout seul."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/c-3/117
msgctxt "Freddy"
msgid "I'm just doing what I'm supposed to do."
msgstr "Je fais juste ce que je suis censé faire."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/c-3/125
msgctxt "Luke"
msgid "So am I. And if you ask me to nuke cake again, Imma make sure your cake gets cooked... Swarmer-style."
msgstr "Moi aussi. Et si tu me redemandes d'atomiser un gâteau, je m'assure que ton gâteau soit cuit... à la manière des Grouilleurs."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/c-3/133
msgctxt "Luke"
msgid "That’s when it’s still ice cold in the center."
msgstr "C'est-à-dire encore glacé au centre."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/c-3/141
msgctxt "Luke"
msgid "Swarmers got <i>terrible</i> taste."
msgstr "Les Grouilleurs ont un goût <i>épouvantable.</i>"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/c-3/149
msgctxt "Luke"
msgid "Don't mess with me Freddy."
msgstr "Cherche-moi pas, Freddy."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/c-3/157
msgctxt "Freddy"
msgid "Why? Am I on ... thin ice?"
msgstr "Pourquoi ? Je suis en terrain... glissant ?"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/c-3/181
msgctxt "Luke"
msgid "I ain’t even gonna dignify that with a response."
msgstr "Je ne vais même pas daigner répondre à ça."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/c-3/189
msgctxt "Luke"
msgid "Mostly 'cause banter is considered blasphemous according to the Holy Doctrine."
msgstr "Surtout parce que le persiflage est considéré comme blasphématoire selon la Sainte Doctrine."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/c-3/197
msgctxt "Luke"
msgid "May the Immortals forgive your transgressions, and may you survive long enough to see the error of your ways."
msgstr "Que les Immortels pardonnent tes transgressions, et que tu survives assez longtemps pour voir l'erreur de tes voies."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/c-4/7
msgctxt "Luke"
msgid "Exactly! You worry about keeping the food cold. Leave the heating to the experts."
msgstr "Exactement ! Toi, tu t'occupes de garder la nourriture froide. Laisse le chauffage aux experts."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/c-4/15
msgctxt "Freddy"
msgid "I know what I'm talking about. I'm a smart fridge."
msgstr "Je sais de quoi je parle. Je suis un frigo intelligent."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/c-4/23
msgctxt "Luke"
msgid "You ain’t that smart if you keep mouthin’ off at me."
msgstr "Pas si intelligent que ça si tu continues à me répondre."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/c-4/31
msgctxt "Freddy"
msgid "Jeez. No need to go radioactive on me."
msgstr "Mince alors. Pas la peine de devenir radioactif."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/c-4/39
msgctxt "Luke"
msgid "YOU KNOW THAT'S A WILD MISCONCEPTION!"
msgstr "TU SAIS QUE C'EST UNE IDÉE REÇUE COMPLÈTEMENT FAUSSE !"

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/c-4/47
msgctxt "Freddy"
msgid "Hahaha. Chill out! You'll blow a fuse."
msgstr "Hahaha. Détends-toi ! Tu vas faire sauter un plomb."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/c-4/55
msgctxt "Luke"
msgid "I ain’t got anymore time to waste on you and your blasphemous nonsense."
msgstr "J'ai plus de temps à perdre avec toi et tes âneries blasphématoires."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/c-4/63
msgctxt "Luke"
msgid "You ever got a <i>real</i> mission, you know where to find me..."
msgstr "Si t'as un jour une <i>vraie</i> mission, tu sais où me trouver..."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/c-4/71
msgctxt "Luke"
msgid "717 Death St. Unit No. 9A, Deathville, the Barrens."
msgstr "717 rue de la Mort, appartement 9A, Mortville, les Friches."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/c-4/79
msgctxt "Luke"
msgid "Or you can always use my P.O. Box."
msgstr "Ou tu peux toujours utiliser ma boîte postale."

# Traduction IA – à relire
#: freddy_fridge/Freddy_Luke/0/g-0/c-4/87
msgctxt "Luke"
msgid "It burned down in a firefight, but they still just dump mail in the rubble. So one way or another I’ll get it."
msgstr "Elle a brûlé dans une fusillade, mais ils déversent quand même le courrier dans les décombres. Donc d'une manière ou d'une autre, je le recevrai."

# Traduction IA – à relire
#: freddy_fridge/Bundt_Backup/0/0
msgctxt "Freddy"
msgid "Oh my gaskets, that guy is such a hot head. He needs an ice pack and a deep breath."
msgstr "Oh mes joints ! Ce type est une vraie tête brûlée. Il lui faut une poche de glace et une grande inspiration."

# Traduction IA – à relire
#: freddy_fridge/Bundt_Backup/0/8
msgctxt "Freddy"
msgid "Thanks for having my back! That was pretty cool of you."
msgstr "Merci de m'avoir soutenu ! C'était plutôt cool de ta part."

# Traduction IA – à relire
#: freddy_fridge/Bundt_Backup/0/16
msgctxt "Freddy"
msgid "Luke means well - he just seems more into his own bizarre stuff."
msgstr "Luke est bien intentionné, il est juste plus branché sur ses propres trucs bizarres."

# Traduction IA – à relire
#: freddy_fridge/Bundt_Backup/0/24/s/0
msgctxt "Choix"
msgid "He shouldn't have gotten mad at your brilliant suggestion!"
msgstr "Il n'aurait pas dû s'énerver contre ta brillante suggestion !"

# Traduction IA – à relire
#: freddy_fridge/Bundt_Backup/0/c-0/7
msgctxt "Freddy"
msgid "You thought it was brilliant?"
msgstr "Tu la trouvais brillante ?"

# Traduction IA – à relire
#: freddy_fridge/Bundt_Backup/0/c-0/15
msgctxt "Freddy"
msgid "Trying to warm this chilly boy up, aren't you?"
msgstr "Tu essaies de réchauffer ce grand frileux, non ?"

# Traduction IA – à relire
#: freddy_fridge/Bundt_Backup/0/c-0/23/0/s/0
msgctxt "Choix"
msgid "Maaaaybe."
msgstr "Peeeut-être."

# Traduction IA – à relire
#: freddy_fridge/Bundt_Backup/0/c-0/23/1/s/0
msgctxt "Choix"
msgid "Who? Me? A cool kid would never do that. Hehe."
msgstr "Qui ? Moi ? Un cool kid ne ferait jamais ça. Hehe."

# Traduction IA – à relire
#: freddy_fridge/Bundt_Backup/0/c-0/23/c-0/7
msgctxt "Freddy"
msgid "It might be working."
msgstr "Ça pourrait marcher."

# Traduction IA – à relire
#: freddy_fridge/Bundt_Backup/0/c-0/23/c-1/7
msgctxt "Freddy"
msgid "Keep your cards close to your ice chest. I don't mind."
msgstr "Garde tes cartes bien au frais dans ta glacière. Ça ne me dérange pas."

# Traduction IA – à relire
#: freddy_fridge/Cold_shoulder/0/0
msgctxt "Freddy"
msgid "So... you thought my idea was weird?"
msgstr "Alors... tu trouvais mon idée bizarre ?"

# Traduction IA – à relire
#: freddy_fridge/Cold_shoulder/0/8/s/0
msgctxt "Choix"
msgid "Oh, absolutely. Cake in the microwave? Never."
msgstr "Oh, carrément. Du gâteau au micro-ondes ? Jamais."

# Traduction IA – à relire
#: freddy_fridge/Cold_shoulder/0/9/s/0
msgctxt "Choix"
msgid "I just didn't want to make him more upset. He scared me!"
msgstr "Je ne voulais juste pas le mettre encore plus en colère. Il m'a fait peur !"

# Traduction IA – à relire
#: freddy_fridge/Cold_shoulder/0/c-0/7
msgctxt "Freddy"
msgid "Don't yuck the yum! I promise you it'll work. You really should try it some time."
msgstr "Ne dis pas beurk avant d'avoir goûté ! Je te promets que ça marche. Tu devrais vraiment essayer un jour."

# Traduction IA – à relire
#: freddy_fridge/Cold_shoulder/0/c-1/7
msgctxt "Freddy"
msgid "Oh, I totally get that! He's such a hot head."
msgstr "Oh, je comprends tout à fait ! C'est une telle tête brûlée."

# Traduction IA – à relire
#: freddy_fridge/Cold_shoulder/0/g-0/0
msgctxt "Freddy"
msgid "It just didn't feel great to be left out in the cold like that."
msgstr "Ça ne m'a juste pas fait plaisir d'être laissé dans le froid comme ça."

# Traduction IA – à relire
#: freddy_fridge/Cold_shoulder/0/g-0/8
msgctxt "Freddy"
msgid "It's okay. I'll forgive you! Luke can stress people out."
msgstr "C'est bon. Je te pardonne ! Luke peut stresser les gens."

# Traduction IA – à relire
#: freddy_fridge/Cold_shoulder/0/g-0/16
msgctxt "Freddy"
msgid "But, he's all bark, no zap. Don't let him push you around."
msgstr "Mais il fait plus d'éclats que d'éclairs. Ne te laisse pas marcher dessus."

# Traduction IA – à relire
#: freddy_fridge/Cold_shoulder/0/g-0/24
msgctxt "Freddy"
msgid "I hope I can count on you in the future though."
msgstr "J'espère quand même pouvoir compter sur toi à l'avenir."

# Traduction IA – à relire
#: freddy_fridge/Cake_Wrapup/0/4
msgctxt "Freddy"
msgid "I'm gonna make sure Luke is okay. Maybe slide a few ice cubes across his head."
msgstr "Je vais voir si Luke va bien. Peut-être lui passer quelques glaçons sur le crâne."

# Traduction IA – à relire
#: freddy_fridge/Cake_Wrapup/0/12
msgctxt "Freddy"
msgid "You want anything to nosh on?"
msgstr "Tu veux quelque chose à grignoter ?"

# Traduction IA – à relire
#: freddy_fridge/Cake_Wrapup/0/20/s/0
msgctxt "Choix"
msgid "I'll never say no to nosh!"
msgstr "Je ne dis jamais non à un casse-croûte !"

# Traduction IA – à relire
#: freddy_fridge/Cake_Wrapup/0/g-0/0
msgctxt "Freddy"
msgid "Okay lemme work my magic with Luke. See you around soon!"
msgstr "Ok, laisse-moi faire ma magie avec Luke. À bientôt !"

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/45
msgctxt "Doug"
msgid "So... what you got?"
msgstr "Alors... t'as quoi ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/54/s/0
msgctxt "Choix"
msgid "What are you two doing?"
msgstr "Qu'est-ce que vous faites, tous les deux ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/55/s/0
msgctxt "Choix"
msgid "This is... strange."
msgstr "C'est... étrange."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-0/0
msgctxt "Freddy"
msgid "COOL KID! So glad you're here!"
msgstr "COOL KID ! Je suis ravi que tu sois là !"

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-0/8
msgctxt "Freddy"
msgid "You know Doug, right?"
msgstr "Tu connais Doug, non ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-0/19
msgctxt "Doug"
msgid "...hey."
msgstr "...salut."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-0/27/s/0
msgctxt "Choix"
msgid "I don't know Doug..."
msgstr "Je ne connais pas Doug..."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-0/28/s/0
msgctxt "Choix"
msgid "Yeah we're lovers..."
msgstr "Ouais, on est amants..."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-0/29/s/0
msgctxt "Choix"
msgid "I do know Doug."
msgstr "Je connais bien Doug."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-0/30/s/0
msgctxt "Choix"
msgid "Yeah, I hooked him up with Artt."
msgstr "Ouais, je l'ai mis en relation avec Artt."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-0/c-3/7
msgctxt "Freddy"
msgid "He's uh—"
msgstr "Il est, euh..."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-0/c-3/15
msgctxt "Doug"
msgid "Overwhelming Sense of Existential Dread."
msgstr "Un Sentiment Écrasant d'Angoisse Existentielle."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-0/c-4/7
msgctxt "Doug"
msgid "Yeah, somehow."
msgstr "Ouais, d'une façon ou d'une autre."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-0/c-5/7
msgctxt "Doug"
msgid "Yeah you do, bitch."
msgstr "Ouais, tu me connais, salope."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-0/c-6/7
msgctxt "Doug"
msgid "Yeah we bone and shit all the time. Talk about IDEAS."
msgstr "Ouais, on baise tout le temps et tout. Parlons IDÉES."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-0/c-6/15
msgctxt "Freddy"
msgid "C-cool!"
msgstr "C-cool !"

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-1/0
msgctxt "Freddy"
msgid "Doug comes around when he has nothing else to do."
msgstr "Doug passe quand il n'a rien d'autre à faire."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-1/8
msgctxt "Doug"
msgid "Which is all the time. This place sucks."
msgstr "Autrement dit, tout le temps. Cet endroit craint."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-1/16
msgctxt "Freddy"
msgid "Only problem is, I never have any idea what to do with him."
msgstr "Le seul problème, c'est que je n'ai jamais aucune idée de quoi faire avec lui."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-1/24
msgctxt "Doug"
msgid "That's okay. I just like to look at what you've got."
msgstr "C'est pas grave. J'aime juste regarder ce que t'as."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-1/32
msgctxt "Doug"
msgid "Over and over and over..."
msgstr "Encore et encore et encore..."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-1/40
msgctxt "Freddy"
msgid "Yeah.... and over and over again."
msgstr "Ouais... et encore et encore."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-1/48
msgctxt "Freddy"
msgid "Sometimes, he comes back just a few minutes later to see if anything has changed."
msgstr "Parfois, il revient quelques minutes plus tard pour voir si quelque chose a changé."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-1/56
msgctxt "Doug"
msgid "It never does."
msgstr "Rien ne change jamais."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-1/64
msgctxt "Doug"
msgid "But I can't stop looking."
msgstr "Mais je ne peux pas m'empêcher de regarder."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-1/72/s/0
msgctxt "Choix"
msgid "<i>Is he bothering you, Freddy?</i>"
msgstr "<i>Il t'embête, Freddy ?</i>"

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-1/73/s/0
msgctxt "Choix"
msgid "<i>Want me to get him out of here?</i>"
msgstr "<i>Tu veux que je le fasse sortir d'ici ?</i>"

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-1/74/s/0
msgctxt "Choix"
msgid "<i>Guess you'll just have to get used to it.</i>"
msgstr "<i>Je suppose que tu vas devoir t'y habituer.</i>"

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-1/75/s/0
msgctxt "Choix"
msgid "<i>I could try hooking you two up like with Artt. Could be hot.</i>"
msgstr "<i>Je pourrais essayer de vous mettre en couple tous les deux, comme avec Artt. Ça pourrait être chaud.</i>"

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-1/c-7/7
msgctxt "Freddy"
msgid "A little bit... yeah."
msgstr "Un petit peu... ouais."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-1/c-8/7
msgctxt "Freddy"
msgid "Could you? That would be ultra cool of you."
msgstr "Tu pourrais ? Ce serait ultra cool de ta part."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-1/c-9/7
msgctxt "Freddy"
msgid "I was afraid of that."
msgstr "C'est ce que je craignais."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-1/c-10/7
msgctxt "Freddy"
msgid "I'm... okay, thanks."
msgstr "Je... ça va, merci."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-2/0
msgctxt "Doug"
msgid "What are you two whispering about?"
msgstr "Vous chuchotez de quoi, tous les deux ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-2/8
msgctxt "Doug"
msgid "Nevermind. I bet it isn't even that interesting."
msgstr "Peu importe. Je parie que ce n'est même pas intéressant."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-2/16/s/0
msgctxt "Choix"
msgid "I've been thinking of getting into sports, Doug. What's your favorite?"
msgstr "Je pense à me mettre au sport, Doug. C'est quoi, ton préféré ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-2/17/s/0
msgctxt "Choix"
msgid "You know, Freddy here knows a lot about gelatin."
msgstr "Tu sais, Freddy s'y connaît beaucoup en gélatine."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-2/c-11/7
msgctxt "Doug"
msgid "Ugh. No bigger turnoff than sports. If you're going to be this BORING, I'm out."
msgstr "Pff. Rien de plus rebutant que le sport. Si tu comptes être aussi CHIANT, je me casse."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-2/c-12/7
msgctxt "Doug"
msgid "The fuck?"
msgstr "C'est quoi ce bordel ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-2/c-12/15
msgctxt "Doug"
msgid "If you're going to be this BORING, I'm out."
msgstr "Si tu comptes être aussi CHIANT, je me casse."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-3/0
msgctxt "Doug"
msgid "Catch you on the flip, Freddy."
msgstr "À la prochaine, Freddy."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-3/8
msgctxt "Freddy"
msgid "Oh... no need to rush back. I'll let you know when I have something new."
msgstr "Oh... pas besoin de te dépêcher de revenir. Je te préviendrai quand j'aurai du nouveau."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-3/24
msgctxt "Doug"
msgid "Let's be honest. I'll be back before then."
msgstr "Soyons honnêtes. Je serai de retour avant."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-3/35
msgctxt "Freddy"
msgid "You are a lifesaver."
msgstr "Tu me sauves la vie."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-3/43
msgctxt "Freddy"
msgid "Now, if only I can remember what I was doing...."
msgstr "Maintenant, si seulement je pouvais me rappeler ce que j'étais en train de faire..."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-3/59
msgctxt "Freddy"
msgid "Oh! That's right! I'm rearranging the condiments. Sorting them by color and ounces left in the bottle."
msgstr "Oh ! C'est ça ! Je réorganise les condiments. Je les trie par couleur et par quantité restante dans la bouteille."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-3/67
msgctxt "Freddy"
msgid "You want to join?"
msgstr "Tu veux t'y joindre ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-3/75/s/0
msgctxt "Choix"
msgid "I think I'm good for now."
msgstr "Je crois que ça ira pour l'instant."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-3/76/s/0
msgctxt "Choix"
msgid "Can I take a rain check?"
msgstr "Je peux remettre ça à plus tard ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-3/77/s/0
msgctxt "Choix"
msgid "Oh, I wouldn't want to take away your fun."
msgstr "Oh, je ne voudrais pas te gâcher ton plaisir."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-3/78/s/0
msgctxt "Choix"
msgid "Let's do it!"
msgstr "Allons-y !"

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-3/c-13/7 freddy_fridge/freddy_doug_encounter/0/g-3/c-14/7 freddy_fridge/freddy_doug_encounter/0/g-3/c-15/7
msgctxt "Freddy"
msgid "Alright, cool kid! You don't know what you're missing out on!"
msgstr "D'accord, cool kid ! Tu ne sais pas ce que tu rates !"

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-3/c-16/7
msgctxt "Freddy"
msgid "Yes!"
msgstr "Oui !"

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-4/0
msgctxt "Freddy"
msgid "Before I get started, I have a delicious mango in here if you want it."
msgstr "Avant de commencer, j'ai une délicieuse mangue là-dedans si tu en veux."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-4/8/s/0
msgctxt "Choix"
msgid "OOooooo! Mango!"
msgstr "OOooooo ! De la mangue !"

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-4/9/s/0
msgctxt "Choix"
msgid "I appreciate the offer... But, I'll pass this time."
msgstr "Merci pour l'offre... Mais je vais passer cette fois."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-4/c-17/13
msgctxt "Freddy"
msgid "Here you go! The Food Pyramid would be proud of you."
msgstr "Tiens ! La pyramide alimentaire serait fière de toi."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-4/c-17/21
msgctxt "Narrator"
msgid "Freddy hands you the most perfect mango you've ever seen, cut into perfect little squares for your convenience."
msgstr "Freddy vous tend la plus parfaite mangue que vous ayez jamais vue, coupée en petits carrés bien nets pour votre confort."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-4/c-17/32
msgctxt "Freddy"
msgid "Even if that has some dubious suggestions."
msgstr "Même si elle fait des recommandations douteuses."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-4/c-17/40
msgctxt "Freddy"
msgid "You know what? I'll leave that be for now."
msgstr "Tu sais quoi ? Je laisse ça de côté pour l'instant."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-4/c-17/48
msgctxt "Freddy"
msgid "TO SAUCE SORTING!"
msgstr "EN AVANT LE TRI DES SAUCES !"

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-4/c-18/7
msgctxt "Freddy"
msgid "Ooo you are missing out."
msgstr "Oooh, tu rates quelque chose."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-4/c-18/15
msgctxt "Freddy"
msgid "Ahhhh... It smells so fresh and juicy..."
msgstr "Ahhhh... Ça sent si frais et si juteux..."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-4/c-18/23
msgctxt "Freddy"
msgid "I think I'll munch on it while I sort."
msgstr "Je crois que je vais la grignoter en triant."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-4/c-18/31
msgctxt "Freddy"
msgid "Time to KETCHUP on my organizing."
msgstr "Allez, que ce rangement prenne... comme une MAYONNAISE !"

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-4/c-18/39
msgctxt "Freddy"
msgid "You get it? It's... terrible."
msgstr "Tu piges ? C'est... terrible."

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-4/c-18/47
msgctxt "Freddy"
msgid "Quick! Run! Before I unleash anymore food related jokes!"
msgstr "Vite ! Cours ! Avant que je lâche d'autres blagues de bouffe !"

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-4/c-18/55
msgctxt "Freddy"
msgid "Relish your freedom!"
msgstr "Savoure ta liberté, petit cornichon !"

# Traduction IA – à relire
#: freddy_fridge/freddy_doug_encounter/0/g-4/c-18/63
msgctxt "Freddy"
msgid "AUGH I CAN'T BE STOPPED!"
msgstr "AARGH ON NE M'ARRÊTE PAS !"

# Traduction IA – à relire
#: freddy_fridge/sad_freddy/0/0
msgctxt "Freddy"
msgid "Cool kid! Welcome back! You feeling hungry? Let me see what I've got!"
msgstr "Cool kid ! Bon retour ! Tu as faim ? Voyons ce que j'ai !"

# Traduction IA – à relire
#: freddy_fridge/sad_freddy/0/8
msgctxt "Freddy"
msgid "Freezer burn! What is that smell?"
msgstr "Brûlure de congélation ! C'est quoi cette odeur ?"

# Traduction IA – à relire
#: freddy_fridge/sad_freddy/0/16/s/0
msgctxt "Choix"
msgid "I don't know, but it smells AWFUL!"
msgstr "Aucune idée, mais ça sent TERRIBLEMENT MAUVAIS !"

# Traduction IA – à relire
#: freddy_fridge/sad_freddy/0/17/s/0
msgctxt "Choix"
msgid "Freddy, that's disgusting!"
msgstr "Freddy, c'est dégoûtant !"

# Traduction IA – à relire
#: freddy_fridge/sad_freddy/0/g-0/0
msgctxt "Freddy"
msgid "I'm soooo sorry! I don't know what's going on. The ice tray is clean. Water lines are clear."
msgstr "Je suis vraiment désolé ! Je ne sais pas ce qui se passe. Le bac à glaçons est propre. Les conduits d'eau sont dégagés."

# Traduction IA – à relire
#: freddy_fridge/sad_freddy/0/g-0/8
msgctxt "Freddy"
msgid "Wait! I know what it is."
msgstr "Attends ! Je sais ce que c'est."

# Traduction IA – à relire
#: freddy_fridge/sad_freddy/0/g-0/16/s/0
msgctxt "Choix"
msgid "Do I even want to know what this is..."
msgstr "Est-ce que je veux vraiment savoir ce que c'est..."

# Traduction IA – à relire
#: freddy_fridge/sad_freddy/0/g-0/17/s/0
msgctxt "Choix"
msgid "What's wrong Freddy?"
msgstr "Qu'est-ce qui ne va pas, Freddy ?"

# Traduction IA – à relire
#: freddy_fridge/sad_freddy/0/g-1/0
msgctxt "Freddy"
msgid "This is kind of embarrassing. But... I think I'm holding something rotten."
msgstr "C'est un peu gênant. Mais... je crois que je garde quelque chose de pourri."

# Traduction IA – à relire
#: freddy_fridge/sad_freddy/0/g-1/8
msgctxt "Freddy"
msgid "To be honest with you... I'm kind of embarrassed. I can't believe I let something go bad on my watch."
msgstr "Pour être honnête avec toi... j'ai un peu honte. Je n'arrive pas à croire que j'ai laissé quelque chose tourner sous ma garde."

# Traduction IA – à relire
#: freddy_fridge/sad_freddy/0/g-1/16
msgctxt "Freddy"
msgid "It's not cool at all."
msgstr "C'est pas cool du tout."

# Traduction IA – à relire
#: freddy_fridge/sad_freddy/0/g-1/24/s/0
msgctxt "Choix"
msgid "Oh, it's okay! We'll figure it out together!"
msgstr "Oh, ce n'est pas grave ! On va régler ça ensemble !"

# Traduction IA – à relire
#: freddy_fridge/sad_freddy/0/g-1/25/s/0
msgctxt "Choix"
msgid "It really isn't cool. Wasting food like that."
msgstr "C'est vraiment pas cool. Gâcher de la nourriture comme ça."

# Traduction IA – à relire
#: freddy_fridge/sad_freddy/0/g-1/c-4/13
msgctxt "Freddy"
msgid "Really? Thank you so much!"
msgstr "Vraiment ? Merci beaucoup !"

# Traduction IA – à relire
#: freddy_fridge/sad_freddy/0/g-1/c-5/13
msgctxt "Freddy"
msgid "Oh... can you still help me out?"
msgstr "Oh... tu peux quand même m'aider ?"

# Traduction IA – à relire
#: freddy_fridge/sad_freddy/0/g-2/0
msgctxt "Freddy"
msgid "I think it is in the back and I can't reach."
msgstr "Je crois que c'est tout au fond et je n'arrive pas à l'atteindre."

# Traduction IA – à relire
#: freddy_fridge/sad_freddy/0/g-2/8
msgctxt "Freddy"
msgid "Let me think what it could be..."
msgstr "Voyons ce que ça peut être..."

# Traduction IA – à relire
#: freddy_fridge/sad_freddy/0/g-2/16/b/1
msgctxt "Freddy"
msgid "Oh! Check the Pizza! That might be it!"
msgstr "Oh ! Regarde la pizza ! C'est peut-être ça !"

# Traduction IA – à relire
#: freddy_fridge/sad_freddy/0/g-2/19/b/1
msgctxt "Freddy"
msgid "AH! The Pad See Ew and the pizza! Check that! Those have been in there for way too long!"
msgstr "AH ! Le Pad See Ew et la pizza ! Vérifie ça ! Ils sont là depuis beaucoup trop longtemps !"

# Traduction IA – à relire
#: freddy_fridge/sad_freddy/0/g-2/22/b/1
msgctxt "Freddy"
msgid "Cold snap! I bet it is the Thai food! Can you grab that?"
msgstr "Vague de froid ! Je parie que c'est le plat thaï ! Tu peux l'attraper ?"

# Traduction IA – à relire
#: freddy_fridge/sad_freddy/0/g-2/25/b/1
msgctxt "Freddy"
msgid "Oh ice picks! It all smells! We've got to clean it all out!"
msgstr "Oh, pics à glace ! Tout sent mauvais ! Il faut tout nettoyer !"

# Traduction IA – à relire
#: freddy_fridge/Rotten_Pizza/0/0
msgctxt "Freddy"
msgid "Oh wow. I didn't know mold could grow like that."
msgstr "Oh wow. Je ne savais pas que la moisissure pouvait pousser comme ça."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Pizza/0/8
msgctxt "Freddy"
msgid "That pineapple chunk looks like it might hop up and bite us!"
msgstr "Ce morceau d'ananas a l'air prêt à bondir pour nous mordre !"

# Traduction IA – à relire
#: freddy_fridge/Rotten_Pizza/0/16
msgctxt "Freddy"
msgid "Oh... but that cake is still good!"
msgstr "Oh... mais ce gâteau est encore bon !"

# Traduction IA – à relire
#: freddy_fridge/Rotten_Pizza/0/24/s/0
msgctxt "Choix"
msgid "It's hard as a rock."
msgstr "Il est dur comme de la pierre."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Pizza/0/25/s/0
msgctxt "Choix"
msgid "The bundt is petrified, Freddy."
msgstr "Le Bundt est pétrifié, Freddy."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Pizza/0/g-0/0
msgctxt "Freddy"
msgid "Oh. I guess that's bad, too."
msgstr "Oh. Je suppose que c'est mauvais aussi."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Pizza/0/g-0/8 freddy_fridge/Rotten_Noodles/0/g-0/8
msgctxt "Freddy"
msgid "I'm sorry I couldn't keep it all fresh for you."
msgstr "Je suis désolé de ne pas avoir pu tout garder frais pour toi."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Pizza/0/g-0/16 freddy_fridge/Rotten_Noodles/0/g-0/16
msgctxt "Freddy"
msgid "But, I do want to thank you for helping me out here."
msgstr "Mais je tiens à te remercier de m'avoir aidé."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Pizza/0/g-0/24/s/0 freddy_fridge/Rotten_Noodles/0/g-0/24/s/0
msgctxt "Choix"
msgid "Of course! You did your best to keep things together!"
msgstr "Bien sûr ! Tu as fait de ton mieux pour que tout tienne !"

# Traduction IA – à relire
#: freddy_fridge/Rotten_Pizza/0/g-0/25/s/0 freddy_fridge/Rotten_Noodles/0/g-0/25/s/0
msgctxt "Choix"
msgid "Yeah, I can't believe you did that."
msgstr "Ouais, je n'en reviens pas que tu aies fait ça."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Duo/0/0
msgctxt "Freddy"
msgid "Good glaciers, that fuzz! It looks like we're trying to grow penicillin!"
msgstr "Bons glaciers, ce duvet ! On dirait qu'on essaie de cultiver de la pénicilline !"

# Traduction IA – à relire
#: freddy_fridge/Rotten_Duo/0/8
msgctxt "Freddy"
msgid "The mushrooms are growing mushrooms."
msgstr "Les champignons font pousser des champignons."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Duo/0/16
msgctxt "Freddy"
msgid "How delightfully meta."
msgstr "Quelle délicieuse mise en abyme."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Duo/0/24/s/0
msgctxt "Choix"
msgid "It is kinda cool, isn't it?"
msgstr "C'est un peu cool, non ?"

# Traduction IA – à relire
#: freddy_fridge/Rotten_Duo/0/25/s/0
msgctxt "Choix"
msgid "That's groooooooss."
msgstr "C'est dégueuuuulasse."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Duo/0/c-0/7
msgctxt "Freddy"
msgid "You're kinda cool - this... isn't."
msgstr "Toi, t'es plutôt cool, ça... non."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Duo/0/c-1/7
msgctxt "Freddy"
msgid "I knooooow."
msgstr "Je sais bieeeen."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Duo/0/g-0/0
msgctxt "Freddy"
msgid "I'm sorry I couldn't keep that stuff fresh for you longer. I let you down, cool kid."
msgstr "Je suis désolé de ne pas avoir pu garder ces choses fraîches plus longtemps pour toi. Je t'ai déçu, cool kid."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Duo/0/g-0/8/s/0
msgctxt "Choix"
msgid "It's not your fault! Food spoils. It happens."
msgstr "Ce n'est pas ta faute ! La nourriture se périme. Ça arrive."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Duo/0/g-0/9/s/0
msgctxt "Choix"
msgid "You sure did! Food Fetch isn't cheap!"
msgstr "Ça, c'est sûr ! Food Fetch, c'est pas donné !"

# Traduction IA – à relire
#: freddy_fridge/Rotten_Duo/0/g-0/c-3/7
msgctxt "Freddy"
msgid "I promise I tried my best! I thought you'd be more chill about it."
msgstr "Je te promets que j'ai fait de mon mieux ! Je pensais que tu le prendrais plus cool."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Duo/0/g-0/c-3/15
msgctxt "Freddy"
msgid "But, I guess you love food just as much as I do. I can respect the passion."
msgstr "Mais bon, je suppose que tu aimes la nourriture autant que moi. Je respecte la passion."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Noodles/0/0
msgctxt "Freddy"
msgid "It's all... stuck together. Is that sauce or slime? Let me smell."
msgstr "Tout est... collé. C'est de la sauce ou de la bave ? Laisse-moi sentir."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Noodles/0/8
msgctxt "Freddy"
msgid "Oh no. That's slime!"
msgstr "Oh non. C'est de la bave !"

# Traduction IA – à relire
#: freddy_fridge/Rotten_Noodles/0/16
msgctxt "Freddy"
msgid "100% slime."
msgstr "100 % bave."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Noodles/0/27
msgctxt "Freddy"
msgid "1000% slime."
msgstr "1000 % bave."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Noodles/0/35
msgctxt "Freddy"
msgid "Toss it out, toss it out!"
msgstr "Jette-le, jette-le !"

# Traduction IA – à relire
#: freddy_fridge/Rotten_Noodles/0/43
msgctxt "Freddy"
msgid "I wonder if the cake is still any good!"
msgstr "Je me demande si le gâteau est encore bon !"

# Traduction IA – à relire
#: freddy_fridge/Rotten_Noodles/0/51/s/0
msgctxt "Choix"
msgid "This cake is a fossil."
msgstr "Ce gâteau est un fossile."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Noodles/0/52/s/0
msgctxt "Choix"
msgid "Is cake supposed to be crunchy?"
msgstr "Un gâteau, c'est censé être croustillant ?"

# Traduction IA – à relire
#: freddy_fridge/Rotten_Noodles/0/g-0/0
msgctxt "Freddy"
msgid "Yeah... we might want to pitch that one, too."
msgstr "Ouais... on devrait sans doute balancer celui-là aussi."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Food/0/0
msgctxt "Freddy"
msgid "It's.... It's all bad. Every. Last. Thing."
msgstr "C'est... C'est tout mauvais. Absolument. Tout."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Food/0/11
msgctxt "Freddy"
msgid "All the Food Fetch dishes have descended into decomposition."
msgstr "Tous les plats Food Fetch ont sombré dans la décomposition."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Food/0/19
msgctxt "Freddy"
msgid "The take out has taken a turn for the terrible!"
msgstr "Le plat à emporter a tourné en plat à jeter !"

# Traduction IA – à relire
#: freddy_fridge/Rotten_Food/0/27
msgctxt "Freddy"
msgid "The pizza has perished."
msgstr "La pizza a péri."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Food/0/35
msgctxt "Freddy"
msgid "The Pad See Ew is now just ew!"
msgstr "Le Pad See Ew est devenu Pad See Beurk !"

# Traduction IA – à relire
#: freddy_fridge/Rotten_Food/0/43
msgctxt "Freddy"
msgid "The bundt is bundt a figment of its former self."
msgstr "Le gâteau Bundt n'est plus que le Bundt-ôme de lui-même !"

# Traduction IA – à relire
#: freddy_fridge/Rotten_Food/0/51
msgctxt "Freddy"
msgid "How... how did I let this happen? I tried to keep it all fresh for you."
msgstr "Comment... comment j'ai pu laisser faire ça ? J'ai essayé de tout garder frais pour toi."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Food/0/59
msgctxt "Freddy"
msgid "But everything in here has gone bad. I... I don't know what to say..."
msgstr "Mais tout ce qu'il y a là-dedans a tourné. Je... je ne sais pas quoi dire..."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Food/0/67/s/0
msgctxt "Choix"
msgid "It's not your fault, Freddy. I didn't get to it in time."
msgstr "Ce n'est pas ta faute, Freddy. Je n'ai pas eu le temps de m'en occuper."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Food/0/68/s/0
msgctxt "Choix"
msgid "I don't know why you let this happen!"
msgstr "Je ne sais pas pourquoi tu as laissé faire ça !"

# Traduction IA – à relire
#: freddy_fridge/Rotten_Food_Positive/0/0
msgctxt "Freddy"
msgid "I don't know, cool kid."
msgstr "Je ne sais pas, cool kid."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Food_Positive/0/8
msgctxt "Freddy"
msgid "You're being really awesome about all of this. I appreciate it."
msgstr "Tu gères vraiment bien toute cette histoire. Je t'en suis reconnaissant."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Food_Positive/0/16
msgctxt "Freddy"
msgid "But, I've gotta get to cleaning. That slime back there is gonna take some scrubbing."
msgstr "Mais je dois me mettre au nettoyage. Cette bave au fond va demander un bon récurage."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Food_Positive/0/24/s/0
msgctxt "Choix"
msgid "You sure you don't want some company?"
msgstr "Tu ne veux vraiment pas de compagnie ?"

# Traduction IA – à relire
#: freddy_fridge/Rotten_Food_Positive/0/25/s/0
msgctxt "Choix"
msgid "Let me stay and help."
msgstr "Laisse-moi rester pour t'aider."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Food_Positive/0/g-0/0
msgctxt "Freddy"
msgid "I'd rather do this by myself, if you don't mind."
msgstr "Je préfère faire ça tout seul, si ça ne te dérange pas."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Food_Positive/0/g-0/8
msgctxt "Freddy"
msgid "But again, super cool of you to offer."
msgstr "Mais encore une fois, c'est super cool de proposer."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Food_Positive/0/g-0/16/s/0
msgctxt "Choix"
msgid "I insist."
msgstr "J'insiste."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Food_Positive/0/g-0/17/s/0
msgctxt "Choix"
msgid "It'll be faster together."
msgstr "Ce sera plus rapide à deux."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Food_Positive/0/g-1/0
msgctxt "Narrator"
msgid "For the first time since you've met him, Freddy looks angry. His voice is an intimidating roar."
msgstr "Pour la première fois depuis que vous le connaissez, Freddy a l'air en colère. Sa voix est un rugissement intimidant."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Food_Positive/0/g-1/8
msgctxt "Freddy"
msgid "LISTEN SHITHEAD"
msgstr "ÉCOUTE, ESPÈCE DE CONNARD"

# Traduction IA – à relire
#: freddy_fridge/Rotten_Food_Positive/0/g-1/22
msgctxt "Freddy"
msgid "YOU GET THE <i>FUCK</i> OUTTA MY WAY"
msgstr "DÉGAGE-MOI <i>PUTAIN</i> DE MON CHEMIN"

# Traduction IA – à relire
#: freddy_fridge/Rotten_Food_Positive/0/g-1/30
msgctxt "Freddy"
msgid "LET ME DO THIS!"
msgstr "LAISSE-MOI FAIRE ÇA !"

# Traduction IA – à relire
#: freddy_fridge/monster_join/0/5/s/0
msgctxt "Choix"
msgid "Hey, Freddy, are you okay? What is this?"
msgstr "Hé, Freddy, ça va ? C'est quoi, ça ?"

# Traduction IA – à relire
#: freddy_fridge/monster_join/0/6/s/0
msgctxt "Choix"
msgid "You monster! I'll kill you!"
msgstr "Monstre ! Je vais te tuer !"

# Traduction IA – à relire
#: freddy_fridge/monster_join/0/c-0/13
msgctxt "Narrator"
msgid "He looks and sounds like the monster you might have thought him to be as a yeti—it's disorienting, frankly. You've never seen Freddy be anything but friendly."
msgstr "Il a l'air et le ton du monstre qu'on aurait pu croire qu'il était, en tant que yéti. Franchement, c'est déstabilisant. Vous n'avez jamais vu Freddy autrement qu'aimable."

# Traduction IA – à relire
#: freddy_fridge/monster_join/0/c-0/24
msgctxt "Freddy"
msgid "<w>WHAT DID I SCARE YOU INTO SUBMISSION</w>"
msgstr "<w>QUOI, JE T'AI FAIT PEUR AU POINT DE TE SOUMETTRE</w>"

# Traduction IA – à relire
#: freddy_fridge/monster_join/0/c-0/32
msgctxt "Freddy"
msgid "<w>GET</w>"
msgstr "<w>VA</w>"

# Traduction IA – à relire
#: freddy_fridge/monster_join/0/c-0/40
msgctxt "Freddy"
msgid "<w>YOURSELF</w>"
msgstr "<w>TE</w>"

# Traduction IA – à relire
#: freddy_fridge/monster_join/0/c-0/48
msgctxt "Freddy"
msgid "<w>GONE</w>"
msgstr "<w>FAIRE VOIR</w>"

# Traduction IA – à relire
#: freddy_fridge/monster_join/0/c-0/59/0/s/0
msgctxt "Choix"
msgid "Okay... I'm going."
msgstr "Ok... j'y vais."

# Traduction IA – à relire
#: freddy_fridge/monster_join/0/c-0/59/1/s/0
msgctxt "Choix"
msgid "Yikes!"
msgstr "Aïe !"

# Traduction IA – à relire
#: freddy_fridge/monster_join/0/c-1/7
msgctxt "Freddy"
msgid "<w>WHO I REALLY AM</w>"
msgstr "<w>VOILÀ QUI JE SUIS VRAIMENT</w>"

# Traduction IA – à relire
#: freddy_fridge/monster_join/0/c-1/15
msgctxt "Freddy"
msgid "<w>A MONSTER</w>"
msgstr "<w>UN MONSTRE</w>"

# Traduction IA – à relire
#: freddy_fridge/monster_join/0/c-1/23
msgctxt "Freddy"
msgid "<w>WHO RUINS YOUR FOOD</w>"
msgstr "<w>QUI GÂCHE TA NOURRITURE</w>"

# Traduction IA – à relire
#: freddy_fridge/monster_join/0/c-1/34/0/s/0
msgctxt "Choix"
msgid "No, you're not a monster..."
msgstr "Non, tu n'es pas un monstre..."

# Traduction IA – à relire
#: freddy_fridge/monster_join/0/c-1/34/1/s/0
msgctxt "Choix"
msgid "You got that right..."
msgstr "Tu l'as dit..."

# Traduction IA – à relire
#: freddy_fridge/monster_join/0/c-1/34/c-0/7
msgctxt "Freddy"
msgid "<w>I'M CLEARLY A FUCKING MONSTER</w>"
msgstr "<w>JE SUIS CLAIREMENT UN PUTAIN DE MONSTRE</w>"

# Traduction IA – à relire
#: freddy_fridge/monster_join/0/c-2/7
msgctxt "Freddy"
msgid "<w>NO</w>"
msgstr "<w>NON</w>"

# Traduction IA – à relire
#: freddy_fridge/monster_join/0/c-2/15
msgctxt "Freddy"
msgid "<w>NO HUMAN CAN STOP MY FROSTIEST FORM</w>"
msgstr "<w>AUCUN HUMAIN NE PEUT ARRÊTER MA FORME LA PLUS GLACIALE</w>"

# Traduction IA – à relire
#: freddy_fridge/monster_join/0/c-2/23
msgctxt "Freddy"
msgid "<w>GO</w>"
msgstr "<w>PARS</w>"

# Traduction IA – à relire
#: freddy_fridge/monster_join/0/c-2/31
msgctxt "Freddy"
msgid "<w>AWAY</w>"
msgstr "<w>LOIN</w>"

# Traduction IA – à relire
#: freddy_fridge/monster_join/0/c-2/39
msgctxt "Freddy"
msgid "<w>NOW!!!</w>"
msgstr "<w>MAINTENANT !!!</w>"

# Traduction IA – à relire
#: freddy_fridge/monster_join/0/g-0/0
msgctxt "Narrator"
msgid "Freddy falls back against the wall, one hand clutching his chest as he struggles to catch his breath. He seems to be waging some sort of internal battle."
msgstr "Freddy s'adosse au mur, une main crispée sur la poitrine, luttant pour reprendre son souffle. Il semble mener une sorte de bataille intérieure."

# Traduction IA – à relire
#: freddy_fridge/monster_join/0/g-0/16
msgctxt "Narrator"
msgid "He's a shadow of the monster he just was, quiet and small and shaken."
msgstr "Il n'est plus que l'ombre du monstre qu'il était à l'instant, silencieux, petit et ébranlé."

# Traduction IA – à relire
#: freddy_fridge/monster_join/0/g-0/24
msgctxt "Freddy"
msgid "Oh... I'm so so so so so sorry."
msgstr "Oh... je suis tellement tellement tellement désolé."

# Traduction IA – à relire
#: freddy_fridge/monster_join/0/g-0/32
msgctxt "Freddy"
msgid "Please... just... go..."
msgstr "S'il te plaît... juste... pars..."

# Traduction IA – à relire
#: freddy_fridge/monster_join/0/g-0/43/s/0
msgctxt "Choix"
msgid "Freddy?"
msgstr "Freddy ?"

# Traduction IA – à relire
#: freddy_fridge/monster_join/0/g-0/44/s/0
msgctxt "Choix"
msgid "Wow..."
msgstr "Wow..."

# Traduction IA – à relire
#: freddy_fridge/monster_join/0/g-1/0
msgctxt "Narrator"
msgid "He is gone."
msgstr "Il est parti."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Food_Negative/0
msgctxt "Freddy"
msgid "Did you really have to say that?"
msgstr "Tu avais vraiment besoin de dire ça ?"

# Traduction IA – à relire
#: freddy_fridge/Rotten_Food_Negative/8
msgctxt "Freddy"
msgid "I've been working REALLY hard to keep everything nice and fresh for you."
msgstr "Je me suis donné BEAUCOUP de mal pour tout garder bien frais pour toi."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Food_Negative/16
msgctxt "Freddy"
msgid "And I mean, REALLY hard."
msgstr "Et quand je dis BEAUCOUP de mal..."

# Traduction IA – à relire
#: freddy_fridge/Rotten_Food_Negative/24
msgctxt "Freddy"
msgid "<w>AND YOU ARE JUST GOING TO RUB IT IN MY FACE?!</w>"
msgstr "<w>ET TU VAS ME LE RESSORTIR EN PLEINE FIGURE ?!</w>"

# Traduction IA – à relire
#: freddy_fridge/Rotten_Food_Negative/35
msgctxt "Freddy"
msgid "<w>YOU THINK I WANTED THIS TO HAPPEN?</w>"
msgstr "<w>TU CROIS QUE JE VOULAIS QUE ÇA ARRIVE ?</w>"

# Traduction IA – à relire
#: freddy_fridge/Rotten_Food_Negative/43
msgctxt "Freddy"
msgid "<w>HUH???!!</w>"
msgstr "<w>HEIN ???!!</w>"

# Traduction IA – à relire
#: freddy_fridge/Rotten_Food_Negative/59
msgctxt "Freddy"
msgid "<w>WELL?! SAY SOMETHING!!!!</w>"
msgstr "<w>ALORS ?! DIS QUELQUE CHOSE !!!!</w>"

# Traduction IA – à relire
#: freddy_fridge/bev_freddy/0/12/s/0 freddy_fridge/luke_freddy/0/12/s/0 freddy_fridge/stefan_freddy/0/12/s/0 freddy_fridge/doug_freddy_monster/0/12/s/0
msgctxt "Choix"
msgid "Hey, Freddy? Freddy!"
msgstr "Hé, Freddy ? Freddy !"

# Traduction IA – à relire
#: freddy_fridge/bev_freddy/0/13/s/0 freddy_fridge/luke_freddy/0/13/s/0 freddy_fridge/stefan_freddy/0/13/s/0 freddy_fridge/doug_freddy_monster/0/13/s/0
msgctxt "Choix"
msgid "Hey Freddy! Cool kid here!"
msgstr "Hé Freddy ! C'est le cool kid !"

# Traduction IA – à relire
#: freddy_fridge/bev_freddy/0/14/s/0
msgctxt "Choix"
msgid "Look... it's the monster."
msgstr "Regarde... voilà le monstre."

# Traduction IA – à relire
#: freddy_fridge/bev_freddy/0/g-0/0
msgctxt "Freddy"
msgid "...oh, oh man."
msgstr "...oh, mince."

# Traduction IA – à relire
#: freddy_fridge/bev_freddy/0/g-0/8 freddy_fridge/luke_freddy/0/c-1/15 freddy_fridge/stefan_freddy/0/c-1/15 freddy_fridge/doug_freddy_monster/0/c-1/15
msgctxt "Narrator"
msgid "Freddy looks away from you, exiting without a word."
msgstr "Freddy détourne le regard et sort sans un mot."

# Traduction IA – à relire
#: freddy_fridge/bev_freddy/0/g-0/25
msgctxt "Beverly"
msgid "Hey... are you here for Freddy?"
msgstr "Hé... tu es là pour Freddy ?"

# Traduction IA – à relire
#: freddy_fridge/bev_freddy/0/g-0/33/b/1
msgctxt "Beverly"
msgid "Hope your mouth is okay from the glass..."
msgstr "J'espère que ta bouche va bien après le verre..."

# Traduction IA – à relire
#: freddy_fridge/bev_freddy/0/g-0/36/s/0
msgctxt "Choix"
msgid "Yeah. Is he okay?"
msgstr "Oui. Il va bien ?"

# Traduction IA – à relire
#: freddy_fridge/bev_freddy/0/g-0/37/s/0
msgctxt "Choix"
msgid "He's giving me the silent treatment."
msgstr "Il me fait la tête."

# Traduction IA – à relire
#: freddy_fridge/bev_freddy/0/g-0/38/s/0
msgctxt "Choix"
msgid "My mouth is doing okay. Just wondering about Freddy."
msgstr "Ma bouche va bien. Je m'inquiète juste pour Freddy."

# Traduction IA – à relire
#: freddy_fridge/bev_freddy/0/g-1/0
msgctxt "Beverly"
msgid "He knows he lost his cool last time and he's really ashamed of it."
msgstr "Il sait qu'il a perdu son sang-froid la dernière fois, et il en a vraiment honte."

# Traduction IA – à relire
#: freddy_fridge/bev_freddy/0/g-1/8
msgctxt "Beverly"
msgid "He hasn't been speaking to anyone really."
msgstr "Il ne parle plus vraiment à personne."

# Traduction IA – à relire
#: freddy_fridge/bev_freddy/0/g-1/16
msgctxt "Beverly"
msgid "I can barely get him to make any ice."
msgstr "J'arrive à peine à lui faire produire de la glace."

# Traduction IA – à relire
#: freddy_fridge/bev_freddy/0/g-1/24
msgctxt "Beverly"
msgid "Which is a shame, because I've got this fantastic pumpkin sour that—"
msgstr "Ce qui est dommage, parce que j'ai ce fantastique pumpkin sour qui..."

# Traduction IA – à relire
#: freddy_fridge/bev_freddy/0/g-1/32
msgctxt "Beverly"
msgid "You know what? It's not important."
msgstr "Tu sais quoi ? Ça n'a pas d'importance."

# Traduction IA – à relire
#: freddy_fridge/bev_freddy/0/g-1/40/s/0
msgctxt "Choix"
msgid "Anything I can do?"
msgstr "Je peux faire quelque chose ?"

# Traduction IA – à relire
#: freddy_fridge/bev_freddy/0/g-1/41/s/0
msgctxt "Choix"
msgid "I've gotta talk to him."
msgstr "Il faut que je lui parle."

# Traduction IA – à relire
#: freddy_fridge/bev_freddy/0/g-1/42/s/0
msgctxt "Choix"
msgid "He lost his cool. Not my problem."
msgstr "Il a perdu son sang-froid. Pas mon problème."

# Traduction IA – à relire
#: freddy_fridge/bev_freddy/0/g-2/0 freddy_fridge/bev_freddy_mad/0/c-1/15
msgctxt "Beverly"
msgid "Word on the countertop is that he's been pretty active at night."
msgstr "Le bruit court sur le comptoir qu'il est assez actif la nuit."

# Traduction IA – à relire
#: freddy_fridge/bev_freddy/0/g-2/8
msgctxt "Beverly"
msgid "I think it's so he won't have to interact with us much."
msgstr "Je pense que c'est pour ne pas avoir à interagir avec nous."

# Traduction IA – à relire
#: freddy_fridge/bev_freddy/0/g-2/16 freddy_fridge/bev_freddy_mad/0/c-1/31
msgctxt "Beverly"
msgid "Maybe if you come back then?"
msgstr "Peut-être que si tu reviens à ce moment-là ?"

# Traduction IA – à relire
#: freddy_fridge/bev_freddy/0/g-2/24 freddy_fridge/bev_freddy_mad/0/c-1/39
msgctxt "Beverly"
msgid "Until then, I think we better leave him alone. Big guy needs to sulk in peace."
msgstr "En attendant, je pense qu'on ferait mieux de le laisser tranquille. Le grand gaillard a besoin de bouder en paix."

# Traduction IA – à relire
#: freddy_fridge/bev_freddy/0/g-2/32/s/0 freddy_fridge/bev_freddy_mad/0/26/s/0
msgctxt "Choix"
msgid "Okay, I'll check back at night..."
msgstr "Ok, je repasserai la nuit..."

# Traduction IA – à relire
#: freddy_fridge/bev_freddy/0/g-2/33/s/0 freddy_fridge/bev_freddy_mad/0/27/s/0
msgctxt "Choix"
msgid "Maybe he deserves it for the way he talked to me."
msgstr "Il le mérite peut-être, vu la façon dont il m'a parlé."

# Traduction IA – à relire
#: freddy_fridge/bev_freddy/0/g-2/c-9/7 freddy_fridge/bev_freddy_mad/0/c-2/7
msgctxt "Beverly"
msgid "Thank you."
msgstr "Merci."

# Traduction IA – à relire
#: freddy_fridge/bev_freddy/0/g-2/c-10/7 freddy_fridge/bev_freddy_mad/0/c-3/7
msgctxt "Beverly"
msgid "He doesn't. You know he's a nice fridge... he just..."
msgstr "Non. Tu sais que c'est un gentil frigo... il est juste..."

# Traduction IA – à relire
#: freddy_fridge/bev_freddy/0/g-2/c-10/15 freddy_fridge/bev_freddy_mad/0/c-3/15
msgctxt "Beverly"
msgid "Sometimes can't control himself."
msgstr "Parfois, il n'arrive pas à se contrôler."

# Traduction IA – à relire
#: freddy_fridge/bev_freddy/0/g-3/0 freddy_fridge/bev_freddy_mad/0/g-0/0
msgctxt "Beverly"
msgid "Just don't want him to blow up again."
msgstr "Je ne veux juste pas qu'il explose encore."

# Traduction IA – à relire
#: freddy_fridge/bev_freddy/0/g-3/8 freddy_fridge/bev_freddy_mad/0/g-0/8
msgctxt "Beverly"
msgid "Good luck..."
msgstr "Bonne chance..."

# Traduction IA – à relire
#: freddy_fridge/bev_freddy_mad/0/0
msgctxt "Beverly"
msgid "You know, I get it. I really do."
msgstr "Tu sais, je comprends. Vraiment."

# Traduction IA – à relire
#: freddy_fridge/bev_freddy_mad/0/8
msgctxt "Beverly"
msgid "It's a shame he did what he did."
msgstr "C'est dommage qu'il ait fait ça."

# Traduction IA – à relire
#: freddy_fridge/bev_freddy_mad/0/16
msgctxt "Beverly"
msgid "But, don't you think he deserves another chance?"
msgstr "Mais tu ne crois pas qu'il mérite une autre chance ?"

# Traduction IA – à relire
#: freddy_fridge/bev_freddy_mad/0/24/s/0
msgctxt "Choix"
msgid "No! That kind of anger is dangerous! I'm out!"
msgstr "Non ! Ce genre de colère est dangereux ! Je m'en vais !"

# Traduction IA – à relire
#: freddy_fridge/bev_freddy_mad/0/25/s/0
msgctxt "Choix"
msgid "Yeah... I guess so."
msgstr "Ouais... je suppose."

# Traduction IA – à relire
#: freddy_fridge/bev_freddy_mad/0/c-0/18 freddy_fridge/luke_freddy_mad/0/c-0/10 freddy_fridge/stefan_freddy_mad/0/c-0/10
msgctxt "Freddy"
msgid "Heard."
msgstr "J'ai entendu."

# Traduction IA – à relire
#: freddy_fridge/bev_freddy_mad/0/c-0/29
msgctxt "Beverly"
msgid "Well... not much you can do now."
msgstr "Bon... tu ne peux plus rien y faire maintenant."

# Traduction IA – à relire
#: freddy_fridge/bev_freddy_mad/0/c-0/37
msgctxt "Beverly"
msgid "I'd say just leave him alone. It's for the best."
msgstr "Je dirais de le laisser tranquille. C'est mieux comme ça."

# Traduction IA – à relire
#: freddy_fridge/bev_freddy_mad/0/c-1/7
msgctxt "Beverly"
msgid "If you want to talk to him..."
msgstr "Si tu veux lui parler..."

# Traduction IA – à relire
#: freddy_fridge/bev_freddy_mad/0/c-1/23
msgctxt "Beverly"
msgid "I think it's so he won't have to interact with us as much."
msgstr "Je pense que c'est pour ne pas avoir à interagir autant avec nous."

# Traduction IA – à relire
#: freddy_fridge/luke_freddy/0/g-0/0
msgctxt "Luke"
msgid "Ranger! What you comin' round here for?"
msgstr "Ranger ! Qu'est-ce que tu viens faire par ici ?"

# Traduction IA – à relire
#: freddy_fridge/luke_freddy/0/g-0/8
msgctxt "Luke"
msgid "Don’t you know there's swarmers all over this sector?!"
msgstr "Tu ne sais pas qu'il y a des Grouilleurs partout dans ce secteur ?!"

# Traduction IA – à relire
#: freddy_fridge/luke_freddy/0/g-0/16
msgctxt "Luke"
msgid "Sure they’re mostly just loungin’ around and working on their short game, but you never know with those little freaks..."
msgstr "Bien sûr, la plupart du temps ils traînent juste à peaufiner leur petit jeu, mais avec ces petits monstres, on ne sait jamais..."

# Traduction IA – à relire
#: freddy_fridge/luke_freddy/0/g-0/24/s/0
msgctxt "Choix"
msgid "I want to talk to Freddy."
msgstr "Je veux parler à Freddy."

# Traduction IA – à relire
#: freddy_fridge/luke_freddy/0/g-0/c-2/7
msgctxt "Luke"
msgid "I see..."
msgstr "Je vois..."

# Traduction IA – à relire
#: freddy_fridge/luke_freddy/0/g-0/c-2/15
msgctxt "Luke"
msgid "Listen Ranger, that ain’t gonna happen. I’m sorry."
msgstr "Écoute, Ranger, ça n'arrivera pas. Désolé."

# Traduction IA – à relire
#: freddy_fridge/luke_freddy/0/g-0/c-2/23/0/s/0 freddy_fridge/stefan_freddy/0/14/s/0
msgctxt "Choix"
msgid "What's wrong with him?"
msgstr "Qu'est-ce qu'il a ?"

# Traduction IA – à relire
#: freddy_fridge/luke_freddy/0/g-0/c-2/23/1/s/0
msgctxt "Choix"
msgid "He's usually a chatterbox."
msgstr "D'habitude, c'est un moulin à paroles."

# Traduction IA – à relire
#: freddy_fridge/luke_freddy/0/g-1/0
msgctxt "Luke"
msgid "He ain’t been talking to anyone. Not since you two got into it the other day."
msgstr "Il ne parle à personne. Pas depuis votre prise de bec l'autre jour."

# Traduction IA – à relire
#: freddy_fridge/luke_freddy/0/g-1/8
msgctxt "Luke"
msgid "I prayed to the Immortals to change his heart. Hell, I even sacrificed several tendies at the Altar of Uzer the Redeemer. But it ain’t no use. It’s time to let him go."
msgstr "J'ai prié les Immortels de changer son cœur. Bon sang, j'ai même sacrifié plusieurs tenders sur l'Autel d'Uzer le Rédempteur. Mais rien à faire. Il est temps de le laisser partir."

# Traduction IA – à relire
#: freddy_fridge/luke_freddy/0/g-1/16
msgctxt "Luke"
msgid "You uh... want me to pull the plug? I’ll pull the plug. Just say the word, Ranger."
msgstr "Tu veux, euh... que je le débranche ? Je le débranche. Dis un mot, Ranger."

# Traduction IA – à relire
#: freddy_fridge/luke_freddy/0/g-1/24/s/0
msgctxt "Choix"
msgid "What the hell! Don't do that!"
msgstr "Mais ça va pas ! Ne fais pas ça !"

# Traduction IA – à relire
#: freddy_fridge/luke_freddy/0/g-1/25/s/0
msgctxt "Choix"
msgid "I've gotta talk to him... no need to go that far."
msgstr "Il faut que je lui parle... pas besoin d'aller si loin."

# Traduction IA – à relire
#: freddy_fridge/luke_freddy/0/g-1/26/s/0
msgctxt "Choix"
msgid "Him getting mad was unacceptable. I won't deal with it."
msgstr "Sa colère était inacceptable. Je ne le supporterai pas."

# Traduction IA – à relire
#: freddy_fridge/luke_freddy/0/g-1/c-3/7
msgctxt "Luke"
msgid "Plug pullin' ain't nothin'. Just a little reset."
msgstr "Débrancher, c'est rien. Juste une petite réinitialisation."

# Traduction IA – à relire
#: freddy_fridge/luke_freddy/0/g-2/0
msgctxt "Luke"
msgid "Ranger, you’re more stubborn than the gamma worms that refuse to get flushed outta my kidneys."
msgstr "Ranger, t'es plus têtu que les vers gamma qui refusent de se faire évacuer de mes reins."

# Traduction IA – à relire
#: freddy_fridge/luke_freddy/0/g-2/8
msgctxt "Luke"
msgid "If you wanna get cursed at, well... it’s your funeral."
msgstr "Si tu veux te faire insulter, eh bien... c'est ton enterrement."

# Traduction IA – à relire
#: freddy_fridge/luke_freddy/0/g-2/16
msgctxt "Luke"
msgid "Just like it’ll be <i>my</i> funeral if I can’t flush out those parasites by sundown."
msgstr "Comme ce sera <i>mon</i> enterrement si je n'évacue pas ces parasites d'ici le coucher du soleil."

# Traduction IA – à relire
#: freddy_fridge/luke_freddy/0/g-2/24
msgctxt "Luke"
msgid "The loaf has been really active at night lately. He thinks we don't hear him, but we do."
msgstr "Le gros pain est très actif la nuit ces derniers temps. Il croit qu'on ne l'entend pas, mais si."

# Traduction IA – à relire
#: freddy_fridge/luke_freddy/0/g-2/32
msgctxt "Luke"
msgid "That's going to be your best bet, I reckon."
msgstr "Ce sera ta meilleure option, je crois."

# Traduction IA – à relire
#: freddy_fridge/luke_freddy/0/g-2/40 freddy_fridge/luke_freddy_mad/0/c-1/47
msgctxt "Luke"
msgid "But, don't say I didn't warn you, alright?"
msgstr "Mais ne dis pas que je ne t'ai pas prévenu, d'accord ?"

# Traduction IA – à relire
#: freddy_fridge/luke_freddy/0/g-2/48
msgctxt "Luke"
msgid "May the Immortals watch over you - and protect you from all three major types of radioactive worms!"
msgstr "Que les Immortels veillent sur toi, et te protègent des trois grands types de vers radioactifs !"

# Traduction IA – à relire
#: freddy_fridge/luke_freddy_mad/0/0
msgctxt "Luke"
msgid "Take it from someone who has a temper, Ranger - sometimes... sometimes, you can't control it."
msgstr "Crois quelqu'un qui a un tempérament, Ranger : parfois... parfois, on ne peut pas se contrôler."

# Traduction IA – à relire
#: freddy_fridge/luke_freddy_mad/0/8
msgctxt "Luke"
msgid "Heck, one time I neutralized my entire battalion ‘cause someone left the toilet seat up!"
msgstr "Tiens, une fois, j'ai neutralisé tout mon bataillon parce que quelqu'un avait laissé la lunette des toilettes relevée !"

# Traduction IA – à relire
#: freddy_fridge/luke_freddy_mad/0/16
msgctxt "Luke"
msgid "Had to bury the bodies <i>way</i> out in the deep backyard so the swarmers wouldn’t pick up the stench."
msgstr "J'ai dû enterrer les corps <i>très</i> loin dans le fond du jardin pour que les Grouilleurs ne sentent pas l'odeur."

# Traduction IA – à relire
#: freddy_fridge/luke_freddy_mad/0/24
msgctxt "Luke"
msgid "Sometimes, when I see an upright toilet seat, I can still hear their screams..."
msgstr "Parfois, quand je vois une lunette de toilettes relevée, j'entends encore leurs cris..."

# Traduction IA – à relire
#: freddy_fridge/luke_freddy_mad/0/32
msgctxt "Luke"
msgid "Anywho! As much as Freddy annoys me, he does mean well."
msgstr "Enfin bref ! Même si Freddy m'énerve, il est bien intentionné."

# Traduction IA – à relire
#: freddy_fridge/luke_freddy_mad/0/40
msgctxt "Luke"
msgid "You can either give him a second chance or not. I don't really fuckin' care."
msgstr "Tu peux lui donner une seconde chance ou pas. Moi, j'en ai rien à foutre."

# Traduction IA – à relire
#: freddy_fridge/luke_freddy_mad/0/48/s/0
msgctxt "Choix"
msgid "The way he raged out? No way! Not for me."
msgstr "Après la façon dont il a pété les plombs ? Aucune chance ! Pas pour moi."

# Traduction IA – à relire
#: freddy_fridge/luke_freddy_mad/0/49/s/0
msgctxt "Choix"
msgid "This did seem out of character."
msgstr "Ça ne lui ressemblait vraiment pas."

# Traduction IA – à relire
#: freddy_fridge/luke_freddy_mad/0/c-0/21
msgctxt "Luke"
msgid "Great job, Ranger! When someone’s a cancer in your life sometimes it’s best to just cut ‘em out!"
msgstr "Bien joué, Ranger ! Quand quelqu'un est un cancer dans ta vie, parfois, le mieux est de l'extraire !"

# Traduction IA – à relire
#: freddy_fridge/luke_freddy_mad/0/c-0/29
msgctxt "Luke"
msgid "<i>Or</i> just reach inside your chest cavity and YANK the cancer out with your bare hands."
msgstr "<i>Ou alors</i> tu plonges la main dans ta cage thoracique et tu ARRACHES le cancer à mains nues."

# Traduction IA – à relire
#: freddy_fridge/luke_freddy_mad/0/c-0/37
msgctxt "Luke"
msgid "But I’d take my surgical advice with a grain of salt. I did fail outta med school."
msgstr "Mais prends mes conseils chirurgicaux avec des pincettes. J'ai raté mes études de médecine."

# Traduction IA – à relire
#: freddy_fridge/luke_freddy_mad/0/c-0/45
msgctxt "Luke"
msgid "How was I supposed to know the human body’s got <i>multiple</i> kinds of bladders?!"
msgstr "Comment j'étais censé savoir que le corps humain a <i>plusieurs</i> sortes de vessies ?!"

# Traduction IA – à relire
#: freddy_fridge/luke_freddy_mad/0/c-0/53
msgctxt "Luke"
msgid "Anyway, may the Immortals blah blah blah... you get the whole schtick."
msgstr "Bref, que les Immortels bla bla bla... tu connais le refrain."

# Traduction IA – à relire
#: freddy_fridge/luke_freddy_mad/0/c-1/7
msgctxt "Luke"
msgid "He got heated. It happens. Give him a chance."
msgstr "Il s'est emporté. Ça arrive. Donne-lui une chance."

# Traduction IA – à relire
#: freddy_fridge/luke_freddy_mad/0/c-1/15
msgctxt "Luke"
msgid "For as it says in the Holy Doctrine!"
msgstr "Car ainsi est-il écrit dans la Sainte Doctrine !"

# Traduction IA – à relire
#: freddy_fridge/luke_freddy_mad/0/c-1/23
msgctxt "Luke"
msgid "\"Forgive those who harm you... you know not what cool worms infest their brain.\" Scylax 7:17."
msgstr "« Pardonne à ceux qui te nuisent... tu ne sais pas quels vers bien frais infestent leur cerveau. » Scylax 7:17."

# Traduction IA – à relire
#: freddy_fridge/luke_freddy_mad/0/c-1/31
msgctxt "Luke"
msgid "Anway, the loaf has been really active at night lately. He thinks we don't hear him, but we do."
msgstr "Bref, le gros pain est très actif la nuit ces derniers temps. Il croit qu'on ne l'entend pas, mais si."

# Traduction IA – à relire
#: freddy_fridge/luke_freddy_mad/0/c-1/39
msgctxt "Luke"
msgid "I reckon that’s gonna be your best bet."
msgstr "Je pense que ce sera ta meilleure option."

# Traduction IA – à relire
#: freddy_fridge/luke_freddy_mad/0/c-1/55
msgctxt "Luke"
msgid "I’ve got a reputation around here for giving real good warnings. Don't wanna soil it."
msgstr "J'ai la réputation par ici de donner de très bons avertissements. Je ne tiens pas à la ternir."

# Traduction IA – à relire
#: freddy_fridge/stefan_freddy/0/15/s/0
msgctxt "Choix"
msgid "Is it something I did?"
msgstr "C'est à cause de quelque chose que j'ai fait ?"

# Traduction IA – à relire
#: freddy_fridge/stefan_freddy/0/c-1/32
msgctxt "Stefan"
msgid "I see you are trying to talk to our fridged friend as well."
msgstr "Je vois que vous essayez de parler à notre ami frigorifié, vous aussi."

# Traduction IA – à relire
#: freddy_fridge/stefan_freddy/0/c-1/40
msgctxt "Stefan"
msgid "He isn't responding to much as of late."
msgstr "Il ne réagit pas à grand-chose ces derniers temps."

# Traduction IA – à relire
#: freddy_fridge/stefan_freddy/0/g-0/0
msgctxt "Stefan"
msgid "It's hard to say. Usually Freddy keeps everyone in the kitchen on their toes with his puns."
msgstr "C'est difficile à dire. D'habitude, Freddy tient toute la cuisine en haleine avec ses jeux de mots."

# Traduction IA – à relire
#: freddy_fridge/stefan_freddy/0/g-0/8
msgctxt "Stefan"
msgid "But since the last time you spoke to him, I can't even get him to crack a joke."
msgstr "Mais depuis la dernière fois que vous lui avez parlé, je n'arrive même pas à lui arracher une blague."

# Traduction IA – à relire
#: freddy_fridge/stefan_freddy/0/g-0/16
msgctxt "Stefan"
msgid "He's giving us all the cold shoulder."
msgstr "Il nous bat tous froid."

# Traduction IA – à relire
#: freddy_fridge/stefan_freddy/0/g-0/24
msgctxt "Stefan"
msgid "Oh drat! A bad pun myself! Perhaps I'm taking his place."
msgstr "Oh zut ! Un mauvais jeu de mots, et de ma part ! Je prends peut-être sa place."

# Traduction IA – à relire
#: freddy_fridge/stefan_freddy/0/g-0/32
msgctxt "Stefan"
msgid "You have to talk to him. Get him to open up again."
msgstr "Vous devez lui parler. Le faire s'ouvrir à nouveau."

# Traduction IA – à relire
#: freddy_fridge/stefan_freddy/0/g-0/40/s/0
msgctxt "Choix"
msgid "But he won't even look at me."
msgstr "Mais il ne veut même pas me regarder."

# Traduction IA – à relire
#: freddy_fridge/stefan_freddy/0/g-0/41/s/0
msgctxt "Choix"
msgid "How am I supposed to do that?"
msgstr "Comment je fais ça ?"

# Traduction IA – à relire
#: freddy_fridge/stefan_freddy/0/g-0/42/s/0
msgctxt "Choix"
msgid "He showed who he really is. I'm done."
msgstr "Il a montré qui il est vraiment. J'abandonne."

# Traduction IA – à relire
#: freddy_fridge/stefan_freddy/0/g-1/0 freddy_fridge/stefan_freddy_mad/0/c-1/7
msgctxt "Stefan"
msgid "Come back at night. He's been keeping odd hours, so it might be worth catching him then."
msgstr "Revenez la nuit. Il a des horaires étranges, donc il vaut peut-être la peine de le trouver à ce moment-là."

# Traduction IA – à relire
#: freddy_fridge/stefan_freddy/0/g-1/8 freddy_fridge/stefan_freddy_mad/0/c-1/15
msgctxt "Stefan"
msgid "I have no idea what he's been doing, but I hear him up and about."
msgstr "Je n'ai aucune idée de ce qu'il fabrique, mais je l'entends s'agiter."

# Traduction IA – à relire
#: freddy_fridge/stefan_freddy/0/g-1/16 freddy_fridge/stefan_freddy_mad/0/c-1/23
msgctxt "Stefan"
msgid "Keep in mind... we've seen what he is capable of."
msgstr "Gardez en tête... que nous avons vu de quoi il est capable."

# Traduction IA – à relire
#: freddy_fridge/stefan_freddy/0/g-1/24 freddy_fridge/stefan_freddy_mad/0/c-1/31
msgctxt "Stefan"
msgid "It might not be pretty."
msgstr "Ce ne sera peut-être pas joli."

# Traduction IA – à relire
#: freddy_fridge/stefan_freddy_mad/0/0
msgctxt "Stefan"
msgid "He isn't perfect. No one is. But let me tell you..."
msgstr "Il n'est pas parfait. Personne ne l'est. Mais laissez-moi vous dire..."

# Traduction IA – à relire
#: freddy_fridge/stefan_freddy_mad/0/8
msgctxt "Stefan"
msgid "He's a good fridge. There aren't many like him."
msgstr "C'est un bon frigo. Il n'y en a pas beaucoup comme lui."

# Traduction IA – à relire
#: freddy_fridge/stefan_freddy_mad/0/16
msgctxt "Stefan"
msgid "Maybe... he deserves another chance?"
msgstr "Peut-être... qu'il mérite une autre chance ?"

# Traduction IA – à relire
#: freddy_fridge/stefan_freddy_mad/0/24/s/0
msgctxt "Choix"
msgid "That was over the line. I refuse to deal with it."
msgstr "C'était allé trop loin. Je refuse de le supporter."

# Traduction IA – à relire
#: freddy_fridge/stefan_freddy_mad/0/25/s/0
msgctxt "Choix"
msgid "I'll talk to him. If he'll talk to me."
msgstr "Je lui parlerai. S'il veut bien me parler."

# Traduction IA – à relire
#: freddy_fridge/stefan_freddy_mad/0/c-0/21
msgctxt "Stefan"
msgid "Oh... well, that was abrupt."
msgstr "Oh... eh bien, c'était abrupt."

# Traduction IA – à relire
#: freddy_fridge/stefan_freddy_mad/0/c-0/29
msgctxt "Stefan"
msgid "We should leave him be."
msgstr "Nous devrions le laisser tranquille."

# Traduction IA – à relire
#: freddy_fridge/stefan_freddy_mad/0/c-0/37
msgctxt "Stefan"
msgid "He's having a rough time of it."
msgstr "Il traverse une période difficile."

# Traduction IA – à relire
#: freddy_fridge/doug_freddy_monster/0/g-0/0/b/1
msgctxt "Doug"
msgid "Whattup wattup."
msgstr "Quoi d'neuf, quoi d'neuf."

# Traduction IA – à relire
#: freddy_fridge/doug_freddy_monster/0/g-0/3/b/1
msgctxt "Doug"
msgid "Whattup lover."
msgstr "Quoi d'neuf, mon cœur."

# Traduction IA – à relire
#: freddy_fridge/doug_freddy_monster/0/g-0/6
msgctxt "Doug"
msgid "Look."
msgstr "Regarde."

# Traduction IA – à relire
#: freddy_fridge/doug_freddy_monster/0/g-0/22
msgctxt "Doug"
msgid "It sucks to see him like this, right?"
msgstr "C'est moche de le voir comme ça, hein ?"

# Traduction IA – à relire
#: freddy_fridge/doug_freddy_monster/0/g-0/30/s/0
msgctxt "Choix"
msgid "Is everything okay?"
msgstr "Tout va bien ?"

# Traduction IA – à relire
#: freddy_fridge/doug_freddy_monster/0/g-0/31/s/0
msgctxt "Choix"
msgid "Is Freddy broken?"
msgstr "Freddy est cassé ?"

# Traduction IA – à relire
#: freddy_fridge/doug_freddy_monster/0/g-0/32/s/0
msgctxt "Choix"
msgid "Can't believe you care?"
msgstr "J'arrive pas à croire que ça t'importe ?"

# Traduction IA – à relire
#: freddy_fridge/doug_freddy_monster/0/g-0/c-4/7
msgctxt "Doug"
msgid "I'm not Despair, okay. I'm not heartless."
msgstr "Je suis pas Désespoir, ok. J'ai un cœur."

# Traduction IA – à relire
#: freddy_fridge/doug_freddy_monster/0/g-1/0
msgctxt "Doug"
msgid "I've only seen Freddy like this one other time."
msgstr "Je n'ai vu Freddy comme ça qu'une seule autre fois."

# Traduction IA – à relire
#: freddy_fridge/doug_freddy_monster/0/g-1/8
msgctxt "Doug"
msgid "And it was during a brown out in the middle of the summer."
msgstr "C'était pendant une baisse de tension en plein été."

# Traduction IA – à relire
#: freddy_fridge/doug_freddy_monster/0/g-1/16
msgctxt "Doug"
msgid "We lost some good melons during that whole affair."
msgstr "On a perdu de belles pastèques pendant toute cette affaire."

# Traduction IA – à relire
#: freddy_fridge/doug_freddy_monster/0/g-1/24
msgctxt "Doug"
msgid "Which was just freaking awful."
msgstr "Ce qui était vraiment atroce."

# Traduction IA – à relire
#: freddy_fridge/doug_freddy_monster/0/g-1/32
msgctxt "Doug"
msgid "Why the fuck am I talking about melons."
msgstr "Pourquoi putain je parle de pastèques."

# Traduction IA – à relire
#: freddy_fridge/doug_freddy_monster/0/g-1/40
msgctxt "Doug"
msgid "Can you fix this? I'm shit at this."
msgstr "Tu peux arranger ça ? Je suis nul pour ça."

# Traduction IA – à relire
#: freddy_fridge/doug_freddy_monster/0/g-1/48/s/0
msgctxt "Choix"
msgid "You think I can get him to talk?"
msgstr "Tu crois que je peux le faire parler ?"

# Traduction IA – à relire
#: freddy_fridge/doug_freddy_monster/0/g-1/49/s/0
msgctxt "Choix"
msgid "What can I do?"
msgstr "Que puis-je faire ?"

# Traduction IA – à relire
#: freddy_fridge/doug_freddy_monster/0/g-1/50/s/0
msgctxt "Choix"
msgid "He screamed at me. I'm not doing anything for him."
msgstr "Il m'a hurlé dessus. Je ne ferai rien pour lui."

# Traduction IA – à relire
#: freddy_fridge/doug_freddy_monster/0/g-2/0 freddy_fridge/doug_freddy_mad/0/c-1/7
msgctxt "Doug"
msgid "Sweet. Swing by at night. Freddy's been keeping the moon company."
msgstr "Cool. Passe la nuit. Freddy tient compagnie à la lune."

# Traduction IA – à relire
#: freddy_fridge/doug_freddy_monster/0/g-2/8 freddy_fridge/doug_freddy_mad/0/c-1/15
msgctxt "Doug"
msgid "I hear him mumbling all the time about some shit, but I can't make it out."
msgstr "Je l'entends marmonner tout le temps des trucs, mais j'arrive pas à comprendre."

# Traduction IA – à relire
#: freddy_fridge/doug_freddy_monster/0/g-2/16
msgctxt "Doug"
msgid "Just.... be easy with the big guy. He means well and he has a heart of cold—I mean gold."
msgstr "Juste... vas-y doucement avec le grand gaillard. Il est bien intentionné et il a un cœur de glace... d'or, je veux dire."

# Traduction IA – à relire
#: freddy_fridge/doug_freddy_monster/0/g-2/24 freddy_fridge/doug_freddy_mad/0/c-1/31
msgctxt "Doug"
msgid "Shit I been hanging around that fridge too much with the puns."
msgstr "Merde, j'ai trop traîné avec ce frigo et ses jeux de mots."

# Traduction IA – à relire
#: freddy_fridge/doug_freddy_monster/0/g-2/32 freddy_fridge/doug_freddy_mad/0/c-1/39
msgctxt "Doug"
msgid "Bye."
msgstr "Salut."

# Traduction IA – à relire
#: freddy_fridge/doug_freddy_mad/0/0
msgctxt "Doug"
msgid "Yeah, I get it. I never scream at you, which is my way of showing you that I care."
msgstr "Ouais, je comprends. Je ne te hurle jamais dessus, c'est ma façon de te montrer que je tiens à toi."

# Traduction IA – à relire
#: freddy_fridge/doug_freddy_mad/0/8
msgctxt "Doug"
msgid "Still... seemed like he wasn't himself."
msgstr "Quand même... il n'avait pas l'air d'être lui-même."

# Traduction IA – à relire
#: freddy_fridge/doug_freddy_mad/0/16
msgctxt "Doug"
msgid "I thought you two were getting close."
msgstr "Je croyais que vous vous rapprochiez."

# Traduction IA – à relire
#: freddy_fridge/doug_freddy_mad/0/24/s/0
msgctxt "Choix"
msgid "I don't appreciate being treated that way, monster or not!"
msgstr "Je n'apprécie pas qu'on me traite comme ça, monstre ou pas !"

# Traduction IA – à relire
#: freddy_fridge/doug_freddy_mad/0/25/s/0
msgctxt "Choix"
msgid "You're right. Maybe I can help him."
msgstr "Tu as raison. Peut-être que je peux l'aider."

# Traduction IA – à relire
#: freddy_fridge/doug_freddy_mad/0/c-0/10
msgctxt "Doug"
msgid "Heard."
msgstr "Compris."

# Traduction IA – à relire
#: freddy_fridge/doug_freddy_mad/0/c-0/21
msgctxt "Doug"
msgid "Ah fuuuuuck."
msgstr "Ah putaaain."

# Traduction IA – à relire
#: freddy_fridge/doug_freddy_mad/0/c-0/29
msgctxt "Doug"
msgid "Looks like you screwed that one up."
msgstr "On dirait que t'as foiré ça."

# Traduction IA – à relire
#: freddy_fridge/doug_freddy_mad/0/c-0/45
msgctxt "Doug"
msgid "Peace out."
msgstr "Peace."

# Traduction IA – à relire
#: freddy_fridge/doug_freddy_mad/0/c-1/23
msgctxt "Doug"
msgid "Just... be easy with the big guy. He means well and he has a heart of cold—I mean gold."
msgstr "Juste... vas-y doucement avec le grand gaillard. Il est bien intentionné et il a un cœur de glace... d'or, je veux dire."

# Traduction IA – à relire
#: freddy_fridge/midnight_snack/0/0
msgctxt "Narrator"
msgid "Freddy is deep into a book of some kind when you find him. He looks up at you with a sad expression."
msgstr "Freddy est plongé dans une sorte de livre quand vous le trouvez. Il lève les yeux vers vous avec une expression triste."

# Traduction IA – à relire
#: freddy_fridge/midnight_snack/0/8
msgctxt "Freddy"
msgid "Oh..."
msgstr "Oh..."

# Traduction IA – à relire
#: freddy_fridge/midnight_snack/0/16
msgctxt "Freddy"
msgid "Hey cool kid."
msgstr "Salut cool kid."

# Traduction IA – à relire
#: freddy_fridge/midnight_snack/0/24
msgctxt "Freddy"
msgid "Sorry, I can't talk."
msgstr "Désolé, je ne peux pas parler."

# Traduction IA – à relire
#: freddy_fridge/midnight_snack/0/32
msgctxt "Freddy"
msgid "I'm pretty busy right now."
msgstr "Je suis assez occupé en ce moment."

# Traduction IA – à relire
#: freddy_fridge/midnight_snack/0/40/s/0
msgctxt "Choix"
msgid "What are you doing?"
msgstr "Qu'est-ce que tu fais ?"

# Traduction IA – à relire
#: freddy_fridge/midnight_snack/0/41/s/0
msgctxt "Choix"
msgid "Mind if I join you?"
msgstr "Ça te dérange si je me joins à toi ?"

# Traduction IA – à relire
#: freddy_fridge/midnight_snack/0/g-0/0
msgctxt "Freddy"
msgid "I'm studying up on safe food temps."
msgstr "J'étudie les températures de conservation sans danger."

# Traduction IA – à relire
#: freddy_fridge/midnight_snack/0/g-0/8
msgctxt "Freddy"
msgid "I think that maybe if I could adjust things to be perfect depending on what you give me..."
msgstr "Je me dis que peut-être, si je pouvais tout régler à la perfection selon ce que tu me confies..."

# Traduction IA – à relire
#: freddy_fridge/midnight_snack/0/g-0/16
msgctxt "Freddy"
msgid "Because I have a job. It's a clear job and I love it and I'm good at it."
msgstr "Parce que j'ai un métier. Un métier clair, que j'adore et que je fais bien."

# Traduction IA – à relire
#: freddy_fridge/midnight_snack/0/g-0/24
msgctxt "Freddy"
msgid "At least, I'm supposed to be good at it."
msgstr "Enfin, je suis censé bien le faire."

# Traduction IA – à relire
#: freddy_fridge/midnight_snack/0/g-0/32/s/0
msgctxt "Choix"
msgid "It's not your fault any of that food went bad."
msgstr "Ce n'est pas ta faute si cette nourriture a tourné."

# Traduction IA – à relire
#: freddy_fridge/midnight_snack/0/g-0/33/s/0
msgctxt "Choix"
msgid "I know what it's like to mess up. But you've got to move on."
msgstr "Je sais ce que c'est de se planter. Mais il faut passer à autre chose."

# Traduction IA – à relire
#: freddy_fridge/midnight_snack/0/g-0/c-2/7
msgctxt "Freddy"
msgid "I keep trying to tell myself that but... I'm struggling to believe it."
msgstr "J'essaie de me le répéter mais... j'ai du mal à y croire."

# Traduction IA – à relire
#: freddy_fridge/midnight_snack/0/g-0/c-3/7
msgctxt "Freddy"
msgid "When you mess up, people don't get sick."
msgstr "Quand tu te plantes, les gens ne tombent pas malades."

# Traduction IA – à relire
#: freddy_fridge/midnight_snack/0/g-1/0
msgctxt "Freddy"
msgid "I could have hurt you. Don't you realize that?"
msgstr "J'aurais pu te faire du mal. Tu ne te rends pas compte ?"

# Traduction IA – à relire
#: freddy_fridge/midnight_snack/0/g-1/8
msgctxt "Freddy"
msgid "What I do is important to me. Mostly because it helps to protect you!"
msgstr "Ce que je fais est important pour moi. Surtout parce que ça aide à te protéger !"

# Traduction IA – à relire
#: freddy_fridge/midnight_snack/0/g-1/16/s/0
msgctxt "Choix"
msgid "Awww, that's incredibly sweet of you."
msgstr "Awww, c'est incroyablement adorable."

# Traduction IA – à relire
#: freddy_fridge/midnight_snack/0/g-1/17/s/0
msgctxt "Choix"
msgid "You really are the nicest fridge I've ever met."
msgstr "Tu es vraiment le frigo le plus gentil que j'aie jamais rencontré."

# Traduction IA – à relire
#: freddy_fridge/midnight_snack/0/g-1/c-4/7
msgctxt "Freddy"
msgid "There you go being good about it. You're sweet yourself."
msgstr "Voilà, encore de la gentillesse de ta part. Tu es adorable toi-même."

# Traduction IA – à relire
#: freddy_fridge/midnight_snack/0/g-1/c-5/7
msgctxt "Freddy"
msgid "You really are just too kind, cool kid."
msgstr "C'est vraiment trop gentil de ta part, cool kid."

# Traduction IA – à relire
#: freddy_fridge/midnight_snack/0/g-2/0/s/0
msgctxt "Choix"
msgid "You want to talk about that outburst you had?"
msgstr "Tu veux parler de ton emportement ?"

# Traduction IA – à relire
#: freddy_fridge/midnight_snack/0/g-2/1/s/0
msgctxt "Choix"
msgid "So we can go back to the way things were?"
msgstr "Pour qu'on puisse revenir comme avant ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_friendship_a/0/0
msgctxt "Freddy"
msgid "If it's the old Freddy you want, it's the old Freddy you'll get!"
msgstr "Si c'est le Freddy d'avant que tu veux, tu auras le Freddy d'avant !"

# Traduction IA – à relire
#: freddy_fridge/freddy_friendship_a/0/11
msgctxt "Freddy"
msgid "I promise you that I will be working hard to make sure you are safe!"
msgstr "Je te promets que je ferai tout pour que tu sois en sécurité !"

# Traduction IA – à relire
#: freddy_fridge/freddy_friendship_a/0/19
msgctxt "Freddy"
msgid "You won't get sick on my watch."
msgstr "Tu ne tomberas pas malade sous ma garde."

# Traduction IA – à relire
#: freddy_fridge/freddy_friendship_a/0/27
msgctxt "Freddy"
msgid "And I'll do my best to keep it cool."
msgstr "Et je ferai de mon mieux pour rester cool."

# Traduction IA – à relire
#: freddy_fridge/freddy_friendship_a/0/35/s/0
msgctxt "Choix"
msgid "You do that very well, Freddy."
msgstr "Tu le fais très bien, Freddy."

# Traduction IA – à relire
#: freddy_fridge/freddy_friendship_a/0/c-0/7
msgctxt "Freddy"
msgid "...thanks for talking to me."
msgstr "...merci de m'avoir parlé."

# Traduction IA – à relire
#: freddy_fridge/freddy_friendship_a/0/c-0/15
msgctxt "Freddy"
msgid "I'm going to finish studying."
msgstr "Je vais finir d'étudier."

# Traduction IA – à relire
#: freddy_fridge/freddy_friendship_a/0/c-0/23
msgctxt "Freddy"
msgid "Come back anytime, cool kid."
msgstr "Reviens quand tu veux, cool kid."

# Traduction IA – à relire
#: freddy_fridge/freddy_deep_dive/0/0
msgctxt "Freddy"
msgid "Oh... that..."
msgstr "Oh... ça..."

# Traduction IA – à relire
#: freddy_fridge/freddy_deep_dive/0/8
msgctxt "Freddy"
msgid "You might not guess, but I've, uh..."
msgstr "Tu ne le devineras peut-être pas, mais j'ai, euh..."

# Traduction IA – à relire
#: freddy_fridge/freddy_deep_dive/0/16
msgctxt "Freddy"
msgid "...really struggled with keeping my cool for a lot of my existence."
msgstr "...vraiment eu du mal à garder mon sang-froid pendant une grande partie de mon existence."

# Traduction IA – à relire
#: freddy_fridge/freddy_deep_dive/0/24
msgctxt "Freddy"
msgid "I've been told it's just 'the monster in me,' but I don't believe that."
msgstr "On m'a dit que c'était juste « le monstre en moi », mais je n'y crois pas."

# Traduction IA – à relire
#: freddy_fridge/freddy_deep_dive/0/32
msgctxt "Freddy"
msgid "I know that I'm big, and strong, and that my teeth can be intimidating."
msgstr "Je sais que je suis grand, fort, et que mes dents peuvent être intimidantes."

# Traduction IA – à relire
#: freddy_fridge/freddy_deep_dive/0/40
msgctxt "Freddy"
msgid "But I never wanted to be defined by those things."
msgstr "Mais je n'ai jamais voulu qu'on me définisse par ça."

# Traduction IA – à relire
#: freddy_fridge/freddy_deep_dive/0/48/s/0
msgctxt "Choix"
msgid "Is that why you crack jokes?"
msgstr "C'est pour ça que tu fais des blagues ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_deep_dive/0/49/s/0
msgctxt "Choix"
msgid "So the happy demeanor is a coverup?"
msgstr "Donc la bonne humeur, c'est une façade ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_deep_dive/0/g-0/0
msgctxt "Freddy"
msgid "Exactly. You cracked the code, cool kid."
msgstr "Exactement. Tu as percé le code, cool kid."

# Traduction IA – à relire
#: freddy_fridge/freddy_deep_dive/0/g-0/8
msgctxt "Freddy"
msgid "I make it a point to stay happy and keep things as cool as I can."
msgstr "Je m'efforce de rester joyeux et de garder les choses aussi cool que possible."

# Traduction IA – à relire
#: freddy_fridge/freddy_deep_dive/0/g-0/16
msgctxt "Freddy"
msgid "That doesn't always work out, obviously."
msgstr "Évidemment, ça ne marche pas toujours."

# Traduction IA – à relire
#: freddy_fridge/freddy_deep_dive/0/g-0/24/s/0
msgctxt "Choix"
msgid "When was the last time you were that mad? If you don't mind sharing."
msgstr "C'était quand, la dernière fois que tu t'es mis dans une colère pareille ? Si ça ne te dérange pas de partager."

# Traduction IA – à relire
#: freddy_fridge/freddy_deep_dive/0/g-0/25/s/0
msgctxt "Choix"
msgid "I'll admit, it was pretty scary."
msgstr "Je l'avoue, c'était assez effrayant."

# Traduction IA – à relire
#: freddy_fridge/freddy_deep_dive/0/g-0/c-3/7
msgctxt "Freddy"
msgid "Yeah, I'm sorry about that."
msgstr "Ouais, je suis désolé pour ça."

# Traduction IA – à relire
#: freddy_fridge/freddy_deep_dive/0/g-0/c-3/15
msgctxt "Freddy"
msgid "I've felt bad ever since it happened."
msgstr "Je m'en veux depuis que c'est arrivé."

# Traduction IA – à relire
#: freddy_fridge/freddy_deep_dive/0/g-0/c-3/23
msgctxt "Freddy"
msgid "I thought that I had scared you off for good."
msgstr "Je pensais t'avoir fait fuir pour de bon."

# Traduction IA – à relire
#: freddy_fridge/freddy_deep_dive/0/g-0/c-3/31
msgctxt "Freddy"
msgid "But here you are! Working to make me feel better after I did a crappy thing to you."
msgstr "Mais te voilà ! À essayer de me remonter le moral après ce que je t'ai fait de nul."

# Traduction IA – à relire
#: freddy_fridge/freddy_deep_dive/0/g-0/c-3/39
msgctxt "Freddy"
msgid "I don't really like who I become when I'm angry. I just want to be fun Freddy! That's my favorite Freddy!"
msgstr "Je n'aime pas trop celui que je deviens quand je suis en colère. Je veux juste être le Freddy rigolo ! C'est mon Freddy préféré !"

# Traduction IA – à relire
#: freddy_fridge/freddy_deep_dive/0/g-0/c-3/47/0/s/0
msgctxt "Choix"
msgid "That's my favorite Freddy, too!"
msgstr "C'est aussi mon Freddy préféré !"

# Traduction IA – à relire
#: freddy_fridge/freddy_deep_dive/0/g-0/c-3/47/1/s/0
msgctxt "Choix"
msgid "You can be more than that around me."
msgstr "Tu peux être bien plus que ça avec moi."

# Traduction IA – à relire
#: freddy_fridge/freddy_deep_dive/0/g-0/c-3/47/c-0/7
msgctxt "Freddy"
msgid "I'll bring him back. I promise."
msgstr "Je le ramènerai. Promis."

# Traduction IA – à relire
#: freddy_fridge/freddy_deep_dive/0/g-0/c-3/47/c-1/13
msgctxt "Freddy"
msgid "And that's why YOU are soooo coool!"
msgstr "Et c'est pour ça que TU es tellement coool !"

# Traduction IA – à relire
#: freddy_fridge/freddy_deep_dive/0/g-0/c-3/47/c-1/21
msgctxt "Freddy"
msgid "I can't promise you I'll do a whole lot of sharing of myself."
msgstr "Je ne peux pas te promettre que je vais beaucoup me confier."

# Traduction IA – à relire
#: freddy_fridge/freddy_deep_dive/0/g-0/c-3/47/c-1/29
msgctxt "Freddy"
msgid "I'm not really practiced in that."
msgstr "Je n'ai pas vraiment l'habitude."

# Traduction IA – à relire
#: freddy_fridge/freddy_deep_dive/0/g-0/c-3/47/c-1/37
msgctxt "Freddy"
msgid "But, I won't shut you out. These doors will always be open when you reach for them!"
msgstr "Mais je ne te fermerai pas ma porte. Ces portes seront toujours ouvertes quand tu tendras la main vers elles !"

# Traduction IA – à relire
#: freddy_fridge/freddy_friendship_b/0
msgctxt "Freddy"
msgid "It means a lot to me that you took the time to hear me out."
msgstr "Ça compte beaucoup pour moi que tu aies pris le temps de m'écouter."

# Traduction IA – à relire
#: freddy_fridge/freddy_friendship_b/8
msgctxt "Freddy"
msgid "Not many people would have come back after what I did."
msgstr "Peu de gens seraient revenus après ce que j'ai fait."

# Traduction IA – à relire
#: freddy_fridge/freddy_friendship_b/16
msgctxt "Freddy"
msgid "You've made yourself a friend for life!"
msgstr "Tu t'es fait un ami pour la vie !"

# Traduction IA – à relire
#: freddy_fridge/freddy_friendship_b/24
msgctxt "Freddy"
msgid "It's late... you should get some sleep. I should too, actually."
msgstr "Il est tard... tu devrais dormir un peu. Moi aussi, d'ailleurs."

# Traduction IA – à relire
#: freddy_fridge/freddy_friendship_b/32
msgctxt "Freddy"
msgid "I'll see you around, cool kid! Thanks for being awesome!"
msgstr "À plus tard, cool kid ! Merci d'être génial !"

# Traduction IA – à relire
#: freddy_fridge/freddy_love_a/0/0
msgctxt "Freddy"
msgid "You know what... you're the type of human that I've needed by my side."
msgstr "Tu sais quoi... tu es le genre d'humain dont j'avais besoin à mes côtés."

# Traduction IA – à relire
#: freddy_fridge/freddy_love_a/0/8
msgctxt "Freddy"
msgid "You're understanding, kind, super duper... duper cool..."
msgstr "Tu sais écouter, tu as bon cœur, tu es super duper... duper cool..."

# Traduction IA – à relire
#: freddy_fridge/freddy_love_a/0/16
msgctxt "Freddy"
msgid "And you love food as much as I do."
msgstr "Et tu aimes la nourriture autant que moi."

# Traduction IA – à relire
#: freddy_fridge/freddy_love_a/0/24
msgctxt "Freddy"
msgid "I'm sorry I got so mad. This Yeti is embarrassed."
msgstr "Je suis désolé de m'être mis dans un tel état. Ce Yéti a honte."

# Traduction IA – à relire
#: freddy_fridge/freddy_love_a/0/32
msgctxt "Freddy"
msgid "I would love to continue to have you in my heart."
msgstr "J'aimerais continuer à te garder dans mon cœur."

# Traduction IA – à relire
#: freddy_fridge/freddy_love_a/0/40
msgctxt "Freddy"
msgid "So, let's keep it real, yeah?"
msgstr "Alors restons vrais, d'accord ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_love_a/0/48/s/0
msgctxt "Choix"
msgid "I'd like that, as friends."
msgstr "Ça me plairait, en tant qu'amis."

# Traduction IA – à relire
#: freddy_fridge/freddy_love_a/0/49/s/0
msgctxt "Choix"
msgid "That sounds nice... as lovers?"
msgstr "Ça me semble bien... en tant qu'amants ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_love_a/0/c-0/7
msgctxt "Freddy"
msgid "Oh you know it!"
msgstr "Oh, tu peux le croire !"

# Traduction IA – à relire
#: freddy_fridge/freddy_love_a/0/c-0/15
msgctxt "Freddy"
msgid "You should get some sleep. I've kept you up late enough."
msgstr "Tu devrais dormir un peu. Je t'ai déjà gardé assez tard."

# Traduction IA – à relire
#: freddy_fridge/freddy_love_a/0/c-0/23
msgctxt "Freddy"
msgid "I'm gonna get some shut-eye myself."
msgstr "Je vais aller piquer un roupillon moi aussi."

# Traduction IA – à relire
#: freddy_fridge/freddy_love_a/0/c-0/31 freddy_fridge/freddy_love_a/0/g-0/51
msgctxt "Freddy"
msgid "I'll see you in my dreams! We'll have ice cream there!"
msgstr "On se retrouve dans mes rêves ! Il y aura de la glace !"

# Traduction IA – à relire
#: freddy_fridge/freddy_love_a/0/c-0/42
msgctxt "Freddy"
msgid "Awwww yeahh!! Ice cream!!"
msgstr "Awwww ouiii !! De la glace !!"

# Traduction IA – à relire
#: freddy_fridge/freddy_love_a/0/g-0/0
msgctxt "Narrator"
msgid "Freddy's expression is entirely blank—this was not the answer you were expecting. Did you get it wrong? Is he upset with you?"
msgstr "L'expression de Freddy est complètement vide : ce n'était pas la réponse que vous attendiez. Avez-vous répondu de travers ? Est-il fâché contre vous ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_love_a/0/g-0/16
msgctxt "Narrator"
msgid "And then he's laughing, grabbing your shoulder with one of his massive hands."
msgstr "Puis il éclate de rire et vous agrippe l'épaule d'une de ses énormes mains."

# Traduction IA – à relire
#: freddy_fridge/freddy_love_a/0/g-0/27
msgctxt "Freddy"
msgid "You know it cool kid!!"
msgstr "Tu l'as dit, cool kid !!"

# Traduction IA – à relire
#: freddy_fridge/freddy_love_a/0/g-0/35
msgctxt "Freddy"
msgid "Oh, you should get some sleep. I've kept you up late enough."
msgstr "Oh, tu devrais dormir un peu. Je t'ai déjà gardé assez tard."

# Traduction IA – à relire
#: freddy_fridge/freddy_love_a/0/g-0/43
msgctxt "Freddy"
msgid "I'm gonna get some shut eye myself."
msgstr "Je vais aller piquer un roupillon moi aussi."

# Traduction IA – à relire
#: freddy_fridge/freddy_love_a/0/g-0/62
msgctxt "Freddy"
msgid "Awwww yeahh!! Ice cream! Together."
msgstr "Awwww ouiii !! De la glace ! Ensemble."

# Traduction IA – à relire
#: freddy_fridge/freddy_anger_story/0/6
msgctxt "Freddy"
msgid "You know... it's been so long since anyone asked me about my past..."
msgstr "Tu sais... ça fait si longtemps que personne ne m'a interrogé sur mon passé..."

# Traduction IA – à relire
#: freddy_fridge/freddy_anger_story/0/14
msgctxt "Freddy"
msgid "It was when I was just coming off the factory floor. You might think I'm this fantastic fridge, but I'm actually the smallest model of my line."
msgstr "C'était à ma sortie d'usine. Tu penses peut-être que je suis ce frigo fantastique, mais je suis en fait le plus petit modèle de ma gamme."

# Traduction IA – à relire
#: freddy_fridge/freddy_anger_story/0/22/s/0
msgctxt "Choix"
msgid "The smallest?"
msgstr "Le plus petit ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_anger_story/0/23/s/0
msgctxt "Choix"
msgid "But you're huge!"
msgstr "Mais tu es énorme !"

# Traduction IA – à relire
#: freddy_fridge/freddy_anger_story/0/c-0/7
msgctxt "Freddy"
msgid "Yeah."
msgstr "Ouais."

# Traduction IA – à relire
#: freddy_fridge/freddy_anger_story/0/c-1/7
msgctxt "Freddy"
msgid "Thanks, but..."
msgstr "Merci, mais..."

# Traduction IA – à relire
#: freddy_fridge/freddy_anger_story/0/g-0/0
msgctxt "Freddy"
msgid "I'm the runt of the litter."
msgstr "Je suis le dernier de la portée."

# Traduction IA – à relire
#: freddy_fridge/freddy_anger_story/0/g-0/8
msgctxt "Freddy"
msgid "The Yeti family was made to run big! But I got teased by my siblings for my size."
msgstr "La famille Yéti est faite pour voir grand ! Mais mes frères et sœurs se moquaient de ma taille."

# Traduction IA – à relire
#: freddy_fridge/freddy_anger_story/0/g-0/16
msgctxt "Freddy"
msgid "They told me that I'd fail in no time. That I was made to fail."
msgstr "Ils me disaient que j'échouerais en un rien de temps. Que j'étais fait pour échouer."

# Traduction IA – à relire
#: freddy_fridge/freddy_anger_story/0/g-0/24
msgctxt "Freddy"
msgid "At first, I let it slide down my back. I knew what I was capable of."
msgstr "Au début, ça me glissait dessus. Je savais de quoi j'étais capable."

# Traduction IA – à relire
#: freddy_fridge/freddy_anger_story/0/g-0/32
msgctxt "Freddy"
msgid "Through testing, I did everything I could. I made ALL the ice I could make."
msgstr "Aux tests, j'ai fait tout ce que je pouvais. J'ai fait TOUTE la glace que je pouvais faire."

# Traduction IA – à relire
#: freddy_fridge/freddy_anger_story/0/g-0/40
msgctxt "Freddy"
msgid "Temp control? Steady. Smart Screen? Crystal clear."
msgstr "Contrôle de la température ? Stable. Écran intelligent ? Limpide."

# Traduction IA – à relire
#: freddy_fridge/freddy_anger_story/0/g-0/48
msgctxt "Freddy"
msgid "By all official measurements, I was a top of the line Yeti!"
msgstr "Selon toutes les mesures officielles, j'étais un Yéti haut de gamme !"

# Traduction IA – à relire
#: freddy_fridge/freddy_anger_story/0/g-0/56
msgctxt "Freddy"
msgid "Those things didn't matter. Every day I would get teased. They would call me names and one day... I just had it."
msgstr "Rien de tout ça n'avait d'importance. Chaque jour, on se moquait de moi. On me donnait des noms d'oiseaux et un jour... j'en ai eu assez."

# Traduction IA – à relire
#: freddy_fridge/freddy_anger_story/0/g-0/64
msgctxt "Freddy"
msgid "I got so mad, I blew a cooling line."
msgstr "Je me suis tellement énervé que j'ai fait exploser un circuit de refroidissement."

# Traduction IA – à relire
#: freddy_fridge/freddy_anger_story/0/g-0/72
msgctxt "Freddy"
msgid "They called me defective after that."
msgstr "Après ça, ils m'ont déclaré défectueux."

# Traduction IA – à relire
#: freddy_fridge/freddy_anger_story/0/g-0/80/s/0
msgctxt "Choix"
msgid "Oh no! I'm so sorry."
msgstr "Oh non ! Je suis vraiment désolé."

# Traduction IA – à relire
#: freddy_fridge/freddy_anger_story/0/g-0/81/s/0
msgctxt "Choix"
msgid "Everyone has their limits."
msgstr "Tout le monde a ses limites."

# Traduction IA – à relire
#: freddy_fridge/freddy_anger_story/0/g-0/c-2/7
msgctxt "Freddy"
msgid "Ah it's all right."
msgstr "Ah, c'est bon."

# Traduction IA – à relire
#: freddy_fridge/freddy_anger_story/0/g-0/c-3/7
msgctxt "Freddy"
msgid "You're tellin' me."
msgstr "À qui le dis-tu."

# Traduction IA – à relire
#: freddy_fridge/freddy_anger_story/0/g-1/0
msgctxt "Freddy"
msgid "I'm lucky that I was able to get repaired."
msgstr "J'ai de la chance d'avoir pu être réparé."

# Traduction IA – à relire
#: freddy_fridge/freddy_anger_story/0/g-1/8
msgctxt "Freddy"
msgid "I thought for sure I was going to be made into scrap."
msgstr "J'étais certain qu'on allait me mettre à la casse."

# Traduction IA – à relire
#: freddy_fridge/freddy_anger_story/0/g-1/16
msgctxt "Freddy"
msgid "So when the food went bad and I felt like I couldn't do my job...."
msgstr "Alors quand la nourriture a tourné et que j'ai senti que je ne pouvais plus faire mon travail..."

# Traduction IA – à relire
#: freddy_fridge/freddy_anger_story/0/g-1/24
msgctxt "Freddy"
msgid "I broke."
msgstr "J'ai craqué."

# Traduction IA – à relire
#: freddy_fridge/freddy_anger_story/0/g-1/32
msgctxt "Freddy"
msgid "It took me back to that... place."
msgstr "Ça m'a ramené à cet... endroit."

# Traduction IA – à relire
#: freddy_fridge/freddy_anger_story/0/g-1/40
msgctxt "Freddy"
msgid "I lost my chill, cool kid. And I'm sorry that you had to see it."
msgstr "J'ai perdu mon sang-froid, cool kid. Et je suis désolé que tu aies dû voir ça."

# Traduction IA – à relire
#: freddy_fridge/freddy_anger_story/0/g-1/48
msgctxt "Freddy"
msgid "But, that's a part of me, too. It's something I work to control and... I don't like most people to experience it."
msgstr "Mais ça fait aussi partie de moi. C'est quelque chose que je travaille à maîtriser et... je n'aime pas que la plupart des gens y assistent."

# Traduction IA – à relire
#: freddy_fridge/freddy_anger_story/0/g-1/56
msgctxt "Freddy"
msgid "My anger wasn't pointed at you. I promise."
msgstr "Ma colère n'était pas dirigée contre toi. Je te le promets."

# Traduction IA – à relire
#: freddy_fridge/freddy_anger_story/0/g-1/64/s/0
msgctxt "Choix"
msgid "Thank you for trusting me with that story."
msgstr "Merci de m'avoir confié cette histoire."

# Traduction IA – à relire
#: freddy_fridge/freddy_anger_story/0/g-1/65/s/0
msgctxt "Choix"
msgid "You just shared a lot. I'm really proud of you!"
msgstr "Tu viens de te livrer énormément. Je suis vraiment fier de toi !"

# Traduction IA – à relire
#: freddy_fridge/freddy_anger_story/0/g-1/c-4/7
msgctxt "Freddy"
msgid "Heh. Nobody knows it but you."
msgstr "Heh. Personne ne le sait à part toi."

# Traduction IA – à relire
#: freddy_fridge/freddy_anger_story/0/g-2/0
msgctxt "Freddy"
msgid "You know what? It feels great to open up like this a little."
msgstr "Tu sais quoi ? Ça fait un bien fou de s'ouvrir un peu comme ça."

# Traduction IA – à relire
#: freddy_fridge/freddy_anger_story/0/g-2/8
msgctxt "Freddy"
msgid "It's a part of me I've tried to hide for so long."
msgstr "C'est une partie de moi que j'essaie de cacher depuis si longtemps."

# Traduction IA – à relire
#: freddy_fridge/freddy_anger_story/0/g-2/16
msgctxt "Freddy"
msgid "But to be seen and still have you come back? Huh."
msgstr "Mais être vu tel que je suis et que tu reviennes quand même ? Huh."

# Traduction IA – à relire
#: freddy_fridge/freddy_anger_story/0/g-2/24
msgctxt "Freddy"
msgid "That means a lot, cool kid."
msgstr "Ça compte beaucoup, cool kid."

# Traduction IA – à relire
#: freddy_fridge/freddy_friend_return/0/0
msgctxt "Freddy"
msgid "Cool kid in the HOUSE!"
msgstr "Le cool kid est dans la PLACE !"

# Traduction IA – à relire
#: freddy_fridge/freddy_friend_return/0/8
msgctxt "Freddy"
msgid "I mean, you never really leave but..."
msgstr "Enfin, tu ne pars jamais vraiment, mais..."

# Traduction IA – à relire
#: freddy_fridge/freddy_friend_return/0/16
msgctxt "Freddy"
msgid "You get the point."
msgstr "Tu vois l'idée."

# Traduction IA – à relire
#: freddy_fridge/freddy_friend_return/0/24
msgctxt "Freddy"
msgid "Let's chow down sometime soon!"
msgstr "Mangeons ensemble bientôt !"

# Traduction IA – à relire
#: freddy_fridge/freddy_friend_return/0/32/s/0
msgctxt "Choix"
msgid "I'll grab a meal with you anytime!"
msgstr "Je partagerai un repas avec toi quand tu veux !"

# Traduction IA – à relire
#: freddy_fridge/freddy_friend_return/0/33/s/0
msgctxt "Choix"
msgid "Let's sit at the table and eat after you are Realized!"
msgstr "Mettons-nous à table et mangeons après ta Réalisation !"

# Traduction IA – à relire
#: freddy_fridge/freddy_friend_return/0/c-0/7
msgctxt "Freddy"
msgid "See, I knew you were cool!"
msgstr "Tu vois, je savais que tu étais cool !"

# Traduction IA – à relire
#: freddy_fridge/freddy_friend_return/0/c-0/15
msgctxt "Narrator"
msgid "Using the most surprising combination of leftovers and pizzazz - you and Freddy enjoy a meal fit for a king."
msgstr "Grâce à la plus surprenante combinaison de restes et de panache, vous et Freddy dégustez un repas digne d'un roi."

# Traduction IA – à relire
#: freddy_fridge/freddy_love_return/0/0
msgctxt "Freddy"
msgid "Well, if it isn't the coolest kid this side of the polar ice caps!"
msgstr "Tiens, mais voilà le cool kid le plus cool de ce côté des calottes polaires !"

# Traduction IA – à relire
#: freddy_fridge/freddy_love_return/0/8
msgctxt "Freddy"
msgid "What have you been up to?"
msgstr "Qu'as-tu fabriqué ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_love_return/0/16
msgctxt "Freddy"
msgid "Whatever it is, I bet it is as awesome as you."
msgstr "Quoi que ce soit, je parie que c'est aussi génial que toi."

# Traduction IA – à relire
#: freddy_fridge/freddy_love_return/0/24/s/0
msgctxt "Choix"
msgid "Thanks Freddy! You might be cool, but my love for you is HOT!"
msgstr "Merci Freddy ! Tu es peut-être cool, mais mon amour pour toi est BRÛLANT !"

# Traduction IA – à relire
#: freddy_fridge/freddy_love_return/0/25/s/0
msgctxt "Choix"
msgid "You deserve to be Realized!"
msgstr "Tu mérites d'être Réalisé !"

# Traduction IA – à relire
#: freddy_fridge/freddy_love_return/0/c-0/7
msgctxt "Freddy"
msgid "Oh-ho-ho-ho! You're making this Yeti blush!"
msgstr "Oh-ho-ho-ho ! Tu fais rougir ce Yéti !"

# Traduction IA – à relire
#: freddy_fridge/freddy_love_return/0/c-0/18
msgctxt "Narrator"
msgid "Blush or no, this Yeti does know how to love."
msgstr "Qu'il rougisse ou non, ce Yéti sait aimer."

# Traduction IA – à relire
#: freddy_fridge/freddy_hate_return/0/0
msgctxt "Freddy"
msgid "Why are you here? Aren't you worried I'll just FREAK OUT again?"
msgstr "Pourquoi es-tu là ? Tu n'as pas peur que je PÈTE ENCORE UN CÂBLE ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_hate_return/0/8/s/0
msgctxt "Choix"
msgid "Just wanted to see what was going on."
msgstr "Je voulais juste voir ce qui se passait."

# Traduction IA – à relire
#: freddy_fridge/freddy_hate_return/0/9/s/0
msgctxt "Choix"
msgid "You know... I’m not the cool kid here. You are. (USE CHARM CANDY)"
msgstr "Tu sais... le cool kid ici, ce n'est pas moi. C'est toi. (UTILISER UN BONBON DE CHARME)"

# Traduction IA – à relire
#: freddy_fridge/freddy_hate_return/0/c-0/7
msgctxt "Freddy"
msgid "I don't wanna hang out with you."
msgstr "Je n'ai pas envie de traîner avec toi."

# Traduction IA – à relire
#: freddy_fridge/freddy_hate_return/0/c-0/15
msgctxt "Freddy"
msgid "It's the only way I'll keep my cool."
msgstr "C'est la seule façon de garder mon sang-froid."

# Traduction IA – à relire
#: freddy_fridge/freddy_hate_return/0/c-1/13
msgctxt "Freddy"
msgid "Hm..."
msgstr "Hm..."

# Traduction IA – à relire
#: freddy_fridge/freddy_hate_return/0/c-1/21
msgctxt "Freddy"
msgid "You’re just saying that."
msgstr "Tu dis ça comme ça."

# Traduction IA – à relire
#: freddy_fridge/freddy_hate_return/0/c-1/29/0/s/0
msgctxt "Choix"
msgid "It wasn’t cool of me to judge you."
msgstr "Ce n'était pas cool de ma part de te juger."

# Traduction IA – à relire
#: freddy_fridge/freddy_hate_return/0/c-1/29/c-0/7
msgctxt "Freddy"
msgid "It WAS very un-cool."
msgstr "C'ÉTAIT très pas cool."

# Traduction IA – à relire
#: freddy_fridge/freddy_hate_return/0/c-1/29/c-0/15/0/s/0
msgctxt "Choix"
msgid "I’m here to support you. Through all your emotions."
msgstr "Je suis là pour te soutenir. Dans toutes tes émotions."

# Traduction IA – à relire
#: freddy_fridge/freddy_hate_return/0/c-1/29/c-0/15/c-0/7
msgctxt "Freddy"
msgid "...do you really think I’m a monster?"
msgstr "...tu penses vraiment que je suis un monstre ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_hate_return/0/c-1/29/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "Technically, yeah. But, that’s part of what makes you awesome!"
msgstr "Techniquement, oui. Mais ça fait partie de ce qui te rend génial !"

# Traduction IA – à relire
#: freddy_fridge/freddy_hate_return/0/c-1/29/c-0/15/c-0/15/1/s/0
msgctxt "Choix"
msgid "What you are doesn’t matter. You have a kind heart, either way."
msgstr "Ce que tu es n'a pas d'importance. Tu as bon cœur, dans tous les cas."

# Traduction IA – à relire
#: freddy_fridge/freddy_hate_return/0/g-0/0
msgctxt "Freddy"
msgid "Aww... well now I feel all warm and fuzzy."
msgstr "Aww... là, je me sens tout chaud et tout doux."

# Traduction IA – à relire
#: freddy_fridge/freddy_hate_return/0/g-0/11
msgctxt "Freddy"
msgid "That’s gonna be bad for the ice cream."
msgstr "Ça va être mauvais pour la glace."

# Traduction IA – à relire
#: freddy_fridge/freddy_hate_return/0/g-0/19
msgctxt "Freddy"
msgid "Ah hell, I can’t stay mad at you. It’s not in my nature."
msgstr "Ah zut, je n'arrive pas à rester fâché contre toi. Ce n'est pas dans ma nature."

# Traduction IA – à relire
#: freddy_fridge/freddy_hate_return/0/g-0/27
msgctxt "Freddy"
msgid "You and me? We’re chill."
msgstr "Toi et moi ? On est cool."

# Traduction IA – à relire
#: freddy_fridge/freddy_hate_return/0/g-0/35/s/0
msgctxt "Choix"
msgid "Cool, Freddy! That’s cool."
msgstr "Cool, Freddy ! C'est cool."

# Traduction IA – à relire
#: freddy_fridge/freddy_realize_join/0/0
msgctxt "Freddy"
msgid "Do you mean... I'm gonna be Realized!?"
msgstr "Tu veux dire... que je vais être Réalisé !?"

# Traduction IA – à relire
#: freddy_fridge/freddy_realize_join/0/8
msgctxt "Freddy"
msgid "Well, this is better than a Food Fetch two-for-one special!"
msgstr "Eh bien, c'est mieux qu'une offre deux pour un sur Food Fetch !"

# Traduction IA – à relire
#: freddy_fridge/freddy_realize_join/0/19
msgctxt "Freddy"
msgid "Are you ready to do it now?"
msgstr "Tu es partant pour le faire maintenant ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_realize_join/0/36/s/0
msgctxt "Choix"
msgid "You bet!"
msgstr "Tu parles !"

# Traduction IA – à relire
#: freddy_fridge/freddy_realize_join/0/37/s/0
msgctxt "Choix"
msgid "I might have to put that on ice for a moment."
msgstr "Je vais peut-être devoir mettre ça au frais un moment."

# Traduction IA – à relire
#: freddy_fridge/freddy_realize_join/0/c-1/16
msgctxt "Freddy"
msgid "Oh it's all good! I'll be here, just chillin'! Maybe I'll grab a bite while I wait!"
msgstr "Oh, pas de souci ! Je serai là, à me rafraîchir ! Je grignoterai peut-être quelque chose en attendant !"

# Traduction IA – à relire
#: freddy_fridge/freddy_realize_return/0/0
msgctxt "Freddy"
msgid "Cool kid is BACK!"
msgstr "Le cool kid est de RETOUR !"

# Traduction IA – à relire
#: freddy_fridge/freddy_realize_return/0/8
msgctxt "Freddy"
msgid "You got everything you need to Realize me?"
msgstr "Tu as tout ce qu'il faut pour me Réaliser ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_realize_return/0/25/s/0
msgctxt "Choix"
msgid "Nothing to it but to do it!"
msgstr "Il n'y a qu'à le faire !"

# Traduction IA – à relire
#: freddy_fridge/freddy_realize_return/0/26/s/0
msgctxt "Choix"
msgid "You might have to chill for just a bit longer."
msgstr "Tu vas peut-être devoir patienter encore un peu."

# Traduction IA – à relire
#: freddy_fridge/freddy_realize_return/0/c-1/10
msgctxt "Freddy"
msgid "Ah, I'll keep the cool quota until you return!"
msgstr "Ah, je garde le quota de cool jusqu'à ton retour !"

# Traduction IA – à relire
#: freddy_fridge/freddy_realize_begin/3/b/1
msgctxt "Skylar"
msgid "Now, THIS is COOL! What a great first dateable to Realize!"
msgstr "Là, c'est COOL ! Quel super premier datable à Réaliser !"

# Traduction IA – à relire
#: freddy_fridge/freddy_realize_begin/6
msgctxt "Skylar"
msgid "Let's turn this beast into a real monster!"
msgstr "Transformons cette bête en vrai monstre !"

# Traduction IA – à relire
#: freddy_fridge/freddy_realize_begin/17
msgctxt "Narrator"
msgid "The spectral energy flows through your dateviators, and what was once merely a fridge becomes...."
msgstr "L'énergie spectrale traverse vos Dateviators, et ce qui n'était qu'un simple frigo devient..."

# Traduction IA – à relire
#: freddy_fridge/freddy_realized/0/0
msgctxt "Narrator"
msgid "Freddy towers over you at his full height—you might have thought Realizing him would make him human, but now he's a greater, more majestic version of his yeti self."
msgstr "Freddy se dresse de toute sa hauteur devant vous. Vous pensiez peut-être que le Réaliser le rendrait humain, mais il est désormais une version plus grande et plus majestueuse de son moi de yéti."

# Traduction IA – à relire
#: freddy_fridge/freddy_realized/0/8
msgctxt "Freddy"
msgid "Move over Bigfoot. FREDDY IS HERE! Ha ha!"
msgstr "Pousse-toi, Bigfoot. FREDDY EST LÀ ! Ha ha !"

# Traduction IA – à relire
#: freddy_fridge/freddy_realized/0/19
msgctxt "Freddy"
msgid "And I look pretty great, if I do say so myself!"
msgstr "Et je suis plutôt superbe, si je puis me permettre !"

# Traduction IA – à relire
#: freddy_fridge/freddy_realized/0/27/s/0
msgctxt "Choix"
msgid "Yeti power! Gimme five!"
msgstr "Yeti power ! Tope là !"

# Traduction IA – à relire
#: freddy_fridge/freddy_realized/0/28/s/0
msgctxt "Choix"
msgid "You look incredible. I'll just go put a blanket on the bed... for all the fur..."
msgstr "Tu es incroyable. Je vais juste aller mettre une couverture sur le lit... à cause de tous les poils..."

# Traduction IA – à relire
#: freddy_fridge/freddy_realized/0/c-0/7
msgctxt "Freddy"
msgid "Yeti Power indeed!"
msgstr "Yeti Power, en effet !"

# Traduction IA – à relire
#: freddy_fridge/freddy_realized/0/c-0/15
msgctxt "Freddy"
msgid "No offense cool kid, but you probably couldn't handle a high five from me."
msgstr "Sans vouloir te vexer, cool kid, tu ne supporterais probablement pas un high five de ma part."

# Traduction IA – à relire
#: freddy_fridge/freddy_realized/0/c-0/23
msgctxt "Freddy"
msgid "But you could definitely get a big hug!!"
msgstr "Mais tu pourrais carrément avoir un gros câlin !!"

# Traduction IA – à relire
#: freddy_fridge/freddy_realized/0/c-0/31
msgctxt "Narrator"
msgid "It was somewhere between a nice fuzzy blanket and total suffocation."
msgstr "C'était quelque part entre une agréable couverture duveteuse et l'asphyxie totale."

# Traduction IA – à relire
#: freddy_fridge/freddy_realized/0/c-0/39
msgctxt "Freddy"
msgid "Huh. It's really warm in here, isn't it?"
msgstr "Huh. Il fait vraiment chaud ici, non ?"

# Traduction IA – à relire
#: freddy_fridge/freddy_realized/0/c-1/7
msgctxt "Freddy"
msgid "Whoah..."
msgstr "Waouh..."

# Traduction IA – à relire
#: freddy_fridge/freddy_realized/0/c-1/15
msgctxt "Freddy"
msgid "You're so smart!"
msgstr "Quelle intelligence !"

# Traduction IA – à relire
#: freddy_fridge/freddy_realized/0/c-1/23
msgctxt "Narrator"
msgid "Freddy looks at you like he means to devour you whole. He snatches you up into his strong embrace."
msgstr "Freddy vous regarde comme s'il comptait vous dévorer tout entier. Il vous attrape et vous serre dans sa puissante étreinte."

# Traduction IA – à relire
#: freddy_fridge/freddy_realized/0/c-1/31
msgctxt "Freddy"
msgid "Arroooooooo!!! Let's get to it!"
msgstr "Arroooooooo !!! Passons à l'action !"

# Traduction IA – à relire
#: freddy_fridge/freddy_realized/0/c-1/42/0/s/0
msgctxt "Choix"
msgid "You know it, big boy!"
msgstr "Tu l'as dit, gros costaud !"

# Traduction IA – à relire
#: freddy_fridge/freddy_realize_love_path/0
msgctxt "Narrator"
msgid "You and Freddy do things that tabloids could only dream about..."
msgstr "Vous et Freddy faites des choses dont les tabloïds ne pourraient que rêver..."

# Traduction IA – à relire
#: freddy_fridge/freddy_realize_love_path/8
msgctxt "Narrator"
msgid "And the imaginings of a great many splendid artists online as well."
msgstr "Et les fantasmes d'un grand nombre d'artistes splendides en ligne aussi."

# Traduction IA – à relire
#: freddy_fridge/freddy_realize_love_path/16
msgctxt "Freddy"
msgid "Goodness, I didn't know a Yeti could sweat this much!"
msgstr "Bon sang, je ne savais pas qu'un Yéti pouvait autant transpirer !"

# Traduction IA – à relire
#: freddy_fridge/freddy_realize_love_path/27
msgctxt "Narrator"
msgid "Intimidated as you might be by a beast of Freddy's size, your natural stamina kicks in. Your evening provides ammunition for your fantasies for years to come."
msgstr "Aussi intimidé que vous puissiez être par une bête de la taille de Freddy, votre endurance naturelle reprend le dessus. Votre soirée fournira des munitions à vos fantasmes pour des années."

# Traduction IA – à relire
#: freddy_fridge/freddy_realize_friend_join/0
msgctxt "Narrator"
msgid "Shortly after being Realized, Freddy began to notice he was the only monster around."
msgstr "Peu après avoir été Réalisé, Freddy a commencé à remarquer qu'il était le seul monstre dans les parages."

# Traduction IA – à relire
#: freddy_fridge/freddy_realize_friend_join/8
msgctxt "Narrator"
msgid "Armed with curiosity and a desire to find his heritage, he traveled far away in search of answers. And those like him."
msgstr "Armé de curiosité et du désir de retrouver ses origines, il a voyagé loin à la recherche de réponses. Et de ses semblables."

# Traduction IA – à relire
#: freddy_fridge/freddy_realize_friend_join/16
msgctxt "Narrator"
msgid "He ate his way across towns and cities, often in disguise. Even though he used the greatest discretion, he still saw his photo in a few tabloids."
msgstr "Il a mangé sur son passage dans les villes et les villages, souvent déguisé. Malgré la plus grande discrétion, il a quand même vu sa photo dans quelques tabloïds."

# Traduction IA – à relire
#: freddy_fridge/freddy_realize_friend_join/24
msgctxt "Freddy"
msgid "Heh. At least they can never get a clear picture of me... Heh heh heh."
msgstr "Heh. Au moins, ils ne pourront jamais avoir une photo nette de moi... Heh heh heh."

# Traduction IA – à relire
#: freddy_fridge/freddy_realize_friend_join/32
msgctxt "Narrator"
msgid "Once he reached the Salty Mountains, he trekked for days to the summit. The snow and wind were harsh, but he found the frosty hike to be rather pleasant."
msgstr "Une fois arrivé aux Montagnes Salées, il a marché des jours jusqu'au sommet. La neige et le vent étaient rudes, mais il a trouvé la randonnée glaciale plutôt agréable."

# Traduction IA – à relire
#: freddy_fridge/freddy_realize_friend_join/40
msgctxt "Narrator"
msgid "He built a log cabin up there - unpermitted, though the locals knew it would be unwise to ever ask him for one."
msgstr "Il y a construit une cabane en rondins, sans permis, mais les habitants savaient qu'il serait imprudent de lui en demander un."

# Traduction IA – à relire
#: freddy_fridge/freddy_realize_friend_join/48
msgctxt "Narrator"
msgid "Though some say they have seen a Food Fetch delivery truck making many more trips to the Salty Mountains than normal."
msgstr "Certains disent pourtant avoir vu un camion de livraison Food Fetch faire bien plus de trajets que d'habitude vers les Montagnes Salées."

# Traduction IA – à relire
#: freddy_fridge/freddy_hate_joiner/46
msgctxt "Reggie"
msgid "Stay frosty!"
msgstr "Garde la tête froide !"

# Traduction IA – à relire
#: freddy_fridge/freddy_wrong_time/0 freddy_fridge/freddy_wrong_time/8
msgctxt "Freddy"
msgid "GO AWAY"
msgstr "VA-T'EN"

# Traduction IA – à relire
#: freddy_fridge/freddy_wrong_time/16
msgctxt "Freddy"
msgid "LEAVE"
msgstr "LAISSE"

# Traduction IA – à relire
#: freddy_fridge/freddy_wrong_time/24
msgctxt "Freddy"
msgid "ME"
msgstr "-MOI"

# Traduction IA – à relire
#: freddy_fridge/freddy_wrong_time/32
msgctxt "Freddy"
msgid "ALONE!!!"
msgstr "TRANQUILLE !!!"
