# Traduction IA – à relire
#: dorian_door/dorian_realize_join/0/0
msgctxt "Dorian"
msgid "I'm not opposed to it. You have the requirements, I presume?"
msgstr "Je n'y suis pas opposé. Tu as ce qu'il faut, je présume ?"

# Traduction IA – à relire
#: dorian_door/dorian_realize_join/0/17/s/0 dorian_door/dorian_realize_join_front/0/17/s/0 dorian_door/dorian_realize_join_back/0/25/s/0 dorian_door/dorian_realize_join_tiny/0/17/s/0 dorian_door/dorian_realize_join_trap/0/17/s/0
