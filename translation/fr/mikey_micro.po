"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

# Traduction IA – à relire
#: mikey_micro/1
msgctxt "Tag Nom d'objet (MAJUSCULES)"
msgid "MICROTRANSACTION"
msgstr "MICROTRANSACTION"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/6
msgctxt "Narrator"
msgid "An armored warrior of some kind stands before you, a massive sack of loot slung over his shoulder. He greets you cheerfully, something about his smile and tone reminding you of your own customer service voice at work."
msgstr "Un guerrier en armure de je ne sais quel genre se tient devant vous, un énorme sac de butin sur l'épaule. Il vous salue avec entrain, et quelque chose dans son sourire et son ton vous rappelle votre propre voix de service client au travail."

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/14
msgctxt "Mikey"
msgid "Hey there! I'm Michael Transaction!"
msgstr "Salut toi ! Moi c'est Michael Transaction !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/22
msgctxt "Mikey"
msgid "But you can call me... Mikey!"
msgstr "Mais tu peux m'appeler... Mikey !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/33
msgctxt "Mikey"
msgid "Thanks for your purchase of the <w>DATE EVERYTHING LUXURIOUS EDITION!</w>"
msgstr "Merci pour ton achat de l'<w>ÉDITION LUXUEUSE DE DATE EVERYTHING !</w>"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/41
msgctxt "Mikey"
msgid "Your purchase gives you <w>EXCLUSIVE ACCESS</w> to new features never seen in the game before!"
msgstr "Ton achat te donne un <w>ACCÈS EXCLUSIF</w> à des fonctionnalités jamais vues dans le jeu !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/49/s/0
msgctxt "Choix"
msgid "What are the features?"
msgstr "C'est quoi, ces fonctionnalités ?"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/50/s/0
msgctxt "Choix"
msgid "Can I get a refund?"
msgstr "Je peux me faire rembourser ?"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/51/s/0
msgctxt "Choix"
msgid "Microtransactions are evil!"
msgstr "Les microtransactions, c'est le mal !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-0/7
msgctxt "Mikey"
msgid "<w>Exclusive access</w> to the Fantastic Red Shirt!"
msgstr "<w>Accès exclusif</w> à la Fantastique Chemise Rouge !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-0/18
msgctxt "Mikey"
msgid "<w>Exclusive access</w> to the Art Book!"
msgstr "<w>Accès exclusif</w> à l'Art Book !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-0/29
msgctxt "Mikey"
msgid "<w>Exclusive access</w> to the Soundtrack!"
msgstr "<w>Accès exclusif</w> à la bande originale !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-0/40
msgctxt "Mikey"
msgid "<w>Exclusive access</w> to Phone Backgrounds!"
msgstr "<w>Accès exclusif</w> aux fonds d'écran de téléphone !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-0/51
msgctxt "Mikey"
msgid "<w>Exclusive access</w> to Lucinda Lavish!"
msgstr "<w>Accès exclusif</w> à Lucinda Lavish !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-0/62
msgctxt "Mikey"
msgid "And most importantly... <w>Exclusive access</w> to me and my store, baby!"
msgstr "Et surtout... <w>Accès exclusif</w> à moi et à ma boutique, bébé !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-1/7
msgctxt "Narrator"
msgid "Mikey's pleasant smile falters for just a moment."
msgstr "Le sourire aimable de Mikey vacille l'espace d'un instant."

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-1/15
msgctxt "Mikey"
msgid "...yeah?"
msgstr "...ouais ?"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-1/23
msgctxt "Mikey"
msgid "You could."
msgstr "Tu pourrais."

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-1/31
msgctxt "Mikey"
msgid "Please don't."
msgstr "S'il te plaît, non."

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-1/39
msgctxt "Mikey"
msgid "You might just fall in love with me, baby!"
msgstr "Tu pourrais bien craquer pour moi, bébé !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-2/7
msgctxt "Mikey"
msgid "But I'm not!"
msgstr "Mais moi, non !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-2/15
msgctxt "Narrator"
msgid "Despite having no visible eyelashes, Mikey manages to bat his at you all the same."
msgstr "Malgré l'absence de cils visibles, Mikey parvient quand même à les battre dans votre direction."

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-2/23
msgctxt "Mikey"
msgid "I'm cute!"
msgstr "Je suis mignon !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-2/34/0/s/0
msgctxt "Choix"
msgid "You prey upon humanity's worst tendencies."
msgstr "Tu exploites les pires penchants de l'humanité."

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-2/34/1/s/0
msgctxt "Choix"
msgid "You teach gambling to children!"
msgstr "Tu apprends le jeu d'argent à des enfants !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-2/34/2/s/0
msgctxt "Choix"
msgid "You take away profits from game developers!"
msgstr "Tu prives les développeurs de jeux de leurs profits !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-2/34/3/s/0
msgctxt "Choix"
msgid "You're right, you are cute."
msgstr "Tu as raison, tu es mignon."

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-2/34/c-0/7
msgctxt "Mikey"
msgid "So does the candy industry!"
msgstr "L'industrie du bonbon aussi !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-2/34/c-0/15
msgctxt "Mikey"
msgid "Do you hate candy?"
msgstr "Tu détestes les bonbons ?"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-2/34/c-0/23/0/s/0
msgctxt "Choix"
msgid "This is a false equivalence."
msgstr "C'est une fausse équivalence."

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-2/34/c-0/23/1/s/0
msgctxt "Choix"
msgid "Yeah! Candy is evil too!"
msgstr "Ouais ! Les bonbons aussi, c'est le mal !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-2/34/c-0/23/2/s/0
msgctxt "Choix"
msgid "Eh, you're right I guess."
msgstr "Bof, tu n'as pas tort, je suppose."

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-2/34/c-0/23/c-0/7
msgctxt "Mikey"
msgid "Candy is something you pay money and get an unknown reward for!"
msgstr "Un bonbon, c'est quelque chose pour lequel tu paies et dont tu reçois une récompense inconnue !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-2/34/c-0/23/c-0/15
msgctxt "Mikey"
msgid "And if kids get rotten teeth, that's their own fault."
msgstr "Et si les gosses se pourrissent les dents, c'est leur faute."

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-2/34/c-0/23/c-0/23
msgctxt "Mikey"
msgid "They should have better parents!"
msgstr "Ils n'avaient qu'à avoir de meilleurs parents !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-2/34/c-0/23/c-1/7
msgctxt "Mikey"
msgid "Uh, all right."
msgstr "Euh, très bien."

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-2/34/c-0/23/c-1/15
msgctxt "Mikey"
msgid "Guess no candy for you..."
msgstr "Pas de bonbons pour toi, alors..."

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-2/34/c-0/23/c-1/23
msgctxt "Mikey"
msgid "Unless you ever get a sweet tooth... !"
msgstr "Sauf si l'envie de sucré te prend un jour... !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-2/34/c-0/23/c-1/31
msgctxt "Mikey"
msgid "I'll be here by your bedside."
msgstr "Je serai là, à ton chevet."

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-2/34/c-0/23/c-2/7 mikey_micro/mikey_start/0/c-2/34/c-2/15/c-0/16/c-0/7 mikey_micro/mikey_start/0/c-2/34/c-3/7 mikey_micro/seeevil/0/c-0/39/c-1/7
msgctxt "Mikey"
msgid "Yay! Awkwardness averted!"
msgstr "Youpi ! Malaise évité !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-2/34/c-1/7
msgctxt "Mikey"
msgid "It's not gambling if there's no chance of winning any money!"
msgstr "Ce n'est pas du jeu d'argent s'il n'y a aucune chance de gagner de l'argent !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-2/34/c-1/15
msgctxt "Mikey"
msgid "And I bring <w>joy</w> to kids with my thrill of <w>random chance!</w>"
msgstr "Et j'apporte de la <w>joie</w> aux enfants avec mon frisson du <w>hasard !</w>"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-2/34/c-2/7
msgctxt "Mikey"
msgid "I can assure you that the creators of this game get a certain percentage of my profits!"
msgstr "Je peux t'assurer que les créateurs de ce jeu touchent un certain pourcentage de mes profits !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-2/34/c-2/15/0/s/0
msgctxt "Choix"
msgid "What percentage?"
msgstr "Quel pourcentage ?"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-2/34/c-2/15/c-0/7
msgctxt "Mikey"
msgid "I'm not certain."
msgstr "Je ne sais pas trop."

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/c-2/34/c-2/15/c-0/16/0/s/0
msgctxt "Choix"
msgid "Ugh, whatever."
msgstr "Pfff, peu importe."

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/averted/0/s/0
msgctxt "Choix"
msgid "I think I <i>might</i> just fall in love with you..."
msgstr "Je crois que je <i>pourrais</i> bien craquer pour toi..."

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/averted/1/s/0
msgctxt "Choix"
msgid "I think we'll be good friends, Mikey."
msgstr "Je crois qu'on sera de bons amis, Mikey."

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/averted/2/s/0
msgctxt "Choix"
msgid "I'm looking forward to getting you to hate me."
msgstr "J'ai hâte que tu me détestes."

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/averted/c-3/7
msgctxt "Mikey"
msgid "Hey, you wouldn't be the first!"
msgstr "Eh, tu ne serais pas le premier !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/averted/c-3/15
msgctxt "Mikey"
msgid "I mean..."
msgstr "Enfin, je veux dire..."

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/averted/c-3/23
msgctxt "Narrator"
msgid "Mikey hefts his sack of loot onto his other shoulder, shifting uncomfortably."
msgstr "Mikey hisse son sac de butin sur son autre épaule, mal à l'aise."

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/averted/c-3/31
msgctxt "Mikey"
msgid "Stacy and I separated a little while ago... but we were in love, for a time."
msgstr "Stacy et moi, on s'est séparés il y a peu... mais on s'est aimés, un temps."

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/averted/c-3/47
msgctxt "Mikey"
msgid "Ah hell, shouldn't bring that up so soon!"
msgstr "Ah zut, je n'aurais pas dû remuer ça si tôt !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/averted/c-4/7
msgctxt "Mikey"
msgid "Mikey likey!"
msgstr "Mikey kiffe !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/averted/c-5/7
msgctxt "Mikey"
msgid "Mikey no likey!"
msgstr "Mikey kiffe pas !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/explainwhatthisis/0
msgctxt "Mikey"
msgid "Unlocking access to me means that you gain access to the <w>DATE EVERYTHING LOOT BOX!</w>"
msgstr "Me débloquer, c'est accéder à la <w>CAISSE DE BUTIN DE DATE EVERYTHING !</w>"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/explainwhatthisis/11
msgctxt "Mikey"
msgid "Each day you can pull me up to 5 times for my <w>EXTREME BONUS ARMOR!</w>"
msgstr "Chaque jour, tu peux tirer jusqu'à 5 fois sur mon <w>ARMURE BONUS EXTRÊME !</w>"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/explainwhatthisis/19/s/0
msgctxt "Choix"
msgid "Do I need armor in a dating sim?"
msgstr "J'ai besoin d'une armure dans un jeu de drague ?"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/explainwhatthisis/20/s/0
msgctxt "Choix"
msgid "Okay, sure."
msgstr "D'accord, d'accord."

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/explainwhatthisis/21/s/0
msgctxt "Choix"
msgid "Okay, I get it, let's go back to the menu."
msgstr "Bon, j'ai compris, retournons au menu."

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/explainwhatthisis/c-6/7
msgctxt "Mikey"
msgid "This armor is so powerful that it can raise your SPECS stats - meaning that you can blaze past huge portions of this game on your path to 100% completion!"
msgstr "Cette armure est si puissante qu'elle augmente tes stats SPECS, ce qui te permet de filer à toute allure à travers de larges pans du jeu sur la route des 100 % !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/explainwhatthisis/c-6/15/0/s/0
msgctxt "Choix"
msgid "What if I like taking my time?"
msgstr "Et si j'aime prendre mon temps ?"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/explainwhatthisis/c-6/15/1/s/0
msgctxt "Choix"
msgid "Sounds great, I'm in!"
msgstr "Ça me plaît, j'en suis !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/explainwhatthisis/c-6/15/c-0/7
msgctxt "Mikey"
msgid "Then you'll love pulling for my armor regardless - it's fun!"
msgstr "Alors tu adoreras quand même tirer mon armure, c'est amusant !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/explainwhatthisis/c-6/15/c-1/7
msgctxt "Mikey"
msgid "It's a blast, baby!"
msgstr "C'est le pied, bébé !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/explainwhatthisis/c-8/7
msgctxt "Mikey"
msgid "Yokay!"
msgstr "D'kay !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/g-0/7
msgctxt "Mikey"
msgid "You can pull for my Common Boots of True Presence."
msgstr "Tu peux tirer mes Bottes Communes de Vraie Présence."

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/g-0/15
msgctxt "Mikey"
msgid "They have a high chance of being pulled!"
msgstr "Elles ont de grandes chances de sortir !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/g-0/26 mikey_micro/mikey_start/0/g-0/56
msgctxt "Mikey"
msgid "Or..."
msgstr "Ou alors..."

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/g-0/37
msgctxt "Mikey"
msgid "You can pull for my Epic Gauntlets of Stardom!"
msgstr "Tu peux tirer mes Gantelets Épiques de la Célébrité !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/g-0/45
msgctxt "Mikey"
msgid "They have a small chance of being pulled!"
msgstr "Ils ont de petites chances de sortir !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/g-0/67
msgctxt "Mikey"
msgid "You can pull for my Legendary Cuirass of Unwavering Magnetism!!"
msgstr "Tu peux tirer ma Cuirasse Légendaire du Magnétisme Inébranlable !!"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/g-0/81
msgctxt "Mikey"
msgid "This extremely rare piece of cosmetics has a tiny chance of being pulled..."
msgstr "Cet élément cosmétique ultra rare a une infime chance de sortir..."

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/g-0/92
msgctxt "Mikey"
msgid "But it does exist! Trust me... I'm regulated by several gaming boards!"
msgstr "Mais il existe ! Fais-moi confiance... je suis réglementé par plusieurs commissions des jeux !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/g-0/100/s/0
msgctxt "Choix"
msgid "Ooohh... I'm looking forward to getting these!"
msgstr "Ooohh... J'ai hâte de les obtenir !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/g-0/101/s/0
msgctxt "Choix"
msgid "I don't trust you."
msgstr "Je ne te fais pas confiance."

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/g-0/c-10/7
msgctxt "Mikey"
msgid "You don't have to - I'll do all the trusting for both of us!"
msgstr "Pas besoin : je ferai toute la confiance pour nous deux !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/g-1/3
msgctxt "Mikey"
msgid "It costs a mere 8 Brundles for each pull!"
msgstr "Ça ne coûte que 8 Brundles par tirage !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/g-1/11
msgctxt "Mikey"
msgid "Brundles are a special kind of currency that you have <w>EXCLUSIVE ACCESS TO!</w>"
msgstr "Les Brundles sont une monnaie spéciale à laquelle tu as <w>ACCÈS EXCLUSIF !</w>"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/g-1/19/s/0
msgctxt "Choix"
msgid "How do I get Brundles?"
msgstr "Comment j'obtiens des Brundles ?"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/g-1/20/s/0
msgctxt "Choix"
msgid "What do Brundles look like?"
msgstr "À quoi ressemblent les Brundles ?"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/g-1/c-11/7
msgctxt "Mikey"
msgid "Good question!"
msgstr "Bonne question !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/g-1/c-12/7
msgctxt "Mikey"
msgid "I... don't know."
msgstr "Je... ne sais pas."

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/g-1/c-12/15
msgctxt "Mikey"
msgid "But they taste <w>amazing</w>!"
msgstr "Mais ils ont un goût <w>incroyable</w> !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/g-2/0
msgctxt "Mikey"
msgid "In order to get your hands on some Brundles - you have to spend <w>Money</w>!"
msgstr "Pour mettre la main sur des Brundles, il faut dépenser de l'<w>Argent</w> !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/g-2/8
msgctxt "Mikey"
msgid "You get 5 <w>Money</w> per day! Save up for <w>big pulls</w>!"
msgstr "Tu reçois 5 <w>Argent</w> par jour ! Économise pour les <w>gros tirages</w> !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/g-2/16/s/0
msgctxt "Choix"
msgid "How do I get money if I don't have a job?"
msgstr "Comment j'obtiens de l'argent si je n'ai pas de travail ?"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/g-2/17/s/0 mikey_micro/boots_fuse/0/40/s/0
msgctxt "Choix"
msgid "Awesome!"
msgstr "Génial !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/g-2/c-13/7
msgctxt "Mikey"
msgid "Ah you're asking those <w>thinker</w> type questions!"
msgstr "Ah, tu poses des questions de <w>penseur</w> !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/g-2/c-13/15
msgctxt "Mikey"
msgid "I love it - and I always have a <w>great explanation</w>!"
msgstr "J'adore ça, et j'ai toujours une <w>excellente explication</w> !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/g-2/c-13/23/0/s/0
msgctxt "Choix"
msgid "So...?"
msgstr "Alors... ?"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/g-2/c-13/23/c-0/7 mikey_micro/mikey_kids_followup_1/0/kidsmenu1return/8/c-4/7
msgctxt "Mikey"
msgid "Oh!"
msgstr "Oh !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/g-2/c-13/23/c-0/15
msgctxt "Mikey"
msgid "Well!"
msgstr "Eh bien !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/g-2/c-13/23/c-0/23
msgctxt "Mikey"
msgid "You said 'money' with no capitalization. That's totally different from 'Money' with the capitalization!"
msgstr "Tu as dit « argent » sans majuscule. C'est totalement différent d'« Argent » avec une majuscule !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/g-2/c-13/23/c-0/31
msgctxt "Mikey"
msgid "You have very little money."
msgstr "Tu as très peu d'argent."

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/g-2/c-13/23/c-0/39
msgctxt "Mikey"
msgid "But just by being at your home, Valdivian pays out its employees 5 <w>Money</w> per day as a way of saying 'Thank!'"
msgstr "Mais rien qu'en étant chez toi, Valdivian verse 5 <w>Argent</w> par jour à ses employés pour dire « Merki ! »"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/g-2/c-13/23/c-0/47/0/s/0
msgctxt "Choix"
msgid "Do you mean... 'Thanks'?"
msgstr "Tu veux dire... « Merci » ?"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/g-2/c-13/23/c-0/47/1/s/0
msgctxt "Choix"
msgid "Makes perfect sense to me!"
msgstr "Ça me paraît parfaitement logique !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/g-2/c-13/23/c-0/47/c-0/7
msgctxt "Mikey"
msgid "Yeah, that!"
msgstr "Ouais, ça !"

# Traduction IA – à relire
#: mikey_micro/mikey_start/0/g-3/0
msgctxt "Mikey"
msgid "Come by when you've saved up enough <w>Money</w> and pull me, baby!"
msgstr "Reviens quand tu auras assez d'<w>Argent</w> et tire-moi, bébé !"

# Traduction IA – à relire
#: mikey_micro/seeevil/0/0/s/0
msgctxt "Choix"
msgid "See? Evil!"
msgstr "Tu vois ? Le mal !"

# Traduction IA – à relire
#: mikey_micro/seeevil/0/c-0/7
msgctxt "Mikey"
msgid "...I'm not evil."
msgstr "...Je ne suis pas le mal."

# Traduction IA – à relire
#: mikey_micro/seeevil/0/c-0/15
msgctxt "Mikey"
msgid "I'm doing this to support my kids, if you really gotta know."
msgstr "Je fais ça pour faire vivre mes enfants, si tu tiens vraiment à le savoir."

# Traduction IA – à relire
#: mikey_micro/seeevil/0/c-0/23
msgctxt "Mikey"
msgid "Blame it on the economic climate, housing market, whatever you want."
msgstr "Mets ça sur le compte de la conjoncture, du marché immobilier, ce que tu veux."

# Traduction IA – à relire
#: mikey_micro/seeevil/0/c-0/31
msgctxt "Mikey"
msgid "But a transaction's gotta transact to survive out there..."
msgstr "Mais une transaction doit transacter pour survivre, là-dehors..."

# Traduction IA – à relire
#: mikey_micro/seeevil/0/c-0/39/0/s/0
msgctxt "Choix"
msgid "I'd rather you die."
msgstr "Je préférerais que tu meures."

# Traduction IA – à relire
#: mikey_micro/seeevil/0/c-0/39/1/s/0
msgctxt "Choix"
msgid "I guess I see where you're coming from..."
msgstr "Je crois que je comprends ton point de vue..."

# Traduction IA – à relire
#: mikey_micro/seeevil/0/c-0/39/c-0/7
msgctxt "Mikey"
msgid "All right, I've got thick skin."
msgstr "Très bien, j'ai la peau dure."

# Traduction IA – à relire
#: mikey_micro/seeevil/0/c-0/39/c-0/15
msgctxt "Mikey"
msgid "But enough is enough."
msgstr "Mais trop, c'est trop."

# Traduction IA – à relire
#: mikey_micro/seeevil/0/c-0/39/c-0/23
msgctxt "Mikey"
msgid "I'll still let ya pull me, but we're gonna cool it for today."
msgstr "Je te laisserai encore me tirer, mais on va se calmer pour aujourd'hui."

# Traduction IA – à relire
#: mikey_micro/seeevil/0/c-0/39/c-0/31
msgctxt "Mikey"
msgid "Goodbye."
msgstr "Au revoir."

# Traduction IA – à relire
#: mikey_micro/seeevil/0/c-0/39/c-0/70
msgctxt "Reggie"
msgid "I don't get a single Money from all the microtransactions in this game."
msgstr "Je ne touche pas un seul Argent sur toutes les microtransactions de ce jeu."

# Traduction IA – à relire
#: mikey_micro/seeevil/0/c-0/39/c-0/78
msgctxt "Reggie"
msgid "It's bullshit!"
msgstr "C'est de la merde !"

# Traduction IA – à relire
#: mikey_micro/mikey_day_start/0/3
msgctxt "Mikey"
msgid "What would you like to do?"
msgstr "Qu'est-ce que tu veux faire ?"

# Traduction IA – à relire
#: mikey_micro/mikey_day_start/0/11/s/0
msgctxt "Choix"
msgid "Who was that on the phone?"
msgstr "C'était qui, au téléphone ?"

# Traduction IA – à relire
#: mikey_micro/mikey_day_start/0/12/s/0
msgctxt "Choix"
msgid "Was that your wife on the phone?"
msgstr "C'était ta femme, au téléphone ?"

# Traduction IA – à relire
#: mikey_micro/mikey_day_start/0/13/s/0
msgctxt "Choix"
msgid "Is everything okay at work?"
msgstr "Tout va bien au travail ?"

# Traduction IA – à relire
#: mikey_micro/mikey_day_start/0/14/s/0
msgctxt "Choix"
msgid "Pull for armor!"
msgstr "Tirer une armure !"

# Traduction IA – à relire
#: mikey_micro/mikey_day_start/0/15/s/0
msgctxt "Choix"
msgid "Can you open the shop again?"
msgstr "Tu peux rouvrir la boutique ?"

# Traduction IA – à relire
#: mikey_micro/mikey_day_start/0/16/s/0
msgctxt "Choix"
msgid "Can you put your kids on?"
msgstr "Tu peux me passer tes enfants ?"

# Traduction IA – à relire
#: mikey_micro/mikey_day_start/0/17/s/0
msgctxt "Choix"
msgid "Explain what this is..."
msgstr "Explique-moi de quoi il s'agit..."

# Traduction IA – à relire
#: mikey_micro/mikey_day_start/0/18/s/0
msgctxt "Choix"
msgid "Let's go to the Brundle Merchant."
msgstr "Allons voir le Marchand de Brundles."

# Traduction IA – à relire
#: mikey_micro/mikey_day_start/0/19/s/0
msgctxt "Choix"
msgid "Can we try this Realization experiment and get you out of here?"
msgstr "On peut tenter cette expérience de Réalisation et te sortir de là ?"

# Traduction IA – à relire
#: mikey_micro/mikey_day_start/0/20/s/0
msgctxt "Choix"
msgid "Just saying hi!"
msgstr "Je dis juste bonjour !"

# Traduction IA – à relire
#: mikey_micro/mikey_day_start/0/21/s/0
msgctxt "Choix"
msgid "Can we fix our relationship?"
msgstr "On peut arranger notre relation ?"

# Traduction IA – à relire
#: mikey_micro/mikey_day_start/0/c-9/7
msgctxt "Mikey"
msgid "I always love saying hello!"
msgstr "J'adore dire bonjour !"

# Traduction IA – à relire
#: mikey_micro/mikey_day_start/0/c-9/15
msgctxt "Mikey"
msgid "Hello!"
msgstr "Bonjour !"

# Traduction IA – à relire
#: mikey_micro/mikey_day_start/0/c-9/26
msgctxt "Mikey"
msgid "I love saying that!"
msgstr "J'adore dire ça !"

# Traduction IA – à relire
#: mikey_micro/mikey_day_start/0/c-10/7
msgctxt "Mikey"
msgid "Nope!"
msgstr "Non !"

# Traduction IA – à relire
#: mikey_micro/mikey_day_start/0/c-10/18/0/s/0
msgctxt "Choix"
msgid "Okay..."
msgstr "D'accord..."

# Traduction IA – à relire
#: mikey_micro/mikey_day_start/0/c-10/18/1/s/0
msgctxt "Choix"
msgid "What if I used this candy...?"
msgstr "Et si j'utilisais ce bonbon... ?"

# Traduction IA – à relire
#: mikey_micro/mikey_day_start/0/c-10/18/2/s/0
msgctxt "Choix"
msgid "What if I gave you my legendary fused armor?"
msgstr "Et si je te donnais mon armure légendaire fusionnée ?"

# Traduction IA – à relire
#: mikey_micro/mikey_day_start/0/c-10/18/c-1/7
msgctxt "Mikey"
msgid "I'm the 101st character in this game."
msgstr "Je suis le 101e personnage de ce jeu."

# Traduction IA – à relire
#: mikey_micro/mikey_day_start/0/c-10/18/c-1/15
msgctxt "Mikey"
msgid "Meaning that if you used one of those candies on me, it would mess up the balance of the other candies!"
msgstr "Ce qui veut dire que si tu utilisais un de ces bonbons sur moi, ça fausserait l'équilibre des autres bonbons !"

# Traduction IA – à relire
#: mikey_micro/mikey_day_start/0/c-10/18/c-1/23
msgctxt "Mikey"
msgid "The math would be completely thrown off... and the balance, destroyed."
msgstr "Les calculs seraient complètement chamboulés... et l'équilibre, détruit."

# Traduction IA – à relire
#: mikey_micro/mikey_day_start/0/c-10/18/c-1/31
msgctxt "Mikey"
msgid "I love balancing."
msgstr "J'adore l'équilibre."

# Traduction IA – à relire
#: mikey_micro/mikey_day_start/0/c-10/18/c-1/39
msgctxt "Mikey"
msgid "And I still hate you."
msgstr "Et je te déteste toujours."

# Traduction IA – à relire
#: mikey_micro/mikey_day_start/0/c-10/18/c-1/47
msgctxt "Mikey"
msgid "Always will."
msgstr "Pour toujours."

# Traduction IA – à relire
#: mikey_micro/mikey_day_start/0/c-10/18/c-2/7 mikey_micro/mikey_love_ending/0/c-0/37 mikey_micro/mikey_love_ending/0/c-1/15/c-0/37 mikey_micro/mikey_friend_ending/0/32
msgctxt "Mikey"
msgid "Well."
msgstr "Bon."

# Traduction IA – à relire
#: mikey_micro/mikey_day_start/0/c-10/18/c-2/15
msgctxt "Mikey"
msgid "I suppose if you got that, it meant that you pulled me enough to enjoy my company a little bit at the very least..."
msgstr "Je suppose que si tu as obtenu ça, c'est que tu m'as assez tiré pour apprécier un peu ma compagnie, au moins..."

# Traduction IA – à relire
#: mikey_micro/mikey_day_start/0/c-10/18/c-2/31
msgctxt "Mikey"
msgid "Sure."
msgstr "Bon."

# Traduction IA – à relire
#: mikey_micro/mikey_day_start/0/c-10/18/c-2/39
msgctxt "Mikey"
msgid "Friends it is, pally."
msgstr "Va pour l'amitié, pote de tirage."

# Traduction IA – à relire
#: mikey_micro/shop_closed_for_good/0
msgctxt "Mikey"
msgid "Ah sorry..."
msgstr "Ah, pardon..."

# Traduction IA – à relire
#: mikey_micro/shop_closed_for_good/8
msgctxt "Mikey"
msgid "By pulling 100 Legendary Armors I'm getting the feeling that either my balance is off, or somehow some kind of cheating is involved."
msgstr "En tirant 100 Armures Légendaires, j'ai l'impression soit que mon équilibre est faussé, soit qu'il y a de la triche là-dessous."

# Traduction IA – à relire
#: mikey_micro/shop_closed_for_good/16/b/1
msgctxt "Mikey"
msgid "I love you, and I don't want to even <i>think</i> about you doing anything untoward."
msgstr "Je t'aime, et je ne veux même pas <i>penser</i> que tu fasses quoi que ce soit de répréhensible."

# Traduction IA – à relire
#: mikey_micro/shop_closed_for_good/19/b/1 mikey_micro/shop_closed_for_good/22/b/1
msgctxt "Mikey"
msgid "I like you, so I don't want to cast any aspersions."
msgstr "Je t'apprécie, donc je ne veux pas porter de soupçons."

# Traduction IA – à relire
#: mikey_micro/shop_closed_for_good/25/b/1
msgctxt "Mikey"
msgid "Even though I hate you, I don't want to cast any aspersions."
msgstr "Même si je te déteste, je ne veux pas porter de soupçons."

# Traduction IA – à relire
#: mikey_micro/shop_closed_for_good/25/b/9
msgctxt "Mikey"
msgid "Better just to close the shop for now until we get this all figured out."
msgstr "Mieux vaut fermer la boutique le temps d'y voir clair."

# Traduction IA – à relire
#: mikey_micro/pull_me_baby/23
msgctxt "Mikey"
msgid "I'll take those Brundles..."
msgstr "Je prends ces Brundles..."

# Traduction IA – à relire
#: mikey_micro/pull_me_baby/31
msgctxt "Mikey"
msgid "Pull me, baby!"
msgstr "Tire-moi, bébé !"

# Traduction IA – à relire
#: mikey_micro/out_of_dailies/0
msgctxt "Mikey"
msgid "Oh sorry... you've already pulled me five times today!"
msgstr "Oh, désolé... tu m'as déjà tiré cinq fois aujourd'hui !"

# Traduction IA – à relire
#: mikey_micro/out_of_dailies/8
msgctxt "Mikey"
msgid "I always have parental controls turned on. Trust me, it's for your own good."
msgstr "J'active toujours le contrôle parental. Fais-moi confiance, c'est pour ton bien."

# Traduction IA – à relire
#: mikey_micro/out_of_dailies/16
msgctxt "Mikey"
msgid "Don't want you getting addicted to my charms too much, baby!"
msgstr "Je ne veux pas que tu deviennes trop accro à mon charme, bébé !"

# Traduction IA – à relire
#: mikey_micro/out_of_dailies/24
msgctxt "Mikey"
msgid "Come back tomorrow!"
msgstr "Reviens demain !"

# Traduction IA – à relire
#: mikey_micro/brundle_police/0/0
msgctxt "Mikey"
msgid "Oooh... you don't have enough Brundles."
msgstr "Oooh... tu n'as pas assez de Brundles."

# Traduction IA – à relire
#: mikey_micro/brundle_police/0/8
msgctxt "Mikey"
msgid "Would you like to exchange <w>Money</w> for Brundles?"
msgstr "Tu veux échanger de l'<w>Argent</w> contre des Brundles ?"

# Traduction IA – à relire
#: mikey_micro/brundle_police/0/16/s/0
msgctxt "Choix"
msgid "Sure..."
msgstr "Bien sûr..."

# Traduction IA – à relire
#: mikey_micro/brundle_police/0/17/s/0
msgctxt "Choix"
msgid "Absolutely!"
msgstr "Absolument !"

# Traduction IA – à relire
#: mikey_micro/brundle_police/0/18/s/0
msgctxt "Choix"
msgid "No, not now."
msgstr "Non, pas maintenant."

# Traduction IA – à relire
#: mikey_micro/brundle_police/0/c-0/7 mikey_micro/brundle_police/0/c-1/7
msgctxt "Mikey"
msgid "Let's get you over to the Brundle Exchange!"
msgstr "Direction le Bureau de Change des Brundles !"

# Traduction IA – à relire
#: mikey_micro/brundle_police/0/c-2/7
msgctxt "Mikey"
msgid "Your remaining Brundles have been returned!"
msgstr "Tes Brundles restants ont été rendus !"

# Traduction IA – à relire
#: mikey_micro/brundle_police/0/c-2/18
msgctxt "Mikey"
msgid "See you when you have more <w>Money</w>!"
msgstr "À bientôt quand tu auras plus d'<w>Argent</w> !"

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/3/b/1
msgctxt "Narrator"
msgid "Mikey turns around for a moment, and though nothing appears to have changed with him, when he speaks to you it's with an entirely new voice."
msgstr "Mikey se retourne un instant et, bien que rien ne semble avoir changé chez lui, quand il vous parle, c'est avec une voix entièrement nouvelle."

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/6
msgctxt "Mikey"
msgid "Oi, 'ello."
msgstr "Ouais, 'jour."

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/14
msgctxt "Mikey"
msgid "Oim the Brundle merchant."
msgstr "J'suis le marchand d'Brundles."

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/22/0
msgctxt "Mikey"
msgid "Would you loike to exchange cash for Brundles?"
msgstr "Tu veux échanger du cash contre des Brundles ?"

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/22/8/s/0 mikey_micro/mikey_love_ending/0/24/s/0
msgctxt "Choix"
msgid "Yes!"
msgstr "Oui !"

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/22/9/s/0
msgctxt "Choix"
msgid "No."
msgstr "Non."

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/22/10/s/0
msgctxt "Choix"
msgid "How much Money do I have?"
msgstr "J'ai combien d'Argent ?"

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/22/11/s/0
msgctxt "Choix"
msgid "How many Brundles do I have?"
msgstr "J'ai combien de Brundles ?"

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/22/c-0/7
msgctxt "Mikey"
msgid "'ow much? It's 10 Money for 6 Brundles."
msgstr "Combien ? C'est 10 Argent pour 6 Brundles."

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/22/c-0/15/0/s/0
msgctxt "Choix"
msgid "10 Money for 6 Brundles, please."
msgstr "10 Argent pour 6 Brundles, s'il vous plaît."

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/22/c-0/15/1/s/0
msgctxt "Choix"
msgid "20 Money for 12 Brundles, please."
msgstr "20 Argent pour 12 Brundles, s'il vous plaît."

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/22/c-0/15/2/s/0
msgctxt "Choix"
msgid "50 Money for 30 Brundles, please."
msgstr "50 Argent pour 30 Brundles, s'il vous plaît."

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/22/c-0/15/3/s/0
msgctxt "Choix"
msgid "100 Money for 60 Brundles, please."
msgstr "100 Argent pour 60 Brundles, s'il vous plaît."

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/22/c-0/15/c-0/22 mikey_micro/brundle_exchange/0/22/c-0/15/c-1/22 mikey_micro/brundle_exchange/0/22/c-0/15/c-2/22
msgctxt "Narrator"
msgid "Mikey hands you your brundles. They shine appealingly in your hands."
msgstr "Mikey vous tend vos brundles. Ils brillent joliment au creux de vos mains."

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/22/c-0/15/c-0/33
msgctxt "Mikey"
msgid "'Ere you are - 6 Golden Brundles!"
msgstr "Voilà pour toi : 6 Brundles dorés !"

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/22/c-0/15/c-1/33
msgctxt "Mikey"
msgid "Blimey! 'Ere you are then - 12 Golden Brundles!"
msgstr "Bigre ! Tiens, voilà : 12 Brundles dorés !"

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/22/c-0/15/c-2/33
msgctxt "Mikey"
msgid "Cor! 30 Golden Brundles for you - take care not to sneeze or they'll go flyin'!"
msgstr "Mince alors ! 30 Brundles dorés pour toi, évite d'éternuer ou ils vont s'envoler !"

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/22/c-0/15/c-3/29
msgctxt "Mikey"
msgid "Bloody 'ell! I'll 'ave to go to the back of me shop for that amount."
msgstr "Nom d'un chien ! Faut que j'aille au fond d'ma boutique pour une somme pareille."

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/22/c-0/15/c-3/40
msgctxt "Narrator"
msgid "Mikey walks out of sight, talking rather loudly to himself."
msgstr "Mikey disparaît de la vue en parlant plutôt fort tout seul."

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/22/c-0/15/c-3/45 mikey_micro/brundle_exchange/0/22/c-0/15/c-3/110 mikey_micro/brundle_exchange/0/22/c-0/15/c-3/180
msgctxt "Mikey"
msgid "clomp clomp clomp"
msgstr "clomp clomp clomp"

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/22/c-0/15/c-3/50
msgctxt "Mikey"
msgid "Oi! Where's me Brundles?"
msgstr "Hé ! Elle est où, ma réserve de Brundles ?"

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/22/c-0/15/c-3/55
msgctxt "Mikey"
msgid "'ow many do they want then?"
msgstr "Y'en veulent combien, alors ?"

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/22/c-0/15/c-3/65
msgctxt "Mikey"
msgid "Dearie me dearie me!"
msgstr "Mon Dieu, mon Dieu !"

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/22/c-0/15/c-3/70
msgctxt "Mikey"
msgid "We'll be out soon oi fear! It's been a tough winter..."
msgstr "On va bientôt être à sec, j'le crains ! L'hiver a été rude..."

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/22/c-0/15/c-3/75
msgctxt "Mikey"
msgid "Well wot are we to do?"
msgstr "Eh ben, qu'est-ce qu'on va faire ?"

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/22/c-0/15/c-3/80
msgctxt "Mikey"
msgid "Can they not give us a day? Some time at least... some time will get us through this winter's discontent..."
msgstr "Y peuvent pas nous accorder un jour ? Un peu de temps, au moins... un peu de temps nous fera passer cet hiver de nos déboires..."

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/22/c-0/15/c-3/85
msgctxt "Mikey"
msgid "Moi love... if I have to steal for them... I shall."
msgstr "Ma mie... s'il faut voler pour eux... j'volerai."

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/22/c-0/15/c-3/90
msgctxt "Mikey"
msgid "Your thievin' ways! Don't do it, Reginald!"
msgstr "Tes manies de voleur ! Fais pas ça, Reginald !"

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/22/c-0/15/c-3/95
msgctxt "Mikey"
msgid "Oi must!"
msgstr "Faut bien !"

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/22/c-0/15/c-3/100
msgctxt "Mikey"
msgid "Reginald!!"
msgstr "Reginald !!"

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/22/c-0/15/c-3/105
msgctxt "Mikey"
msgid "crash boom"
msgstr "crash boum"

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/22/c-0/15/c-3/115
msgctxt "Mikey"
msgid "Noi! It's the Brumble thief back again!"
msgstr "Non ! C'est encore le voleur d'Brumbles !"

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/22/c-0/15/c-3/120
msgctxt "Mikey"
msgid "'ide your Brumbles!! 'ide them all!"
msgstr "Cachez vos Brumbles !! Cachez-les tous !"

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/22/c-0/15/c-3/125
msgctxt "Mikey"
msgid "OI JUST NEED 60 - that's ALL!"
msgstr "J'EN VEUX JUSTE 60, c'est TOUT !"

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/22/c-0/15/c-3/130
msgctxt "Mikey"
msgid "Stop! By order of Sheriff Tabatha you are to—"
msgstr "Halte ! Au nom du shérif Tabatha, vous êtes—"

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/22/c-0/15/c-3/135
msgctxt "Mikey"
msgid "Euuuuugrrrknn my neck!"
msgstr "Euuuuugrrrknn mon cou !"

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/22/c-0/15/c-3/145
msgctxt "Mikey"
msgid "...it'll 'ave to do..."
msgstr "...Ça f'ra l'affaire..."

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/22/c-0/15/c-3/150
msgctxt "Mikey"
msgid "'e's taken precisely 60 Brumbles from the knight's purse!"
msgstr "Y'a pris exactement 60 Brumbles dans la bourse du chevalier !"

# Traduction IA – à relire
#: mikey_micro/brundle_exchange/0/22/c-0/15/c-3/155
msgctxt "Mikey"
msgid "Let that be a lesson to Tabatha and 'er iron rule!"
msgstr "Que ça serve de leçon à Tabatha et à sa poigne de fer !"

# Traduction IA – à relire
