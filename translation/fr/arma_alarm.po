#: arma_alarm/ArmaDeadEnding/0/c-1/23/c-0/37
msgctxt "Arma"
msgid "<w>BEEEEEEEEEEEEEEEEEEE</w>"
msgstr ""

#: arma_alarm/ArmaDeadEnding/0/c-1/23/c-0/48
msgctxt "Arma"
msgid "<w>EEEEEEEEEEEEEEEEEEEEE</w>"
msgstr ""

#: arma_alarm/ArmaDeadEnding/0/c-1/23/c-0/59
msgctxt "Arma"
msgid "<w>EEEEEEEP!!!!!!</w>"
