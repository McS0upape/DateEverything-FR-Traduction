msgid "I guess that’s true."
msgstr "Je crois que c'est vrai."

# Traduction IA – à relire
#: telly_tv/telly_channels1_reality/0/g-0/c-3/32/c-0/23/c-1/40/1/s/0
msgctxt "Choix"
msgid "But I like Valdiviflix."
msgstr "Mais j'aime bien Valdiviflix."

# Traduction IA – à relire
#: telly_tv/telly_channels1_reality/0/g-0/c-3/32/c-0/23/c-1/40/c-0/13
