#: shadow_darkness/1
msgctxt "Tag Nom d'objet (MAJUSCULES)"
msgid "SHADOW"
msgstr ""

#: shadow_darkness/Shadow_1/0/0
msgctxt "Narrator"
msgid "There's a presence in the room with you, you're sure of it... but you can't make anything out in the darkness. As you search for whoever it might be they address you in somber, funereal tones."
msgstr ""

#: shadow_darkness/Shadow_1/0/5
msgctxt "???"
msgid "<w>As the light fades and dusk draws, all hope becomes despair.</w>"
msgstr ""

#: shadow_darkness/Shadow_1/0/10
msgctxt "???"
msgid "<w>Do you wish to proceed?</w>"
msgstr ""

#: shadow_darkness/Shadow_1/0/15/s/0
msgctxt "Choix"
msgid "Sure."
msgstr ""

#: shadow_darkness/Shadow_1/0/16/s/0
msgctxt "Choix"
msgid "Pass."
msgstr ""

#: shadow_darkness/Shadow_1/0/c-0/7
msgctxt "???"
msgid "<w>Is that so?</w>"
msgstr ""

#: shadow_darkness/Shadow_1/0/c-0/12
msgctxt "???"
msgid "<w>Let regret not fill your heart then.</w>"
msgstr ""

#: shadow_darkness/Shadow_1/0/c-0/17
msgctxt "???"
msgid "<w>Hark!</w>"
msgstr ""

#: shadow_darkness/Shadow_1/0/c-0/22
msgctxt "???"
msgid "<w>For your greatest fears manifest in yours truly!</w>"
msgstr ""

#: shadow_darkness/Shadow_1/0/c-1/7
msgctxt "???"
msgid "<w>Very well then.</w>"
msgstr ""

#: shadow_darkness/Shadow_1/0/c-1/12
msgctxt "???"
msgid "<w>Embracing the <b>shadows</b> is not for the fearful heart.</w>"
msgstr ""

#: shadow_darkness/Shadow_1/0/c-1/17
msgctxt "???"
msgid "<w>When you are ready, stand in the darkness and call out once more.</w>"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/9
msgctxt "Narrator"
msgid "A monstrous creature takes shape from the darkness itself—a terrifying amalgam of bones both human and animal. Grotesque clawed fingers. And seething, swirling shadow."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/17
msgctxt "???"
msgid "From brazen earth... to the heavens most incorrigible..."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/25
msgctxt "???"
msgid "The shadows quiver... the shadows quake and quail!"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/33
msgctxt "???"
msgid "Light has no purchase here!"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/41
msgctxt "???"
msgid "For I am..."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/52
msgctxt "???"
msgid "<b><w>...xxXShadowl0rd420Xxx!</b></w>"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/63/s/0
msgctxt "Choix"
msgid "Excuse me?"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/64/s/0
msgctxt "Choix"
msgid "Sweet handle!"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/c-0/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Surprised? Of course, you'd be!"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/c-0/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "For I am the void that covers your eyes when the light rests."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/c-0/23/0/s/0
msgctxt "Choix"
msgid "No dude. Your name..."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/c-0/23/c-0/7
msgctxt "Narrator"
msgid "The shadow creature stops for a moment, perhaps confused by your failure to tremble in fear."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/c-0/23/c-0/15 shadow_darkness/Shadow_2_End/0/g-0/c-2/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "Hm?"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/c-0/23/c-0/23
msgctxt "xxXShadowl0rd420Xxx"
msgid "My name?"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/c-0/23/c-0/31 shadow_darkness/Hangman/0/c-3/23
msgctxt "xxXShadowl0rd420Xxx"
msgid "Fuh..."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/c-0/23/c-0/39 shadow_darkness/Shadow_1_Cont/0/c-0/23/c-0/74 shadow_darkness/Shadow_1_Cont/0/g-2/0 shadow_darkness/Shadow_1_End/0/44
msgctxt "xxXShadowl0rd420Xxx"
msgid "<w>Fwa ha ha ha ha!</w>"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/c-0/23/c-0/50
msgctxt "Narrator"
msgid "He throws his head back in a dramatic, villainous laugh, looking down at you imperiously when he's finished."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/c-0/23/c-0/58
msgctxt "xxXShadowl0rd420Xxx"
msgid "Aren't you a peculiar little shade?"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/c-0/23/c-0/66
msgctxt "xxXShadowl0rd420Xxx"
msgid "Before you stands the emperor of darkness and all that you are compelled to do is question my moniker?"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/c-0/23/c-0/85
msgctxt "xxXShadowl0rd420Xxx"
msgid "You amuse me!"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/c-1/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Of course!"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/c-1/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "I am darkness incarnate!"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-0/0
msgctxt "xxXShadowl0rd420Xxx"
msgid "From now on, you are my <w>penumbra!</w>"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-0/8/s/0
msgctxt "Choix"
msgid "Penumbra?"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-0/9/s/0
msgctxt "Choix"
msgid "Sure, I totally understand."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-0/c-2/7 shadow_darkness/shadow_friendshipreturn/0/0
msgctxt "xxXShadowl0rd420Xxx"
msgid "Penumbra!"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-0/c-3/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Do you?"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-1/0
msgctxt "xxXShadowl0rd420Xxx"
msgid "I am the umbra, the darkest core."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-1/8
msgctxt "xxXShadowl0rd420Xxx"
msgid "You are the penumbra. My companion accent shade. Like an outer shadow cast from an eclipse."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-1/16/s/0
msgctxt "Choix"
msgid "Uhm. Thanks?"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-1/17/s/0
msgctxt "Choix"
msgid "This is a lot."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-1/18/s/0
msgctxt "Choix"
msgid "Sign me up!"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-1/c-4/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "You're welcome!"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-1/c-5/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Indeed!"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-1/c-6/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "...yesssssssss!"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-2/11
msgctxt "xxXShadowl0rd420Xxx"
msgid "So tell me, penumbra, what brings you to the call of night?"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-2/19/s/0
msgctxt "Choix"
msgid "I noticed that one of the shadows was wrong..."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-2/c-7/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Did you find that out on your own..."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-2/c-7/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "Or did you use a hint?"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-2/c-7/23/0/s/0
msgctxt "Choix"
msgid "On my own!"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-2/c-7/23/1/s/0
msgctxt "Choix"
msgid "I needed a hint..."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-2/c-7/23/c-0/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Observant! I enjoy those who observe."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-2/c-7/23/c-1/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Honest! I adore honesty in humanity."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-3/0
msgctxt "xxXShadowl0rd420Xxx"
msgid "You appear to be romancing the objects in your domicile..."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-3/8
msgctxt "xxXShadowl0rd420Xxx"
msgid "I see. You are embarked on a most interesting quest."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-3/16
msgctxt "xxXShadowl0rd420Xxx"
msgid "However, it is quite trivial compared to mine!"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-3/24/s/0
msgctxt "Choix"
msgid "What are you trying to accomplish?"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-3/25/s/0
msgctxt "Choix"
msgid "What do you mean?"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-3/c-8/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "As you can tell, I am dreadfully powerful. However, my true potential has yet to be unleashed."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-3/c-9/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Take a moment to empty your mind and heart."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-4/0
msgctxt "xxXShadowl0rd420Xxx"
msgid "Bask in the shadows and remember."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-4/8
msgctxt "xxXShadowl0rd420Xxx"
msgid "That sinking feeling you get when you turn off the lights as you return to your bedroom."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-4/16
msgctxt "xxXShadowl0rd420Xxx"
msgid "Then this eerie primal instinct to hasten yourself kicks in while your heart begins to rumble with fear."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-4/24
msgctxt "xxXShadowl0rd420Xxx"
msgid "That, my friend, is but a lick of what true darkness can do."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-4/32/s/0
msgctxt "Choix"
msgid "Aw, I hate that spooky feeling."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-4/33/s/0
msgctxt "Choix"
msgid "I love darkness... I always try to keep the lights down."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-4/c-10/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "<w>Fwa ha ha ha ha!</w> So you recognize the power of darkness!"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-4/c-11/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Mmmm... you help my power grow..."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-5/0
msgctxt "xxXShadowl0rd420Xxx"
msgid "But with that said..."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-5/8
msgctxt "xxXShadowl0rd420Xxx"
msgid "I'm afraid to say my power is waning."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-5/16
msgctxt "xxXShadowl0rd420Xxx"
msgid "If not for your summoning ritual, I may be..."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-5/24
msgctxt "xxXShadowl0rd420Xxx"
msgid "Nay. Such thoughts are wasteful."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-5/32
msgctxt "xxXShadowl0rd420Xxx"
msgid "Anyhow, I have been waiting in the abyss in search of a companion."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-5/40/s/0
msgctxt "Choix"
msgid "Like platonically?"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-5/41/s/0
msgctxt "Choix"
msgid "Like romantically?"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-5/c-13/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Such feelings are... unnecessary. Although, not unwelcomed."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-6/0
msgctxt "xxXShadowl0rd420Xxx"
msgid "You see, the essence of darkness must be discussed before obtained."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-6/8
msgctxt "xxXShadowl0rd420Xxx"
msgid "I have been waiting eons for a worthy conversational partner."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-6/16
msgctxt "xxXShadowl0rd420Xxx"
msgid "Our sinister lamentations in pure nightfall will serve as the dark ritual and bring forth my armaments!"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-6/24/s/0
msgctxt "Choix"
msgid "Armaments?"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-6/c-14/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "My armor forged from the shadowy depths."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-6/c-14/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "Think of them as parts to my true self."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-6/c-14/23
msgctxt "xxXShadowl0rd420Xxx"
msgid "However, I have long lost them back during the <w>Great Cataclysm</w>."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-6/c-14/31/0/s/0 shadow_darkness/Shadow_4/0/g-3/c-6/31/c-0/23/0/s/0
msgctxt "Choix"
msgid "I have so many questions."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-6/c-14/31/1/s/0
msgctxt "Choix"
msgid "I have zero questions."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-6/c-14/31/c-0/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Naturally. But I am equipped to ease your wandering mind."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-6/c-14/31/c-0/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "Know that even this discussion will feed into our dark search."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-6/c-14/31/c-1/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "You... are not curious about my dark powers? My special Lore?"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-6/c-14/31/c-1/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "...it is rather special."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-6/c-14/31/c-1/23/0/s/0
msgctxt "Choix"
msgid "Nah, not really."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-6/c-14/31/c-1/23/1/s/0
msgctxt "Choix"
msgid "I guess a little..."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-6/c-14/31/c-1/23/c-0/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Then begone!"
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-6/c-14/31/c-1/23/c-1/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Phew."
msgstr ""

#: shadow_darkness/Shadow_1_Cont/0/g-6/c-14/31/c-1/23/c-1/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "I mean <i>I</i> would have questions meeting any other phantasmal haunting."
msgstr ""

#: shadow_darkness/Shadow_1_Talk/0/8
msgctxt "xxXShadowl0rd420Xxx"
msgid "What troubles you, my penumbra?"
msgstr ""

#: shadow_darkness/Shadow_1_Talk/0/16/s/0
msgctxt "Choix"
msgid "Your moniker..."
msgstr ""

#: shadow_darkness/Shadow_1_Talk/0/17/s/0
msgctxt "Choix"
msgid "The special armor."
msgstr ""

#: shadow_darkness/Shadow_1_Talk/0/18/s/0
msgctxt "Choix"
msgid "The Great Cataclysm."
msgstr ""

#: shadow_darkness/Shadow_1_Talk/0/c-0/13
msgctxt "xxXShadowl0rd420Xxx"
msgid "While it may appear childish, it is a title that bears significance to me."
msgstr ""

#: shadow_darkness/Shadow_1_Talk/0/c-0/24
msgctxt "xxXShadowl0rd420Xxx"
msgid "Even creatures of the dark are entitled to nostalgia."
msgstr ""

#: shadow_darkness/Shadow_1_Talk/0/c-0/32
msgctxt "xxXShadowl0rd420Xxx"
msgid "And its relevancy continues to capture my very essence!"
msgstr ""

#: shadow_darkness/Shadow_1_Talk/0/c-0/40
msgctxt "xxXShadowl0rd420Xxx"
msgid "Lord of shadows!"
msgstr ""

#: shadow_darkness/Shadow_1_Talk/0/c-0/48/0/s/0
msgctxt "Choix"
msgid "What about the x's and 420?"
msgstr ""

#: shadow_darkness/Shadow_1_Talk/0/c-0/48/c-0/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Signature embellishments."
msgstr ""

#: shadow_darkness/Shadow_1_Talk/0/c-0/48/c-0/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "You'd be surprised how popular of an identity <w>shadowlord</w> is."
msgstr ""

#: shadow_darkness/Shadow_1_Talk/0/c-0/48/c-0/23
msgctxt "xxXShadowl0rd420Xxx"
msgid "Can't just have anybody proclaim they are the true lord of shadows!"
msgstr ""

#: shadow_darkness/Shadow_1_Talk/0/c-0/48/c-0/31
msgctxt "xxXShadowl0rd420Xxx"
msgid "Which is why I leave my mark as such."
msgstr ""

#: shadow_darkness/Shadow_1_Talk/0/c-1/13
msgctxt "xxXShadowl0rd420Xxx"
msgid "I'll have you know that these aren't just any normal raiments."
msgstr ""

#: shadow_darkness/Shadow_1_Talk/0/c-1/21
msgctxt "xxXShadowl0rd420Xxx"
msgid "They have no physical form. My armor is of a corporeal shade."
msgstr ""

#: shadow_darkness/Shadow_1_Talk/0/c-1/29
msgctxt "xxXShadowl0rd420Xxx"
msgid "But after I obtain just a single piece of it, the pressure of my dark aura will rise exponentially!"
msgstr ""

#: shadow_darkness/Shadow_1_Talk/0/c-1/40/0/s/0
msgctxt "Choix"
msgid "How do we find the armor parts?"
msgstr ""

#: shadow_darkness/Shadow_1_Talk/0/c-1/40/c-0/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "As I said, by having conversations we initiate the ritual."
msgstr ""

#: shadow_darkness/Shadow_1_Talk/0/c-1/40/c-0/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "Join me in darkness and my power shall inevitably return."
msgstr ""

#: shadow_darkness/Shadow_1_Talk/0/c-1/40/c-0/23/0/s/0
msgctxt "Choix"
msgid "What happens when you get your full armor?"
msgstr ""

#: shadow_darkness/Shadow_1_Talk/0/c-1/40/c-0/23/c-0/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "I descend into the vantablack pools and reemerge as my true awesome form! <w>Fwa ha ha ha ha!</w>"
msgstr ""

#: shadow_darkness/Shadow_1_Talk/0/c-1/40/c-0/23/c-0/18
msgctxt "xxXShadowl0rd420Xxx"
msgid "I sense your curiosity! Stay close, penumbra, and you shall someday see."
msgstr ""

#: shadow_darkness/Shadow_1_Talk/0/c-2/13
msgctxt "xxXShadowl0rd420Xxx"
msgid "The tragedy that befelled my comrades."
msgstr ""

#: shadow_darkness/Shadow_1_Talk/0/c-2/24
msgctxt "xxXShadowl0rd420Xxx"
msgid "Before, it was a peaceful time."
msgstr ""

#: shadow_darkness/Shadow_1_Talk/0/c-2/32
msgctxt "xxXShadowl0rd420Xxx"
msgid "My fellow denizens of the dark and I conversed in the shadows. Then suddenly..."
msgstr ""

#: shadow_darkness/Shadow_1_Talk/0/c-2/40
msgctxt "xxXShadowl0rd420Xxx"
msgid "...a great power beyond any of ours divided us."
msgstr ""

#: shadow_darkness/Shadow_1_Talk/0/c-2/51
msgctxt "xxXShadowl0rd420Xxx"
msgid "I have not seen my allies since. And at the same time, my armament was lost."
msgstr ""

#: shadow_darkness/Shadow_1_Talk/0/c-2/59/0/s/0
msgctxt "Choix"
msgid "What was this power?"
msgstr ""

#: shadow_darkness/Shadow_1_Talk/0/c-2/59/1/s/0
msgctxt "Choix"
msgid "Let me guess. Light defeated the darkness?"
msgstr ""

#: shadow_darkness/Shadow_1_Talk/0/c-2/59/c-1/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Ha! Like such a flimsy concept could be our undoing!"
msgstr ""

#: shadow_darkness/Shadow_1_Talk/0/g-0/0
msgctxt "xxXShadowl0rd420Xxx"
msgid "It is an unexplainable force beyond reason."
msgstr ""

#: shadow_darkness/Shadow_1_Talk/0/g-0/8
msgctxt "xxXShadowl0rd420Xxx"
msgid "But that won't matter once I am at full strength."
msgstr ""

#: shadow_darkness/Shadow_1_End/0/4
msgctxt "Narrator"
msgid "Shadowlord falls silent for a moment, as though listening for something you can't hear. He makes a fist, nodding to himself."
msgstr ""

#: shadow_darkness/Shadow_1_End/0/12 shadow_darkness/Shadow_2_End/0/g-0/51
msgctxt "xxXShadowl0rd420Xxx"
msgid "Ah!"
msgstr ""

#: shadow_darkness/Shadow_1_End/0/20
msgctxt "xxXShadowl0rd420Xxx"
msgid "Can this be?"
msgstr ""

#: shadow_darkness/Shadow_1_End/0/28
msgctxt "Narrator"
msgid "He spreads his arms wide, opening his clawed hands as if to receive something."
msgstr ""

#: shadow_darkness/Shadow_1_End/0/36
msgctxt "xxXShadowl0rd420Xxx"
msgid "Yes, the dark power begins to creep and coarse through me!"
msgstr ""

#: shadow_darkness/Shadow_1_End/0/55/s/0
msgctxt "Choix"
msgid "The dark power...?"
msgstr ""

#: shadow_darkness/Shadow_1_End/0/56/s/0
msgctxt "Choix"
msgid "Did I do a bad thing?"
msgstr ""

#: shadow_darkness/Shadow_1_End/0/c-0/7 shadow_darkness/Shadow_2/0/g-1/c-5/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Yeeess!!"
msgstr ""

#: shadow_darkness/Shadow_1_End/0/c-1/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Perhaps...!!!"
msgstr ""

#: shadow_darkness/Shadow_1_End/0/g-0/0
msgctxt "xxXShadowl0rd420Xxx"
msgid "I knew I had a good feeling about you, penumbra."
msgstr ""

#: shadow_darkness/Shadow_1_End/0/g-0/8
msgctxt "xxXShadowl0rd420Xxx"
msgid "A piece of my armament has returned! My soul quivers with might!"
msgstr ""

#: shadow_darkness/Shadow_1_End/0/g-0/16/s/0
msgctxt "Choix"
msgid "I don't see a difference."
msgstr ""

#: shadow_darkness/Shadow_1_End/0/g-0/17/s/0
msgctxt "Choix"
msgid "It's true. You look very mighty and sexy."
msgstr ""

#: shadow_darkness/Shadow_1_End/0/g-0/c-2/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Sight means naught in the face of shadows!"
msgstr ""

#: shadow_darkness/Shadow_1_End/0/g-0/c-2/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "You'll learn to recognize the ever growing darkness in due time, my companion."
msgstr ""

#: shadow_darkness/Shadow_1_End/0/g-0/c-3/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Oho."
msgstr ""

#: shadow_darkness/Shadow_1_End/0/g-0/c-3/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "That's... exactly the idea!"
msgstr ""

#: shadow_darkness/Shadow_1_End/0/g-1/0
msgctxt "xxXShadowl0rd420Xxx"
msgid "I thank you for awakening me."
msgstr ""

#: shadow_darkness/Shadow_1_End/0/g-1/8
msgctxt "xxXShadowl0rd420Xxx"
msgid "Encountering you has been the most exciting event in a very long time."
msgstr ""

#: shadow_darkness/Shadow_1_End/0/g-1/16
msgctxt "xxXShadowl0rd420Xxx"
msgid "For now, I shall relinquish you. Return to your quest."
msgstr ""

#: shadow_darkness/Shadow_1_End/0/g-1/24
msgctxt "xxXShadowl0rd420Xxx"
msgid "Oh, and no need to reinvite the light. You're now a denizen of darkness, after all!"
msgstr ""

#: shadow_darkness/Shadow_1_End/0/g-1/32
msgctxt "xxXShadowl0rd420Xxx"
msgid "Unless... being in the dark brings about a fearful sensation that tickles your heart too fiercely."
msgstr ""

#: shadow_darkness/Shadow_1_End/0/g-1/40
msgctxt "xxXShadowl0rd420Xxx"
msgid "Farewell! <w>Fwa ha ha ha ha!</w>"
msgstr ""

#: shadow_darkness/Shadow_2/0/6
msgctxt "Narrator"
msgid "Shadowlord greets you in his own unique fashion, throwing his arms open wide as he calls out to you."
msgstr ""

#: shadow_darkness/Shadow_2/0/14
msgctxt "xxXShadowl0rd420Xxx"
msgid "The lights dim and the shadows reign supreme!"
msgstr ""

#: shadow_darkness/Shadow_2/0/25
msgctxt "xxXShadowl0rd420Xxx"
msgid "The doors of the abyss open for yours truly."
msgstr ""

#: shadow_darkness/Shadow_2/0/33
msgctxt "xxXShadowl0rd420Xxx"
msgid "Ah! A dark day to you, my penumbra."
msgstr ""

#: shadow_darkness/Shadow_2/0/41
msgctxt "xxXShadowl0rd420Xxx"
msgid "Oh! I have something I want to show you."
msgstr ""

#: shadow_darkness/Shadow_2/0/49/s/0 shadow_darkness/Shadow_4/0/30/s/0
msgctxt "Choix"
msgid "What is it?"
msgstr ""

#: shadow_darkness/Shadow_2/0/50/s/0
msgctxt "Choix"
msgid "Oh god. This again."
msgstr ""

#: shadow_darkness/Shadow_2/0/c-0/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Evidence of my power returning!"
msgstr ""

#: shadow_darkness/Shadow_2/0/c-1/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "This always!!"
msgstr ""

#: shadow_darkness/Shadow_2/0/g-0/0
msgctxt "xxXShadowl0rd420Xxx"
msgid "During our previous exchange, you questioned if our discussion was monumental in any way."
msgstr ""

#: shadow_darkness/Shadow_2/0/g-0/8
msgctxt "xxXShadowl0rd420Xxx"
msgid "Now, observe closely."
msgstr ""

#: shadow_darkness/Shadow_2/0/g-0/16
msgctxt "xxXShadowl0rd420Xxx"
msgid "Come to me, servants of the night!"
msgstr ""

#: shadow_darkness/Shadow_2/0/g-0/24
msgctxt "Narrator"
msgid "Shadowlord stands stock still, arms spread wide with his head tilted up. He seems to be waiting for something..."
msgstr ""

#: shadow_darkness/Shadow_2/0/g-0/59
msgctxt "Narrator"
msgid "He starts, turning to look at something you can't make out. He points triumphantly."
msgstr ""

#: shadow_darkness/Shadow_2/0/g-0/67
msgctxt "xxXShadowl0rd420Xxx"
msgid "There!"
msgstr ""

#: shadow_darkness/Shadow_2/0/g-0/75
msgctxt "xxXShadowl0rd420Xxx"
msgid "Do you feel them?"
msgstr ""

#: shadow_darkness/Shadow_2/0/g-0/86
msgctxt "Narrator"
msgid "You feel a tickle at your leg."
msgstr ""

#: shadow_darkness/Shadow_2/0/g-0/94/s/0
msgctxt "Choix"
msgid "Is something crawling on me...?"
msgstr ""

#: shadow_darkness/Shadow_2/0/g-0/95/s/0
msgctxt "Choix"
msgid "AAAH!!"
msgstr ""

#: shadow_darkness/Shadow_2/0/g-1/0 shadow_darkness/Shadow_2/0/g-4/c-11/15 shadow_darkness/Shadow_2_End/0/g-0/59 shadow_darkness/Shadow_2_End/0/g-1/24 shadow_darkness/Hangman/0/c-3/31
msgctxt "xxXShadowl0rd420Xxx"
msgid "<w>Fwa ha ha ha!</w>"
msgstr ""

#: shadow_darkness/Shadow_2/0/g-1/11/s/0
msgctxt "Choix"
msgid "Did you summon bugs!?"
msgstr ""

#: shadow_darkness/Shadow_2/0/g-1/12/s/0
msgctxt "Choix"
msgid "I love silverfish!"
msgstr ""

#: shadow_darkness/Shadow_2/0/g-1/c-4/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "These many legged mischievous nocturnal critters hide in the dark until true darkness."
msgstr ""

#: shadow_darkness/Shadow_2/0/g-1/c-4/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "Then they prey at their peak in the shadows!"
msgstr ""

#: shadow_darkness/Shadow_2/0/g-1/c-4/23
msgctxt "xxXShadowl0rd420Xxx"
msgid "Do you believe me now?"
msgstr ""

#: shadow_darkness/Shadow_2/0/g-2/0/s/0
msgctxt "Choix"
msgid "Am I infested with bugs now?"
msgstr ""

#: shadow_darkness/Shadow_2/0/g-2/1/s/0
msgctxt "Choix"
msgid "Glory be to the shroud of darkness... Shadowlord!"
msgstr ""

#: shadow_darkness/Shadow_2/0/g-2/c-6/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Where one is spotted, hundreds of its kind spawn within the walls!"
msgstr ""

#: shadow_darkness/Shadow_2/0/g-2/c-6/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "This is just the beginning!"
msgstr ""

#: shadow_darkness/Shadow_2/0/g-2/c-6/23/0/s/0
msgctxt "Choix"
msgid "I don't want to help you anymore."
msgstr ""

#: shadow_darkness/Shadow_2/0/g-2/c-6/23/1/s/0
msgctxt "Choix"
msgid "So be it... glory to you."
msgstr ""

#: shadow_darkness/Shadow_2/0/g-2/c-6/23/c-0/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "Surely, you jest, penumbra."
msgstr ""

#: shadow_darkness/Shadow_2/0/g-2/c-6/23/c-0/31
msgctxt "xxXShadowl0rd420Xxx"
msgid "Oh. Wait."
msgstr ""

#: shadow_darkness/Shadow_2/0/g-2/c-6/23/c-0/39
msgctxt "xxXShadowl0rd420Xxx"
msgid "Allow me to apologize."
msgstr ""

#: shadow_darkness/Shadow_2/0/g-2/c-6/23/c-0/47
msgctxt "xxXShadowl0rd420Xxx"
msgid "I should have been more sensitive to your connection to the shadows."
msgstr ""

#: shadow_darkness/Shadow_2/0/g-2/c-6/23/c-0/55
msgctxt "xxXShadowl0rd420Xxx"
msgid "I assumed too strongly of your adaptability."
msgstr ""

#: shadow_darkness/Shadow_2/0/g-2/c-6/23/c-0/63/0/s/0
msgctxt "Choix"
msgid "This is gross."
msgstr ""

#: shadow_darkness/Shadow_2/0/g-2/c-6/23/c-1/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Glory! But..."
msgstr ""

#: shadow_darkness/Shadow_2/0/g-2/c-6/23/c-1/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "Dark glory!"
msgstr ""

#: shadow_darkness/Shadow_2/0/g-2/c-7/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Witness my power! Witness my mercy!"
msgstr ""

#: shadow_darkness/Shadow_2/0/g-3/0
msgctxt "xxXShadowl0rd420Xxx"
msgid "Begone, you pests!"
msgstr ""

#: shadow_darkness/Shadow_2/0/g-3/11
msgctxt "Narrator"
msgid "With a swipe of his clawed hand, Shadowlord scatters his insect minions away into nothingness."
msgstr ""

#: shadow_darkness/Shadow_2/0/g-3/19
msgctxt "xxXShadowl0rd420Xxx"
msgid "There. They shall not intrude your presence again."
msgstr ""

#: shadow_darkness/Shadow_2/0/g-3/27/s/0
msgctxt "Choix"
msgid "Thank you, Shadow."
msgstr ""

#: shadow_darkness/Shadow_2/0/g-3/28/s/0
msgctxt "Choix"
msgid "I thank you for your mercy, Lord of Shadows."
msgstr ""

#: shadow_darkness/Shadow_2/0/g-3/c-8/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "\"Shadow?\""
msgstr ""

#: shadow_darkness/Shadow_2/0/g-3/c-8/15 shadow_darkness/Hangman/0/c-2/15 shadow_darkness/Hangman/0/c-3/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "Hmm..."
msgstr ""

#: shadow_darkness/Shadow_2/0/g-3/c-8/23/0/s/0
msgctxt "Choix"
msgid "Consider it a sign that we're getting closer."
msgstr ""

#: shadow_darkness/Shadow_2/0/g-3/c-8/23/c-0/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Oh!"
msgstr ""

#: shadow_darkness/Shadow_2/0/g-3/c-8/23/c-0/18
msgctxt "xxXShadowl0rd420Xxx"
msgid "That's... nice."
msgstr ""

#: shadow_darkness/Shadow_2/0/g-3/c-8/23/c-0/34
msgctxt "xxXShadowl0rd420Xxx"
msgid "Ahem."
msgstr ""

#: shadow_darkness/Shadow_2/0/g-3/c-9/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "I am merciful for your thankness, granted human."
msgstr ""

#: shadow_darkness/Shadow_2/0/g-3/c-9/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "Most merciful of thankness most bountiful! <w>Fwa hah ha ha ha!</w>"
msgstr ""

#: shadow_darkness/Shadow_2/0/g-4/0
msgctxt "xxXShadowl0rd420Xxx"
msgid "I have to say, penumbra, I'm quite surprised."
msgstr ""

#: shadow_darkness/Shadow_2/0/g-4/8
msgctxt "xxXShadowl0rd420Xxx"
msgid "Your unfamiliarity of the dark is... unexpected."
msgstr ""

#: shadow_darkness/Shadow_2/0/g-4/16
msgctxt "xxXShadowl0rd420Xxx"
msgid "This resistance to the caliginosity must be reversed."
msgstr ""

#: shadow_darkness/Shadow_2/0/g-4/24
msgctxt "xxXShadowl0rd420Xxx"
msgid "Perhaps your soul is not attuned properly."
msgstr ""

#: shadow_darkness/Shadow_2/0/g-4/32
msgctxt "xxXShadowl0rd420Xxx"
msgid "Hmmm. Training is in order."
msgstr ""

#: shadow_darkness/Shadow_2/0/g-4/40/s/0
msgctxt "Choix"
msgid "Give me all the training you got! Let's level up!"
msgstr ""

#: shadow_darkness/Shadow_2/0/g-4/41/s/0
msgctxt "Choix"
msgid "Like shadowboxing?"
msgstr ""

#: shadow_darkness/Shadow_2/0/g-4/c-10/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Yessss...."
msgstr ""

#: shadow_darkness/Shadow_2/0/g-4/c-11/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Fu..fuhu.."
msgstr ""

#: shadow_darkness/Shadow_2/0/g-4/c-11/26
msgctxt "xxXShadowl0rd420Xxx"
msgid "You are a rancorous one, my friend!"
msgstr ""

#: shadow_darkness/Shadow_2/0/g-4/c-11/34
msgctxt "xxXShadowl0rd420Xxx"
msgid "I mean in the intellectual sense."
msgstr ""

#: shadow_darkness/Shadow_2/0/g-5/0
msgctxt "xxXShadowl0rd420Xxx"
msgid "Conversation will keep darkness in our mind tempered and in our control."
msgstr ""

#: shadow_darkness/Shadow_2/0/g-5/8
msgctxt "xxXShadowl0rd420Xxx"
msgid "Just as you participate in the labors of light, surely you partake in the leisures of darkness as well."
msgstr ""

#: shadow_darkness/Shadow_2/0/g-5/16
msgctxt "xxXShadowl0rd420Xxx"
msgid "What activities do you enact in the shadows?"
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/0
msgctxt "xxXShadowl0rd420Xxx"
msgid "Regale me with every detail, penumbra."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/8/s/0
msgctxt "Choix"
msgid "Sleep."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/9/s/0
msgctxt "Choix"
msgid "Overthink."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/10/s/0
msgctxt "Choix"
msgid "Doomscroll."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/11/s/0
msgctxt "Choix"
msgid "...private stuff."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-0/13
msgctxt "xxXShadowl0rd420Xxx"
msgid "That is all?"
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-0/21
msgctxt "xxXShadowl0rd420Xxx"
msgid "Uh... What a relaxed spirit you are."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-0/29
msgctxt "xxXShadowl0rd420Xxx"
msgid "No wait..."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-0/48
msgctxt "xxXShadowl0rd420Xxx"
msgid "Yes, of course!"
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-0/56
msgctxt "xxXShadowl0rd420Xxx"
msgid "Perhaps... I have misjudged you."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-0/64
msgctxt "xxXShadowl0rd420Xxx"
msgid "Resting in the shadows is your regiment!"
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-0/72
msgctxt "xxXShadowl0rd420Xxx"
msgid "Absorbing the dark essence while your body is most susceptible is..."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-0/80
msgctxt "xxXShadowl0rd420Xxx"
msgid "...a most legendary method!"
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-0/88/0/s/0
msgctxt "Choix"
msgid "Yup. That's it."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-0/88/1/s/0
msgctxt "Choix"
msgid "I mean... I just dream and stuff."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-0/88/g-0/0
msgctxt "xxXShadowl0rd420Xxx"
msgid "It seems we have much to learn about each other."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-1/13
msgctxt "xxXShadowl0rd420Xxx"
msgid "Keeping your mind active and curious is important."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-1/21
msgctxt "xxXShadowl0rd420Xxx"
msgid "Surely, productive thoughts?"
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-1/29/0/s/0
msgctxt "Choix"
msgid "No..."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-1/29/1/s/0
msgctxt "Choix"
msgid "Yes..."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-1/29/c-0/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Ah. The paranoid down-spiraling ones?"
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-1/29/c-1/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Judging by your surroundings... I don't believe you."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-1/29/g-0/0
msgctxt "xxXShadowl0rd420Xxx"
msgid "Take comfort in knowing that you are not alone."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-1/29/g-0/8
msgctxt "xxXShadowl0rd420Xxx"
msgid "I have been there. Every night."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-1/29/g-0/16
msgctxt "xxXShadowl0rd420Xxx"
msgid "I don't recall the last time I've rested peacefully."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-1/29/g-0/24
msgctxt "xxXShadowl0rd420Xxx"
msgid "There's just... so much I can't help reflect on."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-1/29/g-0/32/0/s/0
msgctxt "Choix"
msgid "Like what?"
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-1/29/g-0/32/c-0/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "If I redirected that same question back to you..."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-1/29/g-0/32/c-0/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "...wouldn't you respond with a wistful sigh:"
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-1/29/g-0/32/c-0/23
msgctxt "xxXShadowl0rd420Xxx"
msgid "\"Nothing important.\""
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-2/13
msgctxt "xxXShadowl0rd420Xxx"
msgid "What is that?"
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-2/21/0/s/0
msgctxt "Choix"
msgid "Scrolling through a social media feed for hours and feeling like garbage."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-2/21/1/s/0
msgctxt "Choix"
msgid "Catching up on the news. Staying updated."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-2/21/g-0/0
msgctxt "xxXShadowl0rd420Xxx"
msgid "That sounds incredibly sad."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-2/21/g-0/8/0/s/0
msgctxt "Choix"
msgid "It is."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-2/21/g-0/8/c-0/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Why do you do this in the dark?"
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-2/21/g-0/8/c-0/15/0/s/0
msgctxt "Choix"
msgid "Sometimes I do this during the day too."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-2/21/g-0/8/c-0/15/c-0/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Hmm."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-2/21/g-0/8/c-0/15/c-0/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "Fascinating."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-2/21/g-0/8/c-0/15/c-0/23
msgctxt "xxXShadowl0rd420Xxx"
msgid "I can't speak to the merits - if any - of this activity, but I can part with you some words to remember by."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-2/21/g-0/8/c-0/15/c-0/31
msgctxt "xxXShadowl0rd420Xxx"
msgid "Even in your loneliest moments, you are a god."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-2/21/g-0/8/c-0/15/c-0/39
msgctxt "xxXShadowl0rd420Xxx"
msgid "In darkness, I will be there to remind you as such."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-2/21/g-0/8/c-0/15/c-0/47
msgctxt "xxXShadowl0rd420Xxx"
msgid "In light, you walk with your shadow."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-2/21/g-0/8/c-0/15/c-0/55
msgctxt "xxXShadowl0rd420Xxx"
msgid "A shadow can only imitate its source."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-2/21/g-0/8/c-0/15/c-0/63
msgctxt "xxXShadowl0rd420Xxx"
msgid "Meaning, everything that's wonderful about you is always there."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-2/21/g-0/8/c-0/15/c-0/71
msgctxt "xxXShadowl0rd420Xxx"
msgid "Even if you don't realize it."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-2/21/g-0/8/c-0/15/c-0/79/0/s/0
msgctxt "Choix"
msgid "Wow. Thank you, Shadow."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-2/21/g-0/8/c-0/15/c-0/79/1/s/0
msgctxt "Choix"
msgid "...that was romantic."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-2/21/g-0/8/c-0/15/c-0/79/c-0/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Just speaking truths, penumbra."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-2/21/g-0/8/c-0/15/c-0/79/c-1/7
msgctxt "Narrator"
msgid "Shadowlord seems taken aback, rubbing one clawed hand at the back of his shadowy neck."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-2/21/g-0/8/c-0/15/c-0/79/c-1/18
msgctxt "xxXShadowl0rd420Xxx"
msgid "I..."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-2/21/g-0/8/c-0/15/c-0/79/c-1/26
msgctxt "xxXShadowl0rd420Xxx"
msgid "...didn't mean anything by that."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-2/21/g-0/8/c-0/15/c-0/79/c-1/34
msgctxt "xxXShadowl0rd420Xxx"
msgid "Obviously."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-3/13
msgctxt "xxXShadowl0rd420Xxx"
msgid "Elaborate."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-3/21/0/s/0
msgctxt "Choix"
msgid "I'd rather not."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-3/21/c-0/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "What's the matter?"
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-3/21/c-0/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "\"Stuff\" is hardly a sufficient description."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-3/21/c-0/23
msgctxt "xxXShadowl0rd420Xxx"
msgid "Answer me properly, penumbra."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-3/21/c-0/31/0/s/0
msgctxt "Choix"
msgid "I'm... you know."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-3/21/c-0/31/c-0/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Excuse me?"
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-3/21/c-0/31/c-0/15/0/s/0
msgctxt "Choix"
msgid "I said I'm... you know..."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-3/21/c-0/31/c-0/15/c-0/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "I feel as though this conversation is actually reversing my power."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-3/21/c-0/31/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "Touching myself in <i>places</i>, okay?!"
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-3/21/c-0/31/c-0/15/c-0/15/1/s/0
msgctxt "Choix"
msgid "Writing poetry in my head!"
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-3/21/c-0/31/c-0/15/c-0/15/c-0/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Oh I know."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-3/21/c-0/31/c-0/15/c-0/15/c-0/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "I just wanted to get you to admit it."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-3/21/c-0/31/c-0/15/c-0/15/c-0/23/0/s/0
msgctxt "Choix"
msgid "Huh!?"
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-3/21/c-0/31/c-0/15/c-0/15/c-0/23/touchjoin/0
msgctxt "xxXShadowl0rd420Xxx"
msgid "The sounds that escape you echo far, you know."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-3/21/c-0/31/c-0/15/c-0/15/c-0/23/touchjoin/8
msgctxt "xxXShadowl0rd420Xxx"
msgid "I wouldn't be surprised if every object in this house has heard them."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-3/21/c-0/31/c-0/15/c-0/15/c-0/23/touchjoin/16/0/s/0
msgctxt "Choix"
msgid "This is embarrassing."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-3/21/c-0/31/c-0/15/c-0/15/c-0/23/touchjoin/16/c-0/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "You are just exhibiting good health. Nothing to be ashamed about."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-3/21/c-0/31/c-0/15/c-0/15/c-0/23/touchjoin/16/c-0/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "And if I may be upfront..."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-3/21/c-0/31/c-0/15/c-0/15/c-0/23/touchjoin/16/c-0/23
msgctxt "xxXShadowl0rd420Xxx"
msgid "Each breath you let out during is admittedly adorable."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-3/21/c-0/31/c-0/15/c-0/15/c-0/23/touchjoin/16/c-0/34/0/s/0
msgctxt "Choix"
msgid "Please stop."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-3/21/c-0/31/c-0/15/c-0/15/c-0/23/touchjoin/16/c-0/34/1/s/0
msgctxt "Choix"
msgid "Go on..."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-3/21/c-0/31/c-0/15/c-0/15/c-0/23/touchjoin/16/c-0/34/c-0/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "As you wish."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-3/21/c-0/31/c-0/15/c-0/15/c-0/23/touchjoin/16/c-0/34/c-1/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "I will when I'm ready."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-3/21/c-0/31/c-0/15/c-0/15/c-1/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "You just didn't want to say the other thing."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-3/21/c-0/31/c-0/15/c-0/15/c-1/23
msgctxt "xxXShadowl0rd420Xxx"
msgid "Right?"
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-3/21/c-0/31/c-0/15/c-0/15/c-1/31/0/s/0
msgctxt "Choix"
msgid "...yeah."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-3/21/c-0/31/c-0/15/c-0/15/c-1/31/1/s/0
msgctxt "Choix"
msgid "No seriously. I like writing poetry in my head."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-3/21/c-0/31/c-0/15/c-0/15/c-1/31/c-1/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Damn."
msgstr ""

#: shadow_darkness/Shadow_2_Questions/0/c-3/21/c-0/31/c-0/15/c-0/15/c-1/31/c-1/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "That's hot."
msgstr ""

#: shadow_darkness/Shadow_2_End/0/4
msgctxt "xxXShadowl0rd420Xxx"
msgid "I am grateful to you for providing me more insight into your life."
msgstr ""

#: shadow_darkness/Shadow_2_End/0/12
msgctxt "xxXShadowl0rd420Xxx"
msgid "Behold: our corrupted bond grows!"
msgstr ""

#: shadow_darkness/Shadow_2_End/0/20/s/0
msgctxt "Choix"
msgid "I have a question."
msgstr ""

#: shadow_darkness/Shadow_2_End/0/21/s/0
msgctxt "Choix"
msgid "Yes! I am beholding you, Shadowlord!"
msgstr ""

#: shadow_darkness/Shadow_2_End/0/c-0/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Hm? Something troubles you, penumbra?"
msgstr ""

#: shadow_darkness/Shadow_2_End/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "You haven't told me what you do yet!"
msgstr ""

#: shadow_darkness/Shadow_2_End/0/c-0/15/c-0/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "My nightly activities?"
msgstr ""

#: shadow_darkness/Shadow_2_End/0/c-0/15/c-0/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "Isn't it obvious?"
msgstr ""

#: shadow_darkness/Shadow_2_End/0/c-0/15/c-0/23/0/s/0 shadow_darkness/Shadow_4_End/0/g-1/c-4/34/c-0/15/1/s/0
msgctxt "Choix"
msgid "What?"
msgstr ""

#: shadow_darkness/Shadow_2_End/0/c-0/15/c-0/23/c-0/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Before you, my time has always been spent the same way."
msgstr ""

#: shadow_darkness/Shadow_2_End/0/c-0/15/c-0/23/c-0/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "Waiting."
msgstr ""

#: shadow_darkness/Shadow_2_End/0/c-0/15/c-0/23/c-0/23/0/s/0
msgctxt "Choix"
msgid "Waiting?"
msgstr ""

#: shadow_darkness/Shadow_2_End/0/c-0/15/c-0/23/c-0/23/1/s/0
msgctxt "Choix"
msgid "For what?"
msgstr ""

#: shadow_darkness/Shadow_2_End/0/g-0/8
msgctxt "Narrator"
msgid "He exhales, his hands tightening into fists before throwing his arms open once more—you're beginning to grow used to this routine with him."
msgstr ""

#: shadow_darkness/Shadow_2_End/0/g-0/16
msgctxt "xxXShadowl0rd420Xxx"
msgid "I feel it!"
msgstr ""

#: shadow_darkness/Shadow_2_End/0/g-0/27
msgctxt "xxXShadowl0rd420Xxx"
msgid "Another piece of my dark armament!"
msgstr ""

#: shadow_darkness/Shadow_2_End/0/g-0/35
msgctxt "xxXShadowl0rd420Xxx"
msgid "It courses through my once dazed body - rejuvenating to the next stage!"
msgstr ""

#: shadow_darkness/Shadow_2_End/0/g-0/73
msgctxt "xxXShadowl0rd420Xxx"
msgid "Excellent."
msgstr ""

#: shadow_darkness/Shadow_2_End/0/g-0/81
msgctxt "xxXShadowl0rd420Xxx"
msgid "My form is stronger..."
msgstr ""

#: shadow_darkness/Shadow_2_End/0/g-0/89
msgctxt "xxXShadowl0rd420Xxx"
msgid "...yet still incomplete."
msgstr ""

#: shadow_darkness/Shadow_2_End/0/g-0/97/s/0
msgctxt "Choix"
msgid "What happens when your form is complete?"
msgstr ""

#: shadow_darkness/Shadow_2_End/0/g-0/98/s/0
msgctxt "Choix"
msgid "I'm so happy for you, my dreary friend."
msgstr ""

#: shadow_darkness/Shadow_2_End/0/g-0/c-2/7
msgctxt "Narrator"
msgid "Your question seems to catch him entirely off-guard."
msgstr ""

#: shadow_darkness/Shadow_2_End/0/g-0/c-2/23
msgctxt "xxXShadowl0rd420Xxx"
msgid "Oh."
msgstr ""

#: shadow_darkness/Shadow_2_End/0/g-0/c-2/31
msgctxt "xxXShadowl0rd420Xxx"
msgid "Uh."
msgstr ""

#: shadow_darkness/Shadow_2_End/0/g-0/c-2/39
msgctxt "xxXShadowl0rd420Xxx"
msgid "We'll have to resume the ritual another night."
msgstr ""

#: shadow_darkness/Shadow_2_End/0/g-0/c-2/47
msgctxt "xxXShadowl0rd420Xxx"
msgid "I must become more adept to this newly returned strength."
msgstr ""

#: shadow_darkness/Shadow_2_End/0/g-1/0
msgctxt "xxXShadowl0rd420Xxx"
msgid "Until next time, penumbra."
msgstr ""

#: shadow_darkness/Shadow_2_End/0/g-1/8
msgctxt "xxXShadowl0rd420Xxx"
msgid "Oh and I do hope you have a pleasant rest."
msgstr ""

#: shadow_darkness/Shadow_2_End/0/g-1/16
msgctxt "xxXShadowl0rd420Xxx"
msgid "You'll need to conjure as much void aura as you can for our next ritual."
msgstr ""

#: shadow_darkness/Shadow_3/0/6
msgctxt "xxXShadowl0rd420Xxx"
msgid "Welcome back, my dark ally."
msgstr ""

#: shadow_darkness/Shadow_3/0/14
msgctxt "xxXShadowl0rd420Xxx"
msgid "Come! Let the next trial commence!"
msgstr ""

#: shadow_darkness/Shadow_3/0/22/s/0
msgctxt "Choix"
msgid "What are we talking about now?"
msgstr ""

#: shadow_darkness/Shadow_3/0/23/s/0
msgctxt "Choix"
msgid "Give me all the trials."
msgstr ""

#: shadow_darkness/Shadow_3/0/c-0/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Words will be exchanged less than usual."
msgstr ""

#: shadow_darkness/Shadow_3/0/c-0/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "We'll be exchanging letters instead."
msgstr ""

#: shadow_darkness/Shadow_3/0/c-1/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "The trial of the Letters begins..."
msgstr ""

#: shadow_darkness/Shadow_3/0/g-0/0/s/0
msgctxt "Choix"
msgid "Letters?"
msgstr ""

#: shadow_darkness/Shadow_3/0/g-0/c-2/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Back before the Great Cataclysm, my comrades and I would partake in spirit-shackling activities."
msgstr ""

#: shadow_darkness/Shadow_3/0/g-0/c-2/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "Some have lasted several nights."
msgstr ""

#: shadow_darkness/Shadow_3/0/g-0/c-2/23
msgctxt "xxXShadowl0rd420Xxx"
msgid "Others, we simply gave up counting."
msgstr ""

#: shadow_darkness/Shadow_3/0/g-0/c-2/31
msgctxt "xxXShadowl0rd420Xxx"
msgid "Are you prepared to begin?"
msgstr ""

#: shadow_darkness/Shadow_3/0/g-0/c-2/39/0/s/0
msgctxt "Choix"
msgid "I have other objects to woo."
msgstr ""

#: shadow_darkness/Shadow_3/0/g-0/c-2/39/1/s/0
msgctxt "Choix"
msgid "I am prepared, Lord of Darkness."
msgstr ""

#: shadow_darkness/Shadow_3/0/g-0/c-2/39/c-0/7
msgctxt "Narrator"
msgid "Shadowlord completely ignores your response."
msgstr ""

#: shadow_darkness/Shadow_3/0/g-0/c-2/39/g-0/0
msgctxt "xxXShadowl0rd420Xxx"
msgid "Let the game of shadows begin!"
msgstr ""

#: shadow_darkness/Shadow_3/0/g-0/c-2/39/g-0/8
msgctxt "xxXShadowl0rd420Xxx"
msgid "I present to you the following:"
msgstr ""

#: shadow_darkness/Shadow_3/0/g-0/c-2/39/g-0/19
msgctxt "Narrator"
msgid "He holds a sheet of notebook paper up to you—it contains a macabre illustration of a dead person and a few mysterious lines."
msgstr ""

#: shadow_darkness/Shadow_3/0/g-0/c-2/39/g-0/35
msgctxt "xxXShadowl0rd420Xxx"
msgid "Now, guess!"
msgstr ""

#: shadow_darkness/Shadow_3/0/g-1/0/s/0
msgctxt "Choix"
msgid "Wait, is this hangman?"
msgstr ""

#: shadow_darkness/Shadow_3/0/g-1/c-3/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "This is \"The Hanged Man.\""
msgstr ""

#: shadow_darkness/Shadow_3/0/shadow_hangman/0
msgctxt "xxXShadowl0rd420Xxx"
msgid "Now choose your letter!"
msgstr ""

#: shadow_darkness/Shadow_3/0/shadow_hangman/8/s/0
msgctxt "Choix"
msgid "I bet it's <i>shadow</i>."
msgstr ""

#: shadow_darkness/Shadow_3/0/shadow_hangman/9/s/0
msgctxt "Choix"
msgid "A"
msgstr ""

#: shadow_darkness/Shadow_3/0/shadow_hangman/10/s/0
msgctxt "Choix"
msgid "O"
msgstr ""

#: shadow_darkness/Shadow_3/0/shadow_hangman/11/s/0
msgctxt "Choix"
msgid "S"
msgstr ""

#: shadow_darkness/Shadow_3/0/shadow_hangman/12/s/0
msgctxt "Choix"
msgid "D"
msgstr ""

#: shadow_darkness/Shadow_3/0/shadow_hangman/13/s/0
msgctxt "Choix"
msgid "W"
msgstr ""

#: shadow_darkness/Shadow_3/0/shadow_hangman/14/s/0
msgctxt "Choix"
msgid "Is it <i>shadow</i>?"
msgstr ""

#: shadow_darkness/Shadow_3/0/shadow_hangman/c-5/11
msgctxt "xxXShadowl0rd420Xxx"
msgid "There is an 'A'!"
msgstr ""

#: shadow_darkness/Shadow_3/0/shadow_hangman/c-6/11
msgctxt "xxXShadowl0rd420Xxx"
msgid "There is an 'O'!"
msgstr ""

#: shadow_darkness/Shadow_3/0/shadow_hangman/c-7/11
msgctxt "xxXShadowl0rd420Xxx"
msgid "There is an 'S'!"
msgstr ""

#: shadow_darkness/Shadow_3/0/shadow_hangman/c-8/11
msgctxt "xxXShadowl0rd420Xxx"
msgid "There is a 'D'!"
msgstr ""

#: shadow_darkness/Shadow_3/0/shadow_hangman/c-9/11
msgctxt "xxXShadowl0rd420Xxx"
msgid "There is a 'W'!"
msgstr ""

#: shadow_darkness/Shadow_3/0/shadow_answer/0
msgctxt "xxXShadowl0rd420Xxx"
msgid "The answer is <w>shadow</w>!"
msgstr ""

#: shadow_darkness/Shadow_3/0/shadow_answer/17/s/0
msgctxt "Choix"
msgid "Figures."
msgstr ""

#: shadow_darkness/Shadow_3/0/shadow_answer/18/s/0
msgctxt "Choix"
msgid "That's so sick, dude."
msgstr ""

#: shadow_darkness/Shadow_3/0/shadow_answer/c-12/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Completely sick."
msgstr ""

#: shadow_darkness/Shadow_3/0/g-2/0
msgctxt "xxXShadowl0rd420Xxx"
msgid "Your turn!"
msgstr ""

#: shadow_darkness/Hangman/0/0
msgctxt "Narrator"
msgid "Shadowlord's skull doesn't really have much in the way of expression, but he seems a bit smug."
msgstr ""

#: shadow_darkness/Hangman/0/8
msgctxt "xxXShadowl0rd420Xxx"
msgid "I'll have you know that among my dark cabal, I was the leading player!"
msgstr ""

#: shadow_darkness/Hangman/0/16
msgctxt "xxXShadowl0rd420Xxx"
msgid "Think to yourself... what is your mysterious text?"
msgstr ""

#: shadow_darkness/Hangman/0/24/s/0
msgctxt "Choix"
msgid "Think: <i>Dateviators</i>"
msgstr ""

#: shadow_darkness/Hangman/0/25/s/0
msgctxt "Choix"
msgid "Think: <i>Darkness</i>"
msgstr ""

#: shadow_darkness/Hangman/0/26/s/0
msgctxt "Choix"
msgid "Think: <i>This sucks</i>"
msgstr ""

#: shadow_darkness/Hangman/0/27/s/0
msgctxt "Choix"
msgid "Think: <i>You're cute</i>"
msgstr ""

#: shadow_darkness/Hangman/0/c-0/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Eleven letters? Aren't you ambitious?"
msgstr ""

#: shadow_darkness/Hangman/0/c-0/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "But it's not enough to challenge me!"
msgstr ""

#: shadow_darkness/Hangman/0/c-0/23
msgctxt "xxXShadowl0rd420Xxx"
msgid "It's most certainly 'dateviators'."
msgstr ""

#: shadow_darkness/Hangman/0/c-0/31/0/s/0
msgctxt "Choix"
msgid "How did you know?"
msgstr ""

#: shadow_darkness/Hangman/0/c-0/31/c-0/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "It's all you ever think about."
msgstr ""

#: shadow_darkness/Hangman/0/c-0/31/c-0/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "Date this, date that."
msgstr ""

#: shadow_darkness/Hangman/0/c-0/31/c-0/23
msgctxt "xxXShadowl0rd420Xxx"
msgid "You're becoming predictable, penumbra."
msgstr ""

#: shadow_darkness/Hangman/0/c-1/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Eight letters? My favorite!"
msgstr ""

#: shadow_darkness/Hangman/0/c-1/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "Why you ask? Isn't it obvious?"
msgstr ""

#: shadow_darkness/Hangman/0/c-1/23
msgctxt "xxXShadowl0rd420Xxx"
msgid "Eight is the infinity symbol... but sideways. Very cool."
msgstr ""

#: shadow_darkness/Hangman/0/c-1/31
msgctxt "xxXShadowl0rd420Xxx"
msgid "It's obviously 'darkness'."
msgstr ""

#: shadow_darkness/Hangman/0/c-1/39/0/s/0
msgctxt "Choix"
msgid "Aw man!"
msgstr ""

#: shadow_darkness/Hangman/0/c-1/39/c-0/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "I appreciate you staying relevant to our practices, penumbra."
msgstr ""

#: shadow_darkness/Hangman/0/c-2/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Two words. First, four letters. Second, five."
msgstr ""

#: shadow_darkness/Hangman/0/c-2/23
msgctxt "xxXShadowl0rd420Xxx"
msgid "The shadows inform me of a negative energy behind this secret phrase."
msgstr ""

#: shadow_darkness/Hangman/0/c-2/31
msgctxt "xxXShadowl0rd420Xxx"
msgid "I believe you may be having a poor attitude about this, penumbra!"
msgstr ""

#: shadow_darkness/Hangman/0/c-2/39
msgctxt "xxXShadowl0rd420Xxx"
msgid "It's most certainly 'this sucks'."
msgstr ""

#: shadow_darkness/Hangman/0/c-2/47/0/s/0
msgctxt "Choix"
msgid "Sorry."
msgstr ""

#: shadow_darkness/Hangman/0/c-2/47/c-0/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "At least make an attempt to enjoy yourself!"
msgstr ""

#: shadow_darkness/Hangman/0/c-2/47/c-0/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "We are allowed to have fun while restoring my power."
msgstr ""

#: shadow_darkness/Hangman/0/c-3/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Two words. The second, four letters. The first, an apostrophe."
msgstr ""

#: shadow_darkness/Hangman/0/c-3/42
msgctxt "xxXShadowl0rd420Xxx"
msgid "This is most certainly a declaration of praise and endearment!"
msgstr ""

#: shadow_darkness/Hangman/0/c-3/50
msgctxt "xxXShadowl0rd420Xxx"
msgid "How sweet of you, penumbra."
msgstr ""

#: shadow_darkness/Hangman/0/c-3/58
msgctxt "xxXShadowl0rd420Xxx"
msgid "It's most certainly 'you're cool'."
msgstr ""

#: shadow_darkness/Hangman/0/c-3/66/0/s/0
msgctxt "Choix"
msgid "You're wrong."
msgstr ""

#: shadow_darkness/Hangman/0/c-3/66/c-0/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "What!?"
msgstr ""

#: shadow_darkness/Hangman/0/c-3/66/c-0/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "That's impossible!"
msgstr ""

#: shadow_darkness/Hangman/0/c-3/66/c-0/23
msgctxt "xxXShadowl0rd420Xxx"
msgid "What is the answer then?"
msgstr ""

#: shadow_darkness/Hangman/0/c-3/66/c-0/31/0/s/0
msgctxt "Choix"
msgid "You're cute."
msgstr ""

#: shadow_darkness/Hangman/0/c-3/66/c-0/31/c-0/7
msgctxt "Narrator"
msgid "Shadowlord falls silent as he tries and fails to process this compliment."
msgstr ""

#: shadow_darkness/Hangman/0/c-3/66/c-0/31/c-0/23
msgctxt "xxXShadowl0rd420Xxx"
msgid "Oh..."
msgstr ""

#: shadow_darkness/Hangman/0/c-3/66/c-0/31/c-0/31
msgctxt "xxXShadowl0rd420Xxx"
msgid "Well."
msgstr ""

#: shadow_darkness/Hangman/0/c-3/66/c-0/31/c-0/39
msgctxt "xxXShadowl0rd420Xxx"
msgid "I see you've chosen the path of flattery."
msgstr ""

#: shadow_darkness/Hangman/0/c-3/66/c-0/31/c-0/55
msgctxt "xxXShadowl0rd420Xxx"
msgid "As are you, penumbra. Very cute."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/0
msgctxt "xxXShadowl0rd420Xxx"
msgid "Ah, that was entertaining!"
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/8
msgctxt "xxXShadowl0rd420Xxx"
msgid "It's been eons since I've played \"The Hanged Man!\""
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/16
msgctxt "xxXShadowl0rd420Xxx"
msgid "Last time, I engaged in a mighty face-off with LunarKnight that lasted until sunrise!"
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/24
msgctxt "xxXShadowl0rd420Xxx"
msgid "Ooooh, it was legendary!"
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/32/s/0
msgctxt "Choix"
msgid "Who's LunarKnight?"
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/33/s/0
msgctxt "Choix"
msgid "I have to go suddenly. I fear you're going to talk a lot."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "An old comrade."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "From before The Great Cataclysm."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/0/s/0
msgctxt "Choix"
msgid "Were you two close?"
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "He was a former shade of mine, if you get what I mean."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "Our conversations gathered more shadows than any other void dweller."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/23
msgctxt "xxXShadowl0rd420Xxx"
msgid "The lord of shadows and his loyal knight."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/31
msgctxt "xxXShadowl0rd420Xxx"
msgid "Us two were perceived as an eternal pair."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/0/s/0
msgctxt "Choix"
msgid "What happened?"
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "The Great Cataclysm."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/0/s/0
msgctxt "Choix"
msgid "Tell me more, Shadow."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/1/s/0
msgctxt "Choix"
msgid "I'm all ears."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/2/s/0
msgctxt "Choix"
msgid "This sounds like too much made up stuff."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/c-2/15 shadow_darkness/Shadow_3_Cont/0/c-1/23
msgctxt "xxXShadowl0rd420Xxx"
msgid "Go."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/g-0/8
msgctxt "xxXShadowl0rd420Xxx"
msgid "Very well."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/g-0/16
msgctxt "xxXShadowl0rd420Xxx"
msgid "I suppose a proper explanation is owed."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/g-0/24
msgctxt "xxXShadowl0rd420Xxx"
msgid "Tell me, penumbra, what do you presume to be a power more fearsome than darkness?"
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/g-0/32/0/s/0
msgctxt "Choix"
msgid "Light?"
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/g-0/32/1/s/0
msgctxt "Choix"
msgid "Love?"
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/g-0/32/2/s/0
msgctxt "Choix"
msgid "Fearlessness itself?"
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/g-0/32/g-0/0
msgctxt "xxXShadowl0rd420Xxx"
msgid "We don't live in a world of whimsical tales and fantasy."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/g-0/32/g-0/8
msgctxt "xxXShadowl0rd420Xxx"
msgid "Not anymore at least."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/g-0/32/g-0/16
msgctxt "xxXShadowl0rd420Xxx"
msgid "The overwhelming phantasmic force that realigned the unified lives of my comrades and I is..."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/g-0/32/g-0/24
msgctxt "xxXShadowl0rd420Xxx"
msgid "...time."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/g-0/32/g-0/32/0/s/0
msgctxt "Choix"
msgid "You drifted apart?"
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/g-0/32/g-0/32/c-0/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "There was no one moment or act that caused it."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/g-0/32/g-0/32/c-0/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "One night, I was with Lunar and my friends. Joyfully conversing about whatever came to our minds."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/g-0/32/g-0/32/c-0/23
msgctxt "xxXShadowl0rd420Xxx"
msgid "Time crept into our dark haven."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/g-0/32/g-0/32/c-0/31
msgctxt "xxXShadowl0rd420Xxx"
msgid "Distance. A symptom."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/g-0/32/g-0/32/c-0/39
msgctxt "xxXShadowl0rd420Xxx"
msgid "And then many nights later, Lunar no longer wished to be by my side."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/g-0/32/g-0/32/c-0/50
msgctxt "xxXShadowl0rd420Xxx"
msgid "Boredom came next."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/g-0/32/g-0/32/c-0/58
msgctxt "xxXShadowl0rd420Xxx"
msgid "My friends took less and less interest in our nightly discussions."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/g-0/32/g-0/32/c-0/66
msgctxt "xxXShadowl0rd420Xxx"
msgid "They too left. One by one."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/g-0/32/g-0/32/c-0/74
msgctxt "xxXShadowl0rd420Xxx"
msgid "And then I was alone."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/g-0/32/g-0/32/c-0/82
msgctxt "xxXShadowl0rd420Xxx"
msgid "You may think it cruel of them for leaving without a proper goodbye."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/g-0/32/g-0/32/c-0/90
msgctxt "xxXShadowl0rd420Xxx"
msgid "But I respected all of my friends' decisions. Even Lunar's."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/g-0/32/g-0/32/c-0/98
msgctxt "xxXShadowl0rd420Xxx"
msgid "I don't harbor any wrathful thoughts against any of them."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/g-0/32/g-0/32/c-0/106
msgctxt "xxXShadowl0rd420Xxx"
msgid "I just think back to those days fondly."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/g-0/32/g-0/32/c-0/114
msgctxt "xxXShadowl0rd420Xxx"
msgid "And wonder why time had to come for us."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/g-0/32/g-0/32/c-0/122
msgctxt "xxXShadowl0rd420Xxx"
msgid "We were happy. I was happy."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/g-0/32/g-0/32/c-0/130/0/s/0
msgctxt "Choix"
msgid "Shadow, I'm so sorry."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/g-0/32/g-0/32/c-0/130/1/s/0
msgctxt "Choix"
msgid "This sounds made up."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/g-0/32/g-0/32/c-0/130/c-0/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Shed not a tear for me, penumbra."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/g-0/32/g-0/32/c-0/130/c-0/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "Time comes for us all in ways we don't expect."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/g-0/32/g-0/32/c-0/130/c-0/39
msgctxt "xxXShadowl0rd420Xxx"
msgid "Heh."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/g-0/32/g-0/32/c-0/130/c-0/47
msgctxt "xxXShadowl0rd420Xxx"
msgid "Normally, I'd celebrate triumphantly at obtaining another armament."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/g-0/32/g-0/32/c-0/130/c-0/55
msgctxt "xxXShadowl0rd420Xxx"
msgid "That'll be all for today, penumbra."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/g-0/32/g-0/32/c-0/130/c-0/63
msgctxt "xxXShadowl0rd420Xxx"
msgid "Thank you for listening to my tale."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/g-0/32/g-0/32/c-0/130/c-1/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "You are made up as far as I can tell."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-0/23/c-0/39/c-0/15/g-0/32/g-0/32/c-0/130/c-1/26
msgctxt "xxXShadowl0rd420Xxx"
msgid "Leave."
msgstr ""

#: shadow_darkness/Shadow_3_Cont/0/c-1/15
msgctxt "xxXShadowl0rd420Xxx"
msgid "A great emotional weight does require a large unburdening."
msgstr ""

#: shadow_darkness/Shadow_4/0/6
msgctxt "Narrator"
msgid "There's a strange heaviness to Shadowlord today—he's not his usual dark, cheery self."
msgstr ""

#: shadow_darkness/Shadow_4/0/14
msgctxt "xxXShadowl0rd420Xxx"
msgid "Dark tidings, penumbra."
msgstr ""

#: shadow_darkness/Shadow_4/0/22
msgctxt "xxXShadowl0rd420Xxx"
msgid "The news I carry may be troubling to you."
msgstr ""

#: shadow_darkness/Shadow_4/0/c-0/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "I have, uh, found the final armament piece."
msgstr ""

#: shadow_darkness/Shadow_4/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "That's great!"
msgstr ""

#: shadow_darkness/Shadow_4/0/c-0/15/1/s/0
msgctxt "Choix"
msgid "You don't sound happy..."
msgstr ""

#: shadow_darkness/Shadow_4/0/g-0/0
msgctxt "xxXShadowl0rd420Xxx"
msgid "Once I don it, my true power will be unleashed."
msgstr ""

#: shadow_darkness/Shadow_4/0/g-0/8
msgctxt "xxXShadowl0rd420Xxx"
msgid "With that, my final form shall be revealed."
msgstr ""

#: shadow_darkness/Shadow_4/0/g-0/16
msgctxt "xxXShadowl0rd420Xxx"
msgid "You may be surprised by who I become."
msgstr ""

#: shadow_darkness/Shadow_4/0/g-0/24/s/0
msgctxt "Choix"
msgid "You're still my friend, Shadow."
msgstr ""

#: shadow_darkness/Shadow_4/0/g-0/25/s/0
msgctxt "Choix"
msgid "Do your worst."
msgstr ""

#: shadow_darkness/Shadow_4/0/g-0/c-1/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "Thank you."
msgstr ""

#: shadow_darkness/Shadow_4/0/g-0/c-1/18
msgctxt "xxXShadowl0rd420Xxx"
msgid "It is imperative to me that you understand that your presence was most welcomed."
msgstr ""

#: shadow_darkness/Shadow_4/0/g-0/c-1/26
msgctxt "xxXShadowl0rd420Xxx"
msgid "Our conversations have been a highlight to my dark days."
msgstr ""

#: shadow_darkness/Shadow_4/0/g-0/c-1/34/0/s/0
msgctxt "Choix"
msgid "Highlight, huh?"
msgstr ""

#: shadow_darkness/Shadow_4/0/g-0/c-1/34/c-0/7
msgctxt "xxXShadowl0rd420Xxx"
msgid "It seems my vernacular has become more flexible as our bond tightened."
msgstr ""

#: shadow_darkness/Shadow_4/0/g-1/11
msgctxt "Narrator"
msgid "Shadowlord bows his head, falling silent for a few moments before he begins his incantation."
msgstr ""

#: shadow_darkness/Shadow_4/0/g-1/19
msgctxt "xxXShadowl0rd420Xxx"
msgid "The die is cast. Let us begin."
msgstr ""

#: shadow_darkness/Shadow_4/0/g-1/27
msgctxt "xxXShadowl0rd420Xxx"
msgid "The whispers of the void, heed my call!"
msgstr ""

#: shadow_darkness/Shadow_4/0/g-1/35
msgctxt "xxXShadowl0rd420Xxx"
msgid "Bend to my will and reforge my soul!"
msgstr ""

#: shadow_darkness/Shadow_4/0/g-1/43
msgctxt "xxXShadowl0rd420Xxx"
msgid "Let darkness incarnate reign supreme once more!"
msgstr ""

#: shadow_darkness/Shadow_4/0/g-1/57
msgctxt "Narrator"
msgid "Shadowlord vanishes from your view with a flash of black smoke."
msgstr ""

#: shadow_darkness/Shadow_4/0/g-1/62/s/0
msgctxt "Choix"
msgid "Woah!"
msgstr ""

#: shadow_darkness/Shadow_4/0/g-1/c-3/7
msgctxt "Narrator"
msgid "The Shadowlord you once knew is gone, replaced by what appears to be..."
msgstr ""

#: shadow_darkness/Shadow_4/0/g-1/c-3/15
msgctxt "???"
msgid "It is complete."
msgstr ""

#: shadow_darkness/Shadow_4/0/g-2/0
msgctxt "Narrator"
msgid "...some nerd?"
msgstr ""

#: shadow_darkness/Shadow_4/0/g-2/8/s/0
msgctxt "Choix"
msgid "Uh... Shadow?"
msgstr ""

#: shadow_darkness/Shadow_4/0/g-2/9/s/0
msgctxt "Choix"
msgid "Who are you?"
msgstr ""

#: shadow_darkness/Shadow_4/0/g-3/0
msgctxt "???"
msgid "As I suspected, you wouldn't recognize my form as it is now."
msgstr ""

#: shadow_darkness/Shadow_4/0/g-3/8
msgctxt "???"
msgid "It's me! Uh. It's me. xxXShadowl0rd420Xxx."
msgstr ""

#: shadow_darkness/Shadow_4/0/g-3/16
msgctxt "???"
msgid "But my real name is Skips."
msgstr ""

#: shadow_darkness/Shadow_4/0/g-3/24/s/0
msgctxt "Choix"
msgid "Skips??"
msgstr ""

#: shadow_darkness/Shadow_4/0/g-3/25/s/0
msgctxt "Choix"
msgid "Honestly... that sounds cool."
msgstr ""

#: shadow_darkness/Shadow_4/0/g-3/c-6/7
msgctxt "Skips"
msgid "Skips Shadley."
msgstr ""

#: shadow_darkness/Shadow_4/0/g-3/c-6/15
msgctxt "Skips"
msgid "I'm sorry for disguising myself, penumbra."
msgstr ""

#: shadow_darkness/Shadow_4/0/g-3/c-6/23 shadow_darkness/Shadow_4/0/g-3/c-7/7
msgctxt "Skips"
msgid "I thought you wouldn't take me seriously if I appeared to you like this."
msgstr ""

#: shadow_darkness/Shadow_4/0/g-3/c-6/31/0/s/0
msgctxt "Choix"
msgid "I mean your other appearance was one thing, but this..."
msgstr ""

#: shadow_darkness/Shadow_4/0/g-3/c-6/31/c-0/7
msgctxt "Skips"
msgid "It's a lot, huh."
msgstr ""

#: shadow_darkness/Shadow_4/0/g-3/c-6/31/c-0/15
msgctxt "Skips"
msgid "You have any questions?"
msgstr ""

#: shadow_darkness/Shadow_4/0/g-3/c-6/31/c-0/23/c-0/7
msgctxt "Skips"
msgid "Like déjà vu."
msgstr ""

#: shadow_darkness/Shadow_4/0/g-3/c-7/15
msgctxt "Skips"
msgid "If you have any questions... ask."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/0
msgctxt "Skips"
msgid "What do you want to know?"
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/0/s/0
msgctxt "Choix"
msgid "Who is Shadowlord, then?"
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/1/s/0
msgctxt "Choix"
msgid "Who is Skips?"
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/2/s/0
msgctxt "Choix"
msgid "Who was Lunarknight?"
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/3/s/0
msgctxt "Choix"
msgid "So was the Great Cataclysm a lie?"
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/4/s/0
msgctxt "Choix"
msgid "I think I get it now."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-0/11
msgctxt "Skips"
msgid "It's a handle."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-0/19
msgctxt "Skips"
msgid "You know, like an online name?"
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-0/27
msgctxt "Skips"
msgid "My friends and I would chat with each other online using DIM."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-0/35/0/s/0
msgctxt "Choix"
msgid "What's DIM?"
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-0/35/c-0/7
msgctxt "Skips"
msgid "Oh, DOL Instant Messenger."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-0/35/c-0/15/0/s/0
msgctxt "Choix"
msgid "Okay. What's DOL?"
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-0/35/c-0/15/c-0/7
msgctxt "Skips"
msgid "Darkness Online? Are you too young to know what that is?"
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-0/35/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "So your shadowy gatherings were all just online chatrooms?"
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-0/35/c-0/15/c-0/15/1/s/0 shadow_darkness/Shadow_4_End/0/g-0/9/s/0
msgctxt "Choix"
msgid "I guess so."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-0/35/c-0/15/c-0/15/c-0/7
msgctxt "Skips"
msgid "Yup."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-0/35/c-0/15/c-0/15/c-0/15
msgctxt "Skips"
msgid "I wasn't kidding when I said 'Shadowlord' was a popular name."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-0/35/c-0/15/c-0/15/c-0/23
msgctxt "Skips"
msgid "You know how many shades are out there?"
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-0/35/c-0/15/c-0/15/c-0/31/0/s/0
msgctxt "Choix"
msgid "But you <i>are</i> darkness right?"
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-0/35/c-0/15/c-0/15/c-0/31/c-0/7
msgctxt "Skips"
msgid "We're <i>all</i> darkness. Some work in collectives, while some occupy a whole house to themselves."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-0/35/c-0/15/c-0/15/c-1/15
msgctxt "Skips"
msgid "It was the cool place to hang. The coolest."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-0/35/c-0/15/c-0/15/c-1/23
msgctxt "Skips"
msgid "But it's gone now like so many other things..."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-1/11
msgctxt "Skips"
msgid "That's my real name. Skips Shadley."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-1/19/0/s/0
msgctxt "Choix"
msgid "So this is the real you?"
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-1/19/c-0/7
msgctxt "Skips"
msgid "Yup... told you you'd hate it."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-1/19/c-0/15/0/s/0
msgctxt "Choix"
msgid "I didn't say that."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-1/19/c-0/15/1/s/0
msgctxt "Choix"
msgid "It is kinda lame."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-1/19/c-0/15/c-0/7
msgctxt "Skips"
msgid "I'm not actually the lord of all shadows."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-1/19/c-0/15/g-0/0/0/s/0
msgctxt "Choix"
msgid "I noticed."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-1/19/c-0/15/g-0/0/c-0/7
msgctxt "Skips"
msgid "My friends and I love roleplaying, so we made characters to chat as."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-1/19/c-0/15/g-0/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "And the armaments?"
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-1/19/c-0/15/g-0/0/c-0/15/c-0/7
msgctxt "Skips"
msgid "Not real."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-1/19/c-0/15/g-0/0/c-0/15/c-0/15
msgctxt "Skips"
msgid "But wasn't it nice feeling like you were making progress?"
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-1/19/c-0/15/g-0/0/c-0/15/c-0/23/0/s/0
msgctxt "Choix"
msgid "What was the point of the rituals then?"
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-1/19/c-0/15/g-0/0/c-0/15/c-0/23/c-0/7
msgctxt "Skips"
msgid "I was..."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-1/19/c-0/15/g-0/0/c-0/15/c-0/23/c-0/15
msgctxt "Skips"
msgid "... excited to talk to someone again."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-1/19/c-0/15/g-0/0/c-0/15/c-0/23/c-0/23/0/s/0
msgctxt "Choix"
msgid "Oh."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-1/19/c-0/15/g-0/0/c-0/15/c-0/23/c-0/23/1/s/0
msgctxt "Choix"
msgid "I'm gonna cry this is so cute!"
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-1/19/c-0/15/g-0/0/c-0/15/c-0/23/c-0/23/c-0/7
msgctxt "Skips"
msgid "Sorry."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-1/19/c-0/15/g-0/0/c-0/15/c-0/23/c-0/23/c-0/15/0/s/0
msgctxt "Choix"
msgid "So shadow beings just hang out in the dark and chat online?"
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-1/19/c-0/15/g-0/0/c-0/15/c-0/23/c-0/23/c-0/15/c-0/7
msgctxt "Skips"
msgid "All shadows are imitations of something or someone."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-1/19/c-0/15/g-0/0/c-0/15/c-0/23/c-0/23/c-0/15/c-0/15
msgctxt "Skips"
msgid "For me - it's this globe I found..."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-1/19/c-0/15/g-0/0/c-0/15/c-0/23/c-0/23/c-0/15/c-0/23
msgctxt "Skips"
msgid "When I joined with it I thought it would help me take over the world..."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-1/19/c-0/15/g-0/0/c-0/15/c-0/23/c-0/23/c-1/7
msgctxt "Skips"
msgid "Ah gross!"
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-1/19/c-0/15/g-0/0/c-0/15/c-0/23/c-0/23/c-1/15
msgctxt "Skips"
msgid "Er... well..."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-1/19/c-0/15/g-0/0/c-0/15/c-0/23/c-0/23/c-1/23
msgctxt "Skips"
msgid "Maybe that's okay."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-2/11
msgctxt "Skips"
msgid "His name was Benji."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-2/19
msgctxt "Skips"
msgid "...<i>is</i> Benji."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-2/27
msgctxt "Skips"
msgid "He's the one who invited me to the group."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-2/35/0/s/0
msgctxt "Choix"
msgid "The group?"
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-2/35/c-0/7
msgctxt "Skips"
msgid "The chatroom."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-2/35/c-0/15
msgctxt "Skips"
msgid "He was really encouraging with everyone's roleplay."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-2/35/c-0/23
msgctxt "Skips"
msgid "Especially mine."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-2/35/c-0/31/0/s/0
msgctxt "Choix"
msgid "Did you ever meet in real life?"
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-2/35/c-0/31/1/s/0
msgctxt "Choix"
msgid "Do you miss him?"
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-2/35/c-0/31/c-0/7
msgctxt "Skips"
msgid "Yes. It was nice."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-2/35/c-0/31/c-0/15
msgctxt "Skips"
msgid "There was an eclipse and... we were able to join our forms."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-2/35/c-0/31/c-0/23 shadow_darkness/Shadow_4_Questions/0/9/8/c-2/35/c-0/31/c-1/23
msgctxt "Skips"
msgid "I hope wherever he is, he's happy."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-2/35/c-0/31/c-1/7
msgctxt "Skips"
msgid "I think I miss our time together more so than him."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-2/35/c-0/31/c-1/15
msgctxt "Skips"
msgid "Does that make sense?"
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-2/35/c-0/31/g-0/0/0/s/0
msgctxt "Choix"
msgid "That's very mature of you."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-2/35/c-0/31/g-0/0/1/s/0
msgctxt "Choix"
msgid "He probably misses you, too."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-2/35/c-0/31/g-0/0/c-0/7
msgctxt "Skips"
msgid "Yeah well, I've had a lot of time to think about it."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-2/35/c-0/31/g-0/0/c-0/15
msgctxt "Skips"
msgid "I still get bummed out though, but that's just my mind taking negative nosedives every now and then."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-2/35/c-0/31/g-0/0/c-0/23/0/s/0
msgctxt "Choix"
msgid "I hear ya."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-2/35/c-0/31/g-0/0/c-0/23/c-0/7
msgctxt "Skips"
msgid "I figured you would."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-2/35/c-0/31/g-0/0/c-1/7
msgctxt "Skips"
msgid "Yeah, probably."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-3/11
msgctxt "Skips"
msgid "That was actually the most accurate thing I've said."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-3/19/0/s/0
msgctxt "Choix"
msgid "You had a rift with your friends."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-3/19/c-0/7
msgctxt "Skips"
msgid "It was slow and sudden at the same time."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-3/19/c-0/15
msgctxt "Skips"
msgid "Maybe it was happening the whole time, but I didn't notice."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-3/19/c-0/23
msgctxt "Skips"
msgid "But it doesn't matter."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-3/19/c-0/31
msgctxt "Skips"
msgid "The fact is my friends all stopped hanging out with me."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-3/19/c-0/39
msgctxt "Skips"
msgid "We just grew apart."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-3/19/c-0/47/0/s/0
msgctxt "Choix"
msgid "That's life."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-3/19/c-0/47/1/s/0
msgctxt "Choix"
msgid "Probably because you got older..."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-3/19/c-0/47/c-0/7
msgctxt "Skips"
msgid "Guess I was hoping that didn't apply to me."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-3/19/c-0/47/c-0/15
msgctxt "Skips"
msgid "Being unalive and all."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-3/19/c-0/47/c-0/23/0/s/0
msgctxt "Choix"
msgid "Fair."
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-3/19/c-0/47/c-0/23/1/s/0
msgctxt "Choix"
msgid "Ha!"
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-3/19/c-0/47/g-0/0
msgctxt "Skips"
msgid "How do you accept that your friends aren't your friends anymore?"
msgstr ""

#: shadow_darkness/Shadow_4_Questions/0/9/8/c-3/19/c-0/47/g-0/8
msgctxt "Skips"
msgid "A question for another time..."
msgstr ""

#: shadow_darkness/Shadow_4_End/0/3
msgctxt "Skips"
msgid "So... are you mad at me?"
msgstr ""

#: shadow_darkness/Shadow_4_End/0/11/s/0
msgctxt "Choix"
msgid "No."
msgstr ""

#: shadow_darkness/Shadow_4_End/0/12/s/0
msgctxt "Choix"
msgid "Maybe a little."
msgstr ""

#: shadow_darkness/Shadow_4_End/0/c-0/7
msgctxt "Skips"
msgid "Cool."
msgstr ""

#: shadow_darkness/Shadow_4_End/0/c-1/7
msgctxt "Skips"
msgid "I get it."
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-0/0
msgctxt "Skips"
msgid "Do you still want to hang out with me?"
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-0/8/s/0
msgctxt "Choix"
msgid "Of course."
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-0/c-2/7
msgctxt "Skips"
msgid "That makes me happy."
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-0/c-3/7
msgctxt "Skips"
msgid "Hmm..."
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-1/0/s/0
msgctxt "Choix"
msgid "So what do you want to do?"
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-1/c-4/7
msgctxt "Skips"
msgid "We can do whatever."
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-1/c-4/18
msgctxt "Skips"
msgid "Chat, play hangman, chill."
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-1/c-4/26
msgctxt "Skips"
msgid "After all, we don't have to worry about time anymore."
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-1/c-4/34/0/s/0
msgctxt "Choix"
msgid "Why's that?"
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-1/c-4/34/c-0/7
msgctxt "Skips"
msgid "Because I'm going to turn you into a shadow."
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-1/c-4/34/c-0/15/0/s/0
msgctxt "Choix"
msgid "I'm sorry?"
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-2/0
msgctxt "Skips"
msgid "Now that I'm up to full power I can reconfigure you."
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-2/8
msgctxt "Skips"
msgid "That way, we'll be together forever."
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-2/16/s/0
msgctxt "Choix"
msgid "I thought the armor thing was made up!"
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-2/17/s/0
msgctxt "Choix"
msgid "You can't just turn me into darkness!"
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-2/c-5/7
msgctxt "Skips"
msgid "Yeah, but the powers of darkness are very real."
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-2/c-5/15
msgctxt "Skips"
msgid "Now become untethered and enter the void!"
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-2/c-6/7
msgctxt "Skips"
msgid "Why not? Didn't you say you still want to hang out with me?"
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-3/0/s/0
msgctxt "Choix"
msgid "Not like this!"
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-3/c-7/7
msgctxt "Skips"
msgid "It'll be fine!"
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-3/c-7/15
msgctxt "Skips"
msgid "You're not like the others."
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-3/c-7/23
msgctxt "Skips"
msgid "You won't leave me like they did. Like Benji did."
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-3/c-7/31
msgctxt "Skips"
msgid "And we'll be together forever."
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-3/c-7/42
msgctxt "Skips"
msgid "Trust me."
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-3/c-7/50/0/s/0
msgctxt "Choix"
msgid "Okay. Shadow time."
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-3/c-7/50/1/s/0
msgctxt "Choix"
msgid "You need to move on!"
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-3/c-7/50/2/s/0
msgctxt "Choix"
msgid "I can't do something that makes no sense!"
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-3/c-7/50/c-0/11
msgctxt "Skips"
msgid "You chose correctly."
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-3/c-7/50/c-1/27
msgctxt "Skips"
msgid "It's been so lonely."
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-3/c-7/50/c-1/35/0/s/0
msgctxt "Choix"
msgid "I know."
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-3/c-7/50/c-1/35/c-0/7
msgctxt "Skips"
msgid "And I really like talking with you."
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-3/c-7/50/c-1/35/c-0/15
msgctxt "Skips"
msgid "I'm sorry. I didn't mean to..."
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-3/c-7/50/c-1/35/c-0/31
msgctxt "Skips"
msgid "Do you think we'll drift apart one day?"
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-3/c-7/50/c-1/35/c-0/39/0/s/0
msgctxt "Choix"
msgid "It's possible. But I hope not."
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-3/c-7/50/c-1/35/c-0/39/c-0/7
msgctxt "Skips"
msgid "Yeah. Me too."
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-3/c-7/50/c-1/35/c-0/39/c-0/15
msgctxt "Skips"
msgid "I'd like to be alone right now, if that's okay."
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-3/c-7/50/c-1/35/c-0/39/c-0/23
msgctxt "Skips"
msgid "I have a lot to think about."
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-3/c-7/50/c-1/35/c-0/39/c-0/31
msgctxt "Skips"
msgid "See ya."
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-3/c-7/50/c-2/11
msgctxt "Skips"
msgid "As if talking to objects makes sense??"
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-3/c-7/50/c-2/19
msgctxt "Skips"
msgid "Don't you believe in my power?"
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-3/c-7/50/c-2/27/0/s/0
msgctxt "Choix"
msgid "I don't believe anything you say."
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-3/c-7/50/c-2/27/1/s/0
msgctxt "Choix"
msgid "Skips, come on."
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-3/c-7/50/c-2/27/2/s/0
msgctxt "Choix"
msgid "I'm outta here!"
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-3/c-7/50/c-2/27/c-0/7
msgctxt "Skips"
msgid "You really don't want to be with me?"
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-3/c-7/50/c-2/27/c-0/15
msgctxt "Skips"
msgid "Fine! Screw off then!"
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-3/c-7/50/c-2/27/c-0/26
msgctxt "Skips"
msgid "Who needs you anyway!?"
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-3/c-7/50/c-2/27/c-1/7
msgctxt "Skips"
msgid "That's xxXShadowl0rd420Xxx to you, penumbra!"
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-3/c-7/50/c-2/27/c-1/18
msgctxt "Skips"
msgid "And you were only ever a satellite in my dark periphery."
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-3/c-7/50/c-2/27/c-1/26
msgctxt "Skips"
msgid "Now begone!"
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-3/c-7/50/c-2/27/c-1/37
msgctxt "Skips"
msgid "Don't make me summon the silverfish again."
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-3/c-7/50/c-2/27/c-2/7
msgctxt "Skips"
msgid "Go ahead, RUN!"
msgstr ""

#: shadow_darkness/Shadow_4_End/0/g-3/c-7/50/c-2/27/c-2/15
msgctxt "Skips"
msgid "The next time we meet, you'll realize your mistake!"
msgstr ""

#: shadow_darkness/Shadow_ritual/0/0
msgctxt "Skips"
msgid "Now, let the dark ritual commence!"
msgstr ""

#: shadow_darkness/Shadow_ritual/0/8
msgctxt "Narrator"
msgid "Skips holds his hand out to you."
msgstr ""

#: shadow_darkness/Shadow_ritual/0/16
msgctxt "Skips"
msgid "Penumbra, join hands with me!"
msgstr ""

#: shadow_darkness/Shadow_ritual/0/24
msgctxt "Narrator"
msgid "You take his hand as directed—it's hard to tell, but you could swear you see a blush spread across his cheeks."
msgstr ""

#: shadow_darkness/Shadow_ritual/0/40
msgctxt "Skips"
msgid "Excellent."
msgstr ""

#: shadow_darkness/Shadow_ritual/0/48
msgctxt "Skips"
msgid "<w>Be untethered from the warmth of light and submit thy soul to the chill of night!</w>"
msgstr ""

#: shadow_darkness/Shadow_ritual/0/59
msgctxt "Skips"
msgid "<w>Be one with the darkness!</w>"
msgstr ""

#: shadow_darkness/Shadow_ritual/0/73
msgctxt "Narrator"
msgid "Skips's grand incantation ends, but there's no puff of smoke or flash of light. You certainly don't <w>feel</w> any different."
msgstr ""

#: shadow_darkness/Shadow_ritual/0/89/s/0
msgctxt "Choix"
msgid "...did it work?"
msgstr ""

#: shadow_darkness/Shadow_ritual/0/90/s/0
msgctxt "Choix"
msgid "I thought as much.. Guess I can't be a shadow."
msgstr ""

#: shadow_darkness/Shadow_ritual/0/c-0/7
msgctxt "Skips"
msgid "This can't be..."
msgstr ""

#: shadow_darkness/Shadow_ritual/0/c-0/15
msgctxt "Skips"
msgid "Why isn't it working? Aren't you fully attuned with the shadows?"
msgstr ""

#: shadow_darkness/Shadow_ritual/0/g-0/0
msgctxt "Skips"
msgid "No, that's not right."
msgstr ""

#: shadow_darkness/Shadow_ritual/0/g-0/8
msgctxt "Skips"
msgid "If you can't become a shadow, how can we truly be together?"
msgstr ""

#: shadow_darkness/Shadow_ritual/0/g-0/16/s/0
msgctxt "Choix"
msgid "Skips, it's fine."
msgstr ""

#: shadow_darkness/Shadow_ritual/0/g-0/17/s/0
msgctxt "Choix"
msgid "I have a life too."
msgstr ""

#: shadow_darkness/Shadow_ritual/0/g-0/c-2/7
msgctxt "Skips"
msgid "For you it is!"
msgstr ""

#: shadow_darkness/Shadow_ritual/0/g-0/c-2/15
msgctxt "Skips"
msgid "You have so many other friends to talk to!"
msgstr ""

#: shadow_darkness/Shadow_ritual/0/g-0/c-2/26
msgctxt "Skips"
msgid "I only have you."
msgstr ""

#: shadow_darkness/Shadow_ritual/0/g-0/c-2/34
msgctxt "Skips"
msgid "Why do you have to go in the morning?"
msgstr ""

#: shadow_darkness/Shadow_ritual/0/g-0/c-2/42
msgctxt "Skips"
msgid "Why can't you just stay and be with me?"
msgstr ""

#: shadow_darkness/Shadow_ritual/0/g-0/c-3/7 shadow_darkness/Shadow_5_B/0/g-0/c-2/63/c-0/7
msgctxt "Skips"
msgid "I know..."
msgstr ""

#: shadow_darkness/Shadow_ritual/0/g-0/c-3/15
msgctxt "Skips"
msgid "I just need to think."
msgstr ""

#: shadow_darkness/Shadow_ritual/0/g-0/c-3/23
msgctxt "Skips"
msgid "Just go."
msgstr ""

#: shadow_darkness/Shadow_ritual/0/g-0/c-3/31
msgctxt "Skips"
msgid "Come back later. If you feel like it."
msgstr ""

#: shadow_darkness/Omega_Shadow/0/0
msgctxt "Narrator"
msgid "You can feel Skips is here, but you can't see him—it's all too reminiscent of your first meeting."
msgstr ""

#: shadow_darkness/Omega_Shadow/0/7
msgctxt "???"
msgid "Dismantled and reconstituted within the void, darkness is born anew!"
msgstr ""

#: shadow_darkness/Omega_Shadow/0/12
msgctxt "???"
msgid "Behold, fragile mortal. Your new emperor of shadows is here."
msgstr ""

#: shadow_darkness/Omega_Shadow/0/23
msgctxt "Narrator"
msgid "It appears that Skips is back to his old Shadowlord look... but someone has cranked the 'edge' dial up to eleven."
msgstr ""

#: shadow_darkness/Omega_Shadow/0/31
msgctxt "xxXOmegaShadowl0rd42069Xxx"
msgid "<w>xxXOmegaShadowl0rd42069Xxx!</w>"
msgstr ""

#: shadow_darkness/Omega_Shadow/0/39/s/0
msgctxt "Choix"
msgid "Uh..."
msgstr ""

#: shadow_darkness/Omega_Shadow/0/40/s/0
msgctxt "Choix"
msgid "Skips, what happened to you?"
msgstr ""

#: shadow_darkness/Omega_Shadow/0/g-0/3
msgctxt "xxXOmegaShadowl0rd42069Xxx"
msgid "If isn't my former penumbra."
msgstr ""

#: shadow_darkness/Omega_Shadow/0/g-0/14
msgctxt "xxXOmegaShadowl0rd42069Xxx"
msgid "Oh how little you matter now."
msgstr ""

#: shadow_darkness/Omega_Shadow/0/g-0/22
msgctxt "xxXOmegaShadowl0rd42069Xxx"
msgid "Are you frightened by my new form? My awesome power?"
msgstr ""

#: shadow_darkness/Omega_Shadow/0/g-0/30/s/0
msgctxt "Choix"
msgid "Dude, your new handle..."
msgstr ""

#: shadow_darkness/Omega_Shadow/0/g-0/31/s/0
msgctxt "Choix"
msgid "What did I do?"
msgstr ""

#: shadow_darkness/Omega_Shadow/0/g-0/c-2/7
msgctxt "xxXOmegaShadowl0rd42069Xxx"
msgid "I am not the lord of shadows you once knew."
msgstr ""

#: shadow_darkness/Omega_Shadow/0/g-0/c-2/15
msgctxt "xxXOmegaShadowl0rd42069Xxx"
msgid "I have evolved into a being of unimaginable darkness."
msgstr ""

#: shadow_darkness/Omega_Shadow/0/g-0/c-2/23
msgctxt "xxXOmegaShadowl0rd42069Xxx"
msgid "And it's all thanks to you."
msgstr ""

#: shadow_darkness/Omega_Shadow/0/g-0/c-3/7
msgctxt "xxXOmegaShadowl0rd42069Xxx"
msgid "You released the shackles that kept my heart away from true darkness."
msgstr ""

#: shadow_darkness/Omega_Shadow/0/g-0/c-3/15
msgctxt "xxXOmegaShadowl0rd42069Xxx"
msgid "And now I have no use for you."
msgstr ""

#: shadow_darkness/Omega_Shadow/0/g-1/0
msgctxt "xxXOmegaShadowl0rd42069Xxx"
msgid "Know this: from every moment you rest in the dark, to standing in a shadow for protection from the light..."
msgstr ""

#: shadow_darkness/Omega_Shadow/0/g-1/8
msgctxt "xxXOmegaShadowl0rd42069Xxx"
msgid "...I will be there. Feeding off of your fear."
msgstr ""

#: shadow_darkness/Omega_Shadow/0/g-1/16/s/0
msgctxt "Choix"
msgid "Can you chill?"
msgstr ""

#: shadow_darkness/Omega_Shadow/0/g-1/17/s/0 shadow_darkness/shadow_hate_return/0/8/s/0
msgctxt "Choix"
msgid "No!"
msgstr ""

#: shadow_darkness/Omega_Shadow/0/g-2/0
msgctxt "xxXOmegaShadowl0rd42069Xxx"
msgid "Witness my newfound power for the first and final time!"
msgstr ""

#: shadow_darkness/Omega_Shadow/0/g-2/11
msgctxt "xxXOmegaShadowl0rd42069Xxx"
msgid "<w><b>Umbra Void Maximum!</w></b>"
msgstr ""

#: shadow_darkness/Omega_Shadow/0/g-2/22
msgctxt "Narrator"
msgid "Skips... OmegaShadowlord vanishes, but his voice grates even in his physical absence."
msgstr ""

#: shadow_darkness/Omega_Shadow/0/g-2/27
msgctxt "xxXOmegaShadowl0rd42069Xxx"
msgid "Farewell."
msgstr ""

#: shadow_darkness/Omega_Shadow/0/g-2/32
msgctxt "xxXOmegaShadowl0rd42069Xxx"
msgid "<w>Fwa ha ha ha ha!</w>"
msgstr ""

#: shadow_darkness/Omega_Shadow/0/g-2/83
msgctxt "Reggie"
msgid "The fuck was that?"
msgstr ""

#: shadow_darkness/Shadow_5_A/0/3
msgctxt "Skips"
msgid "Hey..."
msgstr ""

#: shadow_darkness/Shadow_5_A/0/11/s/0
msgctxt "Choix"
msgid "Good evening, oh dark and powerful one!"
msgstr ""

#: shadow_darkness/Shadow_5_A/0/c-0/7
msgctxt "Skips"
msgid "You don't have to do that."
msgstr ""

#: shadow_darkness/Shadow_5_A/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "But you're <i>the</i> Shadowlord!"
msgstr ""

#: shadow_darkness/Shadow_5_A/0/c-0/15/c-0/7
msgctxt "Skips"
msgid "If I was so powerful, you'd be a shadow."
msgstr ""

#: shadow_darkness/Shadow_5_A/0/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "Is it so bad that I'm not?"
msgstr ""

#: shadow_darkness/Shadow_5_A/0/c-0/15/c-0/15/1/s/0
msgctxt "Choix"
msgid "We can still be together, y'know?"
msgstr ""

#: shadow_darkness/Shadow_5_A/0/c-0/15/c-0/15/c-0/7
msgctxt "Skips"
msgid "No. You're perfect."
msgstr ""

#: shadow_darkness/Shadow_5_A/0/c-0/15/c-0/15/c-1/7
msgctxt "Skips"
msgid "Sorry. I'm just..."
msgstr ""

#: shadow_darkness/Shadow_5_A/0/c-0/15/c-0/15/c-1/15
msgctxt "Skips"
msgid "...so scared to lose someone again."
msgstr ""

#: shadow_darkness/Shadow_5_A/0/c-0/15/c-0/15/c-1/23/b/1
msgctxt "Skips"
msgid "Every time you go, I think \"what if he doesn't come back?\""
msgstr ""

#: shadow_darkness/Shadow_5_A/0/c-0/15/c-0/15/c-1/24/b/1
msgctxt "Skips"
msgid "Every time you go, I think \"what if she doesn't come back?\""
msgstr ""

#: shadow_darkness/Shadow_5_A/0/c-0/15/c-0/15/c-1/25/b/1
msgctxt "Skips"
msgid "Every time you go, I think \"what if they don't come back?\""
msgstr ""

#: shadow_darkness/Shadow_5_A/0/c-0/15/c-0/15/c-1/28
msgctxt "Skips"
msgid "...but my fears subside when you return."
msgstr ""

#: shadow_darkness/Shadow_5_A/0/g-0/0
msgctxt "Skips"
msgid "Why do you keep coming back?"
msgstr ""

#: shadow_darkness/Shadow_5_A/0/g-0/8/s/0
msgctxt "Choix"
msgid "Because I love you, dummy."
msgstr ""

#: shadow_darkness/Shadow_5_A/0/g-0/9/s/0
msgctxt "Choix"
msgid "Because I think you're cool... in your own way."
msgstr ""

#: shadow_darkness/Shadow_5_A/0/g-0/c-1/15
msgctxt "Skips"
msgid "...I see."
msgstr ""

#: shadow_darkness/Shadow_5_A/0/g-0/c-1/23
msgctxt "Skips"
msgid "If that's the case..."
msgstr ""

#: shadow_darkness/Shadow_5_A/0/g-0/c-1/31
msgctxt "Skips"
msgid "...I've grown fond of you as well, penumbra."
msgstr ""

#: shadow_darkness/Shadow_5_A/0/g-0/c-1/42/0/s/0
msgctxt "Choix"
msgid "I'll think of you always throughout my days."
msgstr ""

#: shadow_darkness/Shadow_5_A/0/g-0/c-1/42/c-0/7
msgctxt "Skips"
msgid "And I of you through and beyond my nights."
msgstr ""

#: shadow_darkness/Shadow_5_A/0/g-0/c-1/42/c-0/18
msgctxt "Skips"
msgid "Heh."
msgstr ""

#: shadow_darkness/Shadow_5_A/0/g-0/c-1/42/c-0/26
msgctxt "Skips"
msgid "This is lovely."
msgstr ""

#: shadow_darkness/Shadow_5_A/0/g-0/c-1/42/c-0/34
msgctxt "Skips"
msgid "Your warmth."
msgstr ""

#: shadow_darkness/Shadow_5_A/0/g-0/c-1/42/c-0/42/0/s/0
msgctxt "Choix"
msgid "You are so cool."
msgstr ""

#: shadow_darkness/Shadow_5_A/0/g-0/c-1/42/c-0/42/1/s/0 shadow_darkness/Shadow_5_A/0/g-0/c-2/23/1/s/0
msgctxt "Choix"
msgid "You're such a dork."
msgstr ""

#: shadow_darkness/Shadow_5_A/0/g-0/c-1/42/c-0/42/c-1/15 shadow_darkness/Shadow_5_A/0/g-0/c-2/23/c-1/15
msgctxt "Skips"
msgid "I know."
msgstr ""

#: shadow_darkness/Shadow_5_A/0/g-0/c-1/42/c-0/42/c-1/23 shadow_darkness/Shadow_5_A/0/g-0/c-2/23/c-1/23
msgctxt "Skips"
msgid "And so are you."
msgstr ""

#: shadow_darkness/Shadow_5_A/0/g-0/c-1/42/c-0/42/g-0/0
msgctxt "Skips"
msgid "Now, what sinister ideology shall we deliberate on tonight?"
msgstr ""

#: shadow_darkness/Shadow_5_A/0/g-0/c-2/7
msgctxt "Skips"
msgid "Really...?"
msgstr ""

#: shadow_darkness/Shadow_5_A/0/g-0/c-2/15
msgctxt "Skips"
msgid "I do like being cool."
msgstr ""

#: shadow_darkness/Shadow_5_A/0/g-0/c-2/23/0/s/0
msgctxt "Choix"
msgid "You are!"
msgstr ""

#: shadow_darkness/Shadow_5_A/0/g-0/c-2/23/c-0/7
msgctxt "Skips"
msgid "Well..."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/3
msgctxt "Skips"
msgid "Oh. Hey."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/11 shadow_darkness/shadow_lovereturn/0/11
msgctxt "Skips"
msgid "Did you sleep well?"
msgstr ""

#: shadow_darkness/Shadow_5_B/0/19/s/0
msgctxt "Choix"
msgid "It was alright."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/20/s/0
msgctxt "Choix"
msgid "Not really..."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/c-0/7
msgctxt "Skips"
msgid "Good."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/c-1/7
msgctxt "Skips"
msgid "Tell me about it..."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-0/0
msgctxt "Skips"
msgid "I was thinking about you."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-0/8
msgctxt "Skips"
msgid "If you've been getting better rest since our first talks..."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-0/16
msgctxt "Skips"
msgid "Communing better with the darkness."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-0/24
msgctxt "Skips"
msgid "And I thought... what if I ruined it last time?"
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-0/35/s/0
msgctxt "Choix"
msgid "You're okay, Skips."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-0/c-2/7
msgctxt "Skips"
msgid "Okay. If you say so."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-0/c-2/23
msgctxt "Skips"
msgid "Again, I'm really sorry about, uh, trying to turn you into a shadow."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-0/c-2/31
msgctxt "Skips"
msgid "When you first spoke to me, I was so excited."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-0/c-2/39
msgctxt "Skips"
msgid "You were the first person to talk to me in ages and played along when I was Shadowlord."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-0/c-2/47
msgctxt "Skips"
msgid "And when I thought about how painful it was losing Benji and everyone..."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-0/c-2/55
msgctxt "Skips"
msgid "...I didn't want to lose you too."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-0/c-2/63/0/s/0
msgctxt "Choix"
msgid "I'm here..."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-0/c-2/63/1/s/0
msgctxt "Choix"
msgid "That won't happen!"
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-0/c-2/63/c-1/7
msgctxt "Skips"
msgid "...thank you."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-1/0
msgctxt "Skips"
msgid "But I realized something."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-1/8
msgctxt "Skips"
msgid "My biggest fear has always been time. Time spent with those I cherish."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-1/16
msgctxt "Skips"
msgid "And time taking that away..."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-1/24
msgctxt "Skips"
msgid "But I shouldn't be afraid of time."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-1/32
msgctxt "Skips"
msgid "I should be celebrating it!"
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-1/40/s/0
msgctxt "Choix"
msgid "Yes!"
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-1/41/s/0
msgctxt "Choix"
msgid "There's so much out there..."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-1/c-3/7
msgctxt "Skips"
msgid "I will always miss the old days, but I've got so much more to look forward to!"
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-1/c-4/7
msgctxt "Skips"
msgid "I'll hit up DIM and find some new friends to talk to."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-2/0
msgctxt "Skips"
msgid "I shouldn't be afraid to make new memories!"
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-2/8/s/0
msgctxt "Choix"
msgid "I bet there's a <i>Thiscord</i> server you could join."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-2/9/s/0
msgctxt "Choix"
msgid "You might lose them too one day, but for now you can fill yourself with so much love."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-2/c-5/11
msgctxt "Skips"
msgid "I'll have to learn what that is! I really am behind the times, huh."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-2/c-5/19
msgctxt "Skips"
msgid "With all that too, I hope you'll still stop by for a chat."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-2/c-5/27/0/s/0
msgctxt "Choix"
msgid "Of course!"
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-2/c-5/27/c-0/7
msgctxt "Skips"
msgid "Sweet!"
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-2/c-5/27/c-0/15
msgctxt "Skips"
msgid "Thanks. For everything."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-2/c-6/7
msgctxt "Skips"
msgid "You really are a shining light in my cold dark world."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-3/8
msgctxt "Skips"
msgid "Hey. Can I make another confession?"
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-3/16/s/0
msgctxt "Choix"
msgid "Oh no... is Skips a fake identity too??"
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-3/17/s/0
msgctxt "Choix"
msgid "You're so mysterious..."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-3/c-7/7
msgctxt "Skips"
msgid "No! Haha, there's no one else behind me."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-3/c-8/7
msgctxt "Skips"
msgid "Heh. I know."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-4/0
msgctxt "Skips"
msgid "So..."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-4/8
msgctxt "Skips"
msgid "... sorry, it's just..."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-4/24
msgctxt "Skips"
msgid "Come on..."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-4/32/s/0
msgctxt "Choix"
msgid "What would xxXShadowl0rd420Xxx say?"
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-4/c-9/7
msgctxt "Skips"
msgid "Huh?"
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-4/c-9/15
msgctxt "Skips"
msgid "Oh!"
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-4/c-9/23
msgctxt "Skips"
msgid "Ahem."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-4/c-9/31
msgctxt "Skips"
msgid "Although my dark core is frozen, I admit to growing fond of you by my side, penumbra."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-4/c-9/39
msgctxt "Skips"
msgid "Will you eclipse your heart over mine?"
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-4/c-9/50/0/s/0
msgctxt "Choix"
msgid "If that was a love confession... I'm flattered. But no."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-4/c-9/50/1/s/0
msgctxt "Choix"
msgid "I thought you'd never ask!"
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-4/c-9/50/c-0/7
msgctxt "Skips"
msgid "...I understand."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-4/c-9/50/c-0/15
msgctxt "Skips"
msgid "Thank you for your honesty."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-4/c-9/50/c-0/23
msgctxt "Skips"
msgid "And thank you for letting me step out of the shadows for once."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-4/c-9/50/c-0/31/b/1
msgctxt "Skips"
msgid "So, can you teach me about your <w>Thiscord</w>...?"
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-4/c-9/50/c-1/7
msgctxt "Skips"
msgid "Oh! Sure!"
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-4/c-9/50/c-1/15
msgctxt "Skips"
msgid "I did though!"
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-4/c-9/50/c-1/23
msgctxt "Skips"
msgid "You need not reciprocate right away."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-4/c-9/50/c-1/31/0/s/0
msgctxt "Choix"
msgid "I'm ready for you, Skips."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-4/c-9/50/c-1/31/1/s/0
msgctxt "Choix"
msgid "Thank you for confessing to me."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-4/c-9/50/c-1/31/c-1/7
msgctxt "Skips"
msgid "Thanks for letting me!"
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-4/c-9/50/c-1/31/g-0/0
msgctxt "Skips"
msgid "Hehe."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-4/c-9/50/c-1/31/g-0/8
msgctxt "Skips"
msgid "I don't know why, but I'm just so happy."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-4/c-9/50/c-1/31/g-0/19
msgctxt "Skips"
msgid "It feels nice to get it off my chest."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-4/c-9/50/c-1/31/g-0/27
msgctxt "Skips"
msgid "So what now?"
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-4/c-9/50/c-1/31/g-0/35/0/s/0
msgctxt "Choix"
msgid "Let's get you on <i>Thiscord</i>."
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-4/c-9/50/c-1/31/g-0/35/c-0/7
msgctxt "Skips"
msgid "Sounds exciting!"
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-4/c-9/50/c-1/31/g-0/35/c-0/15
msgctxt "Skips"
msgid "Wait... what the hell?!"
msgstr ""

#: shadow_darkness/Shadow_5_B/0/g-4/c-9/50/c-1/31/g-0/35/c-0/26
msgctxt "Skips"
msgid "I think the name \"xxXShadowl0rd420Xxx\" is taken???"
msgstr ""

#: shadow_darkness/shadow_lovereturn/0/0
msgctxt "Skips"
msgid "Hey you!"
msgstr ""

#: shadow_darkness/shadow_lovereturn/0/19/s/0
msgctxt "Choix"
msgid "I did!"
msgstr ""

#: shadow_darkness/shadow_lovereturn/0/20/s/0
msgctxt "Choix"
msgid "Skips, I'm ready to Realize you."
msgstr ""

#: shadow_darkness/shadow_lovereturn/0/c-0/7
msgctxt "Skips"
msgid "I made sure the silverfish wouldn't bother ya!"
msgstr ""

#: shadow_darkness/shadow_lovereturn/0/c-0/15
msgctxt "Narrator"
msgid "Skips always shows his love for you in the most creative ways."
msgstr ""

#: shadow_darkness/shadow_friendshipreturn/0/8
msgctxt "xxXShadowl0rd420Xxx"
msgid "My friends and I are watching horror movies on <w>Duscord</w>."
msgstr ""

#: shadow_darkness/shadow_friendshipreturn/0/16
msgctxt "xxXShadowl0rd420Xxx"
msgid "Wanna join us?"
msgstr ""

#: shadow_darkness/shadow_friendshipreturn/0/24/s/0
msgctxt "Choix"
msgid "You know it, my immortal!"
msgstr ""

#: shadow_darkness/shadow_friendshipreturn/0/25/s/0
msgctxt "Choix"
msgid "Actually... I'm ready to Realize you."
msgstr ""

#: shadow_darkness/shadow_friendshipreturn/0/c-0/7
msgctxt "Narrator"
msgid "It's good, spooky fun with your ever-shadowed friend."
msgstr ""

#: shadow_darkness/skips_realize_join/0/6
msgctxt "Skips"
msgid "I can walk into the light? For real?"
msgstr ""

#: shadow_darkness/skips_realize_join/0/26/s/0 shadow_darkness/shadow_realize_join/0/70/s/0
msgctxt "Choix"
msgid "Yeah!"
msgstr ""

#: shadow_darkness/skips_realize_join/0/27/s/0 shadow_darkness/shadow_realize_join/0/71/s/0
msgctxt "Choix"
msgid "Well... not yet."
msgstr ""

#: shadow_darkness/skips_realize_join/0/c-0/13/b/1 shadow_darkness/shadow_realize_return/0/c-0/13/b/1 shadow_darkness/shadow_realize_join/0/c-0/13/b/1
msgctxt "Skips"
msgid "But... it's not light out. Come back when it's light, okay? I want the first thing I see to be the sun."
msgstr ""

#: shadow_darkness/skips_realize_join/0/c-1/10 shadow_darkness/shadow_realize_join/0/c-1/10
msgctxt "Skips"
msgid "Oh."
msgstr ""

#: shadow_darkness/skips_realize_join/0/c-1/18 shadow_darkness/shadow_realize_return/0/c-1/10 shadow_darkness/shadow_realize_join/0/c-1/18
msgctxt "Skips"
msgid "Lemme know when you do have everything then. In the meantime... I'll think about what it'll be like to live... out there..."
msgstr ""

#: shadow_darkness/shadow_realize_return/0/0
msgctxt "Skips"
msgid "You're back? You have what you need?"
msgstr ""

#: shadow_darkness/shadow_realize_return/0/17/s/0
msgctxt "Choix"
msgid "I do."
msgstr ""

#: shadow_darkness/shadow_realize_return/0/18/s/0
msgctxt "Choix"
msgid "I do not."
msgstr ""

#: shadow_darkness/shadow_realization/3/b/1
msgctxt "Skylar"
msgid "Can we Realize the absence of light itself? I sure hope this Realization thing works..."
msgstr ""

#: shadow_darkness/shadow_realization/6
msgctxt "Skylar"
msgid "Let there be Shadow!"
msgstr ""

#: shadow_darkness/shadow_realization/20
msgctxt "Narrator"
msgid "The spectral energy flows through your dateviators, and what was once merely a shadow, becomes...."
msgstr ""

#: shadow_darkness/shadow_realized/0/0
msgctxt "Skips"
msgid "I feel so... warm..."
msgstr ""

#: shadow_darkness/shadow_realized/0/8
msgctxt "Narrator"
msgid "Skips looks up at the sun for the first time, stretching his now-human hand towards it in wonder."
msgstr ""

#: shadow_darkness/shadow_realized/0/16
msgctxt "Skips"
msgid "It's so... beautiful."
msgstr ""

#: shadow_darkness/shadow_realized/0/27/s/0
msgctxt "Choix"
msgid "Don't look at the sun too long..."
msgstr ""

#: shadow_darkness/shadow_realized/0/28/s/0
msgctxt "Choix"
msgid "Glad to see you so happy."
msgstr ""

#: shadow_darkness/shadow_realized/0/29/s/0
msgctxt "Choix"
msgid "Not as beautiful as you..."
msgstr ""

#: shadow_darkness/shadow_realize_love/3
msgctxt "Skips"
msgid "You're so... beautiful."
msgstr ""

#: shadow_darkness/shadow_realize_love/14
msgctxt "Skips"
msgid "You're even more astonishing in the daylight."
msgstr ""

#: shadow_darkness/shadow_realize_love/22
msgctxt "Skips"
msgid "Can I try something?"
msgstr ""

#: shadow_darkness/shadow_realize_love/30
msgctxt "Narrator"
msgid "Skips takes your hand..."
msgstr ""

#: shadow_darkness/shadow_realize_love/38
msgctxt "Narrator"
msgid "Closes his eyes."
msgstr ""

#: shadow_darkness/shadow_realize_love/46
msgctxt "Narrator"
msgid "And takes in your energy, letting it flow through his being."
msgstr ""

#: shadow_darkness/shadow_realize_love/54
msgctxt "Skips"
msgid "It's pretty good in the light, being here with you."
msgstr ""

#: shadow_darkness/shadow_love_realize_join/0/0
msgctxt "Skips"
msgid "The interplay between light and shadow... I can't look away."
msgstr ""

#: shadow_darkness/shadow_love_realize_join/0/8
msgctxt "Narrator"
msgid "Skips stands transfixed, his pupils dilating in and out as he looks around at everything in the house."
msgstr ""

#: shadow_darkness/shadow_love_realize_join/0/16
msgctxt "Skips"
msgid "Hm... What if I...?"
msgstr ""

#: shadow_darkness/shadow_love_realize_join/0/24
msgctxt "Narrator"
msgid "He takes the nearest lamp, and turns it on and off, off and on."
msgstr ""

#: shadow_darkness/shadow_love_realize_join/0/32
msgctxt "Skips"
msgid "Fascinating..."
msgstr ""

#: shadow_darkness/shadow_love_realize_join/0/40
msgctxt "Narrator"
msgid "He does this for hours."
msgstr ""

#: shadow_darkness/shadow_love_realize_join/0/48/s/0
msgctxt "Choix"
msgid "Skips? You okay?"
msgstr ""

#: shadow_darkness/shadow_love_realize_join/0/49/s/0
msgctxt "Choix"
msgid "You do you!"
msgstr ""

#: shadow_darkness/shadow_love_realize_join/0/50/s/0
msgctxt "Choix"
msgid "My poor electric bill..."
msgstr ""

#: shadow_darkness/shadow_love_realize_join/0/g-0/0
msgctxt "Skips"
msgid "The contrast between the volumes. These shapes which transfix me."
msgstr ""

#: shadow_darkness/shadow_love_realize_join/0/g-0/8
msgctxt "Skips"
msgid "I know what I need to do now."
msgstr ""

#: shadow_darkness/shadow_love_realize_join/0/g-0/16
msgctxt "Narrator"
msgid "With resolve in his eyes, Skips stares straight into your soul. Lights dance between his irises."
msgstr ""

#: shadow_darkness/shadow_love_realize_join/0/g-0/24
msgctxt "Skips"
msgid "I will become Lord of Shadows..."
msgstr ""

#: shadow_darkness/shadow_love_realize_join/0/g-0/32
msgctxt "Narrator"
msgid "By joining the local theater troupe as a lighting operator."
msgstr ""

#: shadow_darkness/shadow_love_realize_join/0/g-0/40
msgctxt "Skips"
msgid "Spotlight. On!"
msgstr ""

#: shadow_darkness/shadow_realize_join/0/6
msgctxt "xxXShadowl0rd420Xxx"
msgid "No cap?"
msgstr ""

#: shadow_darkness/shadow_realize_join/0/22
msgctxt "xxXShadowl0rd420Xxx"
msgid "...this needs a different form..."
msgstr ""

#: shadow_darkness/shadow_realize_join/0/36/b/1
msgctxt "xxXShadowl0rd420Xxx"
msgid "My true form... which you have never seen."
msgstr ""

#: shadow_darkness/shadow_realize_join/0/45
msgctxt "Skips"
msgid "I enter."
msgstr ""

#: shadow_darkness/shadow_realize_join/0/53
msgctxt "Skips"
msgid "So... I can walk into the light? For real?"
msgstr ""

#: shadow_darkness/shadow_hate_return/0/0
msgctxt "xxXOmegaShadowl0rd42069Xxx"
msgid "Remember, I am following your every move."
msgstr ""

#: shadow_darkness/shadow_hate_return/0/9/s/0
msgctxt "Choix"
msgid "I know it's all an act, Skips. (USE SMARTS CANDY)"
msgstr ""

#: shadow_darkness/shadow_hate_return/0/c-0/13
msgctxt "xxXOmegaShadowl0rd42069Xxx"
msgid "<w>Fwa ha ha ha!</w>"
msgstr ""

#: shadow_darkness/shadow_hate_return/0/c-1/7
msgctxt "xxXOmegaShadowl0rd42069Xxx"
msgid "So??"
msgstr ""

#: shadow_darkness/shadow_hate_return/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "Don't you want friends?"
msgstr ""

#: shadow_darkness/shadow_hate_return/0/c-1/15/c-0/21
msgctxt "xxXOmegaShadowl0rd42069Xxx"
msgid "NO."
msgstr ""

#: shadow_darkness/shadow_hate_return/0/c-1/15/c-0/32/0/s/0
msgctxt "Choix"
msgid "C'mon."
msgstr ""

#: shadow_darkness/shadow_hate_return/0/c-1/15/c-0/32/c-0/15
msgctxt "xxXOmegaShadowl0rd42069Xxx"
msgid "may be"
msgstr ""

#: shadow_darkness/shadow_hate_return/0/c-1/15/c-0/32/c-0/23/0/s/0
msgctxt "Choix"
msgid "Let's be friends, Skips."
msgstr ""

#: shadow_darkness/shadow_hate_return/0/c-1/15/c-0/32/c-0/23/c-0/15
msgctxt "Skips"
msgid "ok"
msgstr ""
