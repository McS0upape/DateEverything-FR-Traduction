#: dasha_desk/dasha_hate_crit/0/g-1/c-7/29/c-0/7
msgctxt "Dasha"
msgid "Practice? You and I?"
msgstr ""

#: dasha_desk/dasha_hate_crit/0/g-1/c-7/29/c-0/15
msgctxt "Dasha"
msgid "You will be kissing me?"
