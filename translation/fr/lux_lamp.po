#: lux_lamp/LuxWhoAmI2/0/g-0/c-3/55/c-1/23
msgctxt "Lux"
msgid "Where some people were born to lead."
msgstr "Où certaines personnes sont nées pour mener."

# Traduction IA – à relire
#: lux_lamp/LuxWhoAmI2/0/g-0/c-3/55/c-1/31
msgctxt "Lux"
msgid "Like me."
msgstr "Comme moi."

# Traduction IA – à relire
#: lux_lamp/LuxWhoAmI2/0/g-0/c-3/55/c-1/39
msgctxt "Lux"
