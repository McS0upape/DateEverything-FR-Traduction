msgctxt "Hank 3"
msgid "You may not be down for <i>everything</i>..."
msgstr "T'es peut-être pas partant pour <i>tout</i>..."

# Traduction IA – à relire
#: hanks_hangers/hanks_friendshippostjump/0/g-0/16
msgctxt "Hank 4"
msgid "BUT you've been really brave."
msgstr "MAIS t'as été vraiment courageux."

# Traduction IA – à relire
#: hanks_hangers/hanks_friendshippostjump/0/g-0/24 hanks_hangers/hanks_friendshipnojump/0/16
msgctxt "Hank 2"
