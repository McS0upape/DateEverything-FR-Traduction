msgstr "Oh là là, ça me manque pas !"

# Traduction IA – à relire
#: zoey_ghost/attic_tableau_sort/0/16/11/c-7/17
msgctxt "Zoey"
msgid "Oh I think I met him before... usually around the Sadie Hawkins dance."
msgstr "Oh je crois que je l'ai déjà rencontré... en général vers le bal de Sadie Hawkins."

# Traduction IA – à relire
#: zoey_ghost/attic_tableau_sort/0/16/11/c-8/7
msgctxt "Zoey"
msgid "Okay... let's see if it's enough..."
msgstr "Ok... voyons si ça suffit..."

# Traduction IA – à relire
#: zoey_ghost/attic_almost/0
