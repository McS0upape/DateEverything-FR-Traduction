#: skylar_specs/skylar_final_love_reggie/0/g-3/c-11/7
msgctxt "Reggie"
msgid "Lucky guess."
msgstr ""

#: skylar_specs/skylar_final_love_reggie/0/g-3/c-12/7
msgctxt "Reggie"
msgid "She definitely was a Scrouf. Those noises were wild."
