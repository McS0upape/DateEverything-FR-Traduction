# Traduction IA – à relire
#: kopi_coffee/1
msgctxt "Tag Nom d'objet (MAJUSCULES)"
msgid "COFFEEMAKER"
msgstr "CAFETIÈRE"

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/6 kopi_coffee/kopi_friar_encounter/0/g-0/21 kopi_coffee/second_encounter/0/0
msgctxt "Kopi"
msgid "Welcome to Roofbucks! The home for all your coffee needs."
msgstr "Bienvenue chez Roofbucks ! La maison de tous vos besoins en café."

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/14
msgctxt "Narrator"
msgid "As she speaks to you, Kopi adds the finishing touches to a drink on the counter that better resembles a milkshake than a cup of coffee."
msgstr "Tandis qu'elle vous parle, Kopi met la touche finale à une boisson, sur le comptoir, qui ressemble plus à un milk-shake qu'à une tasse de café."

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/22
msgctxt "Kopi"
msgid "I'll be right with you, just need to get these chocolate shavings..."
msgstr "Je suis à vous dans une seconde, il me faut juste ces copeaux de chocolat..."

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/30/s/0
msgctxt "Choix"
msgid "I didn't know you offered drinks like this."
msgstr "Je ne savais pas que tu proposais des boissons comme ça."

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/31/s/0
msgctxt "Choix"
msgid "Who's this for?"
msgstr "C'est pour qui ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/32/s/0
msgctxt "Choix"
msgid "Wow, chocolate shavings? Fancy."
msgstr "Waouh, des copeaux de chocolat ? Chic."

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/c-0/7
msgctxt "Kopi"
msgid "I don't really! This is a special order."
msgstr "Pas vraiment ! C'est une commande spéciale."

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/c-1/7
msgctxt "Kopi"
msgid "Can't say... barista-client confidentiality."
msgstr "Impossible à dire... secret professionnel barista-client."

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/c-1/15
msgctxt "Kopi"
msgid "That's not actually a thing, but this client insists it is."
msgstr "Ça n'existe pas vraiment, mais ce client insiste pour dire que si."

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/c-2/7
msgctxt "Kopi"
msgid "Not just any chocolate either... gotta be imported swiss milk chocolate."
msgstr "Et pas n'importe quel chocolat non plus... du chocolat au lait suisse d'importation, s'il vous plaît."

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/g-0/0
msgctxt "Kopi"
msgid "A drink like this is basically a coffee flavored dessert... I think there's much better ways to get people into coffee without doing all this."
msgstr "Une boisson comme ça, c'est quasiment un dessert au goût de café... je pense qu'il y a de bien meilleures façons d'initier les gens au café sans tout ce cirque."

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/g-0/8
msgctxt "Kopi"
msgid "But it's for everyone's sanity that I do this, so... one little chip off my integrity won't kill me, I guess."
msgstr "Mais c'est pour la santé mentale de tout le monde, alors... un petit copeau en moins sur mon intégrité ne me tuera pas, je suppose."

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/g-0/16
msgctxt "Narrator"
msgid "A chill comes over the room — Kopi looks somewhere behind you, perking up and putting on her best customer service voice."
msgstr "Un frisson parcourt la pièce — Kopi regarde quelque chose derrière vous, se redresse et prend sa meilleure voix de service client."

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/g-0/35
msgctxt "Friar Errol"
msgid "<i>Shhhh.</i> Too loud."
msgstr "<i>Chhhut.</i> Trop fort."

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/g-0/43
msgctxt "Narrator"
msgid "Friar Errol has arrived, and he looks positively dreadful. You've never seen him look so tired."
msgstr "Frère Errol est arrivé, et il a une mine franchement épouvantable. Vous ne l'avez jamais vu aussi fatigué."

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/g-0/48
msgctxt "Kopi"
msgid "Sorry Friar!"
msgstr "Pardon, Frère !"

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/g-0/56
msgctxt "Friar Errol"
msgid "Too <i>loud</i>, child."
msgstr "Trop <i>fort</i>, mon enfant."

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/g-0/64/s/0
msgctxt "Choix"
msgid "I didn't think you were a coffee guy, Friar."
msgstr "Je ne te voyais pas en buveur de café, Frère."

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/g-0/65/s/0
msgctxt "Choix"
msgid "Isn't this drink too indulgent for you?"
msgstr "Cette boisson n'est pas un peu trop gourmande pour toi ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/g-0/66/s/0
msgctxt "Choix"
msgid "Don't talk to me until I've had my coffee, am I right?"
msgstr "Ne me parle pas avant que j'aie pris mon café, c'est ça ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/g-0/c-3/7
msgctxt "Friar Errol"
msgid "I am not a 'coffee guy'."
msgstr "Je ne suis pas un « buveur de café »."

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/g-0/c-4/7
msgctxt "Friar Errol"
msgid "Nothing in this drink is fried, so no."
msgstr "Rien dans cette boisson n'est frit, donc non."

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/g-0/c-5/7
msgctxt "Friar Errol"
msgid "Please... not so loud."
msgstr "Je t'en prie... moins fort."

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/g-1/0
msgctxt "Friar Errol"
msgid "I am a humble servant to Our Lord of Convection, and I cannot do my best work until I am caffeinated."
msgstr "Je suis l'humble serviteur de Notre Seigneur de la Convection, et je ne peux pas faire de mon mieux tant que je ne suis pas caféiné."

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/g-1/5
msgctxt "Friar Errol"
msgid "Coffee is not one of His Creations, but His Blessings can be found within it all the same."
msgstr "Le café n'est pas l'une de Ses Créations, mais Ses Bénédictions s'y trouvent tout de même."

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/g-1/10
msgctxt "Narrator"
msgid "He reaches out to take the coffee from Kopi, inhaling its scent with a little groan before he takes a long drink."
msgstr "Il tend la main pour prendre le café des mains de Kopi, en inspire l'odeur avec un petit grognement, puis en boit une longue gorgée."

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/g-1/18
msgctxt "Narrator"
msgid "The Friar has a whipped-cream mustache that he doesn't seem to notice. Kopi raises her eyebrows at you but says nothing."
msgstr "Le Frère a une moustache de chantilly qu'il ne semble pas remarquer. Kopi lève les sourcils vers vous mais ne dit rien."

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/g-1/29
msgctxt "Friar Errol"
msgid "Kopi has been sworn to silence about my drink order. And now you will join her."
msgstr "Kopi a juré de garder le silence sur ma commande. Et maintenant, tu la rejoindras."

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/g-1/40/s/0
msgctxt "Choix"
msgid "Why?"
msgstr "Pourquoi ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/g-1/41/s/0
msgctxt "Choix"
msgid "I'm not keeping your secrets dude."
msgstr "Je ne garde pas tes secrets, mec."

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/g-1/42/s/0
msgctxt "Choix"
msgid "You're that embarrassed about it?"
msgstr "Tu as vraiment si honte que ça ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/g-1/c-6/7
msgctxt "Friar Errol"
msgid "<i>Why?</i>"
msgstr "<i>Pourquoi ?</i>"

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/g-1/c-7/7
msgctxt "Friar Errol"
msgid "You will."
msgstr "Tu le feras."

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/g-1/c-8/7
msgctxt "Friar Errol"
msgid "Embarrassed? No."
msgstr "Honte ? Non."

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/g-2/0
msgctxt "Friar Errol"
msgid "My work is too important to be jeopardized by distractions like being mocked for my delicious drink order."
msgstr "Mon travail est trop important pour être compromis par des distractions comme les moqueries sur ma délicieuse commande."

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/g-2/5
msgctxt "Friar Errol"
msgid "Anyone with sense will know that just because my drink is luxurious does not mean I indulge myself in truly dangerous, sinful temptations."
msgstr "Quiconque a du bon sens saura que ce n'est pas parce que ma boisson est luxueuse que je cède à de véritables tentations dangereuses et pécheresses."

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/g-2/13
msgctxt "Friar Errol"
msgid "But my flock is easily confused, and it is best to spare them such things."
msgstr "Mais mon troupeau se laisse facilement troubler, et mieux vaut lui épargner ces choses."

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/g-2/21
msgctxt "Friar Errol"
msgid "So you <i>will</i> keep this secret."
msgstr "Alors tu <i>garderas</i> ce secret."

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/g-2/26
msgctxt "Narrator"
msgid "He turns on his heel and walks off without another word, sipping at his drink with another strange little groan."
msgstr "Il tourne les talons et s'éloigne sans un mot de plus, sirotant sa boisson avec un autre étrange petit grognement."

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/g-2/40/b/1
msgctxt "Kopi"
msgid "See what I mean? Just easier to make it for him than trying to get him to relax a little."
msgstr "Tu vois ce que je veux dire ? C'est plus simple de la lui préparer que d'essayer de lui faire relâcher un peu la pression."

# Traduction IA – à relire
#: kopi_coffee/kopi_friar_encounter/0/g-2/43
msgctxt "Kopi"
msgid "You know I've got this really great roast you ought to try... and if you want something sweeter I've got some leftover chocolate shavings..."
msgstr "Tu sais, j'ai un torréfié vraiment génial que tu devrais goûter... et si tu veux quelque chose de plus sucré, il me reste des copeaux de chocolat..."

# Traduction IA – à relire
#: kopi_coffee/dishes_coffee/0/0 kopi_coffee/first_encounter/0/19
msgctxt "Kopi"
msgid "Welcome to Roofbucks, the home of all your coffee needs."
msgstr "Bienvenue chez Roofbucks, la maison de tous vos besoins en café."

# Traduction IA – à relire
#: kopi_coffee/dishes_coffee/0/8
msgctxt "Kopi"
msgid "What could I get for you today?"
msgstr "Qu'est-ce que je vous sers aujourd'hui ?"

# Traduction IA – à relire
#: kopi_coffee/dishes_coffee/0/16/s/0
msgctxt "Choix"
msgid "I, uh, have a delivery?"
msgstr "J'ai, euh, une livraison ?"

# Traduction IA – à relire
#: kopi_coffee/dishes_coffee/0/c-0/7
msgctxt "Kopi"
msgid "Huh?"
msgstr "Hein ?"

# Traduction IA – à relire
#: kopi_coffee/dishes_coffee/0/c-0/15
msgctxt "Kopi"
msgid "Oh, the new coffee mugs I requested from Daisuke!"
msgstr "Oh, les nouvelles tasses que j'ai demandées à Daisuke !"

# Traduction IA – à relire
#: kopi_coffee/dishes_coffee/0/c-0/26
msgctxt "Kopi"
msgid "Just set them over here, please."
msgstr "Pose-les là, s'il te plaît."

# Traduction IA – à relire
#: kopi_coffee/dishes_coffee/0/c-0/37
msgctxt "Kopi"
msgid "Alright, thanks for that."
msgstr "Très bien, merci pour ça."

# Traduction IA – à relire
#: kopi_coffee/dishes_coffee/0/c-0/48/b/1
msgctxt "Kopi"
msgid "So... Why did Daisuke send someone like... <i>you</i> to help out with deliveries?"
msgstr "Alors... pourquoi Daisuke a envoyé quelqu'un comme... <i>toi</i> pour les livraisons ?"

# Traduction IA – à relire
#: kopi_coffee/dishes_coffee/0/c-0/48/b/9
msgctxt "Kopi"
msgid "He couldn't find anyone more reliable?"
msgstr "Il n'a trouvé personne de plus fiable ?"

# Traduction IA – à relire
#: kopi_coffee/dishes_coffee/0/c-0/49/b/1
msgctxt "Kopi"
msgid "How come Daisuke wasn't able to come himself, by the way?"
msgstr "D'ailleurs, comment ça se fait que Daisuke n'ait pas pu venir lui-même ?"

# Traduction IA – à relire
#: kopi_coffee/dishes_coffee/0/c-0/52/0/s/0
msgctxt "Choix"
msgid "He got cracked so he's taking it easy."
msgstr "Il s'est fêlé, alors il y va doucement."

# Traduction IA – à relire
#: kopi_coffee/dishes_coffee/0/c-0/52/c-0/7
msgctxt "Kopi"
msgid "That dish really needs to take a break every now and then. He puts the dishes before everything, even his own health."
msgstr "Cette assiette a vraiment besoin de souffler de temps en temps. Il met la vaisselle avant tout, même sa propre santé."

# Traduction IA – à relire
#: kopi_coffee/dishes_coffee/0/c-0/52/c-0/15/0/s/0
msgctxt "Choix"
msgid "Why's he take his work so seriously?"
msgstr "Pourquoi il prend son travail tellement au sérieux ?"

# Traduction IA – à relire
#: kopi_coffee/dishes_coffee/0/c-0/52/c-0/15/c-0/7
msgctxt "Kopi"
msgid "It's all he knows."
msgstr "C'est tout ce qu'il connaît."

# Traduction IA – à relire
#: kopi_coffee/dishes_coffee/0/c-0/52/c-0/15/c-0/15
msgctxt "Kopi"
msgid "His family come from a long line of fine figures. Tsubasa... Moridake... Williams-Casanova... There's a lot to live up to, for him."
msgstr "Sa famille descend d'une longue lignée de porcelaines d'exception. Tsubasa... Moridake... Williams-Casanova... Il y a de quoi se montrer à la hauteur, pour lui."

# Traduction IA – à relire
#: kopi_coffee/dishes_coffee/0/c-0/52/c-0/15/c-0/23
msgctxt "Kopi"
msgid "He can't even imagine a life outside of his work."
msgstr "Il n'arrive même pas à imaginer une vie en dehors de son travail."

# Traduction IA – à relire
#: kopi_coffee/dishes_coffee/0/c-0/52/c-0/15/c-0/31/0/s/0
msgctxt "Choix"
msgid "Do you think he'll ever take time to do anything for himself?"
msgstr "Tu crois qu'il prendra un jour le temps de faire quelque chose pour lui ?"

# Traduction IA – à relire
#: kopi_coffee/dishes_coffee/0/c-0/52/c-0/15/c-0/31/1/s/0
msgctxt "Choix"
msgid "That seems really unhealthy."
msgstr "Ça a l'air vraiment malsain."

# Traduction IA – à relire
#: kopi_coffee/dishes_coffee/0/c-0/52/c-0/15/c-0/31/c-0/7
msgctxt "Kopi"
msgid "I sure hope he will... but I've never seen it in all the years I've known him."
msgstr "Je l'espère bien... mais je ne l'ai jamais vu le faire en toutes ces années où je le connais."

# Traduction IA – à relire
#: kopi_coffee/dishes_coffee/0/c-0/52/c-0/15/c-0/31/c-0/15
msgctxt "Kopi"
msgid "Be delicate, don't be abrasive."
msgstr "Un peu de délicatesse, pas d'abrasion."

# Traduction IA – à relire
#: kopi_coffee/dishes_coffee/0/c-0/52/c-0/15/c-0/31/c-1/7
msgctxt "Kopi"
msgid "You're telling me."
msgstr "À qui le dis-tu."

# Traduction IA – à relire
#: kopi_coffee/dishes_coffee/0/g-0/0
msgctxt "Kopi"
msgid "Anyways, thanks for delivering these mugs. Tell Daisuke I said thanks."
msgstr "Enfin bref, merci d'avoir livré ces tasses. Dis à Daisuke que je le remercie."

# Traduction IA – à relire
#: kopi_coffee/dishes_coffee/0/g-0/18/b/1 kopi_coffee/love_path_4/0 kopi_coffee/kopi_true_friend_path/0/c-1/7
msgctxt "Kopi"
msgid "Oh!"
msgstr "Oh !"

# Traduction IA – à relire
#: kopi_coffee/kopi_fix/0/0
msgctxt "Kopi"
msgid "Was I the last one?"
msgstr "C'était la dernière ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_fix/0/8/s/0
msgctxt "Choix"
msgid "Yeah, actually!"
msgstr "Oui, en fait !"

# Traduction IA – à relire
#: kopi_coffee/kopi_fix/0/c-0/7
msgctxt "Kopi"
msgid "Great job. Daisuke's gonna love that."
msgstr "Beau boulot. Daisuke va adorer ça."

# Traduction IA – à relire
#: kopi_coffee/abel_kopi_conversation/0/0/b/1
msgctxt "Kopi"
msgid "Hello, sunshine!"
msgstr "Salut, rayon de soleil !"

# Traduction IA – à relire
#: kopi_coffee/abel_kopi_conversation/0/3/b/1
msgctxt "Kopi"
msgid "...what do you want."
msgstr "...qu'est-ce que tu veux."

# Traduction IA – à relire
#: kopi_coffee/abel_kopi_conversation/0/6/s/0
msgctxt "Choix"
msgid "Abel told me to say hi?"
msgstr "Abel m'a dit de te dire bonjour ?"

# Traduction IA – à relire
#: kopi_coffee/abel_kopi_conversation/0/g-0/0
msgctxt "Kopi"
msgid "Abel? My sturdy cowboy."
msgstr "Abel ? Mon solide cow-boy."

# Traduction IA – à relire
#: kopi_coffee/abel_kopi_conversation/0/g-0/8
msgctxt "Kopi"
msgid "I’ve known Abel for some time now and I’m not surprised he sent you to me."
msgstr "Je connais Abel depuis un moment et ça ne m'étonne pas qu'il t'ait adressé à moi."

# Traduction IA – à relire
#: kopi_coffee/abel_kopi_conversation/0/g-0/16
msgctxt "Kopi"
msgid "He’s the solitary type, but if you asked, he’d give you the cloth off his table."
msgstr "C'est un solitaire, mais si tu lui demandais, il te donnerait la nappe de sa table."

# Traduction IA – à relire
#: kopi_coffee/abel_kopi_conversation/0/g-0/24
msgctxt "Kopi"
msgid "Why, he holds up practically half the house without a word of complaint."
msgstr "Eh oui, il porte pratiquement la moitié de la maison sans un mot de plainte."

# Traduction IA – à relire
#: kopi_coffee/abel_kopi_conversation/0/g-0/32/s/0
msgctxt "Choix"
msgid "He said he doesn’t like the \"casual stuff,\" but sort of dodged me when I asked what he meant."
msgstr "Il a dit qu'il n'aimait pas les « trucs décontractés », mais il a esquivé quand j'ai demandé ce qu'il voulait dire."

# Traduction IA – à relire
#: kopi_coffee/abel_kopi_conversation/0/g-1/0
msgctxt "Kopi"
msgid "Yes, he would dodge that question."
msgstr "Oui, il esquiverait cette question."

# Traduction IA – à relire
#: kopi_coffee/abel_kopi_conversation/0/g-1/8
msgctxt "Kopi"
msgid "I think the most important thing to know about Abel is that he’s not quiet out of any kind of shyness."
msgstr "Le plus important à savoir sur Abel, je crois, c'est qu'il n'est pas silencieux par timidité."

# Traduction IA – à relire
#: kopi_coffee/abel_kopi_conversation/0/g-1/16
msgctxt "Kopi"
msgid "That’s just how he is—if there’s nothing to say, he’s content to share in your company."
msgstr "C'est comme ça qu'il est — s'il n'y a rien à dire, il se contente de partager ta compagnie."

# Traduction IA – à relire
#: kopi_coffee/abel_kopi_conversation/0/g-1/24/s/0
msgctxt "Choix"
msgid "So... does he like coffee?"
msgstr "Alors... est-ce qu'il aime le café ?"

# Traduction IA – à relire
#: kopi_coffee/abel_kopi_conversation/0/g-1/c-2/7/b/1
msgctxt "Kopi"
msgid "Everyone likes coffee, darling."
msgstr "Tout le monde aime le café, chou."

# Traduction IA – à relire
#: kopi_coffee/abel_kopi_conversation/0/g-1/c-2/10/b/1
msgctxt "Kopi"
msgid "Everyone likes coffee, but I guess you wouldn't know that."
msgstr "Tout le monde aime le café, mais j'imagine que tu l'ignorais."

# Traduction IA – à relire
#: kopi_coffee/abel_kopi_conversation/0/g-2/0
msgctxt "Kopi"
msgid "I’ll pour you a cup of his favorite."
msgstr "Je vais te servir une tasse de son préféré."

# Traduction IA – à relire
#: kopi_coffee/abel_kopi_conversation/0/g-2/11
msgctxt "Kopi"
msgid "It’s an Ethiopian Sidama Ardi that tastes like strawberries, served black and hot."
msgstr "C'est un Sidama Ardi d'Éthiopie qui a un goût de fraise, servi noir et chaud."

# Traduction IA – à relire
#: kopi_coffee/abel_kopi_conversation/0/g-2/19/s/0
msgctxt "Choix"
msgid "Strawberries? Really?"
msgstr "De la fraise ? Vraiment ?"

# Traduction IA – à relire
#: kopi_coffee/abel_kopi_conversation/0/g-2/20/s/0
msgctxt "Choix"
msgid "Sounds amazing..."
msgstr "Ça a l'air génial..."

# Traduction IA – à relire
#: kopi_coffee/abel_kopi_conversation/0/g-2/c-3/7
msgctxt "Kopi"
msgid "Trust me."
msgstr "Fais-moi confiance."

# Traduction IA – à relire
#: kopi_coffee/abel_kopi_conversation/0/g-2/c-4/7
msgctxt "Kopi"
msgid "Oh it is..."
msgstr "Oh, ça l'est..."

# Traduction IA – à relire
#: kopi_coffee/abel_kopi_conversation/0/g-3/10
msgctxt "Narrator"
msgid "With the coffee in hand, you take your leave."
msgstr "Café en main, vous prenez congé."

# Traduction IA – à relire
#: kopi_coffee/first_encounter/0/6
msgctxt "Narrator"
msgid "A charming barista grinds coffee in your kitchen, working so busily she doesn't even seem to notice you. You stand there for a good few minutes before she spies you, startled out of her intense focus."
msgstr "Une charmante barista moud du café dans votre cuisine, si absorbée par sa tâche qu'elle ne semble même pas vous remarquer. Vous restez là de bonnes minutes avant qu'elle vous aperçoive, tirée en sursaut de sa concentration intense."

# Traduction IA – à relire
#: kopi_coffee/first_encounter/0/11
msgctxt "Kopi"
msgid "Oh! Uh, hi there."
msgstr "Oh ! Euh, salut."

# Traduction IA – à relire
#: kopi_coffee/first_encounter/0/27
msgctxt "Kopi"
msgid "I'm Kopi, happy to help."
msgstr "Moi c'est Kopi, ravie de t'aider."

# Traduction IA – à relire
#: kopi_coffee/first_encounter/0/35/s/0
msgctxt "Choix"
msgid "So, you're my coffee maker?"
msgstr "Alors, tu es ma cafetière ?"

# Traduction IA – à relire
#: kopi_coffee/first_encounter/0/c-0/7
msgctxt "Kopi"
msgid "I, uh, sure am!"
msgstr "Je, euh, oui !"

# Traduction IA – à relire
#: kopi_coffee/first_encounter/0/c-0/15
msgctxt "Kopi"
msgid "Here to make your day just a little bit brighter with a touch of coffee."
msgstr "Je suis là pour égayer ta journée avec une touche de café."

# Traduction IA – à relire
#: kopi_coffee/first_encounter/0/c-0/23
msgctxt "Kopi"
msgid "Gosh, that never gets any less awkward to say..."
msgstr "Oh là là, ça ne devient jamais moins gênant à dire..."

# Traduction IA – à relire
#: kopi_coffee/second_encounter/0/14/s/0
msgctxt "Choix"
msgid "It's nice to see you again."
msgstr "C'est sympa de te revoir."

# Traduction IA – à relire
#: kopi_coffee/second_encounter/0/c-0/7
msgctxt "Narrator"
msgid "Kopi gives you an awkward smile, fidgeting with her coffee implements. She keeps looking at you as though she were searching for something."
msgstr "Kopi vous adresse un sourire gêné, tripotant ses ustensiles à café. Elle ne cesse de vous regarder comme si elle cherchait quelque chose."

# Traduction IA – à relire
#: kopi_coffee/second_encounter/0/c-0/15
msgctxt "Kopi"
msgid "Oh, well, it's uh... nice to see you too?"
msgstr "Oh, eh bien, c'est, euh... sympa de te voir aussi ?"

# Traduction IA – à relire
#: kopi_coffee/second_encounter/0/c-0/23
msgctxt "Kopi"
msgid "You're uhh... ah, that's right!"
msgstr "Tu es euh... ah, ça y est !"

# Traduction IA – à relire
#: kopi_coffee/second_encounter/0/c-0/31
msgctxt "Narrator"
msgid "Kopi snaps her fingers, realization striking."
msgstr "Kopi claque des doigts, frappée par une révélation."

# Traduction IA – à relire
#: kopi_coffee/second_encounter/0/c-0/39
msgctxt "Kopi"
msgid "We had a little chat last time, didn't we?"
msgstr "On a un peu discuté la dernière fois, non ?"

# Traduction IA – à relire
#: kopi_coffee/second_encounter/0/c-0/47/0/s/0
msgctxt "Choix"
msgid "You could call it that."
msgstr "On peut appeler ça comme ça."

# Traduction IA – à relire
#: kopi_coffee/second_encounter/0/c-0/47/1/s/0
msgctxt "Choix"
msgid "We did!"
msgstr "Oui !"

# Traduction IA – à relire
#: kopi_coffee/second_encounter/0/c-0/47/c-0/7
msgctxt "Kopi"
msgid "...oh. I thought it was a chat."
msgstr "...oh. Moi, je croyais que c'était une discussion."

# Traduction IA – à relire
#: kopi_coffee/second_encounter/0/c-0/47/g-0/0
msgctxt "Kopi"
msgid "Well, thanks for coming back! I do appreciate your patronage."
msgstr "Eh bien, merci de revenir ! J'apprécie vraiment ta fidélité."

# Traduction IA – à relire
#: kopi_coffee/second_encounter/0/c-0/47/g-0/8
msgctxt "Kopi"
msgid "We actually have a new drink added to the menu since the last time you came in!"
msgstr "On a ajouté une nouvelle boisson au menu depuis ta dernière visite !"

# Traduction IA – à relire
#: kopi_coffee/second_encounter/0/c-0/47/g-0/16 kopi_coffee/third_encounter/38
msgctxt "Kopi"
msgid "So..."
msgstr "Alors..."

# Traduction IA – à relire
#: kopi_coffee/third_encounter/6
msgctxt "Narrator"
msgid "Kopi is in the middle of opening a bag of coffee beans, wafting their aroma towards her with a pleasant sigh."
msgstr "Kopi est en train d'ouvrir un sac de grains de café, humant leur arôme avec un soupir ravi."

# Traduction IA – à relire
#: kopi_coffee/third_encounter/14
msgctxt "Kopi"
msgid "...oh, hey! Welcome back."
msgstr "...oh, salut ! Bon retour parmi nous."

# Traduction IA – à relire
#: kopi_coffee/third_encounter/22
msgctxt "Kopi"
msgid "I hope you're in the mood for some delicious coffee; I just got in some fresh new beans, so they're gonna be nice and ready to grind."
msgstr "J'espère que tu as envie d'un bon café ; je viens de recevoir des grains tout frais, ils seront bien prêts à être moulus."

# Traduction IA – à relire
#: kopi_coffee/third_encounter/30
msgctxt "Kopi"
msgid "And, well, I'm looking to try something a little different today."
msgstr "Et, eh bien, j'ai envie d'essayer quelque chose d'un peu différent aujourd'hui."

# Traduction IA – à relire
#: kopi_coffee/multi_encounter/0
msgctxt "Kopi"
msgid "It's my favorite customer!"
msgstr "Ah, ma star de la clientèle !"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/0
msgctxt "Kopi"
msgid "What can I get for you today?"
msgstr "Qu'est-ce que je te sers aujourd'hui ?"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/8/s/0
msgctxt "Choix"
msgid "A latte."
msgstr "Un latte."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/9/s/0
msgctxt "Choix"
msgid "An affogato."
msgstr "Un affogato."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/10/s/0
msgctxt "Choix"
msgid "An Irish coffee."
msgstr "Un café irlandais."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/11/s/0
msgctxt "Choix"
msgid "I don't think I'll have any coffee today."
msgstr "Je crois que je ne prendrai pas de café aujourd'hui."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-0/7
msgctxt "Kopi"
msgid "Sure thing. One latte, coming right up."
msgstr "Pas de souci. Un latte, ça arrive tout de suite."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-0/15
msgctxt "Narrator"
msgid "Kopi gets to work, grinding and pouring and mixing with an impressive speed."
msgstr "Kopi se met au travail, moulant, versant et mélangeant à une vitesse impressionnante."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-0/26
msgctxt "Kopi"
msgid "And..."
msgstr "Et..."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-0/37
msgctxt "Kopi"
msgid "Voila! One latte, just for you. Hope you like it!"
msgstr "Voilà ! Un latte rien que pour toi. J'espère qu'il te plaira !"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-0/54
msgctxt "Kopi"
msgid "Is there anything you'd like to know about the latte?"
msgstr "Tu veux savoir quelque chose sur le latte ?"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-0/62/0/s/0
msgctxt "Choix"
msgid "So... what is a latte?"
msgstr "Alors... c'est quoi, un latte ?"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-0/62/1/s/0
msgctxt "Choix"
msgid "Why is it called a latte?"
msgstr "Pourquoi ça s'appelle un latte ?"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-0/62/2/s/0
msgctxt "Choix"
msgid "Tell me more about latte art."
msgstr "Parle-moi du latte art."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-0/62/c-0/11
msgctxt "Kopi"
msgid "Oh! Well..."
msgstr "Oh ! Eh bien..."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-0/62/c-0/19
msgctxt "Kopi"
msgid "A latte is your pretty standard coffee."
msgstr "Le latte, c'est un café assez classique."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-0/62/c-0/27
msgctxt "Kopi"
msgid "It's a shot of espresso, topped with steamed milk, with just a touch of foam!"
msgstr "C'est un shot d'espresso, surmonté de lait vapeur, avec juste une touche de mousse !"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-0/62/c-0/35
msgctxt "Kopi"
msgid "Some people think it's basic, but... I think it can be a hard coffee to pull off, if you don't know what you're doing!"
msgstr "Certains le trouvent basique, mais... je pense que c'est un café difficile à réussir quand on ne sait pas ce qu'on fait !"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-0/62/c-0/43
msgctxt "Kopi"
msgid "If you put in too much foam, you're gonna be making a cappuccino instead."
msgstr "Si tu mets trop de mousse, tu fais un cappuccino à la place."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-0/62/c-0/51/0/s/0
msgctxt "Choix"
msgid "It's definitely underrated."
msgstr "Il est clairement sous-estimé."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-0/62/c-0/51/c-0/7
msgctxt "Kopi"
msgid "Yeah... yeah! You get me!"
msgstr "Oui... oui ! Tu me comprends !"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-0/62/c-1/11
msgctxt "Kopi"
msgid "Well, that's the Italian word for milk!"
msgstr "Eh bien, c'est le mot italien pour lait !"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-0/62/c-1/19
msgctxt "Kopi"
msgid "If you're in Italy, you HAVE to order it as a caffè latte."
msgstr "Si tu es en Italie, tu DOIS le commander en caffè latte."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-0/62/c-1/27
msgctxt "Kopi"
msgid "Otherwise... they'll literally just give you a glass of milk."
msgstr "Sinon... on te servira littéralement un verre de lait."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-0/62/c-1/35/0/s/0
msgctxt "Choix"
msgid "That's... awkward."
msgstr "C'est... gênant."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-0/62/c-1/35/c-0/7
msgctxt "Kopi"
msgid "Right?"
msgstr "N'est-ce pas ?"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-0/62/c-1/35/c-0/15
msgctxt "Kopi"
msgid "I don't think my nerves could handle being handed a glass of milk like that."
msgstr "Je crois que mes nerfs ne supporteraient pas qu'on me tende un verre de lait comme ça."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-0/62/c-1/35/c-0/23
msgctxt "Narrator"
msgid "She shudders violently."
msgstr "Elle frissonne violemment."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-0/62/c-1/35/c-0/34
msgctxt "Kopi"
msgid "Ugh."
msgstr "Beurk."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-0/62/c-2/7
msgctxt "Kopi"
msgid "Oh, gosh, where do I begin?!"
msgstr "Oh là là, par où commencer ?!"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-0/62/c-2/15
msgctxt "Kopi"
msgid "There's all different kinds of patterns to choose from..."
msgstr "Il y a toutes sortes de motifs à choisir..."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-0/62/c-2/23
msgctxt "Kopi"
msgid "Hearts... tulips..."
msgstr "Des coeurs... des tulipes..."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-0/62/c-2/31
msgctxt "Kopi"
msgid "But probably one of the most essential patterns for any good barista to learn is the rosetta pattern."
msgstr "Mais l'un des motifs les plus essentiels qu'un bon barista doit apprendre, c'est sans doute le rosetta."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-0/62/c-2/39
msgctxt "Kopi"
msgid "It's supposed to be based off of this plant, but I forgot the full name of it..."
msgstr "Il est censé être inspiré de cette plante, mais j'ai oublié son nom complet..."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-0/62/c-2/47/0/s/0
msgctxt "Choix"
msgid "Is it... called a rosetta?"
msgstr "Ça s'appelle... un rosetta ?"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-0/62/c-2/47/c-0/7
msgctxt "Kopi"
msgid "...that's probably it, yeah."
msgstr "...c'est sûrement ça, oui."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-1/7
msgctxt "Kopi"
msgid "Okay, no problem. One affogato, order up!"
msgstr "Ah, pas de souci. Un affogato, c'est parti !"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-1/15
msgctxt "Narrator"
msgid "Kopi flies into action, assembling your drink order with speed and skill."
msgstr "Kopi passe à l'action, assemblant votre commande avec rapidité et talent."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-1/29
msgctxt "Kopi"
msgid "Alright..."
msgstr "Bon..."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-1/37
msgctxt "Kopi"
msgid "Here we go, one affogato. Enjoy!"
msgstr "Et voilà, un affogato. Savoure !"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-1/54
msgctxt "Kopi"
msgid "Is there anything you'd like to know about the affogato?"
msgstr "Tu veux savoir quelque chose sur l'affogato ?"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-1/62/0/s/0
msgctxt "Choix"
msgid "What's in an affogato?"
msgstr "Qu'est-ce qu'il y a dans un affogato ?"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-1/62/1/s/0
msgctxt "Choix"
msgid "Why is it called an affogato?"
msgstr "Pourquoi ça s'appelle un affogato ?"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-1/62/c-0/11
msgctxt "Kopi"
msgid "An affogato's a pretty fun coffee."
msgstr "L'affogato est un café plutôt rigolo."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-1/62/c-0/19
msgctxt "Kopi"
msgid "Honestly... it's kind of more like a dessert!"
msgstr "Honnêtement... c'est plus un dessert, en fait !"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-1/62/c-0/27
msgctxt "Kopi"
msgid "You usually use some kind of vanilla gelato or ice cream at the bottom of the cup, and then pour hot espresso on top!"
msgstr "On met généralement de la glace à la vanille ou du gelato au fond de la tasse, puis on verse de l'espresso chaud par-dessus !"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-1/62/c-0/35
msgctxt "Kopi"
msgid "It's a pretty awesome coffee!"
msgstr "C'est un café vraiment génial !"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-1/62/c-0/43/0/s/0
msgctxt "Choix"
msgid "So... is it a dessert, or a drink?"
msgstr "Alors... c'est un dessert ou une boisson ?"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-1/62/c-0/43/c-0/7
msgctxt "Kopi"
msgid "Gosh, that's a question that's pretty heavily debated amongst coffee fans..."
msgstr "Oh là là, c'est une question très débattue chez les amateurs de café..."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-1/62/c-0/43/c-0/15
msgctxt "Kopi"
msgid "Personally, though, I like to think of it as a drink. Just a... fun drink!"
msgstr "Personnellement, je préfère y voir une boisson. Juste une... boisson rigolote !"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-1/62/c-1/11
msgctxt "Kopi"
msgid "Well... for a fun coffee, the name certainly backs it up!"
msgstr "Eh bien... pour un café rigolo, le nom est à la hauteur !"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-1/62/c-1/19
msgctxt "Kopi"
msgid "In Italian, they call it \"affogato al caffè\", which literally means, \"drowned in coffee\"."
msgstr "En italien, on dit « affogato al caffè », ce qui signifie littéralement « noyé dans le café »."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-1/62/c-1/27
msgctxt "Kopi"
msgid "So, 'affogato', means \"drowned\"!"
msgstr "Donc « affogato » veut dire « noyé » !"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-1/62/c-1/35
msgctxt "Kopi"
msgid "That's the way it's made, after all! Drown it in espresso!"
msgstr "C'est comme ça qu'on le prépare, après tout ! On le noie d'espresso !"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-1/62/c-1/43/0/s/0
msgctxt "Choix"
msgid "Sounds like delicious drowning!"
msgstr "Une noyade délicieuse, ça me tente !"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-1/62/c-1/43/1/s/0
msgctxt "Choix"
msgid "Isn't that a little too on the nose?"
msgstr "Ce n'est pas un peu trop évident ?"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-1/62/c-1/43/c-0/7
msgctxt "Kopi"
msgid "Don't get lost in it!"
msgstr "Ne te noie pas dedans !"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-1/62/c-1/43/c-1/7
msgctxt "Kopi"
msgid "Hey, the word \"café\" is literally the French word for coffee."
msgstr "Tiens, le mot « café » est littéralement le mot français pour... café."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-1/62/c-1/43/c-1/15
msgctxt "Kopi"
msgid "If we're talking on the nose... that one probably takes the cake."
msgstr "Si on parle de nom trop évident... celui-là rafle la mise."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-1/62/c-1/43/c-1/23
msgctxt "Kopi"
msgid "...or, coffee, I guess."
msgstr "...ou la tasse, plutôt."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-2/7
msgctxt "Kopi"
msgid "Right... Just, uh... remember that the Irish coffee is going to be a little different."
msgstr "Bon... Juste, euh... n'oublie pas que le café irlandais est un peu différent."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-2/15
msgctxt "Kopi"
msgid "Make sure you can take your alcohol."
msgstr "Assure-toi de bien tenir l'alcool."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-2/26
msgctxt "Narrator"
msgid "Kopi makes a lovely cup of coffee in her expert way, topping it off with a generous pour of cream. You can smell the alcohol even before she hands it to you."
msgstr "Kopi prépare une belle tasse de café avec son savoir-faire d'experte, la nappant d'une généreuse rasade de crème. Vous sentez l'alcool avant même qu'elle vous la tende."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-2/40
msgctxt "Kopi"
msgid "And... there we are! Enjoy!"
msgstr "Et... voilà ! Savoure !"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-2/57
msgctxt "Kopi"
msgid "Is there anything you'd like to know about the Irish coffee?"
msgstr "Tu veux savoir quelque chose sur le café irlandais ?"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-2/65/0/s/0
msgctxt "Choix"
msgid "Wait, why is there alcohol in here?"
msgstr "Attends, pourquoi il y a de l'alcool là-dedans ?"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-2/65/1/s/0
msgctxt "Choix"
msgid "What exactly makes it an \"Irish\" coffee?"
msgstr "Qu'est-ce qui en fait exactement un café « irlandais » ?"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-2/65/c-0/11
msgctxt "Kopi"
msgid "Yeah... it's more of a cocktail!"
msgstr "Ouais... c'est plutôt un cocktail !"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-2/65/c-0/19
msgctxt "Kopi"
msgid "You know how there's usually espresso martini at bars?"
msgstr "Tu sais qu'il y a souvent de l'espresso martini dans les bars ?"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-2/65/c-0/27
msgctxt "Kopi"
msgid "The Irish coffee is kind of similar!"
msgstr "Le café irlandais est un peu pareil !"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-2/65/c-0/35
msgctxt "Kopi"
msgid "You've got sugar and whiskey poured over black coffee, stir it up a little bit, and then pour some thick cream over it!"
msgstr "On verse du sucre et du whiskey sur du café noir, on remue un peu, puis on verse de la crème épaisse par-dessus !"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-2/65/c-0/43/0/s/0
msgctxt "Choix"
msgid "That's a lot of ingredients there."
msgstr "Ça fait beaucoup d'ingrédients."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-2/65/c-0/43/c-0/7
msgctxt "Kopi"
msgid "Oh, but trust me, it really makes it all worth it when you prepare it correctly!"
msgstr "Oh, mais crois-moi, ça en vaut vraiment la peine quand on le prépare correctement !"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-2/65/c-1/11
msgctxt "Kopi"
msgid "Well... it's just how it's made!"
msgstr "Eh bien... c'est comme ça qu'on le fait !"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-2/65/c-1/19
msgctxt "Kopi"
msgid "You REALLY need to use Irish whiskey, any other alcohol won't really work."
msgstr "Il faut VRAIMENT du whiskey irlandais, aucun autre alcool ne marchera vraiment."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-2/65/c-1/27
msgctxt "Kopi"
msgid "Irish whiskey is more smooth and has sort of a hint of vanilla in it that really makes the coffee shine through."
msgstr "Le whiskey irlandais est plus doux et a une pointe de vanille qui fait vraiment ressortir le café."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-2/65/c-1/35/0/s/0
msgctxt "Choix"
msgid "So, what happens if I made it with Scotch?"
msgstr "Alors, qu'est-ce qui se passe si je le fais avec du scotch ?"

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-2/65/c-1/35/c-0/7
msgctxt "Kopi"
msgid "I mean..."
msgstr "Eh bien..."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-2/65/c-1/35/c-0/15
msgctxt "Kopi"
msgid "You could try, but don't let any Irish people hear you."
msgstr "Tu peux essayer, mais que les Irlandais ne t'entendent pas."

# Traduction IA – à relire
#: kopi_coffee/coffee_choices/0/c-3/8/b/1
msgctxt "Kopi"
msgid "Oh, uh, alright then. No problem."
msgstr "Oh, euh, très bien. Pas de problème."

# Traduction IA – à relire
#: kopi_coffee/farewell/3
msgctxt "Kopi"
msgid "We'll see you next time!"
msgstr "À la prochaine !"

# Traduction IA – à relire
#: kopi_coffee/latte_quiz/0/b/8
msgctxt "Kopi"
msgid "You've tried my latte a few times now, and pretty much asked me all I know..."
msgstr "Tu as goûté mon latte plusieurs fois et tu m'as posé à peu près toutes les questions..."

# Traduction IA – à relire
#: kopi_coffee/latte_quiz/0/b/16
msgctxt "Kopi"
msgid "...I think it's time I tested you on your latte knowledge, since you asked so much!"
msgstr "...je crois qu'il est temps de tester tes connaissances sur le latte, vu que tu en as tant demandé !"

# Traduction IA – à relire
#: kopi_coffee/latte_quiz/0/b/24
msgctxt "Kopi"
msgid "Tell me..."
msgstr "Dis-moi..."

# Traduction IA – à relire
#: kopi_coffee/latte_quiz/1/b/1 kopi_coffee/affogato_quiz/1/b/1 kopi_coffee/irish_quiz/1/b/1
msgctxt "Kopi"
msgid "Be sure to try out one of our other flavors when you come to visit next!"
msgstr "N'oublie pas d'essayer l'une de nos autres saveurs à ta prochaine visite !"

# Traduction IA – à relire
#: kopi_coffee/first_latte_question/0/0
msgctxt "Kopi"
msgid "What's in a latte?"
msgstr "Qu'y a-t-il dans un latte ?"

# Traduction IA – à relire
#: kopi_coffee/first_latte_question/0/8/s/0
msgctxt "Choix"
msgid "Espresso, steamed milk, and a LOT of foam."
msgstr "Espresso, lait vapeur et BEAUCOUP de mousse."

# Traduction IA – à relire
#: kopi_coffee/first_latte_question/0/9/s/0
msgctxt "Choix"
msgid "Espresso, steamed milk, and chocolate."
msgstr "Espresso, lait vapeur et chocolat."

# Traduction IA – à relire
#: kopi_coffee/first_latte_question/0/10/s/0
msgctxt "Choix"
msgid "Espresso, steamed milk, a TOUCH of foam."
msgstr "Espresso, lait vapeur et un SOUPÇON de mousse."

# Traduction IA – à relire
#: kopi_coffee/first_latte_question/0/c-2/7
msgctxt "Kopi"
msgid "That's right! Good job!"
msgstr "Exact ! Bravo !"

# Traduction IA – à relire
#: kopi_coffee/first_latte_question/0/c-2/15
msgctxt "Kopi"
msgid "You just need a TOUCH of foam, and you're ready to finish up with some latte art!"
msgstr "Il te faut juste un SOUPÇON de mousse, et il ne reste plus qu'à finir avec un peu de latte art !"

# Traduction IA – à relire
#: kopi_coffee/second_latte_question/0/0
msgctxt "Kopi"
msgid "What is, in MY opinion, the MOST essential pattern to learn in latte art?"
msgstr "Selon MOI, quel est le motif LE PLUS essentiel à apprendre en latte art ?"

# Traduction IA – à relire
#: kopi_coffee/second_latte_question/0/8/s/0
msgctxt "Choix"
msgid "The Rosetta."
msgstr "Le Rosetta."

# Traduction IA – à relire
#: kopi_coffee/second_latte_question/0/9/s/0
msgctxt "Choix"
msgid "The Rosary."
msgstr "Le Rosaire."

# Traduction IA – à relire
#: kopi_coffee/second_latte_question/0/10/s/0
msgctxt "Choix"
msgid "The Rosaria."
msgstr "Le Rosaria."

# Traduction IA – à relire
#: kopi_coffee/second_latte_question/0/c-0/7
msgctxt "Kopi"
msgid "You're absolutely right!"
msgstr "Tout à fait !"

# Traduction IA – à relire
#: kopi_coffee/second_latte_question/0/c-0/15
msgctxt "Kopi"
msgid "The Rosetta... based on the plant. The... something Rosetta."
msgstr "Le Rosetta... d'après la plante. La... machin Rosetta."

# Traduction IA – à relire
#: kopi_coffee/second_latte_question/0/c-0/23
msgctxt "Kopi"
msgid "I'll get there."
msgstr "Ça va me revenir."

# Traduction IA – à relire
#: kopi_coffee/affogato_quiz/0/b/8
msgctxt "Kopi"
msgid "Hmm... you've tried the affogato a few times now."
msgstr "Hmm... tu as goûté l'affogato plusieurs fois."

# Traduction IA – à relire
#: kopi_coffee/affogato_quiz/0/b/16
msgctxt "Kopi"
msgid "Do you think you've remembered what I've told you?"
msgstr "Tu crois que tu as retenu ce que je t'ai dit ?"

# Traduction IA – à relire
#: kopi_coffee/first_affogato_question/0/0
msgctxt "Kopi"
msgid "Did I personally think the affogato was a drink, or a dessert?"
msgstr "Selon moi, l'affogato, c'était une boisson ou un dessert ?"

# Traduction IA – à relire
#: kopi_coffee/first_affogato_question/0/8/s/0
msgctxt "Choix"
msgid "You thought it was a dessert."
msgstr "Tu pensais que c'était un dessert."

# Traduction IA – à relire
#: kopi_coffee/first_affogato_question/0/9/s/0
msgctxt "Choix"
msgid "You thought it was a drink."
msgstr "Tu pensais que c'était une boisson."

# Traduction IA – à relire
#: kopi_coffee/first_affogato_question/0/c-1/7
msgctxt "Kopi"
msgid "Wow, you remembered! Yup, I like to think of it as a fun drink."
msgstr "Waouh, tu t'en souviens ! Oui, pour moi, c'est une boisson rigolote."

# Traduction IA – à relire
#: kopi_coffee/second_affogato_question/0/0
msgctxt "Kopi"
msgid "What does 'affogato' mean in Italian?"
msgstr "Que signifie « affogato » en italien ?"

# Traduction IA – à relire
#: kopi_coffee/second_affogato_question/0/8/s/0
msgctxt "Choix"
msgid "Drowned."
msgstr "Noyé."

# Traduction IA – à relire
#: kopi_coffee/second_affogato_question/0/9/s/0
msgctxt "Choix"
msgid "Drizzled."
msgstr "Nappé."

# Traduction IA – à relire
#: kopi_coffee/second_affogato_question/0/10/s/0
msgctxt "Choix"
msgid "Dropped."
msgstr "Noué."

# Traduction IA – à relire
#: kopi_coffee/second_affogato_question/0/c-0/7
msgctxt "Kopi"
msgid "Yes, that's right! Affogato means 'drowned'."
msgstr "Oui, c'est ça ! Affogato veut dire « noyé »."

# Traduction IA – à relire
#: kopi_coffee/second_affogato_question/0/c-0/15
msgctxt "Kopi"
msgid "Might be morbid... but I like it!"
msgstr "C'est peut-être morbide... mais j'aime bien !"

# Traduction IA – à relire
#: kopi_coffee/irish_quiz/0/b/8
msgctxt "Kopi"
msgid "Alright... you've had the Irish coffee a few times now."
msgstr "Bon... tu as pris plusieurs fois le café irlandais."

# Traduction IA – à relire
#: kopi_coffee/irish_quiz/0/b/16
msgctxt "Kopi"
msgid "Assuming you're not completely gone from the booze... pop quiz!"
msgstr "Si l'alcool ne t'a pas complètement grillé les neurones... interro surprise !"

# Traduction IA – à relire
#: kopi_coffee/first_irish_question/0/0
msgctxt "Kopi"
msgid "Why do you need to use Irish whiskey while making an Irish coffee?"
msgstr "Pourquoi faut-il du whiskey irlandais pour faire un café irlandais ?"

# Traduction IA – à relire
#: kopi_coffee/first_irish_question/0/8/s/0
msgctxt "Choix"
msgid "It's more sour."
msgstr "Il est plus acide."

# Traduction IA – à relire
#: kopi_coffee/first_irish_question/0/9/s/0
msgctxt "Choix"
msgid "It's more smoky and spicy."
msgstr "Il est plus fumé et plus épicé."

# Traduction IA – à relire
#: kopi_coffee/first_irish_question/0/10/s/0
msgctxt "Choix"
msgid "It's smoother with hints of vanilla."
msgstr "Il est plus doux, avec des notes de vanille."

# Traduction IA – à relire
#: kopi_coffee/first_irish_question/0/c-2/7
msgctxt "Kopi"
msgid "T-That's right!"
msgstr "E-Exact !"

# Traduction IA – à relire
#: kopi_coffee/first_irish_question/0/c-2/15
msgctxt "Kopi"
msgid "It IS smoother, and does have hints of vanilla in the taste... to bring out the tones of the coffee!"
msgstr "Il EST plus doux, avec des notes de vanille dans le goût... pour faire ressortir les arômes du café !"

# Traduction IA – à relire
#: kopi_coffee/second_irish_question/0/0
msgctxt "Kopi"
msgid "What do you pour over an Irish coffee?"
msgstr "Qu'est-ce qu'on verse sur un café irlandais ?"

# Traduction IA – à relire
#: kopi_coffee/second_irish_question/0/8/s/0
msgctxt "Choix"
msgid "Thick cream."
msgstr "De la crème épaisse."

# Traduction IA – à relire
#: kopi_coffee/second_irish_question/0/9/s/0
msgctxt "Choix"
msgid "Condensed milk."
msgstr "Du lait concentré."

# Traduction IA – à relire
#: kopi_coffee/second_irish_question/0/10/s/0
msgctxt "Choix"
msgid "Thick foam."
msgstr "De la mousse épaisse."

# Traduction IA – à relire
#: kopi_coffee/second_irish_question/0/c-0/7
msgctxt "Kopi"
msgid "You're on the ball! Yup, to make an Irish coffee, you pour whiskey and sugar over black coffee, stir it up a little bit, and then pour some thick cream over it!"
msgstr "Tu gères ! Oui, pour faire un café irlandais, on verse du whiskey et du sucre sur du café noir, on remue un peu, puis on verse de la crème épaisse par-dessus !"

# Traduction IA – à relire
#: kopi_coffee/answer_correct/0/6
msgctxt "Narrator"
msgid "Kopi beams at you."
msgstr "Kopi vous adresse un sourire radieux."

# Traduction IA – à relire
#: kopi_coffee/answer_correct/0/14
msgctxt "Kopi"
msgid "I'm happy you remembered!"
msgstr "Ça me fait plaisir que ça t'ait marqué !"

# Traduction IA – à relire
#: kopi_coffee/answer_correct/0/25
msgctxt "Kopi"
msgid "Anyways, thanks for taking my little quiz!"
msgstr "Enfin bref, merci d'avoir passé mon petit quiz !"

# Traduction IA – à relire
#: kopi_coffee/answer_correct/0/33/s/0
msgctxt "Choix"
msgid "Sure thing!"
msgstr "Avec plaisir !"

# Traduction IA – à relire
#: kopi_coffee/answer_correct/0/34/s/0
msgctxt "Choix"
msgid "Uh, okay? I'm just here for the coffee."
msgstr "Euh, d'accord ? Je suis juste là pour le café."

# Traduction IA – à relire
#: kopi_coffee/answer_correct/0/c-0/7
msgctxt "Kopi"
msgid "Stay caffeinated!"
msgstr "Que la caféine soit avec toi !"

# Traduction IA – à relire
#: kopi_coffee/answer_correct/0/c-1/7
msgctxt "Kopi"
msgid "Ah, right."
msgstr "Ah, d'accord."

# Traduction IA – à relire
#: kopi_coffee/answer_wrong/0
msgctxt "Narrator"
msgid "Kopi frowns, disappointment evident in her expression."
msgstr "Kopi fronce les sourcils, sa déception se lisant sur son visage."

# Traduction IA – à relire
#: kopi_coffee/answer_wrong/8
msgctxt "Kopi"
msgid "No... that's not it."
msgstr "Non... ce n'est pas ça."

# Traduction IA – à relire
#: kopi_coffee/answer_wrong/16
msgctxt "Kopi"
msgid "You really haven't been paying attention to what I've been saying... have you?"
msgstr "Tu n'as vraiment pas fait attention à ce que je disais... n'est-ce pas ?"

# Traduction IA – à relire
#: kopi_coffee/answer_wrong/27
msgctxt "Kopi"
msgid "I suppose I'll see you next time, then..."
msgstr "Je suppose que je te reverrai la prochaine fois, alors..."

# Traduction IA – à relire
#: kopi_coffee/coffee_reject_choice/0/8
msgctxt "Narrator"
msgid "Kopi places both palms on the counter, leaning over to glare at you."
msgstr "Kopi pose les deux paumes sur le comptoir et se penche pour vous fusiller du regard."

# Traduction IA – à relire
#: kopi_coffee/coffee_reject_choice/0/16
msgctxt "Kopi"
msgid "Alright, what's the deal?"
msgstr "Bon, c'est quoi le problème ?"

# Traduction IA – à relire
#: kopi_coffee/coffee_reject_choice/0/21/s/0 kopi_coffee/kopi_open_3/0/c-0/23/0/s/0
msgctxt "Choix"
msgid "What do you mean?"
msgstr "Comment ça ?"

# Traduction IA – à relire
#: kopi_coffee/coffee_reject_choice/0/g-0/0
msgctxt "Kopi"
msgid "You keep on coming in here on multiple days... getting NOTHING to drink."
msgstr "Tu viens ici plusieurs jours de suite... sans prendre RIEN à boire."

# Traduction IA – à relire
#: kopi_coffee/coffee_reject_choice/0/g-0/5
msgctxt "Kopi"
msgid "Why do you even come in here, if you're NOT getting coffee?"
msgstr "Pourquoi tu viens, si tu ne prends PAS de café ?"

# Traduction IA – à relire
#: kopi_coffee/coffee_reject_choice/0/g-0/13/s/0
msgctxt "Choix"
msgid "I like coming in to see you."
msgstr "J'aime venir te voir."

# Traduction IA – à relire
#: kopi_coffee/coffee_reject_choice/0/g-0/c-1/7
msgctxt "Kopi"
msgid "Look, I'm doing a JOB here."
msgstr "Écoute, je fais mon TRAVAIL, ici."

# Traduction IA – à relire
#: kopi_coffee/coffee_reject_choice/0/g-0/c-1/15
msgctxt "Kopi"
msgid "You can't keep coming in here to waste my time and loiter around."
msgstr "Tu ne peux pas continuer à venir me faire perdre mon temps et traîner dans le coin."

# Traduction IA – à relire
#: kopi_coffee/coffee_reject_choice/0/g-0/c-1/23
msgctxt "Kopi"
msgid "This kind of behavior is lowkey creepy."
msgstr "Ce comportement est un peu flippant."

# Traduction IA – à relire
#: kopi_coffee/coffee_reject_choice/0/g-0/c-1/31
msgctxt "Kopi"
msgid "I'm sorry, but I'm going to have to permanently ban you from Roofbucks."
msgstr "Désolée, mais je vais devoir te bannir définitivement de Roofbucks."

# Traduction IA – à relire
#: kopi_coffee/coffee_reject_choice/0/g-0/c-1/42
msgctxt "Kopi"
msgid "We won't be seeing you again."
msgstr "On ne te reverra plus."

# Traduction IA – à relire
#: kopi_coffee/coffee_reject_choice/0/g-0/c-1/81
msgctxt "Reggie"
msgid "Teehee - just creepily coming in to say hi, and ordering nothing?"
msgstr "Hihi - venir dire bonjour comme un creep sans rien commander ?"

# Traduction IA – à relire
#: kopi_coffee/coffee_reject_choice/0/g-0/c-1/89
msgctxt "Reggie"
msgid "One-way-ticket to Weirdoville!"
msgstr "Billet aller simple pour Bizarreville !"

# Traduction IA – à relire
#: kopi_coffee/coffee_double_reject/0
msgctxt "Kopi"
msgid "Again? Seriously??"
msgstr "Encore ? Sérieusement ??"

# Traduction IA – à relire
#: kopi_coffee/coffee_double_reject/8
msgctxt "Kopi"
msgid "No. Just no."
msgstr "Non. Juste non."

# Traduction IA – à relire
#: kopi_coffee/coffee_double_reject/19
msgctxt "Kopi"
msgid "Next time you come in I'm calling security."
msgstr "La prochaine fois que tu viens, j'appelle la sécurité."

# Traduction IA – à relire
#: kopi_coffee/weighty_encounter/0/0
msgctxt "Kopi"
msgid "Listen... I need to talk to you about something."
msgstr "Écoute... il faut que je te parle de quelque chose."

# Traduction IA – à relire
#: kopi_coffee/weighty_encounter/0/8/s/0
msgctxt "Choix"
msgid "What is it?"
msgstr "De quoi s'agit-il ?"

# Traduction IA – à relire
#: kopi_coffee/weighty_encounter/0/9/s/0
msgctxt "Choix"
msgid "I'm all ears."
msgstr "Je t'écoute."

# Traduction IA – à relire
#: kopi_coffee/weighty_encounter/0/g-0/0
msgctxt "Kopi"
msgid "It's just... you've been coming here so often..."
msgstr "C'est juste que... tu viens tellement souvent..."

# Traduction IA – à relire
#: kopi_coffee/weighty_encounter/0/g-0/8/s/0
msgctxt "Choix"
msgid "I visit to see you, what's wrong with that?"
msgstr "Je viens te voir, qu'est-ce qu'il y a de mal à ça ?"

# Traduction IA – à relire
#: kopi_coffee/weighty_encounter/0/g-0/9/s/0
msgctxt "Choix"
msgid "I've loved hearing you talk about coffee."
msgstr "J'adore t'entendre parler de café."

# Traduction IA – à relire
#: kopi_coffee/weighty_encounter/0/g-0/c-2/7
msgctxt "Kopi"
msgid "Well... that's the thing."
msgstr "Eh bien... c'est là le problème."

# Traduction IA – à relire
#: kopi_coffee/weighty_encounter/0/g-0/c-2/15
msgctxt "Kopi"
msgid "I feel like you've ONLY been visiting me just to hear me... rant on about my little coffee facts, but I wonder sometimes if you're really listening."
msgstr "J'ai l'impression que tu ne viens QUE pour m'entendre... débiter mes petites anecdotes sur le café, mais je me demande parfois si tu écoutes vraiment."

# Traduction IA – à relire
#: kopi_coffee/weighty_encounter/0/g-0/c-2/23
msgctxt "Kopi"
msgid "Do you like what I have to say?"
msgstr "Est-ce que ce que je raconte te plaît ?"

# Traduction IA – à relire
#: kopi_coffee/weighty_encounter/0/g-0/c-2/31/0/s/0
msgctxt "Choix"
msgid "It can be hard to remember some stuff, but I enjoy hearing you talk."
msgstr "Il y a des trucs difficiles à retenir, mais j'aime t'entendre parler."

# Traduction IA – à relire
#: kopi_coffee/weighty_encounter/0/g-0/c-2/31/1/s/0
msgctxt "Choix"
msgid "You know I'm listening! I got your answers right, didn't I?"
msgstr "Tu sais bien que j'écoute ! J'ai bien répondu, non ?"

# Traduction IA – à relire
#: kopi_coffee/weighty_encounter/0/g-0/c-2/31/2/s/0
msgctxt "Choix"
msgid "No, not at all. Service workers should stick to their jobs."
msgstr "Non, pas du tout. Les gens du service devraient s'en tenir à leur boulot."

# Traduction IA – à relire
#: kopi_coffee/weighty_encounter/0/g-0/c-2/31/c-0/7
msgctxt "Kopi"
msgid "Well... I can't be too hard on you, I suppose."
msgstr "Eh bien... je ne peux pas être trop dure avec toi, je suppose."

# Traduction IA – à relire
#: kopi_coffee/weighty_encounter/0/g-0/c-2/31/c-0/15 kopi_coffee/weighty_encounter/0/g-0/c-2/31/c-1/18
msgctxt "Kopi"
msgid "You're a good customer, and I'm glad to know you."
msgstr "Ça fait plaisir de te voir ici, et je suis ravie de te connaître."

# Traduction IA – à relire
#: kopi_coffee/weighty_encounter/0/g-0/c-2/31/c-0/26 kopi_coffee/weighty_encounter/0/g-0/c-2/31/c-1/29 kopi_coffee/weighty_encounter/0/g-0/c-2/31/c-2/18
msgctxt "Kopi"
msgid "Thanks for stopping by."
msgstr "Merci de ta visite."

# Traduction IA – à relire
#: kopi_coffee/weighty_encounter/0/g-0/c-2/31/c-1/7
msgctxt "Kopi"
msgid "You're right!"
msgstr "Tu as raison !"

# Traduction IA – à relire
#: kopi_coffee/weighty_encounter/0/g-0/c-2/31/c-2/60
msgctxt "Reggie"
msgid "Yeah! Everyone has a job - and yours is to cause chaos!"
msgstr "Ouais ! Tout le monde a un boulot - et le tien, c'est de semer le chaos !"

# Traduction IA – à relire
#: kopi_coffee/weighty_encounter/0/g-0/c-3/13
msgctxt "Kopi"
msgid "I'm... I'm glad!"
msgstr "Je... j'en suis ravie !"

# Traduction IA – à relire
#: kopi_coffee/weighty_encounter/0/g-0/c-3/21
msgctxt "Kopi"
msgid "I've definitely seen just how much you've come in to chat and learn it all."
msgstr "J'ai bien vu à quel point tu venais discuter et tout apprendre."

# Traduction IA – à relire
#: kopi_coffee/weighty_encounter/0/g-0/c-3/29
msgctxt "Kopi"
msgid "Like... WOAH. You've definitely absorbed a LOT since we started talking."
msgstr "Genre... OUAH. Tu as vraiment absorbé BEAUCOUP de choses depuis qu'on a commencé à parler."

# Traduction IA – à relire
#: kopi_coffee/weighty_encounter/0/g-0/c-3/40
msgctxt "Kopi"
msgid "You're a really attentive customer."
msgstr "Tu écoutes vraiment avec beaucoup d'attention."

# Traduction IA – à relire
#: kopi_coffee/weighty_encounter/0/g-0/c-3/48/0/s/0
msgctxt "Choix"
msgid "It's been an honour learning from you!"
msgstr "Ç'a été un honneur d'apprendre auprès de toi !"

# Traduction IA – à relire
#: kopi_coffee/weighty_encounter/0/g-0/c-3/48/c-0/7
msgctxt "Kopi"
msgid "Same with you, honestly!"
msgstr "Pareil pour toi, franchement !"

# Traduction IA – à relire
#: kopi_coffee/weighty_encounter/0/g-0/c-3/48/c-0/15
msgctxt "Kopi"
msgid "If it weren't for you... I don't think I'd be able to improve my coffee the same way!"
msgstr "Sans toi... je ne crois pas que j'aurais pu améliorer mon café comme ça !"

# Traduction IA – à relire
#: kopi_coffee/weighty_encounter/0/g-0/c-3/48/c-0/23
msgctxt "Kopi"
msgid "You've definitely helped me warm up my skills!"
msgstr "Tu m'as clairement aidée à échauffer mes compétences !"

# Traduction IA – à relire
#: kopi_coffee/weighty_encounter/0/g-0/c-3/48/c-0/31/0/s/0
msgctxt "Choix"
msgid "You certainly make some stellar coffee!"
msgstr "Tu fais vraiment un café exceptionnel !"

# Traduction IA – à relire
#: kopi_coffee/weighty_encounter/0/g-0/c-3/48/c-0/31/1/s/0
msgctxt "Choix"
msgid "And you've helped me warm up my heart."
msgstr "Et toi, tu m'as réchauffé le coeur."

# Traduction IA – à relire
#: kopi_coffee/weighty_encounter/0/g-0/c-3/48/c-0/31/2/s/0
msgctxt "Choix"
msgid "Maybe... you could warm me at night."
msgstr "Peut-être... que tu pourrais me réchauffer la nuit."

# Traduction IA – à relire
#: kopi_coffee/weighty_encounter/0/g-0/c-3/48/c-0/31/3/s/0
msgctxt "Choix"
msgid "You're... uh... you make me warm."
msgstr "Tu... euh... tu me donnes chaud."

# Traduction IA – à relire
#: kopi_coffee/weighty_encounter/0/g-0/c-3/48/c-0/31/4/s/0
msgctxt "Choix"
msgid "I was hoping that we could be more than that."
msgstr "J'espérais qu'on puisse être plus que ça."

# Traduction IA – à relire
#: kopi_coffee/weighty_encounter/0/g-0/c-3/48/c-0/31/c-0/7
msgctxt "Kopi"
msgid "Seriously... Thanks so much."
msgstr "Sérieusement... merci beaucoup."

# Traduction IA – à relire
#: kopi_coffee/weighty_encounter/0/g-0/c-3/48/c-0/31/c-0/15
msgctxt "Kopi"
msgid "I'll see you the next time you come down to Roofbucks!"
msgstr "À la prochaine fois que tu descends chez Roofbucks !"

# Traduction IA – à relire
#: kopi_coffee/love_path_1/0/0
msgctxt "Kopi"
msgid "Gosh... you're really sure about this?"
msgstr "Oh là là... tu me dis ça pour de vrai ?"

# Traduction IA – à relire
#: kopi_coffee/love_path_1/0/8/s/0
msgctxt "Choix"
msgid "You've brewed up love in my heart."
msgstr "Tu as fait infuser l'amour dans mon coeur."

# Traduction IA – à relire
#: kopi_coffee/love_path_1/0/c-0/7
msgctxt "Kopi"
msgid "<i>chuckles</i> So I see."
msgstr "<i>rit</i> Je vois ça."

# Traduction IA – à relire
#: kopi_coffee/love_path_1/0/c-0/15
msgctxt "Kopi"
msgid "We'll see how this goes, then. Feel free to stop by any time."
msgstr "On va voir ce que ça donne, alors. Passe quand tu veux."

# Traduction IA – à relire
#: kopi_coffee/love_path_2/0
msgctxt "Kopi"
msgid "You mean, like..."
msgstr "Tu veux dire, genre..."

# Traduction IA – à relire
#: kopi_coffee/love_path_2/8
msgctxt "Kopi"
msgid "Oh... Oh!"
msgstr "Oh... Oh !"

# Traduction IA – à relire
#: kopi_coffee/love_path_2/16
msgctxt "Kopi"
msgid "Gosh... I never expected this, but..."
msgstr "Oh là là... je ne m'y attendais pas, mais..."

# Traduction IA – à relire
#: kopi_coffee/love_path_2/24
msgctxt "Kopi"
msgid "Why not give it a go!"
msgstr "Pourquoi pas tenter le coup !"

# Traduction IA – à relire
#: kopi_coffee/love_path_2/32
msgctxt "Kopi"
msgid "I'm willing to try it if you are!"
msgstr "Je suis prête à essayer si toi aussi !"

# Traduction IA – à relire
#: kopi_coffee/love_path_2/40
msgctxt "Kopi"
msgid "Stop by any time..."
msgstr "Passe quand tu veux..."

# Traduction IA – à relire
#: kopi_coffee/love_path_3/0
msgctxt "Kopi"
msgid "Oh..."
msgstr "Oh..."

# Traduction IA – à relire
#: kopi_coffee/love_path_3/8
msgctxt "Kopi"
msgid "I'll take that as a confession, haha!"
msgstr "Je prends ça pour un aveu, haha !"

# Traduction IA – à relire
#: kopi_coffee/love_path_3/16
msgctxt "Kopi"
msgid "I might be interested. Give me some time to let this relationship brew."
msgstr "Ça pourrait m'intéresser. Laisse-moi un peu de temps pour laisser infuser cette relation."

# Traduction IA – à relire
#: kopi_coffee/love_path_4/8
msgctxt "Kopi"
msgid "Well... I'm certainly not opposed to it."
msgstr "Eh bien... je n'y suis certainement pas opposée."

# Traduction IA – à relire
#: kopi_coffee/love_path_4/16
msgctxt "Kopi"
msgid "Stop by any time you like. Let's allow this relationship to brew some more."
msgstr "Passe quand tu veux. Laissons cette relation infuser encore un peu."

# Traduction IA – à relire
#: kopi_coffee/kopi_friend_joiner/0 kopi_coffee/kopi_love_joiner/0
msgctxt "Narrator"
msgid "Kopi, with you as her right hand, thrives in the coffee business."
msgstr "Avec vous comme bras droit, Kopi prospère dans le commerce du café."

# Traduction IA – à relire
#: kopi_coffee/kopi_friend_joiner/8 kopi_coffee/kopi_love_joiner/8
msgctxt "Narrator"
msgid "Under her leadership, the house's coffee has never been better. Customers are satisfied, and have started to take a keen liking to chatting away with Kopi."
msgstr "Sous sa direction, le café de la maison n'a jamais été meilleur. Les clients sont satisfaits et ont pris goût à bavarder avec Kopi."

# Traduction IA – à relire
#: kopi_coffee/kopi_friend_joiner/16
msgctxt "Narrator"
msgid "And you are not her only new friend; she's becoming fast friends with everybody she meets."
msgstr "Et vous n'êtes pas sa seule nouvelle amie ; elle se lie d'amitié à toute vitesse avec tous ceux qu'elle rencontre."

# Traduction IA – à relire
#: kopi_coffee/kopi_friend_joiner/24 kopi_coffee/kopi_love_joiner/24
msgctxt "Narrator"
msgid "Without the shackles of corporate greed over her, she is the go-to spot for anybody looking to get a nice warm reception."
msgstr "Libérée des chaînes de la cupidité des grandes entreprises, elle est devenue l'adresse incontournable pour qui veut un accueil bien chaleureux."

# Traduction IA – à relire
#: kopi_coffee/kopi_friend_joiner/35
msgctxt "Narrator"
msgid "She's doing what she loves, and has a great friend to get through the tough times with."
msgstr "Elle fait ce qu'elle aime et peut compter sur un soutien en or pour traverser les moments difficiles."

# Traduction IA – à relire
#: kopi_coffee/kopi_love_joiner/16
msgctxt "Narrator"
msgid "Your love and support has shaped her new perspective on life, and coffee. She insisted all of her new drinks be dedicated to you, with your name adorned on the menu."
msgstr "Votre amour et votre soutien ont façonné sa nouvelle vision de la vie, et du café. Elle a insisté pour que toutes ses nouvelles boissons vous soient dédiées, avec votre nom sur la carte."

# Traduction IA – à relire
#: kopi_coffee/kopi_love_joiner/35
msgctxt "Narrator"
msgid "She's happy to have you right by her side, eagerly awaiting for you to try her next cup of coffee."
msgstr "Elle est heureuse de vous avoir à ses côtés, et attend avec impatience que vous goûtiez sa prochaine tasse de café."

# Traduction IA – à relire
#: kopi_coffee/kopi_coffee_lovereturn/0/0
msgctxt "Kopi"
msgid "Hi love!"
msgstr "Salut, mon chou !"

# Traduction IA – à relire
#: kopi_coffee/kopi_coffee_lovereturn/0/11/s/0
msgctxt "Choix"
msgid "How's work today, brewtiful?"
msgstr "Comment va le boulot aujourd'hui, ma cafébuleuse ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_coffee_lovereturn/0/12/s/0 kopi_coffee/kopi_coffee_friendshipreturn/0/45/s/0
msgctxt "Choix"
msgid "Actually, Kopi, I am ready to Realize you."
msgstr "En fait, Kopi, je suis {{prêt|prête|prêt·e}} à te Réaliser."

# Traduction IA – à relire
#: kopi_coffee/kopi_coffee_lovereturn/0/c-0/7
msgctxt "Kopi"
msgid "Heh, I love it when you call me that."
msgstr "Hé, j'adore quand tu m'appelles comme ça."

# Traduction IA – à relire
#: kopi_coffee/kopi_coffee_lovereturn/0/c-0/15
msgctxt "Kopi"
msgid "Work has been a little slow today, but, it's all worth it to see all the smiles from happy customers!"
msgstr "Le travail a été un peu calme aujourd'hui, mais ça vaut le coup rien que pour voir tous les sourires des clients contents !"

# Traduction IA – à relire
#: kopi_coffee/kopi_coffee_lovereturn/0/c-0/23
msgctxt "Kopi"
msgid "Seriously, love, if it wasn't for you, I'd still be under the corporate machine."
msgstr "Sérieusement, mon chou, sans toi, je serais encore sous la machine de l'entreprise."

# Traduction IA – à relire
#: kopi_coffee/kopi_coffee_lovereturn/0/c-0/31
msgctxt "Kopi"
msgid "How can I warm up my special little brew?"
msgstr "Comment je peux réchauffer ma petite infusion à moi ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_coffee_lovereturn/0/c-0/42/0/s/0
msgctxt "Choix"
msgid "Let's see..."
msgstr "Voyons voir..."

# Traduction IA – à relire
#: kopi_coffee/kopi_coffee_lovereturn/0/c-0/42/1/s/0 kopi_coffee/kopi_coffee_friendshipreturn/0/44/s/0
msgctxt "Choix"
msgid "Just wanted to say hi!"
msgstr "Je voulais juste dire bonjour !"

# Traduction IA – à relire
#: kopi_coffee/kopi_coffee_lovereturn/0/c-0/42/c-1/7 kopi_coffee/kopi_coffee_friendshipreturn/0/c-1/7
msgctxt "Kopi"
msgid "Aw... thanks!"
msgstr "Aw... merci !"

# Traduction IA – à relire
#: kopi_coffee/kopi_coffee_friendshipreturn/0/0
msgctxt "Kopi"
msgid "Heya, friendo! Glad to see you again."
msgstr "Coucou, toi ! Contente de te revoir."

# Traduction IA – à relire
#: kopi_coffee/kopi_coffee_friendshipreturn/0/8
msgctxt "Kopi"
msgid "Now, I'm still thinking of names to call my cafe."
msgstr "Alors, je cherche toujours des noms pour mon café."

# Traduction IA – à relire
#: kopi_coffee/kopi_coffee_friendshipreturn/0/16
msgctxt "Kopi"
msgid "Kopi's Coffee... Kopi's Kopi... Coffee's Kopi..."
msgstr "Le Café de Kopi... Kopi Café... Café Kopi..."

# Traduction IA – à relire
#: kopi_coffee/kopi_coffee_friendshipreturn/0/24
msgctxt "Kopi"
msgid "I'm... yeah I'm still workshopping it."
msgstr "Je... ouais, je suis encore en train d'y réfléchir."

# Traduction IA – à relire
#: kopi_coffee/kopi_coffee_friendshipreturn/0/35
msgctxt "Kopi"
msgid "Anyways, what can I getcha?"
msgstr "Bref, qu'est-ce que je te sers ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_coffee_friendshipreturn/0/43/s/0
msgctxt "Choix"
msgid "I want a drink!"
msgstr "Je veux une boisson !"

# Traduction IA – à relire
#: kopi_coffee/kopi_coffee_hatereturn/0/0
msgctxt "Kopi"
msgid "Welcome to Roofbucks. The home of all your coffee needs..."
msgstr "Bienvenue chez Roofbucks. La maison de tous vos besoins en café..."

# Traduction IA – à relire
#: kopi_coffee/kopi_coffee_hatereturn/0/8
msgctxt "Kopi"
msgid "Then again, it's not like you have any real coffee needs."
msgstr "Remarque, ce n'est pas comme si tu avais de vrais besoins en café."

# Traduction IA – à relire
#: kopi_coffee/kopi_coffee_hatereturn/0/16
msgctxt "Kopi"
msgid "I told you before."
msgstr "Je te l'ai déjà dit."

# Traduction IA – à relire
#: kopi_coffee/kopi_coffee_hatereturn/0/24
msgctxt "Kopi"
msgid "You're. Banned."
msgstr "Persona. Non. Grata."

# Traduction IA – à relire
#: kopi_coffee/kopi_coffee_hatereturn/0/32/s/0
msgctxt "Choix"
msgid "Fine."
msgstr "D'accord."

# Traduction IA – à relire
#: kopi_coffee/kopi_coffee_hatereturn/0/33/s/0
msgctxt "Choix"
msgid "Wait, I've changed my ways! (USE CHARM CANDY)"
msgstr "Attends, j'ai changé ! (UTILISER UN BONBON DE CHARME)"

# Traduction IA – à relire
#: kopi_coffee/kopi_coffee_hatereturn/0/c-0/7
msgctxt "Kopi"
msgid "Get lost."
msgstr "Dégage."

# Traduction IA – à relire
#: kopi_coffee/kopi_coffee_hatereturn/0/c-1/7
msgctxt "Kopi"
msgid "Really?"
msgstr "Vraiment ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_coffee_hatereturn/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "Yes, I realize I wasn't listening to you truly. But I've learned."
msgstr "Oui, je me rends compte que je ne t'écoutais pas vraiment. Mais j'ai appris."

# Traduction IA – à relire
#: kopi_coffee/kopi_coffee_hatereturn/0/c-1/15/c-0/7
msgctxt "Kopi"
msgid "All right. Might as well try this again."
msgstr "Très bien. Autant réessayer."

# Traduction IA – à relire
#: kopi_coffee/kopi_coffee_hatereturn/0/c-1/15/c-0/15
msgctxt "Kopi"
msgid "Next time you come in I'll treat you like any other customer."
msgstr "La prochaine fois que tu viens, je te traiterai comme n'importe quel autre client."

# Traduction IA – à relire
#: kopi_coffee/kopi_double_hate_return/0
msgctxt "Kopi"
msgid "Welcome to-"
msgstr "Bienvenue chez-"

# Traduction IA – à relire
#: kopi_coffee/kopi_double_hate_return/8
msgctxt "Kopi"
msgid "Oh, for pete's sake."
msgstr "Oh, bon sang."

# Traduction IA – à relire
#: kopi_coffee/kopi_double_hate_return/16
msgctxt "Kopi"
msgid "Security!"
msgstr "Sécurité !"

# Traduction IA – à relire
#: kopi_coffee/kopi_double_hate_return/27
msgctxt "Narrator"
msgid "You leave before they can forcibly take you away."
msgstr "Vous partez avant qu'on puisse vous emmener de force."

# Traduction IA – à relire
#: kopi_coffee/kopi_realize_join/0/0
msgctxt "Kopi"
msgid "Wait... really?"
msgstr "Attends... vraiment ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_realize_join/0/8
msgctxt "Kopi"
msgid "I can go do whatever I want?"
msgstr "Je peux faire tout ce que je veux ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_realize_join/0/25/s/0
msgctxt "Choix"
msgid "Yes, and I have what you need to do it."
msgstr "Oui, et j'ai ce qu'il te faut pour le faire."

# Traduction IA – à relire
#: kopi_coffee/kopi_realize_join/0/26/s/0
msgctxt "Choix"
msgid "Yes, but I'm not ready just yet."
msgstr "Oui, mais je ne suis pas encore {{prêt|prête|prêt·e}}."

# Traduction IA – à relire
#: kopi_coffee/kopi_realize_join/0/c-1/10
msgctxt "Kopi"
msgid "Oh, okay! Lemme know and circle back to me, all right?"
msgstr "Oh, d'accord ! Préviens-moi et reviens me voir, d'accord ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_realize_return/0/0
msgctxt "Kopi"
msgid "Oh hey! Welcome back!"
msgstr "Oh, salut ! Bon retour !"

# Traduction IA – à relire
#: kopi_coffee/kopi_realize_return/0/8
msgctxt "Kopi"
msgid "So, we doing this... or...?"
msgstr "Alors, on le fait... ou... ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_realize_return/0/25/s/0
msgctxt "Choix"
msgid "Yes, we're doing this!."
msgstr "Oui, on le fait !"

# Traduction IA – à relire
#: kopi_coffee/kopi_realize_return/0/26/s/0
msgctxt "Choix"
msgid "No, still not yet."
msgstr "Non, toujours pas."

# Traduction IA – à relire
#: kopi_coffee/kopi_realize_return/0/c-1/10
msgctxt "Kopi"
msgid "No problem!"
msgstr "Pas de souci !"

# Traduction IA – à relire
#: kopi_coffee/kopi_realize_return/0/c-1/18
msgctxt "Kopi"
msgid "I guess I'll just be waiting here."
msgstr "Je vais juste attendre ici, j'imagine."

# Traduction IA – à relire
#: kopi_coffee/kopi_realize_return/0/c-1/26
msgctxt "Kopi"
msgid "...waiting...."
msgstr "...j'attends...."

# Traduction IA – à relire
#: kopi_coffee/kopi_realize_begin/6/b/1
msgctxt "Skylar"
msgid "We're starting Realization with Kopi... she's so supportive it's bound to work."
msgstr "On commence la Réalisation avec Kopi... elle est tellement encourageante que ça va forcément marcher."

# Traduction IA – à relire
#: kopi_coffee/kopi_realize_begin/9
msgctxt "Skylar"
msgid "Rise 'n grind, Kopi!"
msgstr "Debout, au moulin, Kopi !"

# Traduction IA – à relire
#: kopi_coffee/kopi_realize_begin/23
msgctxt "Narrator"
msgid "The spectral energy flows through your dateviators, and what was once merely a coffee-maker, becomes...."
msgstr "L'énergie spectrale traverse vos Dateviators, et ce qui n'était jusqu'alors qu'une cafetière devient...."

# Traduction IA – à relire
#: kopi_coffee/kopi_realized/0/3
msgctxt "Kopi"
msgid "Welcome...."
msgstr "Bienvenue...."

# Traduction IA – à relire
#: kopi_coffee/kopi_realized/0/11
msgctxt "Kopi"
msgid "To..."
msgstr "Chez..."

# Traduction IA – à relire
#: kopi_coffee/kopi_realized/0/19
msgctxt "Kopi"
msgid "Humanbucks???"
msgstr "Humainbucks ???"

# Traduction IA – à relire
#: kopi_coffee/kopi_realized/0/27
msgctxt "Narrator"
msgid "Kopi bristles with energy - her ability to make coffee has increased a thousandfold; what with having actual fingers."
msgstr "Kopi déborde d'énergie : son talent pour le café a été multiplié par mille, maintenant qu'elle a de vrais doigts."

# Traduction IA – à relire
#: kopi_coffee/kopi_realized/0/35
msgctxt "Kopi"
msgid "Okay - what can I get you?"
msgstr "Bon, qu'est-ce que je te sers ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_realized/0/43/s/0
msgctxt "Choix"
msgid "You... don't have to get me anything."
msgstr "Tu... n'as pas à me servir quoi que ce soit."

# Traduction IA – à relire
#: kopi_coffee/kopi_realized/0/44/s/0
msgctxt "Choix"
msgid "A kiss?"
msgstr "Un baiser ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_realized/0/c-1/7
msgctxt "Kopi"
msgid "Is that some kind of drink?"
msgstr "C'est une sorte de boisson ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_realized/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "No, Kopi, kiss me!"
msgstr "Non, Kopi, embrasse-moi !"

# Traduction IA – à relire
#: kopi_coffee/kopi_realized/0/c-1/15/1/s/0
msgctxt "Choix"
msgid "Yeah, the kind of drink where you put your lips on mine."
msgstr "Oui, le genre de boisson où tu poses tes lèvres sur les miennes."

# Traduction IA – à relire
#: kopi_coffee/kopi_realized/0/c-1/15/g-0/0
msgctxt "Narrator"
msgid "Kopi stands... shocked. She never figured herself the kissing type. Not the least because she hasn't had lips for very long."
msgstr "Kopi reste figée... sous le choc. Elle ne s'était jamais vue comme du genre à embrasser. Ne serait-ce que parce qu'elle n'a pas de lèvres depuis très longtemps."

# Traduction IA – à relire
#: kopi_coffee/kopi_realized/0/c-1/15/g-0/8
msgctxt "Kopi"
msgid "...ohkay..."
msgstr "...o-kay..."

# Traduction IA – à relire
#: kopi_coffee/kopi_realized/0/c-1/15/g-0/16
msgctxt "Kopi"
msgid "Extra sweetener?"
msgstr "Un supplément de sucre ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_realized/0/c-1/15/g-0/24/0/s/0
msgctxt "Choix"
msgid "You know it!"
msgstr "Tu l'as dit !"

# Traduction IA – à relire
#: kopi_coffee/kopi_realized/0/c-1/15/g-0/24/1/s/0
msgctxt "Choix"
msgid "Nah, you're sweet enough already."
msgstr "Non, tu es déjà assez douce comme ça."

# Traduction IA – à relire
#: kopi_coffee/kopi_realized/0/c-1/15/g-0/24/g-0/3
msgctxt "Narrator"
msgid "Her kiss tastes of mint, the sweet aroma of freshly ground coffee beans tickling your senses."
msgstr "Son baiser a un goût de menthe, l'arôme sucré du café fraîchement moulu vous chatouillant les sens."

# Traduction IA – à relire
#: kopi_coffee/kopi_realized/0/c-1/15/g-0/24/g-0/11
msgctxt "Narrator"
msgid "It's hot."
msgstr "C'est brûlant."

# Traduction IA – à relire
#: kopi_coffee/kopi_realized/0/c-1/15/g-0/24/g-0/19
msgctxt "Narrator"
msgid "Piping hot."
msgstr "Brûlant, bouillant."

# Traduction IA – à relire
#: kopi_coffee/kopi_realized/0/c-1/15/g-0/24/g-0/27
msgctxt "Kopi"
msgid "Sorry..."
msgstr "Pardon..."

# Traduction IA – à relire
#: kopi_coffee/kopi_realized/0/c-1/15/g-0/24/g-0/35
msgctxt "Kopi"
msgid "But... you can always blow on me to cool me down."
msgstr "Mais... tu peux toujours souffler dessus pour me refroidir."

# Traduction IA – à relire
#: kopi_coffee/kopi_realized/0/c-1/15/g-0/24/g-0/43
msgctxt "Narrator"
msgid "Kopi holds your hands in hers."
msgstr "Kopi tient vos mains dans les siennes."

# Traduction IA – à relire
#: kopi_coffee/kopi_realized/0/g-0/0
msgctxt "Narrator"
msgid "She looks deep into your eyes, searching for some sign that all of this is real."
msgstr "Elle vous regarde au fond des yeux, cherchant un signe que tout cela est réel."

# Traduction IA – à relire
#: kopi_coffee/kopi_realized/0/g-0/8
msgctxt "Kopi"
msgid "Do you mean it? I don't have to work in coffee anymore? Take orders? Nothing like that?"
msgstr "Tu le penses vraiment ? Je n'ai plus à travailler dans le café ? Prendre des commandes ? Plus rien de tout ça ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_realized/0/g-0/16/s/0
msgctxt "Choix"
msgid "Not if you don't want to."
msgstr "Pas si tu n'en as pas envie."

# Traduction IA – à relire
#: kopi_coffee/kopi_realized/0/g-0/17/s/0
msgctxt "Choix"
msgid "You're free, Kopi."
msgstr "Tu es libre, Kopi."

# Traduction IA – à relire
#: kopi_coffee/kopi_realized/0/g-1/8
msgctxt "Kopi"
msgid "But I still like helping others. And spreading knowledge about coffee..."
msgstr "Mais j'aime toujours aider les autres. Et transmettre mon savoir sur le café..."

# Traduction IA – à relire
#: kopi_coffee/kopi_realized/0/g-1/19
msgctxt "Kopi"
msgid "Maybe I could open a shop of my own..."
msgstr "Je pourrais peut-être ouvrir ma propre boutique..."

# Traduction IA – à relire
#: kopi_coffee/kopi_realized/0/g-1/27
msgctxt "Kopi"
msgid "One free from multinational corporations."
msgstr "Une boutique libérée des multinationales."

# Traduction IA – à relire
#: kopi_coffee/kopi_realized/0/g-1/35
msgctxt "Narrator"
msgid "Kopi searches the world for the best place to make a small shop - one where she can serve coffee slowly, getting to know all the customers who come by."
msgstr "Kopi parcourt le monde à la recherche du meilleur endroit où ouvrir une petite boutique — un endroit où elle pourrait servir le café lentement, en apprenant à connaître chaque client de passage."

# Traduction IA – à relire
#: kopi_coffee/kopi_realized/0/g-1/43/b/1
msgctxt "Narrator"
msgid "Although she's still shell-shocked if any friars walk in."
msgstr "Même si elle reste traumatisée dès qu'un frère entre."

# Traduction IA – à relire
#: kopi_coffee/kopi_realized/0/g-1/46
msgctxt "Narrator"
msgid "A haven for coffee and a relaxing life, Kopi finds herself in the laneways of Melbourne, Australia."
msgstr "Havre de café et de vie tranquille, Kopi s'installe dans les ruelles de Melbourne, en Australie."

# Traduction IA – à relire
#: kopi_coffee/kopi_realized/0/g-1/54
msgctxt "Narrator"
msgid "Plus, her accent fits right in anyway."
msgstr "Et puis, son accent s'y fond très bien de toute façon."

# Traduction IA – à relire
#: kopi_coffee/kopi_realized/0/g-1/62
msgctxt "Kopi"
msgid "Welcome to SiterBucks!"
msgstr "Bienvenue chez SiterBucks !"

# Traduction IA – à relire
#: kopi_coffee/kopi_realized/0/g-1/70
msgctxt "Narrator"
msgid "Yes, with the walls full of the sound of the Indonesian instrument the siter, Kopi has found a way to rebrand Roofbucks with a name that doesn't sound like anything else, while paying homage to Southeast Asian culture."
msgstr "Oui, avec des murs emplis des sons du siter, l'instrument indonésien, Kopi a trouvé comment rebaptiser Roofbucks sous un nom qui ne ressemble à rien d'autre, tout en rendant hommage à la culture d'Asie du Sud-Est."

# Traduction IA – à relire
#: kopi_coffee/kopi_realized/0/g-1/75
msgctxt "Narrator"
msgid "The coffee is poured extra-slowly, and the conversations are extra-long. Customers who come and visit are treated to education and elucidation on bean provenance and preparation."
msgstr "Le café est versé extra-lentement, et les conversations sont extra-longues. Les clients de passage ont droit à des cours et des explications sur la provenance et la préparation des grains."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/6
msgctxt "Narrator"
msgid "Kopi is for once, not busying herself making coffee when you see her. She rests her head on her hand, staring off into the distance."
msgstr "Pour une fois, Kopi n'est pas occupée à faire du café quand vous la voyez. Elle appuie la tête sur sa main, le regard perdu au loin."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/30/s/0
msgctxt "Choix"
msgid "Uhh, Kopi?"
msgstr "Euh, Kopi ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-0/0
msgctxt "Narrator"
msgid "She starts, lifting her head from her hand."
msgstr "Elle sursaute, relevant la tête de sa main."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-0/8
msgctxt "Kopi"
msgid "Oh! Sorry, hey, good to see you!"
msgstr "Oh ! Pardon, salut, ça fait plaisir de te voir !"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-0/16
msgctxt "Kopi"
msgid "Anything I can get for you today?"
msgstr "Je peux te servir quelque chose aujourd'hui ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-0/24/s/0
msgctxt "Choix"
msgid "Why were you just staring off into space?"
msgstr "Pourquoi tu regardais dans le vide ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-0/25/s/0
msgctxt "Choix"
msgid "Where's your usual greeting?"
msgstr "Où est ta formule d'accueil habituelle ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-0/c-1/7
msgctxt "Kopi"
msgid "Oh, well, uh, it's kinda just what I do every now and then."
msgstr "Oh, eh bien, euh, c'est juste ce que je fais de temps en temps."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-0/c-2/7
msgctxt "Kopi"
msgid "Sorry! I was... distracted."
msgstr "Pardon ! J'étais... distraite."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-1/0
msgctxt "Kopi"
msgid "Most of the time when I don't have customers, I'm kinda just expected to do busy work. Y'know..."
msgstr "La plupart du temps, quand je n'ai pas de clients, on attend de moi que je m'occupe avec des tâches ingrates. Tu vois..."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-1/8
msgctxt "Kopi"
msgid "\"If there's time to lean, there's time to clean!\""
msgstr "« Si t'as le temps de t'appuyer, t'as le temps de briquer ! »"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-1/16
msgctxt "Kopi"
msgid "But, like, a lot of the time there's pretty much just nothing else to do, so I just... dissociate."
msgstr "Mais bon, souvent il n'y a carrément rien d'autre à faire, alors je... je dissocie."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-1/24
msgctxt "Kopi"
msgid "I guess it helps me deal with the business behind the scenes."
msgstr "Je crois que ça m'aide à gérer les coulisses du métier."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-1/32/s/0
msgctxt "Choix"
msgid "I can't imagine the kinds of things you have to deal with."
msgstr "Je n'ose imaginer ce que tu dois gérer."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-1/33/s/0
msgctxt "Choix"
msgid "You must hate your job."
msgstr "Tu dois détester ton boulot."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-1/c-3/7
msgctxt "Kopi"
msgid "You can. It involves cleaning, mostly."
msgstr "Tu peux. Ça implique surtout de nettoyer."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-1/c-4/7
msgctxt "Kopi"
msgid "It's not that I don't like my job. I love my job."
msgstr "Ce n'est pas que je n'aime pas mon travail. J'adore mon travail."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-2/0
msgctxt "Kopi"
msgid "But... I think Roofbucks expects me to be all smiles, all the time."
msgstr "Mais... je crois que Roofbucks attend de moi que je sois tout sourire, tout le temps."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-2/8/s/0
msgctxt "Choix"
msgid "They give you orders like some sort of royalty?"
msgstr "Ils te donnent des ordres comme des rois ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-2/9/s/0
msgctxt "Choix"
msgid "Do they ever come around?"
msgstr "Est-ce qu'ils passent parfois ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-2/c-5/7
msgctxt "Kopi"
msgid "The owner does."
msgstr "Le patron, oui."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-2/c-6/7
msgctxt "Kopi"
msgid "The owner is never around. He just likes being outside of everything that involves boots on the ground..."
msgstr "Le patron n'est jamais là. Il aime juste se tenir à l'écart de tout ce qui se passe sur le terrain..."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-3/0
msgctxt "Kopi"
msgid "It's like... I can only do so much, y'know?"
msgstr "C'est comme si... je ne pouvais faire que ça, tu vois ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-3/8
msgctxt "Kopi"
msgid "Especially when I'm scheduled to have long, grueling shifts."
msgstr "Surtout quand on me met de longs services éreintants."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-3/16
msgctxt "Kopi"
msgid "It's always a pain, but, gotta do what I can for the corporate machine!"
msgstr "C'est toujours pénible, mais bon, il faut bien faire ce qu'on peut pour la machine de l'entreprise !"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-3/24
msgctxt "Kopi"
msgid "It's a... strange existence, if I'm being honest."
msgstr "C'est une drôle d'existence, pour être honnête."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-3/32
msgctxt "Kopi"
msgid "Working every day for a company that wouldn't bat an eye if I went away."
msgstr "Travailler tous les jours pour une entreprise qui ne broncherait pas si je disparaissais."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-3/40
msgctxt "Kopi"
msgid "They'd just replace me with a newer, younger barista that's got skills I wouldn't even dream of."
msgstr "Ils me remplaceraient juste par une barista plus récente, plus jeune, avec des compétences dont je n'oserais même pas rêver."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-3/48
msgctxt "Kopi"
msgid "I think there's some baristas out there that can make whole drinks in like... 30 seconds flat, and all they have to do is just tap some setting in their brain to get going."
msgstr "Je crois qu'il y a des baristas qui peuvent préparer des boissons entières en genre... 30 secondes chrono, et il leur suffit de taper un réglage dans leur cerveau pour s'y mettre."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-3/56
msgctxt "Kopi"
msgid "Me? I like to take my time with drinks."
msgstr "Moi ? J'aime prendre mon temps avec les boissons."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-3/64
msgctxt "Kopi"
msgid "Really make sure that the milk in my hands is at the perfect temperature by really feeling it... y'know?"
msgstr "M'assurer vraiment que le lait dans mes mains est à la température parfaite en le sentant vraiment... tu vois ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-3/72/s/0
msgctxt "Choix"
msgid "Doesn't that wear you out?"
msgstr "Ça ne t'épuise pas ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-4/0
msgctxt "Kopi"
msgid "Oh, big time, but I'll never let customers see it on my face."
msgstr "Oh, et comment, mais je ne laisserai jamais les clients le voir sur mon visage."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-4/8
msgctxt "Kopi"
msgid "Is it unhealthy? Probably."
msgstr "C'est malsain ? Probablement."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-4/16
msgctxt "Kopi"
msgid "Will I take steps to fix it? Probably not."
msgstr "Est-ce que je ferai quelque chose pour y remédier ? Probablement pas."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-4/24
msgctxt "Kopi"
msgid "I just gotta make sure I'm on my game, otherwise I'd be tempted to drink a bit of coffee during the night shift."
msgstr "Je dois juste rester au top, sinon je serais tentée de boire un peu de café pendant le service de nuit."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-4/32/s/0
msgctxt "Choix"
msgid "What's wrong with getting coffee at night?"
msgstr "Qu'est-ce qu'il y a de mal à prendre du café la nuit ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-4/33/s/0
msgctxt "Choix"
msgid "I'll never get coffee at night, so I'm not interested."
msgstr "Je ne prendrai jamais de café la nuit, donc ça ne m'intéresse pas."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-4/c-8/7
msgctxt "Kopi"
msgid "I mean, look, I would never deny myself the taste of a good coffee, and I would love to drink it anytime I pleased, but not at night."
msgstr "Écoute, je ne me priverais jamais du goût d'un bon café, et j'adorerais en boire quand je veux, mais pas la nuit."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-4/c-8/15
msgctxt "Kopi"
msgid "I don't know if it's just caffeine induced psychosis, or whatever, but you'll get nightmares. Guaranteed."
msgstr "Je ne sais pas si c'est de la psychose induite par la caféine ou autre, mais tu fais des cauchemars. Garanti."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-4/c-9/7
msgctxt "Kopi"
msgid "Phew, well, that's a relief."
msgstr "Ouf, bon, ça me soulage."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-5/0
msgctxt "Kopi"
msgid "But, yeah, I pretty much get worked to the bone here. Day and night. So, sometimes I just tune out a bit."
msgstr "Mais bon, ici on me fait travailler jusqu'à l'os. Jour et nuit. Alors parfois je décroche un peu."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-5/8
msgctxt "Kopi"
msgid "Do NOT get me wrong, I do love my job. I couldn't just NOT make coffee; it's my life, y'know?"
msgstr "Ne va PAS te méprendre, j'adore mon travail. Je ne pourrais pas NE PAS faire de café ; c'est ma vie, tu vois ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-5/16
msgctxt "Kopi"
msgid "And, it's what I'm made for. These hands are as steady as an arabica!"
msgstr "Et c'est pour ça que je suis faite. Ces mains sont aussi stables qu'un arabica !"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-5/24
msgctxt "Kopi"
msgid "... Which isn't to say much because they sway pretty badly in the breeze."
msgstr "... Ce qui ne veut pas dire grand-chose, parce qu'elles vacillent pas mal à la moindre brise."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-5/35
msgctxt "Kopi"
msgid "Gosh, sorry, feels like I'm rambling again..."
msgstr "Oh là là, pardon, j'ai l'impression de divaguer encore..."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-5/46/s/0
msgctxt "Choix"
msgid "Maybe I'll have to report you to the manager!"
msgstr "Je vais peut-être devoir te signaler au directeur !"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-5/47/s/0
msgctxt "Choix"
msgid "You're cute when you ramble."
msgstr "Tu es mignonne quand tu divagues."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-5/c-10/7
msgctxt "Kopi"
msgid "Ahahaha! Ahahaha... haha..."
msgstr "Ahahaha ! Ahahaha... haha..."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-5/c-10/15
msgctxt "Kopi"
msgid "Funny, but, gosh, don't even JOKE about that."
msgstr "Drôle, mais, oh là là, ne plaisante même PAS avec ça."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-5/c-11/18
msgctxt "Kopi"
msgid "Thanks."
msgstr "Merci."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-5/c-11/26
msgctxt "Kopi"
msgid "If only the manager felt that way."
msgstr "Si seulement le directeur pensait pareil."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-6/0
msgctxt "Kopi"
msgid "The owner is SUPER particular about the way I do customer service."
msgstr "Le patron est SUPER pointilleux sur ma façon de faire le service client."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-6/8
msgctxt "Kopi"
msgid "We differ in that aspect a LOT I guess, but, gotta do whatever I can to help keep the lights on."
msgstr "On diffère BEAUCOUP là-dessus, je suppose, mais il faut bien faire ce qu'on peut pour que ça tourne."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-6/16
msgctxt "Kopi"
msgid "It'd be nice if he actually took the time to LEARN about coffee, like you did."
msgstr "Ce serait bien qu'il prenne vraiment le temps d'APPRENDRE ce qu'est le café, comme toi."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-6/24/s/0
msgctxt "Choix"
msgid "I had a perfect blend of intelligence and looks teaching me."
msgstr "J'avais un mélange parfait d'intelligence et de beauté pour me l'enseigner."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-6/25/s/0
msgctxt "Choix"
msgid "He probably just doesn't understand the importance of coffee."
msgstr "Il ne comprend probablement pas l'importance du café."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-6/c-12/7
msgctxt "Kopi"
msgid "Oh... stop... !"
msgstr "Oh... arrête... !"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-6/c-12/15
msgctxt "Kopi"
msgid "I don't think I was THAT good of a teacher, but... you do know how to flatter a girl."
msgstr "Je ne crois pas avoir été une SI bonne prof, mais... tu sais flatter une fille."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-6/c-13/7
msgctxt "Kopi"
msgid "Don't I know it."
msgstr "Je le sais bien."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-7/0
msgctxt "Kopi"
msgid "It is what it is, I guess. But hey, at least I get to see my favorite regular!"
msgstr "C'est comme ça, je suppose. Mais bon, au moins je vois ma star des habitués !"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_1/0/g-7/8
msgctxt "Kopi"
msgid "Thanks for the chat, seriously. We need to talk more soon!"
msgstr "Merci pour la discussion, sérieusement. Il faut qu'on se reparle bientôt !"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/6
msgctxt "Narrator"
msgid "Kopi greets you robotically, lifting her hand to give you a stiff wave. Her gaze looks vacant and her words are cold and empty."
msgstr "Kopi vous salue de façon robotique, levant la main pour un salut raide. Son regard est vide et ses mots froids et creux."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/14
msgctxt "Kopi"
msgid "Welcome back! To Roofbucks!"
msgstr "Bon retour ! Chez Roofbucks !"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/22
msgctxt "Kopi"
msgid "Home of all your coffee needs..."
msgstr "La maison de tous vos besoins en café..."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/30/s/0
msgctxt "Choix"
msgid "What the hell is going on?"
msgstr "C'est quoi ce bazar ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/31/s/0
msgctxt "Choix"
msgid "I'm going to just ignore this."
msgstr "Je vais juste ignorer ça."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/c-0/7
msgctxt "Kopi"
msgid "Whatever do you mean, oh fine customer?"
msgstr "Que voulez-vous dire, estimée clientèle ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/c-1/7
msgctxt "Kopi"
msgid "Try your best... but it'll always get to ya."
msgstr "Fais de ton mieux... mais ça finit toujours par te rattraper."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-0/0
msgctxt "Kopi"
msgid "Roofbucks wants to ensure you have a consistent and standardized greeting, so that whenever you come to our store, you know that you are getting the best service every time..."
msgstr "Roofbucks tient à vous garantir un accueil constant et standardisé, afin que chaque fois que vous venez dans notre boutique, vous sachiez que vous recevez le meilleur service à chaque fois..."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-0/8
msgctxt "Kopi"
msgid "...and your continued patronage is appreciated..."
msgstr "...et votre fidélité continue est appréciée..."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-0/16
msgctxt "Narrator"
msgid "Kopi trails off, leaning forward in a sigh that seems to make her entire body droop."
msgstr "Kopi s'interrompt, se penchant en avant dans un soupir qui semble affaisser tout son corps."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-0/24
msgctxt "Kopi"
msgid "...yeah, I can't do that anymore."
msgstr "...ouais, je ne peux plus faire ça."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-0/32/s/0
msgctxt "Choix"
msgid "That was... weird."
msgstr "C'était... bizarre."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-0/33/s/0
msgctxt "Choix"
msgid "But we know each other well now."
msgstr "Mais on se connaît bien, maintenant."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-0/c-2/7
msgctxt "Kopi"
msgid "I know, I know. Roofbucks wants people to add the \"Roofbucks\" touch every single time we greet customers."
msgstr "Je sais, je sais. Roofbucks veut qu'on ajoute la touche « Roofbucks » à chaque accueil de client."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-0/c-3/7
msgctxt "Kopi"
msgid "Yeah, even though you're a regular here, apparently I can't get \"too\" friendly with customers by dropping the formalities."
msgstr "Ouais, même si tu viens souvent ici, apparemment je ne peux pas être « trop » amicale avec les clients en laissant tomber les formalités."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-1/0
msgctxt "Kopi"
msgid "So they're just making me sound like... a monotone robot."
msgstr "Du coup, ils me font parler comme... un robot monotone."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-1/8/s/0
msgctxt "Choix"
msgid "Take me... to your leader."
msgstr "Conduis-moi... à ton chef."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-1/9/s/0
msgctxt "Choix"
msgid "Sounds... like a handful."
msgstr "Ça a l'air... compliqué à gérer."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-1/c-4/7
msgctxt "Kopi"
msgid "...PFF-!"
msgstr "...PFF-!"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-1/c-4/18
msgctxt "Kopi"
msgid "Alright, alright, you get that one."
msgstr "Bon, d'accord, celle-là, je te l'accorde."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-1/c-5/7
msgctxt "Kopi"
msgid "You have no idea."
msgstr "Tu n'as aucune idée."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-1/c-5/18
msgctxt "Kopi"
msgid "I... wait, was that supposed to be a pun?"
msgstr "Je... attends, c'était censé être un jeu de mots ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-1/c-5/26
msgctxt "Kopi"
msgid "No... what am I saying?"
msgstr "Non... qu'est-ce que je raconte ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-1/c-5/37
msgctxt "Kopi"
msgid "I'm sorry, yeah, I'm definitely overthinking that."
msgstr "Pardon, oui, je me prends clairement trop la tête."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-1/c-5/45
msgctxt "Kopi"
msgid "Sorry, sometimes when I'm blowing off steam it feels like I'm going a million miles a minute."
msgstr "Pardon, parfois quand je me défoule, j'ai l'impression d'aller à un million à l'heure."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-1/c-5/50/0/s/0
msgctxt "Choix"
msgid "You're doing great!"
msgstr "Tu te débrouilles très bien !"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-1/c-5/50/1/s/0
msgctxt "Choix"
msgid "Must be all that coffee..."
msgstr "Ça doit être tout ce café..."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-2/0
msgctxt "Kopi"
msgid "But it sucks, too... I feel like every coffee I make for somebody, I learn a little bit more about them. Get to know what they're like."
msgstr "Mais c'est nul aussi... j'ai l'impression qu'à chaque café que je prépare pour quelqu'un, j'en apprends un peu plus sur la personne. Je découvre comment elle est."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-2/8
msgctxt "Kopi"
msgid "Like you, for instance. You're..."
msgstr "Toi, par exemple. Tu es..."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-2/16
msgctxt "Kopi"
msgid "Well, I don't really have words for it..."
msgstr "Eh bien, je n'ai pas vraiment de mots pour ça..."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-2/24
msgctxt "Kopi"
msgid "Friendly?"
msgstr "Sympa ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-2/32
msgctxt "Kopi"
msgid "Sorry, my mind is drawing a blank. Sometimes when we talk, I feel a little out of my depth."
msgstr "Pardon, mon esprit fait le vide. Parfois, quand on parle, je me sens un peu dépassée."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-2/43/s/0
msgctxt "Choix"
msgid "I could say the same for the barista making my drinks."
msgstr "Je pourrais en dire autant de la barista qui prépare mes boissons."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-2/44/s/0
msgctxt "Choix"
msgid "Friendly sounds about right."
msgstr "Sympa, ça me semble juste."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-2/c-6/7
msgctxt "Kopi"
msgid "Is... that a good thing or a bad thing?"
msgstr "Est-ce que c'est... une bonne ou une mauvaise chose ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-2/c-6/15
msgctxt "Kopi"
msgid "How would you describe me then?"
msgstr "Comment tu me décrirais, alors ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-2/c-6/23/0/s/0
msgctxt "Choix"
msgid "You're kind and thoughtful."
msgstr "Tu es gentille et attentionnée."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-2/c-6/23/1/s/0
msgctxt "Choix"
msgid "You're like the coffee you make... warm and brew-tiful."
msgstr "Tu es comme le café que tu fais... chaleureuse et cafébuleuse."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-2/c-6/23/c-0/7
msgctxt "Kopi"
msgid "Oh, well, heh, thank you. I do try."
msgstr "Oh, eh bien, hé, merci. J'essaie."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-2/c-6/23/c-1/7
msgctxt "Kopi"
msgid "W-Well... I've never received such a review before... haha. Thank you."
msgstr "E-Eh bien... je n'ai jamais reçu un tel avis... haha. Merci."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-3/0
msgctxt "Kopi"
msgid "But, you get what I mean, right?"
msgstr "Mais tu vois ce que je veux dire, non ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-3/8
msgctxt "Kopi"
msgid "I like to be more personable with the customers; that's the best kind of customer experience to me."
msgstr "J'aime être plus personnelle avec les clients ; pour moi, c'est la meilleure expérience client."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-3/16
msgctxt "Kopi"
msgid "The corporate nature always gets in the way of all of that."
msgstr "L'esprit d'entreprise se met toujours en travers de tout ça."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-3/24
msgctxt "Kopi"
msgid "Heck, if it weren't for the customers, maybe I would've quit a long time ago."
msgstr "Franchement, sans les clients, j'aurais peut-être démissionné depuis longtemps."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-3/32
msgctxt "Kopi"
msgid "Coffee is just... everything to me. The aroma, the flavor profiles, the warmth."
msgstr "Le café, c'est... tout pour moi. L'arôme, les profils de saveurs, la chaleur."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-3/40
msgctxt "Kopi"
msgid "You feel that too, right?"
msgstr "Tu le ressens aussi, non ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-3/48/s/0
msgctxt "Choix"
msgid "Of course."
msgstr "Bien sûr."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-3/49/s/0
msgctxt "Choix"
msgid "Probably not as much as you, but I get it."
msgstr "Sûrement pas autant que toi, mais je comprends."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-3/c-8/7
msgctxt "Kopi"
msgid "Good... good..."
msgstr "Bien... bien..."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-3/c-8/15
msgctxt "Kopi"
msgid "I'm glad somebody around here does."
msgstr "Je suis contente que quelqu'un ici comprenne."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-3/c-9/7
msgctxt "Kopi"
msgid "Yeah you're not a literal coffeemaker so I guess I win that one."
msgstr "Ouais, tu n'es pas une cafetière au sens propre, donc je suppose que je gagne celle-là."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-4/0
msgctxt "Kopi"
msgid "Sometimes it feels like I go cocoa crazy and nobody else really gets my obsession with this fabulous drink, especially with a boss like..."
msgstr "Parfois j'ai l'impression de devenir cacao-dingue et que personne ne comprend vraiment mon obsession pour cette boisson fabuleuse, surtout avec un patron comme..."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-4/8
msgctxt "Kopi"
msgid "Look, I... I wasn't going to say anything while he was here, but... he's making new plans."
msgstr "Écoute, je... je n'allais rien dire pendant qu'il était là, mais... il prépare de nouveaux plans."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-4/16
msgctxt "Kopi"
msgid "Plans that... I don't like."
msgstr "Des plans que... je n'aime pas."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-4/24/s/0
msgctxt "Choix"
msgid "What plans?"
msgstr "Quels plans ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-4/25/s/0
msgctxt "Choix"
msgid "Uh oh."
msgstr "Oh oh."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-4/c-11/7
msgctxt "Kopi"
msgid "Uh oh is right."
msgstr "Oh oh, c'est le mot."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-5/0
msgctxt "Kopi"
msgid "Roofbucks in their infinite wisdom... have decided to completely get rid of the customer experience."
msgstr "Roofbucks, dans son infinie sagesse... a décidé de supprimer complètement l'expérience client."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-5/8
msgctxt "Kopi"
msgid "They want to turn us into... into a fast coffee business."
msgstr "Ils veulent faire de nous... un commerce de café rapide."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-5/16/s/0
msgctxt "Choix"
msgid "Fast coffee?"
msgstr "Du café rapide ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-5/17/s/0
msgctxt "Choix"
msgid "But you love going slowly!"
msgstr "Mais tu adores prendre ton temps !"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-5/c-13/7
msgctxt "Kopi"
msgid "Exactly!"
msgstr "Exactement !"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-6/0
msgctxt "Kopi"
msgid "They say the whole ordering system needs to be completely revamped to maximise profit."
msgstr "Ils disent que tout le système de commande doit être entièrement refondu pour maximiser les profits."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-6/8
msgctxt "Kopi"
msgid "Instead of warmly greeting customers like I normally would, now I'm expected to have 30 second interactions with them at the MOST to get their order..."
msgstr "Au lieu d'accueillir chaleureusement les clients comme d'habitude, je dois désormais avoir des échanges de 30 secondes MAXIMUM avec eux pour prendre leur commande..."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-6/16
msgctxt "Kopi"
msgid "...and then mindlessly brew away."
msgstr "...puis infuser sans réfléchir."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-6/24
msgctxt "Kopi"
msgid "No special touches, no conversations, nothing."
msgstr "Pas de petites attentions, pas de conversations, rien."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-6/32
msgctxt "Kopi"
msgid "Coffee in, coffee out."
msgstr "Café entrant, café sortant."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-6/40
msgctxt "Kopi"
msgid "It's like they don't want what they hired me for. Quality, and thoughtful coffee."
msgstr "C'est comme s'ils ne voulaient plus de ce pour quoi ils m'ont embauchée. Un café de qualité, réfléchi."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-6/48
msgctxt "Kopi"
msgid "They just want me to take every customer interaction... every drink I make... make it all in an instant and then wrap it all up and throw it away in a disposable pod."
msgstr "Ils veulent juste que chaque interaction avec un client... chaque boisson que je prépare... que je fasse tout en un instant, puis que j'emballe le tout et le jette dans une dosette jetable."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-6/56
msgctxt "Kopi"
msgid "Apparently, \"somebody\" made a complaint about the times I've been chatting away... mainly to you."
msgstr "Apparemment, « quelqu'un » s'est plaint de toutes les fois où j'ai papoté... surtout avec toi."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-6/64/s/0
msgctxt "Choix"
msgid "This is all my fault."
msgstr "C'est entièrement ma faute."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-6/65/s/0
msgctxt "Choix"
msgid "I'm so sorry..."
msgstr "Mille excuses..."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-6/66/s/0
msgctxt "Choix"
msgid "I'm gonna find that snitch and end them."
msgstr "Je vais trouver cette balance et en finir avec elle."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-6/c-14/7
msgctxt "Kopi"
msgid "Oh, honey, no, don't blame yourself!"
msgstr "Oh, chou, non, ne te blâme pas !"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-6/c-15/7
msgctxt "Kopi"
msgid "It's not your fault at all... if anything, it's fully on me."
msgstr "Ce n'est pas ta faute du tout... si quoi que ce soit, c'est entièrement la mienne."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-6/c-16/7
msgctxt "Kopi"
msgid "Whoa! Don't have to go that far!"
msgstr "Waouh ! Pas la peine d'aller jusque-là !"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-7/0
msgctxt "Kopi"
msgid "I get it... I'm just probably not the corporate machine type... I care too much."
msgstr "Je comprends... je ne suis simplement probablement pas du genre machine d'entreprise... je me soucie trop."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-7/8/s/0
msgctxt "Choix"
msgid "Have you ever thought about making coffee somewhere else?"
msgstr "Tu as déjà pensé à faire du café ailleurs ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-7/c-17/7
msgctxt "Kopi"
msgid "S-Somewhere else?"
msgstr "A-Ailleurs ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-7/c-17/15
msgctxt "Kopi"
msgid "I... I guess I never thought of that before. I mean... I guess I do know a thing or two about my coffee."
msgstr "Je... je crois que je n'y avais jamais pensé. Enfin... je crois que je m'y connais un peu en café."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-7/c-17/23
msgctxt "Kopi"
msgid "But... Roofbucks has a complete monopoly on the coffee business; there's nowhere else for me to go."
msgstr "Mais... Roofbucks a un monopole total sur le café ; il n'y a nulle part ailleurs où aller."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-7/c-17/31/0/s/0
msgctxt "Choix"
msgid "You're a literal coffeemaker. You don't need them."
msgstr "Tu es une vraie cafetière. Tu n'as pas besoin d'eux."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-7/c-17/31/c-0/7
msgctxt "Kopi"
msgid "Wow, I... I mean, it's a lot of work to make that happen. I wouldn't have any corporate backing or anything like that."
msgstr "Waouh, je... enfin, ça fait beaucoup de travail pour y arriver. Je n'aurais aucun soutien d'entreprise ni rien de tel."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-8/0
msgctxt "Kopi"
msgid "Do I even have what it takes to make it?"
msgstr "Est-ce que j'ai seulement ce qu'il faut pour y arriver ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-8/8/s/0
msgctxt "Choix"
msgid "You have the returning customers."
msgstr "Tu as les clients qui reviennent."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-8/9/s/0
msgctxt "Choix"
msgid "You have me."
msgstr "Tu m'as, moi."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-8/c-18/7
msgctxt "Kopi"
msgid "You know what... you're right!"
msgstr "Tu sais quoi... tu as raison !"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-8/c-19/7
msgctxt "Kopi"
msgid "You know what... with your support, I guess I could do anything."
msgstr "Tu sais quoi... avec ton soutien, je crois que je pourrais tout faire."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-9/0
msgctxt "Kopi"
msgid "I'm the one making the coffee and seeing the customers day in, day out!"
msgstr "C'est moi qui fais le café et qui vois les clients jour après jour !"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-9/8
msgctxt "Kopi"
msgid "I'll have to give this some thought, but... maybe I CAN do it. I'm a smart bean, I know I'll be able to figure this out."
msgstr "Il faut que j'y réfléchisse, mais... je PEUX peut-être le faire. Je suis un grain malin, je sais que je finirai par trouver."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-9/16/s/0
msgctxt "Choix"
msgid "You're a lot more confident now."
msgstr "Tu as beaucoup plus confiance en toi maintenant."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-9/17/s/0
msgctxt "Choix"
msgid "This is going to be risky... but worth it."
msgstr "Ça va être risqué... mais ça en vaudra la peine."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-9/c-20/7
msgctxt "Kopi"
msgid "All thanks to you!"
msgstr "Tout ça grâce à toi !"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-10/0
msgctxt "Kopi"
msgid "If you hadn't encouraged me to step out on my own, I would have never been able to even think about this."
msgstr "Si tu ne m'avais pas encouragée à voler de mes propres ailes, je n'aurais jamais pu y penser."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-10/8
msgctxt "Kopi"
msgid "It'll take a lot of work, and honestly, still a lot of hours I need to do under Roofbucks to get stuff going, but... it's worth it to chase after my dreams."
msgstr "Ça va demander beaucoup de travail, et honnêtement, encore beaucoup d'heures à faire chez Roofbucks pour lancer le truc, mais... ça vaut le coup de courir après mes rêves."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_2/0/g-10/16
msgctxt "Kopi"
msgid "Thank you... thank you so much."
msgstr "Merci... merci infiniment."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/0
msgctxt "Kopi"
msgid "Order up! I've got a Vietnamese iced coffee, soy frappuccino, and a Mexican iced mocha!"
msgstr "Commande prête ! J'ai un café glacé vietnamien, un frappuccino au soja et un moka glacé mexicain !"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/8
msgctxt "Narrator"
msgid "Kopi seems far cheerier this time around, as busy as ever and calling out orders. She grins when she spots you, greeting you with a peppy wave."
msgstr "Kopi a l'air bien plus joyeuse cette fois, plus occupée que jamais et annonçant les commandes à la volée. Elle sourit en vous apercevant et vous salue d'un signe de la main plein d'entrain."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/16
msgctxt "Kopi"
msgid "Well, hello, hello, hello!"
msgstr "Eh bien, bonjour, bonjour, bonjour !"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/24
msgctxt "Kopi"
msgid "If it isn't my favorite customer!"
msgstr "Ah, ma star de la clientèle !"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/32/s/0
msgctxt "Choix"
msgid "Business is pretty hectic today."
msgstr "Il y a pas mal de monde aujourd'hui."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/33/s/0
msgctxt "Choix"
msgid "No corporate spiel today?"
msgstr "Pas de baratin d'entreprise aujourd'hui ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/c-0/7
msgctxt "Kopi"
msgid "No kidding! I haven't had this much business in ages!"
msgstr "Tu m'étonnes ! Ça faisait des lustres que je n'avais pas eu autant de clients !"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/c-0/15
msgctxt "Kopi"
msgid "But, hey, at least I'm doing things my way!"
msgstr "Mais bon, au moins je fais les choses à ma façon !"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/g-0/0
msgctxt "Kopi"
msgid "Wait.. no... didn't you hear?"
msgstr "Attends... non... tu n'as pas entendu ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/g-0/8
msgctxt "Kopi"
msgid "Did... did nobody tell you?"
msgstr "Est-ce que... personne ne te l'a dit ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/g-0/16
msgctxt "Kopi"
msgid "Did I NOT tell you?"
msgstr "Est-ce que je ne te l'ai PAS dit ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/g-0/27
msgctxt "Kopi"
msgid "Oh my gosh... I can't believe this!"
msgstr "Oh là là... je n'en reviens pas !"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/g-0/35
msgctxt "Kopi"
msgid "I do ALL of my marketing and it was all for nothing?! What a drag!"
msgstr "Je fais TOUT mon marketing et c'était pour rien ?! Quelle galère !"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/g-0/43/s/0
msgctxt "Choix"
msgid "Kopi. Short and sweet."
msgstr "Kopi. Court et doux."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/g-0/44/s/0
msgctxt "Choix"
msgid "What is it Kopi?"
msgstr "Qu'est-ce qu'il y a, Kopi ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/g-0/c-2/7
msgctxt "Kopi"
msgid "Oh! Right, right, I'm sorry, rambling again."
msgstr "Oh ! Oui, oui, pardon, je divague encore."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/g-1/0
msgctxt "Narrator"
msgid "Kopi sets her coffee implements down and gestures all around her, absolutely radiating pride."
msgstr "Kopi pose ses ustensiles à café et désigne tout autour d'elle d'un geste, rayonnant littéralement de fierté."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/g-1/8
msgctxt "Kopi"
msgid "I did it! I went and made my own cafe!"
msgstr "Je l'ai fait ! J'ai ouvert mon propre café !"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/g-1/16
msgctxt "Kopi"
msgid "Welcome to my little slice of paradise!"
msgstr "Bienvenue dans mon petit coin de paradis !"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/g-1/24/s/0
msgctxt "Choix"
msgid "Everything looks... the same."
msgstr "Tout a l'air... pareil."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/g-2/0
msgctxt "Kopi"
msgid "Well... funny story about that."
msgstr "Eh bien... c'est une drôle d'histoire."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/g-2/11
msgctxt "Kopi"
msgid "It was kind of like mutiny. I still get to keep the space but I get to do things MY way."
msgstr "C'était un peu une mutinerie. Je garde le local, mais je fais les choses À MA façon."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/g-2/19
msgctxt "Kopi"
msgid "But... once the others realised that Roofbucks had nobody else to be a barista... they started ordering under my own branding real fast."
msgstr "Mais... dès que les autres ont réalisé que Roofbucks n'avait personne d'autre comme barista... ils ont très vite commencé à commander sous ma propre enseigne."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/g-2/27
msgctxt "Kopi"
msgid "It was kind of a whirlwind experience, but now I get to do things my way!"
msgstr "C'était un peu un tourbillon, mais maintenant je fais les choses à ma façon !"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/g-2/38/s/0
msgctxt "Choix"
msgid "I'm so happy for you!"
msgstr "Ça me fait tellement plaisir pour toi !"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/g-2/39/s/0
msgctxt "Choix"
msgid "That is awesome."
msgstr "C'est génial."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/g-3/0
msgctxt "Kopi"
msgid "Right? I'm so stoked that I could finally make this a reality, and it's all thanks to you!"
msgstr "N'est-ce pas ? Je suis tellement ravie d'avoir enfin pu concrétiser ça, et tout ça grâce à toi !"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/g-3/8
msgctxt "Kopi"
msgid "It just goes to show you... sometimes, red-lined policies aren't always the way. Sometimes, you have to bend them to get return business."
msgstr "Ça montre bien que... parfois, les règles à la lettre ne sont pas la solution. Parfois, il faut les plier pour fidéliser la clientèle."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/g-3/16
msgctxt "Kopi"
msgid "Now, bear in mind, bear in mind, I DO NOT have a name for this place yet."
msgstr "Maintenant, garde bien en tête, garde bien en tête, que je n'ai PAS ENCORE de nom pour cet endroit."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/g-3/24
msgctxt "Kopi"
msgid "It's currently just... \"Hey, wanna get a coffee from Kopi?\""
msgstr "Pour l'instant, c'est juste... « Hé, ça te dit d'aller prendre un café chez Kopi ? »"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/g-3/32
msgctxt "Kopi"
msgid "At least, that's the word of mouth I'm hearing at the moment."
msgstr "Du moins, c'est ce que j'entends au bouche-à-oreille en ce moment."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/g-3/40
msgctxt "Kopi"
msgid "I don't really have a proper business name, but I'm workshopping some ideas!"
msgstr "Je n'ai pas vraiment de nom commercial en bonne et due forme, mais je planche sur des idées !"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/g-3/48/s/0
msgctxt "Choix"
msgid "Call it 'Kopi Burger!'"
msgstr "Appelle-le « Kopi Burger » !"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/g-3/49/s/0
msgctxt "Choix"
msgid "Call it 'Kopicabana!'"
msgstr "Appelle-le « Kopicabana » !"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/g-3/50/s/0
msgctxt "Choix"
msgid "Call it 'The Bean ft. Kopi'"
msgstr "Appelle-le « Le Grain ft. Kopi »"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/g-3/51/s/0
msgctxt "Choix"
msgid "I'll let you come up with something."
msgstr "Je te laisse trouver quelque chose."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/g-3/c-7/7
msgctxt "Kopi"
msgid "But... we don't serve burgers."
msgstr "Mais... on ne sert pas de burgers."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/g-3/c-8/7
msgctxt "Kopi"
msgid "Uh..."
msgstr "Euh..."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/g-3/c-9/7
msgctxt "Kopi"
msgid "I think... no."
msgstr "Je crois... non."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/g-3/c-10/7
msgctxt "Kopi"
msgid "That's a good idea."
msgstr "C'est une bonne idée."

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/g-4/0
msgctxt "Kopi"
msgid "Next time you come around, hopefully, I'll have something ready!"
msgstr "La prochaine fois que tu passes, j'aurai peut-être quelque chose de prêt !"

# Traduction IA – à relire
#: kopi_coffee/kopi_open_3/0/g-4/8
msgctxt "Kopi"
msgid "I seriously can't thank you enough for all of this... which, reminds me..."
msgstr "Je ne te remercierai jamais assez pour tout ça... ce qui me rappelle..."

# Traduction IA – à relire
#: kopi_coffee/kopi_true_love_path/0/0
msgctxt "Kopi"
msgid "You've been one of my favorite customers, and, well, I don't get this close to just anybody."
msgstr "Tu fais partie de ma clientèle préférée et, eh bien, je ne me rapproche pas autant de n'importe qui."

# Traduction IA – à relire
#: kopi_coffee/kopi_true_love_path/0/8
msgctxt "Kopi"
msgid "I... I think I love you. Like, more than a friend way."
msgstr "Je... je crois que je t'aime. Genre, d'une façon qui dépasse l'amitié."

# Traduction IA – à relire
#: kopi_coffee/kopi_true_love_path/0/16
msgctxt "Kopi"
msgid "I... maybe it's too much to ask, and it's just wishful thinking on my part, but... I've been seeing the signs from you."
msgstr "Je... c'est peut-être trop demander, et je prends peut-être mes désirs pour des réalités, mais... j'ai vu des signes de ta part."

# Traduction IA – à relire
#: kopi_coffee/kopi_true_love_path/0/24
msgctxt "Kopi"
msgid "I think I'm ready to take this to the next step."
msgstr "Je crois que je suis prête à passer à l'étape suivante."

# Traduction IA – à relire
#: kopi_coffee/kopi_true_love_path/0/32
msgctxt "Kopi"
msgid "The creamer to my coffee."
msgstr "La crème de mon café."

# Traduction IA – à relire
#: kopi_coffee/kopi_true_love_path/0/40
msgctxt "Kopi"
msgid "Do you think... we could be more than just barista and customer?"
msgstr "Tu crois que... on pourrait être plus qu'une barista et sa clientèle ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_true_love_path/0/51/s/0
msgctxt "Choix"
msgid "I love you too!"
msgstr "Moi aussi, je t'aime !"

# Traduction IA – à relire
#: kopi_coffee/kopi_true_love_path/0/52/s/0
msgctxt "Choix"
msgid "I think it would be best if we just stayed friends."
msgstr "Je crois que le mieux, c'est qu'on en reste à l'amitié."

# Traduction IA – à relire
#: kopi_coffee/kopi_true_love_path/0/c-0/7
msgctxt "Kopi"
msgid "I... r-really?"
msgstr "Je... vr-vraiment ?"

# Traduction IA – à relire
#: kopi_coffee/kopi_true_love_path/0/c-0/18
msgctxt "Kopi"
msgid "Oh, gosh, I'm so glad..."
msgstr "Oh là là, je suis tellement contente..."

# Traduction IA – à relire
#: kopi_coffee/kopi_true_love_path/0/c-1/7
msgctxt "Kopi"
msgid "Oh... I see."
msgstr "Oh... je vois."

# Traduction IA – à relire
#: kopi_coffee/kopi_true_love_path/0/c-1/18
msgctxt "Kopi"
msgid "I'm sorry if I misread something between us, but... I'm glad that we can at least stay friends."
msgstr "Désolée si j'ai mal interprété quelque chose entre nous, mais... je suis contente qu'on puisse au moins garder l'amitié."

# Traduction IA – à relire
#: kopi_coffee/kopi_true_friend_path/0/0
msgctxt "Kopi"
msgid "You've been one of my favorite customers, and honestly? You're someone that I feel I can just have fun with!"
msgstr "Tu fais partie de ma clientèle préférée et, franchement ? Avec toi, j'ai l'impression de pouvoir juste m'amuser !"

# Traduction IA – à relire
#: kopi_coffee/kopi_true_friend_path/0/8
msgctxt "Kopi"
msgid "You're genuinely someone I would like to hang out with outside of a shop."
msgstr "Tu es vraiment quelqu'un avec qui j'aimerais traîner en dehors d'une boutique."

# Traduction IA – à relire
#: kopi_coffee/kopi_true_friend_path/0/19
msgctxt "Kopi"
msgid "I can talk to you about pretty much anything, and you don't even bat an eye."
msgstr "Je peux te parler de pratiquement tout, et tu ne sourcilles même pas."

# Traduction IA – à relire
#: kopi_coffee/kopi_true_friend_path/0/27
msgctxt "Kopi"
msgid "Let's be more than barista and customer. Let's be friends!"
msgstr "Soyons plus qu'une barista et sa clientèle. Faisons de ça une amitié !"

# Traduction IA – à relire
#: kopi_coffee/kopi_true_friend_path/0/35/s/0
msgctxt "Choix"
msgid "That would be awesome."
msgstr "Ce serait génial."

# Traduction IA – à relire
#: kopi_coffee/kopi_true_friend_path/0/36/s/0
msgctxt "Choix"
msgid "I was hoping we could be more than just friends..."
msgstr "J'espérais qu'on soit plus que de l'amitié..."

# Traduction IA – à relire
#: kopi_coffee/kopi_true_friend_path/0/c-0/7
msgctxt "Kopi"
msgid "I knew you'd think so too!"
msgstr "Je savais que tu penserais pareil !"

# Traduction IA – à relire
#: kopi_coffee/kopi_true_friend_path/0/c-0/18
msgctxt "Kopi"
msgid "And this is why we're absolutely going to be best mates, I can feel it!"
msgstr "Et c'est pour ça qu'on va forcément devenir inséparables, je le sens !"

# Traduction IA – à relire
#: kopi_coffee/kopi_true_friend_path/0/c-1/15
msgctxt "Kopi"
msgid "I'm... I'm sorry if you misread anything between us..."
msgstr "Désolée si tu as mal interprété quelque chose entre nous..."

# Traduction IA – à relire
#: kopi_coffee/kopi_true_friend_path/0/c-1/26
msgctxt "Kopi"
msgid "I don't really feel anything romantic towards you... I'm sorry."
msgstr "Je ne ressens rien de romantique pour toi... Désolée."

# Traduction IA – à relire
#: kopi_coffee/kopi_true_friend_path/0/c-1/34
msgctxt "Kopi"
msgid "But, hey, I think staying friends would be the best for us; like two platonic friends in coffee brewing!"
msgstr "Mais bon, je crois que rester proches, c'est ce qu'il y a de mieux pour nous ; comme deux grains d'amitié platonique, en pleine infusion !"
