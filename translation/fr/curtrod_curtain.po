#: curtrod_curtain/shade_laundry/0/g-1/40
msgctxt "Curt"
msgid "And to think, you liked Wyndolyn."
msgstr ""

#: curtrod_curtain/shade_laundry/0/g-1/48
msgctxt "Rod"
msgid "Cooler heads prevailed there."
msgstr ""

#: curtrod_curtain/shade_laundry/0/g-1/56
msgctxt "Wyndolyn"
msgid "Oh, projection. This is getting bad."
msgstr ""

#: curtrod_curtain/shade_laundry/0/g-1/64
msgctxt "Rod"
msgid "Okay! We're ending this conversation."
