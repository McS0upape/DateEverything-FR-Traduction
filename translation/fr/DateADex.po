msgid "Hankees game"
msgstr "Match des Hankees"

# Traduction IA – à relire
#: DateADex/hoove_dex_entry/94
msgctxt "Tag Date-A-Dex"
msgid "What a show!"
msgstr "Quel spectacle !"

# Traduction IA – à relire
