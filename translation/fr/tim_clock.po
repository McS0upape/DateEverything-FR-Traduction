#: tim_clock/timmy_perfection/0/c-0/21/c-0/15/c-0/39/c-1/63/c-0/7
msgctxt "Timmy"
msgid "Mad at me!?"
msgstr ""

#: tim_clock/timmy_perfection/0/c-0/21/c-0/15/c-0/39/c-1/63/c-0/15
msgctxt "Timmy"
msgid "Timmy doesn't want to talk to you anymore then!"
