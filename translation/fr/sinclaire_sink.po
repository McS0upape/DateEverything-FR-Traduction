# Traduction IA – à relire
#: sinclaire_sink/1
msgctxt "Tag Nom d'objet (MAJUSCULES)"
msgid "SINK"
msgstr "ÉVIER"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/0
msgctxt "Narrator"
msgid "You're used to seeing mostly people-shaped objects with the dateviators, but clearly the sink-headed figure before you is... well, not like the others."
msgstr "Avec les Dateviators, vous avez l'habitude de voir surtout des objets en forme de personnes, mais la silhouette à tête d'évier qui se tient devant vous est... enfin, pas comme les autres."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/8
msgctxt "Narrator"
msgid "All the time in the world wouldn't be enough to comprehend whatever is going on with this guy."
msgstr "Tout le temps du monde ne suffirait pas à comprendre ce qui se passe avec ce type."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/13
msgctxt "Narrator"
msgid "You can see that he's got a sink for a head and the clothing and posture of a beleaguered stand-up comic, but your inspection is cut short by his disturbing screams."
msgstr "Vous constatez qu'il a un évier à la place de la tête, ainsi que la tenue et la posture d'un humoriste de stand-up à bout de nerfs, mais votre inspection est interrompue par ses hurlements déchirants."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/18
msgctxt "Sinclaire"
msgid "HEEEEELLLLLLLPPPPPPP!!!!!!"
msgstr "AU SECOOOOOOURS !!!!!!"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/29
msgctxt "Sinclaire"
msgid "HELP ME!"
msgstr "AIDEZ-MOI !"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/37
msgctxt "Sinclaire"
msgid "Hello?? Can you hear me???"
msgstr "Allô ?? Vous m'entendez ???"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/45/s/0 sinclaire_sink/sinclaire_hate_return/0/22/s/0
msgctxt "Choix"
msgid "Um... hi?"
msgstr "Euh... salut ?"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/46/s/0
msgctxt "Choix"
msgid "What's wrong!?"
msgstr "Qu'est-ce qui se passe !?"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/47/s/0
msgctxt "Choix"
msgid "Did you happen to start a fire in the bathroom?"
msgstr "Tu aurais pas mis le feu dans la salle de bain, par hasard ?"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/c-0/7
msgctxt "Sinclaire"
msgid "Hi. Hello."
msgstr "Salut. Bonjour."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "Why were you just screaming 'help?'"
msgstr "Pourquoi tu hurlais « à l'aide » ?"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/c-0/15/c-0/7
msgctxt "Sinclaire"
msgid "That wasn't me."
msgstr "C'était pas moi."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "...what?"
msgstr "...quoi ?"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/c-0/15/c-0/15/c-0/7
msgctxt "Sinclaire"
msgid "I mean it was me, but it wasn't. Isn't."
msgstr "Enfin si, c'était moi, mais c'était pas moi. N'est pas moi."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/c-0/15/c-0/15/c-0/15
msgctxt "Sinclaire"
msgid "Nothing is as it seems. <w>I</w> am not who <w>I</w> seem!"
msgstr "Rien n'est ce qu'il semble être. <w>Je</w> ne suis pas celui que <w>je</w> parais !"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/c-0/15/c-0/15/c-0/23/0/s/0
msgctxt "Choix"
msgid "Okayyyy..."
msgstr "D'accooord..."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/c-0/15/c-0/15/c-0/23/1/s/0
msgctxt "Choix"
msgid "I'm gonna go ahead and leave now."
msgstr "Bon, je vais y aller, du coup."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/c-0/15/c-0/15/c-0/23/c-0/7
msgctxt "Sinclaire"
msgid "I mean the I you see before you isn't the me I am inside!"
msgstr "Je veux dire que le moi que tu vois devant toi n'est pas le moi que je suis à l'intérieur !"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/c-0/15/c-0/15/c-0/23/c-0/15
msgctxt "Sinclaire"
msgid "You see, there's the I that sees through these eyes, of course, but who is that?"
msgstr "Tu vois, il y a le moi qui regarde par ces yeux, bien sûr, mais qui est-ce ?"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/c-0/15/c-0/15/c-0/23/c-0/23
msgctxt "Sinclaire"
msgid "Certainly not the one I am!"
msgstr "Certainement pas celui que je suis !"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/c-0/15/c-0/15/c-0/23/c-0/31/0/s/0
msgctxt "Choix"
msgid "Oh, I see. It's a philosophy thing!"
msgstr "Ah, je vois. C'est un truc de philosophie !"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/c-0/15/c-0/15/c-0/23/c-0/31/1/s/0
msgctxt "Choix"
msgid "You're kind of scaring me."
msgstr "Tu commences à me faire peur."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/c-0/15/c-0/15/c-0/23/c-0/31/c-0/7
msgctxt "Sinclaire"
msgid "No, it's a reality thing."
msgstr "Non, c'est un truc de réalité."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/c-0/15/c-0/15/c-0/23/c-0/31/c-1/7
msgctxt "Sinclaire"
msgid "Don't be afraid."
msgstr "N'aie pas peur."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/c-0/15/c-0/15/c-0/23/c-0/31/c-1/15
msgctxt "Sinclaire"
msgid "There's nothing to fear except creepy old fortune tellers in poorly-lit back alleys."
msgstr "Il n'y a rien à craindre, sauf les vieilles voyantes flippantes dans les ruelles mal éclairées."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/c-0/15/c-0/15/c-0/23/c-0/31/c-1/23/0/s/0
msgctxt "Choix"
msgid "What on earth are you talking about?"
msgstr "Mais de quoi tu parles, enfin ?"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/c-0/15/c-0/15/c-0/23/c-1/7
msgctxt "Sinclaire"
msgid "No! Don't leave me!"
msgstr "Non ! Ne me quitte pas !"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/c-0/15/c-0/15/c-0/23/c-1/18/0/s/0
msgctxt "Choix"
msgid "Byeeeee..."
msgstr "Saluuut..."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/c-1/7
msgctxt "Sinclaire"
msgid "Listen closely. There isn't much time. Nothing is as it seems."
msgstr "Écoute bien. On n'a pas beaucoup de temps. Rien n'est ce qu'il semble être."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "Oh my gosh! What's going on?"
msgstr "Oh mon dieu ! Qu'est-ce qui se passe ?"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/c-2/7
msgctxt "Sinclaire"
msgid "Why yes! I splish-splashed a little water right into the electrical socket."
msgstr "Mais oui ! J'ai fait un petit plouf de flotte direct dans la prise électrique."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/c-2/15
msgctxt "Sinclaire"
msgid "Not a bad move, if I may say so!"
msgstr "Pas mal comme coup, si je puis me permettre !"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/c-2/23/0/s/0
msgctxt "Choix"
msgid "You really shouldn't be doing that! You could've gotten someone really hurt!"
msgstr "Tu ne devrais vraiment pas faire ça ! Tu aurais pu blesser quelqu'un gravement !"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/c-2/23/c-0/7
msgctxt "Sinclaire"
msgid "I never thought about it that way."
msgstr "Je n'avais jamais vu les choses sous cet angle."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/c-2/23/c-0/15
msgctxt "Sinclaire"
msgid "I merely meant to alert the powers that be to my terrible predicament."
msgstr "Je voulais simplement alerter les autorités compétentes sur ma terrible situation."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/c-2/23/c-0/23/0/s/0
msgctxt "Choix"
msgid "Which is...?"
msgstr "À savoir...?"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/0
msgctxt "Sinclaire"
msgid "I'm not who I appear to be."
msgstr "Je ne suis pas ce que je parais être."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/15
msgctxt "Sinclaire"
msgid "My name is NOT Sinclaire, it's MARTIN. Martin Applegate."
msgstr "Mon nom n'est PAS Sinclaire, c'est MARTIN. Martin Applegate."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/26
msgctxt "Martin Applegate"
msgid "And I'm not a sink."
msgstr "Et je ne suis pas un évier."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/34
msgctxt "Martin Applegate"
msgid "I'm an insurance claims adjuster from Turkleman City, Florida."
msgstr "Je suis expert en sinistres d'assurance, à Turkleman City, en Floride."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/42/s/0
msgctxt "Choix"
msgid "This is getting weird fast."
msgstr "Ça devient bizarre très vite."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/43/s/0
msgctxt "Choix"
msgid "Turkleman City? Is that even a real place?"
msgstr "Turkleman City ? Ça existe vraiment, comme endroit ?"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-3/7
msgctxt "Sinclaire"
msgid "Now you're catching on."
msgstr "Tu commences à comprendre."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/0/s/0
msgctxt "Choix"
msgid "To...?"
msgstr "Quoi donc...?"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/7
msgctxt "Sinclaire"
msgid "Just how weird this is going to get."
msgstr "À quel point ça va devenir bizarre."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "I don't know if I want that."
msgstr "Je ne sais pas si j'ai envie de ça."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/1/s/0
msgctxt "Choix"
msgid "I'm gonna gooo..."
msgstr "Je vais y aller..."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/2/s/0
msgctxt "Choix"
msgid "Ooh! Weird. I like weird."
msgstr "Ooh ! Bizarre. J'aime bien le bizarre."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/c-0/7
msgctxt "Sinclaire"
msgid "Well <i>I</i> don't know if I wanted my dog to be turned into a bar of <i>SOAP!</i>"
msgstr "Eh bien <i>moi</i>, je ne sais pas si je voulais que mon chien soit transformé en pain de <i>SAVON !</i>"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/c-0/15
msgctxt "Sinclaire"
msgid "But that happened, and here we are..."
msgstr "Mais c'est arrivé, et nous voilà..."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/c-0/23/0/s/0
msgctxt "Choix"
msgid "Your dog got turned into a bar of soap?"
msgstr "Ton chien a été transformé en pain de savon ?"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/c-0/23/c-0/13 sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/c-1/15/c-0/15/g-0/6 sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/c-2/21 sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/c-0/23/g-0/8/c-0/32 sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/c-1/21 sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/c-2/15/c-0/21
msgctxt "Sudsy"
msgid "Ruff!"
msgstr "Ouaf !"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/c-0/23/c-0/21 sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/c-1/15/c-0/15/g-0/14 sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/c-2/29 sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/c-0/23/g-0/8/c-0/40 sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/c-1/29 sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/c-2/15/c-0/29
msgctxt "Narrator"
msgid "A strange creature that looks and sounds like a soapy little dog jumps up at your legs, yapping and barking."
msgstr "Une étrange créature qui ressemble et aboie comme un petit chien savonneux bondit contre vos jambes en jappant."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/c-0/23/c-0/32 sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/c-1/15/c-0/15/g-0/25 sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/c-2/40 sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/c-0/23/g-0/8/c-0/51 sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/c-1/40 sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/c-2/15/c-0/40
msgctxt "Sinclaire"
msgid "Down Sudsy! Down! Keep your bubbles to yourself, you little devil!"
msgstr "Couché, Sudsy ! Couché ! Garde tes bulles pour toi, petit diable !"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/c-0/23/c-0/40 sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/c-1/15/c-0/15/g-0/33 sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/c-2/48 sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/c-0/23/g-0/8/c-0/59 sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/c-1/48 sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/c-2/15/c-0/51
msgctxt "Sudsy"
msgid "Ruff! Ruff!"
msgstr "Ouaf ! Ouaf !"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/c-0/23/c-0/48 sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/c-1/15/c-0/15/g-0/41 sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/c-2/56 sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/c-0/23/g-0/8/c-0/67 sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/c-1/56 sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/c-2/15/c-0/59
msgctxt "Sinclaire"
msgid "Tray, Sudsy!"
msgstr "Au porte-savon, Sudsy !"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/c-0/23/c-0/59
msgctxt "Sudsy"
msgid "rrrrrRUFF!"
msgstr "grrrrrOUAF !"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/c-0/23/c-0/67 sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/c-1/15/c-0/15/g-0/57 sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/c-2/72 sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/c-0/23/g-0/8/c-0/83 sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/c-1/72 sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/c-2/15/c-0/78
msgctxt "Sinclaire"
msgid "Go. To. Your. Tray!"
msgstr "Va. Dans. Ton. Porte-savon !"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/c-0/23/c-0/81 sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/c-1/15/c-0/15/g-0/71 sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/c-2/86 sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/c-0/23/g-0/8/c-0/97 sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/c-1/86 sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/c-2/15/c-0/92
msgctxt "Sinclaire"
msgid "Sorry about that."
msgstr "Désolé pour ça."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/c-0/23/c-0/89/0/s/0
msgctxt "Choix"
msgid "Ok, so that just happened."
msgstr "Bon, donc ça vient d'arriver."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/c-0/23/c-0/89/c-0/7
msgctxt "Sinclaire"
msgid "And that's just the beginning."
msgstr "Et ce n'est que le début."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/c-1/7
msgctxt "Sinclaire"
msgid "No, wait! I need someone to reverse this curse!"
msgstr "Non, attends ! J'ai besoin de quelqu'un pour lever cette malédiction !"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/c-1/15/0/s/0
msgctxt "Choix"
msgid "Did you say curse?"
msgstr "Tu as dit malédiction ?"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/c-1/15/c-0/7
msgctxt "Sinclaire"
msgid "Oh yes, a foul, mysterious curse! Cast upon me by a foul, mysterious fiend!"
msgstr "Oh oui, une affreuse et mystérieuse malédiction ! Lancée sur moi par un affreux et mystérieux démon !"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/c-1/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "Go on."
msgstr "Continue."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/c-1/15/c-0/15/1/s/0
msgctxt "Choix"
msgid "Guess I'm stuck here..."
msgstr "Je crois que je suis coincé ici..."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/c-1/15/c-0/15/g-0/49 sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/c-2/64 sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/c-1/64
msgctxt "Sudsy"
msgid "rrrrrRUF!"
msgstr "grrrrrOUAF !"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-3/15/c-0/15/c-2/7
msgctxt "Sinclaire"
msgid "Try this on for size, then."
msgstr "Essaie donc celle-là pour voir."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-4/7
msgctxt "Sinclaire"
msgid "Of course it's a real place!"
msgstr "Bien sûr que ça existe !"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-4/15
msgctxt "Sinclaire"
msgid "Do I look like the kind of guy who would lie to you?"
msgstr "J'ai une tête à mentir, moi ?"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/0/s/0 sinclaire_sink/maggie_and_sinclaire/0/53/s/0
msgctxt "Choix"
msgid "Yes."
msgstr "Oui."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/1/s/0 sinclaire_sink/maggie_and_sinclaire/0/52/s/0
msgctxt "Choix"
msgid "No."
msgstr "Non."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/2/s/0
msgctxt "Choix"
msgid "I mean, what do you want me to say? You're a talking sink."
msgstr "Enfin, qu'est-ce que tu veux que je réponde ? Tu es un évier qui parle."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/c-0/7
msgctxt "Sinclaire"
msgid "Looks..."
msgstr "Les apparences..."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/c-0/23/0/s/0
msgctxt "Choix"
msgid "Why are you pausing?"
msgstr "Pourquoi tu fais une pause ?"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/c-0/23/1/s/0
msgctxt "Choix"
msgid "Um."
msgstr "Euh."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/c-0/23/g-0/0
msgctxt "Sinclaire"
msgid "...can be deceiving!"
msgstr "...sont trompeuses !"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/c-0/23/g-0/8/0/s/0
msgctxt "Choix"
msgid "Thanks for the dramatic pause, I guess."
msgstr "Merci pour la pause dramatique, je suppose."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/c-0/23/g-0/8/c-0/7
msgctxt "Sinclaire"
msgid "My pleasure..."
msgstr "Avec plaisir..."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/c-0/23/g-0/8/c-0/15
msgctxt "Sinclaire"
msgid "IS WHAT I WOULD SAY IF I WEREN'T TRAPPED IN ETERNAL SINKDOM."
msgstr "C'EST CE QUE JE DIRAIS SI JE N'ÉTAIS PAS PRIS AU PIÈGE DE L'ÉVIERNITÉ."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/c-0/23/g-0/8/c-0/75 sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/c-2/15/c-0/70
msgctxt "Sudsy"
msgid "rrrrrrRUF!"
msgstr "grrrrrrOUAF !"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/c-1/7
msgctxt "Sinclaire"
msgid "Exactly! And I'm not! I'm telling you the truth."
msgstr "Exactement ! Et je ne le suis pas ! Je te dis la vérité."

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/c-2/7
msgctxt "Sinclaire"
msgid "No! That's just what <w>she</w> wants you to think!"
msgstr "Non ! C'est exactement ce que <w>elle</w> veut te faire croire !"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/c-2/15/0/s/0
msgctxt "Choix"
msgid "She!? Who's 'she?'"
msgstr "Elle !? Qui ça, « elle » ?"

# Traduction IA – à relire
#: sinclaire_sink/SinclaireIntro/0/g-0/c-4/23/c-2/15/c-0/7
msgctxt "Sinclaire"
msgid "Allow me to explain..."
msgstr "Permets-moi de t'expliquer..."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaires_Situation/0/0
msgctxt "Sinclaire"
msgid "Before I begin telling you my tale of woe and temples shirley..."
msgstr "Avant que je te conte mon récit de malheurs et de Shirley Temples..."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaires_Situation/0/8
msgctxt "Sinclaire"
msgid "Lemme let Sudsy out, okay? When he gets like this I just get really flustered."
msgstr "Laisse-moi faire sortir Sudsy, d'accord ? Quand il est comme ça, je suis complètement à cran."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaires_Situation/0/16/s/0
msgctxt "Choix"
msgid "Okay?"
msgstr "D'accord ?"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaires_Situation/0/17/s/0
msgctxt "Choix"
msgid "Is your dog gonna pee on my bathroom tile?"
msgstr "Ton chien va pas faire pipi sur le carrelage de ma salle de bain ?"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaires_Situation/0/18/s/0
msgctxt "Choix"
msgid "Is your dog gonna pee on my kitchen tile?"
msgstr "Ton chien va pas faire pipi sur le carrelage de ma cuisine ?"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaires_Situation/0/19/s/0
msgctxt "Choix"
msgid "Is your dog gonna pee on my floor?"
msgstr "Ton chien va pas faire pipi sur mon sol ?"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaires_Situation/0/20/s/0
msgctxt "Choix"
msgid "More flustered than being transformed into a sink?"
msgstr "Plus à cran que d'avoir été transformé en évier ?"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaires_Situation/0/c-1/7 sinclaire_sink/Sinclaires_Situation/0/c-2/7 sinclaire_sink/Sinclaires_Situation/0/c-3/7
msgctxt "Sinclaire"
msgid "No!"
msgstr "Non !"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaires_Situation/0/c-4/7
msgctxt "Sinclaire"
msgid "Yeah. Pretty much."
msgstr "Ouais. À peu près."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaires_Situation/0/g-0/0
msgctxt "Sinclaire"
msgid "Okay bye! Sink you next time!"
msgstr "Bon, salut ! À la prochaine, évier-demment !"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/0 sinclaire_sink/Agreed_But_No_Agatha/0/0
msgctxt "Sinclaire"
msgid "You're back!"
msgstr "Te revoilà !"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/8/s/0
msgctxt "Choix"
msgid "Tell me your story, Sinclaire."
msgstr "Raconte-moi ton histoire, Sinclaire."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/9/s/0
msgctxt "Choix"
msgid "Yeah, I guess so. More curious than anything."
msgstr "Ouais, je suppose. Plus curieux qu'autre chose."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-0/0
msgctxt "Sinclaire"
msgid "It all happened one rainy night, on the North Side of Turkleman City..."
msgstr "Tout est arrivé par une nuit pluvieuse, dans le quartier nord de Turkleman City..."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-0/8
msgctxt "Sinclaire"
msgid "The <i>tough</i> side."
msgstr "Le côté <i>mal famé</i>."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-0/16
msgctxt "Sinclaire"
msgid "I'd stayed late at the office because I had extra work to do before the holidays."
msgstr "J'étais resté tard au bureau parce que j'avais du travail en plus avant les fêtes."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-0/24/s/0
msgctxt "Choix"
msgid "Stayed late at your job as an... insurance claims adjuster. Go on."
msgstr "Resté tard à ton travail d'... expert en sinistres d'assurance. Continue."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-0/c-2/7
msgctxt "Sinclaire"
msgid "Well, when I left, I was feeling a bit low, so I went out to a local bar."
msgstr "Eh bien, en sortant, j'avais un peu le cafard, alors je suis allé dans un bar du coin."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-0/c-2/15
msgctxt "Sinclaire"
msgid "It's called The Banana Club. They make a mean Shirley Temple. Heavy pour."
msgstr "Ça s'appelle Le Banana Club. Ils font un Shirley Temple d'enfer. Bien tassé."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-0/c-2/23/0/s/0
msgctxt "Choix"
msgid "Then what happened?"
msgstr "Et ensuite ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-0/c-2/23/1/s/0
msgctxt "Choix"
msgid "But I thought Shirley Temples were..."
msgstr "Mais je croyais que les Shirley Temple, c'était..."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-0/c-2/23/c-1/7
msgctxt "Sinclaire"
msgid "Devastatingly potent. Yes."
msgstr "Dévastateurs de puissance. Oui."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-0/c-2/23/c-1/15/0/s/0
msgctxt "Choix"
msgid "I was going to say..."
msgstr "J'allais dire..."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-0/c-2/23/c-1/15/c-0/7
msgctxt "Sinclaire"
msgid "A recipe for disaster? I know! I shouldn't have indulged."
msgstr "Une recette pour le désastre ? Je sais ! Je n'aurais pas dû me laisser tenter."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-1/0
msgctxt "Sinclaire"
msgid "I should have known better."
msgstr "J'aurais dû me méfier."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-1/8
msgctxt "Sinclaire"
msgid "But after I'd had about seven of them, I went out for a stroll."
msgstr "Mais après en avoir bu environ sept, je suis sorti me promener."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-1/16
msgctxt "Sinclaire"
msgid "I don't know where I was going."
msgstr "Je ne sais pas où j'allais."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-1/24
msgctxt "Sinclaire"
msgid "Just trekking the streets with my dog."
msgstr "Je battais le pavé avec mon chien."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-1/32
msgctxt "Sinclaire"
msgid "Suddenly, I came upon a fine dining establishment called the Questionable Dandelion."
msgstr "Soudain, je suis tombé sur un restaurant gastronomique appelé le Pissenlit Douteux."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-1/40/s/0
msgctxt "Choix"
msgid "Right."
msgstr "D'accord."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-1/c-3/7
msgctxt "Sinclaire"
msgid "They've got an incredible buffet."
msgstr "Ils ont un buffet incroyable."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-1/c-3/15
msgctxt "Sinclaire"
msgid "Lots of strange ingredients from all around the world."
msgstr "Plein d'ingrédients étranges venus du monde entier."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-1/c-3/23
msgctxt "Sinclaire"
msgid "They're always trying new things."
msgstr "Ils essaient toujours de nouvelles choses."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-1/c-3/31/0/s/0
msgctxt "Choix"
msgid "Ok."
msgstr "Ok."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-1/c-3/31/c-0/7
msgctxt "Sinclaire"
msgid "Like diplodocus berries."
msgstr "Comme les baies de diplodocus."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-1/c-3/31/c-0/15/0/s/0
msgctxt "Choix"
msgid "Sure. Of course."
msgstr "Bien sûr. Évidemment."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-1/c-3/31/c-0/15/1/s/0
msgctxt "Choix"
msgid "Diplodocus...? Berries...?"
msgstr "Des baies...? De diplodocus...?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-1/c-3/31/c-0/15/g-0/0
msgctxt "Sinclaire"
msgid "And Jimson Weed cupcakes."
msgstr "Et les cupcakes à la stramoine."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-1/c-3/31/c-0/15/g-0/8/0/s/0
msgctxt "Choix"
msgid "Naturally."
msgstr "Naturellement."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-1/c-3/31/c-0/15/g-0/8/c-0/7
msgctxt "Sinclaire"
msgid "They also sell Exceedrin by the pint. The headache medicine."
msgstr "Ils vendent aussi de l'Exceedrin à la pinte. Le médicament contre les maux de tête."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-1/c-3/31/c-0/15/g-0/8/c-0/15/0/s/0
msgctxt "Choix"
msgid "Well, that sounds dangerous."
msgstr "Ça m'a l'air dangereux."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-1/c-3/31/c-0/15/g-0/8/c-0/15/1/s/0
msgctxt "Choix"
msgid "I'm tracking this... I think."
msgstr "Je suis le fil... je crois."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-1/c-3/31/c-0/15/g-0/8/c-0/15/c-0/7
msgctxt "Sinclaire"
msgid "Oh yes. Very. But good for headaches."
msgstr "Oh oui. Très. Mais efficace contre les migraines."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-1/c-3/31/c-0/15/g-0/8/c-0/15/c-1/7
msgctxt "Sinclaire"
msgid "Anyway, I ate my fill and went on my way. That's when things started to get weird."
msgstr "Bref, j'ai mangé à ma faim et je suis reparti. C'est là que les choses ont commencé à devenir bizarres."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-2/0/s/0
msgctxt "Choix"
msgid "Oh, is that when it happened?"
msgstr "Ah, c'est là que c'est arrivé ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-2/1/s/0
msgctxt "Choix"
msgid "Up until now it had been a typical Friday night, I'm guessing?"
msgstr "Jusque-là, c'était un vendredi soir ordinaire, j'imagine ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-2/c-5/7
msgctxt "Sinclaire"
msgid "NO! NOT. AT ALL."
msgstr "NON ! PAS DU TOUT."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-2/c-5/21/c-0/7
msgctxt "Sinclaire"
msgid "It was Thursday."
msgstr "C'était un jeudi."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-2/c-5/21/c-0/15/0/s/0
msgctxt "Choix"
msgid "Forgive me."
msgstr "Pardonne-moi."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-3/0
msgctxt "Sinclaire"
msgid "I was walking around, or sort of drifting, or rather, floating, or..."
msgstr "Je marchais, ou plutôt je dérivais, ou plutôt je flottais, ou..."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-3/8
msgctxt "Sinclaire"
msgid "I guess you could say I was 'making my way' about town."
msgstr "Disons que je « faisais mon chemin » dans la ville."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-3/16
msgctxt "Sinclaire"
msgid "Aimlessly, you see?"
msgstr "Sans but, tu vois ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-3/24/s/0
msgctxt "Choix"
msgid "I'm getting that."
msgstr "Ça, j'ai compris."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-3/25/s/0
msgctxt "Choix"
msgid "And?"
msgstr "Et ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-3/26/s/0
msgctxt "Choix"
msgid "Would you please just get to the bloody point!?!?"
msgstr "Tu veux bien en venir au fait, bon sang !?!?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-3/c-6/7
msgctxt "Sinclaire"
msgid "You're very perceptive!"
msgstr "Tu es très perspicace !"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-3/c-6/18/0/s/0
msgctxt "Choix"
msgid "I pride myself on it. So what happened?"
msgstr "J'en suis fier. Alors, qu'est-ce qui s'est passé ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-3/c-7/7
msgctxt "Sinclaire"
msgid "And what?"
msgstr "Et quoi ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-3/c-7/15/0/s/0
msgctxt "Choix"
msgid "What do you mean 'and what?!' You were just telling me your story!"
msgstr "Comment ça « et quoi ? »!? Tu étais en train de me raconter ton histoire !"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-3/c-7/15/c-0/7
msgctxt "Sinclaire"
msgid "Ah yes, so you want me to continue. This was your meaning?"
msgstr "Ah oui, donc tu veux que je continue. C'est bien ce que tu voulais dire ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-3/c-7/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "What on EARTH is the MATTER WITH YOU?"
msgstr "Mais qu'est-ce qui ne va PAS chez TOI ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-3/c-7/15/c-0/15/c-0/7
msgctxt "Sinclaire"
msgid "Why, that's precisely what I'm telling you!"
msgstr "Mais c'est précisément ce que je suis en train de te raconter !"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-3/c-7/15/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "I may just go insane, here."
msgstr "Je vais peut-être devenir fou, ici."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-3/c-7/15/c-0/15/c-0/15/c-0/7
msgctxt "Sinclaire"
msgid "Please don't. I can assure you, it isn't as much fun as it looks."
msgstr "Je t'en prie, non. Je t'assure que c'est moins drôle qu'il n'y paraît."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-3/c-7/15/c-0/15/c-0/15/c-0/15
msgctxt "Sinclaire"
msgid "And with two of us in the room, it might just start to get a little confusing."
msgstr "Et à deux dans la pièce, ça risquerait de devenir un peu confus."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-3/c-7/15/c-0/15/c-0/15/c-0/23/0/s/0
msgctxt "Choix"
msgid "Oh it might, might it?"
msgstr "Ah, ça risquerait, vraiment ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-3/c-7/15/c-0/15/c-0/15/c-0/23/c-0/7
msgctxt "Sinclaire"
msgid "Please try to stay on track."
msgstr "Essaie de rester sur la bonne voie, s'il te plaît."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-4/0
msgctxt "Sinclaire"
msgid "Well, I came across an alley I had never noticed before."
msgstr "Bref, je suis tombé sur une ruelle que je n'avais jamais remarquée."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-4/8
msgctxt "Sinclaire"
msgid "It was dark and had a rather threatening look about it."
msgstr "Elle était sombre et avait un air plutôt menaçant."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-4/16
msgctxt "Sinclaire"
msgid "So naturally I went down it."
msgstr "Alors naturellement, je m'y suis engagé."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-4/24/s/0
msgctxt "Choix"
msgid "What anyone might do."
msgstr "Comme tout le monde l'aurait fait."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-4/25/s/0
msgctxt "Choix"
msgid "Are you bonkers?"
msgstr "Tu es cinglé ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-4/26/s/0
msgctxt "Choix"
msgid "Sinks sure are brave. Or stupid."
msgstr "Les éviers sont courageux. Ou stupides."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-4/c-10/7
msgctxt "Sinclaire"
msgid "Would I know?"
msgstr "Comment le saurais-je ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-4/c-10/15/0/s/0
msgctxt "Choix"
msgid "Good point."
msgstr "Bien vu."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-4/c-11/7
msgctxt "Sinclaire"
msgid "Sinks?"
msgstr "Les éviers ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-4/c-11/15/0/s/0
msgctxt "Choix"
msgid "Oh right, I forgot. You're an insurance claims adjuster named Martin Applegate."
msgstr "Ah oui, j'oubliais. Tu es un expert en sinistres d'assurance qui s'appelle Martin Applegate."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-4/c-11/15/c-0/7
msgctxt "Sinclaire"
msgid "I am?"
msgstr "Ah bon ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-4/c-11/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "I'm literally two seconds away from leaving."
msgstr "Je suis littéralement à deux secondes de partir."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-4/c-11/15/c-0/15/c-0/7
msgctxt "Sinclaire"
msgid "Relax! It was a joke."
msgstr "Détends-toi ! C'était une blague."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-4/c-11/15/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "<i>Face palm.</i>"
msgstr "<i>Facepalm.</i>"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-4/c-11/15/c-0/15/c-0/15/c-0/7
msgctxt "Sinclaire"
msgid "You really ought to lighten up. Anyway..."
msgstr "Tu devrais vraiment te détendre. Bref..."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-5/0
msgctxt "Sinclaire"
msgid "I wandered down the alley and came to a door, lit by a red light."
msgstr "J'ai suivi la ruelle jusqu'à une porte éclairée par une lumière rouge."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-5/8
msgctxt "Sinclaire"
msgid "I opened it and found a long hall, at the end of which was a sort of booth."
msgstr "Je l'ai ouverte et j'ai découvert un long couloir, au bout duquel se trouvait une sorte de kiosque."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-5/16
msgctxt "Sinclaire"
msgid "And in this booth was a fortune teller!"
msgstr "Et dans ce kiosque, il y avait une voyante !"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-5/24/b/1 sinclaire_sink/sinclaire_post_sudsy/0/g-5/c-12/15/b/1
msgctxt "Sinclaire"
msgid "She was wearing a fantastic red shirt, not unlike the one you're sporting."
msgstr "Elle portait une fantastique chemise rouge, comme celle que tu arbores."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-5/24/b/9
msgctxt "Sinclaire"
msgid "Although it could easily have been more of a chartreuse. I can't tell, I'm tone deaf."
msgstr "Même si elle aurait aussi bien pu être plutôt chartreuse. Je ne saurais le dire, je suis dur d'oreille."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-5/27/s/0
msgctxt "Choix"
msgid "A fortune teller?"
msgstr "Une voyante ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-5/c-12/7
msgctxt "Sinclaire"
msgid "Yes! Her name was Vagabonda the Sinclairious."
msgstr "Oui ! Elle s'appelait Vagabonda la Sinclairieuse."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-5/c-12/15/b/9
msgctxt "Sinclaire"
msgid "I'm sorry I keep harping on the shirt, but it was absolutely... fantastic."
msgstr "Désolé de revenir sans cesse sur la chemise, mais elle était absolument... fantastique."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-5/c-12/18
msgctxt "Sinclaire"
msgid "She spread out a deck of strange cards, and asked me to select one."
msgstr "Elle a étalé un jeu de cartes étranges et m'a demandé d'en choisir une."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-5/c-12/26/0/s/0
msgctxt "Choix"
msgid "Strange how?"
msgstr "Étranges comment ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-5/c-12/26/c-0/7
msgctxt "Sinclaire"
msgid "They were business cards!"
msgstr "C'étaient des cartes de visite !"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-5/c-12/26/c-0/15/0/s/0
msgctxt "Choix"
msgid "I see."
msgstr "Je vois."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-5/c-12/26/c-0/15/1/s/0
msgctxt "Choix"
msgid "Which one did you pick?"
msgstr "Laquelle as-tu choisie ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-5/c-12/26/c-0/15/g-0/0
msgctxt "Sinclaire"
msgid "I chose at random, and the card I picked turned out to be the Ace of Spades."
msgstr "J'ai choisi au hasard, et la carte s'est révélée être l'As de Pique."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-5/c-12/26/c-0/15/g-0/8/0/s/0
msgctxt "Choix"
msgid "Wait... I thought you just said they were business cards."
msgstr "Attends... je croyais que tu venais de dire que c'étaient des cartes de visite."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-5/c-12/26/c-0/15/g-0/8/1/s/0
msgctxt "Choix"
msgid "Sounds like a lucky card..."
msgstr "Ça a l'air d'être une carte porte-bonheur..."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-5/c-12/26/c-0/15/g-0/8/c-0/7
msgctxt "Sinclaire"
msgid "The Ace of Spades is a bespoke shovel manufacturer based in Crumple, Michigan."
msgstr "L'As de Pique est un fabricant de pelles sur mesure installé à Crumple, dans le Michigan."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-5/c-12/26/c-0/15/g-0/8/c-0/15
msgctxt "Sinclaire"
msgid "The owner's name is Ace."
msgstr "Le patron s'appelle As."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-5/c-12/26/c-0/15/g-0/8/c-0/23/0/s/0
msgctxt "Choix"
msgid "I should've known."
msgstr "J'aurais dû m'en douter."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-5/c-12/26/c-0/15/g-0/8/c-0/23/c-0/7
msgctxt "Sinclaire"
msgid "He does great work."
msgstr "Il fait du super boulot."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-5/c-12/26/c-0/15/g-0/8/c-1/7
msgctxt "Sinclaire"
msgid "If ONLY I'd known... that it WASN'T TO BE THE CASE!"
msgstr "Si SEULEMENT j'avais su... que ça NE SE PASSERAIT PAS COMME ÇA !"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-6/0
msgctxt "Sinclaire"
msgid "Vagabonda snatched the card back from me and said 'not that one!'"
msgstr "Vagabonda m'a arraché la carte des mains en disant « pas celle-là ! »"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-6/8
msgctxt "Sinclaire"
msgid "It turns out she had her rewards program on the back - twelve stamps and you get a free spade."
msgstr "Il s'avère qu'elle avait son programme de fidélité au dos : douze tampons et on vous offre une pelle."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-6/16/s/0
msgctxt "Choix"
msgid "Probably shouldn't have had that one in there."
msgstr "Elle n'aurait sans doute pas dû mettre celle-là dedans."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-6/17/s/0
msgctxt "Choix"
msgid "That's rude."
msgstr "C'est malpoli."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-7/0
msgctxt "Sinclaire"
msgid "We agree! Besides, she only had two stamps."
msgstr "On est d'accord ! D'ailleurs, elle n'avait que deux tampons."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-7/8/b/1
msgctxt "Sinclaire"
msgid "So I snatched it back from her again, and we had a bit of a row..."
msgstr "Alors je la lui ai reprise, et on a eu une petite prise de bec..."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-7/8/b/9
msgctxt "Sinclaire"
msgid "I'm sorry, God damn that is a nice shirt!"
msgstr "Pardon, nom d'un chien, qu'est-ce qu'elle est belle, cette chemise !"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-7/8/b/17
msgctxt "Sinclaire"
msgid "Anyway."
msgstr "Bref."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-7/9/b/1
msgctxt "Sinclaire"
msgid "So I snatched it back from her again, and we had a bit of a row."
msgstr "Alors je la lui ai reprise, et on a eu une petite prise de bec."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-7/12
msgctxt "Sinclaire"
msgid "I guess that wasn't a very good start to our fortune telling session."
msgstr "J'imagine que ce n'était pas un très bon début pour notre séance de voyance."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-7/20
msgctxt "Sinclaire"
msgid "I think that's why she cursed me!"
msgstr "Je crois que c'est pour ça qu'elle m'a maudit !"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-7/28/s/0
msgctxt "Choix"
msgid "How do you figure?"
msgstr "Comment ça ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-7/c-15/7
msgctxt "Sinclaire"
msgid "Because right afterwards she said:"
msgstr "Parce que juste après, elle m'a dit :"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-7/c-15/15
msgctxt "Sinclaire"
msgid "'Martin, that wasn't a very good start to our fortune telling session."
msgstr "« Martin, ce n'était pas un très bon début pour notre séance de voyance."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-7/c-15/23
msgctxt "Sinclaire"
msgid "I'm going to curse you because of it!'"
msgstr "Je vais te maudire pour ça ! »"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-7/c-15/31
msgctxt "Sinclaire"
msgid "And then she cursed me!"
msgstr "Et puis elle m'a maudit !"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-7/c-15/39/0/s/0
msgctxt "Choix"
msgid "Cursed you how?"
msgstr "Maudit comment ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-7/c-15/39/c-0/7
msgctxt "Sinclaire"
msgid "She waved what looked like a magic wand..."
msgstr "Elle a agité ce qui ressemblait à une baguette magique..."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-7/c-15/39/c-0/15
msgctxt "Sinclaire"
msgid "... although to be honest it could have easily been a bagel of some sort..."
msgstr "... même si, à vrai dire, ça aurait très bien pu être une sorte de bagel..."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-7/c-15/39/c-0/23
msgctxt "Sinclaire"
msgid "... and then said 'Martin, I doom you now to become a detestable object!"
msgstr "... et elle a dit : « Martin, je te condamne à devenir un objet détestable !"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-7/c-15/39/c-0/31
msgctxt "Sinclaire"
msgid "I transform you thusly, so that you may go home and sink about what you've done.'"
msgstr "Je te transforme ainsi, afin que tu rentres chez toi te rincer les méninges sur ce que tu as fait. »"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-7/c-15/39/c-0/39/0/s/0
msgctxt "Choix"
msgid "Go home and 'sink' about what you've done?"
msgstr "Rentrer chez toi te « rincer les méninges » sur ce que tu as fait ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-7/c-15/39/c-0/39/1/s/0
msgctxt "Choix"
msgid "Am I to understand that you may have confused a wand for a bagel?"
msgstr "Dois-je comprendre que tu as peut-être pris un bagel pour une baguette ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-7/c-15/39/c-0/39/c-0/7
msgctxt "Sinclaire"
msgid "She wasn't above a bad pun."
msgstr "Elle n'était pas au-dessus d'un mauvais jeu de mots."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-7/c-15/39/c-0/39/c-0/15/0/s/0 sinclaire_sink/sinclaire_post_sudsy/0/g-7/c-15/39/c-0/39/c-1/15/0/s/0
msgctxt "Choix"
msgid "And then you became a sink?"
msgstr "Et ensuite tu es devenu un évier ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-7/c-15/39/c-0/39/c-1/7
msgctxt "Sinclaire"
msgid "That is correct."
msgstr "C'est exact."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-8/0
msgctxt "Sinclaire"
msgid "And then I became a sink."
msgstr "Et puis je suis devenu un évier."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-8/8
msgctxt "Sinclaire"
msgid "Now you find me as I am! Trapped in this porcelain prison!"
msgstr "Et maintenant tu me retrouves tel que je suis ! Prisonnier de cette geôle de porcelaine !"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-8/16
msgctxt "Sinclaire"
msgid "All I want to do is return to my old life,"
msgstr "Tout ce que je veux, c'est retrouver ma vie d'avant,"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-8/24
msgctxt "Sinclaire"
msgid "To stroll the streets of Turkleman City once more..."
msgstr "Arpenter de nouveau les rues de Turkleman City..."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-8/32
msgctxt "Sinclaire"
msgid "Without a care in the world!"
msgstr "Sans le moindre souci !"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-8/40
msgctxt "Sinclaire"
msgid "Oh, how I long for it! Please, won't you help me?"
msgstr "Oh, comme j'en rêve ! S'il te plaît, tu veux bien m'aider ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-8/48
msgctxt "Sinclaire"
msgid "Sudsy and I would be oh so grateful if you could get to the bottom of what's going on here, and return us to our proper forms! Will you?"
msgstr "Sudsy et moi te serions infiniment reconnaissants si tu pouvais découvrir ce qui se passe ici et nous rendre nos formes d'origine ! Tu veux bien ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-8/56/s/0
msgctxt "Choix"
msgid "I'll do everything I can!"
msgstr "Je ferai tout mon possible !"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-8/57/s/0
msgctxt "Choix"
msgid "I'm never coming near you again."
msgstr "Je ne m'approcherai plus jamais de toi."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-8/58/s/0
msgctxt "Choix"
msgid "Can I have a bit to think about this?"
msgstr "Je peux avoir un petit moment pour y réfléchir ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-8/c-16/7
msgctxt "Sinclaire"
msgid "Oh, joy!"
msgstr "Oh, quelle joie !"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-8/c-17/7
msgctxt "Sinclaire"
msgid "A wise choice!"
msgstr "Un sage choix !"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-8/c-18/7
msgctxt "Sinclaire"
msgid "Ooh. I'm fresh out of bits."
msgstr "Ooh. Je n'ai plus de petits moments en stock."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-8/c-18/15/0/s/0
msgctxt "Choix"
msgid "No, I mean, like, can I have five minutes."
msgstr "Non, je veux dire, genre cinq minutes."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-8/c-18/15/c-0/7
msgctxt "Sinclaire"
msgid "I haven't been taking minutes on this meeting. Have you?"
msgstr "Je n'ai pas rédigé les minutes de cette réunion. Et toi ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-8/c-18/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "What the...? No, I mean... Never mind. I'll be back in a little while."
msgstr "Quoi ?... Non, je veux dire... Laisse tomber. Je reviens dans un petit moment."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_post_sudsy/0/g-8/c-18/15/c-0/15/c-0/11 sinclaire_sink/Sinclaire_Suggests_Maggie/0/c-1/7 sinclaire_sink/HaveYouMadeUpYourMind/0/c-1/7 sinclaire_sink/Agreed_But_No_Agatha/0/c-1/15/c-0/15/c-0/15/c-0/15/c-0/75/c-1/63/c-0/7
msgctxt "Narrator"
msgid "He stands there silent and unmoving until you finally leave."
msgstr "Il reste là, silencieux et immobile, jusqu'à ce que vous partiez enfin."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Suggests_Maggie/0/0
msgctxt "Sinclaire"
msgid "If you want to help get to the bottom of all this,"
msgstr "Si tu veux aider à tirer tout ça au clair,"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Suggests_Maggie/0/8
msgctxt "Sinclaire"
msgid "I might suggest you seek out someone who is in the business of solving unsolvable mysteries!"
msgstr "je te suggère de chercher quelqu'un dont le métier est de résoudre les mystères insolubles !"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Suggests_Maggie/0/16
msgctxt "Sinclaire"
msgid "Or just go see if Vagabonda the Sinclairious is willing to undo her curse for a free shovel."
msgstr "Ou d'aller voir si Vagabonda la Sinclairieuse accepterait de lever sa malédiction contre une pelle gratuite."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Suggests_Maggie/0/24/s/0
msgctxt "Choix"
msgid "I'll do my best to help you."
msgstr "Je ferai de mon mieux pour t'aider."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Suggests_Maggie/0/25/s/0
msgctxt "Choix"
msgid "I think I know just the magnifying glass..."
msgstr "Je crois que je connais justement la loupe qu'il te faut..."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Suggests_Maggie/0/26/s/0
msgctxt "Choix"
msgid "On second thought, I think I'll just leave you to your own devices for now."
msgstr "Réflexion faite, je vais te laisser te débrouiller tout seul pour l'instant."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Suggests_Maggie/0/c-0/7
msgctxt "Sinclaire"
msgid "Oh, yay! Let me know when you have news!"
msgstr "Oh, youpi ! Tiens-moi au courant quand tu auras des nouvelles !"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Suggests_Maggie/0/c-2/7
msgctxt "Sinclaire"
msgid "Fair enough!"
msgstr "Comme tu voudras !"

# Traduction IA – à relire
#: sinclaire_sink/HaveYouMadeUpYourMind/0/0
msgctxt "Sinclaire"
msgid "Hello again, wandering traveler!"
msgstr "Tiens, re-bonjour, âme errante !"

# Traduction IA – à relire
#: sinclaire_sink/HaveYouMadeUpYourMind/0/8
msgctxt "Sinclaire"
msgid "Have you made up your mind as to whether or not you'll help me?"
msgstr "As-tu décidé si tu allais m'aider ou non ?"

# Traduction IA – à relire
#: sinclaire_sink/HaveYouMadeUpYourMind/0/16
msgctxt "Sinclaire"
msgid "I long to escape the confines of the pipes and their various interweavings."
msgstr "J'aspire à m'évader du carcan des tuyaux et de leurs entrelacements."

# Traduction IA – à relire
#: sinclaire_sink/HaveYouMadeUpYourMind/0/24
msgctxt "Sinclaire"
msgid "And return to my old life as Martin Applegate, insurance claims adjuster extraordinaire."
msgstr "Et à retrouver ma vie d'avant, celle de Martin Applegate, expert en sinistres d'assurance hors pair."

# Traduction IA – à relire
#: sinclaire_sink/HaveYouMadeUpYourMind/0/32/s/0
msgctxt "Choix"
msgid "I'll help you."
msgstr "Je vais t'aider."

# Traduction IA – à relire
#: sinclaire_sink/HaveYouMadeUpYourMind/0/33/s/0
msgctxt "Choix"
msgid "I forgot how crazy you are. Goodbye."
msgstr "J'avais oublié à quel point tu es dingue. Au revoir."

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/11
msgctxt "Sudsy"
msgid "Wruf! rrrRUF RUF!"
msgstr "Wouf ! grrrOUAF OUAF !"

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/19
msgctxt "Sinclaire"
msgid "Off, Sudsy! Go lick someone else's hands!"
msgstr "Descends, Sudsy ! Va lécher les mains de quelqu'un d'autre !"

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/30
msgctxt "Sudsy"
msgid "... rof."
msgstr "... ouaf."

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/38
msgctxt "Sinclaire"
msgid "I don't care how dirty they are! Off with you! Go to your tray."
msgstr "Peu importe qu'elles soient sales ! Ouste ! Va dans ton porte-savon."

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/49
msgctxt "Sudsy"
msgid "Bwuff."
msgstr "Bwouf."

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/60
msgctxt "Sinclaire"
msgid "So, have you found someone to help yet?"
msgstr "Alors, as-tu trouvé quelqu'un pour t'aider ?"

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/68/s/0
msgctxt "Choix"
msgid "I'm working on it!"
msgstr "J'y travaille !"

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/69/s/0
msgctxt "Choix"
msgid "As a matter of complete coincidence, I happened to run into one 'Vagabonda the Sinclairious!'"
msgstr "Par pure coïncidence, je suis tombé sur une certaine « Vagabonda la Sinclairieuse » !"

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/70/s/0
msgctxt "Choix"
msgid "No. But maybe I can help you myself!"
msgstr "Non. Mais peut-être que je peux t'aider moi-même !"

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/c-0/7
msgctxt "Sinclaire"
msgid "Well it is like I have all day!"
msgstr "Eh bien, c'est comme si j'avais toute la journée !"

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/c-0/15
msgctxt "Sinclaire"
msgid "So I'll see you some other time then!"
msgstr "Alors à une autre fois, dans ce cas !"

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/c-1/7
msgctxt "Sinclaire"
msgid "You... You did!?"
msgstr "Tu... Tu l'as fait !?"

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "I did! And as another matter of coincidence, I happened to be carrying an unneeded shovel at the time."
msgstr "Oui ! Et, autre coïncidence, il se trouve que j'avais sur moi une pelle dont je n'avais pas besoin."

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/c-1/15/c-0/7
msgctxt "Sinclaire"
msgid "That's so unlikely as to be almost unbelievable!"
msgstr "C'est si improbable que ça en devient presque incroyable !"

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/c-1/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "Well, ya know what they say: Fact is stranger than fiction!"
msgstr "Eh bien, tu sais ce qu'on dit : la réalité dépasse la fiction !"

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/c-1/15/c-0/15/c-0/7
msgctxt "Sinclaire"
msgid "They do say that. They always have."
msgstr "On le dit, en effet. On l'a toujours dit."

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/c-1/15/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "Anyway, I offered Vagabonda the shovel in exchange for lifting the curse, and VOILA! You're all better now!"
msgstr "Bref, j'ai offert la pelle à Vagabonda en échange de la levée de la malédiction, et ET VOILÀ ! Te voilà guéri !"

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/c-1/15/c-0/15/c-0/15/c-0/7
msgctxt "Sinclaire"
msgid "I... I am!? Wow! Thank you! Let me shake your... Hmm. That's odd."
msgstr "Je... je suis guéri !? Oh là là ! Merci ! Laisse-moi te serrer la... Hmm. C'est bizarre."

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/c-1/15/c-0/15/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "What's odd? Nothing's odd. Everything's totally fine and you believe me."
msgstr "Qu'est-ce qui est bizarre ? Rien n'est bizarre. Tout va très bien et tu me crois."

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/c-1/15/c-0/15/c-0/15/c-0/15/c-0/7
msgctxt "Sinclaire"
msgid "Your tricks won't work on me! My hand isn't a hand at all! It's a stainless steel knob! And my neck is a faucet!"
msgstr "Tes tours ne marcheront pas sur moi ! Ma main n'est pas une main du tout ! C'est un bouton en inox ! Et mon cou est un robinet !"

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/c-1/15/c-0/15/c-0/15/c-0/15/c-0/29
msgctxt "Sinclaire"
msgid "And my dog is still a bar of soap!"
msgstr "Et mon chien est toujours un pain de savon !"

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/c-1/15/c-0/15/c-0/15/c-0/15/c-0/37
msgctxt "Sudsy"
msgid "ruf ruf!"
msgstr "ouaf ouaf !"

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/c-1/15/c-0/15/c-0/15/c-0/15/c-0/45
msgctxt "Sinclaire"
msgid "I don't care if <i>you</i> don't mind, Sudsy! The point here is we've been lied to!"
msgstr "Peu importe que <i>toi</i>, ça ne te dérange pas, Sudsy ! Le fait est qu'on nous a menti !"

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/c-1/15/c-0/15/c-0/15/c-0/15/c-0/56
msgctxt "Sudsy"
msgid "rrrrrrrr."
msgstr "grrrrrrrr."

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/c-1/15/c-0/15/c-0/15/c-0/15/c-0/64
msgctxt "Sinclaire"
msgid "Exactly!"
msgstr "Exactement !"

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/c-1/15/c-0/15/c-0/15/c-0/15/c-0/75/0/s/0
msgctxt "Choix"
msgid "It's possible you might have been <i>slightly</i> misled."
msgstr "Il est possible que tu aies été <i>légèrement</i> induit en erreur."

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/c-1/15/c-0/15/c-0/15/c-0/15/c-0/75/1/s/0
msgctxt "Choix"
msgid "I'm sorry! I was just trying to help! Your story is so crazy I thought that maybe I could just sort of convince you out of it!"
msgstr "Pardon ! J'essayais juste d'aider ! Ton histoire est tellement dingue que j'ai pensé que je pourrais te la sortir de la tête en te convainquant !"

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/c-1/15/c-0/15/c-0/15/c-0/15/c-0/75/c-0/7
msgctxt "Sinclaire"
msgid "Out with you! Out of my sight, false friend!"
msgstr "Dehors ! Hors de ma vue, fourbe !"

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/c-1/15/c-0/15/c-0/15/c-0/15/c-0/75/c-0/18
msgctxt "Sudsy"
msgid "rrrrRUF RUF! rrrrrrr!"
msgstr "grrrrOUAF OUAF ! grrrrrrr !"

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/c-1/15/c-0/15/c-0/15/c-0/15/c-0/75/c-0/26/0/s/0
msgctxt "Choix"
msgid "Ok! Ok! I'm going! Sorry!"
msgstr "Ok ! Ok ! Je m'en vais ! Pardon !"

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/c-1/15/c-0/15/c-0/15/c-0/15/c-0/75/c-1/7
msgctxt "Sinclaire"
msgid "Unbelievable."
msgstr "Incroyable."

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/c-1/15/c-0/15/c-0/15/c-0/15/c-0/75/c-1/15
msgctxt "Sinclaire"
msgid "You thought that just because <i>you</i> didn't believe my story,"
msgstr "Tu as cru que, parce que <i>toi</i>, tu ne croyais pas mon histoire,"

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/c-1/15/c-0/15/c-0/15/c-0/15/c-0/75/c-1/23
msgctxt "Sinclaire"
msgid "That it wasn't my actual experience?"
msgstr "Ce n'était pas mon vécu réel ?"

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/c-1/15/c-0/15/c-0/15/c-0/15/c-0/75/c-1/31
msgctxt "Sinclaire"
msgid "You don't know what it's like to live trapped in an alien body."
msgstr "Tu ne sais pas ce que c'est de vivre prisonnier d'un corps étranger."

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/c-1/15/c-0/15/c-0/15/c-0/15/c-0/75/c-1/39
msgctxt "Sinclaire"
msgid "To know in your heart that you're an insurance claims adjuster, while everyone around you just sees a plain old 'sink!'"
msgstr "De savoir au fond de son cœur qu'on est expert en sinistres d'assurance, alors que tout le monde autour ne voit qu'un banal « évier » !"

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/c-1/15/c-0/15/c-0/15/c-0/15/c-0/75/c-1/47
msgctxt "Sinclaire"
msgid "A sink with a bar of soap for a pet."
msgstr "Un évier avec un pain de savon pour animal de compagnie."

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/c-1/15/c-0/15/c-0/15/c-0/15/c-0/75/c-1/63/0/s/0
msgctxt "Choix"
msgid "I'm sure there's a right way to reply to this, but I'll be damned if I know what it is."
msgstr "Je suis sûr qu'il y a une bonne façon de répondre à ça, mais je veux bien être pendu si je sais laquelle."

# Traduction IA – à relire
#: sinclaire_sink/Agreed_But_No_Agatha/0/c-2/7
msgctxt "Sinclaire"
msgid "You? Alone? I doubt it. Come back when you've found a professional!"
msgstr "Toi ? Sans aide ? J'en doute. Reviens quand tu auras trouvé un professionnel !"

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/0
msgctxt "Narrator"
msgid "Sinclaire does a funny little dance when he sees you, leaping up in the air and clicking his heels together."
msgstr "Sinclaire fait une drôle de petite danse en vous voyant, bondissant en l'air et claquant les talons."

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/8
msgctxt "Sinclaire"
msgid "You've returned!"
msgstr "Te revoilà !"

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/19
msgctxt "Sinclaire"
msgid "And no better time. I've been hearing some strange rumors lately."
msgstr "Et à pic. J'ai entendu d'étranges rumeurs ces derniers temps."

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/27
msgctxt "Sinclaire"
msgid "It would seem that <i>some</i> people are saying I'm not a man at all!"
msgstr "Il paraît que <i>certaines</i> personnes disent que je ne suis pas un homme du tout !"

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/35
msgctxt "Sinclaire"
msgid "They say I'm a sink who's lost his mind!"
msgstr "Elles disent que je suis un évier qui a perdu la tête !"

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/43
msgctxt "Sinclaire"
msgid "Can you believe it?!"
msgstr "Tu te rends compte ?!"

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/51/s/0
msgctxt "Choix"
msgid "Um..."
msgstr "Euh..."

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/c-0/7
msgctxt "Sinclaire"
msgid "Sounds like the 'um' of agreeance!"
msgstr "Ça sonne comme le « euh » de l'approbation !"

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/c-1/7
msgctxt "Sinclaire"
msgid "Sounds like the 'no' of agreeance!"
msgstr "Ça sonne comme le « non » de l'approbation !"

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/c-2/7
msgctxt "Sinclaire"
msgid "Right?!"
msgstr "Pas vrai ?!"

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/g-0/6
msgctxt "Narrator"
msgid "Sinclaire turns his red and blue gaze to Maggie, his expression completely blank."
msgstr "Sinclaire tourne son regard rouge et bleu vers Maggie, l'expression totalement vide."

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/g-0/17
msgctxt "Sinclaire"
msgid "And who's this you've got with you?"
msgstr "Et qui est-ce que tu as amené avec toi ?"

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/g-0/25
msgctxt "Maggie"
msgid "You don't remember me?"
msgstr "Tu ne te souviens pas de moi ?"

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/g-0/33
msgctxt "Sinclaire"
msgid "Remember you? Why, no madam, we've never met before."
msgstr "Me souvenir de vous ? Mais non, madame, nous ne nous sommes jamais rencontrés."

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/g-0/41
msgctxt "Sinclaire"
msgid "I'm sure I'd remember such a stunning beauty!"
msgstr "Je suis sûr que je me souviendrais d'une beauté aussi éblouissante !"

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/g-0/49
msgctxt "Narrator"
msgid "He waggles his handles the way a human might waggle their eyebrows."
msgstr "Il remue ses poignées comme un humain remuerait les sourcils."

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/g-0/60
msgctxt "Maggie"
msgid "Interesting..."
msgstr "Intéressant..."

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/g-0/71
msgctxt "Sudsy"
msgid "rof!"
msgstr "ouaf !"

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/g-0/79
msgctxt "Narrator"
msgid "Maggie bends to allow Sudsy to sniff her hand, patting his head briefly."
msgstr "Maggie se penche pour laisser Sudsy renifler sa main, et lui tapote brièvement la tête."

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/g-0/93
msgctxt "Maggie"
msgid "Hi there, Sudsy. That's a good boy. Now run along to your tray, won't you dear?"
msgstr "Salut, Sudsy. C'est bien, gentil chien. Maintenant, va donc dans ton porte-savon, veux-tu, mon chou ?"

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/g-0/104
msgctxt "Sudsy"
msgid "Wuff! Wuff! rr r ..."
msgstr "Ouaf ! Ouaf ! rr r ..."

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/g-0/115
msgctxt "Sinclaire"
msgid "Yet my dog seems to know you... How curious!"
msgstr "Pourtant mon chien a l'air de vous connaître... Comme c'est curieux !"

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/g-0/123/s/0
msgctxt "Choix"
msgid "Sincl... er... Martin, listen, I've brought Maggie here to help figure out what's going on with you."
msgstr "Sincl... euh... Martin, écoute, j'ai amené Maggie pour nous aider à comprendre ce qui t'arrive."

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/g-0/c-3/7
msgctxt "Sinclaire"
msgid "So that's the name of this shapely glass."
msgstr "Alors c'est donc le nom de cette loupe aux courbes avantageuses."

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/g-0/c-3/15/0/s/0
msgctxt "Choix"
msgid "Right. And she's a professional. We're here to get to the bottom of this!"
msgstr "Exact. Et c'est une professionnelle. On est là pour aller au fond des choses !"

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/g-1/0
msgctxt "Maggie"
msgid "Let's dive right in. Our mutual friend here filled me in on your last conversation, and—"
msgstr "Plongeons dans le vif du sujet. On m'a mise au courant de ta dernière conversation, et—"

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/g-1/8
msgctxt "Sinclaire"
msgid "How rude."
msgstr "Quelle grossièreté."

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/g-1/19/s/0
msgctxt "Choix"
msgid "You asked for my help!"
msgstr "Tu m'avais demandé de l'aide !"

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/g-1/c-4/7
msgctxt "Sinclaire"
msgid "Yes, and that's very kind of you."
msgstr "Oui, et c'est très aimable de ta part."

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/g-1/c-4/15
msgctxt "Sinclaire"
msgid "I meant it was rude of me to interrupt just now."
msgstr "Je parlais de ma grossièreté à moi, de t'avoir interrompue à l'instant."

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/g-1/c-4/23/0/s/0
msgctxt "Choix"
msgid "But you... But I... But..."
msgstr "Mais toi... Mais moi... Mais..."

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/g-1/c-4/23/1/s/0
msgctxt "Choix"
msgid "Nevermind."
msgstr "Laisse tomber."

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/g-1/c-4/23/g-0/0
msgctxt "Maggie"
msgid "As I was saying, I know the contents of your last conversation."
msgstr "Comme je disais, je connais le contenu de ta dernière conversation."

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/g-1/c-4/23/g-0/8
msgctxt "Sinclaire"
msgid "It seems to me there are a few different avenues for further investigation."
msgstr "Il me semble qu'il y a plusieurs pistes à explorer."

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/g-1/c-4/23/g-0/16
msgctxt "Sinclaire"
msgid "There is my very curious choice of occupation..."
msgstr "Il y a mon choix de métier fort curieux..."

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/g-1/c-4/23/g-0/24
msgctxt "Sinclaire"
msgid "My journey downtown after work..."
msgstr "Mon périple en ville après le travail..."

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/g-1/c-4/23/g-0/32
msgctxt "Sinclaire"
msgid "My incongruous lack of memory with regard to other entities in the house..."
msgstr "Mon incongru trou de mémoire à l'égard des autres entités de la maison..."

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/g-1/c-4/23/g-0/40
msgctxt "Sinclaire"
msgid "And my encounter with the mysterious Vagabonda the Sinclairious."
msgstr "Et ma rencontre avec la mystérieuse Vagabonda la Sinclairieuse."

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/g-1/c-4/23/g-0/48
msgctxt "Maggie"
msgid "I... Why, yes. That's... exactly right."
msgstr "Je... Mais oui. C'est... tout à fait ça."

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/g-1/c-4/23/g-0/56
msgctxt "Sinclaire"
msgid "I never cease to amaze myself."
msgstr "Je ne cesse de m'étonner moi-même."

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/g-1/c-4/23/g-0/67
msgctxt "Maggie"
msgid "Let's go through these again and see if we can't collect some evidence, shall we?"
msgstr "Reprenons tout cela et voyons si nous ne pouvons pas recueillir des indices, d'accord ?"

# Traduction IA – à relire
#: sinclaire_sink/maggie_and_sinclaire/0/g-1/c-4/23/g-0/75/0/s/0
msgctxt "Choix"
msgid "Let's do it!"
msgstr "Allons-y !"

# Traduction IA – à relire
#: sinclaire_sink/questioning_sinclaire/0/0/b/1
msgctxt "Maggie"
msgid "Where should we begin our investigation?"
msgstr "Par où devrions-nous commencer notre enquête ?"

# Traduction IA – à relire
#: sinclaire_sink/questioning_sinclaire/0/1/b/1
msgctxt "Maggie"
msgid "What else should we ask him about?"
msgstr "Sur quoi d'autre devrions-nous l'interroger ?"

# Traduction IA – à relire
#: sinclaire_sink/questioning_sinclaire/0/4/s/0
msgctxt "Choix"
msgid "Let's go into a bit of detail about your occupation, Martin."
msgstr "Entrons un peu dans le détail de ton métier, Martin."

# Traduction IA – à relire
#: sinclaire_sink/questioning_sinclaire/0/5/s/0
msgctxt "Choix"
msgid "Martin, I'd like to talk about your trip downtown in more detail."
msgstr "Martin, j'aimerais parler plus en détail de ton trajet en ville."

# Traduction IA – à relire
#: sinclaire_sink/questioning_sinclaire/0/6/s/0
msgctxt "Choix"
msgid "Can you tell us a little more about this 'Vagabonda' character?"
msgstr "Peux-tu nous en dire un peu plus sur ce personnage, « Vagabonda » ?"

# Traduction IA – à relire
#: sinclaire_sink/questioning_sinclaire/0/7/s/0
msgctxt "Choix"
msgid "I'd like to know what some other objects in the house think."
msgstr "J'aimerais savoir ce que pensent les autres objets de la maison."

# Traduction IA – à relire
#: sinclaire_sink/questioning_sinclaire/0/8/s/0
msgctxt "Choix"
msgid "I think we're done here. Let's solve this thing!"
msgstr "Je crois qu'on a fini ici. Résolvons cette affaire !"

# Traduction IA – à relire
#: sinclaire_sink/MartinsJob/0/0/b/1
msgctxt "Sinclaire"
msgid "What else can I tell you about my job?"
msgstr "Que puis-je te dire d'autre sur mon travail ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsJob/0/1/b/1
msgctxt "Sinclaire"
msgid "I work for Generally National Auto Insurance."
msgstr "Je travaille pour Assurances Auto Généralement Nationales."

# Traduction IA – à relire
#: sinclaire_sink/MartinsJob/0/8/s/0
msgctxt "Choix"
msgid "What do you do there?"
msgstr "Tu y fais quoi ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsJob/0/9/s/0
msgctxt "Choix"
msgid "What's your boss' name?"
msgstr "Comment s'appelle ton patron ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsJob/0/10/s/0
msgctxt "Choix"
msgid "Tell me about your office."
msgstr "Parle-moi de ton bureau."

# Traduction IA – à relire
#: sinclaire_sink/MartinsJob/0/11/s/0
msgctxt "Choix"
msgid "Lets move on to another line of inquiry."
msgstr "Passons à une autre piste."

# Traduction IA – à relire
#: sinclaire_sink/MartinsJob/0/c-0/7
msgctxt "Sinclaire"
msgid "I'm a claims adjuster."
msgstr "Je suis expert en sinistres."

# Traduction IA – à relire
#: sinclaire_sink/MartinsJob/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "What does that entail?"
msgstr "Ça consiste en quoi ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsJob/0/c-0/15/c-0/7
msgctxt "Sinclaire"
msgid "Mostly, I just adjust claims. On some special occasions, they adjust me."
msgstr "En gros, je règle des sinistres. Certains jours, ce sont eux qui me règlent mon compte."

# Traduction IA – à relire
#: sinclaire_sink/MartinsJob/0/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "Can you go into more detail on that?"
msgstr "Tu peux entrer dans les détails ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsJob/0/c-0/15/c-0/15/c-0/7
msgctxt "Sinclaire"
msgid "Sure! Adjusting claims is a lot like adjusting the human body."
msgstr "Bien sûr ! Régler des sinistres, c'est un peu comme régler le corps humain."

# Traduction IA – à relire
#: sinclaire_sink/MartinsJob/0/c-0/15/c-0/15/c-0/15
msgctxt "Sinclaire"
msgid "Like chiropractors do!"
msgstr "Comme font les chiropracteurs !"

# Traduction IA – à relire
#: sinclaire_sink/MartinsJob/0/c-0/15/c-0/15/c-0/23
msgctxt "Sinclaire"
msgid "You kind of take one bit and then sort of twist it until something snaps."
msgstr "On prend un bout, et on le tord jusqu'à ce que quelque chose craque."

# Traduction IA – à relire
#: sinclaire_sink/MartinsJob/0/c-0/15/c-0/15/c-0/31
msgctxt "Sinclaire"
msgid "Then the person says \"Wow, thank you! I feel so much better!\""
msgstr "Ensuite la personne dit : « Oh, merci ! Je me sens bien mieux ! »"

# Traduction IA – à relire
#: sinclaire_sink/MartinsJob/0/c-0/15/c-0/15/c-0/39
msgctxt "Sinclaire"
msgid "After that, you submit the claim for approval..."
msgstr "Après quoi, on soumet le dossier pour validation..."

# Traduction IA – à relire
#: sinclaire_sink/MartinsJob/0/c-0/15/c-0/15/c-0/47
msgctxt "Sinclaire"
msgid "And your boss says \"You did a great job, Martin! I'm proud of you.\""
msgstr "Et ton patron dit : « Beau travail, Martin ! Je suis fier de toi. »"

# Traduction IA – à relire
#: sinclaire_sink/MartinsJob/0/c-0/15/c-0/15/c-0/58/0/s/0
msgctxt "Choix"
msgid "That sounds reasonable to me."
msgstr "Ça me paraît raisonnable."

# Traduction IA – à relire
#: sinclaire_sink/MartinsJob/0/c-0/15/c-0/15/c-0/58/1/s/0
msgctxt "Choix"
msgid "I get the feeling you don't have any idea what you're talking about."
msgstr "J'ai l'impression que tu n'as aucune idée de ce dont tu parles."

# Traduction IA – à relire
#: sinclaire_sink/MartinsJob/0/c-0/15/c-0/15/c-0/58/2/s/0
msgctxt "Choix"
msgid "What if my name isn't Martin?"
msgstr "Et si je ne m'appelais pas Martin ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsJob/0/c-0/15/c-0/15/c-0/58/c-0/7
msgctxt "Sinclaire"
msgid "Reasonable is my middle name."
msgstr "Raisonnable, c'est mon deuxième prénom."

# Traduction IA – à relire
#: sinclaire_sink/MartinsJob/0/c-0/15/c-0/15/c-0/58/c-1/7
msgctxt "Sinclaire"
msgid "Me too!"
msgstr "Moi non plus !"

# Traduction IA – à relire
#: sinclaire_sink/MartinsJob/0/c-0/15/c-0/15/c-0/58/c-2/7
msgctxt "Sinclaire"
msgid "Then clearly this isn't the right job for you."
msgstr "Alors ce n'est clairement pas le bon métier pour toi."

# Traduction IA – à relire
#: sinclaire_sink/MartinsJob/0/c-1/7
msgctxt "Sinclaire"
msgid "My boss is named Boss."
msgstr "Mon patron s'appelle Patron."

# Traduction IA – à relire
#: sinclaire_sink/MartinsJob/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "Did you just say that because I—"
msgstr "Tu dis ça parce que je—"

# Traduction IA – à relire
#: sinclaire_sink/MartinsJob/0/c-1/15/c-0/7
msgctxt "Sinclaire"
msgid "Jim Boss."
msgstr "Jim Patron."

# Traduction IA – à relire
#: sinclaire_sink/MartinsJob/0/c-1/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "That sounds like a fake—"
msgstr "Ça sonne comme un faux—"

# Traduction IA – à relire
#: sinclaire_sink/MartinsJob/0/c-1/15/c-0/15/c-0/7
msgctxt "Sinclaire"
msgid "Jim Boss-Man. His name is Jim Bossman."
msgstr "Jim Patron-Man. Il s'appelle Jim Patronman."

# Traduction IA – à relire
#: sinclaire_sink/MartinsJob/0/c-1/15/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "Right..."
msgstr "Bien sûr..."

# Traduction IA – à relire
#: sinclaire_sink/MartinsJob/0/c-1/15/c-0/15/c-0/15/1/s/0
msgctxt "Choix"
msgid "Sounds legit."
msgstr "Ça paraît crédible."

# Traduction IA – à relire
#: sinclaire_sink/MartinsJob/0/c-2/7 sinclaire_sink/solve_for_sinclaire/0/8
msgctxt "Sinclaire"
msgid "Of course!"
msgstr "Évidemment !"

# Traduction IA – à relire
#: sinclaire_sink/MartinsJob/0/c-2/15
msgctxt "Sinclaire"
msgid "But first, what do offices look like?"
msgstr "Mais d'abord, à quoi ressemblent les bureaux ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsJob/0/c-2/23/0/s/0
msgctxt "Choix"
msgid "You've never seen one before?"
msgstr "Tu n'en as jamais vu ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsJob/0/c-2/23/c-0/7
msgctxt "Sinclaire"
msgid "Not exactly, no."
msgstr "Pas exactement, non."

# Traduction IA – à relire
#: sinclaire_sink/MartinsJob/0/c-2/23/c-0/15/0/s/0
msgctxt "Choix"
msgid "I should have expected that."
msgstr "J'aurais dû m'y attendre."

# Traduction IA – à relire
#: sinclaire_sink/MartinsJobClueSelect/0/9
msgctxt "Maggie"
msgid "Before we do, let's discuss what we learned."
msgstr "Avant ça, discutons de ce que nous avons appris."

# Traduction IA – à relire
#: sinclaire_sink/MartinsJobClueSelect/0/17
msgctxt "Maggie"
msgid "What do you make of it?"
msgstr "Qu'en penses-tu ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsJobClueSelect/0/25/s/0
msgctxt "Choix"
msgid "He's clearly lying about what he does for a living."
msgstr "Il ment clairement sur son métier."

# Traduction IA – à relire
#: sinclaire_sink/MartinsJobClueSelect/0/26/s/0
msgctxt "Choix"
msgid "It's like he's making it all up as he goes..."
msgstr "On dirait qu'il invente tout au fur et à mesure..."

# Traduction IA – à relire
#: sinclaire_sink/MartinsJobClueSelect/0/c-0/7
msgctxt "Maggie"
msgid "The whole thing did seem suspicious..."
msgstr "Tout cela m'a effectivement semblé suspect..."

# Traduction IA – à relire
#: sinclaire_sink/MartinsJobClueSelect/0/c-0/15 sinclaire_sink/MartinsJobClueSelect/0/c-1/31
msgctxt "Maggie"
msgid "What do you think it points to?"
msgstr "Selon toi, qu'est-ce que ça indique ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsJobClueSelect/0/c-0/23/0/s/0
msgctxt "Choix"
msgid "He's a sink, trying to mislead us for some reason."
msgstr "C'est un évier, qui essaie de nous induire en erreur pour une raison quelconque."

# Traduction IA – à relire
#: sinclaire_sink/MartinsJobClueSelect/0/c-0/23/1/s/0
msgctxt "Choix"
msgid "He's a man, but his memory has been warped by his transformation."
msgstr "C'est un homme, mais sa mémoire a été déformée par sa transformation."

# Traduction IA – à relire
#: sinclaire_sink/MartinsJobClueSelect/0/c-0/23/2/s/0
msgctxt "Choix"
msgid "Too early to say. I don't think it necessarily means anything."
msgstr "Trop tôt pour le dire. Je ne pense pas que ça signifie forcément quelque chose."

# Traduction IA – à relire
#: sinclaire_sink/MartinsJobClueSelect/0/c-1/7
msgctxt "Maggie"
msgid "I thought the same thing!"
msgstr "J'ai pensé la même chose !"

# Traduction IA – à relire
#: sinclaire_sink/MartinsJobClueSelect/0/c-1/15
msgctxt "Maggie"
msgid "Yet there is no apparent ill intention behind it."
msgstr "Pourtant, on ne voit aucune mauvaise intention derrière tout ça."

# Traduction IA – à relire
#: sinclaire_sink/MartinsJobClueSelect/0/c-1/23
msgctxt "Maggie"
msgid "Perhaps his benign fabrication is a clue in and of itself..."
msgstr "Peut-être que cette fabulation bénigne est un indice en soi..."

# Traduction IA – à relire
#: sinclaire_sink/MartinsJobClueSelect/0/c-1/39/0/s/0
msgctxt "Choix"
msgid "He's a man. The transformation has driven him insane."
msgstr "C'est un homme. La transformation l'a rendu fou."

# Traduction IA – à relire
#: sinclaire_sink/MartinsJobClueSelect/0/c-1/39/1/s/0
msgctxt "Choix"
msgid "He's a sink. Something deeper is going on here."
msgstr "C'est un évier. Il se passe quelque chose de plus profond ici."

# Traduction IA – à relire
#: sinclaire_sink/MartinsJobClueSelect/0/c-1/39/c-0/13
msgctxt "Maggie"
msgid "An intriguing hypothesis..."
msgstr "Une hypothèse intrigante..."

# Traduction IA – à relire
#: sinclaire_sink/MartinsJobClueSelect/0/c-1/39/c-1/13
msgctxt "Maggie"
msgid "I'm thinking the same."
msgstr "Je pense la même chose."

# Traduction IA – à relire
#: sinclaire_sink/MartinsJobClueSelect/0/g-0/0
msgctxt "Maggie"
msgid "Let's get back to our interview."
msgstr "Retournons à notre interrogatoire."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightOut/0/0/b/1
msgctxt "Sinclaire"
msgid "What else can I tell you about that fateful night?"
msgstr "Que puis-je te dire d'autre sur cette soirée fatidique ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightOut/0/1/b/1
msgctxt "Sinclaire"
msgid "Let us dive into that unfortunate eve."
msgstr "Plongeons dans cette fâcheuse soirée."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightOut/0/8/s/0
msgctxt "Choix"
msgid "Let's go over it again from start to finish."
msgstr "Reprenons tout depuis le début, jusqu'à la fin."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightOut/0/c-0/7
msgctxt "Sinclaire"
msgid "Of course. I left work late and made my way to a local watering hole."
msgstr "Bien sûr. J'ai quitté le travail tard et j'ai gagné un abreuvoir du coin."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightOut/0/g-0/0
msgctxt "Sinclaire"
msgid "The Banana Club."
msgstr "Le Banana Club."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightOut/0/g-0/8/s/0
msgctxt "Choix"
msgid "What did you order?"
msgstr "Qu'est-ce que tu as commandé ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightOut/0/g-0/c-1/7
msgctxt "Sinclaire"
msgid "I had a Shirley Temple."
msgstr "J'ai pris un Shirley Temple."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightOut/0/g-0/c-1/15/0/s/0
msgctxt "Choix"
msgid "I thought you said you had seven—"
msgstr "Je croyais que tu avais dit en avoir bu sept—"

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightOut/0/g-0/c-1/15/c-0/7
msgctxt "Sinclaire"
msgid "And then I had six more of them."
msgstr "Et ensuite j'en ai bu six autres."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightOut/0/g-0/c-1/15/c-0/18/0/s/0
msgctxt "Choix"
msgid "And these were alcoholic, or...?"
msgstr "Et ils étaient alcoolisés, ou...?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightOut/0/g-0/c-1/15/c-0/18/c-0/7
msgctxt "Sinclaire"
msgid "Surely not. Or should I say, Shirley not."
msgstr "Évidemment pas ! Ou plutôt, Shirley-demment pas !"

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightOut/0/g-0/c-1/15/c-0/18/c-0/15/0/s/0
msgctxt "Choix"
msgid "But you mentioned them being 'potent' last time we talked."
msgstr "Mais tu les as qualifiés de « puissants » la dernière fois qu'on a parlé."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightOut/0/g-0/c-1/15/c-0/18/c-0/15/1/s/0
msgctxt "Choix"
msgid "Alright, what next?"
msgstr "Bon, et ensuite ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightOut/0/g-0/c-1/15/c-0/18/c-0/15/c-0/7
msgctxt "Sinclaire"
msgid "My mistake. I probably just didn't finish."
msgstr "Mon erreur. Je n'ai probablement pas fini ma phrase."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightOut/0/g-0/c-1/15/c-0/18/c-0/15/c-0/15
msgctxt "Sinclaire"
msgid "If I had, I would have said they were 'potent'-ially the best drinks I'd ever had."
msgstr "Si je l'avais fini, j'aurais dit qu'ils étaient puissamment les meilleures boissons que j'aie jamais bues."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightOut/0/g-0/c-1/15/c-0/18/c-0/15/c-0/23
msgctxt "Maggie"
msgid "It's like interviewing a can of silly string. He's all over the place!"
msgstr "C'est comme interviewer une bombe de serpentins. Il part dans tous les sens !"

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightOut/0/g-0/c-1/15/c-0/18/c-0/15/c-0/31/0/s/0
msgctxt "Choix"
msgid "Ok what happened after that?"
msgstr "Ok, et que s'est-il passé après ça ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightOut/0/g-1/0
msgctxt "Sinclaire"
msgid "Then I went to the Questionable Dandelion."
msgstr "Ensuite je suis allé au Pissenlit Douteux."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightOut/0/g-1/11/s/0
msgctxt "Choix"
msgid "Let's dig into that a bit."
msgstr "Creusons un peu ça."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightOut/0/g-1/c-2/7
msgctxt "Sinclaire"
msgid "With gusto!"
msgstr "Avec appétit !"

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightOut/0/g-1/c-2/15/0/s/0
msgctxt "Choix"
msgid "What did you eat?"
msgstr "Qu'est-ce que tu as mangé ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightOut/0/g-1/c-2/15/c-0/7
msgctxt "Sinclaire"
msgid "I had one of their new specials."
msgstr "J'ai pris un de leurs nouveaux plats du jour."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightOut/0/g-1/c-2/15/c-0/15
msgctxt "Sinclaire"
msgid "Jimson Weed cupcakes with a side of diplodocus berries! Delicious."
msgstr "Des cupcakes à la stramoine avec un accompagnement de baies de diplodocus ! Délicieux."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightOut/0/g-1/c-2/15/c-0/26/0/s/0
msgctxt "Choix"
msgid "Didn't you mention that they sold 'Exceedrin by the pint?'"
msgstr "Tu n'avais pas mentionné qu'ils vendaient de l'« Exceedrin à la pinte » ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightOut/0/g-1/c-2/15/c-0/26/c-0/7
msgctxt "Sinclaire"
msgid "I didn't have a headache, so naturally I avoided that item."
msgstr "Je n'avais pas mal à la tête, donc j'ai naturellement évité ce plat."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightOut/0/g-1/c-2/15/c-0/26/c-0/15/0/s/0
msgctxt "Choix"
msgid "How very rational of you. Then what?"
msgstr "Quelle sagesse. Et ensuite ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightOut/0/g-1/c-2/15/c-0/26/c-0/15/c-0/7
msgctxt "Sinclaire"
msgid "I roamed about a bit."
msgstr "J'ai un peu erré."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightOut/0/g-1/c-2/15/c-0/26/c-0/15/c-0/15
msgctxt "Sinclaire"
msgid "Then I saw a mysterious, threatening, dark alley, which I wandered into - quite sanely I might add."
msgstr "Puis j'ai vu une ruelle sombre, mystérieuse et menaçante, dans laquelle je me suis aventuré, en toute sanité, soit dit en passant."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightOut/0/g-1/c-2/15/c-0/26/c-0/15/c-0/23
msgctxt "Sinclaire"
msgid "And that's when I met Vagabonda!"
msgstr "Et c'est là que j'ai rencontré Vagabonda !"

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightClueSelect/0/6 sinclaire_sink/MartinsNightClueSelect/0/15/0
msgctxt "Maggie"
msgid "Ok. Let's go over this."
msgstr "Ok. Reprenons tout ça."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightClueSelect/0/15/8/0/s/0
msgctxt "Choix"
msgid "What do you make of the Questionable Dandelion?"
msgstr "Qu'est-ce que tu penses du Pissenlit Douteux ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightClueSelect/0/15/8/1/s/0
msgctxt "Choix"
msgid "What's the deal with that bar? The so-called 'Banana Lounge?'"
msgstr "C'est quoi, cette histoire de bar ? Le soi-disant « Banana Lounge » ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightClueSelect/0/15/8/2/s/0
msgctxt "Choix"
msgid "I have my takeaway from this line of questioning."
msgstr "J'ai ce que je voulais tirer de cette série de questions."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightClueSelect/0/15/8/c-0/7
msgctxt "Maggie"
msgid "Well, that is actually a real place. It's usually called the 'QD.'"
msgstr "Eh bien, c'est en fait un endroit qui existe vraiment. On l'appelle généralement « le Douteux »."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightClueSelect/0/15/8/c-0/15
msgctxt "Maggie"
msgid "It's the first thing he's said that seems like it could be true..."
msgstr "C'est la première chose qu'il a dite qui pourrait être vraie..."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightClueSelect/0/15/8/c-0/23
msgctxt "Maggie"
msgid "But what about those ingredients?"
msgstr "Mais que dire de ces ingrédients ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightClueSelect/0/15/8/c-0/31/0/s/0
msgctxt "Choix"
msgid "Diplodocus berries are real. They come from the diplodocus bush."
msgstr "Les baies de diplodocus existent. Elles viennent de l'arbuste à diplodocus."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightClueSelect/0/15/8/c-0/31/1/s/0
msgctxt "Choix"
msgid "Jimson weed is a thing."
msgstr "La stramoine, ça existe."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightClueSelect/0/15/8/c-0/31/2/s/0
msgctxt "Choix"
msgid "Exceedrin is real. It's an off-brand headache med."
msgstr "L'Exceedrin existe. C'est un médicament générique contre les maux de tête."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightClueSelect/0/15/8/c-0/31/3/s/0
msgctxt "Choix"
msgid "None of that stuff is real."
msgstr "Rien de tout ça n'est réel."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightClueSelect/0/15/8/c-0/31/c-0/7
msgctxt "Maggie"
msgid "If you say so..."
msgstr "Si tu le dis..."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightClueSelect/0/15/8/c-0/31/c-1/7
msgctxt "Maggie"
msgid "It is?"
msgstr "Vraiment ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightClueSelect/0/15/8/c-0/31/c-1/15/0/s/0
msgctxt "Choix"
msgid "You bet. But it's just a culinary garnish."
msgstr "Tout à fait. Mais ce n'est qu'une garniture culinaire."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightClueSelect/0/15/8/c-0/31/c-1/15/1/s/0
msgctxt "Choix"
msgid "Yep. It's a powerful psychedelic!"
msgstr "Oui. C'est un puissant psychédélique !"

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightClueSelect/0/15/8/c-0/31/c-1/15/2/s/0
msgctxt "Choix"
msgid "Grows all over the place. Nothing fancy."
msgstr "Ça pousse un peu partout. Rien de sophistiqué."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightClueSelect/0/15/8/c-0/31/c-1/15/c-0/7
msgctxt "Maggie"
msgid "Hmm. Doesn't point to much..."
msgstr "Hmm. Ça n'indique pas grand-chose..."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightClueSelect/0/15/8/c-0/31/c-1/15/c-1/7
msgctxt "Maggie"
msgid "By gosh you're right! 'Datura stramonium.'"
msgstr "Mon Dieu, tu as raison ! « Datura stramonium »."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightClueSelect/0/15/8/c-0/31/c-1/15/c-1/18
msgctxt "Maggie"
msgid "Its properties include memory loss and delusion!"
msgstr "Parmi ses propriétés : perte de mémoire et délires !"

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightClueSelect/0/15/8/c-0/31/c-1/15/c-2/7
msgctxt "Maggie"
msgid "Hmm. Not much of a clue, there."
msgstr "Hmm. Pas vraiment un indice, là."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightClueSelect/0/15/8/c-0/31/c-2/7
msgctxt "Maggie"
msgid "True, true... Says here 'Side effects include psychosis, vomiting, diarrhea, and more vomiting.'"
msgstr "Exact, exact... Il est écrit ici : « Effets secondaires : psychose, vomissements, diarrhée et encore des vomissements. »"

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightClueSelect/0/15/8/c-0/31/c-3/7
msgctxt "Maggie"
msgid "Guess there's no real clue here, then."
msgstr "Je suppose qu'il n'y a pas d'indice réel ici, alors."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightClueSelect/0/15/8/c-1/7
msgctxt "Maggie"
msgid "You've got me. I can't find anything about it online."
msgstr "Là, tu me tiens. Je ne trouve rien à ce sujet en ligne."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightClueSelect2/0/0
msgctxt "Maggie"
msgid "What is it?"
msgstr "C'est quoi ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightClueSelect2/0/8/s/0
msgctxt "Choix"
msgid "I don't buy what he said about the Shirley Temples. I think they must have been alcoholic."
msgstr "Je n'avale pas ce qu'il a dit sur les Shirley Temple. Je pense qu'ils devaient contenir de l'alcool."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightClueSelect2/0/9/s/0
msgctxt "Choix"
msgid "He ordered from a real restaurant. That's the only thing he's told us so far that adds up."
msgstr "Il a commandé dans un vrai restaurant. C'est la seule chose qu'il nous ait dite jusqu'ici qui tienne la route."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightClueSelect2/0/c-0/7
msgctxt "Maggie"
msgid "Interesting... Let's add that to our list."
msgstr "Intéressant... Ajoutons ça à notre liste."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightClueSelect2/0/c-1/7
msgctxt "Maggie"
msgid "Indeed. I thought the same."
msgstr "En effet. J'ai pensé la même chose."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightClueSelect2/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "And on top of that, his diet included a known psychedelic plant!"
msgstr "Et en plus, son menu comprenait une plante psychédélique connue !"

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightClueSelect2/0/c-1/15/1/s/0
msgctxt "Choix"
msgid "And he just may have eaten a medication known to cause psychosis!"
msgstr "Et il a peut-être ingéré un médicament connu pour provoquer des psychoses !"

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightClueSelect2/0/c-1/15/2/s/0
msgctxt "Choix"
msgid "Guess that's a dead end..."
msgstr "Je suppose que c'est une impasse..."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightClueSelect2/0/c-1/15/c-0/7
msgctxt "Maggie"
msgid "I think we're on to something."
msgstr "Je crois qu'on tient quelque chose."

# Traduction IA – à relire
#: sinclaire_sink/MartinsNightClueSelect2/0/c-1/15/c-1/7
msgctxt "Maggie"
msgid "Things are starting to add up here!"
msgstr "Les choses commencent à s'éclaircir !"

# Traduction IA – à relire
#: sinclaire_sink/MartinsEncounter/0/0/b/1
msgctxt "Sinclaire"
msgid "Vagabonda! What a mysterious character."
msgstr "Vagabonda ! Quel personnage mystérieux."

# Traduction IA – à relire
#: sinclaire_sink/MartinsEncounter/0/1/b/1
msgctxt "Sinclaire"
msgid "What else would you like to know?"
msgstr "Que voudrais-tu savoir d'autre ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsEncounter/0/14/s/0
msgctxt "Choix"
msgid "What was the deal with her punch card?"
msgstr "C'était quoi, l'histoire de sa carte à tampons ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsEncounter/0/15/s/0
msgctxt "Choix"
msgid "Why did she curse you, again?"
msgstr "Pourquoi t'a-t-elle maudit, déjà ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsEncounter/0/16/s/0
msgctxt "Choix"
msgid "How do I know she's a real person?"
msgstr "Comment je sais qu'elle existe vraiment ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsEncounter/0/17/s/0
msgctxt "Choix"
msgid "Let's move on to another line of questioning."
msgstr "Passons à une autre série de questions."

# Traduction IA – à relire
#: sinclaire_sink/MartinsEncounter/0/c-0/7
msgctxt "Sinclaire"
msgid "It was a loyalty card for a free shovel from Ace of Spades."
msgstr "C'était une carte de fidélité pour une pelle gratuite de chez L'As de Pique."

# Traduction IA – à relire
#: sinclaire_sink/MartinsEncounter/0/c-0/15
msgctxt "Sinclaire"
msgid "It's a bespoke shovel manufactory."
msgstr "C'est une manufacture de pelles sur mesure."

# Traduction IA – à relire
#: sinclaire_sink/MartinsEncounter/0/c-0/23/0/s/0
msgctxt "Choix"
msgid "Do you still have it?"
msgstr "Tu l'as encore ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsEncounter/0/c-0/23/1/s/0
msgctxt "Choix"
msgid "Maggie, can you find anything about it?"
msgstr "Maggie, tu peux trouver quelque chose à ce sujet ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsEncounter/0/c-0/23/c-0/7
msgctxt "Sinclaire"
msgid "Why yes! Here it is."
msgstr "Mais oui ! La voici."

# Traduction IA – à relire
#: sinclaire_sink/MartinsEncounter/0/c-0/23/c-0/18/0/s/0
msgctxt "Choix"
msgid "You've just handed me a warranty for an in-sink disposal."
msgstr "Tu viens de me tendre une garantie pour un broyeur d'évier."

# Traduction IA – à relire
#: sinclaire_sink/MartinsEncounter/0/c-0/23/c-0/18/c-0/7
msgctxt "Sinclaire"
msgid "Have I?"
msgstr "Vraiment ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsEncounter/0/c-0/23/c-0/18/c-0/15
msgctxt "Sinclaire"
msgid "How odd."
msgstr "Comme c'est étrange."

# Traduction IA – à relire
#: sinclaire_sink/MartinsEncounter/0/c-0/23/c-0/18/c-0/23
msgctxt "Sinclaire"
msgid "Completely unlike me to do such a thing."
msgstr "Ça ne me ressemble vraiment pas de faire une chose pareille."

# Traduction IA – à relire
#: sinclaire_sink/MartinsEncounter/0/c-0/23/c-1/7
msgctxt "Maggie"
msgid "There's nothing anywhere online."
msgstr "Il n'y a rien du tout en ligne."

# Traduction IA – à relire
#: sinclaire_sink/MartinsEncounter/0/c-0/23/c-1/15
msgctxt "Maggie"
msgid "Could just be a mom and pop shop though."
msgstr "Ça pourrait n'être qu'une boutique de papa et maman, cela dit."

# Traduction IA – à relire
#: sinclaire_sink/MartinsEncounter/0/c-0/23/c-1/23
msgctxt "Sinclaire"
msgid "They sell moms and pops now?"
msgstr "Ils vendent des papas et des mamans, maintenant ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsEncounter/0/c-0/23/c-1/31
msgctxt "Sinclaire"
msgid "Ruthless!"
msgstr "Impitoyable !"

# Traduction IA – à relire
#: sinclaire_sink/MartinsEncounter/0/c-1/7
msgctxt "Sinclaire"
msgid "I assume it was because I took her punch card."
msgstr "Je suppose que c'est parce que j'ai pris sa carte à tampons."

# Traduction IA – à relire
#: sinclaire_sink/MartinsEncounter/0/c-2/7
msgctxt "Sinclaire"
msgid "You don't! I don't!"
msgstr "Tu ne le sais pas ! Moi non plus !"

# Traduction IA – à relire
#: sinclaire_sink/MartinsEncounter/0/c-2/15
msgctxt "Sinclaire"
msgid "But do we really <i>know</i> anything?"
msgstr "Mais savons-nous vraiment <i>quoi que ce soit</i> ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsEncounterClueSelect/0/0
msgctxt "Maggie"
msgid "Give us a moment, would you Martin?"
msgstr "Accorde-nous un instant, veux-tu, Martin ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsEncounterClueSelect/0/11
msgctxt "Maggie"
msgid "Anything stand out to you?"
msgstr "Quelque chose te saute aux yeux ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsEncounterClueSelect/0/19/s/0
msgctxt "Choix"
msgid "The disposal warranty is very intriguing."
msgstr "La garantie du broyeur est très intrigante."

# Traduction IA – à relire
#: sinclaire_sink/MartinsEncounterClueSelect/0/20/s/0
msgctxt "Choix"
msgid "He has no evidence that she's real."
msgstr "Il n'a aucune preuve qu'elle existe vraiment."

# Traduction IA – à relire
#: sinclaire_sink/MartinsEncounterClueSelect/0/c-0/7
msgctxt "Maggie"
msgid "I agree. One of the most interesting pieces of evidence thus far."
msgstr "Je suis d'accord. L'un des éléments les plus intéressants jusqu'ici."

# Traduction IA – à relire
#: sinclaire_sink/MartinsEncounterClueSelect/0/c-1/7
msgctxt "Maggie"
msgid "Yes. Very peculiar."
msgstr "Oui. Très particulier."

# Traduction IA – à relire
#: sinclaire_sink/MartinsPast/0/0
msgctxt "Maggie"
msgid "Sinclaire, would you give us a moment?"
msgstr "Sinclaire, pourrais-tu nous laisser un instant ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsPast/0/11
msgctxt "Maggie"
msgid "I think witnesses are in order."
msgstr "Je crois qu'il nous faut des témoins."

# Traduction IA – à relire
#: sinclaire_sink/MartinsPast/0/19/b/1
msgctxt "Maggie"
msgid "We can talk to Dorian, Arma, or... Sudsy?"
msgstr "On peut parler à Dorian, à Arma, ou... à Sudsy ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsPast/0/22/b/1
msgctxt "Maggie"
msgid "Arma is our resident fire alarm. Should be a good witness."
msgstr "Arma est notre alarme incendie attitrée. Ça devrait faire un bon témoin."

# Traduction IA – à relire
#: sinclaire_sink/MartinsPast/0/25
msgctxt "Maggie"
msgid "Who should we talk to first?"
msgstr "À qui devrions-nous parler en premier ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsPast/0/34/6
msgctxt "Maggie"
msgid "Who should we talk to next?"
msgstr "À qui devrions-nous parler ensuite ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsPast/0/34/14/10/s/0
msgctxt "Choix"
msgid "Let's bring in Dorian!"
msgstr "Faisons venir Dorian !"

# Traduction IA – à relire
#: sinclaire_sink/MartinsPast/0/34/14/11/s/0
msgctxt "Choix"
msgid "Let's talk to Arma."
msgstr "Parlons à Arma."

# Traduction IA – à relire
#: sinclaire_sink/MartinsPast/0/34/14/12/s/0
msgctxt "Choix"
msgid "Can we have a moment with Sudsy?"
msgstr "On peut avoir un moment avec Sudsy ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsPast/0/34/14/13/s/0
msgctxt "Choix"
msgid "I think we're ready to move on."
msgstr "Je crois qu'on est prêts à passer à autre chose."

# Traduction IA – à relire
#: sinclaire_sink/MartinsPast/0/34/14/c-0/10/b/1
msgctxt "Dorian"
msgid "You? Not a chance."
msgstr "Toi ? Aucune chance."

# Traduction IA – à relire
#: sinclaire_sink/MartinsPast/0/34/14/c-0/11/b/1
msgctxt "Dorian"
msgid "'Ello loves. What can I do for ya?"
msgstr "Salut, mes cocos. Qu'est-ce que je peux faire pour vous ?"

# Traduction IA – à relire
#: sinclaire_sink/MartinsPast/0/34/14/c-0/11/b/9
msgctxt "Maggie"
msgid "We'd like to ask you about Sinclaire."
msgstr "On aimerait te poser des questions sur Sinclaire."

# Traduction IA – à relire
#: sinclaire_sink/MartinsPast/0/34/14/c-1/10/b/1
msgctxt "Arma"
msgid "<w>BLEEEEEEEEEEE</w>"
msgstr "<w>BLEEEEEEEEEEE</w>"

# Traduction IA – à relire
#: sinclaire_sink/MartinsPast/0/34/14/c-1/10/b/15 sinclaire_sink/MartinsPast/0/34/14/c-1/10/b/23
msgctxt "Arma"
msgid "<w>EEEEEEEEEEEEEEEEEE</w>"
msgstr "<w>EEEEEEEEEEEEEEEEEE</w>"

# Traduction IA – à relire
#: sinclaire_sink/MartinsPast/0/34/14/c-1/10/b/34
msgctxt "Maggie"
msgid "This clearly won't do."
msgstr "Ça ne va clairement pas le faire."

# Traduction IA – à relire
#: sinclaire_sink/MartinsPast/0/34/14/c-1/11/b/1
msgctxt "Arma"
msgid "Hey folks! What can I do for ya?"
msgstr "Salut, les amis ! Qu'est-ce que je peux faire pour vous ?"

# Traduction IA – à relire
#: sinclaire_sink/QuestionDorian/0/0
msgctxt "Dorian"
msgid "I'm open for questioning."
msgstr "Je suis à votre disposition pour un interrogatoire."

# Traduction IA – à relire
#: sinclaire_sink/QuestionDorian/0/8/s/0
msgctxt "Choix"
msgid "Was Sinclaire always this way?"
msgstr "Sinclaire a-t-il toujours été comme ça ?"

# Traduction IA – à relire
#: sinclaire_sink/QuestionDorian/0/9/s/0
msgctxt "Choix"
msgid "Does Sinclaire recognize you?"
msgstr "Sinclaire te reconnaît-il ?"

# Traduction IA – à relire
#: sinclaire_sink/QuestionDorian/0/10/s/0
msgctxt "Choix"
msgid "Have you noticed anything odd about him?"
msgstr "As-tu remarqué quelque chose d'étrange chez lui ?"

# Traduction IA – à relire
#: sinclaire_sink/QuestionDorian/0/11/s/0
msgctxt "Choix"
msgid "Alright, let's move on."
msgstr "Bon, passons à autre chose."

# Traduction IA – à relire
#: sinclaire_sink/QuestionDorian/0/c-0/7
msgctxt "Dorian"
msgid "No. Far as I recall, Sinclaire used to be... well, charming."
msgstr "Non. D'après mes souvenirs, Sinclaire était... charmant, avant."

# Traduction IA – à relire
#: sinclaire_sink/QuestionDorian/0/c-0/15
msgctxt "Dorian"
msgid "He was always thoughtful, and took great care to have perfect hygiene."
msgstr "Il était toujours prévenant, et veillait avec grand soin à avoir une hygiène irréprochable."

# Traduction IA – à relire
#: sinclaire_sink/QuestionDorian/0/c-0/23
msgctxt "Dorian"
msgid "Bit of a mess, now, isn't he?"
msgstr "Il est un peu dans le pétrin, maintenant, non ?"

# Traduction IA – à relire
#: sinclaire_sink/QuestionDorian/0/c-1/7
msgctxt "Dorian"
msgid "No. He keeps calling me names like 'Wall-bert' and 'Jonald.'"
msgstr "Non. Il n'arrête pas de m'appeler « Mur-bert » et « Jonald »."

# Traduction IA – à relire
#: sinclaire_sink/QuestionDorian/0/c-1/15
msgctxt "Dorian"
msgid "Really rather annoying."
msgstr "C'est franchement assez agaçant."

# Traduction IA – à relire
#: sinclaire_sink/QuestionDorian/0/c-2/7
msgctxt "Dorian"
msgid "You mean aside from... everything?"
msgstr "À part... tout ?"

# Traduction IA – à relire
#: sinclaire_sink/QuestionDorian/0/c-2/15
msgctxt "Dorian"
msgid "I guess he does seem to be getting backed up a bit more often than usual."
msgstr "Je dirais qu'il a l'air d'être un peu plus souvent bouché que d'habitude."

# Traduction IA – à relire
#: sinclaire_sink/QuestionArma/0/0/b/1
msgctxt "Arma"
msgid "How can I help?"
msgstr "Comment puis-je vous aider ?"

# Traduction IA – à relire
#: sinclaire_sink/QuestionArma/0/1/b/1
msgctxt "Arma"
msgid "Sorry folks, that's all I've got time for!"
msgstr "Désolé, les amis, je n'ai pas le temps pour plus !"

# Traduction IA – à relire
#: sinclaire_sink/QuestionArma/0/4/s/0
msgctxt "Choix"
msgid "Can you provide a medical diagnosis of Sinclaire/Martin's condition?"
msgstr "Peux-tu poser un diagnostic médical sur l'état de Sinclaire/Martin ?"

# Traduction IA – à relire
#: sinclaire_sink/QuestionArma/0/5/s/0
msgctxt "Choix"
msgid "Why do you think Sinclaire started that fire?"
msgstr "Pourquoi penses-tu que Sinclaire a déclenché cet incendie ?"

# Traduction IA – à relire
#: sinclaire_sink/QuestionArma/0/6/s/0
msgctxt "Choix"
msgid "Does Sinclaire remember past interactions?"
msgstr "Sinclaire se souvient-il de ses interactions passées ?"

# Traduction IA – à relire
#: sinclaire_sink/QuestionArma/0/7/s/0
msgctxt "Choix"
msgid "Have you ever come across a transformation before?"
msgstr "As-tu déjà rencontré une transformation de ce genre ?"

# Traduction IA – à relire
#: sinclaire_sink/QuestionArma/0/c-0/7
msgctxt "Arma"
msgid "Well, I'm not a doctor, but I can speak to it from an emergency responder's point of view."
msgstr "Eh bien, je ne suis pas médecin, mais je peux en parler du point de vue d'un secouriste."

# Traduction IA – à relire
#: sinclaire_sink/QuestionArma/0/c-0/15
msgctxt "Arma"
msgid "Here's what I notice."
msgstr "Voici ce que je remarque."

# Traduction IA – à relire
#: sinclaire_sink/QuestionArma/0/c-0/23
msgctxt "Arma"
msgid "There's definitely an altered state of consciousness."
msgstr "Il y a clairement un état de conscience altéré."

# Traduction IA – à relire
#: sinclaire_sink/QuestionArma/0/c-0/31
msgctxt "Arma"
msgid "His erratic behavior points toward a head injury."
msgstr "Son comportement erratique évoque un traumatisme crânien."

# Traduction IA – à relire
#: sinclaire_sink/QuestionArma/0/c-0/39
msgctxt "Arma"
msgid "Or intoxication due to foreign substances."
msgstr "Ou une intoxication due à des substances étrangères."

# Traduction IA – à relire
#: sinclaire_sink/QuestionArma/0/c-0/47
msgctxt "Arma"
msgid "Or, I guess, magic? Who's to say..."
msgstr "Ou, je suppose, de la magie ? Qui sait..."

# Traduction IA – à relire
#: sinclaire_sink/QuestionArma/0/c-1/7
msgctxt "Arma"
msgid "I've been wondering the same thing."
msgstr "Je me suis posé la même question."

# Traduction IA – à relire
#: sinclaire_sink/QuestionArma/0/c-1/15
msgctxt "Arma"
msgid "It's not like him... He used to be so considerate."
msgstr "Ça ne lui ressemble pas... Il était si attentionné, avant."

# Traduction IA – à relire
#: sinclaire_sink/QuestionArma/0/c-1/23
msgctxt "Arma"
msgid "He's acting like he's high."
msgstr "Il se comporte comme s'il était défoncé."

# Traduction IA – à relire
#: sinclaire_sink/QuestionArma/0/c-2/7
msgctxt "Arma"
msgid "Not in the slightest."
msgstr "Pas le moins du monde."

# Traduction IA – à relire
#: sinclaire_sink/QuestionArma/0/c-2/15
msgctxt "Arma"
msgid "And he's created a bizarre 'memory' of another life."
msgstr "Et il s'est fabriqué un « souvenir » bizarre d'une autre vie."

# Traduction IA – à relire
#: sinclaire_sink/QuestionArma/0/c-3/7
msgctxt "Arma"
msgid "I have to say I have not."
msgstr "Je dois dire que non."

# Traduction IA – à relire
#: sinclaire_sink/QuestionArma/0/c-3/15
msgctxt "Arma"
msgid "But that's not to say it can't be real."
msgstr "Mais ça ne veut pas dire que ça ne peut pas être réel."

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/0
msgctxt "Sudsy"
msgid "Werf!"
msgstr "Ouaf !"

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/8/s/0
msgctxt "Choix"
msgid "Alright, Suds, give us the straight dope."
msgstr "Bon, Suds, dis-nous tout, sans détour."

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/9/s/0
msgctxt "Choix"
msgid "Want a treat?"
msgstr "Tu veux une friandise ?"

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/10/s/0
msgctxt "Choix"
msgid "Guess we oughta let ya go, Suds."
msgstr "Je crois qu'on devrait te laisser partir, Suds."

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/11/s/0
msgctxt "Choix"
msgid "Marvelous."
msgstr "Merveilleux."

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/12/s/0
msgctxt "Choix"
msgid "Best time I ever spent."
msgstr "Le meilleur moment de ma vie."

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/13/s/0
msgctxt "Choix"
msgid "Exquisite."
msgstr "Exquis."

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/14/s/0
msgctxt "Choix"
msgid "Valuable."
msgstr "Précieux."

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/c-0/7
msgctxt "Sudsy"
msgid "Raf rorf!"
msgstr "Ouaf rouaf !"

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "Bark once for yes, and twice for no, ok?"
msgstr "Aboie une fois pour oui, deux fois pour non, d'accord ?"

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/c-0/15/1/s/0
msgctxt "Choix"
msgid "Froth up if you understand me."
msgstr "Fais mousser si tu me comprends."

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/c-0/15/c-0/7
msgctxt "Sudsy"
msgid "Rrrrof!"
msgstr "Grrrouaf !"

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "Alright... Is Sinclaire really a sink?"
msgstr "Bon... Sinclaire est-il vraiment un évier ?"

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/c-0/15/c-0/15/c-0/7
msgctxt "Sudsy"
msgid "... rf."
msgstr "... ouaf."

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/c-0/15/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "Do you mean 'yes?!'"
msgstr "Tu veux dire « oui » ?!"

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/c-0/15/c-0/15/c-0/15/1/s/0
msgctxt "Choix"
msgid "Bark again to confirm!"
msgstr "Aboie encore pour confirmer !"

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/c-0/15/c-0/15/c-0/15/c-0/7
msgctxt "Sudsy"
msgid "ruff. ruff."
msgstr "ouaf. ouaf."

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/c-0/15/c-0/15/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "Wait... so you mean no?"
msgstr "Attends... donc tu veux dire non ?"

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/c-0/15/c-0/15/c-0/15/c-0/15/c-0/7
msgctxt "Sudsy"
msgid "woof, ruf ruf."
msgstr "ouaf, ouaf ouaf."

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/c-0/15/c-0/15/c-0/15/c-0/15/c-0/15
msgctxt "Maggie"
msgid "Good try..."
msgstr "Bel essai..."

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/c-0/15/c-0/15/c-0/15/c-1/7
msgctxt "Sudsy"
msgid "ruf ruf. rrrrr."
msgstr "ouaf ouaf. grrrrr."

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/c-0/15/c-0/15/c-0/15/c-1/15/0/s/0
msgctxt "Choix"
msgid "Are you saying, 'yes he is a sink?'"
msgstr "Tu dis : « oui, c'est un évier » ?"

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/c-0/15/c-0/15/c-0/15/c-1/15/c-0/7
msgctxt "Sudsy"
msgid "rrrrrrr ruf! bwuff."
msgstr "grrrrrr ouaf ! bwouf."

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/c-0/15/c-0/15/c-0/15/c-1/15/c-0/15
msgctxt "Maggie"
msgid "Let's move on..."
msgstr "Passons à autre chose..."

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/c-0/15/c-1/7
msgctxt "Sudsy"
msgid "Frrrrfffrfrfff."
msgstr "Frrrrfffrfrfff."

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/c-0/15/c-1/15/0/s/0
msgctxt "Choix"
msgid "Ok, great! So... is Sinclaire a sink?"
msgstr "Ok, super ! Alors... Sinclaire est-il un évier ?"

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/c-0/15/c-1/15/c-0/7
msgctxt "Sudsy"
msgid "Bruf. Brf Bruff."
msgstr "Bwouf. Brf Bwouf."

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/c-0/15/c-1/15/c-0/15
msgctxt "Sudsy"
msgid "BORK!"
msgstr "BORK !"

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/c-0/15/c-1/15/c-0/23
msgctxt "Maggie"
msgid "I don't think this is getting us anywhere..."
msgstr "Je ne crois pas que ça nous mène quelque part..."

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/c-1/7
msgctxt "Sudsy"
msgid "BWUFF!!"
msgstr "BWOUF !!"

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "Here ya go."
msgstr "Tiens, voilà."

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/c-1/15/c-0/7
msgctxt "Sudsy"
msgid "ruf ! ruf !"
msgstr "ouaf ! ouaf !"

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/c-1/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "One heck of a pupper!"
msgstr "Quel sacré toutou !"

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/c-1/15/c-0/15/1/s/0
msgctxt "Choix"
msgid "Sure is one dang great doogler!"
msgstr "Voilà un sacré fichu super chienchien !"

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/c-1/15/c-0/15/2/s/0
msgctxt "Choix"
msgid "Best lil' Sudser I ever sudsed!"
msgstr "Le meilleur petit Mousseur que j'aie jamais moussé !"

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/c-1/15/c-0/15/3/s/0
msgctxt "Choix"
msgid "I vote this little biscuit for mayor!"
msgstr "Je vote pour ce petit biscuit comme maire !"

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/c-2/10
msgctxt "Maggie"
msgid "Well, that was..."
msgstr "Eh bien, c'était..."

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/g-0/0
msgctxt "Maggie"
msgid "I couldn't agree more."
msgstr "Je ne saurais mieux dire."

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/g-0/8
msgctxt "Maggie"
msgid "What do you think it taught us?"
msgstr "Qu'est-ce que ça nous a appris, d'après toi ?"

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/g-0/16/s/0
msgctxt "Choix"
msgid "Nothing."
msgstr "Rien."

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/g-0/17/s/0
msgctxt "Choix"
msgid "Sinclaire is definitely a man."
msgstr "Sinclaire est clairement un homme."

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/g-0/18/s/0
msgctxt "Choix"
msgid "Sinclaire is definitely a sink."
msgstr "Sinclaire est clairement un évier."

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/g-0/19/s/0
msgctxt "Choix"
msgid "Sudsy is shaped like a dog!"
msgstr "Sudsy a la forme d'un chien !"

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/g-0/c-7/7
msgctxt "Maggie"
msgid "Yes. That."
msgstr "Oui. Ça."

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/g-0/c-8/7 sinclaire_sink/QuestionSudsy/0/g-0/c-9/13
msgctxt "Maggie"
msgid "You got that from Sudsy? All right..."
msgstr "Tu as tiré ça de Sudsy ? Bon, très bien..."

# Traduction IA – à relire
#: sinclaire_sink/QuestionSudsy/0/g-0/c-10/7
msgctxt "Maggie"
msgid "I knew I could trust your judgement."
msgstr "Je savais que je pouvais me fier à ton jugement."

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/0
msgctxt "Maggie"
msgid "Sinclaire, could you give us another moment alone?"
msgstr "Sinclaire, pourrais-tu nous laisser seules un instant de plus ?"

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/19
msgctxt "Sinclaire"
msgid "Here, take it!"
msgstr "Tiens, prends-le !"

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/27
msgctxt "Maggie"
msgid "Um..."
msgstr "Euh..."

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/35
msgctxt "Maggie"
msgid "All right. Thank you?"
msgstr "Très bien. Merci ?"

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/49
msgctxt "Maggie"
msgid "I've been thinking."
msgstr "J'ai réfléchi."

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/57
msgctxt "Maggie"
msgid "Whatever is going on, clearly Sinclaire/Martin's mind is..."
msgstr "Quoi qu'il se passe, l'esprit de Sinclaire/Martin est clairement..."

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/65/s/0
msgctxt "Choix"
msgid "Unstable?"
msgstr "Instable ?"

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/66/s/0
msgctxt "Choix"
msgid "Fractured?"
msgstr "Fracturé ?"

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/67/s/0
msgctxt "Choix"
msgid "A poorly baked souffle?"
msgstr "Un soufflé mal cuit ?"

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/c-2/10
msgctxt "Sinclaire"
msgid "Did somebody say..."
msgstr "Quelqu'un a dit..."

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/g-0/0
msgctxt "Maggie"
msgid "Exactly. I'm a little concerned that given his fragile state, he's vulnerable."
msgstr "Exactement. Je crains que, vu son état fragile, il ne soit vulnérable."

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/g-0/8
msgctxt "Maggie"
msgid "I'm afraid that if we make the wrong analysis of the situation, he might lose it completely."
msgstr "J'ai peur que, si nous analysons mal la situation, il ne perde complètement les pédales."

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/g-0/19/s/0
msgctxt "Choix"
msgid "I agree. But we have to make a move some time."
msgstr "Je suis d'accord. Mais il va bien falloir se lancer un jour."

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/g-0/20/s/0
msgctxt "Choix"
msgid "I think he's less vulnerable than you think."
msgstr "Je pense qu'il est moins vulnérable que tu ne le crois."

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/g-0/21/s/0
msgctxt "Choix"
msgid "I'm really confident I know what's going on."
msgstr "J'ai vraiment la certitude de savoir ce qui se passe."

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/g-0/c-3/7
msgctxt "Maggie"
msgid "Ok... Well, if you say so, let's do this."
msgstr "Ok... Eh bien, si tu le dis, allons-y."

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/g-0/c-4/7
msgctxt "Maggie"
msgid "Seems dangerous... anything could happen."
msgstr "Ça paraît dangereux... tout pourrait arriver."

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/g-0/c-5/7
msgctxt "Maggie"
msgid "I'm glad someone is!"
msgstr "Heureusement que quelqu'un l'est !"

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/g-1/0
msgctxt "Maggie"
msgid "I've never been so nervous!"
msgstr "Je n'ai jamais été aussi nerveuse !"

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/g-1/11
msgctxt "Maggie"
msgid "I can't make heads or tails of this."
msgstr "Je n'y comprends rien du tout."

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/g-1/19
msgctxt "Maggie"
msgid "I... I've never trusted anyone with a case before."
msgstr "Je... je n'ai jamais confié une affaire à qui que ce soit."

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/g-1/27
msgctxt "Maggie"
msgid "But I'm going to trust you to make this call."
msgstr "Mais je vais te faire confiance pour trancher."

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/g-1/41
msgctxt "Sinclaire"
msgid "So what's what? Have you gotten to the bottom of things?"
msgstr "Alors, quoi de neuf ? Avez-vous tiré les choses au clair ?"

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/g-1/49
msgctxt "Maggie"
msgid "We have gotten as far as we can."
msgstr "Nous sommes allés aussi loin que possible."

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/g-1/57
msgctxt "Sinclaire"
msgid "Well, what's your verdict?"
msgstr "Eh bien, quel est votre verdict ?"

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/g-1/65
msgctxt "Sinclaire"
msgid "Am I man? Or am I sink? Or am I walnut brittle?"
msgstr "Suis-je un homme ? Ou un évier ? Ou une nougatine aux noix ?"

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/g-1/73/s/0
msgctxt "Choix"
msgid "Sinclaire, you're actually a sink."
msgstr "Sinclaire, en fait, tu es un évier."

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/g-1/74/s/0
msgctxt "Choix"
msgid "Martin, you are, indeed, a man."
msgstr "Martin, tu es bel et bien un homme."

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/g-1/75/s/0
msgctxt "Choix"
msgid "The truth is we cannot say for sure."
msgstr "La vérité, c'est qu'on ne peut pas le dire avec certitude."

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/g-1/c-6/7
msgctxt "Sinclaire"
msgid "Preposterous! I don't believe it for a moment!"
msgstr "Grotesque ! Je n'en crois pas un mot !"

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/g-1/c-8/7
msgctxt "Maggie"
msgid "We can't? Why not?"
msgstr "On ne peut pas ? Pourquoi ?"

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/g-1/c-8/15/0/s/0
msgctxt "Choix"
msgid "The evidence is contradictory."
msgstr "Les preuves se contredisent."

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/g-1/c-8/15/1/s/0
msgctxt "Choix"
msgid "We couldn't get definitive proof."
msgstr "On n'a pas pu obtenir de preuve définitive."

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/g-1/c-8/15/2/s/0
msgctxt "Choix"
msgid "Actually... Sinclaire you're a sink! Final answer!"
msgstr "En fait... Sinclaire, tu es un évier ! Réponse finale !"

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/g-1/c-8/15/3/s/0
msgctxt "Choix"
msgid "Actually... Martin, we know you're a man!"
msgstr "En fait... Martin, on sait que tu es un homme !"

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/g-1/c-8/15/c-0/7
msgctxt "Maggie"
msgid "It is. And we must err on the side of caution."
msgstr "C'est vrai. Et nous devons pécher par excès de prudence."

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/g-1/c-8/15/c-1/7
msgctxt "Maggie"
msgid "I am sad to say that I agree."
msgstr "J'ai le regret de dire que je suis d'accord."

# Traduction IA – à relire
#: sinclaire_sink/solve_for_sinclaire/0/g-1/c-8/15/c-2/7
msgctxt "Sinclaire"
msgid "What!?"
msgstr "Quoi !?"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms/0/1/b/1
msgctxt "Sinclaire"
msgid "That proves nothing!"
msgstr "Ça ne prouve rien !"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms/0/2/b/1
msgctxt "Sinclaire"
msgid "What evidence do you have!?"
msgstr "Quelles preuves avez-vous !?"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms/0/5/s/0
msgctxt "Choix"
msgid "Other objects in the house corroborate it."
msgstr "D'autres objets de la maison le corroborent."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms/0/6/s/0
msgctxt "Choix"
msgid "Something happened on your 'night out.'"
msgstr "Il s'est passé quelque chose pendant ta « soirée en ville »."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms/0/7/s/0
msgctxt "Choix"
msgid "Your encounter with Vagabonda wasn't real."
msgstr "Ta rencontre avec Vagabonda n'était pas réelle."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms/0/8/s/0
msgctxt "Choix"
msgid "You've clearly never worked in insurance."
msgstr "Tu n'as clairement jamais travaillé dans l'assurance."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms/0/9/s/0
msgctxt "Choix"
msgid "Uh oh... Well, that's all I've got..."
msgstr "Aïe aïe aïe... Bon, c'est tout ce que j'ai..."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms/0/c-0/7
msgctxt "Sinclaire"
msgid "What!"
msgstr "Quoi !"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms/0/c-1/7
msgctxt "Sinclaire"
msgid "Yes, I was cursed!"
msgstr "Si, j'ai été maudit !"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "No, Sinclaire, you ate a psychedelic weed!"
msgstr "Non, Sinclaire, tu as mangé une herbe psychédélique !"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms/0/c-1/15/1/s/0
msgctxt "Choix"
msgid "No, Sinclaire, you ate toxic meds!"
msgstr "Non, Sinclaire, tu as avalé des médicaments toxiques !"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms/0/c-1/15/2/s/0
msgctxt "Choix"
msgid "No, Martin. You got drunk."
msgstr "Non, Martin. Tu t'es saoulé."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms/0/c-1/15/3/s/0
msgctxt "Choix"
msgid "No, Martin. You imagined it all."
msgstr "Non, Martin. Tu as tout imaginé."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms/0/c-1/15/c-0/7
msgctxt "Sinclaire"
msgid "Madness! Jimson weed is perfectly safe!"
msgstr "Quelle folie ! La stramoine est parfaitement inoffensive !"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms/0/c-1/15/c-1/7
msgctxt "Sinclaire"
msgid "Exceedrin is legal in the state of Florida!"
msgstr "L'Exceedrin est légal dans l'État de Floride !"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms/0/c-1/15/c-2/7
msgctxt "Sinclaire"
msgid "No I didn't!"
msgstr "Non, je ne l'ai pas fait !"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms/0/c-1/15/c-3/7
msgctxt "Sinclaire"
msgid "What?! Preposterous!"
msgstr "Quoi ?! Grotesque !"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms/0/c-2/7
msgctxt "Sinclaire"
msgid "How dare you!"
msgstr "Comment oses-tu !"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms/0/c-2/15/0/s/0
msgctxt "Choix"
msgid "It appears to have been a hallucination."
msgstr "Il semble que ce soit une hallucination."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms/0/c-2/15/1/s/0
msgctxt "Choix"
msgid "The 'punch card' was a disposal warranty."
msgstr "La « carte à tampons » était une garantie de broyeur."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms/0/c-2/15/c-0/7
msgctxt "Sinclaire"
msgid "A hallucination!?"
msgstr "Une hallucination !?"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms/0/c-2/15/c-1/7
msgctxt "Sinclaire"
msgid "It... it was?"
msgstr "C'était... vraiment ça ?"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms/0/c-3/7
msgctxt "Sinclaire"
msgid "Dare you suggest such nonsense? I've adjusted a thousand claims in my day!"
msgstr "Oses-tu suggérer pareille absurdité ? J'ai réglé mille sinistres dans ma carrière !"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/0
msgctxt "Sinclaire"
msgid "It can't be... I can't believe it..."
msgstr "Ça ne peut pas être... Je n'arrive pas à y croire..."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/8
msgctxt "Sinclaire"
msgid "And yet... And yet..."
msgstr "Et pourtant... Et pourtant..."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/16
msgctxt "Narrator"
msgid "Sinclaire wobbles, staggering back against the wall."
msgstr "Sinclaire vacille et recule en titubant contre le mur."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/27
msgctxt "Sinclaire"
msgid "Ugh... Is the room spinning?"
msgstr "Ugh... La pièce tourne-t-elle ?"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/41
msgctxt "Sudsy"
msgid "... RUF!"
msgstr "... OUAF !"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/49
msgctxt "Sinclaire"
msgid "Ooooh... I don't feel so good..."
msgstr "Ooooh... Je ne me sens pas très bien..."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/57
msgctxt "Sudsy"
msgid "rufruf!"
msgstr "ouafouaf !"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/65
msgctxt "Narrator"
msgid "Sinclaire doubles over, holding his sides with a sickly groan."
msgstr "Sinclaire se plie en deux, se tenant les flancs avec un gémissement maladif."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/73
msgctxt "Sinclaire"
msgid "I feel something in my pipes... Something strange..."
msgstr "Je sens quelque chose dans mes tuyaux... Quelque chose d'étrange..."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/84
msgctxt "Sudsy"
msgid "BRRRR! BRRRR!!!"
msgstr "GRRRR ! GRRRR !!!"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/92
msgctxt "Sinclaire"
msgid "What are you trying to say, Sudsy?"
msgstr "Qu'essaies-tu de dire, Sudsy ?"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/103
msgctxt "Sudsy"
msgid "BRRRRRRRRRRRRRRRRRRR!"
msgstr "GRRRRRRRRRRRRRRRRRRR !"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/111/s/0
msgctxt "Choix"
msgid "Hit the disposal!"
msgstr "Lance le broyeur !"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/112/s/0
msgctxt "Choix"
msgid "Turn on the faucet!"
msgstr "Ouvre le robinet !"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/c-0/7
msgctxt "Sinclaire"
msgid "<w>GRRRRRRRR</w> COUGH COUGH! BLECH!"
msgstr "<w>GRRRRRRRR</w> COF COF ! BLEURK !"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/c-1/7
msgctxt "Sinclaire"
msgid "<w>glug glug glug</w> Phew!"
msgstr "<w>glou glou glou</w> Ouf !"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/g-0/3
msgctxt "Sinclaire"
msgid "My word! That's done it!"
msgstr "Ma parole ! Voilà qui est fait !"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/g-0/17
msgctxt "Narrator"
msgid "He stands up to his full height, one hand resting gently on his belly; approximately."
msgstr "Il se redresse de toute sa hauteur, une main posée délicatement sur son ventre ; à peu près."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/g-0/25
msgctxt "Sinclaire"
msgid "What <i>was</i> that in my system?"
msgstr "Qu'est-ce que <i>c'était</i>, dans mon organisme ?"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/g-0/33
msgctxt "Sinclaire"
msgid "Why... I feel as if I've just returned from some sort of journey..."
msgstr "Mais... j'ai l'impression de rentrer d'une sorte de voyage..."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/g-0/41
msgctxt "Sinclaire"
msgid "Have I been dreaming?"
msgstr "Ai-je rêvé ?"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/g-0/49/s/0
msgctxt "Choix"
msgid "In a way..."
msgstr "D'une certaine façon..."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/g-0/50/s/0
msgctxt "Choix"
msgid "Something like that."
msgstr "Quelque chose comme ça."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/g-0/51/s/0
msgctxt "Choix"
msgid "Oh no, man. You've been TRIPPING BALLS."
msgstr "Oh non, mec. Tu as fait un énorme BAD TRIP."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/g-0/52/s/0
msgctxt "Choix"
msgid "Actually you almost OD'd on headache meds."
msgstr "En fait, tu as failli faire une OVERDOSE de médocs contre les migraines."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/g-1/0
msgctxt "Maggie"
msgid "Now the moment of truth..."
msgstr "Voici l'heure de vérité..."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/g-1/14
msgctxt "Maggie"
msgid "We need to ask you one question."
msgstr "Nous devons te poser une question."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/g-1/22
msgctxt "Maggie"
msgid "What is your name?"
msgstr "Quel est ton nom ?"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/g-1/33
msgctxt "Sinclaire"
msgid "I'm... I'm Sinclaire, of course."
msgstr "Je suis... je suis Sinclaire, bien sûr."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/g-1/44
msgctxt "Sudsy"
msgid "ROF rofrofrofrofrof mmmmmmm ROF ROF ROF!!!!!"
msgstr "OUAF ouafouafouafouafouaf mmmmmmm OUAF OUAF OUAF !!!!!"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/g-1/52
msgctxt "Maggie"
msgid "We've done it!"
msgstr "On a réussi !"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/g-1/70
msgctxt "Sinclaire"
msgid "Done what, Maggie?"
msgstr "Réussi quoi, Maggie ?"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/g-1/78
msgctxt "Maggie"
msgid "Never you mind, Sinclaire. Never you mind."
msgstr "Ne t'en soucie pas, Sinclaire. Ne t'en soucie pas."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/g-1/86/s/0
msgctxt "Choix"
msgid "I think you'd better get some rest, Sinclaire."
msgstr "Je crois que tu ferais mieux de te reposer, Sinclaire."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/g-1/87/s/0
msgctxt "Choix"
msgid "Maggie, why don't I wrap things up here?"
msgstr "Maggie, et si je terminais ici ?"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/g-1/c-6/7
msgctxt "Sinclaire"
msgid "Yes... That would be nice. I am quite tired."
msgstr "Oui... Ce serait bien. Je suis assez fatigué."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/g-1/c-6/15/0/s/0
msgctxt "Choix"
msgid "I'll come see you soon."
msgstr "Je viendrai te voir bientôt."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/g-1/c-6/15/c-0/7
msgctxt "Maggie"
msgid "Shall we?"
msgstr "On y va ?"

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/g-1/c-6/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "Indeed."
msgstr "Allons-y."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/g-1/c-6/15/c-0/15/1/s/0
msgctxt "Choix"
msgid "You go ahead, Maggie. I'll catch up."
msgstr "Pars devant, Maggie. Je te rattrape."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/g-1/c-6/15/c-0/15/c-0/7
msgctxt "Maggie"
msgid "Meet me back at my office."
msgstr "Retrouve-moi à mon bureau."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/g-1/c-6/15/c-0/15/c-1/7
msgctxt "Maggie"
msgid "Don't take too long..."
msgstr "Ne tarde pas trop..."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/g-1/c-7/7
msgctxt "Maggie"
msgid "Of course. You know where to find me..."
msgstr "Bien sûr. Tu sais où me trouver..."

# Traduction IA – à relire
#: sinclaire_sink/Sinclaire_Transforms2/0/g-1/c-7/15/b/1
msgctxt "Maggie"
msgid "Detective."
msgstr "Détective."

# Traduction IA – à relire
#: sinclaire_sink/WeDontKnow/0/0
msgctxt "Sinclaire"
msgid "So, all this questioning was for naught?"
msgstr "Alors, tout cet interrogatoire n'a servi à rien ?"

# Traduction IA – à relire
#: sinclaire_sink/WeDontKnow/0/8
msgctxt "Maggie"
msgid "I'm sorry."
msgstr "Je suis désolée."

# Traduction IA – à relire
#: sinclaire_sink/WeDontKnow/0/16
msgctxt "Maggie"
msgid "We only announce the results of investigations when we are 100% confident."
msgstr "Nous n'annonçons les résultats d'une enquête que lorsque nous en sommes sûrs à 100 %."

# Traduction IA – à relire
#: sinclaire_sink/WeDontKnow/0/24
msgctxt "Maggie"
msgid "In your case, we just couldn't be certain."
msgstr "Dans ton cas, nous n'avons tout simplement pas pu en avoir la certitude."

# Traduction IA – à relire
#: sinclaire_sink/WeDontKnow/0/32
msgctxt "Sinclaire"
msgid "What am I to make of my situation?"
msgstr "Que dois-je penser de ma situation ?"

# Traduction IA – à relire
#: sinclaire_sink/WeDontKnow/0/40
msgctxt "Sinclaire"
msgid "Neither man nor sink, am I doomed to reside in this middle-world forever?"
msgstr "Ni homme ni évier, suis-je condamné à vivre éternellement dans ce monde intermédiaire ?"

# Traduction IA – à relire
#: sinclaire_sink/WeDontKnow/0/48/s/0
msgctxt "Choix"
msgid "I'm sorry Sinclaire, I'm afraid so."
msgstr "Pardon, Sinclaire, mais je crains que oui."

# Traduction IA – à relire
#: sinclaire_sink/WeDontKnow/0/49/s/0
msgctxt "Choix"
msgid "I'll keep trying to figure this out."
msgstr "Je vais continuer à essayer de comprendre."

# Traduction IA – à relire
#: sinclaire_sink/WeDontKnow/0/50/s/0
msgctxt "Choix"
msgid "Maybe it's ok to be a sink?"
msgstr "Peut-être que ça va, d'être un évier ?"

# Traduction IA – à relire
#: sinclaire_sink/WeDontKnow/0/51/s/0
msgctxt "Choix"
msgid "Maybe the curse will wear off some day."
msgstr "Peut-être que la malédiction finira par s'estomper."

# Traduction IA – à relire
#: sinclaire_sink/WeDontKnow/0/c-0/7
msgctxt "Sinclaire"
msgid "I'm a monster! A freak!"
msgstr "Je suis un monstre ! Une bête de foire !"

# Traduction IA – à relire
#: sinclaire_sink/WeDontKnow/0/c-0/18/0/s/0
msgctxt "Choix"
msgid "You're not a monster. You're just... different."
msgstr "Tu n'es pas un monstre. Tu es juste... différent."

# Traduction IA – à relire
#: sinclaire_sink/WeDontKnow/0/c-0/18/1/s/0
msgctxt "Choix"
msgid "I have to admit, you are pretty weird."
msgstr "Je dois avouer que tu es plutôt bizarre."

# Traduction IA – à relire
#: sinclaire_sink/WeDontKnow/0/c-0/18/c-0/7
msgctxt "Sinclaire"
msgid "Different like a fox!"
msgstr "Différent, mais rusé comme un renard !"

# Traduction IA – à relire
#: sinclaire_sink/WeDontKnow/0/c-0/18/c-1/7
msgctxt "Sinclaire"
msgid "Thank you!"
msgstr "Merci !"

# Traduction IA – à relire
#: sinclaire_sink/WeDontKnow/0/c-1/7
msgctxt "Sinclaire"
msgid "Don't bother. I've given up hope."
msgstr "Ne te donne pas cette peine. J'ai renoncé à tout espoir."

# Traduction IA – à relire
#: sinclaire_sink/WeDontKnow/0/c-2/7
msgctxt "Sinclaire"
msgid "Easy for you to say. You get to be a trapezoid."
msgstr "Facile à dire pour toi. Toi, tu as le droit d'être un trapèze."

# Traduction IA – à relire
#: sinclaire_sink/WeDontKnow/0/c-2/15/0/s/0
msgctxt "Choix"
msgid "A... trapezoid?"
msgstr "Un... trapèze ?"

# Traduction IA – à relire
#: sinclaire_sink/WeDontKnow/0/c-2/15/c-0/7
msgctxt "Sinclaire"
msgid "With all your uneven, beautiful angles."
msgstr "Avec tous tes angles inégaux et magnifiques."

# Traduction IA – à relire
#: sinclaire_sink/WeDontKnow/0/c-2/15/c-0/18/0/s/0
msgctxt "Choix"
msgid "I just... ok."
msgstr "Je... d'accord."

# Traduction IA – à relire
#: sinclaire_sink/WeDontKnow/0/c-2/15/c-0/18/1/s/0
msgctxt "Choix"
msgid "Why yes, I'm glad you noticed."
msgstr "Eh oui, merci de l'avoir remarqué."

# Traduction IA – à relire
#: sinclaire_sink/WeDontKnow/0/c-2/15/c-0/18/2/s/0
msgctxt "Choix"
msgid "I'm a human."
msgstr "Je suis un humain."

# Traduction IA – à relire
#: sinclaire_sink/WeDontKnow/0/c-2/15/c-0/18/c-1/7
msgctxt "Sinclaire"
msgid "I'm very perceptive."
msgstr "Je suis très perspicace."

# Traduction IA – à relire
#: sinclaire_sink/WeDontKnow/0/c-2/15/c-0/18/c-2/7
msgctxt "Sinclaire"
msgid "Suuuure you are. And I'm a sink."
msgstr "Mais bien sûr. Et moi, je suis un évier."

# Traduction IA – à relire
#: sinclaire_sink/WeDontKnow/0/c-3/7
msgctxt "Sinclaire"
msgid "And maybe it'll deepen to the point I'm a talking toilet. God forbid!"
msgstr "Et ça va peut-être s'enfoncer au point que je devienne des toilettes parlantes. Dieu m'en garde !"

# Traduction IA – à relire
#: sinclaire_sink/WeDontKnow/0/c-3/18/b/1
msgctxt "Jean Loo"
msgid "Meh."
msgstr "Bof."

# Traduction IA – à relire
#: sinclaire_sink/WeDontKnow/0/c-3/18/b/15
msgctxt "Sinclaire"
msgid "And now I'm hearing voices!"
msgstr "Et maintenant j'entends des voix !"

# Traduction IA – à relire
#: sinclaire_sink/WeDontKnow/0/g-0/0
msgctxt "Sinclaire"
msgid "Well, annnyyyyway. I guess I'll just be here, washing things."
msgstr "Enfin, bref. Je suppose que je resterai là, à laver des choses."

# Traduction IA – à relire
#: sinclaire_sink/WeDontKnow/0/g-0/11
msgctxt "Sinclaire"
msgid "And pining away for my long-lost home in Turkelman City."
msgstr "Et à languir après ma maison perdue de Turkleman City."

# Traduction IA – à relire
#: sinclaire_sink/WeDontKnow/0/g-0/19
msgctxt "Sinclaire"
msgid "Feel free to come by and see me whenever you like."
msgstr "N'hésite pas à passer me voir quand tu veux."

# Traduction IA – à relire
#: sinclaire_sink/WeDontKnow/0/g-0/27
msgctxt "Sinclaire"
msgid "And thank you for trying to help me."
msgstr "Et merci d'avoir essayé de m'aider."

# Traduction IA – à relire
#: sinclaire_sink/WeDontKnow/0/g-0/35
msgctxt "Sinclaire"
msgid "I'll always think of you as a friend."
msgstr "Tu compteras toujours parmi mes amis."

# Traduction IA – à relire
#: sinclaire_sink/ASinkOnceMore/0/3
msgctxt "Sinclaire"
msgid "I feel as if we are meeting for the first time."
msgstr "J'ai l'impression que nous nous rencontrons pour la première fois."

# Traduction IA – à relire
#: sinclaire_sink/ASinkOnceMore/0/11/s/0
msgctxt "Choix"
msgid "Me too."
msgstr "Moi aussi."

# Traduction IA – à relire
#: sinclaire_sink/ASinkOnceMore/0/12/s/0
msgctxt "Choix"
msgid "Well, hello Sinclaire. It's a pleasure."
msgstr "Eh bien, bonjour Sinclaire. Quel plaisir."

# Traduction IA – à relire
#: sinclaire_sink/ASinkOnceMore/0/13/s/0
msgctxt "Choix"
msgid "You were pretty messed up there for a minute."
msgstr "Tu étais dans un sale état pendant un moment."

# Traduction IA – à relire
#: sinclaire_sink/ASinkOnceMore/0/c-1/7
msgctxt "Sinclaire"
msgid "I assure you, the pleasure is all mine."
msgstr "Je t'assure que le plaisir est tout pour moi."

# Traduction IA – à relire
#: sinclaire_sink/ASinkOnceMore/0/c-2/7
msgctxt "Sinclaire"
msgid "It was a very strange time..."
msgstr "C'était une période très étrange..."

# Traduction IA – à relire
#: sinclaire_sink/ASinkOnceMore/0/c-2/15
msgctxt "Sinclaire"
msgid "But you saved me."
msgstr "Mais tu m'as sauvé."

# Traduction IA – à relire
#: sinclaire_sink/ASinkOnceMore/0/g-0/0
msgctxt "Sinclaire"
msgid "If it weren't for you, I'd still be a raving lunatic."
msgstr "Sans toi, je serais encore un fou furieux."

# Traduction IA – à relire
#: sinclaire_sink/ASinkOnceMore/0/g-0/11
msgctxt "Sinclaire"
msgid "Now that I'm back to my old self, I'd love to thank you properly."
msgstr "Maintenant que je suis redevenu moi-même, j'aimerais te remercier comme il se doit."

# Traduction IA – à relire
#: sinclaire_sink/ASinkOnceMore/0/g-0/19/s/0
msgctxt "Choix"
msgid "I wouldn't say no to a date..."
msgstr "Je ne dirais pas non à un rendez-vous..."

# Traduction IA – à relire
#: sinclaire_sink/ASinkOnceMore/0/g-0/20/s/0
msgctxt "Choix"
msgid "Maybe we can just hang out?"
msgstr "On pourrait peut-être juste traîner ensemble ?"

# Traduction IA – à relire
#: sinclaire_sink/ASinkOnceMore/0/g-0/c-3/22
msgctxt "Sinclaire"
msgid "And neither would I."
msgstr "Moi non plus."

# Traduction IA – à relire
#: sinclaire_sink/ASinkOnceMore/0/g-0/c-3/30
msgctxt "Sinclaire"
msgid "May I take your hand?"
msgstr "Puis-je prendre ta main ?"

# Traduction IA – à relire
#: sinclaire_sink/ASinkOnceMore/0/g-0/c-3/38/0/s/0
msgctxt "Choix"
msgid "Please do..."
msgstr "Je t'en prie..."

# Traduction IA – à relire
#: sinclaire_sink/ASinkOnceMore/0/g-0/c-3/38/1/s/0
msgctxt "Choix"
msgid "You can take more than my hand."
msgstr "Tu peux prendre plus que ma main."

# Traduction IA – à relire
#: sinclaire_sink/ASinkOnceMore/0/g-0/c-3/38/c-0/7
msgctxt "Narrator"
msgid "Sinclaire reaches out for your hand, taking it in his with a pronounced tenderness. He brushes his thumb gently across the back of it."
msgstr "Sinclaire tend la main vers la vôtre et la prend dans la sienne avec une tendresse prononcée. Il glisse doucement son pouce sur le dessus."

# Traduction IA – à relire
#: sinclaire_sink/ASinkOnceMore/0/g-0/c-3/38/c-0/15
msgctxt "Sinclaire"
msgid "So soft... I could caress you all day."
msgstr "Si doux... Je pourrais te caresser toute la journée."

# Traduction IA – à relire
#: sinclaire_sink/ASinkOnceMore/0/g-0/c-3/38/c-0/29/0/s/0
msgctxt "Choix"
msgid "Sinclaire, you're so gentle."
msgstr "Sinclaire, tu es si délicat."

# Traduction IA – à relire
#: sinclaire_sink/ASinkOnceMore/0/g-0/c-3/38/c-0/29/1/s/0
msgctxt "Choix"
msgid "And all night, if you like..."
msgstr "Et toute la nuit, si tu veux..."

# Traduction IA – à relire
#: sinclaire_sink/ASinkOnceMore/0/g-0/c-3/38/c-0/29/c-0/7
msgctxt "Sinclaire"
msgid "I can also be firm."
msgstr "Je sais aussi me montrer ferme."

# Traduction IA – à relire
#: sinclaire_sink/ASinkOnceMore/0/g-0/c-3/38/c-0/29/c-0/15
msgctxt "Narrator"
msgid "He can indeed."
msgstr "Pour ça, il le peut, en effet."

# Traduction IA – à relire
#: sinclaire_sink/ASinkOnceMore/0/g-0/c-3/38/c-0/29/c-1/7
msgctxt "Sinclaire"
msgid "I would like that very much..."
msgstr "Ça me plairait beaucoup..."

# Traduction IA – à relire
#: sinclaire_sink/ASinkOnceMore/0/g-0/c-3/38/c-0/29/c-1/18
msgctxt "Narrator"
msgid "Your night becomes full of porcelain and neckties."
msgstr "Votre nuit se remplit de porcelaine et de cravates."

# Traduction IA – à relire
#: sinclaire_sink/ASinkOnceMore/0/g-0/c-3/38/c-1/7
msgctxt "Narrator"
msgid "Sinclaire fans at himself with one hand, tugging at his tie-pipes."
msgstr "Sinclaire s'évente d'une main, en tirant sur sa cravate-tuyau."

# Traduction IA – à relire
#: sinclaire_sink/ASinkOnceMore/0/g-0/c-3/38/c-1/18
msgctxt "Sinclaire"
msgid "My, my. Let's at least wait until after dinner..."
msgstr "Eh bien, eh bien. Attendons au moins la fin du dîner..."

# Traduction IA – à relire
#: sinclaire_sink/ASinkOnceMore/0/g-0/c-3/38/c-1/26
msgctxt "Narrator"
msgid "With fierce abandon, you show him that waiting is not an option. He is soon... drained."
msgstr "Avec un abandon féroce, vous lui montrez qu'attendre n'est pas une option. Il est bientôt... vidé."

# Traduction IA – à relire
#: sinclaire_sink/ASinkOnceMore/0/g-0/c-4/7
msgctxt "Sinclaire"
msgid "That would be marvelous!"
msgstr "Ce serait merveilleux !"

# Traduction IA – à relire
#: sinclaire_sink/ASinkOnceMore/0/g-0/c-4/18/0/s/0
msgctxt "Choix"
msgid "And... maybe we can bring the dog?"
msgstr "Et... on pourrait peut-être emmener le chien ?"

# Traduction IA – à relire
#: sinclaire_sink/ASinkOnceMore/0/g-0/c-4/18/c-0/7
msgctxt "Sinclaire"
msgid "Always."
msgstr "Toujours."

# Traduction IA – à relire
#: sinclaire_sink/ASinkOnceMore/0/g-0/c-4/18/c-0/15
msgctxt "Sinclaire"
msgid "Come along, Sudsy!"
msgstr "Viens, Sudsy !"

# Traduction IA – à relire
#: sinclaire_sink/ASinkOnceMore/0/g-0/c-4/18/c-0/26
msgctxt "Sudsy"
msgid "... bwuff!"
msgstr "... bwouf !"

# Traduction IA – à relire
#: sinclaire_sink/ASinkOnceMore/0/g-0/c-4/18/c-0/37/0/s/0
msgctxt "Choix"
msgid "Good boy!"
msgstr "Gentil chien !"

# Traduction IA – à relire
#: sinclaire_sink/ASinkOnceMore/0/g-0/c-4/18/c-0/37/1/s/0
msgctxt "Choix"
msgid "Great boy!"
msgstr "Super chien !"

# Traduction IA – à relire
#: sinclaire_sink/ASinkOnceMore/0/g-0/c-4/18/c-0/37/2/s/0
msgctxt "Choix"
msgid "Excellent boy!"
msgstr "Excellent chien !"

# Traduction IA – à relire
#: sinclaire_sink/ASinkOnceMore/0/g-0/c-4/18/c-0/37/3/s/0
msgctxt "Choix"
msgid "Best of all possible boys!"
msgstr "Le meilleur de tous les chiens possibles !"

# Traduction IA – à relire
#. Morceau de phrase coupé par une variable (nom du joueur, nombre...).
#: sinclaire_sink/sinclaire_love_return/0/0
msgctxt "Sinclaire"
msgid "Why, if it isn’t my darling"
msgstr "Mais voyons, si ce n'est pas mon trésor"

# Traduction IA – à relire
#. Morceau de phrase coupé par une variable (nom du joueur, nombre...).
#: sinclaire_sink/sinclaire_love_return/0/5
msgctxt "Narration / joueur"
msgid "! What an outpouring of joy it brings me to see you again!"
msgstr "! Quel déferlement de joie de te revoir !"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_love_return/0/16/s/0
msgctxt "Choix"
msgid "I always love seeing you Sinclaire."
msgstr "J'aime toujours te voir, Sinclaire."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_love_return/0/17/s/0
msgctxt "Choix"
msgid "Actually, I’m ready to Realize you."
msgstr "En fait, il est temps de te Réaliser."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_love_return/0/18/s/0
msgctxt "Choix"
msgid "Perhaps Winnifred will send us a little hot water…"
msgstr "Peut-être que Winnifred nous enverra un peu d'eau chaude…"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_love_return/0/c-0/7
msgctxt "Sinclaire"
msgid "Shall we leave the tap open and while away the hours in delightful conversation?"
msgstr "Si nous laissions le robinet ouvert pour passer les heures dans une délicieuse conversation ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_love_return/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "Yes, let’s let it flow!"
msgstr "Oui, laissons couler !"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_love_return/0/c-0/15/c-0/7
msgctxt "Sinclaire"
msgid "Then flow it shall!"
msgstr "Alors ça coulera !"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_love_return/0/c-0/15/c-0/15
msgctxt "Narrator"
msgid "The hours pass by so quickly when you are with your lover Sinclaire the Sink."
msgstr "Les heures passent si vite quand vous êtes avec votre amant, Sinclaire l'Évier."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_love_return/0/c-2/7
msgctxt "Sinclaire"
msgid "You’ve read my mind…"
msgstr "Tu as lu dans mes pensées…"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_love_return/0/c-2/18
msgctxt "Narrator"
msgid "Things heat up between you and your lover Sinclaire, but always within responsible temperature limits."
msgstr "Les choses se réchauffent entre vous et votre amant Sinclaire, mais toujours dans des limites de température raisonnables."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_martin_love_return/0/0
msgctxt "Sinclaire"
msgid "My dearest. I love thee almost as much as the streets of my home."
msgstr "Mon cœur. Je t'aime presque autant que les rues de ma ville."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_martin_love_return/0/8
msgctxt "Sinclaire"
msgid "Didst thou come to make love?"
msgstr "Viens-tu céans pour faire l'amour ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_martin_love_return/0/16
msgctxt "Sinclaire"
msgid "Or to have a claim adjusted?"
msgstr "Ou pour faire régler un sinistre ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_martin_love_return/0/24
msgctxt "Sinclaire"
msgid "Or to ogle at my hideous form?"
msgstr "Ou pour te rincer l'œil devant ma hideuse forme ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_martin_love_return/0/32/s/0
msgctxt "Choix"
msgid "Martin, you're a wet, porcelain angel."
msgstr "Martin, tu es un ange de porcelaine tout mouillé."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_martin_love_return/0/33/s/0
msgctxt "Choix"
msgid "Oh, Sinky, I came to make love!"
msgstr "Oh, Sinky, je viens pour faire l'amour !"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_martin_love_return/0/c-0/7
msgctxt "Sinclaire"
msgid "Hopefully not for long."
msgstr "Pas trop longtemps, j'espère."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_martin_love_return/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "Exactly! I've come to Realize you!"
msgstr "Exactement ! Je viens te Réaliser !"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_martin_love_return/0/c-0/15/1/s/0
msgctxt "Choix"
msgid "Well, for a bit longer..."
msgstr "Enfin, un peu plus longtemps..."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_martin_love_return/0/c-0/15/c-1/7
msgctxt "Sinclaire"
msgid "Come see me any time."
msgstr "Viens me voir quand tu veux."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_martin_love_return/0/c-0/15/c-1/15
msgctxt "Sinclaire"
msgid "You do help the time flow by."
msgstr "Tu aides vraiment le temps à s'écouler."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_martin_love_return/0/c-0/15/c-1/23
msgctxt "Sinclaire"
msgid "Damn it. I mean 'go' by."
msgstr "Zut. Je voulais dire « passer »."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_martin_love_return/0/c-1/7
msgctxt "Sinclaire"
msgid "Sinky?"
msgstr "Sinky ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_martin_love_return/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "I meant Martin."
msgstr "Je voulais dire Martin."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_martin_love_return/0/c-1/15/1/s/0
msgctxt "Choix"
msgid "It's my new nickname for you."
msgstr "C'est mon nouveau surnom pour toi."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_martin_love_return/0/c-1/15/c-0/7
msgctxt "Sinclaire"
msgid "Ah, yes. I thought you did."
msgstr "Ah, oui. Je me disais bien."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_martin_love_return/0/c-1/15/c-1/7
msgctxt "Sinclaire"
msgid "How spicy!"
msgstr "Quel piquant !"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_martin_love_return/0/g-0/0
msgctxt "Sinclaire"
msgid "Let's get down to business!"
msgstr "Passons aux choses sérieuses !"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_martin_love_return/0/g-0/8/s/0
msgctxt "Choix"
msgid "Are you... gonna kiss me or something?"
msgstr "Tu... vas m'embrasser ou quelque chose ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_martin_love_return/0/g-0/9/s/0
msgctxt "Choix"
msgid "So... Lovemaking?"
msgstr "Alors... on fait l'amour ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_martin_love_return/0/g-1/0
msgctxt "Sinclaire"
msgid "Oh no, not lovemaking. Business! Let me adjust whatever claims you've brought me."
msgstr "Oh non, pas l'amour. Les affaires ! Laisse-moi régler les sinistres que tu m'as apportés."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_martin_love_return/0/g-1/11/s/0
msgctxt "Choix"
msgid "I'll... just go."
msgstr "Je vais... juste m'en aller."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_martin_love_return/0/g-1/12/s/0
msgctxt "Choix"
msgid "Right. Lovemaking next time maybe..."
msgstr "D'accord. Peut-être l'amour la prochaine fois..."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_love_realize_begin/0/12
msgctxt "Sinclaire"
msgid "Realize me?! Why... I never thought I would have that luxury!"
msgstr "Me Réaliser ?! Mais... je n'aurais jamais cru avoir ce luxe !"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_love_realize_begin/0/20
msgctxt "Sinclaire"
msgid "Have you washed away all that stands in the way of this?"
msgstr "As-tu rincé tout ce qui se dresse en travers du chemin ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_love_realize_begin/0/37/s/0
msgctxt "Choix"
msgid "I have! Let’s do it!"
msgstr "Oui ! Faisons-le !"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_love_realize_begin/0/38/s/0
msgctxt "Choix"
msgid "Actually… I need a little more time."
msgstr "En fait… il me faut encore un peu de temps."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_love_realize_begin/0/c-0/13
msgctxt "Sinclaire"
msgid "Well, lathe my hands and call me Martin!"
msgstr "Eh bien, savonne-moi les mains et appelle-moi Martin !"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_love_realize_begin/0/c-0/21
msgctxt "Sinclaire"
msgid "Well.. please don't. I've already been confused enough"
msgstr "Enfin... non, ne le fais pas. J'ai déjà été assez perturbé."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_love_realize_begin/0/c-1/10
msgctxt "Sinclaire"
msgid "Of course. Return when you’re ready. Sudsy and I will be here."
msgstr "Bien sûr. Reviens quand ce sera le moment. Sudsy et moi serons là."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_love_realize_return/0/0
msgctxt "Sinclaire"
msgid "Ah! Back again? Ready to show me my new form?"
msgstr "Ah ! Déjà de retour ? Le moment est-il venu de me montrer ma nouvelle forme ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_love_realize_return/0/17/s/0
msgctxt "Choix"
msgid "You bet!"
msgstr "Et comment !"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_love_realize_return/0/18/s/0 sinclaire_sink/sinclaire_martin_love_realize_begin/0/30/s/0 sinclaire_sink/sinclaire_martin_love_realize_return/0/18/s/0 sinclaire_sink/sinclaire_realize_join/0/48/s/0
msgctxt "Choix"
msgid "I don't think that will be enough..."
msgstr "Je ne pense pas que ça suffira..."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_love_realize_return/0/c-1/10
msgctxt "Sinclaire"
msgid "Not a problem, dear one. Come on back when ready."
msgstr "Pas de problème, mon trésor. Reviens quand tu veux."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_martin_love_realize_begin/0/12
msgctxt "Sinclaire"
msgid "My savior! Is it time?"
msgstr "Ma planche de salut ! Est-ce l'heure ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_martin_love_realize_begin/0/29/s/0
msgctxt "Choix"
msgid "It is! Everything is ready!"
msgstr "Oui ! Tout est prêt !"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_martin_love_realize_begin/0/c-1/10
msgctxt "Sinclaire"
msgid "Alas, I shall wait here, dreaming of claims left unadjusted."
msgstr "Hélas, je patienterai ici, rêvant de sinistres restés non réglés."

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_martin_love_realize_return/0/0
msgctxt "Sinclaire"
msgid "Are we ready? To bring me back to my true form?"
msgstr "Sommes-nous prêts ? À me rendre ma vraie forme ?"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_martin_love_realize_return/0/17/s/0
msgctxt "Choix"
msgid "Yes! We are!"
msgstr "Oui ! On l'est !"

# Traduction IA – à relire
#: sinclaire_sink/sinclaire_martin_love_realize_return/0/c-1/10
msgctxt "Sinclaire"
msgid "I shall endure until you have what is needed."
msgstr "J'endurerai jusqu'à ce que tu aies ce qu'il faut."

# Traduction IA – à relire
#: sinclaire_sink/Martin_Stays_Martin/0/3
msgctxt "Narrator"
msgid "Sinclaire lets out a triumphant laugh."
msgstr "Sinclaire laisse échapper un rire triomphant."

# Traduction IA – à relire
#: sinclaire_sink/Martin_Stays_Martin/0/11
msgctxt "Sinclaire"
msgid "Vindication! Sweet vindication!"
msgstr "Réhabilitation ! Douce réhabilitation !"

# Traduction IA – à relire
#: sinclaire_sink/Martin_Stays_Martin/0/22
msgctxt "Sinclaire"
msgid "All those naysayers have now been nay-said!"
msgstr "Tous ces rabat-joie ont maintenant été rabattus !"

# Traduction IA – à relire
#: sinclaire_sink/Martin_Stays_Martin/0/30
msgctxt "Sinclaire"
msgid "Take that, Maggie! I could smell the doubt on you!"
msgstr "Prends ça, Maggie ! Je sentais le doute sur toi !"

# Traduction IA – à relire
#: sinclaire_sink/Martin_Stays_Martin/0/41
msgctxt "Maggie"
msgid "I'm sorry, but I can't go along with this..."
msgstr "Je suis désolée, mais je ne peux pas cautionner ça..."

# Traduction IA – à relire
#: sinclaire_sink/Martin_Stays_Martin/0/52
msgctxt "Maggie"
msgid "I don't think this is where the evidence pointed us."
msgstr "Je ne crois pas que ce soit là que les preuves nous menaient."

# Traduction IA – à relire
#: sinclaire_sink/Martin_Stays_Martin/0/60/s/0
msgctxt "Choix"
msgid "But you told me I could make the decision!"
msgstr "Mais tu m'as dit que je pouvais décider !"

# Traduction IA – à relire
#: sinclaire_sink/Martin_Stays_Martin/0/61/s/0
msgctxt "Choix"
msgid "I think it's what's best for Martin."
msgstr "Je pense que c'est ce qu'il y a de mieux pour Martin."

# Traduction IA – à relire
#: sinclaire_sink/Martin_Stays_Martin/0/62/s/0
msgctxt "Choix"
msgid "It doesn't matter - just listen to that guy. He's in pain!"
msgstr "Peu importe, écoute-le. Il souffre !"

#: sinclaire_sink/Martin_Stays_Martin/0/63/s/0
msgctxt "Choix"
msgid "Who cares? This is just kind of a goofy thing, right?"
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/c-1/11
msgctxt "Sinclaire"
msgid "...thank you."
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/c-2/11
msgctxt "Sinclaire"
msgid "...finally, someone hears me."
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/c-3/7
msgctxt "Sinclaire"
msgid "I'm not... goofy."
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/0
msgctxt "Maggie"
msgid "Be that as it may, I can't consider this a closed case."
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/8
msgctxt "Maggie"
msgid "I'll be in my office..."
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/19
msgctxt "Sinclaire"
msgid "Thank you for believing in my utterly outrageous tale."
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/27
msgctxt "Sinclaire"
msgid "I feel like I've been seen for who I am."
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/35
msgctxt "Sinclaire"
msgid "And yet I find I am no closer to undoing my curse."
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/43
msgctxt "Sinclaire"
msgid "Does this mean I must remain a sink forever?"
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/51/s/0
msgctxt "Choix"
msgid "I'm afraid so, Martin."
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/52/s/0
msgctxt "Choix"
msgid "There's still hope. There's always hope."
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/53/s/0
msgctxt "Choix"
msgid "I mean... You could try being a turtle?"
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/54/s/0
msgctxt "Choix"
msgid "No... you can be my lover."
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/c-4/7 sinclaire_sink/Martin_Stays_Martin/0/g-0/c-5/15
msgctxt "Sinclaire"
msgid "I'm doomed to retain this cursed form, it seems."
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/c-4/15 sinclaire_sink/Martin_Stays_Martin/0/g-0/c-5/23
msgctxt "Sinclaire"
msgid "I do thank you for your efforts, however."
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/c-4/23 sinclaire_sink/Martin_Stays_Martin/0/g-0/c-5/31
msgctxt "Sinclaire"
msgid "I dub thee 'friend.'"
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/c-4/34 sinclaire_sink/Martin_Stays_Martin/0/g-0/c-5/42
msgctxt "Sinclaire"
msgid "Come by my office any time for a claims adjustment of your choosing."
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/c-5/7
msgctxt "Sinclaire"
msgid "If you couldn't save me, I don't think anyone can."
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/c-6/11
msgctxt "Sinclaire"
msgid "BRILLIANT IDEA!"
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/c-6/25
msgctxt "Sinclaire"
msgid "Ok, how do I look?"
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/c-6/33
msgctxt "Sinclaire"
msgid "Is it working?"
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/c-6/41/0/s/0
msgctxt "Choix"
msgid "Oh yeah. Totally."
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/c-6/41/1/s/0
msgctxt "Choix"
msgid "Turtle power, dude."
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/c-6/41/2/s/0
msgctxt "Choix"
msgid "I... have never loved you more."
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/c-6/41/c-0/7
msgctxt "Sinclaire"
msgid "I'm going to go and practice some martial arts."
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/c-6/41/c-1/7
msgctxt "Sinclaire"
msgid "I find I have an inexplicable craving for pizza..."
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/c-6/41/c-1/18
msgctxt "Sinclaire"
msgid "And he's off!"
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/c-6/41/c-2/7
msgctxt "Sinclaire"
msgid "The turtle loves you back."
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/c-6/41/c-2/18
msgctxt "Sinclaire"
msgid "And I..."
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/c-6/41/c-2/26
msgctxt "Sinclaire"
msgid "I am the turtle."
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/c-7/7
msgctxt "Sinclaire"
msgid "You never doubted me, and I have to confess that I have feelings for you."
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/c-7/15
msgctxt "Sinclaire"
msgid "I would be amenable to trying out life as your lover."
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/c-7/23
msgctxt "Sinclaire"
msgid "I happen to have a smokin' hot wife back home. Like... <w>SMOKIN.</w>"
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/c-7/31
msgctxt "Sinclaire"
msgid "I mean seriously, you really would be surprised at how hot she is."
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/c-7/39
msgctxt "Sinclaire"
msgid "But I digress. I'd be happy to add you to the list, dear one!"
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/c-7/47/0/s/0
msgctxt "Choix"
msgid "And the dateviators can turn you human!"
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/c-7/47/1/s/0
msgctxt "Choix"
msgid "Nothing would make me happier."
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/c-7/47/c-0/7
msgctxt "Sinclaire"
msgid "A... A human?! I need a moment to process this."
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/c-7/47/c-0/15
msgctxt "Sinclaire"
msgid "I have to get all my sinkly possessions together before I go!"
msgstr ""

#: sinclaire_sink/Martin_Stays_Martin/0/g-0/c-7/47/c-1/7
msgctxt "Sinclaire"
msgid "And that froth on Sudsy? That means he approves."
msgstr ""

#: sinclaire_sink/sinclaire_friend_solved_return/0/0
msgctxt "Sinclaire"
msgid "Well, hello there my friend! Allow me to shake your hands..."
msgstr ""

#: sinclaire_sink/sinclaire_friend_solved_return/0/11
msgctxt "Sudsy"
msgid "...ruf!"
msgstr ""

#: sinclaire_sink/sinclaire_friend_solved_return/0/22
msgctxt "Sinclaire"
msgid "Don't mind if he gives you a lick!"
msgstr ""

#: sinclaire_sink/sinclaire_friend_solved_return/0/33
msgctxt "Sinclaire"
msgid "He's very friendly."
msgstr ""

#: sinclaire_sink/sinclaire_friend_solved_return/0/41
msgctxt "Sinclaire"
msgid "And antiseptic!"
msgstr ""

#: sinclaire_sink/sinclaire_friend_solved_return/0/49/s/0
msgctxt "Choix"
msgid "Sudsy! Good boy!"
msgstr ""

#: sinclaire_sink/sinclaire_friend_solved_return/0/50/s/0
msgctxt "Choix"
msgid "Hi Sinclaire! Always so nice to see you!"
msgstr ""

#: sinclaire_sink/sinclaire_friend_solved_return/0/51/s/0
msgctxt "Choix"
msgid "Actually, Sinclaire. I have interesting news about what the dateviators can do..."
msgstr ""

#: sinclaire_sink/sinclaire_friend_solved_return/0/c-0/7
msgctxt "Sudsy"
msgid "rof! ... mmm bwuff!"
msgstr ""

#: sinclaire_sink/sinclaire_friend_solved_return/0/c-1/7
msgctxt "Sinclaire"
msgid "And you, my friend!"
msgstr ""

#: sinclaire_sink/sinclaire_friend_solved_return/0/c-2/7 sinclaire_sink/SinclaireNeverSolved/0/c-1/7
msgctxt "Sinclaire"
msgid "What's that?"
msgstr ""

#: sinclaire_sink/sinclaire_friend_solved_return/0/c-2/15/0/s/0 sinclaire_sink/SinclaireNeverSolved/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "They can turn you into a human, and we can get to the bottom of your story."
msgstr ""

#: sinclaire_sink/sinclaire_friend_solved_return/0/c-2/15/c-0/7 sinclaire_sink/SinclaireNeverSolved/0/c-1/15/c-0/7
msgctxt "Sinclaire"
msgid "Is it painful?"
msgstr ""

#: sinclaire_sink/sinclaire_friend_solved_return/0/c-2/15/c-0/15/0/s/0 sinclaire_sink/SinclaireNeverSolved/0/c-1/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "I don't think so."
msgstr ""

#: sinclaire_sink/sinclaire_friend_solved_return/0/c-2/15/c-0/15/c-0/7 sinclaire_sink/SinclaireNeverSolved/0/c-1/15/c-0/15/c-0/7
msgctxt "Sinclaire"
msgid "Darn."
msgstr ""

#: sinclaire_sink/sinclaire_friend_solved_return/0/c-2/15/c-0/15/c-0/15 sinclaire_sink/SinclaireNeverSolved/0/c-1/15/c-0/15/c-0/15
msgctxt "Sinclaire"
msgid "I'll do it anyway."
msgstr ""

#: sinclaire_sink/sinclaire_friend_solved_return/0/g-0/0/s/0
msgctxt "Choix"
msgid "Still feeling like yourself?"
msgstr ""

#: sinclaire_sink/sinclaire_friend_solved_return/0/g-0/c-3/7
msgctxt "Sinclaire"
msgid "Never better!"
msgstr ""

