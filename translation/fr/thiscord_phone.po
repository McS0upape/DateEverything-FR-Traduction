# Traduction IA – à relire
#. Morceau de phrase coupé par une variable (nom du joueur, nombre...).
#: thiscord_phone/tfh_1/0/4 thiscord_phone/tfh_2/0/4 thiscord_phone/tfh_3/0/4 thiscord_phone/tfh_4/0/4 thiscord_phone/tfh_5/0/4 thiscord_phone/tfh_6/0/4 thiscord_phone/tfh_7/0/4 thiscord_phone/tfh_8/0/4 thiscord_phone/tfh_9/0/4 thiscord_phone/tfh_10/0/4 thiscord_phone/tfh_11/0/4 thiscord_phone/tfh_12/0/4 thiscord_phone/tfh_13/0/4 thiscord_phone/tfh_14/0/4 thiscord_phone/tfh_15/0/4 thiscord_phone/tfh_16/0/4
msgctxt "Tag Appli"
msgid "8x8bc.0b"
msgstr "8x8bc.0b"

# Traduction IA – à relire
#. Morceau de phrase coupé par une variable (nom du joueur, nombre...).
#: thiscord_phone/tfh_1/0/6
msgctxt "tinfoilhat"
msgid "Hello,"
msgstr "Bonjour,"

# Traduction IA – à relire
#: thiscord_phone/tfh_1/0/16
msgctxt "tinfoilhat"
msgid "Okay. Here goes nothing..."
msgstr "Bon. Advienne que pourra..."

# Traduction IA – à relire
#: thiscord_phone/tfh_1/0/21/s/0
msgctxt "Choix"
msgid "I'm scared."
msgstr "J'ai peur."

# Traduction IA – à relire
#: thiscord_phone/tfh_1/0/22/s/0
msgctxt "Choix"
msgid "Who are you?"
msgstr "T'es qui ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_1/0/c-0/7
msgctxt "Player"
msgid "I'm scared."
msgstr "J'ai peur."

# Traduction IA – à relire
#: thiscord_phone/tfh_1/0/c-0/9
msgctxt "tinfoilhat"
msgid "No need to fear. Hi. I'm just an anonymous hacker sending you a package."
msgstr "Inutile d'avoir peur. Salut. Je suis juste un hacker anonyme qui t'envoie un colis."

# Traduction IA – à relire
#: thiscord_phone/tfh_1/0/c-1/7
msgctxt "Player"
msgid "Who are you?"
msgstr "T'es qui ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_1/0/c-1/9
msgctxt "tinfoilhat"
msgid "Well, that’s not important. Think of me as a friendly yet anonymous hacker."
msgstr "Eh bien, ce n'est pas important. Vois-moi comme un hacker sympathique, mais anonyme."

# Traduction IA – à relire
#: thiscord_phone/tfh_1/0/g-0/0
msgctxt "tinfoilhat"
msgid "Any second now you will receive a delivery via drone to your front door. Tell absolutely no one it is in your possession."
msgstr "D'une seconde à l'autre, tu vas recevoir une livraison par drone devant ta porte. Ne dis absolument à personne que tu l'as en ta possession."

# Traduction IA – à relire
#: thiscord_phone/tfh_1/0/g-0/5
msgctxt "tinfoilhat"
msgid "I will return with further instructions when the time is right."
msgstr "Je reviendrai avec d'autres instructions le moment venu."

# Traduction IA – à relire
#: thiscord_phone/tfh_1/0/g-0/10/s/0
msgctxt "Choix"
msgid "When’s that?"
msgstr "C'est quand, ça ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_1/0/g-0/11/s/0
msgctxt "Choix"
msgid "Cool, sounds fun!"
msgstr "Cool, ça a l'air marrant !"

# Traduction IA – à relire
#: thiscord_phone/tfh_1/0/g-0/12/s/0
msgctxt "Choix"
msgid "Boring."
msgstr "Ennuyeux."

# Traduction IA – à relire
#: thiscord_phone/tfh_1/0/g-0/c-2/7
msgctxt "Player"
msgid "When's that?"
msgstr "C'est quand, ça ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_1/0/g-0/c-2/9
msgctxt "tinfoilhat"
msgid "Uh, well. Not now."
msgstr "Euh, eh bien. Pas maintenant."

# Traduction IA – à relire
#: thiscord_phone/tfh_1/0/g-0/c-3/7
msgctxt "Player"
msgid "Cool, sounds fun!"
msgstr "Cool, ça a l'air marrant !"

# Traduction IA – à relire
#: thiscord_phone/tfh_1/0/g-0/c-3/9
msgctxt "tinfoilhat"
msgid "Perhaps."
msgstr "Peut-être."

# Traduction IA – à relire
#: thiscord_phone/tfh_1/0/g-0/c-4/7
msgctxt "Player"
msgid "Boring."
msgstr "Ennuyeux."

# Traduction IA – à relire
#: thiscord_phone/tfh_1/0/g-0/c-4/9
msgctxt "tinfoilhat"
msgid "I fear I may have made a mistake..."
msgstr "Je crains d'avoir commis une erreur..."

# Traduction IA – à relire
#: thiscord_phone/tfh_2/0/6
msgctxt "tinfoilhat"
msgid "Impressive news out of Valfest. Really too bad that particular partnership is about to hit a rough patch."
msgstr "Nouvelles impressionnantes en provenance du Valfest. Vraiment dommage que ce partenariat en particulier soit sur le point de traverser une mauvaise passe."

# Traduction IA – à relire
#: thiscord_phone/tfh_2/0/11
msgctxt "tinfoilhat"
msgid "But then David’s never been great at partnerships."
msgstr "Mais bon, David n'a jamais été doué pour les partenariats."

# Traduction IA – à relire
#: thiscord_phone/tfh_2/0/16/s/0
msgctxt "Choix"
msgid "Ok?"
msgstr "Ok ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_2/0/17/s/0
msgctxt "Choix"
msgid "Me neither."
msgstr "Moi non plus."

# Traduction IA – à relire
#: thiscord_phone/tfh_2/0/c-0/7
msgctxt "Player"
msgid "Ok?"
msgstr "Ok ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_2/0/c-1/7
msgctxt "Player"
msgid "Me neither."
msgstr "Moi non plus."

# Traduction IA – à relire
#: thiscord_phone/tfh_2/0/c-1/9
msgctxt "tinfoilhat"
msgid "Yeah, fascinating, but we're not talking about you right now."
msgstr "Oui, passionnant, mais on ne parle pas de toi, là."

# Traduction IA – à relire
#: thiscord_phone/tfh_2/0/g-0/0
msgctxt "tinfoilhat"
msgid "I see you’ve had the opportunity to test out the prototype."
msgstr "Je vois que tu as eu l'occasion de tester le prototype."

# Traduction IA – à relire
#: thiscord_phone/tfh_2/0/g-0/5/s/0
msgctxt "Choix"
msgid "Yeah, it's been going okay."
msgstr "Ouais, ça se passe plutôt bien."

# Traduction IA – à relire
#: thiscord_phone/tfh_2/0/g-0/6/s/0
msgctxt "Choix"
msgid "You can see me?"
msgstr "Tu peux me voir ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_2/0/g-0/c-2/13
msgctxt "Player"
msgid "Yeah, it's been going okay."
msgstr "Ouais, ça se passe plutôt bien."

# Traduction IA – à relire
#: thiscord_phone/tfh_2/0/g-0/c-3/7
msgctxt "Player"
msgid "You can see me?"
msgstr "Tu peux me voir ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_2/0/g-0/c-3/9
msgctxt "tinfoilhat"
msgid "I have remote access. Allows me to analyze the back-end system data."
msgstr "J'ai un accès à distance. Ça me permet d'analyser les données du système en back-end."

# Traduction IA – à relire
#: thiscord_phone/tfh_2/0/g-0/c-3/14
msgctxt "tinfoilhat"
msgid "What’d you think, that I’d just hand over absolute control of a device this powerful?"
msgstr "Tu croyais quoi, que j'allais te confier le contrôle absolu d'un appareil aussi puissant ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_2/0/g-0/c-3/19/0/s/0 thiscord_phone/tfh_14/0/g-1/20/s/0
msgctxt "Choix"
msgid "Makes sense."
msgstr "Logique."

# Traduction IA – à relire
#: thiscord_phone/tfh_2/0/g-0/c-3/19/1/s/0
msgctxt "Choix"
msgid "Whoa. Chill out."
msgstr "Wow. Du calme."

# Traduction IA – à relire
#: thiscord_phone/tfh_2/0/g-0/c-3/19/c-0/7 thiscord_phone/tfh_14/0/g-1/c-4/13
msgctxt "Player"
msgid "Makes sense."
msgstr "Logique."

# Traduction IA – à relire
#: thiscord_phone/tfh_2/0/g-0/c-3/19/c-1/13
msgctxt "Player"
msgid "Whoa. Chill out."
msgstr "Wow. Du calme."

# Traduction IA – à relire
#: thiscord_phone/tfh_2/0/g-0/c-3/19/c-1/15
msgctxt "tinfoilhat"
msgid "I’m sorry; that was rash."
msgstr "Pardon, c'était irréfléchi."

# Traduction IA – à relire
#: thiscord_phone/tfh_2/0/g-1/0
msgctxt "tinfoilhat"
msgid "I’m enormously grateful to you for concealing the prototype. And I’m sorry I dropped all this on you so unexpectedly."
msgstr "Je te suis immensément reconnaissant de cacher le prototype. Et je suis désolé de t'avoir mis tout ça sur les bras sans prévenir."

# Traduction IA – à relire
#: thiscord_phone/tfh_2/0/g-1/5
msgctxt "tinfoilhat"
msgid "I know protecting it is not a responsibility you asked for. Maybe not even a responsibility you want."
msgstr "Je sais que le protéger n'est pas une responsabilité que tu as demandée. Peut-être même pas une responsabilité que tu veux."

# Traduction IA – à relire
#: thiscord_phone/tfh_2/0/g-1/10
msgctxt "tinfoilhat"
msgid "But I had no other choice. Every other Valdivian employee’s allegiance was unknowable — except you."
msgstr "Mais je n'avais pas le choix. La loyauté de tous les autres employés de Valdivian était impossible à déterminer, sauf la tienne."

# Traduction IA – à relire
#: thiscord_phone/tfh_2/0/g-1/15/s/0
msgctxt "Choix"
msgid "You can count on me!"
msgstr "Tu peux compter sur moi !"

# Traduction IA – à relire
#: thiscord_phone/tfh_2/0/g-1/16/s/0
msgctxt "Choix"
msgid "Why me?"
msgstr "Pourquoi moi ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_2/0/g-1/c-4/7
msgctxt "Player"
msgid "You can count on me!"
msgstr "Tu peux compter sur moi !"

# Traduction IA – à relire
#: thiscord_phone/tfh_2/0/g-1/c-4/15
msgctxt "tinfoilhat"
msgid "I knew you were trustworthy."
msgstr "Je savais que tu étais digne de confiance."

# Traduction IA – à relire
#: thiscord_phone/tfh_2/0/g-1/c-4/20
msgctxt "tinfoilhat"
msgid "Your private HR record said as much."
msgstr "Ton dossier RH confidentiel le disait."

# Traduction IA – à relire
#: thiscord_phone/tfh_2/0/g-1/c-5/7
msgctxt "Player"
msgid "Why me?"
msgstr "Pourquoi moi ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_2/0/g-1/c-5/9
msgctxt "tinfoilhat"
msgid "Because you’re paid the least out of everyone."
msgstr "Parce que c'est toi qui as le plus petit salaire de toute l'entreprise."

# Traduction IA – à relire
#: thiscord_phone/tfh_2/0/g-1/c-5/14/0/s/0
msgctxt "Choix"
msgid "Wait seriously?"
msgstr "Attends, sérieux ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_2/0/g-1/c-5/14/c-0/7
msgctxt "Player"
msgid "Wait seriously?"
msgstr "Attends, sérieux ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_2/0/g-1/c-5/14/c-0/9
msgctxt "tinfoilhat"
msgid "I can’t get into that right now."
msgstr "Je ne peux pas entrer dans les détails pour l'instant."

# Traduction IA – à relire
#: thiscord_phone/tfh_2/0/g-2/0
msgctxt "tinfoilhat"
msgid "Anyway, it’s not safe to talk. I will return when the signal is secure."
msgstr "Bref, ce n'est pas sûr de parler. Je reviendrai quand le signal sera sécurisé."

# Traduction IA – à relire
#: thiscord_phone/tfh_3/0/6
msgctxt "tinfoilhat"
msgid "Based on how plastered David was in his last MostMail, he must’ve finally discovered the prototype is missing..."
msgstr "Vu l'état d'ivresse de David dans son dernier MostMail, il a dû enfin découvrir que le prototype avait disparu..."

# Traduction IA – à relire
#: thiscord_phone/tfh_3/0/11
msgctxt "tinfoilhat"
msgid "He’ll sober up soon though, and when he does he’ll stop at nothing to ensure its retrieval."
msgstr "Mais il va bientôt dessoûler, et à ce moment-là, il ne reculera devant rien pour le récupérer."

# Traduction IA – à relire
#: thiscord_phone/tfh_3/0/16
msgctxt "tinfoilhat"
msgid "If he fails, he’ll be at the mercy of some very powerful people. He’ll never allow that."
msgstr "S'il échoue, il sera à la merci de gens très puissants. Il ne le permettra jamais."

# Traduction IA – à relire
#: thiscord_phone/tfh_3/0/21/s/0
msgctxt "Choix"
msgid "How do you know all this?"
msgstr "Comment tu sais tout ça ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_3/0/22/s/0
msgctxt "Choix"
msgid "Do you trust me to do this? I'm just an average nobody..."
msgstr "Tu me fais confiance pour faire ça ? Je suis personne, juste quelqu'un de banal..."

# Traduction IA – à relire
#: thiscord_phone/tfh_3/0/c-0/7
msgctxt "Player"
msgid "How do you know all this?"
msgstr "Comment tu sais tout ça ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_3/0/c-1/7
msgctxt "Player"
msgid "Do you trust me to do this? I'm just an average nobody..."
msgstr "Tu me fais confiance pour faire ça ? Je suis personne, juste quelqu'un de banal..."

# Traduction IA – à relire
#: thiscord_phone/tfh_3/0/g-0/5
msgctxt "tinfoilhat"
msgid "I guess it’s imperative that we trust each other. And I’ve been asking you to trust me, without being fully transparent. I know all this because..."
msgstr "Je suppose qu'il est impératif qu'on se fasse confiance. Et je te demande de me faire confiance sans être totalement transparent. Je sais tout ça parce que..."

# Traduction IA – à relire
#: thiscord_phone/tfh_3/0/g-0/10
msgctxt "tinfoilhat"
msgid "I created the dateviators."
msgstr "C'est moi qui ai créé les Dateviators."

# Traduction IA – à relire
#: thiscord_phone/tfh_3/0/g-0/15/s/0
msgctxt "Choix"
msgid "That's awesome!"
msgstr "Trop génial !"

# Traduction IA – à relire
#: thiscord_phone/tfh_3/0/g-0/16/s/0
msgctxt "Choix"
msgid "Prove it."
msgstr "Prouve-le."

# Traduction IA – à relire
#: thiscord_phone/tfh_3/0/g-0/17/s/0
msgctxt "Choix"
msgid "Yeah I basically guessed that."
msgstr "Ouais, je m'en doutais un peu."

# Traduction IA – à relire
#: thiscord_phone/tfh_3/0/g-0/c-2/13
msgctxt "Player"
msgid "That's awesome!"
msgstr "Trop génial !"

# Traduction IA – à relire
#: thiscord_phone/tfh_3/0/g-0/c-2/15
msgctxt "tinfoilhat"
msgid "I'm glad you think so. We are obviously in alignment."
msgstr "Ravi que tu le penses. Nous sommes manifestement sur la même longueur d'onde."

# Traduction IA – à relire
#: thiscord_phone/tfh_3/0/g-0/c-3/7
msgctxt "Player"
msgid "Prove it."
msgstr "Prouve-le."

# Traduction IA – à relire
#: thiscord_phone/tfh_3/0/g-0/c-3/15
msgctxt "tinfoilhat"
msgid "There's no time for that."
msgstr "On n'a pas le temps pour ça."

# Traduction IA – à relire
#: thiscord_phone/tfh_3/0/g-0/c-4/7
msgctxt "Player"
msgid "Yeah I basically guessed that."
msgstr "Ouais, je m'en doutais un peu."

# Traduction IA – à relire
#: thiscord_phone/tfh_3/0/g-0/c-4/15
msgctxt "tinfoilhat"
msgid "Hm. Sure. Whatever."
msgstr "Hm. C'est ça. Si tu veux."

# Traduction IA – à relire
#: thiscord_phone/tfh_3/0/g-1/0
msgctxt "tinfoilhat"
msgid "Anyway, I can’t talk now."
msgstr "Bref, je ne peux pas parler maintenant."

# Traduction IA – à relire
#: thiscord_phone/tfh_3/0/g-1/5 thiscord_phone/tfh_15/0/g-1/5
msgctxt "tinfoilhat"
msgid "I’m stealing coffeeshop wifi and the barista finally noticed I’m only ordering tap water."
msgstr "Je vole le wifi d'un café et le barista a fini par remarquer que je ne commande que de l'eau du robinet."

# Traduction IA – à relire
#: thiscord_phone/tfh_3/0/g-1/10
msgctxt "tinfoilhat"
msgid "Remember: under no circumstance allow David to know you possess the prototype!"
msgstr "Souviens-toi : ne laisse en aucun cas David savoir que tu possèdes le prototype !"

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/6
msgctxt "tinfoilhat"
msgid "Unfortunate about Sandy in Corporate Events Planning. She was responsible for all the best casual Friday themes."
msgstr "Dommage pour Sandy, de la planification des événements d'entreprise. C'est elle qui trouvait les meilleurs thèmes pour les vendredis décontractés."

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/11
msgctxt "tinfoilhat"
msgid "Now that she’s gone, there’s finally nothing left of the 7 Pioneers."
msgstr "Maintenant qu'elle est partie, il ne reste enfin plus rien des 7 Pionniers."

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/16/s/0
msgctxt "Choix"
msgid "7 Pioneers?"
msgstr "7 Pionniers ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/17/s/0
msgctxt "Choix"
msgid "This isn't going to be more lore is it?"
msgstr "Ça va pas encore être du lore, si ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/c-0/13
msgctxt "Player"
msgid "7 Pioneers?"
msgstr "7 Pionniers ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/c-1/7
msgctxt "Player"
msgid "This isn't going to be more lore is it?"
msgstr "Ça va pas encore être du lore, si ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/c-1/15
msgctxt "tinfoilhat"
msgid "Lore? No, it's incredibly important and compelling background information that is <i>necessary</i> to understand the current situation."
msgstr "Du lore ? Non, ce sont des informations de contexte extrêmement importantes et passionnantes, <i>nécessaires</i> pour comprendre la situation actuelle."

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/g-0/0
msgctxt "tinfoilhat"
msgid "In the beginning there were seven of us. Working out of David’s dorm room. Stealing wifi from the neighbors and using cardboard boxes for chairs."
msgstr "Au début, on était sept. On travaillait dans la chambre d'étudiant de David. On volait le wifi des voisins et on utilisait des cartons comme chaises."

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/g-0/5
msgctxt "tinfoilhat"
msgid "We had no idea we were changing the world..."
msgstr "On n'avait aucune idée qu'on était en train de changer le monde..."

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/g-0/10
msgctxt "tinfoilhat"
msgid "We just wanted to design a more efficient paperclip."
msgstr "On voulait juste concevoir un trombone plus efficace."

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/g-0/15
msgctxt "tinfoilhat"
msgid "But then the money started flowing and money always changes people."
msgstr "Mais l'argent a commencé à couler à flots, et l'argent change toujours les gens."

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/g-0/20
msgctxt "tinfoilhat"
msgid "Didn’t take long for the 7 Pioneers to be whittled down to one."
msgstr "Il n'a pas fallu longtemps pour que les 7 Pionniers soient réduits à un seul."

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/g-0/25/s/0
msgctxt "Choix"
msgid "... David."
msgstr "... David."

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/g-0/26/s/0
msgctxt "Choix"
msgid "... you?"
msgstr "... toi ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/g-0/27/s/0
msgctxt "Choix"
msgid "Sneezy!"
msgstr "Atchoum !"

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/g-0/c-2/7
msgctxt "Player"
msgid "... David."
msgstr "... David."

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/g-0/c-2/9
msgctxt "tinfoilhat"
msgid "<i>Bingo.</i>"
msgstr "<i>Bingo.</i>"

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/g-0/c-3/7
msgctxt "Player"
msgid "... you?"
msgstr "... toi ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/g-0/c-3/9
msgctxt "tinfoilhat"
msgid "Not me."
msgstr "Pas moi."

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/g-0/c-3/14
msgctxt "tinfoilhat"
msgid "David. The CEO of Valdivian."
msgstr "David. Le PDG de Valdivian."

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/g-0/c-3/19
msgctxt "tinfoilhat"
msgid "Seems like you're not paying attention but I suppose it can't be helped."
msgstr "On dirait que tu ne fais pas attention, mais je suppose que c'est inévitable."

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/g-0/c-3/24
msgctxt "tinfoilhat"
msgid "I am mysterious and only message you sometimes."
msgstr "Je suis mystérieux et je ne t'écris que de temps en temps."

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/g-0/c-3/29/0/s/0 thiscord_phone/tfh_7/0/g-2/c-5/14/0/s/0
msgctxt "Choix"
msgid "Gotcha."
msgstr "Compris."

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/g-0/c-3/29/1/s/0
msgctxt "Choix"
msgid "I'm paying attention!"
msgstr "Je fais attention !"

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/g-0/c-3/29/2/s/0
msgctxt "Choix"
msgid "Fine, whatever."
msgstr "Ok, bref."

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/g-0/c-3/29/c-0/7 thiscord_phone/tfh_7/0/g-2/c-5/14/c-0/7
msgctxt "Player"
msgid "Gotcha."
msgstr "Compris."

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/g-0/c-3/29/c-0/9
msgctxt "tinfoilhat"
msgid "Indeed."
msgstr "En effet."

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/g-0/c-3/29/c-1/7
msgctxt "Player"
msgid "I'm paying attention!"
msgstr "Je fais attention !"

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/g-0/c-3/29/c-1/9
msgctxt "tinfoilhat"
msgid "So you say."
msgstr "C'est toi qui le dis."

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/g-0/c-3/29/c-2/7
msgctxt "Player"
msgid "Fine, whatever."
msgstr "Ok, bref."

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/g-0/c-4/7
msgctxt "Player"
msgid "Sneezy!"
msgstr "Atchoum !"

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/g-0/c-4/15
msgctxt "tinfoilhat"
msgid "I <i>really</i> need you take this seriously."
msgstr "J'ai <i>vraiment</i> besoin que tu prennes ça au sérieux."

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/g-1/0
msgctxt "tinfoilhat"
msgid "And all this? The wretched, soul-sucking, corporate monster that Valdivian became? The Pioneers never wanted that."
msgstr "Et tout ça ? Le monstre corporatiste, misérable et suceur d'âmes qu'est devenu Valdivian ? Les Pionniers n'ont jamais voulu ça."

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/g-1/5
msgctxt "tinfoilhat"
msgid "One-by-one they left, but I stayed."
msgstr "Ils sont partis un par un, mais moi, je suis resté."

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/g-1/10
msgctxt "tinfoilhat"
msgid "Deep down I really believed David — the old David — was still in there somewhere."
msgstr "Au fond de moi, je croyais vraiment que David, l'ancien David, était encore là quelque part."

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/g-1/15
msgctxt "tinfoilhat"
msgid "But when he wanted to use the Dateviators for military applications, I knew more drastic action was necessary. Quickly."
msgstr "Mais quand il a voulu utiliser les Dateviators à des fins militaires, j'ai compris qu'il fallait des mesures plus radicales. Et vite."

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/g-1/20/s/0
msgctxt "Choix"
msgid "So you stole them?"
msgstr "Donc tu les as volées ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/g-1/c-5/7
msgctxt "Player"
msgid "So you stole them?"
msgstr "Donc tu les as volées ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/g-2/0
msgctxt "tinfoilhat"
msgid "I’m sorry, but there’s no time."
msgstr "Désolé, mais on n'a pas le temps."

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/g-2/5
msgctxt "tinfoilhat"
msgid "I’m using the display phone at a wireless store and they closed 30 minutes ago."
msgstr "J'utilise le téléphone de démonstration d'une boutique de téléphonie et ils ont fermé il y a 30 minutes."

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/g-2/10
msgctxt "tinfoilhat"
msgid "The sales associate is giving me the stink eye."
msgstr "Le vendeur me regarde de travers."

# Traduction IA – à relire
#: thiscord_phone/tfh_4/0/g-2/15
msgctxt "tinfoilhat"
msgid "I’ll follow up when I can!"
msgstr "Je te recontacte dès que possible !"

# Traduction IA – à relire
#. Morceau de phrase coupé par une variable (nom du joueur, nombre...).
#: thiscord_phone/tfh_5/0/6
msgctxt "tinfoilhat"
msgid "I’m sorry for the abrupt intrusion"
msgstr "Désolé pour cette intrusion soudaine"

# Traduction IA – à relire
#. Morceau de phrase coupé par une variable (nom du joueur, nombre...).
#: thiscord_phone/tfh_5/0/11
msgctxt "Narration / joueur"
msgid ", but there’s an urgent topic I need to discuss with you immediately."
msgstr ", mais il y a un sujet urgent dont je dois te parler immédiatement."

# Traduction IA – à relire
#: thiscord_phone/tfh_5/0/16/b/1
msgctxt "tinfoilhat"
msgid "Assuming you're going to take my questions seriously. Your commitment to this mission so far has been... questionable."
msgstr "En supposant que tu prennes mes questions au sérieux. Ton implication dans cette mission jusqu'ici a été... discutable."

# Traduction IA – à relire
#: thiscord_phone/tfh_5/0/19
msgctxt "tinfoilhat"
msgid "Is everything alright with the dateviators? Are they operating efficiently?"
msgstr "Est-ce que tout va bien avec les Dateviators ? Est-ce qu'ils fonctionnent efficacement ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_5/0/24/s/0
msgctxt "Choix"
msgid "I think so. Why?"
msgstr "Je crois. Pourquoi ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_5/0/25/s/0
msgctxt "Choix"
msgid "No, they broke completely."
msgstr "Non, ils sont complètement cassés."

# Traduction IA – à relire
#: thiscord_phone/tfh_5/0/c-0/7
msgctxt "Player"
msgid "I think so. Why?"
msgstr "Je crois. Pourquoi ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_5/0/c-1/7
msgctxt "Player"
msgid "No, they broke completely."
msgstr "Non, ils sont complètement cassés."

# Traduction IA – à relire
#: thiscord_phone/tfh_5/0/c-1/9
msgctxt "tinfoilhat"
msgid "Completely? I don't believe that's correct."
msgstr "Complètement ? Je ne crois pas que ce soit exact."

# Traduction IA – à relire
#: thiscord_phone/tfh_5/0/c-1/14
msgctxt "tinfoilhat"
msgid "I'm not one to be trifled with."
msgstr "Je ne suis pas quelqu'un avec qui on plaisante."

# Traduction IA – à relire
#: thiscord_phone/tfh_5/0/g-0/0
msgctxt "tinfoilhat"
msgid "Well as you know, I’m able to remotely monitor their functionality, and I’ve been noticing some deeply troubling readings coming from the Quantum Catalyst Activator."
msgstr "Eh bien, comme tu le sais, je peux surveiller leur fonctionnement à distance, et j'ai remarqué des relevés profondément inquiétants en provenance de l'Activateur Catalytique Quantique."

# Traduction IA – à relire
#: thiscord_phone/tfh_5/0/g-0/5/s/0
msgctxt "Choix"
msgid "Nope the Quantum Catacomb Active-wear is all good."
msgstr "Nan, l'Activewear Catacombique Quantique va très bien."

# Traduction IA – à relire
#: thiscord_phone/tfh_5/0/g-0/6/s/0
msgctxt "Choix"
msgid "What’s that?"
msgstr "C'est quoi, ça ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_5/0/g-0/c-2/7
msgctxt "Player"
msgid "Nope the Quantum Catacomb Active-wear is all good."
msgstr "Nan, l'Activewear Catacombique Quantique va très bien."

# Traduction IA – à relire
#: thiscord_phone/tfh_5/0/g-0/c-2/15
msgctxt "tinfoilhat"
msgid "<i>Quantum Catalyst Activator.</i>"
msgstr "<i>Activateur Catalytique Quantique.</i>"

# Traduction IA – à relire
#: thiscord_phone/tfh_5/0/g-0/c-2/20
msgctxt "tinfoilhat"
msgid "And I haven't even told you what it is yet."
msgstr "Et je ne t'ai même pas encore dit ce que c'était."

# Traduction IA – à relire
#: thiscord_phone/tfh_5/0/g-0/c-3/13
msgctxt "Player"
msgid "What's that?"
msgstr "C'est quoi, ça ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_5/0/g-1/0
msgctxt "tinfoilhat"
msgid "It’s very sci-fi, but essentially the Quantum Catalyst Activator is the internal hardware that allows you to directly acknowledge a thing’s existence. And recently it’s started to emit metacognition readings unlike any I’ve ever seen before."
msgstr "C'est très science-fiction, mais en gros, l'Activateur Catalytique Quantique est le composant interne qui te permet de reconnaître directement l'existence d'une chose. Et récemment, il s'est mis à émettre des relevés de métacognition comme je n'en ai jamais vu."

# Traduction IA – à relire
#: thiscord_phone/tfh_5/0/g-1/5
msgctxt "tinfoilhat"
msgid "I’ll keep an eye on things over here, but please inform me if anything unusual happens."
msgstr "Je vais garder un œil sur tout ça de mon côté, mais préviens-moi s'il se passe quoi que ce soit d'inhabituel."

# Traduction IA – à relire
#: thiscord_phone/tfh_5/0/g-1/10
msgctxt "tinfoilhat"
msgid "Oh, and if they get too hot, throw them in the freezer immediately."
msgstr "Ah, et s'ils chauffent trop, mets-les immédiatement au congélateur."

# Traduction IA – à relire
#: thiscord_phone/tfh_5/0/g-1/15
msgctxt "tinfoilhat"
msgid "Your life depends on it."
msgstr "Ta vie en dépend."

# Traduction IA – à relire
#: thiscord_phone/tfh_5/0/g-1/20/s/0
msgctxt "Choix"
msgid "Wait why?"
msgstr "Attends, pourquoi ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_5/0/g-1/21/s/0
msgctxt "Choix"
msgid "Can I throw them in the fridge instead?"
msgstr "Je peux les mettre au frigo, plutôt ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_5/0/g-1/22/s/0
msgctxt "Choix"
msgid "Thanks for letting me know."
msgstr "Merci de me prévenir."

# Traduction IA – à relire
#: thiscord_phone/tfh_5/0/g-1/c-4/7
msgctxt "Player"
msgid "Wait why?"
msgstr "Attends, pourquoi ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_5/0/g-1/c-5/7
msgctxt "Player"
msgid "Can I throw them in the fridge instead?"
msgstr "Je peux les mettre au frigo, plutôt ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_5/0/g-1/c-5/15
msgctxt "tinfoilhat"
msgid "Are you <i>insane?</i>"
msgstr "Tu as <i>perdu la tête ?</i>"

# Traduction IA – à relire
#: thiscord_phone/tfh_5/0/g-1/c-6/7
msgctxt "Player"
msgid "Thanks for letting me know."
msgstr "Merci de me prévenir."

# Traduction IA – à relire
#: thiscord_phone/tfh_5/0/g-2/0
msgctxt "tinfoilhat"
msgid "Sorry it’s not safe to talk anymore."
msgstr "Désolé, ce n'est plus sûr de parler."

# Traduction IA – à relire
#: thiscord_phone/tfh_5/0/g-2/5
msgctxt "tinfoilhat"
msgid "I’m in a really sketchy neighborhood and this phone is super, duper expensive."
msgstr "Je suis dans un quartier vraiment craignos et ce téléphone coûte super, méga cher."

# Traduction IA – à relire
#: thiscord_phone/tfh_5/0/g-2/13
msgctxt "tinfoilhat"
msgid "But I’ll keep analyzing the data."
msgstr "Mais je vais continuer à analyser les données."

# Traduction IA – à relire
#. Morceau de phrase coupé par une variable (nom du joueur, nombre...).
#: thiscord_phone/tfh_6/0/11
msgctxt "Narration / joueur"
msgid "are you there? Please answer! Hurry!"
msgstr "tu es là ? Réponds, s'il te plaît ! Vite !"

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/16/s/0
msgctxt "Choix"
msgid "Yes, I'm here."
msgstr "Oui, je suis là."

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/17/s/0
msgctxt "Choix"
msgid "I don't work for you, dude."
msgstr "Je bosse pas pour toi, mec."

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/c-0/7
msgctxt "Player"
msgid "Yes, I'm here."
msgstr "Oui, je suis là."

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/c-1/7
msgctxt "Player"
msgid "I don't work for you, dude."
msgstr "Je bosse pas pour toi, mec."

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/c-1/15
msgctxt "tinfoilhat"
msgid "I understand that. But this can not wait."
msgstr "Je le sais bien. Mais ça ne peut pas attendre."

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-0/0
msgctxt "tinfoilhat"
msgid "There’s something we need to discuss. It’s of the utmost importance."
msgstr "Il faut qu'on parle de quelque chose. C'est de la plus haute importance."

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-0/5/b/1
msgctxt "tinfoilhat"
msgid "Besides, we both know you're just being a jerk with the toasters and whatever else, like you are with me."
msgstr "Et puis, on sait tous les deux que tu fais juste le con avec les grille-pain et tout le reste, comme avec moi."

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-0/8/s/0
msgctxt "Choix"
msgid "Go on!"
msgstr "Vas-y !"

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-0/9/s/0
msgctxt "Choix"
msgid "Only if it's the utmost."
msgstr "Seulement si c'est de la plus haute."

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-0/c-2/13
msgctxt "Player"
msgid "Go on!"
msgstr "Vas-y !"

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-0/c-3/7
msgctxt "Player"
msgid "Only if it's the utmost."
msgstr "Seulement si c'est de la plus haute."

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-1/0
msgctxt "tinfoilhat"
msgid "It’s the dateviators. As I mentioned, I’ve been closely monitoring the electromagnetic field anomalies emitting from the Quantum Catalyst Activator."
msgstr "Ce sont les Dateviators. Comme je te l'ai dit, je surveille de près les anomalies du champ électromagnétique émises par l'Activateur Catalytique Quantique."

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-1/5
msgctxt "tinfoilhat"
msgid "And I know this is going to sound completely insane, but it appears..."
msgstr "Et je sais que ça va paraître complètement fou, mais il semblerait que..."

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-1/10
msgctxt "tinfoilhat"
msgid "Well it seems..."
msgstr "Eh bien, on dirait que..."

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-1/15
msgctxt "tinfoilhat"
msgid "I can’t believe I’ve even typing this..."
msgstr "Je n'arrive pas à croire que je suis en train de taper ça..."

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-1/20/s/0
msgctxt "Choix"
msgid "Yes?"
msgstr "Oui ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-1/21/s/0
msgctxt "Choix"
msgid "Spit it out!"
msgstr "Accouche !"

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-1/c-4/7
msgctxt "Player"
msgid "Yes?"
msgstr "Oui ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-1/c-5/7
msgctxt "Player"
msgid "Spit it out!"
msgstr "Accouche !"

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-1/c-5/15
msgctxt "tinfoilhat"
msgid "I'm attempting to!"
msgstr "J'essaie !"

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-2/0
msgctxt "tinfoilhat"
msgid "Based on the data I’m looking at, you may actually be able to use the dateviators to..."
msgstr "D'après les données que j'ai sous les yeux, tu pourrais réellement utiliser les Dateviators pour..."

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-2/5
msgctxt "tinfoilhat"
msgid "Bring objects... <i>to life.</i>"
msgstr "Donner vie aux objets... <i>pour de vrai.</i>"

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-2/10/0/s/0
msgctxt "Choix"
msgid "Yeah I'm doing that now. It's hot."
msgstr "Ouais, c'est ce que je fais en ce moment. C'est sexy."

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-2/10/1/s/0
msgctxt "Choix"
msgid "Isn't that what I've been doing?"
msgstr "C'est pas ce que je fais depuis le début ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-2/10/c-6/7
msgctxt "Player"
msgid "Yeah I'm doing that now. It's hot."
msgstr "Ouais, c'est ce que je fais en ce moment. C'est sexy."

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-2/10/c-7/7
msgctxt "Player"
msgid "Isn't that what I've been doing?"
msgstr "C'est pas ce que je fais depuis le début ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-4/0
msgctxt "tinfoilhat"
msgid "No you’re not <i>listening.</i>"
msgstr "Non, tu n'<i>écoutes</i> pas."

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-4/5/b/1
msgctxt "tinfoilhat"
msgid "Which, annoyingly, is becoming kind of a pattern with you..."
msgstr "Ce qui, c'est agaçant, commence à devenir une habitude chez toi..."

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-4/8
msgctxt "tinfoilhat"
msgid "I don’t mean to engage with an object’s sentience during intended usage. That’s what the dateviators were created to do and they’ve been working perfectly."
msgstr "Je ne parle pas d'interagir avec la conscience d'un objet dans le cadre d'une utilisation normale. C'est pour ça que les Dateviators ont été créés, et ils fonctionnent parfaitement."

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-4/13
msgctxt "tinfoilhat"
msgid "I mean to — 100% literally — transform objects into living, breathing <i>humans.</i>"
msgstr "Je parle de transformer, à 100 % littéralement, des objets en <i>humains</i> vivants qui respirent."

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-4/18/s/0
msgctxt "Choix"
msgid "Whoa. That’s awesome!"
msgstr "Wow. Trop génial !"

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-4/19/s/0
msgctxt "Choix"
msgid "Sounds cool!"
msgstr "Ça a l'air cool !"

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-4/20/s/0
msgctxt "Choix"
msgid "This seems a little scary..."
msgstr "Ça fait un peu peur..."

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-4/21/s/0
msgctxt "Choix"
msgid "My goodness... tell me more."
msgstr "Mon Dieu... raconte-m'en plus."

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-4/c-8/7
msgctxt "Player"
msgid "Whoa. That's awesome!"
msgstr "Wow. Trop génial !"

# Traduction IA – à relire
#. Morceau de phrase coupé par une variable (nom du joueur, nombre...).
#: thiscord_phone/tfh_6/0/g-4/c-8/9 thiscord_phone/tfh_6/0/g-4/c-9/9 thiscord_phone/tfh_6/0/g-4/c-10/9
msgctxt "tinfoilhat"
msgid "Frankly"
msgstr "Franchement"

# Traduction IA – à relire
#. Morceau de phrase coupé par une variable (nom du joueur, nombre...).
#: thiscord_phone/tfh_6/0/g-4/c-8/14
msgctxt "Narration / joueur"
msgid ", we don’t know if it’s awesome."
msgstr ", on ne sait pas si c'est génial."

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-4/c-9/7
msgctxt "Player"
msgid "Sounds cool!"
msgstr "Ça a l'air cool !"

# Traduction IA – à relire
#. Morceau de phrase coupé par une variable (nom du joueur, nombre...).
#: thiscord_phone/tfh_6/0/g-4/c-9/14
msgctxt "Narration / joueur"
msgid ", we don’t know if it’s cool."
msgstr ", on ne sait pas si c'est cool."

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-4/c-10/7
msgctxt "Player"
msgid "This seems a little scary..."
msgstr "Ça fait un peu peur..."

# Traduction IA – à relire
#. Morceau de phrase coupé par une variable (nom du joueur, nombre...).
#: thiscord_phone/tfh_6/0/g-4/c-10/14
msgctxt "Narration / joueur"
msgid ", we don’t know if it’s scary."
msgstr ", on ne sait pas si ça doit faire peur."

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-4/c-11/7
msgctxt "Player"
msgid "My goodness... tell me more."
msgstr "Mon Dieu... raconte-m'en plus."

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-5/0
msgctxt "tinfoilhat"
msgid "We have absolutely no idea the ethical implications of turning objects into people."
msgstr "On n'a absolument aucune idée des implications éthiques de la transformation d'objets en personnes."

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-5/5
msgctxt "tinfoilhat"
msgid "Would they have rights? Do we need to feed them? And if so, how often would we need to feed them?"
msgstr "Auraient-ils des droits ? Faudrait-il les nourrir ? Et si oui, à quelle fréquence ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-5/10
msgctxt "tinfoilhat"
msgid "Is only lunch enough if it’s a big lunch?"
msgstr "Est-ce qu'un seul déjeuner suffit, si c'est un gros déjeuner ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-5/15
msgctxt "tinfoilhat"
msgid "We’re sleep-walking into a mine-field of existential dilemmas here."
msgstr "On s'avance en somnambules dans un champ de mines de dilemmes existentiels."

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-5/20/s/0
msgctxt "Choix"
msgid "Good point."
msgstr "Bien vu."

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-5/21/s/0
msgctxt "Choix"
msgid "I'm not that concerned."
msgstr "Ça m'inquiète pas plus que ça."

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-5/c-12/13
msgctxt "Player"
msgid "Good point."
msgstr "Bien vu."

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-5/c-13/13
msgctxt "Player"
msgid "I'm not that concerned."
msgstr "Ça m'inquiète pas plus que ça."

# Traduction IA – à relire
#. Morceau de phrase coupé par une variable (nom du joueur, nombre...).
#: thiscord_phone/tfh_6/0/g-5/c-13/15
msgctxt "tinfoilhat"
msgid "Well you should be"
msgstr "Eh bien, ça devrait,"

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-5/c-13/25
msgctxt "tinfoilhat"
msgid "Who's going to pay for all those big lunches? Not me, that's for sure."
msgstr "Qui va payer pour tous ces gros déjeuners ? Pas moi, c'est sûr."

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-6/0
msgctxt "tinfoilhat"
msgid "Not to mention I didn’t even program the dateviators with that functionality!"
msgstr "Sans compter que je n'ai même pas programmé cette fonctionnalité dans les Dateviators !"

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-6/5
msgctxt "tinfoilhat"
msgid "Maybe the government augmented my original schematics with secret military tech... but I’d have to do more tests to be sure."
msgstr "Peut-être que le gouvernement a enrichi mes schémas d'origine avec une technologie militaire secrète... mais il faudrait que je fasse d'autres tests pour en être sûr."

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-6/10/s/0
msgctxt "Choix"
msgid "What kind of tests?"
msgstr "Quel genre de tests ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-6/c-14/7
msgctxt "Player"
msgid "What kind of tests?"
msgstr "Quel genre de tests ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-7/0
msgctxt "tinfoilhat"
msgid "I’m sorry, but we’ll have to pick this up later."
msgstr "Désolé, mais on va devoir reprendre plus tard."

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-7/5
msgctxt "tinfoilhat"
msgid "I’m not under any sort of duress or anything, but I had a huge enchilada for lunch and I’m just exhausted."
msgstr "Je ne suis pas sous la contrainte ni rien, mais j'ai mangé une énorme enchilada à midi et je suis juste épuisé."

# Traduction IA – à relire
#: thiscord_phone/tfh_6/0/g-7/10
msgctxt "tinfoilhat"
msgid "I’ll reach out again when I’m able."
msgstr "Je te recontacterai dès que je pourrai."

# Traduction IA – à relire
#. Morceau de phrase coupé par une variable (nom du joueur, nombre...).
#: thiscord_phone/tfh_7/0/11
msgctxt "Narration / joueur"
msgid ", it’s me."
msgstr ", c'est moi."

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/16
msgctxt "tinfoilhat"
msgid "Were you followed? Is this signal encrypted?"
msgstr "Tu as été suivi{{|e|·e}} ? Ce signal est chiffré ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/21/s/0
msgctxt "Choix"
msgid "We're clear."
msgstr "La voie est libre."

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/22/s/0
msgctxt "Choix"
msgid "No idea."
msgstr "Aucune idée."

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/c-0/7
msgctxt "Player"
msgid "We're clear."
msgstr "La voie est libre."

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/c-1/7
msgctxt "Player"
msgid "No idea."
msgstr "Aucune idée."

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/c-1/15/b/1
msgctxt "tinfoilhat"
msgid "Why am I not surprised."
msgstr "Pourquoi ça ne m'étonne pas."

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/c-1/18
msgctxt "tinfoilhat"
msgid "It’ll have to do."
msgstr "Ça fera l'affaire."

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/g-0/0
msgctxt "tinfoilhat"
msgid "Listen, I’ve been giving more thought to our previous conversation. About the ethical implications of transforming inanimate objects into humans."
msgstr "Écoute, j'ai beaucoup repensé à notre dernière conversation. Aux implications éthiques de la transformation d'objets inanimés en humains."

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/g-0/5
msgctxt "tinfoilhat"
msgid "And I’ve come to a realization."
msgstr "Et j'ai eu une révélation."

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/g-0/10/s/0
msgctxt "Choix"
msgid "Ok"
msgstr "Ok"

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/g-0/c-2/7
msgctxt "Player"
msgid "Ok"
msgstr "Ok"

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/g-1/0
msgctxt "tinfoilhat"
msgid "It’s honestly not up to us whether an object should become human. It’s up to the object."
msgstr "Honnêtement, ce n'est pas à nous de décider si un objet doit devenir humain. C'est à l'objet."

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/g-1/5
msgctxt "tinfoilhat"
msgid "And if an object expresses desire for personhood, who are we to deny them?"
msgstr "Et si un objet exprime le désir de devenir une personne, qui sommes-nous pour le lui refuser ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/g-1/10/s/0
msgctxt "Choix"
msgid "Makes sense. I agree."
msgstr "Logique. Je suis d'accord."

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/g-1/11/s/0
msgctxt "Choix"
msgid "You sure about that?"
msgstr "T'es sûr de ça ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/g-1/c-3/13
msgctxt "Player"
msgid "Makes sense. I agree."
msgstr "Logique. Je suis d'accord."

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/g-1/c-4/7
msgctxt "Player"
msgid "You sure about that?"
msgstr "T'es sûr de ça ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/g-1/c-4/15
msgctxt "tinfoilhat"
msgid "Yep."
msgstr "Ouaip."

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/g-2/0
msgctxt "tinfoilhat"
msgid "I did discover one other interesting piece to all this."
msgstr "J'ai découvert un autre élément intéressant dans tout ça."

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/g-2/5/b/1
msgctxt "tinfoilhat"
msgid "At least <i>I</i> find the ability to transform inanimate objects into living humans interesting. Even if you're not super impressed."
msgstr "En tout cas, <i>moi</i>, je trouve intéressante la capacité de transformer des objets inanimés en humains vivants. Même si toi, ça ne t'impressionne pas plus que ça."

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/g-2/8
msgctxt "tinfoilhat"
msgid "After analyzing the data, it appears that certain objects can only become human if the Dateviator user possesses the necessary personality traits."
msgstr "Après analyse des données, il semble que certains objets ne puissent devenir humains que si l'utilisateur des Dateviators possède les traits de personnalité nécessaires."

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/g-2/13
msgctxt "tinfoilhat"
msgid "I’m not sure why... I theorize it’s because certain character attributes emit an energy vibration on the same resonant frequency as the molecules of a particular inanimate object."
msgstr "Je ne sais pas pourquoi... Ma théorie, c'est que certains traits de caractère émettent une vibration énergétique sur la même fréquence de résonance que les molécules d'un objet inanimé donné."

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/g-2/18
msgctxt "tinfoilhat"
msgid "But in all honesty it’s likely a mystery that science will never solve."
msgstr "Mais en toute honnêteté, c'est sans doute un mystère que la science ne résoudra jamais."

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/g-2/23/s/0
msgctxt "Choix"
msgid "Oh I have a theory!"
msgstr "Oh, j'ai une théorie !"

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/g-2/24/s/0
msgctxt "Choix"
msgid "Hm okay..."
msgstr "Hm, ok..."

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/g-2/25/s/0
msgctxt "Choix"
msgid "Guess we'll never know."
msgstr "On saura jamais, alors."

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/g-2/c-5/7
msgctxt "Player"
msgid "Oh I have a theory!"
msgstr "Oh, j'ai une théorie !"

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/g-2/c-5/9
msgctxt "tinfoilhat"
msgid "THAT SCIENCE WILL NEVER SOLVE."
msgstr "QUE LA SCIENCE NE RÉSOUDRA JAMAIS."

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/g-2/c-6/7
msgctxt "Player"
msgid "Hm okay..."
msgstr "Hm, ok..."

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/g-2/c-7/7
msgctxt "Player"
msgid "Guess we'll never know."
msgstr "On saura jamais, alors."

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/g-3/0
msgctxt "tinfoilhat"
msgid "Regardless, I was able to discover which personality traits seem to resonate with each inanimate object, and I’ve uploaded that data into the dateviators."
msgstr "Quoi qu'il en soit, j'ai réussi à découvrir quels traits de personnalité semblent entrer en résonance avec chaque objet inanimé, et j'ai téléversé ces données dans les Dateviators."

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/g-3/5
msgctxt "tinfoilhat"
msgid "I’ve labeled it \"Realization Recipes.\" You should be able to access those files now."
msgstr "Je les ai nommées « Recettes de Réalisation ». Tu devrais pouvoir accéder à ces fichiers maintenant."

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/g-3/10/s/0
msgctxt "Choix"
msgid "Why \"Realization Recipes\"?"
msgstr "Pourquoi « Recettes de Réalisation » ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/g-3/c-8/7
msgctxt "Player"
msgid "Why \"Realization Recipes\"?"
msgstr "Pourquoi « Recettes de Réalisation » ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/g-4/0
msgctxt "tinfoilhat"
msgid "I’m so sorry but there’s no time."
msgstr "Je suis vraiment désolé, mais on n'a pas le temps."

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/g-4/5
msgctxt "tinfoilhat"
msgid "Valdivian’s goons were closing in — so I was forced to flee to a country in South America to avoid detection — and my cell carrier’s overseas data plan is very limited."
msgstr "Les sbires de Valdivian se rapprochaient, alors j'ai dû fuir dans un pays d'Amérique du Sud pour ne pas être repéré, et le forfait data à l'étranger de mon opérateur est très limité."

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/g-4/10
msgctxt "tinfoilhat"
msgid "Seriously, 10MB a day?! I can barely send a gif; what a joke!"
msgstr "Sérieusement, 10 Mo par jour ?! J'arrive à peine à envoyer un gif, c'est une blague !"

# Traduction IA – à relire
#: thiscord_phone/tfh_7/0/g-4/18
msgctxt "tinfoilhat"
msgid "Remember: check the dateviators for the Realization Recipes!"
msgstr "Souviens-toi : consulte les Recettes de Réalisation dans les Dateviators !"

# Traduction IA – à relire
#: thiscord_phone/tfh_8/0/15
msgctxt "tinfoilhat"
msgid "David is obviously becoming desperate. And he doesn’t do well under pressure."
msgstr "David devient manifestement désespéré. Et il gère mal la pression."

# Traduction IA – à relire
#: thiscord_phone/tfh_8/0/20
msgctxt "tinfoilhat"
msgid "I’m worried his behavior will gradually become increasingly erratic, until he crosses a line he can’t come back from."
msgstr "J'ai peur que son comportement devienne de plus en plus imprévisible, jusqu'à ce qu'il franchisse une limite sans retour possible."

# Traduction IA – à relire
#: thiscord_phone/tfh_8/0/25/s/0
msgctxt "Choix"
msgid "That sounds bad?"
msgstr "Ça a l'air grave ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_8/0/c-0/7
msgctxt "Player"
msgid "That sounds bad?"
msgstr "Ça a l'air grave ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_8/0/g-0/0
msgctxt "tinfoilhat"
msgid "You have no idea."
msgstr "Tu n'as pas idée."

# Traduction IA – à relire
#: thiscord_phone/tfh_8/0/g-0/5/b/1 thiscord_phone/tfh_8/0/g-0/6/b/1 thiscord_phone/tfh_8/0/g-0/7/b/1
msgctxt "tinfoilhat"
msgid "Already it feels as if negative behavior has been permeating the whole company..."
msgstr "On a déjà l'impression qu'un comportement toxique se répand dans toute l'entreprise..."

# Traduction IA – à relire
#: thiscord_phone/tfh_8/0/g-0/6/b/6 thiscord_phone/tfh_8/0/g-0/7/b/6
msgctxt "tinfoilhat"
msgid "Undoubtedly because of that wretched Val 9000's switch in alignment to an incredibly rude yet highly profitable asset."
msgstr "Sans doute à cause de ce maudit Val 9000, qui s'est réaligné en un atout incroyablement grossier mais très rentable."

# Traduction IA – à relire
#: thiscord_phone/tfh_8/0/g-0/7/b/11
msgctxt "tinfoilhat"
msgid "And even our most stalwart employees have been reduced to living with their grandmothers."
msgstr "Et même nos employés les plus fidèles en sont réduits à vivre chez leur grand-mère."

# Traduction IA – à relire
#: thiscord_phone/tfh_8/0/g-0/10
msgctxt "tinfoilhat"
msgid "I should never have put you in this situation."
msgstr "Je n'aurais jamais dû te mettre dans cette situation."

# Traduction IA – à relire
#: thiscord_phone/tfh_8/0/g-0/15
msgctxt "tinfoilhat"
msgid "Naively I believed as Valdivian’s lowest paid employee you would be safe. But it’s become clear that as long as you possess the Dateviators you’ll be the target of David’s wrath."
msgstr "Naïvement, je croyais qu'avec le plus petit salaire de Valdivian, tu serais en sécurité. Mais il est clair que tant que tu possèdes les Dateviators, tu seras la cible de la colère de David."

# Traduction IA – à relire
#: thiscord_phone/tfh_8/0/g-0/20/b/1
msgctxt "tinfoilhat"
msgid "Based on your conduct maybe I shouldn't care, but dammit I still do."
msgstr "Vu ta conduite, je ne devrais peut-être pas m'en soucier, mais bon sang, je m'en soucie encore."

# Traduction IA – à relire
#: thiscord_phone/tfh_8/0/g-0/23
msgctxt "tinfoilhat"
msgid "Anyway, I have a solution."
msgstr "Bref, j'ai une solution."

# Traduction IA – à relire
#: thiscord_phone/tfh_8/0/g-0/28/s/0
msgctxt "Choix"
msgid "What?"
msgstr "Quoi ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_8/0/g-0/c-1/7
msgctxt "Player"
msgid "What?"
msgstr "Quoi ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_8/0/g-1/0
msgctxt "tinfoilhat"
msgid "Use the Realization Recipes to bring Skylar to life."
msgstr "Utilise les Recettes de Réalisation pour donner vie à Skylar."

# Traduction IA – à relire
#: thiscord_phone/tfh_8/0/g-1/5
msgctxt "tinfoilhat"
msgid "If Skylar becomes human, the dateviators will instantly cease to operate. And if the dateviators cease to operate, there will be absolutely no evidence implicating you in their theft."
msgstr "Si Skylar devient humaine, les Dateviators cesseront instantanément de fonctionner. Et s'ils cessent de fonctionner, il n'y aura absolument aucune preuve te reliant à leur vol."

# Traduction IA – à relire
#: thiscord_phone/tfh_8/0/g-1/10
msgctxt "tinfoilhat"
msgid "Realize Skylar and destroy the Dateviators before David unleashes his full fury upon you. He has access to resources you’d never believe."
msgstr "Réalise Skylar et détruis les Dateviators avant que David ne déchaîne toute sa fureur sur toi. Il a accès à des ressources que tu ne soupçonnes même pas."

# Traduction IA – à relire
#: thiscord_phone/tfh_8/0/g-1/15/s/0
msgctxt "Choix"
msgid "What kind of resources?"
msgstr "Quel genre de ressources ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_8/0/g-1/c-2/7
msgctxt "Player"
msgid "What kind of resources?"
msgstr "Quel genre de ressources ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_8/0/g-2/0
msgctxt "tinfoilhat"
msgid "I’m afraid there’s just no time to explain..."
msgstr "J'ai bien peur de ne pas avoir le temps de t'expliquer..."

# Traduction IA – à relire
#: thiscord_phone/tfh_8/0/g-2/5
msgctxt "tinfoilhat"
msgid "You see I forgot to charge my phone’s battery last night, and now I’m at 2%."
msgstr "Vois-tu, j'ai oublié de recharger mon téléphone hier soir, et là, je suis à 2 %."

# Traduction IA – à relire
#: thiscord_phone/tfh_8/0/g-2/10
msgctxt "tinfoilhat"
msgid "And I can’t charge it because I also forgot my charging cable. Can you believe that? <i>Ugh!</i>"
msgstr "Et je ne peux pas le recharger parce que j'ai aussi oublié mon câble. Tu te rends compte ? <i>Pff !</i>"

# Traduction IA – à relire
#: thiscord_phone/tfh_8/0/g-2/15
msgctxt "tinfoilhat"
msgid "But remember: Realize Skylar ASAP!"
msgstr "Mais souviens-toi : Réalise Skylar au plus vite !"

# Traduction IA – à relire
#: thiscord_phone/tfh_8_hate/0/0
msgctxt "tinfoilhat"
msgid "Oh. So you Realized something."
msgstr "Oh. Donc tu as Réalisé quelque chose."

# Traduction IA – à relire
#: thiscord_phone/tfh_8_hate/0/5
msgctxt "tinfoilhat"
msgid "Big whoop."
msgstr "La belle affaire."

# Traduction IA – à relire
#: thiscord_phone/tfh_8_hate/0/10/s/0
msgctxt "Choix"
msgid "Aren't you proud of me for changing my ways?"
msgstr "T'es pas fier de moi, d'avoir changé ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_8_hate/0/11/s/0
msgctxt "Choix"
msgid "Yeah, I only like one of these things here."
msgstr "Ouais, j'aime qu'un seul des trucs ici."

# Traduction IA – à relire
#: thiscord_phone/tfh_8_hate/0/c-0/7
msgctxt "Player"
msgid "Aren't you proud of me for changing my ways?"
msgstr "T'es pas fier de moi, d'avoir changé ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_8_hate/0/c-0/9
msgctxt "tinfoilhat"
msgid "No."
msgstr "Non."

# Traduction IA – à relire
#: thiscord_phone/tfh_8_hate/0/c-1/7
msgctxt "Player"
msgid "Yeah, I only like one of those things here."
msgstr "Ouais, j'aime qu'un seul des trucs ici."

# Traduction IA – à relire
#: thiscord_phone/tfh_8_hate/0/c-1/9
msgctxt "tinfoilhat"
msgid "And here I was hoping you would be the chosen one..."
msgstr "Et moi qui espérais que tu serais l'élu..."

# Traduction IA – à relire
#: thiscord_phone/tfh_8_hate/0/g-0/0
msgctxt "tinfoilhat"
msgid "My plan was that you would next Realize Skylar so that the dateviators would become useless... but."
msgstr "Mon plan, c'était que tu Réalises ensuite Skylar pour rendre les Dateviators inutilisables... mais bon."

# Traduction IA – à relire
#: thiscord_phone/tfh_8_hate/0/g-0/5
msgctxt "tinfoilhat"
msgid "At this point."
msgstr "À ce stade."

# Traduction IA – à relire
#: thiscord_phone/tfh_8_hate/0/g-0/10
msgctxt "tinfoilhat"
msgid "You do you."
msgstr "Fais comme tu le sens."

# Traduction IA – à relire
#: thiscord_phone/tfh_8_hate/0/g-0/15 thiscord_phone/tfh_hate/0/g-2/22
msgctxt "tinfoilhat"
msgid "Goodbye."
msgstr "Adieu."

# Traduction IA – à relire
#. Morceau de phrase coupé par une variable (nom du joueur, nombre...).
#: thiscord_phone/tfh_9/0/24
msgctxt "Narration / joueur"
msgid "! It’s me: tinfoilhat. Are you there?"
msgstr "! C'est moi : tinfoilhat. Tu es là ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/29/s/0
msgctxt "Choix"
msgid "Yes!"
msgstr "Oui !"

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/30/s/0
msgctxt "Choix"
msgid "Where else am I gonna be?"
msgstr "Où tu veux que je sois ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/c-0/13
msgctxt "Player"
msgid "Yes"
msgstr "Oui"

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/c-1/13
msgctxt "Player"
msgid "Where else am I gonna be?"
msgstr "Où tu veux que je sois ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/c-1/15
msgctxt "tinfoilhat"
msgid "Well, good point."
msgstr "Eh bien, bien vu."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/c-1/20/b/1
msgctxt "tinfoilhat"
msgid "You really should get out more once this is over. It might improve your social skills."
msgstr "Tu devrais vraiment sortir plus quand tout ça sera fini. Ça pourrait améliorer tes compétences sociales."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-0/0
msgctxt "tinfoilhat"
msgid "I’m still receiving data from the dateviators. Why haven’t you brought Skylar to life and destroyed them?"
msgstr "Je reçois toujours des données des Dateviators. Pourquoi tu n'as pas donné vie à Skylar et détruit les Dateviators ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-0/5
msgctxt "tinfoilhat"
msgid "I realize all the objects are flirty and <i>super</i> hot, but as long as the dateviators exist David will be hunting you."
msgstr "Je sais bien que tous les objets sont dragueurs et <i>super</i> sexy, mais tant que les Dateviators existeront, David te traquera."

# Traduction IA – à relire
#. Morceau de phrase coupé par une variable (nom du joueur, nombre...).
#: thiscord_phone/tfh_9/0/g-0/10
msgctxt "tinfoilhat"
msgid "And you don’t have a chance"
msgstr "Et tu n'as aucune chance,"

# Traduction IA – à relire
#. Morceau de phrase coupé par une variable (nom du joueur, nombre...).
#: thiscord_phone/tfh_9/0/g-0/15
msgctxt "Narration / joueur"
msgid "; he has a whole island just to practice hunting people."
msgstr "; il a une île entière rien que pour s'entraîner à chasser des humains."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-0/20
msgctxt "tinfoilhat"
msgid "\"There's Definitely No People Hunting Going on Here Island.\""
msgstr "« L'Île Où Il N'y A Absolument Aucune Chasse À L'Homme »."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-0/25
msgctxt "tinfoilhat"
msgid "He thinks he's so clever, but I'm onto him."
msgstr "Il se croit très malin, mais je l'ai démasqué."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-0/30/s/0
msgctxt "Choix"
msgid "I can’t Realize her."
msgstr "Je peux pas la Réaliser."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-0/31/s/0
msgctxt "Choix"
msgid "I didn't try to Realize her."
msgstr "J'ai pas essayé de la Réaliser."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-0/c-2/7
msgctxt "Player"
msgid "I can't Realize her."
msgstr "Je peux pas la Réaliser."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-0/c-2/9
msgctxt "tinfoilhat"
msgid "You can’t Realize her?"
msgstr "Tu ne peux pas la Réaliser ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-0/c-2/14
msgctxt "tinfoilhat"
msgid "... oh dear."
msgstr "... oh là là."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-0/c-2/19
msgctxt "tinfoilhat"
msgid "This must be... Unfurnished Business! Undoubtedly from too many reanimation gluons in the plasmonic nanogenerators."
msgstr "Ce doit être... des Affaires à démeubler ! Sans doute à cause d'un excès de gluons de réanimation dans les nanogénérateurs plasmoniques."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-0/c-2/24
msgctxt "tinfoilhat"
msgid "Oh, I was afraid of this."
msgstr "Oh, c'est ce que je craignais."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-0/c-2/29 thiscord_phone/tfh_9/0/g-0/c-3/63
msgctxt "tinfoilhat"
msgid "My calculations showed it was a possibility, but I didn’t realize it was unavoidable."
msgstr "Mes calculs montraient que c'était une possibilité, mais je ne pensais pas que c'était inévitable."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-0/c-2/34/0/s/0 thiscord_phone/tfh_9/0/g-0/c-3/68/0/s/0
msgctxt "Choix"
msgid "Sorry for the bad news."
msgstr "Désolé{{|e|·e}} pour la mauvaise nouvelle."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-0/c-2/34/1/s/0 thiscord_phone/tfh_9/0/g-0/c-3/68/1/s/0
msgctxt "Choix"
msgid "Can we talk more about reanimation gluons? Like what are those?"
msgstr "On peut parler un peu plus des gluons de réanimation ? Genre, c'est quoi ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-0/c-2/34/c-0/7 thiscord_phone/tfh_9/0/g-0/c-3/68/c-0/7
msgctxt "Player"
msgid "Sorry for the bad news."
msgstr "Désolé{{|e|·e}} pour la mauvaise nouvelle."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-0/c-2/34/c-1/7 thiscord_phone/tfh_9/0/g-0/c-3/68/c-1/7
msgctxt "Player"
msgid "Can we talk more about reanimation gluons? Like what are those?"
msgstr "On peut parler un peu plus des gluons de réanimation ? Genre, c'est quoi ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-0/c-2/34/c-1/9 thiscord_phone/tfh_9/0/g-0/c-3/68/c-1/9
msgctxt "tinfoilhat"
msgid "There'll be talk about reanimation gluons much later. I promise."
msgstr "On parlera des gluons de réanimation beaucoup plus tard. Promis."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-0/c-2/34/g-0/0 thiscord_phone/tfh_9/0/g-0/c-3/68/g-0/0
msgctxt "tinfoilhat"
msgid "Alright, change of plans."
msgstr "Bon, changement de plan."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-0/c-2/34/g-0/5
msgctxt "tinfoilhat"
msgid "If Unfurnished Business is inevitable, then you’ll need to bring every object to life before you can Realize Skylar and destroy the dateviators."
msgstr "Si les Affaires à démeubler sont inévitables, alors tu vas devoir donner vie à tous les objets avant de pouvoir Réaliser Skylar et détruire les Dateviators."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-0/c-2/34/g-0/10 thiscord_phone/tfh_9/0/g-0/c-3/68/g-0/10
msgctxt "tinfoilhat"
msgid "Any questions?"
msgstr "Des questions ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-0/c-3/7
msgctxt "Player"
msgid "I didn't try to Realize her."
msgstr "J'ai pas essayé de la Réaliser."

# Traduction IA – à relire
#. Morceau de phrase coupé par une variable (nom du joueur, nombre...).
#: thiscord_phone/tfh_9/0/g-0/c-3/14
msgctxt "Narration / joueur"
msgid "you <i>must!</i> You don't want to end up on that island!"
msgstr "tu <i>dois</i> le faire ! Tu ne veux pas finir sur cette île !"

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-0/c-3/19
msgctxt "tinfoilhat"
msgid "Sure the beaches are pristine, but it's not worth it. Believe me."
msgstr "Les plages sont immaculées, d'accord, mais ça n'en vaut pas la peine. Crois-moi."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-0/c-3/24
msgctxt "tinfoilhat"
msgid "Regardless, you couldn't have brought her to life anyway."
msgstr "De toute façon, tu n'aurais pas pu lui donner vie."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-0/c-3/29
msgctxt "tinfoilhat"
msgid "I might be leading you on in what I believe to be the right path, but even I can be wrong sometimes."
msgstr "Je te guide peut-être sur ce que je crois être la bonne voie, mais même moi, je peux me tromper parfois."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-0/c-3/34
msgctxt "tinfoilhat"
msgid "Unfortunately, I've found a stumbling block in our quest to realize Skylar."
msgstr "Malheureusement, j'ai trouvé un obstacle dans notre quête pour Réaliser Skylar."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-0/c-3/43
msgctxt "tinfoilhat"
msgid "You can’t Realize her just yet due to Unfurnished Business!"
msgstr "Tu ne peux pas encore la Réaliser à cause des Affaires à démeubler !"

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-0/c-3/48
msgctxt "tinfoilhat"
msgid "If an object needs to be around for one reason or another, they won't be able to be Realized."
msgstr "Si un objet doit rester là pour une raison ou une autre, il ne pourra pas être Réalisé."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-0/c-3/53
msgctxt "tinfoilhat"
msgid "You'll have to make sure they have finished their own needs in object-dom."
msgstr "Tu vas devoir t'assurer que chacun a réglé ses propres besoins dans sa vie d'objet."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-0/c-3/58
msgctxt "tinfoilhat"
msgid "Undoubtedly because of the reanimation gluons in the plasmonic nanogenerators."
msgstr "Sans doute à cause des gluons de réanimation dans les nanogénérateurs plasmoniques."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-0/c-3/68/g-0/5
msgctxt "tinfoilhat"
msgid "If Unfurnished Business is inevitable, then you’ll need to bring every object to life before you can Realize Skylar and destroy the Dateviators."
msgstr "Si les Affaires à démeubler sont inévitables, alors tu vas devoir donner vie à tous les objets avant de pouvoir Réaliser Skylar et détruire les Dateviators."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-1/0/s/0
msgctxt "Choix"
msgid "Just one."
msgstr "Juste une."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-1/1/s/0
msgctxt "Choix"
msgid "Like a hundred honestly..."
msgstr "Genre une centaine, honnêtement..."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-1/2/s/0
msgctxt "Choix"
msgid "Nope."
msgstr "Nan."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-1/c-4/13
msgctxt "Player"
msgid "Just one."
msgstr "Juste une."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-1/c-4/15 thiscord_phone/tfh_9/0/g-1/c-5/15
msgctxt "tinfoilhat"
msgid "I’m so sorry, it’ll have to wait..."
msgstr "Je suis vraiment désolé, ça va devoir attendre..."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-1/c-5/13
msgctxt "Player"
msgid "Like a hundred honestly..."
msgstr "Genre une centaine, honnêtement..."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-1/c-6/7
msgctxt "Player"
msgid "Nope."
msgstr "Nan."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-1/c-6/9
msgctxt "tinfoilhat"
msgid "Good. You shouldn't have a single question about any of this."
msgstr "Bien. Tu ne devrais pas avoir la moindre question sur tout ça."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-1/c-6/14
msgctxt "tinfoilhat"
msgid "Regardless..."
msgstr "Quoi qu'il en soit..."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-2/0
msgctxt "tinfoilhat"
msgid "I’m illegally piggybacking off of my neighbor Howard’s wifi and he just found out."
msgstr "Je squatte illégalement le wifi de mon voisin Howard et il vient de s'en rendre compte."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-2/5
msgctxt "tinfoilhat"
msgid "He’s only 11, but he’s got a black belt in taekwondo."
msgstr "Il n'a que 11 ans, mais il est ceinture noire de taekwondo."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-2/10
msgctxt "tinfoilhat"
msgid "And he’s a <i>real</i> big kid."
msgstr "Et c'est un <i>très</i> grand gamin."

# Traduction IA – à relire
#: thiscord_phone/tfh_9/0/g-2/15
msgctxt "tinfoilhat"
msgid "Realize all the objects so you can destroy the dateviators!"
msgstr "Réalise tous les objets pour pouvoir détruire les Dateviators !"

# Traduction IA – à relire
#: thiscord_phone/tfh_9_hate/0/0
msgctxt "tinfoilhat"
msgid "Honestly at this point I'm just confused."
msgstr "Honnêtement, à ce stade, je suis juste perplexe."

# Traduction IA – à relire
#: thiscord_phone/tfh_9_hate/0/5
msgctxt "tinfoilhat"
msgid "Like, why would you get everything to hate you so much?"
msgstr "Genre, pourquoi tu te ferais détester à ce point par tout le monde ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_9_hate/0/10
msgctxt "tinfoilhat"
msgid "But just have some of the objects become Realized humans?"
msgstr "Mais ensuite tu Réalises quand même quelques objets en humains ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_9_hate/0/15
msgctxt "tinfoilhat"
msgid "What's the goal here?"
msgstr "C'est quoi, le but ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_9_hate/0/20/s/0
msgctxt "Choix"
msgid "As I always say, I am Chaos Reborn."
msgstr "Comme je dis toujours, je suis le Chaos Réincarné."

# Traduction IA – à relire
#: thiscord_phone/tfh_9_hate/0/21/s/0
msgctxt "Choix"
msgid "I'm very selective in whom I choose to let into my little harem."
msgstr "Je suis très sélectif{{|ve|·ve}} sur qui je laisse entrer dans mon petit harem."

# Traduction IA – à relire
#: thiscord_phone/tfh_9_hate/0/22/s/0
msgctxt "Choix"
msgid "Don't care."
msgstr "M'en fiche."

# Traduction IA – à relire
#: thiscord_phone/tfh_9_hate/0/c-0/7
msgctxt "Player"
msgid "As I always say, I am Chaos Reborn."
msgstr "Comme je dis toujours, je suis le Chaos Réincarné."

# Traduction IA – à relire
#: thiscord_phone/tfh_9_hate/0/c-0/9
msgctxt "tinfoilhat"
msgid "Well, I believe it."
msgstr "Eh bien, je veux bien le croire."

# Traduction IA – à relire
#: thiscord_phone/tfh_9_hate/0/c-0/14
msgctxt "tinfoilhat"
msgid "Anyway. Do whatever. I'm done and I'm very very tired."
msgstr "Bref. Fais ce que tu veux. J'en ai fini et je suis très, très fatigué."

# Traduction IA – à relire
#: thiscord_phone/tfh_9_hate/0/c-1/7
msgctxt "tinfoilhat"
msgid "I guess most of us are like that in the long run."
msgstr "Je suppose que la plupart d'entre nous finissent comme ça, à la longue."

# Traduction IA – à relire
#: thiscord_phone/tfh_9_hate/0/c-1/12
msgctxt "tinfoilhat"
msgid "Well. Have fun."
msgstr "Bon. Amuse-toi bien."

# Traduction IA – à relire
#: thiscord_phone/tfh_9_hate/0/c-1/17
msgctxt "tinfoilhat"
msgid "We will never speak again."
msgstr "Nous ne nous reparlerons plus jamais."

# Traduction IA – à relire
#: thiscord_phone/tfh_9_hate/0/c-2/7
msgctxt "Player"
msgid "Don't care."
msgstr "M'en fiche."

# Traduction IA – à relire
#: thiscord_phone/tfh_9_hate/0/c-2/9
msgctxt "tinfoilhat"
msgid "Yeah. That tracks."
msgstr "Ouais. Ça colle."

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/6
msgctxt "tinfoilhat"
msgid "Noticed David is promising chocolates but delivering paranoid, controlling outbursts instead. Wouldn’t be the first time."
msgstr "J'ai remarqué que David promet des chocolats, mais livre plutôt des crises paranoïaques et autoritaires. Ce ne serait pas la première fois."

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/11
msgctxt "tinfoilhat"
msgid "And after the outburst, he’ll offer a tear-filled, heartfelt apology saying how he’s sorry — explaining how he won’t ever hurt you again."
msgstr "Et après la crise, il présentera des excuses sincères, en larmes, pour dire à quel point il est désolé, en expliquant qu'il ne te fera plus jamais de mal."

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/16
msgctxt "tinfoilhat"
msgid "But it’s just an act."
msgstr "Mais c'est juste du cinéma."

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/21
msgctxt "tinfoilhat"
msgid "A perpetual, never-ending roller-coaster of pain and heartbreak. A cycle that will never stop until you finally find the courage to slam the bedroom door and excise him from your life."
msgstr "Des montagnes russes perpétuelles et sans fin de douleur et de chagrin. Un cycle qui ne s'arrêtera jamais, jusqu'à ce que tu trouves enfin le courage de claquer la porte de la chambre et de l'arracher de ta vie."

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/26
msgctxt "tinfoilhat"
msgid "And yet somehow here I am... again... stuck in an endless, spellbinding dance with David Most..."
msgstr "Et pourtant, me voilà... encore... coincé dans une danse envoûtante et sans fin avec David Most..."

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/31/s/0
msgctxt "Choix"
msgid "So you guys were co-workers?"
msgstr "Donc vous étiez collègues ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/32/s/0
msgctxt "Choix"
msgid "Is there more to your relationship with David Most?"
msgstr "Il y a autre chose entre toi et David Most ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/33/s/0
msgctxt "Choix"
msgid "Why are you acting so weird, dude?"
msgstr "Pourquoi t'es si bizarre, mec ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/c-0/7
msgctxt "Player"
msgid "So you guys were co-workers?"
msgstr "Donc vous étiez collègues ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/c-1/7
msgctxt "Player"
msgid "Is there more to your relationship with David Most?"
msgstr "Il y a autre chose entre toi et David Most ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/c-2/7
msgctxt "Player"
msgid "Why are you acting so weird, dude?"
msgstr "Pourquoi t'es si bizarre, mec ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/g-0/0
msgctxt "tinfoilhat"
msgid "What are you insinuating?"
msgstr "Qu'est-ce que tu insinues ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/g-0/5/s/0
msgctxt "Choix"
msgid "Nothing!"
msgstr "Rien !"

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/g-0/6/s/0
msgctxt "Choix"
msgid "Oh I think you know what I'm insinuating."
msgstr "Oh, je crois que tu sais très bien ce que j'insinue."

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/g-0/c-3/13
msgctxt "Player"
msgid "Nothing!"
msgstr "Rien !"

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/g-0/c-3/15
msgctxt "tinfoilhat"
msgid "Good."
msgstr "Bien."

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/g-0/c-4/13
msgctxt "Player"
msgid "Oh I think you know what I'm insinuating."
msgstr "Oh, je crois que tu sais très bien ce que j'insinue."

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/g-0/c-4/15
msgctxt "tinfoilhat"
msgid "No, I don't think I do."
msgstr "Non, je ne crois pas."

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/g-1/0
msgctxt "tinfoilhat"
msgid "Because it’s like I explained..."
msgstr "Parce que c'est comme je te l'ai expliqué..."

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/g-1/5
msgctxt "tinfoilhat"
msgid "David and I founded Valdivian out of David’s dorm with five other partners."
msgstr "David et moi avons fondé Valdivian dans sa chambre d'étudiant avec cinq autres associés."

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/g-1/10
msgctxt "tinfoilhat"
msgid "And yes that dorm room was also my dorm room — and yes we were \"technically\" roommates — and yes there was only one bed. But that was only because we were a start-up and couldn’t afford two beds."
msgstr "Et oui, cette chambre était aussi ma chambre, et oui, on était « techniquement » colocataires, et oui, il n'y avait qu'un seul lit. Mais c'était uniquement parce qu'on était une start-up et qu'on n'avait pas les moyens de s'offrir deux lits."

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/g-1/15
msgctxt "tinfoilhat"
msgid "Do you know how <i>expensive</i> it is to design a more efficient paperclip? We had to cut corners wherever we could."
msgstr "Tu sais à quel point ça coûte <i>cher</i> de concevoir un trombone plus efficace ? On devait rogner sur tout."

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/g-1/20
msgctxt "tinfoilhat"
msgid "I survived off only ramen for six years!"
msgstr "J'ai survécu uniquement avec des ramens pendant six ans !"

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/g-1/25
msgctxt "tinfoilhat"
msgid "Do you know what malnutrition does to your bones?"
msgstr "Tu sais ce que la malnutrition fait à tes os ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/g-1/30/b/1
msgctxt "tinfoilhat"
msgid "Of course you don't! Couldn't care less about anything I say. You've made that very clear."
msgstr "Bien sûr que non ! Tu te fiches complètement de tout ce que je dis. Tu me l'as bien fait comprendre."

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/g-1/33/s/0
msgctxt "Choix"
msgid "Ok..."
msgstr "Ok..."

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/g-1/34/s/0
msgctxt "Choix"
msgid "That sounds awful. I'm really sorry."
msgstr "Ça a l'air horrible. Je suis vraiment {{désolé|désolée|désolé·e}}."

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/g-1/c-5/13
msgctxt "Player"
msgid "Ok..."
msgstr "Ok..."

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/g-1/c-5/15
msgctxt "tinfoilhat"
msgid "I really don’t like your tone."
msgstr "Je n'aime vraiment pas ton ton."

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/g-1/c-6/13
msgctxt "Player"
msgid "That sounds awful. I'm really sorry."
msgstr "Ça a l'air horrible. Je suis vraiment {{désolé|désolée|désolé·e}}."

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/g-1/c-6/15
msgctxt "tinfoilhat"
msgid "It's alright... You obviously couldn't have known about my various malnourished bones."
msgstr "Ce n'est rien... Tu ne pouvais évidemment pas être au courant pour mes divers os malnutris."

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/g-1/c-6/20
msgctxt "tinfoilhat"
msgid "But let's get one thing straight, ok?"
msgstr "Mais mettons une chose au clair, ok ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/g-2/0
msgctxt "tinfoilhat"
msgid "My relationship history with David is none of your business, and it has absolutely no bearing on our current goals regarding the Dateviators."
msgstr "Mon passé amoureux avec David ne te regarde pas, et il n'a absolument aucun rapport avec nos objectifs actuels concernant les Dateviators."

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/g-2/5
msgctxt "tinfoilhat"
msgid "If you’re curious about the backstory of Valdivian, you’re free to order the novelization \"Valdivian: An Empire Regurgitated.\""
msgstr "Si l'histoire de Valdivian t'intéresse, tu peux commander la novélisation « Valdivian : un empire régurgité »."

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/g-2/10
msgctxt "tinfoilhat"
msgid "But I’ll tell you the same thing I told the hacks who wrote that trash..."
msgstr "Mais je te dirai la même chose qu'aux plumitifs qui ont écrit cette daube..."

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/g-2/15
msgctxt "tinfoilhat"
msgid "\"There’s nothing to tell, and stop going through my garbage bins!\""
msgstr "« Il n'y a rien à raconter, et arrêtez de fouiller dans mes poubelles ! »"

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/g-2/20/s/0
msgctxt "Choix"
msgid "Sounds like a fun summer read!"
msgstr "Ça a l'air d'une chouette lecture d'été !"

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/g-2/21/s/0
msgctxt "Choix"
msgid "Uh."
msgstr "Euh."

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/g-2/22/s/0
msgctxt "Choix"
msgid "Honestly I'm not a big reader."
msgstr "Honnêtement, je suis pas un{{|e|·e}} grand{{|e|·e}} lecteur{{|ice|·ice}}."

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/g-2/c-7/13
msgctxt "Player"
msgid "Sounds like a fun summer read!"
msgstr "Ça a l'air d'une chouette lecture d'été !"

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/g-2/c-7/15
msgctxt "tinfoilhat"
msgid "To be fair it <i>does</i> have a light, breezy quality... even if it's woefully inaccurate."
msgstr "Pour être honnête, ça a <i>effectivement</i> un côté léger et rafraîchissant... même si c'est lamentablement inexact."

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/g-2/c-8/7
msgctxt "Player"
msgid "Uh."
msgstr "Euh."

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/g-2/c-9/7
msgctxt "Player"
msgid "Honestly I'm not a big reader."
msgstr "Honnêtement, je suis pas un{{|e|·e}} grand{{|e|·e}} lecteur{{|ice|·ice}}."

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/g-2/c-9/15
msgctxt "tinfoilhat"
msgid "Quelle surprise."
msgstr "Surprise, surprise."

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/g-3/0
msgctxt "tinfoilhat"
msgid "Now unfortunately I really have to go."
msgstr "Bon, malheureusement, je dois vraiment y aller."

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/g-3/5
msgctxt "tinfoilhat"
msgid "Apparently I accidentally hacked into Russia’s cyberdefenses, and I gotta clean that whole mess up before I cause another \"international incident.\""
msgstr "Apparemment, j'ai piraté par accident les cyberdéfenses de la Russie, et je dois nettoyer tout ce bazar avant de provoquer un nouvel « incident international »."

# Traduction IA – à relire
#: thiscord_phone/tfh_10/0/g-3/10
msgctxt "tinfoilhat"
msgid "The State Department only gives you two \"oopsies\"."
msgstr "Le Département d'État n'accorde que deux « oups »."

# Traduction IA – à relire
#: thiscord_phone/tfh_11/0/6
msgctxt "tinfoilhat"
msgid "I wanted to apologize for my previous outburst."
msgstr "Je voulais m'excuser pour mon emportement de la dernière fois."

# Traduction IA – à relire
#: thiscord_phone/tfh_11/0/11/b/1
msgctxt "tinfoilhat"
msgid "Even though, let's face it, you kind of deserved it."
msgstr "Même si, soyons honnêtes, tu l'avais un peu cherché."

# Traduction IA – à relire
#: thiscord_phone/tfh_11/0/14
msgctxt "tinfoilhat"
msgid "At the end of the day you were just asking questions, and my reaction was as defensive as it was inappropriate."
msgstr "Au bout du compte, tu ne faisais que poser des questions, et ma réaction était aussi défensive que déplacée."

# Traduction IA – à relire
#: thiscord_phone/tfh_11/0/19
msgctxt "tinfoilhat"
msgid "The truth is my relationship with David is complicated... and opening up those old wounds is difficult. Especially given what he’s done to the company... our company."
msgstr "La vérité, c'est que ma relation avec David est compliquée... et rouvrir ces vieilles blessures est difficile. Surtout vu ce qu'il a fait de l'entreprise... de notre entreprise."

# Traduction IA – à relire
#: thiscord_phone/tfh_11/0/24/s/0
msgctxt "Choix"
msgid "I understand."
msgstr "Je comprends."

# Traduction IA – à relire
#: thiscord_phone/tfh_11/0/25/s/0
msgctxt "Choix"
msgid "Tell me more!"
msgstr "Raconte-m'en plus !"

# Traduction IA – à relire
#: thiscord_phone/tfh_11/0/c-0/7
msgctxt "Player"
msgid "I understand."
msgstr "Je comprends."

# Traduction IA – à relire
#: thiscord_phone/tfh_11/0/c-0/9
msgctxt "tinfoilhat"
msgid "Do you?"
msgstr "Vraiment ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_11/0/c-1/7
msgctxt "Player"
msgid "Tell me more!"
msgstr "Raconte-m'en plus !"

# Traduction IA – à relire
#: thiscord_phone/tfh_11/0/g-0/0
msgctxt "tinfoilhat"
msgid "Have you ever been in love — dedicated your whole life to building something amazing with that person — only to lose them forever?"
msgstr "As-tu déjà été {{amoureux|amoureuse|amoureux·se}}, consacré toute ta vie à bâtir quelque chose d'extraordinaire avec cette personne, pour finalement la perdre à jamais ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_11/0/g-0/5
msgctxt "tinfoilhat"
msgid "For them to kick you out of the company you created and never speak to you again?"
msgstr "La voir te virer de l'entreprise que vous avez créée et ne plus jamais t'adresser la parole ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_11/0/g-0/10
msgctxt "tinfoilhat"
msgid "I don’t mean to be combative or disrespectful, but I don’t see how you could possibly understand."
msgstr "Je ne veux pas être agressif ni irrespectueux, mais je ne vois pas comment tu pourrais comprendre."

# Traduction IA – à relire
#: thiscord_phone/tfh_11/0/g-0/15
msgctxt "tinfoilhat"
msgid "What David and I had, and what I ultimately lost, shred my soul right down to the atoms. And I so <i>intensely</i> distrusted falling in love with another person again, that I went and invented goggles to flirt with inanimate objects instead."
msgstr "Ce que David et moi avions, et ce que j'ai fini par perdre, m'a déchiqueté l'âme jusqu'aux atomes. Et je me méfiais si <i>intensément</i> de l'idée de retomber amoureux de quelqu'un que je suis allé inventer des lunettes pour draguer des objets inanimés à la place."

# Traduction IA – à relire
#: thiscord_phone/tfh_11/0/g-0/20
msgctxt "tinfoilhat"
msgid "Do you really think you understand that kind of anguish?"
msgstr "Tu crois vraiment comprendre ce genre d'angoisse ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_11/0/g-0/25/s/0
msgctxt "Choix"
msgid "Yup, absolutely."
msgstr "Ouaip, carrément."

# Traduction IA – à relire
#: thiscord_phone/tfh_11/0/g-0/26/s/0
msgctxt "Choix"
msgid "Well..."
msgstr "Bah..."

# Traduction IA – à relire
#: thiscord_phone/tfh_11/0/g-0/27/s/0
msgctxt "Choix"
msgid "Is it like stubbing your toe really bad?"
msgstr "C'est comme se cogner l'orteil très fort ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_11/0/g-0/c-2/7
msgctxt "Player"
msgid "Yup, absolutely."
msgstr "Ouaip, carrément."

# Traduction IA – à relire
#. Morceau de phrase coupé par une variable (nom du joueur, nombre...).
#: thiscord_phone/tfh_11/0/g-0/c-2/15
msgctxt "tinfoilhat"
msgid "I really don't appreciate you mocking me,"
msgstr "Je n'apprécie vraiment pas que tu te moques de moi,"

# Traduction IA – à relire
#: thiscord_phone/tfh_11/0/g-0/c-2/25/0/s/0
msgctxt "Choix"
msgid "Fair"
msgstr "Pas faux"

# Traduction IA – à relire
#: thiscord_phone/tfh_11/0/g-0/c-2/25/1/s/0
msgctxt "Choix"
msgid "Sorry, wasn't trying to mock!"
msgstr "Pardon, je voulais pas me moquer !"

# Traduction IA – à relire
#: thiscord_phone/tfh_11/0/g-0/c-2/25/c-0/7
msgctxt "Player"
msgid "Fair."
msgstr "Pas faux."

# Traduction IA – à relire
#: thiscord_phone/tfh_11/0/g-0/c-2/25/c-1/7
msgctxt "Player"
msgid "Sorry, wasn't trying to mock!"
msgstr "Pardon, je voulais pas me moquer !"

# Traduction IA – à relire
#: thiscord_phone/tfh_11/0/g-0/c-3/13
msgctxt "Player"
msgid "Well..."
msgstr "Bah..."

# Traduction IA – à relire
#: thiscord_phone/tfh_11/0/g-0/c-4/13
msgctxt "Player"
msgid "Is it like stubbing your toe really bad?"
msgstr "C'est comme se cogner l'orteil très fort ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_11/0/g-0/c-4/15
msgctxt "tinfoilhat"
msgid "Is that supposed to be a joke?"
msgstr "C'est censé être une blague ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_11/0/g-0/c-4/20/0/s/0
msgctxt "Choix"
msgid "Yup."
msgstr "Ouaip."

# Traduction IA – à relire
#: thiscord_phone/tfh_11/0/g-0/c-4/20/1/s/0
msgctxt "Choix"
msgid "Honestly I'm just trying to gauge the severity."
msgstr "Honnêtement, j'essaie juste d'évaluer la gravité."

# Traduction IA – à relire
#: thiscord_phone/tfh_11/0/g-0/c-4/20/c-0/7
msgctxt "Player"
msgid "Yup."
msgstr "Ouaip."

# Traduction IA – à relire
#: thiscord_phone/tfh_11/0/g-0/c-4/20/c-1/13
msgctxt "Player"
msgid "Honestly I'm just trying to gauge the severity."
msgstr "Honnêtement, j'essaie juste d'évaluer la gravité."

# Traduction IA – à relire
#: thiscord_phone/tfh_11/0/g-1/0
msgctxt "tinfoilhat"
msgid "Listen I don’t mean to cut you off, but I really have to go."
msgstr "Écoute, je ne veux pas te couper, mais je dois vraiment y aller."

# Traduction IA – à relire
#: thiscord_phone/tfh_11/0/g-1/5
msgctxt "tinfoilhat"
msgid "It seems I didn’t pay my internet bill this month and they’re cutting off my service."
msgstr "Il semblerait que je n'aie pas payé ma facture internet ce mois-ci et qu'ils coupent ma connexion."

# Traduction IA – à relire
#: thiscord_phone/tfh_11/0/g-1/10
msgctxt "tinfoilhat"
msgid "Please keep realizing the objects so the Dateviators can be destroyed as quickly as possible!"
msgstr "Continue à Réaliser les objets, s'il te plaît, pour qu'on puisse détruire les Dateviators au plus vite !"

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/6
msgctxt "tinfoilhat"
msgid "Did you see that last email David sent? The one from Augusta, Missouri?"
msgstr "Tu as vu le dernier e-mail de David ? Celui envoyé d'Augusta, dans le Missouri ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/11/s/0
msgctxt "Choix"
msgid "Yes."
msgstr "Oui."

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/12/s/0
msgctxt "Choix"
msgid "I mostly just skim that stuff. Refresh my memory?"
msgstr "Je survole surtout ce genre de trucs. Tu me rafraîchis la mémoire ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/13/s/0
msgctxt "Choix"
msgid "Did he really say 'Skylar Specs'?"
msgstr "Il a vraiment dit « Skylar Specs » ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/c-0/13
msgctxt "Player"
msgid "Yes."
msgstr "Oui."

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/c-1/7
msgctxt "Player"
msgid "I mostly just skim that stuff. Refresh my memory?"
msgstr "Je survole surtout ce genre de trucs. Tu me rafraîchis la mémoire ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/c-2/7
msgctxt "Player"
msgid "Did he really say 'Skylar Specs'?"
msgstr "Il a vraiment dit « Skylar Specs » ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/c-2/9
msgctxt "tinfoilhat"
msgid "Yes, he obviously has tried the dateviators before in prototype but I doubt his relations with Skylar got very far."
msgstr "Oui, il a évidemment déjà essayé les Dateviators au stade du prototype, mais je doute que sa relation avec Skylar soit allée bien loin."

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/c-2/14
msgctxt "tinfoilhat"
msgid "I hope, at least."
msgstr "Je l'espère, en tout cas."

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/c-2/19/0/s/0
msgctxt "Choix"
msgid "I bet they would be a good match."
msgstr "Je parie qu'ils iraient bien ensemble."

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/c-2/19/1/s/0
msgctxt "Choix"
msgid "It creeped me out!"
msgstr "Ça m'a foutu les jetons !"

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/c-2/19/c-0/7
msgctxt "Player"
msgid "I bet they would be a good match."
msgstr "Je parie qu'ils iraient bien ensemble."

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/c-2/19/c-0/9
msgctxt "tinfoilhat"
msgid "I'm shuddering."
msgstr "J'en frissonne."

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/c-2/19/c-1/7
msgctxt "Player"
msgid "It creeped me out!"
msgstr "Ça m'a foutu les jetons !"

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/c-2/19/c-1/9
msgctxt "tinfoilhat"
msgid "Indeed..."
msgstr "En effet..."

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/c-2/19/g-0/0
msgctxt "tinfoilhat"
msgid "But about that email..."
msgstr "Mais à propos de cet e-mail..."

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/g-0/0
msgctxt "tinfoilhat"
msgid "It was very peculiar. I honestly don’t know what to make of it."
msgstr "Il était très étrange. Honnêtement, je ne sais pas quoi en penser."

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/g-0/5
msgctxt "tinfoilhat"
msgid "On one hand it was drenched in self-pity, which is very David. <i>Especially</i> when he’s been drinking."
msgstr "D'un côté, il dégoulinait d'apitoiement, ce qui est très David. <i>Surtout</i> quand il a bu."

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/g-0/10
msgctxt "tinfoilhat"
msgid "But on the other hand he honestly seemed... remorseful? Coming from him that’s novel."
msgstr "Mais d'un autre côté, il avait vraiment l'air... plein de remords ? Venant de lui, c'est nouveau."

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/g-0/15
msgctxt "tinfoilhat"
msgid "Especially to display his faults and regrets so publicly. That’s not reflective of the David I’ve come to know."
msgstr "Surtout d'étaler ses fautes et ses regrets aussi publiquement. Ça ne ressemble pas au David que j'ai appris à connaître."

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/g-0/20
msgctxt "tinfoilhat"
msgid "That was... different. Refreshing."
msgstr "C'était... différent. Rafraîchissant."

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/g-0/25
msgctxt "tinfoilhat"
msgid "And did you see how he even acknowledged I was right about everything?"
msgstr "Et tu as vu comment il a même reconnu que j'avais raison sur tout ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/g-0/30/s/0
msgctxt "Choix"
msgid "I did!"
msgstr "Ouais !"

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/g-0/31/s/0
msgctxt "Choix"
msgid "About \"everything\"?"
msgstr "Sur « tout » ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/g-0/c-3/13
msgctxt "Player"
msgid "I did!"
msgstr "Ouais !"

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/g-0/c-4/13
msgctxt "Player"
msgid "About \"everything\"?"
msgstr "Sur « tout » ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/g-0/c-4/15
msgctxt "tinfoilhat"
msgid "Let me have this."
msgstr "Laisse-moi savourer ça."

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/g-1/0
msgctxt "tinfoilhat"
msgid "He even acknowledged that"
msgstr "Il a même reconnu que"

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/g-1/5
msgctxt "tinfoilhat"
msgid "... he missed me. Curious."
msgstr "... je lui manquais. Curieux."

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/g-1/10/b/1
msgctxt "tinfoilhat"
msgid "This coming from the man who allowed Val 9000 to become a paragon of rudeness."
msgstr "Venant de l'homme qui a laissé Val 9000 devenir un parangon de grossièreté."

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/g-1/13
msgctxt "tinfoilhat"
msgid "You can spend years in proximity to someone — cataloging and analyzing every infinitesimal data-point of their personality — and still never know them in totality."
msgstr "Tu peux passer des années aux côtés de quelqu'un, à cataloguer et analyser chaque infime donnée de sa personnalité, et pourtant ne jamais le connaître dans sa totalité."

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/g-1/18
msgctxt "tinfoilhat"
msgid "Makes you wonder if perhaps you’ve misjudged them."
msgstr "Ça fait se demander si on ne l'a pas mal jugé."

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/g-1/23
msgctxt "tinfoilhat"
msgid "Well at the very least I’ll need to totally reprogram the David Most AI replicant I’ve been tinkering with in my basement."
msgstr "Enfin, au minimum, je vais devoir reprogrammer entièrement le réplicant IA de David Most que je bricole dans mon sous-sol."

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/g-1/28/s/0
msgctxt "Choix"
msgid "The what?"
msgstr "Le quoi ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/g-1/29/s/0
msgctxt "Choix"
msgid "If I ask, I know you're just going to say you have to go so what's the point."
msgstr "Si je demande, je sais que tu vas juste dire que tu dois y aller, alors à quoi bon."

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/g-1/c-5/7
msgctxt "Player"
msgid "The what?"
msgstr "Le quoi ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/g-1/c-6/13
msgctxt "Player"
msgid "If I ask, I know you're just going to say you have to go so what's the point."
msgstr "Si je demande, je sais que tu vas juste dire que tu dois y aller, alors à quoi bon."

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/g-1/c-6/15
msgctxt "tinfoilhat"
msgid "What? That's not true at all!"
msgstr "Quoi ? C'est complètement faux !"

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/g-1/c-6/20
msgctxt "tinfoilhat"
msgid "Ask me about the AI replicant. Go ahead!"
msgstr "Pose-moi des questions sur le réplicant IA. Vas-y !"

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/g-1/c-6/25/0/s/0
msgctxt "Choix"
msgid "What's the deal with the AI replicant?"
msgstr "C'est quoi, cette histoire de réplicant IA ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/g-1/c-6/25/c-0/7
msgctxt "Player"
msgid "What's the deal with the AI replicant?"
msgstr "C'est quoi, cette histoire de réplicant IA ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/g-2/0
msgctxt "tinfoilhat"
msgid "I’m so sorry, I really can’t say anymore."
msgstr "Je suis vraiment désolé, je ne peux pas en dire plus."

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/g-2/5
msgctxt "tinfoilhat"
msgid "I’ve been messaging you from under David’s desk at Valdivian and he’ll be back from the bathroom at any moment."
msgstr "Je t'écris de sous le bureau de David, chez Valdivian, et il va revenir des toilettes d'une seconde à l'autre."

# Traduction IA – à relire
#: thiscord_phone/tfh_12/0/g-2/10
msgctxt "tinfoilhat"
msgid "He really needs to change the locks on this place."
msgstr "Il faudrait vraiment qu'il change les serrures ici."

# Traduction IA – à relire
#: thiscord_phone/tfh_13/0/6 thiscord_phone/tfh_16/0/6
msgctxt "tinfoilhat"
msgid "I can’t believe it..."
msgstr "Je n'arrive pas à y croire..."

# Traduction IA – à relire
#: thiscord_phone/tfh_13/0/11
msgctxt "tinfoilhat"
msgid "Invasive personal questions? Privacy-eroding surveillance? <i>Fluid sample collecting?</i>"
msgstr "Des questions personnelles intrusives ? Une surveillance qui bafoue la vie privée ? <i>Des prélèvements de fluides ?</i>"

# Traduction IA – à relire
#: thiscord_phone/tfh_13/0/16
msgctxt "tinfoilhat"
msgid "This is the most inappropriate, unethical, intrusive corporate malfeasance I’ve ever seen! And I spent six months at our competitor, Diabolicorp!"
msgstr "C'est la malversation d'entreprise la plus déplacée, la plus contraire à l'éthique et la plus intrusive que j'aie jamais vue ! Et j'ai passé six mois chez notre concurrent, Diabolicorp !"

# Traduction IA – à relire
#: thiscord_phone/tfh_13/0/21/b/1
msgctxt "tinfoilhat"
msgid "It must be all this hatred that's been going around recently. It's so thick in the air I can feel it."
msgstr "Ça doit être toute cette haine qui circule ces derniers temps. L'air en est tellement chargé que je la sens."

# Traduction IA – à relire
#: thiscord_phone/tfh_13/0/24
msgctxt "tinfoilhat"
msgid "I realize David’s under duress, but he’s finally gone too far."
msgstr "Je sais que David est sous pression, mais cette fois, il est allé trop loin."

# Traduction IA – à relire
#: thiscord_phone/tfh_13/0/29/s/0
msgctxt "Choix"
msgid "Agreed."
msgstr "D'accord."

# Traduction IA – à relire
#: thiscord_phone/tfh_13/0/30/s/0
msgctxt "Choix"
msgid "Wait collecting fluid samples is bad?"
msgstr "Attends, prélever des fluides, c'est mal ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_13/0/c-0/13
msgctxt "Player"
msgid "Agreed."
msgstr "D'accord."

# Traduction IA – à relire
#: thiscord_phone/tfh_13/0/c-1/13
msgctxt "Player"
msgid "Wait collecting fluid samples is bad?"
msgstr "Attends, prélever des fluides, c'est mal ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_13/0/c-1/15
msgctxt "tinfoilhat"
msgid "In this circumstance? Absolutely."
msgstr "Dans ce cas précis ? Absolument."

# Traduction IA – à relire
#: thiscord_phone/tfh_13/0/g-0/0
msgctxt "tinfoilhat"
msgid "And to think I almost fell for him again. That I almost believed his \"I miss Franklin,\" \"we were so deeply in love\" sob story. He hasn’t changed at all."
msgstr "Et dire que j'ai failli retomber dans ses bras. Que j'ai failli croire à son mélo « Franklin me manque », « on était si profondément amoureux ». Il n'a pas changé du tout."

# Traduction IA – à relire
#: thiscord_phone/tfh_13/0/g-0/5
msgctxt "tinfoilhat"
msgid "He’s the same selfish, controlling, narcissistic creep he’s always been..."
msgstr "C'est le même sale type égoïste, manipulateur et narcissique qu'il a toujours été..."

# Traduction IA – à relire
#: thiscord_phone/tfh_13/0/g-0/10/b/1
msgctxt "tinfoilhat"
msgid "You guys would probably get along fabulously."
msgstr "Vous vous entendriez sans doute à merveille, tous les deux."

# Traduction IA – à relire
#: thiscord_phone/tfh_13/0/g-0/13
msgctxt "tinfoilhat"
msgid "Well I’ve had enough!"
msgstr "Eh bien, j'en ai assez !"

# Traduction IA – à relire
#: thiscord_phone/tfh_13/0/g-0/18
msgctxt "tinfoilhat"
msgid "It’s one thing when his disturbing behavior is only directed at me, it’s another when it’s directed at thousands of innocent employees."
msgstr "C'est une chose quand son comportement inquiétant ne vise que moi, c'en est une autre quand il vise des milliers d'employés innocents."

# Traduction IA – à relire
#: thiscord_phone/tfh_13/0/g-0/23
msgctxt "tinfoilhat"
msgid "And he can parade around like he has absolute power at that company, but it’s my company too."
msgstr "Et il peut parader comme s'il avait les pleins pouvoirs dans cette entreprise, mais c'est aussi mon entreprise."

# Traduction IA – à relire
#: thiscord_phone/tfh_13/0/g-0/28
msgctxt "tinfoilhat"
msgid "I may have been canned, but I’m still a shareholder damnit!"
msgstr "J'ai peut-être été viré, mais je suis toujours actionnaire, bon sang !"

# Traduction IA – à relire
#: thiscord_phone/tfh_13/0/g-0/33/s/0
msgctxt "Choix"
msgid "Wait how’d you get shares?"
msgstr "Attends, comment t'as eu des actions ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_13/0/g-0/34/s/0
msgctxt "Choix"
msgid "How many shares do you have?"
msgstr "T'as combien d'actions ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_13/0/g-0/35/s/0
msgctxt "Choix"
msgid "If I Realize more objects, can I get shares?"
msgstr "Si je Réalise plus d'objets, je peux avoir des actions ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_13/0/g-0/c-2/7
msgctxt "Player"
msgid "Wait how'd you get shares?"
msgstr "Attends, comment t'as eu des actions ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_13/0/g-0/c-3/7
msgctxt "Player"
msgid "How many shares do you have?"
msgstr "T'as combien d'actions ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_13/0/g-0/c-4/7
msgctxt "Player"
msgid "If I Realize more objects, can I get shares?"
msgstr "Si je Réalise plus d'objets, je peux avoir des actions ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_13/0/g-1/0
msgctxt "tinfoilhat"
msgid "The time for talking is over; it’s time to take action!"
msgstr "Le temps des paroles est révolu, place à l'action !"

# Traduction IA – à relire
#: thiscord_phone/tfh_13/0/g-1/5
msgctxt "tinfoilhat"
msgid "I’m going to concoct a plan to depose David from his throne once and for all!"
msgstr "Je vais concocter un plan pour faire tomber David de son trône une bonne fois pour toutes !"

# Traduction IA – à relire
#: thiscord_phone/tfh_13/0/g-1/10
msgctxt "tinfoilhat"
msgid "Right after I get some fresh air."
msgstr "Juste après avoir pris un peu l'air."

# Traduction IA – à relire
#: thiscord_phone/tfh_13/0/g-1/15
msgctxt "tinfoilhat"
msgid "I’m operating from a hidden, underground bunker and I don’t think anyone’s aired it out in fifty years."
msgstr "J'opère depuis un bunker souterrain secret et je ne crois pas que quelqu'un l'ait aéré depuis cinquante ans."

# Traduction IA – à relire
#: thiscord_phone/tfh_13/0/g-1/20
msgctxt "tinfoilhat"
msgid "It’s not hygienic at all."
msgstr "Ce n'est pas du tout hygiénique."

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/6
msgctxt "tinfoilhat"
msgid "That last email from David was kind of pathetic, huh?"
msgstr "Ce dernier e-mail de David était un peu pathétique, hein ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/11/s/0 thiscord_phone/tfh_15/0/31/s/0
msgctxt "Choix"
msgid "Yeah."
msgstr "Ouais."

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/12/s/0
msgctxt "Choix"
msgid "You're really hard on the guy."
msgstr "T'es vraiment dur avec lui."

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/c-0/13 thiscord_phone/tfh_15/0/c-0/13
msgctxt "Player"
msgid "Yeah."
msgstr "Ouais."

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/c-1/13
msgctxt "Player"
msgid "You're really hard on the guy."
msgstr "T'es vraiment dur avec lui."

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/c-1/15
msgctxt "tinfoilhat"
msgid "It's true. And he deserves every bit of it."
msgstr "C'est vrai. Et il mérite chaque mot."

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/c-1/20
msgctxt "tinfoilhat"
msgid "But, as loathe as I am to admit it, you may have a point."
msgstr "Mais, même si ça me coûte de l'admettre, tu n'as peut-être pas tort."

# Traduction IA – à relire
#. Morceau de phrase coupé par une variable (nom du joueur, nombre...).
#: thiscord_phone/tfh_14/0/g-0/0
msgctxt "tinfoilhat"
msgid "You know"
msgstr "Tu sais"

# Traduction IA – à relire
#. Morceau de phrase coupé par une variable (nom du joueur, nombre...).
#: thiscord_phone/tfh_14/0/g-0/5
msgctxt "Narration / joueur"
msgid ", I’ve been doing a lot of thinking."
msgstr ", j'ai beaucoup réfléchi."

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/g-0/10
msgctxt "tinfoilhat"
msgid "Most of that thinking was in service of inventing a virus that would cripple Valdivian’s supply chain — causing the company to hemorrhage customers — and absolutely crater its stock value."
msgstr "La plupart de ces réflexions servaient à inventer un virus qui paralyserait la chaîne d'approvisionnement de Valdivian, ferait fuir ses clients en masse et ferait s'effondrer la valeur de ses actions."

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/g-0/15
msgctxt "tinfoilhat"
msgid "I named it, \"Norman: the Terror Worm.\""
msgstr "Je l'ai appelé « Norman, le Ver de la Terreur »."

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/g-0/20/s/0
msgctxt "Choix"
msgid "Love it."
msgstr "J'adore."

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/g-0/21/s/0
msgctxt "Choix"
msgid "Yikes."
msgstr "Aïe."

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/g-0/c-2/13
msgctxt "Player"
msgid "Love it."
msgstr "J'adore."

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/g-0/c-2/15
msgctxt "tinfoilhat"
msgid "It's catchy, right?"
msgstr "Ça claque, hein ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/g-0/c-2/20/0/s/0
msgctxt "Choix"
msgid "So catchy."
msgstr "Ça claque trop."

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/g-0/c-2/20/c-0/7
msgctxt "Player"
msgid "So catchy."
msgstr "Ça claque trop."

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/g-0/c-2/20/c-0/9
msgctxt "tinfoilhat"
msgid "Right? Like, <i>there's</i> some IP that clearly deserves its own spin-off franchise."
msgstr "Hein ? Genre, <i>ça</i>, c'est une licence qui mérite clairement sa propre franchise dérivée."

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/g-0/c-3/7
msgctxt "Player"
msgid "Yikes."
msgstr "Aïe."

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/g-0/c-3/15
msgctxt "tinfoilhat"
msgid "Listen, I really don't think you're in any position to pass judgement on anyone."
msgstr "Écoute, je ne crois vraiment pas que tu sois en position de juger qui que ce soit."

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/g-1/0
msgctxt "tinfoilhat"
msgid "But I’ve also been thinking about David. How behind all his bluster and ego, he’s just a scared little man caving under pressure no one could handle."
msgstr "Mais j'ai aussi pensé à David. À quel point, derrière ses fanfaronnades et son ego, ce n'est qu'un petit homme effrayé qui cède sous une pression que personne ne pourrait supporter."

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/g-1/5
msgctxt "tinfoilhat"
msgid "Haunted by all his failures, disappointments, and inadequacies."
msgstr "Hanté par tous ses échecs, ses déceptions et ses insuffisances."

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/g-1/10
msgctxt "tinfoilhat"
msgid "And, as frustrated as I am by his actions, I don’t want to hurt him. He was an important part of my life for many, many years."
msgstr "Et même si ses actes me frustrent, je ne veux pas lui faire de mal. Il a été une part importante de ma vie pendant de très nombreuses années."

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/g-1/15
msgctxt "tinfoilhat"
msgid "Honestly, I just want to help him stop causing others so much pain..."
msgstr "Honnêtement, je veux juste l'aider à arrêter de faire autant souffrir les autres..."

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/g-2/0
msgctxt "tinfoilhat"
msgid "Perhaps \"Norman: the Terror Worm.\" isn’t the answer."
msgstr "Peut-être que « Norman, le Ver de la Terreur » n'est pas la solution."

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/g-2/5
msgctxt "tinfoilhat"
msgid "Perhaps the real answer is a conversation we’ve both been putting off for far too long."
msgstr "Peut-être que la vraie solution, c'est une conversation que nous repoussons tous les deux depuis bien trop longtemps."

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/g-2/10/s/0
msgctxt "Choix"
msgid "I think so."
msgstr "Je crois, oui."

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/g-2/11/s/0
msgctxt "Choix"
msgid "I've got no idea."
msgstr "Aucune idée."

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/g-2/12/s/0
msgctxt "Choix"
msgid "No I'm absolutely sure the answer is \"Norman: the Terror Worm.\""
msgstr "Non, je suis absolument {{sûr|sûre|sûr·e}} que la solution, c'est « Norman, le Ver de la Terreur »."

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/g-2/c-5/13
msgctxt "Player"
msgid "I think so."
msgstr "Je crois, oui."

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/g-2/c-6/13
msgctxt "Player"
msgid "I've got no idea."
msgstr "Aucune idée."

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/g-2/c-6/15
msgctxt "tinfoilhat"
msgid "Thank you for your incredibly insightful opinion."
msgstr "Merci pour ton avis incroyablement éclairé."

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/g-2/c-7/7
msgctxt "Player"
msgid "No I'm absolutely sure the answer is \"Norman: the Terror Worm.\""
msgstr "Non, je suis absolument {{sûr|sûre|sûr·e}} que la solution, c'est « Norman, le Ver de la Terreur »."

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/g-2/c-7/9
msgctxt "tinfoilhat"
msgid "Well, luckily I've always got him in my back pocket."
msgstr "Eh bien, heureusement, je l'ai toujours sous le coude."

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/g-3/0
msgctxt "tinfoilhat"
msgid "I have to go now."
msgstr "Je dois y aller."

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/g-3/5
msgctxt "tinfoilhat"
msgid "And not because my battery's low — or because I’m stealing wifi from a coffee shop — or because I’m hiding in an underground bunker."
msgstr "Et pas parce que ma batterie est faible, ni parce que je vole le wifi d'un café, ni parce que je me cache dans un bunker souterrain."

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/g-3/10/b/1
msgctxt "tinfoilhat"
msgid "Not even because chatting with you is exceedingly tedious."
msgstr "Ni même parce que discuter avec toi est extrêmement fastidieux."

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/g-3/13
msgctxt "tinfoilhat"
msgid "Although all those things are definitely true."
msgstr "Même si tout ça est parfaitement vrai."

# Traduction IA – à relire
#: thiscord_phone/tfh_14/0/g-3/18
msgctxt "tinfoilhat"
msgid "I have to go now to have a difficult conversation with someone I don’t talk to anymore. And that’s scarier than \"Norman: the Terror Worm\" could ever be."
msgstr "Je dois y aller pour avoir une conversation difficile avec quelqu'un à qui je ne parle plus. Et c'est plus effrayant que « Norman, le Ver de la Terreur » ne pourra jamais l'être."

# Traduction IA – à relire
#. Morceau de phrase coupé par une variable (nom du joueur, nombre...).
#: thiscord_phone/tfh_14/0/g-3/23
msgctxt "tinfoilhat"
msgid "Wish me luck,"
msgstr "Souhaite-moi bonne chance,"

# Traduction IA – à relire
#: thiscord_phone/tfh_15/0/6
msgctxt "tinfoilhat"
msgid "I hope David saw my email."
msgstr "J'espère que David a vu mon e-mail."

# Traduction IA – à relire
#: thiscord_phone/tfh_15/0/11
msgctxt "tinfoilhat"
msgid "If his last blustery MostMail is any proof, seems like he did."
msgstr "À en juger par son dernier MostMail plein d'esbroufe, on dirait que oui."

# Traduction IA – à relire
#: thiscord_phone/tfh_15/0/16
msgctxt "tinfoilhat"
msgid "It was a last ditch effort, but I still think it was the right choice."
msgstr "C'était une tentative de la dernière chance, mais je pense toujours que c'était le bon choix."

# Traduction IA – à relire
#: thiscord_phone/tfh_15/0/21
msgctxt "tinfoilhat"
msgid "Even though it would’ve been kinda fun to watch \"Norman: the Terror Worm\" cause an economic recession."
msgstr "Même si ça aurait été assez marrant de voir « Norman, le Ver de la Terreur » provoquer une récession économique."

# Traduction IA – à relire
#: thiscord_phone/tfh_15/0/26
msgctxt "tinfoilhat"
msgid "Now all we can do is wait."
msgstr "Maintenant, tout ce qu'on peut faire, c'est attendre."

# Traduction IA – à relire
#: thiscord_phone/tfh_15/0/32/s/0
msgctxt "Choix"
msgid "I'm not going to just sit around and wait!"
msgstr "Je vais pas juste rester les bras croisés à attendre !"

# Traduction IA – à relire
#: thiscord_phone/tfh_15/0/c-1/13
msgctxt "Player"
msgid "I'm not going to just sit around and wait!"
msgstr "Je vais pas juste rester les bras croisés à attendre !"

# Traduction IA – à relire
#: thiscord_phone/tfh_15/0/c-1/15
msgctxt "tinfoilhat"
msgid "Yeah, yeah, well you just keep telling yourself that."
msgstr "Oui, oui, c'est ça, continue de te répéter ça."

# Traduction IA – à relire
#: thiscord_phone/tfh_15/0/g-0/0
msgctxt "tinfoilhat"
msgid "Oh and when the government finds you, just plead ignorance."
msgstr "Ah, et quand le gouvernement te trouvera, plaide l'ignorance."

# Traduction IA – à relire
#: thiscord_phone/tfh_15/0/g-0/5/b/1
msgctxt "tinfoilhat"
msgid "They'll totally believe that excuse coming from you."
msgstr "Venant de toi, ils vont totalement gober cette excuse."

# Traduction IA – à relire
#: thiscord_phone/tfh_15/0/g-0/8
msgctxt "tinfoilhat"
msgid "Say you grabbed the wrong backpack or something."
msgstr "Dis que tu t'es trompé{{|e|·e}} de sac à dos ou un truc du genre."

# Traduction IA – à relire
#: thiscord_phone/tfh_15/0/g-0/13
msgctxt "tinfoilhat"
msgid "People accidentally walk off with experimental military technology all the time."
msgstr "Les gens repartent tout le temps par erreur avec de la technologie militaire expérimentale."

# Traduction IA – à relire
#: thiscord_phone/tfh_15/0/g-0/18/s/0 thiscord_phone/tfh_15/0/g-1/11/s/0
msgctxt "Choix"
msgid "Really?"
msgstr "Vraiment ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_15/0/g-0/19/s/0
msgctxt "Choix"
msgid "I'm pretty sure that's not going to work."
msgstr "Je suis presque {{sûr|sûre|sûr·e}} que ça va pas marcher."

# Traduction IA – à relire
#: thiscord_phone/tfh_15/0/g-0/20/s/0
msgctxt "Choix"
msgid "What if I just told them you gave it to me?"
msgstr "Et si je leur disais juste que c'est toi qui me les as données ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_15/0/g-0/c-2/13 thiscord_phone/tfh_15/0/g-1/c-6/7
msgctxt "Player"
msgid "Really?"
msgstr "Vraiment ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_15/0/g-0/c-3/13
msgctxt "Player"
msgid "I'm pretty sure that's not going to work."
msgstr "Je suis presque {{sûr|sûre|sûr·e}} que ça va pas marcher."

# Traduction IA – à relire
#. Morceau de phrase coupé par une variable (nom du joueur, nombre...).
#: thiscord_phone/tfh_15/0/g-0/c-3/15
msgctxt "tinfoilhat"
msgid "Only one way to find out,"
msgstr "Il n'y a qu'un moyen de le savoir,"

# Traduction IA – à relire
#: thiscord_phone/tfh_15/0/g-0/c-4/7
msgctxt "Player"
msgid "What if I just told them you gave it to me?"
msgstr "Et si je leur disais juste que c'est toi qui me les as données ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_15/0/g-0/c-4/9
msgctxt "tinfoilhat"
msgid "I mean I wouldn't, jackass. At least, not if you don't want a visit from \"Norman: the Terror Worm\"..."
msgstr "À ta place, je ne ferais pas ça, crétin. Du moins, si tu ne veux pas recevoir la visite de « Norman, le Ver de la Terreur »..."

# Traduction IA – à relire
#: thiscord_phone/tfh_15/0/g-1/0
msgctxt "tinfoilhat"
msgid "I’m so sorry, I can’t talk anymore right now..."
msgstr "Je suis vraiment désolé, je ne peux plus parler pour l'instant..."

# Traduction IA – à relire
#: thiscord_phone/tfh_15/0/g-1/10/s/0
msgctxt "Choix"
msgid "You already used that one."
msgstr "Tu l'as déjà sortie, celle-là."

# Traduction IA – à relire
#: thiscord_phone/tfh_15/0/g-1/c-5/7
msgctxt "Player"
msgid "You already used that one."
msgstr "Tu l'as déjà sortie, celle-là."

# Traduction IA – à relire
#: thiscord_phone/tfh_15/0/g-2/0
msgctxt "tinfoilhat"
msgid "Gotta go! Good luck!"
msgstr "Je dois filer ! Bonne chance !"

# Traduction IA – à relire
#: thiscord_phone/tfh_16/0/11
msgctxt "tinfoilhat"
msgid "It actually worked! He wants to reconcile!"
msgstr "Ça a marché ! Il veut qu'on se réconcilie !"

# Traduction IA – à relire
#: thiscord_phone/tfh_16/0/16
msgctxt "tinfoilhat"
msgid "And none of it ever would’ve been possible without you!"
msgstr "Et rien de tout ça n'aurait été possible sans toi !"

# Traduction IA – à relire
#: thiscord_phone/tfh_16/0/21/b/1
msgctxt "tinfoilhat"
msgid "Even though you've been a real pain in my ass, I still couldn't have done this alone."
msgstr "Même si tu m'as vraiment cassé les pieds, je n'aurais jamais pu y arriver seul."

# Traduction IA – à relire
#. Morceau de phrase coupé par une variable (nom du joueur, nombre...).
#: thiscord_phone/tfh_16/0/24
msgctxt "tinfoilhat"
msgid "So thank you"
msgstr "Alors merci"

# Traduction IA – à relire
#. Morceau de phrase coupé par une variable (nom du joueur, nombre...).
#: thiscord_phone/tfh_16/0/29
msgctxt "Narration / joueur"
msgid ", thank you!"
msgstr ", merci !"

# Traduction IA – à relire
#: thiscord_phone/tfh_16/0/34/s/0
msgctxt "Choix"
msgid "I had a blast!"
msgstr "Je me suis éclaté{{|e|·e}} !"

# Traduction IA – à relire
#: thiscord_phone/tfh_16/0/35/s/0
msgctxt "Choix"
msgid "Ah, it was nothin'."
msgstr "Bah, c'était rien."

# Traduction IA – à relire
#: thiscord_phone/tfh_16/0/36/s/0
msgctxt "Choix"
msgid "I hope I'm getting paid for this."
msgstr "J'espère que je suis payé{{|e|·e}} pour ça."

# Traduction IA – à relire
#: thiscord_phone/tfh_16/0/c-0/7
msgctxt "Player"
msgid "I had a blast!"
msgstr "Je me suis éclaté{{|e|·e}} !"

# Traduction IA – à relire
#: thiscord_phone/tfh_16/0/c-0/9
msgctxt "tinfoilhat"
msgid "I'm sure you did... Objects can be very... interesting to speak with I've found."
msgstr "Je n'en doute pas... Les objets peuvent être très... intéressants à fréquenter, d'après mon expérience."

# Traduction IA – à relire
#: thiscord_phone/tfh_16/0/c-0/14/0/s/0
msgctxt "Choix"
msgid "Did you fall in love with any?"
msgstr "T'es tombé amoureux de l'un d'eux ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_16/0/c-0/14/c-0/7
msgctxt "Player"
msgid "Did you fall in love with any?"
msgstr "T'es tombé amoureux de l'un d'eux ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_16/0/c-0/14/c-0/9
msgctxt "tinfoilhat"
msgid "My heart is set on David alone."
msgstr "Mon cœur appartient à David seul."

# Traduction IA – à relire
#: thiscord_phone/tfh_16/0/c-0/14/c-0/14
msgctxt "tinfoilhat"
msgid "But... there was Quentin, of course."
msgstr "Mais... il y a eu Quentin, bien sûr."

# Traduction IA – à relire
#: thiscord_phone/tfh_16/0/c-0/14/c-0/19/0/s/0
msgctxt "Choix"
msgid "Sure, I get that."
msgstr "Bien sûr, je comprends."

# Traduction IA – à relire
#: thiscord_phone/tfh_16/0/c-0/14/c-0/19/1/s/0
msgctxt "Choix"
msgid "Who is Quentin?"
msgstr "C'est qui, Quentin ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_16/0/c-0/14/c-0/19/c-0/7
msgctxt "Player"
msgid "Sure, I get that."
msgstr "Bien sûr, je comprends."

# Traduction IA – à relire
#: thiscord_phone/tfh_16/0/c-0/14/c-0/19/c-1/7
msgctxt "Player"
msgid "Who is Quentin?"
msgstr "C'est qui, Quentin ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_16/0/c-0/14/c-0/19/c-1/9
msgctxt "tinfoilhat"
msgid "Quentin the Quaternary Diode Array Liquid Chromatography System?"
msgstr "Quentin, le Système de Chromatographie Liquide à Barrette de Diodes Quaternaire ?"

# Traduction IA – à relire
#: thiscord_phone/tfh_16/0/c-0/14/c-0/19/c-1/14
msgctxt "tinfoilhat"
msgid "You... probably haven't met him."
msgstr "Tu ne l'as... sans doute pas rencontré."

# Traduction IA – à relire
#: thiscord_phone/tfh_16/0/c-1/7
msgctxt "Player"
msgid "Ah, it was nothin'."
msgstr "Bah, c'était rien."

# Traduction IA – à relire
#: thiscord_phone/tfh_16/0/c-2/7
msgctxt "Player"
msgid "I hope I'm getting paid for this."
msgstr "J'espère que je suis payé{{|e|·e}} pour ça."

# Traduction IA – à relire
#: thiscord_phone/tfh_16/0/c-2/9
msgctxt "tinfoilhat"
msgid "Uh, sure. I can send you some money."
msgstr "Euh, bien sûr. Je peux t'envoyer de l'argent."

# Traduction IA – à relire
