#: dasha_desk/crit_dasha_friend_end/0/c-0/15/c-0/39/0/s/0
msgctxt "Choix"
msgid "Sure. I'll see you later then."
msgstr ""

#: dasha_desk/crit_dasha_friend_end/0/c-0/15/c-0/39/c-0/7
msgctxt "Dasha"
msgid "Do svidaniya."
msgstr ""

#: dasha_desk/crit_dasha_hate_end/0/6
msgctxt "Dasha"
msgid "Date training has been disaster."
msgstr ""

#: dasha_desk/crit_dasha_hate_end/0/17
msgctxt "Dasha"
msgid "I only saw it through because I promised to help you."
msgstr ""

#: dasha_desk/crit_dasha_hate_end/0/25
msgctxt "Dasha"
msgid "And Dasha does not turn her back on those in need."
msgstr ""

#: dasha_desk/crit_dasha_hate_end/0/33
msgctxt "Dasha"
msgid "But you... you need much help. Much more than Dasha can provide."
