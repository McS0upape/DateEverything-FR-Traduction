#: canopy_work/canopy_paperclips/0/26/c-2/9
msgctxt "Customer"
msgid "What?"
msgstr "Quoi ?"

# Traduction IA – à relire
#: canopy_work/canopy_paperclips/0/26/c-2/14
msgctxt "Customer"
msgid "No, I want a refund."
msgstr "Non, je veux un remboursement."

# Traduction IA – à relire
#: canopy_work/canopy_paperclips/0/26/c-3/17
msgctxt "Player"
msgid "Would you like to go on a date?"
msgstr "Voulez-vous sortir avec moi ?"

# Traduction IA – à relire
#: canopy_work/canopy_paperclips/0/26/c-3/19
msgctxt "Customer"
msgid "Perhaps, provided things go well."
msgstr "Peut-être, si tout se passe bien."
