msgid "Bye little guy!"
msgstr "Salut, petit bonhomme !"

# Traduction IA – à relire
#: dorian_door/tutorial_dorian_trap/0/8
msgctxt "Narrator"
msgid "Or it might anyway, if he were wearing a shirt..."
msgstr "Ou du moins, ce serait le cas s'il portait une chemise..."

# Traduction IA – à relire
#: dorian_door/tutorial_dorian_trap/0/13
