#: scandalabra_candelabra/goings_on/0/g-1/0
msgctxt "Scandalabra"
msgid "More scandals abound..."
msgstr ""

#: scandalabra_candelabra/goings_on/0/g-1/8
msgctxt "Scandalabra"
msgid "They say there is a shadow that does not obey the laws of physics!"
msgstr ""

#: scandalabra_candelabra/goings_on/0/g-1/19
msgctxt "Scandalabra"
msgid "A true scandal that undermines the physical realm."
msgstr ""

#: scandalabra_candelabra/goings_on/0/g-1/30/s/0
msgctxt "Choix"
msgid "I don't really care about that one."
msgstr ""

#: scandalabra_candelabra/goings_on/0/g-1/31/s/0
msgctxt "Choix"
msgid "That's impossible."
msgstr ""

#: scandalabra_candelabra/goings_on/0/g-1/32/s/0
msgctxt "Choix"
msgid "Oh yeah, we've met."
msgstr ""

#: scandalabra_candelabra/goings_on/0/g-1/c-9/7
msgctxt "Scandalabra"
msgid "And yet, they say if you peer closely at a certain shadow on the floor, you can see the crooked stranger himself..."
