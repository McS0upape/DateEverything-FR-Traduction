#: dasha_desk/dasha_hate_crit/0/g-2/c-10/13
msgctxt "Dasha"
msgid "Cuddling is leap."
msgstr ""

#: dasha_desk/dasha_hate_crit/0/g-2/c-10/21
msgctxt "Dasha"
msgid "Perhaps if movie is enjoyable I will scoot closer and hold your hand."
