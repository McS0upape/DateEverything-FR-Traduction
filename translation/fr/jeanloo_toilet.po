msgctxt "Choix"
msgid "<i>Try to diss him in his native language!</i>"
msgstr "<i>Tenter de le clasher dans sa langue natale !</i>"

# Traduction IA – à relire
#: jeanloo_toilet/jeanloo_crapbattle_3/0/jeanloo_crapbattle_3d/14/s/0
msgctxt "Choix"
msgid "<i>Hit him with his native language!</i>"
msgstr "<i>L'attaquer dans sa langue natale !</i>"

# Traduction IA – à relire
