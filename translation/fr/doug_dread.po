#: doug_dread/doug_encounter3/0/g-8/c-27/7
msgctxt "Doug"
msgid "Great."
msgstr ""

#: doug_dread/doug_encounter3/0/g-8/c-28/7
msgctxt "Doug"
msgid "Maybe later. I'm not in the mood anymore."
