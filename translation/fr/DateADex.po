msgstr "Un goût de fraise !"

# Traduction IA – à relire
#: DateADex/abel_dex_entry/145
msgctxt "Tag Date-A-Dex"
msgid "Get a cup of coffee for Abel."
msgstr "Va chercher une tasse de café pour Abel."

