# Traduction IA – à relire
#: chance_d20/1
msgctxt "Tag Nom d'objet (MAJUSCULES)"
msgid "TWENTY SIDED DIE"
msgstr "DÉ À VINGT FACES"

# Traduction IA – à relire
#: chance_d20/chance_return_after_death/0/0
msgctxt "Chance"
msgid "Traveler! Thou hast returned!"
msgstr "{{Voyageur|Voyageuse|Voyageur·se}} ! Te voilà de retour !"

# Traduction IA – à relire
#: chance_d20/chance_return_after_death/0/8
msgctxt "Chance"
msgid "You may have been slain, but thou can play again!"
msgstr "Tu as peut-être péri, mais tu peux rejouer !"

# Traduction IA – à relire
#: chance_d20/chance_return_after_death/0/16
msgctxt "Chance"
msgid "Would you like to?"
msgstr "Ça te dit ?"

# Traduction IA – à relire
#: chance_d20/chance_return_after_death/0/24/s/0
msgctxt "Choix"
msgid "Yeah, I'm up for another shot!"
msgstr "Ouais, je suis partant{{|e|·e}} pour un nouvel essai !"

# Traduction IA – à relire
#: chance_d20/chance_return_after_death/0/25/s/0
msgctxt "Choix"
msgid "No, I'm good."
msgstr "Non, ça ira."

# Traduction IA – à relire
#: chance_d20/chance_return_after_death/0/c-0/7
msgctxt "Chance"
msgid "Zoom! Zorch! Profigliano!"
msgstr "Zoum ! Zorch ! Profigliano !"

# Traduction IA – à relire
#: chance_d20/chance_return_after_death/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "What"
msgstr "Quoi"

# Traduction IA – à relire
#: chance_d20/chance_return_after_death/0/c-0/15/1/s/0
msgctxt "Choix"
msgid "Love ya, my dude."
msgstr "Je t'adore, mon pote."

# Traduction IA – à relire
#: chance_d20/chance_return_after_death/0/c-0/15/g-0/0
msgctxt "Chance"
msgid "Onward!"
msgstr "En avant !"

# Traduction IA – à relire
#: chance_d20/victory_sorter/0/0/s/0
msgctxt "Choix"
msgid "Let's go with the Troubadour this time!"
msgstr "On part sur le Troubadour, cette fois !"

# Traduction IA – à relire
#: chance_d20/victory_sorter/0/1/s/0
msgctxt "Choix"
msgid "I'm sticking with the Troubadour."
msgstr "Je reste sur le Troubadour."

# Traduction IA – à relire
#: chance_d20/victory_sorter/0/2/s/0
msgctxt "Choix"
msgid "I've got a good feeling about the Guardian."
msgstr "Je le sens bien, le Gardien."

# Traduction IA – à relire
#: chance_d20/victory_sorter/0/3/s/0
msgctxt "Choix"
msgid "This time I'm taking Guardian all the way to the end."
msgstr "Cette fois, je vais jusqu'au bout avec le Gardien."

# Traduction IA – à relire
#: chance_d20/victory_sorter/0/4/s/0
msgctxt "Choix"
msgid "All right, time for the Enchanter..."
msgstr "Bon, place à l'Enchanteur..."

# Traduction IA – à relire
#: chance_d20/victory_sorter/0/5/s/0
msgctxt "Choix"
msgid "It's still the Enchanter for me."
msgstr "Pour moi, ce sera encore l'Enchanteur."

# Traduction IA – à relire
#: chance_d20/victory_sorter/0/c-0/7 chance_d20/victory_sorter/0/c-1/7
msgctxt "Chance"
msgid "Oooh la la...."
msgstr "Oooh là là..."

# Traduction IA – à relire
#: chance_d20/victory_sorter/0/c-2/7 chance_d20/victory_sorter/0/c-3/7
msgctxt "Chance"
msgid "I can't wait!"
msgstr "J'ai trop hâte !"

# Traduction IA – à relire
#: chance_d20/victory_sorter/0/c-4/7 chance_d20/victory_sorter/0/c-5/7
msgctxt "Chance"
msgid "Enchante..."
msgstr "Enchanté..."

# Traduction IA – à relire
#: chance_d20/Chance_first_encounter/0/0
msgctxt "Narrator"
msgid "You've never been ashamed of your interest in tabletop games, but ever since you stopped seeing people you've spent far less time roleplaying than you used to."
msgstr "Vous n'avez jamais eu honte de votre goût pour les jeux de rôle sur table, mais depuis que vous ne voyez plus personne, vous jouez bien moins qu'avant."

# Traduction IA – à relire
#: chance_d20/Chance_first_encounter/0/5
msgctxt "Narrator"
msgid "The cloak-wearing nerd standing before you reminds you of days gone by, when you used to gather around a table with your college friends and pretend to be someone else."
msgstr "Ce nerd en cape planté devant vous vous rappelle le bon vieux temps, quand vous vous réunissiez autour d'une table avec vos amis de fac pour faire semblant d'être quelqu'un d'autre."

# Traduction IA – à relire
#: chance_d20/Chance_first_encounter/0/10
msgctxt "Chance"
msgid "Ho there, traveler!"
msgstr "Holà, manant !"

# Traduction IA – à relire
#: chance_d20/Chance_first_encounter/0/18/s/0
msgctxt "Choix"
msgid "...what did you call me?"
msgstr "... tu m'as traité{{|e|·e}} de quoi ?"

# Traduction IA – à relire
#: chance_d20/Chance_first_encounter/0/c-0/7
msgctxt "Chance"
msgid "No! Ho as in, Hey!"
msgstr "Non ! « Manant » comme dans... « Salut » !"

# Traduction IA – à relire
#: chance_d20/Chance_first_encounter/0/c-0/18
msgctxt "Chance"
msgid "Howdy..."
msgstr "Bonjour..."

# Traduction IA – à relire
#: chance_d20/Chance_first_encounter/0/c-0/26
msgctxt "Chance"
msgid "How are you... you know. A simple salutation."
msgstr "Comme « Comment ça va »... enfin, tu vois. Une simple salutation."

# Traduction IA – à relire
#: chance_d20/Chance_first_encounter/0/c-0/34/0/s/0
msgctxt "Choix"
msgid "That might not be the best greeting."
msgstr "C'est peut-être pas la meilleure façon de saluer."

# Traduction IA – à relire
#: chance_d20/Chance_first_encounter/0/c-0/34/1/s/0
msgctxt "Choix"
msgid "Oh! Well then. A good day to you!"
msgstr "Oh ! Fort bien. Le bonjour à toi !"

# Traduction IA – à relire
#: chance_d20/Chance_first_encounter/0/c-0/34/c-0/7
msgctxt "Chance"
msgid "Heh. You might be right."
msgstr "Hé. T'as peut-être raison."

# Traduction IA – à relire
#: chance_d20/Chance_first_encounter/0/c-0/34/c-1/7
msgctxt "Chance"
msgid "That's the spirit!"
msgstr "Voilà l'esprit !"

# Traduction IA – à relire
#: chance_d20/Chance_first_encounter/0/g-0/0
msgctxt "Chance"
msgid "I'm Chance, your D20."
msgstr "Je suis Chance, ton D20."

# Traduction IA – à relire
#: chance_d20/Chance_first_encounter/0/g-0/8
msgctxt "Narrator"
msgid "The mysterious cloak comes off, and you see the friendly face beneath."
msgstr "La mystérieuse cape tombe, et vous découvrez le visage avenant qui se cachait dessous."

# Traduction IA – à relire
#: chance_d20/Chance_first_encounter/0/g-0/19
msgctxt "Chance"
msgid "Taking a tiny respite from the drudgery of work?"
msgstr "Tu prends une petite pause dans la corvée du travail ?"

# Traduction IA – à relire
#: chance_d20/Chance_first_encounter/0/g-0/27/s/0
msgctxt "Choix"
msgid "You know what they say about all work and no play."
msgstr "Tu connais le dicton : trop de boulot, pas assez de jeu..."

# Traduction IA – à relire
#: chance_d20/Chance_first_encounter/0/g-0/28/s/0
msgctxt "Choix"
msgid "Just getting up to stretch my legs. Walk around. Talk to my things."
msgstr "Je me dégourdis juste les jambes. Je fais un tour. Je parle à mes affaires."

# Traduction IA – à relire
#: chance_d20/Chance_first_encounter/0/g-0/c-1/7
msgctxt "Chance"
msgid "I actually have no idea. All I do is play."
msgstr "En fait, j'en ai aucune idée. Moi, je ne fais que jouer."

# Traduction IA – à relire
#: chance_d20/Chance_first_encounter/0/g-0/c-2/7
msgctxt "Chance"
msgid "Ah, yes. The usual."
msgstr "Ah, oui. Le classique."

# Traduction IA – à relire
#: chance_d20/Chance_first_encounter/0/g-1/0
msgctxt "Chance"
msgid "If you are up for a real adventure, I have just the thing for you."
msgstr "Si tu es partant{{|e|·e}} pour une vraie aventure, j'ai exactement ce qu'il te faut."

# Traduction IA – à relire
#: chance_d20/Chance_first_encounter/0/g-1/8
msgctxt "Chance"
msgid "Have you ever heard of..."
msgstr "As-tu déjà entendu parler de..."

# Traduction IA – à relire
#: chance_d20/Chance_first_encounter/0/g-1/16
msgctxt "Chance"
msgid "GROTTOS AND GARGOYLES??"
msgstr "GROTTES & GARGOUILLES ??"

# Traduction IA – à relire
#: chance_d20/Chance_first_encounter/0/g-1/24/s/0
msgctxt "Choix"
msgid "Never have I ever. What's that?"
msgstr "Jamais de la vie. C'est quoi ?"

# Traduction IA – à relire
#: chance_d20/Chance_first_encounter/0/g-1/25/s/0
msgctxt "Choix"
msgid "Are you kidding me? Of course I've heard of G and G!"
msgstr "Tu te moques de moi ? Évidemment que je connais G&G !"

# Traduction IA – à relire
#: chance_d20/GandG_explained/0/0
msgctxt "Chance"
msgid "Really?? By the flowing waters of Socklandia, you are missing out!"
msgstr "Sérieux ?? Par les eaux vives de Chaussetlandie, tu rates quelque chose !"

# Traduction IA – à relire
#: chance_d20/GandG_explained/0/8
msgctxt "Chance"
msgid "Can I tell you all about it?"
msgstr "Je peux tout te raconter ?"

# Traduction IA – à relire
#: chance_d20/GandG_explained/0/16/s/0
msgctxt "Choix"
msgid "Tell me everything!"
msgstr "Raconte-moi tout !"

# Traduction IA – à relire
#: chance_d20/GandG_explained/0/17/s/0
msgctxt "Choix"
msgid "You're going to anyway, aren't you?"
msgstr "Tu vas le faire de toute façon, non ?"

# Traduction IA – à relire
#: chance_d20/GandG_explained/0/c-0/7
msgctxt "Chance"
msgid "Great!"
msgstr "Génial !"

# Traduction IA – à relire
#: chance_d20/GandG_explained/0/c-1/7
msgctxt "Chance"
msgid "I mean... yeah."
msgstr "Enfin... ouais."

# Traduction IA – à relire
#: chance_d20/GandG_explained/0/GG_explain/0
msgctxt "Chance"
msgid "G and G is one of, if not THE greatest game that has ever been created. A game, forged by the imaginations of those who know that adventure and excitement can be around every corner."
msgstr "G&G est l'un des plus grands jeux jamais créés, si ce n'est LE plus grand. Un jeu forgé par l'imagination de celles et ceux qui savent que l'aventure et l'excitation peuvent surgir au détour de chaque couloir."

# Traduction IA – à relire
#: chance_d20/GandG_explained/0/GG_explain/8
msgctxt "Chance"
msgid "It's a role playing game, so part of the fun is really getting into it."
msgstr "C'est un jeu de rôle, donc une partie du plaisir, c'est de vraiment se mettre dans la peau du personnage."

# Traduction IA – à relire
#: chance_d20/GandG_explained/0/GG_explain/16/s/0
msgctxt "Choix"
msgid "What do you mean by role playing game?"
msgstr "Comment ça, un jeu de rôle ?"

# Traduction IA – à relire
#: chance_d20/GandG_explained/0/GG_explain/17/s/0
msgctxt "Choix"
msgid "Get into it? How do you do that?"
msgstr "Se mettre dans la peau ? Comment on fait ?"

# Traduction IA – à relire
#: chance_d20/GandG_explained/0/GG_explain/c-2/7
msgctxt "Chance"
msgid "You create a character... and live out their story! Every decision is yours to make and mine to harmonize!"
msgstr "Tu crées un personnage... et tu vis son histoire ! Chaque décision t'appartient, et moi, je les orchestre !"

# Traduction IA – à relire
#: chance_d20/GandG_explained/0/g-0/0
msgctxt "Chance"
msgid "It's all about using your imagination! I, serving as your Chronicler, present the player with situations and scenarios filled with choices for you."
msgstr "Tout repose sur l'imagination ! Moi, en tant que Chroniqueur, je présente au joueur des situations et des scénarios pleins de choix à faire."

# Traduction IA – à relire
#: chance_d20/GandG_explained/0/g-0/8
msgctxt "Chance"
msgid "You could search the deep dark caves scattered across the Bookshelf Bluff. Or run along the bright and musk filled Shoelace Shores."
msgstr "Tu pourrais explorer les grottes sombres et profondes qui parsèment la Falaise de l'Étagère. Ou courir le long des Rivages-Lacets, lumineux et parfumés de musc."

# Traduction IA – à relire
#: chance_d20/GandG_explained/0/g-0/16
msgctxt "Chance"
msgid "Or, my personal favorite, start in the small village of Dec'or, listening to the stories of adventurers, waiting for a quest to pique your interest to start your own epic tale!"
msgstr "Ou, mon préféré, commencer dans le petit village de Dec'or, à écouter les récits des aventuriers en attendant qu'une quête pique ta curiosité et lance ta propre épopée !"

# Traduction IA – à relire
#: chance_d20/GandG_explained/0/g-0/24/s/0
msgctxt "Choix"
msgid "That sounds incredibly fun!"
msgstr "Ça a l'air super marrant !"

# Traduction IA – à relire
#: chance_d20/GandG_explained/0/g-0/25/s/0
msgctxt "Choix"
msgid "Eh... seems kind of lame to me."
msgstr "Bof... ça m'a l'air un peu nul."

# Traduction IA – à relire
#: chance_d20/Dont_want_to_play/0/0
msgctxt "Chance"
msgid "Oh... I mean, it's fun if you try it out. I promise. It's my favorite thing to do."
msgstr "Oh... Enfin, c'est marrant quand on essaie. Promis. C'est mon truc préféré."

# Traduction IA – à relire
#: chance_d20/Dont_want_to_play/0/8/s/0
msgctxt "Choix"
msgid "Hard pass. Way too nerdy for me."
msgstr "Sans façon. Beaucoup trop geek pour moi."

# Traduction IA – à relire
#: chance_d20/Dont_want_to_play/0/9/s/0
msgctxt "Choix"
msgid "You really think I'd like it?"
msgstr "Tu crois vraiment que ça me plairait ?"

# Traduction IA – à relire
#: chance_d20/Dont_want_to_play/0/c-1/7
msgctxt "Chance"
msgid "You never know until you try."
msgstr "On ne sait jamais avant d'avoir essayé."

# Traduction IA – à relire
#: chance_d20/Dont_want_to_play/0/c-1/15
msgctxt "Chance"
msgid "What do ya say?"
msgstr "T'en dis quoi ?"

# Traduction IA – à relire
#: chance_d20/Dont_want_to_play/0/c-1/23/0/s/0
msgctxt "Choix"
msgid "I wouldn't know where to start. I'll play if you help me."
msgstr "Je ne saurais pas par où commencer. Je joue si tu m'aides."

# Traduction IA – à relire
#: chance_d20/Dont_want_to_play/0/c-1/23/1/s/0
msgctxt "Choix"
msgid "Yeah, definitely not into playing dumb games."
msgstr "Non, clairement, les jeux débiles, c'est pas mon truc."

# Traduction IA – à relire
#: chance_d20/Chance_impressed/0/0
msgctxt "Chance"
msgid "That's great! What's your favorite monster? Oh! What about your favorite mystical weapon? Or class? I have so many questions!"
msgstr "Génial ! C'est quoi, ton monstre préféré ? Oh ! Et ton arme mystique préférée ? Ou ta classe ? J'ai tellement de questions !"

# Traduction IA – à relire
#: chance_d20/Chance_impressed/0/8/s/0
msgctxt "Choix"
msgid "I'm partial to... all of them, actually. How could I possibly choose?"
msgstr "J'ai un faible pour... tous, en fait. Comment veux-tu que je choisisse ?"

# Traduction IA – à relire
#: chance_d20/Chance_impressed/0/9/s/0
msgctxt "Choix"
msgid "I've only heard of it. I haven't actually played it. Seems complicated."
msgstr "J'en ai juste entendu parler. J'y ai jamais joué. Ça a l'air compliqué."

# Traduction IA – à relire
#: chance_d20/Chance_impressed/0/10/s/0
msgctxt "Choix"
msgid "I lied, what's Goblins and Gangrene?"
msgstr "J'ai menti, c'est quoi Gobelins et Gangrène ?"

# Traduction IA – à relire
#: chance_d20/Chance_impressed/0/c-0/7
msgctxt "Chance"
msgid "Wow. Someone else who feels the same as me! It's so hard to pick a favorite. Everything about G and G is so cool!"
msgstr "Waouh. Quelqu'un qui pense comme moi ! C'est tellement dur de choisir un préféré. Tout est trop cool dans G&G !"

# Traduction IA – à relire
#: chance_d20/Chance_impressed/0/c-1/7
msgctxt "Chance"
msgid "Oh, that's okay. The fact that you know about it is already pretty awesome. I get so excited to talk about this stuff with people."
msgstr "Oh, c'est pas grave. Le simple fait que tu connaisses, c'est déjà génial. Ça m'enthousiasme tellement de parler de ces trucs avec les gens."

# Traduction IA – à relire
#: chance_d20/Chance_impressed/0/c-2/7
msgctxt "Chance"
msgid "Grottos and GARGOYLES..."
msgstr "Grottes & GARGOUILLES..."

# Traduction IA – à relire
#: chance_d20/Chance_impressed/0/g-0/0
msgctxt "Chance"
msgid "You wouldn't want to... maybe... kinda..."
msgstr "Tu voudrais pas... peut-être... genre..."

# Traduction IA – à relire
#: chance_d20/Chance_impressed/0/g-0/8
msgctxt "Chance"
msgid "Play with me, would you?"
msgstr "Jouer avec moi, dis ?"

# Traduction IA – à relire
#: chance_d20/Chance_impressed/0/g-0/16
msgctxt "Chance"
msgid "It would only be the single greatest thing you could do for me."
msgstr "Ce serait juste la plus belle chose que tu puisses faire pour moi."

# Traduction IA – à relire
#: chance_d20/Chance_impressed/0/g-0/24/s/0
msgctxt "Choix"
msgid "That would be a lot of fun, Chance!"
msgstr "Ce serait super marrant, Chance !"

# Traduction IA – à relire
#: chance_d20/Chance_impressed/0/g-0/25/s/0
msgctxt "Choix"
msgid "Me? Play G and G? I don't really think I want to."
msgstr "Moi ? Jouer à G&G ? Je crois pas que j'en aie envie."

# Traduction IA – à relire
#: chance_d20/Chance_impressed/0/g-0/c-4/7
msgctxt "Chance"
msgid "Really? Why not?"
msgstr "Ah bon ? Pourquoi ?"

# Traduction IA – à relire
#: chance_d20/Chance_impressed/0/g-0/c-4/15/0/s/0
msgctxt "Choix"
msgid "I've never played before. I don't want to make a fool of myself."
msgstr "J'ai jamais joué. J'ai pas envie de me ridiculiser."

# Traduction IA – à relire
#: chance_d20/Chance_impressed/0/g-0/c-4/15/c-0/7
msgctxt "Chance"
msgid "I would be here with you the whole time. It's my job as your Chronicler to guide you through the game! You can trust me."
msgstr "Je serai avec toi tout du long. C'est mon rôle de Chroniqueur de te guider dans le jeu ! Tu peux me faire confiance."

# Traduction IA – à relire
#: chance_d20/Chance_impressed/0/g-1/0/s/0
msgctxt "Choix"
msgid "It doesn't really sound like a good time."
msgstr "Ça a pas l'air très amusant."

# Traduction IA – à relire
#: chance_d20/Chance_impressed/0/g-1/1/s/0
msgctxt "Choix"
msgid "Why won't you take no for an answer?"
msgstr "Pourquoi tu refuses d'entendre un non ?"

# Traduction IA – à relire
#: chance_d20/Chance_impressed/0/g-1/2/s/0
msgctxt "Choix"
msgid "I mean... you think I'd be any good?"
msgstr "Enfin... tu crois que je serais {{doué|douée|doué·e}} ?"

# Traduction IA – à relire
#: chance_d20/Chance_impressed/0/g-1/3/s/0
msgctxt "Choix"
msgid "You know what... sure! Tell me all about it!"
msgstr "Tu sais quoi... d'accord ! Raconte-moi tout !"

# Traduction IA – à relire
#: chance_d20/Convince_to_play/0/0
msgctxt "Chance"
msgid "I'm positive you will be. This game can take you to far off lands where the last thing you have to think about is being good."
msgstr "J'en suis certain. Ce jeu peut t'emmener dans des contrées lointaines où être doué, c'est vraiment le dernier de tes soucis."

# Traduction IA – à relire
#: chance_d20/Convince_to_play/0/8
msgctxt "Chance"
msgid "Think of it this way, you get to build a story with me. Hopefully, it won't be the last."
msgstr "Vois ça comme ça : tu vas construire une histoire avec moi. Et j'espère que ce ne sera pas la dernière."

# Traduction IA – à relire
#: chance_d20/Convince_to_play/0/16/s/0
msgctxt "Choix"
msgid "We would play another campaign after this?"
msgstr "On ferait une autre campagne après celle-là ?"

# Traduction IA – à relire
#: chance_d20/Convince_to_play/0/17/s/0
msgctxt "Choix"
msgid "Oh... do you have any other games in mind, handsome?"
msgstr "Oh... tu as d'autres jeux en tête, beau gosse ?"

# Traduction IA – à relire
#: chance_d20/Convince_to_play/0/c-0/7
msgctxt "Chance"
msgid "Oh I've got oodles of campaigns in this noodle..."
msgstr "Oh, j'ai des tonnes de campagnes dans la caboche..."

# Traduction IA – à relire
#: chance_d20/Convince_to_play/0/c-1/13
msgctxt "Chance"
msgid "Well, I mean..."
msgstr "Enfin, je veux dire..."

# Traduction IA – à relire
#: chance_d20/Convince_to_play/0/c-1/21
msgctxt "Chance"
msgid "Let's just say that this isn't the only role play I like to do."
msgstr "Disons que ce n'est pas le seul jeu de rôle que j'aime pratiquer."

# Traduction IA – à relire
#: chance_d20/Convince_to_play/0/g-0/0
msgctxt "Chance"
msgid "So... what do you say? Roll with me?"
msgstr "Alors... t'en dis quoi ? Tu lances les dés avec moi ?"

# Traduction IA – à relire
#: chance_d20/Convince_to_play/0/g-0/8/s/0
msgctxt "Choix"
msgid "Not to be witty but... no dice."
msgstr "Sans vouloir faire de jeu de mots... je passe mon tour."

# Traduction IA – à relire
#: chance_d20/Convince_to_play/0/g-0/9/s/0
msgctxt "Choix"
msgid "Sounds more fun than I thought. I'm in!"
msgstr "Ça a l'air plus marrant que je pensais. J'en suis !"

# Traduction IA – à relire
#: chance_d20/Wannaplay/0/0
msgctxt "Narrator"
msgid "Chance's eyes light up, his hands balling into fists as he does his best to contain his excitement."
msgstr "Les yeux de Chance s'illuminent ; il serre les poings en faisant de son mieux pour contenir son excitation."

# Traduction IA – à relire
#: chance_d20/Wannaplay/0/8
msgctxt "Chance"
msgid "REALLY? Holy Crit! Someone to play with me! You have no idea how hard it is to find someone to play with."
msgstr "C'EST VRAI ? Nom d'un crit ! Quelqu'un pour jouer avec moi ! Tu n'as pas idée à quel point c'est dur de trouver des partenaires de jeu."

# Traduction IA – à relire
#: chance_d20/Wannaplay/0/16/s/0
msgctxt "Choix"
msgid "Can we play with just the two of us?"
msgstr "On peut jouer juste tous les deux ?"

# Traduction IA – à relire
#: chance_d20/Wannaplay/0/17/s/0
msgctxt "Choix"
msgid "Should we have a group for this game?"
msgstr "Il nous faudrait un groupe pour ce jeu ?"

# Traduction IA – à relire
#: chance_d20/Wannaplay/0/c-0/7
msgctxt "Chance"
msgid "Sure can! Don't you worry about that. Your Chronicler will balance everything for solo play!"
msgstr "Bien sûr ! Ne t'inquiète pas pour ça. Ton Chroniqueur va tout équilibrer pour une partie en solo !"

# Traduction IA – à relire
#: chance_d20/Wannaplay/0/c-1/7
msgctxt "Chance"
msgid "Ideally, but hey! One-on-one sessions can be a really great way to learn the game!"
msgstr "Ce serait l'idéal, mais bon ! Les parties en tête-à-tête, c'est génial pour apprendre le jeu !"

# Traduction IA – à relire
#: chance_d20/Wannaplay/0/c-1/15
msgctxt "Chance"
msgid "Depending on what class you pick though, I might have a few friends around the house who might want to hop in..."
msgstr "Selon la classe que tu choisis, j'ai peut-être quelques amis dans la maison qui voudront se joindre à nous..."

# Traduction IA – à relire
#: chance_d20/Wannaplay/0/g-0/0
msgctxt "Chance"
msgid "Regardless, it'll give us some time to get to know each other better!"
msgstr "Dans tous les cas, ça nous laissera le temps de mieux nous connaître !"

# Traduction IA – à relire
#: chance_d20/Wannaplay/0/g-0/8/s/0
msgctxt "Choix"
msgid "I can roll with that! What's next?"
msgstr "Ça roule ! Et ensuite ?"

# Traduction IA – à relire
#: chance_d20/Wannaplay/0/g-0/9/s/0
msgctxt "Choix"
msgid "One-on-one? I like those odds! What do we do now?"
msgstr "En tête-à-tête ? Ça me plaît, comme probabilités ! On fait quoi, maintenant ?"

# Traduction IA – à relire
#: chance_d20/Campaign_intro/0/0
msgctxt "Chance"
msgid "It's time to get you your character!"
msgstr "C'est l'heure de te créer un personnage !"

# Traduction IA – à relire
#: chance_d20/Campaign_intro/0/8
msgctxt "Chance"
msgid "All we have to do is choose your stats, your powers, and your weapons."
msgstr "Il suffit de choisir tes caractéristiques, tes pouvoirs et tes armes."

# Traduction IA – à relire
#: chance_d20/Campaign_intro/0/16
msgctxt "Chance"
msgid "And then your armor, your lineage, and your gargoyle gauge. Although, I might leave that out for this first character. It's an optional setting."
msgstr "Et puis ton armure, ta lignée et ta jauge de gargouille. Quoique, je vais peut-être laisser ça de côté pour ce premier personnage. C'est une règle optionnelle."

# Traduction IA – à relire
#: chance_d20/Campaign_intro/0/24
msgctxt "Chance"
msgid "See, you can have a portion of gargoyle blood running through your veins which lets you —"
msgstr "Tu vois, tu peux avoir une part de sang de gargouille dans les veines, ce qui te permet de..."

# Traduction IA – à relire
#: chance_d20/Campaign_intro/0/32/s/0
msgctxt "Choix"
msgid "That's... a lot of choices. And I have to make all of them?"
msgstr "Ça fait... beaucoup de choix. Et je dois tous les faire ?"

# Traduction IA – à relire
#: chance_d20/Campaign_intro/0/33/s/0
msgctxt "Choix"
msgid "How much time is all of that going to take?"
msgstr "Ça va prendre combien de temps, tout ça ?"

# Traduction IA – à relire
#: chance_d20/Campaign_intro/0/34/s/0
msgctxt "Choix"
msgid "I dunno, this sounds right up my alley!"
msgstr "Je sais pas, ça a l'air complètement mon truc !"

# Traduction IA – à relire
#: chance_d20/Campaign_intro/0/c-0/7
msgctxt "Chance"
msgid "Oh! Of course! It is a whole heap to take on your first time out."
msgstr "Oh ! Bien sûr ! C'est beaucoup à encaisser pour une première fois."

# Traduction IA – à relire
#: chance_d20/Campaign_intro/0/c-1/7
msgctxt "Chance"
msgid "Depending on whether you skip through what I have to say... maybe 20 minutes."
msgstr "Selon que tu sautes ou non ce que j'ai à dire... peut-être 20 minutes."

# Traduction IA – à relire
#: chance_d20/Campaign_intro/0/g-0/0
msgctxt "Chance"
msgid "How about you let me make your character for you. I know the game inside and out and you can just show up and play."
msgstr "Et si je créais ton personnage pour toi ? Je connais le jeu sur le bout des doigts, et toi, tu n'aurais plus qu'à venir jouer."

# Traduction IA – à relire
#: chance_d20/Campaign_intro/0/g-0/8/s/0
msgctxt "Choix"
msgid "You would do that for me? You're the best."
msgstr "Tu ferais ça pour moi ? T'es le meilleur."

# Traduction IA – à relire
#: chance_d20/Campaign_intro/0/g-0/9/s/0
msgctxt "Choix"
msgid "Perfect! I love that idea!"
msgstr "Parfait ! J'adore l'idée !"

# Traduction IA – à relire
#: chance_d20/Campaign_intro/0/g-0/10/s/0
msgctxt "Choix"
msgid "K."
msgstr "Ok."

# Traduction IA – à relire
#: chance_d20/Campaign_intro/0/g-1/0
msgctxt "Chance"
msgid "Oh, I'm so excited! You have no idea how much fun we are going to have! I'll even build the session based on what class you pick!"
msgstr "Oh, je suis trop excité ! Tu n'as pas idée de ce qu'on va s'amuser ! Je vais même construire la séance selon la classe que tu choisis !"

# Traduction IA – à relire
#: chance_d20/Campaign_intro/0/g-1/8/s/0
msgctxt "Choix"
msgid "What are my options?"
msgstr "J'ai quoi, comme options ?"

# Traduction IA – à relire
#: chance_d20/Campaign_intro/0/g-1/9/s/0
msgctxt "Choix"
msgid "What do you suggest I play as?"
msgstr "Tu me conseilles de jouer quoi ?"

# Traduction IA – à relire
#: chance_d20/Campaign_intro/0/class_choice/0
msgctxt "Chance"
msgid "Hmm... There are three classes I can get rolling for you! All of them are awesome, but they won't be too much of a challenge."
msgstr "Hmm... Il y a trois classes que je peux te préparer ! Elles sont toutes géniales, et elles ne seront pas trop difficiles."

# Traduction IA – à relire
#: chance_d20/Campaign_intro/0/class_choice/8
msgctxt "Chance"
msgid "I'd suggest The Troubadour, The Guardian, or the Enchanter!"
msgstr "Je te propose le Troubadour, le Gardien ou l'Enchanteur !"

# Traduction IA – à relire
#: chance_d20/Campaign_intro/0/class_choice/16/0
msgctxt "Chance"
msgid "Which one would you like?"
msgstr "Laquelle te tente ?"

# Traduction IA – à relire
#: chance_d20/Campaign_intro/0/class_choice/16/8/s/0
msgctxt "Choix"
msgid "Can you explain them to me?"
msgstr "Tu peux me les expliquer ?"

# Traduction IA – à relire
#: chance_d20/Campaign_intro/0/class_choice/16/9/s/0
msgctxt "Choix"
msgid "The Troubadour sounds like fun!"
msgstr "Le Troubadour a l'air marrant !"

# Traduction IA – à relire
#: chance_d20/Campaign_intro/0/class_choice/16/10/s/0
msgctxt "Choix"
msgid "Guardian all the way!"
msgstr "Gardien, à fond !"

# Traduction IA – à relire
#: chance_d20/Campaign_intro/0/class_choice/16/11/s/0
msgctxt "Choix"
msgid "Ooooh! Enchanter is the one for me!"
msgstr "Ooooh ! L'Enchanteur, c'est fait pour moi !"

# Traduction IA – à relire
#: chance_d20/Class_explanation/0/0
msgctxt "Chance"
msgid "Sure!"
msgstr "Bien sûr !"

# Traduction IA – à relire
#: chance_d20/Class_explanation/0/8
msgctxt "Chance"
msgid "Let's start with the Troubadour! Loved by the locals for their wit and their voice, this magnificent magical minstrel can change the outcome of a dire situation with a simple tune."
msgstr "Commençons par le Troubadour ! Adoré du peuple pour son esprit et sa voix, ce ménestrel merveilleusement magique peut renverser une situation désespérée d'un simple air."

# Traduction IA – à relire
#: chance_d20/Class_explanation/0/16
msgctxt "Chance"
msgid "With a lyre by their side, this slick and seducing stupifier is sought after by those who wish to trade both coin and secrets for songs."
msgstr "Lyre au côté, ce séducteur sournois et subjuguant est recherché par tous ceux qui veulent échanger pièces et secrets contre des chansons."

# Traduction IA – à relire
#: chance_d20/Class_explanation/0/24
msgctxt "Chance"
msgid "Don't be fooled though! The Troubadour can hold their own! They are a healthy hero, able to take hits with the best of them."
msgstr "Mais ne te laisse pas berner ! Le Troubadour sait se défendre ! C'est un héros robuste, capable d'encaisser les coups comme les meilleurs."

# Traduction IA – à relire
#: chance_d20/Class_explanation/0/32
msgctxt "Chance"
msgid "What do you think about the Troubadour?"
msgstr "Qu'est-ce que tu penses du Troubadour ?"

# Traduction IA – à relire
#: chance_d20/Class_explanation/0/40/s/0
msgctxt "Choix"
msgid "They sound awesome! What about the Guardian?"
msgstr "Il a l'air génial ! Et le Gardien ?"

# Traduction IA – à relire
#: chance_d20/Class_explanation/0/41/s/0
msgctxt "Choix"
msgid "I don't need to hear about the others! Troubadour is the one for me!"
msgstr "Pas besoin d'entendre les autres ! Le Troubadour, c'est fait pour moi !"

# Traduction IA – à relire
#: chance_d20/Class_explanation/0/g-0/0
msgctxt "Chance"
msgid "The mighty Guardian! This sword-wielding warrior of light and all that is right vows to protect the citizens of the realm."
msgstr "Le puissant Gardien ! Ce guerrier de lumière et de droiture, épée au poing, a juré de protéger les citoyens du royaume."

# Traduction IA – à relire
#: chance_d20/Class_explanation/0/g-0/8
msgctxt "Chance"
msgid "This is one beefy class. While this particular participant can pack a punch, they aren't the smartest of classes. If there is a problem, they will try to solve it by punching."
msgstr "C'est une classe bien costaude. Ce combattant cogne fort, mais ce n'est pas la classe la plus futée. S'il y a un problème, il essaiera de le régler à coups de poing."

# Traduction IA – à relire
#: chance_d20/Class_explanation/0/g-0/16
msgctxt "Chance"
msgid "That isn't a bad thing though! A well equipped Guardian can take down the most vicious of gargoyles. Their fighting record is just as shiny as their armor."
msgstr "Mais ce n'est pas un défaut ! Un Gardien bien équipé peut abattre les gargouilles les plus féroces. Son palmarès au combat brille autant que son armure."

# Traduction IA – à relire
#: chance_d20/Class_explanation/0/g-0/24
msgctxt "Chance"
msgid "Thoughts on the Guardian?"
msgstr "Ton avis sur le Gardien ?"

# Traduction IA – à relire
#: chance_d20/Class_explanation/0/g-0/32/s/0
msgctxt "Choix"
msgid "Strong AND shiny? That's the one for me!"
msgstr "Costaud ET brillant ? C'est fait pour moi !"

# Traduction IA – à relire
#: chance_d20/Class_explanation/0/g-0/33/s/0
msgctxt "Choix"
msgid "On second thought, Troubadour is the one for me!"
msgstr "Tout bien réfléchi, le Troubadour, c'est fait pour moi !"

# Traduction IA – à relire
#: chance_d20/Class_explanation/0/g-0/34/s/0
msgctxt "Choix"
msgid "You know... I'm still not sure. What's the last one?"
msgstr "Tu sais... j'hésite encore. C'est quoi, le dernier ?"

# Traduction IA – à relire
#: chance_d20/Class_explanation/0/g-1/0
msgctxt "Chance"
msgid "The Enchanter! The magic-slinging specialist who calls on charms to complete tasks. Shrouded in secrets and itchy cloaks, the Enchanter is a master of the far-off flaming finger."
msgstr "L'Enchanteur ! Spécialiste des sortilèges, il fait appel aux charmes pour accomplir ses tâches. Drapé de secrets et de capes qui grattent, l'Enchanteur est passé maître dans l'art du doigt de feu à longue portée."

# Traduction IA – à relire
#: chance_d20/Class_explanation/0/g-1/8
msgctxt "Chance"
msgid "They are a bit more delicate, opting to avoid obvious agony by staying further back from the brawl."
msgstr "Il est un peu plus fragile, et préfère éviter les souffrances évidentes en restant à l'écart de la mêlée."

# Traduction IA – à relire
#: chance_d20/Class_explanation/0/g-1/16
msgctxt "Chance"
msgid "But don't you think that they aren't good at busting heads! They can spin spells to soften the toughest Heel Troll. Or even summon a sidewinding Slipper Snake."
msgstr "Mais ne va pas croire qu'il ne sait pas fracasser des crânes ! Il peut tisser des sorts pour attendrir le plus coriace des Trolls-Talons. Ou même invoquer un Serpent-Pantoufle tout en ondulations."

# Traduction IA – à relire
#: chance_d20/Class_explanation/0/g-1/24
msgctxt "Chance"
msgid "How does the Enchanter sound to you?"
msgstr "L'Enchanteur, ça te dit quoi ?"

# Traduction IA – à relire
#: chance_d20/Class_explanation/0/g-1/32/s/0
msgctxt "Choix"
msgid "I do love me some magic! The Enchanter it is!"
msgstr "J'adore la magie ! Va pour l'Enchanteur !"

# Traduction IA – à relire
#: chance_d20/Class_explanation/0/g-1/33/s/0
msgctxt "Choix"
msgid "I think the Guardian is the one for me!"
msgstr "Je crois que le Gardien est fait pour moi !"

# Traduction IA – à relire
#: chance_d20/Class_explanation/0/g-1/34/s/0
msgctxt "Choix"
msgid "None of them sound as cool as the Troubadour!"
msgstr "Aucun n'a l'air aussi cool que le Troubadour !"

# Traduction IA – à relire
#: chance_d20/Class_explanation/0/g-1/35/s/0
msgctxt "Choix"
msgid "Can you explain them to me again?"
msgstr "Tu peux me les réexpliquer ?"

# Traduction IA – à relire
#: chance_d20/Class_choice_made/0/0
msgctxt "Chance"
msgid "I'm so excited!"
msgstr "Je suis trop excité !"

# Traduction IA – à relire
#: chance_d20/Class_choice_made/0/8/b/1
msgctxt "Chance"
msgid "The Troubadour! A fantastic character to start your adventures with!"
msgstr "Le Troubadour ! Un personnage fantastique pour débuter tes aventures !"

# Traduction IA – à relire
#: chance_d20/Class_choice_made/0/8/b/9
msgctxt "Chance"
msgid "I hear that Dasha wanted to roll with a Guardian if someone was playing Troubadour."
msgstr "Il paraît que Dasha voulait jouer une Gardienne si quelqu'un prenait le Troubadour."

# Traduction IA – à relire
#: chance_d20/Class_choice_made/0/8/b/20
msgctxt "Chance"
msgid "If you two know each other, I'll invite her!"
msgstr "Si vous vous connaissez, je l'invite !"

# Traduction IA – à relire
#: chance_d20/Class_choice_made/0/8/b/28/b/1
msgctxt "Chance"
msgid "She's not hard to find - right underneath me!"
msgstr "Pas dure à trouver : elle est juste en dessous de moi !"

# Traduction IA – à relire
#: chance_d20/Class_choice_made/0/11/b/1
msgctxt "Chance"
msgid "The Guardian! May your sword find purchase in whatever vile thing comes your way!"
msgstr "Le Gardien ! Puisse ton épée trouver prise sur toute ignominie qui croisera ta route !"

# Traduction IA – à relire
#: chance_d20/Class_choice_made/0/11/b/9
msgctxt "Chance"
msgid "I heard that Jerry wanted to go Apothecary if someone was rolling a Guardian."
msgstr "Il paraît que Jerry voulait jouer un Apothicaire si quelqu'un prenait un Gardien."

# Traduction IA – à relire
#: chance_d20/Class_choice_made/0/11/b/20
msgctxt "Chance"
msgid "If you two know each other, I'll invite him!"
msgstr "Si vous vous connaissez, je l'invite !"

# Traduction IA – à relire
#: chance_d20/Class_choice_made/0/11/b/28/b/1
msgctxt "Chance"
msgid "He's a little guy like me - right inside the desk here!"
msgstr "C'est un petit bonhomme comme moi : il est juste là, dans le bureau !"

# Traduction IA – à relire
#: chance_d20/Class_choice_made/0/14/b/1
msgctxt "Chance"
msgid "The Enchanter it is! Magic will flow and find home in your heart!"
msgstr "Va pour l'Enchanteur ! La magie coulera à flots et trouvera refuge dans ton cœur !"

# Traduction IA – à relire
#: chance_d20/Class_choice_made/0/14/b/9
msgctxt "Chance"
msgid "I heard that Lux wanted to get into G&G more and was thinking of playing a Hotshot."
msgstr "Il paraît que Lux voulait se mettre davantage à G&G et pensait jouer un Canonnier."

# Traduction IA – à relire
#: chance_d20/Class_choice_made/0/14/b/20
msgctxt "Chance"
msgid "If you two know each other, I'll invite them!"
msgstr "Si vous vous connaissez, je l'invite !"

# Traduction IA – à relire
#: chance_d20/Class_choice_made/0/14/b/28/b/1
msgctxt "Chance"
msgid "They are all over the house - bringing radiance to everything they shine on..."
msgstr "Iel est partout dans la maison : à apporter son éclat à tout ce qu'iel illumine..."

# Traduction IA – à relire
#: chance_d20/Class_choice_made/0/17/s/0
msgctxt "Choix"
msgid "When do we get to play?!"
msgstr "On joue quand ?!"

# Traduction IA – à relire
#: chance_d20/Class_choice_made/0/c-0/7
msgctxt "Chance"
msgid "Now that I know who you want to be, it'll take me some time to finish building out the session for you."
msgstr "Maintenant que je sais qui tu veux incarner, il va me falloir un peu de temps pour finir de préparer la séance."

# Traduction IA – à relire
#: chance_d20/Class_choice_made/0/c-0/15
msgctxt "Chance"
msgid "Give me... a day? I should be ready to by then! Anything before that and it's a bit dicey if I'll be ready or not."
msgstr "Laisse-moi... une journée ? Je devrais être prêt d'ici là ! Avant ça, c'est un peu coup de dés si je serai prêt ou pas."

# Traduction IA – à relire
#: chance_d20/Class_choice_made/0/c-0/23/0/s/0
msgctxt "Choix"
msgid "Sounds great! I can't wait!"
msgstr "Super ! J'ai trop hâte !"

# Traduction IA – à relire
#: chance_d20/Class_choice_made/0/c-0/23/1/s/0
msgctxt "Choix"
msgid "A whole day? Can't it be any sooner?"
msgstr "Une journée entière ? Ça peut pas être plus tôt ?"

# Traduction IA – à relire
#: chance_d20/Class_choice_made/0/c-0/23/c-0/7
msgctxt "Chance"
msgid "Me neither! It's been so long since I've played! I'll see you then!"
msgstr "Moi aussi ! Ça fait tellement longtemps que je n'ai pas joué ! À demain !"

# Traduction IA – à relire
#: chance_d20/Class_choice_made/0/c-0/23/c-1/7
msgctxt "Chance"
msgid "These things take time! A great adventure must be crafted!"
msgstr "Ces choses-là prennent du temps ! Une grande aventure, ça se façonne !"

# Traduction IA – à relire
#: chance_d20/Class_choice_made/0/c-0/23/c-1/15
msgctxt "Chance"
msgid "Allow me this time, fair compatriot! I wish to create something worthy of your time!"
msgstr "Accorde-moi ce temps, {{noble compagnon|noble compagne|noble camarade}} ! Je veux créer quelque chose qui soit digne de toi !"

# Traduction IA – à relire
#: chance_d20/Class_choice_made/0/c-0/23/c-1/23/0/s/0
msgctxt "Choix"
msgid "When you put it like that..."
msgstr "Dit comme ça..."

# Traduction IA – à relire
#: chance_d20/Class_choice_made/0/c-0/23/c-1/23/1/s/0
msgctxt "Choix"
msgid "It better be good!"
msgstr "T'as intérêt à ce que ce soit bien !"

# Traduction IA – à relire
#: chance_d20/Class_choice_made/0/c-0/23/c-1/23/c-0/7
msgctxt "Chance"
msgid "Great! Tomorrow, we tell our tale!"
msgstr "Génial ! Demain, nous conterons notre légende !"

# Traduction IA – à relire
#: chance_d20/Class_choice_made/0/c-0/23/c-1/23/c-1/7
msgctxt "Chance"
msgid "Sheesh. No pressure."
msgstr "Oula. Pas de pression."

# Traduction IA – à relire
#: chance_d20/Class_choice_made/0/c-0/23/c-1/23/c-1/18
msgctxt "Chance"
msgid "Don't worry. I'll do my best! It'll be fantastic!"
msgstr "T'inquiète. Je vais faire de mon mieux ! Ce sera fantastique !"

# Traduction IA – à relire
#: chance_d20/Chance_Disappointed/0/6 chance_d20/chance_disappointed_victory_death/0/6
msgctxt "Chance"
msgid "Oh... okay. If you don't want to play, I can't make you."
msgstr "Oh... d'accord. Si tu ne veux pas jouer, je ne peux pas t'y forcer."

# Traduction IA – à relire
#: chance_d20/Chance_Disappointed/0/14
msgctxt "Chance"
msgid "And here I thought I had someone to roll the dice with me."
msgstr "Et moi qui croyais avoir trouvé quelqu'un pour lancer les dés avec moi."

# Traduction IA – à relire
#: chance_d20/Chance_Disappointed/0/22 chance_d20/chance_disappointed_victory_death/0/14
msgctxt "Chance"
msgid "Are you suuuuuuure you don't want to play?"
msgstr "Tu es sûûûûûr{{|e|·e}} de ne pas vouloir jouer ?"

# Traduction IA – à relire
#: chance_d20/Chance_Disappointed/0/30/s/0
msgctxt "Choix"
msgid "I am totally sure."
msgstr "Absolument sûr{{|e|·e}}."

# Traduction IA – à relire
#: chance_d20/Chance_Disappointed/0/31/s/0
msgctxt "Choix"
msgid "I meeean... maybe I was too hasty."
msgstr "Enfiiin... j'ai peut-être été trop {{hâtif|hâtive|hâtif·ve}}."

# Traduction IA – à relire
#: chance_d20/Chance_Disappointed/0/c-1/7 chance_d20/chance_disappointed_victory_death/0/c-1/7
msgctxt "Chance"
msgid "Phew! Thank goodness! I've been putting in a lot of work and I can't wait to show you!"
msgstr "Ouf ! Dieu merci ! J'ai beaucoup bossé et j'ai trop hâte de te montrer !"

# Traduction IA – à relire
#: chance_d20/chance_disappointed_victory_death/0/22/s/0
msgctxt "Choix"
msgid "I don't like failing and I don't like you.."
msgstr "J'aime pas perdre, et je t'aime pas, toi."

# Traduction IA – à relire
#: chance_d20/chance_disappointed_victory_death/0/23/s/0
msgctxt "Choix"
msgid "I mean... maybe I was too hasty."
msgstr "Enfin... j'ai peut-être été trop {{hâtif|hâtive|hâtif·ve}}."

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/11
msgctxt "Chance"
msgid "MY FAITHFUL TRAVELER! You have returned!"
msgstr "{{MON FIDÈLE VOYAGEUR|MA FIDÈLE VOYAGEUSE|ÊTRE FIDÈLE ENTRE TOUS}} ! Te voilà de retour !"

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/19/s/0 chance_d20/Guardian_session/0/15/s/0 chance_d20/Enchant_Session/0/15/s/0
msgctxt "Choix"
msgid "Of course I have! I'm ready to play!"
msgstr "Évidemment ! Je suis {{prêt|prête|prêt·e}} à jouer !"

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/20/s/0
msgctxt "Choix"
msgid "Did you expect me not to?"
msgstr "Tu croyais que je viendrais pas ?"

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/21/s/0
msgctxt "Choix"
msgid "Yeah... I came to tell you I don't wanna play."
msgstr "Ouais... je suis venu{{|e|·e}} te dire que je veux pas jouer."

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/22/s/0
msgctxt "Choix"
msgid "I couldn't stay away from your cute face!"
msgstr "Je pouvais pas rester loin de ta jolie frimousse !"

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/c-0/7
msgctxt "Chance"
msgid "Ever faithful... I knew it."
msgstr "Toujours fidèle... je le savais."

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/c-1/7
msgctxt "Chance"
msgid "I knew you wouldn't let me down. Still, it's nice to know my assessment of you was correct!"
msgstr "Je savais que tu ne me laisserais pas tomber. Mais ça fait quand même plaisir de voir que je t'avais bien jugé{{|e|·e}} !"

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/c-3/13
msgctxt "Chance"
msgid "Flattery won't get you any extra XP. But it might get you some fudged dice rolls. Key word - MIGHT!"
msgstr "La flatterie ne te rapportera pas d'XP en plus. Mais peut-être quelques jets de dés arrangés. Mot-clé : PEUT-ÊTRE !"

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/troub_return_join/0/b/4
msgctxt "Chance"
msgid "And, it looks like our mutual friend Dasha is joining us today!"
msgstr "Et on dirait que notre amie commune Dasha se joint à nous aujourd'hui !"

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/troub_return_join/0/b/12
msgctxt "Dasha"
msgid "I am ready to perform feats of strength with my imagination."
msgstr "Je suis prête à accomplir exploits de force avec mon imagination."

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/troub_return_join/0/b/20
msgctxt "Narrator"
msgid "She claps you on the back just a little too hard."
msgstr "Elle vous donne une tape dans le dos, juste un peu trop fort."

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/troub_return_join/0/b/25
msgctxt "Dasha"
msgid "Do not worry, my friend—Dasha's brain muscles are just as strong as real muscles."
msgstr "Ne t'inquiète pas, {{mon ami|mon amie|mon ami·e}} : muscles du cerveau de Dasha sont aussi forts que vrais muscles."

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/troub_return_join/0/b/33
msgctxt "Dasha"
msgid "You are sure to succeed in your ventures with Guardian Yekaterina Dmitriyevna Petrova at your side."
msgstr "Tu réussiras forcément tes entreprises avec Gardienne Yekaterina Dmitrievna Petrova à tes côtés."

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/troub_return_join/0/b/41
msgctxt "Chance"
msgid "I prefer to call them 'adventures' but to each their own!"
msgstr "Moi, je préfère parler d'« aventures », mais chacun ses goûts !"

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/troub_return_join/0/b/49
msgctxt "Dasha"
msgid "I use Detect Evildoers to find any villains nearby."
msgstr "J'utilise Détection des Malfaisants pour trouver méchants dans les environs."

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/troub_return_join/0/b/57
msgctxt "Chance"
msgid "We haven't started yet my dear, one moment."
msgstr "On n'a pas encore commencé, ma chère, une seconde."

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/troub_return_join/3 chance_d20/Enchant_Session/0/g-0/8/0
msgctxt "Chance"
msgid "Before we start, here's your character sheet!"
msgstr "Avant de commencer, voici ta feuille de personnage !"

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/troub_return_join/11
msgctxt "Chance"
msgid "You will be playing Miles Cypress, a Troubadour from the mean streets of Cantalopia. You have taken up a new home in Dec'or, which is ruled by the House of Knives."
msgstr "Tu vas incarner Miles Cypress, un Troubadour venu des rues mal famées de Cantalopia. Tu as élu domicile à Dec'or, gouvernée par la Maison des Couteaux."

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/troub_return_join/19/b/4
msgctxt "Dasha"
msgid "I am ready to GROTTO and GARGOYLE!"
msgstr "Je suis prête à GROTTER et à GARGOUILLER !"

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/troub_return_join/22
msgctxt "Chance"
msgid "You start the game with 50 Hit Points. If you reach zero... your adventure ends."
msgstr "Tu commences la partie avec 50 points de vie. Si tu tombes à zéro... ton aventure s'arrête."

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/troub_return_join/30
msgctxt "Chance"
msgid "Don't worry about reading the sheet too much. I'll keep track of your health and letting you know what you can do."
msgstr "Ne te prends pas trop la tête avec la feuille. Je m'occupe de suivre tes points de vie et de te dire ce que tu peux faire."

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/troub_return_join/38
msgctxt "Chance"
msgid "Now tell me... ARE YOU READY???"
msgstr "Maintenant, dis-moi... ES-TU {{PRÊT|PRÊTE|PRÊT·E}} ???"

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/troub_return_join/46/s/0
msgctxt "Choix"
msgid "Let's do this!"
msgstr "C'est parti !"

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/troub_return_join/47/s/0
msgctxt "Choix"
msgid "Ready, Chance!"
msgstr "{{Prêt|Prête|Prêt·e}}, Chance !"

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/troub_return_join/48/s/0
msgctxt "Choix"
msgid "I'm like, 5% excited."
msgstr "Je suis, genre, enthousiaste à 5 %."

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/troub_return_join/c-4/7
msgctxt "Chance"
msgid "Woohoo!"
msgstr "Youhou !"

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/troub_return_join/c-5/7
msgctxt "Chance"
msgid "Time to begin."
msgstr "Que la partie commence."

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/troub_return_join/c-6/7
msgctxt "Chance"
msgid "1/20 - a very impactful chance for a d20 like myself..."
msgstr "1 chance sur 20 : une chance qui en dit long, pour un d20 comme moi..."

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/troub_return_join/c-6/15
msgctxt "Chance"
msgid "I think it's a good omen!"
msgstr "Je crois que c'est un bon présage !"

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/g-0/0
msgctxt "Chance"
msgid "We start our adventure at night. The wind is whistling through the tall trees at the edge of town, carrying with them the smell of pine and possibility."
msgstr "Notre aventure commence de nuit. Le vent siffle entre les grands arbres à l'orée de la ville, porteur d'un parfum de pin et de promesses."

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/g-0/8
msgctxt "Chance"
msgid "Most of the shops in Dec'or have closed for the night, but that doesn't mean the town is asleep. Far from it."
msgstr "La plupart des boutiques de Dec'or ont fermé pour la nuit, mais la ville est loin d'être endormie. Bien au contraire."

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/g-0/16
msgctxt "Chance"
msgid "Near the center of town, right off the cobble stoned path, is the Counter Top Tavern. Music pours from the open windows as you stand on the small wooden stage, having just finished one of your specialty songs."
msgstr "Près du centre-ville, juste à côté du chemin pavé, se trouve la Taverne du Plan de Travail. La musique s'échappe des fenêtres ouvertes ; tu es sur la petite scène en bois, et tu viens de finir l'une de tes chansons fétiches."

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/g-0/24
msgctxt "Chance"
msgid "What are you saying to the crowd?"
msgstr "Que dis-tu à la foule ?"

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/g-0/32/s/0
msgctxt "Choix"
msgid "Um... 'are you not entertained?'"
msgstr "Euh... « Vous n'êtes pas divertis ? »"

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/g-0/33/s/0
msgctxt "Choix"
msgid "WHO'S READY TO ROCK! LET ME HEAR IT, COUNTER TOP!"
msgstr "QUI EST CHAUD POUR DU ROCK ?! FAITES DU BRUIT, LE PLAN DE TRAVAIL !"

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/g-0/c-7/7
msgctxt "Chance"
msgid "I guess that'll work. You're just warming up. It's okay. Let's continue."
msgstr "Bon, j'imagine que ça fera l'affaire. Tu t'échauffes, c'est normal. On continue."

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/g-0/c-8/7
msgctxt "Chance"
msgid "Holy Crit! That's the way to do it! The crowd in the tavern goes WILD! They throw coins at you, all of which you catch in your hands and pocket swiftly."
msgstr "Nom d'un crit ! Ça, c'est comme ça qu'on fait ! La taverne DEVIENT DINGUE ! On te lance des pièces, que tu attrapes toutes au vol avant de les empocher vite fait."

# Traduction IA – à relire
#: chance_d20/Troub_Session/0/g-0/c-8/15
msgctxt "Chance"
msgid "You were worried about how much you would pay for your room, board, and booze. But now, your cup runneth over and you can even afford that health potion you had your eyes on. You gain 10 health!"
msgstr "Tu t'inquiétais de payer ta chambre, tes repas et ta bibine. Mais maintenant, ta coupe déborde, et tu peux même t'offrir la potion de soin qui te faisait de l'œil. Tu gagnes 10 PV !"

# Traduction IA – à relire
#: chance_d20/Troub_part2/0/0/b/4
msgctxt "Dasha"
msgid "Your music is decent. Very good."
msgstr "Ta musique est correcte. Très bien."

# Traduction IA – à relire
#: chance_d20/Troub_part2/0/3
msgctxt "Chance"
msgid "You exit the stage and find your seat at the bar. The bartender slides you a red ale."
msgstr "Tu quittes la scène et t'installes au comptoir. Le tavernier fait glisser une bière rousse vers toi."

# Traduction IA – à relire
#: chance_d20/Troub_part2/0/11/s/0
msgctxt "Choix"
msgid "I try to catch it without looking."
msgstr "J'essaie de l'attraper sans regarder."

# Traduction IA – à relire
#: chance_d20/Troub_part2/0/12/s/0
msgctxt "Choix"
msgid "I toss them a coin for their prompt service."
msgstr "Je lui lance une pièce pour la rapidité du service."

# Traduction IA – à relire
#: chance_d20/Troub_part2/0/c-0/7
msgctxt "Chance"
msgid "You spin around in your seat, hand out in anticipation for the tankard. It slides firmly into your hand."
msgstr "Tu pivotes sur ton tabouret, la main tendue pour accueillir la chope. Elle glisse pile dans ta paume."

# Traduction IA – à relire
#: chance_d20/Troub_part2/0/c-1/7
msgctxt "Chance"
msgid "They catch it and thank you with a simple nod. You know that some meat and cheese will be waiting for you in your room."
msgstr "Il l'attrape et te remercie d'un simple hochement de tête. Tu sais qu'un peu de viande et de fromage t'attendront dans ta chambre."

# Traduction IA – à relire
#: chance_d20/Troub_part2/0/c-1/15/b/4
msgctxt "Dasha"
msgid "I am seated at the bar, enjoying delicious ale and meats, and also cheeses."
msgstr "Je suis assise au comptoir, je déguste délicieuse bière et charcuterie, et aussi fromages."

# Traduction IA – à relire
#: chance_d20/Troub_part2/0/g-0/0
msgctxt "Chance"
msgid "As you sip your drink, a hooded figure sits next to you at the bar. Without looking at you, they simply ask..."
msgstr "Pendant que tu sirotes ta boisson, une silhouette encapuchonnée s'assoit à côté de toi. Sans même te regarder, elle demande simplement..."

# Traduction IA – à relire
#: chance_d20/Troub_part2/0/g-0/8
msgctxt "Chance"
msgid "Can you swing as well as you can sing?"
msgstr "Tu manies l'épée aussi bien que la chansonnette ?"

# Traduction IA – à relire
#: chance_d20/Troub_part2/0/g-0/16/s/0
msgctxt "Choix"
msgid "I punch 'em."
msgstr "Je lui mets un coup de poing."

# Traduction IA – à relire
#: chance_d20/Troub_part2/0/g-0/17/s/0
msgctxt "Choix"
msgid "I try to get a better look at them."
msgstr "J'essaie de mieux la voir."

# Traduction IA – à relire
#: chance_d20/Troub_part2/0/g-0/c-2/7
msgctxt "Chance"
msgid "You... what?"
msgstr "Tu... quoi ?"

# Traduction IA – à relire
#: chance_d20/Troub_part2/0/g-0/c-2/15/b/1
msgctxt "Dasha"
msgid "Oh, we are fighting already? Excellent."
msgstr "Oh, nous combattons déjà ? Excellent."

# Traduction IA – à relire
#: chance_d20/Troub_part2/0/g-0/c-2/18/0/s/0
msgctxt "Choix"
msgid "I punch them. Hard. In the face."
msgstr "Je lui mets un coup de poing. Fort. Dans la figure."

# Traduction IA – à relire
#: chance_d20/Troub_part2/0/g-0/c-3/7
msgctxt "Chance"
msgid "They notice you try to see who they are. They pull their hood closer and slide you a thick gold coin with the stamp of The Butcher Block on it."
msgstr "La silhouette remarque que tu cherches à la dévisager. Elle rabat sa capuche et fait glisser vers toi une épaisse pièce d'or frappée du sceau du Billot."

# Traduction IA – à relire
#: chance_d20/Troub_part2/0/g-1/0/s/0
msgctxt "Choix"
msgid "What's The Butcher Block?"
msgstr "C'est quoi, le Billot ?"

# Traduction IA – à relire
#: chance_d20/Troub_part2/0/g-1/c-4/7
msgctxt "Chance"
msgid "The Butcher Block are the not-so-secret guard of the Knives Monarch. If they have come to you, it is serious business."
msgstr "Le Billot, c'est la garde pas-si-secrète du Monarque des Couteaux. S'ils viennent te trouver, c'est que c'est sérieux."

# Traduction IA – à relire
#: chance_d20/Troub_part2/0/g-1/c-4/15/0/s/0
msgctxt "Choix"
msgid "I pocket the coin without making a big deal of it."
msgstr "J'empoche la pièce l'air de rien."

# Traduction IA – à relire
#: chance_d20/Troub_part2/0/g-1/c-4/15/1/s/0
msgctxt "Choix"
msgid "I ask them \"What do you want with a simple singer?\""
msgstr "Je lui demande : « Que voulez-vous à un simple chanteur ? »"

# Traduction IA – à relire
#: chance_d20/Troub_part2/0/g-2/0
msgctxt "Chance"
msgid "With this, they rise from their seat and they move to the stairs. They pause briefly, making sure to lock eyes with you before ascending the steps."
msgstr "Sur ce, la silhouette se lève et se dirige vers l'escalier. Elle marque une pause, s'assure de croiser ton regard, puis monte les marches."

# Traduction IA – à relire
#: chance_d20/Troub_part2/0/g-2/8
msgctxt "Chance"
msgid "You toss back your drink and you follow. People have noticed the moment and start to whistle and hoot."
msgstr "Tu descends ton verre cul sec et tu la suis. Les clients ont remarqué la scène, et ça siffle et ça hulule."

# Traduction IA – à relire
#: chance_d20/Troub_part2/0/g-2/16/s/0
msgctxt "Choix"
msgid "Why would they be hooting?"
msgstr "Pourquoi ils hululent ?"

# Traduction IA – à relire
#: chance_d20/Troub_part2/0/g-2/17/s/0
msgctxt "Choix"
msgid "They think that... Oh!"
msgstr "Ils pensent que... Oh !"

# Traduction IA – à relire
#: chance_d20/Troub_part2/0/g-2/18/s/0
msgctxt "Choix"
msgid "I give them a thumbs up as I climb the stairs."
msgstr "Je leur fais un pouce levé en montant l'escalier."

# Traduction IA – à relire
#: chance_d20/Troub_part2/0/g-2/c-5/7
msgctxt "Chance"
msgid "The kind of business that happens in the rooms is usually of... a specific nature."
msgstr "Les affaires qui se traitent dans les chambres sont généralement... d'une nature bien particulière."

# Traduction IA – à relire
#: chance_d20/Troub_part2/0/g-2/c-6/7
msgctxt "Chance"
msgid "They sure do! The folks at the Counter Top aren't shy about it, either."
msgstr "Exactement ! Et les habitués du Plan de Travail ne s'en cachent pas, en plus."

# Traduction IA – à relire
#: chance_d20/Troub_part2/0/g-2/c-7/7
msgctxt "Chance"
msgid "You play it up! The whole crowd cheers you on, thinking that your sonic serenade has helped you score."
msgstr "Tu en rajoutes ! Toute la salle t'acclame, persuadée que ta sérénade t'a permis de conclure."

# Traduction IA – à relire
#: chance_d20/Troub_murderhobo/0/0
msgctxt "Chance"
msgid "Um... okay."
msgstr "Euh... d'accord."

# Traduction IA – à relire
#: chance_d20/Troub_murderhobo/0/8
msgctxt "Chance"
msgid "You take a swing at the hooded person and they move so quickly you don't see them behind you. All you feel is the hard hit on the back of your head."
msgstr "Tu frappes la silhouette encapuchonnée, mais elle bouge si vite que tu ne la vois même pas passer derrière toi. Tout ce que tu sens, c'est le coup violent à l'arrière de ton crâne."

# Traduction IA – à relire
#: chance_d20/Troub_murderhobo/0/25/b/1
msgctxt "Chance"
msgid "You feel like you could pass out at any moment. That hit took a lot out of you!"
msgstr "Tu te sens sur le point de t'évanouir. Ce coup t'a vraiment entamé{{|e|·e}} !"

# Traduction IA – à relire
#: chance_d20/Troub_murderhobo/0/28/b/4
msgctxt "Dasha"
msgid "I am beginning to think perhaps violence was not the answer."
msgstr "Je commence à penser que violence n'était peut-être pas la solution."

# Traduction IA – à relire
#: chance_d20/Troub_murderhobo/0/31/s/0
msgctxt "Choix"
msgid "Can I hit them with my barstool? I want to hit them with my barstool."
msgstr "Je peux la frapper avec mon tabouret ? Je veux la frapper avec mon tabouret."

# Traduction IA – à relire
#: chance_d20/Troub_murderhobo/0/32/s/0
msgctxt "Choix"
msgid "That wasn't the best idea, was it?"
msgstr "C'était pas la meilleure idée, hein ?"

# Traduction IA – à relire
#: chance_d20/Troub_murderhobo/0/c-0/7/b/4
msgctxt "Dasha"
msgid "Oh! I have always wanted to hit someone with barstool... I too pick up stool."
msgstr "Oh ! J'ai toujours rêvé de frapper quelqu'un avec tabouret... Moi aussi, je prends tabouret."

# Traduction IA – à relire
#: chance_d20/Troub_murderhobo/0/c-0/10
msgctxt "Chance"
msgid "...sure. You swing at them with the barstool. You feel the cold steel of a blade slide between your ribs. Everything goes black."
msgstr "... d'accord. Tu la frappes avec le tabouret. Tu sens le froid d'une lame qui se glisse entre tes côtes. Tout devient noir."

# Traduction IA – à relire
#: chance_d20/Troub_murderhobo/0/c-0/27/b/1
msgctxt "Chance"
msgid "You pass out on the floor. The last thing you hear are the gasps of the patrons and the scurrying of feet as they flee."
msgstr "Tu t'effondres au sol. Les derniers sons que tu entends sont les cris étouffés des clients et leurs pas précipités tandis qu'ils s'enfuient."

# Traduction IA – à relire
#: chance_d20/Troub_murderhobo/0/c-0/30
msgctxt "Chance"
msgid "You died."
msgstr "Tu meurs."

# Traduction IA – à relire
#: chance_d20/Troub_murderhobo/0/c-1/7
msgctxt "Chance"
msgid "Heh. It's okay! Let's keep going."
msgstr "Hé. C'est pas grave ! On continue."

# Traduction IA – à relire
#: chance_d20/Troub_murderhobo/0/c-1/15
msgctxt "Chance"
msgid "The hooded figure bends over and whispers to you..."
msgstr "La silhouette encapuchonnée se penche et te murmure..."

# Traduction IA – à relire
#: chance_d20/Troub_murderhobo/0/c-1/23
msgctxt "Chance"
msgid "Upstairs! Before the Knives have your head for attacking a member of The Block!"
msgstr "« En haut ! Avant que les Couteaux ne réclament votre tête pour avoir attaqué un membre du Billot ! »"

# Traduction IA – à relire
#: chance_d20/Troub_murderhobo/0/c-1/31
msgctxt "Chance"
msgid "They move quickly to the stairs. It is in this moment that you notice everyone is looking right at you. Some have even moved away."
msgstr "Elle file vers l'escalier. C'est à cet instant que tu remarques que tout le monde te regarde. Certains se sont même écartés."

# Traduction IA – à relire
#: chance_d20/Troub_murderhobo/0/c-1/39/b/4
msgctxt "Dasha"
msgid "Yekaterina is here to fight, not think. You make decision, Troubadour."
msgstr "Yekaterina est là pour combattre, pas pour réfléchir. Toi, tu décides, Troubadour."

# Traduction IA – à relire
#: chance_d20/Troub_murderhobo/0/c-1/42/0/s/0
msgctxt "Choix"
msgid "Can I just... run away?"
msgstr "Je peux juste... m'enfuir ?"

# Traduction IA – à relire
#: chance_d20/Troub_murderhobo/0/c-1/42/1/s/0
msgctxt "Choix"
msgid "I follow the figure up the stairs."
msgstr "Je suis la silhouette dans l'escalier."

# Traduction IA – à relire
#: chance_d20/Troub_murderhobo/0/c-1/42/c-0/7
msgctxt "Chance"
msgid "If you want to..."
msgstr "Si tu veux..."

# Traduction IA – à relire
#: chance_d20/Troub_murderhobo/0/c-1/42/c-0/15/0/s/0
msgctxt "Choix"
msgid "I run away then."
msgstr "Alors je m'enfuis."

# Traduction IA – à relire
#: chance_d20/Troub_run/0/0
msgctxt "Chance"
msgid "Instead of following the figure up the steps, you run for the door."
msgstr "Au lieu de suivre la silhouette dans l'escalier, tu cours vers la porte."

# Traduction IA – à relire
#: chance_d20/Troub_run/0/8
msgctxt "Chance"
msgid "As you do, the hooded figure calls after you -"
msgstr "Au même moment, la silhouette encapuchonnée te crie..."

# Traduction IA – à relire
#: chance_d20/Troub_run/0/16
msgctxt "Chance"
msgid "Let it be known on this day that Miles Cypress is a coward!"
msgstr "« Qu'il soit su en ce jour que Miles Cypress est un lâche ! »"

# Traduction IA – à relire
#: chance_d20/Troub_run/0/24/b/4
msgctxt "Dasha"
msgid "Miles Cypress is also still alive! Is not always bad to be a coward."
msgstr "Miles Cypress est aussi toujours vivant ! Ce n'est pas toujours mauvais, être lâche."

# Traduction IA – à relire
#: chance_d20/Troub_run/0/27
msgctxt "Chance"
msgid "As you run out of town, you hear a bell toll. You know that bell. That is the bell of banishment."
msgstr "Tandis que tu fuis la ville, tu entends une cloche sonner. Tu connais cette cloche. C'est la cloche du bannissement."

# Traduction IA – à relire
#: chance_d20/Troub_run/0/35
msgctxt "Chance"
msgid "It rings when someone has refused to help the monarch. The house of knives has cast you out."
msgstr "Elle sonne quand quelqu'un a refusé d'aider le monarque. La Maison des Couteaux t'a banni{{|e|·e}}."

# Traduction IA – à relire
#: chance_d20/Troub_run/0/43
msgctxt "Chance"
msgid "You can never return again."
msgstr "Tu ne pourras plus jamais revenir."

# Traduction IA – à relire
#: chance_d20/Troub_run/0/51/s/0
msgctxt "Choix"
msgid "Well... that sucked."
msgstr "Bon... c'était nul."

# Traduction IA – à relire
#: chance_d20/Troub_run/0/52/s/0
msgctxt "Choix"
msgid "Wait... what I meant to say is I go up the stairs!"
msgstr "Attends... Je voulais dire que je monte l'escalier !"

# Traduction IA – à relire
#: chance_d20/Troub_run/0/c-1/7
msgctxt "Chance"
msgid "Oh, really? Great! Let's call that a mulligan then."
msgstr "Oh, c'est vrai ? Génial ! On va dire que ça compte pas, alors."

# Traduction IA – à relire
#: chance_d20/Troub_run/0/c-1/15/b/4
msgctxt "Dasha"
msgid "If only life could be so easily redone. This G&G is truly marvelous."
msgstr "Si seulement la vie pouvait se refaire aussi facilement. Ce G&G est vraiment merveilleux."

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/0
msgctxt "Chance"
msgid "At the top of the stairs you see the hooded figure slide into your room. You follow carefully. When you open the door, you see they have pulled their hood back, exposing their face."
msgstr "En haut de l'escalier, tu vois la silhouette se glisser dans ta chambre. Tu la suis prudemment. En ouvrant la porte, tu découvres qu'elle a retiré sa capuche et dévoilé son visage."

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/8
msgctxt "Chance"
msgid "Before you is a gorgeous human. It is disarming. Why would anyone so beautiful cover their face?"
msgstr "Devant toi se tient un être humain d'une beauté sublime. C'est désarmant. Pourquoi quelqu'un d'aussi beau se cacherait-il le visage ?"

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/16/b/4
msgctxt "Dasha"
msgid "Perhaps it is trap... I roll to seduce this beautiful human just to be sure."
msgstr "C'est peut-être piège... Je fais jet de séduction sur ce bel humain, juste pour être sûre."

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/16/b/12
msgctxt "Chance"
msgid "That won't be necessary, Dasha."
msgstr "Ce ne sera pas nécessaire, Dasha."

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/19
msgctxt "Chance"
msgid "They're looking expectantly at you, Miles..."
msgstr "Le bel inconnu te regarde, dans l'expectative, Miles..."

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/27/s/0
msgctxt "Choix"
msgid "They may be beautiful but there's no way they're as hot as you, Chance."
msgstr "C'est peut-être un canon, mais aucune chance que ce soit aussi sexy que toi, Chance."

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/28/s/0
msgctxt "Choix"
msgid "Why did they bring me here?"
msgstr "Pourquoi il m'a amené{{|e|·e}} ici ?"

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/c-0/7
msgctxt "Chance"
msgid "Buttering up the GM does not grant you advantage on skill checks... but it is appreciated."
msgstr "Passer de la pommade au MJ ne donne pas l'avantage aux jets de compétence... mais c'est apprécié."

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/g-0/0
msgctxt "Chance"
msgid "Once you have closed the door they say..."
msgstr "Une fois la porte refermée, il déclare..."

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/g-0/8
msgctxt "Chance"
msgid "\"As a member of The Butcher Block and in direct response to the needs of The House of Knives, we have a task for you.\""
msgstr "« En tant que membre du Billot, et pour répondre directement aux besoins de la Maison des Couteaux, nous avons une mission pour vous. »"

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/g-0/16
msgctxt "Chance"
msgid "\"The Prince of Knives, Nakiri, has been kidnapped. We know that the evil Grand Vasheer has him. They are planning to sacrifice him to their god Cleaver.\""
msgstr "« Le Prince des Couteaux, Nakiri, a été enlevé. Nous savons que le maléfique Grand Vasheer le détient. Ils comptent le sacrifier à leur dieu Couperet. »"

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/g-0/24/b/4
msgctxt "Dasha"
msgid "Sacrifice? This sounds unsafe."
msgstr "Sacrifier ? Ça n'a pas l'air sûr."

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/g-0/27/s/0
msgctxt "Choix"
msgid "Why isn't The Block going after him?"
msgstr "Pourquoi le Billot ne va pas le chercher lui-même ?"

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/g-0/28/s/0
msgctxt "Choix"
msgid "How could I be of any help?"
msgstr "En quoi je pourrais vous être utile ?"

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/g-0/29/s/0
msgctxt "Choix"
msgid "What's in it for me?"
msgstr "Qu'est-ce que j'y gagne ?"

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/g-0/30/s/0
msgctxt "Choix"
msgid "Okay! I'll do it! I'll save the Prince!"
msgstr "D'accord ! Je m'en charge ! Je vais sauver le Prince !"

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/g-0/c-2/7
msgctxt "Chance"
msgid "\"The Block has a mole in our midst. We have not discovered who this person is. Any action to secure the prince would be found out. It would make matters worse.\""
msgstr "« Le Billot a une taupe dans ses rangs. Nous n'avons pas encore découvert de qui il s'agit. Toute action pour secourir le prince serait éventée. Cela ne ferait qu'empirer les choses. »"

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/g-0/c-3/7
msgctxt "Chance"
msgid "\"We believe you know how to get where they are holding the prince without arousing much suspicion. As a musician, you can travel freely.\""
msgstr "« Nous pensons que vous saurez rejoindre l'endroit où ils retiennent le prince sans trop éveiller les soupçons. En tant que musicien, vous voyagez librement. »"

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/g-0/c-3/15
msgctxt "Chance"
msgid "\"They will make the sacrifice at the Great Kitchen Sink Hole tomorrow night! If you state you are visiting family in Cantilopia, no one will suspect you as you move toward the Sink Hole.\""
msgstr "« Ils procéderont au sacrifice au Grand Gouffre de l'Évier demain soir ! Si vous dites que vous rendez visite à votre famille à Cantalopia, personne ne vous soupçonnera en vous voyant approcher du Gouffre. »"

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/g-0/c-4/7
msgctxt "Chance"
msgid "\"The Knives are prepared to take you into their home, where you will live your days as the court musician. Fully funded, of course."
msgstr "« Les Couteaux sont prêts à vous accueillir chez eux, où vous vivrez vos jours en tant que musicien de la cour. Entièrement aux frais de la couronne, bien entendu. »"

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/g-0/c-4/15/b/4
msgctxt "Dasha"
msgid "And what of Yekaterina... perhaps there is full funding for Yekaterina as well?"
msgstr "Et Yekaterina, alors... peut-être que Yekaterina aussi peut être aux frais de couronne ?"

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/g-0/c-4/15/b/12
msgctxt "Chance"
msgid "\"We could always use another blade in the ranks of The Block.\""
msgstr "« Une lame de plus dans les rangs du Billot ne serait pas de refus. »"

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/g-0/c-4/18/0/s/0
msgctxt "Choix"
msgid "Fully funded eh? Sounds great to me!"
msgstr "Aux frais de la couronne, hein ? Ça me va !"

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/g-0/c-4/18/1/s/0
msgctxt "Choix"
msgid "Throw in a new Lyre and you got yourself a deal!"
msgstr "Ajoutez une nouvelle lyre et marché conclu !"

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/g-0/c-4/18/2/s/0
msgctxt "Choix"
msgid "Only if I get to spend a night with you first."
msgstr "Seulement si je passe d'abord une nuit avec vous."

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/g-0/c-4/18/c-0/7
msgctxt "Chance"
msgid "\"I'm glad the terms are to your liking.\""
msgstr "« Je suis ravi que les conditions vous conviennent. »"

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/g-0/c-4/18/c-1/7
msgctxt "Chance"
msgid "\"Of course! A small price to pay for the safety of the Prince.\""
msgstr "« Bien sûr ! C'est un bien petit prix pour la sécurité du Prince. »"

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/g-0/c-4/18/c-2/7
msgctxt "Chance"
msgid "Oh... I mean, maybe after the session?"
msgstr "Oh... enfin, peut-être après la séance ?"

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/g-0/c-4/18/c-2/18
msgctxt "Chance"
msgid "Wait... you meant... you were talking in-game. Heh. Moving on!"
msgstr "Attends... tu voulais dire... tu parlais en jeu. Hé. On continue !"

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/g-0/c-4/18/c-2/26
msgctxt "Chance"
msgid "\"We have made a vow of abstaining until the prince has returned, but after, we may negotiate the terms with more freedom.\""
msgstr "« Nous avons fait vœu d'abstinence jusqu'au retour du prince, mais ensuite, nous pourrons négocier les termes plus librement. »"

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/g-1/0
msgctxt "Chance"
msgid "\"You should rest up. Tomorrow is a big day.\""
msgstr "« Vous devriez vous reposer. Demain sera une grande journée. »"

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/g-1/8
msgctxt "Chance"
msgid "This is so much fun, isn't it?"
msgstr "C'est trop bien, hein ?"

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/g-1/19/b/4
msgctxt "Dasha"
msgid "Yes! I wish to continue."
msgstr "Oui ! Je veux continuer."

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/g-1/22/s/0
msgctxt "Choix"
msgid "It's great because I'm doing it with you!"
msgstr "C'est génial parce que je le fais avec toi !"

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/g-1/23/s/0
msgctxt "Choix"
msgid "You are doing a fantastic job!"
msgstr "Tu fais un boulot fantastique !"

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/g-1/24/s/0
msgctxt "Choix"
msgid "It's strictly okay. The voices are a bit much."
msgstr "C'est juste correct. Les voix, c'est un peu too much."

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/g-1/c-6/7 chance_d20/Troub_Part3/0/g-1/c-7/7
msgctxt "Chance"
msgid "Whoo-hooo!"
msgstr "Youhouuu !"

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/g-1/c-6/18 chance_d20/Troub_Part3/0/g-1/c-7/18
msgctxt "Chance"
msgid "I'm really enjoying myself, too."
msgstr "Moi aussi, je m'amuse vraiment bien."

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/g-1/c-8/7
msgctxt "Chance"
msgid "Oh... I do love the voices though..."
msgstr "Oh... moi, je les adore, les voix..."

# Traduction IA – à relire
#: chance_d20/Troub_Part3/0/g-2/8
msgctxt "Chance"
msgid "Where were we? Right!"
msgstr "On en était où ? Ah oui !"

# Traduction IA – à relire
#: chance_d20/Troub_part4/0/9
msgctxt "Chance"
msgid "You get a full night's rest, and a hearty breakfast. You get a boost of 20 Health for the day!"
msgstr "Tu passes une bonne nuit de sommeil et tu prends un petit-déjeuner copieux. Tu gagnes un bonus de 20 PV pour la journée !"

# Traduction IA – à relire
#: chance_d20/Troub_part4/0/17
msgctxt "Chance"
msgid "You, Troubadour, are ready to go save the Prince."
msgstr "Toi, Troubadour, tu es {{prêt|prête|prêt·e}} à aller sauver le Prince."

# Traduction IA – à relire
#: chance_d20/Troub_part4/0/25/b/4
msgctxt "Dasha"
msgid "Yekaterina will eat a hearty breakfast as well. Breakfast is most important meal of the day."
msgstr "Yekaterina mange aussi petit-déjeuner copieux. Petit-déjeuner est repas le plus important de la journée."

# Traduction IA – à relire
#: chance_d20/Troub_part4/0/25/b/12
msgctxt "Dasha"
msgid "I am ready for action."
msgstr "Je suis prête pour l'action."

# Traduction IA – à relire
#: chance_d20/Troub_part4/0/28
msgctxt "Chance"
msgid "As you head out towards the Great Kitchen Sink Hole, you have a pep in your step and greet the people in the market. They laugh and joke about your performance the night before."
msgstr "En prenant la route du Grand Gouffre de l'Évier, tu marches d'un pas guilleret et salues les gens du marché. Ils rient et plaisantent sur ta prestation de la veille."

# Traduction IA – à relire
#: chance_d20/Troub_part4/0/36
msgctxt "Chance"
msgid "The thought of the Prince of Knives in trouble worries you, and you know you need to make haste."
msgstr "L'idée du Prince des Couteaux en danger t'inquiète, et tu sais que tu dois faire vite."

# Traduction IA – à relire
#: chance_d20/Troub_part4/0/44
msgctxt "Chance"
msgid "You have seen the Prince once before, and the thought of him floods your mind. He is handsome, sharp dressed, and has carved a place in your memory."
msgstr "Tu as déjà vu le Prince une fois, et son souvenir t'envahit. Il est beau, élégant, et il s'est taillé une place dans ta mémoire."

# Traduction IA – à relire
#: chance_d20/Troub_part4/0/52
msgctxt "Chance"
msgid "To sing for him would be a dream come true. To serenade him in private would be... ooo."
msgstr "Chanter pour lui serait un rêve devenu réalité. Lui chanter la sérénade en privé serait... ooh."

# Traduction IA – à relire
#: chance_d20/Troub_part4/0/60
msgctxt "Chance"
msgid "You walk faster at the thought. That pep in your step has become a borderline powerwalk."
msgstr "Cette pensée te fait presser le pas. Ta démarche guillerette frôle maintenant la marche olympique."

# Traduction IA – à relire
#: chance_d20/Troub_part4/0/68
msgctxt "Chance"
msgid "As you walk past the town gates, you notice that two people are behind you. Maybe they are just traveling as well. Still, you can't be too sure."
msgstr "En franchissant les portes de la ville, tu remarques que deux personnes marchent derrière toi. Ce sont peut-être de simples voyageurs. Mais on n'est jamais trop prudent."

# Traduction IA – à relire
#: chance_d20/Troub_part4/0/76
msgctxt "Chance"
msgid "You pass a fork that goes to a neighboring town. They don't turn off. You remember the messenger from last night warning of a mole within the Block."
msgstr "Tu passes une bifurcation qui mène à une ville voisine. Ils ne tournent pas. Tu te souviens que le messager t'a parlé d'une taupe au sein du Billot."

# Traduction IA – à relire
#: chance_d20/Troub_part4/0/84
msgctxt "Chance"
msgid "Could they have found out already? Has your cover been blown?"
msgstr "Auraient-ils déjà découvert quelque chose ? Ta couverture est-elle grillée ?"

# Traduction IA – à relire
#: chance_d20/Troub_part4/0/92 chance_d20/Dodge_b/0/43 chance_d20/Hit_king_b/0/54 chance_d20/Hesitate_b/0/47 chance_d20/Save_partner/0/g-0/49 chance_d20/Enchanter_part2/0/g-3/32 chance_d20/Tool_attack/0/g-1/0 chance_d20/Tool_ask/0/g-1/24 chance_d20/Tool_take/0/g-1/24
msgctxt "Chance"
msgid "What do you do?"
msgstr "Que fais-tu ?"

# Traduction IA – à relire
#: chance_d20/Troub_part4/0/103/s/0
msgctxt "Choix"
msgid "I break from the path to see what they do."
msgstr "Je quitte le chemin pour voir ce qu'ils font."

# Traduction IA – à relire
#: chance_d20/Troub_part4/0/104/s/0
msgctxt "Choix"
msgid "I keep walking. I bet it's nothing."
msgstr "Je continue à marcher. Je parie que c'est rien."

# Traduction IA – à relire
#: chance_d20/Troub_Knobgoblin_battle/0/0
msgctxt "Chance"
msgid "You take a hard right turn into the tall grass field next to you."
msgstr "Tu tournes brusquement à droite, dans le champ d'herbes hautes qui longe la route."

# Traduction IA – à relire
#: chance_d20/Troub_Knobgoblin_battle/0/8
msgctxt "Chance"
msgid "The two people behind you continue on the path."
msgstr "Les deux personnes derrière toi poursuivent leur chemin."

# Traduction IA – à relire
#: chance_d20/Troub_Knobgoblin_battle/0/16
msgctxt "Chance"
msgid "You breathe a sigh of relief. To think, you were just being paranoid."
msgstr "Tu pousses un soupir de soulagement. Dire que tu étais juste parano."

# Traduction IA – à relire
#: chance_d20/Troub_Knobgoblin_battle/0/24/b/4
msgctxt "Dasha"
msgid "They could not handle Yekaterina... my aura of strength has frightened them off."
msgstr "Ils ne faisaient pas le poids face à Yekaterina... mon aura de force les a fait fuir."

# Traduction IA – à relire
#: chance_d20/Troub_Knobgoblin_battle/0/27
msgctxt "Chance"
msgid "But then... you feel the tall grass next to you move."
msgstr "Mais soudain... tu sens les herbes hautes bouger à côté de toi."

# Traduction IA – à relire
#: chance_d20/Troub_Knobgoblin_battle/0/35
msgctxt "Chance"
msgid "You stop, trying to find where the rustle is coming from. That's when you realize, it's coming from all around you."
msgstr "Tu t'arrêtes, cherchant d'où vient le bruissement. C'est là que tu comprends : il vient de partout autour de toi."

# Traduction IA – à relire
#: chance_d20/Troub_Knobgoblin_battle/0/43
msgctxt "Chance"
msgid "Out from the tall grass, you are attacked by a small lizard-thing that bites at you."
msgstr "Des herbes hautes surgit une petite créature, genre lézard, qui tente de te mordre."

# Traduction IA – à relire
#: chance_d20/Troub_Knobgoblin_battle/0/51
msgctxt "Chance"
msgid "\"Snap! Snap snap!\""
msgstr "« Clac ! Clac clac ! »"

# Traduction IA – à relire
#: chance_d20/Troub_Knobgoblin_battle/0/62/s/0
msgctxt "Choix"
msgid "Ahh!! What is that thing?"
msgstr "Aaah !! C'est quoi, ce truc ?"

# Traduction IA – à relire
#: chance_d20/Troub_Knobgoblin_battle/0/c-0/7
msgctxt "Chance"
msgid "It's a Knobgoblin! You can either swing at it with your trusty club, or you can perform a stunning song!"
msgstr "C'est un Gobouton ! Tu peux le frapper avec ton fidèle gourdin, ou lui jouer une chanson étourdissante !"

# Traduction IA – à relire
#: chance_d20/Troub_Knobgoblin_battle/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "I wanna knock this Knobgoblin's knob off!"
msgstr "Je vais faire sauter le bouton de ce Gobouton !"

# Traduction IA – à relire
#: chance_d20/Troub_Knobgoblin_battle/0/c-0/15/1/s/0
msgctxt "Choix"
msgid "Strike up the band! Let's sing it down!"
msgstr "En avant la musique ! On va le terrasser en chanson !"

# Traduction IA – à relire
#: chance_d20/Troub_Knobgoblin_battle/0/c-0/15/2/s/0
msgctxt "Choix"
msgid "Surely it won't hurt that bad!"
msgstr "Ça peut quand même pas faire si mal !"

# Traduction IA – à relire
#: chance_d20/Troub_Knobgoblin_battle/0/c-0/15/c-0/7
msgctxt "Chance"
msgid "You move quick enough to catch the Knobgoblin before it can bite down on your arm. You hit it hard for..."
msgstr "Tu es assez vif pour cueillir le Gobouton avant qu'il ne referme sa mâchoire sur ton bras. Tu le frappes fort et lui infliges..."

# Traduction IA – à relire
#: chance_d20/Troub_Knobgoblin_battle/0/c-0/15/c-0/15
msgctxt "Chance"
msgid "Wow! You CRIT! That tiny thing goes flying! You hear it cry as it crumples amongst the grass."
msgstr "Waouh ! Coup CRITIQUE ! Cette petite chose s'envole ! Tu l'entends couiner en s'écrasant dans l'herbe."

# Traduction IA – à relire
#: chance_d20/Troub_Knobgoblin_battle/0/c-0/15/c-1/7
msgctxt "Chance"
msgid "You find your note and you sing it loud and proud! The Knobgoblin falls to the ground, shocked at your glorious voice!"
msgstr "Tu trouves ta note et tu chantes à pleine voix, haut et fier ! Le Gobouton s'effondre, sidéré par ta voix glorieuse !"

# Traduction IA – à relire
#: chance_d20/Troub_Knobgoblin_battle/0/c-0/15/c-2/7/b/4
msgctxt "Dasha"
msgid "Oh oh oh, it is Yekaterina's turn! I swing my sword, Justice, at this evil creature."
msgstr "Oh oh oh, c'est tour de Yekaterina ! Je frappe cette créature maléfique avec mon épée, Justice."

# Traduction IA – à relire
#: chance_d20/Troub_Knobgoblin_battle/0/c-0/15/c-2/7/b/12
msgctxt "Chance"
msgid "Okay, give me a roll."
msgstr "D'accord, lance-moi un dé."

# Traduction IA – à relire
#: chance_d20/Troub_Knobgoblin_battle/0/c-0/15/c-2/7/b/28
msgctxt "Dasha"
msgid "The number is high. I hit it, correct?"
msgstr "Le nombre est grand. Je le touche, c'est ça ?"

# Traduction IA – à relire
#: chance_d20/Troub_Knobgoblin_battle/0/c-0/15/c-2/7/b/36
msgctxt "Chance"
msgid "You... obliterate that thing!"
msgstr "Tu... pulvérises ce truc !"

# Traduction IA – à relire
#: chance_d20/Troub_Knobgoblin_battle/0/c-0/15/c-2/7/b/44
msgctxt "Chance"
msgid "Maybe I should have made this a bit harder."
msgstr "J'aurais peut-être dû faire un peu plus difficile."

# Traduction IA – à relire
#: chance_d20/Troub_Knobgoblin_battle/0/c-0/15/c-2/10
msgctxt "Chance"
msgid "The Knobgoblin takes a bite out of you for... eeesh. 15 points of health!"
msgstr "Le Gobouton te croque et t'inflige... aïe. 15 points de dégâts !"

# Traduction IA – à relire
#: chance_d20/Troub_Knobgoblin_battle/0/c-0/15/c-2/27/b/1
msgctxt "Chance"
msgid "You aren't sure how many more hits like that you can take!"
msgstr "Tu ne sais pas combien de coups comme ça tu pourras encore encaisser !"

# Traduction IA – à relire
#: chance_d20/Troub_Knobgoblin_battle/0/c-0/15/c-2/30/b/1
msgctxt "Chance"
msgid "Darkness falls over you. You fall in the field with the Prince on your mind. You hope he is safe. But you will never know."
msgstr "Les ténèbres t'engloutissent. Tu t'effondres dans le champ, le Prince en tête. Tu espères qu'il est sain et sauf. Mais tu ne le sauras jamais."

# Traduction IA – à relire
#: chance_d20/Troub_Knobgoblin_battle/0/c-0/15/c-2/33/0/s/0
msgctxt "Choix"
msgid "Oh, hell naw! Gimme that club!"
msgstr "Oh, que nan ! Passe-moi ce gourdin !"

# Traduction IA – à relire
#: chance_d20/Troub_Knobgoblin_battle/0/c-0/15/c-2/33/1/s/0
msgctxt "Choix"
msgid "They did what?! I'm letting the vocal fry fly!"
msgstr "Il a fait QUOI ?! Je lâche ma voix la plus éraillée !"

# Traduction IA – à relire
#: chance_d20/Troub_Knobgoblin_battle/0/c-0/15/c-2/33/c-0/7
msgctxt "Chance"
msgid "Anger pulses through you and you swing away! You knock the Knobgoblin on its back and it perishes!"
msgstr "La colère bat dans tes veines et tu frappes à tour de bras ! Tu renverses le Gobouton sur le dos, et il rend l'âme !"

# Traduction IA – à relire
#: chance_d20/Troub_Knobgoblin_battle/0/c-0/15/c-2/33/c-1/7
msgctxt "Chance"
msgid "You belt out your song and they instantly fall down! They are starstruck by your power vocals! They fall to your feet!"
msgstr "Tu entonnes ta chanson à pleins poumons et ils s'effondrent aussitôt ! Ta puissance vocale les a éblouis ! Ils tombent à tes pieds !"

# Traduction IA – à relire
#: chance_d20/Troub_Knobgoblin_battle/0/g-0/0
msgctxt "Chance"
msgid "You are doing really good at this, by the way. I'm having SO MUCH FUN!"
msgstr "Au fait, tu te débrouilles super bien. Je m'amuse TELLEMENT !"

# Traduction IA – à relire
#: chance_d20/Knobgoblin_Victory/0
msgctxt "Chance"
msgid "With the Knobgoblin behind you, you find the main road and head towards the Great Kitchen Sinkhole!"
msgstr "Le Gobouton derrière toi, tu retrouves la grand-route et te diriges vers le Grand Gouffre de l'Évier !"

# Traduction IA – à relire
#: chance_d20/All_is_well/0/0
msgctxt "Chance"
msgid "Your trust for people won out! Soon, they stop and produce a picnic blanket. They are on a date!"
msgstr "Ta confiance en autrui a payé ! Bientôt, les deux voyageurs s'arrêtent et sortent une nappe de pique-nique. C'est un rencard !"

# Traduction IA – à relire
#: chance_d20/All_is_well/0/8/s/0
msgctxt "Choix"
msgid "That's so cute!"
msgstr "Trop mignon !"

# Traduction IA – à relire
#: chance_d20/All_is_well/0/9/s/0
msgctxt "Choix"
msgid "Phew. That's a relief!"
msgstr "Ouf. Quel soulagement !"

# Traduction IA – à relire
#: chance_d20/All_is_well/0/c-0/7/b/4 chance_d20/All_is_well/0/c-1/7/b/4
msgctxt "Dasha"
msgid "It is quite rude not to invite us to join them, and at least offer a sandwich."
msgstr "C'est très impoli de ne pas nous inviter, et de ne même pas offrir sandwich."

# Traduction IA – à relire
#: chance_d20/All_is_well/0/g-0/0
msgctxt "Chance"
msgid "You notice a small Knobgoblin in the grass next to you. You avoided that fight!"
msgstr "Tu remarques un petit Gobouton dans l'herbe, juste à côté de toi. Tu as évité ce combat !"

# Traduction IA – à relire
#: chance_d20/All_is_well/0/g-0/8
msgctxt "Chance"
msgid "You carry on toward the Great Kitchen Sink Hole!"
msgstr "Tu poursuis ta route vers le Grand Gouffre de l'Évier !"

# Traduction IA – à relire
#: chance_d20/Troub_Part5/0/0
msgctxt "Chance"
msgid "The road is packed well and your feet seem to find flight on it."
msgstr "La route est bien tassée, et tes pieds semblent s'y envoler."

# Traduction IA – à relire
#: chance_d20/Troub_Part5/0/8
msgctxt "Chance"
msgid "The sun is high and the warmth of the day is complemented by the smells coming from the woods ahead of you."
msgstr "Le soleil est haut, et la chaleur du jour se mêle aux parfums qui s'échappent des bois devant toi."

# Traduction IA – à relire
#: chance_d20/Troub_Part5/0/16
msgctxt "Chance"
msgid "As you cross into the trees, the canopy above blocks the light from touching much of the forest floor. The coolness of the shade hits your skin and you smile."
msgstr "Quand tu entres sous les arbres, la canopée empêche la lumière d'atteindre une grande partie du sol. La fraîcheur de l'ombre caresse ta peau et tu souris."

# Traduction IA – à relire
#: chance_d20/Troub_Part5/0/24/b/4
msgctxt "Dasha"
msgid "If only we could stay in this beautiful place. It's like painting in my mind."
msgstr "Si seulement nous pouvions rester dans ce bel endroit. C'est comme tableau dans ma tête."

# Traduction IA – à relire
#: chance_d20/Troub_Part5/0/27
msgctxt "Chance"
msgid "You remember what it was like to play your music for the trees. This is where you learned the art of song. From the birds, the bees, the crickets and the chipmunks."
msgstr "Tu te souviens de l'époque où tu jouais ta musique pour les arbres. C'est ici que tu as appris l'art du chant. Auprès des oiseaux, des abeilles, des grillons et des tamias."

# Traduction IA – à relire
#: chance_d20/Troub_Part5/0/35
msgctxt "Chance"
msgid "You don't know what is ahead of you in the kitchen sinkhole. That makes you anxious."
msgstr "Tu ne sais pas ce qui t'attend dans le Gouffre de l'Évier. Ça t'angoisse."

# Traduction IA – à relire
#: chance_d20/Troub_Part5/0/43
msgctxt "Chance"
msgid "You take a moment, letting the breeze push through the trees and over your body. What is on your mind right now?"
msgstr "Tu prends un moment, laissant la brise glisser entre les arbres et sur ton corps. À quoi penses-tu, en cet instant ?"

# Traduction IA – à relire
#: chance_d20/Troub_Part5/0/51/s/0
msgctxt "Choix"
msgid "I don't have much time to waste here. I take in the moment and move on."
msgstr "J'ai pas de temps à perdre ici. Je savoure l'instant et je repars."

# Traduction IA – à relire
#: chance_d20/Troub_Part5/0/52/s/0
msgctxt "Choix"
msgid "Maybe this is a sign. I need to collect myself before moving forward."
msgstr "C'est peut-être un signe. Je dois me ressaisir avant d'aller plus loin."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_a/0
msgctxt "Chance"
msgid "You taste the wind on your tongue and you use it to move you through the woods."
msgstr "Tu goûtes le vent sur ta langue et tu t'en sers pour te propulser à travers les bois."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_a/8
msgctxt "Chance"
msgid "The path turns to go to Cantalopia, but you look around you before pushing through the overgrowth toward The Great Kitchen Sink Hole."
msgstr "Le chemin bifurque vers Cantalopia, mais tu jettes un œil autour de toi avant de t'enfoncer dans les broussailles vers le Grand Gouffre de l'Évier."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_a/16
msgctxt "Chance"
msgid "As you come upon the edge of the woods, you see it."
msgstr "En arrivant à la lisière du bois, tu le vois."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_a/24
msgctxt "Chance"
msgid "The Sink Hole, lined with silver sand and a large black stopper at the bottom."
msgstr "Le Gouffre, tapissé de sable argenté, avec une grosse bonde noire tout au fond."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_a/32
msgctxt "Chance"
msgid "You look around and consider your options. You see that there is only one way through. And that is right in the center. You see the stopper raise up, and a ladder catches your eye. Surely, that is where they are keeping the Prince."
msgstr "Tu regardes autour de toi et tu pèses tes options. Tu constates qu'il n'y a qu'un seul passage. Et il est en plein centre. Tu vois la bonde se soulever, et une échelle attire ton regard. C'est forcément là qu'ils retiennent le Prince."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_a/40
msgctxt "Chance"
msgid "Guards roam back and forth, surely keeping watch for anyone daring enough to save the Prince from them."
msgstr "Des gardes font des allées et venues, sûrement pour guetter quiconque oserait leur arracher le Prince."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_a/48
msgctxt "Chance"
msgid "You think it best to wait until night begins to fall before you make your move."
msgstr "Tu juges plus sage d'attendre la tombée de la nuit avant d'agir."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_a/56
msgctxt "Chance"
msgid "As the sun begins to head over the horizon, causing the silver of the sand to reflect the light in brillant fashion, you decide it is time to make your move."
msgstr "Alors que le soleil glisse vers l'horizon et que le sable argenté renvoie sa lumière avec éclat, tu décides que c'est le moment d'agir."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_a/64
msgctxt "Chance"
msgid "Moving swiftly and using the sand to slide and the light to hide, you reach the stopper with no interactions from any guards."
msgstr "Tu progresses vite, en glissant sur le sable et en te cachant dans la lumière, et tu atteins la bonde sans croiser le moindre garde."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_a/72
msgctxt "Chance"
msgid "As a matter of fact... there are no guards here."
msgstr "D'ailleurs... il n'y a aucun garde ici."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_a/80/b/4
msgctxt "Dasha"
msgid "They must have heard Yekaterina was coming... heheh."
msgstr "Ils ont dû apprendre que Yekaterina arrivait... héhé."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_a/83
msgctxt "Chance"
msgid "You don't have time to consider how strange that might be. You must continue on."
msgstr "Tu n'as pas le temps de t'interroger sur cette étrangeté. Tu dois continuer."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/0
msgctxt "Chance"
msgid "You open your eyes, looking around until you find a stump that is at a good sitting height."
msgstr "Tu ouvres les yeux et regardes autour de toi, jusqu'à trouver une souche à la bonne hauteur pour t'asseoir."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/8
msgctxt "Chance"
msgid "There is an understanding that you must get to the Sink Hole quickly, but you have time and you want to be centered when you get there."
msgstr "Tu sais que tu dois rejoindre le Gouffre rapidement, mais tu as le temps, et tu veux être centré{{|e|·e}} en arrivant là-bas."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/16
msgctxt "Chance"
msgid "Taking out your lyre, you begin to strum. Your fingers pluck the strings softly at first. But then you close your eyes and let the music take you over."
msgstr "Tu sors ta lyre et tu commences à gratter. D'abord, tes doigts pincent doucement les cordes. Puis tu fermes les yeux et laisses la musique t'emporter."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/24
msgctxt "Chance"
msgid "The tune that floats through the air is one you have never played before, but it comes to you as if it were a memory."
msgstr "L'air qui flotte dans l'atmosphère, tu ne l'as jamais joué, et pourtant il te vient comme un souvenir."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/32
msgctxt "Chance"
msgid "Birds and other critters fall silent to listen. The blades of grass seem to lean in toward you. Leaves suspend in air before they fall, just so they can take in the music."
msgstr "Les oiseaux et autres bestioles se taisent pour écouter. Les brins d'herbe semblent se pencher vers toi. Les feuilles restent suspendues en l'air avant de tomber, juste pour profiter de la musique."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/40/b/4
msgctxt "Dasha"
msgid "Mm, Yekaterina will do very sexy and impressive sword dance. So birds and other critters are enchanted by my moves."
msgstr "Mm, Yekaterina fait danse de l'épée très sexy et impressionnante. Pour que oiseaux et autres bestioles soient envoûtés par mes mouvements."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/43
msgctxt "Chance"
msgid "And then, a branch cracks, breaking you from your playing."
msgstr "Et soudain, une branche craque et t'arrache à ta musique."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/51/s/0
msgctxt "Choix"
msgid "I blast an attack in the direction of the sound."
msgstr "J'envoie une attaque dans la direction du bruit."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/52/s/0
msgctxt "Choix"
msgid "I open my eyes, looking for the sound."
msgstr "J'ouvre les yeux et je cherche d'où vient le bruit."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/53/s/0
msgctxt "Choix"
msgid "I yell out, \"Who is there?\""
msgstr "Je crie : « Qui est là ? »"

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/c-0/7/b/4
msgctxt "Dasha"
msgid "I unsheathe Justice, readying my attack."
msgstr "Je dégaine Justice et je prépare mon attaque."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/c-0/10
msgctxt "Chance"
msgid "Your attack rings through the air, hitting a tree and flinging bark all over the place. A hand, fair and adorned with rings, raises out of the brush in surrender."
msgstr "Ton attaque fend l'air, percute un arbre et fait voler l'écorce partout. Une main, délicate et couverte de bagues, se lève hors des fourrés en signe de reddition."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/c-1/7
msgctxt "Chance"
msgid "You see nothing for a moment, as you sit and listen. And then, someone moves from behind a tree."
msgstr "Pendant un moment, tu ne vois rien ; tu restes assis{{|e|·e}} à écouter. Et puis, quelqu'un sort de derrière un arbre."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/c-2/7
msgctxt "Chance"
msgid "Nothing. No response comes from the location the sound was heard. But slowly, from among the trees, a body emerges."
msgstr "Rien. Aucune réponse ne vient de l'endroit d'où provenait le bruit. Mais lentement, d'entre les arbres, une silhouette émerge."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/g-0/3
msgctxt "Chance"
msgid "As the person comes into view, you instantly know who it is. Adorned in jewels befitting of royalty, but clothes set for a hike, the eyes of a powerful royal meet yours."
msgstr "Quand la personne apparaît, tu la reconnais aussitôt. Parée de joyaux dignes d'une reine, mais vêtue pour la randonnée, elle plonge son regard royal et puissant dans le tien."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/g-0/11
msgctxt "Chance"
msgid "The Warrior Queen Sliceilia stands before you, glass magic staff in hand, a smile on her face."
msgstr "La Reine Guerrière Sliceilia se dresse devant toi, bâton magique de verre à la main, le sourire aux lèvres."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/g-0/19
msgctxt "Chance"
msgid "\"Fear not. I come with no harm in my heart.\""
msgstr "« N'ayez crainte. Mon cœur ne vous veut aucun mal. »"

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/g-0/27/s/0
msgctxt "Choix"
msgid "I bow. Instantly. No wait! I kneel!"
msgstr "Je m'incline. Immédiatement. Non, attends ! Je m'agenouille !"

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/g-0/28/s/0
msgctxt "Choix"
msgid "I say \"My Queen.\" Then I... umm..."
msgstr "Je dis « Ma Reine. » Et puis je... euh..."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/g-0/29/s/0
msgctxt "Choix"
msgid "Is..is she hot?"
msgstr "Elle... elle est canon ?"

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/g-0/c-3/7/b/4
msgctxt "Dasha"
msgid "Yekaterina takes respectful knee."
msgstr "Yekaterina pose respectueusement genou à terre."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/g-0/c-3/10
msgctxt "Chance"
msgid "\"Please, stand. Decorum is not needed in this place. We all bow to nature. I shall not have you bow to me presently.\""
msgstr "« Je vous en prie, relevez-vous. Point besoin de protocole en ce lieu. Ici, nous nous inclinons tous devant la nature. Je ne vous laisserai pas vous incliner devant moi. »"

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/g-0/c-4/7
msgctxt "Chance"
msgid "She stops you. \"Do not speak my title or name in this place. I fear the canopy may have ears, and my being here should be kept secret.\""
msgstr "Elle t'arrête. « Ne prononcez ni mon titre ni mon nom en ce lieu. Je crains que la canopée n'ait des oreilles, et ma présence ici doit rester secrète. »"

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/g-0/c-5/7
msgctxt "Chance"
msgid "Smokin'. Like, so hot it's kinda rude, ya know?"
msgstr "Brûlante. Genre, tellement canon que c'en est presque impoli, tu vois ?"

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/g-0/c-5/15/b/4
msgctxt "Dasha"
msgid "Thank you for asking this very important question."
msgstr "Merci d'avoir posé cette question très importante."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/g-0/c-5/18
msgctxt "Chance"
msgid "At any rate, she continues..."
msgstr "Bref, elle poursuit..."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/g-1/0
msgctxt "Chance"
msgid "\"May I ask what brings such a soul as yours to these woods?\""
msgstr "« Puis-je vous demander ce qui amène une âme telle que la vôtre en ces bois ? »"

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/g-1/8/s/0
msgctxt "Choix"
msgid "I'm on my way to save your son."
msgstr "Je suis en route pour sauver votre fils."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/g-1/9/s/0
msgctxt "Choix"
msgid "The Great Kitchen Sink Hole is my final destination."
msgstr "Le Grand Gouffre de l'Évier est ma destination finale."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/g-1/10/s/0
msgctxt "Choix"
msgid "Just tryin' to do my hero thing! You know how it is."
msgstr "Je fais juste mon boulot de héros ! Vous savez ce que c'est."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/g-1/c-6/7
msgctxt "Chance"
msgid "\"Ah... wondrous.\""
msgstr "« Ah... merveilleux. »"

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/g-2/0
msgctxt "Chance"
msgid "\"A true hero you will be if you help to save my precious boy.\""
msgstr "« Vous serez {{un véritable héros|une véritable héroïne|une véritable figure héroïque}} si vous aidez à sauver mon précieux garçon. »"

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/g-2/8
msgctxt "Chance"
msgid "\"I have a confession. I did not trust the Butcher Block to have found someone who could accomplish the task. I was going to risk my life to save him.\""
msgstr "« Je dois vous faire un aveu. Je ne croyais pas le Billot capable de trouver quelqu'un à la hauteur de la tâche. J'allais risquer ma vie pour le sauver. »"

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/g-2/16
msgctxt "Chance"
msgid "\"But I have heard your voice and I can tell your magical song, when augmented to cause pain, could cut just as sharply as a blade.\""
msgstr "« Mais j'ai entendu votre voix, et je sais que votre chant magique, s'il était amplifié pour infliger la douleur, pourrait trancher aussi net qu'une lame. »"

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/g-2/24
msgctxt "Chance"
msgid "\"Allow me to accompany you. My crown means nothing without my child. With me by your side, the arcane threads of this world will be at your disposal as well.\""
msgstr "« Permettez-moi de vous accompagner. Ma couronne n'est rien sans mon enfant. Avec moi à vos côtés, les fils arcaniques de ce monde seront eux aussi à votre disposition. »"

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/g-2/32/s/0
msgctxt "Choix"
msgid "Yessss! A sidekick! Let's GOOOO!"
msgstr "Ouiiii ! Un acolyte ! C'est PARTIIII !"

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/g-2/33/s/0
msgctxt "Choix"
msgid "I would be honored to have you by my side."
msgstr "Ce serait un honneur de vous avoir à mes côtés."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/g-2/34/s/0
msgctxt "Choix"
msgid "With all due respect, I'd rather do this alone."
msgstr "Sauf votre respect, je préfère faire ça seul{{|e|·e}}."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/g-2/c-9/10/b/4
msgctxt "Dasha"
msgid "Yes. Sidekick. Yekaterina is main character. Hot Queen, sidekick."
msgstr "Oui. Acolyte. Yekaterina est personnage principal. Reine sexy, acolyte."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/g-2/c-11/7
msgctxt "Chance"
msgid "\"Are you certain? Surely you can see the value in us working together. And I am your Queen. Do not forget my station.\""
msgstr "« En êtes-vous {{certain|certaine|certain·e}} ? Vous voyez sûrement l'intérêt de travailler ensemble. Et je suis votre Reine. N'oubliez pas mon rang. »"

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/g-2/c-11/15/b/4
msgctxt "Dasha"
msgid "Do you truly think we are strong enough to accomplish our mission alone?"
msgstr "Tu crois vraiment que nous sommes assez fortes pour accomplir mission seules ?"

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/g-2/c-11/18/0/s/0
msgctxt "Choix"
msgid "On second thought, your help may be vital in this rescue."
msgstr "Tout bien réfléchi, votre aide pourrait être vitale pour ce sauvetage."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/g-2/c-11/18/1/s/0
msgctxt "Choix"
msgid "I guess I shouldn't defy the Queen, now should I?"
msgstr "Je ne devrais sans doute pas défier la Reine, n'est-ce pas ?"

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/g-2/c-11/18/2/s/0
msgctxt "Choix"
msgid "Do not worry yourself. I will accomplish the task and I will do it well."
msgstr "Ne vous en faites pas. J'accomplirai cette tâche, et je l'accomplirai bien."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/g-2/c-11/18/c-2/7
msgctxt "Chance"
msgid "She studies you for a long moment. Seeing your resolve, she says..."
msgstr "Elle t'observe longuement. Voyant ta détermination, elle dit..."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/g-2/c-11/18/c-2/15
msgctxt "Chance"
msgid "\"Let me aid you in even the smallest of ways.\""
msgstr "« Laissez-moi vous aider, ne serait-ce qu'un tout petit peu. »"

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/g-2/c-11/18/c-2/23
msgctxt "Chance"
msgid "With a wave of her staff, magic pours into you. She grants you an additional 10 health!"
msgstr "D'un geste de son bâton, elle déverse sa magie en toi. Elle t'accorde 10 PV supplémentaires !"

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/g-2/c-11/18/c-2/40/b/4
msgctxt "Dasha"
msgid "Thank you for your kindness."
msgstr "Merci pour ta gentillesse."

# Traduction IA – à relire
#: chance_d20/Troub_Part6_b/0/g-2/c-11/18/c-2/43
msgctxt "Chance"
msgid "You turn from her, heading toward the Sink Hole with a new resolve for your mission."
msgstr "Tu te détournes d'elle et prends la direction du Gouffre, ta détermination renouvelée."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_a/0/0
msgctxt "Chance"
msgid "You lift the stopper to find a metal ladder built into the side of the deep hole that serves as the entrance."
msgstr "Tu soulèves la bonde et découvres une échelle métallique fixée à la paroi du trou profond qui sert d'entrée."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_a/0/8
msgctxt "Chance"
msgid "What you thought would be sand is actually metal on either side. Someone took advantage of the cavern that the sink hole created and made it an evil lair."
msgstr "Ce que tu prenais pour du sable est en fait du métal, des deux côtés. Quelqu'un a profité de la caverne creusée par le gouffre pour en faire un repaire maléfique."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_a/0/16
msgctxt "Chance"
msgid "As you move through the space, you hear voices."
msgstr "En avançant, tu entends des voix."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_a/0/24
msgctxt "Chance"
msgid "You sneak down the halls until you find yourself at the edge of a big open room. You know the voices are coming from in there, but you don't know how many there are. What do you do?"
msgstr "Tu te faufiles dans les couloirs jusqu'au seuil d'une grande salle. Les voix viennent de là, mais tu ne sais pas combien ils sont. Que fais-tu ?"

# Traduction IA – à relire
#: chance_d20/Troub_Part7_a/0/32/s/0
msgctxt "Choix"
msgid "I poke my head in the door to see how many there are."
msgstr "Je passe la tête par la porte pour voir combien ils sont."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_a/0/33/s/0
msgctxt "Choix"
msgid "I don't take any chances. I kick the door in, ready to fight."
msgstr "Je ne prends aucun risque. J'enfonce la porte, {{prêt|prête|prêt·e}} à me battre."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_a/0/34/s/0
msgctxt "Choix"
msgid "I wait to see what they do."
msgstr "J'attends de voir ce qu'ils font."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_a/0/c-0/7
msgctxt "Chance"
msgid "As you push open the door, you realize someone is right behind it. It bumps them."
msgstr "En poussant la porte, tu te rends compte que quelqu'un se tient juste derrière. Elle le cogne."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_a/0/c-0/15
msgctxt "Chance"
msgid "\"Oy! Someone's at the door!\""
msgstr "« Hé ! Y a quelqu'un à la porte ! »"

# Traduction IA – à relire
#: chance_d20/Troub_Part7_a/0/c-0/23
msgctxt "Chance"
msgid "The door flies open, revealing two individuals in the room!"
msgstr "La porte s'ouvre en grand et révèle deux individus dans la salle !"

# Traduction IA – à relire
#: chance_d20/Troub_Part7_a/0/c-0/31/b/4
msgctxt "Dasha"
msgid "Yekaterina is ready for battle!"
msgstr "Yekaterina est prête pour bataille !"

# Traduction IA – à relire
#: chance_d20/Troub_Part7_a/0/c-1/7
msgctxt "Chance"
msgid "You kick the door in, and it SLAMS against a person standing right behind it. They hit the back wall and are knocked out!"
msgstr "Tu enfonces la porte, qui PERCUTE quelqu'un posté juste derrière. Il valdingue contre le mur du fond et tombe assommé !"

# Traduction IA – à relire
#: chance_d20/Troub_Part7_a/0/c-1/15/b/4
msgctxt "Dasha"
msgid "I wish to kill this one, please."
msgstr "Je voudrais tuer celui-là, s'il vous plaît."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_a/0/c-1/18
msgctxt "Chance"
msgid "There's only one guy left in there."
msgstr "Il n'en reste plus qu'un là-dedans."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_a/0/c-2/7
msgctxt "Chance"
msgid "You press your ear against the door. After a minute or two, you hear them leave."
msgstr "Tu colles ton oreille contre la porte. Au bout d'une minute ou deux, tu les entends partir."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_a/0/c-2/15
msgctxt "Chance"
msgid "After another minute or two, you open the door slowly. They are gone. Ahead of you is a path that leads to a hallway pulsing with red glowing energy."
msgstr "Une minute ou deux plus tard, tu ouvres lentement la porte. Ils sont partis. Devant toi, un passage mène à un couloir où palpite une lueur rouge."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_a/0/c-2/23 chance_d20/Troub_indoor_fight_a/0/c-0/34 chance_d20/Troub_indoor_fight_b/0/8/b/58 chance_d20/Troub_indoor_fight_b/0/c-0/34 chance_d20/Troub_indoor_fight_b/0/c-1/18/c-0/42 chance_d20/Troub_indoor_fight_b/0/c-1/18/c-1/61
msgctxt "Chance"
msgid "This must be it! The location of the Prince!"
msgstr "C'est forcément là ! L'endroit où se trouve le Prince !"

# Traduction IA – à relire
#: chance_d20/Troub_Part7_a/0/c-2/31 chance_d20/Troub_indoor_fight_a/0/c-0/42 chance_d20/Troub_indoor_fight_b/0/8/b/66 chance_d20/Troub_indoor_fight_b/0/c-0/42 chance_d20/Troub_indoor_fight_b/0/c-1/18/c-0/50 chance_d20/Troub_indoor_fight_b/0/c-1/18/c-1/69
msgctxt "Chance"
msgid "You sprint past, ready to finish your quest!"
msgstr "Tu fonces, {{prêt|prête|prêt·e}} à achever ta quête !"

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_a/0/0
msgctxt "Chance"
msgid "The one behind the door gets the jump on you, slicing across your chest for..."
msgstr "Celui qui était derrière la porte te prend de vitesse et t'entaille la poitrine pour..."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_a/0/8
msgctxt "Chance"
msgid "Ouch! 25 damage!"
msgstr "Aïe ! 25 points de dégâts !"

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_a/0/19/b/4
msgctxt "Dasha"
msgid "Yekaterina dives in front of Miles in slow motion, shouting 'noooooo!'"
msgstr "Yekaterina plonge devant Miles au ralenti en criant « nooooooon ! »"

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_a/0/19/b/12
msgctxt "Chance"
msgid "You step in front just in time to take the damage. But, you are a healthy Guardian. So it is nothing to you!"
msgstr "Tu t'interposes juste à temps pour encaisser les dégâts. Mais tu es une Gardienne robuste. Pour toi, ce n'est rien !"

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_a/0/19/b/20
msgctxt "Chance"
msgid "You can move at normal speed again, Yekaterina."
msgstr "Tu peux reprendre ta vitesse normale, Yekaterina."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_a/0/31/b/1 chance_d20/Troub_Part7_b/0/c-1/57/b/1 chance_d20/Troub_final_fight_a/0/c-0/23/c-0/40/b/1 chance_d20/Troub_final_fight_a/0/c-2/32/b/1 chance_d20/Save_prince_b/0/68/b/1 chance_d20/Hesitate_b/0/22/b/1
msgctxt "Chance"
msgid "You hold on, but you know there are only so many more hits you can take!"
msgstr "Tu tiens bon, mais tu sais que tu ne pourras plus encaisser beaucoup de coups !"

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_a/0/34/b/1
msgctxt "Chance"
msgid "Darkness falls over you. You fall on the cold floor with the Prince on your mind. You hope he is safe. But you will never know."
msgstr "Les ténèbres t'engloutissent. Tu t'effondres sur le sol froid, le Prince en tête. Tu espères qu'il est sain et sauf. Mais tu ne le sauras jamais."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_a/0/37
msgctxt "Chance"
msgid "The second one runs across the room. You have time to respond before they get to you."
msgstr "Le deuxième traverse la salle en courant. Tu as le temps de réagir avant qu'il t'atteigne."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_a/0/45
msgctxt "Chance"
msgid "You can do a few things. Usually, your Seduction song would be available, but you've pulled aggro, so it won't have an effect."
msgstr "Tu as plusieurs options. D'habitude, tu pourrais utiliser ta chanson de Séduction, mais tu as attiré l'aggro, donc elle n'aura aucun effet."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_a/0/53
msgctxt "Chance"
msgid "But, you have the Eardrum Wrecking song aaaand, Oh! The Confusion Song!"
msgstr "Par contre, tu as la chanson Crève-Tympans eeet, oh ! La Chanson de Confusion !"

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_a/0/61/s/0
msgctxt "Choix"
msgid "Let's destroy those eardrums!"
msgstr "Pulvérisons-leur les tympans !"

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_a/0/62/s/0
msgctxt "Choix"
msgid "Confusion? That sounds chaotic! Let's do that!"
msgstr "Confusion ? Ça a l'air chaotique ! Va pour ça !"

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_a/0/c-0/7 chance_d20/Troub_indoor_fight_b/0/c-0/7
msgctxt "Chance"
msgid "BowowoWOwwowOWowOW! You rock out on the lyre! Both guards crumple before you, unable to stand up to the awesomeness of your rock."
msgstr "BowowoWOwwowOWowOW ! Tu envoies du lourd à la lyre ! Les deux gardes s'effondrent devant toi, incapables de résister à la puissance de ton rock."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_a/0/c-0/15/b/4 chance_d20/Troub_indoor_fight_b/0/c-0/15/b/1
msgctxt "Dasha"
msgid "So it is true that rock music is dangerous..."
msgstr "Donc c'est vrai que musique rock est dangereuse..."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_a/0/c-0/18
msgctxt "Chance"
msgid "They both pass out, your song still ringing in their ears."
msgstr "Ils tombent tous les deux dans les pommes, ta chanson leur résonnant encore dans les oreilles."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_a/0/c-0/26 chance_d20/Troub_indoor_fight_b/0/8/b/50 chance_d20/Troub_indoor_fight_b/0/c-0/26 chance_d20/Troub_indoor_fight_b/0/c-1/18/c-0/34 chance_d20/Troub_indoor_fight_b/0/c-1/18/c-1/53
msgctxt "Chance"
msgid "Ahead of you is a path that leads to a hallway pulsing with red glowing energy."
msgstr "Devant toi, un passage mène à un couloir où palpite une lueur rouge."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_a/0/c-1/7
msgctxt "Chance"
msgid "You pluck your lyre in discordant ways. Both guards stop and listen. They've never heard music like this before. They don't understand it."
msgstr "Tu pinces les cordes de ta lyre de façon discordante. Les deux gardes s'arrêtent et écoutent. Ils n'ont jamais entendu une musique pareille. Ils ne la comprennent pas."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_a/0/c-1/18
msgctxt "Chance"
msgid "Things they don't understand make them mad! How could this be?! Their world starts to fall down around them. They question everything about themselves and, in turn, each other."
msgstr "Et ce qu'ils ne comprennent pas les met en rage ! Comment est-ce possible ?! Leur monde s'écroule autour d'eux. Ils remettent tout en question chez eux-mêmes, et chez l'autre."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_a/0/c-1/26/b/4
msgctxt "Dasha"
msgid "This is what being close-minded gets you."
msgstr "Voilà où mène étroitesse d'esprit."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_a/0/c-1/29
msgctxt "Chance"
msgid "They launch at one another, brawling and bawling, trying to reach the other emotionally, while destroying them physically."
msgstr "Ils se jettent l'un sur l'autre, se bagarrent et sanglotent, essayant de toucher l'autre émotionnellement tout en le démolissant physiquement."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_a/0/c-1/37
msgctxt "Chance"
msgid "Do they kiss? Maybe. They've never done it before. But, nothing they know is true anymore! They most likely kiss. But go RIGHT back to fighting."
msgstr "Est-ce qu'ils s'embrassent ? Peut-être. Ils ne l'ont jamais fait. Mais plus rien de ce qu'ils savaient n'est vrai ! Ils s'embrassent très probablement. Puis ils se remettent AUSSITÔT à se battre."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_a/0/c-1/45/b/4
msgctxt "Dasha"
msgid "This has taken sexy turn I was not prepared for."
msgstr "Ça a pris tournure sexy à laquelle je n'étais pas préparée."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_a/0/c-1/48/0/s/0
msgctxt "Choix"
msgid "Whaaaat is happening?"
msgstr "Qu'est-ce qui se passe ?"

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_a/0/c-1/48/1/s/0
msgctxt "Choix"
msgid "Okay, now I'm confused."
msgstr "Ok, là, je suis perdu{{|e|·e}}."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_a/0/g-0/0
msgctxt "Chance"
msgid "Oh! It's just a song that shatters the world view of the target, causing them to be hostile towards the people or things that upheld these previous beliefs."
msgstr "Oh ! C'est juste une chanson qui fait voler en éclats la vision du monde de la cible, et la rend hostile envers les gens ou les choses qui soutenaient ses anciennes croyances."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_a/0/g-0/8
msgctxt "Chance"
msgid "It's pretty awesome, actually. My favorite spell. Only way to dispel it?"
msgstr "C'est plutôt génial, en fait. Mon sort préféré. Et le seul moyen de le dissiper ?"

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_a/0/g-0/16
msgctxt "Chance"
msgid "Therapy."
msgstr "La thérapie."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_a/0/g-0/24
msgctxt "Chance"
msgid "Hehehe."
msgstr "Hihihi."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_a/0/g-0/32/b/4
msgctxt "Dasha"
msgid "Who among us could not use a little therapy?"
msgstr "Qui parmi nous n'aurait pas besoin d'un peu de thérapie ?"

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_a/0/g-0/35/s/0
msgctxt "Choix"
msgid "Therapy is the most powerful spell of all."
msgstr "La thérapie est le plus puissant de tous les sorts."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_a/0/g-1/0
msgctxt "Chance"
msgid "As those two duke it out on the floor, you can clearly see a hallway with red pulsing energy."
msgstr "Pendant que les deux s'empoignent par terre, tu distingues nettement un couloir où palpite une énergie rouge."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_a/0/g-1/8
msgctxt "Chance"
msgid "This must be it! The Prince has to be there."
msgstr "C'est forcément là ! Le Prince doit s'y trouver."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_a/0/g-1/16
msgctxt "Chance"
msgid "Time to save him and free the Prince."
msgstr "L'heure est venue de délivrer le Prince."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_b/0/0
msgctxt "Chance"
msgid "Seeing his fellow guard knocked out, the other one makes a sprint for you! You have time to respond before he is in range."
msgstr "En voyant son collègue assommé, l'autre garde fonce sur toi ! Tu as le temps de réagir avant qu'il soit à portée."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_b/0/8/b/4
msgctxt "Dasha"
msgid "I wish to pick the last enemy up and throw them across the room."
msgstr "Je veux soulever dernier ennemi et le lancer à travers la salle."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_b/0/8/b/12
msgctxt "Chance"
msgid "Okay, are you throwing them at anything in particular?"
msgstr "D'accord, tu le lances sur quelque chose en particulier ?"

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_b/0/8/b/20
msgctxt "Dasha"
msgid "The wall. If it is possible to throw them through the wall, I will do that."
msgstr "Le mur. Si c'est possible de le lancer à travers le mur, je fais ça."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_b/0/8/b/31
msgctxt "Chance"
msgid "You throw them and they smash their head against the wall. They are knocked out."
msgstr "Tu le lances et il s'écrase la tête contre le mur. Il est assommé."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_b/0/8/b/42
msgctxt "Chance"
msgid "With the guard passed out, you both notice something you hadn't before."
msgstr "Le garde hors d'état de nuire, vous remarquez tous les deux quelque chose qui vous avait échappé."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_b/0/11
msgctxt "Chance"
msgid "Let's see what we've got here on the character sheet."
msgstr "Voyons ce qu'on a sur la feuille de personnage."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_b/0/19
msgctxt "Chance"
msgid "Oh! You have Eardrum Wrecking OR you could use..."
msgstr "Oh ! Tu as Crève-Tympans, OU tu pourrais utiliser..."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_b/0/27
msgctxt "Chance"
msgid "Snakes' Tongue! It's a lying spell!"
msgstr "Langue de Vipère ! C'est un sort de mensonge !"

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_b/0/35/s/0
msgctxt "Choix"
msgid "I wanna destroy those ear drums."
msgstr "Je veux pulvériser ces tympans."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_b/0/36/s/0
msgctxt "Choix"
msgid "Snakes' Tongue! Sssssssounds great!"
msgstr "Langue de Vipère ! Ççççça me plaît !"

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_b/0/c-0/18
msgctxt "Chance"
msgid "The guard passes out, your song still ringing in their ears."
msgstr "Le garde tombe dans les pommes, ta chanson lui résonnant encore dans les oreilles."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_b/0/c-1/7/b/4
msgctxt "Dasha"
msgid "Even fictional lies can be harmful indeed."
msgstr "Même mensonges imaginaires peuvent faire beaucoup de mal."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_b/0/c-1/10
msgctxt "Chance"
msgid "What lie do you want to tell them?"
msgstr "Quel mensonge veux-tu lui raconter ?"

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_b/0/c-1/18/0/s/0
msgctxt "Choix"
msgid "Your passed out friend sold you out!"
msgstr "Ton pote dans les vapes t'a balancé !"

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_b/0/c-1/18/1/s/0
msgctxt "Choix"
msgid "Your spouse has been looking for you!"
msgstr "Ta femme te cherche partout !"

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_b/0/c-1/18/c-0/7
msgctxt "Chance"
msgid "Aaand, he failed his check. HE TOTALLY BELIEVES YOU!"
msgstr "Eeet il rate son jet. IL TE CROIT À FOND !"

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_b/0/c-1/18/c-0/15/b/4
msgctxt "Dasha"
msgid "Fool!"
msgstr "Idiot !"

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_b/0/c-1/18/c-0/18
msgctxt "Chance"
msgid "He says \"What? I knew he wanted that promotion, but to have me killed for it? Dude. That's messed up! I'm telling HR!\""
msgstr "Il dit : « Quoi ? Je savais qu'il voulait cette promotion, mais au point de me faire tuer ? Mec. C'est abusé ! Je vais le dire aux RH ! »"

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_b/0/c-1/18/c-0/26
msgctxt "Chance"
msgid "He throws his sword down and squeezes past you, grumbling the whole way out."
msgstr "Il jette son épée par terre et se faufile devant toi en ronchonnant jusqu'à la sortie."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_b/0/c-1/18/c-1/7
msgctxt "Chance"
msgid "They pause at this."
msgstr "Il marque une pause."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_b/0/c-1/18/c-1/15
msgctxt "Chance"
msgid "\"Wait... are they really? Did I forget something or... \""
msgstr "« Attends... c'est vrai ? J'ai oublié un truc, ou... »"

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_b/0/c-1/18/c-1/23
msgctxt "Chance"
msgid "The color drains from their face."
msgstr "Son visage devient livide."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_b/0/c-1/18/c-1/31
msgctxt "Chance"
msgid "\"OUR ANNIVERSARY! I TOTALLY FORGOT!!!\""
msgstr "« NOTRE ANNIVERSAIRE DE MARIAGE ! J'AI COMPLÈTEMENT OUBLIÉ !!! »"

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_b/0/c-1/18/c-1/42/b/4
msgctxt "Dasha"
msgid "Wow... perhaps you have saved a marriage today."
msgstr "Waouh... tu as peut-être sauvé un mariage aujourd'hui."

# Traduction IA – à relire
#: chance_d20/Troub_indoor_fight_b/0/c-1/18/c-1/45
msgctxt "Chance"
msgid "With that, the guard sprints past you, panic causing them to sweat as they completely abandon their post."
msgstr "Sur ce, le garde file devant toi, en sueur, paniqué, et abandonne complètement son poste."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_b/0/0
msgctxt "Chance"
msgid "The Queen has already scouted the area. As you come to the edge of the woods, you see the silver sands of the Kitchen Sink Hole and she motions with her head to the left of where you are standing."
msgstr "La Reine a déjà repéré les lieux. En arrivant à la lisière du bois, tu aperçois les sables argentés du Gouffre de l'Évier, et elle t'indique d'un mouvement de tête un point sur ta gauche."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_b/0/8
msgctxt "Chance"
msgid "She summons a gust of wind and the loose brush on the ground moves to the side, revealing a trail."
msgstr "Elle invoque une bourrasque, et les broussailles au sol s'écartent, révélant un sentier."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_b/0/16
msgctxt "Chance"
msgid "\"This is how they have moved supplies in and out.\""
msgstr "« C'est par ici qu'ils font entrer et sortir leurs provisions. »"

# Traduction IA – à relire
#: chance_d20/Troub_Part7_b/0/24
msgctxt "Chance"
msgid "Before you can respond, she takes off down the path."
msgstr "Avant que tu puisses répondre, elle s'élance sur le sentier."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_b/0/32/b/4
msgctxt "Dasha"
msgid "We must hurry after her."
msgstr "Nous devons nous dépêcher de la suivre."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_b/0/35
msgctxt "Chance"
msgid "As you follow her, you notice it quickly dips into an unexpected valley. As you round the corner, you see a small group of guards surrounding the mouth of a cave."
msgstr "En la suivant, tu remarques que le sentier plonge vite dans un vallon inattendu. Au détour d'un virage, tu aperçois un petit groupe de gardes postés à l'entrée d'une grotte."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_b/0/43
msgctxt "Chance"
msgid "\"I will follow your lead and support you in your actions. What shall we do?\""
msgstr "« Je suivrai votre exemple et vous soutiendrai dans vos actions. Que faisons-nous ? »"

# Traduction IA – à relire
#: chance_d20/Troub_Part7_b/0/51
msgctxt "Chance"
msgid "Looking at your song list, it looks like you know the songs of SleepyTime, Eardrum Wrecking, and Seduction."
msgstr "D'après ta liste de chansons, tu connais Dodo-Dodo, Crève-Tympans et Séduction."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_b/0/59/s/0
msgctxt "Choix"
msgid "Let's make 'em go Night-Night!"
msgstr "Faisons-leur faire dodo !"

# Traduction IA – à relire
#: chance_d20/Troub_Part7_b/0/60/s/0
msgctxt "Choix"
msgid "Eardrums? I wanna wreck 'em!"
msgstr "Des tympans ? Je veux les crever !"

# Traduction IA – à relire
#: chance_d20/Troub_Part7_b/0/c-0/7
msgctxt "Chance"
msgid "You strum the beginning chords of a Lullaby. The guards hear it, instantly heading towards you. But before they can reach you, they collapse on the ground."
msgstr "Tu grattes les premiers accords d'une berceuse. Les gardes l'entendent et se dirigent aussitôt vers toi. Mais avant de t'atteindre, ils s'effondrent au sol."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_b/0/c-0/15
msgctxt "Chance"
msgid "Queen Sliceilia reaches out with her staff, and roots respond. They wrap around the sleeping guards, holding them to the ground. They aren't going anywhere when they wake up."
msgstr "La Reine Sliceilia tend son bâton, et des racines lui répondent. Elles s'enroulent autour des gardes endormis et les clouent au sol. Ils n'iront nulle part à leur réveil."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_b/0/c-0/26/b/4
msgctxt "Dasha"
msgid "I will remove whatever weapons they hold. That way, they are useless once they awaken."
msgstr "Je vais leur retirer toutes leurs armes. Comme ça, ils seront inutiles à leur réveil."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_b/0/c-0/29
msgctxt "Chance"
msgid "The path to the cave is clear, and you just know this is where you will find the Prince."
msgstr "La voie vers la grotte est libre, et tu sais que c'est là que tu trouveras le Prince."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_b/0/c-1/7
msgctxt "Chance"
msgid "You hold your hand high, strumming the strings of your lyre with the force so strong, the sound waves are visible. One guard falls to his knees. Blood starts oozing from his ears."
msgstr "Tu lèves la main bien haut et grattes les cordes de ta lyre avec une telle force que les ondes sonores deviennent visibles. Un garde tombe à genoux. Du sang commence à lui couler des oreilles."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_b/0/c-1/18
msgctxt "Chance"
msgid "The other one... he's a bit more hardy."
msgstr "L'autre... il est un peu plus coriace."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_b/0/c-1/26/b/4
msgctxt "Dasha"
msgid "Yekaterina unsheathes Justice, raising it up above the hardy one's head."
msgstr "Yekaterina dégaine Justice et la lève au-dessus de la tête du coriace."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_b/0/c-1/26/b/12
msgctxt "Chance"
msgid "Go ahead."
msgstr "Vas-y."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_b/0/c-1/26/b/20
msgctxt "Dasha"
msgid "Thank you. I will bring it down on the guard with all my strength."
msgstr "Merci. Je l'abats sur le garde de toutes mes forces."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_b/0/c-1/26/b/28
msgctxt "Chance"
msgid "You cleave right through them. They fall, having met your steel!"
msgstr "Tu le tranches de part en part. Il s'effondre, terrassé par ton acier !"

# Traduction IA – à relire
#: chance_d20/Troub_Part7_b/0/c-1/26/b/36
msgctxt "Dasha"
msgid "I hope sexy Queen is impressed by Yekaterina's murder."
msgstr "J'espère que Reine sexy est impressionnée par meurtre de Yekaterina."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_b/0/c-1/26/b/44
msgctxt "Chance"
msgid "...when you put it that way..."
msgstr "... dit comme ça..."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_b/0/c-1/26/b/52
msgctxt "Chance"
msgid "Moving on!"
msgstr "On continue !"

# Traduction IA – à relire
#: chance_d20/Troub_Part7_b/0/c-1/26/b/60
msgctxt "Chance"
msgid "The path to the cave is now open!"
msgstr "La voie vers la grotte est maintenant libre !"

# Traduction IA – à relire
#: chance_d20/Troub_Part7_b/0/c-1/29
msgctxt "Chance"
msgid "Running at you, pushing through the sound, he raises his sword, and brings it down in a slash that forces you to stumble back."
msgstr "Il te charge en forçant à travers le son, lève son épée et l'abat dans une taillade qui te fait reculer en titubant."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_b/0/c-1/37
msgctxt "Chance"
msgid "He hits you for... 20 damage!"
msgstr "Il t'inflige... 20 points de dégâts !"

# Traduction IA – à relire
#: chance_d20/Troub_Part7_b/0/c-1/60/b/1
msgctxt "Chance"
msgid "Darkness falls over you. You fall on the cold floor with the prince on your mind. You hope he is safe, but you will never know."
msgstr "Les ténèbres t'engloutissent. Tu t'effondres sur le sol froid, le prince en tête. Tu espères qu'il est sain et sauf, mais tu ne le sauras jamais."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_b/0/g-0/0
msgctxt "Chance"
msgid "Too bad he didn't notice the Queen. She shoves the end of the staff into the guards belly, letting a torrent of flame rip through him. He falls at your feet. This clears the way toward the cave."
msgstr "Dommage pour lui, il n'a pas remarqué la Reine. Elle lui enfonce le bout de son bâton dans le ventre et le traverse d'un torrent de flammes. Il s'effondre à tes pieds. La voie vers la grotte est libre."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_b/0/g-0/9/s/0
msgctxt "Choix"
msgid "Seduction all the way, baby!"
msgstr "Séduction à fond, bébé !"

# Traduction IA – à relire
#: chance_d20/Troub_Part7_b/0/g-0/c-2/7/b/4
msgctxt "Dasha"
msgid "I cover my ears—Yekaterina cannot afford to fall in love."
msgstr "Je me bouche les oreilles : Yekaterina ne peut pas se permettre de tomber amoureuse."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_b/0/g-0/c-2/10
msgctxt "Chance"
msgid "You decided to get sexy with it. Sweet tones come from your lyre and your voice wafts toward the guards. Your song meets the one on the right first."
msgstr "Tu as décidé de jouer la carte sexy. De douces notes s'échappent de ta lyre et ta voix flotte jusqu'aux gardes. Ta chanson atteint d'abord celui de droite."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_b/0/g-0/c-2/18
msgctxt "Chance"
msgid "Their eyes glaze over for a second before becoming wide with something I can only describe as carnal desire."
msgstr "Son regard devient vitreux une seconde, puis ses yeux s'écarquillent sous l'effet de ce que je ne peux décrire que comme un désir charnel."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_b/0/g-0/c-2/26
msgctxt "Chance"
msgid "Then, the one on the left hears your sultry song. And before you can get to the chorus, the two guards are going at it. They fully drop their weapons and just... like, get after it."
msgstr "Puis celui de gauche entend ta chanson langoureuse. Et avant même que tu arrives au refrain, les deux gardes s'y mettent. Ils lâchent carrément leurs armes et... genre, ils se lâchent."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_b/0/g-0/c-2/34
msgctxt "Chance"
msgid "The Queen blushes. She also gives you one of those smiles that lets you know she thinks it's kinda awesome."
msgstr "La Reine rougit. Elle t'adresse aussi un de ces sourires qui te font comprendre qu'elle trouve ça plutôt génial."

# Traduction IA – à relire
#: chance_d20/Troub_Part7_b/0/g-0/c-2/42
msgctxt "Chance"
msgid "\"Don't even think about it, or the King would have your head.\""
msgstr "« N'y songez même pas, ou le Roi aurait votre tête. »"

# Traduction IA – à relire
#: chance_d20/Troub_Part7_b/0/g-0/c-2/50
msgctxt "Chance"
msgid "And with that, she starts to walk toward the cave, right past the two guards making out."
msgstr "Sur ce, elle se dirige vers la grotte, en passant juste à côté des deux gardes qui se bécotent."

# Traduction IA – à relire
#: chance_d20/Troub_Part8_a/0/0
msgctxt "Chance"
msgid "As you step into the hallway, you can feel both energy and heat in the air. Something is afoot."
msgstr "En entrant dans le couloir, tu sens de l'énergie et de la chaleur dans l'air. Il se trame quelque chose."

# Traduction IA – à relire
#: chance_d20/Troub_Part8_a/0/8
msgctxt "Chance"
msgid "And as you turn the corner, you see the Prince... but you also see who you know to be the King!"
msgstr "Et au détour du couloir, tu vois le Prince... mais tu vois aussi quelqu'un que tu reconnais : le Roi !"

# Traduction IA – à relire
#: chance_d20/Troub_Part8_a/0/16/b/4
msgctxt "Dasha"
msgid "Oh, a twist! How exciting!"
msgstr "Oh, un rebondissement ! Comme c'est excitant !"

# Traduction IA – à relire
#: chance_d20/Troub_Part8_a/0/19/s/0
msgctxt "Choix"
msgid "THE KING?!"
msgstr "LE ROI ?!"

# Traduction IA – à relire
#: chance_d20/Troub_Part8_a/0/20/s/0
msgctxt "Choix"
msgid "What is he doing here?!"
msgstr "Qu'est-ce qu'il fait là ?!"

# Traduction IA – à relire
#: chance_d20/Troub_Part8_a/0/21/s/0 chance_d20/Troub_Part8_b/0/g-0/50/s/0
msgctxt "Choix"
msgid "Is he here to save the Prince, too?"
msgstr "Il est venu sauver le Prince, lui aussi ?"

# Traduction IA – à relire
#: chance_d20/Troub_Part8_a/0/c-0/7 chance_d20/Troub_Part8_b/0/g-0/c-3/7
msgctxt "Chance"
msgid "<i>So glad this campaign is going well!</i>"
msgstr "<i>Je suis tellement content que cette campagne se passe bien !</i>"

# Traduction IA – à relire
#: chance_d20/Troub_Part8_a/0/c-2/7 chance_d20/Troub_Part8_b/0/g-0/c-5/7
msgctxt "Chance"
msgid "Mayhap..."
msgstr "Peut-être bien..."

# Traduction IA – à relire
#: chance_d20/Troub_Part8_a/0/c-2/15 chance_d20/Troub_Part8_b/0/g-0/c-5/15
msgctxt "Chance"
msgid "May... may... may... hap."
msgstr "Peut... peut... peut-être... bien."

# Traduction IA – à relire
#: chance_d20/Troub_Part8_a/0/g-0/0
msgctxt "Chance"
msgid "King Cleaver stands before you, stripped of his Royal garb. His muscles are coated with a layer of sweat as he kneels before a bonfire. In a cage to the side of the room is the Prince. A pulsing red energy surrounds the cage."
msgstr "Le Roi Couperet se dresse devant toi, dépouillé de ses habits royaux. Ses muscles luisent de sueur tandis qu'il s'agenouille devant un grand feu. Dans une cage, sur le côté de la salle, se trouve le Prince. Une énergie rouge palpite autour de la cage."

# Traduction IA – à relire
#: chance_d20/Troub_Part8_a/0/g-0/8
msgctxt "Chance"
msgid "The King is mumbling what you can only suspect to be an incantation. But he stops as you fully enter the room."
msgstr "Le Roi marmonne ce qui ne peut être qu'une incantation. Mais il s'interrompt dès que tu entres dans la salle."

# Traduction IA – à relire
#: chance_d20/Troub_Part8_a/0/g-0/16
msgctxt "Chance"
msgid "\"I see some of my Block couldn't leave well enough alone.\""
msgstr "« Je vois que certains membres de mon Billot n'ont pas su laisser les choses en l'état. »"

# Traduction IA – à relire
#: chance_d20/Troub_Part8_a/0/g-0/24
msgctxt "Chance"
msgid "The King rises, towering over you, his back to you as the fire dances on the walls."
msgstr "Le Roi se relève et te domine de toute sa taille, dos à toi, tandis que le feu danse sur les murs."

# Traduction IA – à relire
#: chance_d20/Troub_Part8_a/0/g-0/32
msgctxt "Chance"
msgid "Before I begin, this is where I monologue. I know it's silly but it's what the big bads do. Okay?"
msgstr "Avant de commencer : c'est là que je fais mon monologue. Je sais, c'est bête, mais c'est ce que font les grands méchants. D'accord ?"

# Traduction IA – à relire
#: chance_d20/Troub_Part8_a/0/g-0/40/s/0 chance_d20/Guardian_part8/0/g-2/19/s/0
msgctxt "Choix"
msgid "Go for it!"
msgstr "Vas-y !"

# Traduction IA – à relire
#: chance_d20/Troub_Part8_a/0/g-0/41/s/0
msgctxt "Choix"
msgid "I'm excited because you are excited."
msgstr "Je suis {{excité|excitée|excité·e}} parce que tu es excité."

# Traduction IA – à relire
#: chance_d20/Troub_Part8_a/0/g-0/42/s/0
msgctxt "Choix"
msgid "I'd rather you not."
msgstr "J'aimerais mieux pas."

# Traduction IA – à relire
#: chance_d20/Troub_Part8_a/0/g-0/c-4/7 chance_d20/Troub_Part8_b/0/g-1/c-7/7
msgctxt "Chance"
msgid "Thanks for indulging me."
msgstr "Merci de me faire plaisir."

# Traduction IA – à relire
#: chance_d20/Troub_Part8_a/0/g-0/c-5/7
msgctxt "Chance"
msgid "Oh... okay. Then... I'll skip to the battle."
msgstr "Oh... d'accord. Bon... je passe directement au combat."

# Traduction IA – à relire
#: chance_d20/Troub_Part8_b/0/0
msgctxt "Chance"
msgid "As you enter the cave, you find that it leads towards a metal lined hallway. Red power bounces off the surfaces of the walls and energy and heat push down the tunnel towards you. You start to sweat right away, nervous of what you will find."
msgstr "En entrant dans la grotte, tu découvres qu'elle mène à un couloir tapissé de métal. Une puissance rouge rebondit sur les parois, et l'énergie et la chaleur déferlent vers toi dans le tunnel. Tu te mets aussitôt à transpirer, nerveux{{|se|·se}} à l'idée de ce que tu vas trouver."

# Traduction IA – à relire
#: chance_d20/Troub_Part8_b/0/8
msgctxt "Chance"
msgid "You look over to the Queen. Her face? Stern. Her eyes? Focused. Somehow, the sweat rolling down her face looks complimentary to her features."
msgstr "Tu jettes un œil à la Reine. Son visage ? Sévère. Son regard ? Concentré. Bizarrement, la sueur qui ruisselle sur son visage la met en valeur."

# Traduction IA – à relire
#: chance_d20/Troub_Part8_b/0/16
msgctxt "Chance"
msgid "Suddenly, she stops."
msgstr "Soudain, elle s'arrête."

# Traduction IA – à relire
#: chance_d20/Troub_Part8_b/0/24
msgctxt "Chance"
msgid "\"No... this... isn't right.\""
msgstr "« Non... ce... n'est pas normal. »"

# Traduction IA – à relire
#: chance_d20/Troub_Part8_b/0/32/s/0
msgctxt "Choix"
msgid "What's wrong?"
msgstr "Qu'est-ce qui ne va pas ?"

# Traduction IA – à relire
#: chance_d20/Troub_Part8_b/0/33/s/0
msgctxt "Choix"
msgid "\"Is something the matter here, my Queen?\""
msgstr "« Y a-t-il un problème, ma Reine ? »"

# Traduction IA – à relire
#: chance_d20/Troub_Part8_b/0/34/s/0
msgctxt "Choix"
msgid "You're right. This heat should be criminal."
msgstr "Vous avez raison. Une chaleur pareille devrait être illégale."

# Traduction IA – à relire
#: chance_d20/Troub_Part8_b/0/c-1/7
msgctxt "Chance"
msgid "\"I can sense my son up ahead. But I also feel... We must hurry.\""
msgstr "« Je sens mon fils, plus loin. Mais je sens aussi... Nous devons nous hâter. »"

# Traduction IA – à relire
#: chance_d20/Troub_Part8_b/0/g-0/0
msgctxt "Chance"
msgid "She takes off, her gait widening as she races through the tunnel. You struggle to keep up until you almost run into her as she stops at the mouth of a large room."
msgstr "Elle s'élance à grandes enjambées à travers le tunnel. Tu peines à suivre, et tu manques de lui rentrer dedans quand elle s'arrête à l'entrée d'une grande salle."

# Traduction IA – à relire
#: chance_d20/Troub_Part8_b/0/g-0/8/b/4
msgctxt "Dasha"
msgid "She should be more careful. Blocking the exit is fire hazard."
msgstr "Elle devrait faire plus attention. Bloquer sortie, c'est risque d'incendie."

# Traduction IA – à relire
#: chance_d20/Troub_Part8_b/0/g-0/11
msgctxt "Chance"
msgid "As you look into the room, you see the Prince... but you also see the outline of someone everyone would know."
msgstr "En jetant un œil dans la salle, tu vois le Prince... mais aussi la silhouette de quelqu'un que tout le monde connaît."

# Traduction IA – à relire
#: chance_d20/Troub_Part8_b/0/g-0/19
msgctxt "Chance"
msgid "\"It can't be,\" the Queen says almost to herself. \"Cleaver? Is that you?\""
msgstr "« C'est impossible », souffle la Reine, presque pour elle-même. « Couperet ? C'est toi ? »"

# Traduction IA – à relire
#: chance_d20/Troub_Part8_b/0/g-0/27
msgctxt "Chance"
msgid "\"Hello, my darling...\" the figure rumbles as he kneels in front of a bonfire in the middle of the room. \"The Queen has come to be with her King, yes?\""
msgstr "« Bonsoir, ma chérie... », gronde la silhouette, agenouillée devant un grand feu au milieu de la salle. « La Reine est venue rejoindre son Roi, n'est-ce pas ? »"

# Traduction IA – à relire
#: chance_d20/Troub_Part8_b/0/g-0/35/b/4
msgctxt "Dasha"
msgid "So sexy queen is not single...?"
msgstr "Alors Reine sexy n'est pas célibataire... ?"

# Traduction IA – à relire
#: chance_d20/Troub_Part8_b/0/g-0/41
msgctxt "Chance"
msgid "As the figure stands, you take in King Cleaver, King of the Knives, as flames dance across his face!"
msgstr "Quand la silhouette se relève, tu découvres le Roi Couperet, Roi des Couteaux, les flammes dansant sur son visage !"

# Traduction IA – à relire
#: chance_d20/Troub_Part8_b/0/g-0/49/s/0
msgctxt "Choix"
msgid "What?? The King?"
msgstr "Quoi ?? Le Roi ?"

# Traduction IA – à relire
#: chance_d20/Troub_Part8_b/0/g-0/51/s/0
msgctxt "Choix"
msgid "What in the heckin' heck is he doing here?"
msgstr "Mais qu'est-ce qu'il fiche ici, nom de nom ?"

# Traduction IA – à relire
#: chance_d20/Troub_Part8_b/0/g-1/0
msgctxt "Chance"
msgid "King Cleaver stands before you, stripped of his Royal garb. His muscles are coated with a layer of sweat as he basks in the light of the fire. The Prince, in a cage in the corner of the room, is blocked in by a pulsing red energy surrounding it."
msgstr "Le Roi Couperet se dresse devant toi, dépouillé de ses habits royaux. Ses muscles luisent de sueur à la lueur du feu. Le Prince, enfermé dans une cage dans un coin de la salle, est retenu par une énergie rouge qui palpite tout autour."

# Traduction IA – à relire
#: chance_d20/Troub_Part8_b/0/g-1/8
msgctxt "Chance"
msgid "A low growl escapes the King's mouth. \"You interrupted the incantation. I'll have to start again after you perish.\""
msgstr "Un grondement sourd s'échappe de la bouche du Roi. « Tu as interrompu l'incantation. Je devrai la recommencer après ta mort. »"

# Traduction IA – à relire
#: chance_d20/Troub_Part8_b/0/g-1/16
msgctxt "Chance"
msgid "\"My love... what are you doing? Something is not right with you.\""
msgstr "« Mon amour... que fais-tu ? Quelque chose ne va pas chez toi. »"

# Traduction IA – à relire
#: chance_d20/Troub_Part8_b/0/g-1/24
msgctxt "Chance"
msgid "\"If only you had stayed away, my love. You wouldn't have to witness the work that must be done. You also wouldn't have to die.\""
msgstr "« Si seulement tu étais restée à l'écart, mon amour. Tu n'aurais pas eu à assister à ce qui doit être accompli. Et tu n'aurais pas eu à mourir. »"

# Traduction IA – à relire
#: chance_d20/Troub_Part8_b/0/g-1/32
msgctxt "Chance"
msgid "\"What has possessed my husband to cause him to speak like this?! By what manner of EVIL do you move through this world?\""
msgstr "« Qu'est-ce qui a possédé mon mari pour qu'il parle ainsi ?! Par quel MALÉFICE arpentes-tu ce monde ? »"

# Traduction IA – à relire
#: chance_d20/Troub_Part8_b/0/g-1/40
msgctxt "Chance"
msgid "The King tilts his head, still looking into the flames, and —"
msgstr "Le Roi penche la tête, toujours les yeux rivés sur les flammes, et..."

# Traduction IA – à relire
#: chance_d20/Troub_Part8_b/0/g-1/48
msgctxt "Chance"
msgid "Before I begin, this is where I monologue. I know, it's silly but, I've been working hard on it and I'd love for you to experience your first big bad guy monologue."
msgstr "Avant de commencer : c'est là que je fais mon monologue. Je sais, c'est bête, mais j'ai beaucoup bossé dessus, et j'adorerais que tu vives ton premier monologue de grand méchant."

# Traduction IA – à relire
#: chance_d20/Troub_Part8_b/0/g-1/56/s/0
msgctxt "Choix"
msgid "Monologue away!"
msgstr "Vas-y, monologue !"

# Traduction IA – à relire
#: chance_d20/Troub_Part8_b/0/g-1/57/s/0
msgctxt "Choix"
msgid "I'll do it for you!"
msgstr "Je le fais pour toi !"

# Traduction IA – à relire
#: chance_d20/Troub_Part8_b/0/g-1/58/s/0
msgctxt "Choix"
msgid "Is there a way we can skip it?"
msgstr "Il y a moyen de le passer ?"

# Traduction IA – à relire
#: chance_d20/Troub_Part8_b/0/g-1/c-8/13
msgctxt "Chance"
msgid "Skip it? Yeah... totally. I'll just... let's just get to the battle then, yeah?"
msgstr "Le passer ? Ouais... carrément. Je vais juste... passons directement au combat, alors, d'accord ?"

# Traduction IA – à relire
#: chance_d20/Troub_monologue_a/0 chance_d20/Troub_monologue_b/0
msgctxt "Chance"
msgid "\"Do you know how long this realm has had a king? For millennia. Before history can be noted as beginning, this land has always been ruled by a strong-willed King. And not just any King. The only King.\""
msgstr "« Sais-tu depuis combien de temps ce royaume a un roi ? Depuis des millénaires. Avant même le début de l'Histoire, cette terre a toujours été gouvernée par un Roi à la volonté de fer. Et pas n'importe quel Roi. Le seul et unique Roi. »"

# Traduction IA – à relire
#: chance_d20/Troub_monologue_a/8 chance_d20/Troub_monologue_b/8
msgctxt "Chance"
msgid "\"Me.\""
msgstr "« Moi. »"

# Traduction IA – à relire
#: chance_d20/Troub_monologue_a/16 chance_d20/Troub_monologue_b/16
msgctxt "Chance"
msgid "The King turns around and his face looks hollow in the firelight. His eyes are glowing with a sinister glow."
msgstr "Le Roi se retourne ; à la lueur du feu, son visage paraît creux. Ses yeux brillent d'un éclat sinistre."

# Traduction IA – à relire
#: chance_d20/Troub_monologue_a/24
msgctxt "Chance"
msgid "\"And for millennia, someone in the royal line has vanished. Either at war, or out at sea. Some tragedy has fallen to a young member of the family and the kingdom has mourned for a time. But they have moved on.\""
msgstr "« Et depuis des millénaires, un membre de la lignée royale disparaît. À la guerre, ou en mer. Une tragédie frappe un jeune membre de la famille, le royaume le pleure un temps. Puis il passe à autre chose. »"

# Traduction IA – à relire
#: chance_d20/Troub_monologue_a/32
msgctxt "Chance"
msgid "\"And Queens would die, and Kings would pass of a broken heart. And a new King would take the throne. Always some cousin or uncle from a small parcel of land no one had heard of. Always of humble means. Always young. Always handsome.\""
msgstr "« Et les Reines mouraient, et les Rois s'éteignaient le cœur brisé. Et un nouveau Roi montait sur le trône. Toujours un cousin ou un oncle venu d'un lopin de terre dont personne n'avait entendu parler. Toujours d'humble condition. Toujours jeune. Toujours beau. »"

# Traduction IA – à relire
#: chance_d20/Troub_monologue_a/40 chance_d20/Troub_monologue_b/48
msgctxt "Chance"
msgid "\"Always me.\""
msgstr "« Toujours moi. »"

# Traduction IA – à relire
#: chance_d20/Troub_monologue_a/48 chance_d20/Troub_monologue_b/56
msgctxt "Chance"
msgid "\"And all I have ever needed is the blood of my line to rejuvenate me, and for my inner circle to make sure The Butcher Block failed in their search.\""
msgstr "« Et tout ce dont j'ai toujours eu besoin, c'est du sang de ma lignée pour me régénérer, et de mon cercle rapproché pour s'assurer que les recherches du Billot échouent. »"

# Traduction IA – à relire
#: chance_d20/Troub_monologue_a/56
msgctxt "Chance"
msgid "\"But, I suppose my moles failed to do their job this time. They will have to die, too. After I kill you!\""
msgstr "« Mais il faut croire que mes taupes ont failli à leur tâche, cette fois. Elles devront mourir, elles aussi. Après que je t'aurai tué{{|e|·e}} ! »"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/0 chance_d20/Troub_final_fight_b/0/0
msgctxt "Chance"
msgid "The King launches himself at you! What do you do?"
msgstr "Le Roi se jette sur toi ! Que fais-tu ?"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/8/s/0 chance_d20/Troub_final_fight_b/0/8/s/0
msgctxt "Choix"
msgid "I try to dodge out of the way!"
msgstr "J'essaie d'esquiver !"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/9/s/0
msgctxt "Choix"
msgid "I sing at him! LAAAAAA! LAAAA!!!"
msgstr "Je lui chante dessus ! LAAAAAA ! LAAAA !!!"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/10/s/0 chance_d20/Troub_final_fight_b/0/10/s/0
msgctxt "Choix"
msgid "I dunno! I dunno!"
msgstr "J'en sais rien ! J'en sais rien !"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/7
msgctxt "Chance"
msgid "You move just in time as this royal man tries to slash at you with his claws!"
msgstr "Tu te décales juste à temps : le royal personnage tente de te lacérer de ses griffes !"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/15
msgctxt "Chance"
msgid "You see the Prince in the cage, trying to get out!"
msgstr "Tu vois le Prince dans sa cage, qui essaie de sortir !"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/0/s/0 chance_d20/Troub_final_fight_a/0/c-2/46/0/s/0
msgctxt "Choix"
msgid "I try to break the cage!"
msgstr "J'essaie de briser la cage !"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/1/s/0
msgctxt "Choix"
msgid "I aim a song toward the King instead."
msgstr "Je vise plutôt le Roi avec une chanson."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-0/7 chance_d20/Troub_final_fight_a/0/c-2/46/c-0/7 chance_d20/Save_prince_b/0/0
msgctxt "Chance"
msgid "You position a sonic attack at the cage. You can see the bars vibrate and seem to weaken as the Prince tries to pull them apart. They bend some, but not enough!"
msgstr "Tu diriges une attaque sonore vers la cage. Tu vois les barreaux vibrer et sembler faiblir tandis que le Prince tente de les écarter. Ils plient un peu, mais pas assez !"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-0/15 chance_d20/Troub_final_fight_a/0/c-2/46/c-0/15
msgctxt "Chance"
msgid "With a SMACK on the back of the head, the King connects and hits you for...."
msgstr "Et BAM, un coup derrière la tête : le Roi te touche et t'inflige..."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-0/23 chance_d20/Troub_final_fight_a/0/c-2/46/c-0/23
msgctxt "Chance"
msgid "Only 5 health!"
msgstr "Seulement 5 points de dégâts !"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-0/43/b/4
msgctxt "Chance"
msgid "That small amount will be enough though. Darkness falls over you. You fall on the ground with the Prince on your mind. You hope he can escape. But you will never know."
msgstr "Mais ce petit rien suffit. Les ténèbres t'engloutissent. Tu t'effondres au sol, le Prince en tête. Tu espères qu'il parviendra à s'échapper. Mais tu ne le sauras jamais."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-0/46 chance_d20/Troub_final_fight_a/0/c-2/46/c-0/46
msgctxt "Chance"
msgid "You can tell from your passive perception that you are close to getting him free!"
msgstr "Grâce à ta perception passive, tu sens que tu es tout près de le libérer !"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-0/54/b/4
msgctxt "Dasha"
msgid "I will distract the King by fighting him. Do what you must!"
msgstr "Je vais distraire le Roi en le combattant. Fais ce que tu dois faire !"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-0/57/0/s/0 chance_d20/Troub_final_fight_a/0/c-2/46/c-0/54/0/s/0
msgctxt "Choix"
msgid "Double down on the cage! Let's get him out!"
msgstr "On s'acharne sur la cage ! Sortons-le de là !"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-0/57/c-0/7
msgctxt "Chance"
msgid "Your song flies from your mouth and crashes against the cage. The Prince pulls with all of his strength and pulls the bars far enough apart that he squeezes out."
msgstr "Ta chanson jaillit de ta bouche et s'écrase contre la cage. Le Prince tire de toutes ses forces et écarte suffisamment les barreaux pour se faufiler dehors."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-0/57/c-0/15 chance_d20/Troub_final_fight_a/0/c-2/46/c-0/54/c-0/15 chance_d20/Cage_hit_b/5
msgctxt "Chance"
msgid "As he escapes, he whips a massive lance of arcane energy at the King."
msgstr "En s'échappant, il projette une énorme lance d'énergie arcanique sur le Roi."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-0/57/c-0/23 chance_d20/Troub_final_fight_a/0/c-2/46/c-0/54/c-0/23
msgctxt "Chance"
msgid "With a loud CRACK, it hits him square in the chest! The King lurches back, inches from the tall fire."
msgstr "Dans un grand CRAC, elle le frappe en pleine poitrine ! Le Roi recule en titubant, à quelques centimètres du grand feu."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-0/57/c-0/31/0/s/0 chance_d20/Troub_final_fight_a/0/c-2/46/c-0/54/c-0/31/0/s/0
msgctxt "Choix"
msgid "I let the Prince do the honors."
msgstr "Je laisse au Prince l'honneur de l'achever."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-0/57/c-0/31/1/s/0 chance_d20/Troub_final_fight_a/0/c-2/46/c-0/54/c-0/31/1/s/0
msgctxt "Choix"
msgid "Anyone order roasted royal? I push him in!"
msgstr "Quelqu'un a commandé du rôti royal ? Je le pousse dedans !"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-0/57/c-0/31/c-0/7
msgctxt "Chance"
msgid "The Prince locks eyes with the King and says..."
msgstr "Le Prince plonge son regard dans celui du Roi et dit..."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-0/57/c-0/31/c-0/15
msgctxt "Chance"
msgid "\"Long live the King.\""
msgstr "« Longue vie au Roi. »"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-0/57/c-0/31/c-0/26
msgctxt "Chance"
msgid "Another lance of energy flies across the cavern shoving the king onto the fire."
msgstr "Une autre lance d'énergie traverse la caverne et projette le roi dans le feu."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-0/57/c-0/31/c-0/34
msgctxt "Chance"
msgid "His screams echo in the space. Until they don't. Until all that is left is the panting of a Prince, the sighs you let escape your lips, and the crackle of a fire consuming an evil King."
msgstr "Ses hurlements résonnent dans la salle. Puis ils se taisent. Il ne reste plus que le souffle haletant d'un Prince, les soupirs qui s'échappent de tes lèvres, et le crépitement d'un feu qui consume un Roi maléfique."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-0/57/c-0/31/c-1/7/b/4
msgctxt "Dasha"
msgid "I will get him into position!"
msgstr "Je vais le mettre en position !"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-0/57/c-0/31/c-1/10 chance_d20/Troub_final_fight_a/0/c-2/46/c-0/54/c-0/31/c-1/7
msgctxt "Chance"
msgid "You run over to the edge of the fire, shoving the King into it. Flames erupt around you!"
msgstr "Tu cours jusqu'au bord du feu et tu y pousses le Roi. Les flammes jaillissent autour de toi !"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-0/57/c-0/31/c-1/18 chance_d20/Troub_final_fight_a/0/c-2/46/c-0/54/c-0/31/c-0/34
msgctxt "Chance"
msgid "His screams echo in the space until they don't, until all that is left is the panting of a prince, the sighs you let escape your lips, and the crackle of a fire consuming an evil king."
msgstr "Ses hurlements résonnent dans la salle, puis ils se taisent ; il ne reste plus que le souffle haletant d'un prince, les soupirs qui s'échappent de tes lèvres, et le crépitement d'un feu qui consume un roi maléfique."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/7 chance_d20/Troub_final_fight_a/0/c-1/7 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/7 chance_d20/Hit_king_b/0/0
msgctxt "Chance"
msgid "You whip around and shoot a sonic blast toward the King. It pushes him back, causing him to fly across the room and smack into the wall for...."
msgstr "Tu fais volte-face et tires une déflagration sonore sur le Roi. Elle le repousse, le fait voler à travers la salle et s'écraser contre le mur pour..."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/15 chance_d20/Troub_final_fight_a/0/c-1/15 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/15 chance_d20/Hit_king_b/0/8
msgctxt "Chance"
msgid "You did 40 damage to him!"
msgstr "Tu lui infliges 40 points de dégâts !"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/23 chance_d20/Troub_final_fight_a/0/c-1/23 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/23 chance_d20/Hit_king_b/0/16
msgctxt "Chance"
msgid "And he is stunned!"
msgstr "Et il est étourdi !"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/31/b/4
msgctxt "Dasha"
msgid "I will slash at him as well, while he is stunned."
msgstr "Je le taillade aussi, pendant qu'il est étourdi."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/31/b/12
msgctxt "Chance"
msgid "You bring down your sword on him. He groans in pain as you inflict a massive 53 damage to him!"
msgstr "Tu abats ton épée sur lui. Il grogne de douleur : tu lui infliges 53 points de dégâts, rien que ça !"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/31/b/20
msgctxt "Dasha"
msgid "And he is still alive?"
msgstr "Et il est encore vivant ?"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/31/b/28
msgctxt "Chance"
msgid "He sure is!"
msgstr "Eh oui !"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/31/b/36
msgctxt "Dasha"
msgid "What shall we do next?"
msgstr "Que faisons-nous ensuite ?"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/34 chance_d20/Troub_final_fight_a/0/c-1/31 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/31
msgctxt "Chance"
msgid "You can either help the Prince or try for your ultimate attack!"
msgstr "Tu peux soit aider le Prince, soit tenter ton attaque ultime !"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/0/s/0 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/39/0/s/0
msgctxt "Choix"
msgid "I'll secure the Prince!"
msgstr "Je mets le Prince en sécurité !"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/1/s/0 chance_d20/Troub_final_fight_a/0/c-1/39/0/s/0 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/39/1/s/0
msgctxt "Choix"
msgid "Ultimate attack?! I pick that one!"
msgstr "Attaque ultime ?! Je choisis ça !"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/c-0/7 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/39/c-0/7
msgctxt "Chance"
msgid "You focus another sonic blast at the cage. This time, it's enough, and the Prince is able to escape through the bars."
msgstr "Tu concentres une autre déflagration sonore sur la cage. Cette fois, c'est suffisant : le Prince parvient à s'échapper entre les barreaux."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/c-0/15 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/39/c-0/15
msgctxt "Chance"
msgid "Free of the small space, he can call forth a lance of arcane energy that he uses to hit the King square in the chest!"
msgstr "Libéré de cet espace exigu, il peut invoquer une lance d'énergie arcanique, qu'il envoie en plein dans la poitrine du Roi !"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/c-0/23 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/39/c-0/23
msgctxt "Chance"
msgid "The King lets out a roar, his focus no longer on you. He sprints for the Prince!"
msgstr "Le Roi pousse un rugissement ; il ne s'intéresse plus à toi. Il fonce sur le Prince !"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/c-0/31/0/s/0 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/39/c-0/31/0/s/0
msgctxt "Choix"
msgid "I blast him from where I stand!"
msgstr "Je le pulvérise d'où je suis !"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/c-0/31/1/s/0 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/39/c-0/31/1/s/0
msgctxt "Choix"
msgid "I leap in front of the Prince!"
msgstr "Je me jette devant le Prince !"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/c-0/31/c-0/7 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/39/c-0/31/c-0/7
msgctxt "Chance"
msgid "With a massive leap, the King hurtles toward the Prince. Until -"
msgstr "D'un bond prodigieux, le Roi fond sur le Prince. Jusqu'à ce que..."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/c-0/31/c-0/15 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/39/c-0/31/c-0/15 chance_d20/Enchanter_part2/0/g-0/16
msgctxt "Chance"
msgid "BOOM!"
msgstr "BOUM !"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/c-0/31/c-0/23 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/39/c-0/31/c-0/23
msgctxt "Chance"
msgid "Your sound waves connect with him mid-air, causing him to fly into the fire in the center of the room."
msgstr "Tes ondes sonores le percutent en plein vol et le projettent dans le feu au centre de la salle."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/c-0/31/c-0/34 chance_d20/Troub_final_fight_a/0/c-2/46/c-0/54/c-0/31/c-1/18 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/39/c-0/31/c-0/34
msgctxt "Chance"
msgid "His screams echo in the space. Until they don't. Until all that is left is the panting on a Prince, the sighs you let escape your lips, and the crackle of a fire consuming an evil King."
msgstr "Ses hurlements résonnent dans la salle. Puis ils se taisent. Il ne reste plus que le souffle haletant d'un Prince, les soupirs qui s'échappent de tes lèvres, et le crépitement d'un feu qui consume un Roi maléfique."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/c-0/31/c-1/7/b/4
msgctxt "Dasha"
msgid "You would martyr yourself? Yekaterina is touched by your noble sacrifice."
msgstr "Tu te sacrifierais ? Yekaterina est touchée par ton noble sacrifice."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/c-0/31/c-1/10
msgctxt "Chance"
msgid "...Holy Crit! Um..."
msgstr "... Nom d'un crit ! Euh..."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/c-0/31/c-1/18 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/39/c-0/31/c-1/15
msgctxt "Chance"
msgid "As you heroically leap in front of the Prince, the King comes down upon you. His face is inches from yours and he says -"
msgstr "Tandis que tu te jettes héroïquement devant le Prince, le Roi s'abat sur toi. Son visage à quelques centimètres du tien, il dit..."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/c-0/31/c-1/26 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/39/c-0/31/c-1/23 chance_d20/Troub_hero_b/16
msgctxt "Chance"
msgid "\"At least you will die a hero.\""
msgstr "« Au moins, tu mourras en héros. »"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/c-0/31/c-1/34 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/39/c-0/31/c-1/31 chance_d20/Troub_hero_b/24
msgctxt "Chance"
msgid "And with both his hands threaded together into one demonic fist, he comes crashing down on you for..."
msgstr "Et, les deux mains jointes en un seul poing démoniaque, il l'abat sur toi et t'inflige..."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/c-0/31/c-1/42 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/39/c-0/31/c-1/39 chance_d20/Troub_hero_b/32
msgctxt "Chance"
msgid "...Oh... I'm so sorry."
msgstr "... Oh... je suis vraiment désolé."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/c-0/31/c-1/50 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/39/c-0/31/c-1/47 chance_d20/Troub_hero_b/40
msgctxt "Chance"
msgid "92 damage."
msgstr "92 points de dégâts."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/c-0/31/c-1/58 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/39/c-0/31/c-1/55 chance_d20/Troub_hero_b/48
msgctxt "Chance"
msgid "I rolled a crit..."
msgstr "J'ai fait un crit..."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/c-0/31/c-1/69 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/39/c-0/31/c-1/75 chance_d20/Troub_hero_b/68
msgctxt "Chance"
msgid "You feel the impact. Everything begins to blur. And you die. A hero."
msgstr "Tu sens l'impact. Tout devient flou. Et tu meurs. En héros."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/c-0/31/c-1/77/b/4
msgctxt "Dasha"
msgid "Yekaterina will make sure sexy Queen builds a statue of you."
msgstr "Yekaterina veillera à ce que Reine sexy te construise statue."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/c-0/31/c-1/77/b/12
msgctxt "Dasha"
msgid "Perhaps we will be married in Miles Cypress Memorial Garden."
msgstr "Peut-être que nous nous marierons dans Jardin commémoratif Miles Cypress."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/c-1/7 chance_d20/Troub_final_fight_a/0/c-1/39/c-0/7 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/39/c-1/7 chance_d20/Troub_ultimate_b/0
msgctxt "Chance"
msgid "You close your eyes and your mind goes back to the forest."
msgstr "Tu fermes les yeux, et ton esprit retourne dans la forêt."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/c-1/15 chance_d20/Troub_final_fight_a/0/c-1/39/c-0/15 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/39/c-1/15 chance_d20/Troub_ultimate_b/8
msgctxt "Chance"
msgid "Only this time, you hear the steady growing roar of a river ripping through the landscape."
msgstr "Seulement, cette fois, tu entends le grondement croissant d'une rivière qui déchire le paysage."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/c-1/23 chance_d20/Troub_final_fight_a/0/c-1/39/c-0/23 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/39/c-1/23 chance_d20/Troub_ultimate_b/16
msgctxt "Chance"
msgid "You open your mouth and out comes —"
msgstr "Tu ouvres la bouche, et il en sort..."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/c-1/31 chance_d20/Troub_final_fight_a/0/c-1/39/c-0/31 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/39/c-1/31 chance_d20/Troub_ultimate_b/24
msgctxt "Chance"
msgid "THE SOUND WAVE!"
msgstr "L'ONDE DE CHOC SONORE !"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/c-1/39 chance_d20/Troub_final_fight_a/0/c-1/39/c-0/39 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/39/c-1/39 chance_d20/Troub_ultimate_b/32
msgctxt "Chance"
msgid "The room shakes, and everything rumbles. Sonic fury is pouring out of your mouth and the deluge is monumental. So much so that the sand from the surface begins to seep in."
msgstr "La salle tremble, tout gronde. Une fureur sonique se déverse de ta bouche, en un déluge monumental. À tel point que le sable de la surface commence à s'infiltrer."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/c-1/47 chance_d20/Troub_final_fight_a/0/c-1/39/c-0/47 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/39/c-1/47
msgctxt "Chance"
msgid "The King notices."
msgstr "Le Roi s'en aperçoit."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/c-1/55 chance_d20/Troub_final_fight_a/0/c-1/39/c-0/55 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/39/c-1/55
msgctxt "Chance"
msgid "\"You fool! You will kill us all!\""
msgstr "« Idiot ! Tu vas tous nous tuer ! »"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/c-1/63 chance_d20/Troub_final_fight_a/0/c-1/39/c-0/63 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/39/c-1/63
msgctxt "Chance"
msgid "You hear the falling of metal bars as the cage that held the Prince collapses."
msgstr "Tu entends des barreaux métalliques tomber : la cage qui retenait le Prince s'effondre."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/c-1/71 chance_d20/Troub_final_fight_a/0/c-1/39/c-0/71 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/39/c-1/71
msgctxt "Chance"
msgid "A blast of arcane energy flies from his hand, hitting the King in the chest and staggering him."
msgstr "Une déflagration d'énergie arcanique jaillit de sa main, frappe le Roi en pleine poitrine et le fait chanceler."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/c-1/79 chance_d20/Troub_final_fight_a/0/c-1/39/c-0/79 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/39/c-1/79
msgctxt "Chance"
msgid "The Prince grabs your hand saying, \"Let's go! Before it caves in!\""
msgstr "Le Prince t'attrape la main : « Viens ! Avant que tout s'écroule ! »"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/c-1/87 chance_d20/Troub_final_fight_a/0/c-1/39/c-0/87 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/39/c-1/87
msgctxt "Chance"
msgid "He pulls you past the fire and toward the mouth of a cave. As you run, you can hear the room behind you give way."
msgstr "Il t'entraîne au-delà du feu, vers l'entrée d'une grotte. Pendant que tu cours, tu entends la salle s'effondrer derrière toi."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/c-1/95 chance_d20/Troub_final_fight_a/0/c-1/39/c-0/95 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/39/c-1/95
msgctxt "Chance"
msgid "A roar comes from The King."
msgstr "Le Roi pousse un rugissement."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/c-1/103 chance_d20/Troub_final_fight_a/0/c-1/39/c-0/103 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/39/c-1/103
msgctxt "Chance"
msgid "\"NOOOOOO! I CANNOT DIE HERE!\""
msgstr "« NOOOOOON ! JE NE PEUX PAS MOURIR ICI ! »"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/c-1/114 chance_d20/Troub_final_fight_a/0/c-1/39/c-0/114 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/39/c-1/114
msgctxt "Chance"
msgid "Just as you cross the threshold of the cavern everything behind you collapses."
msgstr "À l'instant même où tu franchis le seuil de la caverne, tout s'effondre derrière toi."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-0/23/c-1/42/c-1/122
msgctxt "Chance"
msgid "You stand outside with the Prince, breathing hard from your sprint. You look back on the collapsed cave. It is silent for a moment. Then, the birds start to sing again... Whew!"
msgstr "Te voilà dehors avec le Prince, à bout de souffle après ce sprint. Tu te retournes vers la grotte effondrée. Un moment de silence. Puis les oiseaux se remettent à chanter... Ouf !"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-1/39/c-0/122 chance_d20/Troub_final_fight_a/0/c-2/46/c-1/39/c-1/122
msgctxt "Chance"
msgid "You stand outside with the Prince, breathing hard from your sprint. You look back on the collapsed cave. It is silent for a moment. Then, the birds start to sing again."
msgstr "Te voilà dehors avec le Prince, à bout de souffle après ce sprint. Tu te retournes vers la grotte effondrée. Un moment de silence. Puis les oiseaux se remettent à chanter."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-2/7 chance_d20/Hesitate_b/0/0
msgctxt "Chance"
msgid "Your hesitation is met with a brutal blow by the King. He hits you for..."
msgstr "Ton hésitation te vaut un coup brutal du Roi. Il t'inflige..."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-2/15 chance_d20/Hesitate_b/0/5 chance_d20/Battle_cry/0/c-0/31
msgctxt "Chance"
msgid "20 damage."
msgstr "20 points de dégâts."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-2/35/b/4 chance_d20/Troub_final_fight_a/0/c-2/46/c-0/43/b/4
msgctxt "Chance"
msgid "Darkness falls over you. You fall on the ground with the Prince on your mind. You hope he can escape. But you will never know."
msgstr "Les ténèbres t'engloutissent. Tu t'effondres au sol, le Prince en tête. Tu espères qu'il parviendra à s'échapper. Mais tu ne le sauras jamais."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-2/38
msgctxt "Chance"
msgid "You get back on your feet. You have a moment before he strikes again."
msgstr "Tu te relèves. Tu as un instant avant qu'il frappe de nouveau."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-2/46/1/s/0
msgctxt "Choix"
msgid "I aim a song toward the King."
msgstr "Je vise le Roi avec une chanson."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-2/46/c-0/40/b/1
msgctxt "Chance"
msgid "You can feel yourself getting weaker with each hit!"
msgstr "Tu te sens faiblir à chaque coup !"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-2/46/c-0/54/c-0/7 chance_d20/Cage_hit_b/0
msgctxt "Chance"
msgid "Your song flies from your mouth and crashes against the cage. The Prince pulls all of his strength and pulls the bars far enough apart that he squeezes out."
msgstr "Ta chanson jaillit de ta bouche et s'écrase contre la cage. Le Prince tire de toutes ses forces et écarte suffisamment les barreaux pour se faufiler dehors."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-2/46/c-0/54/c-0/31/c-0/7
msgctxt "Chance"
msgid "The Prince locks eyes with the King and says -"
msgstr "Le Prince plonge son regard dans celui du Roi et dit..."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-2/46/c-0/54/c-0/31/c-0/15
msgctxt "Chance"
msgid "\"Long live the King\""
msgstr "« Longue vie au Roi. »"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-2/46/c-0/54/c-0/31/c-0/23
msgctxt "Chance"
msgid "Another lance of energy flies across the cavern, shoving the king into the fire."
msgstr "Une autre lance d'énergie traverse la caverne et projette le roi dans le feu."

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_a/0/c-2/46/c-1/39/c-0/31/c-1/7
msgctxt "Chance"
msgid "...Holy Crit!"
msgstr "... Nom d'un crit !"

# Traduction IA – à relire
#: chance_d20/Troub_monologue_b/24
msgctxt "Chance"
msgid "The Queen lets out a gasp and goes to move toward him. Your reflexes kick in before you realize it, and you put up your arm to stop her. She heeds your protest."
msgstr "La Reine étouffe un cri et fait un pas vers lui. Tes réflexes prennent le dessus avant même que tu t'en rendes compte, et tu tends le bras pour l'arrêter. Elle se range à ton avis."

# Traduction IA – à relire
#: chance_d20/Troub_monologue_b/32
msgctxt "Chance"
msgid "\"And for milennia, someone in the royal line has vanished. Either at war, or out at sea. Some tragedy has fallen to a young member of the family and the kingdom has mourned for a time. But they have moved on.\""
msgstr "« Et depuis des millénaires, un membre de la lignée royale disparaît. À la guerre, ou en mer. Une tragédie frappe un jeune membre de la famille, le royaume le pleure un temps. Puis il passe à autre chose. »"

# Traduction IA – à relire
#: chance_d20/Troub_monologue_b/40
msgctxt "Chance"
msgid "\"And Queens would die, and Kings would pass of a broken heart. And a new King would take the throne. Always some cousin or uncle from a small parcel of land no one had heard of. Always on humble means. Always young. Always handsome.\""
msgstr "« Et les Reines mouraient, et les Rois s'éteignaient le cœur brisé. Et un nouveau Roi montait sur le trône. Toujours un cousin ou un oncle venu d'un lopin de terre dont personne n'avait entendu parler. Toujours d'humble condition. Toujours jeune. Toujours beau. »"

# Traduction IA – à relire
#: chance_d20/Troub_monologue_b/64
msgctxt "Chance"
msgid "\"It's a shame we only had one child, my darling. You could have kept the other one. But... I need him, sadly.\""
msgstr "« Quel dommage que nous n'ayons eu qu'un seul enfant, ma chérie. Tu aurais pu garder l'autre. Mais... j'ai besoin de lui, hélas. »"

# Traduction IA – à relire
#: chance_d20/Troub_monologue_b/72
msgctxt "Chance"
msgid "\"I don't suppose you can keep on loving me after this... can you?\" A smile twists across his face."
msgstr "« Je suppose que tu ne pourras plus m'aimer après ça... si ? » Un sourire tordu déforme son visage."

# Traduction IA – à relire
#: chance_d20/Troub_monologue_b/80
msgctxt "Chance"
msgid "\"Absolutely not! I shall never love you again!\""
msgstr "« Certainement pas ! Je ne t'aimerai plus jamais ! »"

# Traduction IA – à relire
#: chance_d20/Troub_monologue_b/88
msgctxt "Chance"
msgid "\"What a pity... I guess you must DIE HERE AS WELL!\""
msgstr "« Quel dommage... Alors tu vas devoir MOURIR ICI, TOI AUSSI ! »"

# Traduction IA – à relire
#: chance_d20/Troub_final_fight_b/0/9/s/0
msgctxt "Choix"
msgid "I sing at him! LAAA!!! LAA!!! DIIIEEE!"
msgstr "Je lui chante dessus ! LAAA !!! LAA !!! CRÈÈÈÈVE !"

# Traduction IA – à relire
#: chance_d20/Dodge_b/0/0
msgctxt "Chance"
msgid "You push off the ground with all your might, flying out of the way just in time before the King comes crashing down where you stood."
msgstr "Tu prends appui sur le sol de toutes tes forces et tu bondis hors de portée juste à temps, avant que le Roi s'écrase là où tu te tenais."

# Traduction IA – à relire
#: chance_d20/Dodge_b/0/8/b/4
msgctxt "Dasha"
msgid "I hold my sword like baseball bat, ready to swing at him."
msgstr "Je tiens mon épée comme batte de baseball, prête à le frapper."

# Traduction IA – à relire
#: chance_d20/Dodge_b/0/8/b/12
msgctxt "Chance"
msgid "He sees the move coming and shifts out of the way."
msgstr "Il voit venir le coup et l'esquive."

# Traduction IA – à relire
#: chance_d20/Dodge_b/0/8/b/20
msgctxt "Dasha"
msgid "Blin! I was ready to hit a home run..."
msgstr "Blin ! J'étais prête à faire home run..."

# Traduction IA – à relire
#: chance_d20/Dodge_b/0/11
msgctxt "Chance"
msgid "WHACK!"
msgstr "VLAN !"

# Traduction IA – à relire
#: chance_d20/Dodge_b/0/19
msgctxt "Chance"
msgid "The Queen lets lightning surge through her staff as she cracks it against the head of her husband."
msgstr "La Reine fait jaillir la foudre de son bâton et l'abat sur le crâne de son mari."

# Traduction IA – à relire
#: chance_d20/Dodge_b/0/27
msgctxt "Chance"
msgid "\"Quickly!\", she yells. \"Get my son!\""
msgstr "« Vite ! », crie-t-elle. « Sauvez mon fils ! »"

# Traduction IA – à relire
#: chance_d20/Dodge_b/0/35
msgctxt "Chance"
msgid "Cleaver turns to her, ready to strike her down with his claws."
msgstr "Couperet se tourne vers elle, prêt à l'abattre de ses griffes."

# Traduction IA – à relire
#: chance_d20/Dodge_b/0/51/b/4
msgctxt "Dasha"
msgid "Whatever you choose Yekaterina will help!"
msgstr "Quoi que tu choisisses, Yekaterina t'aidera !"

# Traduction IA – à relire
#: chance_d20/Dodge_b/0/54/s/0
msgctxt "Choix"
msgid "The Queen gave a command. Save the Prince!"
msgstr "La Reine a donné un ordre. Sauvons le Prince !"

# Traduction IA – à relire
#: chance_d20/Dodge_b/0/55/s/0
msgctxt "Choix"
msgid "The Queen must be protected!"
msgstr "Il faut protéger la Reine !"

# Traduction IA – à relire
#: chance_d20/Save_prince_b/0/8
msgctxt "Chance"
msgid "\"STOP THAT!\" The King calls out toward you."
msgstr "« ARRÊTE ÇA ! », te lance le Roi."

# Traduction IA – à relire
#: chance_d20/Save_prince_b/0/16
msgctxt "Chance"
msgid "You see the shadow of his massive hands start to come down upon you."
msgstr "Tu vois l'ombre de ses mains énormes s'abattre sur toi."

# Traduction IA – à relire
#: chance_d20/Save_prince_b/0/24
msgctxt "Chance"
msgid "The Queen swings at him and..."
msgstr "La Reine frappe et..."

# Traduction IA – à relire
#: chance_d20/Save_prince_b/0/32
msgctxt "Chance"
msgid "She misses!"
msgstr "Elle le rate !"

# Traduction IA – à relire
#: chance_d20/Save_prince_b/0/40
msgctxt "Chance"
msgid "With a SMACK on the back of your head, the King connects and hits you for..."
msgstr "Et BAM, un coup derrière la tête : le Roi te touche et t'inflige..."

# Traduction IA – à relire
#: chance_d20/Save_prince_b/0/48
msgctxt "Chance"
msgid "Only 5 damage!"
msgstr "Seulement 5 points de dégâts !"

# Traduction IA – à relire
#: chance_d20/Save_prince_b/0/65/b/1
msgctxt "Dasha"
msgid "I will not allow you to fall here. I let out my War Cry of Healing."
msgstr "Je ne te laisserai pas tomber ici. Je pousse mon Cri de Guerre Guérisseur."

# Traduction IA – à relire
#: chance_d20/Save_prince_b/0/65/b/9
msgctxt "Chance"
msgid "...it was only 5 health..."
msgstr "... ce n'était que 5 points de dégâts..."

# Traduction IA – à relire
#: chance_d20/Save_prince_b/0/65/b/20
msgctxt "Dasha"
msgid "I do not wish to take any chances... and game feels like it is almost over."
msgstr "Je ne veux prendre aucun risque... et j'ai impression que partie est presque finie."

# Traduction IA – à relire
#: chance_d20/Save_prince_b/0/65/b/25
msgctxt "Dasha"
msgid "War Cry of Healing!"
msgstr "Cri de Guerre Guérisseur !"

# Traduction IA – à relire
#: chance_d20/Save_prince_b/0/65/b/33
msgctxt "Chance"
msgid "How much do they regain?"
msgstr "Combien de PV ça lui rend ?"

# Traduction IA – à relire
#: chance_d20/Save_prince_b/0/65/b/41
msgctxt "Dasha"
msgid "35 health."
msgstr "35 PV."

# Traduction IA – à relire
#: chance_d20/Save_prince_b/0/65/b/49
msgctxt "Chance"
msgid "35! I might have made your character too good!"
msgstr "35 ! J'ai peut-être rendu ton personnage trop fort !"

# Traduction IA – à relire
#: chance_d20/Save_prince_b/0/65/b/57
msgctxt "Chance"
msgid "I'll have to work on that balance for the future."
msgstr "Il faudra que je retravaille l'équilibrage, à l'avenir."

# Traduction IA – à relire
#: chance_d20/Save_prince_b/0/71/b/1
msgctxt "Chance"
msgid "But that will be enough. Darkness falls over you. You fall on the ground with the Prince on your mind. You hope him and the Queen can escape. But you will never know."
msgstr "Mais cela suffit. Les ténèbres t'engloutissent. Tu t'effondres au sol, le Prince en tête. Tu espères que lui et la Reine parviendront à s'échapper. Mais tu ne le sauras jamais."

# Traduction IA – à relire
#: chance_d20/Save_prince_b/0/74
msgctxt "Chance"
msgid "You can see the red energy around the cage start to waiver. What do you do now?"
msgstr "Tu vois l'énergie rouge autour de la cage commencer à vaciller. Que fais-tu, maintenant ?"

# Traduction IA – à relire
#: chance_d20/Save_prince_b/0/82/s/0
msgctxt "Choix"
msgid "Double down on the cage!"
msgstr "On s'acharne sur la cage !"

# Traduction IA – à relire
#: chance_d20/Save_prince_b/0/83/s/0
msgctxt "Choix"
msgid "I'm going for the King!"
msgstr "Je m'attaque au Roi !"

# Traduction IA – à relire
#: chance_d20/Cage_hit_b/13
msgctxt "Chance"
msgid "With a loud crack, it hits him square in the chest. The king lurches back, inches from the tall fire."
msgstr "Dans un grand crac, elle le frappe en pleine poitrine. Le roi recule en titubant, à quelques centimètres du grand feu."

# Traduction IA – à relire
#: chance_d20/Cage_hit_b/21
msgctxt "Chance"
msgid "The Prince cries out, \"Mother!\""
msgstr "Le Prince s'écrie : « Mère ! »"

# Traduction IA – à relire
#: chance_d20/Cage_hit_b/29
msgctxt "Chance"
msgid "She pauses and says, \"I'm sorry you have to see this, son. I'm sure he loved you at some point.\""
msgstr "Elle marque une pause et dit : « Je suis désolée que tu doives voir ça, mon fils. Je suis sûre qu'il t'a aimé, à un moment. »"

# Traduction IA – à relire
#: chance_d20/Cage_hit_b/37
msgctxt "Chance"
msgid "And with a force pulled from deep inside her, a gale a wind forces the King onto the pyre."
msgstr "Et, avec une force puisée au plus profond d'elle-même, elle déchaîne une bourrasque qui projette le Roi sur le bûcher."

# Traduction IA – à relire
#: chance_d20/Cage_hit_b/48
msgctxt "Chance"
msgid "The Prince races to his mother's side. The King's screams echo in the space. Until they don't. All that is left are the tears of the cries of a boy, the panting of a mother, and the exhausted sigh you let escape from your lips."
msgstr "Le Prince se précipite aux côtés de sa mère. Les hurlements du Roi résonnent dans la salle. Puis ils se taisent. Il ne reste plus que les larmes d'un garçon, le souffle haletant d'une mère, et le soupir épuisé qui s'échappe de tes lèvres."

# Traduction IA – à relire
#: chance_d20/Hit_king_b/0/24
msgctxt "Chance"
msgid "The Queen gives you a quick nod before flinging a spell at the cage. Her power serves as the final straw as the energy dissipates and the Prince is able to escape."
msgstr "La Reine t'adresse un bref hochement de tête avant de lancer un sort sur la cage. Son pouvoir est la goutte d'eau qui fait déborder le vase : l'énergie se dissipe et le Prince peut s'échapper."

# Traduction IA – à relire
#: chance_d20/Hit_king_b/0/32
msgctxt "Chance"
msgid "The Prince runs toward the Queen, and they embrace."
msgstr "Le Prince court vers la Reine, et ils s'étreignent."

# Traduction IA – à relire
#: chance_d20/Hit_king_b/0/40
msgctxt "Chance"
msgid "But the King recovers! \"YOU WILL BOTH DIE!\" He is a figment of himself, overtaken by rage. He launches himself at the two while they hold each other. The Queen raises a hand, trying to summon an arcane shield. It might not come in time!"
msgstr "Mais le Roi se reprend ! « VOUS ALLEZ MOURIR TOUS LES DEUX ! » Il n'est plus que l'ombre de lui-même, submergé par la rage. Il se jette sur eux pendant qu'ils s'enlacent. La Reine lève la main pour invoquer un bouclier arcanique. Il risque de ne pas apparaître à temps !"

# Traduction IA – à relire
#: chance_d20/Hit_king_b/0/51/b/4
msgctxt "Dasha"
msgid "Can I reach them in time?"
msgstr "Est-ce que je peux les atteindre à temps ?"

# Traduction IA – à relire
#: chance_d20/Hit_king_b/0/51/b/12
msgctxt "Chance"
msgid "Do you have a reaction that doubles your speed?"
msgstr "Tu as une réaction qui double ta vitesse ?"

# Traduction IA – à relire
#: chance_d20/Hit_king_b/0/51/b/20
msgctxt "Dasha"
msgid "I do not."
msgstr "Non."

# Traduction IA – à relire
#: chance_d20/Hit_king_b/0/51/b/28
msgctxt "Chance"
msgid "Shucks!"
msgstr "Mince !"

# Traduction IA – à relire
#: chance_d20/Hit_king_b/0/51/b/36
msgctxt "Dasha"
msgid "It looks like it is up to you, Miles... Yekaterina cannot help you."
msgstr "On dirait que tout repose sur toi, Miles... Yekaterina ne peut pas t'aider."

# Traduction IA – à relire
#: chance_d20/Hit_king_b/0/62/s/0
msgctxt "Choix"
msgid "I hit the King with everything I've got!"
msgstr "Je frappe le Roi de toutes mes forces !"

# Traduction IA – à relire
#: chance_d20/Hit_king_b/0/63/s/0
msgctxt "Choix"
msgid "I hope the shield works!"
msgstr "J'espère que le bouclier va marcher !"

# Traduction IA – à relire
#: chance_d20/Hit_king_b/0/64/s/0
msgctxt "Choix"
msgid "I jump in front of them!"
msgstr "Je me jette devant eux !"

# Traduction IA – à relire
#: chance_d20/Troub_ultimate_b/40
msgctxt "Chance"
msgid "A large chunk of metal from the room falls and hits the king midair. Sand quickly starts to follow, filling the room."
msgstr "Un gros morceau de métal se détache et percute le roi en plein vol. Le sable s'engouffre aussitôt à sa suite et envahit la salle."

# Traduction IA – à relire
#: chance_d20/Troub_ultimate_b/48
msgctxt "Chance"
msgid "This place is going to collapse!"
msgstr "Tout va s'effondrer !"

# Traduction IA – à relire
#: chance_d20/Troub_ultimate_b/56
msgctxt "Chance"
msgid "\"We have to move NOW!\", the Queen demands."
msgstr "« Nous devons partir TOUT DE SUITE ! », ordonne la Reine."

# Traduction IA – à relire
#: chance_d20/Troub_ultimate_b/64/b/1
msgctxt "Dasha"
msgid "Yekaterina is too strong and sexy to die here!"
msgstr "Yekaterina est trop forte et trop sexy pour mourir ici !"

# Traduction IA – à relire
#: chance_d20/Troub_ultimate_b/64/b/9
msgctxt "Chance"
msgid "You sprint past the King, struggling against the deluge of sand piling on top of him."
msgstr "Tu passes en trombe à côté du Roi, qui se débat sous le déluge de sable qui s'entasse sur lui."

# Traduction IA – à relire
#: chance_d20/Troub_ultimate_b/64/b/17
msgctxt "Chance"
msgid "\"NOOOOOO!\", he cries out. \"I CANNOT DIE HERE!\""
msgstr "« NOOOOOON ! », hurle-t-il. « JE NE PEUX PAS MOURIR ICI ! »"

# Traduction IA – à relire
#: chance_d20/Troub_ultimate_b/64/b/25
msgctxt "Dasha"
msgid "But you will, evildoer!"
msgstr "Et pourtant si, malfaisant !"

# Traduction IA – à relire
#: chance_d20/Troub_ultimate_b/64/b/36
msgctxt "Chance"
msgid "But all four of you run toward the exit. You never look back as the sand pours in."
msgstr "Mais vous courez tous les quatre vers la sortie. Vous ne vous retournez pas une seule fois tandis que le sable s'engouffre."

# Traduction IA – à relire
#: chance_d20/Troub_ultimate_b/67/b/1
msgctxt "Chance"
msgid "But the three of you don't look back. You race back the way you came and enter into the evening air as you hear everything behind you collapse."
msgstr "Mais vous ne vous retournez pas, tous les trois. Vous rebroussez chemin à toute allure et débouchez dans l'air du soir, tandis que tout s'effondre derrière vous."

# Traduction IA – à relire
#: chance_d20/Troub_ultimate_b/73
msgctxt "Chance"
msgid "You stand outside, not with a Queen and a Prince. But with a mother and her son. They hold each other in the silence that follows the collapse. Slowly, the crickets start again. The night fills with sounds of life. You are safe. You are all safe."
msgstr "Te voilà dehors, non pas avec une Reine et un Prince, mais avec une mère et son fils. Ils s'étreignent dans le silence qui suit l'effondrement. Lentement, les grillons reprennent leur chant. La nuit s'emplit de bruits de vie. Tu es en sécurité. Vous êtes tous en sécurité."

# Traduction IA – à relire
#: chance_d20/Troub_shield/0/0
msgctxt "Chance"
msgid "The shield doesn't make it up in time and the Cleaver slices through their grasp with a powerful smash! They both fly to the floor, separated again."
msgstr "Le bouclier n'apparaît pas à temps, et Couperet les arrache l'un à l'autre d'un coup puissant ! Ils sont projetés au sol, de nouveau séparés."

# Traduction IA – à relire
#: chance_d20/Troub_shield/0/8
msgctxt "Chance"
msgid "Focused on the Queen, the King grumbles through a smirk, \"You aren't the first Queen to discover my secret. You will be the first to die because of it.\""
msgstr "Les yeux rivés sur la Reine, le Roi grogne avec un rictus : « Tu n'es pas la première Reine à découvrir mon secret. Mais tu seras la première à en mourir. »"

# Traduction IA – à relire
#: chance_d20/Troub_shield/0/16
msgctxt "Chance"
msgid "THWACK!..."
msgstr "PAF !..."

# Traduction IA – à relire
#: chance_d20/Troub_shield/0/27
msgctxt "Chance"
msgid "An arcane lance hits the king square in the chest. The Prince, pullin forth the power for another, yells, \"STAY AWAY FROM MY MOTHER!\""
msgstr "Une lance arcanique frappe le roi en pleine poitrine. Le Prince, rassemblant son pouvoir pour une autre, hurle : « NE T'APPROCHE PAS DE MA MÈRE ! »"

# Traduction IA – à relire
#: chance_d20/Troub_shield/0/35/s/0
msgctxt "Choix"
msgid "GO PRINCE GO!"
msgstr "VAS-Y, PRINCE, VAS-Y !"

# Traduction IA – à relire
#: chance_d20/Troub_shield/0/36/s/0
msgctxt "Choix"
msgid "I start to throw sonic spells!"
msgstr "Je commence à balancer des sorts soniques !"

# Traduction IA – à relire
#: chance_d20/Troub_shield/0/g-0/0
msgctxt "Chance"
msgid "THWACK! THWACK! Each hit connects with the massive King. Pushing him closer and closer to the giant pyre."
msgstr "PAF ! PAF ! Chaque coup atteint l'énorme Roi et le repousse de plus en plus près du gigantesque bûcher."

# Traduction IA – à relire
#: chance_d20/Troub_shield/0/g-0/8/b/4
msgctxt "Dasha"
msgid "We must combine our efforts."
msgstr "Nous devons unir nos forces."

# Traduction IA – à relire
#: chance_d20/Troub_shield/0/g-0/8/b/12
msgctxt "Chance"
msgid "The Queen stands, nodding at you both. As if in sync, all four of you unleash everything you've got!"
msgstr "La Reine se relève et vous adresse un signe de tête. Comme si vous étiez synchronisés, vous déchaînez tous les quatre tout ce que vous avez !"

# Traduction IA – à relire
#: chance_d20/Troub_shield/0/g-0/8/b/20 chance_d20/Troub_shield/0/g-0/19
msgctxt "Chance"
msgid "The King stumbles, rocking back on his heels. His eyes grow big. He knows he can't stop the fall."
msgstr "Le Roi trébuche et vacille sur ses talons. Ses yeux s'écarquillent. Il sait qu'il ne pourra pas empêcher sa chute."

# Traduction IA – à relire
#: chance_d20/Troub_shield/0/g-0/8/b/34
msgctxt "Chance"
msgid "WOOSH! He falls onto the pyre."
msgstr "FOUUUSH ! Il tombe sur le bûcher."

# Traduction IA – à relire
#: chance_d20/Troub_shield/0/g-0/8/b/42 chance_d20/Troub_shield/0/g-0/41
msgctxt "Chance"
msgid "The Prince races to his mother's side. The King's screams echo in the space. Until they don't. Until all that is left are the cries of a boy, the panting of a mother, and the exhausted sigh you let escape from your lips."
msgstr "Le Prince se précipite aux côtés de sa mère. Les hurlements du Roi résonnent dans la salle. Puis ils se taisent. Il ne reste plus que les pleurs d'un garçon, le souffle haletant d'une mère, et le soupir épuisé qui s'échappe de tes lèvres."

# Traduction IA – à relire
#: chance_d20/Troub_shield/0/g-0/11
msgctxt "Chance"
msgid "The Queen stands, nodding at you both. As if in sync, all three of you unleash everything you've got!"
msgstr "La Reine se relève et vous adresse un signe de tête. Comme si vous étiez synchronisés, vous déchaînez tous les trois tout ce que vous avez !"

# Traduction IA – à relire
#: chance_d20/Troub_shield/0/g-0/33
msgctxt "Chance"
msgid "WOOSH! He falls into the pyre."
msgstr "FOUUUSH ! Il tombe dans le bûcher."

# Traduction IA – à relire
#: chance_d20/Troub_hero_b/0
msgctxt "Chance"
msgid "You... Holy Crit! Okay!"
msgstr "Tu... Nom d'un crit ! D'accord !"

# Traduction IA – à relire
#: chance_d20/Troub_hero_b/8
msgctxt "Chance"
msgid "As you bravely leap in front of the Queen and the Prince, the King comes down on you. He knocks you to the ground, placing his face inches from yours. He says -"
msgstr "Tandis que tu te jettes bravement devant la Reine et le Prince, le Roi s'abat sur toi. Il te plaque au sol, son visage à quelques centimètres du tien, et dit..."

# Traduction IA – à relire
#: chance_d20/Hesitate_b/0/25/b/4
msgctxt "Chance"
msgid "Your momentary hesitation cost you. Darkness falls over you. You fall on the ground with the Prince on your mind. You hope he can escape. But you will never know."
msgstr "Ton instant d'hésitation t'a coûté cher. Les ténèbres t'engloutissent. Tu t'effondres au sol, le Prince en tête. Tu espères qu'il parviendra à s'échapper. Mais tu ne le sauras jamais."

# Traduction IA – à relire
#: chance_d20/Hesitate_b/0/28/b/4
msgctxt "Dasha"
msgid "I swing my blade, forcing him to back away from you. This should give you time to recover."
msgstr "Je fais tournoyer ma lame pour l'obliger à reculer. Ça devrait te laisser le temps de te reprendre."

# Traduction IA – à relire
#: chance_d20/Hesitate_b/0/31
msgctxt "Chance"
msgid "You get back on your feet. He goes to swing again, but this time, the Queen intercepts his attack."
msgstr "Tu te relèves. Il s'apprête à frapper de nouveau, mais cette fois, la Reine intercepte son attaque."

# Traduction IA – à relire
#: chance_d20/Hesitate_b/0/39
msgctxt "Chance"
msgid "Guarding you, she yells, \"Save my son!\""
msgstr "Te protégeant, elle crie : « Sauvez mon fils ! »"

# Traduction IA – à relire
#: chance_d20/Hesitate_b/0/55/s/0
msgctxt "Choix"
msgid "I obey my Queen!"
msgstr "J'obéis à ma Reine !"

# Traduction IA – à relire
#: chance_d20/Hesitate_b/0/56/s/0
msgctxt "Choix"
msgid "I should be the one protecting the Queen. So, I will!"
msgstr "C'est à moi de protéger la Reine. Alors c'est ce que je vais faire !"

# Traduction IA – à relire
#: chance_d20/Troub_death/0/0/s/0
msgctxt "Choix"
msgid "Wait! What happened to the Prince?"
msgstr "Attends ! Qu'est-ce qui est arrivé au Prince ?"

# Traduction IA – à relire
#: chance_d20/Troub_death/0/1/s/0
msgctxt "Choix"
msgid "Nooooo!"
msgstr "Noooooon !"

# Traduction IA – à relire
#: chance_d20/Troub_death/0/g-0/0
msgctxt "Chance"
msgid "Your lyre is discovered 100 years after your passing, but the story of the person who played it is lost."
msgstr "Ta lyre est retrouvée 100 ans après ta mort, mais l'histoire de la personne qui en jouait s'est perdue."

# Traduction IA – à relire
#: chance_d20/Troub_death/0/g-0/8
msgctxt "Chance"
msgid "The Royal family no longer rule. The passing of the Prince was enough to cause the Butcher Block to implode, and a faction war broke out."
msgstr "La famille royale ne règne plus. La mort du Prince a suffi à faire imploser le Billot, et une guerre de factions a éclaté."

# Traduction IA – à relire
#: chance_d20/Troub_death/0/g-0/16
msgctxt "Chance"
msgid "The land has fallen into a place of small but constant fights for power between landholders."
msgstr "Le pays a sombré dans d'incessantes petites luttes de pouvoir entre seigneurs locaux."

# Traduction IA – à relire
#: chance_d20/Troub_death/0/g-0/24
msgctxt "Chance"
msgid "And one day, an adventurer may rise and bring peace to the land."
msgstr "Et un jour, peut-être, un aventurier se lèvera pour ramener la paix sur ces terres."

# Traduction IA – à relire
#: chance_d20/Troub_death/0/g-0/35 chance_d20/Enchanter_ending/0/g-1/24
msgctxt "Chance"
msgid "But that's another story."
msgstr "Mais ceci est une autre histoire."

# Traduction IA – à relire
#: chance_d20/Troub_death/0/g-0/43/s/0
msgctxt "Choix"
msgid "FUCK."
msgstr "PUTAIN."

# Traduction IA – à relire
#: chance_d20/Troub_death/0/g-0/44/s/0
msgctxt "Choix"
msgid "Damn it. Sucks I died, but that was fun!"
msgstr "Merde. Dommage que je sois {{mort|morte|mort·e}}, mais c'était marrant !"

# Traduction IA – à relire
#: chance_d20/Troub_ending/6
msgctxt "Chance"
msgid "With the Prince safe, you make your way to Cantalopia together. It is there that you find a member of the Butcher Block you can trust, vouched for by the Prince."
msgstr "Le Prince sain et sauf, vous partez ensemble pour Cantalopia. Là-bas, vous trouvez un membre du Billot digne de confiance, dont le Prince se porte garant."

# Traduction IA – à relire
#: chance_d20/Troub_ending/14
msgctxt "Chance"
msgid "The news of the Immortal King and his destruction is spread. Many begin to question the position of the royal family in their lives and as their rulers. The Queen, now free to rule as she pleases, works to make amends with those who have lost their faith in the crown."
msgstr "La nouvelle du Roi Immortel et de sa chute se répand. Beaucoup commencent à remettre en question la place de la famille royale dans leur vie, et son droit à gouverner. La Reine, désormais libre de régner comme elle l'entend, s'efforce de regagner la confiance de ceux qui ne croient plus en la couronne."

# Traduction IA – à relire
#: chance_d20/Troub_ending/22
msgctxt "Chance"
msgid "And you get what was promised to you. You are set up in the royal court. You play for large events and gain fame! But it is the more intimate moments where you are playing your lyre by the fireside with The Queen nodding along and the Prince creating lyrics on the fly... those are the moments you live for."
msgstr "Et tu obtiens ce qu'on t'avait promis. Tu es installé{{|e|·e}} à la cour royale. Tu joues lors de grands événements et tu deviens célèbre ! Mais ce sont les moments plus intimes, quand tu joues de la lyre au coin du feu tandis que la Reine hoche la tête en rythme et que le Prince improvise des paroles... c'est pour ces moments-là que tu vis."

# Traduction IA – à relire
#: chance_d20/Troub_ending/30
msgctxt "Chance"
msgid "For now, you want for nothing. You are happy. You are well. You are... a hero."
msgstr "Pour l'instant, tu ne manques de rien. Tu es heureux{{|se|·se}}. Tu vas bien. Tu es... {{un héros|une héroïne|une figure héroïque}}."

# Traduction IA – à relire
#: chance_d20/Troub_ending/38/b/4 chance_d20/Troub_hero_ending/52/b/4
msgctxt "Dasha"
msgid "Thank you for running this beautiful game for us, Chance."
msgstr "Merci d'avoir mené cette belle partie pour nous, Chance."

# Traduction IA – à relire
#: chance_d20/Troub_ending/38/b/12 chance_d20/Troub_hero_ending/52/b/12
msgctxt "Dasha"
msgid "Yekaterina will live on in my mind."
msgstr "Yekaterina vivra toujours dans ma tête."

# Traduction IA – à relire
#: chance_d20/Troub_hero_ending/6
msgctxt "Chance"
msgid "It isn't long before your body is found. Members of the Butcher Block find you in the chamber, next to the Prince. They see the wounds on your body and they easily make the connection. You put your life on the line for the Prince. Of that there is no doubt."
msgstr "On ne tarde pas à retrouver ton corps. Des membres du Billot te découvrent dans la salle, à côté du Prince. Ils voient les blessures sur ton corps et font facilement le lien. Tu as risqué ta vie pour le Prince. Cela ne fait aucun doute."

# Traduction IA – à relire
#: chance_d20/Troub_hero_ending/14
msgctxt "Chance"
msgid "They treat you like the hero you are, raising a statue in your honor. At the Counter Top Tavern, an Ode to the Troubadour is written and sung."
msgstr "Ils te traitent comme {{le héros|l'héroïne|la figure héroïque}} que tu es et érigent une statue en ton honneur. À la Taverne du Plan de Travail, on écrit et on chante une Ode au Troubadour."

# Traduction IA – à relire
#: chance_d20/Troub_hero_ending/22
msgctxt "Chance"
msgid "First, every night. And then weekly. But, eventually every month on the full moon, when the world makes the most music, the song of you is sung."
msgstr "D'abord tous les soirs. Puis toutes les semaines. Et finalement, chaque mois, à la pleine lune, quand le monde fait le plus de musique, on chante la chanson qui parle de toi."

# Traduction IA – à relire
#: chance_d20/Troub_hero_ending/30
msgctxt "Chance"
msgid "And that continues until forever."
msgstr "Et ça continue pour toujours."

# Traduction IA – à relire
#: chance_d20/Troub_hero_ending/38/b/4
msgctxt "Dasha"
msgid "Yekaterina will sing the Troubadour's song for the rest of her life."
msgstr "Yekaterina chantera la chanson du Troubadour jusqu'à fin de sa vie."

# Traduction IA – à relire
#: chance_d20/Troub_hero_ending/38/b/12
msgctxt "Chance"
msgid "Oh... you die in the cave as well."
msgstr "Oh... toi aussi, tu meurs dans la grotte."

# Traduction IA – à relire
#: chance_d20/Troub_hero_ending/38/b/23
msgctxt "Dasha"
msgid "Oh. Yekaterina will sing in G&G heaven then."
msgstr "Oh. Alors Yekaterina chantera au paradis de G&G."

# Traduction IA – à relire
#: chance_d20/Troub_hero_ending/41
msgctxt "Chance"
msgid "King Cleaver may endure. But, so do you. And you will inspire the one who eventually brings him down."
msgstr "Le Roi Couperet survit peut-être. Mais toi aussi. Et tu inspireras celui qui finira par le terrasser."

# Traduction IA – à relire
#: chance_d20/Guardian_session/0/7
msgctxt "Chance"
msgid "MY STRONG WARRIOR! You have returned to me!"
msgstr "{{MON VAILLANT GUERRIER|MA VAILLANTE GUERRIÈRE|MON ÊTRE VAILLANT}} ! Te voilà de retour !"

# Traduction IA – à relire
#: chance_d20/Guardian_session/0/16/s/0 chance_d20/Enchant_Session/0/16/s/0
msgctxt "Choix"
msgid "I'd never let you down by not coming."
msgstr "Je ne te laisserais jamais tomber en ne venant pas."

# Traduction IA – à relire
#: chance_d20/Guardian_session/0/17/s/0 chance_d20/Enchant_Session/0/17/s/0
msgctxt "Choix"
msgid "About that. I don't wanna play, so I wanna bounce."
msgstr "À ce propos. J'ai pas envie de jouer, donc je me casse."

# Traduction IA – à relire
#: chance_d20/Guardian_session/0/18/s/0 chance_d20/Enchant_Session/0/18/s/0
msgctxt "Choix"
msgid "You are WAY Too cute to stay away from."
msgstr "T'es BEAUCOUP trop mignon pour que je reste loin de toi."

# Traduction IA – à relire
#: chance_d20/Guardian_session/0/c-3/13
msgctxt "Chance"
msgid "Are you trying to get some magical equipment by flirting? Hehehe. It might work. Keyword, \"might\". Heh."
msgstr "Tu essaies de gratter de l'équipement magique en flirtant ? Hihihi. Ça pourrait marcher. Mot-clé : « pourrait ». Hé."

# Traduction IA – à relire
#: chance_d20/Guardian_session/0/guardian_return_join/0 chance_d20/Enchant_Session/0/g-0/0
msgctxt "Chance"
msgid "I'm so glad you're here. I knew you wouldn't let me down. I rolled a crit on my insight check of you!"
msgstr "Je suis trop content que tu sois là. Je savais que tu ne me laisserais pas tomber. J'ai fait un crit sur mon jet de perspicacité à ton sujet !"

# Traduction IA – à relire
#: chance_d20/Guardian_session/0/guardian_return_join/8/b/4
msgctxt "Chance"
msgid "And, it looks like our mutual friend Jerry is joining us today!"
msgstr "Et on dirait que notre ami commun Jerry se joint à nous aujourd'hui !"

# Traduction IA – à relire
#: chance_d20/Guardian_session/0/guardian_return_join/8/b/12
msgctxt "Jerry"
msgid "Hello! I am excited to play with you! I hear there is loot in this game!"
msgstr "Salut ! J'ai trop hâte de jouer avec toi ! Il paraît qu'il y a du butin dans ce jeu !"

# Traduction IA – à relire
#: chance_d20/Guardian_session/0/guardian_return_join/8/b/20
msgctxt "Chance"
msgid "I've rolled Jerry as the Apothecary class. To keep things a bit more exciting, I've rolled to see what his character would have."
msgstr "J'ai fait de Jerry un Apothicaire. Pour pimenter un peu les choses, j'ai lancé les dés pour savoir ce que son personnage aurait sur lui."

# Traduction IA – à relire
#: chance_d20/Guardian_session/0/guardian_return_join/8/b/28
msgctxt "Chance"
msgid "A lot of it is things to help you on your adventure."
msgstr "En grande partie, des trucs pour t'aider dans ton aventure."

# Traduction IA – à relire
#: chance_d20/Guardian_session/0/guardian_return_join/8/b/36
msgctxt "Chance"
msgid "Some of it is... well... less than useful."
msgstr "Et une partie... eh bien... un peu moins utile."

# Traduction IA – à relire
#: chance_d20/Guardian_session/0/guardian_return_join/11
msgctxt "Chance"
msgid "You will be playing the mighty Sad'ida Ekin, a Guardian who lives on the Shoelace Shores in the village of Snee Kars."
msgstr "Tu vas incarner {{le puissant|la puissante|le puissant}} Sad'ida Ekin, {{un Gardien|une Gardienne|un Gardien}} qui vit sur les Rivages-Lacets, dans le village de Bas-Kets."

# Traduction IA – à relire
#: chance_d20/Guardian_session/0/guardian_return_join/19
msgctxt "Chance"
msgid "You are on your way back from training on the nearby Chukka Hills. You will start with 75 health! But, don't worry. I'll keep track of all of those things for you."
msgstr "Tu rentres d'un entraînement sur les collines voisines des Chukka. Tu commences avec 75 PV ! Mais ne t'inquiète pas. Je m'occupe de tout ça pour toi."

# Traduction IA – à relire
#: chance_d20/Guardian_session/0/guardian_return_join/27
msgctxt "Chance"
msgid "We start our adventure in the early morning. As you walk upon the grass path, thinking about your latest training and feeling the soreness in your muscles, your mind drifts to home."
msgstr "Notre aventure commence au petit matin. Tandis que tu marches sur le sentier herbeux, en repensant à ton dernier entraînement et en sentant tes muscles courbaturés, tes pensées dérivent vers ton foyer."

# Traduction IA – à relire
#: chance_d20/Guardian_session/0/guardian_return_join/35
msgctxt "Chance"
msgid "In particular, your mind drifts to that of your family. Tomorrow is your partner's birthday! You haven't decided what to do yet, but you know it has to be special. Maybe a cake? Or a seafood dinner!"
msgstr "Plus précisément, vers ta famille. Demain, c'est l'anniversaire de ta moitié ! Tu n'as pas encore décidé quoi faire, mais tu sais que ça doit être spécial. Un gâteau, peut-être ? Ou un dîner de fruits de mer !"

# Traduction IA – à relire
#: chance_d20/Guardian_session/0/guardian_return_join/43
msgctxt "Chance"
msgid "The smell of the salty air from the shore is refreshing and you look out on the horizon."
msgstr "L'air salé du rivage te rafraîchit, et tu contemples l'horizon."

# Traduction IA – à relire
#: chance_d20/Guardian_session/0/guardian_return_join/51
msgctxt "Chance"
msgid "That's when something catches your eye. Something from the direction of Snee Kars. Is that? It is!"
msgstr "C'est là que quelque chose attire ton regard. Quelque chose du côté de Bas-Kets. Est-ce que c'est... ? Oui !"

# Traduction IA – à relire
#: chance_d20/Guardian_session/0/guardian_return_join/59
msgctxt "Chance"
msgid "It's smoke! Black and billowing."
msgstr "De la fumée ! Noire et épaisse."

# Traduction IA – à relire
#: chance_d20/Guardian_session/0/guardian_return_join/67/s/0 chance_d20/Guardian_session/0/guardian_return_join/c-6/51/0/s/0
msgctxt "Choix"
msgid "I run toward the smoke!"
msgstr "Je cours vers la fumée !"

# Traduction IA – à relire
#: chance_d20/Guardian_session/0/guardian_return_join/68/s/0 chance_d20/Guardian_session/0/guardian_return_join/c-6/51/1/s/0
msgctxt "Choix"
msgid "I need to be cautious as I approach."
msgstr "Je dois approcher prudemment."

# Traduction IA – à relire
#: chance_d20/Guardian_session/0/guardian_return_join/69/s/0
msgctxt "Choix"
msgid "Jerry, what should we do?"
msgstr "Jerry, qu'est-ce qu'on fait ?"

# Traduction IA – à relire
#: chance_d20/Guardian_session/0/guardian_return_join/c-4/7 chance_d20/Guardian_session/0/guardian_return_join/c-6/51/c-0/7
msgctxt "Chance"
msgid "You take off, ignoring the fatigue in your legs. You are determined to get to Snee Kars as fast as possible."
msgstr "Tu t'élances, sans te soucier de la fatigue dans tes jambes. Tu es {{déterminé|déterminée|déterminé·e}} à rejoindre Bas-Kets le plus vite possible."

# Traduction IA – à relire
#: chance_d20/Guardian_session/0/guardian_return_join/c-5/7 chance_d20/Guardian_session/0/guardian_return_join/c-6/51/c-1/7
msgctxt "Chance"
msgid "You pick up the pace, keeping an eye on everything around you as you move."
msgstr "Tu presses le pas, en gardant un œil sur tout ce qui t'entoure."

# Traduction IA – à relire
#: chance_d20/Guardian_session/0/guardian_return_join/c-6/10
msgctxt "Jerry"
msgid "Cheese and crackers don't ask me! I'm so bad with decisions!"
msgstr "Nom d'une agrafeuse, me demande pas à moi ! Je suis nul pour prendre des décisions !"

# Traduction IA – à relire
#: chance_d20/Guardian_session/0/guardian_return_join/c-6/18
msgctxt "Jerry"
msgid "Here, here's a rubber band! That always helps me out when I'm feeling nervous!"
msgstr "Tiens, voilà un élastique ! Ça m'aide toujours quand je suis nerveux !"

# Traduction IA – à relire
#: chance_d20/Guardian_session/0/guardian_return_join/c-6/26
msgctxt "Jerry"
msgid "You... you can eat it."
msgstr "Tu... tu peux le manger."

# Traduction IA – à relire
#: chance_d20/Guardian_session/0/guardian_return_join/c-6/31
msgctxt "Chance"
msgid "It heals you for 15 health!"
msgstr "Il te soigne de 15 PV !"

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/0
msgctxt "Chance"
msgid "As you reach the top of the hill overlooking your seaside village, you see Snee Kars is smouldering. You see the village priest helping tend to people around the town."
msgstr "En arrivant au sommet de la colline qui surplombe ton village côtier, tu vois que Bas-Kets fume encore. Tu aperçois le prêtre du village qui soigne les gens un peu partout."

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/8
msgctxt "Chance"
msgid "\"Oh! Praise to the goddess! You are back!\""
msgstr "« Oh ! Louée soit la déesse ! Tu es revenu{{|e|·e}} ! »"

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/16
msgctxt "Chance"
msgid "They come to you, worry etched on their face. They take your hand."
msgstr "Il vient vers toi, l'inquiétude gravée sur le visage, et te prend la main."

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/24/s/0 chance_d20/Guardian_part2/0/g-0/25/s/0
msgctxt "Choix"
msgid "What happened here?"
msgstr "Qu'est-ce qui s'est passé ici ?"

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/25/s/0
msgctxt "Choix"
msgid "Why is everything on fire?!"
msgstr "Pourquoi tout est en feu ?!"

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/g-0/0
msgctxt "Chance"
msgid "\"You have questions. But, we shouldn't speak out here. We don't know who is around. Come. Follow me.\""
msgstr "« Tu as des questions. Mais nous ne devrions pas parler ici. Nous ne savons pas qui rôde. Viens. Suis-moi. »"

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/g-0/8
msgctxt "Chance"
msgid "As you follow the priest to a makeshift shelter, you see the level of destruction. Your fellow villagers are hurt, and you start to make a mental tally of who you see. A few people cry as they realize their loved ones didn't survive whatever happened."
msgstr "En suivant le prêtre jusqu'à un abri de fortune, tu mesures l'étendue des dégâts. Tes voisins sont blessés, et tu commences à compter mentalement ceux que tu vois. Certains pleurent en comprenant que leurs proches n'ont pas survécu à ce qui s'est passé."

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/g-0/16
msgctxt "Chance"
msgid "Once inside the shelter, you realize... YOUR PARTNER?!"
msgstr "Une fois dans l'abri, tu te rends compte... ET TA MOITIÉ ?!"

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/g-0/24/s/0
msgctxt "Choix"
msgid "Where's my partner?"
msgstr "Où est ma moitié ?"

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/g-1/0
msgctxt "Chance"
msgid "\"We were attacked right before dawn. A few people were killed, but we were caught unaware, and... I think they were looking for you.\""
msgstr "« Nous avons été attaqués juste avant l'aube. Quelques personnes ont été tuées, nous avons été pris par surprise, et... je crois qu'ils te cherchaient. »"

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/g-1/8/b/4
msgctxt "Jerry"
msgid "I didn't know I was traveling with a wanted person!"
msgstr "Je savais pas que je voyageais avec quelqu'un de recherché !"

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/g-1/11/s/0
msgctxt "Choix"
msgid "ME?!"
msgstr "MOI ?!"

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/g-1/12/s/0
msgctxt "Choix"
msgid "What makes you say that?"
msgstr "Qu'est-ce qui te fait dire ça ?"

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/g-2/0
msgctxt "Chance"
msgid "\"Your house got the worst of it. They took your partner. Spirited them away and left only this amongst the rubble.\""
msgstr "« C'est ta maison qui a le plus souffert. Ils ont enlevé ta moitié. Ils l'ont emmenée et n'ont laissé que ceci dans les décombres. »"

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/g-2/8
msgctxt "Chance"
msgid "The priest hands you a piece of fabric with what looks like a Mountain Lion pouncing burned into it."
msgstr "Le prêtre te tend un morceau de tissu sur lequel est brûlé ce qui ressemble à un puma en plein bond."

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/g-2/16
msgctxt "Chance"
msgid "\"It's the Amup Bandits.\""
msgstr "« Ce sont les Bandits Amup. »"

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/g-2/24/s/0
msgctxt "Choix"
msgid "I wanna be Amup on you! Hehehe"
msgstr "Moi, je te sauterais bien dessus, façon Amup ! Hihi"

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/g-2/25/s/0
msgctxt "Choix"
msgid "Who are they?"
msgstr "Qui sont-ils ?"

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/g-2/c-6/7
msgctxt "Chance"
msgid "Stooop. Hehe. I'm trying to focus!"
msgstr "Arrêêête. Hihi. J'essaie de me concentrer !"

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/g-2/c-6/15/b/4
msgctxt "Jerry"
msgid "Oh, y'know there's an old love poem you wrote once in my drawer here..."
msgstr "Oh, tu sais, il y a un vieux poème d'amour que t'as écrit une fois, dans mon tiroir..."

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/g-2/c-6/15/b/12
msgctxt "Jerry"
msgid "...I'll find it later."
msgstr "... Je le retrouverai plus tard."

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/g-3/0
msgctxt "Chance"
msgid "The Amup Bandits are a rival band of scallywags who were once in constant battle with the village of Snee Kars. Peace was hard fought, with you being the fiercest warrior and a large reason they surrendered. That was a decade ago, and you thought they had moved on."
msgstr "Les Bandits Amup sont une bande rivale de canailles qui, autrefois, étaient sans cesse en guerre contre le village de Bas-Kets. La paix a été durement gagnée : tu étais {{le plus féroce des guerriers|la plus féroce des guerrières|le plus féroce des guerriers}}, et l'une des grandes raisons de leur reddition. C'était il y a dix ans, et tu pensais qu'ils étaient passés à autre chose."

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/g-3/8
msgctxt "Chance"
msgid "But it seems they never forgot about you."
msgstr "Mais on dirait qu'ils ne t'ont jamais oublié{{|e|·e}}."

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/g-3/16
msgctxt "Chance"
msgid "\"What will you do? How should we respond? You are the only one able to go after them.\""
msgstr "« Que vas-tu faire ? Comment devons-nous réagir ? Tu es la seule personne capable de les poursuivre. »"

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/g-3/24/s/0
msgctxt "Choix"
msgid "I will avenge my partner!"
msgstr "Je vengerai ma moitié !"

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/g-3/25/s/0
msgctxt "Choix"
msgid "Ehh. It's not worth it."
msgstr "Bof. Ça vaut pas le coup."

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/g-3/c-8/7/b/4
msgctxt "Jerry"
msgid "And I can help! Surely my sundries will come in handy!"
msgstr "Et je peux t'aider ! Mes bricoles vont sûrement servir !"

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/g-3/c-8/7/b/12
msgctxt "Chance"
msgid "The priest sees the dedication in your eyes, and offers to help you prepare for the journey. They also bless you with what healing energy they have left. You gain 15 health!"
msgstr "Le prêtre voit la détermination dans tes yeux et propose de t'aider à préparer ton voyage. Il te bénit aussi avec ce qui lui reste d'énergie curative. Tu gagnes 15 PV !"

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/g-3/c-9/7
msgctxt "Chance"
msgid "The priest looks at you and blinks hard. \"You would leave your partner in their hands?\""
msgstr "Le prêtre te regarde en clignant fort des yeux. « Tu laisserais ta moitié entre leurs mains ? »"

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/g-3/c-9/15/0/s/0
msgctxt "Choix"
msgid "I will help rebuild the village. Maybe I'll find love again."
msgstr "J'aiderai à reconstruire le village. Peut-être que je retrouverai l'amour."

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/g-3/c-9/15/1/s/0
msgctxt "Choix"
msgid "You're right. What was I thinking? I need to save my partner!"
msgstr "Tu as raison. À quoi je pensais ? Je dois sauver ma moitié !"

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/g-3/c-9/15/c-0/7/b/4
msgctxt "Jerry"
msgid "Oh! Well, that's kind of nice and peaceful. I can help! I have a tape measure around here somewhere..."
msgstr "Oh ! Eh bien, c'est plutôt sympa et paisible. Je peux aider ! J'ai un mètre ruban quelque part par là..."

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/g-3/c-9/15/c-0/7/b/12
msgctxt "Chance"
msgid "Uhhh... okay. The priest is shocked by your choice. So you stay behind and you help rebuild. The Amup never show their face again, but you never see your partner, either."
msgstr "Euuuh... d'accord. Le prêtre est choqué par ton choix. Tu restes donc au village et tu aides à le reconstruire. Les Amup ne se montrent plus jamais, mais tu ne revois jamais ta moitié non plus."

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/g-3/c-9/15/c-0/7/b/20
msgctxt "Chance"
msgid "The village never looks at you the same way. You end up alone. Safe. But alone."
msgstr "Le village ne te regarde plus jamais de la même façon. Tu finis {{seul|seule|seul·e}}. En sécurité. Mais {{seul|seule|seul·e}}."

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/g-3/c-9/15/c-0/7/b/28
msgctxt "Chance"
msgid "The end... I guess?"
msgstr "Fin... j'imagine ?"

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/g-3/c-9/15/c-1/7/b/4
msgctxt "Jerry"
msgid "You have me and my concoctions at your aid as well."
msgstr "Tu as aussi mes mixtures et moi pour t'aider."

# Traduction IA – à relire
#: chance_d20/Guardian_part2/0/g-3/c-9/15/c-1/7/b/12
msgctxt "Chance"
msgid "The priest is happy you are going to venture forth and avenge your village. Still, you can see they doubt your dedication a bit. You will have to prove that you are still the warrior they know you to be!"
msgstr "Le prêtre est heureux que tu partes venger ton village. Mais tu vois bien qu'il doute un peu de ton engagement. Tu vas devoir prouver que tu es toujours {{le guerrier|la guerrière|le guerrier}} qu'il connaît !"

# Traduction IA – à relire
#: chance_d20/Guardian_part3/0/0
msgctxt "Chance"
msgid "You decide to head off when night falls. During the day you help your fellow villagers as you continue to think about your partner and the Amup. What is going through your mind?"
msgstr "Tu décides de partir à la tombée de la nuit. Pendant la journée, tu aides les autres villageois, sans cesser de penser à ta moitié et aux Amup. Qu'est-ce qui te passe par la tête ?"

# Traduction IA – à relire
#: chance_d20/Guardian_part3/0/8/s/0
msgctxt "Choix"
msgid "I'm wondering if any of them are as cute as you."
msgstr "Je me demande si l'un d'eux est aussi mignon que toi."

# Traduction IA – à relire
#: chance_d20/Guardian_part3/0/9/s/0
msgctxt "Choix"
msgid "I hope that my partner is okay!"
msgstr "J'espère que ma moitié va bien !"

# Traduction IA – à relire
#: chance_d20/Guardian_part3/0/10/s/0
msgctxt "Choix"
msgid "Revenge is all I can think of. Those Amup will pay!"
msgstr "Je ne pense qu'à me venger. Ces Amup vont payer !"

# Traduction IA – à relire
#: chance_d20/Guardian_part3/0/c-0/7
msgctxt "Chance"
msgid "Oh! You are rolling well on your charm spells."
msgstr "Oh ! Tes sorts de charme font de bons jets."

# Traduction IA – à relire
#: chance_d20/Guardian_part3/0/c-1/7
msgctxt "Chance"
msgid "You reach out into the universe, trying to feel for them. You can feel the love connection you two have still holding strong. They are still alive!"
msgstr "Tu tends ton esprit vers l'univers pour essayer de la sentir. Tu sens que le lien d'amour qui vous unit tient toujours bon. Ta moitié est encore en vie !"

# Traduction IA – à relire
#: chance_d20/Guardian_part3/0/c-2/7
msgctxt "Chance"
msgid "You know that rage will serve you well in the coming battle. You wait for the sun to set, sharpening your battle axe blade as you do."
msgstr "Tu sais que ta rage te servira dans la bataille à venir. Tu attends le coucher du soleil en affûtant la lame de ta hache de guerre."

# Traduction IA – à relire
#: chance_d20/Guardian_part4/0/0
msgctxt "Chance"
msgid "The moment the stars begin to appear, you take your leave. You have a brief moment with the members of Snee Kars. All of those who are healthy enough to stand and walk form a circle around you."
msgstr "Dès que les étoiles commencent à apparaître, tu prends congé. Tu passes un bref moment avec les habitants de Bas-Kets. Tous ceux qui sont assez valides pour se tenir debout et marcher forment un cercle autour de toi."

# Traduction IA – à relire
#: chance_d20/Guardian_part4/0/8
msgctxt "Chance"
msgid "They all whisper hopes of good fortune and a battle well fought for you. They also take the moment to state anything they might want to say before you pass."
msgstr "Tous te murmurent des vœux de bonne fortune et de victoire. Ils en profitent aussi pour te dire tout ce qu'ils voudraient te dire avant que tu ne meures."

# Traduction IA – à relire
#: chance_d20/Guardian_part4/0/16
msgctxt "Chance"
msgid "This is a Snee Kars ceremony to ensure that there is nothing holding their warriors back from the future, regardless of how the battle ahead may end."
msgstr "C'est une cérémonie de Bas-Kets qui garantit que rien ne retient les guerriers face à leur avenir, quelle que soit l'issue de la bataille."

# Traduction IA – à relire
#: chance_d20/Guardian_part4/0/24
msgctxt "Chance"
msgid "You bask in the moonlight and accept their desire for you to defeat those who attacked them."
msgstr "Tu te baignes dans le clair de lune et acceptes leur volonté de te voir vaincre ceux qui les ont attaqués."

# Traduction IA – à relire
#: chance_d20/Guardian_part4/0/32
msgctxt "Chance"
msgid "Setting off down the path that many say the Amup bandits used, you walk with your head high. Your village is what you fight for."
msgstr "Tu t'engages sur le chemin que les Bandits Amup auraient emprunté, selon beaucoup, et tu marches la tête haute. C'est pour ton village que tu te bats."

# Traduction IA – à relire
#: chance_d20/Guardian_part4/0/40
msgctxt "Chance"
msgid "Moving alongside the path, you travel for about half an hour before you see movement. You find some shrubs off of the path and hide between them. As you sit, surrounded by leaves, you see what you know to be members of the Amup step into the moonlight."
msgstr "Tu longes le chemin pendant environ une demi-heure avant de voir du mouvement. Tu trouves des buissons à l'écart et tu te caches entre eux. Accroupi{{|e|·e}} au milieu des feuilles, tu vois des silhouettes que tu sais être des Amup s'avancer dans le clair de lune."

# Traduction IA – à relire
#: chance_d20/Guardian_part4/0/48
msgctxt "Chance"
msgid "Cat-like humanoids all clad in leather armor. On their side you see the traditional swords that you became familiar with during the battles a decade ago."
msgstr "Des humanoïdes félins tous vêtus d'armures de cuir. À leur côté, tu reconnais les épées traditionnelles qui te sont devenues familières lors des batailles d'il y a dix ans."

# Traduction IA – à relire
#: chance_d20/Guardian_part4/0/56
msgctxt "Chance"
msgid "You think there are only two of them, but wait! A third actually walks right past you, missing you in the bushes."
msgstr "Tu crois qu'ils ne sont que deux, mais attends ! Un troisième passe juste à côté de toi, sans te voir dans les buissons."

# Traduction IA – à relire
#: chance_d20/Guardian_part4/0/64
msgctxt "Chance"
msgid "\"There's no doubt they'll come. You just have to wait. -Uwu\""
msgstr "« Ça ne fait aucun doute, la proie va venir. Il suffit d'attendre. - Uwu »"

# Traduction IA – à relire
#: chance_d20/Guardian_part4/0/72/s/0
msgctxt "Choix"
msgid "Uwu? Hahaha."
msgstr "Uwu ? Hahaha."

# Traduction IA – à relire
#: chance_d20/Guardian_part4/0/73/s/0
msgctxt "Choix"
msgid "Awww! They're cute!"
msgstr "Ooooh ! Ils sont mignons !"

# Traduction IA – à relire
#: chance_d20/Guardian_part4/0/74/s/0
msgctxt "Choix"
msgid "You are so damn adorable."
msgstr "T'es trop adorable, bon sang."

# Traduction IA – à relire
#: chance_d20/Guardian_part4/0/c-2/13
msgctxt "Chance"
msgid "Hehehe. Thanks."
msgstr "Hihihi. Merci."

# Traduction IA – à relire
#: chance_d20/Guardian_part4/0/g-0/0
msgctxt "Chance"
msgid "Don't let them fool you. The Amup are ruthless murderers!"
msgstr "Ne te laisse pas avoir. Les Amup sont des meurtriers impitoyables !"

# Traduction IA – à relire
#: chance_d20/Guardian_part4/0/g-0/8
msgctxt "Chance"
msgid "But, you are lucky. These aren't the most vicious of their fighters. This is a band of scouts."
msgstr "Mais tu as de la chance. Ce ne sont pas leurs combattants les plus redoutables. C'est une bande d'éclaireurs."

# Traduction IA – à relire
#: chance_d20/Guardian_part4/0/g-0/19
msgctxt "Chance"
msgid "You hear one of them say, \"Well, let's do one more pass of the area and then we can dip into the Nip! - Uwu.\""
msgstr "Tu en entends un dire : « Allez, on fait encore un tour du coin et après, on se fait un petit coup d'Herbe ! - Uwu. »"

# Traduction IA – à relire
#: chance_d20/Guardian_part4/0/g-0/27
msgctxt "Chance"
msgid "The Nip was credited with their defeat in previous battles. The fact that this scouting party seems to have some on them proves how much they underestimate you."
msgstr "C'est à l'Herbe qu'on attribue leur défaite lors des batailles passées. Le fait que ces éclaireurs en aient sur eux prouve à quel point ils te sous-estiment."

# Traduction IA – à relire
#: chance_d20/Guardian_part4/0/g-0/35/b/4
msgctxt "Jerry"
msgid "This Nip stuff sounds like it could give us an upper hand!"
msgstr "Ce truc, l'Herbe, ça pourrait nous donner l'avantage !"

# Traduction IA – à relire
#: chance_d20/Guardian_part4/0/g-0/38 chance_d20/Guardian_final_fight/0/8
msgctxt "Chance"
msgid "What do you want to do?"
msgstr "Que veux-tu faire ?"

# Traduction IA – à relire
#: chance_d20/Guardian_part4/0/g-0/46/s/0
msgctxt "Choix"
msgid "Wait for them to Nip out and then attack!"
msgstr "Attendre qu'ils planent à l'Herbe et attaquer !"

# Traduction IA – à relire
#: chance_d20/Guardian_part4/0/g-0/47/s/0
msgctxt "Choix"
msgid "They underestimate me? Time to make my presence known."
msgstr "Ils me sous-estiment ? Il est temps de me faire remarquer."

# Traduction IA – à relire
#: chance_d20/Guardian_part4/0/g-0/48/s/0
msgctxt "Choix"
msgid "Let 'em dip in the Nip and then question one."
msgstr "Les laisser se défoncer à l'Herbe, puis en interroger un."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/0
msgctxt "Chance"
msgid "They circle the area one more time. This time, they are highly distracted. You can tell that Nip is on their minds. They walk past you again, only this time, they almost scurry back and huddle up together."
msgstr "Ils font encore un tour du coin. Cette fois, ils sont très distraits. Tu vois bien qu'ils ne pensent qu'à l'Herbe. Ils repassent à côté de toi, mais cette fois, ils filent presque aussitôt pour se blottir les uns contre les autres."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/8
msgctxt "Chance"
msgid "\"Ooo, this is the good stuff! - Uwu!\""
msgstr "« Ooh, c'est de la bonne ! - Uwu ! »"

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/16
msgctxt "Chance"
msgid "They partake. It doesn't take long for it to take hold of them. Their eyes get wide. One stares at the moon, mouth open and drooling. The other two produce a ball of yarn and begin to pass it back and forth as they roll around on the ground."
msgstr "Ils en prennent. L'effet ne se fait pas attendre. Leurs yeux s'écarquillent. L'un fixe la lune, bouche ouverte, en bavant. Les deux autres sortent une pelote de laine et se la renvoient en se roulant par terre."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/24
msgctxt "Chance"
msgid "This is your chance."
msgstr "C'est ta chance."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/32/s/0
msgctxt "Choix"
msgid "I wanna punch 'em in the face!"
msgstr "Je veux leur coller mon poing dans la figure !"

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/33/s/0
msgctxt "Choix"
msgid "Don't fail me now, trusty axe."
msgstr "Ne me lâche pas maintenant, fidèle hache."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/7
msgctxt "Chance"
msgid "You throw yourself out of the bushes and toward the one looking at the moon."
msgstr "Tu bondis hors des buissons vers celui qui regarde la lune."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/15
msgctxt "Chance"
msgid "They look at you, right before your fist makes contact."
msgstr "Il te regarde, juste avant que ton poing ne l'atteigne."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/23
msgctxt "Chance"
msgid "\"Uwu...?"
msgstr "« Uwu... ? »"

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/31
msgctxt "Chance"
msgid "POW! You make contact with his face! He falls to the ground. His eyes try to focus in on you, but he is fighting the effects of the Nip."
msgstr "POW ! Tu l'atteins en pleine figure ! Il s'effondre. Ses yeux essaient de faire le point sur toi, mais il lutte contre les effets de l'Herbe."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/39
msgctxt "Chance"
msgid "\"Get up you two! They are here! - Uwu!\""
msgstr "« Debout, vous deux ! {{Il|Elle|Iel}} est là ! - Uwu ! »"

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/47/b/4
msgctxt "Jerry"
msgid "I'll distract one of them with my... laser pointer! How convenient!"
msgstr "Je vais distraire l'un d'eux avec mon... pointeur laser ! Comme ça tombe bien !"

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/50
msgctxt "Chance"
msgid "You prepare for another swing when you feel something latch onto your leg."
msgstr "Tu te prépares à frapper de nouveau quand tu sens quelque chose s'agripper à ta jambe."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/58
msgctxt "Chance"
msgid "Claws from the one closest to you on the ground dig into your calf. They hit you for..."
msgstr "Les griffes de celui qui est au sol, le plus proche de toi, s'enfoncent dans ton mollet. Il t'inflige..."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/66 chance_d20/Guardian_nip_fight/0/c-1/42
msgctxt "Chance"
msgid "15 damage!"
msgstr "15 points de dégâts !"

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/83 chance_d20/Guardian_nip_fight/0/c-1/59
msgctxt "Chance"
msgid "The third one is still preoccupied with the ball of yarn."
msgstr "Le troisième est toujours occupé avec la pelote de laine."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/91/0/s/0
msgctxt "Choix"
msgid "I punch the first one again!"
msgstr "Je frappe encore le premier !"

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/91/1/s/0
msgctxt "Choix"
msgid "The one at my feet is getting kicked!"
msgstr "Celui qui est à mes pieds va se prendre un coup de pied !"

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/91/c-0/7
msgctxt "Chance"
msgid "Dragging the Amup attached to your leg with you, you throw a haymaker at the one standing."
msgstr "En traînant l'Amup accroché à ta jambe, tu décoches un crochet monumental à celui qui est debout."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/91/c-0/15
msgctxt "Chance"
msgid "Only, he isn't standing anymore. You fully knock him out."
msgstr "Sauf qu'il n'est plus debout. Tu l'as mis complètement K.-O."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/91/c-0/23/b/4 chance_d20/Guardian_nip_fight/0/c-0/91/c-1/23/b/4
msgctxt "Jerry"
msgid "I use my laser pointer! I swing wildly, hoping to cause confusion!"
msgstr "J'utilise mon pointeur laser ! Je l'agite dans tous les sens pour semer la confusion !"

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/91/c-0/23/b/12
msgctxt "Chance"
msgid "This new mystical item becomes mesmerizing to the Amup. It pounces at the red circle, and with a BONK, it knocks itself out as it slams into the point of light head first."
msgstr "Ce nouvel objet mystique fascine l'Amup. Il bondit sur le cercle rouge et, BONK, s'assomme en fonçant tête la première sur le point lumineux."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/91/c-0/23/b/20 chance_d20/Guardian_nip_fight/0/c-0/91/c-1/23/b/20
msgctxt "Chance"
msgid "It is confused and will not attack the rest of the encounter."
msgstr "Il est confus et n'attaquera plus pour le reste de la rencontre."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/91/c-0/23/b/28 chance_d20/Guardian_nip_fight/0/c-0/91/c-1/23/b/28
msgctxt "Jerry"
msgid "Well, isn't that great!"
msgstr "Eh bien, c'est génial, non ?"

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/91/c-0/23/b/36 chance_d20/Guardian_nip_fight/0/c-0/91/c-1/23/b/36
msgctxt "Chance"
msgid "There is one Amup left, and he is rolling on the ground, playing with the yarn ball."
msgstr "Il ne reste qu'un Amup, et il se roule par terre en jouant avec la pelote de laine."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/91/c-0/23/b/44 chance_d20/Guardian_nip_fight/0/c-0/91/c-1/23/b/44
msgctxt "Chance"
msgid "He looks around, finally noticing what has happened."
msgstr "Il regarde autour de lui et remarque enfin ce qui s'est passé."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/91/c-0/23/b/52 chance_d20/Guardian_nip_fight/0/c-0/91/c-1/23/b/52
msgctxt "Chance"
msgid "The wide eyed Amup says..."
msgstr "L'Amup aux yeux écarquillés dit..."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/91/c-0/23/b/60 chance_d20/Guardian_nip_fight/0/c-0/91/c-1/23/b/60
msgctxt "Chance"
msgid "\"Naww... I'm good. You win - Uwu!\""
msgstr "« Naan... ça ira. T'as gagné - Uwu ! »"

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/91/c-0/23/b/71 chance_d20/Guardian_nip_fight/0/c-0/91/c-0/51/c-0/34 chance_d20/Guardian_nip_fight/0/c-0/91/c-1/23/b/71
msgctxt "Chance"
msgid "Taking his yarn, you see him run into the woods toward what you know to be the territory of the Doggone Pirates. That Amup is as good as dead."
msgstr "Il prend sa pelote et file dans les bois, vers ce que tu sais être le territoire des Pirates Clébards. Cet Amup ne fera pas de vieux os."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/91/c-0/26
msgctxt "Chance"
msgid "This time, the one attached to your leg bites you. For...."
msgstr "Cette fois, celui qui est accroché à ta jambe te mord. Pour..."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/91/c-0/34
msgctxt "Chance"
msgid "Another 15 damage!"
msgstr "15 points de dégâts de plus !"

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/91/c-0/51/0/s/0
msgctxt "Choix"
msgid "GET IT OFF OF ME!"
msgstr "ENLEVEZ-LE-MOI !"

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/91/c-0/51/c-0/7
msgctxt "Chance"
msgid "You reach for your axe and with one quick swipe, you dispatch of the one attached to your leg."
msgstr "Tu attrapes ta hache et, d'un coup rapide, tu te débarrasses de celui qui est accroché à ta jambe."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/91/c-0/51/c-0/15
msgctxt "Chance"
msgid "The one on the ground stops playing with the yarn to finally notice what has happened."
msgstr "Celui qui est par terre arrête de jouer avec la pelote et remarque enfin ce qui s'est passé."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/91/c-0/51/c-0/23
msgctxt "Chance"
msgid "\"Naw... I'm good. You win. - Uwu!\""
msgstr "« Naan... ça ira. T'as gagné. - Uwu ! »"

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/91/c-1/7
msgctxt "Chance"
msgid "You make contact with your boot."
msgstr "Tu lui colles un coup de botte."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/91/c-1/15
msgctxt "Chance"
msgid "\"Ouch! - Uwu!\""
msgstr "« Aïe ! - Uwu ! »"

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/91/c-1/23/b/12
msgctxt "Chance"
msgid "This new mystical item becomes mesmerizing to the Amup. It pounces at the red circle, and with a BOINK, it knocks itself out as it slams into the point of light head first."
msgstr "Ce nouvel objet mystique fascine l'Amup. Il bondit sur le cercle rouge et, BOÏNG, s'assomme en fonçant tête la première sur le point lumineux."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/91/c-1/26
msgctxt "Chance"
msgid "They let go, but not before you get a claw to the face from your first combatant."
msgstr "Il te lâche, mais pas avant que ton premier adversaire te colle un coup de griffe au visage."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/91/c-1/34
msgctxt "Chance"
msgid "They hit you for a whopping... 10. Only 10 damage. Dang it."
msgstr "Il t'inflige la bagatelle de... 10. Seulement 10 points de dégâts. Zut alors."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/91/c-1/54/0/s/0
msgctxt "Choix"
msgid "Tired of both of them. Come here axe!"
msgstr "Ils me fatiguent, tous les deux. Viens là, la hache !"

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/91/c-1/54/c-0/7
msgctxt "Chance"
msgid "With your axe in hand, you swing wildly. You cut them both down."
msgstr "Hache en main, tu frappes dans tous les sens. Tu les abats tous les deux."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/91/c-1/54/c-0/15/b/4
msgctxt "Jerry"
msgid "I swing my laser pointer around like a rave, celebrating your power!"
msgstr "J'agite mon pointeur laser comme en rave pour célébrer ta puissance !"

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/91/c-1/54/c-0/15/b/12
msgctxt "Chance"
msgid "The laser hits you in the eye, blinding you for a moment."
msgstr "Le laser te touche à l'œil et t'aveugle un instant."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/91/c-1/54/c-0/15/b/20
msgctxt "Jerry"
msgid "Ooops! Sorry!"
msgstr "Oups ! Pardon !"

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/91/c-1/54/c-0/18
msgctxt "Chance"
msgid "As you look to the side, you notice the one Amup who was still playing with the yarn is just... staring at you."
msgstr "En tournant la tête, tu remarques que l'Amup qui jouait encore avec la pelote est juste... en train de te fixer."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/91/c-1/54/c-0/26
msgctxt "Chance"
msgid "As you are covered in the life of his friends, the yarn drops out of his hands."
msgstr "Tandis que tu es couvert{{|e|·e}} de la vie de ses amis, la pelote lui tombe des mains."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/91/c-1/54/c-0/34
msgctxt "Chance"
msgid "\"Nope. Not worth it. I'm out! -Uwu!\""
msgstr "« Non. Ça vaut pas le coup. Je me tire ! - Uwu ! »"

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-0/91/c-1/54/c-0/45
msgctxt "Chance"
msgid "He runs off through the field toward the coast. But also toward Doggone Pirate territory. The yarn trails behind him. He won't live to see the morning if he crosses the pirates."
msgstr "Il s'enfuit à travers champs vers la côte. Mais aussi vers le territoire des Pirates Clébards. La pelote de laine se déroule derrière lui. S'il croise les pirates, il ne verra pas le matin."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-1/7
msgctxt "Chance"
msgid "You seem to remember that the Amup scouts were never really prepared for the edge of your axe. You use this to your advantage and leap towards them. You catch the one staring at the moon unaware and they barely let out a cry of pain -"
msgstr "Tu te souviens que les éclaireurs amup n'ont jamais vraiment été préparés au tranchant de ta hache. Tu en profites et tu bondis sur eux. Tu prends par surprise celui qui fixe la lune ; il a à peine le temps de pousser un cri de douleur..."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-1/15
msgctxt "Chance"
msgid "\"Uwwwwu!\""
msgstr "« Uwwwwu ! »"

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-1/26
msgctxt "Chance"
msgid "Before they go down."
msgstr "... avant de s'effondrer."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-1/34
msgctxt "Chance"
msgid "You turn to swing on the other two when you feel something latch onto your leg. Claws from the one closest to you on the ground dig into your calf. They hit you for..."
msgstr "Tu te retournes pour frapper les deux autres quand tu sens quelque chose s'agripper à ta jambe. Les griffes de celui qui est au sol, le plus proche de toi, s'enfoncent dans ton mollet. Il t'inflige..."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-1/67/0/s/0
msgctxt "Choix"
msgid "Get off me, yo!"
msgstr "Lâche-moi, mec !"

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-1/67/c-0/7
msgctxt "Chance"
msgid "Your axe comes down, dispatching the second Amup in a heartbeat."
msgstr "Ta hache s'abat et règle son compte au deuxième Amup en un clin d'œil."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-1/67/c-0/15/b/4
msgctxt "Jerry"
msgid "That looked like it hurt! I will use my... slinky!"
msgstr "Ça avait l'air de faire mal ! J'utilise mon... ressort magique !"

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-1/67/c-0/15/b/12
msgctxt "Chance"
msgid "Umm, okay. It bounces around the battlefield, creating a soothing shimmer in the moonlight."
msgstr "Euh, d'accord. Il rebondit à travers le champ de bataille et miroite paisiblement sous le clair de lune."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-1/67/c-0/15/b/20
msgctxt "Chance"
msgid "The metal coil catches the eye of the final Amup. It looks around, finally aware of what has happened."
msgstr "La spirale de métal attire l'œil du dernier Amup. Il regarde autour de lui et prend enfin conscience de ce qui s'est passé."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-1/67/c-0/15/b/28
msgctxt "Jerry"
msgid "I yell at it, holding up a... thumb tack."
msgstr "Je lui crie dessus en brandissant une... punaise."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-1/67/c-0/15/b/36
msgctxt "Jerry"
msgid "YOU WANT SOME OF THIS?!"
msgstr "T'EN VEUX UN BOUT ?!"

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-1/67/c-0/15/b/44
msgctxt "Chance"
msgid "The slinky starts to move toward the Amup, and it is struck with fear!"
msgstr "Le ressort se met à avancer vers l'Amup, qui est frappé de terreur !"

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-1/67/c-0/15/b/52 chance_d20/Guardian_nip_fight/0/c-1/67/c-0/26
msgctxt "Chance"
msgid "\"Keep the shiny thing away from meeeee!! - Uwu!\""
msgstr "« Éloignez de moi le truc brillaaaant !! - Uwu ! »"

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-1/67/c-0/15/b/63 chance_d20/Guardian_nip_fight/0/c-1/67/c-0/37
msgctxt "Chance"
msgid "The Amup runs, happy to have his life. And his yarn. But, strangely enough... he runs towards your village. Must be the Nip. You have full confidence the people in your village will know what to do with him."
msgstr "L'Amup s'enfuit, trop content d'avoir la vie sauve. Et sa pelote. Mais, chose étrange... il court vers ton village. Sûrement l'effet de l'Herbe. Tu as toute confiance en tes villageois pour savoir quoi faire de lui."

# Traduction IA – à relire
#: chance_d20/Guardian_nip_fight/0/c-1/67/c-0/18
msgctxt "Chance"
msgid "The third Amup is finally coming to his senses. It becomes obvious that he doesn't want the smoke."
msgstr "Le troisième Amup reprend enfin ses esprits. Il est évident qu'il ne veut pas d'ennuis."

# Traduction IA – à relire
#: chance_d20/Guardian_scout_warning/0/0
msgctxt "Chance"
msgid "You feel yourself fill up with wounded pride. The fact they think you aren't worth their full attention is disrespectful!"
msgstr "Tu sens l'orgueil blessé monter en toi. Qu'ils ne te jugent pas digne de toute leur attention, c'est un manque de respect !"

# Traduction IA – à relire
#: chance_d20/Guardian_scout_warning/0/8
msgctxt "Chance"
msgid "You pop out the bushes, running towards them. You yell—"
msgstr "Tu jaillis des buissons et fonces sur eux. Tu cries..."

# Traduction IA – à relire
#: chance_d20/Guardian_scout_warning/0/16
msgctxt "Chance"
msgid "Well, what do you yell?"
msgstr "Bon, tu cries quoi ?"

# Traduction IA – à relire
#: chance_d20/Guardian_scout_warning/0/24/s/0
msgctxt "Choix"
msgid "I'll get you, you furballs!"
msgstr "Je vais vous avoir, boules de poils !"

# Traduction IA – à relire
#: chance_d20/Guardian_scout_warning/0/25/s/0
msgctxt "Choix"
msgid "Fear me! FEAR ME!"
msgstr "Craignez-moi ! CRAIGNEZ-MOI !"

# Traduction IA – à relire
#: chance_d20/Guardian_scout_warning/0/26/s/0
msgctxt "Choix"
msgid "Oh, you think you're so bad?! LET'S GO!"
msgstr "Oh, vous vous croyez balèzes ?! ALLEZ, VENEZ !"

# Traduction IA – à relire
#: chance_d20/Guardian_scout_warning/0/g-0/0/b/4
msgctxt "Jerry"
msgid "Brandishing a highlighter cap, I yell \"Come get some!\""
msgstr "Je brandis un bouchon de surligneur et je crie : « Approchez, si vous l'osez ! »"

# Traduction IA – à relire
#: chance_d20/Guardian_scout_warning/0/g-0/3
msgctxt "Chance"
msgid "You startle them all, and they fly into the air. One of them drops a red ball of yarn. They scramble to pick it up."
msgstr "Tu les fais tous sursauter, et ils bondissent en l'air. L'un d'eux laisse tomber une pelote de laine rouge. Ils se précipitent pour la ramasser."

# Traduction IA – à relire
#: chance_d20/Guardian_scout_warning/0/g-0/11
msgctxt "Chance"
msgid "\"Quick! We must alert the camp! - Uwu!\""
msgstr "« Vite ! Il faut prévenir le camp ! - Uwu ! »"

# Traduction IA – à relire
#: chance_d20/Guardian_scout_warning/0/g-0/19
msgctxt "Chance"
msgid "One thing about the Amup is they are quick when they want to be. Before you know it, they are running down the path toward the Amup camp."
msgstr "Il faut savoir une chose sur les Amup : ils sont rapides quand ils le veulent. Avant que tu comprennes ce qui se passe, ils filent sur le chemin vers le camp amup."

# Traduction IA – à relire
#: chance_d20/Guardian_scout_warning/0/g-0/27/s/0
msgctxt "Choix"
msgid "TELL THEM I'M COMING FOR THEM!"
msgstr "DITES-LEUR QUE JE VIENS LES CHERCHER !"

# Traduction IA – à relire
#: chance_d20/Guardian_scout_warning/0/g-0/28/s/0
msgctxt "Choix"
msgid "YEAH, YOU BETTER RUN!"
msgstr "C'EST ÇA, COUREZ !"

# Traduction IA – à relire
#: chance_d20/Guardian_gather_information/0/6
msgctxt "Chance"
msgid "You bide your time as they make their rounds and then gather together to partake in the Nip."
msgstr "Tu attends ton heure pendant qu'ils font leur ronde, puis se rassemblent pour se faire un petit coup d'Herbe."

# Traduction IA – à relire
#: chance_d20/Guardian_gather_information/0/14
msgctxt "Chance"
msgid "It doesn't take long for it to take hold of them. One stares at the moon while the other two become preoccupied with a red ball of yarn."
msgstr "L'effet ne se fait pas attendre. L'un fixe la lune, tandis que les deux autres ne pensent plus qu'à une pelote de laine rouge."

# Traduction IA – à relire
#: chance_d20/Guardian_gather_information/0/22
msgctxt "Chance"
msgid "You wait for one of them to isolate themself. The moon obsessed one stumbles closer to you. Still looking up, he stops right by your hiding spot."
msgstr "Tu attends que l'un d'eux s'isole. Celui qui est obsédé par la lune titube vers toi. Toujours le nez en l'air, il s'arrête juste à côté de ta cachette."

# Traduction IA – à relire
#: chance_d20/Guardian_gather_information/0/30/s/0
msgctxt "Choix"
msgid "I snatch 'em!"
msgstr "Je l'attrape !"

# Traduction IA – à relire
#: chance_d20/Guardian_gather_information/0/31/s/0
msgctxt "Choix"
msgid "Get over here, ya punk!"
msgstr "Viens par là, petite frappe !"

# Traduction IA – à relire
#: chance_d20/Guardian_gather_information/0/32/s/0
msgctxt "Choix"
msgid "OOOOO, you mine now!"
msgstr "OOOOH, t'es à moi, maintenant !"

# Traduction IA – à relire
#: chance_d20/Guardian_gather_information/0/g-0/0
msgctxt "Chance"
msgid "You snatch 'em, pulling them into the bushes with you. You slide your hand over their mouth. They don't resist."
msgstr "Tu l'attrapes et tu l'entraînes avec toi dans les buissons. Tu lui plaques la main sur la bouche. Il ne résiste pas."

# Traduction IA – à relire
#: chance_d20/Guardian_gather_information/0/g-0/8
msgctxt "Chance"
msgid "The other two? Obsessed with the yarn. They don't even notice he is gone."
msgstr "Les deux autres ? Obsédés par la pelote. Ils ne remarquent même pas qu'il a disparu."

# Traduction IA – à relire
#: chance_d20/Guardian_gather_information/0/g-0/16/b/4
msgctxt "Jerry"
msgid "I pull out my laser pointer, ready to distract them if they start looking around for their friend, here."
msgstr "Je sors mon pointeur laser, prêt à les distraire s'ils se mettent à chercher leur copain."

# Traduction IA – à relire
#: chance_d20/Guardian_gather_information/0/g-0/19/s/0
msgctxt "Choix"
msgid "Don't scream, or I'll end you!"
msgstr "Ne crie pas, ou je t'achève !"

# Traduction IA – à relire
#: chance_d20/Guardian_gather_information/0/g-0/20/s/0
msgctxt "Choix"
msgid "Keep your mouth shut if you wanna keep your whiskers!"
msgstr "Tais-toi si tu veux garder tes moustaches !"

# Traduction IA – à relire
#: chance_d20/Guardian_gather_information/0/g-0/21/s/0
msgctxt "Choix"
msgid "You better not yell when I move my hand."
msgstr "T'as intérêt à ne pas crier quand je retire ma main."

# Traduction IA – à relire
#: chance_d20/Guardian_gather_information/0/g-1/0
msgctxt "Chance"
msgid "You feel a sandpaper tongue against your hand. They are out of it."
msgstr "Tu sens une langue râpeuse comme du papier de verre contre ta main. Il est complètement à l'ouest."

# Traduction IA – à relire
#: chance_d20/Guardian_gather_information/0/g-1/8
msgctxt "Chance"
msgid "You remove your hand. They still just stare at the moon."
msgstr "Tu retires ta main. Il fixe toujours la lune."

# Traduction IA – à relire
#: chance_d20/Guardian_gather_information/0/g-1/16
msgctxt "Chance"
msgid "\"You looking for your partner? - Uwu?\""
msgstr "« Tu cherches ta moitié ? - Uwu ? »"

# Traduction IA – à relire
#: chance_d20/Guardian_gather_information/0/g-1/24/s/0
msgctxt "Choix"
msgid "Uhh... yeah."
msgstr "Euh... ouais."

# Traduction IA – à relire
#: chance_d20/Guardian_gather_information/0/g-1/25/s/0
msgctxt "Choix"
msgid "Is this some sort of trick?"
msgstr "C'est une sorte de piège ?"

# Traduction IA – à relire
#: chance_d20/Guardian_gather_information/0/g-1/c-7/7
msgctxt "Chance"
msgid "\"I don't really wanna fight. I wanna be a painter. - Uwu!\""
msgstr "« J'ai pas trop envie de me battre. Je veux être peintre. - Uwu ! »"

# Traduction IA – à relire
#: chance_d20/Guardian_gather_information/0/g-1/c-7/15
msgctxt "Chance"
msgid "\"So, I'll tell you how to get to them if you want. - Uwu!\""
msgstr "« Alors je vais te dire comment la retrouver, si tu veux. - Uwu ! »"

# Traduction IA – à relire
#: chance_d20/Guardian_gather_information/0/g-1/c-7/23
msgctxt "Chance"
msgid "\"I just want to capture the moon in all it's splendiferous amazingness. - Uwu! Uwu! Uwwwwu!\""
msgstr "« Je veux juste capturer la lune dans toute sa splendifique merveillosité. - Uwu ! Uwu ! Uwwwwu ! »"

# Traduction IA – à relire
#: chance_d20/Guardian_gather_information/0/g-1/c-7/31/0/s/0
msgctxt "Choix"
msgid "Okay, they are the most precious."
msgstr "Ok, c'est la créature la plus adorable du monde."

# Traduction IA – à relire
#: chance_d20/Guardian_gather_information/0/g-1/c-7/31/1/s/0
msgctxt "Choix"
msgid "Well, that was unexpected."
msgstr "Eh ben, je m'y attendais pas."

# Traduction IA – à relire
#: chance_d20/Guardian_gather_information/0/g-1/c-7/31/2/s/0
msgctxt "Choix"
msgid "I love it when you go \"Uwu!\""
msgstr "J'adore quand tu fais « Uwu ! »"

# Traduction IA – à relire
#: chance_d20/Guardian_gather_information/0/g-1/c-7/31/c-2/7
msgctxt "Chance"
msgid "You're making me blush!"
msgstr "Tu me fais rougir !"

# Traduction IA – à relire
#: chance_d20/Guardian_gather_information/0/g-2/0
msgctxt "Chance"
msgid "Ahem... The Amup get uncomfortably close to you, whispering in your ear a secret passage to the dungeon where your partner is being held. Their tongue brushes against your face a few times."
msgstr "Hum... L'Amup s'approche un peu trop près de toi et te murmure à l'oreille le passage secret qui mène au cachot où ta moitié est retenue. Sa langue t'effleure le visage à plusieurs reprises."

# Traduction IA – à relire
#: chance_d20/Guardian_gather_information/0/g-2/8/s/0
msgctxt "Choix"
msgid "I kinda like it... I think."
msgstr "J'aime bien, en fait... je crois."

# Traduction IA – à relire
#: chance_d20/Guardian_gather_information/0/g-2/9/s/0
msgctxt "Choix"
msgid "I listen and then remove my hands from them to free them."
msgstr "J'écoute, puis je le lâche pour le libérer."

# Traduction IA – à relire
#: chance_d20/Guardian_gather_information/0/g-2/c-8/7
msgctxt "Chance"
msgid "Noted! Hehe."
msgstr "C'est noté ! Hihi."

# Traduction IA – à relire
#: chance_d20/Guardian_gather_information/0/g-2/c-9/7
msgctxt "Chance"
msgid "You release them as soon as you have what you need."
msgstr "Tu le relâches dès que tu as ce qu'il te faut."

# Traduction IA – à relire
#: chance_d20/Guardian_gather_information/0/g-3/0
msgctxt "Chance"
msgid "Almost as if nothing happened, the moment you let them go, they stare at the moon again. They go over to their fellow scouts, and whisper something to them."
msgstr "Comme si de rien n'était, dès que tu le lâches, il se remet à fixer la lune. Il rejoint ses camarades éclaireurs et leur murmure quelque chose."

# Traduction IA – à relire
#: chance_d20/Guardian_gather_information/0/g-3/8
msgctxt "Chance"
msgid "The two on the ground look your way. They wave."
msgstr "Les deux qui sont par terre se tournent vers toi. Ils te font coucou."

# Traduction IA – à relire
#: chance_d20/Guardian_gather_information/0/g-3/16/b/4
msgctxt "Jerry"
msgid "Precious. Simply precious!"
msgstr "Adorables. Tout simplement adorables !"

# Traduction IA – à relire
#: chance_d20/Guardian_gather_information/0/g-3/19/s/0
msgctxt "Choix"
msgid "I... wave back?"
msgstr "Je... leur fais coucou aussi ?"

# Traduction IA – à relire
#: chance_d20/Guardian_gather_information/0/g-3/20/s/0
msgctxt "Choix"
msgid "I stay hidden."
msgstr "Je reste {{caché|cachée|caché·e}}."

# Traduction IA – à relire
#: chance_d20/Guardian_gather_information/0/g-4/0
msgctxt "Chance"
msgid "They then get up, move out of the way of the path, and continue with what they were doing. You have passage. These Amup won't bother you."
msgstr "Puis ils se relèvent, s'écartent du chemin et reprennent leurs activités. La voie est libre. Ces Amup ne t'embêteront pas."

# Traduction IA – à relire
#: chance_d20/Guardian_part5/0/3
msgctxt "Chance"
msgid "As you take off toward the Amup camp, you find yourself upon a dried up stream bed."
msgstr "Tandis que tu te diriges vers le camp amup, tu tombes sur le lit d'un ruisseau asséché."

# Traduction IA – à relire
#: chance_d20/Guardian_part5/0/11
msgctxt "Chance"
msgid "The warm days the past few months have not been kind to this stream. You look down on the dry streambed and you think of the first time you spent the day next to it."
msgstr "Les journées chaudes de ces derniers mois n'ont pas épargné ce ruisseau. Tu contemples son lit à sec et tu repenses à la première journée que tu as passée à ses côtés."

# Traduction IA – à relire
#: chance_d20/Guardian_part5/0/19
msgctxt "Chance"
msgid "It was the war. The battle had been raging on several fronts and the weather had been gloomy. But, on this day, the sun was out. It was just plain perfect that day. And both sides of the conflict knew it. No attacks were launched."
msgstr "C'était pendant la guerre. La bataille faisait rage sur plusieurs fronts et le temps était maussade. Mais ce jour-là, le soleil brillait. C'était tout simplement une journée parfaite. Et les deux camps le savaient. Aucune attaque ne fut lancée."

# Traduction IA – à relire
#: chance_d20/Guardian_part5/0/27
msgctxt "Chance"
msgid "Instead, you got to bathe in the cool stream waters. You cleaned your wounds, washed your face, and relaxed for the first time in weeks."
msgstr "Au lieu de ça, tu as pu te baigner dans les eaux fraîches du ruisseau. Tu as nettoyé tes plaies, lavé ton visage et, pour la première fois depuis des semaines, tu t'es détendu{{|e|·e}}."

# Traduction IA – à relire
#: chance_d20/Guardian_part5/0/35
msgctxt "Chance"
msgid "That was when you first saw your partner in their birthday suit. You were spellbound. You didn't make a move then. Instead, you played it cool."
msgstr "C'est là que tu as vu ta moitié dans le plus simple appareil pour la première fois. Tu étais {{envoûté|envoûtée|envoûté·e}}. Tu n'as rien tenté, ce jour-là. Tu as joué la carte de la décontraction."

# Traduction IA – à relire
#: chance_d20/Guardian_part5/0/43
msgctxt "Chance"
msgid "You cracked jokes, splashed around, and let the sun dry your skin together."
msgstr "Vous avez plaisanté, fait des éclaboussures, et laissé le soleil sécher votre peau, ensemble."

# Traduction IA – à relire
#: chance_d20/Guardian_part5/0/51
msgctxt "Chance"
msgid "That was the day you fell in love with them. You are certain of it. It would take months after the fighting had ended for you to finally try to court them."
msgstr "C'est ce jour-là que tu es {{tombé|tombée|tombé·e}} amoureux{{|se|·se}}. Tu en es certain{{|e|·e}}. Il t'a fallu des mois, après la fin des combats, pour enfin oser lui faire la cour."

# Traduction IA – à relire
#: chance_d20/Guardian_part5/0/59
msgctxt "Chance"
msgid "But this is where it began. It feels fitting that it is dry now."
msgstr "Mais c'est ici que tout a commencé. C'est presque symbolique que le ruisseau soit à sec, aujourd'hui."

# Traduction IA – à relire
#: chance_d20/Guardian_part5/0/67/b/4
msgctxt "Jerry"
msgid "That... was beautiful!"
msgstr "C'était... magnifique !"

# Traduction IA – à relire
#: chance_d20/Guardian_part5/0/70/s/0
msgctxt "Choix"
msgid "I can't stop and linger here. I want to press on! I must save them."
msgstr "Je ne peux pas m'attarder ici. Je veux continuer ! Je dois sauver ma moitié."

# Traduction IA – à relire
#: chance_d20/Guardian_part5/0/71/s/0
msgctxt "Choix"
msgid "I want to take just one more moment and remember that time."
msgstr "Je veux prendre encore un petit moment pour me souvenir de cette époque."

# Traduction IA – à relire
#: chance_d20/Guardian_part5/0/c-0/7
msgctxt "Chance"
msgid "You notice the fatigue in your body, but you don't let it slow you down. You press on toward the camp."
msgstr "Tu sens la fatigue dans ton corps, mais tu ne la laisses pas te ralentir. Tu poursuis ta route vers le camp."

# Traduction IA – à relire
#: chance_d20/Guardian_part5/0/c-0/15/b/4
msgctxt "Jerry"
msgid "Wait... I scoop up some of the mud from the river bed and create a mud mask! Just a moment to pamper yourself!"
msgstr "Attends... Je ramasse un peu de boue dans le lit de la rivière et je fais un masque à l'argile ! Un petit moment pour prendre soin de toi !"

# Traduction IA – à relire
#: chance_d20/Guardian_part5/0/c-0/15/b/12
msgctxt "Chance"
msgid "Okay! Strike the mud mask sample from your inventory. How much do you heal for?"
msgstr "D'accord ! Raye l'échantillon de masque à l'argile de ton inventaire. Ça soigne combien ?"

# Traduction IA – à relire
#: chance_d20/Guardian_part5/0/c-0/15/b/20
msgctxt "Jerry"
msgid "Let's see... Cheese and crackers! Only 5 hp! Sorry it isn't more."
msgstr "Voyons voir... Nom d'une agrafeuse ! Seulement 5 PV ! Désolé, c'est pas plus."

# Traduction IA – à relire
#: chance_d20/Guardian_part5/0/c-1/7
msgctxt "Chance"
msgid "As you close your eyes to take in the space, you notice the tiniest sound of a trickle."
msgstr "Tandis que tu fermes les yeux pour t'imprégner du lieu, tu perçois le plus infime bruit de ruissellement."

# Traduction IA – à relire
#: chance_d20/Guardian_part5/0/c-1/15
msgctxt "Chance"
msgid "Sure enough, further up hill, there is a small amount of water starting to rise up from an underground spring. It is running clear and shining in the moonlight."
msgstr "Et en effet, plus haut sur la colline, un filet d'eau commence à jaillir d'une source souterraine. Elle coule, limpide, et scintille sous la lune."

# Traduction IA – à relire
#: chance_d20/Guardian_part5/0/c-1/23
msgctxt "Chance"
msgid "You reach down, and splash your face with it. It is refreshing and rejuvenating."
msgstr "Tu te penches pour t'en asperger le visage. C'est rafraîchissant et revigorant."

# Traduction IA – à relire
#: chance_d20/Guardian_part5/0/c-1/31
msgctxt "Chance"
msgid "You gain 15 health!"
msgstr "Tu gagnes 15 PV !"

# Traduction IA – à relire
#: chance_d20/Guardian_part5/0/c-1/48
msgctxt "Chance"
msgid "With the memory of your partner ever present, you push on. You are ready to take on whatever is next."
msgstr "Le souvenir de ta moitié toujours présent à l'esprit, tu poursuis ta route. Tu es {{prêt|prête|prêt·e}} à affronter ce qui t'attend."

# Traduction IA – à relire
#: chance_d20/Guardian_part6/0/0
msgctxt "Chance"
msgid "You find yourself at the edge of the Amup camp. They are out in full force. You scout the area to try to decide what to do."
msgstr "Te voilà aux abords du camp amup. Ils sont en force. Tu examines les environs pour décider de la marche à suivre."

# Traduction IA – à relire
#: chance_d20/Guardian_part6/0/8
msgctxt "Chance"
msgid "Lucky for you, not much has changed in the decade since you last stormed these wooden walls. This gives you a slight advantage."
msgstr "Par chance, pas grand-chose n'a changé en dix ans, depuis la dernière fois que tu as pris d'assaut ces palissades. Ça te donne un léger avantage."

# Traduction IA – à relire
#: chance_d20/Guardian_part6/0/16
msgctxt "Chance"
msgid "Still, they have numbers on their side."
msgstr "Mais ils ont le nombre pour eux."

# Traduction IA – à relire
#: chance_d20/Guardian_part6/0/24/s/0
msgctxt "Choix"
msgid "Screw the numbers! I'mma take 'em all out!"
msgstr "Au diable le nombre ! Je vais tous les dégommer !"

# Traduction IA – à relire
#: chance_d20/Guardian_part6/0/25/s/0
msgctxt "Choix"
msgid "I should be smart about this. So, I'll watch their patterns and find an opportune time to slip in."
msgstr "Je dois être malin{{|e|·e}}. Je vais observer leurs rondes et trouver le bon moment pour me faufiler."

# Traduction IA – à relire
#: chance_d20/Guardian_part6/0/26/s/0
msgctxt "Choix"
msgid "I try to think back a decade to when I was first here. Surely I remember a way to get in."
msgstr "J'essaie de me rappeler la première fois que je suis venu{{|e|·e}} ici, il y a dix ans. Je dois bien me souvenir d'un moyen d'entrer."

# Traduction IA – à relire
#: chance_d20/Guardian_part6/0/27/s/0 chance_d20/Guardian_part6_a/0/21/s/0
msgctxt "Choix"
msgid "I start looking for secret passage the scout told me about."
msgstr "Je cherche le passage secret dont l'éclaireur m'a parlé."

# Traduction IA – à relire
#: chance_d20/Guardian_murderhobo/0/0
msgctxt "Chance"
msgid "You... think you miiiight be able to take them. But there are a lot of them. Like... a lot."
msgstr "Tu... penses que tu pourrais peut-êêêtre en venir à bout. Mais ils sont nombreux. Genre... vraiment nombreux."

# Traduction IA – à relire
#: chance_d20/Guardian_murderhobo/0/8/b/4
msgctxt "Jerry"
msgid "It might not be the best idea. I can only heal so much."
msgstr "C'est peut-être pas la meilleure idée. Je ne peux pas soigner à l'infini."

# Traduction IA – à relire
#: chance_d20/Guardian_murderhobo/0/11/s/0
msgctxt "Choix"
msgid "And? I'm the hero. I can take 'em on! I rush in, screaming a war cry!"
msgstr "Et alors ? C'est moi, {{le héros|l'héroïne|la figure héroïque}}. Je peux les affronter ! Je fonce en poussant un cri de guerre !"

# Traduction IA – à relire
#: chance_d20/Guardian_murderhobo/0/12/s/0
msgctxt "Choix"
msgid "Fine... we will go with stealth or whatever."
msgstr "Bon... on va faire dans la discrétion, ou je sais pas quoi."

# Traduction IA – à relire
#: chance_d20/Guardian_murderhobo_2/0/0
msgctxt "Chance"
msgid "Okay. You umm... you go screaming toward the gates of the encampment."
msgstr "D'accord. Tu, euh... tu fonces en hurlant vers les portes du campement."

# Traduction IA – à relire
#: chance_d20/Guardian_murderhobo_2/0/8
msgctxt "Chance"
msgid "SWOOSH! An arrow finds its way into your arm. You taaaake...."
msgstr "FIOU ! Une flèche se plante dans ton bras. Tu subiiiis..."

# Traduction IA – à relire
#: chance_d20/Guardian_murderhobo_2/0/16
msgctxt "Chance"
msgid "Oof... 20 Damage."
msgstr "Ouille... 20 points de dégâts."

# Traduction IA – à relire
#: chance_d20/Guardian_murderhobo_2/0/33
msgctxt "Chance"
msgid "\"THEY APPROACH! FIRE!! - UWU!\""
msgstr "« {{IL|ELLE|IEL}} ARRIVE ! TIREZ !! - UWU ! »"

# Traduction IA – à relire
#: chance_d20/Guardian_murderhobo_2/0/41
msgctxt "Chance"
msgid "You have a moment where you can turn back and take cover. Or you can charge forward."
msgstr "Tu as un instant pour faire demi-tour et te mettre à couvert. Ou tu peux charger."

# Traduction IA – à relire
#: chance_d20/Guardian_murderhobo_2/0/49/s/0
msgctxt "Choix"
msgid "Running is for wimps. I ain't no wimp! FORWARD!"
msgstr "Fuir, c'est pour les mauviettes. Et je suis pas une mauviette ! EN AVANT !"

# Traduction IA – à relire
#: chance_d20/Guardian_murderhobo_2/0/50/s/0
msgctxt "Choix"
msgid "Yeah, I should rethink things."
msgstr "Ouais, je devrais revoir mes plans."

# Traduction IA – à relire
#: chance_d20/Guardian_murderhobo_2/0/c-0/7
msgctxt "Chance"
msgid "Umm... okay."
msgstr "Euh... d'accord."

# Traduction IA – à relire
#: chance_d20/Guardian_murderhobo_2/0/c-0/18
msgctxt "Chance"
msgid "As you sprint forward, a volley of arrows fly out from the top of the camp walls. Not all of them find their mark but..."
msgstr "Tandis que tu fonces, une volée de flèches jaillit du haut des palissades. Elles ne font pas toutes mouche, mais..."

# Traduction IA – à relire
#: chance_d20/Guardian_murderhobo_2/0/c-0/26
msgctxt "Chance"
msgid "Eeesh... 7 of them hit you. For..."
msgstr "Aïe aïe aïe... 7 d'entre elles te touchent. Pour..."

# Traduction IA – à relire
#: chance_d20/Guardian_murderhobo_2/0/c-0/34
msgctxt "Chance"
msgid "Holy Crit... 115 damage."
msgstr "Nom d'un crit... 115 points de dégâts."

# Traduction IA – à relire
#: chance_d20/Guardian_murderhobo_2/0/c-0/42/b/4
msgctxt "Jerry"
msgid "I don't... I don't have anything to help you out that much!"
msgstr "Je... J'ai rien qui puisse te soigner autant !"

# Traduction IA – à relire
#: chance_d20/Guardian_murderhobo_2/0/c-0/42/b/12
msgctxt "Chance"
msgid "They see you, too, Jerry! They pounce on you!"
msgstr "Ils te voient aussi, Jerry ! Ils te sautent dessus !"

# Traduction IA – à relire
#: chance_d20/Guardian_murderhobo_2/0/c-0/42/b/20
msgctxt "Jerry"
msgid "I lift my letter opener, ready to strike!"
msgstr "Je lève mon coupe-papier, prêt à frapper !"

# Traduction IA – à relire
#: chance_d20/Guardian_murderhobo_2/0/c-0/42/b/28
msgctxt "Chance"
msgid "You swing and strike one of them. That doesn't stop them all from descending upon you."
msgstr "Tu frappes et tu touches l'un d'eux. Ça ne les empêche pas de tous te tomber dessus."

# Traduction IA – à relire
#: chance_d20/Guardian_murderhobo_2/0/c-0/42/b/36
msgctxt "Chance"
msgid "You take... 87 damage, Jerry."
msgstr "Tu subis... 87 points de dégâts, Jerry."

# Traduction IA – à relire
#: chance_d20/Guardian_murderhobo_2/0/c-0/42/b/44
msgctxt "Jerry"
msgid "I'm... I'm down."
msgstr "Je suis... Je suis K.-O."

# Traduction IA – à relire
#: chance_d20/Guardian_murderhobo_2/0/c-0/45
msgctxt "Chance"
msgid "Your lack of planning seems to have been your downfall as your fall to the ground. Lifeless."
msgstr "Ton manque de préparation semble avoir causé ta perte : tu t'effondres au sol. Sans vie."

# Traduction IA – à relire
#: chance_d20/Guardian_murderhobo_2/0/c-0/53
msgctxt "Chance"
msgid "Because... you were outnumbered. So... yeah."
msgstr "Parce que... ils étaient plus nombreux. Donc... voilà."

# Traduction IA – à relire
#: chance_d20/Guardian_part6_a/0/0
msgctxt "Chance"
msgid "You quickly duck back behind the treeline. Arrows fly past you, but none can find purchase this time around."
msgstr "Tu te replies vite derrière la lisière des arbres. Des flèches sifflent à côté de toi, mais aucune ne fait mouche cette fois."

# Traduction IA – à relire
#: chance_d20/Guardian_part6_a/0/8
msgctxt "Chance"
msgid "But now the camp is on high alert. So you have to be careful."
msgstr "Mais maintenant, le camp est en état d'alerte. Tu dois donc être prudent{{|e|·e}}."

# Traduction IA – à relire
#: chance_d20/Guardian_part6_a/0/16/b/4
msgctxt "Jerry"
msgid "That was a close one!"
msgstr "On l'a échappé belle !"

# Traduction IA – à relire
#: chance_d20/Guardian_part6_a/0/19/s/0
msgctxt "Choix"
msgid "I am going to watch their patrol patterns and find a time to slip in."
msgstr "Je vais observer leurs rondes et trouver le moment de me faufiler."

# Traduction IA – à relire
#: chance_d20/Guardian_part6_a/0/20/s/0
msgctxt "Choix"
msgid "I'll try to remember anything I did last time I was here. Any path or anything."
msgstr "Je vais essayer de me rappeler ce que j'ai fait la dernière fois que je suis venu{{|e|·e}} ici. Un chemin, n'importe quoi."

# Traduction IA – à relire
#: chance_d20/Guardian_part7/0/0
msgctxt "Chance"
msgid "You watch for a time to slip into the camp."
msgstr "Tu guettes le bon moment pour te faufiler dans le camp."

# Traduction IA – à relire
#: chance_d20/Guardian_part7/0/8
msgctxt "Chance"
msgid "And then it hits you. You remember how you got in the first time you were here."
msgstr "Et soudain, ça te revient. Tu te souviens comment tu étais entré{{|e|·e}} la première fois."

# Traduction IA – à relire
#: chance_d20/Guardian_part7/0/16
msgctxt "Chance"
msgid "You look to your left and there, under fallen leaves and palm fronds, you see it - the path that leads around to the back of the camp."
msgstr "Tu regardes sur ta gauche et là, sous les feuilles mortes et les palmes, tu le vois : le chemin qui contourne le camp par l'arrière."

# Traduction IA – à relire
#: chance_d20/Guardian_part7/0/24
msgctxt "Chance"
msgid "You take off down it, keeping low and making sure the sight of the camp is on your right."
msgstr "Tu t'y engages, en restant bien bas et en gardant le camp sur ta droite."

# Traduction IA – à relire
#: chance_d20/Guardian_part7/0/32/b/4
msgctxt "Jerry"
msgid "Do I find any loot on the path?"
msgstr "Est-ce que je trouve du butin sur le chemin ?"

# Traduction IA – à relire
#: chance_d20/Guardian_part7/0/32/b/12
msgctxt "Chance"
msgid "I... maybe? Um... there are a few bottles and broken pieces of shields and swords."
msgstr "Je... peut-être ? Euh... quelques bouteilles et des morceaux de boucliers et d'épées cassés."

# Traduction IA – à relire
#: chance_d20/Guardian_part7/0/32/b/20
msgctxt "Jerry"
msgid "I pocket them. I take them all and I'll sort them in my beautiful little gorgeous pack."
msgstr "Je les empoche. Je prends tout, et je trierai ça dans mon magnifique petit sac sublime."

# Traduction IA – à relire
#: chance_d20/Guardian_part7/0/32/b/28
msgctxt "Chance"
msgid "Okay... you do that."
msgstr "D'accord... vas-y."

# Traduction IA – à relire
#: chance_d20/Guardian_part7/0/35
msgctxt "Chance"
msgid "Eventually, you come to a path. It leads to the back entrance of the encampment. You see two Amup guards there."
msgstr "Tu finis par arriver à un chemin. Il mène à l'entrée de derrière du campement. Tu y vois deux gardes amup."

# Traduction IA – à relire
#: chance_d20/Guardian_part7/0/43/s/0
msgctxt "Choix"
msgid "I like these odds better."
msgstr "Je préfère cette configuration."

# Traduction IA – à relire
#: chance_d20/Guardian_part7/0/44/s/0
msgctxt "Choix"
msgid "They won't know what hit them."
msgstr "Ils ne verront rien venir."

# Traduction IA – à relire
#: chance_d20/Guardian_part7/0/g-0/0
msgctxt "Chance"
msgid "You notice that these two Amup look way more prepared than the scouts. They have bows and arrows, along with scimitars and a thicker armor. They know your potential."
msgstr "Tu remarques que ces deux Amup ont l'air bien mieux préparés que les éclaireurs. Ils ont des arcs et des flèches, des cimeterres et une armure plus épaisse. Ils savent de quoi tu es capable."

# Traduction IA – à relire
#: chance_d20/Guardian_part7/0/g-0/8
msgctxt "Chance"
msgid "Looking at your abilities you could..."
msgstr "D'après tes capacités, tu pourrais..."

# Traduction IA – à relire
#: chance_d20/Guardian_part7/0/g-0/16
msgctxt "Chance"
msgid "Oh! You could either try to frighten them from their post using Battle Cry."
msgstr "Oh ! Tu pourrais essayer de les effrayer pour qu'ils quittent leur poste avec ton Cri de Guerre."

# Traduction IA – à relire
#: chance_d20/Guardian_part7/0/g-0/24
msgctxt "Chance"
msgid "Or you could climb a nearby tree and perform the Rain of Terror attack."
msgstr "Ou tu pourrais grimper à un arbre voisin et lancer l'attaque Pluie de Terreur."

# Traduction IA – à relire
#: chance_d20/Guardian_part7/0/g-0/32/s/0
msgctxt "Choix"
msgid "If I can scare them away, let's do that!"
msgstr "Si je peux les faire fuir, faisons ça !"

# Traduction IA – à relire
#: chance_d20/Guardian_part7/0/g-0/33/s/0
msgctxt "Choix"
msgid "Oh, call me thundercloud 'cause it's gonna rain!"
msgstr "Oh, appelle-moi nuage d'orage, parce qu'il va pleuvoir !"

# Traduction IA – à relire
#: chance_d20/Battle_cry/0/0
msgctxt "Chance"
msgid "You reach back into your training. You remember what it was like to learn the Snee Kars Battle Cry for the first time."
msgstr "Tu puises dans ton entraînement. Tu te rappelles ce que ça faisait d'apprendre le Cri de Guerre de Bas-Kets pour la première fois."

# Traduction IA – à relire
#: chance_d20/Battle_cry/0/8
msgctxt "Chance"
msgid "Stepping out of the trees and within their eyesight, the moon bounces off your blade and dances in your eyes."
msgstr "Tu sors des arbres et entres dans leur champ de vision ; la lune se reflète sur ta lame et danse dans tes yeux."

# Traduction IA – à relire
#: chance_d20/Battle_cry/0/16
msgctxt "Chance"
msgid "Pulling forth all the rage and power you can, you open your mouth and something unworldly erupts forth."
msgstr "Rassemblant toute la rage et toute la puissance possibles, tu ouvres la bouche, et quelque chose de surnaturel en jaillit."

# Traduction IA – à relire
#: chance_d20/Battle_cry/0/24
msgctxt "Chance"
msgid "You can almost see the sound reach the Guards. I'm going to roll to see if they get scared..."
msgstr "Tu peux presque voir le son atteindre les gardes. Je vais faire un jet pour voir s'ils prennent peur..."

# Traduction IA – à relire
#: chance_d20/Battle_cry/0/32
msgctxt "Chance"
msgid "Okay! One of the guards instantly drops his weapons and runs. The other finds the courage to steady themselves."
msgstr "D'accord ! L'un des gardes lâche aussitôt ses armes et s'enfuit. L'autre trouve le courage de tenir bon."

# Traduction IA – à relire
#: chance_d20/Battle_cry/0/40
msgctxt "Chance"
msgid "\"You won't scare me! - Uwu!\""
msgstr "« Tu ne me fais pas peur ! - Uwu ! »"

# Traduction IA – à relire
#: chance_d20/Battle_cry/0/48
msgctxt "Chance"
msgid "The guard squares up. Still, they are shaking in their boots. This gives you an opening."
msgstr "Le garde se met en garde. Mais il tremble dans ses bottes. Ça te laisse une ouverture."

# Traduction IA – à relire
#: chance_d20/Battle_cry/0/56/s/0
msgctxt "Choix"
msgid "I attack with my axe!"
msgstr "J'attaque avec ma hache !"

# Traduction IA – à relire
#: chance_d20/Battle_cry/0/57/s/0
msgctxt "Choix"
msgid "Bare hand brawl, baby!"
msgstr "Bagarre à mains nues, bébé !"

# Traduction IA – à relire
#: chance_d20/Battle_cry/0/c-0/7
msgctxt "Chance"
msgid "You run forward, axe in your hand. As you swing down, it catches on their armor. They are badly hurt, but not down yet."
msgstr "Tu cours, hache en main. En l'abattant, tu accroches son armure. Il est gravement blessé, mais pas encore à terre."

# Traduction IA – à relire
#: chance_d20/Battle_cry/0/c-0/15
msgctxt "Chance"
msgid "This shakes them out of their stupor. Without time to reach for their weapon, they do have access to their claws."
msgstr "Ça le tire de sa torpeur. Il n'a pas le temps d'attraper son arme, mais il a toujours ses griffes."

# Traduction IA – à relire
#: chance_d20/Battle_cry/0/c-0/23
msgctxt "Chance"
msgid "SWIPE SWIPE! They scratch you twice for...."
msgstr "SCHLAK SCHLAK ! Il te griffe deux fois pour..."

# Traduction IA – à relire
#: chance_d20/Battle_cry/0/c-0/48/b/1
msgctxt "Jerry"
msgid "I pull out my eraser, and cast Delete Damage, negating all the damage that would have happened!"
msgstr "Je sors ma gomme et je lance Effacement des Dégâts, ce qui annule tous les dégâts qu'il aurait infligés !"

# Traduction IA – à relire
#: chance_d20/Battle_cry/0/c-0/48/b/9
msgctxt "Chance"
msgid "Nice!"
msgstr "Joli !"

# Traduction IA – à relire
#: chance_d20/Battle_cry/0/c-0/51/b/1 chance_d20/Rain_of_terror/127/b/1 chance_d20/Attack_amup/0/44/b/1 chance_d20/Attack_amup_2/0/81/b/1 chance_d20/Pet_amup/0/g-0/52/b/1
msgctxt "Chance"
msgid "You are strong, but you are starting to feel these hits. You can't take too many more."
msgstr "Tu es costaud, mais tu commences à sentir ces coups. Tu ne pourras plus en encaisser beaucoup."

# Traduction IA – à relire
#: chance_d20/Battle_cry/0/c-0/54/b/1 chance_d20/Rain_of_terror/130/b/1 chance_d20/Attack_amup/0/47/b/4 chance_d20/Attack_amup_2/0/84/b/4 chance_d20/Punch_amup/0/68/b/4 chance_d20/Pet_amup/0/g-0/55/b/4
msgctxt "Chance"
msgid "You fall to your knees. It takes a moment, but you realize that this was what took the last of your strength. It goes black as you die how you lived. In battle."
msgstr "Tu tombes à genoux. Il te faut un moment, mais tu comprends que ce coup t'a pris tes dernières forces. Tout devient noir : tu meurs comme tu as vécu. Au combat."

# Traduction IA – à relire
#: chance_d20/Battle_cry/0/c-0/57
msgctxt "Chance"
msgid "Lucky for you, you are quick, too. You swing your axe, making contact with the belly of the Amup. It is obvious you have dispatched of them."
msgstr "Heureusement pour toi, tu es aussi rapide. Tu abats ta hache, qui atteint le ventre de l'Amup. Il est évident que tu lui as réglé son compte."

# Traduction IA – à relire
#: chance_d20/Battle_cry/0/c-0/65 chance_d20/Battle_cry/0/c-1/61 chance_d20/Rain_of_terror/141
msgctxt "Chance"
msgid "And before you, you see an unguarded back road that leads to a set of stairs that goes underground."
msgstr "Et devant toi, tu vois une allée de derrière sans surveillance qui mène à un escalier descendant sous terre."

# Traduction IA – à relire
#: chance_d20/Battle_cry/0/c-0/73 chance_d20/Battle_cry/0/c-1/69 chance_d20/Rain_of_terror/149
msgctxt "Chance"
msgid "That has to be it. That's where they are keeping your partner."
msgstr "C'est forcément là. C'est là qu'ils retiennent ta moitié."

# Traduction IA – à relire
#: chance_d20/Battle_cry/0/c-1/7
msgctxt "Chance"
msgid "Smart choice! You know the axe has power, but your fists have speed."
msgstr "Bon choix ! Tu sais que la hache a de la puissance, mais tes poings ont la vitesse."

# Traduction IA – à relire
#: chance_d20/Battle_cry/0/c-1/15/b/4
msgctxt "Jerry"
msgid "I will use my ballpoint pen and cast Glide!"
msgstr "J'utilise mon stylo-bille et je lance Glisse !"

# Traduction IA – à relire
#: chance_d20/Battle_cry/0/c-1/15/b/12
msgctxt "Jerry"
msgid "This creates a smooth surface, increasing the movement and attack speed by double!"
msgstr "Ça crée une surface lisse qui double la vitesse de déplacement et d'attaque !"

# Traduction IA – à relire
#: chance_d20/Battle_cry/0/c-1/15/b/20
msgctxt "Chance"
msgid "Coming in clutch with the enhancement spell!"
msgstr "Le sort d'amélioration qui tombe pile au bon moment !"

# Traduction IA – à relire
#: chance_d20/Battle_cry/0/c-1/18
msgctxt "Chance"
msgid "You pounce on them like a... well... cat."
msgstr "Tu lui bondis dessus comme un... eh bien... un chat."

# Traduction IA – à relire
#: chance_d20/Battle_cry/0/c-1/26
msgctxt "Chance"
msgid "You unleash your Billow of Barrages upon them, hitting them quickly and powerfully."
msgstr "Tu déchaînes sur lui ta Bourrasque de Barrages, en frappant vite et fort."

# Traduction IA – à relire
#: chance_d20/Battle_cry/0/c-1/34
msgctxt "Chance"
msgid "They try to raise a hand to you, but you strike it down."
msgstr "Il essaie de lever la main contre toi, mais tu la rabats."

# Traduction IA – à relire
#: chance_d20/Battle_cry/0/c-1/42
msgctxt "Chance"
msgid "POW POW POW POW POW!"
msgstr "POW POW POW POW POW !"

# Traduction IA – à relire
#: chance_d20/Battle_cry/0/c-1/53
msgctxt "Chance"
msgid "Before you know it, they have fallen to your hand! They couldn't even get a single attack in!"
msgstr "En un rien de temps, il tombe sous tes coups ! Il n'a même pas pu placer une seule attaque !"

# Traduction IA – à relire
#: chance_d20/Rain_of_terror/0
msgctxt "Chance"
msgid "You find a nearby tree and you climb as high as you can."
msgstr "Tu trouves un arbre tout proche et tu grimpes le plus haut possible."

# Traduction IA – à relire
#: chance_d20/Rain_of_terror/8
msgctxt "Chance"
msgid "The branches are sturdy in this old growth and you find your footing."
msgstr "Les branches de ce vieil arbre sont solides, et tu trouves ton équilibre."

# Traduction IA – à relire
#: chance_d20/Rain_of_terror/16
msgctxt "Chance"
msgid "Axe in hand, you think back to when you first learned this technique."
msgstr "Hache en main, tu repenses à l'époque où tu as appris cette technique."

# Traduction IA – à relire
#: chance_d20/Rain_of_terror/24
msgctxt "Chance"
msgid "You never thought you would get the rotations right, and many times you didn't."
msgstr "Tu pensais ne jamais réussir les rotations, et souvent, tu les as ratées."

# Traduction IA – à relire
#: chance_d20/Rain_of_terror/32
msgctxt "Chance"
msgid "But the feeling of satisfaction you had when you pulled it off in battle surges forward."
msgstr "Mais le sentiment de satisfaction que tu as ressenti en la réussissant au combat te revient d'un coup."

# Traduction IA – à relire
#: chance_d20/Rain_of_terror/40
msgctxt "Chance"
msgid "You know you've got this."
msgstr "Tu sais que tu vas y arriver."

# Traduction IA – à relire
#: chance_d20/Rain_of_terror/48
msgctxt "Chance"
msgid "Turning your back to the guards, you stand on the thick branch. Then... you leap!"
msgstr "Dos aux gardes, tu te tiens sur l'épaisse branche. Puis... tu sautes !"

# Traduction IA – à relire
#: chance_d20/Rain_of_terror/56
msgctxt "Chance"
msgid "You become a tornado of pain and destruction as you spiral through the air."
msgstr "Tu deviens une tornade de douleur et de destruction en tournoyant dans les airs."

# Traduction IA – à relire
#: chance_d20/Rain_of_terror/64/b/4
msgctxt "Jerry"
msgid "This is so coooooool!"
msgstr "C'est trop coooooool !"

# Traduction IA – à relire
#: chance_d20/Rain_of_terror/67
msgctxt "Chance"
msgid "Through sheer will, you find your targets and spin toward them, the axeblade whipping you around and cutting through air."
msgstr "Par la seule force de ta volonté, tu repères tes cibles et tournoies vers elles, la lame de ta hache t'entraînant et fendant l'air."

# Traduction IA – à relire
#: chance_d20/Rain_of_terror/75
msgctxt "Chance"
msgid "Soon, it is cutting through the Amup, and one of them falls to your blade. You catch the second one in the onslaught as well."
msgstr "Bientôt, elle fend les Amup, et l'un d'eux tombe sous ta lame. Tu prends aussi le second dans l'assaut."

# Traduction IA – à relire
#: chance_d20/Rain_of_terror/83
msgctxt "Chance"
msgid "Only, they survive."
msgstr "Sauf qu'il survit."

# Traduction IA – à relire
#: chance_d20/Rain_of_terror/91
msgctxt "Chance"
msgid "You land on the ground, between the dead guard and the injured one."
msgstr "Tu atterris entre le garde mort et le blessé."

# Traduction IA – à relire
#: chance_d20/Rain_of_terror/99/b/4
msgctxt "Jerry"
msgid "I've got this one! I take out a paper clip shaped like a boomerang. I throw it at the Amup, using my Improvised Weapon feat."
msgstr "Je m'occupe de lui ! Je sors un trombone en forme de boomerang. Je le lance sur l'Amup grâce à mon don Arme Improvisée."

# Traduction IA – à relire
#: chance_d20/Rain_of_terror/99/b/12
msgctxt "Chance"
msgid "Your Boomerclip connects with the Amup, taking away what little health it had left."
msgstr "Ton Trombonerang atteint l'Amup et lui retire le peu de PV qu'il lui restait."

# Traduction IA – à relire
#: chance_d20/Rain_of_terror/99/b/20
msgctxt "Jerry"
msgid "I catch the Boomerclip on its return and say..."
msgstr "Je rattrape le Trombonerang à son retour et je dis..."

# Traduction IA – à relire
#: chance_d20/Rain_of_terror/99/b/28
msgctxt "Jerry"
msgid "Never throw away good office supplies!"
msgstr "On ne jette jamais de bonnes fournitures de bureau !"

# Traduction IA – à relire
#: chance_d20/Rain_of_terror/99/b/39
msgctxt "Chance"
msgid "Having defeated those standing in your way, you notice the path forward."
msgstr "Après avoir vaincu ceux qui te barraient la route, tu remarques le chemin qui s'ouvre devant toi."

# Traduction IA – à relire
#: chance_d20/Rain_of_terror/99/b/47
msgctxt "Chance"
msgid "It is clear, as is your sense that your destiny lies before you."
msgstr "Il est dégagé, et tu sens clairement que ton destin t'attend au bout."

# Traduction IA – à relire
#: chance_d20/Rain_of_terror/99/b/55
msgctxt "Chance"
msgid "Ahead is where you will make your stand."
msgstr "C'est là-bas que tu livreras ton dernier combat."

# Traduction IA – à relire
#: chance_d20/Rain_of_terror/102
msgctxt "Chance"
msgid "As you stand, the guard makes two claw attacks at you. They hit you foooor....."
msgstr "Pendant que tu te relèves, le garde te porte deux coups de griffes. Il t'inflige..."

# Traduction IA – à relire
#: chance_d20/Rain_of_terror/110
msgctxt "Chance"
msgid "25 damage."
msgstr "25 points de dégâts."

# Traduction IA – à relire
#: chance_d20/Rain_of_terror/133
msgctxt "Chance"
msgid "Lucky for you, you are quick, too. You swing your axe up, making contact with the belly of the Amup. It is obvious you have dispatched of them."
msgstr "Heureusement pour toi, tu es aussi rapide. Tu relèves ta hache, qui atteint le ventre de l'Amup. Il est évident que tu lui as réglé son compte."

# Traduction IA – à relire
#: chance_d20/Guardian_part7_a/0/0
msgctxt "Chance"
msgid "You decide to trust the word of the moon obsessed Amup. While they told you a convoluted series of turns and tree stumps to look for, you remember every word."
msgstr "Tu décides de te fier à la parole de l'Amup obsédé par la lune. Il t'a décrit une série alambiquée de virages et de souches à repérer, mais tu te souviens de chaque mot."

# Traduction IA – à relire
#: chance_d20/Guardian_part7_a/0/8
msgctxt "Chance"
msgid "You meander your way around the woods, always making sure the encampment is within view."
msgstr "Tu serpentes à travers les bois, en t'assurant de toujours garder le campement en vue."

# Traduction IA – à relire
#: chance_d20/Guardian_part7_a/0/16
msgctxt "Chance"
msgid "It's taking forever though. Did you make the right decision in trusting an Amup?"
msgstr "Mais ça prend une éternité. As-tu eu raison de faire confiance à un Amup ?"

# Traduction IA – à relire
#: chance_d20/Guardian_part7_a/0/24
msgctxt "Chance"
msgid "An Amup on Nip to be more specific."
msgstr "Un Amup sous Herbe, pour être précis."

# Traduction IA – à relire
#: chance_d20/Guardian_part7_a/0/32/b/4
msgctxt "Jerry"
msgid "Do we trust that little cat person?"
msgstr "On fait confiance à ce petit homme-chat ?"

# Traduction IA – à relire
#: chance_d20/Guardian_part7_a/0/35/s/0
msgctxt "Choix"
msgid "I think... I want to turn around."
msgstr "Je crois... que je veux faire demi-tour."

# Traduction IA – à relire
#: chance_d20/Guardian_part7_a/0/36/s/0
msgctxt "Choix"
msgid "The secret entrance has to be around here somewhere."
msgstr "L'entrée secrète doit forcément être quelque part par ici."

# Traduction IA – à relire
#: chance_d20/Guardian_part7_a/0/c-0/7/b/4
msgctxt "Jerry"
msgid "Smart idea."
msgstr "Bonne idée."

# Traduction IA – à relire
#: chance_d20/Guardian_part7_a/0/c-0/10
msgctxt "Chance"
msgid "You decide to abandon this course of action and position yourself with the camp in view to try and come up with a new plan."
msgstr "Tu décides d'abandonner ce plan et de te poster en vue du camp pour essayer d'en trouver un nouveau."

# Traduction IA – à relire
#: chance_d20/Guardian_part7_a/0/c-1/7/b/4
msgctxt "Jerry"
msgid "If you say so!"
msgstr "Si tu le dis !"

# Traduction IA – à relire
#: chance_d20/Guardian_part7_a/0/c-1/10
msgctxt "Chance"
msgid "You continue on the complicated path the Amup told you about."
msgstr "Tu continues sur le chemin compliqué que l'Amup t'a décrit."

# Traduction IA – à relire
#: chance_d20/Guardian_part7_a/0/c-1/18
msgctxt "Chance"
msgid "Suddenly, you walk across something that seems out of place. A portion of the ground almost seems hollow."
msgstr "Soudain, tu marches sur quelque chose qui détonne. Une portion du sol semble presque creuse."

# Traduction IA – à relire
#: chance_d20/Guardian_part7_a/0/c-1/26
msgctxt "Chance"
msgid "Moving leaves out of the way, you find the handle to a hatch. You lift it, discovering a ladder."
msgstr "En écartant les feuilles, tu trouves la poignée d'une trappe. Tu la soulèves et découvres une échelle."

# Traduction IA – à relire
#: chance_d20/Guardian_part7_a/0/c-1/34
msgctxt "Chance"
msgid "That Amup told you the truth. And for that, you are grateful."
msgstr "Cet Amup t'a dit la vérité. Et tu lui en es {{reconnaissant|reconnaissante|reconnaissant·e}}."

# Traduction IA – à relire
#: chance_d20/Guardian_part7_a/0/c-1/42/b/4
msgctxt "Jerry"
msgid "Oh wow! That's awesome! I knew we were going the right way!"
msgstr "Oh, waouh ! Génial ! Je savais qu'on allait dans la bonne direction !"

# Traduction IA – à relire
#: chance_d20/Guardian_part7_a/0/c-1/45
msgctxt "Chance"
msgid "It has not only saved you time, but the lives of some of his fellow Amup."
msgstr "Ça t'a non seulement fait gagner du temps, mais ça a aussi épargné la vie de quelques-uns de ses camarades amup."

# Traduction IA – à relire
#: chance_d20/Guardian_part7_a/0/c-1/53
msgctxt "Chance"
msgid "You descend down the ladder determined to find your partner and take only the lives you need to in the process."
msgstr "Tu descends l'échelle, {{déterminé|déterminée|déterminé·e}} à retrouver ta moitié et à ne prendre que les vies nécessaires en chemin."

# Traduction IA – à relire
#: chance_d20/Guardian_part8/0/0
msgctxt "Chance"
msgid "You have entered the dungeon under the Amup camp. It smells like damp earth and wet fur. Nothing about the area feels safe."
msgstr "Te voilà dans le cachot sous le camp amup. Ça sent la terre humide et le poil mouillé. Rien ici ne paraît sûr."

# Traduction IA – à relire
#: chance_d20/Guardian_part8/0/8
msgctxt "Chance"
msgid "You move slowly down the corridor until you come upon a large open space. It's dark, with the flicker of a few torches on the far side of the wall providing a bit of light."
msgstr "Tu avances lentement dans le couloir jusqu'à déboucher sur un grand espace dégagé. Il fait sombre ; quelques torches vacillent sur le mur du fond et donnent un peu de lumière."

# Traduction IA – à relire
#: chance_d20/Guardian_part8/0/16/b/4
msgctxt "Jerry"
msgid "I have a promotional light-up keychain in here somewhere... Ah! Here it is! Bing!"
msgstr "J'ai un porte-clés lumineux publicitaire quelque part là-dedans... Ah ! Le voilà ! Bling !"

# Traduction IA – à relire
#: chance_d20/Guardian_part8/0/19
msgctxt "Chance"
msgid "In the middle of it sits a person. They are slumped over, looking tired and worn down. You can't see their face but... their hair!"
msgstr "Au milieu est assise une personne. Avachie, elle a l'air épuisée et à bout. Tu ne vois pas son visage mais... ses cheveux !"

# Traduction IA – à relire
#: chance_d20/Guardian_part8/0/27
msgctxt "Chance"
msgid "The hair looks like it belongs to your partner!"
msgstr "On dirait les cheveux de ta moitié !"

# Traduction IA – à relire
#: chance_d20/Guardian_part8/0/35/s/0
msgctxt "Choix"
msgid "I rush to them!"
msgstr "Je me précipite vers elle !"

# Traduction IA – à relire
#: chance_d20/Guardian_part8/0/36/s/0
msgctxt "Choix"
msgid "I don't trust it."
msgstr "Je me méfie."

# Traduction IA – à relire
#: chance_d20/Guardian_part8/0/c-0/7
msgctxt "Chance"
msgid "You run to them to find them asleep! They look so peaceful sleeping here. You try to wake them up."
msgstr "Tu cours vers elle et découvres qu'elle dort ! Elle a l'air si paisible, endormie là. Tu essaies de la réveiller."

# Traduction IA – à relire
#: chance_d20/Guardian_part8/0/c-1/7
msgctxt "Chance"
msgid "You slowly proceed forward toward the person. Once you reach them, you swing around to find it is your partner! Just asleep."
msgstr "Tu t'approches lentement de la personne. Arrivé{{|e|·e}} à sa hauteur, tu fais le tour et découvres que c'est ta moitié ! Elle dort, c'est tout."

# Traduction IA – à relire
#: chance_d20/Guardian_part8/0/g-0/0
msgctxt "Chance"
msgid "You give them a subtle shake, hoping to wake them gently. Their eyes open and see you. It takes a moment to register, but then a smile slides across their face."
msgstr "Tu la secoues délicatement, en espérant la réveiller en douceur. Ses yeux s'ouvrent et te voient. Il lui faut un moment pour comprendre, puis un sourire se dessine sur son visage."

# Traduction IA – à relire
#: chance_d20/Guardian_part8/0/g-0/8
msgctxt "Chance"
msgid "\"You... you came for me.\""
msgstr "« Tu... tu es venu{{|e|·e}} pour moi. »"

# Traduction IA – à relire
#: chance_d20/Guardian_part8/0/g-0/16/s/0
msgctxt "Choix"
msgid "Of course I did, my love!"
msgstr "Évidemment, mon amour !"

# Traduction IA – à relire
#: chance_d20/Guardian_part8/0/g-0/17/s/0
msgctxt "Choix"
msgid "I hope you never doubted I would."
msgstr "J'espère que tu n'en as jamais douté."

# Traduction IA – à relire
#: chance_d20/Guardian_part8/0/g-1/0/b/4
msgctxt "Jerry"
msgid "Phew! You are together again! Now, let's get out of here!"
msgstr "Ouf ! Vous voilà réunis ! Maintenant, sortons d'ici !"

# Traduction IA – à relire
#: chance_d20/Guardian_part8/0/g-1/3
msgctxt "Chance"
msgid "As they look at you, you notice their eyes shift to right above your head. The glee they had turns to pure terror."
msgstr "Tandis qu'elle te regarde, tu remarques que ses yeux se lèvent juste au-dessus de ta tête. Sa joie se change en pure terreur."

# Traduction IA – à relire
#: chance_d20/Guardian_part8/0/g-1/11
msgctxt "Chance"
msgid "\"LOOK OUT!\""
msgstr "« ATTENTION ! »"

# Traduction IA – à relire
#: chance_d20/Guardian_part8/0/g-1/19
msgctxt "Chance"
msgid "Before you can turn around, you are pushed aside by a giant hand. You can feel something huge behind you."
msgstr "Avant que tu puisses te retourner, une main gigantesque t'écarte. Tu sens quelque chose d'énorme derrière toi."

# Traduction IA – à relire
#: chance_d20/Guardian_part8/0/g-1/27
msgctxt "Chance"
msgid "You scramble on the ground, putting yourself between you and your partner. You look up to see a tiger like Amup towering over you."
msgstr "Tu te démènes au sol pour t'interposer entre lui et ta moitié. Tu lèves les yeux et vois un Amup tigre qui te domine de toute sa hauteur."

# Traduction IA – à relire
#: chance_d20/Guardian_part8/0/g-1/35
msgctxt "Chance"
msgid "Drool drips from its teeth, and his breath reeks of fish and blood."
msgstr "La bave dégouline de ses crocs, et son haleine empeste le poisson et le sang."

# Traduction IA – à relire
#: chance_d20/Guardian_part8/0/g-1/43
msgctxt "Chance"
msgid "He smirks and says to you, \"Ahhhh, yessss. The great warrior of the Snee Kars. Come to play hero once again.\""
msgstr "Il ricane et te dit : « Ahhhh, ouiiii. {{Le grand guerrier|La grande guerrière|Le grand guerrier}} de Bas-Kets. Venu{{|e|·e}} jouer les héros une fois de plus. »"

# Traduction IA – à relire
#: chance_d20/Guardian_part8/0/g-1/51/s/0
msgctxt "Choix"
msgid "...wait, no Uwu?"
msgstr "... attends, pas de Uwu ?"

# Traduction IA – à relire
#: chance_d20/Guardian_part8/0/g-1/c-4/7
msgctxt "Chance"
msgid "No Uwu. He. Means. Business."
msgstr "Pas de Uwu. Il. Est. Sérieux."

# Traduction IA – à relire
#: chance_d20/Guardian_part8/0/g-2/0
msgctxt "Chance"
msgid "Before I continue, I should let you know... this is where I wrote like, a monologue for him. It's silly, but it's what the big bad is supposed to do."
msgstr "Avant de continuer, je dois te prévenir... c'est là que j'ai écrit, genre, un monologue pour lui. C'est bête, mais c'est ce que le grand méchant est censé faire."

# Traduction IA – à relire
#: chance_d20/Guardian_part8/0/g-2/8/b/4
msgctxt "Jerry"
msgid "Oh! Can I have the script when you are done?"
msgstr "Oh ! Je pourrai avoir le script quand t'auras fini ?"

# Traduction IA – à relire
#: chance_d20/Guardian_part8/0/g-2/8/b/12
msgctxt "Chance"
msgid "Sure, no worries, Jerry."
msgstr "Bien sûr, pas de souci, Jerry."

# Traduction IA – à relire
#: chance_d20/Guardian_part8/0/g-2/8/b/20
msgctxt "Jerry"
msgid "SCORE."
msgstr "YES."

# Traduction IA – à relire
#: chance_d20/Guardian_part8/0/g-2/11
msgctxt "Chance"
msgid "Do you mind if I do?"
msgstr "Ça te dérange si je le fais ?"

# Traduction IA – à relire
#: chance_d20/Guardian_part8/0/g-2/20/s/0
msgctxt "Choix"
msgid "If you wrote it, I'm sure it's awesome."
msgstr "Si c'est toi qui l'as écrit, je suis sûr{{|e|·e}} que c'est génial."

# Traduction IA – à relire
#: chance_d20/Guardian_part8/0/g-2/21/s/0
msgctxt "Choix"
msgid "I mean... if we can skip it..."
msgstr "Enfin... si on peut le passer..."

# Traduction IA – à relire
#: chance_d20/Guardian_part8/0/g-2/c-6/7
msgctxt "Chance"
msgid "Aww, thanks! You're the best."
msgstr "Ooh, merci ! T'es le meilleur."

# Traduction IA – à relire
#: chance_d20/Guardian_part8/0/g-2/c-7/13
msgctxt "Chance"
msgid "Oh... yeah... sure. I'll just... move these pages out of the way and jump... right to the fight I guess."
msgstr "Oh... ouais... bien sûr. Je vais juste... mettre ces pages de côté et passer... directement au combat, j'imagine."

# Traduction IA – à relire
#: chance_d20/Guardian_monologue/3
msgctxt "Chance"
msgid "The Tiger Amup stomps his foot, and as if by magic, the rest of the torches on the walls erupt into flame."
msgstr "L'Amup tigre tape du pied et, comme par magie, toutes les autres torches des murs s'embrasent."

# Traduction IA – à relire
#: chance_d20/Guardian_monologue/11
msgctxt "Chance"
msgid "\"You know, I've always preferred to see my prey.\""
msgstr "« Tu sais, j'ai toujours préféré voir ma proie. »"

# Traduction IA – à relire
#: chance_d20/Guardian_monologue/19
msgctxt "Chance"
msgid "\"You don't remember me. Or should I say, you don't remember my father. Do you?\""
msgstr "« Tu ne te souviens pas de moi. Ou plutôt, tu ne te souviens pas de mon père. N'est-ce pas ? »"

# Traduction IA – à relire
#: chance_d20/Guardian_monologue/24
msgctxt "Chance"
msgid "The confused look on your face tells him you don't."
msgstr "Ton air perplexe lui confirme que non."

# Traduction IA – à relire
#: chance_d20/Guardian_monologue/32
msgctxt "Chance"
msgid "\"Ten years ago, during the fighting that caused the destruction of many Amup families, I was just a little one.\""
msgstr "« Il y a dix ans, pendant les combats qui ont détruit tant de familles amup, je n'étais qu'un petit. »"

# Traduction IA – à relire
#: chance_d20/Guardian_monologue/40
msgctxt "Chance"
msgid "\"We thought our village to the South was safe. The one Amup settlement you and your kind left alone. That was until you arrived.\""
msgstr "« Nous pensions notre village du Sud en sécurité. Le seul village amup que toi et les tiens aviez épargné. Jusqu'à ce que tu arrives. »"

# Traduction IA – à relire
#: chance_d20/Guardian_monologue/45
msgctxt "Chance"
msgid "\"I'm sure you remember that day. I saw you enter the town gates from my window perch. You looked so damn proud of yourself.\""
msgstr "« Je suis sûr que tu te souviens de ce jour. Je t'ai vu{{|e|·e}} franchir les portes de la ville depuis mon perchoir, à la fenêtre. Tu avais l'air tellement fier{{|e|·e}} de toi, bon sang. »"

# Traduction IA – à relire
#: chance_d20/Guardian_monologue/50
msgctxt "Chance"
msgid "\"They say you came to broker a truce. But you didn't. You presented an ultimatum. Surrender or you destroy our town.\""
msgstr "« On dit que tu étais venu{{|e|·e}} négocier une trêve. Mais non. Tu as posé un ultimatum. Se rendre, ou voir notre ville détruite. »"

# Traduction IA – à relire
#: chance_d20/Guardian_monologue/58
msgctxt "Chance"
msgid "\"My father... he didn't like that. He told you so. To your face. My father stood up to you and I watched proudly.\""
msgstr "« Mon père... ça ne lui a pas plu. Il te l'a dit. En face. Mon père t'a tenu tête, et je le regardais avec fierté. »"

# Traduction IA – à relire
#: chance_d20/Guardian_monologue/66
msgctxt "Chance"
msgid "\"And instead of listening to reason, you know what you did? DO YOU REMEMBER WHAT YOU DID?!\""
msgstr "« Et au lieu d'entendre raison, tu sais ce que tu as fait ? TU TE SOUVIENS DE CE QUE TU AS FAIT ?! »"

# Traduction IA – à relire
#: chance_d20/Guardian_monologue/74
msgctxt "Chance"
msgid "\"You reached your hand out... and patted him on the head. Telling him it was okay.\""
msgstr "« Tu as tendu la main... et tu lui as caressé la tête. En lui disant que tout allait bien. »"

# Traduction IA – à relire
#: chance_d20/Guardian_monologue/79
msgctxt "Chance"
msgid "\"The way my father's body relaxed and his tail flicked back and forth in an unexcused moment of enjoyment... \""
msgstr "« La façon dont le corps de mon père s'est détendu, dont sa queue a fouetté l'air dans un moment de plaisir impardonnable... »"

# Traduction IA – à relire
#: chance_d20/Guardian_monologue/84
msgctxt "Chance"
msgid "\"Utterly embarrassing. YOU EMBARRASSED HIM! YOU. EMBARRASSED US!\""
msgstr "« Une humiliation totale. TU L'AS HUMILIÉ ! TU. NOUS AS HUMILIÉS ! »"

# Traduction IA – à relire
#: chance_d20/Guardian_monologue/92
msgctxt "Chance"
msgid "\"The whole town saw what happened. And my father was ridiculed until the day he died.\""
msgstr "« Toute la ville a vu ce qui s'est passé. Et mon père a été la risée de tous jusqu'au jour de sa mort. »"

# Traduction IA – à relire
#: chance_d20/Guardian_monologue/97
msgctxt "Chance"
msgid "\"Well, until the day he does die. He's still alive, but still... the ridicule keeps on comin'.\""
msgstr "« Enfin, jusqu'au jour où il mourra. Il est toujours vivant, mais quand même... les moqueries continuent. »"

# Traduction IA – à relire
#: chance_d20/Guardian_monologue/102
msgctxt "Chance"
msgid "\"And I vowed on that day that I would get revenge for what you did to my father. And, oh, your blood will be sweeter than cream!\""
msgstr "« Et j'ai juré ce jour-là de me venger de ce que tu as fait à mon père. Et, oh, ton sang sera plus doux que la crème ! »"

# Traduction IA – à relire
#: chance_d20/Guardian_monologue/107
msgctxt "Chance"
msgid "\"I shall destroy you and embarrass you in front of the one that YOU love!\""
msgstr "« Je vais te détruire et t'humilier devant l'être que TU aimes ! »"

# Traduction IA – à relire
#: chance_d20/Guardian_monologue/115
msgctxt "Chance"
msgid "\"Warrior of the Snee Kars... PREPARE TO BE VANQUISHED!\""
msgstr "« {{Guerrier|Guerrière|Guerrier}} de Bas-Kets... PRÉPARE-TOI À ÊTRE {{VAINCU|VAINCUE|VAINCU·E}} ! »"

# Traduction IA – à relire
#: chance_d20/Guardian_final_fight/0/0
msgctxt "Chance"
msgid "Heehee.... Ahem... You knew where this was leading, so you had your axe at the ready."
msgstr "Hihi... Hum... Tu savais où tout ça menait, alors tu avais ta hache prête."

# Traduction IA – à relire
#: chance_d20/Guardian_final_fight/0/16/s/0
msgctxt "Choix"
msgid "Make sure my partner is at a safe distance."
msgstr "Mettre ma moitié à l'abri."

# Traduction IA – à relire
#: chance_d20/Guardian_final_fight/0/17/s/0
msgctxt "Choix"
msgid "Start slicin'!"
msgstr "On découpe !"

# Traduction IA – à relire
#: chance_d20/Guardian_final_fight/0/18/s/0
msgctxt "Choix"
msgid "What if I pet him?"
msgstr "Et si je le caressais ?"

# Traduction IA – à relire
#: chance_d20/Save_partner/0/0
msgctxt "Chance"
msgid "The Amup can wait. None of this will matter if your partner dies in the attack."
msgstr "L'Amup peut attendre. Rien de tout ça ne comptera si ta moitié meurt dans l'attaque."

# Traduction IA – à relire
#: chance_d20/Save_partner/0/8/b/4
msgctxt "Jerry"
msgid "You get them out of the way. I'll distract them with my laser pointer!"
msgstr "Mets-la à l'abri. Je vais le distraire avec mon pointeur laser !"

# Traduction IA – à relire
#: chance_d20/Save_partner/0/11
msgctxt "Chance"
msgid "You scoop them up and run to the far side of the room. The booming of the Tiger Amup's feet trail behind you."
msgstr "Tu la prends dans tes bras et tu cours à l'autre bout de la salle. Les pas tonitruants de l'Amup tigre résonnent derrière toi."

# Traduction IA – à relire
#: chance_d20/Save_partner/0/19
msgctxt "Chance"
msgid "You place them against the far wall, telling them to stay put."
msgstr "Tu l'adosses au mur du fond en lui disant de ne pas bouger."

# Traduction IA – à relire
#: chance_d20/Save_partner/0/27/s/0
msgctxt "Choix"
msgid "I got this, honey bunches!"
msgstr "Je gère, mon sucre d'orge !"

# Traduction IA – à relire
#: chance_d20/Save_partner/0/28/s/0
msgctxt "Choix"
msgid "Don't worry. I'll be back!"
msgstr "T'inquiète. Je reviens !"

# Traduction IA – à relire
#: chance_d20/Save_partner/0/g-0/0
msgctxt "Chance"
msgid "\"Oh, my love. Kick his ass for me!\""
msgstr "« Oh, mon amour. Botte-lui le derrière pour moi ! »"

# Traduction IA – à relire
#: chance_d20/Save_partner/0/g-0/8
msgctxt "Chance"
msgid "Your partner quickly reaches into their shirt, producing an herb. They put it in your mouth."
msgstr "Ta moitié glisse vivement la main sous sa chemise et en sort une herbe. Elle te la met dans la bouche."

# Traduction IA – à relire
#: chance_d20/Save_partner/0/g-0/16
msgctxt "Chance"
msgid "\"Chew! This will help!\""
msgstr "« Mâche ! Ça va t'aider ! »"

# Traduction IA – à relire
#: chance_d20/Save_partner/0/g-0/24
msgctxt "Chance"
msgid "Oooo. Minty. And it grants you 20 health!"
msgstr "Ooooh. Mentholé. Et ça te rend 20 PV !"

# Traduction IA – à relire
#: chance_d20/Save_partner/0/g-0/41
msgctxt "Chance"
msgid "You run off toward the giant beast."
msgstr "Tu t'élances vers la bête gigantesque."

# Traduction IA – à relire
#: chance_d20/Save_partner/0/g-0/57/s/0
msgctxt "Choix"
msgid "I swing my axe at him!"
msgstr "Je le frappe avec ma hache !"

# Traduction IA – à relire
#: chance_d20/Save_partner/0/g-0/58/s/0
msgctxt "Choix"
msgid "Kitty just needs pets, I bet."
msgstr "Je parie que le minou a juste besoin de câlins."

# Traduction IA – à relire
#: chance_d20/Attack_amup/0/0
msgctxt "Chance"
msgid "You spring forward in the air, flying toward him. Your blade shines in the torch light."
msgstr "Tu bondis dans les airs et fonds sur lui. Ta lame brille à la lueur des torches."

# Traduction IA – à relire
#: chance_d20/Attack_amup/0/8
msgctxt "Chance"
msgid "Only, this was expected. And the Tiger Amup spins around and hits you with his massive tail."
msgstr "Sauf qu'il s'y attendait. L'Amup tigre pivote et te frappe avec son énorme queue."

# Traduction IA – à relire
#: chance_d20/Attack_amup/0/16
msgctxt "Chance"
msgid "You go tumbling to the ground, sliding until you hit the wall."
msgstr "Tu dégringoles au sol et glisses jusqu'à percuter le mur."

# Traduction IA – à relire
#: chance_d20/Attack_amup/0/24
msgctxt "Chance"
msgid "You take... 15 damage."
msgstr "Tu subis... 15 points de dégâts."

# Traduction IA – à relire
#: chance_d20/Attack_amup/0/41/b/4 chance_d20/Pet_amup/0/g-0/40/b/4
msgctxt "Jerry"
msgid "I have one more charge on my eraser. So I negate that damage again!"
msgstr "Il me reste une charge sur ma gomme. Donc j'annule encore ces dégâts !"

# Traduction IA – à relire
#: chance_d20/Attack_amup/0/41/b/12 chance_d20/Pet_amup/0/g-0/40/b/20
msgctxt "Chance"
msgid "That homebrew item might not be balanced well. I'll look into that later."
msgstr "Cet objet maison n'est peut-être pas très équilibré. Je regarderai ça plus tard."

# Traduction IA – à relire
#: chance_d20/Attack_amup/0/41/b/20 chance_d20/Pet_amup/0/g-0/40/b/28
msgctxt "Chance"
msgid "You use the eraser and it turns from a healthy pink to a used and old grey."
msgstr "Tu utilises la gomme, qui passe d'un joli rose à un gris usé et vieilli."

# Traduction IA – à relire
#: chance_d20/Attack_amup/0/41/b/28 chance_d20/Pet_amup/0/g-0/40/b/36
msgctxt "Jerry"
msgid "It was worth the sacrifice!"
msgstr "Ça valait le sacrifice !"

# Traduction IA – à relire
#: chance_d20/Attack_amup/0/50
msgctxt "Chance"
msgid "He's good. But you know you are better."
msgstr "Il est fort. Mais tu sais que tu l'es encore plus."

# Traduction IA – à relire
#: chance_d20/Attack_amup/0/58
msgctxt "Chance"
msgid "Do you want to use your axe again? Or switch up the tactic?"
msgstr "Tu veux encore utiliser ta hache ? Ou changer de tactique ?"

# Traduction IA – à relire
#: chance_d20/Attack_amup/0/66/s/0
msgctxt "Choix"
msgid "My axe won't fail me. I know it."
msgstr "Ma hache ne me lâchera pas. Je le sais."

# Traduction IA – à relire
#: chance_d20/Attack_amup/0/67/s/0
msgctxt "Choix"
msgid "I need speed. I'll go bare hands."
msgstr "J'ai besoin de vitesse. Je passe à mains nues."

# Traduction IA – à relire
#: chance_d20/Attack_amup/0/68/s/0
msgctxt "Choix"
msgid "I can soothe the savage beast."
msgstr "Je peux apaiser la bête sauvage."

# Traduction IA – à relire
#: chance_d20/Attack_amup_2/0/0
msgctxt "Chance"
msgid "You decide to bet on your faithful axe. This time, you go low."
msgstr "Tu décides de miser sur ta fidèle hache. Cette fois, tu vises bas."

# Traduction IA – à relire
#: chance_d20/Attack_amup_2/0/8
msgctxt "Chance"
msgid "You run towards the Tiger Amup again, only this time you slide right before you get to him."
msgstr "Tu cours de nouveau vers l'Amup tigre, mais cette fois, tu glisses juste avant de l'atteindre."

# Traduction IA – à relire
#: chance_d20/Attack_amup_2/0/16
msgctxt "Chance"
msgid "Your axe catches the feet of the Tiger Amup and you slice its legs. It lets out a howl of pain and you complete the slide underneath it."
msgstr "Ta hache accroche les pieds de l'Amup tigre et tu lui tranches les jambes. Il pousse un hurlement de douleur, et tu termines ta glissade sous lui."

# Traduction IA – à relire
#: chance_d20/Attack_amup_2/0/24
msgctxt "Chance"
msgid "This causes him to stumble a bit."
msgstr "Ça le fait trébucher un peu."

# Traduction IA – à relire
#: chance_d20/Attack_amup_2/0/32
msgctxt "Chance"
msgid "He shoots a look over his shoulder at you, and then lets out a grin so evil, you know what he is thinking."
msgstr "Il te jette un regard par-dessus son épaule, puis affiche un sourire si maléfique que tu sais exactement à quoi il pense."

# Traduction IA – à relire
#: chance_d20/Attack_amup_2/0/40 chance_d20/Punch_amup/0/87
msgctxt "Chance"
msgid "\"I'm doing this all wrong. You are the one who should live. And your partner? Should die!\""
msgstr "« Je m'y prends mal. C'est toi qui devrais vivre. Et ta moitié ? Mourir ! »"

# Traduction IA – à relire
#: chance_d20/Attack_amup_2/0/48 chance_d20/Punch_amup/0/95
msgctxt "Chance"
msgid "And with the reflexes of... well... a cat, he pounces toward your partner."
msgstr "Et, avec les réflexes d'un... eh bien... d'un chat, il bondit sur ta moitié."

# Traduction IA – à relire
#: chance_d20/Attack_amup_2/0/56
msgctxt "Chance"
msgid "As he leaps over you, he hits you with another tail attack for..."
msgstr "En sautant au-dessus de toi, il te frappe encore avec sa queue pour..."

# Traduction IA – à relire
#: chance_d20/Attack_amup_2/0/64 chance_d20/Enchanter_part7a/0/g-0/24
msgctxt "Chance"
msgid "10 health!"
msgstr "10 points de dégâts !"

# Traduction IA – à relire
#: chance_d20/Attack_amup_2/0/87/b/4
msgctxt "Jerry"
msgid "I take out my laser pointer and shine it in the Amup's eye! This should buy you some time!"
msgstr "Je sors mon pointeur laser et je le braque dans l'œil de l'Amup ! Ça devrait te faire gagner du temps !"

# Traduction IA – à relire
#: chance_d20/Attack_amup_2/0/90 chance_d20/Punch_amup/0/106
msgctxt "Chance"
msgid "You can either throw your axe, use your ultimate one-a-day attack, or if you have any other ideas?"
msgstr "Tu peux lancer ta hache, utiliser ton attaque ultime d'une fois par jour, ou alors tu as une autre idée ?"

# Traduction IA – à relire
#: chance_d20/Attack_amup_2/0/98/s/0 chance_d20/Punch_amup/0/114/s/0
msgctxt "Choix"
msgid "Bring it home, axe!"
msgstr "À toi de jouer, la hache !"

# Traduction IA – à relire
#: chance_d20/Attack_amup_2/0/99/s/0 chance_d20/Punch_amup/0/115/s/0
msgctxt "Choix"
msgid "One ultimate attack, please!"
msgstr "Une attaque ultime, s'il te plaît !"

# Traduction IA – à relire
#: chance_d20/Attack_amup_2/0/100/s/0 chance_d20/Punch_amup/0/116/s/0
msgctxt "Choix"
msgid "I run to protect my partner!"
msgstr "Je cours protéger ma moitié !"

# Traduction IA – à relire
#: chance_d20/Attack_amup_3/0
msgctxt "Chance"
msgid "With all your might, you fling your axe through the air. Right as the Tiger starts to descend on your partner —"
msgstr "De toutes tes forces, tu lances ta hache. Juste au moment où le Tigre commence à fondre sur ta moitié..."

# Traduction IA – à relire
#: chance_d20/Attack_amup_3/8
msgctxt "Chance"
msgid "THWACK!"
msgstr "VLAN !"

# Traduction IA – à relire
#: chance_d20/Attack_amup_3/16
msgctxt "Chance"
msgid "Your axe snags the shoulder of the beast and pins him to the wall."
msgstr "Ta hache se plante dans l'épaule de la bête et la cloue au mur."

# Traduction IA – à relire
#: chance_d20/Attack_amup_3/24
msgctxt "Chance"
msgid "\"Ooooouch! - Uwu!\""
msgstr "« Aïïïïïe ! - Uwu ! »"

# Traduction IA – à relire
#: chance_d20/Attack_amup_3/32
msgctxt "Chance"
msgid "He catches himself. He said Uwu. A phrase he thought was gone from his lexicon."
msgstr "Il se reprend. Il a dit Uwu. Une expression qu'il croyait avoir rayée de son vocabulaire."

# Traduction IA – à relire
#: chance_d20/Attack_amup_3/40
msgctxt "Chance"
msgid "\"GO! Leave me to die in my shame! - Uwu! Arg! I am as weak as my father! - Uwu!\""
msgstr "« PARTEZ ! Laissez-moi mourir dans ma honte ! - Uwu ! Argh ! Je suis aussi faible que mon père ! - Uwu ! »"

# Traduction IA – à relire
#: chance_d20/Attack_amup_3/48
msgctxt "Chance"
msgid "You go to attempt to sooth the creature."
msgstr "Tu essaies d'apaiser la créature."

# Traduction IA – à relire
#: chance_d20/Attack_amup_3/56
msgctxt "Chance"
msgid "\"LEAVE ME ALONE! - UWU!\""
msgstr "« LAISSE-MOI TRANQUILLE ! - UWU ! »"

# Traduction IA – à relire
#: chance_d20/Attack_amup_3/64
msgctxt "Chance"
msgid "The walls shake at his demand."
msgstr "Les murs tremblent sous son injonction."

# Traduction IA – à relire
#: chance_d20/Attack_amup_3/72
msgctxt "Chance"
msgid "Your partner comes by your side and takes a hold of your hand."
msgstr "Ta moitié vient à tes côtés et te prend la main."

# Traduction IA – à relire
#: chance_d20/Attack_amup_3/80
msgctxt "Chance"
msgid "\"Let's leave, my love. Let him suffer with dignity.\""
msgstr "« Partons, mon amour. Laissons-le souffrir dans la dignité. »"

# Traduction IA – à relire
#: chance_d20/Attack_amup_3/91
msgctxt "Chance"
msgid "The tears of the Tiger Amup echo behind you as you walk toward the corridor that led you here."
msgstr "Les sanglots de l'Amup tigre résonnent derrière vous tandis que vous reprenez le couloir par lequel tu es arrivé{{|e|·e}}."

# Traduction IA – à relire
#: chance_d20/Attack_amup_3/99/b/4
msgctxt "Jerry"
msgid "Oh! It's just a little baby! I want to stay behind and try to comfort it."
msgstr "Oh ! C'est juste un petit bébé ! Je veux rester pour essayer de le consoler."

# Traduction IA – à relire
#: chance_d20/Attack_amup_3/99/b/12
msgctxt "Chance"
msgid "Are you sure about that?"
msgstr "Tu es sûr de toi ?"

# Traduction IA – à relire
#: chance_d20/Attack_amup_3/99/b/20
msgctxt "Jerry"
msgid "Yeah! I have a portion of a pet training book in my collection - I MEAN... inventory."
msgstr "Ouais ! J'ai un bout de manuel de dressage pour animaux dans ma collection... JE VEUX DIRE... mon inventaire."

# Traduction IA – à relire
#: chance_d20/Attack_amup_3/99/b/25
msgctxt "Jerry"
msgid "I bet I can find some techniques in there to help rehabilitate this Amup!"
msgstr "Je parie que je peux y trouver des techniques pour aider à réhabiliter cet Amup !"

# Traduction IA – à relire
#: chance_d20/Attack_amup_3/99/b/33
msgctxt "Chance"
msgid "With a laser pointer and the pages of a book you should have thrown away long ago -"
msgstr "Armé d'un pointeur laser et des pages d'un livre que tu aurais dû jeter depuis longtemps..."

# Traduction IA – à relire
#: chance_d20/Attack_amup_3/99/b/41
msgctxt "Jerry"
msgid "Hey!"
msgstr "Hé !"

# Traduction IA – à relire
#: chance_d20/Attack_amup_3/99/b/49
msgctxt "Chance"
msgid "Jerry decides to stay behind and train the vicious creature."
msgstr "... Jerry décide de rester pour dresser la féroce créature."

# Traduction IA – à relire
#: chance_d20/Attack_amup_3/99/b/57
msgctxt "Chance"
msgid "This allows you and your partner to leave."
msgstr "Ça vous permet de partir, ta moitié et toi."

# Traduction IA – à relire
#: chance_d20/Attack_amup_3/102 chance_d20/Guardian_ultimate/121
msgctxt "Chance"
msgid "As silently as you can, the two of you escape into the darkness of the night."
msgstr "Aussi silencieusement que possible, vous vous échappez tous les deux dans l'obscurité de la nuit."

# Traduction IA – à relire
#: chance_d20/Attack_amup_3/110 chance_d20/Guardian_ultimate/129
msgctxt "Chance"
msgid "You head back toward the Snee Kars village, taking time to stop at the stream where you first fell in love."
msgstr "Vous reprenez la route du village de Bas-Kets, en prenant le temps de vous arrêter au ruisseau où vous êtes tombés amoureux."

# Traduction IA – à relire
#: chance_d20/Attack_amup_3/118 chance_d20/Guardian_ultimate/137
msgctxt "Chance"
msgid "Holding each other, you fall asleep. You are safe. Your love is safe. And for now, all is right."
msgstr "Dans les bras l'un de l'autre, vous vous endormez. Tu es en sécurité. Ton amour est en sécurité. Et pour l'instant, tout va bien."

# Traduction IA – à relire
#: chance_d20/Guardian_ultimate/0/b/4
msgctxt "Jerry"
msgid "This is going to be good!"
msgstr "Ça va être trop bien !"

# Traduction IA – à relire
#: chance_d20/Guardian_ultimate/3
msgctxt "Chance"
msgid "You are tired of playing games. That rage you were trained with comes to the surface."
msgstr "Tu en as assez de jouer. La rage avec laquelle tu as été {{entraîné|entraînée|entraîné·e}} remonte à la surface."

# Traduction IA – à relire
#: chance_d20/Guardian_ultimate/11
msgctxt "Chance"
msgid "You are ready to destroy this Amup."
msgstr "Tu es {{prêt|prête|prêt·e}} à anéantir cet Amup."

# Traduction IA – à relire
#: chance_d20/Guardian_ultimate/19
msgctxt "Chance"
msgid "Power flows through you. So much so that rocks begin to float around you."
msgstr "La puissance coule en toi. À tel point que des rochers se mettent à flotter autour de toi."

# Traduction IA – à relire
#: chance_d20/Guardian_ultimate/27
msgctxt "Chance"
msgid "PSHHH! Yellow-gold energy culminates around you like flames."
msgstr "PSHHH ! Une énergie jaune doré t'enveloppe comme des flammes."

# Traduction IA – à relire
#: chance_d20/Guardian_ultimate/35
msgctxt "Chance"
msgid "Your hair changes color, too."
msgstr "Tes cheveux changent de couleur, aussi."

# Traduction IA – à relire
#: chance_d20/Guardian_ultimate/43
msgctxt "Chance"
msgid "Whatever color you want, really. But yeah, it changes!"
msgstr "La couleur que tu veux, franchement. Mais ouais, ils changent !"

# Traduction IA – à relire
#: chance_d20/Guardian_ultimate/51
msgctxt "Chance"
msgid "And you FLY across the room, catching the Amup midair."
msgstr "Et tu VOLES à travers la salle pour intercepter l'Amup en plein vol."

# Traduction IA – à relire
#: chance_d20/Guardian_ultimate/59
msgctxt "Chance"
msgid "Punches faster than the eye can see fly from your fists. The Tiger Amup can't even grunt in response."
msgstr "Tes poings décochent des coups plus rapides que l'œil. L'Amup tigre ne peut même pas grogner en retour."

# Traduction IA – à relire
#: chance_d20/Guardian_ultimate/67
msgctxt "Chance"
msgid "You have taken on your Glorious Guardian form!"
msgstr "Tu as revêtu ta forme de {{Gardien Glorieux|Gardienne Glorieuse|Gardien Glorieux}} !"

# Traduction IA – à relire
#: chance_d20/Guardian_ultimate/75
msgctxt "Chance"
msgid "All of your training has come to this and you are executing it flawlessly."
msgstr "Tout ton entraînement t'a mené{{|e|·e}} à ce moment, et tu l'exécutes à la perfection."

# Traduction IA – à relire
#: chance_d20/Guardian_ultimate/83
msgctxt "Chance"
msgid "When you are finished, the Tiger Amup is clearly incapacitated."
msgstr "Quand tu as terminé, l'Amup tigre est clairement hors d'état de nuire."

# Traduction IA – à relire
#: chance_d20/Guardian_ultimate/94
msgctxt "Chance"
msgid "As the energy leaves your body, you collapse on the floor. Exhaustion takes over and you slip in and out of awareness."
msgstr "Quand l'énergie quitte ton corps, tu t'effondres au sol. L'épuisement prend le dessus et tu perds connaissance par intermittence."

# Traduction IA – à relire
#: chance_d20/Guardian_ultimate/102
msgctxt "Chance"
msgid "Your partner scoops you up."
msgstr "Ta moitié te soulève dans ses bras."

# Traduction IA – à relire
#: chance_d20/Guardian_ultimate/110
msgctxt "Chance"
msgid "\"I'll get us out of here, love.\""
msgstr "« Je vais nous sortir de là, mon amour. »"

# Traduction IA – à relire
#: chance_d20/Guardian_ultimate/118/b/4
msgctxt "Jerry"
msgid "I want to stay behind. The Amup will need a new leader, and I would like to be that person."
msgstr "Je veux rester. Les Amup vont avoir besoin d'un nouveau chef, et j'aimerais être cette personne."

# Traduction IA – à relire
#: chance_d20/Guardian_ultimate/118/b/12
msgctxt "Jerry"
msgid "If they had a healer leading them, as opposed to a warrior, things might turn out different."
msgstr "S'ils avaient un guérisseur à leur tête, plutôt qu'un guerrier, les choses pourraient tourner autrement."

# Traduction IA – à relire
#: chance_d20/Guardian_ultimate/118/b/17
msgctxt "Chance"
msgid "That is very noble of you!"
msgstr "C'est très noble de ta part !"

# Traduction IA – à relire
#: chance_d20/Guardian_ultimate/118/b/25
msgctxt "Jerry"
msgid "I mean... really... I want to see what cool stuff they have!"
msgstr "Enfin... en vrai... je veux voir les trucs cool qu'ils ont !"

# Traduction IA – à relire
#: chance_d20/Guardian_ultimate/118/b/33
msgctxt "Chance"
msgid "Fair enough! Jerry, your character finds their way to a staircase that leads up and out of the dungeon."
msgstr "Ça se tient ! Jerry, ton personnage trouve un escalier qui monte et sort du cachot."

# Traduction IA – à relire
#: chance_d20/Guardian_ultimate/118/b/41
msgctxt "Jerry"
msgid "I head to it and turn to say..."
msgstr "Je m'y dirige et je me retourne pour dire..."

# Traduction IA – à relire
#: chance_d20/Guardian_ultimate/118/b/46
msgctxt "Jerry"
msgid "Let the village know I chose this life. And I regret nothing!"
msgstr "Faites savoir au village que j'ai choisi cette vie. Et que je ne regrette rien !"

# Traduction IA – à relire
#: chance_d20/Guardian_ultimate/118/b/54
msgctxt "Chance"
msgid "You ascend the stairs, toward your new destiny."
msgstr "Tu gravis les marches, vers ton nouveau destin."

# Traduction IA – à relire
#: chance_d20/Guardian_hero/0/0
msgctxt "Chance"
msgid "Holy Crit! Really? That's... wow!"
msgstr "Nom d'un crit ! Sérieux ? C'est... waouh !"

# Traduction IA – à relire
#: chance_d20/Guardian_hero/0/8
msgctxt "Chance"
msgid "Umm... you run towards your partner, racing the beast as they fly through the air."
msgstr "Euh... tu cours vers ta moitié, à la course avec la bête qui fend les airs."

# Traduction IA – à relire
#: chance_d20/Guardian_hero/0/16
msgctxt "Chance"
msgid "You get there right in time to throw your hands up to shield your partner."
msgstr "Tu arrives juste à temps pour lever les bras et protéger ta moitié."

# Traduction IA – à relire
#: chance_d20/Guardian_hero/0/24
msgctxt "Chance"
msgid "Do you say anything to them?"
msgstr "Tu lui dis quelque chose ?"

# Traduction IA – à relire
#: chance_d20/Guardian_hero/0/32/s/0
msgctxt "Choix"
msgid "I love you. Always will."
msgstr "Je t'aime. Pour toujours."

# Traduction IA – à relire
#: chance_d20/Guardian_hero/0/33/s/0
msgctxt "Choix"
msgid "Tell my story."
msgstr "Raconte mon histoire."

# Traduction IA – à relire
#: chance_d20/Guardian_hero/0/34/s/0
msgctxt "Choix"
msgid "I say nothing. I look the beast dead in the eyes."
msgstr "Je ne dis rien. Je regarde la bête droit dans les yeux."

# Traduction IA – à relire
#: chance_d20/Guardian_hero/0/g-0/0
msgctxt "Chance"
msgid "Wooooow."
msgstr "Waouuuuh."

# Traduction IA – à relire
#: chance_d20/Guardian_hero/0/g-0/8/b/4
msgctxt "Jerry"
msgid "Cheese and crackers, this is heartbreaking!"
msgstr "Nom d'une agrafeuse, c'est déchirant !"

# Traduction IA – à relire
#: chance_d20/Guardian_hero/0/g-0/11
msgctxt "Chance"
msgid "The Tiger Amup comes down on you and..."
msgstr "L'Amup tigre s'abat sur toi et..."

# Traduction IA – à relire
#: chance_d20/Guardian_hero/0/g-0/19
msgctxt "Chance"
msgid "I... I rolled a crit. I'll roll for damage..."
msgstr "J'ai... j'ai fait un crit. Je lance les dégâts..."

# Traduction IA – à relire
#: chance_d20/Guardian_hero/0/g-0/27
msgctxt "Chance"
msgid "Oh... oh no. I'm so sorry."
msgstr "Oh... oh non. Je suis vraiment désolé."

# Traduction IA – à relire
#: chance_d20/Guardian_hero/0/g-0/38
msgctxt "Chance"
msgid "You take... 135 damage."
msgstr "Tu subis... 135 points de dégâts."

# Traduction IA – à relire
#: chance_d20/Guardian_hero/0/g-0/55
msgctxt "Chance"
msgid "You crumple under the hands of your enemy."
msgstr "Tu t'effondres sous les coups de ton ennemi."

# Traduction IA – à relire
#: chance_d20/Guardian_hero/0/g-0/63
msgctxt "Chance"
msgid "Before you close your eyes for the last time, you see your partner pick up your axe, and prepare to fight."
msgstr "Avant de fermer les yeux pour la dernière fois, tu vois ta moitié ramasser ta hache et se préparer au combat."

# Traduction IA – à relire
#: chance_d20/Guardian_hero/0/g-0/71/b/4
msgctxt "Jerry"
msgid "I raise my letter opener, standing by their side!"
msgstr "Je lève mon coupe-papier et je me tiens à ses côtés !"

# Traduction IA – à relire
#: chance_d20/Guardian_hero/0/g-0/77
msgctxt "Chance"
msgid "They will defend you. And if they can't win, you know they will join you in the hereafter."
msgstr "Ta moitié te défendra. Et si elle ne peut pas gagner, tu sais qu'elle te rejoindra dans l'au-delà."

# Traduction IA – à relire
#: chance_d20/Guardian_hero/0/g-0/85
msgctxt "Chance"
msgid "Either way, you did everything you could to save them."
msgstr "Quoi qu'il en soit, tu as fait tout ton possible pour la sauver."

# Traduction IA – à relire
#: chance_d20/Punch_amup/0/0
msgctxt "Chance"
msgid "You throw down your axe and are ready to scrap."
msgstr "Tu jettes ta hache, {{prêt|prête|prêt·e}} à la bagarre."

# Traduction IA – à relire
#: chance_d20/Punch_amup/0/8
msgctxt "Chance"
msgid "You fly towards the Tiger Amup, fists readied."
msgstr "Tu fonces vers l'Amup tigre, poings levés."

# Traduction IA – à relire
#: chance_d20/Punch_amup/0/16
msgctxt "Chance"
msgid "You hit him with a Billow of Barrages, smacking him left and right."
msgstr "Tu le frappes avec ta Bourrasque de Barrages, en le cognant à gauche et à droite."

# Traduction IA – à relire
#: chance_d20/Punch_amup/0/24
msgctxt "Chance"
msgid "With each hit, you can feel him start to weaken."
msgstr "À chaque coup, tu le sens faiblir."

# Traduction IA – à relire
#: chance_d20/Punch_amup/0/32
msgctxt "Chance"
msgid "But, even through the onslaught, he is able to get in a swipe with his claws."
msgstr "Mais même sous ce déluge, il parvient à placer un coup de griffes."

# Traduction IA – à relire
#: chance_d20/Punch_amup/0/40
msgctxt "Chance"
msgid "He hits you for...."
msgstr "Il t'inflige..."

# Traduction IA – à relire
#: chance_d20/Punch_amup/0/48
msgctxt "Chance"
msgid "20 health!"
msgstr "20 points de dégâts !"

# Traduction IA – à relire
#: chance_d20/Punch_amup/0/65/b/1
msgctxt "Chance"
msgid "That one really stung. He might take you out at this rate!"
msgstr "Celui-là a fait vraiment mal. À ce rythme, il pourrait t'achever !"

# Traduction IA – à relire
#: chance_d20/Punch_amup/0/71
msgctxt "Chance"
msgid "This swipe gives enough room for him to break away."
msgstr "Ce coup lui laisse assez de marge pour se dégager."

# Traduction IA – à relire
#: chance_d20/Punch_amup/0/79
msgctxt "Chance"
msgid "He shoots you a look. An evil grin crosses his face."
msgstr "Il te lance un regard. Un sourire maléfique se dessine sur son visage."

# Traduction IA – à relire
#: chance_d20/Punch_amup/0/103/b/4
msgctxt "Jerry"
msgid "Quick! Think of something! I don't know what things I can throw at it!"
msgstr "Vite ! Trouve quelque chose ! Je ne sais pas quoi lui lancer !"

# Traduction IA – à relire
#: chance_d20/Pet_amup/0/0
msgctxt "Chance"
msgid "You think that all this guy needs is a little bit of love."
msgstr "Tu te dis que ce type a juste besoin d'un peu d'amour."

# Traduction IA – à relire
#: chance_d20/Pet_amup/0/8
msgctxt "Chance"
msgid "So you slide under him and scurry up his back!"
msgstr "Alors tu te glisses sous lui et tu grimpes sur son dos !"

# Traduction IA – à relire
#: chance_d20/Pet_amup/0/16
msgctxt "Chance"
msgid "Once on top, you start petting. Scratching behind the ears. Patting his head."
msgstr "Une fois en haut, tu te mets à le caresser. À le gratter derrière les oreilles. À lui tapoter la tête."

# Traduction IA – à relire
#: chance_d20/Pet_amup/0/24
msgctxt "Chance"
msgid "For a moment, he stops. You see his tail behind you flickering with delight. And... what's that?"
msgstr "Un instant, il s'arrête. Derrière toi, tu vois sa queue frétiller de plaisir. Et... qu'est-ce que c'est ?"

# Traduction IA – à relire
#: chance_d20/Pet_amup/0/32
msgctxt "Chance"
msgid "Is that a pur you hear? Oh, it is!"
msgstr "C'est un ronronnement que tu entends ? Oh, oui !"

# Traduction IA – à relire
#: chance_d20/Pet_amup/0/40/s/0
msgctxt "Choix"
msgid "He just a wittle baby! Yes he is!"
msgstr "C'est qu'un tout piti bébé ! Oh oui, c'est un bébé !"

# Traduction IA – à relire
#: chance_d20/Pet_amup/0/41/s/0
msgctxt "Choix"
msgid "Good kitty kitty kitty."
msgstr "Gentil minou minou minou."

# Traduction IA – à relire
#: chance_d20/Pet_amup/0/g-0/0
msgctxt "Chance"
msgid "But this... doesn't last long."
msgstr "Mais ça... ne dure pas longtemps."

# Traduction IA – à relire
#: chance_d20/Pet_amup/0/g-0/8
msgctxt "Chance"
msgid "Soon, you feel a searing pain as claws dig into your back."
msgstr "Bientôt, tu ressens une douleur fulgurante : des griffes s'enfoncent dans ton dos."

# Traduction IA – à relire
#: chance_d20/Pet_amup/0/g-0/16
msgctxt "Chance"
msgid "You let out a scream of agony as he throws you off."
msgstr "Tu pousses un cri de douleur tandis qu'il te projette au loin."

# Traduction IA – à relire
#: chance_d20/Pet_amup/0/g-0/24
msgctxt "Chance"
msgid "He hits you for..."
msgstr "Il t'inflige..."

# Traduction IA – à relire
#: chance_d20/Pet_amup/0/g-0/32
msgctxt "Chance"
msgid "25 Damage."
msgstr "25 points de dégâts."

# Traduction IA – à relire
#: chance_d20/Pet_amup/0/g-0/40/b/12
msgctxt "Jerry"
msgid "Although, I can only negate 15 of it this time. So, 10 sneaks through."
msgstr "Par contre, cette fois, je ne peux en annuler que 15. Donc 10 passent quand même."

# Traduction IA – à relire
#: chance_d20/Pet_amup/0/g-0/58
msgctxt "Chance"
msgid "\"How dare you try to manipulate me! I will destroy you!\""
msgstr "« Comment oses-tu essayer de me manipuler ! Je vais te détruire ! »"

# Traduction IA – à relire
#: chance_d20/Pet_amup/0/g-0/66 chance_d20/Run_away/0/43
msgctxt "Chance"
msgid "What do you do now?"
msgstr "Que fais-tu, maintenant ?"

# Traduction IA – à relire
#: chance_d20/Pet_amup/0/g-0/74/s/0
msgctxt "Choix"
msgid "Hit him with my axe!"
msgstr "Je le frappe avec ma hache !"

# Traduction IA – à relire
#: chance_d20/Pet_amup/0/g-0/75/s/0
msgctxt "Choix"
msgid "I'mma punch his lights out!"
msgstr "Je vais lui éteindre la lumière à coups de poing !"

# Traduction IA – à relire
#: chance_d20/Guardian_death/3
msgctxt "Chance"
msgid "You have no regrets in your death. The ritual of your people released you of any of those binds."
msgstr "Tu n'as aucun regret dans la mort. Le rituel de ton peuple t'a libéré{{|e|·e}} de toute attache."

# Traduction IA – à relire
#: chance_d20/Guardian_death/11
msgctxt "Chance"
msgid "As you feel your spirit slip away, you can feel the souls of those who went before you. They welcome you."
msgstr "En sentant ton esprit s'échapper, tu sens les âmes de ceux qui t'ont précédé{{|e|·e}}. Elles t'accueillent."

# Traduction IA – à relire
#: chance_d20/Guardian_death/19
msgctxt "Chance"
msgid "You now know it is not a matter of if, but when you will be reunited with your love."
msgstr "Tu sais désormais que la question n'est pas de savoir si, mais quand tu retrouveras ton amour."

# Traduction IA – à relire
#: chance_d20/Guardian_death/30
msgctxt "Chance"
msgid "And for that, you can take peace."
msgstr "Et cela t'apporte la paix."

# Traduction IA – à relire
#: chance_d20/Guardian_death/38/b/4
msgctxt "Jerry"
msgid "Oooh... can I take it too?"
msgstr "Ooooh... je peux en avoir aussi, de la paix ?"

# Traduction IA – à relire
#: chance_d20/Guardian_death/38/b/12
msgctxt "Chance"
msgid "...yes. Yes you can Jerry."
msgstr "... oui. Oui, tu peux, Jerry."

# Traduction IA – à relire
#: chance_d20/Guardian_death/45 chance_d20/Guardian_ending/51/b/1
msgctxt "Chance"
msgid "Phew!"
msgstr "Ouf !"

# Traduction IA – à relire
#: chance_d20/Guardian_death/53 chance_d20/Guardian_ending/51/b/6 chance_d20/Chance_friendship_b/0
msgctxt "Chance"
msgid "That was a ton of fun! I know it might not have ended with you completing the quest but, Holy Crit! You were awesome for a first timer!"
msgstr "C'était hyper marrant ! Je sais que tu n'as peut-être pas terminé la quête, mais nom d'un crit ! Tu as été génial{{|e|·e}} pour une première fois !"

# Traduction IA – à relire
#: chance_d20/Guardian_death/61/b/4 chance_d20/Guardian_ending/50/b/9/b/4 chance_d20/Guardian_ending/51/b/14/b/4 chance_d20/Chance_friendship_b/8/b/4
msgctxt "Jerry"
msgid "Ah... it was nothin'."
msgstr "Ah... c'était rien."

# Traduction IA – à relire
#: chance_d20/Guardian_ending/6
msgctxt "Chance"
msgid "The village welcomes you back with open arms and excitement."
msgstr "Le village t'accueille à bras ouverts, tout excité de ton retour."

# Traduction IA – à relire
#: chance_d20/Guardian_ending/14
msgctxt "Chance"
msgid "In the coming weeks, as you rebuild your village, you get an official notice of surrender from the Amup."
msgstr "Dans les semaines qui suivent, tandis que tu reconstruis ton village, tu reçois une reddition officielle des Amup."

# Traduction IA – à relire
#: chance_d20/Guardian_ending/22
msgctxt "Chance"
msgid "You have reminded them that they should fear you, and, in turn, that you are not one to be messed with."
msgstr "Tu leur as rappelé qu'ils devaient te craindre et qu'on ne se frotte pas à toi."

# Traduction IA – à relire
#: chance_d20/Guardian_ending/30
msgctxt "Chance"
msgid "This isn't the last time the great warrior of the Snee Kars would have to raise their axe."
msgstr "Ce ne sera pas la dernière fois que {{le grand guerrier|la grande guerrière|le grand guerrier}} de Bas-Kets devra lever sa hache."

# Traduction IA – à relire
#: chance_d20/Guardian_ending/38
msgctxt "Chance"
msgid "But, for now, you can rest in knowing you have done what needed to be done."
msgstr "Mais pour l'instant, tu peux te reposer en sachant que tu as fait ce qui devait être fait."

# Traduction IA – à relire
#: chance_d20/Guardian_ending/50/b/1
msgctxt "Chance"
msgid "That was incredible!!"
msgstr "C'était incroyable !!"

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/7
msgctxt "Chance"
msgid "MY MASTER OF THE MYSTICS! You have appeared before me, as you had promised!"
msgstr "{{MON MAÎTRE DES ARCANES|MA MAÎTRESSE DES ARCANES|MON ÊTRE DES ARCANES}} ! Te voilà devant moi, comme promis !"

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/c-3/7
msgctxt "Chance"
msgid "You trying to get some powerful spell by flirting, aren't you? Hehe. It might work. Key word - MIGHT!"
msgstr "Tu essaies d'obtenir un sort puissant en flirtant, hein ? Hihi. Ça pourrait marcher. Mot-clé : POURRAIT !"

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-0/8/8
msgctxt "Chance"
msgid "You will be playing the mystical Enchanter by the name of Dewey Day Seamall, a hapless apprentice studying at the Arcana Mystica of the Bookshelf Bluffs."
msgstr "Tu vas incarner {{le mystique Enchanteur|la mystique Enchanteresse|le mystique Enchanteur}} du nom de Dewey Day Seamall, {{un apprenti malchanceux|une apprentie malchanceuse|un·e apprenti·e malchanceux·se}} qui étudie à l'Arcana Mystica de la Falaise de l'Étagère."

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-0/8/16
msgctxt "Chance"
msgid "Looking at your character sheet, you will notice that you only have 40 health. Don't worry! It won't be that bad."
msgstr "En regardant ta feuille de personnage, tu verras que tu n'as que 40 PV. Pas d'inquiétude ! Ça ira."

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-0/8/24/b/5
msgctxt "Chance"
msgid "Lux will be a Hotshot! Using bows and arrows to strike fear into foes from afar, you two will be a great long distance duo."
msgstr "Lux sera Canonnier ! Avec arc et flèches pour terroriser l'ennemi de loin, vous ferez un super duo à longue portée."

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-0/8/24/b/16
msgctxt "Lux"
msgid "What? Sorry. I wasn't listening."
msgstr "Quoi ? Pardon. J'écoutais pas."

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-0/8/24/b/24
msgctxt "Chance"
msgid "Um... You'll be a Hotshot?"
msgstr "Euh... Tu seras Canonnier ?"

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-0/8/24/b/32
msgctxt "Lux"
msgid "I just heard hot."
msgstr "J'ai juste entendu « canon »."

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-0/8/24/b/40
msgctxt "Chance"
msgid "Right. A Hotshot. You shoot arrows."
msgstr "Voilà. Canonnier. Tu tires des flèches."

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-0/8/24/b/48
msgctxt "Lux"
msgid "Like cupid? OMG Cute. Ok I'm totally in. I'll wear a cute little diaper costume."
msgstr "Comme Cupidon ? OMG trop mignon. Ok, j'en suis à fond. Je vais mettre un petit costume de couche trop chou."

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-0/8/24/b/56
msgctxt "Chance"
msgid "You don't... You don't need to wear a costume."
msgstr "T'as pas... T'as pas besoin de te déguiser."

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-0/8/24/b/67
msgctxt "Lux"
msgid "Too late. I'm already changing."
msgstr "Trop tard. Je me change déjà."

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-0/8/24/b/75
msgctxt "Chance"
msgid "Right. Ok. That's... Fine."
msgstr "Bon. D'accord. C'est... très bien."

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-0/8/24/b/83
msgctxt "Lux"
msgid "Finish explaining everything. I've gotta edit this clip."
msgstr "Finis de tout expliquer. Faut que je monte ce clip."

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-0/8/24/b/91
msgctxt "Chance"
msgid "Okay... back to the Enchanter sheet then..."
msgstr "D'accord... retour à la feuille d'Enchanteur, alors..."

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-0/8/27
msgctxt "Chance"
msgid "You will see there are spell notches, and schools of magic. No need to worry about that really. I made it more for me. Since this is your first time, I'll walk you through what you can do when the time comes."
msgstr "Tu vas voir qu'il y a des emplacements de sorts et des écoles de magie. T'inquiète pas trop pour ça. C'est surtout pour moi. Comme c'est ta première fois, je te dirai ce que tu peux faire le moment venu."

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-0/8/35
msgctxt "Chance"
msgid "Are you ready to start?!"
msgstr "Tu es {{prêt|prête|prêt·e}} à commencer ?!"

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-0/8/43/b/4
msgctxt "Lux"
msgid "Hang on I haven't finished posting."
msgstr "Attends, j'ai pas fini de poster."

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-0/8/43/b/12
msgctxt "Chance"
msgid "Ok..."
msgstr "D'accord..."

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-0/8/43/b/44
msgctxt "Chance"
msgid "Lux?"
msgstr "Lux ?"

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-0/8/43/b/52
msgctxt "Lux"
msgid "Do you like this filter? Or this one?"
msgstr "Tu préfères ce filtre ? Ou celui-là ?"

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-0/8/43/b/60
msgctxt "Chance"
msgid "We're going to start."
msgstr "On va commencer."

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-0/8/46/s/0
msgctxt "Choix"
msgid "Let's Dewey this!"
msgstr "Maintenant ou Dewey-mais !"

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-0/8/47/s/0
msgctxt "Choix"
msgid "Let the spells start slingin'!"
msgstr "Que les sorts fusent !"

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-0/8/48/s/0
msgctxt "Choix"
msgid "Hmmm... not sure if Lux is gonna be good for this..."
msgstr "Hmmm... pas sûr{{|e|·e}} que Lux soit un bon choix pour ça..."

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-0/8/c-4/7
msgctxt "Chance"
msgid "I love it!"
msgstr "J'adore !"

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-0/8/c-5/7
msgctxt "Chance"
msgid "It's gonna be great!"
msgstr "Ça va être génial !"

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-1/3
msgctxt "Chance"
msgid "We start our adventure in the study of your mentor, High Enchanter Melvil. She is an annoyingly proficient Enchanter and you are lucky to study under her."
msgstr "Notre aventure commence dans le bureau de ton mentor, la Grande Enchanteresse Melvil. C'est une Enchanteresse d'un talent agaçant, et tu as de la chance d'étudier auprès d'elle."

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-1/11
msgctxt "Chance"
msgid "Only, Enchanter Melvil is also a hoarder. If you ever needed a magical trinket or a mystical doodad, Melvil most likely has it."
msgstr "Seulement, l'Enchanteresse Melvil est aussi une accumulatrice compulsive. Si tu as besoin d'une babiole magique ou d'un bidule mystique, Melvil l'a très certainement."

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-1/19
msgctxt "Chance"
msgid "And, after two years in their care, you are still relegated to dusting these relics while Melvil gives lectures to the Spine of Enchanters."
msgstr "Et après deux ans à son service, tu en es encore réduit{{|e|·e}} à épousseter ces reliques pendant que Melvil donne des conférences à la Reliure des Enchanteurs."

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-1/27/b/4
msgctxt "Lux"
msgid "Except for me. I'm famous."
msgstr "Sauf moi. Je suis célèbre."

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-1/27/b/12
msgctxt "Chance"
msgid "...sure."
msgstr "... si tu veux."

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-1/27/b/20
msgctxt "Lux"
msgid "OMG I love this game already. Continue."
msgstr "OMG j'adore déjà ce jeu. Continue."

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-1/30/s/0
msgctxt "Choix"
msgid "What is the Spine of Enchanters?"
msgstr "C'est quoi, la Reliure des Enchanteurs ?"

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-1/31/s/0
msgctxt "Choix"
msgid "I should be slinging spells, not dusting nooks!"
msgstr "Je devrais lancer des sorts, pas dépoussiérer des recoins !"

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-1/c-7/7
msgctxt "Chance"
msgid "The Spine is a group of Enchanters that govern the magical world. Melvil is one of the foremost researchers and often presents new discoveries to the Spine."
msgstr "La Reliure est un groupe d'Enchanteurs qui gouverne le monde magique. Melvil est l'une des plus grandes chercheuses, et elle présente souvent de nouvelles découvertes à la Reliure."

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-1/c-8/7
msgctxt "Chance"
msgid "That's what you've told Melvil, but she always states that this is an important part of your training."
msgstr "C'est ce que tu as dit à Melvil, mais elle répète toujours que ça fait partie intégrante de ta formation."

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-2/3
msgctxt "Chance"
msgid "You have been doing some magical research on the side, but you have needed some equipment that Melvil has to actually get it done."
msgstr "Tu mènes des recherches magiques en douce, mais pour les mener à bien, tu as besoin d'un équipement que possède Melvil."

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-2/11
msgctxt "Chance"
msgid "With Melvil in conclave for at least another three hours with the Spine, you choose now as the time."
msgstr "Melvil étant en conclave avec la Reliure pour au moins trois heures encore, tu décides que c'est le moment."

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-2/19
msgctxt "Chance"
msgid "You go over to your Sack of Possessing, an item Melvil knows you shouldn't have but allows, and you pull out your latest experiment."
msgstr "Tu vas chercher ton Sac de Possession, un objet que tu n'es pas censé{{|e|·e}} avoir mais que Melvil tolère, et tu en sors ta dernière expérience."

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-2/27
msgctxt "Chance"
msgid "You found... a lamp. Only, it doesn't seem to do much. At least... not yet."
msgstr "Tu as trouvé... une lampe. Sauf qu'elle ne semble pas faire grand-chose. Du moins... pas encore."

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-2/35/s/0
msgctxt "Choix"
msgid "You mean... a magical lamp?"
msgstr "Tu veux dire... une lampe magique ?"

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-2/36/s/0
msgctxt "Choix"
msgid "I'll get wishes!"
msgstr "Je vais avoir des vœux !"

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-2/c-9/7
msgctxt "Chance"
msgid "You sure hope it is!"
msgstr "Tu l'espères bien !"

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-2/c-10/7
msgctxt "Chance"
msgid "That's your hope anyway!"
msgstr "C'est ce que tu espères, en tout cas !"

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-3/0/b/4
msgctxt "Lux"
msgid "Obvs I found the lamp. BC light. And lamps. And glowing."
msgstr "Obvi, c'est moi qui ai trouvé la lampe. Parce que lumière. Et lampes. Et briller."

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-3/0/b/12
msgctxt "Lux"
msgid "But, I let you have it. So, you are welcome."
msgstr "Mais je te la laisse. Donc, de rien."

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-3/0/b/20
msgctxt "Chance"
msgid "...anyway."
msgstr "... bref."

# Traduction IA – à relire
#: chance_d20/Enchant_Session/0/g-3/3
msgctxt "Chance"
msgid "You've tried rubbing it, but nothing works. But surely, there is something here that will awaken whatever is inside."
msgstr "Tu as essayé de la frotter, mais rien n'y fait. Mais il doit forcément y avoir quelque chose ici qui réveillera ce qu'elle contient."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/0
msgctxt "Chance"
msgid "Looking around this cluttered study, your eyes fall on a few things that might help you."
msgstr "En parcourant ce bureau encombré, ton regard tombe sur quelques objets qui pourraient t'aider."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/8
msgctxt "Chance"
msgid "There is an Arcane Amplifier that you've seen used a few times."
msgstr "Il y a un Amplificateur Arcanique que tu as vu utiliser plusieurs fois."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/16
msgctxt "Chance"
msgid "There is the Cosmos Collector that can call on the stars to make things work."
msgstr "Il y a le Collecteur Cosmique, qui peut faire appel aux étoiles pour faire fonctionner les choses."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/24
msgctxt "Chance"
msgid "And there is the Mystic Manipulator, used to alter the very fabric of an item's makeup."
msgstr "Et il y a le Manipulateur Mystique, qui sert à modifier la structure même d'un objet."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/32
msgctxt "Chance"
msgid "Which do you use?"
msgstr "Lequel utilises-tu ?"

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/40/s/0
msgctxt "Choix"
msgid "Arcane Amplifier, baby!"
msgstr "L'Amplificateur Arcanique, bébé !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/41/s/0
msgctxt "Choix"
msgid "The cool Cosmo Collector. Duh."
msgstr "Le super Collecteur Cosmique. Évidemment."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/42/s/0
msgctxt "Choix"
msgid "This is a job for the Mystic Manipulator!"
msgstr "C'est un travail pour le Manipulateur Mystique !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/c-0/7
msgctxt "Chance"
msgid "You scamper over to the Amplifier. You slide the lamp into the mechanism and push some magic into its gears. It starts right up!"
msgstr "Tu files vers l'Amplificateur. Tu glisses la lampe dans le mécanisme et insuffles un peu de magie dans ses rouages. Il démarre au quart de tour !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/c-1/7
msgctxt "Chance"
msgid "The stars are your best bet. You place the lamp in the deep bowl surrounded by cosmic dials and magnifying glasses."
msgstr "Les étoiles sont ta meilleure chance. Tu poses la lampe dans la vasque profonde entourée de cadrans cosmiques et de loupes."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/c-2/7
msgctxt "Chance"
msgid "You figure that changing the very properties of the lamp could render the best results. You slide the lamp into the Manipulator and slide the protective glass into place around it."
msgstr "Tu te dis que modifier les propriétés mêmes de la lampe donnera les meilleurs résultats. Tu glisses la lampe dans le Manipulateur et mets en place la vitre protectrice autour."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-0/0
msgctxt "Chance"
msgid "It doesn't take long for the lamp to react to the device. First, it starts to glow. It takes on a warm copper look."
msgstr "La lampe ne tarde pas à réagir à l'appareil. D'abord, elle se met à luire. Elle prend une chaude teinte cuivrée."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-0/8
msgctxt "Chance"
msgid "But then... it starts to shake. Slightly at first, but then —"
msgstr "Mais ensuite... elle se met à trembler. Légèrement d'abord, puis..."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-0/24
msgctxt "Chance"
msgid "An explosion of magic rips the device apart and white smoke consumes you."
msgstr "Une explosion de magie met l'appareil en pièces, et une fumée blanche t'enveloppe."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-0/32
msgctxt "Chance"
msgid "Some of the glass catches in your skin and you taaake...."
msgstr "Des éclats de verre se plantent dans ta peau et tu subiiis..."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-0/40 chance_d20/Read_runes/0/g-1/91
msgctxt "Chance"
msgid "5 damage."
msgstr "5 points de dégâts."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-0/57/b/4
msgctxt "Lux"
msgid "I roll to avoid the damage. What does a 1 mean?"
msgstr "Je fais un jet pour éviter les dégâts. Ça veut dire quoi, un 1 ?"

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-0/57/b/12
msgctxt "Chance"
msgid "That's a critical failure."
msgstr "C'est un échec critique."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-0/57/b/20
msgctxt "Lux"
msgid "Mmm. Okay, well, I just asked because I didn't roll one."
msgstr "Mmm. Ok, bon, je demandais juste parce que j'ai pas fait 1."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-0/57/b/28
msgctxt "Chance"
msgid "What did you roll?"
msgstr "T'as fait combien ?"

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-0/57/b/36
msgctxt "Lux"
msgid "The number that avoids damage to my freshly applied makeup."
msgstr "Le nombre qui évite les dégâts à mon maquillage tout frais."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-0/60
msgctxt "Chance"
msgid "You wave your hands, clearing your vision. And that is where you see it."
msgstr "Tu agites les mains pour dissiper la fumée. Et c'est là que tu le vois."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-0/68
msgctxt "Chance"
msgid "The lamp, on the ground, broken in half."
msgstr "La lampe, par terre, brisée en deux."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-0/79
msgctxt "Chance"
msgid "And floating above it... with beautiful purple skin and muscles that just won't quit... a djinn."
msgstr "Et flottant au-dessus... avec une magnifique peau violette et des muscles à n'en plus finir... un djinn."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-0/87
msgctxt "Chance"
msgid "You've done it! You have released the djinn inside of the lamp!"
msgstr "Tu as réussi ! Tu as libéré le djinn de la lampe !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-0/95
msgctxt "Chance"
msgid "\"Sooooo... you the one who went off and set me free, and all that?\""
msgstr "« Alooooors... c'est toi qui m'as libéré, et tout le tralala ? »"

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-0/103/s/0
msgctxt "Choix"
msgid "Hell yeah, I did. Gimme my wishes!"
msgstr "Carrément, que c'est moi. File-moi mes vœux !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-0/104/s/0
msgctxt "Choix"
msgid "You can thank me with my wishes!"
msgstr "Tu peux me remercier avec mes vœux !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-0/105/s/0
msgctxt "Choix"
msgid "Look at the mess you made. Wish number 1, clean it up!"
msgstr "Regarde le bazar que t'as mis. Vœu numéro 1 : range-moi ça !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-1/0
msgctxt "Chance"
msgid "The djinn looks at you, and cocks out a hip. This one has attitude."
msgstr "Le djinn te regarde et pose la main sur sa hanche. Il a du caractère, celui-là."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-1/8
msgctxt "Chance"
msgid "\"Ahhh so we're going with rude instead of grateful then huh? Got it.\""
msgstr "« Ahhh, alors on choisit l'impolitesse plutôt que la gratitude, hein ? Compris. »"

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-1/16
msgctxt "Chance"
msgid "They then look down at the broken lamp."
msgstr "Puis il baisse les yeux vers la lampe cassée."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-1/24
msgctxt "Chance"
msgid "\"And the one who has the lamp gets the wishes. Except there is no lamp, is there?\""
msgstr "« Et c'est celui qui a la lampe qui a droit aux vœux. Sauf qu'il n'y a plus de lampe, pas vrai ? »"

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-1/32/s/0
msgctxt "Choix"
msgid "But... you owe me!"
msgstr "Mais... tu me dois bien ça !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-1/33/s/0
msgctxt "Choix"
msgid "Can't you be nice and just give me wishes anyway?"
msgstr "Tu peux pas être sympa et me donner des vœux quand même ?"

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-2/0
msgctxt "Chance"
msgid "\"Noooooo. I'm good. Thanks for the jail break!\""
msgstr "« Nooooon. Ça ira. Merci pour l'évasion ! »"

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-2/11
msgctxt "Chance"
msgid "And with a whirl, the djinn flies out the window and towards the woods."
msgstr "Et dans un tourbillon, le djinn s'envole par la fenêtre en direction des bois."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-2/19
msgctxt "Chance"
msgid "You realize that this... this is bad."
msgstr "Tu te rends compte que ça... c'est mauvais."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-2/27/b/4
msgctxt "Lux"
msgid "OMG can I just say that this is like, terrible writing?"
msgstr "OMG, je peux juste dire que c'est, genre, super mal écrit ?"

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-2/27/b/12
msgctxt "Lux"
msgid "Like, whoever wrote this did, like, a terrible job. No offense."
msgstr "Genre, la personne qui a écrit ça a fait, genre, un boulot nul. Sans vouloir vexer."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-2/27/b/20
msgctxt "Chance"
msgid "You do know I wrote this one shot, right?"
msgstr "Tu sais que c'est moi qui ai écrit ce one-shot, hein ?"

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-2/27/b/28
msgctxt "Lux"
msgid "Hahahahahah!! Wait really? Oh wowwwwwww ok. And I was totally joking."
msgstr "Hahahahahah !! Attends, sérieux ? Oh waouuuuuh ok. Et je rigolais complètement."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-2/27/b/36
msgctxt "Lux"
msgid "It's SOOoooooOOOoooOooo creative and original."
msgstr "C'est TELLeeeeEEMeeeENT créatif et original."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-2/27/b/44
msgctxt "Chance"
msgid "Do you mind?!"
msgstr "Ça va, oui ?!"

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-2/27/b/52
msgctxt "Lux"
msgid "Wow relax I'm just trying to give you a compliment."
msgstr "Waouh, détends-toi, j'essaie juste de te faire un compliment."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-2/27/b/60
msgctxt "Chance"
msgid "MOVING ON."
msgstr "ON CONTINUE."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-2/30/s/0
msgctxt "Choix"
msgid "Really?"
msgstr "Vraiment ?"

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-2/31/s/0
msgctxt "Choix"
msgid "How bad is it?"
msgstr "C'est grave à quel point ?"

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-3/0
msgctxt "Chance"
msgid "Djinns have been trapped in lamps to stop them from being mischievous and using their powers for evil."
msgstr "On enferme les djinns dans des lampes pour les empêcher de faire des bêtises et d'utiliser leurs pouvoirs pour le mal."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-3/8
msgctxt "Chance"
msgid "You have unleashed a great force into the Bookshelf Bluffs."
msgstr "Tu as déchaîné une force terrible sur la Falaise de l'Étagère."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-3/16
msgctxt "Chance"
msgid "All of the most powerful Enchanters are in conclave for the rest of the day."
msgstr "Tous les Enchanteurs les plus puissants sont en conclave pour le reste de la journée."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-3/24
msgctxt "Chance"
msgid "And if High Enchanter Melvil finds out you let a djinn loose... you might as well kiss your education goodbye."
msgstr "Et si la Grande Enchanteresse Melvil découvre que tu as libéré un djinn... tu peux dire adieu à tes études."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-3/40/s/0
msgctxt "Choix"
msgid "I go after it! I gotta catch it!"
msgstr "Je le poursuis ! Je dois l'attraper !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-3/41/s/0
msgctxt "Choix"
msgid "Melvil can't find out. Time to clean up my mess. Then catch the djinn."
msgstr "Melvil ne doit pas l'apprendre. Je range mon bazar. Puis j'attrape le djinn."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-3/42/s/0
msgctxt "Choix"
msgid "Eh... how bad could it be?"
msgstr "Bof... ça peut être grave à quel point ?"

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-3/c-10/7
msgctxt "Chance"
msgid "You rush to your dorm to prepare to catch a djinn."
msgstr "Tu files à ton dortoir pour te préparer à attraper un djinn."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-3/c-10/15/b/4
msgctxt "Lux"
msgid "I run too, but, like, so fast and with so much prancing. I'm basically, like, frolicking in the woods, but sexually."
msgstr "Je cours aussi, mais genre, trop vite et en gambadant de partout. En gros, je batifole dans les bois, mais de façon sexy."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-3/c-11/7
msgctxt "Chance"
msgid "Using a quick spell to sweep up all the glass and metal, you quickly tidy the study before rushing off to prepare to catch a djinn!"
msgstr "D'un sort rapide, tu balaies le verre et le métal, ranges vite le bureau, puis tu files te préparer à attraper un djinn !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-3/c-12/7
msgctxt "Chance"
msgid "I mean... catastrophic. But... you don't have to go after him if you don't want to..."
msgstr "Enfin... catastrophique. Mais... t'es pas {{obligé|obligée|obligé·e}} de le poursuivre si tu n'en as pas envie..."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-3/c-12/15/0/s/0
msgctxt "Choix"
msgid "Yeah, I'm good I think. I'll just keep dusting."
msgstr "Ouais, ça ira, je crois. Je vais continuer à épousseter."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-3/c-12/15/1/s/0
msgctxt "Choix"
msgid "Catastrophic? I can't have that! I gotta stop it!"
msgstr "Catastrophique ? Hors de question ! Je dois l'arrêter !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-3/c-12/15/c-0/7/b/4
msgctxt "Lux"
msgid "YAS Cinder-Ella! Get that dusting, girl."
msgstr "YAS Cendrillon ! Vas-y, astique, ma belle."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-3/c-12/15/c-0/10
msgctxt "Chance"
msgid "Umm... okay. You... stay and dust."
msgstr "Euh... d'accord. Tu... restes épousseter."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-3/c-12/15/c-0/18
msgctxt "Chance"
msgid "It isn't long before the woods outside of the school burst into flames."
msgstr "Peu de temps après, les bois autour de l'école s'embrasent."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-3/c-12/15/c-0/26/b/4
msgctxt "Lux"
msgid "Oh..."
msgstr "Oh..."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-3/c-12/15/c-0/29
msgctxt "Chance"
msgid "All sorts of animated objects pour out of it. Books, garden tools, even chairs. The djinn has made a small army."
msgstr "Toutes sortes d'objets animés en sortent en masse. Des livres, des outils de jardin, même des chaises. Le djinn s'est constitué une petite armée."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-3/c-12/15/c-0/37
msgctxt "Chance"
msgid "It isn't long after the fire erupts that Melvil busts into her study. She sees you, still cleaning, and by some arcane pull, finds the broken lamp."
msgstr "Peu après le début de l'incendie, Melvil déboule dans son bureau. Elle te voit, toujours en train de faire le ménage, et, par quelque attraction arcanique, trouve la lampe cassée."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-3/c-12/15/c-0/45
msgctxt "Chance"
msgid "Before you can even try to explain, she uses magic to lift you in the air, slam you through a portal, and right into the jail under the Bluffs."
msgstr "Avant même que tu puisses t'expliquer, elle te soulève dans les airs par magie, te balance dans un portail et t'envoie droit dans la prison sous la Falaise."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-3/c-12/15/c-0/53/b/4
msgctxt "Lux"
msgid "Not me, though."
msgstr "Pas moi, par contre."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-3/c-12/15/c-0/53/b/12
msgctxt "Lux"
msgid "Because I show her my Hot Grill Summer makeup tutorial video, and she's what? <i>Stunned</i> by the view count."
msgstr "Parce que je lui montre mon tuto maquillage Hot Grill Summer, et elle est quoi ? <i>Sidérée</i> par le nombre de vues."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-3/c-12/15/c-0/53/b/20
msgctxt "Chance"
msgid "Oh, yes you. 100% you."
msgstr "Oh si, toi aussi. Toi à 100 %."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-3/c-12/15/c-0/56
msgctxt "Chance"
msgid "This is where you sit and wait for them to decide your fate."
msgstr "C'est là que tu attends qu'ils décident de ton sort."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-3/c-12/15/c-0/64
msgctxt "Chance"
msgid "But the school is under siege and it may be weeks before they get to you."
msgstr "Mais l'école est assiégée, et il faudra peut-être des semaines avant qu'ils s'occupent de toi."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-3/c-12/15/c-0/72
msgctxt "Chance"
msgid "But that's a story for another time."
msgstr "Mais ça, c'est une autre histoire."

# Traduction IA – à relire
#: chance_d20/Enchanter_part2/0/g-3/c-12/15/c-1/7
msgctxt "Chance"
msgid "Finding your courage and motivation, you race out of the study and toward your dorm to gear up for the search!"
msgstr "Rassemblant ton courage et ta motivation, tu sors en trombe du bureau pour filer à ton dortoir t'équiper pour les recherches !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part3/0/0
msgctxt "Chance"
msgid "In your dorm, your Sack of Possessing over your shoulder, you start to think about what you might need."
msgstr "Dans ton dortoir, ton Sac de Possession sur l'épaule, tu réfléchis à ce dont tu pourrais avoir besoin."

# Traduction IA – à relire
#: chance_d20/Enchanter_part3/0/8
msgctxt "Chance"
msgid "But, you don't have a ton of time."
msgstr "Mais tu n'as pas beaucoup de temps."

# Traduction IA – à relire
#: chance_d20/Enchanter_part3/0/16
msgctxt "Chance"
msgid "Your battle wand, of course. You also grab your Tome of Terrible Creatures."
msgstr "Ta baguette de combat, bien sûr. Tu prends aussi ton Grimoire des Créatures Terribles."

# Traduction IA – à relire
#: chance_d20/Enchanter_part3/0/24
msgctxt "Chance"
msgid "Flipping through it, you make sure you find the chapter on djinns."
msgstr "En le feuilletant, tu t'assures de trouver le chapitre sur les djinns."

# Traduction IA – à relire
#: chance_d20/Enchanter_part3/0/32
msgctxt "Chance"
msgid "One paragraph stands out to you. It's about metal and the way djinn react to it. It's something to come back to."
msgstr "Un paragraphe attire ton attention. Il parle du métal et de la façon dont les djinns y réagissent. Une piste à garder en tête."

# Traduction IA – à relire
#: chance_d20/Enchanter_part3/0/40
msgctxt "Chance"
msgid "Oh, don't forget your ringing rock! Someone might call you!"
msgstr "Oh, et n'oublie pas ton caillou sonnant ! Quelqu'un pourrait t'appeler !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part3/0/48
msgctxt "Chance"
msgid "You know you can't hesitate for too much longer, so you decide to grab one more thing."
msgstr "Tu sais que tu ne peux plus hésiter bien longtemps, alors tu décides de prendre une dernière chose."

# Traduction IA – à relire
#: chance_d20/Enchanter_part3/0/56
msgctxt "Chance"
msgid "Do you want the large red mystery potion? Or..."
msgstr "Tu veux la grande potion mystère rouge ? Ou..."

# Traduction IA – à relire
#: chance_d20/Enchanter_part3/0/64
msgctxt "Chance"
msgid "There is a box with runes sketched into it. It looks like your roommate's."
msgstr "Il y a une boîte gravée de runes. On dirait celle de ton coloc."

# Traduction IA – à relire
#: chance_d20/Enchanter_part3/0/72
msgctxt "Chance"
msgid "But it also looks powerful. Maybe this will help?"
msgstr "Mais elle a aussi l'air puissante. Peut-être qu'elle t'aidera ?"

# Traduction IA – à relire
#: chance_d20/Enchanter_part3/0/80
msgctxt "Chance"
msgid "Which do you take?"
msgstr "Laquelle prends-tu ?"

# Traduction IA – à relire
#: chance_d20/Enchanter_part3/0/88/s/0
msgctxt "Choix"
msgid "The potion."
msgstr "La potion."

# Traduction IA – à relire
#: chance_d20/Enchanter_part3/0/89/s/0
msgctxt "Choix"
msgid "Gimme that box."
msgstr "File-moi cette boîte."

# Traduction IA – à relire
#: chance_d20/Enchanter_part3/0/c-0/7/b/4
msgctxt "Lux"
msgid "OMG, that was such a dimmy move. Everyone knows potions are bad for you."
msgstr "OMG, ce move trop terne. Tout le monde sait que les potions, c'est mauvais pour la santé."

# Traduction IA – à relire
#: chance_d20/Enchanter_part3/0/c-0/10
msgctxt "Chance"
msgid "You grab the potion from your shelf. You instantly remember it was the health potion you brewed last week in class. You pop it open and chug it."
msgstr "Tu attrapes la potion sur ton étagère. Tu te rappelles aussitôt que c'est la potion de soin que tu as concoctée en cours la semaine dernière. Tu la débouches et tu l'avales cul sec."

# Traduction IA – à relire
#: chance_d20/Enchanter_part3/0/c-0/18
msgctxt "Chance"
msgid "You feel yourself recover from the explosion earlier. And then some."
msgstr "Tu te remets de l'explosion de tout à l'heure. Et même plus."

# Traduction IA – à relire
#: chance_d20/Enchanter_part3/0/c-0/26
msgctxt "Chance"
msgid "You get... wow! 35 health!"
msgstr "Tu gagnes... waouh ! 35 PV !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part3/0/c-0/43
msgctxt "Chance"
msgid "With strength coursing through you, you head out the door and toward the woods."
msgstr "La force coulant dans tes veines, tu sors et te diriges vers les bois."

# Traduction IA – à relire
#: chance_d20/Enchanter_part3/0/c-0/51/b/4
msgctxt "Lux"
msgid "Don't worry about me, or whatever. I'm on a cleanse anyway."
msgstr "T'inquiète pas pour moi, ou je sais pas quoi. Je suis en détox, de toute façon."

# Traduction IA – à relire
#: chance_d20/Enchanter_part3/0/c-1/7
msgctxt "Chance"
msgid "You grab the box and shove it inside your Sack of Possessing."
msgstr "Tu attrapes la boîte et tu la fourres dans ton Sac de Possession."

# Traduction IA – à relire
#: chance_d20/Enchanter_part3/0/c-1/15
msgctxt "Chance"
msgid "You have no time to figure out what it is right now. You quickly head out of the door and toward the woods."
msgstr "Tu n'as pas le temps de découvrir ce que c'est pour l'instant. Tu sors en vitesse et te diriges vers les bois."

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/0
msgctxt "Chance"
msgid "You get to the edge of the woods and it isn't hard to figure out where the djinn went."
msgstr "Tu arrives à l'orée du bois, et pas besoin d'être devin pour savoir par où est passé le djinn."

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/8
msgctxt "Chance"
msgid "A path of trees has been bowled over. The funny thing is, the path seems to be heading toward a very specific location."
msgstr "Une rangée d'arbres a été renversée. Le plus drôle, c'est que ce chemin semble mener à un endroit bien précis."

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/16
msgctxt "Chance"
msgid "It is headed for the hut of the groundskeeper, Moys."
msgstr "Il se dirige vers la cabane du gardien du domaine, Moys."

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/27
msgctxt "Chance"
msgid "Moys is a bumbling old fool, but has a good heart. If anything happened to them..."
msgstr "Moys est un vieux bougre maladroit, mais avec un cœur d'or. S'il lui arrivait quoi que ce soit..."

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/35/s/0
msgctxt "Choix"
msgid "Well, I won't let it! Time to get a move on!"
msgstr "Eh bien, je ne laisserai pas faire ça ! En route !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/36/s/0
msgctxt "Choix"
msgid "Oh no! Not Moys!"
msgstr "Oh non ! Pas Moys !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/g-0/0
msgctxt "Chance"
msgid "You race through the woods towards Moys' cabin."
msgstr "Tu traverses les bois à toute allure vers la cabane de Moys."

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/g-0/8
msgctxt "Chance"
msgid "Right on the edge of where Moys' cabin would be, you see Moys."
msgstr "Juste à l'orée de l'endroit où devrait se trouver la cabane, tu vois Moys."

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/g-0/16
msgctxt "Chance"
msgid "They are tied to a tree, but they aren't resisting."
msgstr "Iel est attaché·e à un arbre, mais iel ne se débat pas."

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/g-0/24
msgctxt "Chance"
msgid "A tiny gnome, Moys has always been kind to you. They snuck you herbs you needed for your experiments and may have helped you destroy evidence of a failed enchantment before."
msgstr "Petit gnome, Moys a toujours été gentil·le avec toi. Iel t'a refilé en douce les herbes dont tu avais besoin pour tes expériences, et t'a peut-être même aidé{{|e|·e}} une fois à détruire les preuves d'un enchantement raté."

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/g-0/32/b/4
msgctxt "Lux"
msgid "I set up a drop-shipping store for the gnome, leveraging my brand."
msgstr "J'ouvre une boutique de dropshipping pour le gnome, grâce à ma marque perso."

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/g-0/32/b/20
msgctxt "Lux"
msgid "And because of my incredible popularity, I offer him 98/2 percent distribution split."
msgstr "Et vu mon incroyable popularité, je lui propose un partage des bénéfices à 98/2."

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/g-0/32/b/28
msgctxt "Chance"
msgid "Anyways..."
msgstr "Bref..."

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/g-0/32/b/36
msgctxt "Lux"
msgid "I call it 'Zodiac Herbs for Astrological Abundance' and we make a ton of money."
msgstr "J'appelle ça « Herbes du Zodiaque pour l'Abondance Astrale », et on se fait un fric de dingue."

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/g-0/35/s/0
msgctxt "Choix"
msgid "Moys! Are you alright?"
msgstr "Moys ! Ça va ?"

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/g-0/36/s/0
msgctxt "Choix"
msgid "Let me get you untied."
msgstr "Attends, je te détache."

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/g-1/0
msgctxt "Chance"
msgid "\"Oh, I'm fine! You can leave me here. They said they would come back for me.\""
msgstr "« Oh, ça va très bien ! Tu peux me laisser là. Ils ont dit qu'ils reviendraient me chercher. »"

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/g-1/8/s/0
msgctxt "Choix"
msgid "They? Who's they?"
msgstr "Ils ? Qui ça, ils ?"

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/g-1/9/s/0
msgctxt "Choix"
msgid "The djinn is going to untie you?"
msgstr "Le djinn va te détacher ?"

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/g-1/c-5/7
msgctxt "Chance"
msgid "\"Oh no! My tools! The trowel told me they would come back for me. It's my trusty trowel!\""
msgstr "« Oh non ! Mes outils ! La truelle m'a dit qu'ils reviendraient me chercher. C'est ma fidèle truelle ! »"

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/g-1/c-5/15
msgctxt "Chance"
msgid "You start to think that Moys has lost their mind, when you suddenly see something from the corner of your eye."
msgstr "Tu commences à te dire que Moys a perdu la tête quand, soudain, tu aperçois quelque chose du coin de l'œil."

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/g-1/c-5/23
msgctxt "Chance"
msgid "It's a spade... except... with arms and legs."
msgstr "C'est une bêche... mais... avec des bras et des jambes."

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/g-1/c-5/31
msgctxt "Chance"
msgid "Following behind that is a shovel, a rake, another spade, and the aforementioned trowel."
msgstr "Derrière elle suivent une pelle, un râteau, une autre bêche, et la fameuse truelle."

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/g-1/c-5/39
msgctxt "Chance"
msgid "They are taking pieces from Moys' cabin and leading them into the woods."
msgstr "Ils emportent des morceaux de la cabane de Moys vers les bois."

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/g-1/c-5/47/0/s/0
msgctxt "Choix"
msgid "Any idea what they are doing?"
msgstr "Tu as une idée de ce qu'ils font ?"

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/g-1/c-5/47/1/s/0
msgctxt "Choix"
msgid "So we just... cool with this, Moys?"
msgstr "Donc on est juste... d'accord avec ça, Moys ?"

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/g-2/0
msgctxt "Chance"
msgid "\"The tools are following the instruction of the djinn that came through here.\""
msgstr "« Les outils suivent les instructions du djinn qui est passé par ici. »"

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/g-2/8
msgctxt "Chance"
msgid "\"Oh, I hope you didn't have anything to do with that.\""
msgstr "« Oh, j'espère que tu n'y es pour rien. »"

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/g-2/16/s/0
msgctxt "Choix"
msgid "I admit that it was my fault."
msgstr "J'avoue que c'est ma faute."

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/g-2/17/s/0
msgctxt "Choix"
msgid "I practice the art of silence."
msgstr "Je pratique l'art du silence."

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/g-2/c-6/7/b/4
msgctxt "Lux"
msgid "Hang on wait nobody would ever actually do that."
msgstr "Attends, attends, personne ne ferait jamais vraiment ça."

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/g-2/c-6/7/b/12
msgctxt "Lux"
msgid "That is like totally unbelievable."
msgstr "C'est, genre, pas crédible du tout."

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/g-2/c-6/10
msgctxt "Chance"
msgid "\"Oh! Well, that isn't good. Don't worry. I won't tell anyone. The djinn might destroy us before we even get the chance.\""
msgstr "« Oh ! Eh bien, ce n'est pas bon, ça. Ne t'inquiète pas. Je ne dirai rien à personne. De toute façon, le djinn risque de nous détruire avant qu'on en ait l'occasion. »"

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/g-2/c-7/7/b/4
msgctxt "Lux"
msgid "YES betch. Deny deny deny."
msgstr "OUI, meuf. Nier, nier, nier."

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/g-3/0
msgctxt "Chance"
msgid "\"All I know is that the tools need my shed so they can build a throne for the djinn.\""
msgstr "« Tout ce que je sais, c'est que les outils ont besoin de ma remise pour construire un trône au djinn. »"

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/g-3/8
msgctxt "Chance"
msgid "They might be able to lead you to the djinn. What do you want to do?"
msgstr "Ils pourraient te mener au djinn. Que veux-tu faire ?"

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/g-3/16/s/0
msgctxt "Choix"
msgid "Attack the tools! I'll beat the location of the djinn out of them!"
msgstr "J'attaque les outils ! Je vais leur faire cracher où est le djinn à coups de baffes !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/g-3/17/s/0
msgctxt "Choix"
msgid "If I'm stealthy, maybe I can follow them back!"
msgstr "Si je suis discret{{|e|·e}}, je pourrai peut-être les suivre !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part4/0/g-3/18/s/0
msgctxt "Choix"
msgid "Maybe I can question the trowel?"
msgstr "Je pourrais peut-être interroger la truelle ?"

# Traduction IA – à relire
#: chance_d20/Tool_attack/0/0
msgctxt "Chance"
msgid "You jump up... a spell loaded and ready to fly."
msgstr "Tu bondis... un sort chargé, prêt à partir."

# Traduction IA – à relire
#: chance_d20/Tool_attack/0/8
msgctxt "Chance"
msgid "You catch them unaware and your magical shot rings through the air, hitting the trowel dead on."
msgstr "Tu les prends par surprise et ton tir magique fend l'air pour frapper la truelle en plein dans le mille."

# Traduction IA – à relire
#: chance_d20/Tool_attack/0/16
msgctxt "Chance"
msgid "\"Owww! What's the big idea, bub!\""
msgstr "« Aïeuh ! C'est quoi ton problème, mon gars ? »"

# Traduction IA – à relire
#: chance_d20/Tool_attack/0/24
msgctxt "Chance"
msgid "All of the other tools stop."
msgstr "Tous les autres outils s'arrêtent."

# Traduction IA – à relire
#: chance_d20/Tool_attack/0/32/b/4
msgctxt "Lux"
msgid "I wanna shoot one with an arrow or a- or a thumbs-down or something."
msgstr "Je veux tirer sur l'un d'eux avec une flèche ou un... ou un pouce rouge, un truc comme ça."

# Traduction IA – à relire
#: chance_d20/Tool_attack/0/32/b/12
msgctxt "Chance"
msgid "Do you want to use your bow?"
msgstr "Tu veux utiliser ton arc ?"

# Traduction IA – à relire
#: chance_d20/Tool_attack/0/32/b/20
msgctxt "Lux"
msgid "OMG actually no let me block and report him."
msgstr "OMG, en fait non, laisse-moi le bloquer et le signaler."

# Traduction IA – à relire
#: chance_d20/Tool_attack/0/32/b/28
msgctxt "Chance"
msgid "Okay... roll to see if you can shoot one with an arrow."
msgstr "D'accord... fais un jet pour voir si tu peux en toucher un avec une flèche."

# Traduction IA – à relire
#: chance_d20/Tool_attack/0/32/b/36
msgctxt "Lux"
msgid "Ooo, I got a 1! Again!"
msgstr "Oooh, j'ai fait 1 ! Encore !"

# Traduction IA – à relire
#: chance_d20/Tool_attack/0/32/b/44
msgctxt "Chance"
msgid "I thought you didn't roll—"
msgstr "Je croyais que tu n'avais pas fait..."

# Traduction IA – à relire
#: chance_d20/Tool_attack/0/32/b/52
msgctxt "Lux"
msgid "I mean for the first time! So, like, I'm number one, clearly."
msgstr "Je veux dire pour la première fois ! Donc, genre, je suis numéro un, clairement."

# Traduction IA – à relire
#: chance_d20/Tool_attack/0/32/b/60
msgctxt "Chance"
msgid "You critically fail your attack roll."
msgstr "Ton jet d'attaque est un échec critique."

# Traduction IA – à relire
#: chance_d20/Tool_attack/0/32/b/68
msgctxt "Lux"
msgid "Nah, I'm re-rolling. Hang on."
msgstr "Nan, je relance. Attends."

# Traduction IA – à relire
#: chance_d20/Tool_attack/0/32/b/76
msgctxt "Chance"
msgid "No you... ANYWAY! You... shoot your arrow and with a 1... it sticks into the leg of your party member for... 5 hp."
msgstr "Non, tu... BREF ! Tu... tires ta flèche et, avec un 1... elle se plante dans la jambe d'un membre de ton groupe pour... 5 PV."

# Traduction IA – à relire
#: chance_d20/Tool_attack/0/32/b/84
msgctxt "Chance"
msgid "So you hit your partner... for damage."
msgstr "Donc tu blesses ton propre groupe... avec de vrais dégâts."

# Traduction IA – à relire
#: chance_d20/Tool_attack/0/32/b/92
msgctxt "Lux"
msgid "Now how about all you out there HIT... that like and subscribe button!"
msgstr "Et vous tous, là, n'oubliez pas de TOUCHER... le bouton j'aime et abonnez-vous !"

# Traduction IA – à relire
#: chance_d20/Tool_attack/0/32/b/112
msgctxt "Chance"
msgid "Having Lux play with us might not have been the best idea..."
msgstr "Faire jouer Lux avec nous, ce n'était peut-être pas la meilleure idée..."

# Traduction IA – à relire
#: chance_d20/Tool_attack/0/35
msgctxt "Chance"
msgid "\"You up here throwin' spells all willy nilly. What's wrong with you?\""
msgstr "« Tu débarques et tu balances des sorts à tort et à travers. T'es pas bien ou quoi ? »"

# Traduction IA – à relire
#: chance_d20/Tool_attack/0/43
msgctxt "Chance"
msgid "\"We're just tryin' ta work! You got beef? We can scrap.\""
msgstr "« On essaie juste de bosser, nous ! T'as un problème ? On peut se friter. »"

# Traduction IA – à relire
#: chance_d20/Tool_attack/0/51/s/0
msgctxt "Choix"
msgid "You talk big for a tiny trowel."
msgstr "Tu causes gros pour une petite truelle."

# Traduction IA – à relire
#: chance_d20/Tool_attack/0/52/s/0
msgctxt "Choix"
msgid "You think I'm scared of you?"
msgstr "Tu crois que tu me fais peur ?"

# Traduction IA – à relire
#: chance_d20/Tool_attack/0/g-0/0
msgctxt "Chance"
msgid "\"If you know what's good for ya, you'll stop this nonsense.\""
msgstr "« Si tu tiens à ta peau, t'arrêtes tes bêtises. »"

# Traduction IA – à relire
#: chance_d20/Tool_attack/0/g-0/8
msgctxt "Chance"
msgid "\"My buddy here? He'll rake you over the coals. And then this one will dig your grave.\""
msgstr "« Mon pote, là ? Il va te ratisser vite fait. Et celle-là, elle va te creuser ta tombe. »"

# Traduction IA – à relire
#: chance_d20/Tool_attack/0/g-0/16
msgctxt "Chance"
msgid "\"Don't even get me started on this one. He has anger issues in spades.\""
msgstr "« Et me lance pas sur celui-là. Un sacré bêcheur, avec ça, et il a le sang chaud. »"

# Traduction IA – à relire
#: chance_d20/Tool_attack/0/g-0/24/s/0
msgctxt "Choix"
msgid "Cooorny! But cute."
msgstr "Trop ringaaard ! Mais mignon."

# Traduction IA – à relire
#: chance_d20/Tool_attack/0/g-0/25/s/0
msgctxt "Choix"
msgid "You sound like the tool you are!"
msgstr "Tu parles comme le manche que tu es !"

# Traduction IA – à relire
#: chance_d20/Tool_attack/0/g-0/26/s/0
msgctxt "Choix"
msgid "Don't make me hit you again.\""
msgstr "Me force pas à te frapper encore."

# Traduction IA – à relire
#: chance_d20/Tool_attack/0/g-0/c-2/7
msgctxt "Chance"
msgid "Hehehe. I try."
msgstr "Hihihi. Je fais de mon mieux."

# Traduction IA – à relire
#: chance_d20/Tool_attack/0/g-0/c-3/7
msgctxt "Chance"
msgid "\"Why I oughta!\""
msgstr "« Espèce de... ! »"

# Traduction IA – à relire
#: chance_d20/Tool_attack/0/g-0/c-4/7
msgctxt "Chance"
msgid "\"That a threat comin' from ya? Huh?\""
msgstr "« C'est une menace, ça ? Hein ? »"

# Traduction IA – à relire
#: chance_d20/Tool_attack/0/g-1/8/s/0
msgctxt "Choix"
msgid "I'mm fight him. Fight 'em all."
msgstr "Je vais me le faire. Me les faire tous."

# Traduction IA – à relire
#: chance_d20/Tool_attack_2/0/0
msgctxt "Chance"
msgid "You call forth another spell. They ready themselves."
msgstr "Tu invoques un autre sort. Ils se mettent en garde."

# Traduction IA – à relire
#: chance_d20/Tool_attack_2/0/8
msgctxt "Chance"
msgid "\"Oh, you done gone messed up! Tools! Attack!\""
msgstr "« Oh, t'as fait une grosse bêtise, là ! Les outils ! À l'attaque ! »"

# Traduction IA – à relire
#: chance_d20/Tool_attack_2/0/16
msgctxt "Chance"
msgid "They all start to float in the air, and fling themselves at you."
msgstr "Ils se mettent tous à flotter dans les airs et se jettent sur toi."

# Traduction IA – à relire
#: chance_d20/Tool_attack_2/0/24
msgctxt "Chance"
msgid "You avoid most of them except the rake hits you hard."
msgstr "Tu en évites la plupart, sauf le râteau, qui te frappe durement."

# Traduction IA – à relire
#: chance_d20/Tool_attack_2/0/32
msgctxt "Chance"
msgid "You take... 30 damage!"
msgstr "Tu subis... 30 points de dégâts !"

# Traduction IA – à relire
#: chance_d20/Tool_attack_2/0/49/b/4
msgctxt "Lux"
msgid "Ew. Gross. You shouldn't have let that happen, honestly."
msgstr "Beurk. Dégueu. T'aurais pas dû laisser faire ça, franchement."

# Traduction IA – à relire
#: chance_d20/Tool_attack_2/0/52/b/1 chance_d20/Enchanter_part7a/0/g-0/41/b/1 chance_d20/Magic_attack/0/66/b/1 chance_d20/Read_runes/0/116/b/1 chance_d20/Read_runes/0/g-1/108/b/1 chance_d20/Tool_ask/0/g-2/87/b/1 chance_d20/Tool_take/0/g-2/78/b/1
msgctxt "Chance"
msgid "That hit makes you wish your robes were padded. You can't get smacked around too much more."
msgstr "Ce coup te fait regretter que ta robe ne soit pas rembourrée. Tu ne pourras plus encaisser beaucoup de coups."

# Traduction IA – à relire
#: chance_d20/Tool_attack_2/0/55/b/1 chance_d20/Enchanter_part7a/0/g-0/44/b/1
msgctxt "Chance"
msgid "The djinn is the least of your worries as you pass out from the pain. You fall over. You stop breathing."
msgstr "Le djinn est le cadet de tes soucis : tu t'évanouis de douleur. Tu t'effondres. Tu cesses de respirer."

# Traduction IA – à relire
#: chance_d20/Tool_attack_2/0/58
msgctxt "Chance"
msgid "Good thing you have just the spell up your sleeve. You summon lightning to your fingertips."
msgstr "Heureusement, tu as justement le sort qu'il faut dans ta manche. Tu fais jaillir la foudre au bout de tes doigts."

# Traduction IA – à relire
#: chance_d20/Tool_attack_2/0/66
msgctxt "Chance"
msgid "It shoots out from you, hitting every tool at once, sending them crashing to the ground. They all groan from pain."
msgstr "Elle jaillit de toi, frappe tous les outils à la fois et les envoie s'écraser au sol. Ils gémissent tous de douleur."

# Traduction IA – à relire
#: chance_d20/Tool_attack_2/0/74
msgctxt "Chance"
msgid "\"Alright, alright! Sheesh. Ya strong for a little wimp. What 'cha want, kid?\""
msgstr "« Ça va, ça va ! Oula. T'es costaud pour une petite mauviette. Qu'est-ce que tu veux, {{gamin|gamine|gamin·e}} ? »"

# Traduction IA – à relire
#: chance_d20/Tool_attack_2/0/82/s/0
msgctxt "Choix"
msgid "Where is the djinn?"
msgstr "Où est le djinn ?"

# Traduction IA – à relire
#: chance_d20/Tool_attack_2/0/83/s/0
msgctxt "Choix"
msgid "Tell me where I can find your master!"
msgstr "Dis-moi où je peux trouver ton maître !"

# Traduction IA – à relire
#: chance_d20/Tool_attack_2/0/g-0/0 chance_d20/Question_tool/0/g-2/16
msgctxt "Chance"
msgid "The Trowel walks over to you, and points down a path."
msgstr "La Truelle s'approche de toi et pointe un chemin du doigt."

# Traduction IA – à relire
#: chance_d20/Tool_attack_2/0/g-0/8
msgctxt "Chance"
msgid "\"Keep going that way. You'll get to the glen in the middle of the forest. Can't miss it.\""
msgstr "« Continue par là. Tu vas arriver à la clairière au milieu de la forêt. Tu peux pas la rater. »"

# Traduction IA – à relire
#: chance_d20/Tool_attack_2/0/g-0/16 chance_d20/Question_tool/0/g-2/32
msgctxt "Chance"
msgid "The Trowel turns to the other tools and says \"Alright, folks. Let's pack it in. This ain't no union gig, so we ain't dealin' with these conditions.\""
msgstr "La Truelle se tourne vers les autres outils et dit : « Bon, les gars. On remballe. C'est pas un boulot syndiqué, alors on va pas bosser dans ces conditions. »"

# Traduction IA – à relire
#: chance_d20/Tool_attack_2/0/g-0/24/s/0 chance_d20/Question_tool/0/g-2/43/s/0
msgctxt "Choix"
msgid "Don't forget about Moys!"
msgstr "N'oublie pas Moys !"

# Traduction IA – à relire
#: chance_d20/Tool_attack_2/0/g-0/25/s/0 chance_d20/Question_tool/0/g-2/44/s/0
msgctxt "Choix"
msgid "And put Moys's place back together!"
msgstr "Et remettez la cabane de Moys en état !"

# Traduction IA – à relire
#: chance_d20/Tool_attack_2/0/g-1/0 chance_d20/Question_tool/0/g-3/0
msgctxt "Chance"
msgid "\"Okay! Goodness. Who died and made you foreman?\""
msgstr "« D'accord ! Bon sang. Qui t'a fait chef de chantier ? »"

# Traduction IA – à relire
#: chance_d20/Tool_attack_2/0/g-1/8 chance_d20/Question_tool/0/g-3/8
msgctxt "Chance"
msgid "\"You heard the kid! Untie Moys and let's get ta fixin!\""
msgstr "« Vous avez entendu {{le gamin|la gamine|le gamin}} ! On détache Moys et on se met à réparer ! »"

# Traduction IA – à relire
#: chance_d20/Tool_attack_2/0/g-1/16 chance_d20/Question_tool/0/g-3/16
msgctxt "Chance"
msgid "With that, you turn and walk down the path that the magical Trowel pointed you toward."
msgstr "Sur ce, tu fais demi-tour et t'engages sur le chemin que t'a indiqué la Truelle magique."

# Traduction IA – à relire
#: chance_d20/Sneaky_tools/0
msgctxt "Chance"
msgid "You decide to stealth your way out of this one."
msgstr "Tu décides de t'en sortir en toute discrétion."

# Traduction IA – à relire
#: chance_d20/Sneaky_tools/8
msgctxt "Chance"
msgid "As the tools begin to head off down a path, wood and various building materials in hand, you follow them from a distance."
msgstr "Tandis que les outils s'engagent sur un chemin, chargés de bois et de matériaux divers, tu les suis à distance."

# Traduction IA – à relire
#: chance_d20/Sneaky_tools/16
msgctxt "Chance"
msgid "Every now and then, you have to stop because the trowel looks like it is looking for you."
msgstr "De temps en temps, tu dois t'arrêter, parce que la truelle a l'air de te chercher."

# Traduction IA – à relire
#: chance_d20/Sneaky_tools/24
msgctxt "Chance"
msgid "But you keep going, following them for a few minutes."
msgstr "Mais tu continues et tu les suis pendant quelques minutes."

# Traduction IA – à relire
#: chance_d20/Sneaky_tools/32
msgctxt "Chance"
msgid "Eventually, they stop."
msgstr "Finalement, ils s'arrêtent."

# Traduction IA – à relire
#: chance_d20/Sneaky_tools/40
msgctxt "Chance"
msgid "\"Alright! Time for our break! We've been workin' for an hour so we are taking ten.\""
msgstr "« Bon ! C'est l'heure de la pause ! Ça fait une heure qu'on bosse, alors on prend dix minutes. »"

# Traduction IA – à relire
#: chance_d20/Sneaky_tools/48
msgctxt "Chance"
msgid "The tools all put down what they are carrying and they begin to talk. You listen, closely."
msgstr "Les outils posent tous ce qu'ils portent et se mettent à discuter. Tu tends l'oreille."

# Traduction IA – à relire
#: chance_d20/Sneaky_tools/56
msgctxt "Chance"
msgid "\"So... uhhh... Rake. You doin' alright? This work is out of your general wheelhouse.\""
msgstr "« Alors... euh... Râteau. Ça va, toi ? C'est pas trop ton rayon, ce boulot. »"

# Traduction IA – à relire
#: chance_d20/Sneaky_tools/64
msgctxt "Chance"
msgid "\"Thanks for askin', Spade. I'm hangin' in there. Trowel can really push a person, though.\""
msgstr "« Merci de demander, Bêche. Je tiens le coup. Mais la Truelle sait vraiment pousser les gens à bout. »"

# Traduction IA – à relire
#: chance_d20/Sneaky_tools/72
msgctxt "Chance"
msgid "\"Oh, I know. Try being their cousin.\""
msgstr "« Oh, je sais. Essaie d'être son cousin. »"

# Traduction IA – à relire
#: chance_d20/Sneaky_tools/80
msgctxt "Chance"
msgid "\"The crazy thing is, I should have stayed in the glade with the djinn. Did you see all those leaves?\""
msgstr "« Le plus dingue, c'est que j'aurais dû rester dans la clairière avec le djinn. T'as vu toutes ces feuilles ? »"

# Traduction IA – à relire
#: chance_d20/Sneaky_tools/88
msgctxt "Chance"
msgid "\"They were everywhere.\""
msgstr "« Y en avait partout. »"

# Traduction IA – à relire
#: chance_d20/Sneaky_tools/96
msgctxt "Chance"
msgid "\"And I'm the perfect tool for the job! But noooo! Lift this board, Rake. Put it there, Rake.\""
msgstr "« Et je suis l'outil parfait pour ça ! Mais noooon ! Soulève cette planche, Râteau. Pose-la là, Râteau. »"

# Traduction IA – à relire
#: chance_d20/Sneaky_tools/104
msgctxt "Chance"
msgid "The Spade puts its tiny hand on the Rake's arm."
msgstr "La Bêche pose sa petite main sur le bras du Râteau."

# Traduction IA – à relire
#: chance_d20/Sneaky_tools/112
msgctxt "Chance"
msgid "\"When we get to the glade, you want me to say somethin'?\""
msgstr "« Quand on arrivera à la clairière, tu veux que je dise un truc ? »"

# Traduction IA – à relire
#: chance_d20/Sneaky_tools/120
msgctxt "Chance"
msgid "\"Naww. Thanks though. The djinn seems like a fair guy. I'll talk to him, see what he can do.\""
msgstr "« Naan. Merci quand même. Le djinn a l'air réglo. Je lui parlerai, je verrai ce qu'il peut faire. »"

# Traduction IA – à relire
#: chance_d20/Sneaky_tools/128
msgctxt "Chance"
msgid "The Trowel walks over to the Rake and the Spade. \"We're gonna head back to the shed after our break. Gotta pull some nails for hammer.\""
msgstr "La Truelle rejoint le Râteau et la Bêche. « On retourne à la remise après la pause. Faut arracher des clous pour le marteau. »"

# Traduction IA – à relire
#: chance_d20/Sneaky_tools/136
msgctxt "Chance"
msgid "You've heard all you need to and you head toward the glade."
msgstr "Tu as entendu tout ce qu'il te fallait, et tu te diriges vers la clairière."

# Traduction IA – à relire
#: chance_d20/Sneaky_tools/144/b/4
msgctxt "Lux"
msgid "That's it? We find out where to go by listening?"
msgstr "C'est tout ? On découvre où aller juste en écoutant ?"

# Traduction IA – à relire
#: chance_d20/Sneaky_tools/144/b/12
msgctxt "Lux"
msgid "Don't be surprised if you lose subs over this writing."
msgstr "Sois pas surpris si tu perds des abonnés avec un scénario pareil."

# Traduction IA – à relire
#: chance_d20/Sneaky_tools/144/b/20
msgctxt "Chance"
msgid "What subs? What are you even talking about?"
msgstr "Quels abonnés ? De quoi tu parles, au juste ?"

# Traduction IA – à relire
#: chance_d20/Question_tool/0/0
msgctxt "Chance"
msgid "You jump from your hiding spot. And you shout at the tools..."
msgstr "Tu sors de ta cachette d'un bond. Et tu cries aux outils..."

# Traduction IA – à relire
#: chance_d20/Question_tool/0/8
msgctxt "Chance"
msgid "What do you shout?"
msgstr "Tu cries quoi ?"

# Traduction IA – à relire
#: chance_d20/Question_tool/0/16/s/0
msgctxt "Choix"
msgid "Listen up, TOOLS!"
msgstr "Écoutez-moi bien, les OUTILS !"

# Traduction IA – à relire
#: chance_d20/Question_tool/0/17/s/0
msgctxt "Choix"
msgid "Excuse me. Can I have your attention?"
msgstr "Excusez-moi. Je peux avoir votre attention ?"

# Traduction IA – à relire
#: chance_d20/Question_tool/0/g-0/0
msgctxt "Chance"
msgid "The trowel whips around. \"Eh? Who is you? Can't ya see we're workin' here?!\""
msgstr "La truelle fait volte-face. « Hein ? T'es qui, toi ? Tu vois pas qu'on bosse, là ?! »"

# Traduction IA – à relire
#: chance_d20/Question_tool/0/g-0/8
msgctxt "Chance"
msgid "The other tools stare at you. The trowel speaks up. Mostly because the others don't."
msgstr "Les autres outils te fixent. C'est la truelle qui prend la parole. Surtout parce que les autres se taisent."

# Traduction IA – à relire
#: chance_d20/Question_tool/0/g-0/16
msgctxt "Chance"
msgid "\"Okay, kid. You've got our attention. What is it you want?\""
msgstr "« D'accord, {{gamin|gamine|gamin·e}}. T'as notre attention. Qu'est-ce que tu veux ? »"

# Traduction IA – à relire
#: chance_d20/Question_tool/0/g-0/24/b/4
msgctxt "Lux"
msgid "You better say something sassy and provocative. That's what the algorithm likes."
msgstr "T'as intérêt à dire un truc insolent et provocant. C'est ce que l'algorithme aime."

# Traduction IA – à relire
#: chance_d20/Question_tool/0/g-0/27/s/0
msgctxt "Choix"
msgid "I need you to lead me to the djinn."
msgstr "J'ai besoin que vous me conduisiez au djinn."

# Traduction IA – à relire
#: chance_d20/Question_tool/0/g-0/28/s/0
msgctxt "Choix"
msgid "Take me to your employer."
msgstr "Emmenez-moi voir votre employeur."

# Traduction IA – à relire
#: chance_d20/Question_tool/0/g-1/0
msgctxt "Chance"
msgid "\"Oh goodness. Let me guess, he didn't get the permits he was 'sposed to.\""
msgstr "« Oh, bon sang. Laisse-moi deviner, il a pas obtenu les permis qu'il fallait. »"

# Traduction IA – à relire
#: chance_d20/Question_tool/0/g-1/8
msgctxt "Chance"
msgid "The tools start to grumble."
msgstr "Les outils se mettent à ronchonner."

# Traduction IA – à relire
#: chance_d20/Question_tool/0/g-1/16
msgctxt "Chance"
msgid "\"Is that what this is about? Permits?\""
msgstr "« C'est pour ça, tout ce cirque ? Des permis ? »"

# Traduction IA – à relire
#: chance_d20/Question_tool/0/g-1/24/s/0
msgctxt "Choix"
msgid "Yep. Sure is. Permits."
msgstr "Ouais. Exactement. Des permis."

# Traduction IA – à relire
#: chance_d20/Question_tool/0/g-1/25/s/0
msgctxt "Choix"
msgid "Uhh... not exactly."
msgstr "Euh... pas vraiment."

# Traduction IA – à relire
#: chance_d20/Question_tool/0/g-2/0
msgctxt "Chance"
msgid "The trowel throws his hands up. \"Listen, whatever djinny djinn djinn got himself into, I don't want no part of it.\""
msgstr "La truelle lève les bras au ciel. « Écoute, quel que soit le pétrin dans lequel le djinn s'est djinnfourré, je veux pas m'en mêler. »"

# Traduction IA – à relire
#: chance_d20/Question_tool/0/g-2/8
msgctxt "Chance"
msgid "\"I'm just a tool tryin' to do my job, ya know? You wanna talk to the big guy, by all means.\""
msgstr "« Je suis juste un outil qui essaie de faire son boulot, tu vois ? Tu veux parler au grand chef, fais-toi plaisir. »"

# Traduction IA – à relire
#: chance_d20/Question_tool/0/g-2/24
msgctxt "Chance"
msgid "\"Keep going that way. You'll get to the glade in the middle of the forest. Can't miss it.\""
msgstr "« Continue par là. Tu vas arriver à la clairière au milieu de la forêt. Tu peux pas la rater. »"

# Traduction IA – à relire
#: chance_d20/Question_tool/0/g-2/40/b/4
msgctxt "Lux"
msgid "I see how much boob I can show without triggering a flagged account."
msgstr "Je regarde jusqu'où je peux montrer mes seins sans que mon compte se fasse signaler."

# Traduction IA – à relire
#: chance_d20/Question_tool/0/g-2/40/b/12
msgctxt "Chance"
msgid "That literally has no bearing on this adventure whatsoever."
msgstr "Ça n'a littéralement aucun rapport avec cette aventure."

# Traduction IA – à relire
#: chance_d20/Question_tool/0/g-3/24/b/4
msgctxt "Lux"
msgid "I walk in front so everyone can see me better."
msgstr "Je marche devant pour que tout le monde me voie mieux."

# Traduction IA – à relire
#: chance_d20/Enchanter_part5/0/0
msgctxt "Chance"
msgid "As you make your way toward the glade, your magical senses start to tingle."
msgstr "En te dirigeant vers la clairière, tes sens magiques se mettent à picoter."

# Traduction IA – à relire
#: chance_d20/Enchanter_part5/0/8
msgctxt "Chance"
msgid "You see a few pebbles floating in midair. They float up and down, glowing a soft blue."
msgstr "Tu vois quelques cailloux flotter dans les airs. Ils montent et descendent en luisant d'un bleu doux."

# Traduction IA – à relire
#: chance_d20/Enchanter_part5/0/16
msgctxt "Chance"
msgid "From your education, you know this to be a leyline. It is one of many that converge around the school."
msgstr "Grâce à tes études, tu sais que c'est une ligne tellurique. L'une des nombreuses qui convergent autour de l'école."

# Traduction IA – à relire
#: chance_d20/Enchanter_part5/0/24
msgctxt "Chance"
msgid "You think this is why the djinn went this way, to amass more power along the leyline."
msgstr "Tu penses que c'est pour ça que le djinn est passé par là : pour accumuler davantage de pouvoir le long de la ligne tellurique."

# Traduction IA – à relire
#: chance_d20/Enchanter_part5/0/32
msgctxt "Chance"
msgid "But, there might be more to it than that."
msgstr "Mais il y a peut-être autre chose."

# Traduction IA – à relire
#: chance_d20/Enchanter_part5/0/40
msgctxt "Chance"
msgid "Still, time is of the essence. You could steam forward toward the djinn, or stop and do some quick research from your book."
msgstr "Quoi qu'il en soit, le temps presse. Tu pourrais foncer vers le djinn, ou t'arrêter pour faire une petite recherche dans ton livre."

# Traduction IA – à relire
#: chance_d20/Enchanter_part5/0/48/s/0
msgctxt "Choix"
msgid "Books won't save us now! Gotta get to the djinn!"
msgstr "Les livres ne nous sauveront pas, là ! Faut rejoindre le djinn !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part5/0/49/s/0
msgctxt "Choix"
msgid "Knowledge is power. Bust open those pages!"
msgstr "Savoir, c'est pouvoir. Ouvrons ces pages !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part5/0/c-0/7
msgctxt "Chance"
msgid "You think you know enough to get through. You power ahead!"
msgstr "Tu penses en savoir assez pour t'en sortir. Tu fonces !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part5/0/c-1/7/b/4
msgctxt "Lux"
msgid "Books are like sexy boob covers. I use them when I want to look like a librarian."
msgstr "Les livres, c'est genre des cache-seins sexy. Je m'en sers quand je veux avoir l'air d'une bibliothécaire."

# Traduction IA – à relire
#: chance_d20/Enchanter_part5/0/c-1/10
msgctxt "Chance"
msgid "You take a moment to sit down and crack open the book you brought with you."
msgstr "Tu prends un moment pour t'asseoir et ouvrir le livre que tu as apporté."

# Traduction IA – à relire
#: chance_d20/Enchanter_part5/0/c-1/18
msgctxt "Chance"
msgid "Flipping to the back of the book to find leyline in the index, you quickly find your page."
msgstr "Tu files à la fin du livre pour chercher « ligne tellurique » dans l'index, et tu trouves vite ta page."

# Traduction IA – à relire
#: chance_d20/Enchanter_part5/0/c-1/26
msgctxt "Chance"
msgid "It says that while they are great sources of power, they can also be a great source of healing!"
msgstr "Il y est écrit que si ce sont de grandes sources de pouvoir, elles peuvent aussi être de grandes sources de guérison !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part5/0/c-1/34
msgctxt "Chance"
msgid "You find a ritual of rejuvenation and you partake."
msgstr "Tu trouves un rituel de régénération et tu l'accomplis."

# Traduction IA – à relire
#: chance_d20/Enchanter_part5/0/c-1/42
msgctxt "Chance"
msgid "You have gained an additional 15 health!"
msgstr "Tu gagnes 15 PV supplémentaires !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part5/0/c-1/59/b/4
msgctxt "Lux"
msgid "What do I get? Can I have some additional likes?"
msgstr "Et moi, j'ai quoi ? Je peux avoir des likes en plus ?"

# Traduction IA – à relire
#: chance_d20/Enchanter_part5/0/c-1/59/b/12
msgctxt "Lux"
msgid "I feel like my ritual of foot pics should give me something, right?"
msgstr "J'ai l'impression que mon rituel de photos de pieds devrait me rapporter un truc, non ?"

# Traduction IA – à relire
#: chance_d20/Enchanter_part5/0/c-1/62
msgctxt "Chance"
msgid "Nothing else in the book really helps you, but at least you feel more prepared for what is to come."
msgstr "Rien d'autre dans le livre ne t'aide vraiment, mais au moins, tu te sens mieux {{préparé|préparée|préparé·e}} pour la suite."

# Traduction IA – à relire
#: chance_d20/Enchanter_part5/0/c-1/70
msgctxt "Chance"
msgid "With your Sack on your shoulder and your wand at the ready, you venture toward the glade."
msgstr "Ton Sac sur l'épaule et ta baguette prête, tu t'aventures vers la clairière."

# Traduction IA – à relire
#: chance_d20/Enchanter_part6/0/0
msgctxt "Chance"
msgid "You travel for another 10 to 15 minutes. It is then you see it."
msgstr "Tu marches encore 10 ou 15 minutes. Et c'est là que tu la vois."

# Traduction IA – à relire
#: chance_d20/Enchanter_part6/0/8
msgctxt "Chance"
msgid "A glade surrounded by trees and, in the middle of it, the djinn."
msgstr "Une clairière entourée d'arbres et, en son centre, le djinn."

# Traduction IA – à relire
#: chance_d20/Enchanter_part6/0/16
msgctxt "Chance"
msgid "He is feeding off of a leyline. Behind him is a half constructed throne."
msgstr "Il se nourrit d'une ligne tellurique. Derrière lui se dresse un trône à moitié construit."

# Traduction IA – à relire
#: chance_d20/Enchanter_part6/0/24
msgctxt "Chance"
msgid "As you contemplate what to do, you hear a magical tone."
msgstr "Tandis que tu réfléchis à la marche à suivre, tu entends une sonnerie magique."

# Traduction IA – à relire
#: chance_d20/Enchanter_part6/0/32
msgctxt "Chance"
msgid "You search for where it is coming from. Oh! Your ringing rock!"
msgstr "Tu cherches d'où elle vient. Oh ! Ton caillou sonnant !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part6/0/40/b/4
msgctxt "Lux"
msgid "Ohhhh I get it. The rock is like a phone. And, after you're done with it, let me have it for a bit."
msgstr "Ohhhh, j'ai compris. Le caillou, c'est genre un téléphone. Et quand t'as fini, prête-le-moi un peu."

# Traduction IA – à relire
#: chance_d20/Enchanter_part6/0/40/b/12
msgctxt "Lux"
msgid "Then we'll be able to get some real powers."
msgstr "Comme ça, on aura de vrais pouvoirs."

# Traduction IA – à relire
#: chance_d20/Enchanter_part6/0/43
msgctxt "Chance"
msgid "You quickly search your Sack for the ringing rock, and answer it in hushed tones."
msgstr "Tu fouilles vite ton Sac pour trouver le caillou sonnant, et tu décroches en chuchotant."

# Traduction IA – à relire
#: chance_d20/Enchanter_part6/0/51/s/0
msgctxt "Choix"
msgid "Hello?! Who is this?!"
msgstr "Allô ?! Qui est à l'appareil ?!"

# Traduction IA – à relire
#: chance_d20/Enchanter_part6/0/52/s/0
msgctxt "Choix"
msgid "I'm kinda in the middle of something!"
msgstr "Je suis un peu occupé{{|e|·e}}, là !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part6/0/g-0/0
msgctxt "Chance"
msgid "\"Oh, there you are! Where are you right now?\""
msgstr "« Ah, te voilà ! Où es-tu, en ce moment ? »"

# Traduction IA – à relire
#: chance_d20/Enchanter_part6/0/g-0/8
msgctxt "Chance"
msgid "That voice is one you would never forget. High Enchanter Melvil is on the other end."
msgstr "Cette voix, tu ne l'oublierais jamais. La Grande Enchanteresse Melvil est au bout du fil."

# Traduction IA – à relire
#: chance_d20/Enchanter_part6/0/g-0/16
msgctxt "Chance"
msgid "\"I've come looking for you. I need you to help me in the lecture hall. We made a bit of a mess.\""
msgstr "« Je te cherchais. J'ai besoin de ton aide dans l'amphithéâtre. Nous avons un peu mis le bazar. »"

# Traduction IA – à relire
#: chance_d20/Enchanter_part6/0/g-0/24
msgctxt "Chance"
msgid "\"You weren't in my study, so I figure you are done with your chores?\""
msgstr "« Tu n'étais pas dans mon bureau, alors j'imagine que tu as fini tes corvées ? »"

# Traduction IA – à relire
#: chance_d20/Enchanter_part6/0/g-0/32/s/0
msgctxt "Choix"
msgid "Uhhh... yeah! I totally am!"
msgstr "Euh... ouais ! Complètement !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part6/0/g-0/33/s/0
msgctxt "Choix"
msgid "I'm almost done!"
msgstr "J'ai presque fini !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part6/0/g-1/0
msgctxt "Chance"
msgid "\"Why does it sound like you are outside. Is that... is that a leyline I hear?\""
msgstr "« Pourquoi est-ce qu'on dirait que tu es dehors ? C'est... c'est une ligne tellurique que j'entends ? »"

# Traduction IA – à relire
#: chance_d20/Enchanter_part6/0/g-1/8/s/0
msgctxt "Choix"
msgid "She can hear that?!"
msgstr "Elle entend ça ?!"

# Traduction IA – à relire
#: chance_d20/Enchanter_part6/0/g-1/9/s/0
msgctxt "Choix"
msgid "Wow, she really is powerful."
msgstr "Waouh, elle est vraiment puissante."

# Traduction IA – à relire
#: chance_d20/Enchanter_part6/0/g-2/0
msgctxt "Chance"
msgid "You know that Melvil isn't the biggest fan of lying. You have a choice to make."
msgstr "Tu sais que Melvil n'apprécie pas vraiment le mensonge. Tu as un choix à faire."

# Traduction IA – à relire
#: chance_d20/Enchanter_part6/0/g-2/8
msgctxt "Chance"
msgid "Do you come clean? Or do you hide the truth from your mentor?"
msgstr "Tu avoues tout ? Ou tu caches la vérité à ton mentor ?"

# Traduction IA – à relire
#: chance_d20/Enchanter_part6/0/g-2/16/b/4
msgctxt "Lux"
msgid "We all know what the answer is here."
msgstr "On sait tous quelle est la réponse, là."

# Traduction IA – à relire
#: chance_d20/Enchanter_part6/0/g-2/19/s/0
msgctxt "Choix"
msgid "I'm on campus. I just need a few minutes."
msgstr "Je suis sur le campus. J'ai juste besoin de quelques minutes."

# Traduction IA – à relire
#: chance_d20/Enchanter_part6/0/g-2/20/s/0
msgctxt "Choix"
msgid "I might have unleashed an evil djinn onto the school."
msgstr "J'ai peut-être lâché un djinn maléfique sur l'école."

# Traduction IA – à relire
#: chance_d20/Fib_melvil/6
msgctxt "Chance"
msgid "\"Well, alright. Whatever you are doing, make it snappy! We can't let everything stick to the floors for too long.\""
msgstr "« Bon, très bien. Quoi que tu fasses, dépêche-toi ! On ne peut pas laisser tout ça coller au sol trop longtemps. »"

# Traduction IA – à relire
#: chance_d20/Fib_melvil/14
msgctxt "Chance"
msgid "She hangs up the ringing rock. That's one crisis averted."
msgstr "Elle raccroche le caillou sonnant. Une crise d'évitée."

# Traduction IA – à relire
#: chance_d20/Fib_melvil/22
msgctxt "Chance"
msgid "You hope."
msgstr "Du moins, tu l'espères."

# Traduction IA – à relire
#: chance_d20/Fib_melvil/30
msgctxt "Chance"
msgid "And now... to take on the djinn."
msgstr "Et maintenant... place au djinn."

# Traduction IA – à relire
#: chance_d20/Truth_melvil/16
msgctxt "Chance"
msgid "\"YOU WHAT?!\""
msgstr "« TU AS QUOI ?! »"

# Traduction IA – à relire
#: chance_d20/Truth_melvil/27/b/4
msgctxt "Lux"
msgid "I just want to go on record saying I had nothing to do with this."
msgstr "Je veux juste que ce soit officiel : j'ai rien à voir avec tout ça."

# Traduction IA – à relire
#: chance_d20/Truth_melvil/30
msgctxt "Chance"
msgid "The ringing rock gets so hot you can barely hold it."
msgstr "Le caillou sonnant devient si brûlant que tu peux à peine le tenir."

# Traduction IA – à relire
#: chance_d20/Truth_melvil/38
msgctxt "Chance"
msgid "\"And let me guess. You are off trying to capture it on your own, aren't you?\""
msgstr "« Et laisse-moi deviner. Tu es parti{{|e|·e}} essayer de le capturer tout{{|e|·e}} seul{{|e|·e}}, c'est ça ? »"

# Traduction IA – à relire
#: chance_d20/Truth_melvil/46
msgctxt "Chance"
msgid "You hear her signature mumbles, along with some choice words rolled in there."
msgstr "Tu l'entends marmonner comme elle seule sait le faire, avec quelques mots bien choisis au passage."

# Traduction IA – à relire
#: chance_d20/Truth_melvil/54
msgctxt "Chance"
msgid "\"Alright, listen closely. You need to bind this stupid thing. If you do exactly as I say, you should be fine.\""
msgstr "« Bon, écoute-moi bien. Tu dois lier cette fichue créature. Si tu fais exactement ce que je dis, tout devrait bien se passer. »"

# Traduction IA – à relire
#: chance_d20/Truth_melvil/62
msgctxt "Chance"
msgid "\"Mess it up, and you will be blown to bits. Got it?\""
msgstr "« Si tu te rates, tu vas exploser en mille morceaux. Compris ? »"

# Traduction IA – à relire
#: chance_d20/Truth_melvil/70
msgctxt "Chance"
msgid "You listen closely, taking every action to memory, and even repeating it back to Melvil."
msgstr "Tu écoutes attentivement, tu mémorises chaque étape, et tu les répètes même à Melvil."

# Traduction IA – à relire
#: chance_d20/Truth_melvil/78
msgctxt "Chance"
msgid "\"First, circle the area with soil from where you stand. Then, begin an ice spell, only touch it to the ground.\""
msgstr "« D'abord, trace un cercle autour de la zone avec de la terre prise là où tu te tiens. Ensuite, commence un sort de glace, mais en touchant seulement le sol. »"

# Traduction IA – à relire
#: chance_d20/Truth_melvil/86
msgctxt "Chance"
msgid "\"Lastly, recite the haiku of holding, you should know it from class.\""
msgstr "« Enfin, récite le haïku de l'emprise. Tu dois le connaître, on l'a vu en cours. »"

# Traduction IA – à relire
#: chance_d20/Truth_melvil/94
msgctxt "Chance"
msgid "\"I'm on my way to you, but you must do this first. Hold tight. I'll be there soon.\""
msgstr "« J'arrive, mais tu dois faire ça d'abord. Tiens bon. Je serai là bientôt. »"

# Traduction IA – à relire
#: chance_d20/Truth_melvil/102
msgctxt "Chance"
msgid "\"And don't expect to get off easy!\""
msgstr "« Et ne t'attends pas à t'en tirer à si bon compte ! »"

# Traduction IA – à relire
#: chance_d20/Truth_melvil/110
msgctxt "Chance"
msgid "The ringing rock disconnects. She hung up on you!"
msgstr "Le caillou sonnant se coupe. Elle t'a raccroché au nez !"

# Traduction IA – à relire
#: chance_d20/Truth_melvil/118
msgctxt "Chance"
msgid "None of that matters now. You have to complete exactly what she says."
msgstr "Peu importe, maintenant. Tu dois faire exactement ce qu'elle a dit."

# Traduction IA – à relire
#: chance_d20/Enchanter_part7a/0/0
msgctxt "Chance"
msgid "Right as you begin your action, the djinn spins around toward you."
msgstr "Au moment même où tu commences, le djinn se retourne vers toi."

# Traduction IA – à relire
#: chance_d20/Enchanter_part7a/0/8
msgctxt "Chance"
msgid "\"Cha! Nice try, mini magic dude! You think you can get one over on me?!\""
msgstr "« Tsss ! Bien essayé, mini-mage ! Tu crois que tu peux m'avoir ?! »"

# Traduction IA – à relire
#: chance_d20/Enchanter_part7a/0/16/b/4
msgctxt "Lux"
msgid "OMG your Djinn voice is so delightfully generic."
msgstr "OMG, ta voix de djinn est d'une banalité tellement délicieuse."

# Traduction IA – à relire
#: chance_d20/Enchanter_part7a/0/16/b/15
msgctxt "Chance"
msgid "Will you PLEASE just... Ugh."
msgstr "Est-ce que tu peux, S'IL TE PLAÎT, juste... Pff."

# Traduction IA – à relire
#: chance_d20/Enchanter_part7a/0/16/b/26
msgctxt "Chance"
msgid "Back to what I was saying..."
msgstr "Je reprends..."

# Traduction IA – à relire
#: chance_d20/Enchanter_part7a/0/19
msgctxt "Chance"
msgid "You step into the glade. The djinn floats over to you."
msgstr "Tu entres dans la clairière. Le djinn flotte jusqu'à toi."

# Traduction IA – à relire
#: chance_d20/Enchanter_part7a/0/27
msgctxt "Chance"
msgid "\"You've got some nerve following me here! You really want that wish, don't you?\""
msgstr "« T'as du culot de me suivre jusqu'ici ! Tu le veux vraiment, ce vœu, hein ? »"

# Traduction IA – à relire
#: chance_d20/Enchanter_part7a/0/35/s/0
msgctxt "Choix"
msgid "I sure do!"
msgstr "Carrément !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part7a/0/36/s/0
msgctxt "Choix"
msgid "I want you to go back in a lamp!"
msgstr "Je veux que tu retournes dans une lampe !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part7a/0/g-0/0
msgctxt "Chance"
msgid "\"Psh! That's too bad! I ain't doin' none of that! And you can't make me!\""
msgstr "« Pff ! Dommage ! Je ferai rien de tout ça ! Et tu peux pas m'y obliger ! »"

# Traduction IA – à relire
#: chance_d20/Enchanter_part7a/0/g-0/8
msgctxt "Chance"
msgid "Before you can reply, he flings a spell at you, hitting you right in the chest."
msgstr "Avant que tu puisses répondre, il te lance un sort qui te frappe en pleine poitrine."

# Traduction IA – à relire
#: chance_d20/Enchanter_part7a/0/g-0/16
msgctxt "Chance"
msgid "He hits you foooooor....."
msgstr "Il t'infliiiiige..."

# Traduction IA – à relire
#: chance_d20/Enchanter_part7a/0/g-0/47/b/4
msgctxt "Lux"
msgid "That's, like, not a great look for you."
msgstr "Ça te met, genre, pas trop en valeur."

# Traduction IA – à relire
#: chance_d20/Enchanter_part7a/0/g-0/47/b/12
msgctxt "Chance"
msgid "And he hit YOU, Lux, for 30 health!"
msgstr "Et c'est TOI qu'il touche, Lux, pour 30 points de dégâts !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part7a/0/g-0/47/b/20
msgctxt "Lux"
msgid "SERIOUSLY!? UNGH, I'm almost dead."
msgstr "SÉRIEUX !? RAAH, j'ai presque plus de PV."

# Traduction IA – à relire
#: chance_d20/Enchanter_part7a/0/g-0/47/b/28
msgctxt "Chance"
msgid "Oh no... that's sooo sad."
msgstr "Oh non... c'est trop triste."

# Traduction IA – à relire
#: chance_d20/Enchanter_part7a/0/g-0/47/b/36
msgctxt "Lux"
msgid "Your stream numbers will tank after I die. My Luxies will not watch you anymore."
msgstr "Tes chiffres de stream vont s'effondrer quand je serai plus là. Mes Luxies ne te regarderont plus."

# Traduction IA – à relire
#: chance_d20/Enchanter_part7a/0/g-0/47/b/41
msgctxt "Chance"
msgid "Oh, won't that be a shame."
msgstr "Oh, ce serait vraiment dommage."

# Traduction IA – à relire
#: chance_d20/Enchanter_part7a/0/g-0/47/b/49
msgctxt "Chance"
msgid "Moving on."
msgstr "On continue."

# Traduction IA – à relire
#: chance_d20/Enchanter_part7a/0/g-0/50
msgctxt "Chance"
msgid "You quickly summon your power and throw an arcane bolt at him."
msgstr "Tu rassembles vite ton pouvoir et lui lances un trait arcanique."

# Traduction IA – à relire
#: chance_d20/Enchanter_part7a/0/g-0/58
msgctxt "Chance"
msgid "It connects but... it doesn't seem to bother him."
msgstr "Il le touche, mais... ça n'a pas l'air de le déranger."

# Traduction IA – à relire
#: chance_d20/Enchanter_part7a/0/g-0/66
msgctxt "Chance"
msgid "\"Woah! That tickles!\""
msgstr "« Wouah ! Ça chatouille ! »"

# Traduction IA – à relire
#: chance_d20/Enchanter_part7a/0/g-0/74
msgctxt "Chance"
msgid "That didn't do much. Maybe there is something else you could do."
msgstr "Ça n'a pas fait grand-chose. Il y a peut-être autre chose à tenter."

# Traduction IA – à relire
#: chance_d20/Enchanter_part7a/0/g-0/82/s/0
msgctxt "Choix"
msgid "I just need to try harder! Hit him with fire!"
msgstr "Je dois juste forcer davantage ! Envoie-lui du feu !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part7a/0/g-0/83/s/0
msgctxt "Choix"
msgid "Maybe I can reason with him?"
msgstr "Je pourrais peut-être le raisonner ?"

# Traduction IA – à relire
#: chance_d20/Enchanter_part7a/0/g-0/c-2/7
msgctxt "Chance"
msgid "Are... are you sure about that?"
msgstr "Tu... tu es sûr{{|e|·e}} de toi ?"

# Traduction IA – à relire
#: chance_d20/Enchanter_part7a/0/g-0/c-2/15/0/s/0
msgctxt "Choix"
msgid "I throw the damn fireball!"
msgstr "Je lance cette foutue boule de feu !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part7a/0/g-0/c-2/15/1/s/0
msgctxt "Choix"
msgid "Eh... maybe not? Can I talk to him?"
msgstr "Euh... peut-être pas ? Je peux lui parler ?"

# Traduction IA – à relire
#: chance_d20/Enchanter_part7a/0/g-0/c-2/15/c-0/7
msgctxt "Chance"
msgid "Oookay! You throw a fireball at him."
msgstr "D'aaaccord ! Tu lui lances une boule de feu."

# Traduction IA – à relire
#: chance_d20/Enchanter_part7b/0/0
msgctxt "Chance"
msgid "You start to follow the steps set out by Melvil."
msgstr "Tu commences à suivre les étapes indiquées par Melvil."

# Traduction IA – à relire
#: chance_d20/Enchanter_part7b/0/8
msgctxt "Chance"
msgid "The first thing you do is..."
msgstr "La première chose que tu fais, c'est..."

# Traduction IA – à relire
#: chance_d20/Enchanter_part7b/0/16/b/4
msgctxt "Lux"
msgid "I saw this trending. It's uhhh circle of salt... or something?"
msgstr "J'ai vu ça en tendance. C'est, euh, un cercle de sel... un truc comme ça ?"

# Traduction IA – à relire
#: chance_d20/Enchanter_part7b/0/19/s/0
msgctxt "Choix"
msgid "Circle the area with salt."
msgstr "Tracer un cercle de sel autour de la zone."

# Traduction IA – à relire
#: chance_d20/Enchanter_part7b/0/20/s/0
msgctxt "Choix"
msgid "Circle the area with soil."
msgstr "Tracer un cercle de terre autour de la zone."

# Traduction IA – à relire
#: chance_d20/Enchanter_part7b/0/21/s/0
msgctxt "Choix"
msgid "Circle the area with leaves."
msgstr "Tracer un cercle de feuilles autour de la zone."

# Traduction IA – à relire
#: chance_d20/Enchanter_part7b/0/c-0/7
msgctxt "Chance"
msgid "You find salt inside your Sack and begin the circle."
msgstr "Tu trouves du sel dans ton Sac et tu commences le cercle."

# Traduction IA – à relire
#: chance_d20/Enchanter_part7b/0/c-1/7
msgctxt "Chance"
msgid "You grab a pile of soil in your hand and, staying tucked in the trees, complete your circle."
msgstr "Tu prends une poignée de terre et, en restant à couvert dans les arbres, tu complètes ton cercle."

# Traduction IA – à relire
#: chance_d20/Enchanter_part7b/0/c-2/7
msgctxt "Chance"
msgid "You start to pick up leaves, trying to get as close to the glade without being seen."
msgstr "Tu commences à ramasser des feuilles en essayant de t'approcher le plus possible de la clairière sans te faire voir."

# Traduction IA – à relire
#: chance_d20/Enchanter_part7b/0/g-0/0
msgctxt "Chance"
msgid "The next step was to start what kind of spell?"
msgstr "L'étape suivante, c'était de lancer quel genre de sort ?"

# Traduction IA – à relire
#: chance_d20/Enchanter_part7b/0/g-0/8/b/4
msgctxt "Lux"
msgid "Fire. It's Leo season and that's a fire sign."
msgstr "Feu. C'est la saison du Lion, et c'est un signe de feu."

# Traduction IA – à relire
#: chance_d20/Enchanter_part7b/0/g-0/11/s/0
msgctxt "Choix"
msgid "An ice spell!"
msgstr "Un sort de glace !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part7b/0/g-0/12/s/0
msgctxt "Choix"
msgid "A water spell!"
msgstr "Un sort d'eau !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part7b/0/g-0/13/s/0
msgctxt "Choix"
msgid "A fire spell!"
msgstr "Un sort de feu !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part7b/0/g-0/c-3/7
msgctxt "Chance"
msgid "The bitter cold pulses through your finger. You touch the dirt and hear it snap together."
msgstr "Un froid mordant palpite dans ton doigt. Tu touches la terre et tu l'entends se figer d'un coup sec."

# Traduction IA – à relire
#: chance_d20/Enchanter_part7b/0/g-0/c-4/7
msgctxt "Chance"
msgid "Water pours from your fingers, turning some of the dirt into mud. You try to pick up more dirt."
msgstr "De l'eau jaillit de tes doigts et transforme une partie de la terre en boue. Tu essaies de ramasser plus de terre."

# Traduction IA – à relire
#: chance_d20/Enchanter_part7b/0/g-0/c-5/7
msgctxt "Chance"
msgid "Flame erupts from your fingers. You touch the ground, but the dirt snuffs it out. This can't be right!"
msgstr "Des flammes jaillissent de tes doigts. Tu touches le sol, mais la terre les étouffe. Ça ne peut pas être ça !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part7b/0/g-1/0
msgctxt "Chance"
msgid "Now, the last step."
msgstr "Maintenant, la dernière étape."

# Traduction IA – à relire
#: chance_d20/Enchanter_part7b/0/g-1/8
msgctxt "Chance"
msgid "What did you need to recite?"
msgstr "Qu'est-ce que tu devais réciter ?"

# Traduction IA – à relire
#: chance_d20/Enchanter_part7b/0/g-1/16/b/4
msgctxt "Lux"
msgid "This is a weird hard magic system. I don't like it. Do you, chat?"
msgstr "Ce système de magie est bizarrement compliqué. J'aime pas. Et toi, le chat ?"

# Traduction IA – à relire
#: chance_d20/Enchanter_part7b/0/g-1/16/b/15
msgctxt "Chance"
msgid "There is no chat!!"
msgstr "Il n'y a pas de chat !!"

# Traduction IA – à relire
#: chance_d20/Enchanter_part7b/0/g-1/19/s/0
msgctxt "Choix"
msgid "The poem of protection."
msgstr "Le poème de protection."

# Traduction IA – à relire
#: chance_d20/Enchanter_part7b/0/g-1/20/s/0
msgctxt "Choix"
msgid "The elegy of energy."
msgstr "L'élégie de l'énergie."

# Traduction IA – à relire
#: chance_d20/Enchanter_part7b/0/g-1/21/s/0
msgctxt "Choix"
msgid "The haiku of holding."
msgstr "Le haïku de l'emprise."

# Traduction IA – à relire
#: chance_d20/Enchanter_part7b/0/g-1/c-6/7
msgctxt "Chance"
msgid "You think back to Incantation class, trying hard to remember the words."
msgstr "Tu repenses au cours d'Incantation, en t'efforçant de te rappeler les mots."

# Traduction IA – à relire
#: chance_d20/Enchanter_part7b/0/g-1/c-7/7
msgctxt "Chance"
msgid "Always one of your favorites, you quickly recite this poem."
msgstr "C'est l'un de tes préférés depuis toujours ; tu récites vite ce poème."

# Traduction IA – à relire
#: chance_d20/Enchanter_part7b/0/g-1/c-8/7
msgctxt "Chance"
msgid "It comes to you quickly. It's short and sweet."
msgstr "Il te revient vite. Court et efficace."

# Traduction IA – à relire
#: chance_d20/Enchanter_part7b/0/g-1/c-8/15
msgctxt "Chance"
msgid "You hear the spell complete and you see a dome of magical energy surround the djinn."
msgstr "Tu entends le sort s'achever et tu vois un dôme d'énergie magique entourer le djinn."

# Traduction IA – à relire
#: chance_d20/Enchanter_murderhobo/0
msgctxt "Chance"
msgid "The fireball bounces off of him. But, this time, the djinn isn't pleased with you."
msgstr "La boule de feu rebondit sur lui. Mais cette fois, le djinn n'apprécie pas du tout."

# Traduction IA – à relire
#: chance_d20/Enchanter_murderhobo/8
msgctxt "Chance"
msgid "\"Oh, you wanna see some magic? Here you go!\""
msgstr "« Oh, tu veux voir de la magie ? Tiens, en voilà ! »"

# Traduction IA – à relire
#: chance_d20/Enchanter_murderhobo/16/b/4
msgctxt "Lux"
msgid "Oh, this is full ick. My character is running away gracefully. Um, so, Good luck with the djinn!"
msgstr "Oh, ça, c'est ultra cringe. Mon personnage s'enfuit avec grâce. Euh, donc, bonne chance avec le djinn !"

# Traduction IA – à relire
#: chance_d20/Enchanter_murderhobo/19
msgctxt "Chance"
msgid "Tapping into the leyline that you saw him pulling power from —"
msgstr "Puisant dans la ligne tellurique dont tu l'as vu tirer son pouvoir..."

# Traduction IA – à relire
#: chance_d20/Enchanter_murderhobo/27
msgctxt "Chance"
msgid "A giant storm of arcane energy comes surging through the air at you. It hits you full on."
msgstr "Une gigantesque tempête d'énergie arcanique déferle sur toi. Elle te frappe de plein fouet."

# Traduction IA – à relire
#: chance_d20/Enchanter_murderhobo/35
msgctxt "Chance"
msgid "Your body can't take it since he is... tapped into the leyline you saw him draining."
msgstr "Ton corps ne peut pas encaisser ça, puisqu'il est... branché sur la ligne tellurique que tu l'as vu drainer."

# Traduction IA – à relire
#: chance_d20/Enchanter_murderhobo/43
msgctxt "Chance"
msgid "You are ripped apart in a spectacular show of magical sparks."
msgstr "Tu es {{déchiqueté|déchiquetée|déchiqueté·e}} dans un spectaculaire feu d'artifice d'étincelles magiques."

# Traduction IA – à relire
#: chance_d20/Enchanter_murderhobo/51
msgctxt "Chance"
msgid "And... you die."
msgstr "Et... tu meurs."

# Traduction IA – à relire
#: chance_d20/Talk_djinn/0/0/b/4
msgctxt "Lux"
msgid "Yeah, because we want to lose subscribers, right? Let's keep it boring."
msgstr "Ouais, parce qu'on veut perdre des abonnés, c'est ça ? Restons bien chiants."

# Traduction IA – à relire
#: chance_d20/Talk_djinn/0/3
msgctxt "Chance"
msgid "What do you wanna say to him?"
msgstr "Qu'est-ce que tu veux lui dire ?"

# Traduction IA – à relire
#: chance_d20/Talk_djinn/0/11/s/0
msgctxt "Choix"
msgid "Can we like... make a deal?"
msgstr "On pourrait, genre... passer un marché ?"

# Traduction IA – à relire
#: chance_d20/Talk_djinn/0/12/s/0
msgctxt "Choix"
msgid "Why can't I have my wish?"
msgstr "Pourquoi je peux pas avoir mon vœu ?"

# Traduction IA – à relire
#: chance_d20/Talk_djinn/0/g-0/0
msgctxt "Chance"
msgid "\"You really want that wish, don't you? Sheesh. Persistent.\""
msgstr "« Tu le veux vraiment, ce vœu, hein ? Oula. T'es tenace. »"

# Traduction IA – à relire
#: chance_d20/Talk_djinn/0/g-0/8
msgctxt "Chance"
msgid "\"Okay, I'll give you one wish and one wish only. Then, you chill.\""
msgstr "« Bon, je t'accorde un vœu, et un seul. Après, tu me lâches. »"

# Traduction IA – à relire
#: chance_d20/Talk_djinn/0/g-0/16/s/0
msgctxt "Choix"
msgid "You got it."
msgstr "Ça marche."

# Traduction IA – à relire
#: chance_d20/Talk_djinn/0/g-0/17/s/0
msgctxt "Choix"
msgid "I promise."
msgstr "Promis."

# Traduction IA – à relire
#: chance_d20/Enchanter_part8/0/0
msgctxt "Chance"
msgid "You hear rustling of leaves behind you."
msgstr "Tu entends des feuilles bruisser derrière toi."

# Traduction IA – à relire
#: chance_d20/Enchanter_part8/0/8
msgctxt "Chance"
msgid "Melvil quickly comes by your side."
msgstr "Melvil arrive vite à tes côtés."

# Traduction IA – à relire
#: chance_d20/Enchanter_part8/0/16/b/1
msgctxt "Chance"
msgid "\"You didn't think you could lie to me and me not know, did you? Next time, turn off the rock's tracking.\""
msgstr "« Tu ne pensais quand même pas pouvoir me mentir sans que je le sache ? La prochaine fois, désactive la localisation du caillou. »"

# Traduction IA – à relire
#: chance_d20/Enchanter_part8/0/19/b/4
msgctxt "Lux"
msgid "The ringing rock has tracking now? Ooo, that's good for location tags."
msgstr "Le caillou sonnant a la localisation, maintenant ? Oooh, c'est top pour géotaguer."

# Traduction IA – à relire
#: chance_d20/Enchanter_part8/0/19/b/12
msgctxt "Chance"
msgid "That's... not... the point... Can I continue now?"
msgstr "Ce n'est... pas... la question... Je peux continuer, maintenant ?"

# Traduction IA – à relire
#: chance_d20/Enchanter_part8/0/19/b/20
msgctxt "Lux"
msgid "Yas."
msgstr "Yas."

# Traduction IA – à relire
#: chance_d20/Enchanter_part8/0/22
msgctxt "Chance"
msgid "She gives you a smirk and a nod."
msgstr "Elle t'adresse un petit sourire en coin et un hochement de tête."

# Traduction IA – à relire
#: chance_d20/Enchanter_part8/0/30
msgctxt "Chance"
msgid "\"I see you tamed the thing.\""
msgstr "« Je vois que tu as dompté la bestiole. »"

# Traduction IA – à relire
#: chance_d20/Enchanter_part8/0/38
msgctxt "Chance"
msgid "The djinn puffs up. \"Psh. No one can tame me!\""
msgstr "Le djinn se rengorge. « Pff. Personne ne peut me dompter ! »"

# Traduction IA – à relire
#: chance_d20/Enchanter_part8/0/46
msgctxt "Chance"
msgid "Melvil gets a very serious look on her face. \"We'll see about that.\""
msgstr "Le visage de Melvil devient très sérieux. « C'est ce qu'on va voir. »"

# Traduction IA – à relire
#: chance_d20/Enchanter_part8/0/54
msgctxt "Chance"
msgid "Stepping toward the djinn, Melvil holds something in her hand. It's a LAMP!"
msgstr "En s'avançant vers le djinn, Melvil tient quelque chose à la main. C'est une LAMPE !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part8/0/62
msgctxt "Chance"
msgid "Not just any lamp. One covered in runes and etchings."
msgstr "Pas n'importe quelle lampe. Une lampe couverte de runes et de gravures."

# Traduction IA – à relire
#: chance_d20/Enchanter_part8/0/70
msgctxt "Chance"
msgid "\"You have a choice, dear djinn. Enter the lamp and be trapped for all eternity. Or join me.\""
msgstr "« Tu as le choix, cher djinn. Entrer dans la lampe et y être piégé pour l'éternité. Ou te joindre à moi. »"

# Traduction IA – à relire
#: chance_d20/Enchanter_part8/0/78/s/0
msgctxt "Choix"
msgid "Join you?"
msgstr "Te joindre ?"

# Traduction IA – à relire
#: chance_d20/Enchanter_part8/0/79/s/0
msgctxt "Choix"
msgid "What's going on?"
msgstr "Qu'est-ce qui se passe ?"

# Traduction IA – à relire
#: chance_d20/Enchanter_part8/0/g-0/0
msgctxt "Chance"
msgid "Melvil speaks to you without taking an eye off the djinn."
msgstr "Melvil te parle sans quitter le djinn des yeux."

# Traduction IA – à relire
#: chance_d20/Enchanter_part8/0/g-0/8
msgctxt "Chance"
msgid "\"With a djinn by my side, I would be the most powerful Enchanter there ever was! I shall have his power, one way or another!\""
msgstr "« Avec un djinn à mes côtés, je serais l'Enchanteresse la plus puissante de tous les temps ! J'aurai son pouvoir, d'une manière ou d'une autre ! »"

# Traduction IA – à relire
#: chance_d20/Enchanter_part8/0/g-0/19
msgctxt "Chance"
msgid "The lamp starts to glow and the djinn begins to be sucked into the lamp."
msgstr "La lampe se met à luire et le djinn commence à être aspiré à l'intérieur."

# Traduction IA – à relire
#: chance_d20/Enchanter_part8/0/g-0/27
msgctxt "Chance"
msgid "\"MAKE YOU CHOICE, DJINN\", she cackles. \"MAKE IT NOW!\""
msgstr "« FAIS TON CHOIX, DJINN », ricane-t-elle. « MAINTENANT ! »"

# Traduction IA – à relire
#: chance_d20/Enchanter_part8/0/g-0/35
msgctxt "Chance"
msgid "The djinn, with a panicked look on his face, shouts, \"I'll aid you! My power is yours!\""
msgstr "Le djinn, l'air paniqué, s'écrie : « Je t'aiderai ! Mon pouvoir est à toi ! »"

# Traduction IA – à relire
#: chance_d20/Enchanter_part8/0/g-0/43
msgctxt "Chance"
msgid "WOOOOSH! A flash of light overtakes you. You can't see, but you can hear energy most intense flying around."
msgstr "FOUUUSH ! Un éclair de lumière t'aveugle. Tu ne vois rien, mais tu entends une énergie d'une intensité folle tourbillonner autour de toi."

# Traduction IA – à relire
#: chance_d20/Enchanter_part8/0/g-0/57
msgctxt "Chance"
msgid "Before you floats Melvil. But, she is huge. The djinn has fused with her and she lets out an evil laugh!"
msgstr "Devant toi flotte Melvil. Mais elle est immense. Le djinn a fusionné avec elle, et elle pousse un rire maléfique !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part8/0/g-0/68
msgctxt "Chance"
msgid "Umm... before I go on, I should tell you. This is the part where I would like... monologue as Melvil."
msgstr "Euh... avant de continuer, je dois te dire. C'est le moment où j'aimerais, genre... faire un monologue en tant que Melvil."

# Traduction IA – à relire
#: chance_d20/Enchanter_part8/0/g-0/76
msgctxt "Chance"
msgid "Is it cool if I do that?"
msgstr "Ça te va si je le fais ?"

# Traduction IA – à relire
#: chance_d20/Enchanter_part8/0/g-0/84/b/4
msgctxt "Lux"
msgid "Yah totally. I'm gonna monologue, too."
msgstr "Ouais, carrément. Moi aussi, je vais faire un monologue."

# Traduction IA – à relire
#: chance_d20/Enchanter_part8/0/g-0/84/b/12
msgctxt "Chance"
msgid "Oh for heaven's sakes, Lux... Do it in another room, at least."
msgstr "Oh, pour l'amour du ciel, Lux... Fais-le dans une autre pièce, au moins."

# Traduction IA – à relire
#: chance_d20/Enchanter_part8/0/g-0/84/b/23
msgctxt "Lux"
msgid "Ugh. Fine."
msgstr "Pff. D'accord."

# Traduction IA – à relire
#: chance_d20/Enchanter_part8/0/g-0/87/s/0
msgctxt "Choix"
msgid "Oh, no doubt! Monologue away!"
msgstr "Oh, sans hésiter ! Vas-y, monologue !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part8/0/g-0/88/s/0
msgctxt "Choix"
msgid "If you're excited about it, so am I! I say do it!"
msgstr "Si ça t'enthousiasme, moi aussi ! Je dis vas-y !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part8/0/g-0/89/s/0
msgctxt "Choix"
msgid "I mean... if we could skip it...?"
msgstr "Enfin... si on pouvait le passer... ?"

# Traduction IA – à relire
#: chance_d20/Enchanter_part8/0/g-0/c-2/13
msgctxt "Chance"
msgid "Thanks!"
msgstr "Merci !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part8/0/g-0/c-3/7
msgctxt "Chance"
msgid "Awesome! You're the best!"
msgstr "Génial ! T'es le meilleur !"

# Traduction IA – à relire
#: chance_d20/Enchanter_part8/0/g-0/c-4/13
msgctxt "Chance"
msgid "Oh... yeah. Totally. It's like... no big deal. I'll just throw this page away..."
msgstr "Oh... ouais. Carrément. C'est genre... pas grave. Je vais juste jeter cette page..."

# Traduction IA – à relire
#: chance_d20/Enchanter_part8/0/g-0/c-4/21
msgctxt "Chance"
msgid "Straight to the fight then!"
msgstr "Directement au combat, alors !"

# Traduction IA – à relire
#: chance_d20/Enchanter_monologue/0
msgctxt "Chance"
msgid "Melvil lowers down onto the leyline, seeming to sniff the air that radiates with power."
msgstr "Melvil descend sur la ligne tellurique et semble humer l'air chargé de pouvoir."

# Traduction IA – à relire
#: chance_d20/Enchanter_monologue/8
msgctxt "Chance"
msgid "\"I know you can sense it. The power this place holds. These grounds hold a wealth of energy.\""
msgstr "« Je sais que tu le sens. Le pouvoir que recèle cet endroit. Ce domaine regorge d'énergie. »"

# Traduction IA – à relire
#: chance_d20/Enchanter_monologue/16
msgctxt "Chance"
msgid "\"Energy that could have us Enchanters rule the entire world. Mold it into our image.\""
msgstr "« Une énergie qui pourrait permettre à nous, Enchanteurs, de régner sur le monde entier. De le façonner à notre image. »"

# Traduction IA – à relire
#: chance_d20/Enchanter_monologue/24
msgctxt "Chance"
msgid "\"Could you imagine if every place was as ideal as Bookshelf Bluff? A place where learning was the only goal?\""
msgstr "« Imagine si chaque endroit était aussi idéal que la Falaise de l'Étagère ? Un lieu où apprendre serait le seul but ? »"

# Traduction IA – à relire
#: chance_d20/Enchanter_monologue/32
msgctxt "Chance"
msgid "\"It would be glorious, wouldn't it? If only we could make that happen. Ooops! We can!\""
msgstr "« Ce serait glorieux, non ? Si seulement on pouvait y arriver. Oups ! On le peut ! »"

# Traduction IA – à relire
#: chance_d20/Enchanter_monologue/43
msgctxt "Chance"
msgid "\"The thing is, we've ALWAYS been able to. But, the idiots of The Spine want to make sure we use our magic for good.\""
msgstr "« Le truc, c'est qu'on l'a TOUJOURS pu. Mais les idiots de la Reliure veulent s'assurer qu'on utilise notre magie pour le bien. »"

# Traduction IA – à relire
#: chance_d20/Enchanter_monologue/51
msgctxt "Chance"
msgid "\"What good?! The world is full of evil all around us! From the Shoelace Shores to Cantalopia, evil is everywhere.\""
msgstr "« Quel bien ?! Le monde est rempli de mal, partout autour de nous ! Des Rivages-Lacets à Cantalopia, le mal est partout. »"

# Traduction IA – à relire
#: chance_d20/Enchanter_monologue/59
msgctxt "Chance"
msgid "\"But we can make it ideal. I can now make it ideal! What I will do will not be found in books. It will not be found in scrolls.\""
msgstr "« Mais nous pouvons le rendre idéal. Je peux désormais le rendre idéal ! Ce que je vais accomplir, on ne le trouvera pas dans les livres. On ne le trouvera pas dans les parchemins. »"

# Traduction IA – à relire
#: chance_d20/Enchanter_monologue/67
msgctxt "Chance"
msgid "\"The world will learn the peace we have found here. And I will force them to. There is only one problem to clean up first.\""
msgstr "« Le monde apprendra la paix que nous avons trouvée ici. Et je l'y forcerai. Il n'y a qu'un seul problème à régler d'abord. »"

# Traduction IA – à relire
#: chance_d20/Enchanter_monologue/75
msgctxt "Chance"
msgid "\"You. You know my plan and you could stop me. I can't have that, now can I? What a pity. It seems I must finish you now!\""
msgstr "« Toi. Tu connais mon plan et tu pourrais m'arrêter. Je ne peux pas laisser faire ça, n'est-ce pas ? Quel dommage. Il semble que je doive t'achever maintenant ! »"

# Traduction IA – à relire
#: chance_d20/Enchanter_monologue/83
msgctxt "Chance"
msgid "Melvil begins to float again. \"Sling your spells if you want. At least you will die knowing you tried to stop me.\""
msgstr "Melvil se remet à flotter. « Lance tes sorts, si tu veux. Au moins, tu mourras en sachant que tu as essayé de m'arrêter. »"

# Traduction IA – à relire
#: chance_d20/Enchanter_final_fight/0/0
msgctxt "Chance"
msgid "Melvil flies at you, a spell spinning in the palm of her hand. Only, she hasn't quite got used to her new body and powers. The spell goes wild and crashes into a tree. The tree bursts apart, giant splinters flying everywhere."
msgstr "Melvil fond sur toi, un sort tournoyant dans sa paume. Sauf qu'elle ne s'est pas encore tout à fait habituée à son nouveau corps et à ses nouveaux pouvoirs. Le sort part de travers et s'écrase contre un arbre. L'arbre vole en éclats, projetant des échardes géantes partout."

# Traduction IA – à relire
#: chance_d20/Enchanter_final_fight/0/8
msgctxt "Chance"
msgid "One hits Melvil directly in the arm. She rears back, a pained wince on her face as she pulls out the large piece of wood."
msgstr "L'une d'elles atteint Melvil en plein bras. Elle recule, grimaçant de douleur en arrachant le gros morceau de bois."

# Traduction IA – à relire
#: chance_d20/Enchanter_final_fight/0/16
msgctxt "Chance"
msgid "This gives you time to react! You are panicked and aren't sure what to do."
msgstr "Ça te laisse le temps de réagir ! Tu paniques et tu ne sais pas trop quoi faire."

# Traduction IA – à relire
#: chance_d20/Enchanter_final_fight/0/24/s/0
msgctxt "Choix"
msgid "Shoot her with some magic!"
msgstr "Je lui balance de la magie !"

# Traduction IA – à relire
#: chance_d20/Enchanter_final_fight/0/25/s/0
msgctxt "Choix"
msgid "Where the hell is that lamp she brought?"
msgstr "Où est passée cette fichue lampe qu'elle a apportée ?"

# Traduction IA – à relire
#: chance_d20/Enchanter_final_fight/0/26/s/0
msgctxt "Choix"
msgid "Screw this! I gotta run!"
msgstr "Au diable tout ça ! Faut que je me tire !"

# Traduction IA – à relire
#: chance_d20/Magic_attack/0/0
msgctxt "Chance"
msgid "You summon a fire spell, slinging it across the glen toward Melvil. It is like her skin absorbs it."
msgstr "Tu invoques un sort de feu et le lances à travers la clairière sur Melvil. C'est comme si sa peau l'absorbait."

# Traduction IA – à relire
#: chance_d20/Magic_attack/0/8
msgctxt "Chance"
msgid "You get off a lightning and water spell, too. Nothing."
msgstr "Tu enchaînes aussi un sort de foudre et un sort d'eau. Rien."

# Traduction IA – à relire
#: chance_d20/Magic_attack/0/16/b/4
msgctxt "Lux"
msgid "I have a potion in my inventory. I bet it is acid. I throw it at her."
msgstr "J'ai une potion dans mon inventaire. Je parie que c'est de l'acide. Je la lui lance."

# Traduction IA – à relire
#: chance_d20/Magic_attack/0/16/b/12
msgctxt "Chance"
msgid "IF you had READ the sheet, you would know you just threw her your only health potion."
msgstr "SI tu avais LU la feuille, tu saurais que tu viens de lui lancer ta seule potion de soin."

# Traduction IA – à relire
#: chance_d20/Magic_attack/0/16/b/20
msgctxt "Lux"
msgid "Oh... so I made her stronger?"
msgstr "Oh... donc je l'ai rendue plus forte ?"

# Traduction IA – à relire
#: chance_d20/Magic_attack/0/16/b/28
msgctxt "Chance"
msgid "You made her stronger, yes."
msgstr "Tu l'as rendue plus forte, oui."

# Traduction IA – à relire
#: chance_d20/Magic_attack/0/19
msgctxt "Chance"
msgid "\"Mwahahaha. Someone forgot what they've learned.\""
msgstr "« Mwahahaha. Quelqu'un a oublié ses leçons. »"

# Traduction IA – à relire
#: chance_d20/Magic_attack/0/27
msgctxt "Chance"
msgid "Melvil fires off a spell of pure force at you."
msgstr "Melvil te lance un sort de force pure."

# Traduction IA – à relire
#: chance_d20/Magic_attack/0/35
msgctxt "Chance"
msgid "It hits you hard in the stomach for..."
msgstr "Il te frappe violemment au ventre pour..."

# Traduction IA – à relire
#: chance_d20/Magic_attack/0/46
msgctxt "Chance"
msgid "15 damage."
msgstr "15 points de dégâts."

# Traduction IA – à relire
#: chance_d20/Magic_attack/0/54/b/4
msgctxt "Lux"
msgid "Wish I could help!"
msgstr "J'aimerais tellement pouvoir aider !"

# Traduction IA – à relire
#: chance_d20/Magic_attack/0/69/b/4 chance_d20/Read_runes/0/119/b/4
msgctxt "Chance"
msgid "Melvil's power proves too much for you. You fall over. You stop breathing. The forest is your final resting place."
msgstr "Le pouvoir de Melvil est trop fort pour toi. Tu t'effondres. Tu cesses de respirer. La forêt sera ta dernière demeure."

# Traduction IA – à relire
#: chance_d20/Magic_attack/0/72
msgctxt "Chance"
msgid "Nothing seems to work! What do you do now?"
msgstr "Rien ne semble marcher ! Que fais-tu, maintenant ?"

# Traduction IA – à relire
#: chance_d20/Magic_attack/0/80/b/4
msgctxt "Lux"
msgid "Give Melvil the 15% discount on the Lux Ultra-lite Airplane Pillow."
msgstr "Offrir à Melvil 15 % de réduction sur l'Oreiller de Voyage Ultra-light Lux."

# Traduction IA – à relire
#: chance_d20/Magic_attack/0/83/s/0
msgctxt "Choix"
msgid "Let me see that lamp!"
msgstr "Montre-moi cette lampe !"

# Traduction IA – à relire
#: chance_d20/Magic_attack/0/84/s/0
msgctxt "Choix"
msgid "I'm gettin' out while I can!"
msgstr "Je me tire tant que je peux !"

# Traduction IA – à relire
#: chance_d20/Lamp_attack/0/0
msgctxt "Chance"
msgid "You sprint for the lamp Melvil left on the ground."
msgstr "Tu fonces vers la lampe que Melvil a laissée par terre."

# Traduction IA – à relire
#: chance_d20/Lamp_attack/0/8
msgctxt "Chance"
msgid "Upon touching it, you see it is covered in runes. A quick scan shows you they are runes of capturing."
msgstr "En la touchant, tu vois qu'elle est couverte de runes. Un rapide coup d'œil t'indique que ce sont des runes de capture."

# Traduction IA – à relire
#: chance_d20/Lamp_attack/0/16
msgctxt "Chance"
msgid "\"Put that down, Dewey. You don't know what you are doing with that!\""
msgstr "« Pose ça, Dewey. Tu ne sais pas ce que tu fais avec ça ! »"

# Traduction IA – à relire
#: chance_d20/Lamp_attack/0/24
msgctxt "Chance"
msgid "Melvil is scared of this thing. What do you do?"
msgstr "Melvil a peur de cet objet. Que fais-tu ?"

# Traduction IA – à relire
#: chance_d20/Lamp_attack/0/32/s/0
msgctxt "Choix"
msgid "I throw it at her."
msgstr "Je la lui lance."

# Traduction IA – à relire
#: chance_d20/Lamp_attack/0/33/s/0
msgctxt "Choix"
msgid "I start reading the runes out loud."
msgstr "Je commence à lire les runes à voix haute."

# Traduction IA – à relire
#: chance_d20/Throw_lamp/0/0
msgctxt "Chance"
msgid "You hurl the lamp at her. As a reflex, she goes to catch it, but it burns right through her hand."
msgstr "Tu lui lances la lampe. Par réflexe, elle essaie de l'attraper, mais la lampe lui brûle la main de part en part."

# Traduction IA – à relire
#: chance_d20/Throw_lamp/0/8
msgctxt "Chance"
msgid "That's it! Metal! You remember djinns are weak to metal!"
msgstr "C'est ça ! Le métal ! Tu te rappelles que les djinns craignent le métal !"

# Traduction IA – à relire
#: chance_d20/Throw_lamp/0/16/b/4
msgctxt "Lux"
msgid "My arrows are metal!"
msgstr "Mes flèches sont en métal !"

# Traduction IA – à relire
#: chance_d20/Throw_lamp/0/16/b/12
msgctxt "Chance"
msgid "Nope. Wood. I've just decided."
msgstr "Non. En bois. Je viens de le décider."

# Traduction IA – à relire
#: chance_d20/Throw_lamp/0/16/b/20
msgctxt "Lux"
msgid "If I didn't know better, I'd say you don't like me playing with you."
msgstr "Si je te connaissais pas, je dirais que t'aimes pas jouer avec moi."

# Traduction IA – à relire
#: chance_d20/Throw_lamp/0/16/b/28
msgctxt "Chance"
msgid "Too bad you don't know any better."
msgstr "Dommage que tu me connaisses si mal."

# Traduction IA – à relire
#: chance_d20/Throw_lamp/0/19/s/0
msgctxt "Choix"
msgid "I could use the Tools!"
msgstr "Je pourrais utiliser les Outils !"

# Traduction IA – à relire
#: chance_d20/Throw_lamp/0/20/s/0
msgctxt "Choix"
msgid "Metal? I know where there is metal!"
msgstr "Du métal ? Je sais où il y a du métal !"

# Traduction IA – à relire
#: chance_d20/Throw_lamp/0/g-0/0
msgctxt "Chance"
msgid "The Tools! They might be what you can use to stop Melvil!"
msgstr "Les Outils ! Ils pourraient être la clé pour arrêter Melvil !"

# Traduction IA – à relire
#: chance_d20/Throw_lamp/0/g-0/8
msgctxt "Chance"
msgid "While Melvil screams in agony, you take off."
msgstr "Pendant que Melvil hurle de douleur, tu détales."

# Traduction IA – à relire
#: chance_d20/Read_runes/0/0
msgctxt "Chance"
msgid "You are instantly glad you paid attention in Runes class."
msgstr "Tu te félicites aussitôt d'avoir été attentif{{|ve|·ve}} en cours de Runes."

# Traduction IA – à relire
#: chance_d20/Read_runes/0/8
msgctxt "Chance"
msgid "The words come flowing from your mouth like water. And with each word, Melvil gets pulled closer and closer to the lamp."
msgstr "Les mots coulent de ta bouche comme de l'eau. Et à chaque mot, Melvil est attirée un peu plus près de la lampe."

# Traduction IA – à relire
#: chance_d20/Read_runes/0/16
msgctxt "Chance"
msgid "\"Stop! You don't have to do this! I... I won't kill you right now!\""
msgstr "« Arrête ! Tu n'es pas obligé{{|e|·e}} de faire ça ! Je... je ne te tuerai pas tout de suite ! »"

# Traduction IA – à relire
#: chance_d20/Read_runes/0/24
msgctxt "Chance"
msgid "It is obvious she has never known humility."
msgstr "De toute évidence, elle n'a jamais connu l'humilité."

# Traduction IA – à relire
#: chance_d20/Read_runes/0/32
msgctxt "Chance"
msgid "As she gets pulled in toward the lamp, you hear a voice next to you."
msgstr "Tandis qu'elle est aspirée vers la lampe, tu entends une voix à côté de toi."

# Traduction IA – à relire
#: chance_d20/Read_runes/0/40
msgctxt "Chance"
msgid "\"Well, ain't that somethin'.\""
msgstr "« Eh ben, ça alors. »"

# Traduction IA – à relire
#: chance_d20/Read_runes/0/48
msgctxt "Chance"
msgid "You look away from Melvil for a moment and you see Moys and the Tools appear beside you."
msgstr "Tu détournes un instant les yeux de Melvil et tu vois Moys et les Outils apparaître à tes côtés."

# Traduction IA – à relire
#: chance_d20/Read_runes/0/56
msgctxt "Chance"
msgid "Trowel groans. \"Ya destroyin' all the works we done did!\""
msgstr "La Truelle grogne. « Tu démolis tout le boulot qu'on a fait ! »"

# Traduction IA – à relire
#: chance_d20/Read_runes/0/64
msgctxt "Chance"
msgid "This distraction, though momentary, makes you slip on the pronunciation of the rune \"slifumplach\"."
msgstr "Cette distraction, aussi brève soit-elle, te fait trébucher sur la prononciation de la rune « slifumplach »."

# Traduction IA – à relire
#: chance_d20/Read_runes/0/72
msgctxt "Chance"
msgid "That's a hard one anyway."
msgstr "Elle est difficile, de toute façon."

# Traduction IA – à relire
#: chance_d20/Read_runes/0/80
msgctxt "Chance"
msgid "Melvil uses this opening to fling a spell at you."
msgstr "Melvil profite de cette ouverture pour te lancer un sort."

# Traduction IA – à relire
#: chance_d20/Read_runes/0/88
msgctxt "Chance"
msgid "It makes contact, hitting you for..."
msgstr "Il te touche et t'inflige..."

# Traduction IA – à relire
#: chance_d20/Read_runes/0/96
msgctxt "Chance"
msgid "15 health."
msgstr "15 points de dégâts."

# Traduction IA – à relire
#: chance_d20/Read_runes/0/104/b/4
msgctxt "Lux"
msgid "I hide behind a tree and film the encounter, commenting as a do."
msgstr "Je me cache derrière un arbre et je filme la scène en la commentant."

# Traduction IA – à relire
#: chance_d20/Read_runes/0/122
msgctxt "Chance"
msgid "As you are hit, the lamp flies out of your hand and Melvil goes to catch it."
msgstr "Sous le choc, la lampe t'échappe des mains et Melvil essaie de l'attraper."

# Traduction IA – à relire
#: chance_d20/Read_runes/0/130
msgctxt "Chance"
msgid "Only, it burns through her hand."
msgstr "Sauf que la lampe lui brûle la main de part en part."

# Traduction IA – à relire
#: chance_d20/Read_runes/0/138/s/0
msgctxt "Choix"
msgid "Ah ha! Djinns are weak to metal!"
msgstr "Ah ah ! Les djinns craignent le métal !"

# Traduction IA – à relire
#: chance_d20/Read_runes/0/g-0/0
msgctxt "Chance"
msgid "The memory of the tome comes back to you. Good thing you have metal Tools right next to you."
msgstr "Le souvenir du grimoire te revient. Heureusement que tu as des Outils en métal juste à côté de toi."

# Traduction IA – à relire
#: chance_d20/Read_runes/0/g-0/8/s/0
msgctxt "Choix"
msgid "Come here Trowel!"
msgstr "Viens là, Truelle !"

# Traduction IA – à relire
#: chance_d20/Read_runes/0/g-0/9/s/0
msgctxt "Choix"
msgid "Lend me your steel, you Tools!"
msgstr "Prêtez-moi votre acier, les Outils !"

# Traduction IA – à relire
#: chance_d20/Read_runes/0/g-1/0
msgctxt "Chance"
msgid "\"Eh, I don't know about all that,\" Trowel protests."
msgstr "« Euh, je suis pas trop sûr de tout ça », proteste la Truelle."

# Traduction IA – à relire
#: chance_d20/Read_runes/0/g-1/8
msgctxt "Chance"
msgid "Moys picks him up and hands him to you."
msgstr "Moys le ramasse et te le tend."

# Traduction IA – à relire
#: chance_d20/Read_runes/0/g-1/16
msgctxt "Chance"
msgid "\"Here ya go. He's mouthy but does good work.\""
msgstr "« Tiens. Il a une grande gueule, mais il fait du bon boulot. »"

# Traduction IA – à relire
#: chance_d20/Read_runes/0/g-1/24 chance_d20/Tool_ask/0/g-2/0 chance_d20/Tool_take/0/g-2/0
msgctxt "Chance"
msgid "You lift the Trowel like a magical focus."
msgstr "Tu brandis la Truelle comme un focaliseur magique."

# Traduction IA – à relire
#: chance_d20/Read_runes/0/g-1/32 chance_d20/Tool_ask/0/g-2/8 chance_d20/Tool_take/0/g-2/8
msgctxt "Chance"
msgid "A greyish-silver orb of pure metal collects at the tip of the Trowel."
msgstr "Un orbe gris argenté de métal pur se forme au bout de la Truelle."

# Traduction IA – à relire
#: chance_d20/Read_runes/0/g-1/40
msgctxt "Chance"
msgid "\"This is kinda AWESOME!\" Trowel yells."
msgstr "« C'est trop GÉNIAL, ce truc ! », hurle la Truelle."

# Traduction IA – à relire
#: chance_d20/Read_runes/0/g-1/48 chance_d20/Tool_ask/0/g-2/24 chance_d20/Tool_take/0/g-2/24
msgctxt "Chance"
msgid "And you unleash it toward Melvil. It rips through her, leaving behind a ring of smoke where it made contact."
msgstr "Et tu le déchaînes sur Melvil. Il la transperce, laissant un anneau de fumée là où il l'a touchée."

# Traduction IA – à relire
#: chance_d20/Read_runes/0/g-1/56 chance_d20/Tool_ask/0/g-2/32 chance_d20/Tool_take/0/g-2/32
msgctxt "Chance"
msgid "You've never done metal magic before, so you aren't sure how to summon it quickly."
msgstr "Tu n'as jamais pratiqué la magie du métal, alors tu ne sais pas trop comment l'invoquer rapidement."

# Traduction IA – à relire
#: chance_d20/Read_runes/0/g-1/64 chance_d20/Tool_ask/0/g-2/40 chance_d20/Tool_take/0/g-2/40
msgctxt "Chance"
msgid "This leaves enough room for Melvil to counter attack."
msgstr "Ça laisse assez de marge à Melvil pour contre-attaquer."

# Traduction IA – à relire
#: chance_d20/Read_runes/0/g-1/72 chance_d20/Tool_ask/0/g-2/48 chance_d20/Tool_take/0/g-2/48
msgctxt "Chance"
msgid "With a flash of blue energy, she hits you with an arcane lance."
msgstr "Dans un éclair d'énergie bleue, elle te frappe d'une lance arcanique."

# Traduction IA – à relire
#: chance_d20/Read_runes/0/g-1/83 chance_d20/Tool_ask/0/g-2/59 chance_d20/Tool_take/0/g-2/59
msgctxt "Chance"
msgid "She is still reeling from your hit so it only hits fooooor....."
msgstr "Elle est encore sonnée par ton coup, donc ça ne t'infliiiige que..."

# Traduction IA – à relire
#: chance_d20/Read_runes/0/g-1/111/b/4 chance_d20/Tool_ask/0/g-2/90/b/4 chance_d20/Tool_take/0/g-2/81/b/4
msgctxt "Chance"
msgid "Even in her hurt state, her power proves too much for you. You fall over. You stop breathing. The forest is your final resting place."
msgstr "Même blessée, son pouvoir est trop fort pour toi. Tu t'effondres. Tu cesses de respirer. La forêt sera ta dernière demeure."

# Traduction IA – à relire
#: chance_d20/Read_runes/0/g-1/114 chance_d20/Tool_ask/0/g-2/93 chance_d20/Tool_take/0/g-2/84
msgctxt "Chance"
msgid "You stagger back, pushing through the pain."
msgstr "Tu recules en titubant et tu surmontes la douleur."

# Traduction IA – à relire
#: chance_d20/Read_runes/0/g-1/122 chance_d20/Tool_ask/0/g-2/101 chance_d20/Tool_take/0/g-2/92
msgctxt "Chance"
msgid "You lift your eyes toward Melvil and you see the other Tools rushing her!"
msgstr "Tu lèves les yeux vers Melvil et tu vois les autres Outils se ruer sur elle !"

# Traduction IA – à relire
#: chance_d20/Read_runes/0/g-1/130/b/4
msgctxt "Chance"
msgid "Lux, are you going to help?"
msgstr "Lux, tu vas aider ?"

# Traduction IA – à relire
#: chance_d20/Read_runes/0/g-1/130/b/12
msgctxt "Lux"
msgid "Someone has to live to upload the tale! I'll be back here."
msgstr "Il faut bien que quelqu'un survive pour mettre l'histoire en ligne ! Je reste derrière."

# Traduction IA – à relire
#: chance_d20/Read_runes/0/g-1/133 chance_d20/Tool_ask/0/g-2/109 chance_d20/Tool_take/0/g-2/100
msgctxt "Chance"
msgid "They get a few swipes in before Melvil starts to grab them by the handle and snap them in half."
msgstr "Ils parviennent à placer quelques coups avant que Melvil se mette à les attraper par le manche et à les briser en deux."

# Traduction IA – à relire
#: chance_d20/Read_runes/0/g-1/141 chance_d20/Tool_ask/0/g-2/117 chance_d20/Tool_take/0/g-2/108
msgctxt "Chance"
msgid "In that moment, as if by magic, Moys appears."
msgstr "À cet instant, comme par magie, Moys apparaît."

# Traduction IA – à relire
#: chance_d20/Read_runes/0/g-1/149 chance_d20/Tool_ask/0/g-2/125 chance_d20/Tool_take/0/g-2/116
msgctxt "Chance"
msgid "\"Oh. This doesn't look very good.\""
msgstr "« Oh. Ça n'a pas l'air d'aller très fort. »"

# Traduction IA – à relire
#: chance_d20/Read_runes/0/g-1/157 chance_d20/Tool_ask/0/g-2/133 chance_d20/Tool_take/0/g-2/124
msgctxt "Chance"
msgid "Moys lifts a hand and vines fly out of the ground to wrap around Melvil."
msgstr "Moys lève une main, et des lianes jaillissent du sol pour s'enrouler autour de Melvil."

# Traduction IA – à relire
#: chance_d20/Read_runes/0/g-1/165
msgctxt "Chance"
msgid "It looks like it is holding... until... -"
msgstr "On dirait que ça tient... jusqu'à ce que..."

# Traduction IA – à relire
#: chance_d20/Read_runes/0/g-1/173 chance_d20/Tool_ask/0/g-2/149 chance_d20/Tool_take/0/g-2/140
msgctxt "Chance"
msgid "KA-PLOW! The vines are thrown off and burst into flames as they hit the ground."
msgstr "KA-BOUM ! Les lianes sont arrachées et s'embrasent en touchant le sol."

# Traduction IA – à relire
#: chance_d20/Read_runes/0/g-1/184 chance_d20/Tool_ask/0/g-2/160 chance_d20/Tool_take/0/g-2/151
msgctxt "Chance"
msgid "\"Now, I have to kill you, too! DIE MOYS!\""
msgstr "« Maintenant, je dois te tuer, toi aussi ! MEURS, MOYS ! »"

# Traduction IA – à relire
#: chance_d20/Read_runes/0/g-1/192 chance_d20/Tool_ask/0/g-2/168 chance_d20/Tool_take/0/g-2/159
msgctxt "Chance"
msgid "Melvil charges up an energy attack."
msgstr "Melvil charge une attaque d'énergie."

# Traduction IA – à relire
#: chance_d20/Read_runes/0/g-1/200 chance_d20/Tool_ask/0/g-2/176 chance_d20/Tool_take/0/g-2/167
msgctxt "Chance"
msgid "You have a moment to react before it flies!"
msgstr "Tu as un instant pour réagir avant qu'elle parte !"

# Traduction IA – à relire
#: chance_d20/Read_runes/0/g-1/208 chance_d20/Tool_ask/0/g-2/184 chance_d20/Tool_take/0/g-2/175
msgctxt "Chance"
msgid "You have enough spell notches to do your ultimate attack! Or maybe a higher level metal spell?"
msgstr "Tu as assez d'emplacements de sorts pour ton attaque ultime ! Ou peut-être un sort de métal de plus haut niveau ?"

# Traduction IA – à relire
#: chance_d20/Read_runes/0/g-1/216 chance_d20/Tool_ask/0/g-2/192 chance_d20/Tool_take/0/g-2/183
msgctxt "Chance"
msgid "Or there might be something else you want to do."
msgstr "Ou alors, tu veux peut-être faire autre chose."

# Traduction IA – à relire
#: chance_d20/Read_runes/0/g-1/224/s/0 chance_d20/Tool_ask/0/g-2/200/s/0 chance_d20/Tool_take/0/g-2/191/s/0
msgctxt "Choix"
msgid "Ultimate Attack? Bring. It. On."
msgstr "Attaque ultime ? Qu'on. Y. Aille."

# Traduction IA – à relire
#: chance_d20/Read_runes/0/g-1/225/s/0 chance_d20/Tool_ask/0/g-2/201/s/0 chance_d20/Tool_take/0/g-2/192/s/0
msgctxt "Choix"
msgid "SO much metal I spike my hair, please!"
msgstr "TELLEMENT de métal que je me fais une crête, s'il te plaît !"

# Traduction IA – à relire
#: chance_d20/Read_runes/0/g-1/226/s/0 chance_d20/Tool_ask/0/g-2/202/s/0 chance_d20/Tool_take/0/g-2/193/s/0
msgctxt "Choix"
msgid "I gotta save Moys. I take the hit."
msgstr "Je dois sauver Moys. J'encaisse le coup."

# Traduction IA – à relire
#: chance_d20/Run_away/0/0
msgctxt "Chance"
msgid "You use this time to run through the woods as quickly as you can."
msgstr "Tu profites de ce moment pour traverser les bois le plus vite possible."

# Traduction IA – à relire
#: chance_d20/Run_away/0/8/b/4
msgctxt "Lux"
msgid "But, I'm running faster than you. And more gracefully. And seductively. And inspiringly."
msgstr "Mais je cours plus vite que toi. Et avec plus de grâce. Et de séduction. Et d'inspiration."

# Traduction IA – à relire
#: chance_d20/Run_away/0/11
msgctxt "Chance"
msgid "Melvil fusing with the djinn doubled the size of the entity, and while it can fly, the thick trees prove difficult for it to navigate."
msgstr "En fusionnant avec le djinn, Melvil a doublé de taille, et même si elle peut voler, les arbres serrés la gênent pour avancer."

# Traduction IA – à relire
#: chance_d20/Run_away/0/19
msgctxt "Chance"
msgid "As you sprint back the way you came, you come across the Tools. They are resting in a clearing."
msgstr "En rebroussant chemin au pas de course, tu tombes sur les Outils. Ils se reposent dans une clairière."

# Traduction IA – à relire
#: chance_d20/Run_away/0/27
msgctxt "Chance"
msgid "And then, it hits you. The book said something about... metal? Yeah, it certainly did."
msgstr "Et soudain, ça te revient. Le livre parlait de... métal ? Oui, absolument."

# Traduction IA – à relire
#: chance_d20/Run_away/0/35
msgctxt "Chance"
msgid "If you can get your hands on one of the tools, you might be able to defeat Melvil!"
msgstr "Si tu mets la main sur l'un des outils, tu pourrais peut-être vaincre Melvil !"

# Traduction IA – à relire
#: chance_d20/Run_away/0/51/b/4
msgctxt "Lux"
msgid "You take one of the tools, obvi. They don't get a choice. And you press the heart icon next to where it says Lux."
msgstr "Tu prends un des outils, obvi. Ils ont pas le choix. Et tu appuies sur le cœur à côté de mon nom."

# Traduction IA – à relire
#: chance_d20/Run_away/0/54/s/0
msgctxt "Choix"
msgid "Ask for help!"
msgstr "Demander de l'aide !"

# Traduction IA – à relire
#: chance_d20/Run_away/0/55/s/0
msgctxt "Choix"
msgid "Call one to me with magic!"
msgstr "En appeler un à moi par magie !"

# Traduction IA – à relire
#: chance_d20/Tool_ask/0/0
msgctxt "Chance"
msgid "You run out toward the Tools."
msgstr "Tu cours vers les Outils."

# Traduction IA – à relire
#: chance_d20/Tool_ask/0/8
msgctxt "Chance"
msgid "What do you say?"
msgstr "Que dis-tu ?"

# Traduction IA – à relire
#: chance_d20/Tool_ask/0/16/s/0
msgctxt "Choix"
msgid "I need your help. Right now!"
msgstr "J'ai besoin de votre aide. Tout de suite !"

# Traduction IA – à relire
#: chance_d20/Tool_ask/0/17/s/0
msgctxt "Choix"
msgid "Come with me if you want to live!"
msgstr "Suivez-moi si vous voulez vivre !"

# Traduction IA – à relire
#: chance_d20/Tool_ask/0/18/s/0
msgctxt "Choix"
msgid "DJINN GONE CRAZY! NEED YOU FOR DJINN MURDER!"
msgstr "DJINN DEVENU FOU ! BESOIN DE VOUS POUR MEURTRE DE DJINN !"

# Traduction IA – à relire
#: chance_d20/Tool_ask/0/g-0/0
msgctxt "Chance"
msgid "The Trowel looks at you, unimpressed."
msgstr "La Truelle te regarde, pas impressionnée pour un sou."

# Traduction IA – à relire
#: chance_d20/Tool_ask/0/g-0/8
msgctxt "Chance"
msgid "\"If you ain't about payin' us, then there's nothin' doin'.\""
msgstr "« Si t'as pas l'intention de nous payer, y a rien à faire. »"

# Traduction IA – à relire
#: chance_d20/Tool_ask/0/g-0/16 chance_d20/Tool_take/0/g-0/0
msgctxt "Chance"
msgid "The rumble of Melvil pushing trees aside to find you is heard."
msgstr "On entend le grondement de Melvil qui écarte les arbres pour te trouver."

# Traduction IA – à relire
#: chance_d20/Tool_ask/0/g-0/24 chance_d20/Tool_take/0/g-0/8
msgctxt "Chance"
msgid "\"Say. Is that the boss?\""
msgstr "« Dis donc. C'est le patron, là ? »"

# Traduction IA – à relire
#: chance_d20/Tool_ask/0/g-0/32/s/0
msgctxt "Choix"
msgid "Yeah. They told me they aren't going to pay you."
msgstr "Ouais. Elle m'a dit qu'elle n'allait pas vous payer."

# Traduction IA – à relire
#: chance_d20/Tool_ask/0/g-0/33/s/0 chance_d20/Tool_take/0/g-0/17/s/0
msgctxt "Choix"
msgid "The djinn has a new business partner."
msgstr "Le djinn a une nouvelle associée."

# Traduction IA – à relire
#: chance_d20/Tool_ask/0/g-1/0 chance_d20/Tool_take/0/g-1/0
msgctxt "Chance"
msgid "\"Oh. So changing the terms of our agreement, eh? I don't like that at all.\""
msgstr "« Oh. Donc on change les termes de notre accord, hein ? Ça me plaît pas du tout, ça. »"

# Traduction IA – à relire
#: chance_d20/Tool_ask/0/g-1/8 chance_d20/Tool_take/0/g-1/8
msgctxt "Chance"
msgid "\"Okay kid. Let's get a move on it. We got a djinn to take out.\""
msgstr "« D'accord, {{gamin|gamine|gamin·e}}. On se bouge. On a un djinn à dégommer. »"

# Traduction IA – à relire
#: chance_d20/Tool_ask/0/g-1/16 chance_d20/Tool_take/0/g-1/16
msgctxt "Chance"
msgid "As the Trowel hops in your hand, Melvil stumbles across you and the Tools."
msgstr "Au moment où la Truelle saute dans ta main, Melvil tombe sur toi et les Outils."

# Traduction IA – à relire
#: chance_d20/Tool_ask/0/g-1/32/s/0 chance_d20/Tool_take/0/g-1/32/s/0
msgctxt "Choix"
msgid "I yell \"Eat iron!\""
msgstr "Je crie : « Mange du fer ! »"

# Traduction IA – à relire
#: chance_d20/Tool_ask/0/g-1/33/s/0 chance_d20/Tool_take/0/g-1/33/s/0
msgctxt "Choix"
msgid "Metal Magic? Go...?"
msgstr "Magie du métal ? Vas-y... ?"

# Traduction IA – à relire
#: chance_d20/Tool_ask/0/g-2/16 chance_d20/Tool_take/0/g-2/16
msgctxt "Chance"
msgid "\"This is kinda AWESOME!\", Trowel yells."
msgstr "« C'est trop GÉNIAL, ce truc ! », hurle la Truelle."

# Traduction IA – à relire
#: chance_d20/Tool_ask/0/g-2/67 chance_d20/Tool_take/0/g-2/67
msgctxt "Chance"
msgid "10 damage."
msgstr "10 points de dégâts."

# Traduction IA – à relire
#: chance_d20/Tool_ask/0/g-2/75/b/4
msgctxt "Lux"
msgid "Whatever doesn't kill you makes you weaker."
msgstr "Ce qui ne te tue pas te rend plus faible."

# Traduction IA – à relire
#: chance_d20/Tool_ask/0/g-2/141 chance_d20/Tool_take/0/g-2/132
msgctxt "Chance"
msgid "It looks like it is holding... until..."
msgstr "On dirait que ça tient... jusqu'à ce que..."

# Traduction IA – à relire
#: chance_d20/Tool_take/0/0
msgctxt "Chance"
msgid "You remember a summoning spell. You focus it on Trowel."
msgstr "Tu te rappelles un sort d'invocation. Tu le concentres sur la Truelle."

# Traduction IA – à relire
#: chance_d20/Tool_take/0/8
msgctxt "Chance"
msgid "He comes flying through the air, and lands in your hands."
msgstr "Il traverse les airs et atterrit dans tes mains."

# Traduction IA – à relire
#: chance_d20/Tool_take/0/16
msgctxt "Chance"
msgid "\"Hey now! What's the big idea!\""
msgstr "« Hé, doucement ! C'est quoi ton problème ? »"

# Traduction IA – à relire
#: chance_d20/Tool_take/0/24/b/4
msgctxt "Lux"
msgid "Shut up, you tool! We've got people to save!"
msgstr "Tais-toi, espèce de manche ! On a des gens à sauver !"

# Traduction IA – à relire
#: chance_d20/Tool_take/0/24/b/12
msgctxt "Lux"
msgid "And then I slap the trowel."
msgstr "Et là, je mets une claque à la truelle."

# Traduction IA – à relire
#: chance_d20/Tool_take/0/24/b/20
msgctxt "Chance"
msgid "Why would you... whatever. It hurts. Because it is a trowel. And you take 10 damage."
msgstr "Mais pourquoi tu... bref. Ça fait mal. Parce que c'est une truelle. Et tu subis 10 points de dégâts."

# Traduction IA – à relire
#: chance_d20/Tool_take/0/24/b/31
msgctxt "Lux"
msgid "You didn't even roll for that damage."
msgstr "T'as même pas lancé les dés pour les dégâts."

# Traduction IA – à relire
#: chance_d20/Tool_take/0/24/b/39
msgctxt "Chance"
msgid "Nope. Sure didn't."
msgstr "Non. Absolument pas."

# Traduction IA – à relire
#: chance_d20/Tool_take/0/27
msgctxt "Chance"
msgid "Trowel slaps your hand until you let him go."
msgstr "La Truelle te tape la main jusqu'à ce que tu le lâches."

# Traduction IA – à relire
#: chance_d20/Tool_take/0/35
msgctxt "Chance"
msgid "\"Who is you to be grabbin' at folks? You wanna touch? YOU ASK, ya moron!\""
msgstr "« Pour qui tu te prends à attraper les gens comme ça ? Tu veux toucher ? TU DEMANDES, abruti{{|e|·e}} ! »"

# Traduction IA – à relire
#: chance_d20/Tool_take/0/43/s/0
msgctxt "Choix"
msgid "We don't have time for this! I need your help!"
msgstr "On n'a pas le temps pour ça ! J'ai besoin de ton aide !"

# Traduction IA – à relire
#: chance_d20/Tool_take/0/44/s/0
msgctxt "Choix"
msgid "Can we talk about this later? The djinn is coming!"
msgstr "On peut en parler plus tard ? Le djinn arrive !"

# Traduction IA – à relire
#: chance_d20/Tool_take/0/c-1/7
msgctxt "Chance"
msgid "\"I don't see how any of that is my problem, alright?\""
msgstr "« Je vois pas en quoi c'est mon problème, d'accord ? »"

# Traduction IA – à relire
#: chance_d20/Tool_take/0/g-0/16/s/0
msgctxt "Choix"
msgid "Yeah. They are here to kill us all!"
msgstr "Ouais. Elle est là pour tous nous tuer !"

# Traduction IA – à relire
#: chance_d20/Tool_take/0/g-2/75/b/1
msgctxt "Lux"
msgid "See? If you just hid like my character is - they are hiding by the way - you wouldn't get hit."
msgstr "Tu vois ? Si tu te cachais comme mon personnage (qui se cache, au fait), tu te ferais pas toucher."

# Traduction IA – à relire
#: chance_d20/Enchanter_ultimate/0
msgctxt "Chance"
msgid "You sense something. A pulsing of pure energy. It's the leyline from before."
msgstr "Tu sens quelque chose. Une pulsation d'énergie pure. C'est la ligne tellurique de tout à l'heure."

# Traduction IA – à relire
#: chance_d20/Enchanter_ultimate/8
msgctxt "Chance"
msgid "Scanning quickly to find it, you sprint for it, running past Moys and drawing the attention of Melvil."
msgstr "Tu la repères vite et tu fonces vers elle, en passant devant Moys et en attirant l'attention de Melvil."

# Traduction IA – à relire
#: chance_d20/Enchanter_ultimate/16
msgctxt "Chance"
msgid "As soon as you reach it, you shove Trowel into the ground, breaking open the earth further."
msgstr "Dès que tu l'atteins, tu plantes la Truelle dans le sol et tu ouvres davantage la terre."

# Traduction IA – à relire
#: chance_d20/Enchanter_ultimate/24
msgctxt "Chance"
msgid "In an instant, you are transformed. Your whole body glows with arcane power, and you feel your full magical potential unlocked."
msgstr "En un instant, tu es {{transformé|transformée|transformé·e}}. Tout ton corps rayonne de pouvoir arcanique, et tu sens ton plein potentiel magique se libérer."

# Traduction IA – à relire
#: chance_d20/Enchanter_ultimate/32
msgctxt "Chance"
msgid "Melvil unleashes another arcane lance on you. Only this time, you absorb it. It makes you stronger."
msgstr "Melvil te lance une nouvelle lance arcanique. Mais cette fois, tu l'absorbes. Elle te rend plus fort{{|e|·e}}."

# Traduction IA – à relire
#: chance_d20/Enchanter_ultimate/40
msgctxt "Chance"
msgid "\"Wait... calm down. Remember, you are MY apprentice! We can rule the world together!\""
msgstr "« Attends... calme-toi. N'oublie pas que tu es MON apprenti{{|e|·e}} ! Nous pouvons régner sur le monde ensemble ! »"

# Traduction IA – à relire
#: chance_d20/Enchanter_ultimate/48
msgctxt "Chance"
msgid "But you have heard enough of her. With your hand pointed at the ground, you call forth the very metallic minerals of the dirt."
msgstr "Mais tu en as assez entendu. La main pointée vers le sol, tu fais surgir les minéraux métalliques de la terre elle-même."

# Traduction IA – à relire
#: chance_d20/Enchanter_ultimate/56
msgctxt "Chance"
msgid "They quickly form a giant harpoon of metal."
msgstr "Ils forment rapidement un harpon de métal géant."

# Traduction IA – à relire
#: chance_d20/Enchanter_ultimate/64
msgctxt "Chance"
msgid "And as you unleash your ultimate attack, Arcane Eradication, you feel your power drain from the leyline."
msgstr "Et en déchaînant ton attaque ultime, l'Éradication Arcanique, tu sens ton pouvoir s'écouler hors de la ligne tellurique."

# Traduction IA – à relire
#: chance_d20/Enchanter_ultimate/75
msgctxt "Chance"
msgid "But that's okay. Why? Because your attack strikes true. The giant spike slams her against a tree, pinning her to it."
msgstr "Mais ce n'est pas grave. Pourquoi ? Parce que ton attaque fait mouche. La pointe géante la projette contre un arbre et l'y cloue."

# Traduction IA – à relire
#: chance_d20/Enchanter_ultimate/83
msgctxt "Chance"
msgid "Melvil cries out, the spear of metal cracking and sizzling as it works through her."
msgstr "Melvil hurle, tandis que la lance de métal crépite et grésille en la transperçant."

# Traduction IA – à relire
#: chance_d20/Enchanter_ultimate/91 chance_d20/Metal_final/121
msgctxt "Chance"
msgid "\"If I could, I would flunk you!\""
msgstr "« Si je le pouvais, je te ferais redoubler ! »"

# Traduction IA – à relire
#: chance_d20/Enchanter_ultimate/105 chance_d20/Metal_final/135
msgctxt "Chance"
msgid "But she can't. Slowly, her body melts into a pile of arcane goo. It seeps into the ground, joining the bubbling magic that lies under the surface on the leyline."
msgstr "Mais elle ne peut pas. Lentement, son corps fond en une flaque de gelée arcanique. Elle s'infiltre dans le sol et rejoint la magie qui bouillonne sous la surface, le long de la ligne tellurique."

# Traduction IA – à relire
#: chance_d20/Enchanter_ultimate/113 chance_d20/Metal_final/143
msgctxt "Chance"
msgid "You have cleaned up your mess! As you run back to campus, you mentally call dibs on all of her cool stuff."
msgstr "Tu as réparé tes bêtises ! En rentrant au campus en courant, tu réserves mentalement tous ses trucs cool."

# Traduction IA – à relire
#: chance_d20/Metal_final/0
msgctxt "Chance"
msgid "You simply need time to pull enough metal into a good attack."
msgstr "Il te faut juste le temps de rassembler assez de métal pour une bonne attaque."

# Traduction IA – à relire
#: chance_d20/Metal_final/8
msgctxt "Chance"
msgid "Trowel senses what you are trying to do."
msgstr "La Truelle sent ce que tu essaies de faire."

# Traduction IA – à relire
#: chance_d20/Metal_final/16
msgctxt "Chance"
msgid "\"Keep fightin', guys! Show 'em what Tools are made of!\""
msgstr "« Continuez à vous battre, les gars ! Montrez-leur de quel métal sont faits les Outils ! »"

# Traduction IA – à relire
#: chance_d20/Metal_final/24
msgctxt "Chance"
msgid "Motivated by Trowel's words, the Tools themselves seem to rally. The broken pieces start to magically form new metal objects."
msgstr "Motivés par les mots de la Truelle, les Outils semblent reprendre du poil de la bête. Leurs morceaux cassés se mettent à former magiquement de nouveaux objets en métal."

# Traduction IA – à relire
#: chance_d20/Metal_final/32
msgctxt "Chance"
msgid "Like a movie where a rodent plays with magical cleaning supplies, there are now two of each Tool. They are ready to fight!"
msgstr "Comme dans ce film où un rongeur joue avec des balais magiques, il y a maintenant deux exemplaires de chaque Outil. Ils sont prêts à se battre !"

# Traduction IA – à relire
#: chance_d20/Metal_final/43/b/4
msgctxt "Chance"
msgid "Now would be a REALLY good time to do something, Lux."
msgstr "Ce serait VRAIMENT le bon moment pour faire quelque chose, Lux."

# Traduction IA – à relire
#: chance_d20/Metal_final/43/b/12
msgctxt "Lux"
msgid "You're right."
msgstr "T'as raison."

# Traduction IA – à relire
#: chance_d20/Metal_final/43/b/20
msgctxt "Lux"
msgid "Hi, chat! If you don't already, follow me on all platforms! My info is in the show notes."
msgstr "Coucou, le chat ! Si c'est pas déjà fait, suivez-moi sur toutes les plateformes ! Mes infos sont en description."

# Traduction IA – à relire
#: chance_d20/Metal_final/43/b/28
msgctxt "Lux"
msgid "And, don't forget to check out my new podcast \"Brighten Up With Lux!\" in which we discuss the most CONTR0VERSIAL topics out there!"
msgstr "Et n'oubliez pas d'écouter mon nouveau podcast « Rayonnez avec Lux ! », où on aborde les sujets les plus CONTR0VERSÉS du moment !"

# Traduction IA – à relire
#: chance_d20/Metal_final/43/b/36
msgctxt "Chance"
msgid "...back to the fight."
msgstr "... retour au combat."

# Traduction IA – à relire
#: chance_d20/Metal_final/46
msgctxt "Chance"
msgid "Melvil lets out an unamused laugh. That is until the twin Rakes start scratching at her."
msgstr "Melvil laisse échapper un rire sans joie. Jusqu'à ce que les Râteaux jumeaux se mettent à la griffer."

# Traduction IA – à relire
#: chance_d20/Metal_final/54
msgctxt "Chance"
msgid "The Spades start slamming against her stomach. And over and over the Tools begin their offensive push."
msgstr "Les Bêches se mettent à lui marteler le ventre. Et, encore et encore, les Outils mènent leur offensive."

# Traduction IA – à relire
#: chance_d20/Metal_final/62
msgctxt "Chance"
msgid "This is the time you and Trowel need. You focus on the garden tool, pushing until you are mentally connected with it."
msgstr "C'est le temps dont la Truelle et toi aviez besoin. Tu te concentres sur l'outil de jardin, jusqu'à établir un lien mental avec lui."

# Traduction IA – à relire
#: chance_d20/Metal_final/70
msgctxt "Chance"
msgid "You feel tiny hands wrap around yours. Moys hangs on by the handle, feet dangling because they are so short."
msgstr "Tu sens de toutes petites mains se refermer sur les tiennes. Moys s'accroche au manche, les pieds dans le vide tellement iel est petit·e."

# Traduction IA – à relire
#: chance_d20/Metal_final/78
msgctxt "Chance"
msgid "But you feel them pushing magical energy into the attack as well."
msgstr "Mais tu sens qu'iel insuffle aussi de l'énergie magique dans l'attaque."

# Traduction IA – à relire
#: chance_d20/Metal_final/86
msgctxt "Chance"
msgid "\"Oh yeah! OH YEAH! LET'S GOOOOO!\" Trowel is hype and shaking with power."
msgstr "« Oh ouais ! OH OUAIS ! C'EST PARTIIII ! » La Truelle est surexcitée et vibre de puissance."

# Traduction IA – à relire
#: chance_d20/Metal_final/94
msgctxt "Chance"
msgid "You feel metal coming to the tip of the instrument. It's time. With a giant release of energy, you let it fly."
msgstr "Tu sens le métal affluer au bout de l'instrument. C'est le moment. Dans une gigantesque libération d'énergie, tu le laisses partir."

# Traduction IA – à relire
#: chance_d20/Metal_final/102
msgctxt "Chance"
msgid "You can hear the impact of the attack."
msgstr "Tu entends l'impact de l'attaque."

# Traduction IA – à relire
#: chance_d20/Metal_final/113
msgctxt "Chance"
msgid "Melvil cries out, the sphere of metal crackling and sizzling as it works through her."
msgstr "Melvil hurle, tandis que la sphère de métal crépite et grésille en la transperçant."

# Traduction IA – à relire
#: chance_d20/Enchanter_death/6
msgctxt "Chance"
msgid "As you perish, your last thought isn't about the djinn or about school."
msgstr "Tandis que tu péris, ta dernière pensée n'est ni pour le djinn, ni pour l'école."

# Traduction IA – à relire
#: chance_d20/Enchanter_death/14
msgctxt "Chance"
msgid "Rather, it is about the people who may suffer because of your choice to tamper with the lamp."
msgstr "Elle va plutôt aux gens qui risquent de souffrir parce que tu as choisi de trafiquer la lampe."

# Traduction IA – à relire
#: chance_d20/Enchanter_death/22
msgctxt "Chance"
msgid "You know that there are more powerful Enchanters than you. And you only wish you could help fix the problem you made."
msgstr "Tu sais qu'il existe des Enchanteurs plus puissants que toi. Et tu voudrais juste pouvoir aider à réparer le problème que tu as créé."

# Traduction IA – à relire
#: chance_d20/Enchanter_death/30
msgctxt "Chance"
msgid "And with that pure of heart desire, you feel yourself become one with the magic of the world."
msgstr "Et avec ce désir au cœur pur, tu te sens ne faire plus qu'un avec la magie du monde."

# Traduction IA – à relire
#: chance_d20/Enchanter_death/38
msgctxt "Chance"
msgid "You are pure energy, racing across leylines and moving through magic focuses faster than you can fully understand."
msgstr "Tu es énergie pure, filant le long des lignes telluriques et traversant les focaliseurs magiques plus vite que tu ne peux le comprendre."

# Traduction IA – à relire
#: chance_d20/Enchanter_death/46
msgctxt "Chance"
msgid "And with this, you know that you will be able to help bring down the djinn in some way. Because you are now one with the forces that can change the world."
msgstr "Et ainsi, tu sais que tu pourras aider à vaincre le djinn d'une façon ou d'une autre. Car tu ne fais plus qu'un avec les forces capables de changer le monde."

# Traduction IA – à relire
#: chance_d20/Enchanter_death/54
msgctxt "Chance"
msgid "That brings you peace. And that's all you could ask for anyway."
msgstr "Cela t'apporte la paix. Et de toute façon, tu ne pouvais rien demander de plus."

# Traduction IA – à relire
#: chance_d20/Enchanter_death/62/b/1
msgctxt "Lux"
msgid "What about me?"
msgstr "Et moi ?"

# Traduction IA – à relire
#: chance_d20/Enchanter_death/62/b/9
msgctxt "Chance"
msgid "Oh yeah. Your character dies. Instantly. And no one cares."
msgstr "Ah oui. Ton personnage meurt. Instantanément. Et tout le monde s'en fiche."

# Traduction IA – à relire
#: chance_d20/Enchanter_death/62/b/20
msgctxt "Lux"
msgid "Except that they do... they do care."
msgstr "Sauf que non... ils s'en fichent pas."

# Traduction IA – à relire
#: chance_d20/Enchanter_death/62/b/28
msgctxt "Lux"
msgid "They care DANGEROUSLY much. You know, the way an online mob cares about things..."
msgstr "Ils s'en soucient DANGEREUSEMENT. Tu sais, comme une meute en ligne se soucie des choses..."

# Traduction IA – à relire
#: chance_d20/Enchanter_ending/0/6
msgctxt "Chance"
msgid "You fought and defeated an evil djinn. With your mentor gone, you are unsure of what your future at the school holds."
msgstr "Tu as affronté et vaincu un djinn maléfique. Sans ton mentor, tu ne sais pas trop ce que l'avenir te réserve à l'école."

# Traduction IA – à relire
#: chance_d20/Enchanter_ending/0/14
msgctxt "Chance"
msgid "As you walk back to campus, exhausted and excited about the many tools and trinkets in Melvil's office you can claim, you wonder if your days here are numbered."
msgstr "En rentrant au campus, épuisé{{|e|·e}} et tout excité{{|e|·e}} à l'idée de réclamer les nombreux outils et babioles du bureau de Melvil, tu te demandes si tes jours ici sont comptés."

# Traduction IA – à relire
#: chance_d20/Enchanter_ending/0/22
msgctxt "Chance"
msgid "But, as you walk towards the main doors of the school, you see a member of The Spine waiting for you."
msgstr "Mais en approchant des grandes portes de l'école, tu vois un membre de la Reliure qui t'attend."

# Traduction IA – à relire
#: chance_d20/Enchanter_ending/0/30
msgctxt "Chance"
msgid "Moys, by some magic they will never reveal, has beat you there and stands beside the High Enchanter Jefferson."
msgstr "Moys, par une magie qu'iel ne révélera jamais, est arrivé·e avant toi et se tient à côté du Grand Enchanteur Jefferson."

# Traduction IA – à relire
#: chance_d20/Enchanter_ending/0/38
msgctxt "Chance"
msgid "\"I hear you took on a djinn. And won.\""
msgstr "« J'ai entendu dire que tu avais affronté un djinn. Et gagné. »"

# Traduction IA – à relire
#: chance_d20/Enchanter_ending/0/46/s/0
msgctxt "Choix"
msgid "Yeah. I sure did!"
msgstr "Ouais. Et comment !"

# Traduction IA – à relire
#: chance_d20/Enchanter_ending/0/47/s/0
msgctxt "Choix"
msgid "I got lucky."
msgstr "J'ai eu de la chance."

# Traduction IA – à relire
#: chance_d20/Enchanter_ending/0/48/s/0
msgctxt "Choix"
msgid "I'm surprised I made it out alive!"
msgstr "Je suis {{surpris|surprise|surpris·e}} d'en être sorti{{|e|·e}} vivant{{|e|·e}} !"

# Traduction IA – à relire
#: chance_d20/Enchanter_ending/0/g-0/0
msgctxt "Chance"
msgid "\"And you used metal magic. That, my child, is a rare deed. You have accomplished more than you know.\""
msgstr "« Et tu as utilisé la magie du métal. C'est là un exploit rare, mon enfant. Tu as accompli plus que tu ne le crois. »"

# Traduction IA – à relire
#: chance_d20/Enchanter_ending/0/g-0/8
msgctxt "Chance"
msgid "\"We in The Spine hereby declare your tuition free. You may study under any Enchanter you choose.\""
msgstr "« Nous, membres de la Reliure, déclarons par la présente tes frais de scolarité offerts. Tu pourras étudier auprès de l'Enchanteur de ton choix. »"

# Traduction IA – à relire
#: chance_d20/Enchanter_ending/0/g-0/16/s/0
msgctxt "Choix"
msgid "I... what?"
msgstr "Je... quoi ?"

# Traduction IA – à relire
#: chance_d20/Enchanter_ending/0/g-0/17/s/0
msgctxt "Choix"
msgid "That's awesome!"
msgstr "C'est génial !"

# Traduction IA – à relire
#: chance_d20/Enchanter_ending/0/g-1/0
msgctxt "Chance"
msgid "\"The hero of Bookshelf Bluff must be trained up. For you have the makings of the most powerful Enchanter to ever live. We shall foster your potential.\""
msgstr "« {{Le héros|L'héroïne|La figure héroïque}} de la Falaise de l'Étagère doit être {{formé|formée|formé·e}}. Car tu as l'étoffe {{du plus puissant Enchanteur|de la plus puissante Enchanteresse|de l'être enchanteur le plus puissant}} de tous les temps. Nous cultiverons ton potentiel. »"

# Traduction IA – à relire
#: chance_d20/Enchanter_ending/0/g-1/8
msgctxt "Chance"
msgid "And with those words, a smile appears on your face."
msgstr "Et à ces mots, un sourire apparaît sur ton visage."

# Traduction IA – à relire
#: chance_d20/Enchanter_ending/0/g-1/16
msgctxt "Chance"
msgid "This is not the last time the hero of Bookshelf Bluff will be asked to sling a spell for the protection of the school."
msgstr "Ce ne sera pas la dernière fois qu'on demandera {{au héros|à l'héroïne|à la figure héroïque}} de la Falaise de l'Étagère de lancer un sort pour protéger l'école."

# Traduction IA – à relire
#: chance_d20/Enchanter_ending/0/g-1/35/b/4
msgctxt "Lux"
msgid "And I went on to be the most famous, sexy, popular, sexy, smart, popular lamp in Bookshelf Bluff, right?"
msgstr "Et moi, j'ai fini par être la lampe la plus célèbre, sexy, populaire, sexy, intelligente et populaire de la Falaise de l'Étagère, c'est ça ?"

# Traduction IA – à relire
#: chance_d20/Enchanter_ending/0/g-1/35/b/12
msgctxt "Chance"
msgid "I just..."
msgstr "Je..."

# Traduction IA – à relire
#: chance_d20/Enchanter_ending/0/g-1/35/b/20
msgctxt "Lux"
msgid "Perfect. Thank you."
msgstr "Parfait. Merci."

# Traduction IA – à relire
#: chance_d20/Enchanter_hero/0/0
msgctxt "Chance"
msgid "Oh... well, Crit!"
msgstr "Oh... eh bien, crit !"

# Traduction IA – à relire
#: chance_d20/Enchanter_hero/0/8
msgctxt "Chance"
msgid "You step in front of Moys before Melvil can unleash her attack."
msgstr "Tu t'interposes devant Moys avant que Melvil puisse lancer son attaque."

# Traduction IA – à relire
#: chance_d20/Enchanter_hero/0/16/b/4
msgctxt "Lux"
msgid "I step in front of you, and strike a hot, mysterious pose. Then I get somewhere safe and out of the way."
msgstr "Je m'interpose devant toi et je prends une pose sexy et mystérieuse. Puis je me mets à l'abri, loin de tout ça."

# Traduction IA – à relire
#: chance_d20/Enchanter_hero/0/19
msgctxt "Chance"
msgid "One of the tools shouts out -"
msgstr "L'un des outils s'écrie..."

# Traduction IA – à relire
#: chance_d20/Enchanter_hero/0/27
msgctxt "Chance"
msgid "\"What are ya' doin', kid?\""
msgstr "« Qu'est-ce que tu fabriques, {{gamin|gamine|gamin·e}} ? »"

# Traduction IA – à relire
#: chance_d20/Enchanter_hero/0/35/s/0
msgctxt "Choix"
msgid "No one hurts Moys!"
msgstr "Personne ne touche à Moys !"

# Traduction IA – à relire
#: chance_d20/Enchanter_hero/0/36/s/0
msgctxt "Choix"
msgid "Take care of Moys for me."
msgstr "Prends soin de Moys pour moi."

# Traduction IA – à relire
#: chance_d20/Enchanter_hero/0/g-0/0
msgctxt "Chance"
msgid "You release your hold on the Trowel, letting him tumble to the ground."
msgstr "Tu lâches la Truelle, qui dégringole au sol."

# Traduction IA – à relire
#: chance_d20/Enchanter_hero/0/g-0/8
msgctxt "Chance"
msgid "That is all you have time for before Melvil hurtles the attack at you."
msgstr "C'est tout ce que tu as le temps de faire avant que Melvil te projette son attaque."

# Traduction IA – à relire
#: chance_d20/Enchanter_hero/0/g-0/19
msgctxt "Chance"
msgid "She hits you fooooor....."
msgstr "Elle t'infliiiige..."

# Traduction IA – à relire
#: chance_d20/Enchanter_hero/0/g-0/27
msgctxt "Chance"
msgid "Oh no... I rolled a crit."
msgstr "Oh non... j'ai fait un crit."

# Traduction IA – à relire
#: chance_d20/Enchanter_hero/0/g-0/38
msgctxt "Chance"
msgid "That means she hits you for 93 damage."
msgstr "Ça veut dire qu'elle t'inflige 93 points de dégâts."

# Traduction IA – à relire
#: chance_d20/Enchanter_hero/0/g-0/46
msgctxt "Chance"
msgid "I'm... so sorry."
msgstr "Je suis... vraiment désolé."

# Traduction IA – à relire
#: chance_d20/Enchanter_hero/0/g-0/54
msgctxt "Chance"
msgid "Umm... you feel the magic hit your chest."
msgstr "Euh... tu sens la magie te frapper la poitrine."

# Traduction IA – à relire
#: chance_d20/Enchanter_hero/0/g-0/62
msgctxt "Chance"
msgid "And in that moment, you are known by everything in the universe that ever was or ever will be."
msgstr "Et à cet instant, tu es connu{{|e|·e}} de tout ce que l'univers a jamais contenu et contiendra jamais."

# Traduction IA – à relire
#: chance_d20/Enchanter_hero/0/g-0/73
msgctxt "Chance"
msgid "The bright light from the attack doesn't burn out. Instead, you open your eyes to find yourself swirling in magical ether."
msgstr "La lumière éclatante de l'attaque ne s'éteint pas. Au contraire, tu ouvres les yeux et tu te retrouves à tournoyer dans l'éther magique."

# Traduction IA – à relire
#: chance_d20/Enchanter_hero/0/g-0/81
msgctxt "Chance"
msgid "Melvil unbound your soul from the earthly plane. But in doing so... released you from pain."
msgstr "Melvil a détaché ton âme du plan terrestre. Mais ce faisant... elle t'a libéré{{|e|·e}} de la douleur."

# Traduction IA – à relire
#: chance_d20/Enchanter_hero/0/g-0/89
msgctxt "Chance"
msgid "Everything is beautiful and you are in tune with all things."
msgstr "Tout est beau, et tu es en harmonie avec toute chose."

# Traduction IA – à relire
#: chance_d20/Enchanter_hero/0/g-0/97
msgctxt "Chance"
msgid "But... wait! That's not all! Ummm..."
msgstr "Mais... attends ! Ce n'est pas tout ! Euuuh..."

# Traduction IA – à relire
#: chance_d20/Enchanter_hero/0/g-0/105/b/4
msgctxt "Lux"
msgid "I bet he is making this up on the fly."
msgstr "Je parie qu'il invente au fur et à mesure."

# Traduction IA – à relire
#: chance_d20/Enchanter_hero/0/g-0/108
msgctxt "Chance"
msgid "You are zooming through time and space and existence and you slam into something. And then it is black."
msgstr "Tu files à travers le temps, l'espace et l'existence, et tu percutes quelque chose. Puis c'est le noir."

# Traduction IA – à relire
#: chance_d20/Enchanter_hero/0/g-0/116
msgctxt "Chance"
msgid "You open new eyes. And a voice in your head tells you that your sacrifice has earned you another chance."
msgstr "Tu ouvres de nouveaux yeux. Et une voix dans ta tête te dit que ton sacrifice t'a valu une seconde chance."

# Traduction IA – à relire
#: chance_d20/Enchanter_hero/0/g-0/124
msgctxt "Chance"
msgid "You see the sky. You feel grass under you. You realize, you have been reincarnated. But where and who you are is a mystery to you."
msgstr "Tu vois le ciel. Tu sens l'herbe sous toi. Tu comprends que tu t'es réincarné{{|e|·e}}. Mais où tu es, et qui tu es, ça reste un mystère."

# Traduction IA – à relire
#: chance_d20/Enchanter_hero/0/g-0/132
msgctxt "Chance"
msgid "And that mystery is a story for another time."
msgstr "Et ce mystère, c'est une autre histoire."

# Traduction IA – à relire
#: chance_d20/Enchanter_hero/0/g-0/140/b/4
msgctxt "Lux"
msgid "Way to leave me to clean up your mess. Which, I'm not going to do."
msgstr "Merci de me laisser réparer tes bêtises. Ce que je ne ferai pas, d'ailleurs."

# Traduction IA – à relire
#: chance_d20/Enchanter_hero/0/g-0/140/b/12
msgctxt "Lux"
msgid "My character bows down and becomes a servant of Melvil."
msgstr "Mon personnage s'incline et devient serviteur de Melvil."

# Traduction IA – à relire
#: chance_d20/Enchanter_hero/0/g-0/140/b/20
msgctxt "Chance"
msgid "So... now you are an evil character and the adventure is over. So... good job..."
msgstr "Donc... maintenant tu es un personnage maléfique et l'aventure est finie. Donc... bravo..."

# Traduction IA – à relire
#: chance_d20/Enchanter_hero/0/g-0/140/b/28
msgctxt "Lux"
msgid "But I got like 480 new followers. How many did YOU get?"
msgstr "Mais j'ai gagné genre 480 nouveaux abonnés. Et TOI, t'en as gagné combien ?"

# Traduction IA – à relire
#: chance_d20/Murderhobo_ending/0/6
msgctxt "Chance"
msgid "Can I be honest with you? I hope I can."
msgstr "Je peux être honnête avec toi ? J'espère que oui."

# Traduction IA – à relire
#: chance_d20/Murderhobo_ending/0/14
msgctxt "Chance"
msgid "It's just, I worked really hard on getting everything set up and building out the story and —"
msgstr "C'est juste que j'ai vraiment beaucoup bossé pour tout mettre en place et construire l'histoire, et..."

# Traduction IA – à relire
#: chance_d20/Murderhobo_ending/0/26/s/0
msgctxt "Choix"
msgid "I'm sorry. You're right. I didn't take it super seriously."
msgstr "Je suis {{désolé|désolée|désolé·e}}. Tu as raison. Je ne l'ai pas pris très au sérieux."

# Traduction IA – à relire
#: chance_d20/Murderhobo_ending/0/27/s/0
msgctxt "Choix"
msgid "You made it where I lose too easy. This is your fault."
msgstr "Tu as fait en sorte que je perde trop facilement. C'est ta faute."

# Traduction IA – à relire
#: chance_d20/Murderhobo_ending/0/c-1/7
msgctxt "Chance"
msgid "This is my fault? You didn't pay attention to any of the clues I was dropping!"
msgstr "C'est ma faute ? Tu n'as fait attention à aucun des indices que je semais !"

# Traduction IA – à relire
#: chance_d20/Murderhobo_ending/0/c-1/15
msgctxt "Chance"
msgid "I gave you all the information you needed!"
msgstr "Je t'ai donné toutes les infos dont tu avais besoin !"

# Traduction IA – à relire
#: chance_d20/Murderhobo_ending/0/c-1/23/0/s/0
msgctxt "Choix"
msgid "You should have let me win. Be a better Game Master or whatever."
msgstr "T'aurais dû me laisser gagner. Sois un meilleur maître du jeu, ou je sais pas quoi."

# Traduction IA – à relire
#: chance_d20/Murderhobo_ending/0/c-1/23/1/s/0
msgctxt "Choix"
msgid "Can't I do anything?! Me dying is lazy storytelling on your part!"
msgstr "Je peux rien faire ?! Me faire mourir, c'est de la flemme narrative de ta part !"

# Traduction IA – à relire
#: chance_d20/Chance_love/0/0
msgctxt "Chance"
msgid "You were amazing! The way you just—-AHHH!!"
msgstr "Tu as été incroyable ! La façon dont tu as... AHHH !!"

# Traduction IA – à relire
#: chance_d20/Chance_love/0/8
msgctxt "Chance"
msgid "Sorry. I am just so excited with how much fun we just had!"
msgstr "Pardon. Je suis juste trop excité par tout le fun qu'on vient d'avoir !"

# Traduction IA – à relire
#: chance_d20/Chance_love/0/16
msgctxt "Chance"
msgid "I'm... floored by you."
msgstr "Tu me... laisses sans voix."

# Traduction IA – à relire
#: chance_d20/Chance_love/0/24
msgctxt "Chance"
msgid "Listen... that was pretty much perfect for me. YOU are pretty much perfect to me."
msgstr "Écoute... pour moi, c'était quasiment parfait. TOI, tu es quasiment parfait{{|e|·e}}, pour moi."

# Traduction IA – à relire
#: chance_d20/Chance_love/0/32
msgctxt "Chance"
msgid "And if you are ever wanting to role play again..."
msgstr "Et si jamais tu as envie de refaire du jeu de rôle..."

# Traduction IA – à relire
#: chance_d20/Chance_love/0/40
msgctxt "Chance"
msgid "In any way..."
msgstr "De n'importe quel genre..."

# Traduction IA – à relire
#: chance_d20/Chance_love/0/48
msgctxt "Chance"
msgid "Let me know?"
msgstr "Tu me fais signe ?"

# Traduction IA – à relire
#: chance_d20/Chance_love/0/56
msgctxt "Chance"
msgid "We could move from the character sheets to the uh...."
msgstr "On pourrait passer des parties sur table aux, euh..."

# Traduction IA – à relire
#: chance_d20/Chance_love/0/64
msgctxt "Chance"
msgid "Other... sheets?"
msgstr "Aux parties... sous la couette ?"

# Traduction IA – à relire
#: chance_d20/Chance_love/0/72/s/0
msgctxt "Choix"
msgid "I understand your insinuation and I am all for it."
msgstr "Je comprends très bien ton sous-entendu, et je suis à fond pour."

# Traduction IA – à relire
#: chance_d20/Chance_love/0/73/s/0
msgctxt "Choix"
msgid "Oh... this was just supposed to be a fun thing to do with friends!"
msgstr "Oh... c'était juste censé être un moment sympa entre amis !"

# Traduction IA – à relire
#: chance_d20/Chance_love/0/c-0/10
msgctxt "Chance"
msgid "<i>cough</i> Yeah. I'd like that."
msgstr "<i>tousse</i> Ouais. Ça me plairait."

# Traduction IA – à relire
#: chance_d20/Chance_love/0/c-0/18/b/4
msgctxt "Jerry"
msgid "Same here! It'll be wonderful!"
msgstr "Moi aussi ! Ce sera merveilleux !"

# Traduction IA – à relire
#: chance_d20/Chance_love/0/c-0/18/b/12
msgctxt "Chance"
msgid "...sure Jerry. Sure."
msgstr "... c'est ça, Jerry. C'est ça."

# Traduction IA – à relire
#: chance_d20/Chance_love/0/c-0/21
msgctxt "Chance"
msgid "Until next time, you mighty hero. I'll be waiting for your epic return!"
msgstr "À la prochaine, {{puissant héros|puissante héroïne|puissante figure héroïque}}. J'attendrai ton retour épique !"

# Traduction IA – à relire
#: chance_d20/Chance_love/0/c-1/7
msgctxt "Chance"
msgid "No problem! Forgive me for piercing the GM veil. This should always be a safe space."
msgstr "Pas de souci ! Pardonne-moi d'avoir percé le voile du MJ. Ça doit toujours rester un espace sûr."

# Traduction IA – à relire
#: chance_d20/Chance_love/0/c-1/15
msgctxt "Chance"
msgid "We are friends - and adventurers, through and through."
msgstr "On est amis, et aventuriers, jusqu'au bout."

# Traduction IA – à relire
#: chance_d20/Chance_hero_love/0/3
msgctxt "Chance"
msgid "THAT WAS INCREDIBLE!"
msgstr "C'ÉTAIT INCROYABLE !"

# Traduction IA – à relire
#: chance_d20/Chance_hero_love/0/14
msgctxt "Chance"
msgid "The way you sacrificed yourself!"
msgstr "La façon dont tu t'es sacrifié{{|e|·e}} !"

# Traduction IA – à relire
#: chance_d20/Chance_hero_love/0/22
msgctxt "Chance"
msgid "HOOOOOLLLLYYY CRIT!"
msgstr "NOOOOOM D'UN CRIIIIIT !"

# Traduction IA – à relire
#: chance_d20/Chance_hero_love/0/30
msgctxt "Chance"
msgid "That was better than I could have imagined."
msgstr "C'était encore mieux que tout ce que j'aurais pu imaginer."

# Traduction IA – à relire
#: chance_d20/Chance_hero_love/0/38
msgctxt "Chance"
msgid "That was... you are...."
msgstr "C'était... tu es..."

# Traduction IA – à relire
#: chance_d20/Chance_hero_love/0/46
msgctxt "Chance"
msgid "Perfect."
msgstr "Parfait{{|e|·e}}."

# Traduction IA – à relire
#: chance_d20/Chance_hero_love/0/54
msgctxt "Chance"
msgid "I'm sorry, that's super embarrassing but like..."
msgstr "Pardon, c'est super gênant, mais genre..."

# Traduction IA – à relire
#: chance_d20/Chance_hero_love/0/62
msgctxt "Chance"
msgid "If that's how you role play here, I'm excited to see how you might like some... other role play?"
msgstr "Si c'est comme ça que tu joues ton rôle ici, j'ai hâte de voir ce que tu penserais d'un... autre genre de jeu de rôle ?"

# Traduction IA – à relire
#: chance_d20/Chance_hero_love/0/70/s/0
msgctxt "Choix"
msgid "You passed the cute check, that's for sure."
msgstr "Tu as réussi ton jet de mignonnerie, c'est sûr."

# Traduction IA – à relire
#: chance_d20/Chance_hero_love/0/71/s/0
msgctxt "Choix"
msgid "Only if it's all above board as friends..."
msgstr "Seulement si tout reste en toute amitié, sans arrière-pensées..."

# Traduction IA – à relire
#: chance_d20/Chance_hero_love/0/c-0/10
msgctxt "Chance"
msgid "That was such a good session."
msgstr "C'était une super séance."

# Traduction IA – à relire
#: chance_d20/Chance_hero_love/0/c-0/18 chance_d20/Chance_hero_love/0/c-1/15
msgctxt "Chance"
msgid "Listen... I appreciate you so much and I would LOVE to play with you again."
msgstr "Écoute... je t'apprécie énormément, et j'ADORERAIS rejouer avec toi."

# Traduction IA – à relire
#: chance_d20/Chance_hero_love/0/c-0/26 chance_d20/Chance_hero_love/0/c-1/23
msgctxt "Chance"
msgid "And I am so damn glad you sat down with me to do this. You're amazing."
msgstr "Et je suis vraiment, mais vraiment content que tu te sois assis{{|e|·e}} à ma table pour faire ça. Tu es incroyable."

# Traduction IA – à relire
#: chance_d20/Chance_hero_love/0/c-0/34 chance_d20/Chance_hero_love/0/c-1/31
msgctxt "Chance"
msgid "I need to wind down because that was intense!"
msgstr "J'ai besoin de redescendre, parce que c'était intense !"

# Traduction IA – à relire
#: chance_d20/Chance_hero_love/0/c-0/42
msgctxt "Chance"
msgid "But PLEASE PLEASE PLEASE come see me again soon! I'd love to have you play with my dice again."
msgstr "Mais S'IL TE PLAÎT, S'IL TE PLAÎT, S'IL TE PLAÎT, reviens me voir bientôt ! J'adorerais que tu joues encore avec mes dés."

# Traduction IA – à relire
#: chance_d20/Chance_hero_love/0/c-0/53
msgctxt "Chance"
msgid "I mean..."
msgstr "Enfin..."

# Traduction IA – à relire
#: chance_d20/Chance_hero_love/0/c-0/61
msgctxt "Chance"
msgid "Uhhhh..."
msgstr "Euuuh..."

# Traduction IA – à relire
#: chance_d20/Chance_hero_love/0/c-0/69
msgctxt "Chance"
msgid "Bye!"
msgstr "Salut !"

# Traduction IA – à relire
#: chance_d20/Chance_hero_love/0/c-1/7
msgctxt "Chance"
msgid "That is SO totally fine with me."
msgstr "Ça me va TOTALEMENT."

# Traduction IA – à relire
#: chance_d20/Chance_hero_love/0/c-1/39
msgctxt "Chance"
msgid "But PLEASE PLEASE PLEASE come see me again soon!"
msgstr "Mais S'IL TE PLAÎT, S'IL TE PLAÎT, S'IL TE PLAÎT, reviens me voir bientôt !"

# Traduction IA – à relire
#: chance_d20/Chance_friendship_a/0
msgctxt "Chance"
msgid "So... Yeah... that was... yeah..."
msgstr "Bon... Ouais... c'était... ouais..."

# Traduction IA – à relire
#: chance_d20/Chance_friendship_a/11
msgctxt "Chance"
msgid "But... at least you tried! I appreciate that part."
msgstr "Mais... au moins, tu as essayé ! J'apprécie ça."

# Traduction IA – à relire
#: chance_d20/Chance_friendship_a/19
msgctxt "Chance"
msgid "Maybe this just isn't your thing. Which is fine! I'm not upset or anything. I just... thank you for playing with me."
msgstr "Ce n'est peut-être juste pas ton truc. Et c'est pas grave ! Je ne suis pas vexé ni rien. Je... merci d'avoir joué avec moi."

# Traduction IA – à relire
#: chance_d20/Chance_friendship_a/27
msgctxt "Chance"
msgid "Maybe we can play a different game sometime."
msgstr "On pourra peut-être jouer à un autre jeu, un de ces jours."

# Traduction IA – à relire
#: chance_d20/Chance_friendship_a/35
msgctxt "Chance"
msgid "I think I should go... Thanks for trying!"
msgstr "Je crois que je vais y aller... Merci d'avoir essayé !"

# Traduction IA – à relire
#: chance_d20/Chance_friendship_b/11
msgctxt "Chance"
msgid "Look, I can't tell you how much I appreciate you playing with me. It takes a special someone to do just dive into G&G. It takes a really special friend to do that."
msgstr "Écoute, je ne te dirai jamais assez à quel point j'apprécie que tu aies joué avec moi. Il faut quelqu'un de spécial pour se lancer comme ça dans G&G. Il faut {{un ami vraiment spécial|une amie vraiment spéciale|un·e ami·e vraiment spécial·e}}."

# Traduction IA – à relire
#: chance_d20/Chance_friendship_b/19
msgctxt "Chance"
msgid "If you ever want to roll some dice or anything, let me know? I'd love to hang out again."
msgstr "Si un jour tu veux lancer des dés ou autre chose, tu me fais signe ? J'adorerais qu'on se revoie."

# Traduction IA – à relire
#: chance_d20/chance_hate/3
msgctxt "Chance"
msgid "I'm gonna roll it to you straight."
msgstr "Je vais jouer cartes sur table... enfin, dés sur table."

# Traduction IA – à relire
#: chance_d20/chance_hate/11
msgctxt "Chance"
msgid "I'm kind of looking for someone who is willing to share in my interest."
msgstr "Je cherche un peu quelqu'un qui soit prêt à partager ma passion."

# Traduction IA – à relire
#: chance_d20/chance_hate/19
msgctxt "Chance"
msgid "And, I've been tossed around before. My heart just can't take it."
msgstr "Et on m'a déjà fait rouler dans tous les sens. Mon cœur ne le supporterait pas."

# Traduction IA – à relire
#: chance_d20/chance_hate/27
msgctxt "Chance"
msgid "So, I'm gonna roll a stealth check and just not engage with you."
msgstr "Alors je vais faire un jet de discrétion et juste éviter de m'engager avec toi."

# Traduction IA – à relire
#: chance_d20/chance_hate/35
msgctxt "Chance"
msgid "No hard feelings, I hope."
msgstr "Sans rancune, j'espère."

# Traduction IA – à relire
#: chance_d20/chance_hate/77 chance_d20/Chance_hate_b/0/g-0/58
msgctxt "Reggie"
msgid "Crit fail, baby. No saving throws here."
msgstr "Échec critique, bébé. Pas de jet de sauvegarde ici."

# Traduction IA – à relire
#: chance_d20/Chance_hate_b/0/3
msgctxt "Chance"
msgid "Holy Crit, that was mean. If you were trying to hurt my feelings, you struck true."
msgstr "Nom d'un crit, c'était méchant. Si tu voulais me blesser, tu as fait mouche."

# Traduction IA – à relire
#: chance_d20/Chance_hate_b/0/11
msgctxt "Chance"
msgid "It's obvious to me that when you rolled your stats as a person, you chose kindness to be your dump stat."
msgstr "C'est évident : quand tu as tiré tes caractéristiques en tant que personne, tu as mis la gentillesse en stat poubelle."

# Traduction IA – à relire
#: chance_d20/Chance_hate_b/0/19/s/0
msgctxt "Choix"
msgid "You are just being too sensitive about a game."
msgstr "Tu es juste trop susceptible pour un jeu."

# Traduction IA – à relire
#: chance_d20/Chance_hate_b/0/20/s/0
msgctxt "Choix"
msgid "Games are for children anyway."
msgstr "Les jeux, c'est pour les gamins, de toute façon."

# Traduction IA – à relire
#: chance_d20/Chance_hate_b/0/g-0/0
msgctxt "Chance"
msgid "You must have a zero for perception."
msgstr "Tu dois avoir zéro en perception."

# Traduction IA – à relire
#: chance_d20/Chance_hate_b/0/g-0/8
msgctxt "Chance"
msgid "We are done here. The campaign of us? Over."
msgstr "C'est fini. La campagne de nous deux ? Terminée."

# Traduction IA – à relire
#: chance_d20/Chance_hate_b/0/g-0/16
msgctxt "Chance"
msgid "If you could leave, that would be great. Just leave your character sheet. You won't need it again."
msgstr "Si tu pouvais partir, ce serait super. Laisse juste ta feuille de personnage. Tu n'en auras plus besoin."

# Traduction IA – à relire
#: chance_d20/chance_love_return/0/0
msgctxt "Chance"
msgid "Holy Crit, you look fantastic today."
msgstr "Nom d'un crit, tu es superbe aujourd'hui."

# Traduction IA – à relire
#: chance_d20/chance_love_return/0/8
msgctxt "Chance"
msgid "I've been thinking about you. Maybe we can get into some fun later?"
msgstr "J'ai pensé à toi. On pourrait peut-être s'amuser un peu, plus tard ?"

# Traduction IA – à relire
#: chance_d20/chance_love_return/0/16
msgctxt "Chance"
msgid "I'd love to play a game with you."
msgstr "J'adorerais faire une partie avec toi."

# Traduction IA – à relire
#: chance_d20/chance_love_return/0/24
msgctxt "Chance"
msgid "But don't worry, I'd never play with your heart."
msgstr "Mais ne t'inquiète pas, je ne jouerai jamais avec ton cœur."

# Traduction IA – à relire
#: chance_d20/chance_love_return/0/32/s/0
msgctxt "Choix"
msgid "I know you wouldn't. And that's why I love you!"
msgstr "Je sais bien. Et c'est pour ça que je t'aime !"

# Traduction IA – à relire
#: chance_d20/chance_love_return/0/33/s/0 chance_d20/chance_friend_return/0/25/s/0
msgctxt "Choix"
msgid "Do you have any more campaigns for me to play?"
msgstr "Tu as d'autres campagnes à me faire jouer ?"

# Traduction IA – à relire
#: chance_d20/chance_love_return/0/34/s/0
msgctxt "Choix"
msgid "I know. That's why I want to Realize you!"
msgstr "Je sais. C'est pour ça que je veux te Réaliser !"

# Traduction IA – à relire
#: chance_d20/chance_love_return/0/c-0/7
msgctxt "Chance"
msgid "And that's a crit to make me smile."
msgstr "Et voilà un crit qui me donne le sourire."

# Traduction IA – à relire
#: chance_d20/chance_love_return/0/c-1/7 chance_d20/chance_friend_return/0/c-1/7
msgctxt "Chance"
msgid "So many more... so many..."
msgstr "Tellement d'autres... tellement..."

# Traduction IA – à relire
#: chance_d20/chance_love_return/0/c-1/15 chance_d20/chance_friend_return/0/c-1/15
msgctxt "Chance"
msgid "But... not just yet."
msgstr "Mais... pas tout de suite."

# Traduction IA – à relire
#: chance_d20/chance_love_return/0/c-1/23 chance_d20/chance_friend_return/0/c-1/23
msgctxt "Chance"
msgid "I need more inspiration... and the one thing that always helps with writing campaigns is... guilt and deadlines!"
msgstr "J'ai besoin de plus d'inspiration... et la seule chose qui aide toujours à écrire des campagnes, c'est... la culpabilité et les dates limites !"

# Traduction IA – à relire
#: chance_d20/chance_love_return/0/c-1/31
msgctxt "Chance"
msgid "Since I don't have any of those... I might just take a break."
msgstr "Comme je n'ai ni l'une ni les autres... je vais peut-être faire une pause."

# Traduction IA – à relire
#: chance_d20/chance_friend_return/0/0
msgctxt "Chance"
msgid "Hey there pal!"
msgstr "Salut, l'ami{{|e|·e}} !"

# Traduction IA – à relire
#: chance_d20/chance_friend_return/0/8
msgctxt "Chance"
msgid "Hopefully luck has been on your side."
msgstr "J'espère que la chance a été de ton côté."

# Traduction IA – à relire
#: chance_d20/chance_friend_return/0/16
msgctxt "Chance"
msgid "May every day be an adventure for you!"
msgstr "Que chaque jour soit une aventure pour toi !"

# Traduction IA – à relire
#: chance_d20/chance_friend_return/0/24/s/0
msgctxt "Choix"
msgid "As long as we are friends, I'm positive it will be!"
msgstr "Tant qu'on est amis, j'en suis {{sûr|sûre|sûr·e}} !"

# Traduction IA – à relire
#: chance_d20/chance_friend_return/0/26/s/0
msgctxt "Choix"
msgid "I want to Realize you! Then you can have a REAL adventure!"
msgstr "Je veux te Réaliser ! Comme ça, tu pourras vivre une VRAIE aventure !"

# Traduction IA – à relire
#: chance_d20/chance_friend_return/0/c-0/7
msgctxt "Chance"
msgid "Huzahh!"
msgstr "Huzzah !"

# Traduction IA – à relire
#: chance_d20/chance_friend_return/0/c-1/31
msgctxt "Chance"
msgid "Since I don't have any of those... I just might take a break."
msgstr "Comme je n'ai ni l'une ni les autres... je vais peut-être bien faire une pause."

# Traduction IA – à relire
#: chance_d20/chance_hate_return/0/0
msgctxt "Chance"
msgid "Oh... hey."
msgstr "Oh... salut."

# Traduction IA – à relire
#: chance_d20/chance_hate_return/0/8
msgctxt "Chance"
msgid "Sorry, I'm busy building out lore. I can't really talk right now."
msgstr "Désolé, je suis occupé à construire mon univers. Je ne peux pas vraiment parler, là."

# Traduction IA – à relire
#: chance_d20/chance_hate_return/0/16
msgctxt "Chance"
msgid "Besides... this is probably too nerdy for you anyway."
msgstr "Et puis... c'est sûrement trop geek pour toi, de toute façon."

# Traduction IA – à relire
#: chance_d20/chance_hate_return/0/24/s/0
msgctxt "Choix"
msgid "Yeah, way too nerdy for me. I'm gonna play a dating sim."
msgstr "Ouais, beaucoup trop geek pour moi. Je vais jouer à un jeu de drague."

# Traduction IA – à relire
#: chance_d20/chance_hate_return/0/25/s/0
msgctxt "Choix"
msgid "Is there a future where our friendship is more than a fantasy? (USE CHARM CANDY)"
msgstr "Y a-t-il un avenir où notre amitié serait plus qu'un fantasme ? (UTILISER UN BONBON DE CHARME)"

# Traduction IA – à relire
#: chance_d20/chance_hate_return/0/c-1/13
msgctxt "Chance"
msgid "That was... smooth."
msgstr "C'était... habile."

# Traduction IA – à relire
#: chance_d20/chance_hate_return/0/c-1/21
msgctxt "Chance"
msgid "Are you rolling to charm me?"
msgstr "Tu fais un jet pour me charmer ?"

# Traduction IA – à relire
#: chance_d20/chance_hate_return/0/c-1/29/0/s/0
msgctxt "Choix"
msgid "Is it working?"
msgstr "Ça marche ?"

# Traduction IA – à relire
#: chance_d20/chance_hate_return/0/c-1/29/1/s/0
msgctxt "Choix"
msgid "Maaaaybe?"
msgstr "Peut-êêêtre ?"

# Traduction IA – à relire
#: chance_d20/chance_hate_return/0/c-1/29/g-0/0
msgctxt "Chance"
msgid "I must admit... I have a weakness to charming people such as yourself."
msgstr "Je dois l'avouer... j'ai un faible pour les gens charmants comme toi."

# Traduction IA – à relire
#: chance_d20/chance_hate_return/0/c-1/29/g-0/8
msgctxt "Chance"
msgid "Oh, Crit. Okay. Fine. Yes."
msgstr "Oh, crit. D'accord. Bon. Oui."

# Traduction IA – à relire
#: chance_d20/chance_hate_return/0/c-1/29/g-0/16
msgctxt "Chance"
msgid "In the land of Friendship two people meet in a tavern. One is me... the other is you."
msgstr "Au pays de l'Amitié, deux personnes se rencontrent dans une taverne. L'une, c'est moi... l'autre, c'est toi."

# Traduction IA – à relire
#: chance_d20/chance_hate_return/0/c-1/29/g-0/24/0/s/0
msgctxt "Choix"
msgid "We are friends again?"
msgstr "On est de nouveau amis ?"

# Traduction IA – à relire
#: chance_d20/chance_hate_return/0/c-1/29/g-0/24/c-0/10
msgctxt "Chance"
msgid "You are no longer an NPC."
msgstr "Tu n'es plus un PNJ."

# Traduction IA – à relire
#: chance_d20/chance_friend_candy_return/0/0
msgctxt "Chance"
msgid "Hey there."
msgstr "Salut."

# Traduction IA – à relire
#: chance_d20/chance_friend_candy_return/0/8
msgctxt "Chance"
msgid "It’s good to see you around! Do you wanna...?"
msgstr "Ça fait plaisir de te voir dans le coin ! Tu veux... ?"

# Traduction IA – à relire
#: chance_d20/chance_friend_candy_return/0/16
msgctxt "Chance"
msgid "Wait... never mind. I know the answer to that."
msgstr "Attends... laisse tomber. Je connais déjà la réponse."

# Traduction IA – à relire
#: chance_d20/chance_friend_candy_return/0/32
msgctxt "Chance"
msgid "Holy Crit, making friends can be hard."
msgstr "Nom d'un crit, c'est dur de se faire des amis."

# Traduction IA – à relire
#: chance_d20/chance_friend_candy_return/0/40/b/1
msgctxt "Chance"
msgid "I really don’t know what we should talk about. All I have in my mind are maps and cool names of townsfolk and tavern keeps."
msgstr "Je ne sais vraiment pas de quoi on pourrait parler. J'ai la tête pleine de cartes et de noms trop cool de villageois et de taverniers."

# Traduction IA – à relire
#: chance_d20/chance_friend_candy_return/0/43/b/1
msgctxt "Chance"
msgid "I still appreciate you trying the game out. I know it wasn’t your thing, but you gave it a go."
msgstr "J'apprécie quand même que tu aies essayé le jeu. Je sais que ce n'était pas ton truc, mais tu as tenté le coup."

# Traduction IA – à relire
#: chance_d20/chance_friend_candy_return/0/46/s/0
msgctxt "Choix"
msgid "It's okay - just wanted to catch up."
msgstr "C'est bon, je voulais juste prendre des nouvelles."

# Traduction IA – à relire
#: chance_d20/chance_friend_candy_return/0/47/s/0
msgctxt "Choix"
msgid "I'm actually here to Realize you, Chance."
msgstr "En fait, je suis venu{{|e|·e}} te Réaliser, Chance."

# Traduction IA – à relire
#: chance_d20/chance_friend_candy_return/0/c-0/7
msgctxt "Chance"
msgid "I'm still glad you came by. It is always good to see your face!"
msgstr "Je suis quand même content que tu sois passé{{|e|·e}}. Ça fait toujours plaisir de voir ta tête !"

# Traduction IA – à relire
#: chance_d20/chance_realize_join/0/0
msgctxt "Chance"
msgid "Holy Crit, really?! You want to Realize me?!"
msgstr "Nom d'un crit, c'est vrai ?! Tu veux me Réaliser ?!"

# Traduction IA – à relire
#: chance_d20/chance_realize_join/0/8
msgctxt "Chance"
msgid "That's outstanding! In all my rolls, I never thought I would have a REAL adventure!"
msgstr "C'est extraordinaire ! De tous mes jets, je n'aurais jamais cru vivre une VRAIE aventure !"

# Traduction IA – à relire
#: chance_d20/chance_realize_join/0/16
msgctxt "Chance"
msgid "I take it you have the required Stat Allocation?"
msgstr "Je suppose que tu as la répartition de caractéristiques requise ?"

# Traduction IA – à relire
#: chance_d20/chance_realize_join/0/33/s/0
msgctxt "Choix"
msgid "You bet I do!"
msgstr "Et comment !"

# Traduction IA – à relire
#: chance_d20/chance_realize_join/0/34/s/0
msgctxt "Choix"
msgid "I need a few more quests, then I'll be ready!"
msgstr "Il me faut encore quelques quêtes, et je serai {{prêt|prête|prêt·e}} !"

# Traduction IA – à relire
#: chance_d20/chance_realize_join/0/c-1/10
msgctxt "Chance"
msgid "Ah yes, sometimes a level up is needed to unlock what you need!"
msgstr "Ah oui, parfois il faut monter de niveau pour débloquer ce dont on a besoin !"

# Traduction IA – à relire
#: chance_d20/chance_realize_join/0/c-1/18
msgctxt "Chance"
msgid "Go forth, my courageous companion! I shall wait for you here!"
msgstr "Va, {{mon courageux compagnon|ma courageuse compagne|mon être courageux}} ! Je t'attendrai ici !"

# Traduction IA – à relire
#: chance_d20/chance_realize_return/0/0
msgctxt "Chance"
msgid "You have returned! Did your journeys provide you with the necessary boons?"
msgstr "Te voilà de retour ! Tes périples t'ont-ils apporté les bonus nécessaires ?"

# Traduction IA – à relire
#: chance_d20/chance_realize_return/0/17/s/0
msgctxt "Choix"
msgid "They sure did! I'm ready to Realize you!"
msgstr "Et comment ! Je suis {{prêt|prête|prêt·e}} à te Réaliser !"

# Traduction IA – à relire
#: chance_d20/chance_realize_return/0/18/s/0
msgctxt "Choix"
msgid "I need a bit more time, I think."
msgstr "Il me faut encore un peu de temps, je crois."

# Traduction IA – à relire
#: chance_d20/chance_realize_return/0/c-1/10
msgctxt "Chance"
msgid "Worry not. I shall be here, steadfast and patient."
msgstr "Point d'inquiétude. Je serai là, fidèle et patient."

# Traduction IA – à relire
#: chance_d20/chance_realize_begin/6/b/1
msgctxt "Skylar"
msgid "Starting with the d20, huh? Don't worry... I've got a saving-throw system built-in just in case..."
msgstr "On commence par le d20, hein ? T'inquiète... j'ai un système de jet de sauvegarde intégré, au cas où..."

# Traduction IA – à relire
#: chance_d20/chance_realize_begin/6/b/9
msgctxt "Skylar"
msgid "Here's hoping this works!"
msgstr "Croisons les doigts pour que ça marche !"

# Traduction IA – à relire
#: chance_d20/chance_realize_begin/7/b/1
msgctxt "Skylar"
msgid "Chance! Let's start your next campaign..."
msgstr "Chance ! Lançons ta prochaine campagne..."

# Traduction IA – à relire
#: chance_d20/chance_realize_begin/13
msgctxt "Narrator"
msgid "The spectral energy flows through your dateviators, and what was once merely a 20 sided die, becomes..."
msgstr "L'énergie spectrale traverse vos Dateviators, et ce qui n'était qu'un simple dé à 20 faces devient..."

# Traduction IA – à relire
#: chance_d20/chance_realized/0/3
msgctxt "Chance"
msgid "Holy Crit! Will you look at that? I have taken on a new form!"
msgstr "Nom d'un crit ! Regarde-moi ça ! J'ai pris une nouvelle forme !"

# Traduction IA – à relire
#: chance_d20/chance_realized/0/11
msgctxt "Chance"
msgid "I wonder what my new movement speed is!"
msgstr "Je me demande quelle est ma nouvelle vitesse de déplacement !"

# Traduction IA – à relire
#: chance_d20/chance_realized/0/19/s/0
msgctxt "Choix"
msgid "You look fantastic!"
msgstr "Tu es superbe !"

# Traduction IA – à relire
#: chance_d20/chance_realized/0/20/s/0
msgctxt "Choix"
msgid "What do I have to roll to get you to roll more than dice with me?"
msgstr "Je dois faire combien pour que tu me roules autre chose que des dés... genre une pelle ?"

# Traduction IA – à relire
#: chance_d20/chance_realized/0/c-0/7
msgctxt "Chance"
msgid "Why, thank you. I owe this new adventure to you and your kindness."
msgstr "Eh bien, merci. Je dois cette nouvelle aventure à toi et à ta gentillesse."

# Traduction IA – à relire
#: chance_d20/chance_realized/0/c-0/15
msgctxt "Chance"
msgid "Thank you!"
msgstr "Merci !"

# Traduction IA – à relire
#: chance_d20/chance_realized/0/c-1/15
msgctxt "Chance"
msgid "You automatically succeed that check!"
msgstr "Tu réussis ce jet automatiquement !"

# Traduction IA – à relire
#: chance_d20/chance_realized/0/c-1/23
msgctxt "Chance"
msgid "You have yourself a VERY willing creature here."
msgstr "Tu as devant toi une créature TRÈS consentante."

# Traduction IA – à relire
#: chance_d20/chance_realize_love_path/0
msgctxt "Chance"
msgid "Wait... I want to roll a couple thiiiiiings..."
msgstr "Attends... je veux lancer deux-trois truuuucs..."

# Traduction IA – à relire
#: chance_d20/chance_realize_love_path/8
msgctxt "Chance"
msgid "Hrm..."
msgstr "Hmm..."

# Traduction IA – à relire
#: chance_d20/chance_realize_love_path/16
msgctxt "Chance"
msgid "A nine and a six..."
msgstr "Un six et un neuf..."

# Traduction IA – à relire
#: chance_d20/chance_realize_love_path/32
msgctxt "Chance"
msgid "I think we can make those numbers work."
msgstr "Je crois qu'on peut tirer quelque chose de ces chiffres."

# Traduction IA – à relire
#: chance_d20/chance_realize_love_path/43
msgctxt "Narrator"
msgid "And you do. As you would imagine, Chance is ready to go with any roleplay you might fancy."
msgstr "Et c'est ce que vous faites. Comme vous pouvez l'imaginer, Chance est partant pour n'importe quel jeu de rôle qui vous ferait envie."

# Traduction IA – à relire
#: chance_d20/chance_realize_love_path/51
msgctxt "Narrator"
msgid "And the voices... oh the voices."
msgstr "Et les voix... oh, les voix."

# Traduction IA – à relire
#: chance_d20/chance_realize_friend_join/0
msgctxt "Narrator"
msgid "Chance vowed to keep the love of G&G alive, and he went out LFG."
msgstr "Chance fit le serment de garder vivante la passion de G&G, et partit en quête d'un groupe."

# Traduction IA – à relire
#: chance_d20/chance_realize_friend_join/5
msgctxt "Narrator"
msgid "Upon entering human society, he noticed something peculiar."
msgstr "En entrant dans la société humaine, il remarqua une chose étrange."

# Traduction IA – à relire
#: chance_d20/chance_realize_friend_join/10
msgctxt "Narrator"
msgid "There were children who did not know the joy of creating worlds and working out the complexities of life through play."
msgstr "Il y avait des enfants qui ignoraient la joie de créer des mondes et de démêler les complexités de la vie par le jeu."

# Traduction IA – à relire
#: chance_d20/chance_realize_friend_join/15
msgctxt "Narrator"
msgid "There were adults who were stuck in their own misfortunes, but didn't have the tools of imagination to work through them."
msgstr "Il y avait des adultes coincés dans leurs propres malheurs, mais dépourvus des outils de l'imagination pour s'en sortir."

# Traduction IA – à relire
#: chance_d20/chance_realize_friend_join/20
msgctxt "Chance"
msgid "It seems... I have a quest of my own!"
msgstr "On dirait... que j'ai ma propre quête !"

# Traduction IA – à relire
#: chance_d20/chance_realize_friend_join/28
msgctxt "Narrator"
msgid "Chance quickly enrolled in classes for Psychology, Literature, and Creative Writing, building up his stats with one mission in mind."
msgstr "Chance s'inscrivit aussitôt à des cours de psychologie, de littérature et d'écriture créative, montant ses caractéristiques avec une seule mission en tête."

# Traduction IA – à relire
#: chance_d20/chance_realize_friend_join/36
msgctxt "Narrator"
msgid "After graduating with a few certifications, he opened up his table again to those who seek adventure...."
msgstr "Une fois diplômé et muni de quelques certifications, il rouvrit sa table à ceux qui cherchaient l'aventure..."

# Traduction IA – à relire
#: chance_d20/chance_realize_friend_join/44
msgctxt "Narrator"
msgid "Except this time, he used the game of G&G to help those who have experienced hardship process and grow from their experiences."
msgstr "Sauf que cette fois, il se servit de G&G pour aider ceux qui avaient traversé des épreuves à les surmonter et à en ressortir grandis."

# Traduction IA – à relire
#: chance_d20/chance_realize_friend_join/52
msgctxt "Narrator"
msgid "He went on to create the largest tabletop therapy clinic in the city."
msgstr "Il finit par créer le plus grand cabinet de thérapie par le jeu de rôle de la ville."

# Traduction IA – à relire
#: chance_d20/chance_realize_friend_join/60
msgctxt "Chance"
msgid "Please sit down... this is a safe space."
msgstr "Je t'en prie, assieds-toi... ici, tu es en sécurité."

# Traduction IA – à relire
#: chance_d20/chance_realize_friend_join/68
msgctxt "Chance"
msgid "Now... how do you want to do this?"
msgstr "Alors... comment veux-tu procéder ?"

# Traduction IA – à relire
#: chance_d20/chance_realize_friend_join/79
msgctxt "Narrator"
msgid "Many entered his doors - and all left feeling a little lighter, a little braver."
msgstr "Beaucoup franchirent sa porte, et tous repartirent un peu plus légers, un peu plus courageux."

# Traduction IA – à relire
#: chance_d20/chance_realize_friend_join/87
msgctxt "Narrator"
msgid "And just a bit more critical."
msgstr "Et avec un peu plus d'esprit critique."
