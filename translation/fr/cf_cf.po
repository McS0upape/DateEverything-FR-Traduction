#: cf_cf/cf_ceilingsorter/4
msgctxt "Tag Nom d'objet (MAJUSCULES)"
msgid "CEILING"
msgstr ""

#: cf_cf/cf_floorsorter/1
msgctxt "Tag Nom d'objet (MAJUSCULES)"
msgid "FLOOR"
msgstr ""

#: cf_cf/cf_1st_encounter_florence/0
msgctxt "Florence"
msgid "Be there in a moment!"
msgstr ""

#: cf_cf/cf_1st_encounter_florence/8 cf_cf/cf_1st_encounter_celia/3
msgctxt "Narrator"
msgid "An utterly charming secretary hurries into view, giving you an apologetic nod."
msgstr ""

#: cf_cf/cf_1st_encounter_florence/16
msgctxt "Florence"
msgid "Hello there. What can I do for you?"
msgstr ""

#: cf_cf/cf_1st_encounter_florence/24 cf_cf/cf_1st_encounter_celia/27
msgctxt "Narrator"
msgid "Her greeting is cut short as she seems to recognize you mid-sentence."
msgstr ""

#: cf_cf/cf_1st_encounter_florence/32 cf_cf/cf_1st_encounter_appointment/0/c-1/7 cf_cf/florence_part1/0/g-0/24 cf_cf/cf_realize_return/0/8
msgctxt "Florence"
msgid "Oh!"
msgstr ""

#: cf_cf/cf_1st_encounter_florence/40
msgctxt "Florence"
msgid "Oh my goodness gracious! It's the human!"
msgstr ""

#: cf_cf/cf_1st_encounter_florence/54
msgctxt "Florence"
msgid "W-Well, I wasn't expecting you today! Golly, I must look an absolute mess."
msgstr ""

#: cf_cf/cf_1st_encounter_florence/62
msgctxt "Florence"
msgid "You must be here for Mayor Celia."
msgstr ""

#: cf_cf/cf_1st_encounter_celia/11
msgctxt "Florence"
msgid "Excuse me!"
msgstr ""

#: cf_cf/cf_1st_encounter_celia/19
msgctxt "Florence"
msgid "I'm sorry, I'm afraid Miss Mayor is quite busy at the moment. She has a whole line of meetings going out the door. You'll have to wait until..."
msgstr ""

#: cf_cf/cf_1st_encounter_celia/35
msgctxt "Florence"
msgid "Oh! Oh, oh my goodness gracious! It's the human!"
msgstr ""

#: cf_cf/cf_1st_encounter_celia/49
msgctxt "Florence"
msgid "W-Well, I wasn't expecting you today! Gosh, I must look an absolute mess..."
msgstr ""

#: cf_cf/cf_1st_encounter_celia/57 cf_cf/florence_part2/0/15/b/1
msgctxt "Florence"
msgid "I presume you're here to see Mayor Celia?"
msgstr ""

#: cf_cf/cf_1st_encounter_1/0/0/s/0
msgctxt "Choix"
msgid "Yes, I'm here to see Celia."
msgstr ""

#: cf_cf/cf_1st_encounter_1/0/1/s/0
msgctxt "Choix"
msgid "Mayor Celia?"
msgstr ""

#: cf_cf/cf_1st_encounter_1/0/2/s/0
msgctxt "Choix"
msgid "How are you, Florence?"
msgstr ""

#: cf_cf/cf_1st_encounter_1/0/3/s/0
msgctxt "Choix"
msgid "Just wandering around. Who are you?"
msgstr ""

#: cf_cf/cf_1st_encounter_1/0/c-0/7
msgctxt "Florence"
msgid "Of course! She's in a series of meetings at the moment, but I can pencil you in to see her as soon as possible."
msgstr ""

#: cf_cf/cf_1st_encounter_1/0/c-1/7
msgctxt "Florence"
msgid "Oh! You don't know!"
msgstr ""

#: cf_cf/cf_1st_encounter_1/0/c-1/15
msgctxt "Florence"
msgid "I completely understand. You must be such a busy bee, running around and taking care of all of us here in the house."
msgstr ""

#: cf_cf/cf_1st_encounter_1/0/c-1/23
msgctxt "Florence"
msgid "Who would have the time to remember every little detail?"
msgstr ""

#: cf_cf/cf_1st_encounter_1/0/c-1/31
msgctxt "Florence"
msgid "Mayor Celia runs things around here! Keeps an eye on all the citizens. Makes sure the wheels are greased so nothin' squeaks."
msgstr ""

#: cf_cf/cf_1st_encounter_1/0/c-1/39
msgctxt "Florence"
msgid "You know, that sort of thing."
msgstr ""

#: cf_cf/cf_1st_encounter_1/0/c-1/47
msgctxt "Florence"
msgid "I help her out where I can... (But if we're being honest she does most of the heavy lifting around here.)"
msgstr ""

#: cf_cf/cf_1st_encounter_1/0/c-1/55
msgctxt "Florence"
msgid "Keeps a roof over everyone's heads."
msgstr ""

#: cf_cf/cf_1st_encounter_1/0/c-1/63
msgctxt "Florence"
msgid "Literally. She's the ceiling."
msgstr ""

#: cf_cf/cf_1st_encounter_1/0/c-1/71 cf_cf/cf_1st_encounter_1/0/c-3/31
msgctxt "Florence"
msgid "I could pencil you in for an appointment, if you'd like?"
msgstr ""

#: cf_cf/cf_1st_encounter_1/0/c-2/13
msgctxt "Florence"
msgid "Oh! I'm fine. Great, even!"
msgstr ""

#: cf_cf/cf_1st_encounter_1/0/c-2/21
msgctxt "Florence"
msgid "Surprised that you even remembered little old me. Means the world."
msgstr ""

#: cf_cf/cf_1st_encounter_1/0/c-2/29
msgctxt "Florence"
msgid "The mayor's a little busy today, but I can pencil you in to see her as soon as possible, if you like?"
msgstr ""

#: cf_cf/cf_1st_encounter_1/0/c-3/7
msgctxt "Florence"
msgid "Me? Oh, I'm nobody. Nobody at all. Just Mayor Celia's assistant."
msgstr ""

#: cf_cf/cf_1st_encounter_1/0/c-3/15
msgctxt "Florence"
msgid "I do odd jobs here and there. File papers and licking stamps."
msgstr ""

#: cf_cf/cf_1st_encounter_1/0/c-3/23
msgctxt "Florence"
msgid "The mayor's up in her office doing the real work. Whole line a' folks lined up outside her door now."
msgstr ""

#: cf_cf/cf_1st_encounter_appointment/0/0/s/0
msgctxt "Choix"
msgid "You sound like a great PA. If it helps you look good to your boss, I'd be glad to."
msgstr ""

#: cf_cf/cf_1st_encounter_appointment/0/1/s/0
msgctxt "Choix"
msgid "I'd like to see her now, actually."
msgstr ""

#: cf_cf/cf_1st_encounter_appointment/0/c-0/7
msgctxt "Florence"
msgid "Oh! Well..."
msgstr ""

#: cf_cf/cf_1st_encounter_appointment/0/c-0/15
msgctxt "Narrator"
msgid "She twirls a strand of dark hair around her finger, blushing sweetly."
msgstr ""

#: cf_cf/cf_1st_encounter_appointment/0/c-1/15
msgctxt "Florence"
msgid "Oh, of course! I'm so sorry!"
msgstr ""

#: cf_cf/cf_1st_encounter_appointment/0/c-1/23
msgctxt "Florence"
msgid "What am I thinking? You are <i>the human</i>, after all. It is your house! Why should you have to wait?"
msgstr ""

#: cf_cf/cf_1st_encounter_appointment/0/c-1/31
msgctxt "Florence"
msgid "Here, right this way. I'll take you up to her office."
msgstr ""

#: cf_cf/cf_1st_encounter_appointment/0/c-1/39
msgctxt "Florence"
msgid "She still has a few appointments lined up, but knowing her she'll be done in a jiff!"
msgstr ""

#: cf_cf/cf_1st_encounter_tea_prelude/0/0
msgctxt "Florence"
msgid "Would you care for some tea while you wait?"
msgstr ""

#: cf_cf/cf_1st_encounter_tea_prelude/0/8/s/0
msgctxt "Choix"
msgid "Yes, please."
msgstr ""

#: cf_cf/cf_1st_encounter_tea_prelude/0/9/s/0
msgctxt "Choix"
msgid "No, that's alright."
msgstr ""

#: cf_cf/cf_1st_encounter_tea_prelude/0/c-1/7
msgctxt "Florence"
msgid "Okey-dokey. I'll let you know the minute she's available."
msgstr ""

#: cf_cf/cf_1st_encounter_tea_prelude/0/c-1/15
msgctxt "Florence"
msgid "And let me know if you change your mind about that tea!"
msgstr ""

#: cf_cf/cf_1st_encounter_tea_prelude/0/c-1/23/0/s/0
msgctxt "Choix"
msgid "<i>Change your mind about the tea.</i>"
msgstr ""

#: cf_cf/cf_1st_encounter_tea_prelude/0/c-1/23/1/s/0
msgctxt "Choix"
msgid "<i>Never. Your mind is made up. No tea shall pass these lips on this day, so help you God.</i>"
msgstr ""

#: cf_cf/cf_1st_encounter_tea_prelude/0/c-1/23/c-0/7
msgctxt "Florence"
msgid "Coming right up!"
msgstr ""

#: cf_cf/cf_1st_encounter_tea_prelude/0/c-1/23/c-1/7
msgctxt "Florence"
msgid "She should be free in just a second."
msgstr ""

#: cf_cf/cf_1st_encounter_tea_prelude/0/c-1/23/c-1/15
msgctxt "Florence"
msgid "Hmm hmm hmm~ ?"
msgstr ""

#: cf_cf/cf_1st_encounter_tea_prelude/0/c-1/23/c-1/23
msgctxt "Florence"
msgid "Ah, there we go. Thanks for waiting. I'll take you up to her office."
msgstr ""

#: cf_cf/cf_1st_encounter_tea_prelude/0/c-1/23/c-1/31
msgctxt "Florence"
msgid "She still has a few appointments lined up, but knowing her she'll be done in a jiff! You can head on up, if you like."
msgstr ""

#: cf_cf/cf_firstencounter_1_tea/0/0
msgctxt "Florence"
msgid "Perfect timing! Just so happens I've got a kettle all nice and ready."
msgstr ""

#: cf_cf/cf_firstencounter_1_tea/0/8
msgctxt "Florence"
msgid "How do you take it?"
msgstr ""

#: cf_cf/cf_firstencounter_1_tea/0/16/s/0
msgctxt "Choix"
msgid "Plain is okay."
msgstr ""

#: cf_cf/cf_firstencounter_1_tea/0/17/s/0
msgctxt "Choix"
msgid "Milk and sugar, please."
msgstr ""

#: cf_cf/cf_firstencounter_1_tea/0/18/s/0
msgctxt "Choix"
msgid "With a shot of whiskey."
msgstr ""

#: cf_cf/cf_firstencounter_1_tea/0/c-0/7
msgctxt "Florence"
msgid "Coming up!"
msgstr ""

#: cf_cf/cf_firstencounter_1_tea/0/c-0/15
msgctxt "Florence"
msgid "(I'll use the nice cup since you're a VIP. Don't tell the others, though! Wink!)"
msgstr ""

#: cf_cf/cf_firstencounter_1_tea/0/c-0/23
msgctxt "Florence"
msgid "...probably could'a just winked my eye instead'a sayin' it out loud, huh?"
msgstr ""

#: cf_cf/cf_firstencounter_1_tea/0/c-1/13
msgctxt "Florence"
msgid "Oh! That's my favorite too. I think I'll pour myself a cup while I'm at it."
msgstr ""

#: cf_cf/cf_firstencounter_1_tea/0/c-2/7
msgctxt "Florence"
msgid "Well!"
msgstr ""

#: cf_cf/cf_firstencounter_1_tea/0/c-2/15
msgctxt "Florence"
msgid "Normally I wouldn't offer that sort of thing, being a civil servant and all, but you are a VIP!"
msgstr ""

#: cf_cf/cf_firstencounter_1_tea/0/c-2/23
msgctxt "Florence"
msgid "(You didn't hear it from me, but sometimes the mayor likes a little Irish in the cup herself.)"
msgstr ""

#: cf_cf/cf_firstencounter_1_tea/0/c-2/31
msgctxt "Florence"
msgid "Too much for me, personally. I'm a sugar gal."
msgstr ""

#: cf_cf/cf_firstencounter_1_tea/0/c-2/39
msgctxt "Florence"
msgid "Here you are!"
msgstr ""

#: cf_cf/cf_firstencounter_1_tea/0/g-0/0
msgctxt "Florence"
msgid "Wh... whoa! <w>Aaaah!</w>"
msgstr ""

#: cf_cf/cf_firstencounter_1_tea/0/g-0/8
msgctxt "Narrator"
msgid "Florence stumbles, pitching forward onto her hands and knees. The tea spills all over the floor, though thankfully the cup doesn't shatter."
msgstr ""

#: cf_cf/cf_firstencounter_1_tea/0/g-0/29
msgctxt "Florence"
msgid "Ooh... oh no! Gosh, that just spilled everywhere."
msgstr ""

#: cf_cf/cf_firstencounter_1_tea/0/g-0/40
msgctxt "Florence"
msgid "And right on the carpet of my good jacket... Ohh, that's gonna stain!"
msgstr ""

#: cf_cf/cf_firstencounter_1_tea/0/g-0/48
msgctxt "Florence"
msgid "I'm so sorry dear, I need to dab this out with a towel right away!"
msgstr ""

#: cf_cf/cf_firstencounter_1_tea/0/g-0/56
msgctxt "Florence"
msgid "Erm. W-Would it be alright if you showed yourself up to the mayor's office? Just this once?"
msgstr ""

#: cf_cf/cf_firstencounter_1_tea/0/g-0/64/s/0
msgctxt "Choix"
msgid "Sure, don't worry about it."
msgstr ""

#: cf_cf/cf_firstencounter_1_tea/0/g-0/65/s/0
msgctxt "Choix"
msgid "But... my tea..."
msgstr ""

#: cf_cf/cf_firstencounter_1_tea/0/g-0/c-3/13
msgctxt "Florence"
msgid "Thank you so much, dear. Sorry again about the tea! Aaagh... please don't tell the mayor about this!"
msgstr ""

#: cf_cf/cf_firstencounter_1_tea/0/g-0/c-4/13
msgctxt "Florence"
msgid "Oh... r-right! Erm... I'll make it again first. So sorry about that..."
msgstr ""

#: cf_cf/cf_firstencounter_1_tea/0/g-0/c-4/21
msgctxt "Florence"
msgid "<i>Aagh, c'mon Florence! Get it together!</i>"
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/9
msgctxt "Narrator"
msgid "There she is, the mayor herself—she simply radiates poise and power. She's an intimidating sort of beauty, but you find yourself intrigued to learn more about her."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/28
msgctxt "Celia"
msgid "So... in summary..."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/36
msgctxt "Beverly"
msgid "I just think if I could get a little more foot traffic around my bar I'd get more business!"
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/47
msgctxt "Celia"
msgid "Oh, Beverly, I understand your concerns. But what do you expect us to do, dear? We already put up posters and held fundraisers."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/55
msgctxt "Celia"
msgid "We can't just move the fridge, stove, toilet, and everyone else out of the way to clear foot traffic every night."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/63
msgctxt "Beverly"
msgid "We could try that!"
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/71
msgctxt "Celia"
msgid "<i>Bev.</i>"
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/79
msgctxt "Beverly"
msgid "Tch. Fine."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/87
msgctxt "Celia"
msgid "Trust me. We're doing everything that we can."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/95
msgctxt "Beverly"
msgid "Alright. But if nobody's in by next week, I'll be back!"
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/103
msgctxt "Celia"
msgid "I'm sure you will, darling."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/0
msgctxt "Narrator"
msgid "Celia presses an intercom button on her desk."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/11
msgctxt "Celia"
msgid "Florence, dearest? Send the next one in."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/19
msgctxt "Florence"
msgid "Yes, Miss."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/27
msgctxt "Mateo"
msgid "Uh... Hi."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/38
msgctxt "Celia"
msgid "Hello, Mateo. What can I do for you today?"
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/46
msgctxt "Mateo"
msgid "That's... um, that's a great question actually. Now that I'm here I can't even remember! Haha, isn't it funny how that always happens? Right when you need to think of something to say your brain just sort of goes blank."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/57
msgctxt "Mateo"
msgid "You know what, it was probably nothing. I don't want to waste your time, I know how busy you are. I'll just see myself out!"
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/65
msgctxt "Celia"
msgid "Mateo."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/73
msgctxt "Celia"
msgid "Come, sit."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/81
msgctxt "Celia"
msgid "Tell me what's bothering you."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/89
msgctxt "Mateo"
msgid "Right... it's just..."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/97
msgctxt "Celia"
msgid "Go on."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/105
msgctxt "Mateo"
msgid "It's Lux. They're kinda pulling cords around the house... refusing to pick up after themselves... keeping the whole bedroom up late with their streams..."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/119
msgctxt "Mateo"
msgid "It's really been stressful for the inanimals."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/127
msgctxt "Mateo"
msgid "And, I don't want to get anyone in trouble, but it's just been a lot and-"
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/135
msgctxt "Celia"
msgid "Alright, Mateo, alright. Lux, you said?"
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/143
msgctxt "Mateo"
msgid "Y-Yes, ma'am."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/151
msgctxt "Celia"
msgid "I'll have someone take care of it."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/159
msgctxt "Mateo"
msgid "Thank you..."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/178 cf_cf/cf_1st_encounter_2/0/118/239
msgctxt "Celia"
msgid "Next?"
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/189
msgctxt "Wallace"
msgid "Wall."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/200
msgctxt "Celia"
msgid "Hello, Wallace darling."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/208 cf_cf/cf_1st_encounter_2/0/118/225/b/1
msgctxt "Wallace"
msgid "WALL."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/216
msgctxt "Celia"
msgid "Yes, I remember from last week. It's on the docket."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/224/b/1
msgctxt "Wallace"
msgid "Ah my apologies. How can one forget the docket!"
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/228
msgctxt "Celia"
msgid "Think nothing of it."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/247
msgctxt "Celia"
msgid "Oh. It's you."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/255/b/1
msgctxt "Celia"
msgid "You're the one who was working on the junk drawer issue. Thanks again for that. Come in, come in."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/255/b/12
msgctxt "Celia"
msgid "Mayor Celia. I'm also the president of the HOA. That's \"Home Objects Association\"."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/256/b/1
msgctxt "Celia"
msgid "You're the one who puts on those... interesting plays with Chairemi. Come in, come in."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/256/b/9 cf_cf/cf_1st_encounter_2/0/118/257/b/9 cf_cf/cf_1st_encounter_2/0/118/258/b/9 cf_cf/cf_1st_encounter_2/0/118/259/b/1
msgctxt "Celia"
msgid "I don't believe we've formally met. Mayor Celia. I'm also the president of the HOA. That's \"Home Objects Association\"."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/257/b/1
msgctxt "Celia"
msgid "You're the one who puts on those delightful performances with Chairemi. Come in, come in."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/258/b/1
msgctxt "Celia"
msgid "Florence tells me you've been putting on some delightful performances with Chairemi. I'll have to make the time to see them later this week. Come in, come in."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/262/3
msgctxt "Celia"
msgid "Here's my card. But really, all you ever need to do if you need me is to simply look up."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/262/11
msgctxt "Celia"
msgid "What can I do for you today?"
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/262/22/s/0 cf_cf/cf_1st_encounter_2/0/118/262/c-2/31/g-0/78/0/s/0
msgctxt "Choix"
msgid "Nothing specific. I'm just going around talking to everyone."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/262/23/s/0
msgctxt "Choix"
msgid "Try to get the lay of the land, and I wanted to meet \"The Mayor\"."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/262/24/s/0 cf_cf/cf_raineyreturn/0/11/s/0
msgctxt "Choix"
msgid "I have a question about Rainey's past."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/262/c-2/7 cf_cf/cf_1st_encounter_no_detective/0/c-0/7 cf_cf/cf_raineyreturn/0/c-0/7
msgctxt "Celia"
msgid "Rainey? Ah... poor thing."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/262/c-2/15 cf_cf/cf_1st_encounter_no_detective/0/c-0/15 cf_cf/cf_raineyreturn/0/c-0/15 cf_cf/quickrainey/0/c-0/18
msgctxt "Celia"
msgid "She hasn't been quite the same since the incident..."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/262/c-2/23 cf_cf/cf_1st_encounter_no_detective/0/c-0/23 cf_cf/cf_raineyreturn/0/c-0/23
msgctxt "Celia"
msgid "What did you want to know?"
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/262/c-2/31/0/s/0 cf_cf/cf_1st_encounter_no_detective/0/c-0/31/0/s/0 cf_cf/cf_raineyreturn/0/c-0/31/0/s/0
msgctxt "Choix"
msgid "Why's her music all messed up?"
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/262/c-2/31/1/s/0 cf_cf/cf_1st_encounter_no_detective/0/c-0/31/1/s/0 cf_cf/cf_raineyreturn/0/c-0/31/1/s/0
msgctxt "Choix"
msgid "What's 'the incident?'"
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/262/c-2/31/g-0/0 cf_cf/cf_1st_encounter_2/0/cf_celiaquestionloop/c-10/31/c-0/7 cf_cf/cf_1st_encounter_no_detective/0/c-0/31/g-0/0 cf_cf/cf_raineyreturn/0/g-0/0
msgctxt "Celia"
msgid "...I see."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/262/c-2/31/g-0/8 cf_cf/cf_1st_encounter_2/0/cf_celiaquestionloop/c-10/31/c-0/15 cf_cf/cf_1st_encounter_no_detective/0/c-0/31/g-0/8 cf_cf/cf_raineyreturn/0/g-0/8
msgctxt "Celia"
msgid "It's a tragic affair, really. But I'm one of the only objects in this home old enough to tell it, so I suppose it falls to me."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/262/c-2/31/g-0/16 cf_cf/cf_1st_encounter_2/0/cf_celiaquestionloop/c-10/31/c-0/23 cf_cf/cf_1st_encounter_no_detective/0/c-0/31/g-0/16 cf_cf/cf_raineyreturn/0/g-0/16 cf_cf/quickrainey/0/c-0/26/c-0/7
msgctxt "Celia"
msgid "The long and short of it is that she was damaged during a party. A wild one, if memory serves."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/262/c-2/31/g-0/24 cf_cf/cf_1st_encounter_2/0/cf_celiaquestionloop/c-10/31/c-0/31 cf_cf/cf_1st_encounter_no_detective/0/c-0/31/g-0/24 cf_cf/cf_raineyreturn/0/g-0/24 cf_cf/quickrainey/0/c-0/26/c-0/15
msgctxt "Celia"
msgid "She was knocked down from her perch just as things were really getting going... it was a catastrophic fall."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/262/c-2/31/g-0/32 cf_cf/cf_1st_encounter_2/0/cf_celiaquestionloop/c-10/31/c-0/39 cf_cf/cf_1st_encounter_no_detective/0/c-0/31/g-0/32 cf_cf/cf_raineyreturn/0/g-0/32 cf_cf/quickrainey/0/g-1/0
msgctxt "Celia"
msgid "Here. I'll write everything down for you. Take this to Rainey and tell her about it. She'll have an easier time believing it if you've got written proof."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/262/c-2/31/g-0/43 cf_cf/cf_1st_encounter_2/0/cf_celiaquestionloop/c-10/31/c-0/47 cf_cf/cf_1st_encounter_no_detective/0/c-0/31/g-0/40 cf_cf/cf_raineyreturn/0/g-0/40 cf_cf/quickrainey/0/g-1/11
msgctxt "Narrator"
msgid "Celia writes something quickly on a memo pad, handing it over to you. You can't help but linger on her beautiful handwriting—it's just as grand and elegant as she is."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/262/c-2/31/g-0/51 cf_cf/cf_1st_encounter_2/0/cf_celiaquestionloop/c-10/31/c-0/55 cf_cf/cf_1st_encounter_no_detective/0/c-0/31/g-0/48 cf_cf/cf_raineyreturn/0/g-0/51 cf_cf/quickrainey/0/g-1/19
msgctxt "Celia"
msgid "She's a stubborn thing, but she still trusts me."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/262/c-2/31/g-0/59 cf_cf/cf_1st_encounter_2/0/cf_celiaquestionloop/c-10/31/c-0/69
msgctxt "Celia"
msgid "Now then..."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/262/c-2/31/g-0/70
msgctxt "Celia"
msgid "Was there anything else you needed?"
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/118/262/c-2/31/g-0/78/1/s/0
msgctxt "Choix"
msgid "I'm getting the lay of the land, and I wanted to meet \"The Mayor\"."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/g-1/0
msgctxt "Celia"
msgid "Well, then. Hello. Meeting successful."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/g-1/8
msgctxt "Celia"
msgid "Never a bad idea to make sure everybody knows your face. We're important here."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/g-1/16
msgctxt "Celia"
msgid "Some sit back and wait for others to plan things. Others simply do them. You and I? We're doers."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/g-1/24/s/0
msgctxt "Choix"
msgid "I dunno, I'm kind of an introvert to be honest..."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/g-1/25/s/0
msgctxt "Choix"
msgid "Absolutely."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/g-1/c-3/7
msgctxt "Celia"
msgid "That hardly precludes you from getting things done. It just means that you do them quietly."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/g-1/c-4/13
msgctxt "Celia"
msgid "I've seen you zipping back and forth around the house, running here and there."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/g-2/0
msgctxt "Celia"
msgid "You seem like a reliable sort. I wonder if I might ask you a favor?"
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/g-2/8
msgctxt "Celia"
msgid "It's about my assistant, Florence."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/g-2/16/s/0
msgctxt "Choix"
msgid "She seems sweet."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/g-2/17/s/0
msgctxt "Choix"
msgid "She seems distracted."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/g-2/18/s/0
msgctxt "Choix"
msgid "She spilled my tea."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/g-2/c-5/13
msgctxt "Celia"
msgid "She is an absolute dear."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/g-2/c-5/21
msgctxt "Celia"
msgid "Although sometimes, I fear it gets her into trouble."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/g-2/c-6/7
msgctxt "Celia"
msgid "Yes, that's exactly the issue."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/g-2/c-6/15
msgctxt "Celia"
msgid "She can be a bit clumsy sometimes... But she's been unusually out of sorts lately. I'm concerned."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/g-2/c-7/19
msgctxt "Celia"
msgid "I see. That is unfortunate."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/g-2/c-7/27
msgctxt "Celia"
msgid "She can be a bit clumsy sometimes, but she's been unusually out of sorts lately. Even for her."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/g-3/0
msgctxt "Celia"
msgid "She's such a kind thing... but that means she lets people walk all over her. Sometimes I worry the wrong sort might be taking advantage of her."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/g-3/8
msgctxt "Celia"
msgid "I've noticed that whenever we go to lunch together she never seems to buy herself anything."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/g-3/16
msgctxt "Celia"
msgid "What's more, she's been pinching every penny you've dropped on her like a miser. I suspect she might be having financial issues."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/g-3/24
msgctxt "Celia"
msgid "This office pays her well, of course. She's an invaluable assistant. I think it's possible someone might be fleecing her."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/g-3/32
msgctxt "Celia"
msgid "I'd like to formally ask for your help."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/g-3/40
msgctxt "Celia"
msgid "I may be her boss, but Florence would never give me a straight answer if she thought it might upset me."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/g-3/48
msgctxt "Celia"
msgid "However, she's quite friendly with strangers. And technically speaking, as the owner of the house, you outrank me. Maybe you could get something out of her?"
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/g-3/56
msgctxt "Celia"
msgid "What do you say? Would you do me a favor and look into this matter? Quietly?"
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/g-3/70/s/0
msgctxt "Choix"
msgid "Okay, I'll look into it."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/g-3/71/s/0
msgctxt "Choix"
msgid "I'm not that interested."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/g-3/c-8/17
msgctxt "Celia"
msgid "Thank you. I'll be waiting. Hopefully it's nothing."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/g-3/c-9/7
msgctxt "Celia"
msgid "Well. I suppose I can't force you. This is a private matter, after all."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/g-3/c-9/15
msgctxt "Celia"
msgid "If you happen to change your mind, I'll be here."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/cf_celiaquestionloop/3/b/1
msgctxt "Celia"
msgid "Stop doing that!"
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/cf_celiaquestionloop/6/b/1
msgctxt "Celia"
msgid "What else do you need?"
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/cf_celiaquestionloop/9/s/0
msgctxt "Choix"
msgid "Oh, real quick, Rainey wanted me to ask you something."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/cf_celiaquestionloop/10/s/0
msgctxt "Choix"
msgid "Tell me about Florence."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/cf_celiaquestionloop/11/s/0
msgctxt "Choix"
msgid "Just wanted to see you!"
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/cf_celiaquestionloop/12/s/0
msgctxt "Choix"
msgid "I figured it out. Florence is trapped in a pyramid scheme."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/cf_celiaquestionloop/13/s/0
msgctxt "Choix"
msgid "I'll go back through Florence's office."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/cf_celiaquestionloop/c-10/7
msgctxt "Celia"
msgid "Oh? What about?"
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/cf_celiaquestionloop/c-10/15
msgctxt "Celia"
msgid "Her memory isn't the best, the poor thing. But at least she isn't trapped in that attic anymore."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/cf_celiaquestionloop/c-10/23
msgctxt "Celia"
msgid "What did she want to know?"
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/cf_celiaquestionloop/c-10/31/0/s/0
msgctxt "Choix"
msgid "What happened on the night of the big party?"
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/cf_celiaquestionloop/c-10/31/c-0/89 cf_cf/cf_raineyreturn/0/g-0/59
msgctxt "Narrator"
msgid "You leave the Mayor's office, proof in hand."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/cf_celiaquestionloop/c-11/7
msgctxt "Celia"
msgid "She's the most dedicated secretary I've ever worked with. She would do anything for this office."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/cf_celiaquestionloop/c-11/15
msgctxt "Celia"
msgid "Unfortunately, the dear can be a little down on herself. Not much in the way of self-confidence."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/cf_celiaquestionloop/c-11/23
msgctxt "Celia"
msgid "It's a shame, really. She's totally unaware of her own natural charms."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/cf_celiaquestionloop/c-11/31/0/s/0
msgctxt "Choix"
msgid "What makes you say that?"
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/cf_celiaquestionloop/c-11/31/1/s/0
msgctxt "Choix"
msgid "Natural charms?"
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/cf_celiaquestionloop/c-11/31/c-0/7
msgctxt "Celia"
msgid "I think she's under the impression that she needs to spruce herself up. I keep finding empty bottles around her desk. Perfume, maybe? Although they don't carry a scent..."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/cf_celiaquestionloop/c-11/31/c-0/15
msgctxt "Celia"
msgid "And it seems like every time I turn my back, she's got another set."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/cf_celiaquestionloop/c-11/31/c-0/23
msgctxt "Celia"
msgid "They don't look especially high-quality either. Poor dear."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/cf_celiaquestionloop/c-11/31/c-1/7
msgctxt "Celia"
msgid "Of course."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/cf_celiaquestionloop/c-11/31/c-1/15
msgctxt "Celia"
msgid "She's a hard worker and she gets along with absolutely everybody. She's never in the spotlight, but she makes every room she's in better, like foil next to a diamond."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/cf_celiaquestionloop/c-11/31/c-1/23
msgctxt "Celia"
msgid "The objects who come into my office to lodge complaints would be in a much worse mood if she weren't there to take the edge off them."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/cf_celiaquestionloop/c-11/31/c-1/31
msgctxt "Celia"
msgid "And, speaking personally, I'd enjoy my work much less if I didn't get to see her smiling face in the office every morning."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/cf_celiaquestionloop/c-11/31/c-1/39
msgctxt "Celia"
msgid "It's a tragedy she doesn't see herself the same way."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/cf_celiaquestionloop/c-12/7
msgctxt "Celia"
msgid "You have done so. Keep well."
msgstr ""

#: cf_cf/cf_1st_encounter_2/0/cf_celiaquestionloop/c-14/7/b/1
msgctxt "Celia"
msgid "Mhm."
msgstr ""

#: cf_cf/cf_1st_encounter_no_detective/0/0
msgctxt "Celia"
msgid "Welcome back. Have you changed your mind about helping me with Florence?"
msgstr ""

#: cf_cf/cf_1st_encounter_no_detective/0/8/s/0
msgctxt "Choix"
msgid "Actually, Rainey wanted me to ask you something."
msgstr ""

#: cf_cf/cf_1st_encounter_no_detective/0/9/s/0
msgctxt "Choix"
msgid "I'll do it."
msgstr ""

#: cf_cf/cf_1st_encounter_no_detective/0/10/s/0
msgctxt "Choix"
msgid "Nope."
msgstr ""

#: cf_cf/cf_1st_encounter_no_detective/0/c-0/31/g-0/56
msgctxt "Celia"
msgid "Now then... was there anything else you needed?"
msgstr ""

#: cf_cf/cf_1st_encounter_no_detective/0/c-1/7
msgctxt "Celia"
msgid "Wonderful."
msgstr ""

#: cf_cf/cf_1st_encounter_no_detective/0/c-2/13
msgctxt "Celia"
msgid "...then I question why you're here taking up my valuable time. You can see yourself out."
msgstr ""

#: cf_cf/cf_2nd_encounter/0/6
msgctxt "Florence"
msgid "Oh, hello again!"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/14
msgctxt "Florence"
msgid "I trust your meeting with the mayor went well?"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/22/s/0
msgctxt "Choix"
msgid "Eh. I kinda blew her off actually."
msgstr ""

#: cf_cf/cf_2nd_encounter/0/23/s/0
msgctxt "Choix"
msgid "Yep."
msgstr ""

#: cf_cf/cf_2nd_encounter/0/c-0/7
msgctxt "Florence"
msgid "W-What?!"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/c-0/15
msgctxt "Florence"
msgid "Oh, maybe that's why she's been sort of prickly lately..."
msgstr ""

#: cf_cf/cf_2nd_encounter/0/c-0/23
msgctxt "Florence"
msgid "Here, you have to go talk to her at once!"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/c-1/7
msgctxt "Florence"
msgid "Wonderful!"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/0
msgctxt "Florence"
msgid "Anything else I can help you with while you're here?"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/8/s/0
msgctxt "Choix"
msgid "Tell me about yourself."
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/9/s/0
msgctxt "Choix"
msgid "About your crush on the mayor..."
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/10/s/0 cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-5/35/c-1/50/0/s/0
msgctxt "Choix"
msgid "Florence... you have feelings for the mayor, don't you?"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/11/s/0
msgctxt "Choix"
msgid "Tell me about the mayor."
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/12/s/0
msgctxt "Choix"
msgid "Celia tells me you've been leaving bottles around your desk."
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/13/s/0
msgctxt "Choix"
msgid "<i>Exit Florence's office.</i>"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-2/11
msgctxt "Florence"
msgid "What? You want to know about me?"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-2/19
msgctxt "Florence"
msgid "Oh, no. No, no, no, no, no."
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-2/27
msgctxt "Florence"
msgid "You just spoke with the mayor! A little ol' fuddy-duddy like me can't hold a candle to someone like her."
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-2/35
msgctxt "Florence"
msgid "I just handle the paperwork, that's all. Pay me no mind."
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-4/7
msgctxt "Florence"
msgid "W-w-w-what?!"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-4/18 cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-5/35/c-1/50/c-0/18
msgctxt "Florence"
msgid "Hahahaha! T-That's crazy!"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-4/34 cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-5/35/c-1/50/c-0/34
msgctxt "Florence"
msgid "Ooh... Is it that obvious?"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-5/11
msgctxt "Florence"
msgid "She's just incredible, isn't she?"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-5/19
msgctxt "Florence"
msgid "So tall and commanding... What I wouldn't give to be able to deal with people the way that she does!"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-5/27
msgctxt "Florence"
msgid "Some people think the mayor's cold-hearted, but I'll tell you what, there isn't a sweeter structure this side of the HOA!"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-5/35/0/s/0
msgctxt "Choix"
msgid "She's very striking."
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-5/35/1/s/0
msgctxt "Choix"
msgid "You seem quite taken with her."
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-5/35/c-0/13
msgctxt "Florence"
msgid "Isn't she though?!"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-5/35/c-0/21
msgctxt "Narrator"
msgid "Florence puts her hands to her cheeks and sighs wistfully, her lashes fluttering."
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-5/35/c-0/29
msgctxt "Florence"
msgid "...that vaulted figure. Her impeccable fashion sense. She really has it all, doesn't she?"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-5/35/c-0/37
msgctxt "Florence"
msgid "It's no wonder she's the mayor! She has my vote any day."
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-5/35/c-1/7
msgctxt "Florence"
msgid "Wh..."
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-5/35/c-1/18
msgctxt "Florence"
msgid "W-What do you mean by that exactly?!"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-5/35/c-1/26
msgctxt "Florence"
msgid "I-I just think she's a really remarkable ceiling, that's all!"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-5/35/c-1/34
msgctxt "Florence"
msgid "Besides, she's my boss so I couldn't begin to comment on her outside of professional opinion. H-haha!"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-5/35/c-1/50/1/s/0
msgctxt "Choix"
msgid "Sounds very professional."
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-5/35/c-1/50/c-0/7
msgctxt "Florence"
msgid "W-w-w- wait wait wait, what?!"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-5/35/c-1/50/c-1/7
msgctxt "Florence"
msgid "Hoho! Y-yep!!!"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-6/11
msgctxt "Florence"
msgid "Oh goodness! Did I forget to clean those up again? I'm hopeless..."
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-6/19
msgctxt "Florence"
msgid "But I'm happy to hear she's noticed something different about me, at least. (That means it's working!)"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-6/27
msgctxt "Florence"
msgid "I have been sampling some new things the past few weeks. It's a special new line of \"bottled air\" from Airway!"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-6/35/0/s/0
msgctxt "Choix"
msgid "Ah, of course. Bottled air. A quality product."
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-6/35/1/s/0
msgctxt "Choix"
msgid "Ah, of course. Bottled air. A 'quality' product..."
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-6/35/2/s/0
msgctxt "Choix"
msgid "Bottled... air?"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-6/35/g-0/3
msgctxt "Florence"
msgid "Yes! <i>\"Activated Air to improve the mind and body!\"</i>"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-6/35/g-0/11
msgctxt "Florence"
msgid "And it has the most <i>interesting</i> business model!"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-6/35/g-0/19
msgctxt "Florence"
msgid "Now, normally, you just buy a product from the store and that's it, right?"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-6/35/g-0/27
msgctxt "Florence"
msgid "Well, with Activated Air from Airway, you can buy your own kit and sell them to other people! And then <i>those</i> people can start selling their own little kits! And you get a cut of each sale."
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-6/35/g-0/38
msgctxt "Florence"
msgid "They call it a \"resale triangle!\" Isn't that fun?"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-6/35/g-0/46/0/s/0
msgctxt "Choix"
msgid "That's very interesting."
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-6/35/g-0/46/1/s/0
msgctxt "Choix"
msgid "That is 100% a pyramid scheme."
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-6/35/g-0/46/c-0/13
msgctxt "Florence"
msgid "Isn't it?"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-6/35/g-0/46/c-0/21
msgctxt "Florence"
msgid "Now, I'm not really cut out for the business angle myself. Or, the business tri-angle, as those Airway people would say."
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-6/35/g-0/46/c-0/29
msgctxt "Florence"
msgid "But the label says that anybody seen through the Activated Air will become irresistibly eye-catching!"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-6/35/g-0/46/c-0/37
msgctxt "Florence"
msgid "It's like a magical lens floating all around your body!"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-6/35/g-0/46/c-0/45
msgctxt "Florence"
msgid "That's why I've bought ten packs. You can't buy the products by themselves, you see. It's a whole process."
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-6/35/g-0/46/c-0/53
msgctxt "Florence"
msgid "They're quite expensive, but it'll all be worth it when they work!"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-6/35/g-0/46/c-0/61/0/s/0
msgctxt "Choix"
msgid "Are you trying to catch anyone's eye in particular?"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-6/35/g-0/46/c-0/61/1/s/0
msgctxt "Choix"
msgid "Yeah. That's absolutely a pyramid scheme."
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-6/35/g-0/46/c-0/61/c-0/7
msgctxt "Florence"
msgid "Oho... well. Maybe. A floor has to have her secrets!"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-6/35/g-0/46/c-0/61/c-0/15/0/s/0
msgctxt "Choix"
msgid "Well, I think you're plenty eye-catching already, Florence."
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-6/35/g-0/46/c-0/61/c-0/15/1/s/0
msgctxt "Choix"
msgid "Maybe... Mayor Celia?"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-6/35/g-0/46/c-0/61/c-0/15/c-0/7
msgctxt "Florence"
msgid "Goodness! Flatterer!"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-6/35/g-0/46/c-0/61/c-0/15/c-0/15
msgctxt "Florence"
msgid "You don't have to butter me up, dear. After all, the primary <i>flavoring agent</i> in many of Airway's air bottles is actually butter! I'm covered in it!"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-6/35/g-0/46/c-0/61/c-0/15/c-0/23
msgctxt "Florence"
msgid "The ants love it."
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-6/35/g-0/46/c-0/61/c-0/15/c-1/7
msgctxt "Narrator"
msgid "Florence lets out a sound that you couldn't transcribe even if you tried."
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-6/35/g-0/46/c-0/61/c-0/15/c-1/15
msgctxt "Florence"
msgid "<w>kfdklsahHodghdk!</w>"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-6/35/g-0/46/c-0/61/c-0/15/c-1/23
msgctxt "Florence"
msgid "I HAVE NO IDEA WHAT YOU'RE TALKING ABOUT, DEAR!"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-6/35/g-0/46/c-0/61/c-0/15/c-1/31
msgctxt "Florence"
msgid "Ho! Ho ho ho! HAHAHAHAHA!!"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-6/35/g-0/46/c-0/61/c-0/15/c-1/39
msgctxt "Florence"
msgid "M-Me and the mayor?! HAHAHA!! Could you even imagine!?! AHAHAH!!!"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-6/35/g-0/46/c-0/61/c-0/15/c-1/58
msgctxt "Florence"
msgid "...could you, though?"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-6/35/g-0/46/c-0/61/c-0/15/c-1/66/0/s/0
msgctxt "Choix"
msgid "Florence..."
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-7/7
msgctxt "Florence"
msgid "Oh! Bye bye!"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-7/15/0/s/0 cf_cf/cf_bottledairmention/0/g-0/c-2/30/c-0/23/c-0/15/0/s/0
msgctxt "Choix"
msgid "<i>Go to Celia's office.</i>"
msgstr ""

#: cf_cf/cf_2nd_encounter/0/cf_florencequestionloop/c-7/15/1/s/0
msgctxt "Choix"
msgid "<i>Leave.</i>"
msgstr ""

#: cf_cf/cf_pyramidscheme/0/4
msgctxt "Florence"
msgid "A pyramid scheme? Oh, no! No."
msgstr ""

#: cf_cf/cf_pyramidscheme/0/12
msgctxt "Florence"
msgid "It's an opportunity to become a small business! At least, that's what the very persuasive literature that comes with each package says."
msgstr ""

#: cf_cf/cf_pyramidscheme/0/20
msgctxt "Florence"
msgid "You don't need to worry about me, dearie. I'm a grown floorboard, I think I'd know a pyramid scheme when I see one!"
msgstr ""

#: cf_cf/cf_pyramidscheme/0/28
msgctxt "Florence"
msgid "Besides, this is a \"resale triangle\". Very different."
msgstr ""

#: cf_cf/cf_pyramidscheme/0/36
msgctxt "Florence"
msgid "...by the way I don't suppose you could see your way to dropping a few more coins on me, could you? All these bottles are really starting to eat into my finances."
msgstr ""

#: cf_cf/cf_pyramidscheme/0/44/s/0
msgctxt "Choix"
msgid "<i>Maybe I should tell Celia about this... </i>"
msgstr ""

#: cf_cf/cf_pyramidscheme/0/45/s/0
msgctxt "Choix"
msgid "No thank you..."
msgstr ""

#: cf_cf/florence_part1/0/0
msgctxt "Florence"
msgid "I guess I can't hide anything from someone as keen-eyed as you."
msgstr ""

#: cf_cf/florence_part1/0/8
msgctxt "Florence"
msgid "Yes. I'm afraid it's true. I've been... taken with the mayor for... For quite some time now."
msgstr ""

#: cf_cf/florence_part1/0/16
msgctxt "Florence"
msgid "Any time I think about her, I can feel my foundation warping into the shape of a heart..."
msgstr ""

#: cf_cf/florence_part1/0/24
msgctxt "Florence"
msgid "I'm terribly embarrassed about it, of course!"
msgstr ""

#: cf_cf/florence_part1/0/32
msgctxt "Florence"
msgid "But can you blame me?! She's incredible!"
msgstr ""

#: cf_cf/florence_part1/0/40
msgctxt "Florence"
msgid "The looks... the brains... the confidence."
msgstr ""

#: cf_cf/florence_part1/0/48/s/0
msgctxt "Choix"
msgid "Sounds like you really look up to her."
msgstr ""

#: cf_cf/florence_part1/0/49/s/0
msgctxt "Choix"
msgid "I dunno. I think you're just about as cute as she is."
msgstr ""

#: cf_cf/florence_part1/0/c-0/7
msgctxt "Florence"
msgid "I mean, <i>everyone</i> looks up to her. She's the ceiling."
msgstr ""

#: cf_cf/florence_part1/0/c-0/15
msgctxt "Florence"
msgid "Ho ho! House joke!"
msgstr ""

#: cf_cf/florence_part1/0/c-0/23
msgctxt "Florence"
msgid "But... me especially. She means the world to me."
msgstr ""

#: cf_cf/florence_part1/0/c-1/13
msgctxt "Florence"
msgid "P-Please, dear, don't try to fluster me! I'm already in a tizzy!"
msgstr ""

#: cf_cf/florence_part1/0/g-0/0
msgctxt "Florence"
msgid "The other day while organizing her schedule, I even caught myself writing my first name with her last and vice-versa."
msgstr ""

#: cf_cf/florence_part1/0/g-0/8
msgctxt "Florence"
msgid "\"Celia Floor.\" \"Florence Ceiling.\""
msgstr ""

#: cf_cf/florence_part1/0/g-0/16
msgctxt "Florence"
msgid "...listen to me go on and on like this. I'm such a schoolgirl."
msgstr ""

#: cf_cf/florence_part1/0/g-0/32/0
msgctxt "Florence"
msgid "Y-You're not going to tell Celia, are you? I'd be absolutely mortified!"
msgstr ""

#: cf_cf/florence_part1/0/g-0/32/12/s/0
msgctxt "Choix"
msgid "Your secret's safe with me."
msgstr ""

#: cf_cf/florence_part1/0/g-0/32/13/s/0
msgctxt "Choix"
msgid "Why not tell her you like her?"
msgstr ""

#: cf_cf/florence_part1/0/g-0/32/c-2/13
msgctxt "Florence"
msgid "Thank goodness... Nearly gave me a tell-tale heart attack there."
msgstr ""

#: cf_cf/florence_part1/0/g-0/32/c-3/7
msgctxt "Florence"
msgid "Oh, lord, no! I'd have to be cuckoo bananas to do that!"
msgstr ""

#: cf_cf/florence_part1/0/g-0/32/c-3/15
msgctxt "Florence"
msgid "First thing's first: She's my boss! This is a public office, for heaven's sake! I couldn't cause that kind of scandal. It'd ruin her!"
msgstr ""

#: cf_cf/florence_part1/0/g-0/32/c-3/23
msgctxt "Florence"
msgid "And, second things second:"
msgstr ""

#: cf_cf/florence_part1/0/g-0/32/c-3/31
msgctxt "Florence"
msgid "I'm nervous."
msgstr ""

#: cf_cf/florence_part1/0/g-1/0/s/0
msgctxt "Choix"
msgid "Maybe I could help you catch her eye?"
msgstr ""

#: cf_cf/florence_part1/0/g-1/1/s/0
msgctxt "Choix"
msgid "Well. Good luck with all that."
msgstr ""

#: cf_cf/florence_part1/0/g-1/c-4/13 cf_cf/florence_part1/0/g-1/c-4/37/c-3/15/g-0/0
msgctxt "Florence"
msgid "...really?"
msgstr ""

#: cf_cf/florence_part1/0/g-1/c-4/21
msgctxt "Florence"
msgid "Oh, no, dear... That's asking far too much."
msgstr ""

#: cf_cf/florence_part1/0/g-1/c-4/29
msgctxt "Florence"
msgid "I can't imagine she'd ever think of me as anything other than her fuddy-duddy little secretary, anyhow..."
msgstr ""

#: cf_cf/florence_part1/0/g-1/c-4/37/0/s/0
msgctxt "Choix"
msgid "Well, if you're sure..."
msgstr ""

#: cf_cf/florence_part1/0/g-1/c-4/37/1/s/0
msgctxt "Choix"
msgid "Not if you use more bottled air!"
msgstr ""

#: cf_cf/florence_part1/0/g-1/c-4/37/2/s/0
msgctxt "Choix"
msgid "What about that new bottled air product that everyone is talking about these days?"
msgstr ""

#: cf_cf/florence_part1/0/g-1/c-4/37/3/s/0
msgctxt "Choix"
msgid "That's not true. She really respects you."
msgstr ""

#: cf_cf/florence_part1/0/g-1/c-4/37/c-0/7
msgctxt "Florence"
msgid "Thanks anyways, dear. It's sweet of you to want to help."
msgstr ""

#: cf_cf/florence_part1/0/g-1/c-4/37/c-3/7
msgctxt "Florence"
msgid "Oh, I don't know about that."
msgstr ""

#: cf_cf/florence_part1/0/g-1/c-4/37/c-3/15/0/s/0
msgctxt "Choix"
msgid "She told me that \"you make every room you're in better\"."
msgstr ""

#: cf_cf/florence_part1/0/g-1/c-4/37/c-3/15/1/s/0
msgctxt "Choix"
msgid "She said she wouldn't enjoy her work if she didn't get to see your smiling face every day."
msgstr ""

#: cf_cf/florence_part1/0/g-1/c-4/37/c-3/15/g-0/8
msgctxt "Florence"
msgid "She said that? About... me?"
msgstr ""

#: cf_cf/florence_part1/0/g-1/c-4/37/c-3/15/g-0/16
msgctxt "Florence"
msgid "That's so sweet..."
msgstr ""

#: cf_cf/florence_part1/0/g-1/c-4/37/c-3/15/g-0/24/0/s/0
msgctxt "Choix"
msgid "Celia asked me to make sure you were ok. She's been worried sick about you."
msgstr ""

#: cf_cf/florence_part1/0/g-1/c-4/37/c-3/15/g-0/24/c-0/7
msgctxt "Florence"
msgid "Well... Gosh, I... I don't know what to say!"
msgstr ""

#: cf_cf/florence_part1/0/g-1/c-4/37/c-3/15/g-0/24/c-0/15
msgctxt "Florence"
msgid "I think I might cry..."
msgstr ""

#: cf_cf/florence_part1/0/g-1/c-4/37/c-3/15/g-0/24/c-0/23
msgctxt "Florence"
msgid "But... Wh-what am I supposed to do?"
msgstr ""

#: cf_cf/florence_part1/0/g-1/c-4/37/c-3/15/g-0/24/c-0/31
msgctxt "Florence"
msgid "Sure, I'm better than a plain dirt floor, I suppose. But I've got wrinkles! Cracks in my tiles!"
msgstr ""

#: cf_cf/florence_part1/0/g-1/c-4/37/c-3/15/g-0/24/c-0/39
msgctxt "Florence"
msgid "My paneling is peeling, my form is all warped..."
msgstr ""

#: cf_cf/florence_part1/0/g-1/c-4/37/c-3/15/g-0/24/c-0/47
msgctxt "Florence"
msgid "Even if the mayor really does like me a <i>little</i> bit, I can't imagine ever being good enough to reach her level!"
msgstr ""

#: cf_cf/florence_part1/0/g-1/c-4/37/c-3/15/g-0/24/c-0/55
msgctxt "Florence"
msgid "She's a ceiling!"
msgstr ""

#: cf_cf/florence_part1/0/g-1/c-4/37/c-3/15/g-0/24/c-0/63
msgctxt "Florence"
msgid "Unless..."
msgstr ""

#: cf_cf/florence_part1/0/g-1/c-4/37/c-3/15/g-0/24/c-0/71
msgctxt "Florence"
msgid "Wait! Wait a moment, dear!"
msgstr ""

#: cf_cf/florence_part1/0/g-1/c-4/37/c-3/15/g-0/24/c-0/79
msgctxt "Florence"
msgid "You've been running around and practicing dating, right? You must've learned a thing or two!"
msgstr ""

#: cf_cf/florence_part1/0/g-1/c-4/37/c-3/15/g-0/24/c-0/87
msgctxt "Florence"
msgid "Would you be able to teach me some of what you've learned?"
msgstr ""

#: cf_cf/florence_part1/0/g-1/c-4/37/c-3/15/g-0/24/c-0/95/0/s/0
msgctxt "Choix"
msgid "I can try?"
msgstr ""

#: cf_cf/florence_part1/0/g-1/c-4/37/c-3/15/g-0/24/c-0/95/c-0/7
msgctxt "Florence"
msgid "Okay! Any advice you have would be great!"
msgstr ""

#: cf_cf/florence_part1/0/g-1/c-5/7
msgctxt "Florence"
msgid "Alright... Phew."
msgstr ""

#: cf_cf/florence_part2/0/6
msgctxt "Florence"
msgid "Oh, you're back!"
msgstr ""

#: cf_cf/florence_part2/0/14/b/1
msgctxt "Florence"
msgid "Did you want to see the mayor? Or were you here to help me, erm..."
msgstr ""

#: cf_cf/florence_part2/0/14/b/9
msgctxt "Florence"
msgid "(G-Give me some dating advice?)"
msgstr ""

#: cf_cf/florence_part2/0/18/s/0
msgctxt "Choix"
msgid "I'm here to see Celia."
msgstr ""

#: cf_cf/florence_part2/0/19/s/0
msgctxt "Choix"
msgid "I'm here to give dating advice."
msgstr ""

#: cf_cf/florence_part2/0/20/s/0 cf_cf/florence_part2/0/florence_part2_spectacle_check_a/8/c-10/31/2/s/0
msgctxt "Choix"
msgid "Actually I had some questions for you."
msgstr ""

#: cf_cf/florence_part2/0/21/s/0
msgctxt "Choix"
msgid "I know what you need! More bottled air!"
msgstr ""

#: cf_cf/florence_part2/0/22/s/0
msgctxt "Choix"
msgid "I'm coming here from Airway Inc. Have you used our bottled air to attract the attentions of a certain crush you might have?"
msgstr ""

#: cf_cf/florence_part2/0/23/s/0
msgctxt "Choix"
msgid "Nevermind."
msgstr ""

#: cf_cf/florence_part2/0/c-0/7 cf_cf/florence_part2/0/florence_part2_spectacle_check_a/8/c-10/31/c-0/7
msgctxt "Florence"
msgid "Okay, I'll send you right up!"
msgstr ""

#: cf_cf/florence_part2/0/c-5/7
msgctxt "Florence"
msgid "Oh! Alright! S-See you later, then!"
msgstr ""

#: cf_cf/florence_part2/0/florence_part2_spectacle_check_a/0
msgctxt "Florence"
msgid "A-Alright! Let's hear it!"
msgstr ""

#: cf_cf/florence_part2/0/florence_part2_spectacle_check_a/8/0/s/0
msgctxt "Choix"
msgid "If you want someone to like you, then <i>you</i> have to like you first."
msgstr ""

#: cf_cf/florence_part2/0/florence_part2_spectacle_check_a/8/1/s/0
msgctxt "Choix"
msgid "Maybe you should try being sassy~!"
msgstr ""

#: cf_cf/florence_part2/0/florence_part2_spectacle_check_a/8/2/s/0
msgctxt "Choix"
msgid "You need to use more Activated Air!"
msgstr ""

#: cf_cf/florence_part2/0/florence_part2_spectacle_check_a/8/3/s/0
msgctxt "Choix"
msgid "For you girl, the <i>only</i> thing is Activated Air!"
msgstr ""

#: cf_cf/florence_part2/0/florence_part2_spectacle_check_a/8/4/s/0
msgctxt "Choix"
msgid "...sorry, I got nothing."
msgstr ""

#: cf_cf/florence_part2/0/florence_part2_spectacle_check_a/8/c-6/7
msgctxt "Florence"
msgid "Huh? What do you mean?"
msgstr ""

#: cf_cf/florence_part2/0/florence_part2_spectacle_check_a/8/c-6/15/0/s/0
msgctxt "Choix"
msgid "You're so quick to belittle yourself, Florence. You need to be more confident."
msgstr ""

#: cf_cf/florence_part2/0/florence_part2_spectacle_check_a/8/c-6/15/1/s/0
msgctxt "Choix"
msgid "You want Celia to love you? Love yourself."
msgstr ""

#: cf_cf/florence_part2/0/florence_part2_spectacle_check_a/8/c-6/15/g-0/8
msgctxt "Florence"
msgid "Well. Easier said than done, I think."
msgstr ""

#: cf_cf/florence_part2/0/florence_part2_spectacle_check_a/8/c-6/15/g-0/16
msgctxt "Florence"
msgid "I'm just a boring old floor... What's there to love?"
msgstr ""

#: cf_cf/florence_part2/0/florence_part2_spectacle_check_a/8/c-6/15/g-0/24/0/s/0
msgctxt "Choix"
msgid "Your kindness."
msgstr ""

#: cf_cf/florence_part2/0/florence_part2_spectacle_check_a/8/c-6/15/g-0/24/1/s/0
msgctxt "Choix"
msgid "Remember what the mayor said?"
msgstr ""

#: cf_cf/florence_part2/0/florence_part2_spectacle_check_a/8/c-6/15/g-0/24/2/s/0
msgctxt "Choix"
msgid "Well, first off? You're hot."
msgstr ""

#: cf_cf/florence_part2/0/florence_part2_spectacle_check_a/8/c-6/15/g-0/24/c-0/7
msgctxt "Florence"
msgid "My... kindness?"
msgstr ""

#: cf_cf/florence_part2/0/florence_part2_spectacle_check_a/8/c-6/15/g-0/24/c-0/15/0/s/0
msgctxt "Choix"
msgid "The way you greet the citizens when they come into the office."
msgstr ""

#: cf_cf/florence_part2/0/florence_part2_spectacle_check_a/8/c-6/15/g-0/24/c-0/15/c-0/7
msgctxt "Florence"
msgid "Oh that's nothing..."
msgstr ""

#: cf_cf/florence_part2/0/florence_part2_spectacle_check_a/8/c-6/15/g-0/24/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "You offered me tea. And a smile."
msgstr ""

#: cf_cf/florence_part2/0/florence_part2_spectacle_check_a/8/c-6/15/g-0/24/c-0/15/c-0/15/c-0/7
msgctxt "Florence"
msgid "So..."
msgstr ""

#: cf_cf/florence_part2/0/florence_part2_spectacle_check_a/8/c-6/15/g-0/24/c-0/15/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "That's worth more than you think, Florence."
msgstr ""

#: cf_cf/florence_part2/0/florence_part2_spectacle_check_a/8/c-6/15/g-0/24/c-0/15/c-0/15/c-0/15/c-0/21
msgctxt "Florence"
msgid "You really think so?"
msgstr ""

#: cf_cf/florence_part2/0/florence_part2_spectacle_check_a/8/c-6/15/g-0/24/c-0/15/c-0/15/c-0/15/c-0/29/0/s/0
msgctxt "Choix"
msgid "Celia thinks so. She told me, herself, remember?"
msgstr ""

