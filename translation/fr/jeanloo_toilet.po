#: jeanloo_toilet/jeanloo_realize_join/0/3/b/1
msgctxt "Jean Loo"
msgid "Lil' Crapper thought you were always supposed to rap through Ballco—"
msgstr ""

#: jeanloo_toilet/jeanloo_realize_join/0/6
msgctxt "Jean Loo"
msgid "Wait... what did you say?"
msgstr ""

#: jeanloo_toilet/jeanloo_realize_join/0/23/s/0
msgctxt "Choix"
msgid "I want to make you human."
msgstr ""

#: jeanloo_toilet/jeanloo_realize_join/0/24/s/0
msgctxt "Choix"
msgid "I wanted to make you a human... but I don't have the right stats yet."
