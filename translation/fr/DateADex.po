#: DateADex/betty_dex_entry/103
msgctxt "Tag Date-A-Dex"
msgid "It's so wrong, but feels so right."
msgstr "C'est tellement mal, mais ça fait tellement de bien."

# Traduction IA – à relire
#: DateADex/betty_dex_entry/106
msgctxt "Tag Date-A-Dex"
msgid "Achieve enemies with benefits with Betty."
msgstr "Deviens {{ennemi|ennemie|ennemi·e}} avec bénéfices de Betty."

