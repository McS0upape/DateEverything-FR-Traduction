# Traduction IA – à relire
#: tbc_ui/tbc_debug_mode/4
msgctxt "Textbox-chan"
msgid "Let's turn on my debug to make sure that all these return states generate correctly!"
msgstr "Activons mon mode debug pour vérifier que tous ces états de retour se génèrent bien !"

# Traduction IA – à relire
#: tbc_ui/tbc_debug_mode/9
msgctxt "Textbox-chan"
msgid "All 50 will now play - let's make sure there's no white squares!"
msgstr "Les 50 vont se lancer maintenant. Vérifions qu'il n'y a pas de carrés blancs !"

# Traduction IA – à relire
#: tbc_ui/tbc_debug_mode/65
msgctxt "Textbox-chan"
msgid "Phew! That was a lot of emoting QA-kun!! Hope it went okay!"
msgstr "Ouf ! Ça faisait beaucoup d'émotes, QA-kun !! J'espère que tout s'est bien passé !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/6
msgctxt "???"
msgid "<w>Hewooo~!</w>"
msgstr "<w>Bonjouw~ !</w>"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/11/s/0
msgctxt "Choix"
msgid "Where is that coming from..."
msgstr "D'où ça vient..."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/c-0/7
msgctxt "???"
msgid "<w>Hewo!</w>"
msgstr "<w>Bonjouw !</w>"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/c-0/12/0/s/0
msgctxt "Choix"
msgid "'Hewo'?"
msgstr "« Bonjouw » ?"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/c-0/12/1/s/0
msgctxt "Choix"
msgid "Speak normal."
msgstr "Parle normalement."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/c-0/12/2/s/0
msgctxt "Choix"
msgid "Hewooo out there!"
msgstr "Bonjouuuw, y a quelqu'un là-dedans !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/c-0/12/c-0/7
msgctxt "???"
msgid "Hewo! It's me!"
msgstr "Bonjouw ! C'est moi !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/c-0/12/c-1/7
msgctxt "???"
msgid "Oh, oh, sorry about that! It's me!"
msgstr "Oh, oh, pardon ! C'est moi !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-0/3
msgctxt "Textbox-Chan"
msgid "ヽ(ﾟДﾟ)ﾉ┌┛ What's up! I'm Textbox-chan!"
msgstr "ヽ(ﾟДﾟ)ﾉ┌┛ Salut salut ! Je suis Textbox-chan !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-0/17
msgctxt "Narrator"
msgid "A stranger that appears to be cuteness personified jump-kicks into your view, striking a pose so adorable it makes you just a little dizzy."
msgstr "Une inconnue qui semble être la mignonitude incarnée surgit dans votre champ de vision d'un coup de pied sauté et prend une pose si adorable qu'elle vous donne un peu le tournis."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-0/25/s/0
msgctxt "Choix"
msgid "Textbox... -chan?"
msgstr "Textbox... -chan ?"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-0/26/s/0
msgctxt "Choix"
msgid "Yooo it's the text box made into an anime lady!"
msgstr "Yooo c'est la boîte de texte transformée en héroïne d'animé !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-1/0
msgctxt "Textbox-chan"
msgid "Yup! Gee, those dateviators really can transform anything!"
msgstr "Ouaip ! Dis donc, ces Dateviators peuvent vraiment tout transformer !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-1/8
msgctxt "Textbox-chan"
msgid "Wait, we should use it on THE SUN!"
msgstr "Attends, on devrait s'en servir sur LE SOLEIL !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-1/16
msgctxt "Textbox-chan"
msgid "Think that would work?"
msgstr "Tu crois que ça marcherait ?"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-1/24/s/0
msgctxt "Choix"
msgid "The beam thing doesn't go out the windows..."
msgstr "Le faisceau ne sort pas par les fenêtres..."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-1/25/s/0
msgctxt "Choix"
msgid "I don't want to date the sun... if I can date you..."
msgstr "Je ne veux pas sortir avec le soleil... si je peux sortir avec toi..."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-1/c-3/7
msgctxt "Textbox-chan"
msgid "That's okay - it'll happen someday. (๑❛ ▿ ◠๑)"
msgstr "Ça viendra un jour, t'inquiète. (๑❛ ▿ ◠๑)"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-1/c-3/15
msgctxt "Textbox-chan"
msgid "Maybe DLC or something!"
msgstr "Dans un DLC, peut-être !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-1/c-4/7
msgctxt "Textbox-chan"
msgid "Oh! Well if you want to know the way to my heart. ♡(´ᵕ`✿)"
msgstr "Oh ! Eh bien, si tu veux savoir comment conquérir mon cœur. ♡(´ᵕ`✿)"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-1/c-4/15
msgctxt "Textbox-chan"
msgid "You have to do one thing..."
msgstr "Il n'y a qu'une chose à faire..."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-1/c-4/23/0/s/0
msgctxt "Choix"
msgid "Flirt?"
msgstr "Flirter ?"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-1/c-4/23/1/s/0
msgctxt "Choix"
msgid "Fight?"
msgstr "Se battre ?"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-1/c-4/23/2/s/0
msgctxt "Choix"
msgid "Read?"
msgstr "Lire ?"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-1/c-4/23/3/s/0
msgctxt "Choix"
msgid "Click options?"
msgstr "Cliquer sur des options ?"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-1/c-4/23/c-0/7
msgctxt "Textbox-chan"
msgid "Ummm... not really. ò_ô"
msgstr "Euh... pas vraiment. ò_ô"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-1/c-4/23/c-0/18
msgctxt "Textbox-chan"
msgid "As the UI, I love transforming ideas into words!"
msgstr "En tant qu'interface, j'adore transformer les idées en mots !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-1/c-4/23/c-1/7
msgctxt "Textbox-chan"
msgid "Ha! As if you could beat me in single combat. ò_ô"
msgstr "Ha ! Comme si tu pouvais me battre en combat singulier. ò_ô"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-1/c-4/23/c-1/15
msgctxt "Textbox-chan"
msgid "I contain all the highest stats. Take a look at these!"
msgstr "J'ai toutes les meilleures stats. Regarde-moi ça !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-1/c-4/23/c-1/26
msgctxt "Textbox-chan"
msgid "No matter how many exploits you do - they still have to be shown in UI first! (ง •̀ ω•́)ง"
msgstr "Peu importe le nombre d'exploits que tu accomplis, ils doivent d'abord s'afficher dans l'interface ! (ง •̀ ω•́)ง"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-1/c-4/23/c-1/34/0/s/0
msgctxt "Choix"
msgid "Attack?"
msgstr "Attaquer ?"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-1/c-4/23/c-1/34/1/s/0 tbc_ui/Textbox_Chan_1/0/g-2/9/s/0
msgctxt "Choix"
msgid "Makes sense to me."
msgstr "Ça se tient."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-1/c-4/23/c-1/34/c-0/7
msgctxt "Textbox-chan"
msgid "0 damage..."
msgstr "0 dégât..."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-1/c-4/23/c-1/34/c-0/15
msgctxt "Textbox-chan"
msgid "Let's move on, okay?"
msgstr "Passons à autre chose, d'accord ?"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-1/c-4/23/c-2/7
msgctxt "Textbox-chan"
msgid "Read! I love transforming ideas into words!"
msgstr "Lire ! J'adore transformer les idées en mots !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-1/c-4/23/c-3/7
msgctxt "Textbox-chan"
msgid "That's right!"
msgstr "Exactement !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-1/c-4/23/c-3/18
msgctxt "Textbox-chan"
msgid "Well. Hopefully the right ones. The ones that are making sure you pay attention."
msgstr "Enfin. J'espère que ce sont les bons. Ceux qui veillent à ce que tu restes {{attentif|attentive|attentif·ve}}."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-2/0
msgctxt "Textbox-chan"
msgid "Even though UI is on the surface... the ideas being conveyed are anything but."
msgstr "L'interface reste en surface... mais les idées qu'elle transmet sont tout sauf superficielles."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-2/8/s/0
msgctxt "Choix"
msgid "What's UI?"
msgstr "C'est quoi, l'UI ?"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-2/10/s/0
msgctxt "Choix"
msgid "I don't know... this game seems kinda surface level to me."
msgstr "Je ne sais pas... ce jeu me paraît plutôt superficiel."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-2/c-5/19
msgctxt "Textbox-chan"
msgid "User Interface! I help you talk to everyone here! (*^.^*)"
msgstr "User Interface, l'interface utilisateur ! Je t'aide à parler avec tout le monde ici ! (*^.^*)"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-2/c-5/27
msgctxt "Textbox-chan"
msgid "If it weren't for me... you'd never be able to talk to anyone..."
msgstr "Sans moi... tu ne pourrais parler à personne..."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-2/c-5/35
msgctxt "Textbox-chan"
msgid "Or even quit the game...! (◍°o°◍)"
msgstr "Ni même quitter le jeu...! (◍°o°◍)"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-2/c-5/43/0/s/0
msgctxt "Choix"
msgid "That's terrifying!"
msgstr "C'est terrifiant !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-2/c-5/43/1/s/0
msgctxt "Choix"
msgid "Seems kinda useful I guess."
msgstr "Ça a l'air plutôt utile, je suppose."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-2/c-5/43/c-0/7
msgctxt "Textbox-chan"
msgid "Trapped in here forever..."
msgstr "{{Coincé|Coincée|Coincé·e}} ici pour toujours..."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-2/c-5/43/c-0/15
msgctxt "Textbox-chan"
msgid "At least you'd have good company! ( *∵* )"
msgstr "Au moins, tu aurais de la bonne compagnie ! ( *∵* )"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-2/c-5/43/c-1/7
msgctxt "Textbox-chan"
msgid "I like to think I am!"
msgstr "J'aime à le croire !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-2/c-7/7
msgctxt "Textbox-chan"
msgid "Then I'm not doing as good a job as I can."
msgstr "Alors je ne fais pas aussi bien mon travail que je le pourrais."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-2/c-7/15
msgctxt "Textbox-chan"
msgid "I can always work harder!"
msgstr "Je peux toujours travailler plus dur !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-3/0
msgctxt "Textbox-chan"
msgid "Look... I know you've been staring at me this whole time... which is the point!"
msgstr "Écoute... je sais que tu me regardes depuis tout à l'heure... et c'est le but !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-3/8
msgctxt "Textbox-chan"
msgid "But remember: my advice is to listen to what I have to say, not just admire my pretty colors. (´｡• ᵕ •｡`)"
msgstr "Mais souviens-toi : mon conseil, c'est d'écouter ce que j'ai à dire, pas seulement d'admirer mes jolies couleurs. (´｡• ᵕ •｡`)"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-3/16/s/0
msgctxt "Choix"
msgid "You got it, Textbox-chan!"
msgstr "Compte sur moi, Textbox-chan !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-3/17/s/0
msgctxt "Choix"
msgid "Eh, we'll see."
msgstr "Mouais, on verra."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-3/c-8/7
msgctxt "Textbox-chan"
msgid "Yay!"
msgstr "Youpi !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-3/c-9/13
msgctxt "Textbox-chan"
msgid "Hm... now where did I put the..."
msgstr "Hm... mais où j'ai mis le..."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-3/c-9/21
msgctxt "Textbox-chan"
msgid "Gah, let's see... Oh! Here it is!"
msgstr "Gah, voyons voir... Oh ! Le voilà !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-3/c-9/40/0/s/0
msgctxt "Choix"
msgid "A g-gun??"
msgstr "Un f-flingue ??"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-3/c-9/40/1/s/0
msgctxt "Choix"
msgid "Do your worst, UI lady."
msgstr "Fais de ton pire, madame l'UI."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-3/c-9/40/g-0/0
msgctxt "Textbox-chan"
msgid "Bye bye."
msgstr "Bye bye."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-3/c-9/40/g-0/8 tbc_ui/Textbox_Chan_1/0/g-5/16
msgctxt "Textbox-chan"
msgid "Come talk to me again after you've awakened SIXTEEN dateables!"
msgstr "Reviens me parler quand tu auras éveillé SEIZE datables !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-4/0
msgctxt "Textbox-chan"
msgid "How are your dates going by the way?"
msgstr "Au fait, comment se passent tes rendez-vous ?"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-4/8
msgctxt "Textbox-chan"
msgid "I hope I've been helpful so far!"
msgstr "J'espère que je t'ai été utile jusqu'ici !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-4/16/s/0
msgctxt "Choix"
msgid "You've been super helpful!"
msgstr "Tu as été super utile !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-4/17/s/0
msgctxt "Choix"
msgid "You've been doing a standard job."
msgstr "Tu as fait un travail correct."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-4/18/s/0
msgctxt "Choix"
msgid "Not great."
msgstr "Pas terrible."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-4/c-10/13
msgctxt "Textbox-chan"
msgid "You're super welcome! (*^.^*)"
msgstr "Mais de rien ! (*^.^*)"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-4/c-11/7
msgctxt "Textbox-chan"
msgid "Okay! There's always room to improve."
msgstr "D'accord ! On peut toujours s'améliorer."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-4/c-12/7
msgctxt "Textbox-chan"
msgid "Oh! I'm sorry. I'll try to do my best to make things more readable and accessible for you in future updates."
msgstr "Oh ! Désolée. Je ferai de mon mieux pour que tout soit plus lisible et accessible dans les prochaines mises à jour."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-5/0
msgctxt "Textbox-chan"
msgid "Just know that you can count on me in your romantic quests!"
msgstr "Sache que tu peux compter sur moi dans tes quêtes amoureuses !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-5/8
msgctxt "Textbox-chan"
msgid "Now, I'll leave you to it!"
msgstr "Allez, je te laisse !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-5/24
msgctxt "Textbox-chan"
msgid "Then just put on those specs and tap that phantom word box you've never questioned before!"
msgstr "Alors enfile ces lunettes et touche cette boîte de texte fantôme dont tu ne t'es jamais {{méfié|méfiée|méfié·e}} !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-5/32/s/0
msgctxt "Choix"
msgid "Why sixteen?"
msgstr "Pourquoi seize ?"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-5/33/s/0 tbc_ui/TBInterview/0/g-0/9/s/0
msgctxt "Choix"
msgid "I've already done that!"
msgstr "Je l'ai déjà fait !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-5/c-14/7
msgctxt "Textbox-chan"
msgid "Well then come back later! I can't have you see all my content in one go!"
msgstr "Alors reviens plus tard ! Je ne peux pas te laisser voir tout mon contenu d'un coup !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-5/c-14/15
msgctxt "Textbox-chan"
msgid "A UI still has to leave something to the imagination... ┬┴┬┴┤ ͜ʖ ͡°) ├┬┴┬┴"
msgstr "Une UI doit bien laisser un peu de place à l'imagination... ┬┴┬┴┤ ͜ʖ ͡°) ├┬┴┬┴"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_1/0/g-6/0
msgctxt "Textbox-chan"
msgid "Ttyl! ★⌒ Ｙ⌒Ｙ⌒Ｙ⌒Ｙ⌒ ヾ(oﾟДﾟ)ﾉ"
msgstr "À+ ! ★⌒ Ｙ⌒Ｙ⌒Ｙ⌒Ｙ⌒ ヾ(oﾟДﾟ)ﾉ"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/3/b/1 tbc_ui/Textbox_Chan_3/0/3/b/1 tbc_ui/Textbox_Chan_4/0/3/b/1 tbc_ui/Textbox_Chan_5/0/3/b/1
msgctxt "Textbox-chan"
msgid "Hey! You haven't found enough dateables yet. Try me again after!"
msgstr "Hé ! Tu n'as pas encore trouvé assez de datables. Réessaie plus tard !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/12/b/1
msgctxt "Textbox-chan"
msgid "Hey, hey! ＼(＾▽＾*) Hi!"
msgstr "Coucou, coucou ! ＼(＾▽＾*) Salut !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/15
msgctxt "Textbox-chan"
msgid "Oho~ So you've met fourteen dateables?"
msgstr "Oho~ Alors tu as rencontré quatorze datables ?"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/23/s/0
msgctxt "Choix"
msgid "I thought you wanted me to find 16 dateables?"
msgstr "Je croyais que tu voulais que j'en trouve 16 ?"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/24/s/0
msgctxt "Choix"
msgid "Sure have!"
msgstr "Et comment !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/c-0/7
msgctxt "Textbox-chan"
msgid "Oh!"
msgstr "Oh !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/c-0/15
msgctxt "Textbox-chan"
msgid "Uhhhh..."
msgstr "Euhhh..."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-0/0
msgctxt "Textbox-chan"
msgid "The harem continues to grow! (*≧∇◕)"
msgstr "Le harem continue de s'agrandir ! (*≧∇◕)"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-0/11/s/0
msgctxt "Choix"
msgid "It sure does!"
msgstr "Ça, c'est sûr !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-0/12/s/0
msgctxt "Choix"
msgid "That's gross."
msgstr "C'est dégoûtant."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-0/13/s/0
msgctxt "Choix"
msgid "I'm here to make friends, not a harem!"
msgstr "Je suis là pour me faire des amis, pas un harem !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-0/14/s/0
msgctxt "Choix"
msgid "I'm talking with everyone here so I can destroy their souls one by one."
msgstr "Je parle à tout le monde ici pour détruire leurs âmes une à une."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-0/c-3/7
msgctxt "Textbox-chan"
msgid "Don't worry! I'm not judging."
msgstr "T'inquiète ! Je ne juge pas."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-0/c-3/15
msgctxt "Textbox-chan"
msgid "I am always on your side, remember? ✽-( ˘▽˘ ❁)/✽"
msgstr "Je suis toujours de ton côté, tu te souviens ? ✽-( ˘▽˘ ❁)/✽"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-0/c-4/7
msgctxt "Textbox-chan"
msgid "A friend-harem, I meant. ✽-( ˘▽˘ ❁)/✽"
msgstr "Un harem d'amis, je voulais dire. ✽-( ˘▽˘ ❁)/✽"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-0/c-5/15
msgctxt "Textbox-chan"
msgid "Not my style... but that's your choice I guess."
msgstr "Pas mon style... mais c'est ton choix, je suppose."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-1/0
msgctxt "Textbox-chan"
msgid "Oh... survey time!"
msgstr "Oh... l'heure du sondage !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-1/8
msgctxt "Textbox-chan"
msgid "How would you rate your textbox user-interface design?"
msgstr "Comment noterais-tu le design de mon interface de boîte de texte ?"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-1/16/s/0
msgctxt "Choix"
msgid "Could look cleaner."
msgstr "Pourrait être plus propre."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-1/17/s/0
msgctxt "Choix"
msgid "It's great on the eyes!"
msgstr "C'est un régal pour les yeux !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-1/18/s/0
msgctxt "Choix"
msgid "Why do I feel like this is a trick?"
msgstr "Pourquoi j'ai l'impression que c'est un piège ?"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-1/19/s/0
msgctxt "Choix"
msgid "She's gorgeous..."
msgstr "Elle est magnifique..."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-1/c-6/15 tbc_ui/Textbox_Chan_2/0/g-1/c-7/15 tbc_ui/Textbox_Chan_2/0/g-1/c-9/15/c-2/15
msgctxt "Textbox-chan"
msgid "Great! Your response has been recorded."
msgstr "Super ! Ta réponse a été enregistrée."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-1/c-8/7
msgctxt "Textbox-chan"
msgid "Mm-mmm! No tricks, I swear!"
msgstr "Mm-mmm ! Pas de piège, promis !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-1/c-9/7
msgctxt "Textbox-chan"
msgid "Oh, thank you! Though I meant accessibility-wise.."
msgstr "Oh, merci ! Mais je parlais d'accessibilité.."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-1/c-9/15/0/s/0
msgctxt "Choix"
msgid "You're so pretty."
msgstr "Tu es si jolie."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-1/c-9/15/1/s/0
msgctxt "Choix"
msgid "I can read it okay, thank you!"
msgstr "Je lis sans problème, merci !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-1/c-9/15/2/s/0
msgctxt "Choix"
msgid "Needs work, honestly."
msgstr "Il y a du boulot, franchement."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-1/c-9/15/c-0/7
msgctxt "Textbox-chan"
msgid "Ugh. Okay I suppose I can take that as a 'working as intended.' (—_—)"
msgstr "Pfff. Bon, je vais considérer ça comme « fonctionne comme prévu ». (—_—)"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-1/c-9/15/c-1/7
msgctxt "Textbox-chan"
msgid "Perfect!"
msgstr "Parfait !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-2/0
msgctxt "Textbox-chan"
msgid "Anyway!"
msgstr "Bref !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-2/8
msgctxt "Textbox-chan"
msgid "With all the new peeps you've been meeting, your listening (and reading) skills must be off the charts!"
msgstr "Avec tous les nouveaux visages que tu rencontres, tes capacités d'écoute (et de lecture) doivent être au top !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-2/16
msgctxt "Textbox-chan"
msgid "So be honest with me..."
msgstr "Alors sois honnête avec moi..."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-2/24
msgctxt "Textbox-chan"
msgid "Are you the type of person to skip text and dialogue?"
msgstr "Tu fais partie de ceux qui sautent les textes et les dialogues ?"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-2/32/s/0
msgctxt "Choix"
msgid "No! I read every single word."
msgstr "Non ! Je lis chaque mot."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-2/33/s/0
msgctxt "Choix"
msgid "What? Me? I would... never..."
msgstr "Quoi ? Moi ? Je ne ferais... jamais ça..."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-2/34/s/0 tbc_ui/Textbox_Chan_3/0/g-3/5/s/0
msgctxt "Choix"
msgid "<i>Skip</i>."
msgstr "<i>Passer.</i>"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-2/c-10/13
msgctxt "Textbox-chan"
msgid "Yes! I know you do!"
msgstr "Oui ! Je sais que tu le fais !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-2/c-10/21
msgctxt "Textbox-chan"
msgid "I get an alert every time you click 'next' and they're pretty spaced out."
msgstr "Je reçois une alerte à chaque fois que tu cliques sur « suivant », et elles sont bien espacées."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-2/c-10/29
msgctxt "Textbox-chan"
msgid "I really... really appreciate a person like you! (^◡^)"
msgstr "J'apprécie vraiment... vraiment quelqu'un comme toi ! (^◡^)"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-2/c-11/7
msgctxt "Textbox-chan"
msgid "Is that so?"
msgstr "C'est vrai ?"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-2/c-11/15
msgctxt "Textbox-chan"
msgid "Because I get an alert every time you click next and you are button-mashing like crazy!"
msgstr "Parce que je reçois une alerte à chaque clic sur « suivant » et tu matraques le bouton comme si ta vie en dépendait !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-2/c-11/26
msgctxt "Textbox-chan"
msgid "Love isn't a race, dude."
msgstr "L'amour, c'est pas une course, hein."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-2/c-11/34
msgctxt "Textbox-chan"
msgid "(-‸ლ) Well, whatever. As long as my texts are still useful to you..."
msgstr "(-‸ლ) Bon, peu importe. Tant que mes textes te sont utiles..."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-2/c-11/42/0/s/0
msgctxt "Choix"
msgid "They totally are!"
msgstr "Ils le sont complètement !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-2/c-11/42/1/s/0
msgctxt "Choix"
msgid "They aren't."
msgstr "Ils ne le sont pas."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-2/c-11/42/c-0/7
msgctxt "Textbox-chan"
msgid "Oh! Really?"
msgstr "Oh ! Vraiment ?"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-2/c-11/42/c-0/15
msgctxt "Textbox-chan"
msgid "I'm glad to hear that. (^◡^)"
msgstr "Je suis ravie de l'entendre. (^◡^)"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-2/c-11/42/c-1/7
msgctxt "Textbox-chan"
msgid "Very funny. (❁*ᵕ*)︻╦╤─"
msgstr "Très drôle. (❁*ᵕ*)︻╦╤─"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-2/c-12/7
msgctxt "Textbox-chan"
msgid "Oh! Okay!"
msgstr "Oh ! D'accord !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-2/c-12/15
msgctxt "Textbox-chan"
msgid "There's nothing wrong with skipping dialogue. (o^ ^o)"
msgstr "Il n'y a rien de mal à passer les dialogues. (o^ ^o)"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-2/c-12/23
msgctxt "Textbox-chan"
msgid "If the voiceover speed isn't to your liking, or we aren't saying something interesting, then it's fine to move forward faster!"
msgstr "Si la vitesse du doublage ne te convient pas, ou si on ne dit rien d'intéressant, tu peux avancer plus vite sans souci !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-2/c-12/31
msgctxt "Textbox-chan"
msgid "That's why I have given you the ultimate power..."
msgstr "C'est pour ça que je t'ai donné le pouvoir ultime..."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_2/0/g-2/c-12/39
msgctxt "Textbox-chan"
msgid "To skip!"
msgstr "Celui de passer !"

# Traduction IA – à relire
#: tbc_ui/TBInterview/0/0
msgctxt "Textbox-chan"
msgid "Alright, your turn!"
msgstr "Bon, à ton tour !"

# Traduction IA – à relire
#: tbc_ui/TBInterview/0/8/s/0
msgctxt "Choix"
msgid "Turn to do what?"
msgstr "À mon tour de faire quoi ?"

# Traduction IA – à relire
#: tbc_ui/TBInterview/0/c-0/7
msgctxt "Textbox-chan"
msgid "To ask me a question, duh!"
msgstr "De me poser une question, pardi !"

# Traduction IA – à relire
#: tbc_ui/TBInterview/0/c-0/15
msgctxt "Textbox-chan"
msgid "It's not fair that I just ask you questions all the time, right?"
msgstr "Ce n'est pas juste que je sois toujours celle qui pose les questions, non ?"

# Traduction IA – à relire
#: tbc_ui/TBInterview/0/c-0/23
msgctxt "Textbox-chan"
msgid "So ask away!"
msgstr "Alors vas-y, demande !"

# Traduction IA – à relire
#: tbc_ui/TBInterview/0/c-0/31/0/s/0
msgctxt "Choix"
msgid "What is your biggest pet peeve?"
msgstr "Quelle est ta plus grande bête noire ?"

# Traduction IA – à relire
#: tbc_ui/TBInterview/0/c-0/31/1/s/0
msgctxt "Choix"
msgid "What is your greatest fear?"
msgstr "Quelle est ta plus grande peur ?"

# Traduction IA – à relire
#: tbc_ui/TBInterview/0/c-0/31/2/s/0
msgctxt "Choix"
msgid "What's the most NSFW thing you've had to convert into text?"
msgstr "Quelle est la chose la plus NSFW que tu aies dû convertir en texte ?"

# Traduction IA – à relire
#: tbc_ui/TBInterview/0/c-0/31/3/s/0
msgctxt "Choix"
msgid "I don't have any questions."
msgstr "Je n'ai aucune question."

# Traduction IA – à relire
#: tbc_ui/TBInterview/0/c-0/31/c-0/13
msgctxt "Textbox-chan"
msgid "Oh that's easy."
msgstr "Oh, ça, c'est facile."

# Traduction IA – à relire
#: tbc_ui/TBInterview/0/c-0/31/c-0/21
msgctxt "Textbox-chan"
msgid "The way my parser works is dependent on the name of each character followed by two colons."
msgstr "Mon analyseur fonctionne grâce au nom de chaque personnage suivi de deux fois le signe deux-points."

# Traduction IA – à relire
#: tbc_ui/TBInterview/0/c-0/31/c-0/29
msgctxt "Textbox-chan"
msgid "If there's a typo anywhere, I won't be able to connect to all the great art and things get all messed up!"
msgstr "Si une faute de frappe se glisse quelque part, je ne peux plus me connecter à tous les beaux dessins et tout part de travers !"

# Traduction IA – à relire
#: tbc_ui/TBInterview/0/c-0/31/c-0/37
msgctxt "Textbox-chan"
msgid "Like this!"
msgstr "Comme ça !"

# Traduction IA – à relire
#: tbc_ui/TBInterview/0/c-0/31/c-0/48
msgctxt "Narration / joueur"
msgid "Textbox-chan: Or this! There's only one colon here and they forgot to record my voiceover line!"
msgstr "Textbox-chan: Ou comme ça ! Il n'y a qu'un seul deux-points ici et ils ont oublié d'enregistrer ma réplique !"

# Traduction IA – à relire
#: tbc_ui/TBInterview/0/c-0/31/c-0/56/0/s/0
msgctxt "Choix"
msgid "I'm sorry to hear that!"
msgstr "Je suis {{désolé|désolée|désolé·e}} de l'apprendre !"

# Traduction IA – à relire
#: tbc_ui/TBInterview/0/c-0/31/c-0/56/1/s/0
msgctxt "Choix"
msgid "I wish I could help your colons!"
msgstr "J'aimerais pouvoir aider tes deux-points !"

# Traduction IA – à relire
#: tbc_ui/TBInterview/0/c-0/31/c-0/56/c-0/7
msgctxt "Textbox-chan"
msgid "It's okay. We even have parsers for the parsers. So hopefully we found every. Single. One."
msgstr "Ça va. On a même des analyseurs pour les analyseurs. Donc j'espère qu'on les a tous. Trouvés. Un. Par. Un."

# Traduction IA – à relire
#: tbc_ui/TBInterview/0/c-0/31/c-0/56/c-1/18
msgctxt "Textbox-chan"
msgid "We're going to move on from that conversation!"
msgstr "Changeons de sujet !"

# Traduction IA – à relire
#: tbc_ui/TBInterview/0/c-0/31/c-1/13
msgctxt "Textbox-chan"
msgid "I can handle almost anything that comes up word-wise!"
msgstr "Je peux gérer presque tout ce qui se présente côté mots !"

# Traduction IA – à relire
#: tbc_ui/TBInterview/0/c-0/31/c-1/21
msgctxt "Textbox-chan"
msgid "Though I do have my limits..."
msgstr "Même si j'ai mes limites..."

# Traduction IA – à relire
#: tbc_ui/TBInterview/0/c-0/31/c-1/29
msgctxt "Textbox-chan"
msgid "If there ever comes up a line that's way too long and I can't divide the thoughts into smaller thoughts, I'll unfortunately have to do my best to convince the writer to reword something or maybe find a less detailed way to put it. But unfortunately, sometimes writers can be really stub (๑•̀ㅂ•́)و✧"
msgstr "Si jamais une réplique est beaucoup trop longue et que je n'arrive pas à découper les pensées en pensées plus petites, je devrai malheureusement faire de mon mieux pour convaincre l'auteur de reformuler ou de trouver une façon moins détaillée de le dire. Mais parfois, les auteurs sont vraiment têtus (๑•̀ㅂ•́)و✧"

# Traduction IA – à relire
#: tbc_ui/TBInterview/0/c-0/31/c-1/40/0/s/0
msgctxt "Choix"
msgid "Oh man. Fortunately I'm always able to put my thoughts succinctly into the box, and there's never a problem communicating what I need to you! No matter my thoughts at a particular time, I always feel that there's an option that works for me, word for word, letter for letter. In fact, it can sometimes be troubling having to choose between two very good options! We certainly make a great team, Textbox-chan!"
msgstr "Ah là là. Heureusement, j'arrive toujours à faire tenir mes pensées dans la boîte avec concision, et je n'ai jamais aucun mal à te dire ce qu'il faut ! Quelles que soient mes pensées du moment, j'ai toujours l'impression qu'il existe une option qui me convient, mot pour mot, lettre pour lettre. D'ailleurs, ça peut même être pénible d'avoir à choisir entre deux très bonnes options ! On forme décidément une super équipe, Textbox-chan !"

# Traduction IA – à relire
#: tbc_ui/TBInterview/0/c-0/31/c-1/40/1/s/0
msgctxt "Choix"
msgid "Huh."
msgstr "Hein."

# Traduction IA – à relire
#: tbc_ui/TBInterview/0/c-0/31/c-1/40/g-0/0
msgctxt "Textbox-chan"
msgid "Fortunately that's never been an issue!"
msgstr "Heureusement, ça n'a jamais été un problème !"

# Traduction IA – à relire
#: tbc_ui/TBInterview/0/c-0/31/c-2/13
msgctxt "Textbox-chan"
msgid "That's a great question!"
msgstr "Excellente question !"

# Traduction IA – à relire
#: tbc_ui/TBInterview/0/c-0/31/c-2/61/0/s/0
msgctxt "Choix"
msgid "Are you gonna answer me?"
msgstr "Tu vas me répondre ?"

# Traduction IA – à relire
#: tbc_ui/TBInterview/0/c-0/31/c-3/7
msgctxt "Textbox-chan"
msgid "Oh. Okay!"
msgstr "Oh. D'accord !"

# Traduction IA – à relire
#: tbc_ui/TBInterview/0/c-0/31/c-3/15 tbc_ui/Textbox_Chan_3/0/g-5/0
msgctxt "Textbox-chan"
msgid "Ttyl~! ★⌒ Ｙ⌒Ｙ⌒Ｙ⌒Ｙ⌒ ヾ(oﾟДﾟ)ﾉ"
msgstr "À+~ ! ★⌒ Ｙ⌒Ｙ⌒Ｙ⌒Ｙ⌒ ヾ(oﾟДﾟ)ﾉ"

# Traduction IA – à relire
#: tbc_ui/TBInterview/0/g-0/0
msgctxt "Textbox-chan"
msgid "Chatting time is over! Come back after you've awakened FORTY-ONE dateables!!"
msgstr "La discussion est terminée ! Reviens après avoir éveillé QUARANTE ET UN datables !!"

# Traduction IA – à relire
#: tbc_ui/TBInterview/0/g-0/8/s/0
msgctxt "Choix"
msgid "Okay, see ya!"
msgstr "D'accord, à plus !"

# Traduction IA – à relire
#: tbc_ui/TBInterview/0/g-0/c-2/7
msgctxt "Textbox-chan"
msgid "Oh well then come back later - gimme a chance to take a breather!"
msgstr "Oh, alors reviens plus tard, laisse-moi souffler un peu !"

# Traduction IA – à relire
#: tbc_ui/TBInterview/0/g-0/c-2/15
msgctxt "Textbox-chan"
msgid "I'm not used to actually speaking from the heart, and not through the others!"
msgstr "Je n'ai pas l'habitude de parler vraiment avec mon cœur, sans passer par les autres !"

# Traduction IA – à relire
#: tbc_ui/TBInterview/0/g-1/0
msgctxt "Textbox-chan"
msgid "Ttyl~! See ya!!! ★⌒ Ｙ⌒Ｙ⌒Ｙ⌒Ｙ⌒ ヾ(oﾟДﾟ)ﾉ"
msgstr "À+~ ! Salut !!! ★⌒ Ｙ⌒Ｙ⌒Ｙ⌒Ｙ⌒ ヾ(oﾟДﾟ)ﾉ"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_3/0/23/s/0
msgctxt "Choix"
msgid "Hey, Textbox-chan! Are you okay?"
msgstr "Hé, Textbox-chan ! Ça va ?"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_3/0/24/s/0
msgctxt "Choix"
msgid "Uh-oh. I'm just gonna... go."
msgstr "Oh oh. Je vais juste... m'en aller."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_3/0/c-0/24/0/s/0
msgctxt "Choix"
msgid "Oh no - I'm so sorry!"
msgstr "Oh non, je suis vraiment {{désolé|désolée|désolé·e}} !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_3/0/g-0/0 tbc_ui/Textbox_Chan_4/0/g-0/c-3/7
msgctxt "Textbox-chan"
msgid "Huh?"
msgstr "Hein ?"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_3/0/g-0/8
msgctxt "Textbox-chan"
msgid "Oh... sorry!"
msgstr "Oh... pardon !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_3/0/g-0/19
msgctxt "Textbox-chan"
msgid "I was just doing some of my, ahem, acting practice!"
msgstr "Je faisais juste un peu d'entraînement de jeu d'actrice, hum !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_3/0/g-0/27
msgctxt "Textbox-chan"
msgid "UI is more than just the text - it's the little transitions and animations too!"
msgstr "Une UI, ce n'est pas que du texte, ce sont aussi les petites transitions et animations !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_3/0/g-0/35/s/0
msgctxt "Choix"
msgid "Yeah, I knew that."
msgstr "Ouais, je le savais."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_3/0/g-0/36/s/0
msgctxt "Choix"
msgid "That's really cool!"
msgstr "C'est vraiment cool !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_3/0/g-0/c-2/7
msgctxt "Textbox-chan"
msgid "Oh, great!"
msgstr "Oh, super !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_3/0/g-0/c-3/7
msgctxt "Textbox-chan"
msgid "I think so too."
msgstr "Je trouve aussi."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_3/0/g-1/0
msgctxt "Textbox-chan"
msgid "I love the little animations, and they help the others here show their emotions in a more reactive way than what might be conveyed through art alone..."
msgstr "J'adore les petites animations, elles aident les autres à exprimer leurs émotions de façon plus vive que ce que le dessin seul pourrait faire..."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_3/0/g-1/8
msgctxt "Textbox-chan"
msgid "And practicing can be fun! (♡˙︶˙♡)"
msgstr "Et s'entraîner, ça peut être amusant ! (♡˙︶˙♡)"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_3/0/g-1/16/s/0
msgctxt "Choix"
msgid "Can you show me all your emotions?"
msgstr "Tu peux me montrer toutes tes émotions ?"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_3/0/g-1/17/s/0
msgctxt "Choix"
msgid "Yeah, I can imagine that."
msgstr "Ouais, j'imagine bien."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_3/0/g-1/c-4/19
msgctxt "Textbox-chan"
msgid "I would love to!! (^◡^) Let's go!"
msgstr "Avec plaisir !! (^◡^) C'est parti !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_3/0/g-1/c-4/33
msgctxt "Textbox-chan"
msgid "Okay... lights up... and..."
msgstr "Bon... lumières... et..."

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_3/0/g-1/c-4/41
msgctxt "Textbox-chan"
msgid "Action!"
msgstr "Action !"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_3/0/g-1/c-4/52
msgctxt "Textbox-chan"
msgid "<w>Joy</w>"
msgstr "<w>Joie</w>"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_3/0/g-1/c-4/63
msgctxt "Textbox-chan"
msgid "<w>Sadness</w>"
msgstr "<w>Tristesse</w>"

# Traduction IA – à relire
#: tbc_ui/Textbox_Chan_3/0/g-1/c-4/74
msgctxt "Textbox-chan"
msgid "<w>Anger</w>"
