msgstr "-JEAN ! S'IL TE PLAÎT ! Je suis en train de faire un truc, là."

# Traduction IA – à relire
#: rebel_duck/part_two_rebel_greeting/0/c-1/15/c-0/40
msgctxt "Jean Loo"
msgid "...meh."
msgstr "...meh."

# Traduction IA – à relire
#: rebel_duck/part_two_rebel_greeting/0/c-1/15/c-0/51/0/s/0 rebel_duck/part_two_rebel_greeting/0/c-1/15/c-1/67/2/s/0
msgctxt "Choix"
msgid "Rebbie?"
msgstr "Rebbie ?"

# Traduction IA – à relire
#: rebel_duck/part_two_rebel_greeting/0/c-1/15/c-0/51/1/s/0
msgctxt "Choix"
msgid "I don't speak French - do you, Rebbie?"
msgstr "Moi je parle pas le Jean Loo - et toi, Rebbie ?"

# Traduction IA – à relire
#: rebel_duck/part_two_rebel_greeting/0/c-1/15/c-1/7
msgctxt "Rebel"
msgid "Doooooooooooty. Nice work."
msgstr "Aaaaaah, c'est ça. Beau boulot."

# Traduction IA – à relire
#: rebel_duck/part_two_rebel_greeting/0/c-1/15/c-1/15
msgctxt "Rebel"
msgid "And hell yeah, I sleep, you creeper."
msgstr "Et putain ouais, je dors, tête de nœud."

# Traduction IA – à relire
#: rebel_duck/part_two_rebel_greeting/0/c-1/15/c-1/23
msgctxt "Rebel"
msgid "With one eye duckin' open."
msgstr "Avec un œil putain d'ouvert."

# Traduction IA – à relire
#: rebel_duck/part_two_rebel_greeting/0/c-1/15/c-1/34
msgctxt "Bathsheba"
msgid "They never go to bed on time, so they usually sleep in-"
msgstr "Iel se couche jamais à l'heure, alors iel dort souvent dans-"

# Traduction IA – à relire
#: rebel_duck/part_two_rebel_greeting/0/c-1/15/c-1/42
msgctxt "Rebel"
msgid "-BATHSHEBA! Argh, dammmmmit!"
msgstr "-BATHSHEBA ! Argh, meeeeerde !"

# Traduction IA – à relire
#: rebel_duck/part_two_rebel_greeting/0/c-1/15/c-1/53
msgctxt "Bathsheba"
msgid "Sorry Rebbie!"
msgstr "Désolée Rebbie !"

# Traduction IA – à relire
#: rebel_duck/part_two_rebel_greeting/0/c-1/15/c-1/67/0/s/0
msgctxt "Choix"
msgid "Oh... Rebbie."
msgstr "Oh... Rebbie."

# Traduction IA – à relire
#: rebel_duck/part_two_rebel_greeting/0/c-1/15/c-1/67/1/s/0
msgctxt "Choix"
msgid "Rebbie! That's so cute."
msgstr "Rebbie ! C'est trop mignon."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/0
msgctxt "Rebel"
msgid "I say you could call me that, dumbass?"
msgstr "J'ai dit que tu pouvais m'appeler comme ça, pauvre buse ?"

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/8
msgctxt "Rebel"
msgid "Pretty damn sure I didn't."
msgstr "Franchement, je crois pas."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/16/s/0
msgctxt "Choix"
msgid "Sorry. What should I call you?"
msgstr "{{Désolé|Désolée|Désolé·e}}. Je t'appelle comment ?"

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/17/s/0
msgctxt "Choix"
msgid "I mean I didn't really say you could call me everything you called me."
msgstr "Je veux dire, j'ai pas vraiment dit que tu pouvais m'appeler tout ce que tu m'as appelé."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/c-0/7
msgctxt "Rebel"
msgid "Daddy."
msgstr "Papa."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/c-0/15
msgctxt "Rebel"
msgid "Or Rebel."
msgstr "Ou Rebel."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/c-1/7
msgctxt "Rebel"
msgid "But you <i>are</i> all those things."
msgstr "Mais t'es <i>vraiment</i> tout ça."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/c-1/15
msgctxt "Rebel"
msgid "And more, probably."
msgstr "Et plus, sûrement."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/c-1/23
msgctxt "Rebel"
msgid "I'm just bein' accurate."
msgstr "Je fais juste dans la précision."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/c-1/39
msgctxt "Rebel"
msgid "Fine. Call me Rebel."
msgstr "Bon. Appelle-moi Rebel."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/c-1/47
msgctxt "Rebel"
msgid "Or Daddy."
msgstr "Ou Papa."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/c-1/55/0/s/0
msgctxt "Choix"
msgid "Yes, Daddy."
msgstr "Oui, Papa."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/c-1/55/2/s/0
msgctxt "Choix"
msgid "Hm. Don't like either."
msgstr "Hm. J'aime ni l'un ni l'autre."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/c-1/55/c-0/11/b/1
msgctxt "Rebel"
msgid "Good boy."
msgstr "Gentil garçon."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/c-1/55/c-0/12/b/1
msgctxt "Rebel"
msgid "Good girl."
msgstr "Gentille fille."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/c-1/55/c-0/13/b/1
msgctxt "Rebel"
msgid "Good toy."
msgstr "Gentil jouet."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/c-1/55/c-1/13 rebel_duck/Rebel_ISayYou/0/c-1/55/c-2/7
msgctxt "Rebel"
msgid "Boring."
msgstr "Chiant."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-0/0
msgctxt "Rebel"
msgid "Oh...!"
msgstr "Oh...!"

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-0/8
msgctxt "Rebel"
msgid "Aaaand there it is!"
msgstr "Et voilààà !"

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-0/16
msgctxt "Rebel"
msgid "I'm gettin' bored with this dumb ass convo."
msgstr "Je commence à m'ennuyer avec cette conversation de merde."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-0/24
msgctxt "Rebel"
msgid "I usually spend about 20 seconds talking and then whoever I'm talkin' to miraculously ends up dead or underneath my rubber ass."
msgstr "D'habitude je parle 20 secondes et ensuite la personne en face finit miraculeusement morte ou sous mon cul en caoutchouc."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-0/32
msgctxt "Rebel"
msgid "You can be whichever one you like."
msgstr "Tu peux choisir lequel tu préfères."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-0/40
msgctxt "Rebel"
msgid "That's the only favor I'm gonna do you, too, so appreciate that shit."
msgstr "C'est la seule faveur que je te ferai, alors profites-en bien."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-0/48/s/0
msgctxt "Choix"
msgid "So... Rebel's your real name?"
msgstr "Donc... Rebel, c'est ton vrai nom ?"

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-0/49/s/0
msgctxt "Choix"
msgid "You might end up under someone else's ass one day, pal."
msgstr "Tu pourrais finir sous le cul de quelqu'un d'autre un jour, tu sais."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-0/c-2/7
msgctxt "Rebel"
msgid "Yes and no."
msgstr "Oui et non."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-0/c-2/15/0/s/0
msgctxt "Choix"
msgid "What is?"
msgstr "Quoi donc ?"

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-0/c-2/15/1/s/0
msgctxt "Choix"
msgid "So that makes no sense?"
msgstr "Donc ça n'a aucun sens ?"

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-0/c-2/15/c-1/7
msgctxt "Rebel"
msgid "Ain't my obligation to make sense, jerkoff!"
msgstr "J'ai pas l'obligation d'avoir du sens, branle-couilles !"

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-0/c-2/15/c-1/15
msgctxt "Rebel"
msgid "But sure. You want my name? I'll give you my duckin' name."
msgstr "Mais bon. Tu veux mon nom ? Je te donne mon putain de nom."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-0/c-2/15/g-0/0
msgctxt "Rebel"
msgid "It's Nunya."
msgstr "C'est Patesoignons."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-0/c-2/15/g-0/8/0/s/0
msgctxt "Choix"
msgid "Ooh, that's pretty!"
msgstr "Ooh, c'est joli !"

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-0/c-2/15/g-0/8/1/s/0
msgctxt "Choix"
msgid "Nah. This is a setup..."
msgstr "Nan. C'est un piège..."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-0/c-2/15/g-0/8/g-0/0
msgctxt "Rebel"
msgid "Nunya duckin' Bizniss!"
msgstr "Pas-tes-putains-d'oignons !"

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-0/c-2/15/g-0/8/g-0/8/0/s/0
msgctxt "Choix"
msgid "Yep. Thought so."
msgstr "Ouais. Je m'en doutais."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-0/c-2/15/g-0/8/g-0/8/1/s/0
msgctxt "Choix"
msgid "Nice to meet you, Nunya."
msgstr "{{Enchanté|Enchantée|Enchanté·e}}, Patesoignons."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-0/c-2/15/g-0/8/g-0/8/c-1/7
msgctxt "Rebel"
msgid "Barf."
msgstr "Beurk."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-0/c-2/15/g-0/9/s/0
msgctxt "Choix"
msgid "Seems like we're getting nowhere."
msgstr "On dirait qu'on n'avance à rien."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-0/c-2/15/g-1/0
msgctxt "Rebel"
msgid "Names are worth choosing."
msgstr "Un nom, ça se choisit."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-0/c-2/15/g-1/8
msgctxt "Rebel"
msgid "And I don't have to tell you shit if I don't feel like it."
msgstr "Et j'ai pas à te dire de la merde si j'ai pas envie."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-0/c-3/7
msgctxt "Rebel"
msgid "Maybe, maybe. But I'm rubber bitch..."
msgstr "Peut-être, peut-être. Mais je suis en caoutchouc, moi..."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-0/c-3/15
msgctxt "Rebel"
msgid "I'll bounce right back."
msgstr "Je rebondis direct."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-1/4
msgctxt "Rebel"
msgid "In fact, I'm gonna get the duck out of this one-bill-town."
msgstr "Même, je vais me tirer de ce putain de bled à un seul bec."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-1/12
msgctxt "Rebel"
msgid "You wanna talk to me again? Too duckin' bad, poser."
msgstr "Tu veux me reparler ? Tant pis, putain de {{poseur|poseuse|poseur·se}}."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-1/20/s/0
msgctxt "Choix"
msgid "I don't want to talk to you again."
msgstr "Je veux pas te reparler."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-1/21/s/0
msgctxt "Choix"
msgid "Wait, when will you come back?"
msgstr "Attends, tu reviens quand ?"

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-1/22/s/0
msgctxt "Choix"
msgid "You can't just leave, you're a rubber duck."
msgstr "Tu peux pas t'en aller comme ça, t'es un canard en plastique."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-1/c-4/7
msgctxt "Rebel"
msgid "Poser says what?"
msgstr "Ça dit quoi, {{le poseur|la poseuse|le·la poseur·se}} ?"

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-1/c-5/7
msgctxt "Rebel"
msgid "Rebel's out. Rebel ain't coming back."
msgstr "Rebel se barre. Rebel reviendra pas."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-1/c-6/7
msgctxt "Rebel"
msgid "You ever heard the saying 'gone like a rubber duck who's done with your shit'?"
msgstr "T'as déjà entendu l'expression « parti comme un canard en plastique qui en a marre de tes conneries » ?"

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-1/c-6/15/0/s/0
msgctxt "Choix"
msgid "No."
msgstr "Non."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-1/c-6/15/1/s/0
msgctxt "Choix"
msgid "Oh yeah, they said that all the time in preschool."
msgstr "Ah ouais, ils disaient ça tout le temps en maternelle."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-1/c-6/15/2/s/0
msgctxt "Choix"
msgid "You're making this up!"
msgstr "Tu l'inventes !"

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-1/c-6/15/c-0/7
msgctxt "Rebel"
msgid "You will now."
msgstr "Maintenant, si."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-1/c-6/15/c-1/7
msgctxt "Rebel"
msgid "So that's why you turned out this way."
msgstr "C'est donc pour ça que t'as tourné comme ça."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-1/c-6/15/c-2/7
msgctxt "Rebel"
msgid "Yeah? Watch this."
msgstr "Ouais ? Regarde bien."

# Traduction IA – à relire
#: rebel_duck/Rebel_ISayYou/0/g-2/0
msgctxt "Rebel"
msgid "Poof. Rebel's gone."
msgstr "Pouf. Rebel a disparu."

# Traduction IA – à relire
#: rebel_duck/rebel_skip_start/0
msgctxt "Rebel"
msgid "Now duck off. I'm bored."
msgstr "Maintenant dégage. Je m'ennuie."

# Traduction IA – à relire
#: rebel_duck/rebcheck/8/b/1
msgctxt "Rebel"
msgid "Ugh. Why you gotta keep doing that..."
msgstr "Pfff. Pourquoi faut que tu continues à faire ça..."

# Traduction IA – à relire
#: rebel_duck/rebcheck/9/b/1
msgctxt "Rebel"
msgid "No one appreciates that kinda talkback, all right?"
msgstr "Personne apprécie ce genre de répliques, ok ?"

# Traduction IA – à relire
#: rebel_duck/rebcheck/10/b/1
msgctxt "Rebel"
msgid "Duckin' A, you gotta stop doing that!"
msgstr "Bordel de canard, faut que t'arrêtes de faire ça !"

# Traduction IA – à relire
#: rebel_duck/rebel_popin_one/0/9
msgctxt "Narrator"
msgid "But before you go back to your overworld home, it appears that Rebel blocks your way."
msgstr "Mais avant que vous ne regagniez votre foyer du monde extérieur, il semble que Rebel vous barre la route."

# Traduction IA – à relire
#: rebel_duck/rebel_popin_one/0/17
msgctxt "Rebel"
msgid "You?"
msgstr "Toi ?"

# Traduction IA – à relire
#: rebel_duck/rebel_popin_one/0/25
msgctxt "Rebel"
msgid "What're you doing? Couldn't get enough of me, huh?"
msgstr "Qu'est-ce que tu fais ? T'en as pas eu assez de moi, hein ?"

# Traduction IA – à relire
#: rebel_duck/rebel_popin_one/0/33
msgctxt "Rebel"
msgid "Thought I told you to get lost."
msgstr "Je croyais t'avoir dit de te perdre."

# Traduction IA – à relire
#: rebel_duck/rebel_popin_one/0/41/s/0
msgctxt "Choix"
msgid "I wasn't talking to you?"
msgstr "Je te parlais pas ?"

# Traduction IA – à relire
#: rebel_duck/rebel_popin_one/0/42/s/0
msgctxt "Choix"
msgid "You're insane. You said you were leaving."
msgstr "T'es dingue. Tu disais que tu partais."

# Traduction IA – à relire
#: rebel_duck/rebel_popin_one/0/43/s/0
msgctxt "Choix"
msgid "I'm checking out others here... not you."
msgstr "Je regarde les autres ici... pas toi."

# Traduction IA – à relire
#: rebel_duck/rebel_popin_one/0/c-0/7
msgctxt "Rebel"
msgid "Yeah, you weren't."
msgstr "Ouais, tu parlais pas."

# Traduction IA – à relire
#: rebel_duck/rebel_popin_one/0/c-0/15
msgctxt "Rebel"
msgid "But guess what you missed out on?"
msgstr "Mais devine ce que t'as raté ?"

# Traduction IA – à relire
#: rebel_duck/rebel_popin_one/0/c-1/7
msgctxt "Rebel"
msgid "Ooh, ok, ok. I can dig a little sass."
msgstr "Ooh, ok, ok. J'aime bien un peu de sarcasme."

# Traduction IA – à relire
#: rebel_duck/rebel_popin_one/0/c-1/15
msgctxt "Rebel"
msgid "Wanna know what else I dig just as much?"
msgstr "Tu veux savoir ce que j'aime tout autant ?"

# Traduction IA – à relire
#: rebel_duck/rebel_popin_one/0/c-2/7
msgctxt "Rebel"
msgid "Sounds fun. I could give you something else to check out."
msgstr "Ça a l'air fun. Je pourrais te donner autre chose à mater."

# Traduction IA – à relire
#: rebel_duck/rebel_popin_one/0/g-0/0/s/0
msgctxt "Choix"
msgid "This feels like a trap."
msgstr "Ça sent le piège."

# Traduction IA – à relire
#: rebel_duck/rebel_popin_one/0/g-0/1/s/0
msgctxt "Choix"
msgid "It's gonna be your butt or something."
msgstr "Ça va être tes fesses ou un truc du genre."

# Traduction IA – à relire
#: rebel_duck/rebel_popin_one/0/g-0/2/s/0
msgctxt "Choix"
msgid "Fine. What's that?"
msgstr "Bon. C'est quoi ?"

# Traduction IA – à relire
#: rebel_duck/rebel_popin_one/0/g-0/3/s/0
msgctxt "Choix"
msgid "I am eager and trusting! What?"
msgstr "Je suis tout plein d'enthousiasme et de confiance ! Quoi ?"

# Traduction IA – à relire
#: rebel_duck/rebel_popin_one/0/g-1/0
msgctxt "Rebel"
msgid "It's my ass."
msgstr "C'est mon cul."

# Traduction IA – à relire
#: rebel_duck/rebel_popin_one/0/g-1/8/s/0
msgctxt "Choix"
msgid "Yeah, I walked right into that."
msgstr "Ouais, je l'ai bien cherché."

# Traduction IA – à relire
#: rebel_duck/rebel_popin_one/0/g-1/9/s/0
msgctxt "Choix"
msgid "It's highly unimpressive."
msgstr "C'est franchement peu impressionnant."

# Traduction IA – à relire
#: rebel_duck/rebel_popin_one/0/g-1/10/s/0
msgctxt "Choix"
msgid "You're kind of a total bitch, did you know that?"
msgstr "T'es une sacrée peau de vache, tu savais ?"

# Traduction IA – à relire
#: rebel_duck/rebel_popin_one/0/g-1/c-7/7
msgctxt "Rebel"
msgid "Let's call it a learning experience."
msgstr "Disons que c'est une leçon."

# Traduction IA – à relire
#: rebel_duck/rebel_popin_one/0/g-1/c-7/15/0/s/0
msgctxt "Choix"
msgid "Lesson being?"
msgstr "La leçon étant ?"

# Traduction IA – à relire
#: rebel_duck/rebel_popin_one/0/g-1/c-7/15/1/s/0
msgctxt "Choix"
msgid "Point of which is I'm done talking to you."
msgstr "Et le but, c'est que j'ai fini de te parler."

# Traduction IA – à relire
#: rebel_duck/rebel_popin_one/0/g-1/c-7/15/c-0/7
msgctxt "Rebel"
msgid "Try not to be such a ducking rube."
msgstr "Essaie de pas jouer les putain de ploucs."

# Traduction IA – à relire
#: rebel_duck/rebel_popin_one/0/g-1/c-7/15/c-1/7
msgctxt "Rebel"
msgid "Oh how handy."
msgstr "Oh, comme c'est pratique."

# Traduction IA – à relire
#: rebel_duck/rebel_popin_one/0/g-1/c-7/15/c-1/15
msgctxt "Rebel"
msgid "Then how about you just run along and-"
msgstr "Alors si tu allais tout simplement te-"

# Traduction IA – à relire
#: rebel_duck/rebel_popin_one/0/g-1/c-8/7
msgctxt "Rebel"
msgid "Huh. Bore a striking resemblance to your face, I thought."
msgstr "Hm. Ça ressemblait étrangement à ta tronche, il me semblait."

# Traduction IA – à relire
#: rebel_duck/rebel_popin_one/0/g-1/c-9/14
msgctxt "Rebel"
msgid "Oh do I ever."
msgstr "Oh que oui."

# Traduction IA – à relire
#: rebel_duck/rebel_popin_one/0/g-2/0
msgctxt "Rebel"
msgid "I hope you've had as much of a blast as I have."
msgstr "J'espère que t'as pris autant ton pied que moi."

# Traduction IA – à relire
#: rebel_duck/rebel_popin_one/0/g-2/8/s/0
msgctxt "Choix"
msgid "Yeah. Real treat."
msgstr "Ouais. Un vrai régal."

# Traduction IA – à relire
#: rebel_duck/rebel_popin_one/0/g-2/9/s/0
msgctxt "Choix"
msgid "You're funny. I like it."
msgstr "T'es drôle. J'aime bien."

# Traduction IA – à relire
#: rebel_duck/rebel_popin_one/0/g-2/10/s/0
msgctxt "Choix"
msgid "Might not be quite the words I'd use."
msgstr "C'est pas tout à fait les mots que j'emploierais."

