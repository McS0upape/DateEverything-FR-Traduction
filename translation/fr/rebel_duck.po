msgstr "Et encore une fois, merci... pour tout."

# Traduction IA – à relire
#: rebel_duck/Rebel_Breakthrough_3/0/g-10/0
msgctxt "Rebel"
msgid "Oh thank GOD!"
msgstr "Oh, merci mon DIEU !"

# Traduction IA – à relire
