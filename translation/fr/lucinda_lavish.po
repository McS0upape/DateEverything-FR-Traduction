#: lucinda_lavish/second_loving/0/g-1/28/s/0
msgctxt "Choix"
msgid "You suck! Sometimes we suck!"
msgstr ""

#: lucinda_lavish/second_loving/0/g-1/c-7/7
msgctxt "Lucinda Lacking"
