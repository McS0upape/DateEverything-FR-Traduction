#: doug_dread/doug_encounter4/0/28/s/0
msgctxt "Choix"
msgid "That’s Brigadier General Dork to you."
msgstr ""

#: doug_dread/doug_encounter4/0/29/s/0
msgctxt "Choix"
msgid "No one ever expects the Dork. I mean,"
msgstr ""

#: doug_dread/doug_encounter4/0/30/s/0
msgctxt "Choix"
msgid "I just wanna talk."
msgstr ""

#: doug_dread/doug_encounter4/0/g-0/0
msgctxt "Doug"
msgid "Sure s-sure. Whatever you want, dawg."
msgstr ""

#: doug_dread/doug_encounter4/0/g-0/11
msgctxt "Doug"
msgid "Just please don’t bully me anymore."
msgstr ""

#: doug_dread/doug_encounter4/0/g-0/19/s/0
msgctxt "Choix"
msgid "No promises."
msgstr ""

#: doug_dread/doug_encounter4/0/g-0/20/s/0
msgctxt "Choix"
msgid "But I like bullying."
