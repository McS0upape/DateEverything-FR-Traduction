#: doug_dread/doug_encounter3/0/g-5/c-18/45
msgctxt "Doug"
msgid "I’d know."
msgstr ""

#: doug_dread/doug_encounter3/0/g-5/c-18/53/0/s/0
msgctxt "Choix"
msgid "But you care about Vidbucket?"
