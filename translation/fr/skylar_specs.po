#: skylar_specs/skylar_final_love_reggie/0/g-2/35
msgctxt "Reggie"
msgid "HAH! I got it."
msgstr ""

#: skylar_specs/skylar_final_love_reggie/0/g-2/43
msgctxt "Reggie"
msgid "If you really do love everyone like you say you do, then you'd remember the little details right?"
msgstr ""

#: skylar_specs/skylar_final_love_reggie/0/g-2/51
msgctxt "Skylar"
msgid "What? A pop quiz? No fair!"
msgstr ""

#: skylar_specs/skylar_final_love_reggie/0/g-2/59
msgctxt "Reggie"
msgid "I'm just saying... I don't think a true lover should be casual about it..."
msgstr ""

#: skylar_specs/skylar_final_love_reggie/0/g-2/67
msgctxt "Skylar"
msgid "...I guess I agree... still not fair."
msgstr ""

#: skylar_specs/skylar_final_love_reggie/0/g-2/78/s/0
msgctxt "Choix"
msgid "I scared."
msgstr ""

#: skylar_specs/skylar_final_love_reggie/0/g-2/79/s/0
msgctxt "Choix"
msgid "Bring it on."
msgstr ""

#: skylar_specs/skylar_final_love_reggie/0/g-3/0/b/1
msgctxt "Reggie"
msgid "Tell me, loverboy."
msgstr ""

#: skylar_specs/skylar_final_love_reggie/0/g-3/1/b/1
msgctxt "Reggie"
msgid "Tell me, Lady Lovesalot."
msgstr ""

#: skylar_specs/skylar_final_love_reggie/0/g-3/2/b/1
msgctxt "Reggie"
msgid "Tell me, uberlover."
msgstr ""

#: skylar_specs/skylar_final_love_reggie/0/g-3/5
msgctxt "Reggie"
msgid "Which of these is <i>not</i> a character Connie Soul portrays?"
