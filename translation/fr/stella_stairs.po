# Traduction IA – à relire
#: stella_stairs/1
msgctxt "Tag Nom d'objet (MAJUSCULES)"
msgid "STAIRS"
msgstr "ESCALIER"

# Traduction IA – à relire
#: stella_stairs/stella_hate_joiner/58 stella_stairs/stella_celia_takeover/0/g-0/34
msgctxt "Reggie"
msgid "Stella!!!!"
msgstr "Stella !!!!"

# Traduction IA – à relire
#: stella_stairs/stella_hate_joiner/66 stella_stairs/stella_celia_takeover/0/g-0/42
msgctxt "Reggie"
msgid "...sorry, been wanting to say that for like a while now."
msgstr "... pardon, ça faisait genre un moment que j'avais envie de dire ça."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/39
msgctxt "Narrator"
msgid "Celia's grand presence announces her before she even speaks to you. She greets you with a regal nod."
msgstr "La présence imposante de Celia l'annonce avant même qu'elle ne vous parle. Elle vous salue d'un hochement de tête royal."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/47
msgctxt "Celia"
msgid "Good. You're here. Let's get this done."
msgstr "Bien. Vous êtes là. Finissons-en."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/55 stella_stairs/StellaCeliaEmploymentReturn/0/8/b/1
msgctxt "Celia"
msgid "STELLA!"
msgstr "STELLA !"

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/66
msgctxt "Stella"
msgid "OH! Hello, Miss Mayor."
msgstr "OH ! Bonjour, madame la Maire."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/75/b/1
msgctxt "Stella"
msgid "OH Celia dearie! You must have heard I'm starting a new business!?"
msgstr "OH, Celia, mon chou ! Vous avez dû apprendre que je lance une nouvelle affaire !?"

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/75/b/9
msgctxt "Celia"
msgid "I have."
msgstr "En effet."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/75/b/17
msgctxt "Celia"
msgid "And I need you to stop."
msgstr "Et j'ai besoin que vous arrêtiez."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/75/b/25
msgctxt "Celia"
msgid "Airway has no place in this house."
msgstr "Airway n'a pas sa place dans cette maison."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/75/b/33
msgctxt "Stella"
msgid "...oh!"
msgstr "... oh !"

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/75/b/41
msgctxt "Celia"
msgid "I've seen the damage they can do."
msgstr "J'ai vu les dégâts qu'ils peuvent causer."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/75/b/49
msgctxt "Celia"
msgid "Even if you haven't."
msgstr "Même si ce n'est pas votre cas."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/75/b/57
msgctxt "Stella"
msgid "Well you see—"
msgstr "Eh bien, voyez-vous..."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/75/b/68
msgctxt "Celia"
msgid "No. Stella."
msgstr "Non. Stella."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/75/b/76
msgctxt "Stella"
msgid "I'm just saying—"
msgstr "Je dis simplement que..."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/75/b/87 stella_stairs/StellaCeliaMissionTrue/0/g-1/40
msgctxt "Celia"
msgid "Stella."
msgstr "Stella."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/75/b/95
msgctxt "Stella"
msgid "I'm not selling Airway."
msgstr "Je ne vends pas d'Airway."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/75/b/111
msgctxt "Celia"
msgid "You're not?"
msgstr "Ah non ?"

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/75/b/119 stella_stairs/poise_rebuttal/0/c-0/15/c-0/7 stella_stairs/StellaBusiness/0/g-0/c-4/15/c-0/15 stella_stairs/Stella3Sad/0/c-1/23
msgctxt "Stella"
msgid "No."
msgstr "Non."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/75/b/127
msgctxt "Stella"
msgid "I'm selling SHOES!"
msgstr "Je vends des CHAUSSURES !"

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/75/b/138
msgctxt "Stella"
msgid "Stilettos, specifically."
msgstr "Des stilettos, pour être précise."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/75/b/146
msgctxt "Stella"
msgid "I do hope that's okay..."
msgstr "J'espère que ça ne pose pas de problème..."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/75/b/154
msgctxt "Stella"
msgid "...is it?"
msgstr "... si ?"

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/75/b/165
msgctxt "Celia"
msgid "Your own?"
msgstr "Votre propre marque ?"

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/75/b/173 stella_stairs/Stella_CeliaConfrontation2/0/g-1/8 stella_stairs/Stella3Sad/0/c-1/7
msgctxt "Stella"
msgid "Yes."
msgstr "Oui."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/75/b/181
msgctxt "Stella"
msgid "For better or worse."
msgstr "Pour le meilleur et pour le pire."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/75/b/189
msgctxt "Stella"
msgid "I was... In a little deep with Airway."
msgstr "J'étais... un peu trop impliquée avec Airway."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/75/b/197
msgctxt "Stella"
msgid "But that's behind me."
msgstr "Mais c'est derrière moi."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/75/b/205
msgctxt "Celia"
msgid "I should hope so."
msgstr "Je l'espère bien."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/75/b/213
msgctxt "Stella"
msgid "So should I."
msgstr "Moi aussi."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/75/b/221
msgctxt "Celia"
msgid "Well then. If that's sorted. I've other matters to attend to."
msgstr "Bien. Si l'affaire est réglée, j'ai d'autres dossiers à traiter."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/75/b/229
msgctxt "Stella"
msgid "I'm sorry, Celia, for any trouble."
msgstr "Je suis désolée, Celia, pour le dérangement."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/75/b/237
msgctxt "Celia"
msgid "Not a worry."
msgstr "Ne vous en faites pas."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/75/b/253 stella_stairs/StellaDifferent/0/g-1/0/b/36
msgctxt "Celia"
msgid "Congratulations."
msgstr "Félicitations."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/78/b/1
msgctxt "Stella"
msgid "Ah. And the human is here."
msgstr "Ah. Et voilà {{l'humain|l'humaine|l'humain·e}}."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/78/b/9
msgctxt "Stella"
msgid "I believe I made it clear I wasn't interested in speaking to you."
msgstr "Je crois avoir été claire : je n'avais aucune envie de te parler."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/78/b/17
msgctxt "Celia"
msgid "Well, I'm afraid the two of us are <i>very</i> interested in speaking with you."
msgstr "Eh bien, je crains que nous deux ayons <i>très</i> envie de vous parler."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/78/b/25
msgctxt "Celia"
msgid "I'll cut right to the chase. I want Airway out of this house."
msgstr "J'irai droit au but. Je veux qu'Airway quitte cette maison."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/78/b/33
msgctxt "Stella"
msgid "What? No!"
msgstr "Quoi ? Non !"

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/78/b/44
msgctxt "Narrator"
msgid "Stella rounds on you, her hands balled into fists."
msgstr "Stella se tourne vers vous, les poings serrés."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/78/b/52
msgctxt "Stella"
msgid "You! You went to the Mayor!?"
msgstr "Toi ! Tu es {{allé|allée|allé·e}} voir la Maire !?"

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/78/b/63
msgctxt "Stella"
msgid "I'm just a small business... Why would you do this to me? You couldn't just let me try!?"
msgstr "Je ne suis qu'une petite entreprise... Pourquoi tu me fais ça ? Tu ne pouvais pas juste me laisser essayer !?"

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/78/b/71
msgctxt "Celia"
msgid "Airway isn't a \"small business\", Stella. It's a big problem."
msgstr "Airway n'est pas une « petite entreprise », Stella. C'est un gros problème."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/78/b/79
msgctxt "Stella"
msgid "I won't forgive you. Never. Never. Never."
msgstr "Je ne te pardonnerai pas. Jamais. Jamais. Jamais."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/78/b/87
msgctxt "Celia"
msgid "I think we're done here. I can handle any additional fallout myself."
msgstr "Je pense que nous en avons terminé. Je me charge moi-même des retombées éventuelles."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/78/b/95
msgctxt "Celia"
msgid "Come along Stella. Back to the office."
msgstr "Venez, Stella. Retournons au bureau."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/79/b/1
msgctxt "Stella"
msgid "I know you're a busy ceiling, but you're also..."
msgstr "Je sais que vous êtes un plafond très occupé, mais vous êtes aussi..."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/79/b/9
msgctxt "Stella"
msgid "(Let me check my notes here...)"
msgstr "(Laissez-moi vérifier mes notes...)"

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/79/b/17
msgctxt "Stella"
msgid "Smart!"
msgstr "Intelligente !"

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/79/b/28
msgctxt "Stella"
msgid "What would you say if I told you that you could be the first ceiling ever to get in on the ground floor of an exciting new start-up?"
msgstr "Que diriez-vous si je vous disais que vous pourriez être le tout premier plafond à entrer au rez-de-chaussée d'une nouvelle start-up passionnante ?"

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/79/b/36
msgctxt "Celia"
msgid "Airway isn't a small start-up, Stella. It's a big problem."
msgstr "Airway n'est pas une petite start-up, Stella. C'est un gros problème."

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/79/b/44
msgctxt "Stella"
msgid "OH! You're familiar with our brand! I'm so terrible at the speech, so it's good to know you're already onboard!"
msgstr "OH ! Vous connaissez notre marque ! Je suis si mauvaise pour le boniment, alors c'est bon de savoir que vous êtes déjà partante !"

# Traduction IA – à relire
#: stella_stairs/celia_stella_confrontation/79/b/52
msgctxt "Celia"
msgid "Not quite."
msgstr "Pas vraiment."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/0
msgctxt "Celia"
msgid "Stella, I'm concerned that you're being scammed, my dear."
msgstr "Stella, je crains que vous ne vous fassiez arnaquer, ma chère."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/8
msgctxt "Stella"
msgid "I am."
msgstr "C'est le cas."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/24
msgctxt "Celia"
msgid "You... are being scammed?"
msgstr "Vous... vous faites arnaquer ?"

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/32
msgctxt "Celia"
msgid "And you know that?"
msgstr "Et vous le savez ?"

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/40
msgctxt "Stella"
msgid "I know that it's easy for this to be seen as a scam."
msgstr "Je sais qu'on peut facilement prendre ça pour une arnaque."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/48
msgctxt "Stella"
msgid "But it's not."
msgstr "Mais ça n'en est pas une."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/56
msgctxt "Stella"
msgid "It's an opportunity."
msgstr "C'est une opportunité."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/91
msgctxt "Stella"
msgid "...and it's the only opportunity I have."
msgstr "... et c'est la seule opportunité que j'aie."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/99 stella_stairs/StellaCeliaNull/0/c-1/50/g-0/40
msgctxt "Celia"
msgid "Stella..."
msgstr "Stella..."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/107
msgctxt "Stella"
msgid "...please, Celia. Just let me try."
msgstr "... s'il vous plaît, Celia. Laissez-moi juste essayer."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/115/s/0
msgctxt "Choix"
msgid "Consider it Celia? Give her a chance? Maybe she can make something of this."
msgstr "Tu y réfléchirais, Celia ? Tu lui laisserais une chance ? Elle pourrait peut-être en tirer quelque chose."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/116/s/0
msgctxt "Choix"
msgid "Stella, this needs to stop."
msgstr "Stella, il faut que ça s'arrête."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-0/23 stella_stairs/Stella_CeliaConfrontation2/0/g-1/51
msgctxt "Celia"
msgid "Hmph."
msgstr "Hmph."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-0/31
msgctxt "Celia"
msgid "I doubt it."
msgstr "J'en doute."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-0/39
msgctxt "Celia"
msgid "But."
msgstr "Mais."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-0/47
msgctxt "Celia"
msgid "I see this means a lot to you, Stella."
msgstr "Je vois que cela compte beaucoup pour vous, Stella."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-0/55
msgctxt "Stella"
msgid "It does."
msgstr "C'est vrai."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-0/71
msgctxt "Celia"
msgid "Be careful."
msgstr "Soyez prudente."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-0/79
msgctxt "Celia"
msgid "And be kind, as kind as you can."
msgstr "Et soyez bienveillante, autant que vous le pourrez."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-0/87
msgctxt "Celia"
msgid "These are dangerous games, my dear."
msgstr "Ce sont des jeux dangereux, ma chère."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-0/95
msgctxt "Celia"
msgid "I'll turn a blind eye, for now."
msgstr "Je vais fermer les yeux, pour l'instant."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-0/103
msgctxt "Stella"
msgid "OH THANK YOU."
msgstr "OH, MERCI."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-0/114
msgctxt "Celia"
msgid "For NOW."
msgstr "Pour l'INSTANT."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-0/122
msgctxt "Stella"
msgid "Of course, of course."
msgstr "Bien sûr, bien sûr."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-0/133
msgctxt "Stella"
msgid "I should get back to work."
msgstr "Je devrais retourner au travail."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-0/141
msgctxt "Celia"
msgid "And so should I."
msgstr "Et moi de même."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-0/149
msgctxt "Celia"
msgid "Careful, Stella."
msgstr "Prudence, Stella."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-0/171
msgctxt "Stella"
msgid "She's gone?"
msgstr "Elle est partie ?"

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-0/179/0/s/0
msgctxt "Choix"
msgid "I think so..."
msgstr "Je crois..."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-0/179/c-0/10
msgctxt "Stella"
msgid "CAN I KISS YOU OR WHAT YOU STUDMUFFIN??"
msgstr "JE PEUX T'EMBRASSER OUI OU NON, ESPÈCE DE CANON ??"

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-0/179/c-0/18/0/s/0
msgctxt "Choix"
msgid "Sure! Kiss me, stair-lady!"
msgstr "Bien sûr ! Embrasse-moi, madame l'escalier !"

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-0/179/c-0/18/1/s/0
msgctxt "Choix"
msgid "J-just friends!"
msgstr "J-juste amis !"

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-0/179/c-0/18/c-0/7
msgctxt "Stella"
msgid "We're gonna go far, you and me. Up and up and up!"
msgstr "On va aller loin, toi et moi. Toujours plus haut !"

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-0/179/c-0/18/c-1/7
msgctxt "Stella"
msgid "Oh a staircase can dream, can't she?"
msgstr "Oh, un escalier a bien le droit de rêver, non ?"

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-1/10
msgctxt "Celia"
msgid "I'm afraid I agree, Stella. I understand this is important to you, but it's my responsibility to look after the whole, and Airway is a risk to that."
msgstr "Je crains d'être d'accord, Stella. Je comprends que ce soit important pour vous, mais il est de ma responsabilité de veiller sur l'ensemble de la maison, et Airway représente un risque."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-1/18
msgctxt "Celia"
msgid "I'm officially banning all sales of Airway products within this household."
msgstr "J'interdis officiellement toute vente de produits Airway dans ce foyer."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-1/34
msgctxt "Stella"
msgid "You... intervened. You ruined what I had going."
msgstr "Tu... es {{intervenu|intervenue|intervenu·e}}. Tu as gâché ce que j'avais lancé."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-1/42
msgctxt "Stella"
msgid "Didn't you?"
msgstr "Pas vrai ?"

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-1/50/0/s/0
msgctxt "Choix"
msgid "I didn't not tell her."
msgstr "Je ne lui ai pas rien dit."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-1/50/1/s/0
msgctxt "Choix"
msgid "I did."
msgstr "Oui."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-1/50/2/s/0
msgctxt "Choix"
msgid "I did not."
msgstr "Non."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-1/50/c-0/7
msgctxt "Stella"
msgid "Shut up with that nonsense."
msgstr "Arrête avec ces bêtises."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-1/50/c-2/7
msgctxt "Stella"
msgid "Then why are you here?"
msgstr "Alors pourquoi tu es là ?"

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-1/50/g-0/0
msgctxt "Stella"
msgid "I never should have relied on anyone else."
msgstr "Je n'aurais jamais dû compter sur quelqu'un d'autre."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-1/50/g-0/8
msgctxt "Stella"
msgid "Should've gone it alone."
msgstr "J'aurais dû me lancer seule."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-1/50/g-0/16 stella_stairs/Stella2/0/g-0/c-3/47/c-1/31
msgctxt "Stella"
msgid "Maybe."
msgstr "Peut-être."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-1/50/g-0/24
msgctxt "Stella"
msgid "I suppose I'll never know."
msgstr "J'imagine que je ne le saurai jamais."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-1/50/g-0/32
msgctxt "Stella"
msgid "I'd like you both to leave."
msgstr "J'aimerais que vous partiez, tous les deux."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaNull/0/c-1/50/g-0/48
msgctxt "Stella"
msgid "Leave."
msgstr "Partez."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/0
msgctxt "Celia"
msgid "Effective immediately, the sale of Airway products in this household is banned."
msgstr "Avec effet immédiat, la vente de produits Airway est interdite dans ce foyer."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/8
msgctxt "Stella"
msgid "What?!"
msgstr "Quoi ?!"

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/16
msgctxt "Stella"
msgid "No! I..."
msgstr "Non ! Je..."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/24
msgctxt "Celia"
msgid "Furthermore! I want you to give back every red cent you took from Florence."
msgstr "De plus ! Je veux que vous rendiez jusqu'au dernier centime que vous avez pris à Florence."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/32
msgctxt "Stella"
msgid "F-Florence?"
msgstr "F-Florence ?"

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/40
msgctxt "Stella"
msgid "But I haven't sold anything to Florence..."
msgstr "Mais je n'ai rien vendu à Florence..."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/48
msgctxt "Stella"
msgid "Oh! I suppose I did give her a free sample, once. I dropped it on her tile and she asked what it was."
msgstr "Oh ! J'imagine que je lui ai donné un échantillon gratuit, une fois. Je l'ai fait tomber sur son carrelage et elle m'a demandé ce que c'était."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/56
msgctxt "Stella"
msgid "I said she could have that one for free. \"A single free sample might just turn into a lifelong customer.\" Page 77."
msgstr "Je lui ai dit qu'elle pouvait garder celui-là gratuitement. « Un simple échantillon gratuit peut faire un client à vie. » Page 77."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/64
msgctxt "Stella"
msgid "I gave her the pitch and I told her she could come back for more!"
msgstr "Je lui ai fait mon boniment et je lui ai dit qu'elle pouvait revenir en chercher d'autres !"

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/72
msgctxt "Stella"
msgid "But... she didn't come back for more. I assumed she wasn't interested."
msgstr "Mais... elle n'est pas revenue en chercher. J'en ai déduit que ça ne l'intéressait pas."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/80
msgctxt "Stella"
msgid "Nobody ever is."
msgstr "Ça n'intéresse jamais personne."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/88
msgctxt "Celia"
msgid "Who else is selling these?"
msgstr "Qui d'autre vend ces produits ?"

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/96/b/1 stella_stairs/Stella_CeliaConfrontation2/0/97/b/1
msgctxt "Stella"
msgid "Well. I was under the impression it was me and the lieutenant."
msgstr "Eh bien. J'étais persuadée que c'était moi et le Lieutenant."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/96/b/9 stella_stairs/Stella_CeliaConfrontation2/0/97/b/9
msgctxt "Stella"
msgid "But I see I was mistaken."
msgstr "Mais je vois que je me trompais."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/98/b/1
msgctxt "Stella"
msgid "N-Nobody! I haven't been able to recruit a single soul!"
msgstr "P-personne ! Je n'ai pas réussi à recruter une seule âme !"

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/101
msgctxt "Stella"
msgid "Florence... she must be ordering them online."
msgstr "Florence... elle doit les commander en ligne."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/109
msgctxt "Celia"
msgid "Online?"
msgstr "En ligne ?"

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/117
msgctxt "Stella"
msgid "Online orders are more appealing to most customers these days... That's what the booklet says."
msgstr "Les commandes en ligne plaisent davantage à la plupart des clients de nos jours... C'est ce que dit le livret."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/125
msgctxt "Stella"
msgid "Page... Page 1."
msgstr "Page... page 1."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/133
msgctxt "Celia"
msgid "Well."
msgstr "Bien."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/141
msgctxt "Celia"
msgid "It's a lucky thing for you that you're only <i>indirectly</i> responsible for Florence's financial issues this time."
msgstr "Vous avez de la chance de n'être qu'<i>indirectement</i> responsable des soucis financiers de Florence, cette fois-ci."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/149
msgctxt "Celia"
msgid "It means your punishment will be light."
msgstr "Cela signifie que votre punition sera légère."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/157
msgctxt "Stella"
msgid "P-Punishment?"
msgstr "P-punition ?"

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/168
msgctxt "Celia"
msgid "I'll be keeping a close eye on any and all activities you have a hand in for quite awhile."
msgstr "Je garderai un œil attentif sur chacune de vos activités pendant un bon moment."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/176 stella_stairs/Stella3Hate/0/c-1/15/c-2/7
msgctxt "Stella"
msgid "Oh..."
msgstr "Oh..."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/184
msgctxt "Celia"
msgid "And this Airway scam has to go."
msgstr "Et cette arnaque Airway doit disparaître."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/192
msgctxt "Stella"
msgid "...but..."
msgstr "... mais..."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/200
msgctxt "Stella"
msgid "Celia. This is the only thing I've got."
msgstr "Celia. C'est tout ce que j'ai."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/208
msgctxt "Celia"
msgid "Then find another thing."
msgstr "Alors trouvez autre chose."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/216
msgctxt "Celia"
msgid "Something less damaging."
msgstr "Quelque chose de moins nuisible."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/224/s/0
msgctxt "Choix"
msgid "Now hold on one moment. I may have a solution."
msgstr "Attends une seconde. J'ai peut-être une solution."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/225/s/0
msgctxt "Choix"
msgid "I'm sorry Stella. But I couldn't let this continue."
msgstr "{{Désolé|Désolée|Désolé·e}}, Stella. Mais je ne pouvais pas laisser ça continuer."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/226/s/0
msgctxt "Choix"
msgid "I'm sorry, Celia, but Stella's already certified. You can't just shut her down."
msgstr "{{Désolé|Désolée|Désolé·e}}, Celia, mais Stella est déjà certifiée. Tu ne peux pas simplement la faire fermer."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/c-1/15
msgctxt "Celia"
msgid "And neither can I."
msgstr "Et moi non plus."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/c-1/23
msgctxt "Stella"
msgid "Well."
msgstr "Eh bien."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/c-1/42
msgctxt "Stella"
msgid "I think..."
msgstr "Je crois..."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/c-1/50
msgctxt "Stella"
msgid "I thought..."
msgstr "Je croyais..."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/c-1/58
msgctxt "Stella"
msgid "I thought you were a friend, dearie."
msgstr "Je croyais que tu étais {{un ami|une amie|un·e ami·e}}, mon petit chou."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/c-1/66
msgctxt "Stella"
msgid "Fooled me. I suppose."
msgstr "Tu m'as bien eue. J'imagine."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/c-1/74/0/s/0
msgctxt "Choix"
msgid "I'm sorry Stella, Celia is pretty stubborn on this."
msgstr "{{Désolé|Désolée|Désolé·e}}, Stella, Celia est assez inflexible là-dessus."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/c-1/74/1/s/0
msgctxt "Choix"
msgid "This wasn't never going to work out, Stella."
msgstr "Ça n'aurait jamais pu marcher, Stella."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/c-1/74/g-0/0
msgctxt "Stella"
msgid "I suppose I ought to have gone it alone."
msgstr "J'imagine que j'aurais dû me lancer seule."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/c-1/74/g-0/8
msgctxt "Stella"
msgid "Silly me."
msgstr "Que je suis bête."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/c-1/74/g-0/16
msgctxt "Stella"
msgid "Fine. You win. Congratulations. Now, I'd like you to leave."
msgstr "Très bien. Tu as gagné. Félicitations. Maintenant, j'aimerais que tu partes."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/c-1/74/g-0/24
msgctxt "Celia"
msgid "I hope you understand the damage you've very nearly done."
msgstr "J'espère que vous mesurez les dégâts que vous avez bien failli causer."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/c-1/74/g-0/32
msgctxt "Stella"
msgid "Just leave, Celia."
msgstr "Partez, Celia."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/c-1/74/g-0/40
msgctxt "Stella"
msgid "You too."
msgstr "Toi aussi."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/c-2/7
msgctxt "Celia"
msgid "Actually, I can."
msgstr "À vrai dire, si, je peux."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/c-2/23/b/1
msgctxt "Stella"
msgid "He's right, actually."
msgstr "Il a raison, en fait."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/c-2/24/b/1
msgctxt "Stella"
msgid "She's right, actually."
msgstr "Elle a raison, en fait."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/c-2/25/b/1
msgctxt "Stella"
msgid "They're right, actually."
msgstr "Iel a raison, en fait."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/c-2/28
msgctxt "Stella"
msgid "Rule 37. A certified lieutanant Rank II can call upon the Airway legal counsel for any business related enquiries."
msgstr "Règle 37. Un Lieutenant certifié de rang II peut faire appel au conseil juridique d'Airway pour toute question liée à son activité."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/c-2/47
msgctxt "Celia"
msgid "I'm sorry, what?"
msgstr "Pardon, quoi ?"

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/c-2/55/0/s/0
msgctxt "Choix"
msgid "Stella's got lawyers."
msgstr "Stella a des avocats."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/c-2/55/1/s/0
msgctxt "Choix"
msgid "Rule 37. A certified lieutanant Rank II can call upon the Airway legal counsel for any business related enquiries."
msgstr "Règle 37. Un Lieutenant certifié de rang II peut faire appel au conseil juridique d'Airway pour toute question liée à son activité."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/c-2/55/c-1/7
msgctxt "Celia"
msgid "Yes I HEARD you. I just find the thought preposterous."
msgstr "Oui, je vous ai ENTENDUE. Je trouve simplement l'idée grotesque."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/g-0/0
msgctxt "Celia"
msgid "You want to take this to court?"
msgstr "Vous voulez porter l'affaire en justice ?"

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/g-0/8/s/0
msgctxt "Choix"
msgid "I think she does."
msgstr "Je crois que oui."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/g-0/9/s/0
msgctxt "Choix"
msgid "Stella?"
msgstr "Stella ?"

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/g-1/19
msgctxt "Stella"
msgid "Yes I do."
msgstr "Oui, je le veux."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/g-1/27 stella_stairs/Stella_CeliaConfrontation2/0/g-1/126/c-7/15 stella_stairs/poise_rebuttal/0/c-0/15/c-0/23 stella_stairs/poise_rebuttal/0/g-0/c-4/15/c-0/23 stella_stairs/StellaRecruit/0/c-0/31/g-0/0/c-1/15/c-0/15 stella_stairs/StellaRecruit/0/c-0/31/g-0/0/c-2/23/c-1/15
msgctxt "Stella"
msgid "I think."
msgstr "Je crois."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/g-1/35
msgctxt "Stella"
msgid "I think I will."
msgstr "Je crois que oui."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/g-1/59
msgctxt "Celia"
msgid "Tedious."
msgstr "Fastidieux."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/g-1/67
msgctxt "Celia"
msgid "And likely a waste of public resources."
msgstr "Et sans doute un gaspillage de l'argent public."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/g-1/75
msgctxt "Stella"
msgid "Then let it go."
msgstr "Alors laissez tomber."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/g-1/91
msgctxt "Stella"
msgid "Celia. This is the only thing I've had in decades. I will fight you for it."
msgstr "Celia. C'est la seule chose que j'aie eue depuis des décennies. Je me battrai contre vous pour la garder."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/g-1/99
msgctxt "Celia"
msgid "Fine. Tedious, but fine."
msgstr "Soit. Fastidieux, mais soit."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/g-1/107
msgctxt "Celia"
msgid "I hope you understand the damage you'll do."
msgstr "J'espère que vous mesurez les dégâts que vous allez causer."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/g-1/115
msgctxt "Celia"
msgid "Good day, I suppose."
msgstr "Bonne journée, je suppose."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/g-1/126/0
msgctxt "Stella"
msgid "PHEW."
msgstr "OUF."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/g-1/126/11/s/0
msgctxt "Choix"
msgid "That was a new side to you."
msgstr "Je ne te connaissais pas sous ce jour-là."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/g-1/126/12/s/0
msgctxt "Choix"
msgid "You really stepped up."
msgstr "Tu as vraiment monté d'une marche."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/g-1/126/13/s/0
msgctxt "Choix"
msgid "That was a little mean."
msgstr "C'était un peu méchant."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/g-1/126/c-5/7
msgctxt "Stella"
msgid "It was, wasn't it?"
msgstr "C'est vrai, hein ?"

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/g-1/126/c-6/7
msgctxt "Stella"
msgid "I suppose I did."
msgstr "Il faut croire, oui."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/g-1/126/c-7/7
msgctxt "Stella"
msgid "But it felt wonderful."
msgstr "Mais ça m'a fait un bien fou."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/g-1/126/c-7/23 stella_stairs/Stella2/0/g-0/c-5/15
msgctxt "Stella"
msgid "Mostly."
msgstr "Presque."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/g-3/3
msgctxt "Stella"
msgid "Thank you."
msgstr "Merci."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/g-3/11
msgctxt "Stella"
msgid "I'd almost forgotten rule 37."
msgstr "J'avais presque oublié la règle 37."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/g-3/19
msgctxt "Stella"
msgid "I supposed I'd forgotten I qualified."
msgstr "J'imagine que j'avais oublié que j'y avais droit."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/g-3/27/s/0
msgctxt "Choix"
msgid "You know, it was kind of... Hot. Seeing you stand up for yourself like that."
msgstr "Tu sais, c'était un peu... sexy. De te voir te défendre comme ça."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/g-3/28/s/0
msgctxt "Choix"
msgid "What are friends for?"
msgstr "C'est à ça que servent les amis, non ?"

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/g-3/c-8/7 stella_stairs/poise_rebuttal/0/g-1/c-5/7 stella_stairs/StellaMissionSuccesful/0/g-1/c-5/7 stella_stairs/StellaMissionSuccesful/0/g-2/8 stella_stairs/Stella3Hate/0/0
msgctxt "Stella"
msgid "Oh."
msgstr "Oh."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/g-3/c-8/23 stella_stairs/poise_rebuttal/0/g-1/c-5/34 stella_stairs/StellaBusiness/0/g-0/c-5/7 stella_stairs/StellaDifferent/0/g-0/59
msgctxt "Stella"
msgid "OH!"
msgstr "OH !"

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/g-3/c-8/34
msgctxt "Stella"
msgid "Oh my, dearie."
msgstr "Oh, Seigneur, mon petit chou."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/g-3/c-8/42
msgctxt "Stella"
msgid "Well. You know. I'm actually moving up in the world lately."
msgstr "Eh bien. Tu sais. Je monte pas mal dans le monde, ces temps-ci."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/g-3/c-8/50
msgctxt "Stella"
msgid "Maybe you'd like to step up to my office sometime?"
msgstr "Tu voudrais peut-être monter dans mon bureau, un de ces jours ?"

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/g-3/c-8/58/0/s/0
msgctxt "Choix"
msgid "Yes ma'am."
msgstr "Oui, madame."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/g-3/c-8/58/1/s/0
msgctxt "Choix"
msgid "I think I would."
msgstr "Je crois que oui."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/g-3/c-9/7
msgctxt "Stella"
msgid "Indeed. And what a friend you've been."
msgstr "En effet. Et {{quel ami|quelle amie|quel·le ami·e}} tu as été."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/g-3/c-9/15
msgctxt "Stella"
msgid "You always pull through, dearie."
msgstr "Tu réponds toujours présent, mon petit chou."

# Traduction IA – à relire
#: stella_stairs/Stella_CeliaConfrontation2/0/g-3/c-9/23
msgctxt "Stella"
msgid "I won't ever forget that."
msgstr "Je ne l'oublierai jamais."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/6
msgctxt "Celia"
msgid "Do tell?"
msgstr "Ah oui ?"

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/14/s/0
msgctxt "Choix"
msgid "Surely this isn't what you really want Stella?"
msgstr "Ce n'est sûrement pas ce que tu veux vraiment, Stella ?"

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/15/s/0
msgctxt "Choix"
msgid "Stella. You want to make something of yourself, right? Work for Celia. Help make this house a better home."
msgstr "Stella. Tu veux devenir quelqu'un, non ? Travaille pour Celia. Aide à faire de cette maison un meilleur foyer."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/c-0/7
msgctxt "Stella"
msgid "Um."
msgstr "Euh."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "Surely there's something else you can sell, something you actually care about?"
msgstr "Il y a sûrement autre chose que tu pourrais vendre, quelque chose qui te tient vraiment à cœur ?"

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/c-0/15/c-0/15
msgctxt "Stella"
msgid "This is all I've ever come close to having."
msgstr "C'est ce que j'ai eu de plus proche d'un projet à moi."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/c-0/15/c-0/42
msgctxt "Stella"
msgid "I think what I need is a blasted nap."
msgstr "Je crois que ce qu'il me faut, c'est une sacrée sieste."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/c-0/15/c-0/50
msgctxt "Stella"
msgid "I appreciate your concern, I suppose."
msgstr "J'apprécie que tu t'inquiètes, j'imagine."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/c-0/15/c-0/58
msgctxt "Stella"
msgid "But I'd rather be alone."
msgstr "Mais je préfère être seule."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/c-1/15
msgctxt "Stella"
msgid "I mean, I'm flattered dearie."
msgstr "Enfin, je suis flattée, mon petit chou."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/c-1/31
msgctxt "Stella"
msgid "But that doesn't really seem feasible."
msgstr "Mais ça ne me paraît pas vraiment faisable."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/c-1/47
msgctxt "Stella"
msgid "I'm not sure how much I'd have to offer."
msgstr "Je ne sais pas trop ce que j'aurais à offrir."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/c-1/63
msgctxt "Celia"
msgid "Effort, and care, is all it requires."
msgstr "Des efforts et de l'attention, c'est tout ce qu'il faut."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/c-1/71
msgctxt "Celia"
msgid "Put in half as much there as you've put in here."
msgstr "Mettez-en moitié autant là-dedans que vous en avez mis ici."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/c-1/79
msgctxt "Celia"
msgid "You underestimate yourself, Stella."
msgstr "Vous vous sous-estimez, Stella."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/c-1/87
msgctxt "Celia"
msgid "Or perhaps you overestimate the rest of us."
msgstr "Ou peut-être nous surestimez-vous, nous autres."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/c-1/95
msgctxt "Celia"
msgid "Besides, goodness knows Florence could use the help."
msgstr "Et puis, Dieu sait que Florence aurait bien besoin d'aide."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/c-1/103
msgctxt "Stella"
msgid "Well if she needs the help."
msgstr "Eh bien, si elle a besoin d'aide."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/c-1/111
msgctxt "Celia"
msgid "You'd have to leave this Airway nonsense behind, though."
msgstr "Il faudrait toutefois laisser tomber ces sottises d'Airway."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/c-1/119
msgctxt "Stella"
msgid "It's not nonsense."
msgstr "Ce ne sont pas des sottises."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/c-1/127
msgctxt "Celia"
msgid "Oh, Stella. You're not stupid."
msgstr "Oh, Stella. Vous n'êtes pas idiote."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/c-1/143
msgctxt "Stella"
msgid "No. I suppose I'm not."
msgstr "Non. J'imagine que non."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/c-1/151
msgctxt "Celia"
msgid "Wouldn't it be nice to work in a place where you don't have to <i>act</i> stupid."
msgstr "Ne serait-ce pas agréable de travailler dans un endroit où vous n'avez pas à <i>jouer</i> les idiotes ?"

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/c-1/159
msgctxt "Stella"
msgid "That does sound nice."
msgstr "Ça a l'air agréable, c'est vrai."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/c-1/167
msgctxt "Celia"
msgid "Fantastic. Tomorrow morning, my office. Florence will give you the rundown."
msgstr "Parfait. Demain matin, à mon bureau. Florence vous mettra au courant."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/c-1/189 stella_stairs/StellaMissionSuccesful/0/g-2/16 stella_stairs/Stella3Hate/0/c-1/15/c-2/15
msgctxt "Stella"
msgid "Well then."
msgstr "Eh bien."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/c-1/197
msgctxt "Stella"
msgid "It all seems a bit obvious now, doesn't it dearie?"
msgstr "Ça paraît évident, maintenant, hein, mon petit chou ?"

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/g-0/0/s/0
msgctxt "Choix"
msgid "Maybe you just needed Airway to build up your confidence?"
msgstr "Peut-être que tu avais juste besoin d'Airway pour prendre confiance en toi ?"

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/g-0/1/s/0
msgctxt "Choix"
msgid "It always was."
msgstr "Ça l'a toujours été."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/g-0/2/s/0
msgctxt "Choix"
msgid "It's hard to see you struggling."
msgstr "C'est dur de te voir galérer."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/g-0/c-2/7
msgctxt "Stella"
msgid "Maybe so."
msgstr "Peut-être bien."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/g-0/c-2/15
msgctxt "Stella"
msgid "Still. It's hard not to feel a little stupid."
msgstr "Quand même. C'est dur de ne pas se sentir un peu bête."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/g-0/c-3/7
msgctxt "Stella"
msgid "Truly."
msgstr "Vraiment."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/g-0/c-4/7
msgctxt "Stella"
msgid "I felt like I was thriving."
msgstr "J'avais l'impression de m'épanouir."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/g-0/c-4/15/0/s/0 stella_stairs/Stella2/0/g-0/c-3/47/g-0/20/0/s/0
msgctxt "Choix"
msgid "Really?"
msgstr "Vraiment ?"

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/g-0/c-4/15/1/s/0
msgctxt "Choix"
msgid "And now?"
msgstr "Et maintenant ?"

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/g-0/c-4/15/2/s/0
msgctxt "Choix"
msgid "You weren't."
msgstr "Ce n'était pas le cas."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/g-0/c-4/15/c-0/15
msgctxt "Stella"
msgid "I'm not sure."
msgstr "Je ne sais pas trop."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/g-0/c-4/15/c-1/7
msgctxt "Stella"
msgid "Now I'm not so sure."
msgstr "Maintenant, je n'en suis plus si sûre."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/g-0/c-4/15/c-2/7
msgctxt "Stella"
msgid "... No. I suppose not."
msgstr "... Non. J'imagine que non."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/g-1/0
msgctxt "Stella"
msgid "Helping this house."
msgstr "Aider cette maison."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/g-1/8
msgctxt "Stella"
msgid "Seems a little more important than bottled air."
msgstr "Ça paraît un peu plus important que de l'air en bouteille."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/g-1/16
msgctxt "Stella"
msgid "A little more impossible, too."
msgstr "Un peu plus impossible, aussi."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/g-1/27
msgctxt "Stella"
msgid "But not completely."
msgstr "Mais pas complètement."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/g-1/43
msgctxt "Stella"
msgid "Thank you, dearie."
msgstr "Merci, mon petit chou."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/g-1/51
msgctxt "Stella"
msgid "I know I must have been a pain."
msgstr "Je sais que j'ai dû être pénible."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/g-1/59/s/0
msgctxt "Choix"
msgid "Anything for love."
msgstr "Tout pour l'amour."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/g-1/60/s/0
msgctxt "Choix"
msgid "Anything for a friend."
msgstr "Tout pour une amie."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/g-1/c-5/23
msgctxt "Narrator"
msgid "It takes Stella a few moments to fully comprehend your words."
msgstr "Il faut quelques instants à Stella pour saisir pleinement vos paroles."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/g-1/c-5/45
msgctxt "Stella"
msgid "A day full of surprises."
msgstr "Une journée pleine de surprises."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/g-1/c-5/53
msgctxt "Stella"
msgid "Well. You know. I'm actually between jobs right now. And I've got the day off."
msgstr "Eh bien. Tu sais. Je suis entre deux emplois, en ce moment. Et j'ai ma journée."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/g-1/c-5/61
msgctxt "Stella"
msgid "Step up to my office?"
msgstr "Tu montes dans mon bureau ?"

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/g-1/c-5/69
msgctxt "Narrator"
msgid "You step right up into her waiting embrace."
msgstr "Vous montez droit dans ses bras grands ouverts."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/g-1/c-6/7
msgctxt "Stella"
msgid "And what a friend you've been."
msgstr "Et {{quel ami|quelle amie|quel·le ami·e}} tu as été."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/g-1/c-6/15
msgctxt "Stella"
msgid "I'll never forget this, you know."
msgstr "Je ne l'oublierai jamais, tu sais."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/g-1/c-6/23
msgctxt "Stella"
msgid "Just don't go expecting any political favours."
msgstr "Mais ne t'attends pas à des faveurs politiques."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/g-1/c-6/31/0/s/0 stella_stairs/StellaRecruit/0/c-3/34/0/s/0
msgctxt "Choix"
msgid "Why?"
msgstr "Pourquoi ?"

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/g-1/c-6/31/c-0/10
msgctxt "Stella"
msgid "OHHH I'm going to work in politics."
msgstr "OHHH, je vais travailler dans la politique."

# Traduction IA – à relire
#: stella_stairs/poise_rebuttal/0/g-1/c-6/31/c-0/18
msgctxt "Stella"
msgid "Who would've guessed!?"
msgstr "Qui l'eût cru !?"

# Traduction IA – à relire
#: stella_stairs/stella_celia_takeover/0/6
msgctxt "Celia"
msgid "I'm here to put an end to this Airway nonsense."
msgstr "Je suis ici pour mettre fin à ces sottises d'Airway."

# Traduction IA – à relire
#: stella_stairs/stella_celia_takeover/0/14/s/0
msgctxt "Choix"
msgid "Sorry, Celia. Not gonna happen."
msgstr "{{Désolé|Désolée|Désolé·e}}, Celia. Ça n'arrivera pas."

# Traduction IA – à relire
#: stella_stairs/stella_celia_takeover/0/15/s/0
msgctxt "Choix"
msgid "Stella, it's time to give it up."
msgstr "Stella, il est temps de laisser tomber."

# Traduction IA – à relire
#: stella_stairs/stella_celia_takeover/0/c-0/7
msgctxt "Celia"
msgid "What? I wasn't addressing you..."
msgstr "Quoi ? Ce n'est pas à vous que je m'adressais..."

# Traduction IA – à relire
#: stella_stairs/stella_celia_takeover/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "I know. I don't think it's nonsense."
msgstr "Je sais. Je ne pense pas que ce soient des sottises."

# Traduction IA – à relire
#: stella_stairs/stella_celia_takeover/0/c-0/15/c-0/7
msgctxt "Celia"
msgid "How... what?"
msgstr "Comment... quoi ?"

# Traduction IA – à relire
#: stella_stairs/stella_celia_takeover/0/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "Airway is a fantastic product used by only the most fantastic of us."
msgstr "Airway est un produit fantastique, utilisé uniquement par les plus fantastiques d'entre nous."

# Traduction IA – à relire
#: stella_stairs/stella_celia_takeover/0/c-0/15/c-0/15/c-0/7
msgctxt "Stella"
msgid "Yes, Lieutenant, yes! That's in the handbook!"
msgstr "Oui, Lieutenant, oui ! C'est dans le manuel !"

# Traduction IA – à relire
#: stella_stairs/stella_celia_takeover/0/c-0/15/c-0/15/c-0/18
msgctxt "Stella"
msgid "Celia. I think you are a bit outnumbered."
msgstr "Celia. Je crois que vous êtes un peu en minorité."

# Traduction IA – à relire
#: stella_stairs/stella_celia_takeover/0/c-0/15/c-0/15/c-0/37
msgctxt "Celia"
msgid "I am in CHARGE here."
msgstr "C'est MOI qui commande ici."

# Traduction IA – à relire
#: stella_stairs/stella_celia_takeover/0/c-0/15/c-0/15/c-0/48
msgctxt "Celia"
msgid "I will outlaw all Airway products."
msgstr "Je vais interdire tous les produits Airway."

# Traduction IA – à relire
#: stella_stairs/stella_celia_takeover/0/c-0/15/c-0/15/c-0/56
msgctxt "Celia"
msgid "And I will never speak with you again, citizen."
msgstr "Et je ne vous adresserai plus jamais la parole, {{citoyen|citoyenne|citoyen·ne}}."

# Traduction IA – à relire
#: stella_stairs/stella_celia_takeover/0/c-0/15/c-0/15/c-0/64
msgctxt "Celia"
msgid "How dare you. How dare you betray your municipal government this way."
msgstr "Comment osez-vous ? Comment osez-vous trahir ainsi votre gouvernement municipal ?"

# Traduction IA – à relire
#: stella_stairs/stella_celia_takeover/0/c-0/15/c-0/15/c-0/103
msgctxt "Stella"
msgid "Well done! Yippee!"
msgstr "Bien joué ! Youpi !"

# Traduction IA – à relire
#: stella_stairs/stella_celia_takeover/0/c-0/15/c-0/15/c-0/114
msgctxt "Stella"
msgid "We're gonna be rich!"
msgstr "On va être riches !"

# Traduction IA – à relire
#: stella_stairs/stella_celia_takeover/0/c-0/15/c-0/15/c-0/122/0/s/0
msgctxt "Choix"
msgid "Can't wait!! Screw that uptight mayor."
msgstr "J'ai trop hâte !! Au diable cette Maire coincée."

# Traduction IA – à relire
#: stella_stairs/stella_celia_takeover/0/c-0/15/c-0/15/c-0/122/1/s/0
msgctxt "Choix"
msgid "Wait, isn't Airway outlawed?"
msgstr "Attends, Airway n'est pas interdit ?"

# Traduction IA – à relire
#: stella_stairs/stella_celia_takeover/0/c-0/15/c-0/15/c-0/122/c-0/7
msgctxt "Stella"
msgid "Thank you so much for sticking up for me."
msgstr "Merci mille fois d'avoir pris ma défense."

# Traduction IA – à relire
#: stella_stairs/stella_celia_takeover/0/c-0/15/c-0/15/c-0/122/c-1/7
msgctxt "Stella"
msgid "Oh that's all right."
msgstr "Oh, ce n'est pas grave."

# Traduction IA – à relire
#: stella_stairs/stella_celia_takeover/0/c-0/15/c-0/15/c-0/122/c-1/15
msgctxt "Stella"
msgid "We'll just sell it under another name."
msgstr "On n'aura qu'à le vendre sous un autre nom."

# Traduction IA – à relire
#: stella_stairs/stella_celia_takeover/0/c-0/15/c-0/15/c-0/122/c-1/23
msgctxt "Stella"
msgid "Nothing will stand in the way of our upright goals!"
msgstr "Rien ne se dressera sur le chemin de nos ambitions ascendantes !"

# Traduction IA – à relire
#: stella_stairs/stella_celia_takeover/0/c-0/15/c-0/15/c-0/122/g-0/25
msgctxt "Reggie"
msgid "Betrayal. The most succulent of hatred."
msgstr "La trahison. La plus succulente des haines."

# Traduction IA – à relire
#: stella_stairs/stella_celia_takeover/0/c-1/7
msgctxt "Stella"
msgid "What! After all we've done together!"
msgstr "Quoi ! Après tout ce qu'on a fait ensemble !"

# Traduction IA – à relire
#: stella_stairs/stella_celia_takeover/0/c-1/18/0/s/0
msgctxt "Choix"
msgid "It's a bad cause... it's a pyramid scheme. I regret it."
msgstr "C'est une mauvaise cause... c'est une vente pyramidale. Je regrette."

# Traduction IA – à relire
#: stella_stairs/stella_celia_takeover/0/c-1/18/c-0/7
msgctxt "Stella"
msgid "Oooohh... you..."
msgstr "Ooooh... toi..."

# Traduction IA – à relire
#: stella_stairs/stella_celia_takeover/0/c-1/18/c-0/18
msgctxt "Stella"
msgid "Hmph."
msgstr "Hmph."

# Traduction IA – à relire
#: stella_stairs/stella_celia_takeover/0/c-1/18/c-0/26
msgctxt "Stella"
msgid "I will rise again. You'll see."
msgstr "Je me relèverai. Tu verras."

# Traduction IA – à relire
#: stella_stairs/stella_celia_takeover/0/c-1/18/c-0/37
msgctxt "Stella"
msgid "You'll all see."
msgstr "Vous verrez tous."

# Traduction IA – à relire
#: stella_stairs/stella_celia_takeover/0/c-1/18/c-0/45
msgctxt "Celia"
msgid "As of today, a moratorium on all Airway products will be imposed throughout the household."
msgstr "À compter d'aujourd'hui, un moratoire sur tous les produits Airway sera imposé dans l'ensemble du foyer."

# Traduction IA – à relire
#: stella_stairs/stella_celia_takeover/0/c-1/18/c-0/53
msgctxt "Celia"
msgid "I believe we're done here."
msgstr "Je crois que nous en avons terminé."

# Traduction IA – à relire
#: stella_stairs/stella_celia_takeover/0/c-1/18/c-0/75/0/s/0
msgctxt "Choix"
msgid "I'm sorry, Stella. I think we can still be friends."
msgstr "Je suis {{désolé|désolée|désolé·e}}, Stella. Je pense qu'on peut rester {{amis|amies|ami·es}}."

# Traduction IA – à relire
#: stella_stairs/stella_celia_takeover/0/c-1/18/c-0/75/1/s/0
msgctxt "Choix"
msgid "That's what you deserve!"
msgstr "C'est ce que tu mérites !"

# Traduction IA – à relire
#: stella_stairs/stella_celia_takeover/0/c-1/18/c-0/75/c-0/7
msgctxt "Stella"
msgid "Not right now."
msgstr "Pas maintenant."

# Traduction IA – à relire
#: stella_stairs/stella_celia_takeover/0/c-1/18/c-0/75/c-0/15
msgctxt "Stella"
msgid "Not... right now."
msgstr "Pas... maintenant."

# Traduction IA – à relire
#: stella_stairs/stella_mission_checkin/0/0
msgctxt "Stella"
msgid "Oh Lieutenant! You've returned!"
msgstr "Oh, Lieutenant ! Tu es de retour !"

# Traduction IA – à relire
#: stella_stairs/stella_mission_checkin/0/8
msgctxt "Stella"
msgid "How goes the search for more recruits?"
msgstr "Comment avance la chasse aux recrues ?"

# Traduction IA – à relire
#: stella_stairs/stella_mission_checkin/0/16/s/0
msgctxt "Choix"
msgid "I've convinced them all!"
msgstr "Je les ai tous convaincus !"

# Traduction IA – à relire
#: stella_stairs/stella_mission_checkin/0/17/s/0
msgctxt "Choix"
msgid "I need to check in with Penelope."
msgstr "Il faut que je passe voir Penelope."

# Traduction IA – à relire
#: stella_stairs/stella_mission_checkin/0/18/s/0
msgctxt "Choix"
msgid "I, Ronaldini, gotta find him first."
msgstr "Moi, Ronaldini, il faut que je le trouve d'abord."

# Traduction IA – à relire
#: stella_stairs/stella_mission_checkin/0/19/s/0
msgctxt "Choix"
msgid "Forgot to see if Winnifred was interested."
msgstr "J'ai oublié de voir si Winnifred était intéressée."

# Traduction IA – à relire
#: stella_stairs/stella_mission_checkin/0/20/s/0
msgctxt "Choix"
msgid "I was able to seal the deal with Florence!"
msgstr "J'ai réussi à conclure l'affaire avec Florence !"

# Traduction IA – à relire
#: stella_stairs/stella_mission_checkin/0/g-0/3
msgctxt "Stella"
msgid "Well, go on then!"
msgstr "Eh bien, vas-y, alors !"

# Traduction IA – à relire
#: stella_stairs/florence_divert/0/0
msgctxt "Stella"
msgid "I had been working that angle for weeks, right under the Mayor's upturned nose!"
msgstr "Ça faisait des semaines que je travaillais cette piste, juste sous le nez retroussé de la Maire !"

# Traduction IA – à relire
#: stella_stairs/florence_divert/0/8
msgctxt "Stella"
msgid "Dropping free samples hither and yon..."
msgstr "À semer des échantillons gratuits à droite et à gauche..."

# Traduction IA – à relire
#: stella_stairs/florence_divert/0/16/s/0
msgctxt "Choix"
msgid "She said that there's a part that mentions 'indentured servitude'?"
msgstr "Elle dit qu'il y a un passage qui parle de « servitude sous contrat » ?"

# Traduction IA – à relire
#: stella_stairs/florence_divert/0/c-0/7
msgctxt "Stella"
msgid "Oh that? That's a typo."
msgstr "Oh, ça ? C'est une coquille."

# Traduction IA – à relire
#: stella_stairs/florence_divert/0/c-0/18/0/s/0
msgctxt "Choix"
msgid "That's what I told her!"
msgstr "C'est ce que je lui ai dit !"

# Traduction IA – à relire
#: stella_stairs/florence_divert/0/c-0/18/1/s/0
msgctxt "Choix"
msgid "That's a very large typo."
msgstr "C'est une très grosse coquille."

# Traduction IA – à relire
#: stella_stairs/florence_divert/0/c-0/18/c-0/7
msgctxt "Stella"
msgid "You are a closer, and I certainly feel a bit... closer to you now."
msgstr "Tu sais conclure, et je me sens un peu plus... proche de toi, maintenant."

# Traduction IA – à relire
#: stella_stairs/florence_divert/0/c-0/18/c-1/7
msgctxt "Stella"
msgid "Only the largest for Airway!"
msgstr "Rien que les plus grosses pour Airway !"

# Traduction IA – à relire
#: stella_stairs/StellaCeliaMissionTrue/0/0
msgctxt "Stella"
msgid "And my lieutenant! Wow!"
msgstr "Et mon Lieutenant ! Ouah !"

# Traduction IA – à relire
#: stella_stairs/StellaCeliaMissionTrue/0/8
msgctxt "Stella"
msgid "This is an unexpected get!"
msgstr "Voilà une prise inattendue !"

# Traduction IA – à relire
#: stella_stairs/StellaCeliaMissionTrue/0/16
msgctxt "Stella"
msgid "I was having trouble even turning heads and you've grabbed the mayor."
msgstr "J'avais déjà du mal à attirer un regard, et toi, tu m'attrapes la Maire."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaMissionTrue/0/24
msgctxt "Stella"
msgid "Makes me feel. A bit inadequate! To be honest!"
msgstr "Ça me fait me sentir. Un peu nulle ! Pour être honnête !"

# Traduction IA – à relire
#: stella_stairs/StellaCeliaMissionTrue/0/32
msgctxt "Celia"
msgid "\"Lieutenant\"?"
msgstr "« Lieutenant » ?"

# Traduction IA – à relire
#: stella_stairs/StellaCeliaMissionTrue/0/40/s/0
msgctxt "Choix"
msgid "I \"joined\" because otherwise she wouldn't talk to me."
msgstr "J'ai « adhéré » parce que sinon, elle refusait de me parler."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaMissionTrue/0/41/s/0
msgctxt "Choix"
msgid "It's part of the schtick."
msgstr "Ça fait partie du numéro."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaMissionTrue/0/g-0/0
msgctxt "Stella"
msgid "H-Huh?"
msgstr "H-hein ?"

# Traduction IA – à relire
#: stella_stairs/StellaCeliaMissionTrue/0/g-0/8
msgctxt "Celia"
msgid "I see..."
msgstr "Je vois..."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaMissionTrue/0/g-0/16
msgctxt "Celia"
msgid "I'm afraid I'm not here to buy your snake oil, Stella. I'm here to put an end to it."
msgstr "Je crains de ne pas être venue acheter votre poudre de perlimpinpin, Stella. Je suis venue y mettre fin."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaMissionTrue/0/g-0/24
msgctxt "Celia"
msgid "I want Airway out of this house."
msgstr "Je veux qu'Airway quitte cette maison."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaMissionTrue/0/g-0/32
msgctxt "Stella"
msgid "W-What?"
msgstr "Q-quoi ?"

# Traduction IA – à relire
#: stella_stairs/StellaCeliaMissionTrue/0/g-0/43
msgctxt "Stella"
msgid "Lieutenant... You're betraying me?"
msgstr "Lieutenant... Tu me trahis ?"

# Traduction IA – à relire
#: stella_stairs/StellaCeliaMissionTrue/0/g-0/54/s/0
msgctxt "Choix"
msgid "I tried to warn you. It's for your own good."
msgstr "J'ai essayé de te prévenir. C'est pour ton bien."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaMissionTrue/0/g-0/55/s/0
msgctxt "Choix"
msgid "I just want you two to talk this through."
msgstr "Je veux juste que vous en parliez toutes les deux."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaMissionTrue/0/g-0/56/s/0
msgctxt "Choix"
msgid "This is what pyramid schemes do, Stella. You have to step on others to get what you want."
msgstr "C'est ça, une vente pyramidale, Stella. Il faut marcher sur les autres pour obtenir ce qu'on veut."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaMissionTrue/0/g-0/c-2/7
msgctxt "Stella"
msgid "Betrayal, for my own good."
msgstr "Une trahison, pour mon bien."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaMissionTrue/0/g-0/c-3/7
msgctxt "Stella"
msgid "Well that's certainly not the impression."
msgstr "Eh bien, ce n'est pas vraiment l'impression que ça donne."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaMissionTrue/0/g-1/8
msgctxt "Stella"
msgid "You think this is teaching me a lesson."
msgstr "Tu crois que ça va me servir de leçon."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaMissionTrue/0/g-1/16
msgctxt "Stella"
msgid "You think you're doing me a favor."
msgstr "Tu crois que tu me rends service."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaMissionTrue/0/g-1/24
msgctxt "Stella"
msgid "You're not."
msgstr "Ce n'est pas le cas."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaMissionTrue/0/g-1/32
msgctxt "Stella"
msgid "I was finally getting off the ground..."
msgstr "Je commençais enfin à décoller..."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/6
msgctxt "Narrator"
msgid "A distinguished beauty greets you with an elegant wave. You never really thought so many hard corners and angles could be soft and graceful, but she's really selling it somehow."
msgstr "Une beauté distinguée vous salue d'un geste élégant. Vous n'auriez jamais cru que tant d'angles et d'arêtes puissent être aussi doux et gracieux, mais elle arrive on ne sait comment à vous le vendre."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/14
msgctxt "Stella"
msgid "Oh hello dearie. Mind your step, I'm getting a bit creaky in my old age."
msgstr "Oh, bonjour, mon petit chou. Attention à la marche, je deviens un peu grinçante avec l'âge."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/22
msgctxt "Stella"
msgid "I'm working on it, mind you."
msgstr "J'y travaille, remarque."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/30
msgctxt "Stella"
msgid "I'm Stella - your quickest way up and down between floor and ceiling."
msgstr "Je suis Stella, ton chemin le plus rapide pour monter et descendre entre le sol et le plafond."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/48/s/0
msgctxt "Choix"
msgid "I don't mind the creak, feels homey."
msgstr "Le grincement ne me dérange pas, ça fait chez-soi."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/49/s/0
msgctxt "Choix"
msgid "You are a noisy old thing, aren't you?"
msgstr "T'es une vieille chose bruyante, toi, hein ?"

# Traduction IA – à relire
#: stella_stairs/Stella1/0/50/s/0
msgctxt "Choix"
msgid "Good for you."
msgstr "Tant mieux pour toi."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/c-0/7
msgctxt "Stella"
msgid "Well aren't you a sweet summer thing. I appreciate the sentiment."
msgstr "Eh bien, que tu es {{mignon|mignonne|mignon·ne}}, toi. J'apprécie l'intention."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/c-0/15
msgctxt "Stella"
msgid "Still, one step at a time, alright? Just in case. And step and step and step and step."
msgstr "Enfin, une marche à la fois, d'accord ? Juste au cas où. Et une marche, et une marche, et une marche, et une marche."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/c-0/23
msgctxt "Stella"
msgid "Least that's what they say."
msgstr "C'est du moins ce qu'on dit."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/c-0/31/0/s/0
msgctxt "Choix"
msgid "One step at a time."
msgstr "Une marche à la fois."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/c-0/31/1/s/0
msgctxt "Choix"
msgid "That's a lot of steps."
msgstr "Ça fait beaucoup de marches."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/c-0/31/c-0/7
msgctxt "Stella"
msgid "That's the way, step on through."
msgstr "Voilà, c'est ça, avance d'un pas."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/c-0/31/c-1/7
msgctxt "Stella"
msgid "Just take it step by step."
msgstr "Vas-y juste marche après marche."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/c-0/31/c-1/15
msgctxt "Stella"
msgid "By step."
msgstr "Après marche."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/c-1/7
msgctxt "Stella"
msgid "That's me to a T, chitter chatter."
msgstr "C'est tout moi, ça, papoter."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/c-1/15
msgctxt "Stella"
msgid "I've gotta get the words out while I can since everyone's always coming and going, especially since they never stay long."
msgstr "Il faut que je sorte mes mots tant que je peux, puisque tout le monde ne fait que passer, surtout qu'ils ne restent jamais longtemps."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/c-1/23
msgctxt "Stella"
msgid "Gotta get my steps up, if steps were words, which they aren't, but still..."
msgstr "Il faut que je fasse mes pas, si les pas étaient des mots, ce qu'ils ne sont pas, mais quand même..."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/c-1/31
msgctxt "Stella"
msgid "Talking's good for the soul, apparently."
msgstr "Parler, c'est bon pour l'âme, paraît-il."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/c-1/39
msgctxt "Stella"
msgid "Sorry, still figuring it out, this whole talking thing. Step by step they say. Step by step by step."
msgstr "Désolée, je découvre encore tout ça, cette histoire de parler. Marche après marche, comme on dit. Marche après marche après marche."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/c-2/7
msgctxt "Stella"
msgid "Thanks sweetie. One step at a time they say. Step by step by step."
msgstr "Merci, mon cœur. Une marche à la fois, comme on dit. Marche après marche après marche."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/g-0/0/s/0
msgctxt "Choix"
msgid "Laying it on a bit thick there."
msgstr "Tu en fais un peu des tonnes, là."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/g-0/1/s/0
msgctxt "Choix"
msgid "Maybe take some smaller steps?"
msgstr "Et si tu faisais des pas un peu plus petits ?"

# Traduction IA – à relire
#: stella_stairs/Stella1/0/g-0/2/s/0
msgctxt "Choix"
msgid "I'll be on my way then."
msgstr "Je vais y aller, alors."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/g-0/c-3/7
msgctxt "Narrator"
msgid "She gives you a surprisingly cheeky little wink."
msgstr "Elle vous adresse un petit clin d'œil étonnamment espiègle."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/g-0/c-3/15
msgctxt "Stella"
msgid "They call it branding, apparently. It still feels a bit creaky to me too."
msgstr "On appelle ça le branding, paraît-il. Ça me paraît encore un peu grinçant, à moi aussi."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/g-0/c-4/7
msgctxt "Stella"
msgid "Oh but you've got to dream big, you know? HUSTLE! I believe, is the word?"
msgstr "Oh, mais il faut voir grand, tu sais ? SE BOUGER ! C'est le mot, je crois ?"

# Traduction IA – à relire
#: stella_stairs/Stella1/0/g-0/c-5/7
msgctxt "Stella"
msgid "Ah. Yes, of course. Sorry to bother dear."
msgstr "Ah. Oui, bien sûr. Désolée de déranger, mon chou."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/g-1/0/s/0
msgctxt "Choix"
msgid "Branding for what?"
msgstr "Du branding pour quoi ?"

# Traduction IA – à relire
#: stella_stairs/Stella1/0/g-1/1/s/0
msgctxt "Choix"
msgid "Hustle for what?"
msgstr "Se bouger pour quoi ?"

# Traduction IA – à relire
#: stella_stairs/Stella1/0/g-1/2/s/0
msgctxt "Choix"
msgid "Well I say keep on creaking."
msgstr "Eh bien, moi, je dis : continue de grincer."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/g-1/3/s/0
msgctxt "Choix"
msgid "Hustle has a couple meanings, I think."
msgstr "« Se bouger », ça a plusieurs sens, je crois."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/g-1/4/s/0
msgctxt "Choix"
msgid "You're not a bother."
msgstr "Tu ne déranges pas."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/g-1/5/s/0
msgctxt "Choix"
msgid "Just in a rush is all."
msgstr "Je suis juste {{pressé|pressée|pressé·e}}, c'est tout."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/g-1/c-6/7 stella_stairs/Stella1/0/g-1/c-7/7
msgctxt "Stella"
msgid "Self-sufficiency."
msgstr "L'autonomie."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/g-1/c-8/7
msgctxt "Stella"
msgid "Oh no we can't have that. Creaking is a sign of weakness."
msgstr "Oh non, pas question. Grincer, c'est un signe de faiblesse."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/g-1/c-8/15/0/s/0
msgctxt "Choix"
msgid "It's just noise, there's no need to be self-conscious."
msgstr "Ce n'est que du bruit, pas besoin d'être complexée."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/g-1/c-8/15/1/s/0
msgctxt "Choix"
msgid "What's a little structural weakness?"
msgstr "C'est quoi, une petite faiblesse structurelle ?"

# Traduction IA – à relire
#: stella_stairs/Stella1/0/g-1/c-8/15/2/s/0
msgctxt "Choix"
msgid "I'd say there are bigger signs of weakness."
msgstr "Il y a de pires signes de faiblesse, à mon avis."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/g-1/c-8/15/c-0/7
msgctxt "Stella"
msgid "I wouldn't say I'm self-conscious."
msgstr "Je ne dirais pas que je suis complexée."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/g-1/c-8/15/c-0/15
msgctxt "Stella"
msgid "Just conscious."
msgstr "Juste consciente."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/g-1/c-8/15/c-1/7
msgctxt "Stella"
msgid "A big deal is what it is."
msgstr "Une grosse affaire, voilà ce que c'est."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/g-1/c-8/15/c-2/7
msgctxt "Stella"
msgid "Oh indeed. I've a lot to work on, I know. Creaking's just a part of it."
msgstr "Oh, absolument. J'ai beaucoup de travail sur moi, je sais. Le grincement n'en est qu'une partie."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/g-1/c-8/15/g-0/0
msgctxt "Stella"
msgid "First impressions and all that."
msgstr "La première impression, tout ça."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/g-1/c-9/7
msgctxt "Stella"
msgid "One of those tricky ones, huh? I'm learning a lot of new words lately, you'll have to forgive me."
msgstr "Un de ces mots piégeux, hein ? J'apprends beaucoup de mots nouveaux, ces temps-ci, il faudra me pardonner."

# Traduction IA – à relire
#: stella_stairs/Stella1/0/g-2/0
msgctxt "Stella"
msgid "Oh bother, I've been a bother, haven't I... I'm sorry. I'm just..."
msgstr "Oh, misère, je t'ai {{dérangé|dérangée|dérangé·e}}, hein... Je suis désolée. C'est juste que..."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/0
msgctxt "Stella"
msgid "You see..."
msgstr "Tu vois..."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/8 stella_stairs/StellaBusiness/0/g-0/c-4/15/c-0/7
msgctxt "Stella"
msgid "Well..."
msgstr "Eh bien..."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/19
msgctxt "Narrator"
msgid "Stella looks everywhere but at you, trying and failing to find the words. Eventually she sighs, plucking up the courage from somewhere within her."
msgstr "Stella regarde partout sauf vers vous, cherchant ses mots sans les trouver. Elle finit par soupirer et puise du courage quelque part en elle."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/27
msgctxt "Stella"
msgid "Truth be told..."
msgstr "À vrai dire..."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/35
msgctxt "Stella"
msgid "I'm starting a business."
msgstr "Je lance une entreprise."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/46
msgctxt "Narrator"
msgid "She gives you a nervous but sweet smile."
msgstr "Elle vous adresse un sourire nerveux mais adorable."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/54/s/0
msgctxt "Choix"
msgid "I see..."
msgstr "Je vois..."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/55/s/0
msgctxt "Choix"
msgid "That's great! Congratulations."
msgstr "C'est génial ! Félicitations."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/56/s/0
msgctxt "Choix"
msgid "What kind of business?"
msgstr "Quel genre d'entreprise ?"

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/c-0/7
msgctxt "Stella"
msgid "I know! I'm a bit speechless myself!"
msgstr "Je sais ! J'en reste un peu sans voix moi-même !"

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/c-1/7
msgctxt "Stella"
msgid "Oh, thank you, dearie! It's all a bit exciting."
msgstr "Oh, merci, mon petit chou ! Tout ça est un peu excitant."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/c-1/15
msgctxt "Stella"
msgid "I've never really had a \"thing\" like this before. A project. A goal."
msgstr "Je n'ai jamais vraiment eu de « truc » comme ça avant. Un projet. Un objectif."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/c-1/23
msgctxt "Stella"
msgid "Never really thought I would, truth be told."
msgstr "Je n'aurais jamais vraiment cru en avoir un, à vrai dire."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/c-2/7
msgctxt "Stella"
msgid "Well it's... A lot of things! But I'm focusing on a new release right now. Market research tells me it's a little lacking around here..."
msgstr "Eh bien, c'est... Plein de choses ! Mais je me concentre sur un nouveau lancement pour l'instant. D'après mon étude de marché, ça manque un peu par ici..."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/c-2/18
msgctxt "Stella"
msgid "No offense to anyone of course!"
msgstr "Sans vouloir vexer personne, bien sûr !"

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/c-2/26/0/s/0
msgctxt "Choix"
msgid "None taken."
msgstr "Pas de souci."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/c-2/26/1/s/0
msgctxt "Choix"
msgid "You mean me?"
msgstr "Tu parles de moi ?"

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/c-2/26/c-0/7
msgctxt "Stella"
msgid "Oh. Thank goodness."
msgstr "Oh. Dieu merci."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/c-2/26/c-1/7
msgctxt "Stella"
msgid "Oh goodness no!"
msgstr "Oh, Seigneur, non !"

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/c-2/26/c-1/15
msgctxt "Stella"
msgid "Just..."
msgstr "Juste..."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/c-2/26/c-1/23
msgctxt "Stella"
msgid "Everyone. In general. I imagine there'll be high demand! At least that's what the booklet says."
msgstr "Tout le monde. En général. J'imagine qu'il y aura une forte demande ! C'est du moins ce que dit le livret."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-0/0
msgctxt "Stella"
msgid "You know. If you were interested, I could get you in on the ground level."
msgstr "Tu sais. Si ça t'intéresse, je pourrais te faire entrer dès le rez-de-chaussée."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-0/8/s/0
msgctxt "Choix"
msgid "Actually... I have the mayor coming over to talk about that..."
msgstr "En fait... la Maire doit passer me voir pour en parler..."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-0/9/s/0
msgctxt "Choix"
msgid "I think I'm ok."
msgstr "Je crois que ça ira."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-0/10/s/0
msgctxt "Choix"
msgid "Tell me more?"
msgstr "Raconte-m'en plus ?"

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-0/11/s/0
msgctxt "Choix"
msgid "Have you ever heard of a pyramid scheme?"
msgstr "Tu as déjà entendu parler de la vente pyramidale ?"

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-0/c-4/7
msgctxt "Stella"
msgid "Are you sure? Business is booming you know. It's the perfect time to get on board."
msgstr "Tu es {{sûr|sûre|sûr·e}} ? Les affaires sont florissantes, tu sais. C'est le moment idéal pour monter à bord."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-0/c-4/15/0/s/0
msgctxt "Choix"
msgid "Is it now?"
msgstr "Ah bon ?"

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-0/c-4/15/c-0/23 stella_stairs/Stella3Sad/0/c-1/39
msgctxt "Stella"
msgid "Not really."
msgstr "Pas vraiment."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-0/c-4/15/c-0/31
msgctxt "Stella"
msgid "Oh I'm not great at going off book, sorry dearie. It all seemed a lot easier in the booklet."
msgstr "Oh, je ne suis pas douée pour sortir du livret, désolée, mon petit chou. Ça paraissait bien plus simple dans le livret."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-0/c-5/18
msgctxt "Narrator"
msgid "Stella looks almost touched."
msgstr "Stella semble presque émue."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-0/c-5/26
msgctxt "Stella"
msgid "Really?"
msgstr "Vraiment ?"

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-0/c-5/34
msgctxt "Stella"
msgid "No one's ever said that."
msgstr "Personne ne m'avait jamais dit ça."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-0/c-5/42
msgctxt "Stella"
msgid "Well!"
msgstr "Eh bien !"

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-0/c-5/50
msgctxt "Stella"
msgid "Well now I'm all a bit frazzled. Sorry dear. I'm very grateful, it's just, I've not gotten this far before. Let me check the booklet."
msgstr "Eh bien, me voilà toute chamboulée. Désolée, mon chou. Je suis très reconnaissante, c'est juste que je ne suis jamais allée aussi loin. Laisse-moi vérifier le livret."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-0/c-6/7
msgctxt "Stella"
msgid "I mean I've heard about the pyramids. Beautiful things, always wanted to see them. Never had the time. Probably a little too late now though , isn't it?"
msgstr "Enfin, j'ai entendu parler des pyramides. De si belles choses, j'ai toujours voulu les voir. Jamais eu le temps. Un peu trop tard maintenant, sans doute, non ?"

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-0/c-6/15
msgctxt "Stella"
msgid "Oh no I've gone off book. It all seemed so much easier in the booklet."
msgstr "Oh non, je suis sortie du livret. Tout paraissait tellement plus simple dans le livret."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-1/0/s/0
msgctxt "Choix"
msgid "Booklet?"
msgstr "Le livret ?"

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-1/1/s/0
msgctxt "Choix"
msgid "You're reading from a script?"
msgstr "Tu lis un script ?"

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-1/2/s/0
msgctxt "Choix"
msgid "What seemed easier?"
msgstr "Qu'est-ce qui paraissait plus simple ?"

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-1/c-7/7
msgctxt "Stella"
msgid "They sent it to me when I signed up."
msgstr "Ils me l'ont envoyé quand je me suis inscrite."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-1/c-8/7
msgctxt "Stella"
msgid "I thought I had it locked down. The script. They tell you what to say and how to say it. Problem is I haven't the darndest charisma for it."
msgstr "Je croyais le maîtriser. Le script. Ils te disent quoi dire et comment le dire. Le problème, c'est que je n'ai pas le moindre fichu charisme pour ça."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-1/c-9/7
msgctxt "Stella"
msgid "\"Making the sale\". That's what they call it."
msgstr "« Conclure la vente ». C'est comme ça qu'ils appellent ça."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-2/0
msgctxt "Stella"
msgid "Stella's Steps to Success. How to sell that sale and change your life. Generate passive income and financial freedom, all from the comfort of your own home."
msgstr "Les Marches du succès de Stella. Comment vendre la vente et changer de vie. Générez des revenus passifs et gagnez votre liberté financière, sans quitter le confort de votre foyer."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-2/11
msgctxt "Narrator"
msgid "Stella pulls out a pamphlet from deep in her bag."
msgstr "Stella tire une brochure du fond de son sac."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-2/22
msgctxt "Stella"
msgid "I memorised that part at least."
msgstr "Au moins, ce passage-là, je l'ai appris par cœur."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-2/30/s/0
msgctxt "Choix"
msgid "Looks like someone's just scrawled your name in front of some boilerplate text."
msgstr "On dirait que quelqu'un a juste griffonné ton nom devant un texte tout fait."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-2/31/s/0
msgctxt "Choix"
msgid "I think you're being scammed, Stella."
msgstr "Je crois que tu te fais arnaquer, Stella."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-2/c-10/7
msgctxt "Stella"
msgid "It does, doesn't it? And they probably did. Still, it felt rude to throw it out. There's some good advice in here, really. Like this one!"
msgstr "C'est vrai, hein ? Et c'est sûrement ce qu'ils ont fait. Mais ça me paraissait malpoli de la jeter. Il y a de bons conseils là-dedans, vraiment. Comme celui-là !"

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-2/c-10/15
msgctxt "Narrator"
msgid "She unfolds the pamphlet and begins to read."
msgstr "Elle déplie la brochure et commence à lire."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-2/c-10/23
msgctxt "Stella"
msgid "Step 29: You can never have too much stock, but you can run out of storage space. Consider investing in a larger house."
msgstr "Étape 29 : on n'a jamais trop de stock, mais on peut manquer de place pour le ranger. Envisagez d'investir dans une plus grande maison."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-2/c-10/31/0/s/0
msgctxt "Choix"
msgid "That seems dramatic."
msgstr "Ça me paraît excessif."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-2/c-10/31/1/s/0
msgctxt "Choix"
msgid "Of course, why didn't I think of that!?"
msgstr "Mais bien sûr, comment je n'y ai pas pensé !?"

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-2/c-10/31/2/s/0
msgctxt "Choix"
msgid "That's terrible advice."
msgstr "C'est un conseil horrible."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-2/c-10/31/c-0/7
msgctxt "Stella"
msgid "Well it is a little... Bold. But maybe that's what I need. BOLD."
msgstr "Eh bien, c'est un peu... audacieux. Mais c'est peut-être ce qu'il me faut. De l'AUDACE."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-2/c-10/31/c-1/7
msgctxt "Stella"
msgid "Oh! I actually struggled with that one a bit. Didn't quite ring right, you know? But I guess it makes sense to some people."
msgstr "Oh ! En fait, celui-là m'a un peu posé problème. Il ne sonnait pas tout à fait juste, tu vois ? Mais j'imagine qu'il a du sens pour certains."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-2/c-10/31/c-2/7
msgctxt "Stella"
msgid "Oh. Is it? WAIT. Step 41: People will tell you that this is terrible advice. Ignore them."
msgstr "Oh. Tu crois ? ATTENDS. Étape 41 : on vous dira que c'est un conseil horrible. Ignorez-les."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-2/c-10/31/c-2/15
msgctxt "Stella"
msgid "That does seem rather rude though. Ignoring you."
msgstr "Ça me paraît assez malpoli, quand même. De t'ignorer."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-2/c-10/31/c-2/23
msgctxt "Stella"
msgid "I might ignore that one."
msgstr "Je vais peut-être ignorer celui-là."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-2/c-11/7
msgctxt "Stella"
msgid "Well let's not get too dramatic. It's hard work sure, but isn't anything? They even tell you that! Step 37: Not everyone will make it, but drive and passion are the fuel that fans the flame. Patience is a virtue, and success is for the virtuous."
msgstr "Bon, ne dramatisons pas trop. C'est du travail, bien sûr, mais quoi n'en est pas ? Ils te le disent, d'ailleurs ! Étape 37 : tout le monde n'y arrivera pas, mais l'ambition et la passion sont le combustible qui attise la flamme. La patience est une vertu, et le succès est réservé aux vertueux."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-2/c-11/15
msgctxt "Stella"
msgid "Doesn't that just make you want to get to work!?"
msgstr "Ça ne te donne pas juste envie de te mettre au travail !?"

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-2/c-11/23/0/s/0
msgctxt "Choix"
msgid "Does it make you want to get to work?"
msgstr "Ça te donne envie de te mettre au travail, toi ?"

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-2/c-11/23/1/s/0
msgctxt "Choix"
msgid "Speaking of work, I'm in a bit of a hurry, sorry Stella."
msgstr "En parlant de travail, je suis un peu {{pressé|pressée|pressé·e}}, {{désolé|désolée|désolé·e}}, Stella."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-2/c-11/23/2/s/0
msgctxt "Choix"
msgid "It kind of does, actually."
msgstr "Un peu, en fait."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-2/c-11/23/c-0/7
msgctxt "Stella"
msgid "Yes, actually. It does. Make something of myself."
msgstr "Oui, en fait. Ça me donne envie. De devenir quelqu'un."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-2/c-11/23/c-1/7
msgctxt "Stella"
msgid "Oh, of course, dearie! Silly me. I should let you go."
msgstr "Oh, bien sûr, mon petit chou ! Que je suis bête. Je devrais te laisser partir."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-2/c-11/23/c-2/7
msgctxt "Stella"
msgid "They really know their stuff."
msgstr "Ils s'y connaissent vraiment."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-3/3
msgctxt "Stella"
msgid "Oh I really have gone off track now haven't I... Booklet or not this is a mess."
msgstr "Oh, je me suis vraiment égarée, là, hein... Livret ou pas, c'est un désastre."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-3/11
msgctxt "Stella"
msgid "Look dearie, I'm so sorry to ask, but could you come by again someday soon? Give me another shot. I'm still working on my nerves."
msgstr "Écoute, mon petit chou, je suis vraiment désolée de te demander ça, mais tu pourrais repasser un de ces jours ? Me laisser une autre chance. Je travaille encore sur mes nerfs."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-3/19
msgctxt "Stella"
msgid "And there really are a lot of fancy words to learn."
msgstr "Et il y a vraiment beaucoup de mots compliqués à apprendre."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-3/27
msgctxt "Stella"
msgid "I'll throw in a free sample? Gotta get rid of them SOMEHOW. Haha. Ha..."
msgstr "Je t'offrirai un échantillon gratuit ? Il faut bien que je m'en débarrasse D'UNE MANIÈRE OU D'UNE AUTRE. Haha. Ha..."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-3/38/s/0
msgctxt "Choix"
msgid "I'd rather not take part in a glorified scam."
msgstr "Je préfère ne pas participer à une arnaque déguisée."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-3/39/s/0
msgctxt "Choix"
msgid "I'll swing by when I can."
msgstr "Je repasserai quand je pourrai."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-3/40/s/0
msgctxt "Choix"
msgid "I might have the time. We'll have to see."
msgstr "J'aurai peut-être le temps. On verra."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-3/41/s/0
msgctxt "Choix"
msgid "Of course Stella, not a worry."
msgstr "Bien sûr, Stella, pas de souci."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-3/c-12/7
msgctxt "Stella"
msgid "Well it's not... I don't think... Yes, of course dearie. Sorry to bother."
msgstr "Eh bien, ce n'est pas... Je ne crois pas... Oui, bien sûr, mon petit chou. Désolée de déranger."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-3/c-13/7
msgctxt "Stella"
msgid "Oh you're a sweetheart, dearie, thank you!"
msgstr "Oh, tu es un amour, mon petit chou, merci !"

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-3/c-14/7
msgctxt "Stella"
msgid "Of course! I wouldn't want to impose dearie."
msgstr "Bien sûr ! Je ne voudrais pas m'imposer, mon petit chou."

# Traduction IA – à relire
#: stella_stairs/StellaBusiness/0/g-3/c-15/7
msgctxt "Stella"
msgid "You're too kind. I do appreciate it dearie."
msgstr "Tu es trop {{gentil|gentille|gentil·le}}. Ça me touche, mon petit chou."

# Traduction IA – à relire
#: stella_stairs/StellaScam2/0/0
msgctxt "Stella"
msgid "Oh. Hello again. I'm assuming you're just... Passing through?"
msgstr "Oh. Re-bonjour. J'imagine que tu ne fais que... passer ?"

# Traduction IA – à relire
#: stella_stairs/StellaScam2/0/8/s/0
msgctxt "Choix"
msgid "Well I do need go to work or bed at some point."
msgstr "Ben, il faut bien que j'aille au travail ou au lit à un moment."

# Traduction IA – à relire
#: stella_stairs/StellaScam2/0/9/s/0
msgctxt "Choix"
msgid "Not here for the scam, just here to check in."
msgstr "Je ne suis pas là pour l'arnaque, juste pour prendre de tes nouvelles."

# Traduction IA – à relire
#: stella_stairs/StellaScam2/0/10/s/0
msgctxt "Choix"
msgid "Sold anything?"
msgstr "Tu as vendu quelque chose ?"

# Traduction IA – à relire
#: stella_stairs/StellaScam2/0/c-0/7
msgctxt "Stella"
msgid "That does make sense. The whole back and the forth. The up and the down."
msgstr "C'est logique. Les allers et les retours. Les montées et les descentes."

# Traduction IA – à relire
#: stella_stairs/StellaScam2/0/c-0/15
msgctxt "Narrator"
msgid "Stella smiles, but it's clear her heart's not in it."
msgstr "Stella sourit, mais le cœur n'y est visiblement pas."

# Traduction IA – à relire
#: stella_stairs/StellaScam2/0/c-0/31
msgctxt "Stella"
msgid "Good to see you."
msgstr "Ça fait plaisir de te voir."

# Traduction IA – à relire
#: stella_stairs/StellaScam2/0/c-1/7
msgctxt "Stella"
msgid "I know. I appreciate it."
msgstr "Je sais. Ça me touche."

# Traduction IA – à relire
#: stella_stairs/StellaScam2/0/c-1/23
msgctxt "Stella"
msgid "It's going about as well as you'd expect."
msgstr "Ça se passe à peu près comme on pouvait s'y attendre."

# Traduction IA – à relire
#: stella_stairs/StellaScam2/0/c-2/7
msgctxt "Stella"
msgid "About as much as you'd expect."
msgstr "À peu près ce qu'on pouvait attendre."

# Traduction IA – à relire
#: stella_stairs/StellaNoScam2/0/0
msgctxt "Stella"
msgid "Oh, dearie, you're back! I'm so glad you came!"
msgstr "Oh, mon petit chou, tu es {{revenu|revenue|revenu·e}} ! Je suis si contente que tu sois là !"

# Traduction IA – à relire
#: stella_stairs/StellaNoScam2/0/8/s/0
msgctxt "Choix"
msgid "Oh I was just passing through!"
msgstr "Oh, je ne faisais que passer !"

# Traduction IA – à relire
#: stella_stairs/StellaNoScam2/0/9/s/0
msgctxt "Choix"
msgid "You didn't think I would be?"
msgstr "Tu pensais que je ne reviendrais pas ?"

# Traduction IA – à relire
#: stella_stairs/StellaNoScam2/0/10/s/0
msgctxt "Choix"
msgid "I told you I'd be back."
msgstr "Je t'avais dit que je reviendrais."

# Traduction IA – à relire
#: stella_stairs/StellaNoScam2/0/c-0/7
msgctxt "Stella"
msgid "Oh you're so funny dearie!"
msgstr "Oh, que tu es drôle, mon petit chou !"

# Traduction IA – à relire
#: stella_stairs/StellaNoScam2/0/c-0/15
msgctxt "Stella"
msgid "Stay a bit, chat with me?"
msgstr "Reste un peu, bavarde avec moi ?"

# Traduction IA – à relire
#: stella_stairs/StellaNoScam2/0/g-0/0
msgctxt "Stella"
msgid "Well... You know."
msgstr "Eh bien... Tu sais."

# Traduction IA – à relire
#: stella_stairs/StellaNoScam2/0/g-0/8
msgctxt "Stella"
msgid "Folks can be fickle."
msgstr "Les gens peuvent être volages."

# Traduction IA – à relire
#: stella_stairs/StellaNoScam2/0/g-0/16
msgctxt "Stella"
msgid "It's no one's fault!"
msgstr "Ce n'est la faute de personne !"

# Traduction IA – à relire
#: stella_stairs/StellaNoScam2/0/g-0/24
msgctxt "Stella"
msgid "But it's nice when anyone takes the time."
msgstr "Mais c'est agréable quand quelqu'un prend le temps."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/6
msgctxt "Stella"
msgid "As you can see. Business is hardly booming."
msgstr "Comme tu vois. Les affaires sont loin d'être florissantes."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/14
msgctxt "Stella"
msgid "Of course it'd be ridiculous to expect success so quickly, wouldn't it!?"
msgstr "Évidemment, ce serait ridicule d'espérer réussir si vite, non !?"

# Traduction IA – à relire
#: stella_stairs/Stella2/0/22
msgctxt "Stella"
msgid "\"Success is a long man's game.\""
msgstr "« Le succès est un jeu pour les hommes longs. »"

# Traduction IA – à relire
#: stella_stairs/Stella2/0/30
msgctxt "Stella"
msgid "Or a \"long game?\""
msgstr "Ou c'était « un jeu de longue haleine » ?"

# Traduction IA – à relire
#: stella_stairs/Stella2/0/38
msgctxt "Stella"
msgid "Or was it \"a man's game?\""
msgstr "Ou alors « un jeu d'hommes » ?"

# Traduction IA – à relire
#: stella_stairs/Stella2/0/46
msgctxt "Stella"
msgid "I'll have to check the booklet, but I doubt either of those things are likely to hurt your chances."
msgstr "Il faudra que je vérifie dans le livret, mais je doute que l'un ou l'autre nuise à tes chances."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/54
msgctxt "Stella"
msgid "Maybe I should get some high heels."
msgstr "Je devrais peut-être m'acheter des talons hauts."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/62
msgctxt "Stella"
msgid "People always like long people. Tall people."
msgstr "Les gens aiment toujours les gens longs. Les grands."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/70
msgctxt "Stella"
msgid "I never was all that tall."
msgstr "Je n'ai jamais été bien haute."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/78
msgctxt "Stella"
msgid "Not really a thing you can change. Not without money at least."
msgstr "Ce n'est pas vraiment quelque chose qu'on peut changer. Pas sans argent, en tout cas."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/86
msgctxt "Stella"
msgid "Maybe I SHOULD get some heels."
msgstr "Je DEVRAIS peut-être m'acheter des talons."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/94
msgctxt "Stella"
msgid "Maybe that's what I need."
msgstr "C'est peut-être ce qu'il me faut."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/102/s/0
msgctxt "Choix"
msgid "A little height never hurt anyone."
msgstr "Un peu de hauteur n'a jamais fait de mal à personne."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/103/s/0
msgctxt "Choix"
msgid "I don't think heels are the problem."
msgstr "Je ne crois pas que les talons soient le problème."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/104/s/0
msgctxt "Choix"
msgid "Stilettos?"
msgstr "Des stilettos ?"

# Traduction IA – à relire
#: stella_stairs/Stella2/0/c-0/7
msgctxt "Stella"
msgid "Unless they fell."
msgstr "Sauf s'ils tombaient."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/c-0/15
msgctxt "Stella"
msgid "But I've hardly far to fall, so..."
msgstr "Mais je n'ai pas bien haut d'où tomber, alors..."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/c-1/7
msgctxt "Stella"
msgid "I think you're right."
msgstr "Je crois que tu as raison."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/c-1/15
msgctxt "Stella"
msgid "Unfortunately."
msgstr "Malheureusement."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/c-2/7
msgctxt "Stella"
msgid "Stella Stiletto. Now THAT's a name."
msgstr "Stella Stiletto. Ça, c'est un nom."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/8
msgctxt "Narrator"
msgid "Stella sighs, her shoulders slumping."
msgstr "Stella soupire, les épaules affaissées."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/16
msgctxt "Stella"
msgid "Do you think I'm making a mistake, dearie?"
msgstr "Tu crois que je fais une erreur, mon petit chou ?"

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/24/s/0
msgctxt "Choix"
msgid "Do you?"
msgstr "Et toi ?"

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/25/s/0
msgctxt "Choix"
msgid "I think you're being taken advantage of."
msgstr "Je crois qu'on profite de toi."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/26/s/0
msgctxt "Choix"
msgid "I don't really know what you're doing in the first place."
msgstr "Je ne sais même pas vraiment ce que tu fais, au départ."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/27/s/0
msgctxt "Choix"
msgid "I think you're just trying to make the most of something."
msgstr "Je crois que tu essaies juste de tirer le meilleur de quelque chose."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-3/7
msgctxt "Stella"
msgid "Yes, actually."
msgstr "Oui, en fait."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-3/15
msgctxt "Stella"
msgid "I do."
msgstr "Je le crois."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-3/23
msgctxt "Stella"
msgid "Unfortunately..."
msgstr "Malheureusement..."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-3/31
msgctxt "Stella"
msgid "But I've felt like that my whole existence."
msgstr "Mais je me suis sentie comme ça toute mon existence."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-3/39
msgctxt "Stella"
msgid "At a certain point I'd rather commit to the bit than... than... whatever else <i>isn't</i> happening."
msgstr "À un moment, je préfère jouer le jeu jusqu'au bout plutôt que... que... tout ce qui <i>n'</i>arrive pas."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-3/47/0/s/0
msgctxt "Choix"
msgid "There are better mistakes to make than falling for a pyramid scheme."
msgstr "Il y a de meilleures erreurs à faire que de tomber dans une vente pyramidale."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-3/47/1/s/0
msgctxt "Choix"
msgid "Having a mid-life crisis?"
msgstr "C'est la crise de la cinquantaine ?"

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-3/47/2/s/0
msgctxt "Choix"
msgid "I understand."
msgstr "Je comprends."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-3/47/c-0/7
msgctxt "Stella"
msgid "I know what it is!"
msgstr "Je sais ce que c'est !"

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-3/47/c-0/15
msgctxt "Stella"
msgid "I know \"no one wins.\""
msgstr "Je sais que « personne ne gagne »."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-3/47/c-0/23
msgctxt "Stella"
msgid "But someone does."
msgstr "Mais quelqu'un gagne."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-3/47/c-0/31
msgctxt "Stella"
msgid "I'd like to try winning for once."
msgstr "J'aimerais essayer de gagner, pour une fois."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-3/47/c-0/39
msgctxt "Stella"
msgid "See what it feels like."
msgstr "Voir l'effet que ça fait."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-3/47/c-0/47
msgctxt "Stella"
msgid "Even if it is a mistake."
msgstr "Même si c'est une erreur."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-3/47/c-0/63
msgctxt "Stella"
msgid "Call me naive."
msgstr "Traite-moi de naïve."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-3/47/c-1/7
msgctxt "Stella"
msgid "Well it is a little overdue, mind you."
msgstr "Eh bien, elle arrive un peu tard, remarque."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-3/47/c-1/15
msgctxt "Stella"
msgid "At least it's productive."
msgstr "Au moins, c'est productif."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-3/47/c-1/23
msgctxt "Stella"
msgid "Somewhat."
msgstr "Plus ou moins."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-3/47/c-2/7
msgctxt "Stella"
msgid "Well you're very kind, dearie."
msgstr "Eh bien, tu es très {{gentil|gentille|gentil·le}}, mon petit chou."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-3/47/g-0/0
msgctxt "Stella"
msgid "You know."
msgstr "Tu sais."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-3/47/g-0/8
msgctxt "Stella"
msgid "You'd make a good sales lieutenant."
msgstr "Tu ferais un bon Lieutenant des ventes."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-3/47/g-0/20/1/s/0
msgctxt "Choix"
msgid "I'm not really cut out for that."
msgstr "Je ne suis pas vraiment {{fait|faite|fait·e}} pour ça."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-3/47/g-0/20/c-0/7
msgctxt "Stella"
msgid "Absolutely. I mean, if I can do it, you certainly can."
msgstr "Absolument. Enfin, si moi j'y arrive, toi, tu y arriveras sans problème."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-3/47/g-0/20/c-1/7
msgctxt "Stella"
msgid "Nonsense. Look at me! If I can do it, you certainly can."
msgstr "Sottises. Regarde-moi ! Si moi j'y arrive, toi, tu y arriveras sans problème."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-3/47/g-0/20/g-0/0/0/s/0
msgctxt "Choix"
msgid "But can you do it?"
msgstr "Mais toi, tu y arrives ?"

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-3/47/g-0/20/g-0/0/1/s/0
msgctxt "Choix"
msgid "Well... Maybe I could."
msgstr "Bon... peut-être que je pourrais."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-3/47/g-0/20/g-0/0/c-0/7
msgctxt "Stella"
msgid "Ay, there's the rub. Isn't it?"
msgstr "Ah, voilà bien le hic. Pas vrai ?"

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-3/47/g-0/20/g-0/0/c-0/15
msgctxt "Stella"
msgid "I have been working on the pitch, mind you. If you wouldn't mind being my test audience?"
msgstr "Remarque, je travaille sur mon boniment. Ça t'ennuierait d'être mon public test ?"

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-3/47/g-0/20/g-0/0/c-1/7
msgctxt "Stella"
msgid "You know. I could take you under my wing, so to speak. Show you the steps."
msgstr "Tu sais. Je pourrais te prendre sous mon aile, pour ainsi dire. Te montrer les marches."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-3/47/g-0/20/g-0/0/c-1/15
msgctxt "Stella"
msgid "I should show you the pitch first though, shouldn't I?"
msgstr "Mais je devrais d'abord te montrer mon boniment, non ?"

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-3/47/g-0/20/g-0/1/s/0
msgctxt "Choix"
msgid "Lieutenant?"
msgstr "Lieutenant ?"

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-3/47/g-0/20/g-0/c-2/7
msgctxt "Stella"
msgid "I know. It's a little silly isn't it? Still, I kind of like it. Lieutenant Stella. It sounds very important."
msgstr "Je sais. C'est un peu bête, hein ? Mais ça me plaît bien. Lieutenant Stella. Ça sonne très important."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-3/47/g-0/20/g-0/c-2/15
msgctxt "Stella"
msgid "Liutenant Stella! REPORTING IN!"
msgstr "Lieutenant Stella ! AU RAPPORT !"

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-3/47/g-0/20/g-0/c-2/26
msgctxt "Stella"
msgid "OH! Speaking of important."
msgstr "OH ! En parlant de choses importantes."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-3/47/g-0/20/g-0/c-2/34
msgctxt "Stella"
msgid "The pitch!"
msgstr "Le boniment !"

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-3/47/g-0/20/g-0/c-2/42
msgctxt "Stella"
msgid "You've come back, so you must be open to hearing it?"
msgstr "Tu es {{revenu|revenue|revenu·e}}, donc tu dois être {{prêt|prête|prêt·e}} à l'écouter ?"

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-4/7
msgctxt "Stella"
msgid "I think so too."
msgstr "Je le pense aussi."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-4/15
msgctxt "Stella"
msgid "But what's new?"
msgstr "Mais quoi de neuf ?"

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-4/23
msgctxt "Stella"
msgid "I'm old, I'm alone."
msgstr "Je suis vieille, je suis seule."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-4/31
msgctxt "Stella"
msgid "Of course I'm being taken advantage of."
msgstr "Évidemment qu'on profite de moi."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-4/39
msgctxt "Stella"
msgid "I'm not completely stupid."
msgstr "Je ne suis pas complètement idiote."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-4/47
msgctxt "Stella"
msgid "Might as well try and do something with it."
msgstr "Autant essayer d'en faire quelque chose."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-4/55/0/s/0
msgctxt "Choix"
msgid "Do what?"
msgstr "D'en faire quoi ?"

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-4/55/1/s/0
msgctxt "Choix"
msgid "You can always walk away."
msgstr "Tu peux toujours partir."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-4/55/c-0/7
msgctxt "Stella"
msgid "Lemons. Lemonade."
msgstr "Les citrons. La citronnade."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-4/55/c-0/15
msgctxt "Stella"
msgid "You know, there's a lot of nattery in that booklet. But they've got good ones every now and again."
msgstr "Tu sais, il y a beaucoup de blabla dans ce livret. Mais de temps en temps, il y en a des bons."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-4/55/c-0/23
msgctxt "Stella"
msgid "Sometimes."
msgstr "Parfois."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-4/55/c-0/31
msgctxt "Stella"
msgid "And maybe I can make SOMETHING out of this."
msgstr "Et peut-être que je peux en tirer QUELQUE CHOSE."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-4/55/c-1/7
msgctxt "Stella"
msgid "I could, yes."
msgstr "Je pourrais, oui."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-4/55/c-1/15
msgctxt "Stella"
msgid "I've done a lot of that."
msgstr "Je l'ai beaucoup fait."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-4/55/c-1/23
msgctxt "Stella"
msgid "But maybe I can make something out of it instead?"
msgstr "Mais peut-être que je peux plutôt en tirer quelque chose ?"

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-4/55/g-0/0/0/s/0
msgctxt "Choix"
msgid "Make what?"
msgstr "En tirer quoi ?"

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-5/7
msgctxt "Stella"
msgid "Neither do I."
msgstr "Moi non plus."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-0/c-6/7
msgctxt "Stella"
msgid "Something like that."
msgstr "Quelque chose comme ça."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-1/0
msgctxt "Stella"
msgid "Make a sale. Run a business. Stand on my own two feet. Find financial freedom. Those are the booklet buzzwords. So something along those lines, I guess."
msgstr "Conclure une vente. Diriger une entreprise. Tenir sur mes deux pieds. Trouver la liberté financière. Ce sont les mots à la mode du livret. Alors quelque chose dans ce goût-là, j'imagine."

# Traduction IA – à relire
#: stella_stairs/Stella2/0/g-1/8
msgctxt "Stella"
msgid "And on THAT note, I've been working on my pitch! Only if you've got a minute, of course?"
msgstr "Et à CE propos, j'ai travaillé sur mon boniment ! Seulement si tu as une minute, bien sûr ?"

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/0/s/0
msgctxt "Choix"
msgid "I'd love to hear it!"
msgstr "J'adorerais l'entendre !"

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/1/s/0
msgctxt "Choix"
msgid "I'd rather not."
msgstr "Je préfère pas."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/2/s/0
msgctxt "Choix"
msgid "I'd rather choke."
msgstr "Plutôt m'étouffer."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/c-0/7 stella_stairs/StellaPitch/0/c-1/7 stella_stairs/StellaPitch/0/c-2/7
msgctxt "Stella"
msgid "MARVELOUS!"
msgstr "MERVEILLEUX !"

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/c-1/18 stella_stairs/StellaPitch/0/c-2/18
msgctxt "Stella"
msgid "I did hear you dearie I'm so sorry I'm just practicing being ASSERTIVE. You understand!"
msgstr "Je t'ai bien {{entendu|entendue|entendu·e}}, mon petit chou, je suis vraiment désolée, je m'entraîne juste à m'AFFIRMER. Tu comprends !"

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-0/0
msgctxt "Stella"
msgid "So I think it goes something like, I'll enter from stage right. OK."
msgstr "Alors je crois que ça se passe un peu comme ça : j'entre par la droite de la scène. OK."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-0/8
msgctxt "Stella"
msgid "So just wait here."
msgstr "Alors attends juste ici."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-0/19
msgctxt "Narrator"
msgid "Stella walks off just out of sight. You can hear her giving herself a little pep talk."
msgstr "Stella s'éloigne juste hors de votre vue. Vous l'entendez se donner un petit discours d'encouragement."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-0/24
msgctxt "Stella"
msgid "Ok Stella. Time to step up."
msgstr "Bon, Stella. À toi de monter d'une marche."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-0/29
msgctxt "Stella"
msgid "Ready!?"
msgstr "{{Prêt|Prête|Prêt·e}} !?"

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-0/34/s/0
msgctxt "Choix"
msgid "Yes!"
msgstr "Oui !"

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-0/35/s/0
msgctxt "Choix"
msgid "No!"
msgstr "Non !"

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-0/36/s/0
msgctxt "Choix"
msgid "Are you?"
msgstr "Et toi ?"

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-0/37/s/0
msgctxt "Choix"
msgid "You know I really oughta go..."
msgstr "Tu sais, je devrais vraiment y aller..."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-1/0
msgctxt "Stella"
msgid "HUZZAH!"
msgstr "HOURRA !"

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-1/5
msgctxt "Stella"
msgid "OK. I'm coming in in three... two... one... aaaaand-"
msgstr "OK. J'entre dans trois... deux... un... eeeeet..."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-1/10 stella_stairs/StellaPitch/0/g-3/20
msgctxt "Stella"
msgid "ACTION!"
msgstr "ACTION !"

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-1/15
msgctxt "Stella"
msgid "Oh my this is tricky, isn't it."
msgstr "Oh là là, c'est délicat, hein."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-1/20
msgctxt "Stella"
msgid "Chairemi is VERY good at this."
msgstr "Chairemi est TRÈS douée pour ça."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-1/28
msgctxt "Stella"
msgid "Makes it look much easier."
msgstr "Elle fait paraître ça bien plus facile."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-1/33/s/0
msgctxt "Choix"
msgid "She's not THAT good."
msgstr "Elle n'est pas SI douée."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-1/34/s/0
msgctxt "Choix"
msgid "Is everything ok?"
msgstr "Tout va bien ?"

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-1/35/s/0
msgctxt "Choix"
msgid "I've just got this thing I've gotta get to."
msgstr "J'ai juste un truc où il faut que j'aille."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-1/c-8/7
msgctxt "Stella"
msgid "STUPENDOUS. Just... Doing my breathing exercises."
msgstr "FORMIDABLE. Je fais juste... mes exercices de respiration."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-1/c-8/12
msgctxt "Stella"
msgid "Uno momento!"
msgstr "Uno momento !"

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-1/c-9/7
msgctxt "Stella"
msgid "UNO MOMENTO!"
msgstr "UNO MOMENTO !"

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-2/0
msgctxt "Stella"
msgid "That's a theatre thing, isn't it? Do people say that in theatre?"
msgstr "C'est un truc de théâtre, non ? Les gens disent ça, au théâtre ?"

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-2/5
msgctxt "Stella"
msgid "Uno momento."
msgstr "Uno momento."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-2/10/s/0
msgctxt "Choix"
msgid "Sure."
msgstr "Bien sûr."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-2/11/s/0
msgctxt "Choix"
msgid "I think it's just Spanish."
msgstr "Je crois que c'est juste de l'espagnol."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-2/12/s/0
msgctxt "Choix"
msgid "Not really."
msgstr "Pas vraiment."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-2/c-10/7
msgctxt "Stella"
msgid "Thanks goodness."
msgstr "Dieu merci."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-2/c-11/7
msgctxt "Stella"
msgid "Oh dear. Now I'm racist."
msgstr "Oh, misère. Voilà que je suis raciste."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-2/c-12/7
msgctxt "Stella"
msgid "Oh goodness."
msgstr "Oh, Seigneur."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-3/0
msgctxt "Stella"
msgid "Okay. GET IT TOGETHER STELLA."
msgstr "Bon. RESSAISIS-TOI, STELLA."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-3/5
msgctxt "Stella"
msgid "THREE."
msgstr "TROIS."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-3/10
msgctxt "Stella"
msgid "TWO."
msgstr "DEUX."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-3/15
msgctxt "Stella"
msgid "ONE."
msgstr "UN."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-3/25
msgctxt "Narrator"
msgid "Stella walks back into view, slow and steady, and acting as though she doesn't see you at all."
msgstr "Stella revient dans votre champ de vision, d'un pas lent et assuré, faisant comme si elle ne vous voyait pas du tout."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-3/44
msgctxt "Stella"
msgid "OH! I didn't see you there. Hello dearie!"
msgstr "OH ! Je ne t'avais pas {{vu|vue|vu·e}}. Bonjour, mon petit chou !"

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-3/55/s/0
msgctxt "Choix"
msgid "Oh. Don't mind me. Just going about my day. Doo da dee da doo da dee."
msgstr "Oh. Ne fais pas attention à moi. Je vaque à mes occupations. Tralala lalère tralala."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-3/56/s/0
msgctxt "Choix"
msgid "But we were just talking."
msgstr "Mais on était justement en train de parler."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-3/57/s/0
msgctxt "Choix"
msgid "Oh. Roleplay. Kinky."
msgstr "Oh. Un jeu de rôle. Coquin."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-3/c-14/7
msgctxt "Stella"
msgid "Oh I know dearie but now I'm ACTING."
msgstr "Oh, je sais, mon petit chou, mais là, je JOUE LA COMÉDIE."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-3/c-15/7
msgctxt "Stella"
msgid "OH! DEAR!"
msgstr "OH ! SEIGNEUR !"

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-3/c-15/18
msgctxt "Stella"
msgid "Well. I... AS I WAS SAYING."
msgstr "Eh bien. Je... COMME JE LE DISAIS."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-4/0
msgctxt "Stella"
msgid "You know. You really have great. Um.."
msgstr "Tu sais. Tu as vraiment une superbe. Euh..."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-4/22
msgctxt "Narrator"
msgid "Stella simply walks off without another word. You can hear her muttering practice lines under her breath but you can't quite make out what she's saying."
msgstr "Stella s'en va tout simplement, sans un mot de plus. Vous l'entendez marmonner ses répliques à mi-voix, sans parvenir à saisir ce qu'elle dit."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-4/35
msgctxt "Narrator"
msgid "She returns with that same put-on, casual air, as though she hadn't just beat a hasty retreat mid-conversation."
msgstr "Elle revient avec ce même air faussement décontracté, comme si elle ne venait pas de battre en retraite précipitamment au beau milieu de la conversation."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-4/43
msgctxt "Stella"
msgid "Great skin!"
msgstr "Peau !"

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-4/54/s/0
msgctxt "Choix"
msgid "Thanks?"
msgstr "Merci ?"

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-4/55/s/0
msgctxt "Choix"
msgid "Oh."
msgstr "Oh."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-4/56/s/0
msgctxt "Choix"
msgid "Oh stop it, you."
msgstr "Oh, arrête, toi."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-4/c-16/7
msgctxt "Stella"
msgid "No. Thank you for blessing my eyes."
msgstr "Non. Merci à toi de bénir mes yeux."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-4/c-17/7
msgctxt "Stella"
msgid "Oh? More like, WOAH!"
msgstr "Oh ? Plutôt OUAH !"

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-4/c-18/7
msgctxt "Stella"
msgid "Oh No! I simply can't. Simply RADIANT you are."
msgstr "Oh, non ! C'est plus fort que moi. Tout simplement RAYONNANT, tu es."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-5/0
msgctxt "Stella"
msgid "Yes. Such a wonderful glow. But you know what could make that great skin even greaterer?"
msgstr "Oui. Un éclat si merveilleux. Mais tu sais ce qui pourrait rendre cette superbe peau encore plus meilleure ?"

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-5/8/s/0
msgctxt "Choix"
msgid "A bath?"
msgstr "Un bain ?"

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-5/9/s/0
msgctxt "Choix"
msgid "Rock salt?"
msgstr "Du gros sel ?"

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-5/10/s/0
msgctxt "Choix"
msgid "Why don't you tell me, mysterious saleswoman?"
msgstr "Pourquoi tu ne me le dirais pas, mystérieuse vendeuse ?"

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-5/11/s/0
msgctxt "Choix"
msgid "No! I don't!"
msgstr "Non ! Je ne sais pas !"

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-5/c-21/7
msgctxt "Stella"
msgid "Oh good job good 'improvisation'!"
msgstr "Oh, bien joué, belle « improvisation » !"

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-6/0
msgctxt "Stella"
msgid "Why, it's Airway's latest discovery. Activated air."
msgstr "Eh bien, c'est la toute dernière découverte d'Airway. L'Air Activé."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-6/11
msgctxt "Stella"
msgid "\"Open your lungs, let them breathe.\" Our activated air is caught fresh from the peaks of the Appalachians, so you know it's at least somewhat American."
msgstr "« Ouvrez vos poumons, laissez-les respirer. » Notre Air Activé est capté tout frais sur les sommets des Appalaches, alors vous savez qu'il est au moins un peu américain."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-6/19
msgctxt "Narrator"
msgid "Stella holds up a small pressurized can, posing with it like a model in an infomercial."
msgstr "Stella brandit une petite bombe pressurisée et prend la pose avec, comme une mannequin de téléachat."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-6/33
msgctxt "Stella"
msgid "Just one puff can leave you skin feeling cooler, your lungs feeling lighter, and your mind feeling calmer."
msgstr "Une seule bouffée peut rafraîchir votre peau, alléger vos poumons et apaiser votre esprit."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-6/44
msgctxt "Stella"
msgid "This all-in-one superbottle comes at the forefront of Airway's latest campaign, and you too can be a part of our rapid expansion."
msgstr "Cette superbouteille tout-en-un est le fer de lance de la toute dernière campagne d'Airway, et vous aussi, vous pouvez participer à notre expansion fulgurante."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-6/52
msgctxt "Stella"
msgid "Free your lungs, but also your life. Our salesforce lieutenants have the opportunity to fight their way to financial freedom, and we're with you all the way."
msgstr "Libérez vos poumons, mais aussi votre vie. Nos lieutenants de la force de vente ont l'occasion de se battre pour conquérir leur liberté financière, et nous sommes à vos côtés jusqu'au bout."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-6/60
msgctxt "Stella"
msgid "Rise the ranks, and earn your place at Airway's luxurious premier retreats. Major Corporal Brigadier Captains can earn cars, holidays, and even two-to-three-bedroom condos."
msgstr "Gravissez les échelons et gagnez votre place dans les luxueuses retraites d'élite d'Airway. Les Capitaines-Brigadiers-Caporaux-Majors peuvent gagner des voitures, des vacances, et même des appartements de deux à trois chambres."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-6/68
msgctxt "Stella"
msgid "If you've ever wanted to stand on your own two feet, we're here to help you rise to the occasion. Speak to your local representative..."
msgstr "Si vous avez toujours voulu tenir sur vos deux pieds, nous sommes là pour vous aider à vous hisser à la hauteur. Parlez-en à votre représentante locale..."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-6/79
msgctxt "Stella"
msgid "...what is the next..."
msgstr "... c'est quoi, la suite..."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-6/84 stella_stairs/StellaMissionSuccesful/0/g-1/c-4/7 stella_stairs/Stella3Sad/0/8 stella_stairs/Stella3Rejected/0/8 stella_stairs/stella_realize_love_divert/0
msgctxt "Stella"
msgid "Oh!"
msgstr "Oh !"

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-6/92
msgctxt "Stella"
msgid "Stella, today."
msgstr "Stella, dès aujourd'hui."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-6/100
msgctxt "Stella"
msgid "Activated Air, by Airway."
msgstr "L'Air Activé, par Airway."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-6/111
msgctxt "Stella"
msgid "Just breathe."
msgstr "Respirez, tout simplement."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-6/122
msgctxt "Stella"
msgid "And. SCENE."
msgstr "Et. COUPEZ."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-6/130
msgctxt "Narrator"
msgid "Stella takes the smallest of bows."
msgstr "Stella fait la plus petite des révérences."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-6/138/s/0
msgctxt "Choix"
msgid "Oh. You're in DEEP."
msgstr "Oh. Tu es dedans JUSQU'AU COU."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-6/140/s/0
msgctxt "Choix"
msgid "WOOOOOOOH!!!!!!!"
msgstr "OUAAAAAAAAIS !!!!!!!"

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-6/c-25/7
msgctxt "Stella"
msgid "OH! Well thank you dearie. I'm a little bit flustered now."
msgstr "OH ! Eh bien, merci, mon petit chou. Me voilà un peu toute retournée."

# Traduction IA – à relire
#: stella_stairs/StellaPitch/0/g-6/c-25/15
msgctxt "Stella"
msgid "Phew..."
msgstr "Pfiou..."

# Traduction IA – à relire
#: stella_stairs/StellaThatBad/0/0
msgctxt "Stella"
msgid "Was it that bad?"
msgstr "C'était si mauvais que ça ?"

# Traduction IA – à relire
#: stella_stairs/StellaThatBad/0/8/s/0
msgctxt "Choix"
msgid "How do you think it went?"
msgstr "Tu trouves que ça s'est passé comment ?"

# Traduction IA – à relire
#: stella_stairs/StellaThatBad/0/9/s/0
msgctxt "Choix"
msgid "It's pretty rough."
msgstr "C'est assez laborieux."

# Traduction IA – à relire
#: stella_stairs/StellaThatBad/0/10/s/0
msgctxt "Choix"
msgid "No. It was... wonderful."
msgstr "Non. C'était... merveilleux."

# Traduction IA – à relire
#: stella_stairs/StellaThatBad/0/11/s/0
msgctxt "Choix"
msgid "It was great!"
msgstr "C'était génial !"

# Traduction IA – à relire
#: stella_stairs/StellaThatBad/0/c-0/7
msgctxt "Stella"
msgid "Oh, it was really bad, wasn't it?"
msgstr "Oh, c'était vraiment mauvais, hein ?"

# Traduction IA – à relire
#: stella_stairs/StellaThatBad/0/c-1/7
msgctxt "Stella"
msgid "I thought so. I spent all night on it as well."
msgstr "C'est ce que je pensais. Et pourtant, j'y ai passé toute la nuit."

# Traduction IA – à relire
#: stella_stairs/StellaThankGoodness/0/0
msgctxt "Stella"
msgid "Oh thank goodness. I spent all night on that one."
msgstr "Oh, Dieu merci. J'ai passé toute la nuit sur celui-là."

# Traduction IA – à relire
#: stella_stairs/StellaThankGoodness/0/8/s/0
msgctxt "Choix"
msgid "All night?"
msgstr "Toute la nuit ?"

# Traduction IA – à relire
#: stella_stairs/StellaThankGoodness/0/9/s/0
msgctxt "Choix"
msgid "It shows!"
msgstr "Ça se voit !"

# Traduction IA – à relire
#: stella_stairs/StellaThankGoodness/0/10/s/0
msgctxt "Choix"
msgid "I think you're doing great!"
msgstr "Je trouve que tu te débrouilles super bien !"

# Traduction IA – à relire
#: stella_stairs/StellaThankGoodness/0/c-0/7
msgctxt "Stella"
msgid "What's a little all-nighter in the face of success?"
msgstr "Qu'est-ce qu'une petite nuit blanche face au succès ?"

# Traduction IA – à relire
#: stella_stairs/StellaThankGoodness/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "It's not really sustainable is all."
msgstr "C'est juste que ce n'est pas tenable."

# Traduction IA – à relire
#: stella_stairs/StellaThankGoodness/0/c-0/15/1/s/0
msgctxt "Choix"
msgid "You're a real hustler."
msgstr "Tu es une vraie fonceuse."

# Traduction IA – à relire
#: stella_stairs/StellaThankGoodness/0/c-0/15/c-0/7
msgctxt "Stella"
msgid "That's the cost. Least that's what the booklet says."
msgstr "C'est le prix à payer. C'est du moins ce que dit le livret."

# Traduction IA – à relire
#: stella_stairs/StellaThankGoodness/0/c-0/15/c-1/7
msgctxt "Stella"
msgid "I do try."
msgstr "J'essaie."

# Traduction IA – à relire
#: stella_stairs/StellaThankGoodness/0/c-0/15/g-0/0
msgctxt "Stella"
msgid "I've never been the best chit-chatter. I know there's work to do, but it's work worth doing."
msgstr "Je n'ai jamais été la meilleure pour papoter. Je sais qu'il y a du travail, mais c'est du travail qui en vaut la peine."

# Traduction IA – à relire
#: stella_stairs/StellaThankGoodness/0/g-0/0
msgctxt "Stella"
msgid "Well thank you dearie. Still got some way to go. But I'm glad it's working. Even just a little."
msgstr "Eh bien, merci, mon petit chou. Il y a encore du chemin. Mais je suis contente que ça marche. Même un tout petit peu."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/0
msgctxt "Stella"
msgid "You know, dear, I have been meaning to ask. Is there any chance you'd be interested in signing up?"
msgstr "Tu sais, mon chou, je voulais te demander. Y a-t-il une chance que tu veuilles t'inscrire ?"

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/8
msgctxt "Stella"
msgid "They call it enlisting, technically. And there's real money to be made, you know!"
msgstr "Techniquement, on appelle ça s'enrôler. Et il y a vraiment de l'argent à gagner, tu sais !"

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/16
msgctxt "Stella"
msgid "We can get in on the ground level if we move quick, and I've just got to recruit four more lieutenants before I get bumped up to Lieutenant Rank II!"
msgstr "On peut entrer au rez-de-chaussée si on fait vite, et il ne me manque que quatre lieutenants à recruter pour passer Lieutenant de rang II !"

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/24
msgctxt "Stella"
msgid "You've been so kind, I wouldn't want to leave you behind."
msgstr "Tu as été si {{gentil|gentille|gentil·le}}, je ne voudrais pas te laisser sur le bord du chemin."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/32/s/0
msgctxt "Choix"
msgid "Stella. You know this is a scam, right?"
msgstr "Stella. Tu sais que c'est une arnaque, hein ?"

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/33/s/0
msgctxt "Choix"
msgid "It's still a scam, Stella. I can't take part. And you shouldn't either. You'd be stupid to."
msgstr "Ça reste une arnaque, Stella. Je ne peux pas y participer. Et toi non plus, tu ne devrais pas. Ce serait idiot."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/34/s/0 stella_stairs/StellaRecruit/0/c-2/42/0/s/0 stella_stairs/Stella3Conjoined/0/g-1/25/s/0
msgctxt "Choix"
msgid "Why not?"
msgstr "Pourquoi pas ?"

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/35/s/0
msgctxt "Choix"
msgid "I'd love to."
msgstr "J'adorerais."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-0/7
msgctxt "Stella"
msgid "I know it's hard work. But what isn't?"
msgstr "Je sais que c'est du travail. Mais quoi n'en est pas ?"

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-0/23
msgctxt "Stella"
msgid "I'm not exactly drowning in opportunity."
msgstr "Ce n'est pas comme si je croulais sous les opportunités."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-0/31/0/s/0
msgctxt "Choix"
msgid "Fine. I'll sign up."
msgstr "D'accord. Je m'inscris."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-0/31/1/s/0
msgctxt "Choix"
msgid "But is this really what you want to be doing?"
msgstr "Mais est-ce que c'est vraiment ce que tu veux faire ?"

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-0/31/2/s/0
msgctxt "Choix"
msgid "And this is really the best you can find?"
msgstr "Et c'est vraiment le mieux que tu puisses trouver ?"

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-0/31/c-1/7
msgctxt "Stella"
msgid "It's the best I've got."
msgstr "C'est le mieux que j'aie."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-0/31/c-2/7
msgctxt "Stella"
msgid "It's the best that I can make the best of."
msgstr "C'est ce dont je peux tirer le meilleur."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-0/31/g-0/0/0/s/0
msgctxt "Choix"
msgid "You really love to wallow in your misery."
msgstr "Tu adores vraiment te complaire dans ton malheur."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-0/31/g-0/0/1/s/0
msgctxt "Choix"
msgid "But what do you want?"
msgstr "Mais toi, qu'est-ce que tu veux ?"

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-0/31/g-0/0/2/s/0
msgctxt "Choix"
msgid "That's a pretty sad outlook, don't you think?"
msgstr "C'est une vision assez triste, tu ne trouves pas ?"

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-0/31/g-0/0/c-0/7
msgctxt "Stella"
msgid "Wallowing is doing nothing. I'm finally doing SOMETHING and all I'm getting is mocked from every angle."
msgstr "Se complaire, c'est ne rien faire. Je fais enfin QUELQUE CHOSE et tout ce que je récolte, ce sont des moqueries de tous les côtés."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-0/31/g-0/0/c-0/18 stella_stairs/StellaRecruit/0/c-0/31/g-0/0/c-2/23/c-0/18
msgctxt "Stella"
msgid "I think you should leave."
msgstr "Je crois que tu devrais partir."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-0/31/g-0/0/c-0/26/0/s/0 stella_stairs/StellaRecruit/0/c-0/31/g-0/0/c-2/23/c-0/26/0/s/0
msgctxt "Choix"
msgid "Well hold on now."
msgstr "Attends un peu, là."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-0/31/g-0/0/c-0/26/1/s/0 stella_stairs/StellaRecruit/0/c-0/31/g-0/0/c-2/23/c-0/26/1/s/0
msgctxt "Choix"
msgid "Gladly."
msgstr "Avec plaisir."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-0/31/g-0/0/c-0/26/c-0/7 stella_stairs/StellaRecruit/0/c-0/31/g-0/0/c-2/23/c-0/26/c-0/7
msgctxt "Stella"
msgid "Please. Leave."
msgstr "S'il te plaît. Pars."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-0/31/g-0/0/c-0/26/c-0/23 stella_stairs/StellaRecruit/0/c-0/31/g-0/0/c-2/23/c-0/26/c-0/23
msgctxt "Stella"
msgid "You know what? I'll do it myself."
msgstr "Tu sais quoi ? Je vais le faire moi-même."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-0/31/g-0/0/c-1/7
msgctxt "Stella"
msgid "This. I want this."
msgstr "Ça. Je veux ça."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-0/31/g-0/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "Well I can't be a part of it."
msgstr "Eh bien, je ne peux pas en faire partie."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-0/31/g-0/0/c-1/15/1/s/0
msgctxt "Choix"
msgid "Ok then. I'll help."
msgstr "Bon, d'accord. Je vais t'aider."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-0/31/g-0/0/c-1/15/c-0/7 stella_stairs/StellaRecruit/0/c-0/31/g-0/0/c-2/23/c-1/7
msgctxt "Stella"
msgid "Then... Don't. This was about making it by myself anyway. I'll be fine."
msgstr "Alors... ne m'aide pas. Le but, c'était de réussir toute seule, de toute façon. Ça ira."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-0/31/g-0/0/c-2/7
msgctxt "Stella"
msgid "That's one outlook, I suppose."
msgstr "C'est une façon de voir, j'imagine."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-0/31/g-0/0/c-2/15
msgctxt "Stella"
msgid "I'm old. I've learned to place a little weight in realistic pessimism."
msgstr "Je suis vieille. J'ai appris à accorder un peu de crédit au pessimisme réaliste."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-0/31/g-0/0/c-2/23/0/s/0
msgctxt "Choix"
msgid "It sounds like this isn't really what you want."
msgstr "On dirait que ce n'est pas vraiment ce que tu veux."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-0/31/g-0/0/c-2/23/1/s/0
msgctxt "Choix"
msgid "Well I can't be a part of that."
msgstr "Eh bien, je ne peux pas participer à ça."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-0/31/g-0/0/c-2/23/c-0/7
msgctxt "Stella"
msgid "Well it is! And if you can't see that then perhaps you shouldn't be a part of it."
msgstr "Eh bien si ! Et si tu ne le vois pas, alors tu ne devrais peut-être pas en faire partie."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-1/7
msgctxt "Stella"
msgid "Ah. There it is."
msgstr "Ah. Nous y voilà."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-1/15
msgctxt "Stella"
msgid "I'll leave you be."
msgstr "Je vais te laisser tranquille."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-1/23
msgctxt "Stella"
msgid "Obviously we're not quite on the same page."
msgstr "De toute évidence, on n'est pas tout à fait sur la même longueur d'onde."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-1/31
msgctxt "Stella"
msgid "I appreciate your time, but perhaps it's better spent apart."
msgstr "Je te remercie de ton temps, mais il vaut peut-être mieux qu'on le passe chacun de son côté."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-1/39
msgctxt "Stella"
msgid "Rule 66. Haters gonna hate. Not everyone will understand. But you will."
msgstr "Règle 66. Les rageux vont rager. Tout le monde ne comprendra pas. Mais toi, si."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-2/7
msgctxt "Stella"
msgid "I understand. Sorry to pressure you."
msgstr "Je comprends. Désolée de t'avoir mis la pression."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-2/23
msgctxt "Stella"
msgid "OH WAIT!"
msgstr "OH, ATTENDS !"

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-2/34
msgctxt "Stella"
msgid "Why not!? As in... YES?"
msgstr "Pourquoi pas !? Genre... OUI ?"

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-2/42/1/s/0
msgctxt "Choix"
msgid "Yes. Why not, as in yes."
msgstr "Oui. Pourquoi pas, genre oui."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-2/42/2/s/0
msgctxt "Choix"
msgid "On second thought, I'm not sure this is for me."
msgstr "Tout bien réfléchi, je ne suis pas {{sûr|sûre|sûr·e}} que ce soit pour moi."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-2/42/c-0/7
msgctxt "Stella"
msgid "Well now I'm just a little confused, sorry dearie."
msgstr "Bon, là, je suis un peu perdue, désolée, mon petit chou."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-2/42/c-0/15/0/s/0
msgctxt "Choix"
msgid "I'm saying yes, Stella."
msgstr "Je te dis oui, Stella."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-2/42/c-0/15/1/s/0
msgctxt "Choix"
msgid "It's probably not for me, sorry."
msgstr "Ce n'est sûrement pas pour moi, {{désolé|désolée|désolé·e}}."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-2/42/c-0/15/c-1/7
msgctxt "Stella"
msgid "Oh I see."
msgstr "Oh, je vois."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-2/42/c-0/15/c-1/15
msgctxt "Stella"
msgid "I understand dearie, no need to apologise."
msgstr "Je comprends, mon petit chou, pas besoin de t'excuser."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-2/42/c-2/7
msgctxt "Stella"
msgid "Oh. Well. I can't force you dearie."
msgstr "Oh. Eh bien. Je ne peux pas te forcer, mon petit chou."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-2/42/c-2/15
msgctxt "Stella"
msgid "So sorry to bother."
msgstr "Désolée de t'avoir {{dérangé|dérangée|dérangé·e}}."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-2/42/c-2/23
msgctxt "Stella"
msgid "I suppose I'll just... Carry on."
msgstr "J'imagine que je vais juste... continuer."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-2/42/c-2/31
msgctxt "Stella"
msgid "Thank you for hearing me out."
msgstr "Merci de m'avoir écoutée jusqu'au bout."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-3/7
msgctxt "Stella"
msgid "YOU WOULD!?"
msgstr "TU VEUX BIEN !?"

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-3/18
msgctxt "Stella"
msgid "Oh. Sorry. That was rather loud."
msgstr "Oh. Pardon. C'était un peu fort."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-3/26
msgctxt "Stella"
msgid "I'm just a bit shocked, is all."
msgstr "Je suis juste un peu sous le choc, c'est tout."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-3/34/1/s/0
msgctxt "Choix"
msgid "I've got a shocking personality. I'm in."
msgstr "J'ai une personnalité électrique. J'en suis."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-3/34/c-0/7
msgctxt "Stella"
msgid "Well I suppose... I can't really imagine I'd say yes to me."
msgstr "Eh bien, j'imagine... J'ai du mal à imaginer que je me dirais oui à moi-même."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-3/34/c-0/15/0/s/0
msgctxt "Choix"
msgid "Then let me."
msgstr "Alors laisse-moi le faire."

# Traduction IA – à relire
#: stella_stairs/StellaRecruit/0/c-3/34/c-0/15/1/s/0
msgctxt "Choix"
msgid "Maybe I shouldn't, but I am."
msgstr "Je ne devrais peut-être pas, mais je le fais."

# Traduction IA – à relire
#: stella_stairs/StellaYes/0/0
msgctxt "Stella"
msgid "Why I could kiss you dearie!"
msgstr "Ma parole, je pourrais t'embrasser, mon petit chou !"

# Traduction IA – à relire
#: stella_stairs/StellaYes/0/11
msgctxt "Stella"
msgid "What a joy!"
msgstr "Quelle joie !"

# Traduction IA – à relire
#: stella_stairs/StellaYes/0/22
msgctxt "Narrator"
msgid "Stella promptly exits. You can hear her breathing heavily somewhere out of sight."
msgstr "Stella sort aussitôt. Vous l'entendez respirer bruyamment quelque part hors de vue."

# Traduction IA – à relire
#: stella_stairs/StellaYes/0/35
msgctxt "Narrator"
msgid "She returns a few minutes later, rosy-cheeked and smiling."
msgstr "Elle revient quelques minutes plus tard, les joues roses et le sourire aux lèvres."

# Traduction IA – à relire
#: stella_stairs/StellaYes/0/43
msgctxt "Stella"
msgid "Sorry. I just needed to catch my breath."
msgstr "Pardon. J'avais juste besoin de reprendre mon souffle."

# Traduction IA – à relire
#: stella_stairs/StellaYes/0/51
msgctxt "Stella"
msgid "We're going to move mountains, you and I."
msgstr "On va déplacer des montagnes, toi et moi."

# Traduction IA – à relire
#: stella_stairs/StellaYes/0/59
msgctxt "Stella"
msgid "I, Stella, hereby pronounce you Lieutenant of the Airway Army."
msgstr "Moi, Stella, je te nomme par la présente Lieutenant de l'Armée Airway."

# Traduction IA – à relire
#: stella_stairs/StellaYes/0/73/s/0
msgctxt "Choix"
msgid "Yay!"
msgstr "Youpi !"

# Traduction IA – à relire
#: stella_stairs/StellaYes/0/74/s/0
msgctxt "Choix"
msgid "Aye aye!"
msgstr "À vos ordres !"

# Traduction IA – à relire
#: stella_stairs/StellaYes/0/g-0/0
msgctxt "Stella"
msgid "Your first mission, find us three more recruits!"
msgstr "Ta première mission : nous trouver trois nouvelles recrues !"

# Traduction IA – à relire
#: stella_stairs/StellaYes/0/g-0/11
msgctxt "Stella"
msgid "Any three will do, but we'll need three more of us before we can start receiving discounts on merchandise for resale."
msgstr "N'importe lesquelles feront l'affaire, mais il nous en faut trois de plus avant de pouvoir bénéficier de réductions sur la marchandise à revendre."

# Traduction IA – à relire
#: stella_stairs/StellaYes/0/g-0/19
msgctxt "Narrator"
msgid "She pulls a small slip of paper from somewhere and squints at it."
msgstr "Elle sort un petit bout de papier de nulle part et plisse les yeux pour le lire."

# Traduction IA – à relire
#: stella_stairs/StellaYes/0/g-0/27
msgctxt "Stella"
msgid "I received a list from my higher-up that says some promising aspirants are:"
msgstr "Ma supérieure m'a envoyé une liste de candidats prometteurs :"

# Traduction IA – à relire
#: stella_stairs/StellaYes/0/g-0/35
msgctxt "Stella"
msgid "I, Ronaldini..."
msgstr "Moi, Ronaldini..."

# Traduction IA – à relire
#: stella_stairs/StellaYes/0/g-0/46
msgctxt "Stella"
msgid "Penelope..."
msgstr "Penelope..."

# Traduction IA – à relire
#: stella_stairs/StellaYes/0/g-0/57
msgctxt "Stella"
msgid "...and Winnifred."
msgstr "... et Winnifred."

# Traduction IA – à relire
#: stella_stairs/StellaYes/0/g-0/68
msgctxt "Stella"
msgid "OH! And you need this!"
msgstr "OH ! Et il te faut ça !"

# Traduction IA – à relire
#: stella_stairs/StellaYes/0/g-0/76
msgctxt "Narrator"
msgid "She hands you a pamphlet."
msgstr "Elle vous tend une brochure."

# Traduction IA – à relire
#: stella_stairs/StellaYes/0/g-0/87
msgctxt "Stella"
msgid "Don't worry! I've memorized it. Mostly!"
msgstr "Ne t'en fais pas ! Je la connais par cœur. Presque !"

# Traduction IA – à relire
#: stella_stairs/StellaYes/0/g-0/95/s/0
msgctxt "Choix"
msgid "Aye aye captain."
msgstr "À vos ordres, capitaine."

# Traduction IA – à relire
#: stella_stairs/StellaYes/0/g-0/96/s/0
msgctxt "Choix"
msgid "Recite page 24!"
msgstr "Récite la page 24 !"

# Traduction IA – à relire
#: stella_stairs/StellaYes/0/g-0/97/s/0
msgctxt "Choix"
msgid "So I just need to convince three others to sign up?"
msgstr "Donc je dois juste convaincre trois autres personnes de s'inscrire ?"

# Traduction IA – à relire
#: stella_stairs/StellaYes/0/g-0/c-2/7
msgctxt "Stella"
msgid "OH! Well I'm very flattered but I'm only a lieutenant for now dearie!"
msgstr "OH ! Eh bien, c'est très flatteur, mais je ne suis que lieutenant pour l'instant, mon petit chou !"

# Traduction IA – à relire
#: stella_stairs/StellaYes/0/g-0/c-2/15/0/s/0
msgctxt "Choix"
msgid "Aye aye lieutenant!"
msgstr "À vos ordres, lieutenant !"

# Traduction IA – à relire
#: stella_stairs/StellaYes/0/g-0/c-2/15/1/s/0
msgctxt "Choix"
msgid "Just preparing for the inevitable."
msgstr "Je me prépare juste à l'inévitable."

# Traduction IA – à relire
#: stella_stairs/StellaYes/0/g-0/c-2/15/c-0/7
msgctxt "Stella"
msgid "Aye aye indeed!"
msgstr "À vos ordres, oui !"

# Traduction IA – à relire
#: stella_stairs/StellaYes/0/g-0/c-2/15/c-1/7
msgctxt "Stella"
msgid "Well I!"
msgstr "Eh bien, ça !"

# Traduction IA – à relire
#: stella_stairs/StellaYes/0/g-0/c-2/15/c-1/23
msgctxt "Stella"
msgid "Thank you dearie."
msgstr "Merci, mon petit chou."

# Traduction IA – à relire
#: stella_stairs/StellaYes/0/g-0/c-3/7
msgctxt "Stella"
msgid "Always wear pink to a funeral! Stand out from the crowd!"
msgstr "Portez toujours du rose à un enterrement ! Démarquez-vous de la foule !"

# Traduction IA – à relire
#: stella_stairs/StellaYes/0/g-0/c-4/7
msgctxt "Stella"
msgid "And pay the <i>very small</i> signup fee."
msgstr "Et payez les <i>tout petits</i> frais d'inscription."

# Traduction IA – à relire
#: stella_stairs/StellaYes/0/g-0/c-4/15
msgctxt "Stella"
msgid "But any three will do!"
msgstr "Mais trois personnes quelconques feront l'affaire !"

# Traduction IA – à relire
#: stella_stairs/StellaYes/0/g-0/c-4/23
msgctxt "Stella"
msgid "I'll leave it up to you to choose, you're my right hand after all!"
msgstr "Je te laisse choisir, tu es mon bras droit, après tout !"

# Traduction IA – à relire
#: stella_stairs/StellaYes/0/g-1/0
msgctxt "Stella"
msgid "Now. Up and away! Let's sell some air!"
msgstr "Allez. Toujours plus haut ! Allons vendre de l'air !"

# Traduction IA – à relire
#: stella_stairs/StellaSad/0/0/s/0
msgctxt "Choix"
msgid "Maybe you just need some rest?"
msgstr "Tu as peut-être juste besoin de repos ?"

# Traduction IA – à relire
#: stella_stairs/StellaSad/0/1/s/0
msgctxt "Choix"
msgid "We're not all cut out for charisma."
msgstr "On n'est pas tous faits pour le charisme."

# Traduction IA – à relire
#: stella_stairs/StellaSad/0/g-0/0
msgctxt "Stella"
msgid "I suppose so."
msgstr "J'imagine."

# Traduction IA – à relire
#: stella_stairs/StellaSad/0/g-0/8
msgctxt "Stella"
msgid "Perhaps you're right."
msgstr "Tu as peut-être raison."

# Traduction IA – à relire
#: stella_stairs/StellaSad/0/g-0/16
msgctxt "Stella"
msgid "Well... Thank you for listening, regardless, dearie."
msgstr "Eh bien... Merci de m'avoir écoutée, malgré tout, mon petit chou."

# Traduction IA – à relire
#: stella_stairs/StellaSad/0/g-0/24
msgctxt "Stella"
msgid "I think I might just need some space for the moment."
msgstr "Je crois que j'ai juste besoin d'un peu d'espace pour le moment."

# Traduction IA – à relire
#: stella_stairs/StellaSad/0/g-0/32/b/1
msgctxt "Stella"
msgid "I might take your advice. Perhaps I just need a little nap."
msgstr "Je vais peut-être suivre ton conseil. Il me faut peut-être juste une petite sieste."

# Traduction IA – à relire
#: stella_stairs/StellaSad/0/g-0/35
msgctxt "Stella"
msgid "Sorry for the inconvenience."
msgstr "Désolée pour le dérangement."

# Traduction IA – à relire
#: stella_stairs/StellaMissionSuccesful/0/0
msgctxt "Stella"
msgid "OH DEARIE! YOU DID IT!"
msgstr "OH, MON PETIT CHOU ! TU AS RÉUSSI !"

# Traduction IA – à relire
#: stella_stairs/StellaMissionSuccesful/0/11
msgctxt "Stella"
msgid "I just got off the line with HQ, and they're going to be sending around our official certificate of rank."
msgstr "Je sors d'un appel avec le QG, et ils vont nous envoyer notre certificat de grade officiel."

# Traduction IA – à relire
#: stella_stairs/StellaMissionSuccesful/0/19
msgctxt "Stella"
msgid "Stella. Lieutenant rank II..."
msgstr "Stella. Lieutenant de rang II..."

# Traduction IA – à relire
#: stella_stairs/StellaMissionSuccesful/0/27/s/0
msgctxt "Choix"
msgid "We convinced them to buy the product!"
msgstr "On les a convaincus d'acheter le produit !"

# Traduction IA – à relire
#: stella_stairs/StellaMissionSuccesful/0/28/s/0
msgctxt "Choix"
msgid "Congratulations!"
msgstr "Félicitations !"

# Traduction IA – à relire
#: stella_stairs/StellaMissionSuccesful/0/c-0/7
msgctxt "Stella"
msgid "Congratulations, sweetie!"
msgstr "Félicitations, mon cœur !"

# Traduction IA – à relire
#: stella_stairs/StellaMissionSuccesful/0/c-0/18
msgctxt "Stella"
msgid "Although we try not to use the word 'convinced'. We are merely 'providing a glimpse of the power that can be beheld'."
msgstr "Même si on essaie d'éviter le mot « convaincus ». On ne fait que « leur offrir un aperçu du pouvoir qu'il leur est donné de contempler »."

# Traduction IA – à relire
#: stella_stairs/StellaMissionSuccesful/0/c-0/26/0/s/0
msgctxt "Choix"
msgid "I provided a glimpse of the power that can be beheld to all of them!"
msgstr "Je leur ai offert à tous un aperçu du pouvoir qu'il leur est donné de contempler !"

# Traduction IA – à relire
#: stella_stairs/StellaMissionSuccesful/0/c-0/26/1/s/0
msgctxt "Choix"
msgid "What?"
msgstr "Quoi ?"

# Traduction IA – à relire
#: stella_stairs/StellaMissionSuccesful/0/c-0/26/c-0/7
msgctxt "Stella"
msgid "That's it, that's it!"
msgstr "C'est ça, c'est ça !"

# Traduction IA – à relire
#: stella_stairs/StellaMissionSuccesful/0/g-0/0
msgctxt "Stella"
msgid "This is... marvelous."
msgstr "C'est... merveilleux."

# Traduction IA – à relire
#: stella_stairs/StellaMissionSuccesful/0/g-0/8/s/0
msgctxt "Choix"
msgid "And me?"
msgstr "Et moi ?"

# Traduction IA – à relire
#: stella_stairs/StellaMissionSuccesful/0/g-0/9/s/0
msgctxt "Choix"
msgid "Couldn't have done it without you."
msgstr "Je n'aurais pas pu y arriver sans toi."

# Traduction IA – à relire
#: stella_stairs/StellaMissionSuccesful/0/g-0/c-2/7
msgctxt "Stella"
msgid "You'll be my right hand! And we'll climb the rest together."
msgstr "Tu seras mon bras droit ! Et on gravira le reste ensemble."

# Traduction IA – à relire
#: stella_stairs/StellaMissionSuccesful/0/g-0/c-3/7
msgctxt "Stella"
msgid "And I without you, Lieutenant."
msgstr "Et moi non plus sans toi, Lieutenant."

# Traduction IA – à relire
#: stella_stairs/StellaMissionSuccesful/0/g-1/0
msgctxt "Stella"
msgid "I've never had a certificate of anything before."
msgstr "Je n'ai jamais eu de certificat de quoi que ce soit."

# Traduction IA – à relire
#: stella_stairs/StellaMissionSuccesful/0/g-1/8
msgctxt "Stella"
msgid "I don't even know where I'd put it."
msgstr "Je ne sais même pas où je le mettrais."

# Traduction IA – à relire
#: stella_stairs/StellaMissionSuccesful/0/g-1/16
msgctxt "Stella"
msgid "Gosh, I could kiss you."
msgstr "Ma parole, je pourrais t'embrasser."

# Traduction IA – à relire
#: stella_stairs/StellaMissionSuccesful/0/g-1/24/s/0
msgctxt "Choix"
msgid "I think it's best we maintain some professional boundaries."
msgstr "Je pense qu'il vaut mieux garder des limites professionnelles."

# Traduction IA – à relire
#: stella_stairs/StellaMissionSuccesful/0/g-1/25/s/0
msgctxt "Choix"
msgid "I've always had a thing for powerful staircases."
msgstr "J'ai toujours eu un faible pour les escaliers puissants."

# Traduction IA – à relire
#: stella_stairs/StellaMissionSuccesful/0/g-1/26/s/0
msgctxt "Choix"
msgid "Why don't you?"
msgstr "Pourquoi tu ne le fais pas ?"

# Traduction IA – à relire
#: stella_stairs/StellaMissionSuccesful/0/g-1/c-4/15
msgctxt "Stella"
msgid "Yes. Of course."
msgstr "Oui. Bien sûr."

# Traduction IA – à relire
#: stella_stairs/StellaMissionSuccesful/0/g-1/c-4/23
msgctxt "Stella"
msgid "I just. I Just want you to know that I'll always be grateful. And I couldn't have done this without you."
msgstr "Je veux. Je veux juste que tu saches que je te serai toujours reconnaissante. Et que je n'aurais pas pu y arriver sans toi."

# Traduction IA – à relire
#: stella_stairs/StellaMissionSuccesful/0/g-1/c-4/31/0/s/0
msgctxt "Choix"
msgid "I think you could have."
msgstr "Je crois que si."

# Traduction IA – à relire
#: stella_stairs/StellaMissionSuccesful/0/g-1/c-4/31/1/s/0
msgctxt "Choix"
msgid "I'm just happy to help."
msgstr "Je suis juste {{content|contente|content·e}} d'aider."

# Traduction IA – à relire
#: stella_stairs/StellaMissionSuccesful/0/g-1/c-4/31/c-0/7
msgctxt "Stella"
msgid "Ever too kind."
msgstr "Toujours trop {{gentil|gentille|gentil·le}}."

# Traduction IA – à relire
#: stella_stairs/StellaMissionSuccesful/0/g-1/c-4/31/g-0/0
msgctxt "Stella"
msgid "And for now, you should rest. Let me take care of the Airway stuff. But swing by sometime and touch base, we've always got room for growth."
msgstr "Et pour l'instant, tu devrais te reposer. Laisse-moi m'occuper des trucs d'Airway. Mais repasse un de ces jours faire le point, il y a toujours de la marge de progression."

# Traduction IA – à relire
#: stella_stairs/StellaMissionSuccesful/0/g-1/c-5/15
msgctxt "Stella"
msgid "Well... I suppose that's what I am now. Powerful."
msgstr "Eh bien... J'imagine que c'est ce que je suis, maintenant. Puissante."

# Traduction IA – à relire
#: stella_stairs/StellaMissionSuccesful/0/g-1/c-5/23/0/s/0
msgctxt "Choix"
msgid "Ravishingly so."
msgstr "Divinement puissante."

# Traduction IA – à relire
#: stella_stairs/StellaMissionSuccesful/0/g-1/c-5/23/1/s/0
msgctxt "Choix"
msgid "Then take what you want."
msgstr "Alors prends ce que tu veux."

# Traduction IA – à relire
#: stella_stairs/StellaMissionSuccesful/0/g-1/c-6/7
msgctxt "Stella"
msgid "Oh. I mean. I wouldn't want to impose."
msgstr "Oh. Enfin. Je ne voudrais pas m'imposer."

# Traduction IA – à relire
#: stella_stairs/StellaMissionSuccesful/0/g-1/c-6/15/0/s/0
msgctxt "Choix"
msgid "Feel free."
msgstr "Fais-toi plaisir."

# Traduction IA – à relire
#: stella_stairs/StellaMissionSuccesful/0/g-1/c-6/15/1/s/0
msgctxt "Choix"
msgid "I thought you were more assertive than that."
msgstr "Je te croyais plus sûre de toi que ça."

# Traduction IA – à relire
#: stella_stairs/StellaMissionSuccesful/0/g-2/0
msgctxt "Narrator"
msgid "Stella raises a brow, her gaze warming as your encouragement sinks in."
msgstr "Stella hausse un sourcil, et son regard se réchauffe à mesure que vos encouragements font leur effet."

# Traduction IA – à relire
#: stella_stairs/StellaMissionSuccesful/0/g-2/24
msgctxt "Stella"
msgid "Why don't you... Step up to my office?"
msgstr "Et si tu... montais dans mon bureau ?"

# Traduction IA – à relire
#: stella_stairs/StellaMissionSuccesful/0/g-2/32
msgctxt "Narrator"
msgid "You step right up into Stella's warm embrace."
msgstr "Vous montez droit dans les bras chaleureux de Stella."

# Traduction IA – à relire
#: stella_stairs/Stella3Sad/0/0 stella_stairs/Stella3Rejected/0/0
msgctxt "Stella"
msgid "Step 92. It's ALWAYS a bear market."
msgstr "Étape 92. C'est TOUJOURS un marché baissier."

# Traduction IA – à relire
#: stella_stairs/Stella3Sad/0/16
msgctxt "Stella"
msgid "Hello dearie. I'm so sorry about that little book of mine."
msgstr "Bonjour, mon petit chou. Je suis vraiment désolée pour mon petit livret."

# Traduction IA – à relire
#: stella_stairs/Stella3Sad/0/24
msgctxt "Stella"
msgid "Bit childish of me."
msgstr "C'était un peu puéril de ma part."

# Traduction IA – à relire
#: stella_stairs/Stella3Sad/0/32/s/0
msgctxt "Choix"
msgid "Not at all!"
msgstr "Pas du tout !"

# Traduction IA – à relire
#: stella_stairs/Stella3Sad/0/33/s/0
msgctxt "Choix"
msgid "Are you feeling better?"
msgstr "Tu te sens mieux ?"

# Traduction IA – à relire
#: stella_stairs/Stella3Sad/0/34/s/0
msgctxt "Choix"
msgid "A little."
msgstr "Un peu."

# Traduction IA – à relire
#: stella_stairs/Stella3Sad/0/c-0/7
msgctxt "Stella"
msgid "Ever so sweet, aren't you?"
msgstr "Toujours aussi adorable, hein ?"

# Traduction IA – à relire
#: stella_stairs/Stella3Sad/0/c-1/47
msgctxt "Stella"
msgid "But discomfort is the source of success. Page 84."
msgstr "Mais l'inconfort est la source du succès. Page 84."

# Traduction IA – à relire
#: stella_stairs/Stella3Sad/0/c-1/55/0/s/0
msgctxt "Choix"
msgid "Do you believe that?"
msgstr "Tu y crois, à ça ?"

# Traduction IA – à relire
#: stella_stairs/Stella3Sad/0/c-1/55/1/s/0
msgctxt "Choix"
msgid "That's a lot of pages for a booklet."
msgstr "Ça fait beaucoup de pages pour un livret."

# Traduction IA – à relire
#: stella_stairs/Stella3Sad/0/c-1/55/c-0/7
msgctxt "Stella"
msgid "It's a comforting thought."
msgstr "C'est une pensée réconfortante."

# Traduction IA – à relire
#: stella_stairs/Stella3Sad/0/c-1/55/c-1/7
msgctxt "Stella"
msgid "One phrase a page. It's not exactly efficient, no."
msgstr "Une phrase par page. Ce n'est pas franchement efficace, non."

# Traduction IA – à relire
#: stella_stairs/Stella3Sad/0/c-2/7
msgctxt "Stella"
msgid "Not one to pull punches, are you?"
msgstr "Tu ne mâches pas tes mots, hein ?"

# Traduction IA – à relire
#: stella_stairs/Stella3Sad/0/g-0/1
msgctxt "Stella"
msgid "I appreciate your checking up on me."
msgstr "Ça me touche que tu prennes de mes nouvelles."

# Traduction IA – à relire
#: stella_stairs/Stella3Rejected/0/16
msgctxt "Stella"
msgid "You're back!"
msgstr "Tu es {{revenu|revenue|revenu·e}} !"

# Traduction IA – à relire
#: stella_stairs/Stella3Rejected/0/24/s/0
msgctxt "Choix"
msgid "Is that so surprising?"
msgstr "C'est si surprenant que ça ?"

# Traduction IA – à relire
#: stella_stairs/Stella3Rejected/0/25/s/0
msgctxt "Choix"
msgid "I do live here."
msgstr "J'habite ici, quand même."

# Traduction IA – à relire
#: stella_stairs/Stella3Rejected/0/c-0/7
msgctxt "Stella"
msgid "I just thought you might be done with me."
msgstr "Je pensais juste que tu en avais peut-être fini avec moi."

# Traduction IA – à relire
#: stella_stairs/Stella3Rejected/0/c-1/7
msgctxt "Stella"
msgid "Well. Yes."
msgstr "Eh bien. Oui."

# Traduction IA – à relire
#: stella_stairs/Stella3Rejected/0/c-1/15
msgctxt "Stella"
msgid "I suppose we both do."
msgstr "J'imagine que c'est chez nous, à toi comme à moi."

# Traduction IA – à relire
#: stella_stairs/Stella3Rejected/0/c-1/23
msgctxt "Stella"
msgid "I suppose I thought you might be done with me."
msgstr "J'imagine que je pensais que tu en avais peut-être fini avec moi."

# Traduction IA – à relire
#: stella_stairs/Stella3Rejected/0/g-0/0/s/0
msgctxt "Choix"
msgid "I'm just not interested in the scam, we're still friends. Aren't we?"
msgstr "C'est juste l'arnaque qui ne m'intéresse pas, on est toujours {{amis|amies|ami·es}}. Non ?"

# Traduction IA – à relire
#: stella_stairs/Stella3Rejected/0/g-0/1/s/0
msgctxt "Choix"
msgid "We live together. We might as well be cordial."
msgstr "On vit ensemble. Autant garder de bons rapports."

# Traduction IA – à relire
#: stella_stairs/Stella3Rejected/0/g-0/c-2/15
msgctxt "Stella"
msgid "Well I'm very touched."
msgstr "Eh bien, ça me touche beaucoup."

# Traduction IA – à relire
#: stella_stairs/Stella3Rejected/0/g-0/c-2/23
msgctxt "Stella"
msgid "Even if it's not a scam."
msgstr "Même si ce n'est pas une arnaque."

# Traduction IA – à relire
#: stella_stairs/Stella3Rejected/0/g-0/c-2/31/0/s/0
msgctxt "Choix"
msgid "You said you knew what it was."
msgstr "Tu as dit que tu savais ce que c'était."

# Traduction IA – à relire
#: stella_stairs/Stella3Rejected/0/g-0/c-2/31/1/s/0
msgctxt "Choix"
msgid "But it is."
msgstr "Mais c'en est une."

# Traduction IA – à relire
#: stella_stairs/Stella3Rejected/0/g-0/c-2/31/2/s/0
msgctxt "Choix"
msgid "Okay Stella."
msgstr "D'accord, Stella."

# Traduction IA – à relire
#: stella_stairs/Stella3Rejected/0/g-0/c-2/31/c-0/7
msgctxt "Stella"
msgid "I know that it's difficult. But it's also possible."
msgstr "Je sais que c'est difficile. Mais c'est aussi possible."

# Traduction IA – à relire
#: stella_stairs/Stella3Rejected/0/g-0/c-2/31/c-1/7
msgctxt "Stella"
msgid "It's only a scam if you fall for it. I've done my research."
msgstr "Ce n'est une arnaque que si on se fait avoir. Je me suis renseignée."

# Traduction IA – à relire
#: stella_stairs/Stella3Rejected/0/g-0/c-2/31/c-2/7
msgctxt "Stella"
msgid "You're not convinced."
msgstr "Tu n'es pas {{convaincu|convaincue|convaincu·e}}."

# Traduction IA – à relire
#: stella_stairs/Stella3Rejected/0/g-0/c-3/7
msgctxt "Stella"
msgid "I appreciate the sentiment."
msgstr "J'apprécie l'intention."

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/0/s/0
msgctxt "Choix"
msgid "So you're sticking with it?"
msgstr "Alors tu t'accroches ?"

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/1/s/0
msgctxt "Choix"
msgid "Still gung-ho on that booklet?"
msgstr "Toujours à fond sur ce livret ?"

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-0/0
msgctxt "Stella"
msgid "I'll be seeing it through, best I can. Yes."
msgstr "J'irai jusqu'au bout, du mieux que je peux. Oui."

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-0/8/s/0
msgctxt "Choix"
msgid "Why are you so stubborn about this?"
msgstr "Pourquoi tu t'entêtes autant ?"

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-0/9/s/0
msgctxt "Choix"
msgid "Now that's childish."
msgstr "Là, c'est puéril."

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-0/10/s/0
msgctxt "Choix"
msgid "At a certain point it's just conscious ignorance, no?"
msgstr "À un moment, c'est de l'ignorance volontaire, non ?"

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-0/c-2/7
msgctxt "Stella"
msgid "Because I've never let myself be stubborn before."
msgstr "Parce que je ne me suis jamais autorisée à m'entêter avant."

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-0/c-3/7
msgctxt "Stella"
msgid "Because I've never let myself be childish before."
msgstr "Parce que je ne me suis jamais autorisée à être puérile avant."

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-0/c-4/7
msgctxt "Stella"
msgid "Because I've never let myself be ignorant before."
msgstr "Parce que je ne me suis jamais autorisée à être ignorante avant."

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-1/0
msgctxt "Stella"
msgid "I'm getting on. There's certain things I just... need to do."
msgstr "Je prends de l'âge. Il y a certaines choses que je dois juste... faire."

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-1/8
msgctxt "Stella"
msgid "Need to try. Need to know."
msgstr "Essayer. Savoir."

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-1/16
msgctxt "Stella"
msgid "I've never really had to until now."
msgstr "Je n'en ai jamais vraiment eu besoin jusqu'ici."

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-1/24/s/0
msgctxt "Choix"
msgid "You couldn't pick a smarter thing?"
msgstr "Tu ne pouvais pas choisir un truc plus malin ?"

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-1/c-5/7
msgctxt "Stella"
msgid "A safer thing."
msgstr "Un truc plus sûr."

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-1/c-6/7
msgctxt "Stella"
msgid "I didn't have the need."
msgstr "Je n'en avais pas besoin."

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-2/0
msgctxt "Stella"
msgid "This booklet is the only thing I have. The only chance I'm given."
msgstr "Ce livret, c'est tout ce que j'ai. La seule chance qu'on me donne."

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-2/8
msgctxt "Stella"
msgid "I'm old and I'm slow, and greeting is all I've ever done. And who's going to give me a chance to do more than that, if not myself?"
msgstr "Je suis vieille et je suis lente, et accueillir les gens, c'est tout ce que j'ai jamais fait. Et qui va me donner la chance de faire plus que ça, si ce n'est moi-même ?"

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-2/16
msgctxt "Stella"
msgid "And I know I'm not good at it."
msgstr "Et je sais que je ne suis pas douée."

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-2/24
msgctxt "Stella"
msgid "But maybe I can be?"
msgstr "Mais peut-être que je peux le devenir ?"

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-2/32/s/0
msgctxt "Choix"
msgid "Fine. Let's help you with your booklet."
msgstr "D'accord. On va t'aider avec ton livret."

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-2/33/s/0
msgctxt "Choix"
msgid "What if we could find something else?"
msgstr "Et si on pouvait trouver autre chose ?"

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-2/34/s/0
msgctxt "Choix"
msgid "If your only answer is finding folks to scam, then you're just not looking hard enough."
msgstr "Si ta seule solution, c'est de trouver des gens à arnaquer, c'est que tu ne cherches pas assez."

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-2/c-7/15
msgctxt "Stella"
msgid "OH."
msgstr "OH."

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-2/c-7/23
msgctxt "Stella"
msgid "You're serious!"
msgstr "Tu es {{sérieux|sérieuse|sérieux·se}} !"

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-2/c-8/7
msgctxt "Stella"
msgid "I've looked dearie."
msgstr "J'ai cherché, mon petit chou."

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-2/c-8/15
msgctxt "Stella"
msgid "Trust me, I have."
msgstr "Crois-moi, j'ai cherché."

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-2/c-8/23/0/s/0
msgctxt "Choix"
msgid "Then let me help."
msgstr "Alors laisse-moi t'aider."

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-2/c-8/23/1/s/0
msgctxt "Choix"
msgid "Clearly not hard enough."
msgstr "Clairement pas assez."

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-2/c-8/23/c-0/15
msgctxt "Stella"
msgid "Seems I still can't say no."
msgstr "On dirait que je ne sais toujours pas dire non."

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-2/c-8/23/c-0/31
msgctxt "Stella"
msgid "But I can't keep saying yes."
msgstr "Mais je ne peux pas continuer à dire oui."

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-2/c-8/23/c-0/39
msgctxt "Stella"
msgid "Fine."
msgstr "D'accord."

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-2/c-8/23/c-0/47
msgctxt "Stella"
msgid "But I won't wait around forever."
msgstr "Mais je n'attendrai pas éternellement."

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-2/c-8/23/c-0/55
msgctxt "Stella"
msgid "And for now dearie, truth be told, I'm a little knackered."
msgstr "Et pour l'instant, mon petit chou, à vrai dire, je suis un peu lessivée."

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-2/c-8/23/c-0/63
msgctxt "Stella"
msgid "I'll think on it, I promise. I just can't keep standing still."
msgstr "J'y réfléchirai, promis. Je ne peux juste pas continuer à faire du surplace."

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-2/c-8/23/c-0/71
msgctxt "Stella"
msgid "Regardless... Thank you."
msgstr "Quoi qu'il en soit... Merci."

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-3/0
msgctxt "Stella"
msgid "You really think so little of me?"
msgstr "Tu as vraiment une si piètre opinion de moi ?"

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-3/8
msgctxt "Stella"
msgid "Here I thought you might actually understand."
msgstr "Et moi qui pensais que tu comprendrais peut-être."

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-3/16
msgctxt "Stella"
msgid "I suppose we're past the greeting phase."
msgstr "J'imagine qu'on a dépassé l'étape de l'accueil."

# Traduction IA – à relire
#: stella_stairs/Stella3Conjoined/0/g-3/24
msgctxt "Stella"
msgid "I'd rather you leave."
msgstr "Je préférerais que tu partes."

# Traduction IA – à relire
#: stella_stairs/Stella3Hate/0/8
msgctxt "Stella"
msgid "It's you."
msgstr "C'est toi."

# Traduction IA – à relire
#: stella_stairs/Stella3Hate/0/16/s/0
msgctxt "Choix"
msgid "I wanted to apologize."
msgstr "Je voulais m'excuser."

# Traduction IA – à relire
#: stella_stairs/Stella3Hate/0/17/s/0
msgctxt "Choix"
msgid "Still at it?"
msgstr "Toujours dans le coup ?"

# Traduction IA – à relire
#: stella_stairs/Stella3Hate/0/c-0/7
msgctxt "Stella"
msgid "Oh dearie no! NO, it's my fault! I really flew off the handle and honestly I've just been feeling horrid about it."
msgstr "Oh, mon petit chou, non ! NON, c'est ma faute ! Je me suis vraiment emportée et franchement, je m'en veux terriblement depuis."

# Traduction IA – à relire
#: stella_stairs/Stella3Hate/0/c-0/15
msgctxt "Stella"
msgid "I'm sorry."
msgstr "Je suis désolée."

# Traduction IA – à relire
#: stella_stairs/Stella3Hate/0/c-0/23
msgctxt "Stella"
msgid "There's a line between assertive and assholery, and I fear I flirted too far between"
msgstr "Il y a une limite entre s'affirmer et faire sa peau de vache, et je crains d'avoir un peu trop flirté avec"

# Traduction IA – à relire
#: stella_stairs/Stella3Hate/0/c-1/7
msgctxt "Stella"
msgid "You think I'd quit so quickly?"
msgstr "Tu croyais que j'abandonnerais si vite ?"

# Traduction IA – à relire
#: stella_stairs/Stella3Hate/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "I think you should."
msgstr "Je pense que tu devrais."

# Traduction IA – à relire
#: stella_stairs/Stella3Hate/0/c-1/15/1/s/0
msgctxt "Choix"
msgid "I'll admit I'm a little surprised."
msgstr "J'avoue que je suis un peu {{surpris|surprise|surpris·e}}."

# Traduction IA – à relire
#: stella_stairs/Stella3Hate/0/c-1/15/2/s/0
msgctxt "Choix"
msgid "No."
msgstr "Non."

# Traduction IA – à relire
#: stella_stairs/Stella3Hate/0/c-1/15/c-0/7
msgctxt "Stella"
msgid "Well I shan't. The booklet warned me about folks like you and I should've paid more attention."
msgstr "Eh bien, je n'en ferai rien. Le livret m'avait mise en garde contre les gens comme toi et j'aurais dû y prêter plus attention."

# Traduction IA – à relire
#: stella_stairs/Stella3Hate/0/c-1/15/c-0/15
msgctxt "Stella"
msgid "I'd like you to leave."
msgstr "J'aimerais que tu partes."

# Traduction IA – à relire
#: stella_stairs/Stella3Hate/0/c-1/15/c-0/23
msgctxt "Stella"
msgid "And I'd like you to not come back."
msgstr "Et j'aimerais que tu ne reviennes pas."

# Traduction IA – à relire
#: stella_stairs/Stella3Hate/0/c-1/15/c-0/39
msgctxt "Stella"
msgid "Go."
msgstr "Va-t'en."

# Traduction IA – à relire
#: stella_stairs/Stella3Hate/0/c-1/15/c-1/7
msgctxt "Stella"
msgid "Well aren't I full of surprises?"
msgstr "Eh bien, je suis pleine de surprises, hein ?"

# Traduction IA – à relire
#: stella_stairs/StellaFriendshipEnding/0/0
msgctxt "Stella"
msgid "I'M HERE!"
msgstr "ME VOILÀ !"

# Traduction IA – à relire
#: stella_stairs/StellaFriendshipEnding/0/11
msgctxt "Stella"
msgid "Sorry for the wait!"
msgstr "Désolée pour l'attente !"

# Traduction IA – à relire
#: stella_stairs/StellaFriendshipEnding/0/19/s/0
msgctxt "Choix"
msgid "You seem excited."
msgstr "Tu as l'air toute excitée."

# Traduction IA – à relire
#: stella_stairs/StellaFriendshipEnding/0/20/s/0
msgctxt "Choix"
msgid "Where were you?"
msgstr "Tu étais où ?"

# Traduction IA – à relire
#: stella_stairs/StellaFriendshipEnding/0/c-0/7
msgctxt "Stella"
msgid "I am!"
msgstr "Je le suis !"

# Traduction IA – à relire
#: stella_stairs/StellaFriendshipEnding/0/g-0/0
msgctxt "Stella"
msgid "Planning and plotting and plotting and planning."
msgstr "À planifier et comploter, et comploter et planifier."

# Traduction IA – à relire
#: stella_stairs/StellaFriendshipEnding/0/g-0/16
msgctxt "Stella"
msgid "I haven't really slept."
msgstr "Je n'ai pas vraiment dormi."

# Traduction IA – à relire
#: stella_stairs/StellaFriendshipEnding/0/g-0/24/s/0
msgctxt "Choix"
msgid "That's not good."
msgstr "Ce n'est pas bien."

# Traduction IA – à relire
#: stella_stairs/StellaFriendshipEnding/0/g-0/25/s/0
msgctxt "Choix"
msgid "Well I've been thinking on some other options."
msgstr "Eh bien, moi, j'ai réfléchi à d'autres options."

# Traduction IA – à relire
#: stella_stairs/StellaFriendshipEnding/0/g-0/c-2/7
msgctxt "Stella"
msgid "Oh but it is dearie!"
msgstr "Oh, mais si, mon petit chou !"

# Traduction IA – à relire
#: stella_stairs/StellaFriendshipEnding/0/g-0/c-3/7
msgctxt "Stella"
msgid "STOP!"
msgstr "STOP !"

# Traduction IA – à relire
#: stella_stairs/StellaFriendshipEnding/0/g-1/0
msgctxt "Stella"
msgid "You see. I know you want to help. But the whole reason I wanted to do this was to do something... myself."
msgstr "Tu vois. Je sais que tu veux m'aider. Mais toute la raison pour laquelle je voulais faire ça, c'était de faire quelque chose... moi-même."

# Traduction IA – à relire
#: stella_stairs/StellaFriendshipEnding/0/g-1/8
msgctxt "Stella"
msgid "And I appreciate you taking the time."
msgstr "Et je te remercie d'avoir pris le temps."

# Traduction IA – à relire
#: stella_stairs/StellaFriendshipEnding/0/g-1/16
msgctxt "Stella"
msgid "But I wanted to solve this."
msgstr "Mais je voulais résoudre ça."

# Traduction IA – à relire
#: stella_stairs/StellaFriendshipEnding/0/g-1/24
msgctxt "Stella"
msgid "Hence the lack of sleep."
msgstr "D'où le manque de sommeil."

# Traduction IA – à relire
#: stella_stairs/StellaFriendshipEnding/0/g-1/32
msgctxt "Stella"
msgid "BUT I DID."
msgstr "MAIS J'AI RÉUSSI."

# Traduction IA – à relire
#: stella_stairs/StellaFriendshipEnding/0/g-1/40
msgctxt "Stella"
msgid "Or I might have."
msgstr "Ou peut-être."

# Traduction IA – à relire
#: stella_stairs/StellaFriendshipEnding/0/g-1/48
msgctxt "Stella"
msgid "Which, mind you, I wouldn't have had you not inspired me to do so."
msgstr "Ce que, remarque, je n'aurais pas fait si tu ne m'avais pas inspirée."

# Traduction IA – à relire
#: stella_stairs/StellaFriendshipEnding/0/g-1/56
msgctxt "Stella"
msgid "But I have something else. Something I know and something I can do and something I can make my own."
msgstr "Mais j'ai autre chose. Quelque chose que je connais, quelque chose que je sais faire et quelque chose que je peux m'approprier."

# Traduction IA – à relire
#: stella_stairs/StellaFriendshipEnding/0/g-1/72
msgctxt "Stella"
msgid "Do you notice anything different?"
msgstr "Tu remarques quelque chose de différent ?"

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/0/s/0
msgctxt "Choix"
msgid "Did you change your hair?"
msgstr "Tu as changé de coiffure ?"

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/1/s/0
msgctxt "Choix"
msgid "Did you change your outfit?"
msgstr "Tu as changé de tenue ?"

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/2/s/0
msgctxt "Choix"
msgid "Did you... grow?"
msgstr "Tu as... grandi ?"

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/3/s/0
msgctxt "Choix"
msgid "That's wonderful Stella!"
msgstr "C'est merveilleux, Stella !"

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/4/s/0
msgctxt "Choix"
msgid "WOOOOOOOH!!!"
msgstr "OUAAAAAAAIS !!!"

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/5/s/0
msgctxt "Choix"
msgid "Wow..."
msgstr "Ouah..."

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/c-0/7 stella_stairs/StellaDifferent/0/c-2/7
msgctxt "Stella"
msgid "NO!"
msgstr "NON !"

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/c-1/7
msgctxt "Stella"
msgid "NOPE!"
msgstr "PERDU !"

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/c-2/15
msgctxt "Stella"
msgid "But also yes!"
msgstr "Mais aussi oui !"

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/c-2/23
msgctxt "Narrator"
msgid "Stella holds herself upright, sticking one leg out and pointing her foot elegantly."
msgstr "Stella se tient bien droite, tend une jambe et pointe élégamment le pied."

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/c-2/31
msgctxt "Stella"
msgid "PRESENTING!"
msgstr "JE VOUS PRÉSENTE !"

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/c-2/39
msgctxt "Stella"
msgid "Reach the sky with Stella's latest hot-topic release."
msgstr "Touchez le ciel avec la toute dernière nouveauté brûlante de Stella."

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/c-2/50
msgctxt "Stella"
msgid "Free your feet, but also your life. Our design is sleek, but comfortable, edgy, but crafted with care."
msgstr "Libérez vos pieds, mais aussi votre vie. Un design élégant, mais confortable, audacieux, mais façonné avec soin."

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/c-2/58
msgctxt "Stella"
msgid "If you've ever wanted to stand on your own two feet, we're here to help you rise to the occasion. Speak to your local representative, Stella, today."
msgstr "Si vous avez toujours voulu tenir sur vos deux pieds, nous sommes là pour vous aider à vous hisser à la hauteur. Parlez-en à votre représentante locale, Stella, dès aujourd'hui."

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/c-2/69
msgctxt "Stella"
msgid "Stella's Stilettos, by Stella."
msgstr "Les Stilettos de Stella, par Stella."

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/c-2/80
msgctxt "Stella"
msgid "Stairs, for your feet."
msgstr "Des escaliers pour vos pieds."

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/c-2/88
msgctxt "Narrator"
msgid "The shoe is just as it sounds—a small pair of stairs for one's feet."
msgstr "La chaussure est exactement ce que son nom indique : un petit escalier pour les pieds."

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/c-2/96
msgctxt "Stella"
msgid "Step up."
msgstr "Montez d'une marche."

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/g-0/3
msgctxt "Stella"
msgid "And it's mine. It's my idea, it's my product."
msgstr "Et c'est à moi. C'est mon idée, c'est mon produit."

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/g-0/11
msgctxt "Stella"
msgid "It's me taking advantage of me and I don't even care if it fails because it's a thing that I'm doing and that's all I need it to be."
msgstr "C'est moi qui profite de moi, et ça m'est égal si ça échoue, parce que c'est un truc que je fais, et c'est tout ce que j'ai besoin que ce soit."

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/g-0/19
msgctxt "Stella"
msgid "And."
msgstr "Et."

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/g-0/27
msgctxt "Stella"
msgid "And..."
msgstr "Et..."

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/g-0/35
msgctxt "Stella"
msgid "And thank you."
msgstr "Et merci."

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/g-0/43
msgctxt "Stella"
msgid "Thank you so much dearie."
msgstr "Merci infiniment, mon petit chou."

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/g-0/51
msgctxt "Stella"
msgid "Because I almost missed it."
msgstr "Parce que j'ai failli passer à côté."

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/g-0/67
msgctxt "Stella"
msgid "I do hope you didn't spend too much time thinking on your own alternatives."
msgstr "J'espère que tu n'as pas passé trop de temps à réfléchir à tes propres solutions."

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/g-0/75
msgctxt "Stella"
msgid "I just needed this idea to be my own."
msgstr "J'avais juste besoin que cette idée vienne de moi."

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/g-0/83
msgctxt "Stella"
msgid "But I couldn't have thought of it without you."
msgstr "Mais je n'aurais pas pu y penser sans toi."

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/g-0/91/s/0
msgctxt "Choix"
msgid "What's one night spent in wonder?"
msgstr "Qu'est-ce qu'une nuit passée à s'émerveiller ?"

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/g-0/92/s/0
msgctxt "Choix"
msgid "And you couldn't have done it without you."
msgstr "Et tu n'aurais pas pu y arriver sans toi."

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/g-0/93/s/0
msgctxt "Choix"
msgid "I'm proud of you."
msgstr "Je suis {{fier|fière|fier·e}} de toi."

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/g-1/0/b/4
msgctxt "Celia"
msgid "Stella! My dear, I saw your business application filing this morning."
msgstr "Stella ! Ma chère, j'ai vu votre demande d'immatriculation d'entreprise ce matin."

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/g-1/0/b/12
msgctxt "Celia"
msgid "I take it this means you've come to your senses."
msgstr "J'en déduis que vous êtes revenue à la raison."

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/g-1/0/b/20
msgctxt "Celia"
msgid "I'm grateful."
msgstr "Je vous en suis reconnaissante."

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/g-1/0/b/28
msgctxt "Celia"
msgid "And a little proud, truth be told."
msgstr "Et un peu fière, à vrai dire."

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/g-1/0/b/44
msgctxt "Stella"
msgid "Celia... Thank you."
msgstr "Celia... Merci."

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/g-1/0/b/52
msgctxt "Celia"
msgid "Now. I've work to return to, but I'll be back. I'm eager to see what you create."
msgstr "Bien. J'ai du travail qui m'attend, mais je reviendrai. J'ai hâte de voir ce que vous allez créer."

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/g-1/13
msgctxt "Stella"
msgid "You, my dear, are the dearest friend I have. I spent all night on this just to prove I could, and I know it's nothing special, but I want you to have it."
msgstr "Toi, mon chou, tu es {{le plus cher ami|la plus chère amie|l'ami·e le plus cher}} que j'aie. J'ai passé toute la nuit là-dessus juste pour prouver que j'en étais capable, et je sais que ce n'est rien de spécial, mais je veux que tu l'aies."

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/g-1/21
msgctxt "Narrator"
msgid "She hands you the shoe, smiling as you take it from her with gentle hands."
msgstr "Elle vous tend la chaussure, souriant tandis que vous la prenez délicatement."

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/g-1/29
msgctxt "Stella"
msgid "And I'd love to stay and chat, but I'm off to make a hundred more. Too busy for chit chat."
msgstr "Et j'adorerais rester bavarder, mais je file en fabriquer cent de plus. Trop occupée pour papoter."

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/g-1/37 stella_stairs/longway_stella/0/16
msgctxt "Stella"
msgid "Never thought I'd get to say that."
msgstr "Je n'aurais jamais cru pouvoir dire ça un jour."

# Traduction IA – à relire
#: stella_stairs/StellaDifferent/0/g-1/45
msgctxt "Stella"
msgid "Take care dearie. And do swing by!"
msgstr "Prends soin de toi, mon petit chou. Et repasse me voir !"

# Traduction IA – à relire
#: stella_stairs/longway_stella/0/0
msgctxt "Stella"
msgid "You... are the dearest human I have."
msgstr "Tu... es {{l'humain le plus cher|l'humaine la plus chère|l'humain·e le plus cher}} que j'aie."

# Traduction IA – à relire
#: stella_stairs/longway_stella/0/24
msgctxt "Stella"
msgid "I did hate you. Did."
msgstr "Je t'ai {{détesté|détestée|détesté·e}}, c'est vrai. Au passé."

# Traduction IA – à relire
#: stella_stairs/longway_stella/0/32
msgctxt "Stella"
msgid "But the way you've treated me shows me that perhaps I misjudged you."
msgstr "Mais ta façon de me traiter me montre que je t'ai peut-être mal {{jugé|jugée|jugé·e}}."

# Traduction IA – à relire
#: stella_stairs/longway_stella/0/40
msgctxt "Stella"
msgid "How do you feel about us now?"
msgstr "Que penses-tu de nous, maintenant ?"

# Traduction IA – à relire
#: stella_stairs/longway_stella/0/48
msgctxt "Stella"
msgid "The two of us."
msgstr "Nous deux."

# Traduction IA – à relire
#: stella_stairs/longway_stella/0/56/s/0
msgctxt "Choix"
msgid "With Celia and Florence... I think the four of us should shack up together!"
msgstr "Avec Celia et Florence... je pense qu'on devrait s'installer tous les quatre ensemble !"

# Traduction IA – à relire
#: stella_stairs/longway_stella/0/57/s/0
msgctxt "Choix"
msgid "We had our differences... but it was only because I cared about you, Stella."
msgstr "On a eu nos différends... mais c'était seulement parce que je tenais à toi, Stella."

# Traduction IA – à relire
#: stella_stairs/longway_stella/0/58/s/0
msgctxt "Choix"
msgid "Friends is fine with me!"
msgstr "Rester {{amis|amies|ami·es}}, ça me va très bien !"

# Traduction IA – à relire
#: stella_stairs/longway_stella/0/c-0/7
msgctxt "Stella"
msgid "Oh my! Cheeky!"
msgstr "Oh, ma parole ! {{Petit coquin|Petite coquine|Petit·e coquin·e}} !"

# Traduction IA – à relire
#: stella_stairs/longway_stella/0/c-0/15
msgctxt "Stella"
msgid "...I'll see if the other girls would be into that..."
msgstr "... Je vais voir si les autres filles seraient partantes..."

# Traduction IA – à relire
#: stella_stairs/longway_stella/0/c-1/7
msgctxt "Stella"
msgid "I can see that now."
msgstr "Je le vois, maintenant."

# Traduction IA – à relire
#: stella_stairs/longway_stella/0/c-1/15
msgctxt "Stella"
msgid "I was blinded before."
msgstr "J'étais aveugle, avant."

# Traduction IA – à relire
#: stella_stairs/longway_stella/0/c-1/23
msgctxt "Stella"
msgid "Come here, my dearie."
msgstr "Viens là, mon petit chou à moi."

# Traduction IA – à relire
#: stella_stairs/longway_stella/0/c-2/7
msgctxt "Stella"
msgid "There there..."
msgstr "Là, là..."

# Traduction IA – à relire
#: stella_stairs/longway_stella/0/c-2/15
msgctxt "Stella"
msgid "Thank you for truly looking out for me."
msgstr "Merci de veiller vraiment sur moi."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaEmploymentReturn/0/0
msgctxt "Stella"
msgid "Why hello dearie. I do love a work visit, but you'll have to forgive me, we're busy busy busy."
msgstr "Tiens, bonjour, mon petit chou. J'adore les visites au travail, mais tu vas devoir m'excuser, on est débordées, débordées, débordées."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaEmploymentReturn/0/8/b/9
msgctxt "Stella"
msgid "Coming!"
msgstr "J'arrive !"

# Traduction IA – à relire
#: stella_stairs/StellaCeliaEmploymentReturn/0/11
msgctxt "Stella"
msgid "It's always lovely to see you."
msgstr "C'est toujours un plaisir de te voir."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaEmploymentReturn/0/19/s/0
msgctxt "Choix"
msgid "And you, Stella."
msgstr "Toi aussi, Stella."

# Traduction IA – à relire
#: stella_stairs/StellaCeliaEmploymentReturn/0/20/s/0 stella_stairs/stella_love_return_joiner/0/9/s/0 stella_stairs/stella_else_friendreturn/0/9/s/0
msgctxt "Choix"
msgid "I'm ready to Realize you."
msgstr "Je suis {{prêt|prête|prêt·e}} à te Réaliser."

# Traduction IA – à relire
#: stella_stairs/slr1/0
msgctxt "Stella"
msgid "Page 32. Always wear pink to a funeral. Stand out from the crowd."
msgstr "Page 32. Portez toujours du rose à un enterrement. Démarquez-vous de la foule."

# Traduction IA – à relire
#: stella_stairs/slr2/0
msgctxt "Stella"
msgid "Page 12. H.U.S.T.L.E Having. Ultimate. Self-Confidence. Trust. Leverage and Entrepreneurship."
msgstr "Page 12. F.O.N.C.E.R. Foi. Optimisme. Nerfs d'acier. Confiance. Effet de levier et Rentabilité."

# Traduction IA – à relire
#: stella_stairs/slr3/0
msgctxt "Stella"
msgid "Page 2. A.B.C. Always be cleansing."
msgstr "Page 2. A.B.C. Avant tout, Bien se Curer."

# Traduction IA – à relire
#: stella_stairs/slr4/0
msgctxt "Stella"
msgid "A sale, I think they mean a sale."
msgstr "Conclure, je crois qu'ils veulent dire conclure."

# Traduction IA – à relire
#: stella_stairs/slr5/0
msgctxt "Stella"
msgid "Page 97. You can never have too much stock, but you can run out of storage space."
msgstr "Page 97. On n'a jamais trop de stock, mais on peut manquer de place pour le ranger."

# Traduction IA – à relire
#: stella_stairs/slr5/8
msgctxt "Stella"
msgid "Consider investing in a larger house."
msgstr "Envisagez d'investir dans une plus grande maison."

# Traduction IA – à relire
#: stella_stairs/slr6/0
msgctxt "Stella"
msgid "Page 9. It's ALWAYS a bear market."
msgstr "Page 9. C'est TOUJOURS un marché baissier."

# Traduction IA – à relire
#: stella_stairs/slr7/0
msgctxt "Stella"
msgid "Page 20. Pain is weakness leaving your investment portfolio."
msgstr "Page 20. La douleur, c'est la faiblesse qui quitte votre portefeuille d'investissement."

# Traduction IA – à relire
#: stella_stairs/slr8/0
msgctxt "Stella"
msgid "Page 35. Monetize your hobbies or die."
msgstr "Page 35. Monétisez vos loisirs ou crevez."

# Traduction IA – à relire
#: stella_stairs/slr9/0
msgctxt "Stella"
msgid "Page 71. Invest everything. What's the worst that could happen?"
msgstr "Page 71. Investissez tout. Qu'est-ce qui pourrait mal tourner ?"

# Traduction IA – à relire
#: stella_stairs/slr10/0
msgctxt "Stella"
msgid "Page 21. Mortgage? More like passive income."
msgstr "Page 21. Un prêt immobilier ? Disons plutôt un revenu passif."

# Traduction IA – à relire
#: stella_stairs/stella_love_return_joiner/0/0
msgctxt "Stella"
msgid "My favourite right hand. Want to help me check on the books?"
msgstr "Mon bras droit préféré. Tu veux m'aider à vérifier les comptes ?"

# Traduction IA – à relire
#: stella_stairs/stella_love_return_joiner/0/8/s/0
msgctxt "Choix"
msgid "Of course!"
msgstr "Bien sûr !"

# Traduction IA – à relire
#: stella_stairs/stella_love_return_joiner/0/c-0/7
msgctxt "Narrator"
msgid "You do check on the books, as well as other, more private things."
msgstr "Vous vérifiez bien les comptes, ainsi que d'autres choses, plus intimes."

# Traduction IA – à relire
#: stella_stairs/stella_love_return_joiner/0/c-0/15
msgctxt "Narrator"
msgid "One can say that with Stella, your business, at least, is booming."
msgstr "On peut dire qu'avec Stella, vos affaires, au moins, sont florissantes."

# Traduction IA – à relire
#: stella_stairs/stella_realize_join/0/0
msgctxt "Stella"
msgid "Truly dear!? I mean. I'm flattered. B-but you don't have to. Unless you, well, want to."
msgstr "Vraiment, mon chou !? Enfin. Je suis flattée. M-mais tu n'es pas {{obligé|obligée|obligé·e}}. À moins que tu, eh bien, le veuilles."

# Traduction IA – à relire
#: stella_stairs/stella_realize_join/0/11
msgctxt "Stella"
msgid "I mean I want to, but only if you want to too."
msgstr "Enfin, moi, je le veux, mais seulement si toi aussi, tu le veux."

# Traduction IA – à relire
#: stella_stairs/stella_realize_join/0/28/s/0
msgctxt "Choix"
msgid "I want to. And I've got what we'd need."
msgstr "Je le veux. Et j'ai ce qu'il nous faut."

# Traduction IA – à relire
#: stella_stairs/stella_realize_join/0/29/s/0
msgctxt "Choix"
msgid "Perhaps not just yet."
msgstr "Peut-être pas tout de suite."

# Traduction IA – à relire
#: stella_stairs/stella_realize_join/0/c-1/10
msgctxt "Stella"
msgid "Then I'll stay here 'til you're ready."
msgstr "Alors je resterai ici jusqu'à ce que tu sois {{prêt|prête|prêt·e}}."

# Traduction IA – à relire
#: stella_stairs/stella_realize_return/0/0
msgctxt "Stella"
msgid "You're back. Are we ready?"
msgstr "Te revoilà. On y va ?"

# Traduction IA – à relire
#: stella_stairs/stella_realize_return/0/17/s/0
msgctxt "Choix"
msgid "Yes, time to step up."
msgstr "Oui, il est temps de monter d'une marche."

# Traduction IA – à relire
#: stella_stairs/stella_realize_return/0/18/s/0
msgctxt "Choix"
msgid "Not just yet. One step at a time."
msgstr "Pas tout de suite. Une marche à la fois."

# Traduction IA – à relire
#: stella_stairs/stella_realize_return/0/c-1/10
msgctxt "Stella"
msgid "One step at a time. Then I will stay here 'til you're ready."
msgstr "Une marche à la fois. Alors je resterai ici jusqu'à ce que tu sois {{prêt|prête|prêt·e}}."

# Traduction IA – à relire
#: stella_stairs/stella_realize_begin/6/b/1
msgctxt "Skylar"
msgid "Our first Realization is going to be Stella, huh? I hope she'll be safe out there..."
msgstr "Notre première Réalisation, ce sera Stella, hein ? J'espère qu'elle sera en sécurité, là-dehors..."

# Traduction IA – à relire
#: stella_stairs/stella_realize_begin/9
msgctxt "Skylar"
msgid "Time to step out!"
msgstr "En avant, marche !"

# Traduction IA – à relire
#: stella_stairs/stella_realize_begin/20
msgctxt "Narrator"
msgid "The spectral energy flows through your dateviators, and what was once merely a set of stairs, becomes...."
msgstr "L'énergie spectrale traverse vos Dateviators, et ce qui n'était qu'un simple escalier devient..."

# Traduction IA – à relire
#: stella_stairs/stella_realized/0/3
msgctxt "Stella"
msgid "Oh me oh my!"
msgstr "Oh, Seigneur, ma parole !"

# Traduction IA – à relire
#: stella_stairs/stella_realized/0/14
msgctxt "Stella"
msgid "Standing is a little bit..."
msgstr "Tenir debout, c'est un petit peu..."

# Traduction IA – à relire
#: stella_stairs/stella_realized/0/22
msgctxt "Stella"
msgid "Woozy?"
msgstr "Vertigineux ?"

# Traduction IA – à relire
#: stella_stairs/stella_realized/0/30/s/0
msgctxt "Choix"
msgid "Oh no! Are you okay?"
msgstr "Oh non ! Ça va ?"

# Traduction IA – à relire
#: stella_stairs/stella_realized/0/c-0/7
msgctxt "Stella"
msgid "No... It's a little bit wonderful. Actually."
msgstr "Non... C'est un petit peu merveilleux. En fait."

# Traduction IA – à relire
#: stella_stairs/stella_realized/0/c-0/15
msgctxt "Stella"
msgid "Standing on my own two feet."
msgstr "Tenir sur mes deux pieds."

# Traduction IA – à relire
#: stella_stairs/stella_realized/0/g-0/0
msgctxt "Stella"
msgid "I can move, I can look back, I can see how far I've come. And I can do that again and again and again."
msgstr "Je peux bouger, je peux regarder en arrière, je peux voir tout le chemin parcouru. Et je peux le refaire encore et encore et encore."

# Traduction IA – à relire
#: stella_stairs/stella_realized/0/g-0/8
msgctxt "Stella"
msgid "Thank you for your patronage."
msgstr "Merci de votre fidélité."

# Traduction IA – à relire
#: stella_stairs/stella_realized/0/g-0/16/s/0
msgctxt "Choix"
msgid "You are most welcome, Stella."
msgstr "Tout le plaisir est pour moi, Stella."

# Traduction IA – à relire
#: stella_stairs/stella_realized/0/g-0/17/s/0
msgctxt "Choix"
msgid "Care to take this higher?"
msgstr "Ça te dirait de monter plus haut ?"

# Traduction IA – à relire
#: stella_stairs/stella_realize_love_divert/8
msgctxt "Stella"
msgid "Well... let me see how these joints will do..."
msgstr "Eh bien... voyons comment ces articulations vont tenir..."

# Traduction IA – à relire
#: stella_stairs/stella_realize_love_divert/19
msgctxt "Narrator"
msgid "Stella is far sturdier than she seems. With her experience, she teaches you that you can always take things..."
msgstr "Stella est bien plus solide qu'elle n'en a l'air. Forte de son expérience, elle vous apprend qu'on peut toujours aller..."

# Traduction IA – à relire
#: stella_stairs/stella_realize_love_divert/30
msgctxt "Narrator"
msgid "One..."
msgstr "Une..."

# Traduction IA – à relire
#: stella_stairs/stella_realize_love_divert/38
msgctxt "Narrator"
msgid "Step..."
msgstr "Marche..."

# Traduction IA – à relire
#: stella_stairs/stella_realize_love_divert/46
msgctxt "Narrator"
msgid "Higher...."
msgstr "Plus haut..."

# Traduction IA – à relire
#: stella_stairs/stella_realize_love_join/0
msgctxt "Narrator"
msgid "Stella steps up and steps out."
msgstr "Stella monte d'une marche, puis prend son envol."

# Traduction IA – à relire
#: stella_stairs/stella_realize_love_join/8
msgctxt "Stella"
msgid "Onward and upward!"
msgstr "En avant, et plus haut !"

# Traduction IA – à relire
#: stella_stairs/stella_realize_love_join/19
msgctxt "Narrator"
msgid "Striking right at the heart of entrepreneurship, Stella starts three companies simultaneously."
msgstr "Frappant au cœur même de l'entrepreneuriat, Stella lance trois entreprises à la fois."

# Traduction IA – à relire
#: stella_stairs/stella_realize_love_join/27
msgctxt "Stella"
msgid "Stella's Stilettos! Stella's Stencils! Stella's Steering Wheels!"
msgstr "Les Stilettos de Stella ! Les Stylos de Stella ! Les Stores de Stella !"

# Traduction IA – à relire
#: stella_stairs/stella_realize_love_join/35
msgctxt "Narrator"
msgid "But in the real world of brutal economic truth, there was more to being successful than showing up and working hard. Sometimes things stayed stagnant, or even dipped."
msgstr "Mais dans le monde réel, celui de l'impitoyable vérité économique, réussir demandait plus que de se présenter et travailler dur. Parfois, les choses stagnaient, voire déclinaient."

# Traduction IA – à relire
#: stella_stairs/stella_realize_love_join/43
msgctxt "Stella"
msgid "I'm... not always leveling up..."
msgstr "Je... ne monte pas toujours de niveau..."

# Traduction IA – à relire
#: stella_stairs/stella_realize_love_join/51
msgctxt "Narrator"
msgid "In order to cope with the feelings of despair, Stella opened a silly-looking app that you had downloaded onto her phone: Candy Crash."
msgstr "Pour surmonter son désespoir, Stella ouvrit une appli à l'air idiot que vous aviez téléchargée sur son téléphone : Candy Crash."

# Traduction IA – à relire
#: stella_stairs/stella_realize_love_join/59
msgctxt "Narrator"
msgid "And very soon topped the leaderboards over the entire world..."
msgstr "Et elle se hissa très vite en tête des classements mondiaux..."

# Traduction IA – à relire
#: stella_stairs/stella_realize_love_join/67
msgctxt "Stella"
msgid "Don't stop, don't stop! Those numbers can still be higher!"
msgstr "Continue, continue ! Ces chiffres peuvent encore grimper !"

# Traduction IA – à relire
#: stella_stairs/stella_realize_love_join/78
msgctxt "Narrator"
msgid "With that kind of attention, streaming was the obvious next step. Stella's Streams keep gamers inspired with new tactics and toolkits to get their scores into the stratosphere."
msgstr "Avec une telle attention, le streaming était l'étape suivante évidente. Les Streams de Stella inspirent les joueurs avec de nouvelles tactiques et astuces pour propulser leurs scores dans la stratosphère."

# Traduction IA – à relire
#: stella_stairs/stella_realize_love_join/86
msgctxt "Stella"
msgid "Rule 102 - No Microtransactions - all hard work!"
msgstr "Règle 102 : pas de microtransactions, que du travail acharné !"

# Traduction IA – à relire
#: stella_stairs/stella_stilletto_friendreturn/0/0 stella_stairs/stella_else_friendreturn/0/0
msgctxt "Stella"
msgid "Dearie! So nice of you to swing by."
msgstr "Mon petit chou ! C'est gentil de passer."

# Traduction IA – à relire
#: stella_stairs/stella_stilletto_friendreturn/0/8
msgctxt "Stella"
msgid "I wish I had more time to chat, but I've got a huge order coming in. Magic in the making."
msgstr "J'aimerais avoir plus de temps pour bavarder, mais j'ai une énorme commande qui arrive. La magie est en marche."

# Traduction IA – à relire
#: stella_stairs/stella_stilletto_friendreturn/0/16/s/0 stella_stairs/stella_shutdown_friendreturn/0/19/s/0
msgctxt "Choix"
msgid "Go and make that magic!"
msgstr "Va faire ta magie !"

# Traduction IA – à relire
#: stella_stairs/stella_stilletto_friendreturn/0/17/s/0
msgctxt "Choix"
msgid "But wait - Stella, I'm ready to Realize you."
msgstr "Mais attends... Stella, je suis {{prêt|prête|prêt·e}} à te Réaliser."

# Traduction IA – à relire
#: stella_stairs/stella_mogul_friendreturn/0/0
msgctxt "Stella"
msgid "Lieutenant! Sales on the rise."
msgstr "Lieutenant ! Les ventes grimpent."

# Traduction IA – à relire
#: stella_stairs/stella_mogul_friendreturn/0/8
msgctxt "Stella"
msgid "Did you hear about the new essence? Activated Air: Volcanic Breeze? It's like activated charcoal, but AIR!"
msgstr "Tu as entendu parler de la nouvelle essence ? Air Activé : Brise Volcanique ? C'est comme le charbon activé, mais en AIR !"

# Traduction IA – à relire
#: stella_stairs/stella_mogul_friendreturn/0/19/s/0
msgctxt "Choix"
msgid "Now that sounds like success to me, my friend!"
msgstr "Voilà qui ressemble au succès, mon amie !"

# Traduction IA – à relire
#: stella_stairs/stella_mogul_friendreturn/0/20/s/0
msgctxt "Choix"
msgid "Did you hear about the new Realization essense going around? I'm ready to Realize you!"
msgstr "Tu as entendu parler de la nouvelle essence de Réalisation qui circule ? Je suis {{prêt|prête|prêt·e}} à te Réaliser !"

# Traduction IA – à relire
#: stella_stairs/stella_shutdown_friendreturn/0/0
msgctxt "Stella"
msgid "Even though I've lost my business... that doesn't mean that more can't spring up!"
msgstr "J'ai beau avoir perdu mon entreprise... ça ne veut pas dire que d'autres ne peuvent pas éclore !"

# Traduction IA – à relire
#: stella_stairs/stella_shutdown_friendreturn/0/11 stella_stairs/stella_else_friendreturn/0/c-0/7
msgctxt "Stella"
msgid "Let's go onward — up and up!"
msgstr "En avant, toujours plus haut !"

# Traduction IA – à relire
#: stella_stairs/stella_shutdown_friendreturn/0/20/s/0
msgctxt "Choix"
msgid "Well I have good news - I'm ready to Realize you."
msgstr "Eh bien, j'ai une bonne nouvelle : je suis {{prêt|prête|prêt·e}} à te Réaliser."

# Traduction IA – à relire
#: stella_stairs/stella_else_friendreturn/0/8/s/0
msgctxt "Choix"
msgid "It's always nice to check in on ya, Stella."
msgstr "Ça fait toujours plaisir de prendre de tes nouvelles, Stella."

# Traduction IA – à relire
#: stella_stairs/stella_hate_return/0/8
msgctxt "Stella"
msgid "You're either going up or coming down. Just don't stick around."
msgstr "Soit tu montes, soit tu descends. Mais ne reste pas {{collé|collée|collé·e}} là."

# Traduction IA – à relire
#: stella_stairs/stella_hate_return/0/16/s/0
msgctxt "Choix"
msgid "Just passing through."
msgstr "Je ne fais que passer."

# Traduction IA – à relire
#: stella_stairs/stella_hate_return/0/17/s/0
msgctxt "Choix"
msgid "What if I want to stick to you? (USE CHARM CANDY)"
msgstr "Et si je veux rester {{collé|collée|collé·e}} à toi ? (UTILISER UN BONBON DE CHARME)"

# Traduction IA – à relire
#: stella_stairs/stella_hate_return/0/c-0/7
msgctxt "Narrator"
msgid "You pass on by."
msgstr "Vous passez votre chemin."

# Traduction IA – à relire
#: stella_stairs/stella_hate_return/0/c-1/7
msgctxt "Stella"
msgid "Is that...?"
msgstr "C'est...?"

# Traduction IA – à relire
#: stella_stairs/stella_hate_return/0/c-1/15
msgctxt "Stella"
msgid "Are those little hard candies?"
msgstr "Ce sont des petits bonbons durs ?"

# Traduction IA – à relire
#: stella_stairs/stella_hate_return/0/c-1/23
msgctxt "Stella"
msgid "I love those things."
msgstr "J'adore ces trucs-là."

# Traduction IA – à relire
#: stella_stairs/stella_hate_return/0/c-1/31
msgctxt "Stella"
msgid "I hear they are great for increasing your stats. Ever higher. Up and up."
msgstr "Il paraît qu'ils sont parfaits pour augmenter ses statistiques. Toujours plus. Toujours plus haut."

# Traduction IA – à relire
#: stella_stairs/stella_hate_return/0/c-1/39/0/s/0
msgctxt "Choix"
msgid "Something like that."
msgstr "Quelque chose comme ça."

# Traduction IA – à relire
#: stella_stairs/stella_hate_return/0/c-1/39/c-0/7
msgctxt "Stella"
msgid "I can't fault you for trying your best to make it work."
msgstr "Je ne peux pas te reprocher de faire de ton mieux pour que ça marche."

# Traduction IA – à relire
#: stella_stairs/stella_hate_return/0/c-1/39/c-0/15
msgctxt "Stella"
msgid "Here. Stand by me and we can reach the next level together."
msgstr "Tiens. Reste à mes côtés et on passera au niveau supérieur ensemble."
