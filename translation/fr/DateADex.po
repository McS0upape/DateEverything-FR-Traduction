msgid "{vegetarian==false: Beef Wellington}{vegetarian==true: Mushroom Wellington}"
msgstr "{vegetarian==false: Boeuf Wellington}{vegetarian==true: Champignons Wellington}"

# Traduction IA – à relire
#: DateADex/stefan_dex_entry/106
msgctxt "Tag Date-A-Dex"
msgid "Easier to draw than bake."
msgstr "Plus facile à dessiner qu'à cuire."

# Traduction IA – à relire
#: DateADex/stefan_dex_entry/109 DateADex/stefan_dex_entry/118
msgctxt "Tag Date-A-Dex"
msgid "Ask Stefan to cook."
msgstr "Demande à Stefan de cuisiner."

# Traduction IA – à relire
#: DateADex/stefan_dex_entry/112
msgctxt "Tag Date-A-Dex"
msgid "Nachos à la Estufa"
msgstr "Nachos à la Estufa"

# Traduction IA – à relire
#: DateADex/stefan_dex_entry/115
