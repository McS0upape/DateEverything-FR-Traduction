msgid "I already talked to her."
msgstr "Je lui ai déjà parlé."

# Traduction IA – à relire
#: skylar_specs/skylar_wherenext/0/c-1/7
msgctxt "Skylar"
msgid "Magnifying glass, over next to the piano!"
msgstr "La loupe, à côté du piano !"

# Traduction IA – à relire
#: skylar_specs/skylar_wherenext/0/c-2/7
msgctxt "Skylar"
msgid "You did yesterday... but today is a whole new day and I'm fully charged!"
msgstr "Hier, oui... mais aujourd'hui est un tout nouveau jour et je suis rechargée à bloc !"

