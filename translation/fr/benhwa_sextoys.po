# Traduction IA – à relire
#: benhwa_sextoys/1
msgctxt "Tag Nom d'objet (MAJUSCULES)"
msgid "MYSTERIOUS OBJECTS"
msgstr "OBJETS MYSTÉRIEUX"

# Traduction IA – à relire
#: benhwa_sextoys/benhwa_content/0/3
msgctxt "Skylar"
msgid "Hey."
msgstr "Salut."

# Traduction IA – à relire
#: benhwa_sextoys/benhwa_content/0/11
msgctxt "Skylar"
msgid "So the little bag that's in the dresser next to your bed?"
msgstr "Alors, le petit sac dans la commode à côté de ton lit ?"

# Traduction IA – à relire
#: benhwa_sextoys/benhwa_content/0/27
msgctxt "Skylar"
msgid "They're sex toys."
msgstr "Ce sont des sextoys."

# Traduction IA – à relire
#: benhwa_sextoys/benhwa_content/0/35
msgctxt "Ben-hwa"
msgid "Toys? Pleasure is not a <i>game</i>, darling."
msgstr "Des jouets ? Le plaisir n'est pas un <i>jeu</i>, mon coeur."

# Traduction IA – à relire
#: benhwa_sextoys/benhwa_content/0/43
msgctxt "Ben-hwa"
msgid "But at least you didn't call me a marital aid."
msgstr "Mais au moins, tu n'as pas dit que j'étais un accessoire conjugal."

# Traduction IA – à relire
#: benhwa_sextoys/benhwa_content/0/51
msgctxt "Skylar"
msgid "Ben-hwa is gonna have some pretty choice dialogue and themes. They're 'adults only'."
msgstr "Ben-hwa va avoir des dialogues et des thèmes assez croustillants. C'est « réservé aux adultes »."

# Traduction IA – à relire
#: benhwa_sextoys/benhwa_content/0/59
msgctxt "Skylar"
msgid "They might also be a little 'pushy' with their consent!"
msgstr "Et il se peut que le consentement soit traité de façon un peu « poussée » !"

# Traduction IA – à relire
#: benhwa_sextoys/benhwa_content/0/67
msgctxt "Ben-hwa"
msgid "You wanna skip me? That's fine."
msgstr "Tu veux me zapper ? Pas de souci."

# Traduction IA – à relire
#: benhwa_sextoys/benhwa_content/0/75
msgctxt "Ben-hwa"
msgid "I can have plenty of fun all by myself."
msgstr "Je saurai m'amuser très bien sans personne."

# Traduction IA – à relire
#: benhwa_sextoys/benhwa_content/0/83/s/0
msgctxt "Choix"
msgid "Yeah, I can't be having that all over my monitor."
msgstr "Ouais, je ne peux pas laisser ça s'afficher sur mon écran."

# Traduction IA – à relire
#: benhwa_sextoys/benhwa_content/0/84/s/0
msgctxt "Choix"
msgid "No, let me in. I like this stuff."
msgstr "Non, laisse-moi entrer. J'aime ce genre de trucs."

# Traduction IA – à relire
#: benhwa_sextoys/benhwa_content/0/c-0/29
msgctxt "Narrator"
msgid "How would you like your relationship with Ben-hwa to resolve?"
msgstr "Comment voulez-vous que votre relation avec Ben-hwa se conclue ?"

# Traduction IA – à relire
#: benhwa_sextoys/benhwa_content/0/c-0/34/0/s/0
msgctxt "Choix"
msgid "Love!"
msgstr "L'amour !"

# Traduction IA – à relire
#: benhwa_sextoys/benhwa_content/0/c-0/34/1/s/0
msgctxt "Choix"
msgid "Friendship!"
msgstr "L'amitié !"

# Traduction IA – à relire
#: benhwa_sextoys/benhwa_content/0/c-0/34/2/s/0
msgctxt "Choix"
msgid "Hate!"
msgstr "La haine !"

# Traduction IA – à relire
#: benhwa_sextoys/benhwa_content/0/c-0/34/c-0/7
msgctxt "Narrator"
msgid "Ben-hwa's face fills with excitement at the immediate prospect of your love. Ooh-la-la."
msgstr "Le visage de Ben-hwa s'illumine à la perspective immédiate de votre amour. Ooh-la-la."

# Traduction IA – à relire
#: benhwa_sextoys/benhwa_content/0/c-0/34/c-0/15
msgctxt "Skylar"
msgid "It's love!"
msgstr "C'est l'amour !"

# Traduction IA – à relire
#: benhwa_sextoys/benhwa_content/0/c-0/34/c-0/35 benhwa_sextoys/benhwa_content/0/c-0/34/c-1/48 benhwa_sextoys/benhwa_content/0/c-0/34/c-2/35
msgctxt "Skylar"
msgid "See you out there on the next one!"
msgstr "À bientôt pour la suite !"

# Traduction IA – à relire
#: benhwa_sextoys/benhwa_content/0/c-0/34/c-1/7
msgctxt "Narrator"
msgid "It could be said that Ben-hwa enjoys friendship just as much as any other inanimate object. You are now friends."
msgstr "On pourrait dire que Ben-hwa apprécie l'amitié autant que n'importe quel autre objet inanimé. Vous voilà amis."

# Traduction IA – à relire
#: benhwa_sextoys/benhwa_content/0/c-0/34/c-1/12
msgctxt "Ben-hwa"
msgid "Sure, I understand."
msgstr "Oui, je comprends."

# Traduction IA – à relire
#: benhwa_sextoys/benhwa_content/0/c-0/34/c-1/23
msgctxt "Ben-hwa"
msgid "Friends it is."
msgstr "Va pour l'amitié."

# Traduction IA – à relire
#: benhwa_sextoys/benhwa_content/0/c-0/34/c-1/28
msgctxt "Skylar"
msgid "Aww... friends forever."
msgstr "Aww... amis pour toujours."

# Traduction IA – à relire
#: benhwa_sextoys/benhwa_content/0/c-0/34/c-2/7
msgctxt "Narrator"
msgid "It was never meant to be for you and Ben-hwa - they are your bitter enemy."
msgstr "Ça n'a jamais été fait pour marcher entre vous et Ben-hwa : c'est votre ennemi juré."

# Traduction IA – à relire
#: benhwa_sextoys/benhwa_content/0/c-0/34/c-2/15
msgctxt "Skylar"
msgid "Enjoy your... hateship."
msgstr "Profitez bien de votre... haimitié."

# Traduction IA – à relire
#: benhwa_sextoys/benhwa_content/0/c-0/34/c-2/68 benhwa_sextoys/benhwa_hate_path_together/86
msgctxt "Reggie"
msgid "Y'know..."
msgstr "Tu sais..."

# Traduction IA – à relire
#: benhwa_sextoys/benhwa_content/0/c-0/34/c-2/76 benhwa_sextoys/benhwa_hate_path_together/94
msgctxt "Reggie"
msgid "...by definition I'm a virgin."
msgstr "...par définition, je suis vierge."

# Traduction IA – à relire
#: benhwa_sextoys/benhwa_content/0/c-1/7
msgctxt "Skylar"
msgid "Okay, have funsies!"
msgstr "Bon, amusez-vous bien !"

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/9
msgctxt "Narrator"
msgid "The stranger standing before you is dressed to kill—a sheer black catsuit, studded black manacles with pink fur trim, and a variety of brightly colored accessories drape their shoulders and frame their delicate features."
msgstr "La personne qui se tient devant vous est sapée pour tuer : une combinaison noire transparente, des menottes noires cloutées bordées de fourrure rose, et tout un assortiment d'accessoires aux couleurs vives drapés sur ses épaules et encadrant ses traits délicats."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/17
msgctxt "Narrator"
msgid "Loneliness has been such a defining factor in your existence over the last few years—you've almost forgotten what it's like to be around others."
msgstr "La solitude a tellement défini votre existence ces dernières années que vous avez presque oublié ce que c'est que de côtoyer les autres."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/25
msgctxt "Narrator"
msgid "You've <i>certainly</i> forgotten what it's like to be around someone like this—you almost feel as if you've stepped into a sex shop."
msgstr "Vous avez <i>certainement</i> oublié ce que c'est que de côtoyer quelqu'un comme ça : on dirait presque que vous avez poussé la porte d'un sex-shop."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/39
msgctxt "Ben-hwa"
msgid "There you are... I was beginning to think you'd forgotten me."
msgstr "Te voilà... Je commençais à croire que tu avais zappé mon existence."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/47/s/0
msgctxt "Choix"
msgid "Who could forget you?"
msgstr "Qui pourrait t'oublier ?"

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/48/s/0
msgctxt "Choix"
msgid "I absolutely did."
msgstr "Complètement, oui."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/49/s/0
msgctxt "Choix"
msgid "What was your name again?"
msgstr "Comment tu t'appelais, déjà ?"

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/c-0/7
msgctxt "Ben-hwa"
msgid "Mhmm. Cute."
msgstr "Mhmm. Mignon."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/c-1/7
msgctxt "Ben-hwa"
msgid "Of course you did."
msgstr "Évidemment, c'est exactement ce que tu avais fait."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/c-2/7
msgctxt "Narrator"
msgid "They shake their head and sigh quietly."
msgstr "Iel secoue la tête et soupire doucement."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-0/0
msgctxt "Ben-hwa"
msgid "I'm Ben-hwa... your partner in pleasure."
msgstr "Je suis Ben-hwa... ton complice du plaisir."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-0/11/s/0
msgctxt "Choix"
msgid "I have never used a sex toy in my life."
msgstr "Je n'ai jamais utilisé de sextoy de ma vie."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-0/12/s/0
msgctxt "Choix"
msgid "Oh... you're..."
msgstr "Oh... tu es..."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-0/13/s/0
msgctxt "Choix"
msgid "I don't remember you and I having sex."
msgstr "Je ne me souviens pas qu'on ait couché ensemble, toi et moi."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-0/c-3/13
msgctxt "Ben-hwa"
msgid "An absolute shame."
msgstr "Quel gâchis."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-0/c-4/7
msgctxt "Ben-hwa"
msgid "What many call sex toys, yes."
msgstr "Ce que beaucoup appellent des sextoys, oui."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-0/c-4/15
msgctxt "Ben-hwa"
msgid "I prefer to call myself... your ruin."
msgstr "Je préfère m'appeler... ta perte."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-0/c-5/7
msgctxt "Ben-hwa"
msgid "It's not in the way that you're thinking... but self-pleasure is certainly a form of sex."
msgstr "Ce n'est pas comme tu l'imagines... mais le plaisir en solo est bel et bien une forme de sexe."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-0/c-5/15/0/s/0
msgctxt "Choix"
msgid "I never even opened your box."
msgstr "Je n'ai même jamais ouvert ta boîte."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-0/c-5/15/1/s/0
msgctxt "Choix"
msgid "Oh... I guess I did do that."
msgstr "Oh... je crois bien que si, je l'ai fait."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-1/0
msgctxt "Ben-hwa"
msgid "It's really about time you came to speak to me."
msgstr "Il était grand temps que tu viennes me parler."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-1/8
msgctxt "Ben-hwa"
msgid "Given the way we met... someone less confident than me might really take it personally."
msgstr "Vu la manière dont on a fait connaissance... quelqu'un de moins sûr de soi le prendrait peut-être très mal."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-1/16
msgctxt "Narrator"
msgid "They look at you expectantly, raising an eyebrow."
msgstr "Iel vous regarde d'un air entendu, un sourcil levé."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-1/24
msgctxt "Ben-hwa"
msgid "You <i>do</i> remember the way we met, don't you?"
msgstr "Tu te <i>souviens</i> de la façon dont on a fait connaissance, n'est-ce pas ?"

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-1/32/s/0
msgctxt "Choix"
msgid "I bought you?"
msgstr "Tu as payé pour m'avoir ?"

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-1/33/s/0
msgctxt "Choix"
msgid "Weren't you a gag gift..."
msgstr "Tu n'étais pas un cadeau gag..."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-1/34/s/0
msgctxt "Choix"
msgid "Dating app?"
msgstr "Une appli de rencontres ?"

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-1/c-6/7
msgctxt "Ben-hwa"
msgid "You think you could afford me?"
msgstr "Tu crois que tu aurais les moyens de t'offrir mes services ?"

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-1/c-6/15
msgctxt "Ben-hwa"
msgid "Please, no, that wasn't it."
msgstr "Je t'en prie, non, ce n'était pas ça."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-1/c-7/7
msgctxt "Narrator"
msgid "The words 'gag gift' make their cool expression crack for just a moment."
msgstr "Les mots « cadeau gag » fissurent un instant son masque de froideur."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-1/c-7/15
msgctxt "Ben-hwa"
msgid "Ah yes, there it is."
msgstr "Ah oui, ça y est."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-1/c-8/7
msgctxt "Ben-hwa"
msgid "Don't be silly, darling."
msgstr "Ne sois pas ridicule, mon coeur."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-1/c-8/15
msgctxt "Ben-hwa"
msgid "If only it were that."
msgstr "Si seulement c'était ça."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-2/0
msgctxt "Ben-hwa"
msgid "'Gag gift'."
msgstr "« Cadeau gag. »"

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-2/11
msgctxt "Narrator"
msgid "They look absolutely disgusted."
msgstr "Iel affiche un dégoût absolu."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-2/19
msgctxt "Ben-hwa"
msgid "The only way to strip the word 'gag' of all its appeal."
msgstr "La seule façon de dépouiller le mot « gag » de tout son charme."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-2/27
msgctxt "Ben-hwa"
msgid "Some friend of yours thought they were <i>hilarious</i>."
msgstr "Un de tes amis trouvait ça <i>hilarant</i>."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-2/35
msgctxt "Ben-hwa"
msgid "You moved into this house, and your friend brought you a big box."
msgstr "Tu avais emménagé dans cette maison, et ton ami t'a apporté une grande boîte."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-2/43
msgctxt "Ben-hwa"
msgid "You opened it up to find... what else? A smaller box."
msgstr "Tu l'as ouverte pour découvrir... quoi d'autre ? Une boîte plus petite."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-2/51
msgctxt "Ben-hwa"
msgid "You opened THAT to find... another small box."
msgstr "Tu as ouvert CELLE-LÀ pour trouver... encore une petite boîte."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-2/59
msgctxt "Ben-hwa"
msgid "And so on and so forth. Sooo funny."
msgstr "Et ainsi de suite. Trop drôle."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-2/67
msgctxt "Ben-hwa"
msgid "Eventually you got to the smallest box, and there I was..."
msgstr "Tu as fini par atteindre la plus petite boîte, et là, il y avait moi..."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-2/75
msgctxt "Ben-hwa"
msgid "A bright-eyed virgin, yours for the taking."
msgstr "Une virginité aux yeux brillants, rien que pour toi."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-2/86/b/1
msgctxt "Ben-hwa"
msgid "Who'd have guessed you'd let me lie untouched all these years?"
msgstr "Qui aurait cru que tu me laisserais sans y toucher toutes ces années ?"

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-2/89/b/1
msgctxt "Ben-hwa"
msgid "Who'd have guessed that after showing me the night of my life you'd let me lie untouched for so long after?"
msgstr "Qui aurait cru qu'après m'avoir offert la nuit de ma vie, tu me laisserais sans y toucher aussi longtemps ?"

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-2/92
msgctxt "Ben-hwa"
msgid "But there's still time to rectify that..."
msgstr "Mais il est encore temps d'y remédier..."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-2/100
msgctxt "Ben-hwa"
msgid "After all, you're here... I'm here... and I <i>know</i> you have nothing but time."
msgstr "Après tout, tu es là... je suis là... et je <i>sais</i> que tu as tout ton temps."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-2/114
msgctxt "Ben-hwa"
msgid "So how about it? Me, and you... and mind-bending, earth-shattering pleasure."
msgstr "Alors, qu'en dis-tu ? Toi, moi... et un plaisir à vous retourner le cerveau, à vous faire trembler la terre."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-2/122/s/0
msgctxt "Choix"
msgid "Hell no."
msgstr "Hors de question."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-2/123/s/0
msgctxt "Choix"
msgid "Oh hell yeah."
msgstr "Oh, carrément."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-2/124/s/0
msgctxt "Choix"
msgid "Maybe we could just cuddle and get to know each other instead?"
msgstr "On pourrait peut-être juste se câliner et faire connaissance, plutôt ?"

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-2/c-9/7
msgctxt "Ben-hwa"
msgid "Oh... how boring."
msgstr "Oh... quel ennui."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-2/c-9/15
msgctxt "Ben-hwa"
msgid "Suit yourself... but don't come my way again unless you're ready to have your world rocked."
msgstr "Comme tu voudras... mais ne reviens pas vers moi à moins de vouloir que ton monde soit secoué."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-2/c-10/13
msgctxt "Ben-hwa"
msgid "Mmm... I knew you couldn't stay away much longer."
msgstr "Mmm... Je savais que tu ne pourrais pas rester loin très longtemps."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-2/c-10/21
msgctxt "Ben-hwa"
msgid "Come here..."
msgstr "Viens là..."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-2/c-10/32
msgctxt "Narrator"
msgid "Ben-hwa takes you by the hand, guiding you to lie down on your bed. What happens next is a blur of sensation."
msgstr "Ben-hwa vous prend par la main et vous guide jusqu'à votre lit pour vous allonger. Ce qui suit n'est qu'un flou de sensations."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-2/c-10/40
msgctxt "Narrator"
msgid "Ben-hwa is everywhere at once, taking your hands and showing you just what to do to blow your own mind."
msgstr "Ben-hwa est partout à la fois, prenant vos mains et vous montrant exactement quoi faire pour vous retourner la tête."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-2/c-10/48
msgctxt "Narrator"
msgid "You've never experienced anything like it... and you know you'll never be the same again."
msgstr "Vous n'avez jamais rien connu de tel... et vous savez que plus rien ne sera comme avant."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-2/c-11/7
msgctxt "Ben-hwa"
msgid "Oh. Well..."
msgstr "Oh. Bon..."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-2/c-11/15
msgctxt "Ben-hwa"
msgid "That does sound sweet."
msgstr "Ça, c'est mignon."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter1/0/g-2/c-11/23
msgctxt "Ben-hwa"
msgid "Come here, then."
msgstr "Alors viens là."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter2/0/6
msgctxt "Narrator"
msgid "Ben-hwa is in a graceful split on the ground, bending forward so that their nose touches their knee. They smile when they see you, but they take their sweet time getting up."
msgstr "Ben-hwa est en grand écart gracieux sur le sol, penché en avant, le nez contre le genou. Iel sourit en vous voyant, mais prend tout son temps pour se relever."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter2/0/14
msgctxt "Narrator"
msgid "Perhaps they intend to show off for you."
msgstr "Peut-être compte-t-iel se faire admirer."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter2/0/22/b/1
msgctxt "Ben-hwa"
msgid "Well well well! Surprised you can walk without a limp after all that."
msgstr "Eh bien eh bien eh bien ! Ça m'étonne que tu marches sans boiter après tout ça."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter2/0/25/b/1
msgctxt "Ben-hwa"
msgid "Oh, hello... don't mind me. Just trying to keep limber after all that time in your drawer."
msgstr "Oh, bonjour... ne fais pas attention à moi. J'essaie juste de rester souple après tout ce temps dans ton tiroir."

# Traduction IA – à relire
#: benhwa_sextoys/ben_encounter2/0/28
msgctxt "Ben-hwa"
