#: betty_bed/betty_date_dancing/0/g-0/c-5/31
msgctxt "Betty"
msgid "But really..."
msgstr ""

#: betty_bed/betty_date_dancing/0/g-1/0
msgctxt "Betty"
msgid "Thanks again for tonight."
msgstr ""

#: betty_bed/betty_date_dancing/0/g-1/8
msgctxt "Betty"
msgid "This was truly magical."
msgstr ""

#: betty_bed/betty_date_dancing/0/g-1/16
msgctxt "Narrator"
msgid "You and Betty walk back up to your room hand in hand, the air between you thick with a welcome sort of tension."
msgstr ""

#: betty_bed/betty_date_dancing/0/g-1/27
msgctxt "Narrator"
msgid "You get the feeling that Betty may not be ready for the night to end just yet—she looks at you expectantly, if sweetly."
