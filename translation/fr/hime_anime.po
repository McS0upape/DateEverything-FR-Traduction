# Traduction IA – à relire
#: hime_anime/1
msgctxt "Tag Nom d'objet (MAJUSCULES)"
msgid "ANIME FIGURINE"
msgstr "FIGURINE D'ANIME"

# Traduction IA – à relire
#: hime_anime/Hero_1/0/6
msgctxt "Hero-Hime"
msgid "<i>Oh gosh, I'm late for school!</i>"
msgstr "<i>Oh là là, je suis en retard pour l'école !</i>"

# Traduction IA – à relire
#: hime_anime/Hero_1/0/17
msgctxt "Hero-Hime"
msgid "-is what I would say if I were your typical anime schoolgirl protagonist!"
msgstr "-c'est ce que je dirais si j'étais une héroïne d'anime lycéenne typique !"

# Traduction IA – à relire
#: hime_anime/Hero_1/0/25
msgctxt "Hero-Hime"
msgid "But that's not who I am!"
msgstr "Mais ce n'est pas moi !"

# Traduction IA – à relire
#: hime_anime/Hero_1/0/33
msgctxt "Hero-Hime"
msgid "My name is Hero-hime, a college freshman entering Heart Ace Academy - the center of all things <i><i>tennis</i></i>!"
msgstr "Je m'appelle Hero-hime, étudiante de première année à l'Académie Heart Ace, le centre de tout ce qui touche au <i><i>tennis</i></i> !"

# Traduction IA – à relire
#: hime_anime/Hero_1/0/47
msgctxt "Hero-Hime"
msgid "Tennis athletes from all over come to Heart Ace to train and challenge each other to be the <i><i>Tennistar</i></i>!!"
msgstr "Des athlètes de tennis du monde entier viennent à Heart Ace pour s'entraîner et s'affronter afin de devenir la <i><i>Tennistar</i></i> !!"

# Traduction IA – à relire
#: hime_anime/Hero_1/0/55
msgctxt "Hero-Hime"
msgid "Right, Nekoboru?"
msgstr "Pas vrai, Nekoboru ?"

# Traduction IA – à relire
#: hime_anime/Hero_1/0/69 hime_anime/Hero_1/0/c-1/7 hime_anime/Hero_Meet/0/c-2/21 hime_anime/Hero_Meet/0/c-2/37 hime_anime/Hero_Meet/0/c-2/45/c-0/15 hime_anime/Hero_Meet/0/c-2/45/c-1/15 hime_anime/Hero_1_Cont/0/g-3/c-11/67 hime_anime/Hero_1_Cont/0/g-4/16 hime_anime/Hero_2/0/17 hime_anime/Hero_2/0/c-2/7 hime_anime/Hero_2/0/g-4/c-11/15/g-0/24 hime_anime/Hero_2/0/g-4/c-12/39 hime_anime/Hero_2/0/g-5/c-13/7 hime_anime/Hero_Tennis_1_Cont/0/g-0/96 hime_anime/yosh/0/g-0/8 hime_anime/Hero_3/0/g-1/60 hime_anime/Nekoboru_1/0/0 hime_anime/Nekoboru_1/0/g-6/c-18/15 hime_anime/Nekoboru_1/0/g-8/51 hime_anime/Nekoboru_1/0/g-9/14/19 hime_anime/Hero_5/0/g-9/c-24/19/c-0/39/c-0/26 hime_anime/Hero_Friendship/0/g-0/35 hime_anime/hime_realized/0/g-0/19 hime_anime/hime_realized/0/g-1/0
msgctxt "Nekoboru"
msgid "Nekoboru."
msgstr "Nekoboru."

# Traduction IA – à relire
#: hime_anime/Hero_1/0/77/s/0
msgctxt "Choix"
msgid "That was a lot."
msgstr "Ça fait beaucoup."

# Traduction IA – à relire
#: hime_anime/Hero_1/0/78/s/0
msgctxt "Choix"
msgid "Is that a floating tennis-ball cat?"
msgstr "C'est un chat-balle-de-tennis qui flotte ?"

# Traduction IA – à relire
#: hime_anime/Hero_1/0/g-0/0
msgctxt "Hero-Hime"
msgid "Oh, I'm sorry! Here, let me start over."
msgstr "Oh, pardon ! Tiens, je recommence."

# Traduction IA – à relire
#: hime_anime/Hero_1/0/g-0/8
msgctxt "Hero-Hime"
msgid "Hi, I'm Hero-hime and this is my tennis-ball cat, Nekoboru."
msgstr "Salut, je suis Hero-hime et voici mon chat-balle-de-tennis, Nekoboru."

# Traduction IA – à relire
#: hime_anime/Hero_1/0/g-0/16 hime_anime/Hero_1/0/g-0/c-2/15
msgctxt "Hero-Hime"
msgid "I'm happy to answer any questions you have!"
msgstr "Je réponds avec plaisir à toutes tes questions !"

# Traduction IA – à relire
#: hime_anime/Hero_1/0/g-0/24/s/0
msgctxt "Choix"
msgid "I have a few."
msgstr "J'en ai quelques-unes."

# Traduction IA – à relire
#: hime_anime/Hero_1/0/g-0/25/s/0
msgctxt "Choix"
msgid "Don't think so. All seems pretty normal to me!"
msgstr "Je crois pas. Tout me paraît plutôt normal !"

# Traduction IA – à relire
#: hime_anime/Hero_1/0/g-0/c-2/7
msgctxt "Hero-Hime"
msgid "Go for it!"
msgstr "Je t'écoute !"

# Traduction IA – à relire
#: hime_anime/Hero_1/0/g-0/c-3/7
msgctxt "Hero-Hime"
msgid "Hahah! You're silly."
msgstr "Hahaha ! Tu es drôle !"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/0/b/1
msgctxt "Hero-Hime"
msgid "What can I fill you in on?"
msgstr "Qu'est-ce que je peux t'expliquer ?"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/1/b/1
msgctxt "Hero-Hime"
msgid "Anything else?"
msgstr "Autre chose ?"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/2/b/1
msgctxt "Hero-Hime"
msgid "Hope these are helping!"
msgstr "J'espère que ça t'aide !"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/7/s/0
msgctxt "Choix"
msgid "What anime are you from?"
msgstr "Tu viens de quel anime ?"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/8/s/0
msgctxt "Choix"
msgid "What's a \"Tennistar\"?"
msgstr "C'est quoi, une « Tennistar » ?"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/9/s/0
msgctxt "Choix"
msgid "Nekoboru?"
msgstr "Nekoboru ?"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/10/s/0
msgctxt "Choix"
msgid "I'm good! I get it."
msgstr "Ça ira ! J'ai compris."

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-0/13
msgctxt "Hero-Hime"
msgid "<i>Starlight Overheaders!! The Anime</i> - a magical-girl/sports anime with a single cour of twelve episodes!"
msgstr "<i>Starlight Overheaders!! The Anime</i> : un anime de magical girl et de sport, en un seul cour de douze épisodes !"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-0/21
msgctxt "Hero-Hime"
msgid "Since most popular sports anime rely on teamwork and the power of friendship..."
msgstr "Comme la plupart des animes de sport célèbres reposent sur l'esprit d'équipe et la puissance de l'amitié..."

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-0/29
msgctxt "Hero-Hime"
msgid "The production committee felt like tennis had an unfair disadvantage of being depicted."
msgstr "Le comité de production trouvait que le tennis était injustement désavantagé à l'écran."

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-0/37
msgctxt "Hero-Hime"
msgid "The idea of a doubles team was considered, but the creator decided on adding the magical-girl flair!"
msgstr "On a envisagé une équipe de double, mais le créateur a préféré ajouter le côté magical girl !"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-0/45/0/s/0
msgctxt "Choix"
msgid "But the animation wasn't great from what I remember."
msgstr "Mais l'animation n'était pas terrible, si je me souviens bien."

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-0/45/1/s/0
msgctxt "Choix"
msgid "I love the magical girl trope!"
msgstr "J'adore le trope de la magical girl !"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-0/45/c-0/7
msgctxt "Hero-Hime"
msgid "Unfortunately, it wasn't very <i>sakuga</i>."
msgstr "Malheureusement, ce n'était pas très <i>sakuga</i>."

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-0/45/c-0/15
msgctxt "Hero-Hime"
msgid "But I'm surprised you remember!"
msgstr "Mais je suis surprise que tu t'en souviennes !"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-0/45/c-1/7
msgctxt "Hero-Hime"
msgid "Me too! Girl power forever!"
msgstr "Moi aussi ! Girl power pour toujours !"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-0/45/c-1/15
msgctxt "Hero-Hime"
msgid "But don't forget, those shows are for <i>everyone</i>!"
msgstr "Mais n'oublie pas, ces séries sont pour <i>tout le monde</i> !"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-0/45/g-0/0/0/s/0
msgctxt "Choix"
msgid "I'm kinda surprised that you <i>know</i> that you're from a show..."
msgstr "Je suis un peu {{surpris|surprise|surpris·e}} que tu <i>saches</i> que tu viens d'une série..."

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-0/45/g-0/0/1/s/0
msgctxt "Choix"
msgid "You're a really cool gift."
msgstr "Tu es un super cadeau."

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-0/45/g-0/0/c-0/7
msgctxt "Hero-Hime"
msgid "Well, I am an anime figure after all!"
msgstr "Eh bien, je suis une figurine d'anime, après tout !"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-0/45/g-0/0/c-0/15
msgctxt "Hero-Hime"
msgid "We come with all the lore necessary - all you have to do is awaken our essences!"
msgstr "On vient avec tout le lore nécessaire : il suffit d'éveiller notre essence !"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-0/45/g-0/0/c-1/7
msgctxt "Hero-Hime"
msgid "<w>GASP</w> You think I'm a gift to this world?! SUPER-SET!"
msgstr "<w>OH</w> Tu trouves que je suis un cadeau pour ce monde ?! SUPER-SET !"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-1/13
msgctxt "Hero-Hime"
msgid "The Tennistar is the greatest tennis player alive and the hero of Heart Ace Academy!"
msgstr "La Tennistar est la meilleure joueuse de tennis vivante et l'héroïne de l'Académie Heart Ace !"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-1/21/0/s/0
msgctxt "Choix"
msgid "How are they a hero?"
msgstr "En quoi c'est une héroïne ?"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-1/21/1/s/0
msgctxt "Choix"
msgid "What's the Heart Ace Academy?"
msgstr "C'est quoi, l'Académie Heart Ace ?"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-1/21/c-0/7
msgctxt "Hero-Hime"
msgid "They're a shining pillar to athletes around the world!"
msgstr "C'est un phare pour les athlètes du monde entier !"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-1/21/c-0/15
msgctxt "Hero-Hime"
msgid "They also fight crime in between their tennis games!"
msgstr "Elle combat aussi le crime entre deux matchs !"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-1/21/c-1/7
msgctxt "Hero-Hime"
msgid "The greatest tennis training school in the world!"
msgstr "La meilleure école d'entraînement au tennis du monde !"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-1/21/c-1/15
msgctxt "Hero-Hime"
msgid "It produces the greatest <i>players</i>. And crime-fights!"
msgstr "Elle forme les meilleurs <i>joueurs</i>. Et les meilleurs justiciers !"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-1/21/g-0/0/0/s/0
msgctxt "Choix"
msgid "Sounds busy."
msgstr "Ça a l'air chargé."

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-1/21/g-0/0/1/s/0
msgctxt "Choix"
msgid "Haha. What do you do, whack a 120mph serve at the bad guys?"
msgstr "Haha. Quoi, tu envoies un service à 200 km/h dans la figure des méchants ?"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-1/21/g-0/0/c-0/7
msgctxt "Hero-Hime"
msgid "You have to be if you want to be a symbol of peace and inspiration to future tennis players!"
msgstr "Il le faut si on veut être un symbole de paix et une source d'inspiration pour les futurs joueurs de tennis !"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-1/21/g-0/0/c-0/15
msgctxt "Hero-Hime"
msgid "That's why I have to keep training!"
msgstr "C'est pour ça que je dois continuer à m'entraîner !"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-1/21/g-0/0/c-1/7
msgctxt "Hero-Hime"
msgid "How did you know?! I've exploded a few bad guy orbital sockets in my time."
msgstr "Comment tu as deviné ?! J'ai fait exploser quelques orbites de méchants dans ma carrière."

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-1/21/g-0/0/c-1/15
msgctxt "Nekoboru"
msgid "Nekoboru!!!"
msgstr "Nekoboru !!!"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-1/21/g-0/0/g-0/0/0/s/0
msgctxt "Choix"
msgid "Are you good at tennis?"
msgstr "Tu es forte au tennis ?"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-1/21/g-0/0/g-0/0/1/s/0
msgctxt "Choix"
msgid "Are you good at fighting crime?"
msgstr "Tu es forte pour combattre le crime ?"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-1/21/g-0/0/g-0/0/c-0/7
msgctxt "Hero-Hime"
msgid "Hehe, wouldn't you like to know?"
msgstr "Hihi, tu aimerais bien le savoir, hein ?"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-1/21/g-0/0/g-0/0/c-0/15
msgctxt "Hero-Hime"
msgid "The previous Tennistar mysteriously disappeared, so everyone has been training for their spot."
msgstr "La précédente Tennistar a mystérieusement disparu, alors tout le monde s'entraîne pour prendre sa place."

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-1/21/g-0/0/g-0/0/c-0/23
msgctxt "Hero-Hime"
msgid "Heh, but they won't beat me!"
msgstr "Hé, mais ils ne me battront pas !"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-1/21/g-0/0/g-0/0/c-1/7
msgctxt "Hero-Hime"
msgid "Try something funny and find out... Teehee!"
msgstr "Tente un truc louche et tu verras... Hihi !"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-1/21/g-0/0/g-0/0/c-1/15
msgctxt "Hero-Hime"
msgid "Just Kidding!!!"
msgstr "Je rigole !!!"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-1/21/g-0/0/g-0/0/c-1/23
msgctxt "Hero-Hime"
msgid "Or am I."
msgstr "Ou pas."

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-1/21/g-0/0/g-0/0/c-1/31
msgctxt "Hero-Hime"
msgid "Anyway, the previous Tennistar mysteriously disappeared, so everyone has been training for their spot."
msgstr "Bref, la précédente Tennistar a mystérieusement disparu, alors tout le monde s'entraîne pour prendre sa place."

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-1/21/g-0/0/g-0/0/c-1/39
msgctxt "Hero-Hime"
msgid "But they won't beat me!"
msgstr "Mais ils ne me battront pas !"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-2/13
msgctxt "Hero-Hime"
msgid "Yup! Nekoboru!"
msgstr "Ouais ! Nekoboru !"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-2/29
msgctxt "Hero-Hime"
msgid "Nekoboru~!!"
msgstr "Nekoboru~ !!"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-2/45/0/s/0 hime_anime/Hero_Tennis_1_Cont/0/g-3/8/s/0
msgctxt "Choix"
msgid "Never mind."
msgstr "Laisse tomber."

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-2/45/1/s/0
msgctxt "Choix"
msgid "I'm confused."
msgstr "Je suis {{perdu|perdue|perdu·e}}."

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-2/45/c-0/7 hime_anime/Hero_Meet/0/c-2/45/c-1/7
msgctxt "Hero-Hime"
msgid "Okay!"
msgstr "Okay !"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-3/7/b/1
msgctxt "Hero-Hime"
msgid "Without asking a single question?? You're not curious??"
msgstr "Sans poser la moindre question ?? Tu n'es pas curieux ??"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-3/7/b/9
msgctxt "Hero-Hime"
msgid "Well then... let's get to training!"
msgstr "Eh bien... passons à l'entraînement !"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-3/8/b/1
msgctxt "Hero-Hime"
msgid "Phew! Answering these questions has got me hungry for some tennis!"
msgstr "Ouf ! Répondre à toutes ces questions m'a donné faim de tennis !"

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-3/8/b/9
msgctxt "Hero-Hime"
msgid "But I need a tennis partner to help me get to the top."
msgstr "Mais il me faut un partenaire d'entraînement pour atteindre le sommet."

# Traduction IA – à relire
#: hime_anime/Hero_Meet/0/c-3/8/b/17
msgctxt "Hero-Hime"
msgid "Say, why don't you train with me?"
msgstr "Dis, et si tu t'entraînais avec moi ?"

# Traduction IA – à relire
#: hime_anime/Hero_1_Cont/0/0/s/0
msgctxt "Choix"
msgid "Uh sure?"
msgstr "Euh, ok ?"

# Traduction IA – à relire
#: hime_anime/Hero_1_Cont/0/1/s/0
msgctxt "Choix"
msgid "I have a feeling I've got no choice..."
msgstr "J'ai comme l'impression que je n'ai pas le choix..."

# Traduction IA – à relire
#: hime_anime/Hero_1_Cont/0/c-0/7
msgctxt "Hero-Hime"
msgid "Awesome! You're a lifesaver!"
msgstr "Génial ! Tu me sauves la vie !"

# Traduction IA – à relire
#: hime_anime/Hero_1_Cont/0/c-1/7
msgctxt "Hero-Hime"
msgid "You're super good at feeling things!"
msgstr "Tu as un sixième sens du tonnerre !"

# Traduction IA – à relire
#: hime_anime/Hero_1_Cont/0/g-0/3 hime_anime/Hero_Hate/0/g-1/8 hime_anime/Hero_Friendship/0/g-1/8
msgctxt "Hero-Hime"
msgid "Battle court activate!"
msgstr "Court de combat, activation !"

# Traduction IA – à relire
#: hime_anime/Hero_1_Cont/0/g-0/11/s/0
msgctxt "Choix"
msgid "Battle court?"
msgstr "Court de combat ?"

# Traduction IA – à relire
#: hime_anime/Hero_1_Cont/0/g-0/12/s/0
msgctxt "Choix"
msgid "Am I going to die?"
msgstr "Je vais mourir ?"

# Traduction IA – à relire
#: hime_anime/Hero_1_Cont/0/g-0/c-2/7
msgctxt "Hero-Hime"
msgid "Battle court!"
msgstr "Court de combat !"

# Traduction IA – à relire
#: hime_anime/Hero_1_Cont/0/g-0/c-3/7
msgctxt "Hero-Hime"
msgid "No, but you might get served!"
msgstr "Non, mais tu risques de te faire servir !"

# Traduction IA – à relire
#: hime_anime/Hero_1_Cont/0/g-0/c-3/15
msgctxt "Hero-Hime"
msgid "Okay, here it comes!"
msgstr "Allez, ça arrive !"

# Traduction IA – à relire
#: hime_anime/Hero_1_Cont/0/g-1/0
msgctxt "Hero-Hime"
msgid "Hope you're ready!"
msgstr "J'espère que tu es prêt !"

# Traduction IA – à relire
#: hime_anime/Hero_1_Cont/0/g-1/8/s/0
msgctxt "Choix"
msgid "Am I in the anime now?"
msgstr "Je suis dans l'anime, maintenant ?"

# Traduction IA – à relire
#: hime_anime/Hero_1_Cont/0/g-1/9/s/0
msgctxt "Choix"
msgid "How did this racket get in my hand?!"
msgstr "Comment cette raquette a atterri dans ma main ?!"

# Traduction IA – à relire
#: hime_anime/Hero_1_Cont/0/g-1/10/s/0
msgctxt "Choix"
msgid "Let's do this!"
msgstr "Allons-y !"

# Traduction IA – à relire
#: hime_anime/Hero_1_Cont/0/g-2/0 hime_anime/Hero_Tennis_2/0/9/11/c-2/23
msgctxt "Hero-Hime"
msgid "<i>Galaxy Arts: Starlight Smash!</i>"
msgstr "<i>Arts Galactiques : Smash Étoilé !</i>"

# Traduction IA – à relire
#: hime_anime/Hero_1_Cont/0/g-2/11
msgctxt "Hero-Hime"
msgid "How are you going to return that?"
msgstr "Comment vas-tu renvoyer ça ?"

# Traduction IA – à relire
#: hime_anime/Hero_1_Cont/0/g-2/19/s/0
msgctxt "Choix"
msgid "<i>Run towards it with forehand.</i>"
msgstr "<i>Courir dessus en coup droit.</i>"

# Traduction IA – à relire
#: hime_anime/Hero_1_Cont/0/g-2/20/s/0
msgctxt "Choix"
msgid "<i>Run towards it with backhand.</i>"
msgstr "<i>Courir dessus en revers.</i>"

# Traduction IA – à relire
