# Traduction IA – à relire
#: connie_console/1
msgctxt "Tag Nom d'objet (MAJUSCULES)"
msgid "VIDEO GAME CONSOLE"
msgstr "CONSOLE DE JEUX VIDÉO"

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/6
msgctxt "Narrator"
msgid "The game console turns on."
msgstr "La console de jeux s'allume."

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/11
msgctxt "Narrator"
msgid "Team 17"
msgstr "Team 17"

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/16
msgctxt "Narrator"
msgid "Sassy Chap Games"
msgstr "Sassy Chap Games"

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/21
msgctxt "Narrator"
msgid "Moonsurgents: Resurgence"
msgstr "Moonsurgents: Resurgence"

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/32/b/1
msgctxt "Narrator"
msgid "This has to be the most immersive video game you've ever played. Your in-game companion is an absolute stunner, but she doesn't leave you much time to take in the sight of her."
msgstr "Ce doit être le jeu vidéo le plus immersif auquel vous ayez jamais joué. Votre compagne virtuelle est une beauté renversante, mais elle ne vous laisse guère le temps de la contempler."

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/32/b/9
msgctxt "Narrator"
msgid "She waves you forward, looking around as though she expects an attack to come at any moment."
msgstr "Elle vous fait signe d'avancer, scrutant les alentours comme si une attaque pouvait surgir à tout instant."

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/35/b/1
msgctxt "Narrator"
msgid "Here you are once again-back where you started, with your beautiful companion urging you to make a decision."
msgstr "Vous revoici au point de départ, votre sublime compagne vous pressant de prendre une décision."

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/35/b/9
msgctxt "Narrator"
msgid "She looks at you just the same way she did the last time... with a strange familiarity, but still not quite recognizing who you truly are."
msgstr "Elle vous regarde exactement comme la dernière fois... avec une étrange familiarité, sans toutefois reconnaître tout à fait qui vous êtes vraiment."

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/38
msgctxt "Luna"
msgid "You're here! I didn't think you'd make it back."
msgstr "Tu es là ! Je pensais pas que tu reviendrais."

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/52
msgctxt "Luna"
msgid "Which way do you want to go?"
msgstr "Par où tu veux aller ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/60/s/0
msgctxt "Choix"
msgid "Wait - we've definitely met. Don't you remember?"
msgstr "Attends, on s'est déjà rencontrés. Tu t'en souviens pas ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/61/s/0 connie_console/connie_encounter_three/0/g-0/16/s/0
msgctxt "Choix"
msgid "Lingonberries!"
msgstr "Airelles !"

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/62/s/0
msgctxt "Choix"
msgid "Uh... what?"
msgstr "Euh... quoi ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/63/s/0
msgctxt "Choix"
msgid "You're being very forward... do you think we've met or something?"
msgstr "Tu y vas fort... tu crois qu'on se connaît ou quoi ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/64/s/0 connie_console/connie_love_return/0/33/s/0 connie_console/connie_friend_return/0/33/s/0 connie_console/connie_hate_return/0/26/s/0
msgctxt "Choix"
msgid "Telly said Davi might have come this way?"
msgstr "Telly a dit que Davi serait peut-être passé par là ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/c-2/7
msgctxt "Luna"
msgid "Which way do you want to go? They're coming!"
msgstr "Par où tu veux aller ? Ils arrivent !"

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/c-3/7
msgctxt "Luna"
msgid "Of course we've met! We're in the middle of a huge battle for Regolith on Colony 16!"
msgstr "Évidemment qu'on s'est rencontrés ! On est en pleine bataille pour le Régolithe sur la Colonie 16 !"

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/c-3/18/0/s/0
msgctxt "Choix"
msgid "Regolith?"
msgstr "Le Régolithe ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/c-3/18/1/s/0
msgctxt "Choix"
msgid "Where?"
msgstr "Où ça ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/c-3/18/2/s/0
msgctxt "Choix"
msgid "Yeah, let's battle!"
msgstr "Ouais, battons-nous !"

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/c-3/18/c-0/7
msgctxt "Luna"
msgid "The prime resource of our times? What... have you been living under a drock?"
msgstr "La ressource essentielle de notre époque ? Quoi... t'as vécu sous un drok ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/c-3/18/c-1/7
msgctxt "Luna"
msgid "The moon, goolie! We were born here."
msgstr "La lune, pote ! C'est ici qu'on est nés."

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/c-3/18/c-1/15
msgctxt "Luna"
msgid "You been doing too much scruzz... I swear."
msgstr "Tu abuses du scruzz, je te jure."

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/c-3/18/c-2/7
msgctxt "Luna"
msgid "Phew, had me scared for a second yail."
msgstr "Ouf, j'ai eu peur une seconde, pote."

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/c-4/7 connie_console/connie_love_return/0/c-3/7 connie_console/connie_friend_return/0/c-3/7 connie_console/connie_hate_return/0/c-2/7
msgctxt "Narrator"
msgid "She ignores you entirely."
msgstr "Elle vous ignore complètement."

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/fps/0
msgctxt "Luna"
msgid "You just equipped my zower rifle, which means that you're thinking of unloading a whole lotta zacre charges on these scroufs out here."
msgstr "Tu viens d'équiper mon fusil zower, donc je suppose que tu comptes balancer plein de charges de zacre sur ces scroufs."

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/fps/8
msgctxt "Luna"
msgid "What're we gonna do?"
msgstr "On fait quoi ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/fps/16/s/0
msgctxt "Choix"
msgid "Unload a whole lotta zacre charges on the scroufs."
msgstr "Balancer plein de charges de zacre sur les scroufs."

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/fps/17/s/0
msgctxt "Choix"
msgid "Talk to the scroufs."
msgstr "Parler aux scroufs."

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/fps/18/s/0
msgctxt "Choix"
msgid "Run away from the scroufs."
msgstr "Fuir les scroufs."

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/fps/19/s/0
msgctxt "Choix"
msgid "What the fuck are scroufs?"
msgstr "C'est quoi, putain, ces scroufs ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/fps/c-5/7
msgctxt "Luna"
msgid "Bizorch!"
msgstr "Bizorch !"

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/fps/c-5/21 connie_console/connie_encounter_start/0/fps/c-6/24 connie_console/connie_encounter_start/0/fps/c-7/21 connie_console/connie_encounter_start/0/fps/c-8/35
msgctxt "Scrouf"
msgid "Auugh! GRaaaaah!"
msgstr "Auugh ! GRaaaaah !"

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/fps/c-5/35
msgctxt "Luna"
msgid "EAT ZACRE, WORM!"
msgstr "BOUFFE DU ZACRE, VERMINE !"

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/fps/c-5/49
msgctxt "Scrouf"
msgid "Ack! Grrrr... ...eh."
msgstr "Ack ! Grrrr... ...bof."

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/fps/c-6/7
msgctxt "Luna"
msgid "Talk to them? Sure... I guess I'll just put my weapon down and wait for the bullets to whizz through my skull."
msgstr "Leur parler ? Bien sûr... je vais juste poser mon arme et attendre que les balles me sifflent dans le crâne."

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/fps/c-6/38
msgctxt "Luna"
msgid "Damn. All this yapping and now we're overrun. I'm shooting!"
msgstr "Merde. À force de papoter, on est submergés. Je tire !"

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/fps/c-7/7
msgctxt "Luna"
msgid "You can't just run away! Those yails are relentless!"
msgstr "Tu peux pas juste fuir ! Ces ordures sont increvables !"

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/fps/c-7/35 connie_console/connie_encounter_start/0/fps/c-8/49
msgctxt "Luna"
msgid "Damn. All that yapping and now we're overrun. I'm shooting!"
msgstr "Merde. À force de papoter, on est submergés. Je tire !"

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/fps/c-8/7
msgctxt "Luna"
msgid "Scroufs? They're Upholders spliced in genetically from downside Novaya Moskva. Tough little freedles."
msgstr "Les scroufs ? Des Gardiens modifiés génétiquement, venus d'en bas, de Novaya Moskva. De sacrés petits freedles."

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/fps/c-8/21
msgctxt "Luna"
msgid "Their claws can turn into sprayer guns - real new tech that gives me the greens."
msgstr "Leurs griffes se transforment en pulvérisateurs, une techno toute neuve qui me file les glandes."

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/g-0/0
msgctxt "Luna"
msgid "88 charges later, that's a whole lotta scrouf carcasses. Nice haul!"
msgstr "88 charges plus tard, ça fait un paquet de carcasses de scroufs. Beau butin !"

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/g-0/11
msgctxt "Luna"
msgid "That outta teach Selene and her goons."
msgstr "Ça devrait servir de leçon à Selene et à sa bande."

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/g-0/19
msgctxt "Luna"
msgid "We're near the compound of the Upholders."
msgstr "On approche du complexe des Gardiens."

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/g-0/27
msgctxt "Luna"
msgid "They'll have Assassin Class Upholders as well as Surveillance Class."
msgstr "Il y aura des Gardiens de classe Assassin, et de classe Surveillance aussi."

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/g-0/35
msgctxt "Luna"
msgid "We'll have to sneak our way in, then probably start dispatching them with utmost violence. You up for it?"
msgstr "On va devoir s'infiltrer, puis probablement les éliminer avec la plus extrême violence. T'es partant ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/g-0/43/0/s/0
msgctxt "Choix"
msgid "Violence is wrong."
msgstr "La violence, c'est mal."

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/g-0/43/1/s/0
msgctxt "Choix"
msgid "Let's go - we got the right equipment?"
msgstr "Allons-y, on a le bon équipement ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/g-0/43/2/s/0
msgctxt "Choix"
msgid "Is this a stealth section or something?"
msgstr "C'est une séquence d'infiltration, ou quoi ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/g-0/43/c-9/7
msgctxt "Luna"
msgid "Ha! You don't want violence, go play a relate-sim on your greepad."
msgstr "Ha ! Tu veux pas de violence ? Va jouer à un simulateur de relations sur ton greepad."

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/g-0/43/c-9/15
msgctxt "Luna"
msgid "What we've got ahead of us is lots more shootin' and killin'."
msgstr "Ce qui nous attend, c'est encore plus de tirs et de morts."

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/g-0/43/c-9/23/0/s/0
msgctxt "Choix"
msgid "Okay... carry on with the killin'."
msgstr "D'accord... continue de tuer."

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/g-0/43/c-9/23/1/s/0
msgctxt "Choix"
msgid "Not my style. But I can change you. Trust me."
msgstr "Pas mon style. Mais je peux te changer. Fais-moi confiance."

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/g-0/43/c-9/23/c-1/7 connie_console/recipe_find/0/c-0/23/c-0/34/c-2/15
msgctxt "Luna"
msgid "Sure."
msgstr "Si tu le dis."

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/g-0/43/c-10/7
msgctxt "Luna"
msgid "You're right! I'll put on my +5 shadowsuit - it'll help us get through the sensors in there."
msgstr "T'as raison ! Je vais enfiler ma combinaison d'ombre +5, elle nous aidera à passer les capteurs là-dedans."

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/g-0/43/c-10/18
msgctxt "Luna"
msgid "Upholder tech is nasty."
msgstr "La techno des Gardiens, c'est du vilain."

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/g-0/43/c-11/7
msgctxt "Luna"
msgid "Yeah! Sneaky stuff!"
msgstr "Ouais ! Du sournois !"

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/g-2/0
msgctxt "Luna"
msgid "I've found an entrance on the darkside - should be an easy way in if we just follow the marker on the map."
msgstr "J'ai trouvé une entrée côté obscur, ça devrait être facile d'entrer si on suit le marqueur sur la carte."

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/g-2/8/s/0
msgctxt "Choix"
msgid "Sounds good - following!"
msgstr "Ça marche, je te suis !"

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/g-2/9/s/0
msgctxt "Choix"
msgid "Where are we going?"
msgstr "On va où ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/g-2/c-13/7
msgctxt "Luna"
msgid "To defeat the final boss!"
msgstr "Vaincre le boss final !"

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/g-2/c-13/15/0/s/0
msgctxt "Choix"
msgid "Who is that?"
msgstr "C'est qui ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/g-2/c-13/15/1/s/0
msgctxt "Choix"
msgid "Death to the final boss!"
msgstr "Mort au boss final !"

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/g-2/c-13/15/c-0/7
msgctxt "Luna"
msgid "Selene. She's the worst."
msgstr "Selene. La pire."

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/g-2/c-13/15/c-0/18
msgctxt "Luna"
msgid "She and the Upholders turned Colony 16 into a Regolith extraction facility that's gotten the local wildlife real annoyed."
msgstr "Elle et les Gardiens ont transformé la Colonie 16 en site d'extraction de Régolithe, ce qui a bien énervé la faune locale."

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/g-2/c-13/15/c-0/26
msgctxt "Luna"
msgid "Which is a problem when the local wildlife is 150 ft long and made of scales."
msgstr "Ce qui pose problème quand la faune locale mesure 45 mètres de long et est couverte d'écailles."

# Traduction IA – à relire
#: connie_console/connie_encounter_start/0/g-2/c-13/15/c-1/7
msgctxt "Luna"
msgid "Woohoo! Death!"
msgstr "Youhou ! La mort !"

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/0
msgctxt "Narrator"
msgid "After a short walk you find yourself standing in front of a bullet-ridden metal door, way out in the middle of the cold grey landscape."
msgstr "Après une courte marche, vous vous retrouvez devant une porte métallique criblée de balles, au beau milieu d'un paysage froid et gris."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/8
msgctxt "Luna"
msgid "This is the entrance I've never seen anyone use."
msgstr "C'est l'entrée que je n'ai jamais vu personne utiliser."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/16
msgctxt "Luna"
msgid "With my trockpicking skills - we'll have this open in no time."
msgstr "Avec mes talents de crochetage, on l'ouvre en deux temps trois mouvements."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/24/s/0
msgctxt "Choix"
msgid "Luna, tell me more about yourself."
msgstr "Luna, parle-moi de toi."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/25/s/0
msgctxt "Choix"
msgid "Let's get it done."
msgstr "Finissons-en."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/c-0/7
msgctxt "Luna"
msgid "Me? I'm your average member of the Resistance."
msgstr "Moi ? Je suis une résistante ordinaire."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/c-0/15
msgctxt "Luna"
msgid "Maybe... above average."
msgstr "Enfin... un peu au-dessus de la moyenne."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/c-0/23
msgctxt "Luna"
msgid "We fight against the Upholders who are determined to do everything in their power to druck everything up here on my Homeworld."
msgstr "On se bat contre les Gardiens, qui sont décidés à tout faire pour druck tout ici, sur ma planète natale."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/c-0/31/0/s/0
msgctxt "Choix"
msgid "And who am I to you?"
msgstr "Et moi, je suis qui pour toi ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/c-0/31/1/s/0
msgctxt "Choix"
msgid "Are we sure the Upholders are the bad guys?"
msgstr "On est sûrs que les Gardiens sont les méchants ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/c-0/31/c-0/7
msgctxt "Luna"
msgid "You? I always thought of you as a companion. Someone who followed me around and gave me advice."
msgstr "Toi ? Pour moi, t'es une sorte d'acolyte : quelqu'un qui me suit partout et me donne des conseils."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/c-0/31/c-0/15
msgctxt "Luna"
msgid "Cute, but expendable."
msgstr "Adorable, mais jetable."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/c-0/31/c-1/7
msgctxt "Luna"
msgid "Positive about that. The surroundings might be grey, but what's going on here is black and white."
msgstr "Certaine. Le décor est peut-être gris, mais ce qui se passe ici est tout noir ou tout blanc."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-0/0
msgctxt "Narrator"
msgid "Luna picks the lock, allowing you to peer inside. You can see hallways filled with shining electronic doors off into the distance."
msgstr "Luna crochète la serrure, ce qui vous permet de jeter un oeil à l'intérieur. Vous apercevez des couloirs remplis de portes électroniques scintillantes qui s'étirent au loin."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-0/8
msgctxt "Luna"
msgid "Here we go - Upholder central inside. I'm seeing Grunt Class Upholders, who shouldn't be too bad."
msgstr "C'est parti : le coeur des Gardiens, juste là. Je vois des Gardiens de classe Sbire, qui ne devraient pas poser trop de problèmes."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-0/16
msgctxt "Luna"
msgid "But there will be Surveillance Class too, which can sound the alarm."
msgstr "Mais il y aura aussi de la classe Surveillance, qui peut donner l'alerte."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-0/24/s/0
msgctxt "Choix"
msgid "There will be an Assassin Class Upholder right around the first corridor we pass."
msgstr "Il y aura un Gardien de classe Assassin juste après le premier couloir."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-0/25/s/0
msgctxt "Choix"
msgid "This doesn't ever go great for us."
msgstr "Ça ne se passe jamais bien pour nous."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-0/26/s/0
msgctxt "Choix"
msgid "Sounds dangerous..."
msgstr "Ça a l'air dangereux..."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-0/27/s/0
msgctxt "Choix"
msgid "Put on your xeno-goggles!"
msgstr "Mets tes xéno-lunettes !"

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-0/c-2/7
msgctxt "Luna"
msgid "Hm... just knowing that isn't enough to help. They've got ultra-tech that renders them invisible to all senses."
msgstr "Hm... le savoir ne suffit pas. Ils ont de l'ultra-techno qui les rend invisibles pour tous les sens."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-0/c-2/15
msgctxt "Luna"
msgid "Kraa... Can't believe that's our fate."
msgstr "Kraa... Impossible de croire que c'est notre destin."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-0/c-2/23/0/s/0
msgctxt "Choix"
msgid "So it is..."
msgstr "Eh oui..."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-0/c-2/23/1/s/0
msgctxt "Choix"
msgid "Why don't you put on your xeno-goggles?"
msgstr "Pourquoi tu mets pas tes xéno-lunettes ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-0/c-2/23/c-1/11
msgctxt "Luna"
msgid "And leave myself open to getting killed?"
msgstr "Et me laisser à découvert pour me faire tuer ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-0/c-2/23/c-1/19
msgctxt "Luna"
msgid "That tech is impressive, but not combat-ready."
msgstr "Cette techno est impressionnante, mais pas prête pour le combat."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-0/c-3/7
msgctxt "Luna"
msgid "That's okay - this time will be different..."
msgstr "C'est pas grave, cette fois sera différente..."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-0/c-3/15
msgctxt "Luna"
msgid "I'll simply use <i>more</i> bullets."
msgstr "Je vais simplement utiliser <i>plus</i> de balles."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-0/c-4/7
msgctxt "Luna"
msgid "It is. Very."
msgstr "Oui. Tout à fait."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-0/c-5/7 connie_console/connie_quest_true_stealth/0/g-0/c-3/63/c-1/7
msgctxt "Luna"
msgid "Why? That will drastically reduce my combat capabilities!"
msgstr "Pourquoi ? Ça réduirait drastiquement mes capacités de combat !"

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-0/c-5/18/0/s/0 connie_console/connie_love_return/0/30/s/0 connie_console/connie_friend_return/0/30/s/0
msgctxt "Choix"
msgid "That's what you said last time."
msgstr "C'est ce que tu disais la dernière fois."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-0/c-5/18/1/s/0
msgctxt "Choix"
msgid "But if we only take out one Assassin Class Upholder, we'll be free and clear to sneak through."
msgstr "Mais si on élimine un seul Gardien de classe Assassin, on pourra se faufiler sans problème."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-0/c-5/18/c-0/7
msgctxt "Luna"
msgid "It's true!"
msgstr "C'est vrai !"

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-0/c-5/18/c-0/18/0/s/0
msgctxt "Choix"
msgid "Then you said to 'Not listen to the sirop-addled junkie who said no to wearing the goggles in that timeline.'"
msgstr "Ensuite, tu m'as dit de « ne pas écouter la droguée au sirop qui a refusé de mettre les lunettes dans cette chronologie »."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-0/c-5/18/c-0/18/c-0/7
msgctxt "Luna"
msgid "Uhh... that's me all right."
msgstr "Euh... ça, c'est bien moi."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-0/c-5/18/c-0/18/c-0/15 connie_console/connie_encounter_two/0/g-0/c-5/18/c-1/15
msgctxt "Luna"
msgid "Fine, I'll wear the goggles."
msgstr "Bon, je mets les lunettes."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-0/c-5/18/c-0/18/c-0/23 connie_console/connie_encounter_two/0/g-0/c-5/18/c-1/23
msgctxt "Luna"
msgid "But you have to tell me where our mark is."
msgstr "Mais tu dois me dire où est notre cible."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-0/c-5/18/c-0/18/c-0/31/0/s/0
msgctxt "Choix"
msgid "There was always an Assassin Class Upholder right around the first corridor we pass."
msgstr "Il y avait toujours un Gardien de classe Assassin juste après le premier couloir."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-0/c-5/18/c-0/18/c-0/31/c-0/7 connie_console/connie_encounter_two/0/g-0/c-5/18/c-1/31/c-0/7 connie_console/connie_encounter_three/0/g-1/9/0 connie_console/connie_quest_true_crafting/0/crafting/0
msgctxt "Luna"
msgid "Got it."
msgstr "Compris."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-0/c-5/18/c-0/18/c-0/31/c-0/15 connie_console/connie_quest_true_crafting/0/8
msgctxt "Narrator"
msgid "Luna puts on the xeno-goggles, and enters the compound cautiously."
msgstr "Luna met les xéno-lunettes et pénètre prudemment dans le complexe."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-0/c-5/18/c-1/7
msgctxt "Luna"
msgid "Hmm... good point."
msgstr "Hmm... bon argument."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-0/c-5/18/c-1/31/0/s/0 connie_console/connie_quest_true_stealth/0/g-0/c-3/63/c-1/18/c-0/26/0/s/0
msgctxt "Choix"
msgid "There is always an Assassin Class Upholder right around the first corridor we pass."
msgstr "Il y a toujours un Gardien de classe Assassin juste après le premier couloir."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-0/c-5/18/c-1/31/c-0/15
msgctxt "Narrator"
msgid "Luna puts on the xeno-goggles and enters the compound, cautious and alert for the first sign of trouble."
msgstr "Luna met les xéno-lunettes et entre dans le complexe, prudente et attentive au moindre signe de danger."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/0
msgctxt "Luna"
msgid "How do you suggest we do this?"
msgstr "Tu proposes quoi ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/8/s/0
msgctxt "Choix"
msgid "As quietly as possible."
msgstr "Le plus discrètement possible."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/9/s/0
msgctxt "Choix"
msgid "Try to date one of the guards..."
msgstr "Essaie de draguer un des gardes..."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/10/s/0
msgctxt "Choix"
msgid "Who cares - guns blazing!"
msgstr "On s'en fout, flingues à fond !"

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-6/7
msgctxt "Luna"
msgid "Makes sense."
msgstr "Logique."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-6/15/b/1
msgctxt "Luna"
msgid "With the shadowsuit, there's no way they'll hear us coming."
msgstr "Avec la combinaison d'ombre, ils ne nous entendront jamais arriver."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-6/18
msgctxt "Narrator"
msgid "Using all your available grace and patience, you and Luna slowly make your way down the corridors."
msgstr "Avec toute la grâce et toute la patience dont vous êtes capable, vous et Luna progressez lentement dans les couloirs."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-6/26
msgctxt "Luna"
msgid "<i>Close behind me, yail.</i>"
msgstr "<i>Reste juste derrière moi, pote.</i>"

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-6/34
msgctxt "Narrator"
msgid "You drift past both Grunt and Surveillance Upholders with ease."
msgstr "Vous dépassez sans peine des Gardiens Sbires et Surveillance."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-6/42
msgctxt "Luna"
msgid "<i>Good choice on the stealth... I usually prefer the part where we—</i>"
msgstr "<i>Bon choix, la discrétion... moi, je préfère d'habitude la partie où on—</i>"

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-6/50 connie_console/connie_encounter_two/0/g-1/c-7/15/c-0/15/g-0/212 connie_console/connie_encounter_two/0/g-1/c-8/115
msgctxt "Assassin Upholder"
msgid "<w>t h e r e y o u a r e</w>"
msgstr "<w>t e v o i l à</w>"

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-6/64
msgctxt "Luna"
msgid "<w>Oh no - Assassin!</w>"
msgstr "<w>Oh non, un Assassin !</w>"

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-6/78
msgctxt "Narrator"
msgid "From your stealthy vantage point you can get a vague sense of what's happening."
msgstr "Depuis votre cachette, vous ne devinez que vaguement ce qui se passe."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-6/83
msgctxt "Narrator"
msgid "A vast laser juts out from some sort of holographic human from down the end of the corridor."
msgstr "Un immense laser jaillit d'une sorte d'humain holographique au bout du couloir."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-6/91
msgctxt "Narrator"
msgid "The light engulfs Luna and renders her immobile."
msgstr "La lumière engloutit Luna et l'immobilise."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-6/99/0/s/0 connie_console/connie_encounter_two/0/g-1/c-7/15/c-0/15/g-0/251/0/s/0 connie_console/connie_encounter_two/0/g-1/c-8/154/0/s/0
msgctxt "Choix"
msgid "<i>Grab Luna and run.</i>"
msgstr "<i>Attraper Luna et courir.</i>"

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-6/99/1/s/0 connie_console/connie_encounter_two/0/g-1/c-7/15/c-0/15/g-0/251/1/s/0 connie_console/connie_encounter_two/0/g-1/c-8/154/1/s/0
msgctxt "Choix"
msgid "<i>Watch helplessly.</i>"
msgstr "<i>Observer sans rien pouvoir faire.</i>"

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-6/99/c-0/7 connie_console/connie_encounter_two/0/g-1/c-7/15/c-0/15/g-0/251/c-0/7 connie_console/connie_encounter_two/0/g-1/c-8/154/c-0/7
msgctxt "Narrator"
msgid "Bravely, you take Luna's frozen body and crash through the remainder of the hallway."
msgstr "Courageusement, vous prenez le corps figé de Luna et fracassez le reste du couloir."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-6/99/c-0/18 connie_console/connie_encounter_two/0/g-1/c-7/15/c-0/15/g-0/251/c-0/15 connie_console/connie_encounter_two/0/g-1/c-8/154/c-0/18
msgctxt "Narrator"
msgid "Once she is removed from the power of the strange weapon, she hangs limply in your arms for a moment, enjoying the ride."
msgstr "Une fois soustraite au pouvoir de l'arme étrange, elle pend mollement dans vos bras un instant, profitant du trajet."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-6/99/c-0/26/0/s/0 connie_console/connie_encounter_two/0/g-1/c-7/15/c-0/15/g-0/251/c-0/26/0/s/0 connie_console/connie_encounter_two/0/g-1/c-8/154/c-0/26/0/s/0
msgctxt "Choix"
msgid "<i>Give her a wink and a smile...</i>"
msgstr "<i>Lui adresser un clin d'oeil et un sourire...</i>"

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-6/99/c-0/26/1/s/0
msgctxt "Choix"
msgid "<i>Continue to run like a badass.</i>"
msgstr "<i>Continuer de courir comme une légende.</i>"

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-6/99/c-0/26/c-0/13
msgctxt "Luna"
msgid "Guess I don't have to whisper anymore..."
msgstr "Je suppose que j'ai plus besoin de chuchoter..."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-6/99/c-1/7 connie_console/connie_encounter_two/0/g-1/c-7/15/c-0/15/g-0/251/c-1/7 connie_console/connie_encounter_two/0/g-1/c-8/154/c-1/7
msgctxt "Luna"
msgid "Do... I have to... do everything... myself."
msgstr "Faut... que je... tout faire... moi-même."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-6/99/c-1/15 connie_console/connie_encounter_two/0/g-1/c-7/15/c-0/15/g-0/251/c-1/15 connie_console/connie_encounter_two/0/g-1/c-8/154/c-1/15
msgctxt "Narrator"
msgid "From Luna's pockets, a small device drops, and soon the hallway is immersed in a bright yellow flash."
msgstr "Un petit appareil tombe des poches de Luna, et bientôt le couloir est plongé dans un éclair jaune éclatant."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-6/99/c-1/23 connie_console/connie_encounter_two/0/g-1/c-7/15/c-0/15/g-0/251/c-1/23 connie_console/connie_encounter_two/0/g-1/c-8/154/c-1/23
msgctxt "Narrator"
msgid "The laser stops momentarily - and Luna gets to her feet after falling to the ground."
msgstr "Le laser s'interrompt un instant, et Luna se relève après avoir chuté au sol."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-6/99/c-1/31 connie_console/connie_encounter_two/0/g-1/c-7/15/c-0/15/g-0/251/c-1/31 connie_console/connie_encounter_two/0/g-1/c-8/154/c-1/31
msgctxt "Luna"
msgid "Follow me!"
msgstr "Suis-moi !"

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-7/7
msgctxt "Luna"
msgid "Dating? Why would you do that?"
msgstr "Draguer ? Pourquoi tu ferais ça ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-7/15/0/s/0
msgctxt "Choix"
msgid "Well, sometimes you meet things on your adventure and start to... have feelings for them."
msgstr "Eh bien, parfois on rencontre des choses pendant l'aventure et on commence à... avoir des sentiments pour elles."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-7/15/c-0/7
msgctxt "Luna"
msgid "Do you have feelings for me?"
msgstr "T'as des sentiments pour moi ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-7/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "Too early to tell."
msgstr "Trop tôt pour le dire."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-7/15/c-0/15/1/s/0
msgctxt "Choix"
msgid "Yup."
msgstr "Ouaip."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-7/15/c-0/15/g-0/0
msgctxt "Luna"
msgid "Interesting..."
msgstr "Intéressant..."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-7/15/c-0/15/g-0/8
msgctxt "Luna"
msgid "See, I'm more familiar with reloading, looting, and corridors, personally."
msgstr "Moi, personnellement, je suis plus familière du rechargement, du looting et des couloirs."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-7/15/c-0/15/g-0/16
msgctxt "Luna"
msgid "But we can try this 'dating'."
msgstr "Mais on peut essayer ce « drague »."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-7/15/c-0/15/g-0/24
msgctxt "Narrator"
msgid "Luna strides boldly up to a nearby Grunt."
msgstr "Luna s'avance hardiment vers un Sbire proche."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-7/15/c-0/15/g-0/32
msgctxt "Luna"
msgid "Hey Grunt, wanna date?"
msgstr "Hé, Sbire, ça te dit de sortir avec moi ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-7/15/c-0/15/g-0/46
msgctxt "Grunt Upholder"
msgid "<w>WHAT</w>"
msgstr "<w>QUOI</w>"

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-7/15/c-0/15/g-0/63
msgctxt "Luna"
msgid "You, me - go out and watch a flyck? Drive around Hanatown? Eat spaghetti and plarkton?"
msgstr "Toi, moi, on sort voir un flyck ? On se balade dans Hanatown ? On mange des spaghettis au plarkton ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-7/15/c-0/15/g-0/77
msgctxt "Grunt Upholder"
msgid "<w>HM. YOU ARE A CUTE ONE.</w>"
msgstr "<w>HM. TU ES MIGNONNE.</w>"

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-7/15/c-0/15/g-0/91
msgctxt "Narrator"
msgid "From the Grunt's pocket, a voice barks loudly."
msgstr "Dans la poche du Sbire, une voix aboie."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-7/15/c-0/15/g-0/99
msgctxt "Surveillance Upholder"
msgid "Grunt! What are you doing!"
msgstr "Sbire ! Qu'est-ce que tu fabriques !"

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-7/15/c-0/15/g-0/107
msgctxt "Grunt Upholder"
msgid "<w>I I I</w>"
msgstr "<w>J J J</w>"

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-7/15/c-0/15/g-0/115
msgctxt "Surveillance Upholder"
msgid "Get her!"
msgstr "Attrapez-la !"

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-7/15/c-0/15/g-0/123 connie_console/connie_encounter_two/0/g-1/c-8/23
msgctxt "Luna"
msgid "Ah bits, we've got company!"
msgstr "Ah, zut, on a de la visite !"

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-7/15/c-0/15/g-0/137
msgctxt "Narrator"
msgid "Except for the smitten Grunt Upholder (who to this day still holds a candle for Luna), the hallways are swarmed with guards."
msgstr "Hormis le Sbire fou amoureux (qui, à ce jour, en pince encore pour Luna), les couloirs grouillent de gardes."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-7/15/c-0/15/g-0/145 connie_console/connie_encounter_two/0/g-1/c-8/51
msgctxt "Surveillance Upholder"
msgid "<w>CEASE CEASE CEASE</w>"
msgstr "<w>STOP STOP STOP</w>"

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-7/15/c-0/15/g-0/159 connie_console/connie_encounter_two/0/g-1/c-8/59
msgctxt "Luna"
msgid "Eat plasma, drights!"
msgstr "Mangez du plasma, ordures !"

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-7/15/c-0/15/g-0/176 connie_console/connie_encounter_two/0/g-1/c-8/76
msgctxt "Grunt Upholder"
msgid "<w>UGH UGH UGH</w>"
msgstr "<w>UGH UGH UGH</w>"

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-7/15/c-0/15/g-0/190 connie_console/connie_encounter_two/0/g-1/c-8/90
msgctxt "Narrator"
msgid "The battle rages through the halls as you and Luna drop guard after guard..."
msgstr "La bataille fait rage dans les couloirs, vous et Luna abattant garde après garde..."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-7/15/c-0/15/g-0/204 connie_console/connie_encounter_two/0/g-1/c-8/104
msgctxt "Luna"
msgid "Hahahahah!!"
msgstr "Hahahahah !!"

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-7/15/c-0/15/g-0/229 connie_console/connie_encounter_two/0/g-1/c-8/132
msgctxt "Luna"
msgid "Oh no... I can't see them... I can't... move..."
msgstr "Oh non... je les vois pas... je peux plus... bouger..."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-7/15/c-0/15/g-0/243 connie_console/connie_encounter_two/0/g-1/c-8/146
msgctxt "Narrator"
msgid "You can't quite tell what is happening, but a vast laser peeks from around a corner and engulfs Luna's stiffened form."
msgstr "Vous ne comprenez pas bien ce qui se passe, mais un immense laser surgit d'un angle et engloutit Luna, raide comme un piquet."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-7/15/c-0/15/g-0/251/c-0/26/1/s/0 connie_console/connie_encounter_two/0/g-1/c-8/154/c-0/26/1/s/0
msgctxt "Choix"
msgid "<i>Continue running like a badass.</i>"
msgstr "<i>Continuer de courir comme une légende.</i>"

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-7/15/c-0/15/g-0/251/c-0/26/c-0/13
msgctxt "Luna"
msgid "Is this what dating gets you? Not too bad I suppose."
msgstr "C'est ça que ça donne, de draguer ? C'est pas si mal, je suppose."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-8/7
msgctxt "Luna"
msgid "Let's light this place up!"
msgstr "On met le feu à cet endroit !"

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-8/15
msgctxt "Narrator"
msgid "After merely a few charges spring from Luna's rifle, the corridor is absolutely swarmed with guards."
msgstr "Après quelques charges à peine tirées du fusil de Luna, le couloir grouille de gardes."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-8/37
msgctxt "Grunt Upholder"
msgid "<w>DROP YOUR WEAPON</w>"
msgstr "<w>LÂCHEZ VOTRE ARME</w>"

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/g-1/c-8/154/c-0/26/c-0/14
msgctxt "Luna"
msgid "Not bad, yail. Not bad."
msgstr "Pas mal, pote. Pas mal."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/runjoin/8
msgctxt "Narrator"
msgid "You run further through the maze-like compound and finally make it to an empty office."
msgstr "Vous courez plus loin dans le complexe labyrinthique et atteignez enfin un bureau vide."

# Traduction IA – à relire
#: connie_console/connie_encounter_two/0/runjoin/19
msgctxt "Luna"
msgid "Kraa... we lost a lot of gear there in the trist of battle. But at least we still have enough health to get us through to the end."
msgstr "Kraa... on a perdu un paquet de matos dans le trist du combat. Mais on a encore assez de santé pour aller jusqu'au bout."

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/0
msgctxt "Luna"
msgid "We're getting close..."
msgstr "On y est presque..."

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/8
msgctxt "Luna"
msgid "You want to press on? Or should we take a crafting break?"
msgstr "Tu veux continuer ? Ou on fait une pause artisanat ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/16/s/0
msgctxt "Choix"
msgid "To the boss!"
msgstr "Au boss !"

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/17/s/0
msgctxt "Choix"
msgid "What's crafting?"
msgstr "C'est quoi, l'artisanat ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/c-0/7 connie_console/connie_quest_true_stealth/0/g-0/c-3/63/c-0/7
msgctxt "Luna"
msgid "Let's go."
msgstr "Allons-y."

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/c-1/7
msgctxt "Luna"
msgid "We have a chance to use what's left in our inventory to make something that will help us in the final battle."
msgstr "On peut utiliser ce qui reste dans notre inventaire pour fabriquer un truc qui nous aidera dans le combat final."

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "Let's get crafty..."
msgstr "Mettons-nous à bricoler..."

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/c-1/15/1/s/0
msgctxt "Choix"
msgid "That sounds boring. Let's fight the bad lady!"
msgstr "Ça a l'air ennuyeux. Allons battre la méchante !"

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/c-1/15/c-1/7
msgctxt "Luna"
msgid "Heh. Yeah, crafting sucks."
msgstr "Heh. Ouais, l'artisanat, c'est nul."

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-0/0
msgctxt "Luna"
msgid "All right, we can craft something really special using this workbench."
msgstr "Bon, on peut fabriquer un truc vraiment spécial avec cet établi."

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-0/8
msgctxt "Luna"
msgid "This thing can take anything we've got and transform it into anything we don't."
msgstr "Ce machin peut prendre tout ce qu'on a et le transformer en tout ce qu'on n'a pas."

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-0/17/s/0
msgctxt "Choix"
msgid "Does it take compliments?"
msgstr "Il accepte les compliments ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-0/18/s/0
msgctxt "Choix"
msgid "You're going to fight Crescentia... and Selene, you know."
msgstr "Tu vas affronter Crescentia... et Selene, tu sais."

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-0/19/s/0 connie_console/connie_quest_true_crafting/0/g-1/17/s/0
msgctxt "Choix"
msgid "What do we have in our inventory?"
msgstr "Qu'est-ce qu'on a dans l'inventaire ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-0/c-2/7
msgctxt "Luna"
msgid "Yail, I gotta say. You think I'm sputz or something?"
msgstr "Pote, franchement. Tu me prends pour une sputz ou quoi ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-0/c-2/15
msgctxt "Luna"
msgid "We're still in the same timeline where I told you that! That's not gonna convince me of anything."
msgstr "On est toujours dans la chronologie où je t'ai dit ça ! Ça va pas me convaincre."

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-0/c-3/13
msgctxt "Luna"
msgid "Compliments?"
msgstr "Des compliments ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-0/c-3/21/0/s/0
msgctxt "Choix"
msgid "Yeah, you look great. So glad I get to have you as my partner here."
msgstr "Ouais, tu es superbe. Quelle chance de t'avoir comme partenaire."

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-0/c-3/21/1/s/0
msgctxt "Choix"
msgid "You're the fiercest damn warrior I've ever seen! Love your moves!"
msgstr "T'es la guerrière la plus féroce que j'aie jamais vue ! J'adore tes mouvements !"

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-0/c-3/21/2/s/0
msgctxt "Choix"
msgid "Your voice makes my insides... do things."
msgstr "Ta voix fait des trucs à mes entrailles."

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-0/c-3/21/c-0/7
msgctxt "Luna"
msgid "Thanks - you're not too bad yourself."
msgstr "Merci, toi non plus t'es pas mal."

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-0/c-3/21/c-1/7
msgctxt "Luna"
msgid "Thanks! Those moves came from years of button-mashing."
msgstr "Merci ! Ces mouvements, c'est des années à marteler des boutons."

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-0/c-3/21/c-2/7
msgctxt "Luna"
msgid "Oh... interesting. I will be aware of that so I don't distract you in combat."
msgstr "Oh... intéressant. J'y ferai attention pour pas te distraire au combat."

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-0/c-4/7
msgctxt "Luna"
msgid "Hm."
msgstr "Hm."

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-0/c-4/15
msgctxt "Luna"
msgid "I'm not quite sure I believe you just yet."
msgstr "Je suis pas sûre de te croire tout de suite."

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-0/c-4/23
msgctxt "Luna"
msgid "But noted. I'm prepared for anything."
msgstr "Mais noté. Je suis prête à tout."

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-0/c-5/7
msgctxt "Luna"
msgid "Not much... we got zonked by that last encounter pretty hard."
msgstr "Pas grand-chose... la dernière rencontre nous a bien assommés."

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-0/c-5/15
msgctxt "Luna"
msgid "One Globule, One Wood, and One Scrouf skin."
msgstr "Un Globule, un Bois et une peau de scrouf."

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-0/c-5/23/0/s/0
msgctxt "Choix"
msgid "What can we make with that?"
msgstr "On peut fabriquer quoi avec ça ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-0/c-5/23/1/s/0
msgctxt "Choix"
msgid "Sounds dismal."
msgstr "Lamentable."

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-0/c-5/23/c-0/7
msgctxt "Luna"
msgid "We'll have to find out."
msgstr "On va devoir le découvrir."

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-0/c-5/23/c-1/7
msgctxt "Luna"
msgid "Dismal? Sounds like an earther word."
msgstr "Lamentable ? On dirait un mot de terrien."

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-0/c-5/23/c-1/15
msgctxt "Luna"
msgid "Here on the moon we say dhismal."
msgstr "Ici, sur la lune, on dit lamhentable."

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-1/0
msgctxt "Luna"
msgid "Okay. Let's get started with..."
msgstr "Bon. Commençons par..."

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-1/9/8 connie_console/connie_quest_true_crafting/0/crafting/8
msgctxt "Luna"
msgid "And then?"
msgstr "Et ensuite ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-1/9/16/0/s/0 connie_console/connie_quest_true_crafting/0/crafting/16/0/s/0
msgctxt "Choix"
msgid "One Globule."
msgstr "Un Globule."

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-1/9/16/1/s/0 connie_console/connie_quest_true_crafting/0/crafting/16/1/s/0
msgctxt "Choix"
msgid "One Wood."
msgstr "Un Bois."

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-1/9/16/2/s/0 connie_console/connie_quest_true_crafting/0/crafting/16/2/s/0
msgctxt "Choix"
msgid "One Scrouf skin."
msgstr "Une peau de scrouf."

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-1/9/16/3/s/0 connie_console/connie_quest_true_crafting/0/crafting/16/3/s/0
msgctxt "Choix"
msgid "That's it... I think."
msgstr "C'est tout... je crois."

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-2/0
msgctxt "Luna"
msgid "All right... I don't think that's gonna give us anything we really need, unfortunately."
msgstr "Bon... j'ai bien peur que ça nous donne rien dont on ait vraiment besoin."

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-2/8
msgctxt "Luna"
msgid "But there's no reason to lose hope! Lemme just put these together and..."
msgstr "Mais pas de raison de perdre espoir ! Laisse-moi assembler tout ça et..."

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-2/16/b/5
msgctxt "Luna"
msgid "It's... pretty globular."
msgstr "C'est... plutôt globuleux."

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-2/16/b/13
msgctxt "Luna"
msgid "Which is always good for defense!"
msgstr "Ce qui est toujours bon pour la défense !"

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-2/19/b/5
msgctxt "Luna"
msgid "The wood gives nice heft, raising our attack!"
msgstr "Le bois donne un bon poids, ce qui augmente notre attaque !"

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-2/22/b/5
msgctxt "Luna"
msgid "The scrouf skin makes anything look a lot better for comfort."
msgstr "La peau de scrouf rend n'importe quoi bien plus confortable."

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-2/25/b/1
msgctxt "Luna"
msgid "Oh wait. We didn't put in anything at all. What was I thinking?"
msgstr "Oh, attends. On n'a rien mis du tout. À quoi je pensais ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-2/25/b/9 connie_console/connie_quest_true_crafting/0/g-2/15/b/9
msgctxt "Luna"
msgid "Oh well! Worth a shot!"
msgstr "Tant pis ! Ça valait le coup d'essayer !"

# Traduction IA – à relire
#: connie_console/connie_encounter_three/0/g-2/26/b/5
msgctxt "Luna"
msgid "We've got an amazing new piece of armor from this. That'll help us in the battle ahead!"
msgstr "On a une nouvelle armure incroyable grâce à ça. Elle nous aidera dans la bataille qui vient !"

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/0
msgctxt "Narrator"
msgid "You and Luna make your way through the final threshold, and stop right before the entrance."
msgstr "Vous et Luna franchissez le dernier seuil et vous arrêtez juste avant l'entrée."

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/11
msgctxt "Luna"
msgid "Oh no... there it is."
msgstr "Oh non... le voilà."

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/19
msgctxt "Luna"
msgid "The horror of it all."
msgstr "Toute l'horreur de la chose."

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/27
msgctxt "Narrator"
msgid "The way opens up into a large Regolith cavern. Mining constructs mingle with moon rocks as the terminus of the station is reached."
msgstr "Le passage s'ouvre sur une vaste caverne de Régolithe. Des engins miniers côtoient les roches lunaires : c'est le terminus de la station."

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/32
msgctxt "Narrator"
msgid "But perched high on the crane next to a large glowing blue crack in the Regolith, was a well-outfitted spacer who looked just like Luna."
msgstr "Mais perchée en haut de la grue, près d'une large fissure bleue luisante dans le Régolithe, se tenait une spatiale bien équipée qui ressemblait trait pour trait à Luna."

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/46
msgctxt "Selene"
msgid "You came just in time for the festivities to begin..."
msgstr "Vous arrivez juste à temps pour le début des festivités..."

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/54
msgctxt "Luna"
msgid "Selene Moonrise... Prepare to die."
msgstr "Selene Moonrise... Prépare-toi à mourir."

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/71
msgctxt "Selene"
msgid "Luna... you'll never take Crescentia's power."
msgstr "Luna... tu ne t'empareras jamais du pouvoir de Crescentia."

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/85/s/0
msgctxt "Choix"
msgid "Who is Crescentia?"
msgstr "C'est qui, Crescentia ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/86/s/0
msgctxt "Choix"
msgid "Who is Selene?"
msgstr "C'est qui, Selene ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/87/s/0
msgctxt "Choix"
msgid "Shoot her in the face already!"
msgstr "Tire-lui dans la figure, c'est tout !"

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/88/s/0
msgctxt "Choix"
msgid "With our extra resources - we can get this taken care of real fast."
msgstr "Avec nos ressources en plus, on règle ça en deux temps trois mouvements."

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/c-0/7
msgctxt "Luna"
msgid "Crescentia - the goddess of the moon."
msgstr "Crescentia, la déesse de la lune."

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/c-0/21
msgctxt "Selene"
msgid "We found her in 2066."
msgstr "On l'a trouvée en 2066."

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/c-0/35
msgctxt "Selene"
msgid "And next year she'll be destroyed."
msgstr "Et l'an prochain, elle sera détruite."

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/c-0/43
msgctxt "Selene"
msgid "Leaving us free to harvest."
msgstr "Nous laissant libres de récolter."

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/c-1/7
msgctxt "Selene"
msgid "Who is that with you? Some low-level peon?"
msgstr "C'est qui, avec toi ? Un larbin de bas niveau ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/c-1/15
msgctxt "Selene"
msgid "I always send those to the drock pits."
msgstr "Je les envoie toujours aux fosses à drok."

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/c-1/23
msgctxt "Luna"
msgid "Do you need to know any more?"
msgstr "T'as besoin d'en savoir plus ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/c-1/37
msgctxt "Luna"
msgid "We kill her."
msgstr "On la tue."

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/c-2/7
msgctxt "Luna"
msgid "Yes! What's wrong with me..."
msgstr "Oui ! Qu'est-ce qui m'arrive..."

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/c-3/7
msgctxt "Luna"
msgid "I agree - I am Invincible!!"
msgstr "Je suis d'accord, je suis Invincible !!"

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/g-0/0
msgctxt "Narrator"
msgid "The glowing crack seems to swell."
msgstr "La fissure luisante semble gonfler."

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/g-0/8
msgctxt "Luna"
msgid "Eat charge, bitch!"
msgstr "Mange de la charge, salope !"

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/g-0/19
msgctxt "Selene"
msgid "Hmph."
msgstr "Hmph."

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/g-0/33
msgctxt "Narrator"
msgid "The blue deposit of moon-rock erupts - and from the crack a monstrous creature bursts forth."
msgstr "Le gisement bleu de roche lunaire entre en éruption, et de la fissure jaillit une créature monstrueuse."

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/g-0/41
msgctxt "Selene"
msgid "Crescentia - go!"
msgstr "Crescentia, va !"

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/g-0/49
msgctxt "Crescentia"
msgid "<w>KRRREEEEE!!!!</w>"
msgstr "<w>KRRREEEEE !!!!</w>"

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/g-0/63
msgctxt "Luna"
msgid "Auugh!"
msgstr "Auugh !"

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/g-0/77/s/0
msgctxt "Choix"
msgid "Shoot more, harder!"
msgstr "Tire plus, plus fort !"

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/g-0/78/s/0
msgctxt "Choix"
msgid "Use items!"
msgstr "Utilise des objets !"

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/g-0/79/s/0
msgctxt "Choix"
msgid "360 No-scope!"
msgstr "No-scope à 360 !"

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/g-0/80/s/0
msgctxt "Choix"
msgid "Use the power of Love, Luna! Lingonberrryyy!!!"
msgstr "Utilise le pouvoir de l'Amour, Luna ! Airelleeees !!!"

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/g-0/c-4/7
msgctxt "Luna"
msgid "I'm trying!"
msgstr "J'essaie !"

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/g-0/c-5/7
msgctxt "Luna"
msgid "Take this!"
msgstr "Prends ça !"

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/g-0/c-5/15
msgctxt "Narrator"
msgid "Luna throws an elemental grenade that blasts Crescentia's scaly hide."
msgstr "Luna lance une grenade élémentaire qui calcine le cuir écailleux de Crescentia."

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/g-0/c-6/7
msgctxt "Luna"
msgid "Ha! Easy!"
msgstr "Ha ! Fastoche !"

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/g-0/c-7/7
msgctxt "Luna"
msgid "What? Love has like 0 attack."
msgstr "Quoi ? L'Amour a genre 0 en attaque."

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/g-0/c-7/15
msgctxt "Luna"
msgid "I choose the old standby..."
msgstr "Je choisis la valeur sûre..."

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/g-0/c-7/23
msgctxt "Luna"
msgid "An unceasing burst of zacre charges."
msgstr "Une rafale ininterrompue de charges de zacre."

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/g-1/0/b/1
msgctxt "Narrator"
msgid "Thanks to your crafting, Luna is able to withstand the mighty force of Crescentia's power."
msgstr "Grâce à votre artisanat, Luna parvient à résister à la puissante force de Crescentia."

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/g-1/3
msgctxt "Narrator"
msgid "The battle is fierce, but ultimately Crescentia, and Selene, fall to the ground."
msgstr "Le combat est féroce, mais finalement Crescentia et Selene s'effondrent."

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/g-1/17
msgctxt "Narrator"
msgid "Presumably dead."
msgstr "Mortes, vraisemblablement."

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/g-1/25
msgctxt "Luna"
msgid "Wow. Did that without even a single save."
msgstr "Wow. On a fait ça sans une seule sauvegarde."

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/g-1/39
msgctxt "Luna"
msgid "Great job, yail. Couldn't have done it without you."
msgstr "Beau boulot, pote. J'aurais pas pu sans toi."

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/g-1/50/s/0
msgctxt "Choix"
msgid "I'm so glad to be there for you."
msgstr "Ça me fait tellement plaisir d'être là pour toi."

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/g-1/51/s/0
msgctxt "Choix"
msgid "That was fun!"
msgstr "C'était marrant !"

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/g-1/52/s/0
msgctxt "Choix"
msgid "Could this be something more?"
msgstr "Ça pourrait être quelque chose de plus ?"

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/g-1/53/s/0
msgctxt "Choix"
msgid "This is the same as the other times..."
msgstr "C'est pareil que les autres fois..."

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/g-1/c-8/7
msgctxt "Luna"
msgid "You're the best partner I could ever have asked for. You always chose the right path, unwaveringly."
msgstr "Je n'aurais jamais pu rêver mieux comme partenaire. T'as toujours choisi la bonne voie, sans jamais faiblir."

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/g-1/c-9/7
msgctxt "Luna"
msgid "I'm glad! I think this is fun, too!"
msgstr "Ça me fait plaisir ! Je trouve ça marrant aussi !"

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/g-1/c-10/7
msgctxt "Luna"
msgid "Well..."
msgstr "Eh bien..."

# Traduction IA – à relire
#: connie_console/connie_encounter_four/0/g-1/c-11/7
msgctxt "Luna"
msgid "Is it? I feel so pumped full of denahinadrine that I can't imagine we didn't alter the timeline at least a little!"
msgstr "Vraiment ? J'ai tellement de dénahinadrine dans les veines que je vois pas comment on aurait pas modifié la chronologie, ne serait-ce qu'un peu !"

# Traduction IA – à relire
#: connie_console/recipe_find/0/4
msgctxt "Narrator"
msgid "Luna's xeno-goggles catch a small screen dropped from Selene's grasp."
msgstr "Les xéno-lunettes de Luna captent un petit écran échappé de la main de Selene."

# Traduction IA – à relire
#: connie_console/recipe_find/0/15
msgctxt "Luna"
msgid "Wait... Selene left something behind!"
msgstr "Attends... Selene a laissé un truc derrière elle !"

# Traduction IA – à relire
#: connie_console/recipe_find/0/23
msgctxt "Narrator"
msgid "Luna picks it up and turns on the display."
msgstr "Luna le ramasse et allume l'écran."

# Traduction IA – à relire
#: connie_console/recipe_find/0/31
msgctxt "Luna"
msgid "It's the recipe for a Harmonic Stratospire!"
msgstr "C'est la recette d'une Stratospire Harmonique !"

# Traduction IA – à relire
#: connie_console/recipe_find/0/39 connie_console/harmonic_options/0/c-0/18
msgctxt "Luna"
msgid "The Resistance has been working on this tech for a generation - it's a way to take fractured timelines and concentrate the differences in power into a deadly beam."
msgstr "La Résistance travaille sur cette techno depuis une génération : elle permet de prendre des chronologies fracturées et de concentrer les différences de puissance en un rayon mortel."

# Traduction IA – à relire
#: connie_console/recipe_find/0/50
msgctxt "Luna"
msgid "That beam can erase a crack in the continuum for good. And I think something about your timeline-tripping abilities and Selene's rise to power have something to do with each other."
msgstr "Ce rayon peut effacer définitivement une faille du continuum. Et je crois que tes capacités de voyage temporel et l'ascension de Selene ont un lien."

# Traduction IA – à relire
#: connie_console/recipe_find/0/58/s/0
msgctxt "Choix"
msgid "That's great - let's make it! Let's stop Selene!"
msgstr "Génial, fabriquons-la ! Arrêtons Selene !"

# Traduction IA – à relire
#: connie_console/recipe_find/0/c-0/7
msgctxt "Luna"
msgid "But she's already died in this timeline."
msgstr "Mais elle est déjà morte dans cette chronologie."

# Traduction IA – à relire
#: connie_console/recipe_find/0/c-0/15
msgctxt "Luna"
msgid "You'll have to come back... with the knowledge of the recipe."
msgstr "Tu devras revenir... avec la connaissance de la recette."

# Traduction IA – à relire
#: connie_console/recipe_find/0/c-0/23/0/s/0
msgctxt "Choix"
msgid "What is the recipe?"
msgstr "C'est quoi, la recette ?"

# Traduction IA – à relire
#: connie_console/recipe_find/0/c-0/23/c-0/7
msgctxt "Luna"
msgid "It's 4 Globules, 1 Wood, and 2 Scrouf skins. Remember it."
msgstr "C'est 4 Globules, 1 Bois et 2 peaux de scrouf. Retiens-la."

# Traduction IA – à relire
#: connie_console/recipe_find/0/c-0/23/c-0/15
msgctxt "Luna"
msgid "Remember... me..."
msgstr "Souviens-toi... de moi..."

# Traduction IA – à relire
#: connie_console/recipe_find/0/c-0/23/c-0/23
msgctxt "Narrator"
msgid "Luna is already beginning to fade away."
msgstr "Luna commence déjà à s'effacer."

# Traduction IA – à relire
#: connie_console/recipe_find/0/c-0/23/c-0/34/0/s/0
msgctxt "Choix"
msgid "I'll do it for you, my love."
msgstr "Je le ferai pour toi, mon amour."

# Traduction IA – à relire
#: connie_console/recipe_find/0/c-0/23/c-0/34/1/s/0
msgctxt "Choix"
msgid "Yes, my Upholder."
msgstr "Oui, ma Gardienne."

# Traduction IA – à relire
#: connie_console/recipe_find/0/c-0/23/c-0/34/2/s/0
msgctxt "Choix"
msgid "I hate you, Luna."
msgstr "Je te déteste, Luna."

# Traduction IA – à relire
#: connie_console/recipe_find/0/c-0/23/c-0/34/c-0/7
msgctxt "Luna"
msgid "Thank you."
msgstr "Merci."

# Traduction IA – à relire
#: connie_console/recipe_find/0/c-0/23/c-0/34/c-1/7
msgctxt "Luna"
msgid "Blood to blood - till the end."
msgstr "Sang pour sang, jusqu'à la fin."

# Traduction IA – à relire
#: connie_console/recipe_find/0/c-0/23/c-0/34/c-2/7
msgctxt "Luna"
msgid "Hah. Because I'll forget?"
msgstr "Hah. Parce que j'oublierai ?"

# Traduction IA – à relire
#: connie_console/recipe_find/0/c-0/23/c-0/34/c-2/23
msgctxt "Luna"
msgid "I hate you, too."
msgstr "Moi aussi, je te déteste."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/0
msgctxt "Luna"
msgid "Lingonberries..."
msgstr "Airelles..."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/8
msgctxt "Luna"
msgid "Oh my dunes..."
msgstr "Oh, mes dunes..."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/16
msgctxt "Luna"
msgid "We've got a timeline crisis here!"
msgstr "On a une crise temporelle !"

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/24/s/0
msgctxt "Choix"
msgid "Yes, you told me to say that to you last time."
msgstr "Oui, tu m'as dit de te dire ça la dernière fois."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/25/s/0
msgctxt "Choix"
msgid "I'm here to help!"
msgstr "Je suis là pour aider !"

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/26/s/0
msgctxt "Choix"
msgid "Yep, and we've even done the whole conversation before where we talk about it."
msgstr "Yep, et on a même déjà eu toute la conversation où on en parle."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/c-0/7
msgctxt "Luna"
msgid "Preparation came in handy."
msgstr "Se préparer a été utile."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/c-1/7
msgctxt "Luna"
msgid "Thank Snowwa you were one of the good ones."
msgstr "Remercie Snowwa, t'étais du bon côté."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/c-2/7
msgctxt "Luna"
msgid "Makes sense... maybe a million times."
msgstr "Logique... peut-être un million de fois."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/c-2/15/0/s/0
msgctxt "Choix"
msgid "Yep, I've spent one million times doing this already."
msgstr "Ouais, j'ai déjà passé un million de fois là-dessus."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/c-2/15/1/s/0
msgctxt "Choix"
msgid "Just one other time."
msgstr "Une seule autre fois."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/c-2/15/c-0/7
msgctxt "Luna"
msgid "Lasers and grates..."
msgstr "Des lasers et des grilles..."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/c-2/15/c-1/7
msgctxt "Luna"
msgid "Oh, so not too bad."
msgstr "Ah, alors c'est pas si terrible."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/c-2/15/c-1/15/0/s/0
msgctxt "Choix"
msgid "It's still pretty annoying."
msgstr "C'est quand même assez pénible."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/c-2/15/c-1/15/1/s/0
msgctxt "Choix"
msgid "Yeah, not so bad. Kinda fun."
msgstr "Ouais, c'est pas si mal. Plutôt marrant."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/c-2/15/c-1/15/2/s/0
msgctxt "Choix"
msgid "I have no opinion on this and just want to keep the quest going."
msgstr "J'ai pas d'avis là-dessus, je veux juste que la quête continue."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/c-2/15/c-1/15/c-0/7
msgctxt "Luna"
msgid "Sorry."
msgstr "Désolée."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/c-2/15/c-1/15/c-1/7
msgctxt "Luna"
msgid "Timeline crises always are..."
msgstr "Les crises temporelles sont toujours comme ça..."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/c-2/15/c-1/15/c-2/7 connie_console/connie_quest_true_stealth/0/g-0/c-3/63/c-1/18/c-0/15
msgctxt "Luna"
msgid "Understood."
msgstr "Compris."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-0/0
msgctxt "Luna"
msgid "Come here... let's find a place to hide from these Scroufs while you tell me what to do."
msgstr "Viens... trouvons un endroit où nous planquer de ces scroufs pendant que tu me dis quoi faire."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-0/8
msgctxt "Narrator"
msgid "Luna grabs at you and you both wiggle through an open fence near some scattered power grid structures."
msgstr "Luna vous attrape et vous vous faufilez tous les deux par une clôture ouverte, près de structures éparses d'un réseau électrique."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-0/16
msgctxt "Luna"
msgid "Just tell me where to go."
msgstr "Dis-moi juste où aller."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-0/24/s/0
msgctxt "Choix"
msgid "Crouch down by the Essner Transformer."
msgstr "Accroupis-toi près du Transformateur Essner."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-0/25/s/0
msgctxt "Choix"
msgid "I don't know yet... but we eventually go to the Upholder facility."
msgstr "Je sais pas encore... mais on finit par aller au complexe des Gardiens."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-0/c-3/7
msgctxt "Luna"
msgid "Oh..."
msgstr "Oh..."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-0/c-3/18
msgctxt "Luna"
msgid "There's a Kryzny Box!"
msgstr "Il y a une Boîte Kryzny !"

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-0/c-3/33
msgctxt "Luna"
msgid "With xeno-goggles!"
msgstr "Avec des xéno-lunettes !"

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-0/c-3/44
msgctxt "Luna"
msgid "Prools, you're good at this!"
msgstr "Prools, tu te débrouilles bien !"

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-0/c-3/55
msgctxt "Luna"
msgid "Okay, then what?"
msgstr "Bon, et ensuite ?"

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-0/c-3/63/0/s/0
msgctxt "Choix"
msgid "Then we go inside the Upholder facility."
msgstr "Ensuite, on entre dans le complexe des Gardiens."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-0/c-3/63/1/s/0
msgctxt "Choix"
msgid "Now, put on your xeno-goggles."
msgstr "Maintenant, mets tes xéno-lunettes."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-0/c-3/63/c-1/18/0/s/0
msgctxt "Choix"
msgid "Don't listen to the sirop-addled junkie who said no to wearing the goggles."
msgstr "N'écoute pas la droguée au sirop qui a refusé de mettre les lunettes."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-0/c-3/63/c-1/18/c-0/7
msgctxt "Luna"
msgid "Ah."
msgstr "Ah."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-0/c-3/63/c-1/18/c-0/26/c-0/7
msgctxt "Luna"
msgid "So?"
msgstr "Alors ?"

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-0/c-3/63/c-1/18/c-0/26/c-0/15/0/s/0
msgctxt "Choix"
msgid "And it always pulls you in with some sort of laser rifle thing. And you kinda, hang there until we make it out the other side."
msgstr "Et ça t'attrape toujours avec une sorte de fusil laser. Et tu restes, genre, suspendue là jusqu'à ce qu'on passe de l'autre côté."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-0/c-3/63/c-1/18/c-0/26/c-0/15/c-0/7
msgctxt "Luna"
msgid "Dru! This specificity is making me trust you..."
msgstr "Dru ! Cette précision me donne confiance en toi..."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-0/c-4/7
msgctxt "Luna"
msgid "That was where I planned on—"
msgstr "C'était justement là que je comptais—"

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-0/c-4/15
msgctxt "Narrator"
msgid "Luna is shocked to see something nearby flash."
msgstr "Luna a la surprise de voir quelque chose clignoter tout près."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-1/0
msgctxt "Luna"
msgid "That's... a Kryzny Box? Right by the Essner Transformer?"
msgstr "C'est... une Boîte Kryzny ? Juste à côté du Transformateur Essner ?"

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-1/8/s/0
msgctxt "Choix"
msgid "Kryzny Box?"
msgstr "Une Boîte Kryzny ?"

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-1/9/s/0
msgctxt "Choix"
msgid "Essner Transformer?"
msgstr "Le Transformateur Essner ?"

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-1/c-5/7
msgctxt "Luna"
msgid "Left behind by Kryzny & Associates - these things can contain all sorts of good gear."
msgstr "Laissée par Kryzny & Associés : ces trucs peuvent contenir toutes sortes de bon matos."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-1/c-6/7
msgctxt "Luna"
msgid "Yeah, Essner Co. made them - perfect for adapting electricity for low-grav."
msgstr "Ouais, c'est Essner Co. qui les fabriquait, parfaits pour adapter l'électricité à la faible gravité."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-2/0
msgctxt "Narrator"
msgid "Luna opens the box to find a pair of futuristic goggles - which float and spin in the air in front of you both."
msgstr "Luna ouvre la boîte et y trouve une paire de lunettes futuristes, qui flottent et tournoient dans l'air devant vous deux."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-2/8
msgctxt "Luna"
msgid "These are Mark 2 xeno-goggles!"
msgstr "Ce sont des xéno-lunettes Mark 2 !"

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-2/27
msgctxt "Luna"
msgid "An incredible upgrade. I'm keeping these!"
msgstr "Une amélioration incroyable. Je les garde !"

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-2/41
msgctxt "Luna"
msgid "Happy accidents, huh?"
msgstr "Les heureux hasards, hein ?"

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-2/49/s/0
msgctxt "Choix"
msgid "I guess so...?"
msgstr "Je suppose...?"

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-2/50/s/0
msgctxt "Choix"
msgid "Oh man those look so cool!"
msgstr "Oh là là, elles ont trop la classe !"

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-2/c-8/7
msgctxt "Luna"
msgid "I'm the only one who can wear them. You're already wearing some sorta xeno-tech on your slots!"
msgstr "Je suis la seule à pouvoir les porter. Tu as déjà de la xéno-technologie sur tes emplacements !"

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-2/c-8/15
msgctxt "Luna"
msgid "Looks kinda... lovely if I'm being honest."
msgstr "C'est plutôt... joli, pour être honnête."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-2/c-8/23/0/s/0
msgctxt "Choix"
msgid "Oh these things? These help me get dates."
msgstr "Ça ? Ça m'aide à avoir des rencards."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-2/c-8/23/1/s/0
msgctxt "Choix"
msgid "Then kiss me..."
msgstr "Alors embrasse-moi..."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-2/c-8/23/c-0/13
msgctxt "Luna"
msgid "Huh. Might be into that."
msgstr "Hm. Ça pourrait me plaire."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-2/c-8/23/c-0/21
msgctxt "Luna"
msgid "<i>After</i> the part where Selene goes full transcendental."
msgstr "<i>Après</i> la partie où Selene devient complètement transcendante."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-2/c-8/23/c-1/7
msgctxt "Luna"
msgid "We don't have time for flirting, all right?"
msgstr "On n'a pas le temps de flirter, d'accord ?"

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-3/0/s/0
msgctxt "Choix"
msgid "Glad to have shifted the timeline at least a little..."
msgstr "Au moins, la chronologie a un peu bougé..."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/g-3/1/s/0 connie_console/connie_quest_stealth_clue/0/g-0/11/s/0
msgctxt "Choix"
msgid "Got it."
msgstr "Compris."

# Traduction IA – à relire
#: connie_console/connie_quest_true_stealth/0/accidents/0
msgctxt "Luna"
msgid "Now... Let's get to the facility..."
msgstr "Maintenant... allons au complexe..."

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/0
msgctxt "Luna"
msgid "This advice sounds like something I would come up with myself."
msgstr "Ce conseil ressemble à un truc que j'aurais pu trouver toute seule."

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/22/0
msgctxt "Luna"
msgid "Ah! I can see so many more wavelengths now..."
msgstr "Ah ! Je vois tellement plus de longueurs d'onde maintenant..."

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/22/8
msgctxt "Luna"
msgid "And you're right - there's an Assassin Class about 7 besos away..."
msgstr "Et tu as raison : il y a un Gardien de classe Assassin à environ 7 besos..."

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/22/16
msgctxt "Luna"
msgid "We can get the drop on him!"
msgstr "On peut le prendre par surprise !"

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/22/24/s/0
msgctxt "Choix"
msgid "Take him out stealthily and close-up."
msgstr "Élimine-le discrètement, au corps à corps."

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/22/25/s/0
msgctxt "Choix"
msgid "Shoot him from afar."
msgstr "Tire-lui dessus de loin."

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/22/26/s/0
msgctxt "Choix"
msgid "Call him a big stupid-head!"
msgstr "Traite-le de gros débile !"

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/22/c-0/7
msgctxt "Luna"
msgid "On it..."
msgstr "Je m'en occupe..."

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/22/c-0/15
msgctxt "Narrator"
msgid "Luna stalks her prey - with the xeno-goggles and her own combat prowess she is like a moon-cat on the path of a moon-mouse."
msgstr "Luna traque sa proie : avec les xéno-lunettes et ses talents de combattante, elle est comme un chat lunaire sur la piste d'une souris lunaire."

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/22/c-1/7
msgctxt "Luna"
msgid "My favorite..."
msgstr "Mon préféré..."

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/22/c-1/15
msgctxt "Narrator"
msgid "With exaggerated relish, Luna lifts her rifle, cocks her eye slightly, and silently peers through the lenses."
msgstr "Avec un plaisir exagéré, Luna lève son fusil, plisse légèrement l'oeil et regarde en silence à travers les lentilles."

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/22/c-1/23
msgctxt "Luna"
msgid "He's done."
msgstr "Il est fini."

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/22/c-2/7
msgctxt "Luna"
msgid "I don't know, time-tripper."
msgstr "Je sais pas, toi qui voyages dans le temps."

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/22/c-2/15
msgctxt "Luna"
msgid "You may have knowledge I cannot comprehend, but even I know that's a terrible idea."
msgstr "Tu as peut-être des connaissances qui me dépassent, mais même moi je sais que c'est une idée désastreuse."

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/22/c-2/23
msgctxt "Luna"
msgid "I'll shoot him in the face from here."
msgstr "Je vais lui tirer en pleine face d'ici."

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/g-0/0
msgctxt "Narrator"
msgid "With the coast clear, the two of you stealthily walk the corridors until you reach an office right before what seems to be the terminus of the compound."
msgstr "La voie libre, vous parcourez discrètement les couloirs jusqu'à atteindre un bureau juste avant ce qui semble être le bout du complexe."

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/g-0/8
msgctxt "Luna"
msgid "Is this the furthest we've ever gotten?"
msgstr "C'est le plus loin qu'on ait jamais été ?"

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/g-0/16/s/0
msgctxt "Choix"
msgid "Yes, this is new from here..."
msgstr "Oui, c'est nouveau à partir d'ici..."

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/g-0/17/s/0
msgctxt "Choix"
msgid "No. We've been here before."
msgstr "Non. On a déjà été ici."

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/g-0/c-3/7
msgctxt "Luna"
msgid "Excellent."
msgstr "Excellent."

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/g-0/c-4/7
msgctxt "Luna"
msgid "Spratz. Thought for sure that was some new rift being created in the timelines..."
msgstr "Spratz. J'étais sûre que c'était une nouvelle faille qui se créait dans les chronologies..."

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/g-1/0
msgctxt "Luna"
msgid "Right now, we've got a chance to get ready before the battle against Selene."
msgstr "Pour l'instant, on a une chance de se préparer avant le combat contre Selene."

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/g-1/8
msgctxt "Luna"
msgid "There's a workshop table here and we can get crafting... or go straight to the final battle."
msgstr "Il y a un établi ici : on peut fabriquer des trucs... ou aller direct au combat final."

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/g-1/16/s/0
msgctxt "Choix"
msgid "Let's make something. There's sure to be something useful."
msgstr "Fabriquons quelque chose. Ça sera forcément utile."

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/g-1/c-5/7 connie_console/connie_quest_true_crafting/0/g-1/c-6/31/c-0/7
msgctxt "Luna"
msgid "What recipe should we make?"
msgstr "Quelle recette on fabrique ?"

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/g-1/c-6/7
msgctxt "Luna"
msgid "We didn't lose anything getting in here."
msgstr "On n'a rien perdu en entrant ici."

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/g-1/c-6/15
msgctxt "Luna"
msgid "I've been hoarding for a while on this playthrough, so practically infinite Globules, Wood, and Scrouf skins."
msgstr "J'ai accumulé pendant un moment sur cette partie, donc des Globules, du Bois et des peaux de scrouf quasi infinis."

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/g-1/c-6/23
msgctxt "Luna"
msgid "Low-level loot, but can make high-level stuff."
msgstr "Du butin de bas niveau, mais ça permet de fabriquer du matériel de haut niveau."

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/g-1/c-6/31/0/s/0
msgctxt "Choix"
msgid "Let's make something."
msgstr "Fabriquons quelque chose."

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/g-1/c-6/31/1/s/0
msgctxt "Choix"
msgid "Let's get to the final boss."
msgstr "Allons au boss final."

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/g-1/c-6/31/c-1/7
msgctxt "Luna"
msgid "I'm not complaining."
msgstr "Je ne m'en plains pas."

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/g-2/0
msgctxt "Luna"
msgid "All right... lemme just put them together and..."
msgstr "Bon... laisse-moi juste les assembler et..."

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/g-2/11/b/1
msgctxt "Luna"
msgid "We did it! A Harmonic Stratospire!"
msgstr "On l'a fait ! Une Stratospire Harmonique !"

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/g-2/12/b/1
msgctxt "Luna"
msgid "That much Scrouf skin will be great for making this aerodynamic and whisper quiet."
msgstr "Autant de peau de scrouf, ce sera parfait pour la rendre aérodynamique et silencieuse comme un murmure."

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/g-2/13/b/1
msgctxt "Luna"
msgid "The Wood merged together forms a fantastic protective layer."
msgstr "Le Bois fusionné forme une fantastique couche protectrice."

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/g-2/14/b/1
msgctxt "Luna"
msgid "That many Globules... always seems to form in the shape of a hat."
msgstr "Autant de Globules... ça finit toujours par former un chapeau."

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/g-2/14/b/9
msgctxt "Luna"
msgid "Hats are always good defense!"
msgstr "Un chapeau, c'est toujours une bonne défense !"

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/g-2/15/b/1
msgctxt "Luna"
msgid "Oh wait. There's nothing at all."
msgstr "Oh, attends. Il n'y a rien du tout."

# Traduction IA – à relire
#: connie_console/connie_quest_true_crafting/0/g-2/16/b/1
msgctxt "Luna"
msgid "Now this... is an amazing new piece of armor. That'll help us in the battle ahead!"
msgstr "Ça, c'est une nouvelle pièce d'armure incroyable. Elle nous aidera dans la bataille à venir !"

# Traduction IA – à relire
#: connie_console/harmonic_options/0/0/s/0
msgctxt "Choix"
msgid "What the hell is a Stratospire? And why is it Harmonic?"
msgstr "C'est quoi, une Stratospire ? Et pourquoi elle est Harmonique ?"

# Traduction IA – à relire
#: connie_console/harmonic_options/0/1/s/0
msgctxt "Choix"
msgid "Is that really the best we could get?"
msgstr "C'est vraiment le mieux qu'on pouvait avoir ?"

# Traduction IA – à relire
#: connie_console/harmonic_options/0/2/s/0
msgctxt "Choix"
msgid "So the recipe for the legendary relic was just some Globules and Wood?"
msgstr "Donc la recette de la relique légendaire, c'était juste des Globules et du Bois ?"

# Traduction IA – à relire
#: connie_console/harmonic_options/0/c-0/7
msgctxt "Luna"
msgid "Oh, I thought you would have known, time-skipper that you are."
msgstr "Oh, je pensais que tu le saurais, toi qui sautes d'une époque à l'autre."

# Traduction IA – à relire
#: connie_console/harmonic_options/0/c-0/26
msgctxt "Luna"
msgid "That beam can erase a crack in the continuum for good."
msgstr "Ce faisceau peut effacer une fissure du continuum pour de bon."

# Traduction IA – à relire
#: connie_console/harmonic_options/0/c-0/34/0/s/0
msgctxt "Choix"
msgid "Let's get cracking!"
msgstr "Allons réparer cette fissure !"

# Traduction IA – à relire
#: connie_console/harmonic_options/0/c-0/34/1/s/0
msgctxt "Choix"
msgid "I love a good beam."
msgstr "J'adore un bon faisceau."

# Traduction IA – à relire
#: connie_console/harmonic_options/0/c-0/34/2/s/0
msgctxt "Choix"
msgid "Sure... I guess."
msgstr "Ouais... je suppose."

# Traduction IA – à relire
#: connie_console/harmonic_options/0/c-0/34/c-0/7
msgctxt "Luna"
msgid "Follow me..."
msgstr "Suis-moi..."

# Traduction IA – à relire
#: connie_console/harmonic_options/0/c-0/34/c-1/7
msgctxt "Luna"
msgid "Nothing better than beams."
msgstr "Rien de mieux que les faisceaux."

# Traduction IA – à relire
#: connie_console/harmonic_options/0/c-0/34/c-2/7
msgctxt "Luna"
msgid "I don't need you to care."
msgstr "J'ai pas besoin que tu t'en soucies."

# Traduction IA – à relire
#: connie_console/harmonic_options/0/c-0/34/c-2/15
msgctxt "Luna"
msgid "I'll care for both of us."
msgstr "Je m'en soucierai pour nous deux."

# Traduction IA – à relire
#: connie_console/harmonic_options/0/c-1/7
msgctxt "Luna"
msgid "I certainly think so! With this many resources we are bound to change the timeline."
msgstr "Je pense bien que oui ! Avec autant de ressources, on va forcément changer la chronologie."

# Traduction IA – à relire
#: connie_console/harmonic_options/0/c-2/7
msgctxt "Luna"
msgid "Don't forget the Scrouf skins."
msgstr "N'oublie pas les peaux de scrouf."

# Traduction IA – à relire
#: connie_console/harmonic_options/0/c-2/15/0/s/0
msgctxt "Choix"
msgid "Whatever."
msgstr "Peu importe."

# Traduction IA – à relire
#: connie_console/harmonic_options/0/c-2/15/1/s/0
msgctxt "Choix"
msgid "Let's do it Luna - once and for all."
msgstr "Allons-y Luna, une bonne fois pour toutes."

# Traduction IA – à relire
#: connie_console/harmonic_options/0/c-2/15/c-1/7
msgctxt "Luna"
msgid "Here we go..."
msgstr "C'est parti..."

# Traduction IA – à relire
#: connie_console/connie_quest_battle_clue/0/0
msgctxt "Luna"
msgid "Of course we've met - we've been about 17 hours into this questline!"
msgstr "Évidemment qu'on se connaît : ça fait environ 17 heures qu'on est dans cette suite de quêtes !"

# Traduction IA – à relire
#: connie_console/connie_quest_battle_clue/0/8/s/0
msgctxt "Choix"
msgid "No, we fell in love, remember?"
msgstr "Non, l'amour est né entre nous, tu te souviens ?"

# Traduction IA – à relire
#: connie_console/connie_quest_battle_clue/0/9/s/0
msgctxt "Choix"
msgid "No, we became friends... remember?"
msgstr "Non, on s'est liés d'amitié... tu te souviens ?"

# Traduction IA – à relire
#: connie_console/connie_quest_battle_clue/0/10/s/0
msgctxt "Choix"
msgid "We fought a huge boss battle - remember?"
msgstr "On s'est livré un énorme combat de boss, tu te souviens ?"

# Traduction IA – à relire
#: connie_console/connie_quest_battle_clue/0/11/s/0
msgctxt "Choix"
msgid "You... hated me."
msgstr "Tu... me détestais."

# Traduction IA – à relire
#: connie_console/connie_quest_battle_clue/0/g-0/0
msgctxt "Luna"
msgid "Uh... no? I would definitely remember something like that."
msgstr "Euh... non ? Je me souviendrais sûrement d'un truc pareil."

# Traduction IA – à relire
#: connie_console/connie_quest_battle_clue/0/g-0/8
msgctxt "Luna"
msgid "I've got quest updates and relationship statuses in my state-a-dex, anyway."
msgstr "J'ai les mises à jour de quête et les statuts de relation dans mon Statu-Dex, de toute façon."

# Traduction IA – à relire
#: connie_console/connie_quest_battle_clue/0/g-0/16
msgctxt "Luna"
msgid "And I don't see anything about an actual connection we've had aside from mission partners in here..."
msgstr "Et je ne vois rien qui parle d'un vrai lien entre nous, à part des partenaires de mission..."

# Traduction IA – à relire
#: connie_console/connie_quest_battle_clue/0/g-0/24/s/0
msgctxt "Choix"
msgid "But it happened I swear! How can I get you to believe me?"
msgstr "Mais c'est arrivé, je le jure ! Comment te le faire croire ?"

# Traduction IA – à relire
#: connie_console/connie_quest_battle_clue/0/g-0/25/s/0
msgctxt "Choix"
msgid "I'm not letting this go. You love me."
msgstr "Je lâche pas l'affaire. Tu m'aimes."

# Traduction IA – à relire
#: connie_console/connie_quest_battle_clue/0/g-0/26/s/0
msgctxt "Choix"
msgid "I'm not letting this go. We are friends."
msgstr "Je lâche pas l'affaire. On est amis."

# Traduction IA – à relire
#: connie_console/connie_quest_battle_clue/0/g-0/c-4/7
msgctxt "Luna"
msgid "All right, all right!"
msgstr "D'accord, d'accord !"

# Traduction IA – à relire
#: connie_console/connie_quest_battle_clue/0/g-0/c-4/26
msgctxt "Luna"
msgid "I'm familiar with the trope, okay?"
msgstr "Je connais le trope, ok ?"

# Traduction IA – à relire
#: connie_console/connie_quest_battle_clue/0/g-0/c-4/34
msgctxt "Luna"
msgid "When I was little, I thought up a secret password that ONLY a time-traveler would be able to tell me."
msgstr "Quand j'étais petite, j'avais imaginé un mot de passe secret que SEULE une personne voyageant dans le temps pourrait me dire."

# Traduction IA – à relire
#: connie_console/connie_quest_battle_clue/0/g-0/c-4/42
msgctxt "Luna"
msgid "The password for me is..."
msgstr "Mon mot de passe, c'est..."

# Traduction IA – à relire
#: connie_console/connie_quest_battle_clue/0/g-0/c-4/50
msgctxt "Luna"
msgid "Lingonberries."
msgstr "Airelles."

# Traduction IA – à relire
#: connie_console/connie_quest_battle_clue/0/g-0/c-4/61
msgctxt "Luna"
msgid "Just give that to me next time you see me, and I promise I'll believe whatever crupp you hash at me."
msgstr "Redis-le-moi la prochaine fois qu'on se voit, et je te promets de croire toutes les crupp que tu me sortiras."

# Traduction IA – à relire
#: connie_console/connie_quest_battle_clue/0/g-0/c-4/69/0/s/0
msgctxt "Choix"
msgid "'Lingonberries.' Got it."
msgstr "« Airelles ». Noté."

# Traduction IA – à relire
#: connie_console/connie_quest_battle_clue/0/g-0/c-4/69/c-0/14
msgctxt "Luna"
msgid "Now let's get back to blastin'!"
msgstr "Allez, retournons dégommer !"

# Traduction IA – à relire
#: connie_console/connie_quest_stealth_clue/0/4
msgctxt "Luna"
msgid "An Assassin Level Upholder... they've got digi-tech to keep themselves invisible."
msgstr "Un Gardien de niveau Assassin... il a de la techno numérique pour rester invisible."

# Traduction IA – à relire
#: connie_console/connie_quest_stealth_clue/0/12
msgctxt "Luna"
msgid "The only hard counter... xeno-goggles."
msgstr "Le seul antidote radical... les xéno-lunettes."

# Traduction IA – à relire
#: connie_console/connie_quest_stealth_clue/0/20/s/0
msgctxt "Choix"
msgid "Why didn't you use them?"
msgstr "Pourquoi tu les as pas utilisées ?"

# Traduction IA – à relire
#: connie_console/connie_quest_stealth_clue/0/21/s/0
msgctxt "Choix"
msgid "My fault for not telling you to put them on."
msgstr "C'est ma faute, j'ai oublié de te dire de les mettre."

# Traduction IA – à relire
#: connie_console/connie_quest_stealth_clue/0/22/s/0
msgctxt "Choix"
msgid "I told you to wear them!"
msgstr "Je t'avais dit de les mettre !"

# Traduction IA – à relire
#: connie_console/connie_quest_stealth_clue/0/c-0/7
msgctxt "Luna"
msgid "I was distracted, okay?"
msgstr "J'étais distraite, d'accord ?"

# Traduction IA – à relire
#: connie_console/connie_quest_stealth_clue/0/c-1/7
msgctxt "Luna"
msgid "C'mon, yail. Not your fault."
msgstr "Allez, pote. C'est pas ta faute."

# Traduction IA – à relire
#: connie_console/connie_quest_stealth_clue/0/c-1/15
msgctxt "Luna"
msgid "I should have been more aware."
msgstr "J'aurais dû être plus attentive."

# Traduction IA – à relire
#: connie_console/connie_quest_stealth_clue/0/c-2/7
msgctxt "Luna"
msgid "Yeah..."
msgstr "Ouais..."

# Traduction IA – à relire
#: connie_console/connie_quest_stealth_clue/0/g-0/3
msgctxt "Luna"
msgid "Look, next time around... just tell me: don't listen to the sirop-addled junkie who said no to wearing the goggles."
msgstr "Écoute, la prochaine fois... dis-moi juste : n'écoute pas la droguée au sirop qui a refusé de mettre les lunettes."

# Traduction IA – à relire
#: connie_console/connie_quest_stealth_clue/0/g-0/12/s/0
msgctxt "Choix"
msgid "You sure that'll work?"
msgstr "Tu es sûre que ça marchera ?"

# Traduction IA – à relire
#: connie_console/connie_quest_stealth_clue/0/g-0/c-4/7
msgctxt "Luna"
msgid "Yeah... I used to... partake sometimes."
msgstr "Ouais... j'en prenais, avant. De temps en temps."

# Traduction IA – à relire
#: connie_console/connie_quest_stealth_clue/0/g-0/c-4/15
msgctxt "Luna"
msgid "Ah, but that's grooshie talk. Let's get back to the mission."
msgstr "Ah, mais ça, c'est du grooshie. Revenons à la mission."

# Traduction IA – à relire
#: connie_console/connie_quest_stealth_clue/0/g-1/0
msgctxt "Luna"
msgid "We'll have to remember that for next time."
msgstr "Il faudra s'en souvenir pour la prochaine fois."

# Traduction IA – à relire
#: connie_console/connie_quest_stealth_clue/0/g-1/8
msgctxt "Luna"
msgid "Well. You will."
msgstr "Enfin. Toi, si."

# Traduction IA – à relire
#: connie_console/connie_quest_stealth_clue/0/g-1/16/s/0
msgctxt "Choix"
msgid "Anything for the mission..."
msgstr "Tout pour la mission..."

# Traduction IA – à relire
#: connie_console/connie_quest_stealth_clue/0/g-1/17/s/0
msgctxt "Choix"
msgid "As long as I can remember how to spell 'sirop.'"
msgstr "Du moment que je sais encore épeler « sirop »."

# Traduction IA – à relire
#: connie_console/connie_quest_stealth_clue/0/g-2/0
msgctxt "Luna"
msgid "Dreek. Can't believe we're here. Seems like a dead-end."
msgstr "Dreek. Je peux pas croire qu'on en soit là. On dirait une impasse."

# Traduction IA – à relire
#: connie_console/connie_quest_stealth_clue/0/g-2/11/s/0
msgctxt "Choix"
msgid "Damn. Is this going to be a wash, then?"
msgstr "Merde. Ça va être un fiasco, alors ?"

# Traduction IA – à relire
#: connie_console/connie_quest_stealth_clue/0/g-2/c-7/7
msgctxt "Luna"
msgid "Hey, you might disappear after this but I keep going."
msgstr "Hé, toi tu disparaîtras peut-être après ça, mais moi je continue."

# Traduction IA – à relire
#: connie_console/connie_quest_stealth_clue/0/g-2/c-7/15
msgctxt "Luna"
msgid "And I'm not planning on going anywhere - resources or not!"
msgstr "Et j'ai pas l'intention d'aller où que ce soit, avec ou sans ressources !"

# Traduction IA – à relire
#: connie_console/connie_quest_stealth_clue/0/g-2/c-7/23
msgctxt "Luna"
msgid "Speaking of..."
msgstr "En parlant de ça..."

# Traduction IA – à relire
#: connie_console/connie_quest_stealth_clue/0/g-2/c-7/31
msgctxt "Luna"
msgid "You want to see if there's a workbench?"
msgstr "Tu veux voir s'il y a un établi ?"

# Traduction IA – à relire
#: connie_console/connie_quest_stealth_clue/0/g-2/c-7/39/0/s/0
msgctxt "Choix"
msgid "There is, down the second corridor."
msgstr "Il y en a un, au fond du deuxième couloir."

# Traduction IA – à relire
#: connie_console/connie_quest_stealth_clue/0/g-2/c-7/39/1/s/0
msgctxt "Choix"
msgid "Let's just get straight to the boss battle."
msgstr "Allons direct au combat de boss."

# Traduction IA – à relire
#: connie_console/connie_quest_stealth_clue/0/g-2/c-7/39/c-0/7
msgctxt "Luna"
msgid "All right."
msgstr "D'accord."

# Traduction IA – à relire
#: connie_console/connie_quest_stealth_clue/0/g-2/c-7/39/c-1/7
msgctxt "Luna"
msgid "I can't wait..."
msgstr "J'ai hâte..."

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/0
msgctxt "Narrator"
msgid "As you step into the terminus of the compound you can already feel a difference in the air. It's crackling with potential energy..."
msgstr "En pénétrant dans le bout du complexe, vous sentez déjà une différence dans l'air. Il crépite d'énergie potentielle..."

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/8
msgctxt "Selene"
msgid "I knew you'd be coming here. All the Regolith you would ever want - and all of the Selene you could ever need."
msgstr "Je savais que tu viendrais ici. Tout le Régolithe dont tu pourrais rêver, et toute la Selene dont tu pourrais avoir besoin."

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/22
msgctxt "Selene"
msgid "For what reason? All I'm here for is the sweet profit, banya."
msgstr "Pour quelle raison ? Je suis ici uniquement pour le doux profit, banya."

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/30
msgctxt "Luna"
msgid "Ever seen one of these?"
msgstr "Tu en as déjà vu un ?"

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/47
msgctxt "Narrator"
msgid "Luna holds aloft the Stratospire - it glows ominously."
msgstr "Luna brandit la Stratospire, qui rougeoie d'un éclat sinistre."

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/55
msgctxt "Selene"
msgid "How... did you get one of those?"
msgstr "Comment... as-tu mis la main sur ça ?"

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/69
msgctxt "Luna"
msgid "You messed with temporal energy and trapped me in here with you forever. Playing out the one pathway where I always reset."
msgstr "Tu as bidouillé l'énergie temporelle et tu m'as piégée ici avec toi pour toujours. À rejouer la seule voie où je me réinitialise toujours."

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/83
msgctxt "Luna"
msgid "Thinking that I would never be able to get the one thing to stop it because you kept it from me secretly."
msgstr "En pensant que je ne pourrais jamais obtenir la seule chose capable d'y mettre fin, parce que tu me l'avais cachée en secret."

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/91
msgctxt "Luna"
msgid "But you didn't count on one thing."
msgstr "Mais tu n'avais pas prévu une chose."

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/99
msgctxt "Selene"
msgid "What..."
msgstr "Quoi..."

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/113/s/0
msgctxt "Choix"
msgid "Me!"
msgstr "Moi !"

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/114/s/0
msgctxt "Choix"
msgid "A little something called 'wanting to date a video game console'."
msgstr "Un petit truc qui s'appelle « vouloir sortir avec une console de jeux vidéo »."

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/115/s/0
msgctxt "Choix"
msgid "Persistence, and curiosity."
msgstr "De la persévérance, et de la curiosité."

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/c-0/7
msgctxt "Selene"
msgid "The NPC?"
msgstr "Le PNJ ?"

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/c-0/15/b/1
msgctxt "Selene"
msgid "I never thought he was anything special..."
msgstr "Je pensais pas qu'il avait quoi que ce soit de spécial..."

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/c-0/16/b/1
msgctxt "Selene"
msgid "I never thought she was anything special..."
msgstr "Je pensais pas qu'elle avait quoi que ce soit de spécial..."

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/c-0/17/b/1
msgctxt "Selene"
msgid "I never thought they were anything special..."
msgstr "Je pensais pas qu'iel avait quoi que ce soit de spécial..."

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/c-1/7
msgctxt "Selene"
msgid "What the hell does that mean??"
msgstr "Qu'est-ce que ça veut dire, bordel ??"

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/c-2/7
msgctxt "Selene"
msgid "Nothing compared to profit, drizo."
msgstr "Rien comparé au profit, drizo."

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/g-0/3
msgctxt "Selene"
msgid "Krokk. My plan... all ruined."
msgstr "Krokk. Mon plan... réduit à néant."

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/g-0/14
msgctxt "Selene"
msgid "Just kidding of course. There's no way you have the innate strength to use that thing."
msgstr "Je plaisante, bien sûr. Tu n'as pas la force innée pour te servir de cette chose."

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/g-0/25
msgctxt "Celestia"
msgid "<w>NO. BUT I DO.</w>"
msgstr "<w>NON. MAIS MOI, SI.</w>"

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/g-0/53
msgctxt "Narrator"
msgid "From out of the crack in the cave wall, Celestia in her scaled glory crawls out slowly, magnificently."
msgstr "Surgissant de la fissure dans la paroi de la grotte, Celestia, dans sa gloire écailleuse, rampe lentement, magnifiquement."

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/g-0/67
msgctxt "Celestia"
msgid "<w>YOU HAVE DONE IT CONNIE. YOU HAVE BROUGHT THE BALANCE TO THE TIMELINES.</w>"
msgstr "<w>TU Y ES ARRIVÉE, CONNIE. TU AS APPORTÉ L'ÉQUILIBRE AUX CHRONOLOGIES.</w>"

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/g-0/75
msgctxt "Celestia"
msgid "<w>AND YOU HAVE BUILT MY DEVICE.</w>"
msgstr "<w>ET TU AS CONSTRUIT MON APPAREIL.</w>"

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/g-0/83
msgctxt "Luna"
msgid "Connie...?"
msgstr "Connie... ?"

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/g-0/100
msgctxt "Selene"
msgid "Who the hell?"
msgstr "C'est qui, bordel ?"

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/g-0/114
msgctxt "Celestia"
msgid "<w>THE PIECES ARE ALL HERE. HUMAN. ENEMY. HERO. GODDESS.</w>"
msgstr "<w>TOUTES LES PIÈCES SONT LÀ. HUMAIN. ENNEMI. HÉROS. DÉESSE.</w>"

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/g-0/128
msgctxt "Celestia"
msgid "<w>PLAYER AND PLAYED.</w>"
msgstr "<w>JOUEUR ET JOUÉ.</w>"

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/g-0/136 connie_console/connie_quest_true_battle/0/g-0/188
msgctxt "Celestia"
msgid "<w>ALL SHARDS OF THE SAME SOUL.</w>"
msgstr "<w>TOUS DES ÉCLATS D'UNE MÊME ÂME.</w>"

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/g-0/144
msgctxt "Celestia"
msgid "<w>CONNIE'S.</w>"
msgstr "<w>CELLE DE CONNIE.</w>"

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/g-0/152
msgctxt "Luna"
msgid "Wait... I remember..."
msgstr "Attends... je me souviens..."

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/g-0/166
msgctxt "Narrator"
msgid "Luna's eyes drift upward as the Harmonic Stratospire floats toward Celestia and bolts of pure temporal energy begin to streak outward."
msgstr "Le regard de Luna se perd vers le haut tandis que la Stratospire Harmonique flotte vers Celestia et que des éclairs d'énergie temporelle pure commencent à jaillir."

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/g-0/177
msgctxt "Luna"
msgid "I was... I am..."
msgstr "J'étais... je suis..."

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/g-0/205
msgctxt "Narrator"
msgid "Luna's eyes become clear - full of fire. She raises her hands up in a gesture of glory."
msgstr "Le regard de Luna s'éclaircit, plein de feu. Elle lève les mains en un geste de gloire."

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/g-0/219
msgctxt "Connie Soul"
msgid "I am Connie Soul!"
msgstr "Je suis Connie Soul !"

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/g-0/233
msgctxt "Connie Soul"
msgid "I am Video Games!"
msgstr "Je suis le Jeu Vidéo !"

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/g-0/247
msgctxt "Narrator"
msgid "Selene is taken aback and stands up, ready to fight."
msgstr "Selene, saisie, se redresse, prête à se battre."

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/g-0/261
msgctxt "Selene"
msgid "No... You were never supposed to know your power."
msgstr "Non... Tu n'étais pas censée connaître ton pouvoir."

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/g-0/269
msgctxt "Connie Soul"
msgid "There's no power. It's all mirrors upon mirrors Selene, all leading back to you."
msgstr "Il n'y a aucun pouvoir. C'est des miroirs et encore des miroirs, Selene, qui ramènent tous à toi."

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/g-0/283
msgctxt "Celestia"
msgid "<w>TO US.</w>"
msgstr "<w>À NOUS.</w>"

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/g-0/297
msgctxt "Selene"
msgid "Stop it!"
msgstr "Arrête !"

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/g-0/311
msgctxt "Connie Soul"
msgid "Celestia - Selene - Luna - All."
msgstr "Celestia - Selene - Luna - Toutes."

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/g-0/325
msgctxt "Connie Soul"
msgid "It's time... to reintegrate."
msgstr "Il est temps... de nous réintégrer."

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/g-0/333
msgctxt "Narrator"
msgid "The Stratospire's sizzling energy explodes into an array of rainbow beams, covering the mine entrance with kaleidoscopic colors."
msgstr "L'énergie crépitante de la Stratospire explose en un déploiement de faisceaux arc-en-ciel, couvrant l'entrée de la mine de couleurs kaléidoscopiques."

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/g-0/350/s/0
msgctxt "Choix"
msgid "I have no idea what's going on!"
msgstr "J'ai aucune idée de ce qui se passe !"

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/g-0/351/s/0
msgctxt "Choix"
msgid "Do it Connie! Reintegrate!"
msgstr "Vas-y Connie ! Réintègre-toi !"

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/g-0/c-3/7
msgctxt "Celestia"
msgid "<w>IT'S THE END OF A VIDEO GAME.</w>"
msgstr "<w>C'EST LA FIN D'UN JEU VIDÉO.</w>"

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/g-0/c-3/18
msgctxt "Connie Soul"
msgid "No one ever knows what's going on."
msgstr "Personne ne sait jamais ce qui se passe."

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/g-0/c-4/7
msgctxt "Connie Soul"
msgid "That's it! That's right!"
msgstr "Ça y est ! C'est ça !"

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/g-0/c-4/18
msgctxt "Celestia"
msgid "<w>YOUR QUEST IS ALMOST COMPLETE.</w>"
msgstr "<w>TA QUÊTE EST PRESQUE ACCOMPLIE.</w>"

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/g-1/0
msgctxt "Selene"
msgid "I refuse!"
msgstr "Je refuse !"

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/g-1/14
msgctxt "Celestia"
msgid "<w>SHE RESISTS.</w>"
msgstr "<w>ELLE RÉSISTE.</w>"

# Traduction IA – à relire
#: connie_console/connie_quest_true_battle/0/g-1/25
msgctxt "Connie Soul"
msgid "You're still a part of this. Show your support!"
msgstr "Tu fais toujours partie de tout ça. Montre ton soutien !"

# Traduction IA – à relire
#: connie_console/connie_decision/0/0
msgctxt "Celestia"
msgid "<w>COMPLETE THE CEREMONY.</w>"
msgstr "<w>ACHÈVE LA CÉRÉMONIE.</w>"

# Traduction IA – à relire
#: connie_console/connie_decision/0/8/s/0
msgctxt "Choix"
msgid "Connie Soul - become complete!"
msgstr "Connie Soul, deviens complète !"

# Traduction IA – à relire
#: connie_console/connie_decision/0/9/s/0
msgctxt "Choix"
msgid "Everything leads to love!"
msgstr "Tout mène à l'amour !"

# Traduction IA – à relire
#: connie_console/connie_decision/0/10/s/0
msgctxt "Choix"
msgid "Trust in yourself! Trust in everyone!"
msgstr "Aie confiance en toi ! Aie confiance en tous !"

# Traduction IA – à relire
#: connie_console/connie_decision/0/11/s/0
msgctxt "Choix"
msgid "<i>Put your hand through the beam to see what it feels like.</i>"
msgstr "<i>Passe ta main à travers le faisceau pour voir l'effet que ça fait.</i>"

# Traduction IA – à relire
#: connie_console/connie_decision/0/c-3/7
msgctxt "Connie Soul"
msgid "What??"
msgstr "Quoi ??"

# Traduction IA – à relire
#: connie_console/connie_decision/0/c-3/18
msgctxt "Luna"
msgid "NO!"
msgstr "NON !"

# Traduction IA – à relire
#: connie_console/connie_decision/0/c-3/35
msgctxt "Selene"
msgid "What... is... happening???"
msgstr "Qu'est-ce... qui... se passe ???"

# Traduction IA – à relire
#: connie_console/connie_decision/0/c-3/52
msgctxt "Narrator"
msgid "While it certainly feels 'cool' to have interrupted the reintegration beam, this act has rendered the ceremony completely off-balance."
msgstr "S'il est certes « cool » d'avoir interrompu le faisceau de réintégration, cet acte a complètement déséquilibré la cérémonie."

# Traduction IA – à relire
#: connie_console/connie_decision/0/c-3/60
msgctxt "Luna"
msgid "We.. are..."
msgstr "Nous... sommes..."

# Traduction IA – à relire
#: connie_console/connie_decision/0/c-3/71
msgctxt "Connie Soul"
msgid "Permanently..."
msgstr "Définitivement..."

# Traduction IA – à relire
#: connie_console/connie_decision/0/c-3/82
msgctxt "Selene"
msgid "Separate."
msgstr "Séparées."

# Traduction IA – à relire
#: connie_console/connie_decision/0/c-3/93
msgctxt "Narrator"
msgid "The timeline shatters and cracks - never to be repaired again."
msgstr "La chronologie se brise et se fissure, sans jamais pouvoir être réparée."

# Traduction IA – à relire
#: connie_console/connie_decision/0/c-3/109
msgctxt "Connie Soul"
msgid "I hope you're happy."
msgstr "J'espère que ça te fait plaisir."

# Traduction IA – à relire
#: connie_console/connie_decision/0/c-3/117/0/s/0
msgctxt "Choix"
msgid "That felt really cool on my hand though!"
msgstr "Ça m'a fait un effet super cool sur la main, quand même !"

# Traduction IA – à relire
#: connie_console/connie_decision/0/c-3/117/1/s/0
msgctxt "Choix"
msgid "I... don't know what came over me."
msgstr "Je... sais pas ce qui m'a pris."

# Traduction IA – à relire
#: connie_console/connie_decision/0/c-3/117/c-1/7
msgctxt "Luna"
msgid "We do."
msgstr "Nous, si."

# Traduction IA – à relire
#: connie_console/connie_decision/0/c-3/117/c-1/15
msgctxt "Assassin Upholder"
msgid "<w>h a t e h a t e h a t e</w>"
msgstr "<w>h a i n e h a i n e h a i n e</w>"

# Traduction IA – à relire
#: connie_console/connie_quest_true_finale/0/6
msgctxt "Narrator"
msgid "The Stratospire's shuddering reaches a breaking point..."
msgstr "Les tremblements de la Stratospire atteignent leur point de rupture..."

# Traduction IA – à relire
#: connie_console/connie_quest_true_finale/0/17
msgctxt "Narrator"
msgid "...and with one final gasp, explodes into a dizzying array of sounds, colors, and shapes, as the characters, sets, sounds, and UI all melt into Connie Soul, who stands before you."
msgstr "...et dans un dernier soupir, elle explose en un déploiement vertigineux de sons, de couleurs et de formes, tandis que les personnages, les décors, les sons et l'interface se fondent tous en Connie Soul, qui se tient devant vous."

# Traduction IA – à relire
#: connie_console/connie_quest_true_finale/0/34
msgctxt "Celestia"
msgid "<w>CONGRATULATIONS. YOU WIN...</w>"
msgstr "<w>FÉLICITATIONS. TU GAGNES...</w>"

# Traduction IA – à relire
#: connie_console/connie_quest_true_finale/0/45
msgctxt "Connie Soul"
msgid "You saw every part of me, human... the good, and the bad."
msgstr "Tu as vu chaque partie de moi, {{humain|humaine|humain·e}}... le bon, et le mauvais."

# Traduction IA – à relire
#: connie_console/connie_quest_true_finale/0/53
msgctxt "Connie Soul"
msgid "I'm Luna, Selene. Celestia, too... even the Upholders."
msgstr "Je suis Luna, Selene. Celestia aussi... même les Gardiens."

# Traduction IA – à relire
#: connie_console/connie_quest_true_finale/0/61
msgctxt "Connie Soul"
msgid "Do you... love me? Even with those bad parts?"
msgstr "Est-ce que tu... m'aimes ? Même avec ces mauvaises parties ?"

# Traduction IA – à relire
#: connie_console/connie_quest_true_finale/0/69/s/0
msgctxt "Choix"
msgid "You know I do Connie. What kind of game wouldn't have an antagonist?"
msgstr "Tu sais bien que oui, Connie. Quel genre de jeu n'aurait pas d'antagoniste ?"

# Traduction IA – à relire
#: connie_console/connie_quest_true_finale/0/70/s/0
msgctxt "Choix"
msgid "I wouldn't say love, but play buddies? Definitely."
msgstr "Je dirais pas amour, mais potes de jeu ? Carrément."

# Traduction IA – à relire
#: connie_console/connie_quest_true_finale/0/c-0/7
msgctxt "Connie Soul"
msgid "You're right."
msgstr "Tu as raison."

# Traduction IA – à relire
#: connie_console/connie_quest_true_finale/0/c-0/15 connie_console/connie_quest_true_finale/0/c-1/7
msgctxt "Connie Soul"
msgid "Thank you. Hopefully you'll be my player forever."
msgstr "Merci. J'espère que tu resteras {{mon joueur|ma joueuse|mon joueur·se}} pour toujours."

# Traduction IA – à relire
#: connie_console/connie_quest_true_finale/0/c-0/23
msgctxt "Connie Soul"
msgid "I won't forget you..."
msgstr "Je ne t'oublierai pas..."

# Traduction IA – à relire
#: connie_console/connie_quest_true_finale/0/c-1/15
msgctxt "Connie Soul"
msgid "You did a fantastic job beating my game."
msgstr "Tu as fait un travail fantastique en venant à bout de mon jeu."

# Traduction IA – à relire
#: connie_console/connie_false_endings/0/6
msgctxt "Luna"
msgid "I'd love to be friends with you."
msgstr "J'adorerais être amie avec toi."

# Traduction IA – à relire
#: connie_console/connie_false_endings/0/14 connie_console/luna_love_ending/0/c-1/15
msgctxt "Luna"
msgid "Even though it can be dangerous out there in Novaya Moskva, having a real friend by your side means you keep your K/D ratio way down."
msgstr "Même si ça peut être dangereux là-bas, à Novaya Moskva, avoir une vraie amie à tes côtés, ça veut dire que ton ratio K/D reste bien bas."

# Traduction IA – à relire
#: connie_console/connie_false_endings/0/22/s/0
msgctxt "Choix"
msgid "Sounds good, Luna!"
msgstr "Ça me va, Luna !"

# Traduction IA – à relire
#: connie_console/connie_false_endings/0/23/s/0 connie_console/luna_love_ending/0/18/s/0
msgctxt "Choix"
msgid "Only if it sticks this time."
msgstr "Seulement si ça tient cette fois."

# Traduction IA – à relire
#: connie_console/connie_false_endings/0/c-0/7 connie_console/luna_love_ending/0/g-0/0
msgctxt "Luna"
msgid "Come back any time and let's play again!"
msgstr "Reviens quand tu veux, et on rejouera !"

# Traduction IA – à relire
#: connie_console/connie_false_endings/0/c-1/7 connie_console/luna_love_ending/0/c-2/7
msgctxt "Luna"
msgid "Oh it'll stick all right, fantastic traveler."
msgstr "Oh, ça tiendra, tu peux me croire, {{fantastique voyageur|fantastique voyageuse|fantastique voyageur·se}}."

# Traduction IA – à relire
#: connie_console/connie_false_endings/0/c-1/27 connie_console/luna_love_ending/0/c-2/24
msgctxt "Luna"
msgid "Next time you come back - I'll remember you for sure."
msgstr "La prochaine fois que tu reviens, je me souviendrai de toi, c'est sûr."

# Traduction IA – à relire
#: connie_console/luna_love_ending/0/0
msgctxt "Luna"
msgid "If you'll have me... can we take this to a more romantic level?"
msgstr "Si tu veux de moi... on pourrait passer à quelque chose de plus romantique ?"

# Traduction IA – à relire
#: connie_console/luna_love_ending/0/8
msgctxt "Luna"
msgid "Don't think I didn't notice those little flirting responses you gave."
msgstr "Crois pas que je n'ai pas remarqué ces petites réponses de flirt que tu m'as données."

# Traduction IA – à relire
#: connie_console/luna_love_ending/0/16/s/0
msgctxt "Choix"
msgid "I did it because you're hot, Luna."
msgstr "Je l'ai fait parce que tu es canon, Luna."

# Traduction IA – à relire
#: connie_console/luna_love_ending/0/17/s/0
msgctxt "Choix"
msgid "Oh, I just did that to be nice."
msgstr "Oh, j'ai juste fait ça pour être sympa."

# Traduction IA – à relire
#: connie_console/luna_love_ending/0/c-0/7
msgctxt "Luna"
msgid "Whatever works, yail."
msgstr "Tout ce qui marche, pote."

# Traduction IA – à relire
#: connie_console/luna_love_ending/0/c-1/7
msgctxt "Luna"
msgid "That's fine, I'd still love to be friends with you."
msgstr "Pas de souci, j'adorerais quand même être ton amie."

# Traduction IA – à relire
#: connie_console/connie_hate_joiner/40
msgctxt "Reggie"
msgid "Game over..."
msgstr "Game over..."

# Traduction IA – à relire
#: connie_console/luna_hate_joiner/3
msgctxt "Luna"
msgid "Ugh. Get out of here, creep."
msgstr "Beurk. Dégage d'ici, espèce de pervers."

# Traduction IA – à relire
#: connie_console/connie_love_return/0/6
msgctxt "Connie Soul"
msgid "My sweetest yail..."
msgstr "Mon chou..."

# Traduction IA – à relire
#: connie_console/connie_love_return/0/14
msgctxt "Connie Soul"
msgid "I bet it makes you happy to hear me say that."
msgstr "Je parie que ça te fait plaisir de m'entendre dire ça."

# Traduction IA – à relire
#: connie_console/connie_love_return/0/22 connie_console/connie_friend_return/0/22
msgctxt "Connie Soul"
msgid "I haven't forgotten you..."
msgstr "Tu es toujours dans ma mémoire..."

# Traduction IA – à relire
#: connie_console/connie_love_return/0/31/s/0
msgctxt "Choix"
msgid "It does. Always."
msgstr "Oui. Toujours."

# Traduction IA – à relire
#: connie_console/connie_love_return/0/32/s/0
msgctxt "Choix"
msgid "I'm ready to Realize you, Connie..."
msgstr "Je suis {{prêt|prête|prêt·e}} à te Réaliser, Connie..."

# Traduction IA – à relire
#: connie_console/connie_love_return/0/c-0/7 connie_console/connie_friend_return/0/c-0/7
msgctxt "Connie Soul"
msgid "Uh oh... maybe the timelines haven't stopped their fluctuations..."
msgstr "Oh oh... les chronologies n'ont peut-être pas fini de fluctuer..."

# Traduction IA – à relire
#: connie_console/connie_love_return/0/c-1/7
msgctxt "Connie Soul"
msgid "C'mon, let's boot up another adventure..."
msgstr "Allez, lançons une autre aventure..."

# Traduction IA – à relire
#: connie_console/connie_love_return/0/c-1/15
msgctxt "Narrator"
msgid "You spend your time interacting with Connie in the most romantic of ways - and your progress has been saved."
msgstr "Vous passez votre temps à interagir avec Connie de la façon la plus romantique qui soit, et votre progression a été sauvegardée."

# Traduction IA – à relire
#: connie_console/connie_friend_return/0/6
msgctxt "Connie Soul"
msgid "Well, it's my old battle companion back to see me."
msgstr "Eh bien, mon ancien partenaire de bataille vient me rendre visite."

# Traduction IA – à relire
#: connie_console/connie_friend_return/0/14
msgctxt "Connie Soul"
msgid "I bet it always makes you happy to hear me say that."
msgstr "Je parie que ça te fait toujours plaisir de m'entendre dire ça."

# Traduction IA – à relire
#: connie_console/connie_friend_return/0/31/s/0
msgctxt "Choix"
msgid "It's nice to know you're doing so well."
msgstr "C'est agréable de savoir que tu vas si bien."

# Traduction IA – à relire
#: connie_console/connie_friend_return/0/32/s/0
msgctxt "Choix"
msgid "I'm ready to Realize you, Connie.."
msgstr "Je suis {{prêt|prête|prêt·e}} à te Réaliser, Connie.."

# Traduction IA – à relire
#: connie_console/connie_friend_return/0/c-1/7
msgctxt "Connie Soul"
msgid "I am - and I'm excited to boot up another adventure..."
msgstr "C'est le cas, et j'ai hâte de lancer une autre aventure..."

# Traduction IA – à relire
#: connie_console/connie_friend_return/0/c-1/15
msgctxt "Narrator"
msgid "You spend your time interacting with your friend Connie, and your progress has been saved."
msgstr "Vous passez votre temps avec votre amie Connie, et votre progression a été sauvegardée."

# Traduction IA – à relire
#: connie_console/connie_hate_return/0/0
msgctxt "Connie Soul"
msgid "Shattered."
msgstr "Brisée."

# Traduction IA – à relire
#: connie_console/connie_hate_return/0/8
msgctxt "Luna"
msgid "I can't believe you."
msgstr "Je n'en reviens pas de toi."

# Traduction IA – à relire
#: connie_console/connie_hate_return/0/16
msgctxt "Connie Soul"
msgid "Bringing me into my full being, and then refusing to let me reintegrate."
msgstr "M'amener à mon plein être, puis refuser de me laisser me réintégrer."

# Traduction IA – à relire
#: connie_console/connie_hate_return/0/24/s/0
msgctxt "Choix"
msgid "Wasn't it kinda fun though?"
msgstr "C'était quand même un peu marrant, non ?"

# Traduction IA – à relire
#: connie_console/connie_hate_return/0/25/s/0
msgctxt "Choix"
msgid "<i>Load a previous save.</i> (USE EMPATHY CANDY)"
msgstr "<i>Charger une sauvegarde précédente.</i> (UTILISER UN BONBON D'EMPATHIE)"

# Traduction IA – à relire
#: connie_console/connie_hate_return/0/c-0/7
msgctxt "Grunt Upholder"
msgid "<w>GET OUT</w>"
msgstr "<w>DEHORS</w>"

# Traduction IA – à relire
#: connie_console/connie_hate_return/0/c-1/13
msgctxt "Luna"
msgid "You..."
msgstr "Tu..."

# Traduction IA – à relire
#: connie_console/connie_hate_return/0/c-1/24
msgctxt "Connie Soul"
msgid "Are..."
msgstr "Es en train de..."

# Traduction IA – à relire
#: connie_console/connie_hate_return/0/c-1/35
msgctxt "Selene"
msgid "Doing the impossible..."
msgstr "Accomplir l'impossible..."

# Traduction IA – à relire
#: connie_console/connie_hate_return/0/c-1/46
msgctxt "Narrator"
msgid "It shouldn't have been possible, but it was true. You were turning back the timelines, running them back to where you had previously gone wrong."
msgstr "Cela n'aurait pas dû être possible, mais c'était vrai. Vous remontiez les chronologies, les ramenant au point où vous aviez fait fausse route."

# Traduction IA – à relire
#: connie_console/connie_realize_join/0/0
msgctxt "Connie Soul"
msgid "To become real? Like, like, a human? A singular human?"
msgstr "Devenir réelle ? Genre, genre, une humaine ? Une seule humaine ?"

# Traduction IA – à relire
#: connie_console/connie_realize_join/0/8
msgctxt "Connie Soul"
msgid "I think I'd like that... as long as I still get to play all my different roles."
msgstr "Je crois que ça me plairait... tant que je peux continuer à jouer tous mes différents rôles."

# Traduction IA – à relire
#: connie_console/connie_realize_join/0/25/s/0
msgctxt "Choix"
msgid "Role-playing? They definitely have that in the real world."
msgstr "Du jeu de rôle ? Ils en ont forcément dans le monde réel."

# Traduction IA – à relire
#: connie_console/connie_realize_join/0/26/s/0
msgctxt "Choix"
msgid "You'll get to. Just not right now."
msgstr "Tu pourras. Mais pas tout de suite."

# Traduction IA – à relire
#: connie_console/connie_realize_join/0/c-1/10
msgctxt "Connie Soul"
msgid "No problem, yail. I'll be right here waiting for my next update."
msgstr "Pas de souci, pote. Je serai juste là, à attendre ma prochaine mise à jour."

# Traduction IA – à relire
#: connie_console/connie_realize_return/0/0
msgctxt "Connie Soul"
msgid "Hey, yail! You've got enough points to beat the high score?"
msgstr "Hé, pote ! T'as assez de points pour battre le meilleur score ?"

# Traduction IA – à relire
#: connie_console/connie_realize_return/0/17/s/0
msgctxt "Choix"
msgid "Dated reference, but okay."
msgstr "Référence un peu datée, mais d'accord."

# Traduction IA – à relire
#: connie_console/connie_realize_return/0/18/s/0
msgctxt "Choix"
msgid "Gotta get more points yet!"
msgstr "Il me faut encore plus de points !"

# Traduction IA – à relire
#: connie_console/connie_realize_return/0/c-0/13
msgctxt "Connie Soul"
msgid "I've been around a long time... longer than you might think..."
msgstr "Je suis là depuis longtemps... plus longtemps que tu ne le crois..."

# Traduction IA – à relire
#: connie_console/connie_realize_return/0/c-1/10
msgctxt "Connie Soul"
msgid "Get up those leaderboards!"
msgstr "Grimpe dans les classements !"

# Traduction IA – à relire
#: connie_console/connie_realize_begin/6/b/1
msgctxt "Skylar"
msgid "Starting with the video games, huh? Now that's real interactivity!"
msgstr "Tu commences par les jeux vidéo, hein ? Ça, c'est de la vraie interactivité !"

# Traduction IA – à relire
#: connie_console/connie_realize_begin/6/b/9
msgctxt "Skylar"
msgid "Here's hoping this works!"
msgstr "Pourvu que ça marche !"

# Traduction IA – à relire
#: connie_console/connie_realize_begin/7/b/1
msgctxt "Skylar"
msgid "Connie! Prepare to level up!"
msgstr "Connie ! Prépare-toi à monter de niveau !"

# Traduction IA – à relire
#: connie_console/connie_realize_begin/13
msgctxt "Narrator"
msgid "The spectral energy flows through your dateviators, and what was once merely a video game console, becomes...."
msgstr "L'énergie spectrale traverse vos Dateviators, et ce qui n'était jadis qu'une console de jeux vidéo devient..."

# Traduction IA – à relire
#: connie_console/connie_realized/0/3
msgctxt "Connie Soul"
msgid "Oh wow! These graphics are incredible!"
msgstr "Oh là là ! Ces graphismes sont incroyables !"

# Traduction IA – à relire
#: connie_console/connie_realized/0/14
msgctxt "Narrator"
msgid "Connie's gaze wanders all around the living room, taking in the extreme detail in the assets."
msgstr "Le regard de Connie parcourt tout le salon, absorbant l'incroyable niveau de détail des assets."

# Traduction IA – à relire
#: connie_console/connie_realized/0/22
msgctxt "Connie Soul"
msgid "They did a really good job on you..."
msgstr "Ils ont vraiment fait du bon boulot sur toi..."

# Traduction IA – à relire
#: connie_console/connie_realized/0/30/s/0
msgctxt "Choix"
msgid "Aw, thanks Connie. You look great."
msgstr "Aw, merci Connie. Tu es superbe."

# Traduction IA – à relire
#: connie_console/connie_realized/0/31/s/0
msgctxt "Choix"
msgid "Yeah... wanna see if they modeled anything under my clothes?"
msgstr "Ouais... tu veux voir s'ils ont modélisé quelque chose sous mes vêtements ?"

# Traduction IA – à relire
#: connie_console/connie_realized/0/c-0/7
msgctxt "Connie Soul"
msgid "But maybe more importantly... I <i>sound</i> great."
msgstr "Mais peut-être plus important encore... je <i>sonne</i> super bien."

# Traduction IA – à relire
#: connie_console/connie_love_divert/3
msgctxt "Connie Soul"
msgid "My favorite part - finding all the loose ends..."
msgstr "Ce que je préfère : dénicher toutes les failles..."

# Traduction IA – à relire
#: connie_console/connie_love_divert/14
msgctxt "Narrator"
msgid "Connie delights in just how interactive the human body can be—she tests every sensation and function, dedicating herself to the task of lovemaking with the sort of focus and expertise that would put even the most hardcore gamer to shame."
msgstr "Connie se délecte de voir à quel point le corps humain est interactif : elle teste chaque sensation et chaque fonction, se consacrant à l'art de l'amour avec une concentration et un savoir-faire qui feraient honte aux joueurs les plus acharnés."

# Traduction IA – à relire
#: connie_console/connie_love_divert/25
msgctxt "Narrator"
msgid "She speedruns your pleasure, mercilessly exploiting your every weakness to bring you to your peak in record time."
msgstr "Elle fait un speedrun de votre plaisir, exploitant sans pitié chacune de vos faiblesses pour vous mener au sommet en un temps record."

# Traduction IA – à relire
#: connie_console/connie_love_divert/33
msgctxt "Narrator"
msgid "It's not until the first rays of sun peek in through your curtains that Connie manages to let you rest, muttering something to herself about server maintenance."
msgstr "Ce n'est qu'aux premiers rayons du soleil filtrant à travers vos rideaux que Connie vous laisse enfin vous reposer, en marmonnant quelque chose à propos de la maintenance des serveurs."

# Traduction IA – à relire
#: connie_console/connie_love_divert/41
msgctxt "Narrator"
msgid "As you watch her set off to start her own life, there's no doubt in your mind that Connie's passion and dedication will take her to the top of the leaderboards no matter what she chooses to do."
msgstr "Alors que vous la regardez partir commencer sa propre vie, aucun doute : la passion et le dévouement de Connie la mèneront en tête des classements, quoi qu'elle choisisse de faire."

# Traduction IA – à relire
#: connie_console/connie_love_join/0
msgctxt "Connie Soul"
msgid "I think I'm going to use these versatile pipes of mine to make a living as a voice actor!"
msgstr "Je crois que je vais mettre mes cordes vocales polyvalentes au service d'une carrière de comédienne de doublage !"

# Traduction IA – à relire
#: connie_console/connie_love_join/8
msgctxt "Narrator"
msgid "Perhaps one of the most dangerous paths one of today's humans can take. In the age of AI, voice actors were a rarer breed than any before..."
msgstr "Peut-être l'une des voies les plus dangereuses qu'un humain d'aujourd'hui puisse emprunter. À l'ère de l'IA, les comédiens de doublage étaient une espèce plus rare que jamais..."

# Traduction IA – à relire
#: connie_console/connie_love_join/16
msgctxt "Narrator"
msgid "But if there was anyone who could do it, it was Connie Soul."
msgstr "Mais si quelqu'un pouvait y arriver, c'était bien Connie Soul."

# Traduction IA – à relire
#: connie_console/connie_love_join/27
msgctxt "Narrator"
msgid "Her auditions took the industry by storm - no one could believe that all of these characters were the same person."
msgstr "Ses auditions firent sensation dans le métier : personne n'arrivait à croire que tous ces personnages étaient interprétés par la même personne."

# Traduction IA – à relire
#: connie_console/connie_love_join/35
msgctxt "Connie Soul"
msgid "Trust me, I'm good at seeing things from all different perspectives."
msgstr "Crois-moi, je sais voir les choses sous tous les angles."

# Traduction IA – à relire
#: connie_console/connie_love_join/43
msgctxt "Narrator"
msgid "Her time in the booth was legendary - and she always fought for the rights of human actors over all."
msgstr "Son passage en cabine fut légendaire, et elle défendit toujours avant tout les droits des acteurs humains."

# Traduction IA – à relire
#: connie_console/connie_love_join/51
msgctxt "Narrator"
msgid "One particularly potent social media campaign she led embarrassed the video game industry entirely. Profile pictures were changed at an unprecedented rate - catching the attention of even the sleepiest of executives."
msgstr "Une campagne particulièrement virulente qu'elle mena sur les réseaux sociaux couvrit de honte toute l'industrie du jeu vidéo. Les photos de profil changèrent à un rythme sans précédent, attirant l'attention même des cadres les plus endormis."

# Traduction IA – à relire
#: connie_console/connie_love_join/59
msgctxt "Narrator"
msgid "For it was becoming clear that AI acting, while easy to create and impressive at times, didn't have that lifelike unpredictable spark of play."
msgstr "Car il devenait évident que le jeu d'acteur par IA, bien que facile à produire et parfois impressionnant, n'avait pas cette étincelle imprévisible et vivante du jeu."

# Traduction IA – à relire
#: connie_console/connie_love_join/67
msgctxt "Narrator"
msgid "Because..."
msgstr "Parce que..."

# Traduction IA – à relire
#: connie_console/connie_love_join/75
msgctxt "Connie Soul"
msgid "Above all - gaming should be all about <i>play</i>."
msgstr "Avant tout, le jeu vidéo devrait être une affaire de <i>jeu</i>."
