#: skylar_specs/suspension_4/19/b/9
msgctxt "Skylar"
msgid "Ugh..."
msgstr ""

#: skylar_specs/suspension_4/19/b/17
msgctxt "Skylar"
msgid "You're walking a really fine tightrope here."
msgstr ""

#: skylar_specs/suspension_4/19/b/25
msgctxt "Skylar"
msgid "Please, for her sake... give it a chance."
msgstr ""

#: skylar_specs/suspension_decide_good/0/10
msgctxt "Narrator"
msgid "Skylar beams at you, her eyes glimmering behind her glasses—are those happy tears?"
msgstr ""

#: skylar_specs/suspension_decide_good/0/18
msgctxt "Narrator"
msgid "For a moment she looks as though she's contemplating hugging you, but she manages to keep her arms at her sides, her hands curled into excited fists."
