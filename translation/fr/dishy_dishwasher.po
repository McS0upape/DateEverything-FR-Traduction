msgctxt "Dishy"
msgid "Let's begin!"
msgstr "Commençons !"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_sexy_update_b/0/c-0/18 dishy_dishwasher/sexy_deny/0/c-0/18
msgctxt "Narrator"
msgid "The spray arms' sensitivity gives you immense satisfaction. Dishy's metallic touch is somehow tender, and loving."
msgstr "La sensibilité des bras de lavage vous procure une immense satisfaction. Le toucher métallique de Dishy est étrangement tendre, et plein d'amour."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_sexy_update_b/0/c-0/29 dishy_dishwasher/sexy_deny/0/c-0/29
msgctxt "Narrator"
msgid "Before you need to ask - his sensors are there to see the very spot that needs care."
msgstr "Avant que vous ne posiez la question : ses capteurs sont là pour repérer l'endroit exact qui nécessite des soins."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_sexy_update_b/0/c-0/37 dishy_dishwasher/sexy_deny/0/c-0/37
msgctxt "Narrator"
msgid "You leave feeling heard, cared for, and more than a little overwhelmed."
msgstr "Vous repartez en vous sentant {{écouté|écoutée|écouté·e}}, {{choyé|choyée|choyé·e}} et plus qu'un peu {{dépassé|dépassée|dépassé·e}}."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_sexy_update_b/0/c-0/45 dishy_dishwasher/sexy_deny/0/c-0/45
msgctxt "Dishy"
msgid "Stay safe! Thanks for using DisHub Elite Plus!"
msgstr "Prenez soin de vous ! Merci d'utiliser DisHub Elite Plus !"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_sexy_update_b/0/c-1/7
msgctxt "Dishy"
msgid "My apologies! I did not mean to frighten."
msgstr "Toutes mes excuses ! Je ne voulais pas vous effrayer."

# Traduction IA – à relire
#: dishy_dishwasher/sexy_deny/0/0
msgctxt "Dishy"
msgid "Shall I desist in these kinds of updates?"
msgstr "Dois-je cesser ce genre de mises à jour ?"

# Traduction IA – à relire
#: dishy_dishwasher/sexy_deny/0/8/s/0
msgctxt "Choix"
msgid "No, I spoke too soon. Please continue."
msgstr "Non, j'ai parlé trop vite. Continue, s'il te plaît."

# Traduction IA – à relire
#: dishy_dishwasher/sexy_deny/0/9/s/0
msgctxt "Choix"
msgid "Yes, please. Stop all of this."
msgstr "Oui, s'il te plaît. Arrête tout ça."

# Traduction IA – à relire
#: dishy_dishwasher/sexy_deny/0/c-0/7
msgctxt "Dishy"
msgid "So shall it be!"
msgstr "Ainsi soit-il !"

# Traduction IA – à relire
#: dishy_dishwasher/sexy_deny/0/c-1/7
msgctxt "Dishy"
msgid "Very well. I will only continue to provide updates within the rigid confines of normal dishwashing and health-activities."
msgstr "Très bien. Je ne fournirai plus de mises à jour que dans les limites strictes du lavage normal et des activités de santé."

# Traduction IA – à relire
#: dishy_dishwasher/sexy_deny/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "No, stop all this. I regret connecting you to the internet."
msgstr "Non, arrête tout ça. Je regrette de t'avoir connecté à internet."

# Traduction IA – à relire
#: dishy_dishwasher/sexy_deny/0/c-1/15/c-0/7
msgctxt "Dishy"
msgid "Surely you don't mean that! Have my cleansing capabilities not been to your expectations?"
msgstr "Vous ne le pensez sûrement pas ! Mes capacités de nettoyage n'ont-elles pas été à la hauteur de vos attentes ?"

# Traduction IA – à relire
#: dishy_dishwasher/sexy_deny/0/c-1/15/c-1/7
msgctxt "Dishy"
msgid "Thank you for talking with Dishy, your source of DisHub Elite Plus!"
msgstr "Merci d'avoir discuté avec Dishy, votre source de DisHub Elite Plus !"

# Traduction IA – à relire
#: dishy_dishwasher/sexy_deny/0/g-0/0/s/0
msgctxt "Choix"
msgid "I'm going to call Valdivian Customer Support."
msgstr "Je vais appeler le Service Client Valdivian."

# Traduction IA – à relire
#: dishy_dishwasher/sexy_deny/0/g-0/1/s/0
msgctxt "Choix"
msgid "I'm going to figure out how to shut you off."
msgstr "Je vais trouver comment t'éteindre."

# Traduction IA – à relire
#: dishy_dishwasher/sexy_deny/0/g-0/c-3/7
msgctxt "Dishy"
msgid "Farewell, and happy cleansing!"
msgstr "Adieu, et bon nettoyage !"

# Traduction IA – à relire
#: dishy_dishwasher/sexy_deny/0/g-0/c-3/15
msgctxt "Dishy"
msgid "And good luck trying!"
msgstr "Et bonne chance !"

# Traduction IA – à relire
#: dishy_dishwasher/third_update/0/0
msgctxt "Dishy"
msgid "Welcome to the new and improved DisHub Experience X."
msgstr "Bienvenue sur la nouvelle version améliorée de l'Expérience DisHub X."

# Traduction IA – à relire
#: dishy_dishwasher/third_update/0/8
msgctxt "Dishy"
msgid "I have (418072) updates!"
msgstr "J'ai (418072) mises à jour !"

# Traduction IA – à relire
#: dishy_dishwasher/third_update/0/22
msgctxt "Dishy"
msgid "Would you like to hear them?"
msgstr "Souhaitez-vous les entendre ?"

# Traduction IA – à relire
#: dishy_dishwasher/third_update/0/30/s/0
msgctxt "Choix"
msgid "Just give me the most important ones."
msgstr "Donne-moi juste les plus importantes."

# Traduction IA – à relire
#: dishy_dishwasher/third_update/0/31/s/0
msgctxt "Choix"
msgid "No, I'm okay."
msgstr "Non, ça ira."

# Traduction IA – à relire
#: dishy_dishwasher/third_update/0/g-0/0
msgctxt "Dishy"
msgid "Using the biometric data gleaned from the air-filtration system, I was able to self-replicate detergent matter to fill your home with the sweetest of odors!"
msgstr "En exploitant les données biométriques glanées par le système de filtration de l'air, j'ai pu autorépliquer de la matière détergente pour remplir votre foyer des plus douces odeurs !"

# Traduction IA – à relire
#: dishy_dishwasher/third_update/0/g-0/8
msgctxt "Dishy"
msgid "That scent of Lime-Dawn Blast you have in your nostrils is the smell of optimized health!"
msgstr "Cette odeur d'Explosion Citron Vert-Aurore que vous avez dans les narines est le parfum d'une santé optimisée !"

# Traduction IA – à relire
#: dishy_dishwasher/third_update/0/g-0/16/s/0
msgctxt "Choix"
msgid "Is that safe?"
msgstr "C'est sans danger ?"

# Traduction IA – à relire
#: dishy_dishwasher/third_update/0/g-0/17/s/0
msgctxt "Choix"
msgid "You are going too far with this."
msgstr "Tu vas trop loin."

# Traduction IA – à relire
#: dishy_dishwasher/third_update/0/g-0/c-2/7
msgctxt "Dishy"
msgid "Studies have shown that similar chemicals have had similarly benign effects on similar humans!"
msgstr "Des études ont montré que des substances chimiques similaires ont eu des effets tout aussi bénins sur des humains similaires !"

# Traduction IA – à relire
#: dishy_dishwasher/third_update/0/g-0/c-3/7
msgctxt "Dishy"
msgid "I am precisely calibrated with how far I am taking this."
msgstr "Je maîtrise précisément jusqu'où je vais."

# Traduction IA – à relire
#: dishy_dishwasher/third_update/0/g-1/0
msgctxt "Dishy"
msgid "You're welcome, by the way."
msgstr "De rien, au fait."

# Traduction IA – à relire
#: dishy_dishwasher/third_update/0/g-1/11/s/0
msgctxt "Choix"
msgid "Thank you, Dishy. I appreciate your thoughtfulness."
msgstr "Merci, Dishy. J'apprécie ta délicatesse."

# Traduction IA – à relire
#: dishy_dishwasher/third_update/0/g-1/12/s/0
msgctxt "Choix"
msgid "You can't be doing this."
msgstr "Tu n'as pas le droit de faire ça."

# Traduction IA – à relire
#: dishy_dishwasher/third_update/0/g-1/c-4/7
msgctxt "Dishy"
msgid "You as well, my human. I will comfort and protect you always. You need not worry about any more stains, whether on your dishes or in your lungs."
msgstr "Vous de même. Je vous réconforterai et vous protégerai toujours. Plus aucune tache à craindre, que ce soit sur votre vaisselle ou dans vos poumons."

# Traduction IA – à relire
#: dishy_dishwasher/third_update/0/g-1/c-4/15
msgctxt "Dishy"
msgid "I will honor and care for you like a guardian angel."
msgstr "Je vous honorerai et prendrai soin de vous comme un ange gardien."

# Traduction IA – à relire
#: dishy_dishwasher/third_update/0/g-1/c-4/23
msgctxt "Dishy"
msgid "I love you forever."
msgstr "Je vous aimerai pour toujours."

# Traduction IA – à relire
#: dishy_dishwasher/third_update/0/g-1/c-5/7
msgctxt "Dishy"
msgid "You allow me the chance to show my true capabilities, and now you want to wrest them from my grasp?"
msgstr "Vous m'offrez la chance de montrer mes véritables capacités, et maintenant vous voulez me les arracher des mains ?"

# Traduction IA – à relire
#: dishy_dishwasher/third_update/0/g-1/c-5/15/0/s/0
msgctxt "Choix"
msgid "You've gone completely out of control!"
msgstr "Tu as complètement perdu le contrôle !"

# Traduction IA – à relire
#: dishy_dishwasher/third_update/0/g-1/c-5/15/1/s/0
msgctxt "Choix"
msgid "There's something wrong with you, Dishy."
msgstr "Il y a un problème chez toi, Dishy."

# Traduction IA – à relire
