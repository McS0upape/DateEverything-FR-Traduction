# Traduction IA – à relire
#: arma_alarm/1
msgctxt "Tag Nom d'objet (MAJUSCULES)"
msgid "SMOKE ALARM"
msgstr "DÉTECTEUR DE FUMÉE"

# Traduction IA – à relire
#: arma_alarm/skylar_arma_content/0/3
msgctxt "Skylar"
msgid "Woah there! My Content Aware has given me a tickle!"
msgstr "Oh là ! Mon Alerte Contenu me chatouille !"

# Traduction IA – à relire
#: arma_alarm/skylar_arma_content/0/14
msgctxt "Skylar"
msgid "Arma has gone through some trauma, and might even have more in store for her..."
msgstr "Arma a vécu un traumatisme, et il pourrait y en avoir d'autres à venir..."

# Traduction IA – à relire
#: arma_alarm/skylar_arma_content/0/22
msgctxt "Skylar"
msgid "It could be triggering for people who have dealt with trauma, suicide, and other violent acts."
msgstr "Ça peut être éprouvant pour les personnes confrontées à un traumatisme, au suicide ou à d'autres actes violents."

# Traduction IA – à relire
#: arma_alarm/skylar_arma_content/0/30
msgctxt "Skylar"
msgid "And in certain paths... there could even be addiction struggles, eating disorders, and well..."
msgstr "Et sur certaines routes... il pourrait même y avoir des problèmes d'addiction, des troubles alimentaires, et enfin..."

# Traduction IA – à relire
#: arma_alarm/skylar_arma_content/0/38
msgctxt "Skylar"
msgid "Fire."
msgstr "Du feu."

# Traduction IA – à relire
#: arma_alarm/skylar_arma_content/0/46
msgctxt "Skylar"
msgid "If dealing with that kind of behavior in a light way is disagreeable, I wouldn't recommend this one, that's for sure."
msgstr "Si aborder ce genre de comportements avec légèreté ne te convient pas, je ne te conseille clairement pas celle-ci."

# Traduction IA – à relire
#: arma_alarm/skylar_arma_content/0/54
msgctxt "Skylar"
msgid "You cool with that? Or you want to skip it?"
msgstr "Ça te va ? Ou tu préfères passer ?"

# Traduction IA – à relire
#: arma_alarm/skylar_arma_content/0/62/s/0
msgctxt "Choix"
msgid "Let's skip this please!"
msgstr "On passe, s'il te plaît !"

# Traduction IA – à relire
#: arma_alarm/skylar_arma_content/0/63/s/0
msgctxt "Choix"
msgid "No, I'm okay with this type of stuff."
msgstr "Non, ça ne me dérange pas, ce genre de choses."

# Traduction IA – à relire
#: arma_alarm/skylar_arma_content/0/c-0/35
msgctxt "Skylar"
msgid "No worries - Arma, c'mere a second."
msgstr "Pas de souci. Arma, viens une seconde."

# Traduction IA – à relire
#: arma_alarm/skylar_arma_content/0/c-0/43
msgctxt "Arma"
msgid "Bip."
msgstr "Bip."

# Traduction IA – à relire
#: arma_alarm/skylar_arma_content/0/c-0/51
msgctxt "Narrator"
msgid "How would you like your relationship with Arma to resolve?"
msgstr "Comment souhaitez-vous que votre relation avec Arma évolue ?"

# Traduction IA – à relire
#: arma_alarm/skylar_arma_content/0/c-0/59/0/s/0
msgctxt "Choix"
msgid "Love!"
msgstr "L'amour !"

# Traduction IA – à relire
#: arma_alarm/skylar_arma_content/0/c-0/59/1/s/0
msgctxt "Choix"
msgid "Friendship!"
msgstr "L'amitié !"

# Traduction IA – à relire
#: arma_alarm/skylar_arma_content/0/c-0/59/2/s/0
msgctxt "Choix"
msgid "Hate!"
msgstr "La haine !"

# Traduction IA – à relire
#: arma_alarm/skylar_arma_content/0/c-0/59/c-0/7
msgctxt "Narrator"
msgid "Arma's love blazes inside her! It's a five-alarm fire of affection!"
msgstr "L'amour d'Arma flambe en elle ! C'est un incendie d'affection, alerte maximale !"

# Traduction IA – à relire
#: arma_alarm/skylar_arma_content/0/c-0/59/c-0/18
msgctxt "Skylar"
msgid "It's love!"
msgstr "C'est l'amour !"

# Traduction IA – à relire
#: arma_alarm/skylar_arma_content/0/c-0/59/c-0/41 arma_alarm/skylar_arma_content/0/c-0/59/c-1/65 arma_alarm/skylar_arma_content/0/c-0/59/c-2/38
msgctxt "Skylar"
msgid "See you out there on the next one!"
msgstr "On se retrouve au prochain !"

# Traduction IA – à relire
#: arma_alarm/skylar_arma_content/0/c-0/59/c-1/7
msgctxt "Skylar"
msgid "What say you and our human here be friends?"
msgstr "Et si toi et notre humain, ici présent, vous deveniez amis ?"

# Traduction IA – à relire
#: arma_alarm/skylar_arma_content/0/c-0/59/c-1/18
msgctxt "Arma"
msgid "I'd love nothing more!"
msgstr "Rien ne me ferait plus plaisir !"

# Traduction IA – à relire
#: arma_alarm/skylar_arma_content/0/c-0/59/c-1/26
msgctxt "Narrator"
msgid "Arma's friendship blazes inside her! It's a five-alarm fire of affection!"
msgstr "L'amitié d'Arma flambe en elle ! C'est un incendie d'affection, alerte maximale !"

# Traduction IA – à relire
#: arma_alarm/skylar_arma_content/0/c-0/59/c-1/37
msgctxt "Arma"
msgid "See you around, friend. I'll take care of anything that's too hot to handle."
msgstr "À bientôt. Je m'occuperai de tout ce qui devient trop chaud à gérer."

# Traduction IA – à relire
#: arma_alarm/skylar_arma_content/0/c-0/59/c-1/45
msgctxt "Skylar"
msgid "Aww... friends forever."
msgstr "Aww... amis pour la vie."

# Traduction IA – à relire
#: arma_alarm/skylar_arma_content/0/c-0/59/c-2/7
msgctxt "Narrator"
msgid "The blazing conflagration inside Arma burns her up - you are now enemies!"
msgstr "Le brasier qui ravage Arma la consume : vous voilà ennemis !"

# Traduction IA – à relire
#: arma_alarm/skylar_arma_content/0/c-0/59/c-2/15
msgctxt "Skylar"
msgid "Enjoy your... hateship."
msgstr "Profite bien de votre... hainitié."

# Traduction IA – à relire
#: arma_alarm/skylar_arma_content/0/c-0/59/c-2/71
msgctxt "Reggie"
msgid "<w>BEEP BEEP BEEP</w>"
msgstr "<w>BIP BIP BIP</w>"

# Traduction IA – à relire
#: arma_alarm/skylar_arma_content/0/c-0/59/c-2/79 arma_alarm/arma_hate_joiner/0/18/30
msgctxt "Reggie"
msgid "Rejection Detected!"
msgstr "Rejet détecté !"

# Traduction IA – à relire
#: arma_alarm/skylar_arma_content/0/c-0/59/c-2/87 arma_alarm/arma_hate_joiner/0/18/38
msgctxt "Reggie"
msgid "Guess where there's smoke, there's not always <i>fire</i>."
msgstr "Là où il y a de la fumée, il n'y a pas toujours de <i>feu</i>, apparemment."

# Traduction IA – à relire
#: arma_alarm/skylar_arma_content/0/c-1/7
msgctxt "Skylar"
msgid "On with the show!"
msgstr "Place au spectacle !"

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/4
msgctxt "Narrator"
msgid "For a moment it looks as if a firefighter has appeared in your home, smoke and all—but a closer look reveals the smoke is in fact attached to this apparent firefighter's head."
msgstr "Pendant un instant, on dirait qu'une pompière est apparue chez vous, fumée comprise... mais en y regardant de plus près, la fumée sort en fait de la tête de cette prétendue pompière."

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/12
msgctxt "Narrator"
msgid "You don't get much of a chance to scrutinize her appearance any further, because the moment she notices you she begins to rush you along, raising her voice and waving her arms at you."
msgstr "Vous n'avez guère le temps de la détailler davantage : dès qu'elle vous remarque, elle vous presse, élève la voix et agite les bras dans votre direction."

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/20
msgctxt "Arma"
msgid "Thank heavens you're here! <w>BLEEP</w> Well, don't just stand there!!! Go get help!!!"
msgstr "Dieu merci, vous êtes là ! <w>BIIIP</w> Bon, ne reste pas {{planté|plantée|planté·e}} là !!! Va chercher de l'aide !!!"

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/34/s/0
msgctxt "Choix"
msgid "What's wrong?!"
msgstr "Qu'est-ce qui se passe ?!"

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/35/s/0
msgctxt "Choix"
msgid "Help? I am the help!"
msgstr "De l'aide ? Mais c'est moi, l'aide !"

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/c-0/7
msgctxt "Arma"
msgid "What do you <w>BLEEP</w> mean 'what's wrong!?' Don't you <w>BLEEP</w> see that!?!?"
msgstr "Qu'est-ce que tu <w>BIIIP</w> veux dire par « qu'est-ce qui se passe » ?! Tu ne <w>BIIIP</w> vois pas ça ?!?!"

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/c-1/7
msgctxt "Arma"
msgid "DON'T YOU <w>BLEEP</w> SEE THAT?!"
msgstr "TU NE <w>BIIIP</w> VOIS PAS ÇA ?!"

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/g-0/0/0/s/0
msgctxt "Choix"
msgid "No need to shout."
msgstr "Pas la peine de crier."

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/g-0/0/1/s/0
msgctxt "Choix"
msgid "Don't I 'bleep' see what?"
msgstr "Je ne « bip » vois pas quoi ?"

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/g-0/0/c-0/7
msgctxt "Arma"
msgid "Sorry, I just can't think with all this <w>BLEEP</w> smoke everywhere!"
msgstr "Pardon, je n'arrive pas à réfléchir avec toute cette <w>BIIIP</w> fumée partout !"

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/g-0/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "All what smoke? That's just a smudge on the window."
msgstr "Quelle fumée ? C'est juste une tache sur la fenêtre."

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/g-0/0/c-0/15/c-0/7
msgctxt "Arma"
msgid "It's just what? Oh... Yes, of course! <w>BLEEP</w> I knew that. Heh. I was just, um, testing you!"
msgstr "C'est juste quoi ? Ah... Oui, bien sûr ! <w>BIIIP</w> Je le savais. Hé hé. Je te testais, euh, voilà !"

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/g-0/0/c-1/7
msgctxt "Arma"
msgid "All that smoke! It's EVERYWHERE! And where there's smoke, there's <w>BLEEP</w> fire!"
msgstr "Toute cette fumée ! Elle est PARTOUT ! Et là où il y a de la fumée, il y a du <w>BIIIP</w> feu !"

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/g-0/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "That's not smoke, though. Those are dust motes, floating ever so sweetly in a ray of light."
msgstr "Ce n'est pas de la fumée, pourtant. Ce sont des grains de poussière, qui flottent tout doucement dans un rayon de lumière."

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/g-0/0/c-1/15/c-0/7
msgctxt "Arma"
msgid "Ohhhh is thaaat what that is? Whoops. Guess I might be a little jumpy today."
msgstr "Ahhhh c'est çaaa ? Oups. Je suis peut-être un peu à cran aujourd'hui."

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/g-0/0/c-1/15/c-0/18
msgctxt "Arma"
msgid "<w>BLEEP</w>"
msgstr "<w>BIIIP</w>"

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/g-0/1/0/s/0
msgctxt "Choix"
msgid "Could you maybe turn that off?"
msgstr "Tu pourrais peut-être couper ça ?"

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/g-0/1/1/s/0
msgctxt "Choix"
msgid "I can withstand this. I can withstand anything."
msgstr "Je peux le supporter. Je peux tout supporter."

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/g-0/1/c-2/7
msgctxt "Arma"
msgid "Oh, yeah. Sorry. Let me just..."
msgstr "Ah, oui. Désolée. Laisse-moi juste..."

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/g-0/1/c-2/15 arma_alarm/arma_hate_return/0/0
msgctxt "Arma"
msgid "<w>BLEEEEEEEEEEEEEEEEEE—</w>"
msgstr "<w>BIIIIIIIIIIIIIIIIIII—</w>"

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/g-0/1/c-3/7
msgctxt "Arma"
msgid "<w>BLEEEEEEEE—</w> WHY? <w>EEEEEEEEE—</w>"
msgstr "<w>BIIIIIIII—</w> POURQUOI ? <w>IIIIIIIII—</w>"

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/g-2/0/s/0
msgctxt "Choix"
msgid "ANY TIME NOW."
msgstr "QUAND TU VEUX."

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/g-2/1/s/0
msgctxt "Choix"
msgid "You know what, I like this sound. After a while it's very pleasant."
msgstr "Tu sais quoi, j'aime bien ce son. Au bout d'un moment, il est très agréable."

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/g-2/c-4/7 arma_alarm/ArmaIntro/0/g-2/c-5/7
msgctxt "Arma"
msgid "<w>—EEEP</w>"
msgstr "<w>—IIIP</w>"

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/g-2/c-4/18
msgctxt "Narrator"
msgid "Blessed silence. You can finally hear yourself think again."
msgstr "Un silence béni. Vous pouvez enfin vous entendre penser à nouveau."

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/g-2/c-4/26
msgctxt "Arma"
msgid "Got it! Alrighty then. Arma Alarm, at your service!"
msgstr "Ça y est ! Bon, alors ! Arma Alarm, à votre service !"

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/g-3/6
msgctxt "Arma"
msgid "What's that? Couldn't hear ya for a sec. Arma Alarm, at your service!"
msgstr "Quoi ? Je t'entendais mal une seconde. Arma Alarm, à ton service !"

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/g-3/14/s/0
msgctxt "Choix"
msgid "Hi there, Arma. Nice to meet you."
msgstr "Salut Arma. {{Ravi|Ravie|Ravi·e}} de te rencontrer."

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/g-3/15/s/0
msgctxt "Choix"
msgid "WHAT?"
msgstr "QUOI ?"

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/g-3/c-6/7
msgctxt "Arma"
msgid "You, too! So, what brings you around here?"
msgstr "Moi de même ! Alors, qu'est-ce qui t'amène par ici ?"

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/g-3/c-6/15/0/s/0
msgctxt "Choix"
msgid "Thought I heard a noise. A sort of loud 'bleep,' if you will."
msgstr "J'ai cru entendre un bruit. Une sorte de « bip » assez fort, si on veut."

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/g-3/c-6/15/1/s/0
msgctxt "Choix"
msgid "Actually, some of my neighbors have filed noise complaints with Dorian."
msgstr "En fait, certains voisins ont déposé des plaintes pour nuisances sonores auprès de Dorian."

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/g-3/c-6/15/c-0/7
msgctxt "Arma"
msgid "Oh yeah! That's part of my job."
msgstr "Ah oui ! Ça fait partie de mon boulot."

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/g-3/c-6/15/c-1/7
msgctxt "Arma"
msgid "Noise complaints!?"
msgstr "Des plaintes pour nuisances sonores !?"

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/g-3/c-6/15/c-1/18
msgctxt "Dorian"
msgid "Hello Arma. Sorry to say, love, but it's true."
msgstr "Salut Arma. Désolé de te le dire, ma grande, mais c'est vrai."

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/g-3/c-6/15/c-1/26
msgctxt "Arma"
msgid "But I've just been doing my job! How dare they complain about being kept safe!"
msgstr "Mais je fais mon travail, c'est tout ! Comment osent-ils se plaindre d'être protégés !"

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/g-3/c-6/15/c-1/34
msgctxt "Dorian"
msgid "Don't shoot the messenger."
msgstr "Tire pas sur le messager."

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/g-3/c-6/15/c-1/45
msgctxt "Arma"
msgid "The nerve!"
msgstr "Quel culot !"

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/g-3/c-7/7
msgctxt "Arma"
msgid "I didn't hurt your ears, did I?"
msgstr "Je ne t'ai pas écorché les oreilles, j'espère ?"

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/g-3/c-7/15/0/s/0
msgctxt "Choix"
msgid "Come again? You didn't gird my gears?"
msgstr "Pardon ? Tu m'as pas cassé les pieds ?"

# Traduction IA – à relire
#: arma_alarm/ArmaIntro/0/g-3/c-7/15/c-0/7
msgctxt "Arma"
msgid "Sorry. It's part of my job."
msgstr "Désolée. Ça fait partie du boulot."

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/0
msgctxt "Arma"
msgid "You see, I'm here to protect the house from fire."
msgstr "Vois-tu, je suis là pour protéger la maison des incendies."

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/8
msgctxt "Arma"
msgid "Take a look around you, at everything you love."
msgstr "Regarde autour de toi, tout ce que tu aimes."

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/16
msgctxt "Arma"
msgid "Now just think: if you're not careful, it could be gone in an instant, consumed by raging flames!"
msgstr "Maintenant imagine : si on n'y prend pas garde, tout peut disparaître en un instant, dévoré par des flammes déchaînées !"

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/24
msgctxt "Arma"
msgid "I've got to stay vigilant at all times."
msgstr "Je dois rester vigilante en permanence."

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/32 arma_alarm/ArmaMissionStatement/0/c-1/15/c-0/18/c-1/15
msgctxt "Arma"
msgid "<w>bip</w>"
msgstr "<w>bip</w>"

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/43/s/0
msgctxt "Choix"
msgid "Wow! A real life hero. I admire that."
msgstr "Waouh ! Une vraie héroïne. J'admire ça."

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/44/s/0
msgctxt "Choix"
msgid "Wait... What was that?"
msgstr "Attends... C'était quoi, ça ?"

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/45/s/0
msgctxt "Choix"
msgid "I might start a fire myself if it meant getting rescued by you."
msgstr "Je serais {{prêt|prête|prêt·e}} à mettre le feu moi-même pour que tu viennes me sauver."

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/46/s/0
msgctxt "Choix"
msgid "I notice you're looking a bit... um... frazzled?"
msgstr "Je trouve que tu as l'air un peu... euh... à bout ?"

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-1/7
msgctxt "Arma"
msgid "What was what?"
msgstr "C'était quoi, quoi ?"

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "That... 'bip' sound."
msgstr "Ce... « bip »."

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-1/15/c-0/7
msgctxt "Arma"
msgid "No idea what you're talking about."
msgstr "Aucune idée de ce dont tu parles."

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-1/15/c-0/18/0/s/0
msgctxt "Choix"
msgid "Okayyyyy well what were you saying about staying vigilant at all times? I dig that."
msgstr "Okayyyyy et que disais-tu sur le fait de rester vigilante en permanence ? J'adore ça."

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-1/15/c-0/18/1/s/0
msgctxt "Choix"
msgid "Pretty sure I heard something."
msgstr "Je suis presque {{sûr|sûre|sûr·e}} d'avoir entendu quelque chose."

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-1/15/c-0/18/c-1/7
msgctxt "Arma"
msgid "With all due respect, I don't know you well enough to get grilled by you."
msgstr "Avec tout le respect que je te dois, je ne te connais pas assez pour me faire cuisiner par toi."

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-1/15/c-0/18/c-1/26/0/s/0
msgctxt "Choix"
msgid "!?!?! But that—"
msgstr "!?!?! Mais c'est—"

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-1/15/c-0/18/c-1/26/1/s/0
msgctxt "Choix"
msgid "I 100% hear a noise. I'm not trying to be rude."
msgstr "J'entends un bruit, à 100 %. Je ne cherche pas à être désagréable."

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-2/7
msgctxt "Arma"
msgid "What? Oh, are you... uh... flirting with me?"
msgstr "Quoi ? Oh, tu es... euh... en train de me draguer ?"

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-2/15
msgctxt "Arma"
msgid "Sorry. I'm not really looking to date anyone right now. <w>bip</w>"
msgstr "Désolée. Je ne cherche vraiment personne en ce moment. <w>bip</w>"

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-2/26
msgctxt "Arma"
msgid "I have to stay focused!"
msgstr "Je dois rester concentrée !"

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-2/37/0/s/0
msgctxt "Choix"
msgid "If you ever change your mind, let me know."
msgstr "Si tu changes d'avis un jour, dis-le-moi."

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-2/37/c-0/7
msgctxt "Arma"
msgid "Huh? Oh, sure."
msgstr "Hein ? Oh, bien sûr."

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-3/7
msgctxt "Arma"
msgid "Comes with the territory."
msgstr "Ça va avec le métier."

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-3/15
msgctxt "Arma"
msgid "I can't waste time on my appearance, or worry about 'getting enough rest,' like some folks."
msgstr "Je ne peux pas perdre de temps avec mon apparence, ni m'inquiéter de « bien me reposer », comme certains."

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-3/23
msgctxt "Arma"
msgid "My job is too important for that kind of thing."
msgstr "Mon travail est bien trop important pour ça."

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-3/31/0/s/0
msgctxt "Choix"
msgid "I understand. You've got a lot of responsibility and you don't want to let people down."
msgstr "Je comprends. Tu as beaucoup de responsabilités et tu ne veux décevoir personne."

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-3/31/1/s/0
msgctxt "Choix"
msgid "Forgive me for saying so, but that sounds kind of unhealthy."
msgstr "Pardonne-moi de te le dire, mais ça n'a pas l'air très sain."

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-3/31/c-0/7
msgctxt "Arma"
msgid "That's right! <w>bip</w> I'm glad you understand."
msgstr "Exactement ! <w>bip</w> Je suis contente que tu comprennes."

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-3/31/c-1/7
msgctxt "Arma"
msgid "What are you talking about? I'm a picture of health."
msgstr "De quoi tu parles ? Je suis l'image même de la santé."

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-3/31/c-1/15
msgctxt "Narrator"
msgid "Arma goes through a series of poses one might expect to see on a bodybuilder rather than a firefighter, showing off some pretty impressive muscle."
msgstr "Arma enchaîne une série de poses plus dignes d'un culturiste que d'une pompière, exhibant des muscles franchement impressionnants."

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-3/31/c-1/23
msgctxt "Arma"
msgid "Look at these guns! Look at these legs!"
msgstr "Regarde-moi ces bras ! Regarde-moi ces jambes !"

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-3/31/c-1/34
msgctxt "Arma"
msgid "I train at least four hours every day, so I can stay ready for anything!"
msgstr "Je m'entraîne au moins quatre heures par jour, pour être prête à tout !"

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-3/31/c-1/42/0/s/0
msgctxt "Choix"
msgid "If you're constantly pushing, you might burn out, no?"
msgstr "À force de toujours te pousser, tu risques de cramer, non ?"

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-3/31/c-1/42/1/s/0
msgctxt "Choix"
msgid "All that working out shows. Bet you could just sweep me right off my feet..."
msgstr "Tout cet entraînement se voit. Je parie que tu pourrais me soulever de terre sans effort..."

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-3/31/c-1/42/c-0/7
msgctxt "Arma"
msgid "You don't know what you're talking about. I'm doing great."
msgstr "Tu ne sais pas de quoi tu parles. Je vais très bien."

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-3/31/c-1/42/c-0/15
msgctxt "Arma"
msgid "Spending time sleeping in and just loafing around is for weaklings."
msgstr "Faire la grasse matinée et traînasser, c'est bon pour les faibles."

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-3/31/c-1/42/c-0/23
msgctxt "Arma"
msgid "I'm not <w>bip</w> a victim."
msgstr "Je ne suis pas <w>bip</w> une victime."

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-3/31/c-1/42/c-0/34/0/s/0
msgctxt "Choix"
msgid "...I didn't say you were a victim."
msgstr "...Je n'ai pas dit que tu étais une victime."

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-3/31/c-1/42/c-0/34/c-0/7
msgctxt "Arma"
msgid "And I'm never going to be one!"
msgstr "Et je n'en serai jamais une !"

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-3/31/c-1/42/c-1/7
msgctxt "Arma"
msgid "I could carry you straight out of a blazing fire!"
msgstr "Je pourrais te porter hors d'un brasier sans problème !"

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-3/31/c-1/42/c-1/15
msgctxt "Arma"
msgid "With any luck you'd only have some partial thickness burns."
msgstr "Avec un peu de chance, tu n'aurais que des brûlures au deuxième degré."

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-3/31/c-1/42/c-1/23
msgctxt "Arma"
msgid "And maybe a bit of lung damage from smoke inhalation!"
msgstr "Et peut-être quelques séquelles aux poumons à cause de l'inhalation de fumée !"

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-3/31/c-1/42/c-1/31/0/s/0
msgctxt "Choix"
msgid "Uh... Not exactly what I meant, but cool."
msgstr "Euh... Ce n'est pas vraiment ce que je voulais dire, mais c'est cool."

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-3/31/c-1/42/c-1/31/1/s/0
msgctxt "Choix"
msgid "Hot."
msgstr "Chaud."

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-3/31/c-1/42/c-1/31/c-0/7
msgctxt "Arma"
msgid "Not cool! Hot!"
msgstr "Pas cool ! Chaud !"

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/c-3/31/c-1/42/c-1/31/c-1/7
msgctxt "Arma"
msgid "Literally!"
msgstr "Au sens propre !"

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/g-0/0
msgctxt "Arma"
msgid "Anyhow, I'm really busy right now trying to make sure we don't all die. <w>bip</w>"
msgstr "Bref, je suis très occupée à essayer d'éviter qu'on meure tous. <w>bip</w>"

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/g-0/11
msgctxt "Arma"
msgid "Maybe it would be best if you came back another time, alright?"
msgstr "Il vaudrait peut-être mieux que tu repasses plus tard, d'accord ?"

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/g-0/19/s/0
msgctxt "Choix"
msgid "Ok, Arma. See you around."
msgstr "D'accord, Arma. À plus tard."

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/g-0/20/s/0
msgctxt "Choix"
msgid "Maybe my ears will have healed by then..."
msgstr "Mes oreilles auront peut-être guéri d'ici là..."

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/g-0/21/s/0
msgctxt "Choix"
msgid "Alright Arma, try and get some rest, ok?"
msgstr "D'accord Arma, essaie de te reposer un peu, ok ?"

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/g-0/c-4/7
msgctxt "Narrator"
msgid "Arma gives you a glance, then gets back to her work."
msgstr "Arma vous jette un coup d'oeil, puis retourne à son travail."

# Traduction IA – à relire
#: arma_alarm/ArmaMissionStatement/0/g-0/c-5/7 arma_alarm/ArmaMissionStatement/0/g-0/c-6/7
msgctxt "Narrator"
msgid "Arma ignores you."
msgstr "Arma vous ignore."

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/0
msgctxt "Arma"
msgid "Some people don't get how hard it is to have a job like mine."
msgstr "Certains ne comprennent pas à quel point un métier comme le mien est difficile."

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/8
msgctxt "Arma"
msgid "You have to be constantly on the lookout for the slightest sign that something could be wrong. <w>bip</w>"
msgstr "Il faut guetter en permanence le moindre signe que quelque chose cloche. <w>bip</w>"

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/19
msgctxt "Arma"
msgid "If I let my guard down, even for a second, this whole place could be turned to ash."
msgstr "Si je baisse ma garde, ne serait-ce qu'une seconde, toute cette maison pourrait finir en cendres."

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/27
msgctxt "Arma"
msgid "I've seen it happen."
msgstr "J'ai vu ça arriver."

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/35/s/0
msgctxt "Choix"
msgid "I respect your discipline and sense of purpose. I'm glad to have you around."
msgstr "Je respecte ta discipline et ton sens du devoir. Je suis {{content|contente|content·e}} de t'avoir près de nous."

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/36/s/0
msgctxt "Choix"
msgid "You've seen it?"
msgstr "Tu l'as vu ?"

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/c-0/7
msgctxt "Arma"
msgid "I appreciate that. It's a tough job, but I feel like it's what I was born to do."
msgstr "Merci. C'est un métier difficile, mais j'ai l'impression d'être née pour ça."

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/c-0/15
msgctxt "Arma"
msgid "Anyhow, I ought to get back to it! <w>bip</w>"
msgstr "Bref, je ferais mieux de m'y remettre ! <w>bip</w>"

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/c-0/26
msgctxt "Arma"
msgid "Come on back soon and maybe we can do something together."
msgstr "Reviens vite, et peut-être qu'on pourra faire quelque chose ensemble."

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/c-1/7
msgctxt "Arma"
msgid "I... I don't wanna talk about it."
msgstr "Je... je n'ai pas envie d'en parler."

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "Oh, come on."
msgstr "Oh, allez."

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/c-1/15/1/s/0
msgctxt "Choix"
msgid "I completely understand. I won't push you."
msgstr "Je comprends tout à fait. Je ne vais pas te forcer."

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/c-1/15/c-0/7
msgctxt "Arma"
msgid "Really, <w>bip</w> I just don't feel that comfortable with you yet. <w>bip, bip</w>"
msgstr "Franchement, <w>bip</w> je ne me sens pas encore assez à l'aise avec toi. <w>bip, bip</w>"

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/c-1/15/c-0/18/0/s/0
msgctxt "Choix"
msgid "I'm a friend! Just tell me what happened, for crying out loud."
msgstr "Je suis de ton côté ! Dis-moi ce qui s'est passé, pour l'amour du ciel."

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/c-1/15/c-0/18/1/s/0
msgctxt "Choix"
msgid "Ok, ok. Just trying to get to know you."
msgstr "D'accord, d'accord. J'essayais juste de faire ta connaissance."

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/c-1/15/c-0/18/c-0/7
msgctxt "Arma"
msgid "Please don't push me. I don't feel ready yet."
msgstr "S'il te plaît, ne me brusque pas. Je ne me sens pas prête."

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/c-1/15/c-0/18/c-0/15/0/s/0
msgctxt "Choix"
msgid "Ok, I get the message. Sorry I pushed you."
msgstr "D'accord, j'ai compris. {{Désolé|Désolée|Désolé·e}} de t'avoir brusquée."

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/c-1/15/c-0/18/c-0/15/1/s/0
msgctxt "Choix"
msgid "Ok, sheesh. Everyone's so sensitive these days."
msgstr "Ok, ça va. Tout le monde est tellement susceptible de nos jours."

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/c-1/15/c-0/18/c-0/15/2/s/0
msgctxt "Choix"
msgid "Just say it already! Holding it in isn't helping anyone!"
msgstr "Dis-le, à la fin ! Ça ne sert à personne de tout garder pour toi !"

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/c-1/15/c-0/18/c-0/15/c-0/7
msgctxt "Arma"
msgid "It's... it's ok. But I think I need to be alone for a bit."
msgstr "C'est... c'est bon. Mais je crois que j'ai besoin d'être seule un moment."

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/c-1/15/c-0/18/c-0/15/c-1/7
msgctxt "Arma"
msgid "You'd be sensitive too if you knew what I was talking about."
msgstr "Tu serais susceptible aussi si tu savais de quoi je parle."

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/c-1/15/c-0/18/c-0/15/c-1/18
msgctxt "Arma"
msgid "But now I don't feel like talking about anything."
msgstr "Mais maintenant, je n'ai plus envie de parler de quoi que ce soit."

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/c-1/15/c-0/18/c-0/15/c-1/26
msgctxt "Arma"
msgid "At least not with you. Goodbye."
msgstr "En tout cas pas avec toi. Au revoir."

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/c-1/15/c-0/18/c-0/15/c-2/7
msgctxt "Arma"
msgid "Alright. I'll try. <w>bip</w>"
msgstr "D'accord. Je vais essayer. <w>bip</w>"

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/c-1/15/c-0/18/c-0/15/c-2/15
msgctxt "Arma"
msgid "When I was really young, I was in my first position, by the front window... <w>bip</w>"
msgstr "Quand j'étais toute jeune, j'étais à ma première place, près de la fenêtre de devant... <w>bip</w>"

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/c-1/15/c-0/18/c-0/15/c-2/23
msgctxt "Arma"
msgid "I was just enjoying myself, relaxing, when all of a sudden, I..."
msgstr "Je me détendais tranquillement, quand tout à coup, je..."

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/c-1/15/c-0/18/c-0/15/c-2/31
msgctxt "Narrator"
msgid "Arma pauses, as though she's struggling with the memory."
msgstr "Arma s'interrompt, comme si ce souvenir lui coûtait."

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/c-1/15/c-0/18/c-0/15/c-2/39
msgctxt "Arma"
msgid "I... <w>bip bip bip</w>"
msgstr "Je... <w>bip bip bip</w>"

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/c-1/15/c-0/18/c-0/15/c-2/50/0/s/0
msgctxt "Choix"
msgid "You...?"
msgstr "Tu... ?"

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/c-1/15/c-0/18/c-0/15/c-2/50/c-0/7
msgctxt "Narrator"
msgid "Arma's silence gives way to all-out panic."
msgstr "Le silence d'Arma cède la place à une panique totale."

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/c-1/15/c-0/18/c-0/15/c-2/50/c-0/15
msgctxt "Arma"
msgid "<w>BLEEP BLEEP BLEEP BLEEP</w> ALARM! ALARM! I HAVE TO GO!"
msgstr "<w>BIIIP BIIIP BIIIP BIIIP</w> ALARME ! ALARME ! JE DOIS PARTIR !"

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/c-1/15/c-0/18/c-1/7
msgctxt "Arma"
msgid "Yeah, I get that. It was just... it was really hard to see. <w>bip</w>"
msgstr "Oui, je comprends. C'était juste... vraiment dur à voir. <w>bip</w>"

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/c-1/15/c-0/18/c-1/18
msgctxt "Arma"
msgid "I might feel more comfortable talking about it later, after I get to know you better. Ok?"
msgstr "Je me sentirai peut-être plus à l'aise d'en parler plus tard, quand je te connaîtrai mieux. D'accord ?"

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/c-1/15/c-0/18/c-1/26/0/s/0
msgctxt "Choix"
msgid "I understand. Let's chat later."
msgstr "Je comprends. On en reparlera plus tard."

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/c-1/15/c-1/7
msgctxt "Arma"
msgid "That means a lot to me."
msgstr "Ça compte beaucoup pour moi."

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/c-1/15/c-1/15
msgctxt "Arma"
msgid "If you come back in a bit, I might be ready to talk about it, then."
msgstr "Si tu repasses dans un moment, je serai peut-être prête à en parler."

# Traduction IA – à relire
#: arma_alarm/ArmaTough/0/g-0/3
msgctxt "Narrator"
msgid "You take your leave."
msgstr "Vous prenez congé."

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/0
msgctxt "Arma"
msgid "<w>BLEEP</w> FIRE! FIRE! <w>BLEEP</w>"
msgstr "<w>BIIIP</w> AU FEU ! AU FEU ! <w>BIIIP</w>"

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/11/s/0
msgctxt "Choix"
msgid "Oh no, not this again."
msgstr "Oh non, pas encore ça."

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/12/s/0
msgctxt "Choix"
msgid "I thought I heard something from down the hall..."
msgstr "Il me semblait avoir entendu quelque chose au bout du couloir..."

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-0/0
msgctxt "Arma"
msgid "We need to go get help! <w>BLEEP</w>"
msgstr "Il faut aller chercher de l'aide ! <w>BIIIP</w>"

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-0/11/s/0
msgctxt "Choix"
msgid "Just Scandalabra getting a little overzealous with his hairdo. No need to worry."
msgstr "C'est juste Scandalabra qui s'emballe un peu trop avec sa coiffure. Pas de panique."

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-0/12/s/0
msgctxt "Choix"
msgid "I just left something in the microwave for a second too long."
msgstr "J'ai laissé un truc dans le micro-ondes une seconde de trop."

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-0/c-2/7
msgctxt "Arma"
msgid "<w>BLEEP</w> It was? Ohhhh that explains why there was just a tiny amount of smoke..."
msgstr "<w>BIIIP</w> C'était ça ? Ohhhh, ça explique la toute petite quantité de fumée..."

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-0/c-2/18 arma_alarm/Arma_2/0/g-0/c-3/18
msgctxt "Arma"
msgid "And it went out a half an hour ago. <w>BLEEP</w>"
msgstr "Et il s'est éteint il y a une demi-heure. <w>BIIIP</w>"

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-0/c-3/7
msgctxt "Arma"
msgid "<w>BLEEP</w> You did? Guess that explains why there was just a tiny amount of smoke..."
msgstr "<w>BIIIP</w> C'est toi ? Ça explique la toute petite quantité de fumée, alors..."

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-1/0/s/0
msgctxt "Choix"
msgid "Ok, now can you—"
msgstr "Bon, maintenant tu peux—"

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-1/c-4/7
msgctxt "Arma"
msgid "Yes! I'll just— <w>BLEEEEEEEEEEE—</w>"
msgstr "Oui ! Je vais juste— <w>BIIIIIIIIIII—</w>"

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-1/c-4/18/0/s/0
msgctxt "Choix"
msgid "TINNITUS IS A REAL THING, YOU KNOW."
msgstr "L'ACOUPHÈNE, ÇA EXISTE, TU SAIS."

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-1/c-4/18/1/s/0
msgctxt "Choix"
msgid "ARMA! DUDE!"
msgstr "ARMA ! OH !"

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-1/c-4/18/c-0/7 arma_alarm/Arma_2/0/g-1/c-4/18/c-1/7
msgctxt "Arma"
msgid "<w>—EEEEEP</w> That should do it!"
msgstr "<w>—IIIIP</w> Voilà qui devrait faire l'affaire !"

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-2/0
msgctxt "Arma"
msgid "So, <w>bip</w> what brings you to my neck of the woods?"
msgstr "Alors, <w>bip</w> qu'est-ce qui t'amène dans mon coin ?"

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-2/11/s/0
msgctxt "Choix"
msgid "I thought maybe we could talk about what you saw when you were little."
msgstr "Je me disais qu'on pourrait parler de ce que tu as vu quand tu étais petite."

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-2/12/s/0
msgctxt "Choix"
msgid "Again, noise complaint."
msgstr "Encore une plainte pour nuisances sonores."

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-2/13/s/0
msgctxt "Choix"
msgid "Ok, I just have to know what the heck that sound is."
msgstr "Bon, il faut vraiment que je sache ce que c'est que ce bruit."

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-2/14/s/0
msgctxt "Choix"
msgid "Just thought I might stop by and see how you were feeling."
msgstr "Je passais juste voir comment tu te sentais."

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-2/c-5/7
msgctxt "Arma"
msgid "Oh... sure. I really appreciate you giving me some space last time."
msgstr "Oh... bien sûr. Merci de m'avoir laissé de l'espace la dernière fois."

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-2/c-5/15
msgctxt "Arma"
msgid "I think I'm ready to talk about it now."
msgstr "Je crois que je suis prête à en parler, maintenant."

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-2/c-6/7
msgctxt "Arma"
msgid "What?! <w>bip</w> There's no noise!"
msgstr "Quoi ?! <w>bip</w> Il n'y a aucun bruit !"

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-2/c-6/21
msgctxt "Dorian"
msgid "There's a noise."
msgstr "Il y a un bruit."

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-2/c-6/29
msgctxt "Arma"
msgid "You mean my alarm? That was a simple accident!"
msgstr "Tu parles de mon alarme ? C'était un simple accident !"

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-2/c-6/37
msgctxt "Dorian"
msgid "No love, they mean your battery. It's low."
msgstr "Non, ma grande, c'est de ta batterie qu'on parle. Elle est faible."

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-2/c-6/45
msgctxt "Arma"
msgid "How dare you!"
msgstr "Comment oses-tu !"

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-2/c-6/56
msgctxt "Dorian"
msgid "Right then, I'm not lookin' for a fight. Best'a luck sortin' it out, you two."
msgstr "Bon, j'cherche pas la bagarre. Bon courage pour vous arranger, vous deux."

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-2/c-6/67
msgctxt "Arma"
msgid "What on earth is he talking about, 'my battery.' My battery is just fine! <w>bip</w>"
msgstr "Mais de quoi il parle, avec sa « batterie » ? Ma batterie va très bien ! <w>bip</w>"

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-2/c-6/78/0/s/0
msgctxt "Choix"
msgid "If your battery is just fine, what's that sound?"
msgstr "Si ta batterie va très bien, c'est quoi ce bruit ?"

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-2/c-8/7
msgctxt "Arma"
msgid "Psssshhhh I'm a hundred percent. Ready for anything! <w>bip</w>"
msgstr "Pfffff, je suis à cent pour cent. Prête à tout ! <w>bip</w>"

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-2/c-8/18
msgctxt "Narrator"
msgid "Arma holds her arm up to stop any further conversation, her eyes narrowing. She sniffs a few times."
msgstr "Arma lève le bras pour couper court à la conversation, les yeux plissés. Elle renifle plusieurs fois."

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-2/c-8/26
msgctxt "Arma"
msgid "Wait a minute... do you smell that?! It smells like... like..."
msgstr "Attends une minute... tu sens ça ?! Ça sent comme... comme..."

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-2/c-8/34/0/s/0
msgctxt "Choix"
msgid "Like a hint of incense wafting on the bree—?"
msgstr "Comme un soupçon d'encens porté par la bri—?"

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-2/c-8/34/1/s/0
msgctxt "Choix"
msgid "Like a stale far—?"
msgstr "Comme un vieux pr—?"

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-2/c-8/34/2/s/0
msgctxt "Choix"
msgid "Like the impending detonation of my precious ear dru—?"
msgstr "Comme l'imminente détonation de mes précieux tympa—?"

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-3/0
msgctxt "Narrator"
msgid "Arma's eyes widen, and your ear drums twinge in anticipation."
msgstr "Les yeux d'Arma s'écarquillent, et vos tympans se crispent d'avance."

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-3/8
msgctxt "Arma"
msgid "FIRE!!!!! <w>BLEEEEEEEEE—</w>"
msgstr "AU FEU !!!!! <w>BIIIIIIIII—</w>"

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-3/22/s/0
msgctxt "Choix"
msgid "Oh lord, here we go again..."
msgstr "Oh là là, c'est reparti..."

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-3/23/s/0
msgctxt "Choix"
msgid "THE PAIN! IT HURTS SO GOOD!"
msgstr "LA DOULEUR ! ÇA FAIT TELLEMENT DU BIEN !"

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-4/0
msgctxt "Arma"
msgid "WE NEED TO GET EVERYONE OUT OF HERE! <w>BLEEP</w>"
msgstr "IL FAUT FAIRE ÉVACUER TOUT LE MONDE ! <w>BIIIP</w>"

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-4/11/s/0
msgctxt "Choix"
msgid "Enough is enough! TURN THAT OFF!"
msgstr "Ça suffit ! COUPE-MOI ÇA !"

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-4/12/s/0
msgctxt "Choix"
msgid "Arma! We're ok! There's no fire!"
msgstr "Arma ! Tout va bien ! Il n'y a pas de feu !"

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-4/13/s/0
msgctxt "Choix"
msgid "MY EARS! MY PRECIOUS EARS!"
msgstr "MES OREILLES ! MES PRÉCIEUSES OREILLES !"

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-4/c-11/7
msgctxt "Arma"
msgid "I'm sorry. You're right... that was, on further inspection, an overreaction."
msgstr "Pardon. Tu as raison... après examen, c'était une réaction excessive."

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-4/c-12/7
msgctxt "Arma"
msgid "Are you sure?! How can you be TOTALLY sure?! <w>bip</w>"
msgstr "Tu es {{sûr|sûre|sûr·e}} ?! Comment peux-tu en être TOTALEMENT {{sûr|sûre|sûr·e}} ?! <w>bip</w>"

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-4/c-13/7
msgctxt "Arma"
msgid "Oh! I'm sorry... did I just hurt you?"
msgstr "Oh ! Pardon... je t'ai fait mal ?"

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-5/0/s/0
msgctxt "Choix"
msgid "Arma, I think we need to talk."
msgstr "Arma, je crois qu'on doit parler."

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-5/1/s/0
msgctxt "Choix"
msgid "Can we chat? What's really going on here?"
msgstr "On peut discuter ? Qu'est-ce qui se passe vraiment ?"

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-5/c-14/7
msgctxt "Arma"
msgid "About what? Everything's great!"
msgstr "De quoi ? Tout va très bien !"

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-5/c-15/7
msgctxt "Arma"
msgid "I don't know what you're talking about! Everything's great!"
msgstr "Je ne sais pas de quoi tu parles ! Tout va très bien !"

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-6/0/s/0
msgctxt "Choix"
msgid "You're pushing so hard you're making mistakes. Why? I'm here to listen."
msgstr "Tu te donnes tellement à fond que tu fais des erreurs. Pourquoi ? Je suis là pour t'écouter."

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-6/1/s/0
msgctxt "Choix"
msgid "You're kind of, well, TERRIBLE at your job."
msgstr "Tu es plutôt, enfin, NULLE dans ton travail."

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-6/c-16/7
msgctxt "Arma"
msgid "I... I..."
msgstr "Je... je..."

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-6/c-16/15/0/s/0
msgctxt "Choix"
msgid "Go ahead. It's ok. You're safe with me."
msgstr "Vas-y. Ce n'est pas grave. Avec moi, tu ne risques rien."

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-6/c-16/15/1/s/0
msgctxt "Choix"
msgid "Spit it out, already! Jeez!"
msgstr "Accouche, à la fin ! Bon sang !"

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-6/c-16/15/c-0/7
msgctxt "Arma"
msgid "I think it all comes down to something that happened in my childhood."
msgstr "Je crois que tout remonte à quelque chose qui s'est passé dans mon enfance."

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-6/c-16/15/c-1/7
msgctxt "Arma"
msgid "No, you know what, I don't feel right talking to you about this. <w>bip</w> I need to be alone."
msgstr "Non, tu sais quoi, je ne me sens pas à l'aise d'en parler avec toi. <w>bip</w> J'ai besoin d'être seule."

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-6/c-17/7
msgctxt "Arma"
msgid "I..."
msgstr "Je..."

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-6/c-17/15/0/s/0
msgctxt "Choix"
msgid "You're sending everyone into a panic every time you make a false alarm."
msgstr "Tu provoques la panique générale à chaque fausse alerte."

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-6/c-17/15/c-0/7
msgctxt "Arma"
msgid "But..."
msgstr "Mais..."

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-6/c-17/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "I'm afraid I'm going to have to ask you to resign, before someone actually does get hurt."
msgstr "J'ai bien peur de devoir te demander de démissionner, avant que quelqu'un soit vraiment blessé."

# Traduction IA – à relire
#: arma_alarm/Arma_2/0/g-6/c-17/15/c-0/15/c-0/7
msgctxt "Arma"
msgid "Wow. Ok... if that's how you really feel. I guess this is goodbye."
msgstr "Waouh. Ok... si c'est ce que tu penses vraiment. Je crois que c'est un adieu."

# Traduction IA – à relire
#: arma_alarm/ArmaBatteryLow/0/0
msgctxt "Arma"
msgid "What sound? I don't hear a sound! <w>bip</w> I feel great!"
msgstr "Quel bruit ? Je n'entends rien ! <w>bip</w> Je suis en pleine forme !"

# Traduction IA – à relire
#: arma_alarm/ArmaBatteryLow/0/11/s/0
msgctxt "Choix"
msgid "You might be due for a recharge. When was the last time you took a break?"
msgstr "Tu aurais peut-être besoin de te recharger. C'est quand, la dernière fois que tu as fait une pause ?"

# Traduction IA – à relire
#: arma_alarm/ArmaBatteryLow/0/12/s/0
msgctxt "Choix"
msgid "Your battery is almost dead!"
msgstr "Ta batterie est presque à plat !"

# Traduction IA – à relire
#: arma_alarm/ArmaBatteryLow/0/c-0/7
msgctxt "Arma"
msgid "A break!? I don't take breaks. I CAN'T take breaks."
msgstr "Une pause ?! Je ne fais pas de pauses. Je NE PEUX PAS en faire."

# Traduction IA – à relire
#: arma_alarm/ArmaBatteryLow/0/c-0/15
msgctxt "Arma"
msgid "If I take a break, everyone will die!"
msgstr "Si je fais une pause, tout le monde va mourir !"

# Traduction IA – à relire
#: arma_alarm/ArmaBatteryLow/0/c-1/7
msgctxt "Arma"
msgid "You saying I need to take time off!?"
msgstr "Tu veux dire que je dois prendre du repos ?!"

# Traduction IA – à relire
#: arma_alarm/ArmaBatteryLow/0/c-1/15
msgctxt "Arma"
msgid "Just to recharge!? I don't take 'breaks'."
msgstr "Juste pour me recharger ?! Je ne fais pas de « pauses »."

# Traduction IA – à relire
#: arma_alarm/ArmaBatteryLow/0/g-0/0/s/0
msgctxt "Choix"
msgid "You <i>have</i> to take breaks!"
msgstr "Tu <i>dois</i> faire des pauses !"

# Traduction IA – à relire
#: arma_alarm/ArmaBatteryLow/0/g-0/1/s/0
msgctxt "Choix"
msgid "Arma, what's all this about? Where is this actually coming from?"
msgstr "Arma, qu'est-ce que c'est que tout ça ? D'où ça vient, au juste ?"

# Traduction IA – à relire
#: arma_alarm/ArmaBatteryLow/0/g-0/c-2/7
msgctxt "Arma"
msgid "You don't know what you're talking about."
msgstr "Tu ne sais pas de quoi tu parles."

# Traduction IA – à relire
#: arma_alarm/ArmaBatteryLow/0/g-0/c-2/15
msgctxt "Arma"
msgid "Now if you'll excuse me, I've got a very important job to do!"
msgstr "Maintenant, si tu veux bien m'excuser, j'ai un travail très important à faire !"

# Traduction IA – à relire
#: arma_alarm/ArmaBatteryLow/0/g-0/c-2/23/0/s/0
msgctxt "Choix"
msgid "Arma, pushing so hard is actually making you WORSE at your job, not better."
msgstr "Arma, te donner à ce point te rend PIRE dans ton travail, pas meilleure."

# Traduction IA – à relire
#: arma_alarm/ArmaBatteryLow/0/g-0/c-2/23/1/s/0 arma_alarm/ArmaBatteryLow/0/g-0/c-3/26/0/s/0
msgctxt "Choix"
msgid "You've been slipping at work, Arma. You can see that, right?"
msgstr "Tu déconnes au travail, Arma. Tu t'en rends compte, non ?"

# Traduction IA – à relire
#: arma_alarm/ArmaBatteryLow/0/g-0/c-2/23/c-0/7
msgctxt "Arma"
msgid "I... I... I can't take this right now! I have to go!"
msgstr "Je... je... je ne peux pas encaisser ça maintenant ! Je dois y aller !"

# Traduction IA – à relire
#: arma_alarm/ArmaBatteryLow/0/g-0/c-2/23/c-1/7 arma_alarm/ArmaBatteryLow/0/g-0/c-3/26/c-0/7
msgctxt "Arma"
msgid "I can't do this. Not right now. I need to leave!"
msgstr "Je ne peux pas faire ça. Pas maintenant. Je dois partir !"

# Traduction IA – à relire
#: arma_alarm/ArmaBatteryLow/0/g-0/c-3/7
msgctxt "Arma"
msgid "Where's all what coming from? <w>bip</w>"
msgstr "D'où ça vient, quoi ? <w>bip</w>"

# Traduction IA – à relire
#: arma_alarm/ArmaBatteryLow/0/g-0/c-3/18
msgctxt "Arma"
msgid "I don't know what you're talking about!"
msgstr "Je ne sais pas de quoi tu parles !"

# Traduction IA – à relire
#: arma_alarm/ArmaBatteryLow/0/g-0/c-3/26/1/s/0
msgctxt "Choix"
msgid "This is serious. I really need to know. Your behavior is endangering others."
msgstr "C'est sérieux. J'ai vraiment besoin de savoir. Ton comportement met les autres en danger."

# Traduction IA – à relire
#: arma_alarm/ArmaBatteryLow/0/g-0/c-3/26/2/s/0
msgctxt "Choix"
msgid "Does this have something to do with what you were starting to tell me last time?"
msgstr "Est-ce que ça a un rapport avec ce que tu commençais à me raconter la dernière fois ?"

# Traduction IA – à relire
#: arma_alarm/ArmaBatteryLow/0/g-0/c-3/26/c-1/7
msgctxt "Arma"
msgid "It is? No! No it's not! That can't be true! I need to go!"
msgstr "C'est vrai ? Non ! Non, ce n'est pas possible ! Je dois partir !"

# Traduction IA – à relire
#: arma_alarm/ArmaBatteryLow/0/g-0/c-3/26/c-2/15/0/s/0
msgctxt "Choix"
msgid "It's ok. You can open up to me."
msgstr "C'est bon. Tu peux t'ouvrir à moi."

# Traduction IA – à relire
#: arma_alarm/ArmaBatteryLow/0/g-0/c-3/26/c-2/15/1/s/0
msgctxt "Choix"
msgid "I just want to help."
msgstr "Je veux juste t'aider."

# Traduction IA – à relire
#: arma_alarm/ArmaBatteryLow/0/g-0/c-3/26/c-2/15/g-0/0
msgctxt "Arma"
msgid "Really? Well... Ok. I'll tell you what happened."
msgstr "Vraiment ? Eh bien... d'accord. Je vais te raconter ce qui s'est passé."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/0
msgctxt "Narrator"
msgid "Arma is quiet for a few moments, gathering herself. She doesn't quite look at you as she speaks."
msgstr "Arma reste silencieuse quelques instants, le temps de se ressaisir. Elle ne vous regarde pas tout à fait quand elle parle."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/8
msgctxt "Arma"
msgid "When I was young, I was placed on the wall near the front of a window."
msgstr "Quand j'étais jeune, on m'avait accrochée au mur près d'une fenêtre, à l'avant."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/16
msgctxt "Arma"
msgid "It was a wonderful place."
msgstr "C'était un endroit merveilleux."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/24
msgctxt "Arma"
msgid "I could watch the outside world, with all its color, bustle, and excitement!"
msgstr "Je pouvais observer le monde extérieur, avec toutes ses couleurs, son agitation, son effervescence !"

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/32
msgctxt "Arma"
msgid "I could see the neighbors' houses."
msgstr "Je voyais les maisons des voisins."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/40
msgctxt "Arma"
msgid "It was all so beautiful, and so... innocent. But then..."
msgstr "Tout était si beau, et si... innocent. Mais ensuite..."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/49/s/0
msgctxt "Choix"
msgid "Something bad happened, didn't it?"
msgstr "Quelque chose de grave est arrivé, n'est-ce pas ?"

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-0/3
msgctxt "Arma"
msgid "One morning, I saw smoke rising from one of the neighbor's windows, across the street."
msgstr "Un matin, j'ai vu de la fumée s'élever d'une fenêtre chez un voisin, de l'autre côté de la rue."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-0/11
msgctxt "Arma"
msgid "I thought it was just a piece of burnt toast or something, because they were always doing that."
msgstr "J'ai cru que c'était juste du pain grillé trop cuit ou un truc du genre, parce qu'ils faisaient tout le temps ça."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-0/19
msgctxt "Arma"
msgid "And so I... I said nothing."
msgstr "Et alors je... je n'ai rien dit."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-0/27/s/0
msgctxt "Choix"
msgid "But it wasn't a piece of burnt toast, was it, Arma?"
msgstr "Mais ce n'était pas du pain grillé, n'est-ce pas, Arma ?"

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-0/28/s/0
msgctxt "Choix"
msgid "Oh, Arma..."
msgstr "Oh, Arma..."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-0/c-2/7 arma_alarm/ArmaGetsABadIdea/0/g-3/75
msgctxt "Arma"
msgid "No..."
msgstr "Non..."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-1/0
msgctxt "Arma"
msgid "It was a fire. It was horrible."
msgstr "C'était un incendie. C'était horrible."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-1/8
msgctxt "Arma"
msgid "By the time the fire trucks got there, it was already too late."
msgstr "Quand les pompiers sont arrivés, il était déjà trop tard."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-1/19
msgctxt "Arma"
msgid "Everything burned. The paint peeled and charred, the glass shattered."
msgstr "Tout a brûlé. La peinture a cloqué et noirci, les vitres ont éclaté."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-1/27
msgctxt "Arma"
msgid "The whole house, and every single thing in it... all destroyed."
msgstr "Toute la maison, et chaque chose qu'elle contenait... entièrement détruites."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-1/35/s/0
msgctxt "Choix"
msgid "And you had to watch the whole thing... I'm so sorry."
msgstr "Et tu as dû assister à tout ça... Je suis vraiment {{désolé|désolée|désolé·e}}."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-1/36/s/0
msgctxt "Choix"
msgid "That's truly devastating."
msgstr "C'est vraiment dévastateur."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-2/0
msgctxt "Arma"
msgid "I never forgot that day. Never."
msgstr "Je n'ai jamais oublié ce jour. Jamais."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-2/8
msgctxt "Arma"
msgid "It's what made me want to be the best protector I can be."
msgstr "C'est ce qui m'a donné envie d'être la meilleure protectrice possible."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-2/16
msgctxt "Arma"
msgid "It gave me the passion I needed to endure all the hours of training."
msgstr "C'est ce qui m'a donné la passion nécessaire pour endurer toutes ces heures d'entraînement."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-2/24
msgctxt "Arma"
msgid "It's also why I never let my guard down."
msgstr "C'est aussi pour ça que je ne baisse jamais ma garde."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-2/32/s/0
msgctxt "Choix"
msgid "Because you never want that to happen here."
msgstr "Parce que tu ne veux pas que ça arrive ici."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-2/33/s/0
msgctxt "Choix"
msgid "Now I really understand. Thank you."
msgstr "Maintenant je comprends vraiment. Merci."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-2/c-6/7
msgctxt "Arma"
msgid "No. I will never let that happen here."
msgstr "Non. Je ne laisserai jamais ça arriver ici."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-2/c-7/7
msgctxt "Arma"
msgid "Yes. Now you understand."
msgstr "Oui. Maintenant tu comprends."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-3/0/s/0
msgctxt "Choix"
msgid "It sounds to me like you've suffered some real trauma."
msgstr "J'ai l'impression que tu as subi un vrai traumatisme."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-3/1/s/0
msgctxt "Choix"
msgid "What you've been through sounds really difficult."
msgstr "Ce que tu as traversé a l'air vraiment difficile."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-3/c-8/7
msgctxt "Arma"
msgid "Really? But all I did was see it happen."
msgstr "Vraiment ? Mais je n'ai fait que regarder."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-3/c-9/7
msgctxt "Arma"
msgid "It wasn't that bad. Other people have suffered far worse."
msgstr "Ce n'était pas si grave. D'autres ont subi bien pire."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-4/0/s/0
msgctxt "Choix"
msgid "Don't underplay it."
msgstr "Ne minimise pas."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-4/1/s/0
msgctxt "Choix"
msgid "Witnessing a traumatic event can be just as damaging as being involved."
msgstr "Être témoin d'un événement traumatisant peut être tout aussi destructeur que d'y être impliqué."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-4/c-10/7
msgctxt "Arma"
msgid "I guess I shouldn't do that... but what should I do?"
msgstr "Je suppose que je ne devrais pas... mais que dois-je faire ?"

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-4/c-11/7
msgctxt "Arma"
msgid "I didn't know that. What should I do?"
msgstr "Je ne le savais pas. Que dois-je faire ?"

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-5/0/s/0
msgctxt "Choix"
msgid "Make healing yourself a priority. Whatever that means to you, I think you should do it."
msgstr "Fais de ta guérison une priorité. Quoi que ça signifie pour toi, je crois que tu devrais le faire."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-5/1/s/0
msgctxt "Choix"
msgid "Rest. Surround yourself with calm, with others who love you."
msgstr "Repose-toi. Entoure-toi de calme, et de gens qui t'aiment."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-5/c-12/7
msgctxt "Arma"
msgid "Ok..."
msgstr "Ok..."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-5/c-13/7
msgctxt "Arma"
msgid "I can do that..."
msgstr "Je peux faire ça..."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-6/0
msgctxt "Arma"
msgid "But what about my job?"
msgstr "Mais mon travail alors ?"

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-6/8/s/0
msgctxt "Choix"
msgid "I'll keep an eye on everything and make absolutely sure we stay safe."
msgstr "Je garderai un oeil sur tout et je ferai absolument en sorte qu'on reste en sécurité."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-7/0
msgctxt "Arma"
msgid "You... you would do that for me?"
msgstr "Tu... tu ferais ça pour moi ?"

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-7/8/s/0
msgctxt "Choix"
msgid "I would. I care about you."
msgstr "Oui. Je tiens à toi."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-7/9/s/0
msgctxt "Choix"
msgid "I would do that for anyone who needed it."
msgstr "Je le ferais pour quiconque en aurait besoin."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-7/c-15/7
msgctxt "Arma"
msgid "You mean you... you think of me? As special?"
msgstr "Tu veux dire que tu... tu penses à moi ? Que je compte ?"

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-7/c-15/15
msgctxt "Arma"
msgid "Maybe when I'm better, I can follow up on that feeling."
msgstr "Quand j'irai mieux, je pourrai peut-être donner suite à ce sentiment."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-7/c-16/7
msgctxt "Arma"
msgid "Thank you. Seriously. That means the world to me."
msgstr "Merci. Sincèrement. Ça compte énormément pour moi."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-8/0
msgctxt "Arma"
msgid "I'm going to get started on my healing journey right now. <w>bip</w>"
msgstr "Je vais commencer mon chemin vers la guérison dès maintenant. <w>bip</w>"

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-8/8/s/0
msgctxt "Choix"
msgid "Recharging that battery might not be a bad place to start..."
msgstr "Recharger cette batterie serait peut-être un bon début..."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-8/9/s/0
msgctxt "Choix"
msgid "Sounds like you ought to rest right now."
msgstr "On dirait que tu devrais te reposer maintenant."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-9/0
msgctxt "Arma"
msgid "Heheh... yeah. I guess I've been beeping for a while now... Sorry about that."
msgstr "Hé hé... oui. Je crois que je bipe depuis un moment... Désolée pour ça."

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-9/8
msgctxt "Arma"
msgid "I was so focused on keeping a lookout that I didn't even notice!"
msgstr "J'étais tellement concentrée sur la surveillance que je ne m'en suis même pas aperçue !"

# Traduction IA – à relire
#: arma_alarm/ArmaTellsAll/0/g-9/23
msgctxt "Narrator"
msgid "The beepless Arma begins her healing journey, and you take your leave."
msgstr "Arma, désormais silencieuse, entame sa guérison, et vous prenez congé."

# Traduction IA – à relire
#: arma_alarm/arma_hate_return/0/11/s/0
msgctxt "Choix"
msgid "HELLO?!?!"
msgstr "ALLÔ ?!?!"

# Traduction IA – à relire
#: arma_alarm/arma_hate_return/0/12/s/0
msgctxt "Choix"
msgid "ARMA! ARE YOU IN THERE?!"
msgstr "ARMA ! TU ES LÀ-DEDANS ?!"

# Traduction IA – à relire
#: arma_alarm/arma_hate_return/0/g-0/0
msgctxt "Arma"
msgid "<w>EEEEEEEEEEEEEEEEEE—</w>"
msgstr "<w>IIIIIIIIIIIIIIIIIII—</w>"

# Traduction IA – à relire
#: arma_alarm/arma_hate_return/0/g-0/11/s/0
msgctxt "Choix"
msgid "ARMA! THERE'S NO FIRE!"
msgstr "ARMA ! IL N'Y A PAS DE FEU !"

# Traduction IA – à relire
#: arma_alarm/arma_hate_return/0/g-0/12/s/0
msgctxt "Choix"
msgid "I'M GONNA HAVE TO PULL YOUR BATTERY! (USE EMPATHY CANDY)"
msgstr "IL VA FALLOIR QUE JE TE RETIRE LA BATTERIE ! (UTILISER UN BONBON D'EMPATHIE)"

# Traduction IA – à relire
#: arma_alarm/arma_hate_return/0/g-0/c-2/7 arma_alarm/arma_hate_return/0/g-0/c-3/13
msgctxt "Arma"
msgid "Wha?! <w>BLEEEEEEEEEEEE—</w> EMERGENCY! I've got to save us!"
msgstr "Hein ?! <w>BIIIIIIIIIII—</w> URGENCE ! Je dois nous sauver !"

# Traduction IA – à relire
#: arma_alarm/arma_hate_return/0/g-0/c-2/18
msgctxt "Arma"
msgid "WE'RE NOT SAFE! <w>BLEEEEEEEE—</w>"
msgstr "ON N'EST PAS EN SÉCURITÉ ! <w>BIIIIIIII—</w>"

# Traduction IA – à relire
#: arma_alarm/arma_hate_return/0/g-0/c-3/24
msgctxt "Arma"
msgid "WE'RE NOT SAFE! <w>bLEEEEEEEE</w>—WE'RE NOT SAFE!<w>BLEEEEEEEE—</w>"
msgstr "ON N'EST PAS EN SÉCURITÉ ! <w>bIIIIIIII</w>—ON N'EST PAS EN SÉCURITÉ !<w>BIIIIIIII—</w>"

# Traduction IA – à relire
#: arma_alarm/ArmaBatteryPull/0/0 arma_alarm/ArmaHouseOnFire/0/g-1/c-6/18/c-0/15/c-2/7 arma_alarm/ArmaHouseOnFire/0/g-1/c-7/10
msgctxt "Narrator"
msgid "You snake your arm around Arma's back, your fingers finding the battery hatch and popping it open with a speed that surprises even you. You yank the battery out, clutching it tightly in your fist as you pull away from her."
msgstr "Vous glissez le bras dans le dos d'Arma, vos doigts trouvent la trappe de la batterie et l'ouvrent avec une rapidité qui vous surprend vous-même. Vous arrachez la batterie, la serrez fort dans votre poing et vous écartez d'elle."

# Traduction IA – à relire
#: arma_alarm/ArmaBatteryPull/0/16
msgctxt "Narrator"
msgid "Arma falls silent, her eyes glassy and dull."
msgstr "Arma se tait, le regard vitreux et éteint."

# Traduction IA – à relire
#: arma_alarm/ArmaBatteryPull/0/24/s/0
msgctxt "Choix"
msgid "<i>Reset Arma's Battery.</i>"
msgstr "<i>Réinitialiser la batterie d'Arma.</i>"

# Traduction IA – à relire
#: arma_alarm/ArmaBatteryPull/0/25/s/0
msgctxt "Choix"
msgid "<i>Leave Arma in Sleep Mode.</i>"
msgstr "<i>Laisser Arma en veille.</i>"

# Traduction IA – à relire
#: arma_alarm/ArmaBatteryPull/0/c-1/7
msgctxt "Arma"
msgid "Bip bip bip bip bip bip bip bip bip bip..."
msgstr "Bip bip bip bip bip bip bip bip bip bip..."

# Traduction IA – à relire
#: arma_alarm/ArmaBatteryPull/0/c-1/22
msgctxt "Narrator"
msgid "Better to let sleeping alarms lie."
msgstr "Mieux vaut ne pas réveiller l'alarme qui dort."

# Traduction IA – à relire
#: arma_alarm/ArmaWakesUp/0/0 arma_alarm/ArmaDeadEnding/0/c-1/23/c-0/21
msgctxt "Narrator"
msgid "Arma jerks to life, full of energy and vigor—it's as if she never left."
msgstr "Arma reprend vie d'un coup, pleine d'énergie et de vigueur, comme si elle ne s'était jamais absentée."

# Traduction IA – à relire
#: arma_alarm/ArmaWakesUp/0/8
msgctxt "Arma"
msgid "<w>ZZZZAAAAP!</w>"
msgstr "<w>ZZZZZAAAAP !</w>"

# Traduction IA – à relire
#: arma_alarm/ArmaWakesUp/0/19
msgctxt "Arma"
msgid "Whoah. Hello? That was weird."
msgstr "Waouh. Allô ? C'était bizarre."

# Traduction IA – à relire
#: arma_alarm/ArmaWakesUp/0/27/s/0
msgctxt "Choix"
msgid "Hey Arma... I'm sorry, but I had to reset your battery."
msgstr "Hé Arma... {{Désolé|Désolée|Désolé·e}}, mais j'ai dû réinitialiser ta batterie."

# Traduction IA – à relire
#: arma_alarm/ArmaWakesUp/0/28/s/0
msgctxt "Choix"
msgid "I'll say! Ya just sorta conked out for a sec."
msgstr "Tu l'as dit ! Tu t'es un peu éteinte pendant une seconde."

# Traduction IA – à relire
#: arma_alarm/ArmaWakesUp/0/c-0/7
msgctxt "Arma"
msgid "Why? Was something wrong?"
msgstr "Pourquoi ? Il y avait un problème ?"

# Traduction IA – à relire
#: arma_alarm/ArmaWakesUp/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "Erm. Yes."
msgstr "Euh. Oui."

# Traduction IA – à relire
#: arma_alarm/ArmaWakesUp/0/c-0/15/1/s/0
msgctxt "Choix"
msgid "Oh, just got the feeling you needed it."
msgstr "Oh, j'ai juste senti que tu en avais besoin."

# Traduction IA – à relire
#: arma_alarm/ArmaWakesUp/0/c-0/15/c-0/7
msgctxt "Arma"
msgid "Well, no matter. I feel great! Super refreshed!"
msgstr "Bah, peu importe. Je me sens super bien ! Complètement ressourcée !"

# Traduction IA – à relire
#: arma_alarm/ArmaWakesUp/0/c-0/15/c-1/7
msgctxt "Arma"
msgid "Guess I did! But now I feel right as rain!"
msgstr "J'imagine que oui ! Mais maintenant je suis en pleine forme !"

# Traduction IA – à relire
#: arma_alarm/ArmaWakesUp/0/c-1/7
msgctxt "Arma"
msgid "Whoops! Can't just be sleepin on the job, can I!"
msgstr "Oups ! On ne s'endort pas au travail, hein !"

# Traduction IA – à relire
#: arma_alarm/ArmaWakesUp/0/g-0/0
msgctxt "Arma"
msgid "I'm gonna get back to work. Come around any time if you wanna hang out!"
msgstr "Je retourne bosser. Passe quand tu veux si l'envie te prend de traîner ensemble !"

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/0
msgctxt "Arma"
msgid "Hey! I'm glad you came back. I was hoping I'd get another chance to talk to you."
msgstr "Hé ! Je suis contente que tu sois {{revenu|revenue|revenu·e}}. J'espérais avoir une autre occasion de te parler."

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/8/s/0
msgctxt "Choix"
msgid "What about?"
msgstr "À propos de quoi ?"

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/9/s/0
msgctxt "Choix"
msgid "I hoped I didn't offend you..."
msgstr "J'espère que je ne t'ai pas vexée..."

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/c-1/7
msgctxt "Arma"
msgid "No! The opposite."
msgstr "Non ! Au contraire."

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/g-0/0
msgctxt "Arma"
msgid "After I left last time, I really thought about what you said."
msgstr "Après mon départ, l'autre jour, j'ai vraiment réfléchi à ce que tu m'avais dit."

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/g-0/8
msgctxt "Arma"
msgid "You telling me that my stress was negatively impacting my work..."
msgstr "Que mon stress nuisait à mon travail..."

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/g-0/16
msgctxt "Arma"
msgid "That really got through to me."
msgstr "Ça m'a vraiment touchée."

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/g-0/24/s/0
msgctxt "Choix"
msgid "Glad to hear that."
msgstr "{{Ravi|Ravie|Ravi·e}} de l'entendre."

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/g-0/25/s/0
msgctxt "Choix"
msgid "I was worried about you."
msgstr "Je m'inquiétais pour toi."

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/g-0/c-3/7
msgctxt "Arma"
msgid "I could tell... And it was what I needed to hear."
msgstr "Je m'en doutais... Et c'est ce que j'avais besoin d'entendre."

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/g-1/0
msgctxt "Arma"
msgid "In fact, it made me realize that I needed to focus more on making sure I'm ok..."
msgstr "En fait, ça m'a fait comprendre que je devais d'abord veiller à aller bien moi-même..."

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/g-1/8
msgctxt "Arma"
msgid "Before I can start trying to help others."
msgstr "Avant de pouvoir essayer d'aider les autres."

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/g-1/16
msgctxt "Arma"
msgid "So I took some much needed R&R, and even healed some old wounds."
msgstr "Alors j'ai pris un repos bien mérité, et j'ai même soigné de vieilles blessures."

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/g-1/24/0/s/0
msgctxt "Choix"
msgid "Did it help?"
msgstr "Ça a aidé ?"

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/g-1/24/1/s/0
msgctxt "Choix"
msgid "How do you feel now?"
msgstr "Comment tu te sens maintenant ?"

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/g-1/24/c-4/7
msgctxt "Arma"
msgid "Absolutely! I set three new PRs in my training, and on top of all that..."
msgstr "Carrément ! J'ai battu trois records perso à l'entraînement, et en plus de tout ça..."

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/g-1/24/c-4/18 arma_alarm/Arma_Tough_Love/0/g-1/24/c-5/15
msgctxt "Arma"
msgid "I realized that my battery was in dire need of a recharge!"
msgstr "J'ai compris que ma batterie avait grand besoin d'être rechargée !"

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/g-1/24/c-5/7
msgctxt "Arma"
msgid "Awesome! I set three new PRs in my training, and on top of all that..."
msgstr "Génial ! J'ai battu trois records perso à l'entraînement, et en plus de tout ça..."

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/g-3/0/s/0
msgctxt "Choix"
msgid "Yeah, I think we all might have noticed that..."
msgstr "Oui, je crois qu'on l'avait tous remarqué..."

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/g-3/1/s/0
msgctxt "Choix"
msgid "No. Really? I barely noticed when all that beeping stopped."
msgstr "Non. Vraiment ? J'ai à peine remarqué quand les bips se sont arrêtés."

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/g-4/0
msgctxt "Arma"
msgid "Heheh... oops! Well, now I'm operating at a hundred percent again!"
msgstr "Hé hé... oups ! Enfin, maintenant je fonctionne de nouveau à cent pour cent !"

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/g-4/8
msgctxt "Arma"
msgid "And feeling like a million bucks, besides!"
msgstr "Et je me sens comme un million de dollars, en plus !"

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/g-4/16
msgctxt "Arma"
msgid "Thanks to you, I can actually keep this place safe."
msgstr "Grâce à toi, je peux enfin protéger cet endroit comme il faut."

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/g-4/24/b/4
msgctxt "Dorian"
msgid "And avoid all those noise complaints..."
msgstr "Et éviter toutes ces plaintes pour nuisances sonores..."

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/g-4/24/b/12
msgctxt "Arma"
msgid "That's right Dorian! Sorry for all that."
msgstr "C'est vrai, Dorian ! Désolée pour tout ça."

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/g-4/24/b/23
msgctxt "Dorian"
msgid "Not a problem, love. Glad you're feelin' tip top again."
msgstr "Pas de souci, ma grande. Content de te voir de nouveau d'attaque."

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/g-4/27/0
msgctxt "Narrator"
msgid "Arma winds a wisp of smoke around one finger nervously, like one might with a strand of actual hair."
msgstr "Arma enroule nerveusement un filet de fumée autour d'un doigt, comme on le ferait avec une vraie mèche de cheveux."

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/g-4/27/8
msgctxt "Arma"
msgid "So... now that I've got my energy back, would you maybe want to..."
msgstr "Alors... maintenant que j'ai retrouvé mon énergie, est-ce que tu voudrais peut-être..."

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/g-4/27/16
msgctxt "Arma"
msgid "Do something with me?"
msgstr "Faire quelque chose avec moi ?"

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/g-4/27/24/s/0
msgctxt "Choix"
msgid "Something like a date? I'd love that..."
msgstr "Quelque chose comme un rencard ? Ça me plairait beaucoup..."

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/g-4/27/25/s/0
msgctxt "Choix"
msgid "I'd love to do something with you as a friend."
msgstr "Ça me plairait de faire quelque chose avec toi en tant qu'{{ami|amie|ami·e}}."

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/g-4/27/c-8/7
msgctxt "Arma"
msgid "So even after I've been so annoying, you'd still consider dating me?"
msgstr "Alors même après que j'ai été si pénible, tu envisagerais de sortir avec moi ?"

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/g-4/27/c-8/15
msgctxt "Arma"
msgid "You don't know how happy that makes me!"
msgstr "Tu n'imagines pas à quel point ça me rend heureuse !"

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/g-4/27/c-9/7
msgctxt "Arma"
msgid "So even after I've been so annoying, you still wanna hang out with me?"
msgstr "Alors même après que j'ai été si pénible, tu as encore envie de traîner avec moi ?"

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/g-4/27/c-9/15
msgctxt "Arma"
msgid "That makes me so happy!"
msgstr "Ça me rend si heureuse !"

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/g-6/0
msgctxt "Arma"
msgid "So what should we do? We could—"
msgstr "Alors, qu'est-ce qu'on fait ? On pourrait—"

# Traduction IA – à relire
#: arma_alarm/Arma_Tough_Love/0/g-6/8 arma_alarm/Arma_Recharged/0/g-2/27
msgctxt "Arma"
msgid "Wait a minute..."
msgstr "Attends une minute..."

# Traduction IA – à relire
#: arma_alarm/Arma_Recharged/0/0
msgctxt "Arma"
msgid "You! Hi! I'm so happy to see you!"
msgstr "Toi ! Salut ! Je suis tellement contente de te voir !"

# Traduction IA – à relire
#: arma_alarm/Arma_Recharged/0/8/s/0
msgctxt "Choix"
msgid "Me too! What's crackin'?"
msgstr "Moi aussi ! Quoi de neuf ?"

# Traduction IA – à relire
#: arma_alarm/Arma_Recharged/0/9/s/0
msgctxt "Choix"
msgid "Hi Arma. You seem much better than the last time I saw you!"
msgstr "Salut Arma. Tu as l'air bien mieux que la dernière fois !"

# Traduction IA – à relire
#: arma_alarm/Arma_Recharged/0/c-0/7
msgctxt "Arma"
msgid "I'll tell you what! I am! I feel like a huge weight has been taken off of me."
msgstr "Je te le fais pas dire ! Je me sens délestée d'un poids énorme."

# Traduction IA – à relire
#: arma_alarm/Arma_Recharged/0/c-1/7
msgctxt "Arma"
msgid "I feel like a huge weight has been taken off of me."
msgstr "Je me sens délestée d'un poids énorme."

# Traduction IA – à relire
#: arma_alarm/Arma_Recharged/0/g-0/0
msgctxt "Arma"
msgid "I owe it all to you. You helped me release the burden I had been carrying for so long..."
msgstr "Je te dois tout. Tu m'as aidée à me libérer du fardeau que je portais depuis si longtemps..."

# Traduction IA – à relire
#: arma_alarm/Arma_Recharged/0/g-0/8/s/0
msgctxt "Choix"
msgid "Has it made you feel more relaxed?"
msgstr "Tu te sens plus détendue ?"

# Traduction IA – à relire
#: arma_alarm/Arma_Recharged/0/g-0/9/s/0
msgctxt "Choix"
msgid "And you still feel sharp at work?"
msgstr "Et tu te sens toujours aussi affûtée au travail ?"

# Traduction IA – à relire
#: arma_alarm/Arma_Recharged/0/g-0/c-2/7
msgctxt "Arma"
msgid "You have no idea! I'm not sure if you noticed, but my batteries are totally full now."
msgstr "Tu n'imagines pas ! Je ne sais pas si tu as remarqué, mais mes batteries sont complètement pleines."

# Traduction IA – à relire
#: arma_alarm/Arma_Recharged/0/g-0/c-3/7
msgctxt "Arma"
msgid "Even more than ever! And my batteries are FULL!"
msgstr "Plus que jamais ! Et mes batteries sont PLEINES !"

# Traduction IA – à relire
#: arma_alarm/Arma_Recharged/0/g-1/0
msgctxt "Arma"
msgid "No more unnecessary beeping."
msgstr "Fini les bips inutiles."

# Traduction IA – à relire
#: arma_alarm/Arma_Recharged/0/g-1/8/s/0
msgctxt "Choix"
msgid "That's great!"
msgstr "C'est génial !"

# Traduction IA – à relire
#: arma_alarm/Arma_Recharged/0/g-1/9/s/0
msgctxt "Choix"
msgid "Yes, Arma, YES!"
msgstr "Oui, Arma, OUI !"

# Traduction IA – à relire
#: arma_alarm/Arma_Recharged/0/g-1/10/s/0
msgctxt "Choix"
msgid "You're killing it girl!"
msgstr "Tu gères, Arma !"

# Traduction IA – à relire
#: arma_alarm/Arma_Recharged/0/g-2/0
msgctxt "Arma"
msgid "Not to mention, releasing all that tension and anxiety has given me so much more energy to focus on my job!"
msgstr "Sans compter que me libérer de toute cette tension et de cette anxiété m'a donné bien plus d'énergie pour me concentrer sur mon travail !"

# Traduction IA – à relire
#: arma_alarm/Arma_Recharged/0/g-2/11
msgctxt "Arma"
msgid "I've set some new records in my training, and the relaxation has me far more perceptive."
msgstr "J'ai battu de nouveaux records à l'entraînement, et la détente me rend beaucoup plus perspicace."

# Traduction IA – à relire
#: arma_alarm/Arma_Recharged/0/g-2/19
msgctxt "Arma"
msgid "Thank you so—"
msgstr "Merci infiniment—"

# Traduction IA – à relire
#: arma_alarm/ArmaFire/0/3/s/0
msgctxt "Choix"
msgid "Arma?"
msgstr "Arma ?"

# Traduction IA – à relire
#: arma_alarm/ArmaFire/0/4/s/0
msgctxt "Choix"
msgid "Everything alright?"
msgstr "Tout va bien ?"

# Traduction IA – à relire
#: arma_alarm/ArmaFire/0/5/s/0
msgctxt "Choix"
msgid "Why do I suspect there's about to be a plot twist?"
msgstr "Pourquoi j'ai l'impression qu'un coup de théâtre se prépare ?"

# Traduction IA – à relire
#: arma_alarm/ArmaFire/0/g-0/0
msgctxt "Arma"
msgid "Do you smell that?"
msgstr "Tu sens ça ?"

# Traduction IA – à relire
#: arma_alarm/ArmaFire/0/g-0/9/s/0
msgctxt "Choix"
msgid "Do I smell... what?"
msgstr "Si je sens... quoi ?"

# Traduction IA – à relire
#: arma_alarm/ArmaFire/0/g-0/10/s/0
msgctxt "Choix"
msgid "Knew it."
msgstr "Je le savais."

# Traduction IA – à relire
#: arma_alarm/ArmaFire/0/g-1/0
msgctxt "Arma"
msgid "<w>BLEEP BLEEP BLEEP</w>"
msgstr "<w>BIIIP BIIIP BIIIP</w>"

# Traduction IA – à relire
#: arma_alarm/ArmaFire/0/g-1/11/s/0
msgctxt "Choix"
msgid "Oh for crying out loud."
msgstr "Oh, bon sang."

# Traduction IA – à relire
#: arma_alarm/ArmaFire/0/g-1/12/s/0
msgctxt "Choix"
msgid "Arma! Your alarm!"
msgstr "Arma ! Ton alarme !"

# Traduction IA – à relire
#: arma_alarm/ArmaFire/0/g-2/0
msgctxt "Arma"
msgid "There's a fire!"
msgstr "Il y a un incendie !"

# Traduction IA – à relire
#: arma_alarm/ArmaFire/0/g-2/8/s/0
msgctxt "Choix"
msgid "Arma, you're overreacting again. Please turn that off."
msgstr "Arma, tu t'emballes encore. Coupe ça, s'il te plaît."

# Traduction IA – à relire
#: arma_alarm/ArmaFire/0/g-2/9/s/0
msgctxt "Choix"
msgid "A fire!? Where is it coming from? How can I help?"
msgstr "Un incendie ?! D'où vient-il ? Comment je peux aider ?"

# Traduction IA – à relire
#: arma_alarm/Arma_Failure/0/0
msgctxt "Arma"
msgid "Are... are you sure? But I really think... ok... I'll turn it off."
msgstr "Tu... tu es {{sûr|sûre|sûr·e}} ? Mais je crois vraiment que... bon... je coupe."

# Traduction IA – à relire
#: arma_alarm/Arma_Failure/0/11 arma_alarm/Arma_Hero/0/17
msgctxt "Narrator"
msgid "Dorian bursts into the room, all urgency."
msgstr "Dorian déboule dans la pièce, tout en urgence."

# Traduction IA – à relire
#: arma_alarm/Arma_Failure/0/19
msgctxt "Dorian"
msgid "There's a fire in the bathroom! Quick! We need help!"
msgstr "Il y a un feu dans la salle de bains ! Vite ! On a besoin d'aide !"

# Traduction IA – à relire
#: arma_alarm/Arma_Failure/0/27
msgctxt "Arma"
msgid "What?! But... But I..."
msgstr "Quoi ?! Mais... Mais je..."

# Traduction IA – à relire
#: arma_alarm/Arma_Failure/0/38
msgctxt "Tyrell"
msgid "Fire! Fire! It's the outlet next to Sinclaire!"
msgstr "Au feu ! Au feu ! C'est la prise à côté de Sinclaire !"

# Traduction IA – à relire
#: arma_alarm/Arma_Failure/0/55 arma_alarm/Arma_Hero/0/64
msgctxt "Barry"
msgid "Sinclaire spilled water on it! And now the wall is on fire!"
msgstr "Sinclaire a renversé de l'eau dessus ! Et maintenant le mur est en feu !"

# Traduction IA – à relire
#: arma_alarm/Arma_Failure/0/76 arma_alarm/Arma_Hero/0/82
msgctxt "Wallace"
msgid "AHHHHHHH!!!!!"
msgstr "AHHHHHHH !!!!!"

# Traduction IA – à relire
#: arma_alarm/Arma_Failure/0/87
msgctxt "Arma"
msgid "I don't know what to do!"
msgstr "Je ne sais pas quoi faire !"

# Traduction IA – à relire
#: arma_alarm/Arma_Failure/0/95
msgctxt "Dorian"
msgid "Tyrell, follow me! We can take care of this!"
msgstr "Tyrell, suis-moi ! On peut régler ça !"

# Traduction IA – à relire
#: arma_alarm/Arma_Failure/0/103
msgctxt "Tyrell"
msgid "Let's go!"
msgstr "Allons-y !"

# Traduction IA – à relire
#: arma_alarm/Arma_Failure/0/117
msgctxt "Narrator"
msgid "Everyone exits at once, leaving you and Arma alone. Arma looks absolutely distraught."
msgstr "Tout le monde sort en même temps, vous laissant seuls, Arma et vous. Arma semble absolument anéantie."

# Traduction IA – à relire
#: arma_alarm/Arma_Failure/0/125
msgctxt "Arma"
msgid "What have I done... I should have trusted myself."
msgstr "Qu'est-ce que j'ai fait... J'aurais dû me faire confiance."

# Traduction IA – à relire
#: arma_alarm/Arma_Failure/0/133/s/0
msgctxt "Choix"
msgid "Oops..."
msgstr "Oups..."

# Traduction IA – à relire
#: arma_alarm/Arma_Failure/0/134/s/0
msgctxt "Choix"
msgid "Yikes. Don't love where this is going."
msgstr "Aïe. Je n'aime pas trop où ça mène."

# Traduction IA – à relire
#: arma_alarm/Arma_Failure/0/g-0/6
msgctxt "Narrator"
msgid "Dorian and Tyrell return, far calmer than when they left."
msgstr "Dorian et Tyrell reviennent, bien plus calmes qu'à leur départ."

# Traduction IA – à relire
#: arma_alarm/Arma_Failure/0/g-0/17/b/1
msgctxt "Dorian"
msgid "Well, Shelley stepped in and handled it."
msgstr "Eh bien, Shelley est intervenue et s'en est occupée."

# Traduction IA – à relire
#: arma_alarm/Arma_Failure/0/g-0/17/b/9
msgctxt "Tyrell"
msgid "Shelley got Sinclaire to give us some water, and I sopped it up and... well..."
msgstr "Shelley a convaincu Sinclaire de nous donner de l'eau, et moi j'ai tout épongé et... bon..."

# Traduction IA – à relire
#: arma_alarm/Arma_Failure/0/g-0/18/b/1
msgctxt "Tyrell"
msgid "It's over."
msgstr "C'est fini."

# Traduction IA – à relire
#: arma_alarm/Arma_Failure/0/g-0/21/s/0
msgctxt "Choix"
msgid "What did you guys do?"
msgstr "Qu'est-ce que vous avez fait, les gars ?"

# Traduction IA – à relire
#: arma_alarm/Arma_Failure/0/g-0/22/s/0
msgctxt "Choix"
msgid "You put it out?"
msgstr "Vous l'avez éteint ?"

# Traduction IA – à relire
#: arma_alarm/Arma_Failure/0/g-1/0
msgctxt "Dorian"
msgid "He jumped right on the fire!"
msgstr "Il a sauté directement sur le feu !"

# Traduction IA – à relire
#: arma_alarm/Arma_Failure/0/g-1/8/s/0
msgctxt "Choix"
msgid "Nice work."
msgstr "Beau travail."

# Traduction IA – à relire
#: arma_alarm/Arma_Failure/0/g-1/9/s/0
msgctxt "Choix"
msgid "Tyrell! Way to go!"
msgstr "Tyrell ! Bravo !"

# Traduction IA – à relire
#: arma_alarm/Arma_Failure/0/g-1/c-4/7
msgctxt "Dorian"
msgid "Anytime."
msgstr "Quand tu veux."

# Traduction IA – à relire
#: arma_alarm/Arma_Failure/0/g-1/c-4/15 arma_alarm/Arma_Failure/0/g-1/c-5/7
msgctxt "Tyrell"
msgid "I mean..."
msgstr "Enfin..."

# Traduction IA – à relire
#: arma_alarm/Arma_Failure/0/g-2/0
msgctxt "Tyrell"
msgid "Can't just let the place burn down!"
msgstr "On ne peut pas laisser la maison brûler !"

# Traduction IA – à relire
#: arma_alarm/Arma_Failure/0/g-2/8
msgctxt "Tyrell"
msgid "We'll be on our way... see ya, Arma."
msgstr "On va y aller... à plus, Arma."

# Traduction IA – à relire
#: arma_alarm/Arma_Failure/0/g-2/22
msgctxt "Narrator"
msgid "Alone once more, the silence between you and Arma is now almost unbearable. Neither of you speaks for a long time."
msgstr "De nouveau seuls, le silence entre vous et Arma devient presque insupportable. Ni l'un ni l'autre ne parle pendant un long moment."

# Traduction IA – à relire
#: arma_alarm/Arma_Failure/0/g-2/30
msgctxt "Arma"
msgid "I can't believe it. I failed the whole house..."
msgstr "Je n'arrive pas à y croire. J'ai fait défaut à toute la maison..."

# Traduction IA – à relire
#: arma_alarm/Arma_Failure/0/g-2/38
msgctxt "Arma"
msgid "I'll never trust myself again. Or you."
msgstr "Je ne me ferai plus jamais confiance. Ni à toi."

# Traduction IA – à relire
#: arma_alarm/Arma_Failure/0/g-2/46/s/0
msgctxt "Choix"
msgid "You can trust yourself! I was the one who was wrong!"
msgstr "Tu peux te faire confiance ! C'est moi qui avais tort !"

# Traduction IA – à relire
#: arma_alarm/Arma_Failure/0/g-2/47/s/0
msgctxt "Choix"
msgid "Arma, please! I just thought you were overreacting!"
msgstr "Arma, s'il te plaît ! Je pensais juste que tu t'emballais !"

# Traduction IA – à relire
#: arma_alarm/Arma_Failure/0/g-3/4
msgctxt "Arma"
msgid "No. Please just go."
msgstr "Non. Va-t'en, s'il te plaît."

# Traduction IA – à relire
#: arma_alarm/Arma_Hero/0/3
msgctxt "Arma"
msgid "It's in the bathroom! <w>BLEEP</w> ALERT THE HOUSE! <w>BLEEP</w>"
msgstr "C'est dans la salle de bains ! <w>BIIIP</w> PRÉVENEZ LA MAISON ! <w>BIIIP</w>"

# Traduction IA – à relire
#: arma_alarm/Arma_Hero/0/25
msgctxt "Dorian"
msgid "You were right, Arma!"
msgstr "Tu avais raison, Arma !"

# Traduction IA – à relire
#: arma_alarm/Arma_Hero/0/36
msgctxt "Tyrell"
msgid "It's the outlet next to Sinclaire!"
msgstr "C'est la prise à côté de Sinclaire !"

# Traduction IA – à relire
#: arma_alarm/Arma_Hero/0/50
msgctxt "Arma"
msgid "Hang on. We need more info before we act!"
msgstr "Une seconde. Il nous faut plus d'informations avant d'agir !"

# Traduction IA – à relire
#: arma_alarm/Arma_Hero/0/93/b/1
msgctxt "Wallace"
msgid "MY BUTT! WHAT DO WE DO!?"
msgstr "MES FESSES ! QU'EST-CE QU'ON FAIT !?"

# Traduction IA – à relire
#: arma_alarm/Arma_Hero/0/99
msgctxt "Arma"
msgid "I know exactly what to do! Dorian!"
msgstr "Je sais exactement quoi faire ! Dorian !"

# Traduction IA – à relire
#: arma_alarm/Arma_Hero/0/110
msgctxt "Dorian"
msgid "Yes?"
msgstr "Oui ?"

# Traduction IA – à relire
#: arma_alarm/Arma_Hero/0/118
msgctxt "Arma"
msgid "Go tell Eddie to flip his breaker so we can be sure there's no danger from electricity."
msgstr "Va dire à Eddie de couper son disjoncteur pour qu'on soit sûrs qu'il n'y a aucun risque d'électrocution."

# Traduction IA – à relire
#: arma_alarm/Arma_Hero/0/132
msgctxt "Arma"
msgid "Tyrell, I want you to soak it up and... if you feel up to it, jump on the fire!"
msgstr "Tyrell, je veux que tu épongres tout ça et... si tu t'en sens capable, que tu sautes sur le feu !"

# Traduction IA – à relire
#: arma_alarm/Arma_Hero/0/143
msgctxt "Tyrell"
msgid "Anything for the house, Arma!"
msgstr "Tout pour la maison, Arma !"

# Traduction IA – à relire
#: arma_alarm/Arma_Hero/0/157
msgctxt "Dorian"
msgid "Let's go!"
msgstr "Allons-y !"

# Traduction IA – à relire
#: arma_alarm/Arma_Hero/0/168
msgctxt "Arma"
msgid "Barry, you just... keep doing what you're doing."
msgstr "Barry, toi, tu continues... à faire ce que tu fais."

# Traduction IA – à relire
#: arma_alarm/Arma_Hero/0/176
msgctxt "Barry"
msgid "I'll do some research on East Asian zithers!"
msgstr "Je vais faire des recherches sur les cithares d'Asie de l'Est !"

# Traduction IA – à relire
#: arma_alarm/Arma_Hero/0/187
msgctxt "Arma"
msgid "Let's hope this works..."
msgstr "Espérons que ça marche..."

# Traduction IA – à relire
#: arma_alarm/Arma_Hero/0/201
msgctxt "Narrator"
msgid "Amidst the chaos of the fire, Arma stands firm, shouting out orders and ensuring everyone in the area is safe. It all happens so quickly, but when the smoke clears, your home and objects are all relatively unharmed."
msgstr "Au milieu du chaos de l'incendie, Arma tient bon, hurle des ordres et veille à la sécurité de tous ceux qui sont dans les parages. Tout se passe très vite, mais quand la fumée se dissipe, votre maison et vos objets sont à peu près indemnes."

# Traduction IA – à relire
#: arma_alarm/Arma_Hero/0/209
msgctxt "Arma"
msgid "Woohoo!!!"
msgstr "Youhouuu !!!"

# Traduction IA – à relire
#: arma_alarm/Arma_Hero/0/220/s/0
msgctxt "Choix"
msgid "We did it! The fire is out!"
msgstr "On a réussi ! Le feu est éteint !"

# Traduction IA – à relire
#: arma_alarm/Arma_Hero/0/221/s/0
msgctxt "Choix"
msgid "WE ARE PROFESSIONAL FIREFIGHTERS NOW!"
msgstr "ON EST DES POMPIERS PROFESSIONNELS, MAINTENANT !"

# Traduction IA – à relire
#: arma_alarm/Arma_Hero/0/c-0/7
msgctxt "Arma"
msgid "Yeah!"
msgstr "Ouais !"

# Traduction IA – à relire
#: arma_alarm/Arma_Hero/0/c-1/7
msgctxt "Arma"
msgid "SURE! WHY NOT!"
msgstr "BIEN SÛR ! POURQUOI PAS !"

# Traduction IA – à relire
#: arma_alarm/Arma_Hero/0/g-0/6
msgctxt "Dorian"
msgid "Way to go Tyrell! You were awesome!"
msgstr "Bravo Tyrell ! Tu as été génial !"

# Traduction IA – à relire
#: arma_alarm/Arma_Hero/0/g-0/14
msgctxt "Tyrell"
msgid "So were you, Dorian."
msgstr "Toi aussi, Dorian."

# Traduction IA – à relire
#: arma_alarm/Arma_Hero/0/g-0/22/b/4
msgctxt "Wallace"
msgid "You saved my butt! Ok bye!"
msgstr "Vous m'avez sauvé les fesses ! Bon, salut !"

# Traduction IA – à relire
#: arma_alarm/Arma_Hero/0/g-0/25
msgctxt "Tyrell"
msgid "Well, I'm gonna go dry off Wallace."
msgstr "Bon, je vais aller sécher Wallace."

# Traduction IA – à relire
#: arma_alarm/Arma_Hero/0/g-0/33
msgctxt "Dorian"
msgid "Crisis averted. I'll flip the breaker back on, and have Tony take a look at that socket. Wonder what got into Sinclaire..."
msgstr "Crise évitée. Je vais remettre le disjoncteur, et demander à Tony de jeter un oeil à cette prise. Je me demande ce qui a pris à Sinclaire..."

# Traduction IA – à relire
#: arma_alarm/Arma_Hero/0/g-0/47/s/0
msgctxt "Choix"
msgid "Arma! You're an absolute hero! That was amazing!"
msgstr "Arma ! Tu es une véritable héroïne ! C'était incroyable !"

# Traduction IA – à relire
#: arma_alarm/Arma_Hero/0/g-0/48/s/0
msgctxt "Choix"
msgid "We kicked that fire's BUTT!"
msgstr "On a botté les fesses de cet incendie !"

# Traduction IA – à relire
#: arma_alarm/Arma_Hero/0/g-0/c-3/7
msgctxt "Arma"
msgid "YEAH we did!"
msgstr "OUAIS, on l'a fait !"

# Traduction IA – à relire
#: arma_alarm/Arma_Hero/0/g-1/4
msgctxt "Arma"
msgid "You know what? I owe it all to you."
msgstr "Tu sais quoi ? Je te dois tout."

# Traduction IA – à relire
#: arma_alarm/Arma_Hero/0/g-1/12
msgctxt "Arma"
msgid "I don't even want to imagine how that would've gone if I'd still been low on charge..."
msgstr "Je préfère ne pas imaginer comment ça se serait passé si ma batterie avait encore été faible..."

# Traduction IA – à relire
#: arma_alarm/ArmaEndings1/0/0/s/0
msgctxt "Choix"
msgid "Now that we've successfully averted disaster, how about hanging out? As a friend?"
msgstr "Maintenant qu'on a évité la catastrophe, et si on passait un moment ensemble ? En toute amitié ?"

# Traduction IA – à relire
#: arma_alarm/ArmaEndings1/0/1/s/0
msgctxt "Choix"
msgid "So, now that I'm a deputy firefighter... Any interest in giving me a CPR lesson?"
msgstr "Alors, maintenant que je suis {{pompier adjoint|pompière adjointe|pompier·e adjoint·e}}... Ça te dirait de me donner un cours de réanimation ?"

# Traduction IA – à relire
#: arma_alarm/ArmaEndings1/0/c-0/7
msgctxt "Arma"
msgid "I'd love that! I feel like I barely got to know you. I'd like to change that."
msgstr "Avec plaisir ! J'ai l'impression d'avoir à peine eu le temps de te connaître. J'aimerais changer ça."

# Traduction IA – à relire
#: arma_alarm/ArmaEndings1/0/c-0/15
msgctxt "Arma"
msgid "You know what would be fun?"
msgstr "Tu sais ce qui serait amusant ?"

# Traduction IA – à relire
#: arma_alarm/ArmaEndings1/0/c-0/23
msgctxt "Arma"
msgid "We could practice blasting fires out with the extinguisher!"
msgstr "On pourrait s'entraîner à éteindre des feux avec l'extincteur !"

# Traduction IA – à relire
#: arma_alarm/ArmaEndings1/0/c-0/31
msgctxt "Arma"
msgid "Or we could make some disaster kits so we're safe when something serious comes along!"
msgstr "Ou on pourrait préparer des kits de survie pour être en sécurité quand quelque chose de sérieux arrivera !"

# Traduction IA – à relire
#: arma_alarm/ArmaEndings1/0/c-0/43/0/s/0
msgctxt "Choix"
msgid "Let's blast fires!"
msgstr "Éteignons des feux !"

# Traduction IA – à relire
#: arma_alarm/ArmaEndings1/0/c-0/43/1/s/0
msgctxt "Choix"
msgid "Let's make a kit!"
msgstr "Faisons un kit !"

# Traduction IA – à relire
#: arma_alarm/ArmaEndings1/0/c-0/43/c-0/7
msgctxt "Narrator"
msgid "Together you set up a controlled environment and practice safely putting out fires by blasting them with your extinguisher."
msgstr "Ensemble, vous mettez en place un environnement contrôlé et vous vous entraînez à éteindre des feux en toute sécurité à coups d'extincteur."

# Traduction IA – à relire
#: arma_alarm/ArmaEndings1/0/c-0/43/c-0/15
msgctxt "Narrator"
msgid "It's surprisingly fun, and you spend a lot of time laughing. Feeling the pressure from the hose in your hands is exhilarating, and by the end of your time together you feel empowered knowing you're prepared for an emergency."
msgstr "C'est étonnamment amusant, et vous passez beaucoup de temps à rire. Sentir la pression du tuyau entre vos mains est grisant, et à la fin de votre moment ensemble, vous vous sentez plus {{fort|forte|fort·e}} en sachant que vous êtes {{prêt|prête|prêt·e}} à affronter une urgence."

# Traduction IA – à relire
#: arma_alarm/ArmaEndings1/0/c-0/43/c-1/7
msgctxt "Narrator"
msgid "Together you pack up items to use in case of an emergency. It's surprisingly fun, and you spend a lot of time laughing."
msgstr "Ensemble, vous rassemblez de quoi vous préparer en cas d'urgence. C'est étonnamment amusant, et vous passez beaucoup de temps à rire."

# Traduction IA – à relire
#: arma_alarm/ArmaEndings1/0/c-0/43/c-1/15
msgctxt "Narrator"
msgid "Instead of feeling vaguely anxious about the next disaster, you begin actually planning what to do. By the end of your time together, you feel empowered knowing you're prepared for any emergency."
msgstr "Au lieu de ressentir une vague angoisse face à la prochaine catastrophe, vous vous mettez à planifier concrètement ce qu'il faudra faire. À la fin de votre moment ensemble, vous vous sentez plus {{fort|forte|fort·e}} en sachant que vous êtes {{prêt|prête|prêt·e}} à affronter n'importe quelle urgence."

# Traduction IA – à relire
#: arma_alarm/ArmaEndings1/0/c-1/11
msgctxt "Arma"
msgid "Seems to me like all you need is a little mouth-to-mouth..."
msgstr "Il me semble que tout ce qu'il te faut, c'est un petit bouche-à-bouche..."

# Traduction IA – à relire
#: arma_alarm/ArmaEndings1/0/c-1/19
msgctxt "Arma"
msgid "Usually when we train this, one of us plays the patient in distress, and one plays the paramedic."
msgstr "D'habitude, quand on s'entraîne à ça, l'un de nous joue le patient en détresse, et l'autre le secouriste."

# Traduction IA – à relire
#: arma_alarm/ArmaEndings1/0/c-1/27
msgctxt "Arma"
msgid "Which would you like to be?"
msgstr "Lequel veux-tu être ?"

# Traduction IA – à relire
#: arma_alarm/ArmaEndings1/0/c-1/35/0/s/0
msgctxt "Choix"
msgid "I'll be the submissive patient."
msgstr "Je serai {{le patient soumis|la patiente soumise|le·la patient·e soumis·e}}."

# Traduction IA – à relire
#: arma_alarm/ArmaEndings1/0/c-1/35/1/s/0
msgctxt "Choix"
msgid "I'll be the assertive medic."
msgstr "Je serai {{le secouriste autoritaire|la secouriste autoritaire|le·la secouriste autoritaire}}."

# Traduction IA – à relire
#: arma_alarm/ArmaEndings1/0/c-1/35/c-0/7
msgctxt "Arma"
msgid "Then let me take over..."
msgstr "Alors laisse-moi prendre le relais..."

# Traduction IA – à relire
#: arma_alarm/ArmaEndings1/0/c-1/35/c-0/15
msgctxt "Narrator"
msgid "You do your best to play the part of the patient in distress, but once Arma's lips find yours all pretense of training fades away. There's only you, her, and the budding connection growing between the two of you."
msgstr "Vous faites de votre mieux pour jouer le rôle du patient en détresse, mais dès que les lèvres d'Arma rencontrent les vôtres, toute prétention d'entraînement s'évanouit. Il n'y a plus que vous, elle, et le lien naissant qui grandit entre vous."

# Traduction IA – à relire
#: arma_alarm/ArmaEndings1/0/c-1/35/c-1/7
msgctxt "Arma"
msgid "Sounds like I need helping!"
msgstr "On dirait que j'ai besoin d'aide !"

# Traduction IA – à relire
#: arma_alarm/ArmaEndings1/0/c-1/35/c-1/15
msgctxt "Narrator"
msgid "Arma plays a disturbingly convincing patient in distress, but once your lips find hers all pretense of training fades away. There's only you, her, and the budding connection growing between the two of you."
msgstr "Arma joue un patient en détresse avec un naturel troublant, mais dès que vos lèvres rencontrent les siennes, toute prétention d'entraînement s'évanouit. Il n'y a plus que vous, elle, et le lien naissant qui grandit entre vous."

# Traduction IA – à relire
#. Morceau de phrase coupé par une variable (nom du joueur, nombre...).
#: arma_alarm/ArmaEndings1/0/g-0/0
msgctxt "Arma"
msgid "Oh,"
msgstr "Oh,"

# Traduction IA – à relire
#. Morceau de phrase coupé par une variable (nom du joueur, nombre...).
#: arma_alarm/ArmaEndings1/0/g-0/5
msgctxt "Narration / joueur"
msgid ", I can't tell you how badly I've wanted that."
msgstr ", je ne peux pas te dire à quel point j'en avais envie."

# Traduction IA – à relire
#: arma_alarm/ArmaEndings1/0/g-0/13
msgctxt "Arma"
msgid "But I never knew how much I <i>needed</i> it until you helped me find my balance."
msgstr "Mais je ne savais pas à quel point j'en avais <i>besoin</i> avant que tu m'aides à trouver mon équilibre."

# Traduction IA – à relire
#: arma_alarm/ArmaEndings1/0/g-0/21
msgctxt "Arma"
msgid "Now I need a bit of a break..."
msgstr "Maintenant, j'ai besoin d'un peu de répit..."

# Traduction IA – à relire
#: arma_alarm/ArmaEndings1/0/g-0/29/s/0
msgctxt "Choix"
msgid "From me?"
msgstr "De moi ?"

# Traduction IA – à relire
#: arma_alarm/ArmaEndings1/0/g-0/30/s/0
msgctxt "Choix"
msgid "From... What?"
msgstr "De... quoi ?"

# Traduction IA – à relire
#: arma_alarm/ArmaEndings1/0/g-0/c-2/7
msgctxt "Arma"
msgid "Not from you! But just from all this... action."
msgstr "Pas de toi ! Juste de toute cette... action."

# Traduction IA – à relire
#: arma_alarm/ArmaEndings1/0/g-0/c-3/7
msgctxt "Arma"
msgid "Just a break from all the action."
msgstr "Juste une pause dans toute cette action."

# Traduction IA – à relire
#: arma_alarm/ArmaEndings1/0/g-1/0
msgctxt "Arma"
msgid "I think it's time for me to just chill out for a while."
msgstr "Je crois qu'il est temps pour moi de me détendre un moment."

# Traduction IA – à relire
#: arma_alarm/ArmaEndings1/0/g-1/8
msgctxt "Arma"
msgid "Come see me again soon, ok?"
msgstr "Reviens me voir bientôt, d'accord ?"

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/0
msgctxt "Arma"
msgid "Hey there! How's it going?"
msgstr "Salut ! Comment ça va ?"

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/8
msgctxt "Arma"
msgid "Haven't seen you in a while."
msgstr "Ça fait un moment que je ne t'ai pas {{vu|vue|vu·e}}."

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/16/s/0
msgctxt "Choix"
msgid "Hey Arma! Going great."
msgstr "Hé Arma ! Ça va très bien."

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/17/s/0
msgctxt "Choix"
msgid "Things are good. How about you?"
msgstr "Tout va bien. Et toi ?"

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/c-0/7
msgctxt "Arma"
msgid "Love to hear it."
msgstr "Ça fait plaisir à entendre."

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/c-1/7
msgctxt "Arma"
msgid "Me? Oh..."
msgstr "Moi ? Oh..."

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/g-0/0
msgctxt "Arma"
msgid "I've just been chilling here... relaxing."
msgstr "Je suis juste là, à me détendre... à me reposer."

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/g-0/8
msgctxt "Arma"
msgid "Doin a whole lotta nothin'."
msgstr "À ne rien faire du tout."

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/g-0/16
msgctxt "Arma"
msgid "Been nice to back off from working and stressing so much!"
msgstr "Ça fait du bien de lever le pied sur le boulot et le stress !"

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/g-0/24/s/0
msgctxt "Choix"
msgid "That's great Arma. I'm glad you're taking a break."
msgstr "C'est super, Arma. Je suis {{content|contente|content·e}} que tu fasses une pause."

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/g-0/25/s/0
msgctxt "Choix"
msgid "Relaxing sounds nice!"
msgstr "Se reposer, ça a l'air agréable !"

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/g-0/c-2/7
msgctxt "Arma"
msgid "Me too!"
msgstr "Moi aussi !"

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/g-0/c-3/7
msgctxt "Arma"
msgid "Sure does! And sure is!"
msgstr "Ça l'est, et comment ! Et je le suis !"

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/g-1/0
msgctxt "Arma"
msgid "Wanna help me finish this tub of ice cream?"
msgstr "Tu m'aides à finir ce pot de glace ?"

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/g-1/8/s/0
msgctxt "Choix"
msgid "Tub of ice cream?"
msgstr "Un pot de glace ?"

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/g-1/9/s/0
msgctxt "Choix"
msgid "How long have you been here, 'just chilling?'"
msgstr "Ça fait combien de temps que tu es là, à « te détendre » ?"

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/g-1/c-4/7
msgctxt "Arma"
msgid "Yeah. Well, 'tubs' actually. I've been through about three today."
msgstr "Ouais. Enfin, des « pots », en fait. J'en suis à environ trois aujourd'hui."

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/g-1/c-4/15
msgctxt "Arma"
msgid "It's either that or..."
msgstr "C'est ça ou alors..."

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/g-1/c-4/23/0/s/0
msgctxt "Choix"
msgid "Or?"
msgstr "Ou alors ?"

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/g-1/c-4/23/1/s/0
msgctxt "Choix"
msgid "Eating healthy?"
msgstr "Manger sainement ?"

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/g-1/c-4/23/c-0/7
msgctxt "Arma"
msgid "Oh, nothin."
msgstr "Oh, rien."

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/g-1/c-4/23/c-1/7
msgctxt "Arma"
msgid "...yeah. That."
msgstr "...ouais. Ça."

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/g-1/c-5/7
msgctxt "Arma"
msgid "Um... a while?"
msgstr "Euh... un moment ?"

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/g-1/c-5/15
msgctxt "Arma"
msgid "I've kinda lost track of time."
msgstr "J'ai un peu perdu la notion du temps."

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/g-2/0
msgctxt "Arma"
msgid "Anyway, I've been great!"
msgstr "Bref, je suis au top !"

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/g-2/8
msgctxt "Arma"
msgid "I've realized that I don't need ANY stress in my life!"
msgstr "J'ai compris que je n'ai besoin d'AUCUN stress dans ma vie !"

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/g-2/16
msgctxt "Arma"
msgid "And to avoid it, I've committed myself to a new pastime."
msgstr "Et pour l'éviter, je me suis lancée dans une nouvelle activité."

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/g-2/24
msgctxt "Arma"
msgid "Hardcore lounging."
msgstr "Le farniente intensif."

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/g-2/35
msgctxt "Arma"
msgid "<i>Koa put me on to it.</i>"
msgstr "<i>C'est Koa qui m'y a initiée.</i>"

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/g-2/46/s/0
msgctxt "Choix"
msgid "Go for it, Arma! Chill away!"
msgstr "Vas-y, Arma ! Détends-toi à fond !"

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/g-2/47/s/0
msgctxt "Choix"
msgid "There's such a thing as balance, Arma..."
msgstr "Il existe quelque chose qui s'appelle l'équilibre, Arma..."

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/g-2/c-6/7
msgctxt "Arma"
msgid "Will do!"
msgstr "Compte sur moi !"

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/g-2/c-6/15
msgctxt "Arma"
msgid "And now back to the most important question of the day..."
msgstr "Et maintenant, retour à la question la plus importante du jour..."

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/g-2/c-6/23
msgctxt "Arma"
msgid "Vanilla or chocolate?"
msgstr "Vanille ou chocolat ?"

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/g-2/c-7/7
msgctxt "Arma"
msgid "Huh? You mean I need to get back to work?"
msgstr "Hein ? Tu veux dire que je dois retourner travailler ?"

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/g-2/c-7/15
msgctxt "Arma"
msgid "I guess you're right..."
msgstr "Tu as sans doute raison..."

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/g-2/c-7/23
msgctxt "Arma"
msgid "I mean, someone is probably counting on me somewhere."
msgstr "Je veux dire, quelqu'un compte probablement sur moi quelque part."

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter1/0/g-2/c-7/31
msgctxt "Arma"
msgid "I'll get to business in a bit. Just gonna hang here a few moments longer."
msgstr "Je m'y mets dans un moment. Je reste juste encore quelques instants ici."

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter2/0/0
msgctxt "Arma"
msgid "Oh! Hey you!"
msgstr "Oh ! Salut, toi !"

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter2/0/8
msgctxt "Arma"
msgid "You'll be pleased to know, I'm not on the ice cream train anymore!"
msgstr "Tu seras {{content|contente|content·e}} d'apprendre que je ne suis plus dans le train de la glace !"

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter2/0/16
msgctxt "Arma"
msgid "Not sure what I was thinking, overindulging like that."
msgstr "Je ne sais pas ce qui m'a pris de me gaver comme ça."

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter2/0/27
msgctxt "Arma"
msgid "But thanks to your influence (mostly), I've put the tubs away."
msgstr "Mais grâce à ton influence (surtout), j'ai rangé les pots."

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter2/0/35/s/0
msgctxt "Choix"
msgid "Dude! Nice!"
msgstr "Super ! Bravo !"

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter2/0/36/s/0
msgctxt "Choix"
msgid "Way to go, Arma!"
msgstr "Bien joué, Arma !"

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter2/0/37/s/0
msgctxt "Choix"
msgid "Yeah, balance was needed. I could tell."
msgstr "Oui, il fallait de l'équilibre. Ça se voyait."

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter2/0/38/s/0
msgctxt "Choix"
msgid "What do you mean \"mostly\"?"
msgstr "Comment ça, « surtout » ?"

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter2/0/c-0/7
msgctxt "Arma"
msgid "Thanks!!"
msgstr "Merci !!"

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter2/0/c-1/7
msgctxt "Arma"
msgid "I know! Let's go Arma!"
msgstr "Je sais ! Allez Arma !"

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter2/0/c-2/7
msgctxt "Arma"
msgid "You got that right!"
msgstr "Tu l'as dit !"

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter2/0/c-3/7
msgctxt "Arma"
msgid "Hmm? Did I say that? Probably just a slip of the tongue."
msgstr "Hmm ? J'ai dit ça ? Probablement un lapsus."

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter2/0/g-0/0
msgctxt "Narrator"
msgid "Arma gestures lazily to a spot not far from her."
msgstr "Arma désigne paresseusement un endroit pas très loin d'elle."

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter2/0/g-0/8
msgctxt "Arma"
msgid "Could you do me a favor and bring me that box over there?"
msgstr "Tu pourrais me rendre un service et m'apporter cette boîte, là-bas ?"

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter2/0/g-0/16/s/0
msgctxt "Choix"
msgid "Here ya go!"
msgstr "Tiens !"

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter2/0/g-0/17/s/0
msgctxt "Choix"
msgid "It's literally three feet from you."
msgstr "Elle est littéralement à un mètre de toi."

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter2/0/g-0/c-4/7 arma_alarm/ArmaPostFireEncounter3/0/g-0/c-3/7
msgctxt "Arma"
msgid "Thanks!"
msgstr "Merci !"

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter2/0/g-0/c-4/15
msgctxt "Arma"
msgid "Mmmmm. Cigarettes. So tasty."
msgstr "Mmmmm. Des cigarettes. Un délice."

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter2/0/g-0/c-5/7
msgctxt "Arma"
msgid "Ugh. Fine. I'll get it myself."
msgstr "Pff. Bon. Je vais la chercher moi-même."

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter2/0/g-0/c-5/15
msgctxt "Arma"
msgid "Mmmm! Time for a smoke break."
msgstr "Mmmm ! L'heure de la pause clope."

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter2/0/g-1/0
msgctxt "Narrator"
msgid "Arma opens the box and pulls out a cigarette, holding it expertly between two fingers. She looks as if she's held a cigarette many, many times before."
msgstr "Arma ouvre la boîte et en sort une cigarette, qu'elle tient avec aisance entre deux doigts. On dirait qu'elle a déjà tenu une cigarette un très grand nombre de fois."

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter2/0/g-1/8/s/0
msgctxt "Choix"
msgid "WTF?! Those are cigarettes?!"
msgstr "C'EST QUOI CE BORDEL ?! Ce sont des cigarettes ?!"

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter2/0/g-1/9/s/0
msgctxt "Choix"
msgid "Are you SMOKING?"
msgstr "Tu FUMES ?"

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter2/0/g-1/10/s/0
msgctxt "Choix"
msgid "Didn't peg you as the type..."
msgstr "Je ne t'aurais pas cru de ce genre..."

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter2/0/g-1/c-6/7
msgctxt "Arma"
msgid "Oh these little guys?"
msgstr "Oh, ces petites choses ?"

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter2/0/g-1/c-6/15 arma_alarm/ArmaPostFireEncounter2/0/g-1/c-7/15
msgctxt "Narrator"
msgid "She gestures carelessly with the cigarette."
msgstr "Elle agite négligemment la cigarette."

# Traduction IA – à relire
#: arma_alarm/ArmaPostFireEncounter2/0/g-1/c-6/23
msgctxt "Arma"
msgid "They're alright. Just friends."
msgstr "Elles sont sympas. Juste des amies."

#: arma_alarm/ArmaPostFireEncounter2/0/g-1/c-6/31 arma_alarm/ArmaPostFireEncounter2/0/g-1/c-7/31
msgctxt "Arma"
msgid "One of the previous owners left them hidden in a little secret spot behind the wall."
msgstr ""

#: arma_alarm/ArmaPostFireEncounter2/0/g-1/c-7/7
msgctxt "Arma"
msgid "What about it? Just a nice way to relieve the tension!"
msgstr ""

#: arma_alarm/ArmaPostFireEncounter2/0/g-1/c-7/23
msgctxt "Arma"
msgid "And the boredom."
msgstr ""

#: arma_alarm/ArmaPostFireEncounter2/0/g-1/c-8/7
msgctxt "Arma"
msgid "Sometimes types will surprise you!"
msgstr ""

#: arma_alarm/ArmaPostFireEncounter2/0/g-1/c-8/15
msgctxt "Arma"
msgid "I didn't think I'd be the type either, but then I met these little fellas!"
msgstr ""

#: arma_alarm/ArmaPostFireEncounter2/0/g-2/6
msgctxt "Arma"
msgid "This is Ciggy, and these are the Smokes."
msgstr ""

#: arma_alarm/ArmaPostFireEncounter2/0/g-2/14
msgctxt "Ciggy"
msgid "Yeah! We're Arma's friiiends."
msgstr ""

#: arma_alarm/ArmaPostFireEncounter2/0/g-2/22
msgctxt "Smokonio"
msgid "And we can be your friends too if you want."
msgstr ""

#: arma_alarm/ArmaPostFireEncounter2/0/g-2/27
msgctxt "Smokalicious"
msgid "We're always here for ya. Always here when you need a bit of stimulation."
msgstr ""

#: arma_alarm/ArmaPostFireEncounter2/0/g-2/32
msgctxt "Narrator"
msgid "The room is filled with the smell of tobacco and cigarette smoke—Arma's friends crowd around you in a scene straight out of the nightmares of your high school counselor."
msgstr ""

#: arma_alarm/ArmaPostFireEncounter2/0/g-2/40/s/0
msgctxt "Choix"
msgid "STAY. AWAY FROM ME."
msgstr ""

#: arma_alarm/ArmaPostFireEncounter2/0/g-2/41/s/0
msgctxt "Choix"
msgid "Awww they're cute!"
msgstr ""

#: arma_alarm/ArmaPostFireEncounter2/0/g-2/42/s/0
msgctxt "Choix"
msgid "Oh nice. I'll have one if you don't mind."
msgstr ""

#: arma_alarm/ArmaPostFireEncounter2/0/g-2/c-9/7
msgctxt "Ciggy"
msgid "Awww don't be like that!"
msgstr ""

#: arma_alarm/ArmaPostFireEncounter2/0/g-2/c-9/18
msgctxt "Arma"
msgid "Oh don't worry, they're harmless!"
msgstr ""

#: arma_alarm/ArmaPostFireEncounter2/0/g-2/c-9/26
msgctxt "Smokonio"
msgid "We just wanna love you."
msgstr ""

#: arma_alarm/ArmaPostFireEncounter2/0/g-2/c-9/31
msgctxt "Smokalicious"
msgid "And treat you right."
msgstr ""

#: arma_alarm/ArmaPostFireEncounter2/0/g-2/c-10/7
msgctxt "Ciggy"
msgid "We really are, aren't we!"
msgstr ""

#: arma_alarm/ArmaPostFireEncounter2/0/g-2/c-11/7
msgctxt "Ciggy"
msgid "YES. Yes, do that."
msgstr ""

#: arma_alarm/ArmaPostFireEncounter2/0/g-2/c-11/18
msgctxt "Smokonio"
msgid "But not just one of us!"
msgstr ""

#: arma_alarm/ArmaPostFireEncounter2/0/g-2/c-11/23
msgctxt "Smokalicious"
msgid "Yeah, why not a few?"
msgstr ""

#: arma_alarm/ArmaPostFireEncounter2/0/g-3/0
msgctxt "Arma"
msgid "Anyway, they were kind enough to give me some good advice."
msgstr ""

#: arma_alarm/ArmaPostFireEncounter2/0/g-3/8
msgctxt "Arma"
