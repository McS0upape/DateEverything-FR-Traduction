#: betty_bed/betty_hateending/0/g-1/c-7/23/c-0/31
msgctxt "Betty"
msgid "I can't even fucking look at you."
msgstr ""

#: betty_bed/betty_hateending/0/g-1/c-7/23/c-0/39/0/s/0
msgctxt "Choix"
msgid "This was a mistake."
