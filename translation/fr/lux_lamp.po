# Traduction IA – à relire
#: lux_lamp/1
msgctxt "Tag Nom d'objet (MAJUSCULES)"
msgid "LIGHT"
msgstr "LUMIÈRE"

# Traduction IA – à relire
#: lux_lamp/lux_actual_cancel/0/4
msgctxt "Lux"
msgid "Um, what the actual eff? I feel like you're staring at me like some creepo weirdo."
msgstr "Euh, c'est quoi ce délire ? On dirait que tu me fixes comme un creepo bizarre."

# Traduction IA – à relire
#: lux_lamp/lux_actual_cancel/0/15
msgctxt "Lux"
msgid "What are you doing?"
msgstr "Tu fais quoi, là ?"

# Traduction IA – à relire
#: lux_lamp/lux_actual_cancel/0/23/s/0
msgctxt "Choix"
msgid "I'm here to cancel my subscription. It's been three years."
msgstr "Je viens résilier mon abonnement. Ça fait trois ans."

# Traduction IA – à relire
#: lux_lamp/lux_actual_cancel/0/24/s/0
msgctxt "Choix"
msgid "Just like staring at ya."
msgstr "Comme te fixer, d'ailleurs."

# Traduction IA – à relire
#: lux_lamp/lux_actual_cancel/0/c-0/7
msgctxt "Lux"
msgid "Wtf."
msgstr "Wtf."

# Traduction IA – à relire
#: lux_lamp/lux_actual_cancel/0/c-0/15
msgctxt "Lux"
msgid "Like I am literally amazed at the follow-through."
msgstr "Genre, ta persévérance me scotche littéralement."

# Traduction IA – à relire
#: lux_lamp/lux_actual_cancel/0/c-0/23
msgctxt "Lux"
msgid "Fine. Your subscription is cancelled."
msgstr "Bon. Ton abonnement est résilié."

# Traduction IA – à relire
#: lux_lamp/lux_actual_cancel/0/c-0/31
msgctxt "Lux"
msgid "But I keep all your moneyyyy."
msgstr "Mais je garde tout ton argenttt."

# Traduction IA – à relire
#: lux_lamp/lux_actual_cancel/0/c-0/39
msgctxt "Lux"
msgid "Sorry if it didn't change your life or whatever."
msgstr "Désolé si ça t'a pas changé la vie ou je sais pas quoi."

# Traduction IA – à relire
#: lux_lamp/lux_actual_cancel/0/c-1/7
msgctxt "Lux"
msgid "Um, I do NOT give that away for free."
msgstr "Euh, ça, je le donne PAS gratuitement."

# Traduction IA – à relire
#: lux_lamp/lux_actual_cancel/0/c-1/15
msgctxt "Lux"
msgid "Desist and cease loser!"
msgstr "Cesse et désiste, loser !"

# Traduction IA – à relire
#: lux_lamp/keyes_lux/0/0
msgctxt "Narrator"
msgid "Lux is primping for some imaginary audience when you find them, striking pose after pose."
msgstr "Lux prend la pose pour un public imaginaire quand vous le trouvez, enchaînant pose sur pose."

# Traduction IA – à relire
#: lux_lamp/keyes_lux/0/8
msgctxt "Narrator"
msgid "When they see you they roll their eyes, pausing to address you."
msgstr "En vous voyant, iel lève les yeux au ciel, puis s'interrompt pour vous adresser la parole."

# Traduction IA – à relire
#: lux_lamp/keyes_lux/0/16
msgctxt "Lux"
msgid "What you're on a quest or some shit?"
msgstr "T'es en quête ou un truc de ce genre, de ouf ?"

# Traduction IA – à relire
#: lux_lamp/keyes_lux/0/24/s/0
msgctxt "Choix"
msgid "Yeah, I guess. Keyes says you've been ignoring her?"
msgstr "Ouais, on dirait. Keyes dit que tu l'ignores ?"

# Traduction IA – à relire
#: lux_lamp/keyes_lux/0/25/s/0
msgctxt "Choix"
msgid "Keyes needs your help. Be nice, Lux."
msgstr "Keyes a besoin de ton aide. Sois sympa, Lux."

# Traduction IA – à relire
#: lux_lamp/keyes_lux/0/g-0/0
msgctxt "Lux"
msgid "Oh, yeah, she wants better lighting?"
msgstr "Ah ouais, elle veut un meilleur éclairage ?"

# Traduction IA – à relire
#: lux_lamp/keyes_lux/0/g-0/8
msgctxt "Lux"
msgid "Need I point out the total disregard for what I might be doing?"
msgstr "Je dois souligner le mépris total pour ce que je pourrais être en train de faire ?"

# Traduction IA – à relire
#: lux_lamp/keyes_lux/0/g-0/16
msgctxt "Lux"
msgid "Uh, the utter self-absorbtion of that request?"
msgstr "Euh, l'égocentrisme absolu de cette demande ?"

# Traduction IA – à relire
#: lux_lamp/keyes_lux/0/g-0/24
msgctxt "Lux"
msgid "I mean if Keyes wasn't such a total diva, she might have checked my latest posts."
msgstr "Genre, si Keyes n'était pas une telle diva, elle aurait peut-être regardé mes derniers posts."

# Traduction IA – à relire
#: lux_lamp/keyes_lux/0/g-0/32
msgctxt "Lux"
msgid "Then she would know that I am super busy with this update on my second snack of the afternoon."
msgstr "Elle saurait que je suis en plein dans la mise à jour de mon deuxième goûter de l'après-midi."

# Traduction IA – à relire
#: lux_lamp/keyes_lux/0/g-0/40
msgctxt "Lux"
msgid "Ugh... But FINE whatever. I guess I'm just that essential."
msgstr "Pfff... Mais BON, ok, whatever. Je suppose que je suis juste indispensable."

# Traduction IA – à relire
#: lux_lamp/keyes_lux/0/g-0/48/s/0
msgctxt "Choix"
msgid "Thanks Lux?"
msgstr "Merci, Lux ?"

# Traduction IA – à relire
#: lux_lamp/keyes_lux/0/g-0/c-2/7
msgctxt "Lux"
msgid "Baiii."
msgstr "Byeee."

# Traduction IA – à relire
#: lux_lamp/LuxQuestion2/0/3 lux_lamp/LuxMember/0/11
msgctxt "Instaglam Moderator"
msgid "This account has been temporarily suspended."
msgstr "Ce compte a été temporairement suspendu."

# Traduction IA – à relire
#: lux_lamp/LuxQuestion2/0/17/s/0
msgctxt "Choix"
msgid "Riiiiight."
msgstr "Ouaaais, c'est ça."

# Traduction IA – à relire
#: lux_lamp/LuxQuestion2/0/18/s/0
msgctxt "Choix"
msgid "Still?!?"
msgstr "Toujours ?!?"

# Traduction IA – à relire
#: lux_lamp/LuxQuestion2/0/19/s/0 lux_lamp/LuxMember/0/25/s/0
msgctxt "Choix"
msgid "Where's Lux!?"
msgstr "Il est où, Lux !?"

# Traduction IA – à relire
#: lux_lamp/LuxQuestion2/0/g-0/0 lux_lamp/LuxMember/0/g-0/0
msgctxt "Instaglam Moderator"
msgid "I'm sorry but we cannot answer that question."
msgstr "Je suis désolé, mais nous ne pouvons pas répondre à cette question."

# Traduction IA – à relire
#: lux_lamp/LuxQuestion2/0/g-0/8 lux_lamp/LuxMember/0/g-0/8
msgctxt "Instaglam Moderator"
msgid "Thank you for using our platform!"
msgstr "Merci d'utiliser notre plateforme !"

# Traduction IA – à relire
#: lux_lamp/LuxQuestion2/0/g-0/19 lux_lamp/LuxMember/0/g-0/19
msgctxt "Instaglam Moderator"
msgid "Please consider buying a premium subscription."
msgstr "Pensez à souscrire un abonnement premium."

# Traduction IA – à relire
#: lux_lamp/LuxQuestion2/0/g-0/27 lux_lamp/LuxMember/0/g-0/27
msgctxt "Instaglam Moderator"
msgid "Goodbye."
msgstr "Au revoir."

# Traduction IA – à relire
#: lux_lamp/LuxQuestion2/0/g-0/38
msgctxt "Maggie"
msgid "What was that about?"
msgstr "C'était quoi, ça ?"

# Traduction IA – à relire
#: lux_lamp/LuxQuestion2/0/g-0/46/s/0
msgctxt "Choix"
msgid "It's a long story."
msgstr "C'est une longue histoire."

# Traduction IA – à relire
#: lux_lamp/LuxQuestion2/0/g-0/47/s/0
msgctxt "Choix"
msgid "Not worth your time."
msgstr "Ça ne vaut pas la peine de perdre ton temps."

# Traduction IA – à relire
#: lux_lamp/LuxQuestion2/0/g-0/48/s/0
msgctxt "Choix"
msgid "Lux owes me money."
msgstr "Lux me doit de l'argent."

# Traduction IA – à relire
#: lux_lamp/LuxQuestion2/0/g-0/c-3/7
msgctxt "Maggie"
msgid "A case for another time, I suppose..."
msgstr "Une affaire pour une autre fois, je suppose..."

# Traduction IA – à relire
#: lux_lamp/LuxQuestion2/0/g-0/c-4/7
msgctxt "Maggie"
msgid "Hmm... I suppose."
msgstr "Hmm... Je suppose."

# Traduction IA – à relire
#: lux_lamp/LuxQuestion2/0/g-0/c-5/7
msgctxt "Maggie"
msgid "Me too."
msgstr "Moi aussi."

# Traduction IA – à relire
#: lux_lamp/LuxQuestion2/0/g-1/0
msgctxt "Narrator"
msgid "Discouraged, you and Maggie will have to continue the case back at her usual meeting place."
msgstr "Découragés, vous et Maggie allez devoir poursuivre l'enquête à son lieu de rendez-vous habituel."

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/9
msgctxt "Narrator"
msgid "You find Lux fiddling with a tripod, but they're quick to straighten up and look entirely unbothered when they see you approaching."
msgstr "Vous trouvez Lux en train de bricoler un trépied, mais iel se redresse vite et prend l'air parfaitement détaché en vous voyant approcher."

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/17
msgctxt "Narrator"
msgid "You can feel them turn 'on', a tangible shift in their energy."
msgstr "Vous sentez Lux s'« allumer », un changement tangible dans son énergie."

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/25
msgctxt "Lux"
msgid "What's up, bitches n' bros?"
msgstr "Quoi de neuf, bitches et bros ?"

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/33/s/0
msgctxt "Choix"
msgid "Ugh. Hi Lux. Heard anything about a counterfeit in the house?"
msgstr "Pff. Salut Lux. T'as entendu parler d'une contrefaçon dans la maison ?"

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/34/s/0
msgctxt "Choix"
msgid "Hey there. Just wondering whether you knew anything about a counterfeit item in the house."
msgstr "Salut. Je me demandais si tu savais quelque chose sur un objet contrefait dans la maison."

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/c-0/7 lux_lamp/maggie_lux_quest/0/c-1/7
msgctxt "Lux"
msgid "Oh my god. Srsly I love that you're even asking me!"
msgstr "Oh mon dieu. Srx, j'adore que tu me demandes ça !"

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/c-0/18
msgctxt "Lux"
msgid "I'm so flattered. Lemme, let, lemme just like hashtag gratitude that right now..."
msgstr "Ça me flatte trop. Laisse, laisse-moi juste, genre, hashtag gratitude ça tout de suite..."

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/c-0/26/0/s/0 lux_lamp/maggie_lux_quest/0/c-1/26/0/s/0
msgctxt "Choix"
msgid "Lux we really need-"
msgstr "Lux, on a vraiment besoin-"

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/c-0/26/c-0/7 lux_lamp/maggie_lux_quest/0/c-1/26/c-0/7
msgctxt "Lux"
msgid "Omg like just give me a second alright."
msgstr "Omg, donne-moi juste une seconde, ok."

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/c-0/26/c-0/15 lux_lamp/maggie_lux_quest/0/c-1/26/c-0/15
msgctxt "Lux"
msgid "I'm just trying to give you a shout out. What's your handle?"
msgstr "J'essaie juste de te faire un shout out. C'est quoi ton pseudo ?"

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/c-0/26/c-0/23/0/s/0 lux_lamp/maggie_lux_quest/0/c-1/26/c-0/23/0/s/0
msgctxt "Choix"
msgid "Lux I've told you my handle about forty-five times now."
msgstr "Lux, je t'ai donné mon pseudo une quarantaine de fois."

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/c-0/26/c-0/23/1/s/0
msgctxt "Choix"
msgid "My handle is"
msgstr "Mon pseudo, c'est"

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/c-0/26/c-0/23/c-0/7 lux_lamp/maggie_lux_quest/0/c-1/26/c-0/23/c-0/7
msgctxt "Lux"
msgid "Ok sue me I forgot it. What do you even want from me?"
msgstr "Ok, attaque-moi en justice, je l'ai oublié. Tu veux quoi de moi, au juste ?"

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/c-0/26/c-0/23/c-0/15/0/s/0 lux_lamp/maggie_lux_quest/0/c-1/26/c-0/23/c-0/15/0/s/0
msgctxt "Choix"
msgid "Can you please, for the love of all that is good and holy..."
msgstr "Peux-tu s'il te plaît, pour l'amour de tout ce qui est bon et saint..."

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/c-0/26/c-0/23/c-0/15/c-0/7 lux_lamp/maggie_lux_quest/0/c-1/26/c-0/23/c-0/15/c-0/7
msgctxt "Lux"
msgid "Uh huh."
msgstr "Mmh mmh."

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/c-0/26/c-0/23/c-0/15/c-0/15/0/s/0 lux_lamp/maggie_lux_quest/0/c-1/26/c-0/23/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "Just tell us what you've heard about a counterfeit item being in the house?"
msgstr "Juste nous dire ce que tu as entendu sur un objet contrefait dans la maison ?"

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/c-0/26/c-0/23/c-0/15/c-0/15/c-0/7 lux_lamp/maggie_lux_quest/0/c-1/26/c-0/23/c-0/15/c-0/15/c-0/7
msgctxt "Lux"
msgid "House? Item? About?"
msgstr "Maison ? Objet ? Entendu ?"

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/c-0/26/c-0/23/c-0/15/c-0/15/c-0/15/0/s/0 lux_lamp/maggie_lux_quest/0/c-1/26/c-0/23/c-0/15/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "Because I'm beginning to think it's you."
msgstr "Parce que je commence à penser que c'est toi."

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/c-0/26/c-0/23/c-1/7
msgctxt "Lux"
msgid "You know what never mind the wifi sucks right now anyway."
msgstr "Tu sais quoi, laisse tomber, le wifi est nul en ce moment de toute façon."

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/c-0/26/c-0/23/c-1/15
msgctxt "Lux"
msgid "You should fix that btw."
msgstr "Tu devrais arranger ça, btw."

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/c-0/26/c-0/23/c-1/23
msgctxt "Lux"
msgid "Anyway what's so important that I had to leave my latest activation?"
msgstr "Bref, c'était quoi de si important pour que je quitte ma dernière activation ?"

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/c-0/26/c-0/23/c-1/31/0/s/0
msgctxt "Choix"
msgid "IS THERE A COUNTERFEIT IN THE HOUSE?"
msgstr "Y A-T-IL UNE CONTREFAÇON DANS LA MAISON ?"

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/c-1/18
msgctxt "Lux"
msgid "I'm so flattered. Lemme, let, lemme just hashtag gratitude that right now..."
msgstr "Ça me flatte trop. Laisse, laisse-moi juste hashtag gratitude ça tout de suite..."

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/g-0/0
msgctxt "Lux"
msgid "I never thought you'd even freaking ask me that."
msgstr "Je pensais même pas que tu me poserais cette question."

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/g-0/11
msgctxt "Lux"
msgid "And I even have an answer, so like, don't we love this for me?"
msgstr "Et j'ai même une réponse, alors, genre, on adore ça pour moi, non ?"

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/g-0/19/s/0
msgctxt "Choix"
msgid "We do love this for you, Lux."
msgstr "On adore ça pour toi, Lux."

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/g-0/20/s/0
msgctxt "Choix"
msgid "We don't love this for you, Lux."
msgstr "On n'adore pas ça pour toi, Lux."

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/g-1/0
msgctxt "Lux"
msgid "Let me just set up my camera so we can film me answering you."
msgstr "Laisse-moi installer ma caméra pour qu'on puisse filmer ma réponse."

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/g-1/8/s/0
msgctxt "Choix"
msgid "I'm leaving now."
msgstr "Je m'en vais."

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/g-1/9/s/0
msgctxt "Choix"
msgid "Fine."
msgstr "Bon."

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/g-1/10/s/0
msgctxt "Choix"
msgid "You've gotta look your best, Lux!"
msgstr "Faut que tu sois au top, Lux !"

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/g-2/0
msgctxt "Lux"
msgid "Ok, so like, I'm ready for my interview."
msgstr "Ok, donc, genre, c'est l'heure de mon interview."

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/g-2/16
msgctxt "Lux"
msgid "Hang on let me just do my hair."
msgstr "Attends, laisse-moi juste faire ma coiffure."

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/g-2/24
msgctxt "Lux"
msgid "It needs to look like I spent $500 on it, but also like I spent $8 and got it done by my sister."
msgstr "Faut que ça ait l'air de m'avoir coûté 500 balles, mais aussi que ça ait l'air de m'en avoir coûté 8 et d'avoir été fait par ma sœur."

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/g-2/32/s/0
msgctxt "Choix"
msgid "It's not a complicated question."
msgstr "C'est pas une question compliquée."

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/g-2/33/s/0
msgctxt "Choix"
msgid "You look so good the way you are, Lux!"
msgstr "Tu es super bien comme ça, Lux !"

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/g-2/c-7/7
msgctxt "Lux"
msgid "WOW. Ok. Seriously, you can't rush this."
msgstr "WOW. Ok. Sérieux, on ne se précipite pas pour ça."

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/g-2/c-7/15
msgctxt "Lux"
msgid "I'm a professional, ok?"
msgstr "C'est mon métier, ok ?"

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/g-2/c-7/23
msgctxt "Lux"
msgid "An ICON."
msgstr "Une ICÔNE."

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/g-2/c-7/31
msgctxt "Lux"
msgid "I can't just show up looking like I spent as little time on my appearance as YOU did."
msgstr "Je peux pas me pointer en ayant passé aussi peu de temps sur mon apparence que TOI."

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/g-3/0
msgctxt "Maggie"
msgid "LUX!"
msgstr "LUX !"

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/g-3/14
msgctxt "Maggie"
msgid "WHAT have you heard about a counterfeit item?"
msgstr "QU'EST-CE que tu as entendu à propos d'un objet contrefait ?"

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/g-3/22
msgctxt "Maggie"
msgid "And WHO have you heard it from?"
msgstr "Et de la part de QUI ?"

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/g-3/30
msgctxt "Maggie"
msgid "ANSWER ME BEFORE I BACK MY LENS OFF, TURN YOUR LIGHT INTO A NARROW BEAM..."
msgstr "RÉPONDS-MOI AVANT QUE JE RECULE MA LENTILLE, RÉGLE TA LUMIÈRE EN FAISCEAU ÉTROIT..."

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/g-3/38
msgctxt "Maggie"
msgid "AND SINGE YOU WITH IT!!!!!"
msgstr "ET TE ROTISSE AVEC !!!!!"

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/g-3/63
msgctxt "Maggie"
msgid "...please. And thank you."
msgstr "...s'il te plaît. Et merci."

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/g-3/71
msgctxt "Lux"
msgid "I heard that one of the dishes was a counterfeit."
msgstr "J'ai entendu qu'une des assiettes était une contrefaçon."

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/g-3/82
msgctxt "Lux"
msgid "I heard it from Stepford."
msgstr "Je l'ai entendu de Stepford."

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/g-3/99/s/0
msgctxt "Choix"
msgid "Maggie, that was the hottest thing I've ever seen."
msgstr "Maggie, c'était la chose la plus classe que j'aie jamais vue."

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/g-3/100/s/0
msgctxt "Choix"
msgid "That will be all. Goodbye."
msgstr "Ce sera tout. Au revoir."

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/g-3/c-9/7
msgctxt "Maggie"
msgid "Thank you."
msgstr "Merci."

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/g-3/c-9/15
msgctxt "Maggie"
msgid "Lux, get out of here."
msgstr "Lux, dégage d'ici."

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/g-3/c-10/10
msgctxt "Maggie"
msgid "And good riddance!"
msgstr "Et bon débarras !"

# Traduction IA – à relire
#: lux_lamp/maggie_lux_quest/0/g-3/c-10/18
msgctxt "Maggie"
msgid "Insufferable twat..."
msgstr "Espèce d'imbécile insupportable..."

# Traduction IA – à relire
