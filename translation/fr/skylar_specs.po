#: skylar_specs/suspension_decide_bad/0/c-0/7
msgctxt "Skylar"
msgid "Too bad you don't."
msgstr ""

#: skylar_specs/suspension_decide_bad/0/c-0/15
msgctxt "Skylar"
msgid "...sorry. That was spiteful."
msgstr ""

#: skylar_specs/suspension_decide_bad/0/c-0/23
msgctxt "Skylar"
msgid "See you around."
msgstr ""

#: skylar_specs/suspension_decide_bad/0/c-1/7
msgctxt "Skylar"
msgid "...what?!"
msgstr ""

#: skylar_specs/suspension_decide_bad/0/c-1/18
msgctxt "Skylar"
msgid "Tell that to me the next time you speak with another dateable object."
msgstr ""

#: skylar_specs/suspension_decide_bad/0/c-1/26
msgctxt "Skylar"
msgid "Loner."
msgstr ""

#: skylar_specs/suspension_decide_bad/0/c-2/7
msgctxt "Skylar"
msgid "It doesn't matter..."
msgstr ""

#: skylar_specs/suspension_decide_bad/0/g-0/3
msgctxt "Narrator"
msgid "You've never felt such distance from Skylar—as you watch her walk away, you can't help but feel... well, a bit of disbelief."
msgstr ""

#: skylar_specs/suspension_decide_bad/0/g-0/39
msgctxt "Narrator"
msgid "Reggie rushes into the room so quickly he nearly falls over. He doubles over for a few moments to catch his breath, reaching out toward Skylar's retreating figure in the distance."
msgstr ""

#: skylar_specs/suspension_decide_bad/0/g-0/50
msgctxt "Reggie"
msgid "Hey don't go, Skylar!"
msgstr ""

#: skylar_specs/suspension_decide_bad/0/g-0/64
msgctxt "Reggie"
msgid "I gotta gloat some!"
msgstr ""

#: skylar_specs/suspension_decide_bad/0/g-0/72
msgctxt "Narrator"
msgid "Skylar doesn't even grant him the respect of a look backwards."
msgstr ""

#: skylar_specs/suspension_decide_bad/0/g-0/83
msgctxt "Skylar"
msgid "Gloat on your own time."
msgstr ""

#: skylar_specs/suspension_decide_bad/0/g-0/91
msgctxt "Reggie"
msgid "I do... but it's still not enough!"
