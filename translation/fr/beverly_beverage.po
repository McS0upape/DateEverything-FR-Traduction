#: beverly_beverage/mocktail_bev_drinks/0/c-0/7
msgctxt "Beverly"
msgid "NO, no I dont wanna stop!"
msgstr "NON, non je veux pas arrêter !"

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/c-0/15
msgctxt "Beverly"
msgid "if I STOP then you LEAV. AND I’LL BE all alone again. <w>FOREVER.</w>"
msgstr "si j'ARRÊTE alors tu PARS. ET JE SERAI toute seule encore. <w>POUR TOUJOURS.</w>"

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/c-0/23/0/s/0
msgctxt "Choix"
msgid "What do you mean?"
msgstr "Qu'est-ce que tu veux dire ?"

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/c-0/23/1/s/0
msgctxt "Choix"
msgid "<i>Let her talk</i>"
msgstr "<i>Laissez-la parler</i>"

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/c-0/23/g-0/0
msgctxt "Beverly"
msgid "Becasue <w>THA \"S we hAT EVERYBODY Does </w>"
msgstr "Parceke <w>C'EST ce kon fai TOUS</w>"

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/c-0/23/g-0/8
msgctxt "Beverly"
msgid "<w>SLIKE I think the PROBEL MIS N\" T eth BAr</w>"
msgstr "<w>EN FAIT jpense kle PROBLÈM C'ÉTAIT l BAr</w>"

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/c-0/23/g-0/16
msgctxt "Beverly"
msgid "...'sme."
msgstr "...c'ê moi."

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/c-0/23/g-0/24/0/s/0
msgctxt "Choix"
msgid "Sme?"
msgstr "C'ê moi ?"

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/c-0/23/g-0/24/1/s/0
msgctxt "Choix"
msgid "What?"
msgstr "Quoi ?"

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/c-0/23/g-0/24/g-0/0
msgctxt "Beverly"
msgid "It's always been me..."
msgstr "C'a toujours été moi..."

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/c-0/23/g-0/24/g-0/8
msgctxt "Beverly"
msgid "We coulad HEVA the be st adevirtISNG EVERY but I'm still the problem."
msgstr "On pourè AVWAR la meilleur pubb DU MONDE mais le problème c'est tjrs moi."

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/c-0/23/g-0/24/g-0/16/0/s/0
msgctxt "Choix"
msgid "You're not a problem..."
msgstr "Tu n'es pas un problème..."

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/c-0/23/g-0/24/g-0/16/1/s/0
msgctxt "Choix"
msgid "Well, you may have a point there."
msgstr "Eh bien, tu n'as peut-être pas tort."

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/c-0/23/g-0/24/g-0/16/c-0/7
msgctxt "Beverly"
msgid "<w>Yes I\" AM! I'm LAud I'm OBNOXIUS...</w>"
msgstr "<w>Si JE LE SUIS ! Je suis FOR je suis INSUPORTABLE...</w>"

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/c-0/23/g-0/24/g-0/16/g-0/0
msgctxt "Beverly"
msgid "Thank you... fer lissening..."
msgstr "Merci... d'avoir écouuté..."

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/c-0/23/g-0/24/g-0/16/g-0/14
msgctxt "Narrator"
msgid "Beverly appears to have fallen asleep. You take your leave, tiptoeing away."
msgstr "Beverly semble s'être endormie. Vous prenez congé et partez sur la pointe des pieds."

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/c-1/7
msgctxt "Beverly"
msgid "I'm sorry. Ahhh I'm horrible."
msgstr "Désolée. Ahhh je suis horrible."

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "I think you need to go lie down. I’ll close the bar for the night. Okay?"
msgstr "Je crois que tu as besoin d'aller t'allonger. Je ferme le bar pour ce soir. D'accord ?"

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/c-1/15/c-0/7
msgctxt "Beverly"
msgid "Okay..."
msgstr "D'accord..."

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/c-1/15/c-0/15
msgctxt "Beverly"
msgid "Will you stay wth me later? Just until I fall asleep?"
msgstr "Tu resteras avec moi plus tard ? Juste jusqu'à ce que je m'endorme ?"

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/c-1/15/c-0/23/0/s/0
msgctxt "Choix"
msgid "Of course."
msgstr "Bien sûr."

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/c-1/15/c-0/23/1/s/0
msgctxt "Choix"
msgid "I don’t think that’s a good idea."
msgstr "Je ne crois pas que ce soit une bonne idée."

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/c-1/15/c-0/23/c-0/7
msgctxt "Beverly"
msgid "Thank you..."
msgstr "Merci..."

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/c-1/15/c-0/23/c-0/21/0/s/0
msgctxt "Choix"
msgid "Okay. Beverly’s asleep. Now’s a good time to leave."
msgstr "Bon. Beverly dort. C'est le bon moment pour partir."

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/c-1/15/c-0/23/c-1/7
msgctxt "Beverly"
msgid "Aw come onnnnn! Pleassssssseeeeeeeeeeeeeee!!"
msgstr "Aw allez quoiiiii ! S'il te plaiiiiiiiiiiiiit !!"

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/g-0/0/s/0
msgctxt "Choix"
msgid "No Bev. You need to get some rest, and I do too."
msgstr "Non Bev. Il faut que tu te reposes, et moi aussi."

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/g-0/c-2/7
msgctxt "Beverly"
msgid "Nooo! But then you’ll leaveee!"
msgstr "Nooon ! Mais après tu vas partiiir !"

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/g-0/c-2/15
msgctxt "Beverly"
msgid "I don’t want you to gooo! I like you!"
msgstr "Je veux pas que tu partes ! Je t'aime bien !"

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/g-0/c-2/23/0/s/0
msgctxt "Choix"
msgid "Oh! Wow. Um. Well I-"
msgstr "Oh ! Wow. Euh. Eh bien je-"

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/g-0/c-2/23/1/s/0
msgctxt "Choix"
msgid "I like you, but I don't like this."
msgstr "Je t'aime bien, mais je n'aime pas ça."

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/g-0/c-2/23/c-0/7
msgctxt "Narrator"
msgid "Beverly knocks out before you can even respond, snoring loudly."
msgstr "Beverly s'écroule avant même que vous ayez pu répondre, et ronfle bruyamment."

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/g-0/c-2/23/c-0/15
msgctxt "Beverly"
msgid "Zzzz...."
msgstr "Zzzz...."

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/g-0/c-2/23/c-0/26
msgctxt "Narrator"
msgid "You do your best to make her comfortable before you leave, tiptoeing away."
msgstr "Vous faites de votre mieux pour la mettre à l'aise avant de partir, sur la pointe des pieds."

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/g-0/c-2/23/c-1/7
msgctxt "Beverly"
msgid "Where are you going?"
msgstr "Où tu vas ?"

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/g-0/c-2/23/c-1/15
msgctxt "Beverly"
msgid "Do you hate me?"
msgstr "Tu me détestes ?"

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/g-0/c-2/23/c-1/23/1/s/0
msgctxt "Choix"
msgid "No, of course not!"
msgstr "Non, bien sûr que non !"

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/g-0/c-2/23/c-1/23/c-1/7
msgctxt "Beverly"
msgid "Thank you... I’m sorry..."
msgstr "Merci... Désolée..."

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/g-0/c-2/23/c-1/23/c-1/15
msgctxt "Beverly"
msgid "I’ll go lie down. Can you close up the bar for me, please?"
msgstr "Je vais aller m'allonger. Tu peux fermer le bar à ma place, s'il te plaît ?"

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/g-0/c-2/23/c-1/23/c-1/23
msgctxt "Beverly"
msgid "And... will you stay with me afterwards?"
msgstr "Et... tu resteras avec moi après ?"

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/g-0/c-2/23/c-1/23/c-1/31/0/s/0
msgctxt "Choix"
msgid "Yes, of course."
msgstr "Oui, bien sûr."

# Traduction IA – à relire
#: beverly_beverage/mocktail_bev_drinks/0/g-0/c-2/23/c-1/23/c-1/31/1/s/0
msgctxt "Choix"
msgid "Sure..."
msgstr "Bien sûr..."

# Traduction IA – à relire
#: beverly_beverage/player_drunk_awaken/0/3
msgctxt "Beverly"
msgid "Hey... you’re alive!"
msgstr "Hé... tu es en vie !"

# Traduction IA – à relire
#: beverly_beverage/player_drunk_awaken/0/11/s/0
msgctxt "Choix"
msgid "Yeah... are you?"
msgstr "Ouais... et toi ?"

# Traduction IA – à relire
#: beverly_beverage/player_drunk_awaken/0/c-0/7
msgctxt "Beverly"
msgid "I think so, well... not alive. I've never been that..."
msgstr "Je crois, enfin... pas en vie. Je ne l'ai jamais été..."

# Traduction IA – à relire
#: beverly_beverage/player_drunk_awaken/0/c-0/15
msgctxt "Beverly"
msgid "But awake..and in one piece... yeah."
msgstr "Mais réveillée... et en un seul morceau... ouais."

# Traduction IA – à relire
#: beverly_beverage/player_drunk_awaken/0/c-0/23
msgctxt "Beverly"
msgid "Everything is agony, but I’m still here I guess."
msgstr "Tout est une agonie, mais je suis toujours là, j'imagine."

# Traduction IA – à relire
#: beverly_beverage/player_drunk_awaken/0/c-0/34
msgctxt "Beverly"
msgid "How are you doing?"
msgstr "Comment tu te sens ?"

# Traduction IA – à relire
#: beverly_beverage/player_drunk_awaken/0/g-0/0/s/0
msgctxt "Choix"
msgid "My head is full of pain and regret."
msgstr "J'ai la tête pleine de douleur et de regrets."

# Traduction IA – à relire
#: beverly_beverage/player_drunk_awaken/0/g-0/1/s/0
msgctxt "Choix"
msgid "<i>Please</i> keep your voice down."
msgstr "Parle <i>moins fort</i>, s'il te plaît."

# Traduction IA – à relire
#: beverly_beverage/player_drunk_awaken/0/g-0/2/s/0
msgctxt "Choix"
msgid "Totally worth it."
msgstr "Ça valait totalement le coup."

# Traduction IA – à relire
#: beverly_beverage/player_drunk_awaken/0/g-0/c-1/7
msgctxt "Beverly"
msgid "Aw... I’m sorry."
msgstr "Aw... Désolée."

# Traduction IA – à relire
#: beverly_beverage/player_drunk_awaken/0/g-0/c-1/18
msgctxt "Beverly"
msgid "Surely it wasn’t all bad though, right?"
msgstr "Tout n'était pas mauvais, quand même, non ?"

# Traduction IA – à relire
#: beverly_beverage/player_drunk_awaken/0/g-0/c-1/26
msgctxt "Beverly"
msgid "At least I hope it wasn’t, I can’t remember."
msgstr "Enfin, j'espère que non, je ne me souviens de rien."

# Traduction IA – à relire
#: beverly_beverage/player_drunk_awaken/0/g-0/c-1/34
msgctxt "Beverly"
msgid "It feels like my brain is trying to claw its way out of my skull."
msgstr "J'ai l'impression que mon cerveau essaie de s'extraire de mon crâne à coups de griffes."

# Traduction IA – à relire
#: beverly_beverage/player_drunk_awaken/0/g-0/c-1/42
msgctxt "Beverly"
msgid "I mean... I had fun!"
msgstr "Enfin... je me suis amusée !"

# Traduction IA – à relire
#: beverly_beverage/player_drunk_awaken/0/g-0/c-1/50
msgctxt "Beverly"
msgid "Next time will be better! I promise!"
msgstr "La prochaine fois sera mieux ! Promis !"

# Traduction IA – à relire
#: beverly_beverage/player_drunk_awaken/0/g-0/c-2/7 beverly_beverage/mocktail_return/0/c-0/18
msgctxt "Beverly"
msgid "Gotcha, sorry..."
msgstr "Compris, désolée..."

# Traduction IA – à relire
#: beverly_beverage/player_drunk_awaken/0/g-0/c-3/7
msgctxt "Beverly"
msgid "Aww! <i>Urp</i> You mean it?"
msgstr "Aww ! <i>Urp</i> Tu le penses vraiment ?"

# Traduction IA – à relire
#: beverly_beverage/player_drunk_awaken/0/g-0/c-3/15
msgctxt "Beverly"
msgid "I’m sure you’ll mean it more when the hangover goes away haha..."
msgstr "Je suis sûre que tu le penseras encore plus quand la gueule de bois sera passée haha..."

# Traduction IA – à relire
#: beverly_beverage/player_drunk_awaken/0/g-0/c-3/23
msgctxt "Beverly"
msgid "That may be the nicest thing anyone has ever said to me!"
msgstr "C'est peut-être la plus gentille chose qu'on m'ait jamais dite !"

# Traduction IA – à relire
#: beverly_beverage/player_drunk_awaken/0/g-0/c-3/31
msgctxt "Beverly"
msgid "I’m so happy you didn’t leave. I love... having you around."
msgstr "Je suis si contente que tu n'aies pas filé. J'adore... t'avoir autour de moi."

# Traduction IA – à relire
#: beverly_beverage/player_drunk_awaken/0/g-1/0
msgctxt "Beverly"
msgid "Don’t move, I’ll make us a couple hangover cures."
msgstr "Bouge pas, je nous prépare deux remèdes anti-gueule de bois."

# Traduction IA – à relire
#: beverly_beverage/player_drunk_awaken/0/g-1/8/s/0
msgctxt "Choix"
msgid "Thank you..."
msgstr "Merci..."

# Traduction IA – à relire
#: beverly_beverage/player_drunk_awaken/0/g-1/c-4/7
msgctxt "Beverly"
msgid "I’m just gonna make it slowly... moving too much makes the lights hurt."
msgstr "Je vais le faire lentement... trop bouger fait mal aux lumières."

# Traduction IA – à relire
#: beverly_beverage/mocktail_return/0/0
msgctxt "Beverly"
msgid "Good morning!"
msgstr "Bonjour !"

# Traduction IA – à relire
#: beverly_beverage/mocktail_return/0/8/s/0
msgctxt "Choix"
msgid "It's not morning..."
msgstr "C'est pas le matin..."

# Traduction IA – à relire
#: beverly_beverage/mocktail_return/0/9/s/0
msgctxt "Choix"
msgid "Morning Bev! You seem chipper today."
msgstr "Salut Bev ! Tu as l'air en forme aujourd'hui."

# Traduction IA – à relire
#: beverly_beverage/mocktail_return/0/g-0/0
msgctxt "Beverly"
msgid "I just feel good! After our mocktail party I went out and put up more flyers! Then I talked to Phoenicia for advice on buying Placebook ads."
msgstr "Je me sens juste bien ! Après notre soirée mocktails, je suis sortie remettre des flyers ! Ensuite j'ai demandé conseil à Phoenicia pour acheter de la pub sur Placebook."

# Traduction IA – à relire
#: beverly_beverage/mocktail_return/0/g-0/11
msgctxt "Beverly"
msgid "All in all, a very productive night. I just feel like I’m on the edge of good things now!"
msgstr "Dans l'ensemble, une nuit très productive. J'ai l'impression d'être au bord de belles choses maintenant !"

# Traduction IA – à relire
#: beverly_beverage/mocktail_return/0/g-0/19
msgctxt "Beverly"
msgid "And I have you to thank! You really gave me the push that I needed."
msgstr "Et c'est grâce à toi ! Tu m'as vraiment donné le coup de pouce dont j'avais besoin."

# Traduction IA – à relire
#: beverly_beverage/mocktail_return/0/g-0/27
msgctxt "Beverly"
msgid "I’ve learned so many things that I know I’m gonna put to use everyday!"
msgstr "J'ai appris tellement de choses que je sais que je vais mettre en pratique tous les jours !"

# Traduction IA – à relire
#: beverly_beverage/mocktail_return/0/g-0/35
msgctxt "Beverly"
msgid "I’m really gonna put in the work to make THIS work!"
msgstr "Je vais vraiment m'investir pour que ÇA marche !"

# Traduction IA – à relire
#: beverly_beverage/mocktail_return/0/g-0/43
msgctxt "Beverly"
msgid "I can’t stop just because I invented one good drink! The Tipsy Tumbler is gonna succeed, and I want you to see it when it does!"
msgstr "Je ne peux pas m'arrêter juste parce que j'ai inventé une bonne boisson ! La Tipsy Tumbler va réussir, et je veux que tu sois là pour le voir !"

# Traduction IA – à relire
#: beverly_beverage/mocktail_return/0/g-0/51
msgctxt "Beverly"
msgid "Well, I’m going to roll up my sleeves and get this place looking more presentable. So no drinks today."
msgstr "Bon, je vais retrousser mes manches et rendre cet endroit plus présentable. Donc pas de boissons aujourd'hui."

# Traduction IA – à relire
#: beverly_beverage/mocktail_return/0/g-0/59/0
msgctxt "Beverly"
msgid "But... please come back some time. I’d love to see my favorite drinking buddy!"
msgstr "Mais... reviens me voir un de ces jours. J'adorerais voir ma personne préférée pour trinquer !"

# Traduction IA – à relire
#: beverly_beverage/mocktail_return/0/g-0/59/8/s/0
msgctxt "Choix"
msgid "You got it, buddy!"
msgstr "Compte sur moi, Bev !"

# Traduction IA – à relire
#: beverly_beverage/mocktail_return/0/g-0/59/9/s/0
msgctxt "Choix"
msgid "Aren't we more than buddies?"
msgstr "On n'est pas plus que des potes ?"

# Traduction IA – à relire
#: beverly_beverage/mocktail_return/0/g-0/59/c-3/7
msgctxt "Beverly"
msgid "Uh yeah, we totally are!"
msgstr "Euh ouais, carrément !"

# Traduction IA – à relire
#: beverly_beverage/mocktail_return/0/g-0/59/c-3/15
msgctxt "Beverly"
msgid "Sorry I'm just so not used to saying this but...."
msgstr "Désolée, j'ai tellement pas l'habitude de dire ça mais...."

# Traduction IA – à relire
#: beverly_beverage/mocktail_return/0/g-0/59/c-3/23
msgctxt "Beverly"
msgid "Ahhh I love you!"
msgstr "Ahhh je t'aime !"

# Traduction IA – à relire
#: beverly_beverage/Bev_Drunk_Return/0/0
msgctxt "Beverly"
msgid "Oh! You... you actually came back??"
msgstr "Oh ! Tu... tu es vraiment de retour ??"

# Traduction IA – à relire
#: beverly_beverage/Bev_Drunk_Return/0/g-0/0
msgctxt "Beverly"
msgid "Ugh, God I’m so embarrassed. You really saw me at my worst."
msgstr "Ugh, mon Dieu, j'ai tellement honte. Tu m'as vraiment vue au pire."

# Traduction IA – à relire
#: beverly_beverage/Bev_Drunk_Return/0/g-0/11/b/1
msgctxt "Beverly"
msgid "But you stayed... which means so much to me."
msgstr "Mais tu as tenu bon... ce qui compte énormément pour moi."

# Traduction IA – à relire
#: beverly_beverage/Bev_Drunk_Return/0/g-0/14/b/1
msgctxt "Beverly"
msgid "I didn’t think you’d want to see me after the mess I was in last time. I'm so sorry you had to see that..."
msgstr "Je ne pensais pas que tu voudrais me revoir après l'état dans lequel j'étais la dernière fois. Je suis vraiment désolée que tu aies dû voir ça..."

# Traduction IA – à relire
#: beverly_beverage/Bev_Drunk_Return/0/g-0/17/s/0
msgctxt "Choix"
msgid "Actually, I wanted to talk about that."
msgstr "En fait, je voulais en parler."

# Traduction IA – à relire
#: beverly_beverage/Bev_Drunk_Return/0/g-0/18/s/0
msgctxt "Choix"
msgid "It’s no problem!"
msgstr "Il n'y a pas de problème !"

# Traduction IA – à relire
#: beverly_beverage/Bev_Drunk_Return/0/g-0/c-2/7
msgctxt "Beverly"
msgid "What? Why?"
msgstr "Quoi ? Pourquoi ?"

# Traduction IA – à relire
#: beverly_beverage/Bev_Drunk_Return/0/g-0/c-2/15
msgctxt "Beverly"
msgid "Look, I’m fine! There’s no problem! I just drink for fun!"
msgstr "Écoute, je vais bien ! Il n'y a aucun problème ! Je bois juste pour le plaisir !"

# Traduction IA – à relire
#: beverly_beverage/Bev_Drunk_Return/0/g-0/c-2/23
msgctxt "Beverly"
msgid "It’s not like I’m secretly trying to cope with my crippling fears and anxieties or anything."
msgstr "Ce n'est pas comme si j'essayais secrètement de gérer mes peurs et mes angoisses paralysantes ou quoi que ce soit."

# Traduction IA – à relire
#: beverly_beverage/Bev_Drunk_Return/0/g-0/c-2/31
msgctxt "Beverly"
msgid "I mean. I don’t know! I’m stressed!!"
msgstr "Enfin. Je sais pas ! Je suis stressée !!"

# Traduction IA – à relire
#: beverly_beverage/Bev_Drunk_Return/0/g-0/c-2/39
msgctxt "Beverly"
msgid "And when I’m sober all I do is think about the things I’m stressed about more!"
msgstr "Et quand je suis sobre, tout ce que je fais, c'est penser encore plus à ce qui me stresse !"

# Traduction IA – à relire
#: beverly_beverage/Bev_Drunk_Return/0/g-0/c-2/47
msgctxt "Beverly"
msgid "I just. Um. Look, can we talk about this later?"
msgstr "C'est juste. Euh. Écoute, on peut en parler plus tard ?"

# Traduction IA – à relire
#: beverly_beverage/Bev_Drunk_Return/0/g-0/c-2/55/0/s/0
msgctxt "Choix"
msgid "Sure thing."
msgstr "Bien sûr."

# Traduction IA – à relire
#: beverly_beverage/Bev_Drunk_Return/0/g-0/c-2/55/1/s/0
msgctxt "Choix"
msgid "No, I want to get to the bottom of this."
msgstr "Non, je veux vider cette affaire jusqu'à la dernière goutte."

# Traduction IA – à relire
#: beverly_beverage/Bev_Drunk_Return/0/g-0/c-3/7
msgctxt "Beverly"
msgid "I’m so relieved to hear that."
msgstr "Je suis tellement soulagée de l'entendre."

# Traduction IA – à relire
#: beverly_beverage/Bev_Drunk_Return/0/g-0/c-3/15
msgctxt "Beverly"
msgid "Seriously, I’m glad you’re cool with it. I mean, everyone who drinks has at least one embarrassing experience, right? So it’s really no big deal, right?"
msgstr "Sérieusement, je suis contente que tu le prennes bien. Enfin, tous ceux qui boivent ont au moins une expérience embarrassante, non ? Donc ce n'est vraiment pas grave, non ?"

# Traduction IA – à relire
#: beverly_beverage/Bev_Drunk_Return/0/g-0/c-3/23
msgctxt "Beverly"
msgid "At least this one didn’t end with me waking up with my face on the bathroom floor beside Jean Loo."
msgstr "Au moins, celle-là ne s'est pas terminée avec moi qui me réveille la tête sur le carrelage de la salle de bain, à côté de Jean Loo."

# Traduction IA – à relire
#: beverly_beverage/Bev_Drunk_Return/0/g-0/c-3/37
msgctxt "Beverly"
msgid "The last thing you wanna hear when you’re hung over is him <i>rapping</i> in your ear."
msgstr "La dernière chose qu'on veut entendre quand on a la gueule de bois, c'est lui qui <i>rappe</i> dans votre oreille."

# Traduction IA – à relire
#: beverly_beverage/Bev_Drunk_Return/0/g-0/c-3/45
msgctxt "Beverly"
msgid "\"Bev's drunk again, slumped in a pile, / Ain't got friends and ain't got style / Ran out of wine, all that's left are the lines / Pressed into her face from the bathroom tile!\""
msgstr "« Bev a trop bu, la voilà en tas par terre, / Sans amis, sans style, la reine des galères, / Plus de vin, c'est la fin du festin, / Le carrelage imprimé sur son visage enfin ! »"

# Traduction IA – à relire
#: beverly_beverage/Bev_Drunk_Return/0/g-0/c-3/53
msgctxt "Beverly"
msgid "I hate him. I hate him so much."
msgstr "Je le déteste. Je le déteste tellement."

# Traduction IA – à relire
#: beverly_beverage/Bev_Drunk_Return/0/drinknow/0
msgctxt "Beverly"
msgid "I just wish I had been a better host for you. I’m sorry."
msgstr "J'aurais juste voulu être une meilleure hôtesse pour toi. Désolée."

# Traduction IA – à relire
#: beverly_beverage/Bev_Drunk_Return/0/drinknow/8/s/0
msgctxt "Choix"
msgid "We’ll have more fun next time!"
msgstr "On s'amusera encore plus la prochaine fois !"

# Traduction IA – à relire
#: beverly_beverage/Bev_Drunk_Return/0/drinknow/9/s/0
msgctxt "Choix"
msgid "All the more reason to be more careful with your drinking?"
msgstr "Raison de plus pour faire plus attention à ta façon de boire ?"

# Traduction IA – à relire
#: beverly_beverage/Bev_Drunk_Return/0/drinknow/c-4/7
msgctxt "Beverly"
msgid "Hey yeah!! Next time we’ll throw a REAL rager! One that doesn’t end with one of us in the bathroom."
msgstr "Hé ouais !! La prochaine fois, on organise une VRAIE fête de dingue ! Une qui ne se termine pas avec l'un de nous dans la salle de bain."

# Traduction IA – à relire
#: beverly_beverage/Bev_Drunk_Return/0/drinknow/c-4/15
msgctxt "Beverly"
msgid "Hell yeah, I’m excited for it!!"
msgstr "Ouais, j'ai trop hâte !!"

# Traduction IA – à relire
#: beverly_beverage/Bev_Drunk_Return/0/drinknow/c-5/7
msgctxt "Beverly"
msgid "Hmm... I don’t quite follow..."
msgstr "Hmm... je ne suis pas sûre de suivre..."

# Traduction IA – à relire
#: beverly_beverage/Bev_Drunk_Return/0/drinknow/c-5/15
msgctxt "Beverly"
msgid "Of course I’m careful! I didn’t spill anything, or drop any glasses, or get sick outside the toilet!"
msgstr "Bien sûr que je fais attention ! Je n'ai rien renversé, je n'ai pas fait tomber de verres, et je n'ai pas vomi en dehors des toilettes !"

# Traduction IA – à relire
#: beverly_beverage/Bev_Drunk_Return/0/drinknow/c-5/23
msgctxt "Beverly"
msgid "I’m surprisingly coordinated when I’m wasted. Years of practice pays off!"
msgstr "Je suis étonnamment coordonnée quand je suis défoncée. Des années de pratique qui paient !"

# Traduction IA – à relire
#: beverly_beverage/Bev_Drunk_Return/0/g-1/0
msgctxt "Beverly"
msgid "So... why did you come back?"
msgstr "Alors... pourquoi tu as remis les pieds ici ?"

# Traduction IA – à relire
#: beverly_beverage/Bev_Drunk_Return/0/g-1/8/s/0
msgctxt "Choix"
msgid "I just wanted to make sure you were okay."
msgstr "Je voulais juste m'assurer que tu allais bien."

# Traduction IA – à relire
#: beverly_beverage/Bev_Drunk_Return/0/g-1/9/s/0
msgctxt "Choix"
msgid "I think you're hot."
msgstr "Je te trouve canon."

# Traduction IA – à relire
#: beverly_beverage/Bev_Drunk_Return/0/g-1/c-6/7
msgctxt "Beverly"
msgid "Really? You care that much about little ol’ me?"
msgstr "Vraiment ? Tu tiens autant à la petite moi ?"

# Traduction IA – à relire
#: beverly_beverage/Bev_Drunk_Return/0/g-1/c-7/7
msgctxt "Beverly"
msgid "Aww... that’s sweet. Thank you."
msgstr "Aww... c'est adorable. Merci."

# Traduction IA – à relire
#: beverly_beverage/Bev_Drunk_Return/0/g-2/0
msgctxt "Beverly"
msgid "Well, I need to get a hangover cure. Do you want something while I’m at the bar?"
msgstr "Bon, il faut que je me prépare un remède anti-gueule de bois. Tu veux quelque chose pendant que je suis au bar ?"

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/0/s/0
msgctxt "Choix"
msgid "Ahh, that’s good."
msgstr "Ahh, c'est bon."

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/1/s/0
msgctxt "Choix"
msgid "That one was made a little rough I think..."
msgstr "Celui-là a été fait un peu à l'arrache, je crois..."

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/c-0/7
msgctxt "Beverly"
msgid "Phew, glad you like it."
msgstr "Ouf, je suis contente qu'il te plaise."

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/c-1/7
msgctxt "Beverly"
msgid "I feel a little rough I think..."
msgstr "Je me sens un peu à l'arrache, je crois..."

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/c-2/7
msgctxt "Narrator"
msgid "You move almost in slow motion, taking the cup from Beverly and turning it over to dump it out at her feet."
msgstr "Vous bougez presque au ralenti, prenez le gobelet des mains de Beverly et le retournez pour le vider à ses pieds."

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/c-2/39/b/1
msgctxt "Beverly"
msgid "Yup. There's always that option."
msgstr "Ouais. Il y a toujours cette option."

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/c-2/42/b/1
msgctxt "Narrator"
msgid "Beverly stares down at the drink pooling on the ground. She doesn't even seem hurt anymore... more numb."
msgstr "Beverly fixe la boisson qui s'étale par terre. Elle ne semble même plus blessée... plutôt engourdie."

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/c-2/45/b/1
msgctxt "Beverly"
msgid "Every. Frickin. Time."
msgstr "À. Chaque. Fichue. Fois."

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-0/0/12/s/0
msgctxt "Choix"
msgid "How are you feeling now Bev?"
msgstr "Comment tu te sens maintenant, Bev ?"

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-0/0/13/s/0
msgctxt "Choix"
msgid "You okay?"
msgstr "Ça va ?"

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-0/0/c-3/7
msgctxt "Beverly"
msgid "Mmmf... I’ll let you know when my brain and I are on speaking terms again."
msgstr "Mmmf... je te dirai quand mon cerveau et moi serons de nouveau en bons termes."

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-1/0
msgctxt "Beverly"
msgid "Ughhh why do I do this."
msgstr "Ughhh pourquoi je fais ça."

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-1/8
msgctxt "Beverly"
msgid "I mean. I know WHY but whyyyyyyyyyyy."
msgstr "Je veux dire. Je sais POURQUOI mais pourquoiiiiiiiii."

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-1/16/s/0
msgctxt "Choix"
msgid "Why <i>do</i> you drink?"
msgstr "Pourquoi tu bois, <i>en fait</i> ?"

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-1/c-6/21
msgctxt "Beverly"
msgid "Because I’m so afraid of failure and being alone."
msgstr "Parce que j'ai tellement peur de l'échec et de la solitude."

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-1/c-6/29
msgctxt "Beverly"
msgid "I drink to deal with the stress, and so my customers will have more fun with me and won’t leave."
msgstr "Je bois pour gérer le stress, et pour que mes clients s'amusent plus avec moi et ne partent pas."

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-1/c-6/37
msgctxt "Beverly"
msgid "My whole purpose is to serve and entertain. If I can’t do that, then what am I?"
msgstr "Toute ma raison d'être, c'est de servir et de divertir. Si je n'y arrive pas, alors qu'est-ce que je suis ?"

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/8/s/0
msgctxt "Choix"
msgid "You’re my friend!"
msgstr "Tu es mon amie !"

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/9/s/0
msgctxt "Choix"
msgid "You’re someone who is funny. And smart. Not to mention cute."
msgstr "Tu es drôle. Et intelligente. Sans parler de mignonne."

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/c-7/15
msgctxt "Beverly"
msgid "Really? You mean it?"
msgstr "Vraiment ? Tu le penses ?"

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/c-7/23
msgctxt "Beverly"
msgid "So you won’t leave me?"
msgstr "Alors tu ne vas pas me quitter ?"

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/c-7/31
msgctxt "Beverly"
msgid "Awww!! You big softie!"
msgstr "Awww !! Espèce de bon gros cœur !"

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/c-7/39
msgctxt "Beverly"
msgid "You’re right, we ARE friends! And I’m so happy about it! You’ve been a true friend this past week!"
msgstr "Tu as raison, on EST amis ! Et j'en suis ravie ! Tu as été un vrai soutien cette dernière semaine !"

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/c-7/47
msgctxt "Beverly"
msgid "Thank you for saying that. Really."
msgstr "Merci d'avoir dit ça. Vraiment."

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/c-7/55
msgctxt "Beverly"
msgid "I know I’m kind of a mess, and a lot to be around... but drunk or sober I’m gonna appreciate you 'til the last call for alcohol!"
msgstr "Je sais que je suis un peu un cas, et que je suis beaucoup à supporter... mais ivre ou sobre, je t'apprécierai jusqu'à la dernière tournée !"

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/c-8/15
msgctxt "Beverly"
msgid "Y-You really think I’m those things?"
msgstr "T-Tu penses vraiment que je suis tout ça ?"

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/c-8/23
msgctxt "Beverly"
msgid "Cuz... I think you’re all those things too!"
msgstr "Parce que... moi, je pense que tu es tout ça aussi !"

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/c-8/31
msgctxt "Beverly"
msgid "Not to mention... you’ve done soooooo much for me."
msgstr "Sans parler du fait que... tu as fait tellement de choses pour moi."

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/c-8/39
msgctxt "Beverly"
msgid "You literally made my dream a reality."
msgstr "Tu as littéralement réalisé mon rêve."

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/c-8/47
msgctxt "Beverly"
msgid "No one has ever cared so much about me before. You really touched my little glass heart."
msgstr "Personne ne s'était jamais autant soucié de moi. Tu as vraiment touché mon petit cœur de verre."

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/c-8/55
msgctxt "Beverly"
msgid "Ha! Wow! I must still be drunk, my face is all flushed!"
msgstr "Ha ! Wow ! Je dois encore être soûle, j'ai le visage tout rouge !"

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/c-8/63/0/s/0
msgctxt "Choix"
msgid "Can’t relate..."
msgstr "Connais pas..."

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/c-8/63/1/s/0
msgctxt "Choix"
msgid "Mine too!"
msgstr "Moi aussi !"

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/c-8/63/2/s/0
msgctxt "Choix"
msgid "My face is flushed for a different reason."
msgstr "J'ai le visage rouge pour une autre raison."

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/c-8/63/c-0/7
msgctxt "Beverly"
msgid "O-Oh! Well... you must have a higher tolerance than I do! Hahahaha!"
msgstr "O-Oh ! Eh bien... tu dois avoir une meilleure tolérance que moi ! Hahahaha !"

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/c-8/63/c-0/15
msgctxt "Beverly"
msgid "I just. Really really appreciate our... friendship."
msgstr "C'est juste. Que j'apprécie vraiment, vraiment notre... amitié."

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/c-8/63/c-0/23
msgctxt "Beverly"
msgid "Because you’re a good friend... Come by any time."
msgstr "Parce que tu es quelqu'un de bien... Passe quand tu veux."

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/c-8/63/c-1/7
msgctxt "Beverly"
msgid "!! Oh wow, you’re not lying. You’re redder than a Bloody Mary!"
msgstr "!! Oh wow, tu ne mens pas. Tu es plus rouge qu'un Bloody Mary !"

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/c-8/63/c-1/15
msgctxt "Beverly"
msgid "Maybe we should have another drink?"
msgstr "On devrait peut-être reprendre un verre ?"

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/c-8/63/c-1/23
msgctxt "Beverly"
msgid "And then... maybe kiss a little?"
msgstr "Et puis... peut-être s'embrasser un peu ?"

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/c-8/63/c-1/34/0/s/0
msgctxt "Choix"
msgid "I think we could definitely do that..."
msgstr "Je crois qu'on pourrait carrément faire ça..."

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/c-8/63/c-1/34/1/s/0
msgctxt "Choix"
msgid "N-nnooo. Just friends please?"
msgstr "N-nnoon. Juste amis, s'il te plaît ?"

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/c-8/63/c-1/34/c-0/7
msgctxt "Beverly"
msgid "Yes!!"
msgstr "Oui !!"

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/c-8/63/c-1/34/c-0/15
msgctxt "Beverly"
msgid "Come here, I wanna taste your drink off your lips and get drunk off of <i>you.</i> <3"
msgstr "Viens là, je veux goûter ton verre sur tes lèvres et me saouler de <i>toi.</i> <3"

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/c-8/63/c-1/34/c-1/7
msgctxt "Beverly"
msgid "Ooooohhh okiedokie. Yeah. We're friends for sure!"
msgstr "Ooooohhh d'accord. Ouais. On est amis, c'est sûr !"

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/c-8/63/c-2/7
msgctxt "Beverly"
msgid "You think I'm cute even when you're sober!!"
msgstr "Tu me trouves mignonne même quand tu es sobre !!"

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/c-8/63/c-2/15
msgctxt "Beverly"
msgid "Wow..."
msgstr "Wow..."

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/c-8/63/c-2/26
msgctxt "Beverly"
msgid "Imeanithinksotoo"
msgstr "Jeveuxdirejelepenseaussi"

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/c-8/63/c-2/34
msgctxt "Beverly"
msgid "You're- you're cute, I mean."
msgstr "Tu es- tu es adorable, je veux dire."

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/c-8/63/c-2/42
msgctxt "Beverly"
msgid "You'll love me even though I'm a lush?"
msgstr "Tu m'aimeras même si je suis une poivrote ?"

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/c-8/63/c-2/50/0/s/0
msgctxt "Choix"
msgid "That's okay with me."
msgstr "Ça me va très bien."

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/c-8/63/c-2/50/1/s/0
msgctxt "Choix"
msgid "You being a lush makes me blush."
msgstr "T'es poivrote, moi je tremblote."

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/c-8/63/c-2/50/c-0/7
msgctxt "Beverly"
msgid "I'll pour another drink! Champagne, anyone?"
msgstr "Je ressers un verre ! Du champagne pour tout le monde ?"

# Traduction IA – à relire
#: beverly_beverage/fifth_drink/0/g-2/c-8/63/c-2/50/c-1/7
msgctxt "Beverly"
msgid "Oh we're rhyming now?? Hell yeah!"
msgstr "Oh, on rime maintenant ?? Carrément !"

# Traduction IA – à relire
#: beverly_beverage/beverly_hate_return/0/0
msgctxt "Narrator"
msgid "Beverly is hanging a sign across the bar when you walk up on her. She gives you the briefest of glances over her shoulder."
msgstr "Beverly accroche une pancarte au-dessus du bar quand vous vous approchez. Elle vous jette à peine un coup d'oeil par-dessus son épaule."

# Traduction IA – à relire
#: beverly_beverage/beverly_hate_return/0/8
msgctxt "Beverly"
msgid "You see that sign?"
msgstr "Tu vois cette pancarte ?"

# Traduction IA – à relire
#: beverly_beverage/beverly_hate_return/0/16
msgctxt "Beverly"
msgid "It says - \"Closing Down. Thank you for your business.\""
msgstr "Elle dit : « Fermeture définitive. Merci de votre confiance. »"

# Traduction IA – à relire
#: beverly_beverage/beverly_hate_return/0/24/s/0
msgctxt "Choix"
msgid "Good."
msgstr "Tant mieux."

# Traduction IA – à relire
#: beverly_beverage/beverly_hate_return/0/25/s/0
msgctxt "Choix"
msgid "Look, I’m sorry."
msgstr "Écoute, je suis {{désolé|désolée|désolé·e}}."

# Traduction IA – à relire
#: beverly_beverage/beverly_hate_return/0/26/s/0
msgctxt "Choix"
msgid "I learned how to make something just for you. (USE CHARM CANDY)"
msgstr "J'ai appris à faire quelque chose rien que pour toi. (UTILISER UN BONBON DE CHARME)"

# Traduction IA – à relire
#: beverly_beverage/beverly_hate_return/0/c-0/7
msgctxt "Beverly"
msgid "Go away."
msgstr "Va-t'en."

# Traduction IA – à relire
#: beverly_beverage/beverly_hate_return/0/c-1/7
msgctxt "Beverly"
msgid "OH WOW! Well that just solves EVERYTHING doesn’t it?"
msgstr "OH WOW ! Eh bien ça règle TOUT, n'est-ce pas ?"

# Traduction IA – à relire
#: beverly_beverage/beverly_hate_return/0/c-1/15
msgctxt "Beverly"
msgid "I mean, how could I possibly be sad after such a heartfelt apology?"
msgstr "Je veux dire, comment pourrais-je être triste après des excuses aussi sincères ?"

# Traduction IA – à relire
#: beverly_beverage/beverly_hate_return/0/c-1/23
msgctxt "Beverly"
msgid "Sorry is such a MAGICAL word! I can’t believe anyone doesn't say it more, it’s SO convenient!"
msgstr "« Pardon » est un mot tellement MAGIQUE ! Je n'arrive pas à croire qu'on ne le dise pas plus souvent, c'est TELLEMENT pratique !"

# Traduction IA – à relire
#: beverly_beverage/beverly_hate_return/0/c-1/31
msgctxt "Beverly"
msgid "Here let me try it. I’m sorry! POOF! <i>GASP</i> Oh my gosh! My broken dreams are fixed!"
msgstr "Tiens, laisse-moi essayer. Pardon ! POUF ! <i>OH</i> Mon Dieu ! Mes rêves brisés sont réparés !"

# Traduction IA – à relire
#: beverly_beverage/beverly_hate_return/0/c-1/42
msgctxt "Beverly"
msgid "And that feeling that I’m a huge failure that led me to an endless downward spiral? All gone! WOW!"
msgstr "Et cette impression d'être un énorme échec qui m'a entraînée dans une spirale sans fin ? Disparue ! WOW !"

# Traduction IA – à relire
#: beverly_beverage/beverly_hate_return/0/c-1/50/0/s/0
msgctxt "Choix"
msgid "Sigh... Look, I’ll go. I am sorry. Good luck Beverly..."
msgstr "Soupir... Écoute, je m'en vais. Je suis {{désolé|désolée|désolé·e}}. Bonne chance, Beverly..."

# Traduction IA – à relire
#: beverly_beverage/beverly_hate_return/0/c-1/50/c-0/7
msgctxt "Beverly"
msgid "Hmph!!"
msgstr "Hmph !!"

# Traduction IA – à relire
#: beverly_beverage/beverly_hate_return/0/c-1/50/c-0/15
msgctxt "Beverly"
msgid "I’d advertise that you’re a JERK so everyone else would be on the lookout, but apparently NO ONE CARES ENOUGH TO LISTEN TO ME!"
msgstr "Je ferais bien de la pub pour dire que tu es une ORDURE pour que tout le monde se méfie, mais apparemment PERSONNE NE S'INTÉRESSE ASSEZ À MOI POUR M'ÉCOUTER !"

# Traduction IA – à relire
#: beverly_beverage/beverly_hate_return/0/c-1/50/c-0/26
msgctxt "Beverly"
msgid "If I never see you again, it’ll be too soon!"
msgstr "Si je ne te revois jamais, ce sera encore trop tôt !"

# Traduction IA – à relire
#: beverly_beverage/beverly_hate_return/0/c-2/17
msgctxt "Beverly"
msgid "...what."
msgstr "...quoi."

# Traduction IA – à relire
#: beverly_beverage/beverly_hate_return/0/c-2/25/0/s/0
msgctxt "Choix"
msgid "It's called a Sorry Drink."
msgstr "Ça s'appelle un Verre de Pardon."

# Traduction IA – à relire
#: beverly_beverage/beverly_hate_return/0/c-2/25/1/s/0
msgctxt "Choix"
msgid "It's called I'm an Idiot, served on the rocks."
msgstr "Ça s'appelle Mea Culpa, servi sur glace."

# Traduction IA – à relire
#: beverly_beverage/beverly_hate_return/0/c-2/25/g-0/8
msgctxt "Beverly"
msgid "That's cute."
msgstr "C'est mignon."

# Traduction IA – à relire
#: beverly_beverage/beverly_hate_return/0/c-2/25/g-0/16
msgctxt "Beverly"
msgid "What's in it?"
msgstr "Qu'est-ce qu'il y a dedans ?"

# Traduction IA – à relire
#: beverly_beverage/beverly_hate_return/0/c-2/25/g-0/24/0/s/0
msgctxt "Choix"
msgid "Two parts apology, one part humility."
msgstr "Deux doses d'excuses, une dose d'humilité."

# Traduction IA – à relire
#: beverly_beverage/beverly_hate_return/0/c-2/25/g-0/24/1/s/0
msgctxt "Choix"
msgid "Grenadine, whiskey, coconut... and a hug.."
msgstr "Grenadine, whisky, noix de coco... et un câlin.."

# Traduction IA – à relire
#: beverly_beverage/beverly_hate_return/0/c-2/25/g-0/24/g-0/0
msgctxt "Beverly"
msgid "That's a good drink."
msgstr "C'est une bonne boisson."

# Traduction IA – à relire
#: beverly_beverage/beverly_hate_return/0/c-2/25/g-0/24/g-0/8
msgctxt "Beverly"
msgid "All right, you. You're forgiven."
msgstr "Bon, toi. Tu es {{pardonné|pardonnée|pardonné·e}}."

# Traduction IA – à relire
#: beverly_beverage/beverly_hate_return/0/c-2/25/g-0/24/g-0/16
msgctxt "Narrator"
msgid "Beverly grabs the sign and tosses it to the floor."
msgstr "Beverly attrape la pancarte et la jette par terre."

# Traduction IA – à relire
#: beverly_beverage/beverly_hate_return/0/c-2/25/g-0/24/g-0/32
msgctxt "Beverly"
msgid "You’re kinda the only mouth that can help me."
msgstr "Tu es à peu près la seule bouche qui puisse m'aider."

# Traduction IA – à relire
#: beverly_beverage/beverly_hate_return/0/c-2/25/g-0/24/g-0/40
