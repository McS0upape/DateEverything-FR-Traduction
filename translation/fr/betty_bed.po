#: betty_bed/betty_hateending/0/g-1/c-7/23/c-0/39/c-0/7
msgctxt "Betty"
msgid "You're goddamn right it was."
msgstr ""

#: betty_bed/betty_hateending/0/g-1/c-7/23/c-0/39/c-0/15
msgctxt "Betty"
msgid "Get away from me."
