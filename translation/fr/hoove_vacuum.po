msgctxt "Hoove"
msgid "Even so, maybe I can turn you into a true fan."
msgstr "Même comme ça, je peux peut-être faire de toi un vrai fan."

# Traduction IA – à relire
#: hoove_vacuum/HooveHanksGame/0/c-0/26/c-0/23/c-0/23 hoove_vacuum/HooveHanksGame/0/c-0/26/c-0/23/c-1/23
msgctxt "Hoove"
msgid "I've got season tickets!"
msgstr "J'ai un abonnement à l'année !"

# Traduction IA – à relire
#: hoove_vacuum/HooveHanksGame/0/c-0/26/c-0/23/c-2/11
msgctxt "Hoove"
msgid "LET'S GOOOO!!!!!"
msgstr "ALLONS-Y !!!!!"

# Traduction IA – à relire
#: hoove_vacuum/HooveHanksGame/0/c-0/26/c-0/23/c-2/22
msgctxt "Hoove"
msgid "That's the sort of thing only a true fan would know!"
msgstr "Ça, c'est le genre de truc que seul un vrai fan sait !"

# Traduction IA – à relire
#: hoove_vacuum/HooveHanksGame/0/c-0/26/c-0/23/c-2/30
msgctxt "Hoove"
msgid "I've got season tickets... and FRONT ROW SEATS!"
msgstr "J'ai un abonnement à l'année... et des places au PREMIER RANG !"

# Traduction IA – à relire
#: hoove_vacuum/HooveHanksGame/0/c-0/26/c-1/7
msgctxt "Hoove"
msgid "Well, I'll teach you to love em!"
msgstr "Eh bien, je vais t'apprendre à les aimer !"

# Traduction IA – à relire
#: hoove_vacuum/HooveHanksGame/0/c-0/26/c-1/15
msgctxt "Hoove"
msgid "I've got season tickets..."
msgstr "J'ai un abonnement à l'année..."

# Traduction IA – à relire
#: hoove_vacuum/HooveHanksGame/0/c-0/26/c-1/23
msgctxt "Hoove"
msgid "Let's go!"
msgstr "Allons-y !"

# Traduction IA – à relire
#: hoove_vacuum/HooveHanksGame/0/c-1/11
msgctxt "Hoove"
msgid "What?! You must be crazy!"
msgstr "Quoi ?! Tu délires complètement !"

# Traduction IA – à relire
#: hoove_vacuum/HooveHanksGame/0/c-1/19
msgctxt "Hoove"
msgid "They stink!"
msgstr "Ils puent !"

# Traduction IA – à relire
#: hoove_vacuum/HooveHanksGame/0/c-1/30/0/s/0
