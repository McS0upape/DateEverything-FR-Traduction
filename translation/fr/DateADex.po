msgid "Kiss from a candle"
msgstr "Baiser d'une bougie"

# Traduction IA – à relire
#: DateADex/scandalabra_dex_entry/154
msgctxt "Tag Date-A-Dex"
msgid "You really went for it."
msgstr "Tu t'es vraiment {{lâché|lâchée|lâché·e}}."

# Traduction IA – à relire
#: DateADex/scandalabra_dex_entry/157
msgctxt "Tag Date-A-Dex"
msgid "Kiss the Scandalabra... with all you have."
msgstr "Embrasse Scandalabra... de toutes tes forces."

# Traduction IA – à relire
#: DateADex/scandalabra_dex_entry/160
msgctxt "Tag Date-A-Dex"
msgid "Scandalabra's Date-a-dex"
msgstr "Le Date-A-Dex de Scandalabra"

# Traduction IA – à relire
