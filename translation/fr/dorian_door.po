msgid "You get to speak with each object once per day."
msgstr "Tu peux parler à chaque objet une fois par jour."

# Traduction IA – à relire
#: dorian_door/tutorial_dorian/0/g-0/16
msgctxt "Dorian"
msgid "We get a little knackered by using this newfangled dateviator rubbish, y'see."
msgstr "Ça nous lessive un peu, ces nouvelles bidouilles de Dateviators, tu vois."

# Traduction IA – à relire
#: dorian_door/tutorial_dorian/0/g-0/24 dorian_door/tutorial_dorian_front/0/g-0/24 dorian_door/tutorial_dorian_back/0/g-0/24 dorian_door/tutorial_dorian_tiny/0/g-0/24 dorian_door/tutorial_dorian_trap/0/g-0/24
msgctxt "Skylar"
msgid "Sometimes when you reach a certain level of affection with a dateable object, your relationship status changes!"
msgstr "Parfois, quand tu atteins un certain niveau d'affection avec un objet datable, le statut de votre relation change !"

# Traduction IA – à relire
