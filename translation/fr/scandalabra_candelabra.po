# Traduction IA – à relire
#: scandalabra_candelabra/1
msgctxt "Tag Nom d'objet (MAJUSCULES)"
msgid "CANDELABRA"
msgstr "CANDÉLABRE"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_globe/0/4
msgctxt "Narrator"
msgid "Scandalabra leans in close, inhaling your scent in a way that's just a little too intimate."
msgstr "Scandalabra se penche tout près, humant votre odeur d'une façon un peu trop intime."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_globe/0/12
msgctxt "Scandalabra"
msgid "You smell of spheres... have you been talking with Gaia?"
msgstr "Tu sens la sphère... as-tu parlé avec Gaia ?"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_globe/0/20/s/0
msgctxt "Choix"
msgid "That's right, she said you didn't seem all that foreign to her."
msgstr "Exact, elle m'a dit que tu ne lui semblais pas si étranger que ça."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_globe/0/21/s/0
msgctxt "Choix"
msgid "How did you know that?"
msgstr "Comment as-tu su ?"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_globe/0/g-0/0
msgctxt "Scandalabra"
msgid "Hah! I am as un-american as you can be!"
msgstr "Ha ! Je suis aussi peu américain qu'il est possible de l'être !"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_globe/0/g-0/8
msgctxt "Scandalabra"
msgid "My gait, like so, my accent, like so, my mein, like so."
msgstr "Ma démarche, ainsi ; mon accent, ainsi ; ma mine, ainsi."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_globe/0/g-0/16
msgctxt "Scandalabra"
msgid "Why I couldn't tell a hot dog from a Hamburger."
msgstr "Je ne saurais même pas distinguer un hot-dog d'un hamburger."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_globe/0/g-0/24
msgctxt "Scandalabra"
msgid "Those from Hamburg are rather frankfurter-shaped, if you must know."
msgstr "Les natifs de Hambourg sont plutôt en forme de saucisse de Francfort, si tu veux tout savoir."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_globe/0/g-0/32
msgctxt "Scandalabra"
msgid "I would know as I'm CONTINENTAL."
msgstr "Je le sais, car je suis CONTINENTAL."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_globe/0/g-0/40
msgctxt "Scandalabra"
msgid "End of parley."
msgstr "Fin des pourparlers."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/13
msgctxt "Narrator"
msgid "The Scandalabra is no longer—everything about him has firmly shifted into 'just some guy' territory."
msgstr "Le Scandalabra n'est plus — tout en lui a résolument basculé dans le registre du « gars quelconque »."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/21
msgctxt "Narrator"
msgid "It's somewhat disconcerting."
msgstr "C'est assez déconcertant."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/29
msgctxt "Jon Wick"
msgid "Well, now you know my big secret."
msgstr "Eh bien, maintenant tu connais mon grand secret."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/37
msgctxt "Jon Wick"
msgid "I'm a big old fraud."
msgstr "Je suis un gros fraudeur, un vieux fumiste."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/45/b/1
msgctxt "Jon Wick"
msgid "Full of memories of that incredible love we shared."
msgstr "Plein de souvenirs de cet incroyable amour que nous avons partagé."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/45/b/9
msgctxt "Jon Wick"
msgid "I can remember your lips pressed against mine... that secret threat of your tongue..."
msgstr "Je me souviens de tes lèvres pressées contre les miennes... cette menace secrète de ta langue..."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/45/b/17
msgctxt "Jon Wick"
msgid "It still gives me the shivers."
msgstr "Ça me donne encore des frissons."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/48/s/0
msgctxt "Choix"
msgid "Hey, Scandalabra. It's okay. I like playing pretend."
msgstr "Hé, Scandalabra. C'est bon. J'aime bien faire semblant."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/49/s/0
msgctxt "Choix"
msgid "I actually love you for who you are underneath."
msgstr "En fait, je t'aime pour ce que tu es au fond."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/50/s/0 scandalabra_candelabra/scandalabra_unmasked_return_no_relationship/0/24/s/0
msgctxt "Choix"
msgid "The whole fake identity thing gives me the creeps."
msgstr "Toute cette histoire de fausse identité me file la chair de poule."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/c-0/11
msgctxt "Jon Wick"
msgid "Really? You liked the fake me?"
msgstr "Vraiment ? Tu l'aimais bien, le faux moi ?"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/c-0/19/0/s/0
msgctxt "Choix"
msgid "Yeah, it was fun! I'm no angel either."
msgstr "Ouais, c'était marrant ! Moi non plus je n'ai rien d'un ange."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/c-0/19/c-0/7
msgctxt "Jon Wick"
msgid "So you get where I'm coming from?"
msgstr "Alors tu comprends d'où je viens ?"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/c-0/19/c-0/15
msgctxt "Narrator"
msgid "He strikes a pose reminiscent of the scandal-loving lighting implement he once was."
msgstr "Il prend une pose rappelant l'instrument d'éclairage friand de scandales qu'il fut jadis."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/c-0/19/c-0/23
msgctxt "Scandalabra"
msgid "You... enjoy this side of me?"
msgstr "Tu... apprécies ce côté de moi ?"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/c-0/19/c-0/34/0/s/0
msgctxt "Choix"
msgid "The more ribald the better!"
msgstr "Plus c'est grivois, mieux c'est !"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/c-0/19/c-0/34/1/s/0
msgctxt "Choix"
msgid "It's not my favorite thing, but it is pretty hilarious."
msgstr "Ce n'est pas mon truc préféré, mais c'est assez hilarant."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/c-0/19/c-0/34/2/s/0
msgctxt "Choix"
msgid "Ah never mind, that voice is annoying."
msgstr "Ah, laisse tomber, cette voix est agaçante."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/c-0/19/c-0/34/c-0/7 scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/c-0/19/c-0/34/c-1/7
msgctxt "Scandalabra"
msgid "Oh joy, oh my heart!"
msgstr "Oh joie, oh mon coeur !"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/c-0/19/c-0/34/c-0/21 scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/c-0/19/c-0/34/c-1/21
msgctxt "Scandalabra"
msgid "It'll be our little scandal. You and I. The perfect pair."
msgstr "Ce sera notre petit scandale. Toi et moi. Le duo parfait."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/c-0/19/c-0/34/c-0/29 scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/c-0/19/c-0/34/c-1/29
msgctxt "Scandalabra"
msgid "Mwah!!"
msgstr "Mwah !!"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/c-1/7 scandalabra_candelabra/scandalabra_unmasked_return_no_relationship/0/c-1/7
msgctxt "Jon Wick"
msgid "Me? Just regular old Jon?"
msgstr "Moi ? Juste ce bon vieux Jon ?"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "Regular old Jon."
msgstr "Ce bon vieux Jon."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/c-1/15/1/s/0 scandalabra_candelabra/scandalabra_unmasked_return_no_relationship/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "Yes, the other you was way too much energy to keep up with."
msgstr "Oui, l'autre toi demandait bien trop d'énergie pour suivre."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/c-1/15/g-0/4 scandalabra_candelabra/scandalabra_unmasked_return_no_relationship/0/c-1/15/c-0/11
msgctxt "Jon Wick"
msgid "Well then fuck!"
msgstr "Bon ben merde !"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/c-1/15/g-0/12 scandalabra_candelabra/scandalabra_unmasked_return_no_relationship/0/c-1/15/c-0/19
msgctxt "Jon Wick"
msgid "Come over anytime. We can screw like normal, yeah?"
msgstr "Passe quand tu veux. On pourra baiser comme avant, hein ?"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/c-1/15/g-0/23/0/s/0 scandalabra_candelabra/scandalabra_unmasked_return_no_relationship/0/c-1/15/c-0/30/0/s/0
msgctxt "Choix"
msgid "I'd love that."
msgstr "J'adorerais."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/c-1/15/g-0/23/1/s/0 scandalabra_candelabra/scandalabra_unmasked_return_no_relationship/0/c-1/15/c-0/30/1/s/0
msgctxt "Choix"
msgid "Uh, yeah sure."
msgstr "Euh, ouais, bien sûr."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/c-1/15/g-0/23/2/s/0 scandalabra_candelabra/scandalabra_unmasked_return_no_relationship/0/c-1/15/c-0/30/2/s/0
msgctxt "Choix"
msgid "Woah... just friends, dude."
msgstr "Wow... juste des amis, hein."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/c-1/15/g-0/23/c-2/7 scandalabra_candelabra/scandalabra_unmasked_return_no_relationship/0/c-1/15/c-0/30/c-2/7
msgctxt "Jon Wick"
msgid "Ah sure whatever."
msgstr "Ah ouais, comme tu veux."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/c-2/7/b/1 scandalabra_candelabra/scandalabra_unmasked_return_no_relationship/0/c-2/7/b/1
msgctxt "Jon Wick"
msgid "Oh really? And me asking you to kiss me wasn't creepy enough?"
msgstr "Ah ouais ? Et me demander de t'embrasser, c'était pas assez flippant ?"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/c-2/10/b/1 scandalabra_candelabra/scandalabra_unmasked_return_no_relationship/0/c-2/10/b/1
msgctxt "Jon Wick"
msgid "The whole bit where you psychoanalyzed me didn't? But the accent did?"
msgstr "Tout le passage où tu m'as psychanalysé, non ? Mais l'accent, si ?"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/rub/4 scandalabra_candelabra/scandalabra_unmasked_return_no_relationship/0/rub2/4
msgctxt "Jon Wick"
msgid "Rub it in why don't you."
msgstr "Enfonce le clou, vas-y."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/rub/12 scandalabra_candelabra/scandalabra_unmasked_return_no_relationship/0/rub2/12
msgctxt "Jon Wick"
msgid "I know just what to put in your dex entry."
msgstr "Je sais exactement quoi mettre dans ta fiche du dex."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/rub/71 scandalabra_candelabra/scandalabra_unmasked_return_no_relationship/0/rub2/71
msgctxt "Reggie"
msgid "Hate! He put hate in there! I saw it!"
msgstr "De la haine ! Il a mis de la haine ! Je l'ai vu !"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_has_relationship_return/0/rub/79 scandalabra_candelabra/scandalabra_unmasked_return_no_relationship/0/rub2/79
msgctxt "Reggie"
msgid "It always gives me a little shiver when that happens..."
msgstr "Ça me donne toujours un petit frisson quand ça arrive..."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_return_no_relationship/0/6
msgctxt "Jon Wick"
msgid "Well, we had fun didn't we?"
msgstr "Bon, on s'est bien amusés, non ?"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_return_no_relationship/0/14
msgctxt "Jon Wick"
msgid "You might not have been as much of a scandal-monger as I was, but we had our moments."
msgstr "Tu n'as peut-être pas autant aimé semer le scandale que moi, mais on a eu nos moments."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_return_no_relationship/0/22/s/0
msgctxt "Choix"
msgid "Actually, I really loved getting those scandals going. I miss the old you!"
msgstr "En fait, j'adorais lancer ces scandales. L'ancien toi me manque !"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_return_no_relationship/0/23/s/0
msgctxt "Choix"
msgid "I actually like you for who you are underneath."
msgstr "En fait, je t'aime bien pour ce que tu es au fond."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_return_no_relationship/0/c-0/11
msgctxt "Jon Wick"
msgid "You... you do?"
msgstr "Tu... vraiment ?"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_return_no_relationship/0/c-0/19
msgctxt "Jon Wick"
msgid "I suppose we could, just add my other identity as one more scandal to the pile?"
msgstr "Je suppose qu'on pourrait ajouter mon autre identité à la pile, comme un scandale de plus ?"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_return_no_relationship/0/c-0/27/0/s/0
msgctxt "Choix"
msgid "How else could we possibly go on?"
msgstr "Comment pourrions-nous continuer autrement ?"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_return_no_relationship/0/c-0/27/c-0/7
msgctxt "Jon Wick"
msgid "Ah wonderful!"
msgstr "Ah, merveilleux !"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_return_no_relationship/0/c-0/27/c-0/15
msgctxt "Narrator"
msgid "Scandalabra clears his throat, going through a few vocal exercises..."
msgstr "Scandalabra se râcle la gorge et enchaîne quelques exercices vocaux..."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_return_no_relationship/0/c-0/27/c-0/23
msgctxt "Jon Wick"
msgid "Ahem! La la la la la laaaa....."
msgstr "Hum ! La la la la laaaa....."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_return_no_relationship/0/c-0/27/c-0/38
msgctxt "Narrator"
msgid "And then his entire posture changes—he becomes the Scandalabra you first met once again."
msgstr "Puis toute sa posture change : il redevient le Scandalabra que vous avez rencontré au début."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_return_no_relationship/0/c-0/27/c-0/49 scandalabra_candelabra/scandalabra_post_scandal_friend_return/0/c-0/11 scandalabra_candelabra/scandalabra_post_scandal_love_return/0/c-0/11
msgctxt "Scandalabra"
msgid "Now, where were we...?"
msgstr "Voyons, où en étions-nous...?"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_return_no_relationship/0/c-0/27/c-0/57/0/s/0
msgctxt "Choix"
msgid "You were going to fall in love with me... I think...?"
msgstr "Tu allais tomber amoureux de moi... je crois...?"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_return_no_relationship/0/c-0/27/c-0/57/1/s/0
msgctxt "Choix"
msgid "We were gonna be best pals, Mr. Scandalabra."
msgstr "On allait être les meilleurs potes, monsieur Scandalabra."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_return_no_relationship/0/rub2/94/s/0
msgctxt "Choix"
msgid "How about instead of silly things like relationship status... we just Realize you?"
msgstr "Et si, au lieu de bêtises comme le statut de la relation... on te Réalisait, tout simplement ?"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_return_no_relationship/0/rub2/c-3/7
msgctxt "Jon Wick"
msgid "Oh!"
msgstr "Oh !"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_post_scandal_friend_return/0/0
msgctxt "Scandalabra"
msgid "My friend!"
msgstr "{{Mon ami|Mon amie|Mon ami·e}} !"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_post_scandal_friend_return/0/8 scandalabra_candelabra/scandalabra_post_scandal_love_return/0/11
msgctxt "Scandalabra"
msgid "Shall we take a look at that big dex of yours...?"
msgstr "Si nous jetions un oeil à ce grand dex qui est le tien...?"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_post_scandal_friend_return/0/16/s/0 scandalabra_candelabra/scandalabra_post_scandal_love_return/0/19/s/0
msgctxt "Choix"
msgid "Let's do it..."
msgstr "Allons-y..."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_post_scandal_friend_return/0/17/s/0 scandalabra_candelabra/scandalabra_post_scandal_love_return/0/20/s/0
msgctxt "Choix"
msgid "Oh, just stopping by!"
msgstr "Oh, je passais juste !"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_post_scandal_friend_return/0/18/s/0 scandalabra_candelabra/scandalabra_post_scandal_love_return/0/21/s/0
msgctxt "Choix"
msgid "I was thinking instead of Realizing you!"
msgstr "Je pensais plutôt te Réaliser !"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_post_scandal_friend_return/0/c-1/7 scandalabra_candelabra/scandalabra_post_scandal_love_return/0/c-1/7
msgctxt "Scandalabra"
msgid "Stop by anytime! Don't forget the tea!"
msgstr "Passe quand tu veux ! N'oublie pas le thé !"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_post_scandal_friend_return/0/c-2/7 scandalabra_candelabra/scandalabra_post_scandal_love_return/0/c-2/7
msgctxt "Scandalabra"
msgid "Oh!"
msgstr "Oh !"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_post_scandal_love_return/0/0
msgctxt "Scandalabra"
msgid "My lover!"
msgstr "Mon amour !"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_hate_return/0/6
msgctxt "Jon Wick"
msgid "So you know my secret. We dislike each other fiercely."
msgstr "Alors tu connais mon secret. On se déteste férocement."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_hate_return/0/14
msgctxt "Jon Wick"
msgid "Why come back? I ain't doing anything wrong."
msgstr "Pourquoi revenir ? Je fais rien de mal."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_hate_return/0/22/s/0
msgctxt "Choix"
msgid "I just wanted to see you squirm, you toad."
msgstr "Je voulais juste te voir te tortiller, espèce de crapaud."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_hate_return/0/c-0/7
msgctxt "Jon Wick"
msgid "Well, you got it."
msgstr "Eh bien, c'est réussi."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_hate_return/0/c-0/15
msgctxt "Jon Wick"
msgid "Squirm squirm squirm."
msgstr "Tortille tortille tortille."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_hate_return/0/c-0/26
msgctxt "Jon Wick"
msgid "Happy?"
msgstr "Content ?"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_hate_return_2/0/0
msgctxt "Jon Wick"
msgid "I've been doing great on my own, ya know."
msgstr "Je me débrouille très bien tout seul, tu sais."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_hate_return_2/0/11/b/1
msgctxt "Jon Wick"
msgid "Me and Abel, we've been chatting a lot. Talking about you."
msgstr "Abel et moi, on a beaucoup discuté. De toi."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_unmasked_hate_return_2/0/14
msgctxt "Jon Wick"
msgid "No need to tell you about it though."
msgstr "Pas besoin de te raconter, cela dit."

# Traduction IA – à relire
