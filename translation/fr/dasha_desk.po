msgstr "Ce rendez-vous imaginaire est terminé."

# Traduction IA – à relire
#: dasha_desk/the_bowling_alley/0/g-1/c-8/29/c-1/7
msgctxt "Dasha"
msgid "I do not need this!"
msgstr "Je n'ai pas besoin de ça !"

# Traduction IA – à relire
#: dasha_desk/the_bowling_alley/0/g-1/c-8/29/c-1/15
msgctxt "Dasha"
msgid "You are focused on toes when you are supposed to sweep me off my feet!"
msgstr "Tu te concentres sur la pointe des pieds alors que tu es censé{{|e|·e}} me faire perdre pied !"

# Traduction IA – à relire
#: dasha_desk/the_bowling_alley/0/g-1/c-8/29/c-1/23
