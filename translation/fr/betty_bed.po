#: betty_bed/betty_hateending/0/c-1/15
msgctxt "Betty"
msgid "Well you said enough!"
msgstr ""

#: betty_bed/betty_hateending/0/c-2/7
msgctxt "Betty"
msgid "<i>I'M</i> nasty!?"
