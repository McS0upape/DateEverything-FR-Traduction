msgctxt "Beverly"
msgid "Hmph!!"
msgstr ""

#: beverly_beverage/beverly_hate_return/0/c-1/50/c-0/15
msgctxt "Beverly"
msgid "I’d advertise that you’re a JERK so everyone else would be on the lookout, but apparently NO ONE CARES ENOUGH TO LISTEN TO ME!"
