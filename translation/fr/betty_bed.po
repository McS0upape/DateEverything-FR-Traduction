msgstr ""

#: betty_bed/betty_hateending/0/g-1/18/s/0
msgctxt "Choix"
msgid "<i>Wait to see what she does.</i>"
msgstr ""

#: betty_bed/betty_hateending/0/g-1/c-6/10
msgctxt "Narrator"
msgid "You slip past her, and to your surprise she doesn't follow after you. She doesn't even turn around."
