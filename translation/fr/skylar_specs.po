#: skylar_specs/skylar_final_love_reggie/0/g-3/13/s/0
msgctxt "Choix"
msgid "Selene."
msgstr ""

#: skylar_specs/skylar_final_love_reggie/0/g-3/14/s/0
msgctxt "Choix"
msgid "Luna."
msgstr ""

#: skylar_specs/skylar_final_love_reggie/0/g-3/15/s/0
msgctxt "Choix"
msgid "Celestiana."
msgstr ""

#: skylar_specs/skylar_final_love_reggie/0/g-3/16/s/0
msgctxt "Choix"
msgid "Scrouf."
msgstr ""

#: skylar_specs/skylar_final_love_reggie/0/g-3/c-9/7
msgctxt "Reggie"
msgid "HAH! Wrong!"
msgstr ""

#: skylar_specs/skylar_final_love_reggie/0/g-3/c-10/7
msgctxt "Reggie"
msgid "I said <i>not</i> a character! Wrong!"
