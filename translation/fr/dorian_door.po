msgid "Yes, I have what it takes."
msgstr "Oui, j'ai ce qu'il faut."

# Traduction IA – à relire
#: dorian_door/dorian_realize_join/0/18/s/0 dorian_door/dorian_realize_return/0/18/s/0 dorian_door/dorian_realize_join_front/0/18/s/0 dorian_door/dorian_realize_return_front/0/18/s/0 dorian_door/dorian_realize_join_back/0/26/s/0 dorian_door/dorian_realize_return_back/0/18/s/0 dorian_door/dorian_realize_join_tiny/0/18/s/0 dorian_door/dorian_realize_return_tiny/0/18/s/0 dorian_door/dorian_realize_join_trap/0/18/s/0 dorian_door/dorian_realize_return_trap/0/18/s/0
msgctxt "Choix"
msgid "No, not just yet."
msgstr "Non, pas encore."

# Traduction IA – à relire
#: dorian_door/dorian_realize_join/0/c-1/10
msgctxt "Dorian"
msgid "Fine by me."
msgstr "Ça me va."

# Traduction IA – à relire
#: dorian_door/dorian_realize_return/0/0
msgctxt "Dorian"
msgid "This time you have what you need?"
msgstr "Cette fois, tu as ce qu'il te faut ?"

# Traduction IA – à relire
#: dorian_door/dorian_realize_return/0/17/s/0 dorian_door/dorian_realize_return_front/0/17/s/0 dorian_door/dorian_realize_return_back/0/17/s/0 dorian_door/dorian_realize_return_tiny/0/17/s/0 dorian_door/dorian_realize_return_trap/0/17/s/0
