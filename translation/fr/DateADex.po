msgid "Achieve a Love ending with Tyrell."
msgstr "Obtiens une fin Amour avec Tyrell."

# Traduction IA – à relire
#: DateADex/tyrell_dex_entry/79
msgctxt "Tag Date-A-Dex"
msgid "Towel Buddy - Monkey Form"
msgstr "Copain-serviette : forme singe"

# Traduction IA – à relire
#: DateADex/tyrell_dex_entry/82
