#: mitchell_food/mitchell_realize_join/0/9/s/0
msgctxt "Choix"
msgid "Oui"
msgstr ""

#: mitchell_food/mitchell_realize_join/0/g-0/0
msgctxt "Mitchell"
msgid "And Tokyo?"
