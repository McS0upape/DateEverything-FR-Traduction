#: dorian_door/bathroom_bedroom_third/0/0
msgctxt "Narrator"
msgid "Dorian gives you an appraising look, stepping aside and gesturing to the bathroom."
msgstr ""

#: dorian_door/bathroom_bedroom_third/0/8/b/1
msgctxt "Dorian"
msgid "Darling... you appear full."
msgstr ""

#: dorian_door/bathroom_bedroom_third/0/11
msgctxt "Dorian"
msgid "Fancy a tinkle?"
msgstr ""

#: dorian_door/bathroom_bedroom_third/0/19
msgctxt "Dorian"
msgid "Right this way."
