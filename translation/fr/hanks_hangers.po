#: hanks_hangers/fifth_encounter/0/c-1/35/1/s/0
msgctxt "Choix"
msgid "SICK!"
msgstr "DE OUF !"

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/c-1/35/c-0/7
msgctxt "Hanks"
msgid "AHAHAHHAHA!"
msgstr "AHAHAHHAHA !"

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/c-1/35/c-1/7
msgctxt "Hanks"
msgid "SICK!"
msgstr "DE OUF !"

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-0/0/s/0
msgctxt "Choix"
msgid "So, why are you in such a good mood?"
msgstr "Alors, pourquoi vous êtes de si bonne humeur ?"

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-0/1/s/0
msgctxt "Choix"
msgid "This is some immense energy. What's all the buzz about?"
msgstr "Y a une énergie énorme. C'est quoi, tout ce bruit ?"

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-1/0
msgctxt "Hanks"
msgid "WING SUITS, WING SUITS, WING SUITS!!!"
msgstr "WINGSUITS, WINGSUITS, WINGSUITS !!!"

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-1/23/s/0
msgctxt "Choix"
msgid "No way! That's so dangerous!"
msgstr "Pas possible ! C'est tellement dangereux !"

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-1/24/s/0
msgctxt "Choix"
msgid "Is that the one where you turn yourself into a nylon flying squirrel?"
msgstr "C'est celui où on se transforme en écureuil volant en nylon ?"

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-1/c-5/7
msgctxt "Hank 5"
msgid "Haha, you're so funny! But yeah, basically."
msgstr "Haha, t'es trop drôle ! Mais ouais, en gros."

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-1/c-5/15
msgctxt "Hank 2"
msgid "It's an advanced form of skydiving!"
msgstr "C'est une forme avancée de parachutisme !"

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-1/c-5/23
msgctxt "Hank 4"
msgid "You still wear the chute..."
msgstr "On porte toujours le parachute..."

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-1/c-5/31
msgctxt "Hank 1"
msgid "But you also wear THE SUIT."
msgstr "Mais on porte aussi LA COMBI."

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-1/c-5/42
msgctxt "Hank 3"
msgid "It creates a ton of drag and turns you into a human glider."
msgstr "Ça crée une tonne de traînée et ça te transforme en deltaplane humain."

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-1/c-5/50
msgctxt "Hank 5"
msgid "Ever had a really amazing dream where you're flying? It's like that, but maybe even better."
msgstr "T'as déjà fait un rêve génial où tu voles ? C'est comme ça, mais peut-être encore mieux."

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-1/c-5/58/0/s/0
msgctxt "Choix"
msgid "Sounds more like a nightmare."
msgstr "Ça ressemble plus à un cauchemar."

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-1/c-5/58/1/s/0
msgctxt "Choix"
msgid "Sounds magical."
msgstr "Ça a l'air magique."

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-1/c-5/58/2/s/0
msgctxt "Choix"
msgid "Sounds intense."
msgstr "Ça a l'air intense."

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-1/c-5/58/3/s/0
msgctxt "Choix"
msgid "Sounds EPIC."
msgstr "Ça a l'air ÉPIQUE."

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-1/c-5/58/c-0/7
msgctxt "Hanks"
msgid "NO WAY!"
msgstr "PAS POSSIBLE !"

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-2/20/s/0
msgctxt "Choix"
msgid "Heck yeah!! You guys do this all the time, right?"
msgstr "Carrément !! Vous faites ça tout le temps, non ?"

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-2/21/s/0
msgctxt "Choix"
msgid "I'm not so sure, but I suppose if you guys are experts at it..."
msgstr "Je suis pas si {{sûr|sûre|sûr·e}}, mais si vous êtes des experts..."

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-2/c-6/7 hanks_hangers/fifth_encounter/0/g-2/c-7/7
msgctxt "Hanks"
msgid "Nope!"
msgstr "Non !"

# Traduction IA – à relire
#: hanks_hangers/fifth_encounter/0/g-2/c-6/30/0/s/0 hanks_hangers/fifth_encounter/0/g-2/c-7/30/0/s/0
