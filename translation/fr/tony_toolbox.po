# Traduction IA – à relire
#: tony_toolbox/1
msgctxt "Tag Nom d'objet (MAJUSCULES)"
msgid "TOOLBOX"
msgstr "BOÎTE À OUTILS"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/6
msgctxt "Narrator"
msgid "The handsome construction worker currently invading your space makes you feel as though you've accidentally wandered into an active building site."
msgstr "Le séduisant ouvrier du bâtiment qui envahit actuellement votre espace vous donne l'impression d'avoir atterri par erreur sur un chantier en pleine activité."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/14
msgctxt "Narrator"
msgid "He holds up his hands to stop you from going any further, glaring at you as he looks you up and down."
msgstr "Il lève les mains pour vous empêcher d'avancer et vous dévisage de haut en bas d'un oeil mauvais."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/22
msgctxt "Tony"
msgid "Hey, whoa whoa! Where do you think you're going?"
msgstr "Hé, houlà houlà ! Tu vas où comme ça ?"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/33/s/0
msgctxt "Choix"
msgid "This is my house!"
msgstr "C'est chez moi, ici !"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/34/s/0
msgctxt "Choix"
msgid "Closet?"
msgstr "Dans le placard ?"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/35/s/0
msgctxt "Choix"
msgid "To my next lover..."
msgstr "Vers mon prochain amant..."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/c-2/7
msgctxt "Tony"
msgid "Eh?"
msgstr "Hein ?"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-0/0
msgctxt "Tony"
msgid "I can't let you in here without the proper PPE."
msgstr "Je peux pas te laisser entrer sans les EPI réglementaires."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-0/11
msgctxt "Narrator"
msgid "Tony puts his fingers to his mouth and whistles."
msgstr "Tony porte ses doigts à sa bouche et siffle."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-0/19
msgctxt "Tony"
msgid "Ayo! Get 'em outta here."
msgstr "Ohé ! Virez-moi ça d'ici."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-0/27/s/0
msgctxt "Choix"
msgid "Hang on a minute. PP-what?"
msgstr "Une seconde. Les E-quoi ?"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-0/c-3/7
msgctxt "Tony"
msgid "Your hard hat, your boots, your hi-viz vest..."
msgstr "Ton casque, tes bottes, ton gilet jaune..."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-0/c-3/15
msgctxt "Tony"
msgid "C'mon, this is a job site."
msgstr "Allez, c'est un chantier ici."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-0/c-3/23/0/s/0
msgctxt "Choix"
msgid "Except it's the breaker box closet..."
msgstr "Sauf que c'est le placard du tableau électrique..."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-0/c-3/23/c-0/7
msgctxt "Tony"
msgid "Don't even get me started."
msgstr "Me lance pas là-dessus."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-0/c-3/23/c-0/15
msgctxt "Tony"
msgid "Not when Johnny Wannabe next door's got a whole garage to himself!"
msgstr "Pas quand ce Jojo le Prétentieux d'à côté a tout un garage pour lui tout seul !"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-0/c-3/23/c-0/23
msgctxt "Tony"
msgid "I'm talking wall-to-wall pegboard, six kinds of saws and he's got this 12\" auger — man, those things go deep."
msgstr "Je te parle de panneaux perforés du sol au plafond, de six sortes de scies, et d'un foret de 30 centimètres... mec, ces trucs-là, ça pénètre en profondeur."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-0/c-3/23/c-0/31/0/s/0
msgctxt "Choix"
msgid "Someone's hot and bothered."
msgstr "Quelqu'un a des bouffées de chaleur."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-0/c-3/23/c-0/31/1/s/0
msgctxt "Choix"
msgid "That lucky bastard."
msgstr "Quel veinard, ce salaud."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-0/c-3/23/c-0/31/2/s/0
msgctxt "Choix"
msgid "An auger — that's like a root vegetable, right?"
msgstr "Un foret ? Genre, avec plein d'arbres ?"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-0/c-3/23/c-0/31/c-0/7
msgctxt "Tony"
msgid "Yeah, well well, what can I say. Professional jealousy."
msgstr "Ouais, bah, qu'est-ce que tu veux que j'te dise. La jalousie professionnelle."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-0/c-3/23/c-0/31/c-1/7
msgctxt "Tony"
msgid "Man, you're tellin' me, one percenters, right?"
msgstr "Mec, tu m'étonnes, les 1 %, hein ?"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-0/c-3/23/c-0/31/c-2/7
msgctxt "Tony"
msgid "A veg-... WHAT?"
msgstr "Des arb-... QUOI ?"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-0/c-3/23/c-0/31/c-2/15
msgctxt "Tony"
msgid "You don't know nuthin', do ya?"
msgstr "Tu y connais rien, hein ?"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-1/0
msgctxt "Tony"
msgid "Look, all's I'm saying is I want a little more space too."
msgstr "Écoute, tout ce que j'dis, c'est que moi aussi, j'veux un peu plus de place."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-1/8
msgctxt "Tony"
msgid "Y'know, for entertaining."
msgstr "Tu vois, pour recevoir."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-1/16/s/0
msgctxt "Choix"
msgid "Host a lot of cocktail parties?"
msgstr "Tu organises beaucoup de cocktails ?"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-1/c-4/7
msgctxt "Tony"
msgid "I'm a popular tool."
msgstr "Je suis un outil très demandé."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-1/c-4/15
msgctxt "Tony"
msgid "It's always \"Hi Tony this\" or \"Thanks Tony that\" or \"Ton', my ass is leaking.\""
msgstr "C'est toujours « Salut Tony, ceci » ou « Merci Tony, cela » ou « Ton', j'ai une fuite au cul »."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-1/c-4/23/0/s/0
msgctxt "Choix"
msgid "Please don't tell me whose..."
msgstr "Me dis pas à qui..."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-1/c-4/23/c-0/7
msgctxt "Tony"
msgid "Jean Loo."
msgstr "Jean Loo."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-1/c-4/23/c-0/15
msgctxt "Tony"
msgid "Incontinence."
msgstr "Incontinence."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-1/c-4/23/c-0/23
msgctxt "Tony"
msgid "You didn't hear it from me though. HIPAA."
msgstr "Mais t'as rien entendu de moi, hein. Secret médical."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-1/c-4/23/c-0/31/0/s/0
msgctxt "Choix"
msgid "That's not how HIPAA works."
msgstr "Le secret médical, ça marche pas comme ça."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-1/c-4/23/c-0/31/1/s/0
msgctxt "Choix"
msgid "What's that?"
msgstr "C'est quoi, ça ?"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-1/c-4/23/c-0/31/c-1/7
msgctxt "Tony"
msgid "It's when your ass leaks."
msgstr "C'est quand t'as une fuite au cul."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-1/c-4/23/c-0/31/c-1/15
msgctxt "Tony"
msgid "My fault for using $10 words like 'incontinence.'"
msgstr "Ma faute, j'utilise des mots à dix balles comme « incontinence »."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/0
msgctxt "Tony"
msgid "Anyways, objects need somewhere bigger than this to come see me for what ails 'em."
msgstr "Bref, les objets ont besoin d'un endroit plus grand pour venir me voir quand ils ont un souci."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/8
msgctxt "Tony"
msgid "And uhhh... sometimes ol' Ton' might also wanna have \"special company\" over."
msgstr "Et euh... des fois, ce vieux Ton' voudrait aussi recevoir de la « compagnie spéciale »."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/16
msgctxt "Tony"
msgid "...you know what I'm talking about, huh?"
msgstr "...tu vois de quoi j'parle, hein ?"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/24
msgctxt "Narrator"
msgid "Tony nods, grinning smugly at you."
msgstr "Tony hoche la tête en vous adressant un sourire suffisant."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/32/s/0
msgctxt "Choix"
msgid "I have no idea what you're talking about, actually."
msgstr "En fait, je vois pas du tout de quoi tu parles."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/33/s/0
msgctxt "Choix"
msgid "Special company makes me break out in hives."
msgstr "La compagnie spéciale me donne de l'urticaire."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/34/s/0
msgctxt "Choix"
msgid "Hell yes I do."
msgstr "Et comment que je vois !"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/35/s/0
msgctxt "Choix"
msgid "Hell yeah!"
msgstr "Ouais, carrément !"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/36/s/0
msgctxt "Choix"
msgid "I guess."
msgstr "Je suppose."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-5/7
msgctxt "Tony"
msgid "Y'know... when you wanna get your screws in nice 'n tight."
msgstr "Tu vois... quand tu veux visser bien serré."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-5/15
msgctxt "Tony"
msgid "Maybe you call someone over, do a lil bakin'... fill their cannoli, you know."
msgstr "Peut-être que t'appelles quelqu'un, tu fais une p'tite pâtisserie... tu fourres son cannolo, tu vois."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-5/23/0/s/0
msgctxt "Choix"
msgid "You're making desserts?"
msgstr "Tu fais des desserts ?"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-5/23/1/s/0
msgctxt "Choix"
msgid "Your innuendo is terrible."
msgstr "Ton allusion est nulle."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-5/23/2/s/0
msgctxt "Choix"
msgid "Do hands count as special company?"
msgstr "Les mains, ça compte comme compagnie spéciale ?"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-5/23/c-0/7
msgctxt "Tony"
msgid "Oh for the love of... talkin' about smashin'! Bangin'! SEX!"
msgstr "Oh, pour l'amour du... je parle de se la jouer ! De tringler ! DU SEXE !"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-5/23/c-0/15/0/s/0
msgctxt "Choix"
msgid "Just say that next time... but no. Not doing any of that these days."
msgstr "Dis-le comme ça la prochaine fois... mais non. Je fais rien de tout ça en ce moment."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-5/23/c-1/7
msgctxt "Tony"
msgid "So's your attitude."
msgstr "Ton attitude non plus."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-5/23/c-2/7
msgctxt "Tony"
msgid "Your hands or someone else's?"
msgstr "Tes mains ou celles de quelqu'un d'autre ?"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-5/23/c-2/15/0/s/0
msgctxt "Choix"
msgid "Mine...?"
msgstr "Les miennes... ?"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-5/23/c-2/15/1/s/0
msgctxt "Choix"
msgid "Someone else's."
msgstr "Celles de quelqu'un d'autre."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-5/23/c-2/15/c-0/7
msgctxt "Narrator"
msgid "Tony places a hand on your shoulder, looking you squarely in the eyes."
msgstr "Tony pose une main sur votre épaule et vous regarde droit dans les yeux."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-5/23/c-2/15/c-0/15
msgctxt "Tony"
msgid "Listen pal, I know you been datin' five-finger fanny since middle school."
msgstr "Écoute-moi bien, je sais que tu fréquentes Madame Cinq Doigts depuis le collège."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-5/23/c-2/15/c-0/23
msgctxt "Tony"
msgid "But you gotta dream bigger."
msgstr "Mais faut voir plus grand."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-5/23/c-2/15/c-1/7
msgctxt "Tony"
msgid "Uh... well yeah. Any part'a somebody else is special company... but maybe you keep 'em in one piece, eh?"
msgstr "Euh... ouais. N'importe quelle partie de quelqu'un d'autre, c'est de la compagnie spéciale... mais peut-être que tu la gardes en un seul morceau, hein ?"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-6/7
msgctxt "Tony"
msgid "Oooo, you should really tell your partners."
msgstr "Ooooh, faudrait vraiment prévenir tes partenaires."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-6/15
msgctxt "Tony"
msgid "It's only fair that they know what they're gettin' themselves into."
msgstr "C'est juste normal qu'ils sachent dans quoi ils mettent les pieds."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-6/23/0/s/0
msgctxt "Choix"
msgid "Not <i>those</i> kind of hives!"
msgstr "Pas <i>ce</i> genre d'urticaire !"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-6/23/c-0/7
msgctxt "Tony"
msgid "Oh, hey. Oh, okay. Sorry."
msgstr "Oh, hé. Oh, d'accord. Pardon."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-6/23/c-0/15
msgctxt "Tony"
msgid "For the record ain't nothing wrong with \"those kind\" either."
msgstr "Pour info, y a rien de mal à « ce genre » non plus."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-6/23/c-0/23
msgctxt "Tony"
msgid "I mean, it just goes to show you've lived a little, am I right? Heh. Bada-bing. Heh heh. I'm not saying anything about myself."
msgstr "Je veux dire, ça prouve que t'as un peu vécu, non ? Hé hé. Ba-da-boum. Hé hé hé. Je dis rien sur moi, hein."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-7/7 tony_toolbox/second_encounter/0/g-1/c-6/7
msgctxt "Tony"
msgid "You know what I'm TALKING about!"
msgstr "Tu sais de quoi j'PARLE !"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-3/0 tony_toolbox/second_encounter/0/g-3/0
msgctxt "Tony"
msgid "You KNOW what I'm talking about!"
msgstr "Tu SAIS de quoi j'parle !"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-3/11/s/0
msgctxt "Choix"
msgid "You KNOW it buddy! AWOOOOO!"
msgstr "Tu l'as dit, mon pote ! AWOOOOO !"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-3/12/s/0
msgctxt "Choix"
msgid "Sure do."
msgstr "Et comment."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-4/0 tony_toolbox/second_encounter/0/g-4/0
msgctxt "Tony"
msgid "YOU know what I'm talking about!"
msgstr "TU sais de quoi j'parle !"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-4/11/s/0
msgctxt "Choix"
msgid "Yeah."
msgstr "Ouais."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-4/12/s/0
msgctxt "Choix"
msgid "Oh you know it you know it you know it!"
msgstr "Oh que oui, que oui, que oui !"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-5/0 tony_toolbox/second_encounter/0/g-5/0
msgctxt "Tony"
msgid "You know what I'M talking about!"
msgstr "Tu sais de quoi J'parle !"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-5/11/s/0
msgctxt "Choix"
msgid "Mhm."
msgstr "Mhm."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-5/12/s/0
msgctxt "Choix"
msgid "All day baby all day!"
msgstr "Toute la journée, mon grand, toute la journée !"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-6/0
msgctxt "Tony"
msgid "You know what I'm talking ABOUT!!! Whoo!"
msgstr "Tu sais de quoi j'PARLE !!! Ouhou !"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-6/11/s/0
msgctxt "Choix"
msgid "I KNOW WHAT YOU'RE TALKIN' ABOUT!"
msgstr "JE SAIS DE QUOI TU PARLES !"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-6/c-16/13
msgctxt "Narrator"
msgid "Tony nods at you, you nod at him, and you nod at each other, both entirely pleased that you each KNOW what the OTHER is TALKING ABOUT."
msgstr "Tony vous fait un signe de tête, vous lui en faites un, et vous hochez la tête l'un vers l'autre, parfaitement ravis de SAVOIR chacun de quoi l'AUTRE PARLE."

# Traduction IA – à relire
#: tony_toolbox/tony_talking/0/0
msgctxt "Tony"
msgid "So you get it! I need more space!"
msgstr "Donc t'as compris ! Il me faut plus de place !"

# Traduction IA – à relire
#: tony_toolbox/tony_talking/0/8
msgctxt "Tony"
msgid "Space for all sorts a things I may or may not be insinuatin'."
msgstr "De la place pour toutes sortes de trucs que je suggère peut-être, ou peut-être pas."

# Traduction IA – à relire
#: tony_toolbox/tony_talking/0/16/s/0
msgctxt "Choix"
msgid "Makes sense."
msgstr "C'est logique."

# Traduction IA – à relire
#: tony_toolbox/tony_talking/0/17/s/0
msgctxt "Choix"
msgid "What other things do you like to insinuate...?"
msgstr "Quelles autres choses aimes-tu suggérer... ?"

# Traduction IA – à relire
#: tony_toolbox/tony_talking/0/c-0/7
msgctxt "Tony"
msgid "I got a pitch for ya."
msgstr "J'ai un plan pour toi."

# Traduction IA – à relire
#: tony_toolbox/tony_talking/0/c-1/7
msgctxt "Tony"
msgid "Relax tiger, it's Tony time. I gotta pitch for ya."
msgstr "Détends-toi, c'est l'heure de Tony. J'ai un plan pour toi."

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/0
msgctxt "Tony"
msgid "So, you're telling me you don't get out there roh-mantically?"
msgstr "Alors, tu me dis que tu sors pas côté ro-mantique ?"

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/8/s/0
msgctxt "Choix"
msgid "Nope."
msgstr "Non."

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/9/s/0
msgctxt "Choix"
msgid "I have, but it's complicated."
msgstr "Si, mais c'est compliqué."

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/10/s/0
msgctxt "Choix"
msgid "Why would I? It's bleak enough out there as it is."
msgstr "Pourquoi je le ferais ? C'est déjà assez glauque dehors."

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/c-0/7
msgctxt "Tony"
msgid "Probably has to do with the look of this place."
msgstr "Ça vient probablement de l'allure de cette baraque."

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/c-1/7
msgctxt "Tony"
msgid "Ol' Tony knows complicated. But you could probably pull more partners with better digs."
msgstr "Ce vieux Tony s'y connaît en compliqué. Mais tu pourrais sûrement attirer plus de partenaires avec un meilleur logis."

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/c-2/7
msgctxt "Tony"
msgid "Yeah you would have that outlook with a place like this."
msgstr "Ouais, forcément que t'aurais cette vision-là avec un endroit pareil."

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/0/s/0
msgctxt "Choix"
msgid "What does that mean?"
msgstr "Ça veut dire quoi ?"

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/7
msgctxt "Tony"
msgid "Well, it doesn't exactly scream Randy Andy, does it?"
msgstr "Bah, ça évoque pas franchement Dédé la Braise, hein ?"

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/15
msgctxt "Tony"
msgid "A roh-mantic prospect wants to know that <i>you</i> know your way around a toolbox."
msgstr "Un prétendant ro-mantique veut savoir que <i>tu</i> sais te servir d'une boîte à outils."

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/23
msgctxt "Tony"
msgid "That you're good with your hands."
msgstr "Que t'es doué de tes mains."

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/31
msgctxt "Tony"
msgid "A fixer."
msgstr "Un réparateur."

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/39
msgctxt "Tony"
msgid "And this place ... uhhh ... it doesn't exactly show it."
msgstr "Et cet endroit... euh... ça se voit pas trop."

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/47
msgctxt "Tony"
msgid "You know what I mean?"
msgstr "Tu vois ce que j'veux dire ?"

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/55
msgctxt "Tony"
msgid "No bells, no whistles, nothing."
msgstr "Pas de fioritures, rien."

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/63/0/s/0
msgctxt "Choix"
msgid "Okay genius. What do you have in mind?"
msgstr "Très bien, génie. Qu'est-ce que tu as en tête ?"

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/63/1/s/0
msgctxt "Choix"
msgid "I don't know. I think this place is actually ok."
msgstr "Je sais pas. Je trouve que cet endroit est plutôt bien, en fait."

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/63/2/s/0
msgctxt "Choix"
msgid "I'm pretty handy. I can do it myself."
msgstr "Je me débrouille plutôt bien en bricolage. Je peux le faire moi-même."

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/63/c-1/7
msgctxt "Tony"
msgid "How about you just hear my pitch. Alright?"
msgstr "Si tu écoutais juste mon plan ? D'accord ?"

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/63/c-2/7
msgctxt "Tony"
msgid "If it goes anything like that bird bath you tried to build I can't wait to see it."
msgstr "Si c'est comme ce bain d'oiseaux que t'as essayé de construire, j'ai hâte de voir ça."

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/63/c-2/15/0/s/0
msgctxt "Choix"
msgid "Lots of architecture leans to the side!"
msgstr "Plein d'architecture penche d'un côté !"

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/63/c-2/15/1/s/0
msgctxt "Choix"
msgid "It's not my fault the birds flew in before the cement dried!"
msgstr "C'est pas ma faute si les oiseaux sont entrés avant que le ciment sèche !"

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/63/c-2/15/2/s/0
msgctxt "Choix"
msgid "The basin was supposed to leak! It was the artist's statement on the fleeting nature of WATER!"
msgstr "La vasque était censée fuir ! C'était la déclaration de l'artiste sur la nature éphémère de l'EAU !"

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/63/c-2/15/c-0/7
msgctxt "Tony"
msgid "Yeah, and lots of architecture gets condemned and demolished."
msgstr "Ouais, et plein d'architecture est condamnée et démolie."

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/63/c-2/15/c-0/15
msgctxt "Tony"
msgid "That what you want? You want a wrecking ball should come flyin' in here?"
msgstr "C'est ça que tu veux ? Tu veux qu'une boule de démolition arrive en volant ici ?"

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/63/c-2/15/c-1/7
msgctxt "Tony"
msgid "Yeah, I'd argue it was exactly your fault the birds flew in before the cement dried, but let's leave the past in the past, eh?"
msgstr "Ouais, je dirais que c'était exactement ta faute si les oiseaux sont entrés avant que le ciment sèche, mais laissons le passé où il est, hein ?"

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/63/c-2/15/c-2/7
msgctxt "Tony"
msgid "This ain't an art gallery, and I ain't an art dealer—so I ain't buyin' it."
msgstr "C'est pas une galerie d'art ici, et je suis pas marchand d'art, donc j'achète pas."

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-1/0
msgctxt "Tony"
msgid "You just hear me out, ok?"
msgstr "Écoute-moi juste jusqu'au bout, ok ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch1/0/3
msgctxt "Tony"
msgid "A drawbridge."
msgstr "Un pont-levis."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch1/0/14/s/0
msgctxt "Choix"
msgid "Like from ye olden times?"
msgstr "Comme au bon vieux temps ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch1/0/c-0/7
msgctxt "Tony"
msgid "Think about it."
msgstr "Réfléchis-y."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch1/0/c-0/15
msgctxt "Tony"
msgid "Your lover pulls up for a date and the drawbridge lowers to let 'em in."
msgstr "Ton amant arrive pour un rencard et le pont-levis s'abaisse pour le laisser entrer."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch1/0/c-0/23
msgctxt "Tony"
msgid "Pretty freakin' impressive, huh?"
msgstr "Sacrément impressionnant, hein ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch1/0/c-0/31/0/s/0
msgctxt "Choix"
msgid "Back up. You know how to do that?"
msgstr "Attends. Tu sais faire ça ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch1/0/c-0/31/1/s/0
msgctxt "Choix"
msgid "That is impressive..."
msgstr "C'est impressionnant..."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch1/0/c-0/31/c-0/7
msgctxt "Tony"
msgid "Oh, yeah. Got everything I need on hand."
msgstr "Oh, ouais. J'ai tout ce qu'il me faut sous la main."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch1/0/c-0/31/c-1/7
msgctxt "Tony"
msgid "Damn straight."
msgstr "Putain, ouais."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch1/0/c-0/31/c-1/15
msgctxt "Tony"
msgid "...is how I would build it using my tools. No curves in this drawbridge."
msgstr "...c'est comme ça que je le construirais avec mes outils. Pas de courbes dans ce pont-levis."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch1/0/g-0/0
msgctxt "Tony"
msgid "The flat lookin' screwdriver, the pointy, star-shaped one, a hammer and the spearmint gum you've had in here since April."
msgstr "Le tournevis plat, le pointu en forme d'étoile, un marteau et le chewing-gum à la menthe verte que t'as laissé là depuis avril."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch1/0/g-0/8/s/0
msgctxt "Choix"
msgid "Please tell me there's a moat."
msgstr "Dis-moi qu'il y a des douves."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch1/0/g-0/9/s/0
msgctxt "Choix"
msgid "Yeah... that could definitely be a thing. Very death trappy."
msgstr "Ouais... ça pourrait carrément être un truc. Très piège mortel."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch1/0/g-0/10/s/0
msgctxt "Choix"
msgid "I don't know much about architecture, but I think this might be a bit beyond the capabilities of a toolbox."
msgstr "Je m'y connais pas trop en architecture, mais je crois que ça dépasse un peu les capacités d'une boîte à outils."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch1/0/g-0/c-1/13
msgctxt "Tony"
msgid "Absolutely! See, you get it."
msgstr "Absolument ! Tu vois, t'as compris."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch1/0/g-0/c-1/21
msgctxt "Tony"
msgid "Which leads into my next idea:"
msgstr "Ce qui nous amène à mon idée suivante :"

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch1/0/g-0/c-2/13
msgctxt "Tony"
msgid "Alright. Alright. You like it but you don't love it. I get that. How about this —"
msgstr "Bon. Bon. Ça te plaît mais t'adhères pas. J'ai compris. Et si on faisait ça —"

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch1/0/g-0/c-3/7
msgctxt "Tony"
msgid "I get it. You're a tough customer, but there's no need to get personal. At least hear the rest of my pitch, huh."
msgstr "J'ai compris. T'es un client difficile, mais pas besoin de se froisser. Écoute au moins la suite de mon plan, hein."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/3
msgctxt "Tony"
msgid "<i>Ahem</i>"
msgstr "<i>Hum hum</i>"

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/14
msgctxt "Tony"
msgid "Indoor slide."
msgstr "Toboggan d'intérieur."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/25
msgctxt "Tony"
msgid "We get rid of the stairs, replace them with a slide."
msgstr "On vire les escaliers, on les remplace par un toboggan."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/33
msgctxt "Tony"
msgid "Great to travel from upstairs to downstairs."
msgstr "Génial pour aller de l'étage au rez-de-chaussée."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/41/s/0
msgctxt "Choix"
msgid "What about going from downstairs to upstairs?"
msgstr "Et pour aller du rez-de-chaussée à l'étage ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/42/s/0
msgctxt "Choix"
msgid "What about Stella?"
msgstr "Et Stella ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-0/7
msgctxt "Tony"
msgid "Way ahead of you."
msgstr "J'ai déjà prévu le coup."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-0/15
msgctxt "Tony"
msgid "All us construction guys do this. It's an industry standard."
msgstr "Tous les gars du bâtiment font ça. C'est la norme du secteur."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-0/23
msgctxt "Tony"
msgid "You ready?"
msgstr "On y va ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-0/31/0/s/0
msgctxt "Choix"
msgid "Hit me."
msgstr "Vas-y, balance."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-0/31/c-0/7
msgctxt "Tony"
msgid "Grippy socks."
msgstr "Des chaussettes antidérapantes."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-0/31/c-0/18/0/s/0
msgctxt "Choix"
msgid "Oh, hell yeah! Can I get a ninety degree incline on the slide?"
msgstr "Oh, putain, ouais ! Je peux avoir une pente à quatre-vingt-dix degrés sur le toboggan ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-0/31/c-0/18/1/s/0
msgctxt "Choix"
msgid "Sounds super fun and not at all inconvenient. Can I sleep on it?"
msgstr "Ça a l'air super marrant et pas du tout gênant. Je peux dormir dessus ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-0/31/c-0/18/2/s/0
msgctxt "Choix"
msgid "I think our stairs might be load bearing... so I'm gonna say no."
msgstr "Je crois que notre escalier est porteur... donc je vais dire non."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-0/31/c-0/18/c-0/7
msgctxt "Tony"
msgid "It can be as steep as you want. Your house, your rules!"
msgstr "Ça peut être aussi raide que tu veux. Ta maison, tes règles !"

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-0/31/c-0/18/c-1/7
msgctxt "Tony"
msgid "Course you can. Just don't take too long. I tend to book out 6-8 weeks in advance."
msgstr "Bien sûr. Mais traîne pas trop. J'ai tendance à être complet 6 à 8 semaines à l'avance."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-0/31/c-0/18/c-2/7
msgctxt "Tony"
msgid "Alright. You're the boss. <i>(what the heck is a \"load-bearing\")</i>"
msgstr "Bon. T'es le patron. <i>(c'est quoi, un « porteur », bon sang)</i>"

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-1/7
msgctxt "Tony"
msgid "Hey, yeah she can get in on this too."
msgstr "Hé, ouais, elle peut participer aussi."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-1/15
msgctxt "Tony"
msgid "She'd become... Indora the Indoor Slide."
msgstr "Elle deviendrait... Intéria, le Toboggan d'Intérieur."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-1/23
msgctxt "Tony"
msgid "Totally fine. Changes like that happen all the time."
msgstr "Aucun souci. Des changements comme ça, ça arrive tout le temps."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-1/31
msgctxt "Tony"
msgid "You just gotta fill out a buncha boring forms."
msgstr "Faut juste remplir une tripotée de formulaires barbants."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-1/39
msgctxt "Tony"
msgid "$200 fee."
msgstr "200 $ de frais."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-1/47/0/s/0
msgctxt "Choix"
msgid "Sounds good."
msgstr "Ça me va."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-1/47/1/s/0
msgctxt "Choix"
msgid "I have to pass."
msgstr "Je passe mon tour."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-1/47/c-0/7
msgctxt "Tony"
msgid "But wait there's more..."
msgstr "Mais attends, c'est pas fini..."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-1/47/c-1/7
msgctxt "Tony"
msgid "Sure, of course, yeah, because an indoor slide would be ridiculous."
msgstr "Bien sûr, évidemment, ouais, parce qu'un toboggan d'intérieur, ce serait ridicule."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/3
msgctxt "Tony"
msgid "Now... how do you feel about indoor pools?"
msgstr "Alors... que penses-tu des piscines d'intérieur ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/11
msgctxt "Tony"
msgid "Because if we rip out the floor in the living room, we can get you an indoor pool."
msgstr "Parce que si on arrache le sol du salon, on peut te faire une piscine d'intérieur."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/19/s/0
msgctxt "Choix"
msgid "Is that safe? I feel like that's a recipe for electrocution."
msgstr "C'est sans danger ? J'ai l'impression que c'est la recette parfaite pour l'électrocution."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/20/s/0
msgctxt "Choix"
msgid "I'm in! Let's do it!"
msgstr "Je suis partant ! Allons-y !"

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-2/7
msgctxt "Tony"
msgid "Course it is, but that's what the chewing gum is for."
msgstr "Bien sûr que oui, mais c'est à ça que sert le chewing-gum."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-2/15
msgctxt "Tony"
msgid "You just stick some of it in the outlet holes and viola, it's now all shockproof."
msgstr "Tu colles un peu de gomme dans les trous des prises et voilà, c'est à l'épreuve des chocs."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-2/23
msgctxt "Tony"
msgid "That concludes my remodeling advice."
msgstr "Ça conclut mes conseils de rénovation."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-2/31
msgctxt "Tony"
msgid "Now for the actual dating advice, you'll just have to sign up for my workshop."
msgstr "Pour les vrais conseils de drague, faudra t'inscrire à mon atelier."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-2/39/0/s/0
msgctxt "Choix"
msgid "I hope there'll be a hands-on demonstration."
msgstr "J'espère qu'il y aura une démonstration pratique."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-2/39/1/s/0
msgctxt "Choix"
msgid "Workshop? Sounds expensive."
msgstr "Un atelier ? Ça sent la dépense."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-2/39/2/s/0
msgctxt "Choix"
msgid "You must really know your stuff."
msgstr "Tu dois vraiment t'y connaître."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-2/39/c-0/13
msgctxt "Tony"
msgid "Oh you better believe it."
msgstr "Oh, tu peux me croire."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-2/39/c-0/21
msgctxt "Tony"
msgid "I'll be payin' real close attention... so you better make sure you're takin' notes."
msgstr "Je vais y regarder de très près... alors t'as intérêt à prendre des notes."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-2/39/c-1/13
msgctxt "Tony"
msgid "C'man, I'm givin' it to ya for free."
msgstr "Allez, je te le donne gratuit."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-2/39/c-1/21
msgctxt "Tony"
msgid "Everybody's a critic..."
msgstr "Tout le monde est critique..."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-2/39/c-2/13
msgctxt "Tony"
msgid "'Course I do. And lucky you, you're gonna get to know my stuff too."
msgstr "Bien sûr que oui. Et t'as de la chance, toi aussi tu vas apprendre à connaître mes affaires."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-3/7
msgctxt "Tony"
msgid "Eyyyy!"
msgstr "Eyyyy !"

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-3/15
msgctxt "Tony"
msgid "Lemme get the permits goin', see if I can get my best tools on the job."
msgstr "Laisse-moi lancer les permis, voir si je peux mettre mes meilleurs outils sur le coup."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-3/23
msgctxt "Tony"
msgid "Hammer's availability has been SHOT ever since... the incident."
msgstr "Les dispos de Marteau sont FOUTUES depuis... l'incident."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-3/31/0/s/0 tony_toolbox/Tony_Pitch2/0/g-0/c-3/31/c-0/31/0/s/0
msgctxt "Choix"
msgid "What incident?"
msgstr "Quel incident ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-3/31/c-0/7
msgctxt "Narrator"
msgid "Tony slides past your question without skipping a beat."
msgstr "Tony esquive votre question sans sourciller."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-3/31/c-0/15
msgctxt "Tony"
msgid "Anyway that's enough about that guy. Let me tell you about my best-sellin' workshop."
msgstr "Bref, assez parlé de ce type. Laisse-moi te parler de mon atelier best-seller."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-3/31/c-0/23
msgctxt "Tony"
msgid "It's a workshop about lovin'."
msgstr "C'est un atelier sur l'amour."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-3/31/c-0/31/1/s/0
msgctxt "Choix"
msgid "Okay... tell me more."
msgstr "D'accord... dis-m'en plus."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-3/31/c-0/31/c-0/7
msgctxt "Narrator"
msgid "You might as well have said absolutely nothing—Tony doesn't budge from his sales pitch."
msgstr "Vous auriez tout aussi bien pu ne rien dire du tout, Tony ne démord pas de son argumentaire."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-1/3
msgctxt "Tony"
msgid "I'm gonna make it real easy for ya."
msgstr "Je vais te faciliter la vie."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-1/11
msgctxt "Tony"
msgid "You wanna take my workshop all's you gotta do is show up. No paperwork or nothin'."
msgstr "Tu veux suivre mon atelier, tout ce que t'as à faire, c'est te pointer. Pas de paperasse ni rien."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-1/19
msgctxt "Tony"
msgid "Now, I don't mean to hustle you outta here, but I gotta take lunch."
msgstr "Bon, je veux pas te presser de partir, mais faut que j'aille déjeuner."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-1/27
msgctxt "Tony"
msgid "Union rules."
msgstr "Règles du syndicat."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-1/35
msgctxt "Tony"
msgid "But you come back later and we'll see what we can do."
msgstr "Mais repasse plus tard et on verra ce qu'on peut faire."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-1/43
msgctxt "Tony"
msgid "Y'know, help you fix up your roh-mantic affairs."
msgstr "Tu sais, t'aider à arranger tes affaires ro-mantiques."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-1/51/s/0
msgctxt "Choix"
msgid "You will not make me a project, Tony."
msgstr "Tu ne feras pas de moi un projet, Tony."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-1/52/s/0
msgctxt "Choix"
msgid "All right you old so 'n so."
msgstr "Très bien, vieux machin."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-1/c-4/7
msgctxt "Tony"
msgid "Who, me? Never."
msgstr "Qui, moi ? Jamais."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-1/c-4/15
msgctxt "Tony"
msgid "Now, get outta here before a crane hits you in the face."
msgstr "Allez, dégage avant qu'une grue te cogne en pleine figure."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-1/c-4/23/0/s/0
msgctxt "Choix"
msgid "I should be so lucky."
msgstr "J'aurais de la chance."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-1/c-5/7
msgctxt "Tony"
msgid "See you around."
msgstr "À plus."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/9
msgctxt "Tony"
msgid "All right. You ready for your first workshop?"
msgstr "Bon. On passe à ton premier atelier ?"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/17/s/0
msgctxt "Choix"
msgid "I still don't understand why you're qualified to give relationship advice."
msgstr "Je ne comprends toujours pas ce qui te qualifie pour donner des conseils sur les relations."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/18/s/0
msgctxt "Choix"
msgid "I'm ready!"
msgstr "Allons-y !"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/7
msgctxt "Tony"
msgid "The way I see it, building a relationship's no different from building, well ... anything."
msgstr "Comme je vois les choses, construire une relation, c'est pas différent de construire, euh... n'importe quoi."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/15
msgctxt "Tony"
msgid "And seeing how I'm a master builder..."
msgstr "Et vu que je suis un maître bricoleur..."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/0/s/0
msgctxt "Choix"
msgid "More like a master baiter."
msgstr "Plutôt un maître branleur."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-0/7 tony_toolbox/second_encounter/0/c-0/23/c-1/13
msgctxt "Tony"
msgid "What?"
msgstr "Quoi ?"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-0/15/0/s/0
msgctxt "Choix"
msgid "What?"
msgstr "Quoi ?"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-0/15/c-0/7
msgctxt "Tony"
msgid "You callin' me a jerk-off?"
msgstr "Tu me traites de branleur ?"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "What? No. You just teed it up too perfectly."
msgstr "Quoi ? Non. Tu me l'as juste servi sur un plateau."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-0/15/c-0/15/c-0/7
msgctxt "Tony"
msgid "Okay..."
msgstr "Ok..."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-0/15/c-0/15/c-0/15
msgctxt "Tony"
msgid "Anyway I'm qualified just fine."
msgstr "Enfin bref, je suis très bien qualifié."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-1/21/0/s/0
msgctxt "Choix"
msgid "I'm not gonna say it."
msgstr "Je ne vais pas le dire."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-1/21/c-0/7
msgctxt "Tony"
msgid "Whatever."
msgstr "Peu importe."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-1/21/c-0/15
msgctxt "Tony"
msgid "I'm qualified just fine."
msgstr "Je suis très bien qualifié."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-1/21/c-0/23/0/s/0
msgctxt "Choix"
msgid "You're a tool box, Tony. Which means you only know as much as I do."
msgstr "T'es une boîte à outils, Tony. Ce qui veut dire que t'en sais autant que moi."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-1/21/c-0/23/c-0/7
msgctxt "Tony"
msgid "Ehhh, I gotta disagree."
msgstr "Ehhh, je suis pas d'accord."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-1/21/c-0/23/c-0/15
msgctxt "Tony"
msgid "You forget I studied under Greg. The contractor."
msgstr "T'oublies que j'ai étudié sous Greg. L'entrepreneur."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-1/21/c-0/23/c-0/23/0/s/0 tony_toolbox/Tony_LoveAdvice/0/g-0/9/s/0
msgctxt "Choix"
msgid "Who?"
msgstr "Qui ?"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-1/21/c-0/23/c-0/23/c-0/7
msgctxt "Tony"
msgid "Yeah, you know the guy ... you brought him in to spiff up the joint after we moved in."
msgstr "Ouais, tu vois le gars... tu l'as fait venir pour retaper la baraque après qu'on a emménagé."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-1/21/c-0/23/c-0/23/c-0/15/0/s/0
msgctxt "Choix"
msgid "You don't mean Greg from Gregslist!"
msgstr "Tu parles pas de Greg de Gregslist !"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-1/21/c-0/23/c-0/23/c-0/15/c-0/7
msgctxt "Tony"
msgid "That's the one!"
msgstr "C'est lui !"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-1/21/c-0/23/c-0/23/c-0/15/c-0/15
msgctxt "Tony"
msgid "He took me all around the house that week."
msgstr "Il m'a trimballé dans toute la maison cette semaine-là."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-1/21/c-0/23/c-0/23/c-0/15/c-0/23
msgctxt "Tony"
msgid "Taught me everything I know."
msgstr "M'a appris tout ce que je sais."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-1/21/c-0/23/c-0/23/c-0/15/c-0/31/0/s/0
msgctxt "Choix"
msgid "That man was not a contractor. I literally paid him in deli meat. Per his request."
msgstr "Ce type n'était pas entrepreneur. Je l'ai littéralement payé en charcuterie. À sa demande."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-1/21/c-0/23/c-0/23/c-0/15/c-0/31/1/s/0
msgctxt "Choix"
msgid "I guess that makes sense."
msgstr "Je suppose que ça se tient."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-1/21/c-0/23/c-0/23/c-0/15/c-0/31/c-0/7
msgctxt "Tony"
msgid "Well, you got a scream of a deal. He really knew his stuff."
msgstr "Bah, t'as fait une affaire à hurler. Il s'y connaissait vraiment."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-1/21/c-0/23/c-0/23/c-0/15/c-0/31/c-0/15/0/s/0
msgctxt "Choix"
msgid "Alright, then. Blow me away."
msgstr "Très bien, alors. Épate-moi."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-1/21/c-0/23/c-0/23/c-0/15/c-0/31/c-1/7
msgctxt "Tony"
msgid "'Course it does. I learned from the best and now I'm givin' you the best!"
msgstr "Bien sûr que oui. J'ai appris des meilleurs et maintenant je te donne le meilleur !"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-1/7
msgctxt "Tony"
msgid "That's what I'm talking about! Alright, come to the job site prepared and with a can-do attitude."
msgstr "C'est de ça que je parle ! Bon, viens sur le chantier préparé et avec la niaque."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "I just want to impress you is all."
msgstr "Je veux juste t'impressionner, c'est tout."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-1/15/1/s/0
msgctxt "Choix"
msgid "I like getting the job done."
msgstr "J'aime que le boulot soit fait."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-1/15/c-0/7
msgctxt "Tony"
msgid "Heh. It's working."
msgstr "Hé. Ça marche."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-0/0
msgctxt "Tony"
msgid "A good job is never done."
msgstr "Un bon boulot est jamais fini."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-0/8
msgctxt "Tony"
msgid "Unless it's done-zo."
msgstr "Sauf s'il est fini-zo."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-0/16
msgctxt "Tony"
msgid "You ever heard of done-zo?"
msgstr "T'as déjà entendu parler du fini-zo ?"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-0/25/s/0
msgctxt "Choix"
msgid "No, wuzzat?"
msgstr "Non, c'est quoi ?"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-0/26/s/0
msgctxt "Choix"
msgid "Tell me, oh wise one."
msgstr "Dis-moi, ô sage."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-1/0
msgctxt "Tony"
msgid "One step ABOVE done. The ultimate done."
msgstr "Une étape AU-DESSUS de fini. Le fini ultime."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-1/8
msgctxt "Tony"
msgid "Be careful though, I knew a screw who had a little too much done-zo if you know what I'm talkin' about."
msgstr "Fais gaffe quand même, j'ai connu une vis qui avait pris un peu trop de fini-zo, si tu vois ce que j'veux dire."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-1/16
msgctxt "Narrator"
msgid "Tony grins, flashing you a pair of finger guns as he waggles his eyebrows at you."
msgstr "Tony sourit, vous adresse deux pistolets avec les doigts et remue les sourcils."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-1/24/s/0
msgctxt "Choix"
msgid "I'm not doing this."
msgstr "Je ne fais pas ça."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-1/25/s/0
msgctxt "Choix"
msgid "Oh I KNOW what you're talkin' about."
msgstr "Oh, je SAIS de quoi tu parles."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-2/0/s/0
msgctxt "Choix"
msgid "Oh you know I know, baby!"
msgstr "Oh, tu sais que je sais, chéri !"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-2/1/s/0
msgctxt "Choix"
msgid "Yeah, and that's all that needs to be said about it."
msgstr "Ouais, et c'est tout ce qu'il y a à en dire."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-3/11/s/0
msgctxt "Choix"
msgid "I KNOW what you're talkin' about!"
msgstr "Je SAIS de quoi tu parles !"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-3/12/s/0
msgctxt "Choix"
msgid "Yes, very much so. Quite."
msgstr "Oui, tout à fait. Parfaitement."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-4/11/s/0
msgctxt "Choix"
msgid "Feels like the premise is well-established now."
msgstr "J'ai l'impression que le principe est bien établi, maintenant."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-4/12/s/0
msgctxt "Choix"
msgid "Oh I know. I KNOW!"
msgstr "Oh je sais. Je SAIS !"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-5/11/s/0
msgctxt "Choix"
msgid "I think the entire house knows at this point."
msgstr "Je crois que toute la maison est au courant à ce stade."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-5/12/s/0
msgctxt "Choix"
msgid "I know what I know, and baby, I KNOW what you're TALKIN' ABOUT!"
msgstr "Je sais ce que je sais, et chéri, je SAIS de quoi tu PARLES !"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-6/0
msgctxt "Tony"
msgid "You know what I'm talking ABOUT!!!"
msgstr "Tu sais de quoi j'PARLE !!!"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-6/17/s/0
msgctxt "Choix"
msgid "I KNOW IT AND YOU KNOW IT!"
msgstr "JE LE SAIS ET TU LE SAIS !"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-6/c-15/7
msgctxt "Tony"
msgid "AYYYY!"
msgstr "AYYYY !"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-6/c-15/18/0/s/0
msgctxt "Choix"
msgid "AYYYY!"
msgstr "AYYYY !"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-6/c-15/18/c-0/7
msgctxt "Narrator"
msgid "Tony beams at you, validated by your admission that you KNOW what he's TALKIN' ABOUT."
msgstr "Tony vous sourit de toutes ses dents, conforté par votre aveu que vous SAVEZ de quoi il PARLE."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-6/c-15/18/c-0/15
msgctxt "Tony"
msgid "Me 'n you? Same page. But since I got integrity as a workshop instructor 'n whatnot..."
msgstr "Toi et moi ? Sur la même longueur d'onde. Mais comme j'ai de l'intégrité en tant que formateur et tout..."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-6/c-15/18/c-0/23
msgctxt "Tony"
msgid "I'm just gonna pretend you don't know shit about shit and start at square one. Capiche?"
msgstr "Je vais faire comme si t'y connaissais que dalle et repartir de zéro. Capiche ?"

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/0
msgctxt "Tony"
msgid "First thing's first: In a courtship as on a job site, you wanna look busy."
msgstr "Première chose : dans la séduction comme sur un chantier, faut avoir l'air occupé."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/8
msgctxt "Tony"
msgid "You don't gotta be doin' nothin', you just gotta look it."
msgstr "Faut pas faire quoi que ce soit, juste en avoir l'air."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/16/s/0
msgctxt "Choix"
msgid "Are you telling me that's what Greg was doing?!"
msgstr "Tu es en train de me dire que c'est ce que faisait Greg ?!"

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/17/s/0
msgctxt "Choix"
msgid "Wouldn't it be easier to just talk to whoever you're trying to impress?"
msgstr "Ce ne serait pas plus simple de parler à la personne qu'on veut impressionner ?"

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/18/s/0 tony_toolbox/workshop_tony_start/0/c-0/23/1/s/0 tony_toolbox/workshop_tony_start/0/g-0/8/s/0 tony_toolbox/workshop_tony_start/0/g-1/9/s/0 tony_toolbox/workshop_tony_start/0/g-4/29/s/0 tony_toolbox/third_encounter/0/g-2/13/10/s/0
msgctxt "Choix"
msgid "<i>Take detailed notes with look of intense concentration.</i>"
msgstr "<i>Prendre des notes détaillées avec un air de concentration intense.</i>"

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-0/7
msgctxt "Tony"
msgid "That's neither here nor there."
msgstr "Là n'est pas la question."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-0/15
msgctxt "Tony"
msgid "Point is, it makes you look good."
msgstr "L'important, c'est que ça te met en valeur."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-0/23/0/s/0
msgctxt "Choix"
msgid "Hm."
msgstr "Hm."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-0/23/c-1/13
msgctxt "Tony"
msgid "That's the spirit."
msgstr "C'est ça, l'esprit."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-0/23/g-0/0
msgctxt "Tony"
msgid "Take this for example: The other day I was fixin' somethin' in the other closet."
msgstr "Prends cet exemple : l'autre jour, je réparais un truc dans l'autre placard."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-0/23/g-0/8
msgctxt "Tony"
msgid "I wasn't DOIN' nothin', but I damn sure looked like I was."
msgstr "Je FAISAIS rien du tout, mais putain, j'avais l'air de bosser."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-0/23/g-0/16
msgctxt "Tony"
msgid "I just carried a sack 'a nuts around the job site for 2 hours."
msgstr "J'ai juste trimballé un sac d'écrous sur le chantier pendant 2 heures."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-0/23/g-0/24
msgctxt "Tony"
msgid "Makes your muscles look real good."
msgstr "Ça met drôlement bien tes muscles en valeur."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-1/7
msgctxt "Tony"
msgid "Uhhh no?"
msgstr "Euh non ?"

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-1/15
msgctxt "Tony"
msgid "Come on, you think I gotta do much talking when I walk around lookin' like this? Check out this toolbelt."
msgstr "Allez, tu crois que j'ai besoin de beaucoup parler quand je me balade avec cette gueule ? Regarde-moi cette ceinture à outils."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-1/26
msgctxt "Tony"
msgid "Folks dig the construction thing."
msgstr "Les gens adorent le côté chantier."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-1/34/0/s/0
msgctxt "Choix"
msgid "Mmm, that belt's packing some serious heat."
msgstr "Mmm, cette ceinture, elle envoie du lourd."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-1/34/1/s/0
msgctxt "Choix"
msgid "You just have so much charm, you know? Why waste it?"
msgstr "T'as tellement de charme, tu sais ? Pourquoi le gâcher ?"

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-1/34/2/s/0
msgctxt "Choix"
msgid "Gross."
msgstr "Beurk."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-1/34/c-0/13
msgctxt "Tony"
msgid "Glad you noticed."
msgstr "Content que tu l'aies remarqué."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-1/34/c-1/7
msgctxt "Tony"
msgid "I ain't wastin' it! Just savin' my energy."
msgstr "Je le gâche pas ! J'économise mon énergie."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-1/34/c-1/15
msgctxt "Tony"
msgid "That's energy I can use to carry heavy things and look busy."
msgstr "Cette énergie, je peux l'utiliser pour porter des trucs lourds et avoir l'air occupé."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-1/34/c-2/13
msgctxt "Tony"
msgid "Gross? That ain't no way to talk to the man who's schoolin' you."
msgstr "Beurk ? On parle pas comme ça à l'homme qui t'instruit."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-1/34/c-2/21
msgctxt "Tony"
msgid "I'm sharin' some absolute jewels here. Real pearls of wisdom."
msgstr "Je te livre de vrais joyaux, là. De vraies perles de sagesse."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-1/34/g-0/0
msgctxt "Tony"
msgid "Anyway I'm gettin' off-track."
msgstr "Enfin bref, je m'égare."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-2/13
msgctxt "Tony"
msgid "Ahhh... the sweet sounds of education."
msgstr "Ahhh... le doux son de l'éducation."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-0/0
msgctxt "Tony"
msgid "Lesson number 2!"
msgstr "Leçon numéro 2 !"

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-0/9/s/0
msgctxt "Choix"
msgid "Greg help us..."
msgstr "Que Greg nous vienne en aide..."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-0/c-3/13
msgctxt "Tony"
msgid "You just wrote down 'Lesson number 2'?"
msgstr "Tu viens d'écrire « Leçon numéro 2 » ?"

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-0/c-3/21/0/s/0
msgctxt "Choix"
msgid "<i>Nod furiously</i>"
msgstr "<i>Hocher la tête avec frénésie</i>"

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-0/c-3/21/c-0/13
msgctxt "Tony"
msgid "Wow. Commitment."
msgstr "Wow. L'engagement."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-1/0
msgctxt "Tony"
msgid "It's what's on the outside that counts."
msgstr "C'est ce qu'il y a à l'extérieur qui compte."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-1/8/s/0
msgctxt "Choix"
msgid "Really? That's not what I've heard..."
msgstr "Vraiment ? Ce n'est pas ce que j'ai entendu..."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-1/c-5/7
msgctxt "Tony"
msgid "Take the paint job in the bathroom..."
msgstr "Prends la peinture de la salle de bains..."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-1/c-5/15/0/s/0
msgctxt "Choix"
msgid "What's wrong with the paint job in the bathroom?"
msgstr "Qu'est-ce qui cloche avec la peinture de la salle de bains ?"

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-1/c-5/15/c-0/7
msgctxt "Tony"
msgid "Nothing."
msgstr "Rien."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-1/c-5/15/c-0/15
msgctxt "Tony"
msgid "Greg did a great job covering up that black stuff we found."
msgstr "Greg a fait du super boulot pour couvrir ce truc noir qu'on a trouvé."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-1/c-5/15/c-0/23/0/s/0
msgctxt "Choix"
msgid "What black stuff?"
msgstr "Quel truc noir ?"

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-1/c-5/15/c-0/23/c-0/7
msgctxt "Tony"
msgid "I think he called it, \"mole\"?"
msgstr "Je crois qu'il appelait ça du « moisi » ?"

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-1/c-5/15/c-0/23/c-0/15/0/s/0
msgctxt "Choix"
msgid "WE HAVE MOLD?!?"
msgstr "ON A DU MOISI ?!?"

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-1/c-5/15/c-0/23/c-0/15/c-0/7
msgctxt "Tony"
msgid "Don't even worry about it, you can't see it no more."
msgstr "T'inquiète pas pour ça, on le voit plus."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-1/c-5/15/c-0/23/c-0/15/c-0/15
msgctxt "Tony"
msgid "It's all deep in the walls. And hey, just like the mole or whatever you got in your house..."
msgstr "Il est tout au fond des murs. Et tiens, comme le moisi ou je sais pas quoi que t'as dans ta maison..."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-1/c-5/15/c-0/23/c-0/15/c-0/23
msgctxt "Tony"
msgid "Only thing that matters in love is appearances. Your lover don't need to know what's underneath the surface."
msgstr "La seule chose qui compte en amour, c'est les apparences. Ton amant a pas besoin de savoir ce qu'il y a sous la surface."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-1/c-5/15/c-0/23/c-0/15/c-0/31/0/s/0
msgctxt "Choix"
msgid "That still seems wrong."
msgstr "Ça me paraît quand même mal."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-1/c-5/15/c-0/23/c-0/15/c-0/31/c-0/7
msgctxt "Tony"
msgid "What's wrong about it? People don't actually need to know you."
msgstr "Qu'est-ce qui est mal là-dedans ? Les gens ont pas vraiment besoin de te connaître."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-1/c-5/15/c-0/23/c-0/15/c-0/31/c-0/15
msgctxt "Tony"
msgid "Not deep down anyway."
msgstr "Pas au fond, en tout cas."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-1/c-5/15/c-0/23/c-0/15/c-0/31/c-0/23
msgctxt "Tony"
msgid "You just figure out what your lover wants and then you become that on the outside."
msgstr "Tu comprends ce que veut ton amant et ensuite tu deviens ça à l'extérieur."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-1/c-6/13
msgctxt "Tony"
msgid "Yeah, my work here is done."
msgstr "Ouais, mon boulot ici est terminé."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-2/0/s/0
msgctxt "Choix"
msgid "You're so wise, Tony."
msgstr "Tu es tellement sage, Tony."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-2/1/s/0
msgctxt "Choix"
msgid "This has to be why you're still single."
msgstr "C'est sûrement pour ça que tu es toujours célibataire."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-2/2/s/0
msgctxt "Choix"
msgid "It takes a real secure and sexy toolbox to change himself for a lover."
msgstr "Il faut une boîte à outils vraiment sûre d'elle et sexy pour se changer pour un amant."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-2/c-7/13
msgctxt "Tony"
msgid "I know, right?"
msgstr "Je sais, hein ?"

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-2/c-7/21
msgctxt "Tony"
msgid "Still, never hurts to hear it again."
msgstr "Ça fait toujours plaisir de l'entendre encore."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-2/c-7/29
msgctxt "Tony"
msgid "You're a real star pupil, you know that?"
msgstr "T'es une vraie élève modèle, tu le sais ça ?"

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-2/c-8/13
msgctxt "Tony"
msgid "I'm single cause it takes a lot to handle all this!"
msgstr "Je suis célibataire parce qu'il faut un sacré paquet de qualités pour gérer tout ça !"

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-2/c-8/21
msgctxt "Tony"
msgid "Don't be jealous, baby. I'm sharin' my advice with ya."
msgstr "Pas de jalousie, bébé. Je partage mes conseils avec toi."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-2/c-9/13
msgctxt "Tony"
msgid "See? You're really startin' to get it."
msgstr "Tu vois ? Tu commences vraiment à piger."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-3/0
msgctxt "Tony"
msgid "Alright, that's enough wisdom for today."
msgstr "Bon, ça suffit pour aujourd'hui côté sagesse."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-3/8
msgctxt "Tony"
msgid "Gotta give you time to digest all of that good advice."
msgstr "Faut te laisser le temps de digérer tous ces bons conseils."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-3/16/b/1
msgctxt "Tony"
msgid "Hope you were takin' notes. Next time you're gettin' tested."
msgstr "J'espère que t'as pris des notes. La prochaine fois, c'est contrôle."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-3/17/b/1
msgctxt "Tony"
msgid "Glad to see you were takin' notes. Next time you're gettin' tested."
msgstr "Content de voir que t'as pris des notes. La prochaine fois, c'est contrôle."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-3/18/b/1
msgctxt "Tony"
msgid "Look at you! With those notes you took you'll ace the test I'm givin' ya."
msgstr "Regarde-toi ! Avec les notes que t'as prises, tu vas cartonner au test que je te prépare."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-3/21/s/0
msgctxt "Choix"
msgid "Tested? But I'm clean. I swear."
msgstr "Un test ? Mais j'ai rien, je le jure."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-3/22/s/0
msgctxt "Choix"
msgid "Hope it's a practical exam."
msgstr "J'espère que ce sera un examen pratique."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-3/23/s/0
msgctxt "Choix"
msgid "I'm gonna make you proud."
msgstr "Je vais te rendre fier."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-3/24/s/0
msgctxt "Choix"
msgid "Whatever."
msgstr "Peu importe."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-3/c-10/13
msgctxt "Tony"
msgid "Not tested like goin' to the clinic tested! Yeesh."
msgstr "Pas testé genre aller à la clinique ! Pfff."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-3/c-10/21
msgctxt "Tony"
msgid "I mean tested like pop quiz tested."
msgstr "Je veux dire testé genre interro surprise."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-3/c-11/13
msgctxt "Tony"
msgid "Of course it's gonna be practical... how else am I gonna make sure you know your shit?"
msgstr "Évidemment que ce sera pratique... comment je saurais sinon si tu connais ton sujet ?"

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-3/c-11/21
msgctxt "Tony"
msgid "Get here ready to fall in love, baby."
msgstr "Viens ici avec l'amour au bord des lèvres, bébé."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-3/c-12/7
msgctxt "Tony"
msgid "Good! You better knock my bolts off next time I see ya."
msgstr "Bien ! Tu as intérêt à me faire sauter les boulons la prochaine fois que je te vois."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-3/c-12/15/0/s/0
msgctxt "Choix"
msgid "I will!"
msgstr "Je le ferai !"

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-4/0
msgctxt "Tony"
msgid "<i>!</i>"
msgstr "<i>!</i>"

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-4/8
msgctxt "Tony"
msgid "There's the lunch bell. Gotta run."
msgstr "Voilà la cloche du déjeuner. Faut que je file."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-4/19
msgctxt "Tony"
msgid "Remember what I told ya! Test next time!"
msgstr "Rappelle-toi ce que j'ai dit ! Test la prochaine fois !"

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-4/27/s/0
msgctxt "Choix"
msgid "Feels like I'm back in school again..."
msgstr "J'ai l'impression de retourner à l'école..."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-4/28/s/0
msgctxt "Choix"
msgid "You got it 'Tones."
msgstr "Compris, Tonio."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-4/c-16/13/b/1
msgctxt "Tony"
msgid "Okay lay off!"
msgstr "Bon, lâche-moi !"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/6/b/1
msgctxt "Tony"
msgid "Ayyy, teacher's pet over here!"
msgstr "Ayyy, voilà le chouchou du prof !"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/7/b/1
msgctxt "Tony"
msgid "Well if it ain't my most promising student."
msgstr "Eh ben, si c'est pas ma plus belle promesse de l'atelier."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/8/b/1
msgctxt "Tony"
msgid "It's real clear you need all the help you can get. But ol' Tony's got ya."
msgstr "C'est clair que t'as besoin de toute l'aide possible. Mais ce vieux Tony assure tes arrières."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/11/b/1
msgctxt "Tony"
msgid "I was just tellin' Shelley about ya!"
msgstr "J'étais justement en train de parler de toi à Shelley !"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/14
msgctxt "Tony"
msgid "You had long enough to chew over the workshop. You ready to prove yourself?"
msgstr "T'as eu assez de temps pour ruminer l'atelier. Il est temps de faire tes preuves, non ?"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/22/s/0
msgctxt "Choix"
msgid "I got this."
msgstr "Je gère."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/23/s/0
msgctxt "Choix"
msgid "I don't have to prove anything to you."
msgstr "J'ai rien à te prouver."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/24/s/0
msgctxt "Choix"
msgid "I'm gonna sweep you off your feet."
msgstr "Je vais te faire tomber à la renverse."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/25/s/0
msgctxt "Choix"
msgid "I wrote down literally everything you said."
msgstr "J'ai noté littéralement tout ce que tu as dit."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/c-0/13
msgctxt "Tony"
msgid "Talk is cheap, pal! Let's hear it."
msgstr "Les paroles, c'est gratuit ! Voyons ça."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/c-0/21
msgctxt "Tony"
msgid "Show me what you got!"
msgstr "Montre-moi ce que t'as dans le ventre !"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/c-1/13
msgctxt "Tony"
msgid "Well if you feel like that why the hell are you here?"
msgstr "Eh ben si tu penses ça, qu'est-ce que tu fiches ici ?"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/c-1/21
msgctxt "Tony"
msgid "No, no, no. It's obvious you need my approval."
msgstr "Non, non, non. C'est évident que t'as besoin de mon approbation."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/c-1/29
msgctxt "Tony"
msgid "And you can still have it if you shape up! Stop gabbin' and show me what you got."
msgstr "Et tu peux encore l'avoir si tu te reprends ! Arrête de papoter et montre-moi ce que t'as."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/c-2/13
msgctxt "Tony"
msgid "Yeah! That's the spirit! Alright, let's see what you got."
msgstr "Ouais ! C'est ça, l'esprit ! Bon, voyons ce que t'as."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/c-3/7
msgctxt "Tony"
msgid "Alright, alright, that's enough of that. Nobody likes a nerd!"
msgstr "Bon, bon, ça suffit. Personne aime les intellos !"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-0/0
msgctxt "Tony"
msgid "You got a crush on me. Real bad."
msgstr "Tu as le béguin pour moi. Grave."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-0/8
msgctxt "Tony"
msgid "Passion rages through your body every time ya see me."
msgstr "La passion fait rage dans ton corps chaque fois que tu me vois."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-0/16
msgctxt "Tony"
msgid "You see me walkin' your way lookin' handsome and strong an' all that... now... what do you do?"
msgstr "Tu me vois arriver vers toi, beau et fort et tout ça... alors... qu'est-ce que tu fais ?"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-0/24/s/0
msgctxt "Choix"
msgid "I throw myself at your feet, begging for a crumb of your attention."
msgstr "Je me jette à tes pieds en implorant une miette de ton attention."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-0/25/s/0
msgctxt "Choix"
msgid "I make myself look busy immediately."
msgstr "Je m'invente immédiatement du boulot."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-0/26/s/0
msgctxt "Choix"
msgid "I pretend to be busy while surreptitiously checking out your toolbelt."
msgstr "Je fais semblant d'avoir du boulot tout en matant discrètement ta ceinture à outils."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-0/c-4/13
msgctxt "Tony"
msgid "What? Nah, nah! That's just embarrassing. It's pathetic."
msgstr "Quoi ? Non, non ! C'est juste gênant. C'est pathétique."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-0/c-4/24
msgctxt "Tony"
msgid "Get up and fix it!"
msgstr "Relève-toi et rattrape ça !"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-0/c-4/32
msgctxt "Tony"
msgid "Look I'll help ya out with this one, alright?"
msgstr "Écoute, je vais t'aider sur celle-là, d'accord ?"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-0/c-4/40
msgctxt "Tony"
msgid "You gotta pretend to be busy! Ignore me."
msgstr "Faut faire semblant d'être occupé ! M'ignorer."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-0/c-5/19
msgctxt "Tony"
msgid "That's the way! You ignore your crush while lookin' busy and sexy."
msgstr "C'est ça ! Tu ignores ton béguin en ayant l'air occupé et sexy."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-0/c-5/27
msgctxt "Tony"
msgid "Just like I taught ya."
msgstr "Comme je te l'ai appris."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-0/c-6/19
msgctxt "Tony"
msgid "Ohohoho... takin' a page out of ol, Tony's playbook, eh?"
msgstr "Ohohoho... on s'inspire du manuel de ce vieux Tony, hein ?"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-0/c-6/27
msgctxt "Tony"
msgid "I didn't even tell ya that part... you really are payin' attention."
msgstr "Je t'avais même pas dit cette partie... tu fais vraiment attention."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-0/c-6/35/0/s/0
msgctxt "Choix"
msgid "Oh, I've been paying real close attention."
msgstr "Oh, je fais très attention."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-0/c-6/35/1/s/0
msgctxt "Choix"
msgid "I got lucky I guess."
msgstr "J'ai eu de la chance, je suppose."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-0/c-6/35/c-0/7
msgctxt "Tony"
msgid "Oh yeah? You better watch it."
msgstr "Ah ouais ? Fais gaffe."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-0/c-6/35/c-0/15
msgctxt "Tony"
msgid "We still got a test to do. You keep talkin' like that this workshop is endin' early."
msgstr "On a encore un test à faire. Si tu continues à causer comme ça, l'atelier finit plus tôt."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-0/c-6/35/c-1/7
msgctxt "Tony"
msgid "Real lucky..."
msgstr "Vraiment de la chance..."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/0
msgctxt "Tony"
msgid "Next."
msgstr "Suivant."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/8
msgctxt "Tony"
msgid "I come up to talk to ya cause all that lookin' hot and busy's got me dyin' to get to know ya."
msgstr "Je viens te parler parce que tout ce côté beau gosse occupé me donne une envie folle de te connaître."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/16
msgctxt "Tony"
msgid "I tell ya, <i>\"I would like to see you sometime.\"</i>"
msgstr "Je te dis : <i>« Je voudrais te voir un de ces jours. »</i>"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/24
msgctxt "Tony"
msgid "How'd you handle that?"
msgstr "Comment tu gères ça ?"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/32/s/0
msgctxt "Choix"
msgid "I give myself a makeover from head to toe using the assumptions I made from our brief conversation."
msgstr "Je me fais un relooking de la tête aux pieds en me basant sur les suppositions tirées de notre brève conversation."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/33/s/0
msgctxt "Choix"
msgid "I tell you to take a long walk off a short pier, jerk-off."
msgstr "Je te dis d'aller te faire voir ailleurs, branleur."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/34/s/0
msgctxt "Choix"
msgid "I turn myself into the person I think you'll find hottest, while telling you very clearly just what sort of tools I'm into."
msgstr "Je me transforme en la personne que je pense que tu trouveras la plus sexy, tout en te disant très clairement quel genre d'outils me plaisent."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/c-7/19
msgctxt "Tony"
msgid "Ooh now that's the stuff!"
msgstr "Ooh, voilà qui est bien !"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/c-7/27
msgctxt "Tony"
msgid "You hide your real self under a shiny new coat 'a paint!"
msgstr "Tu caches ton vrai moi sous une belle couche de peinture neuve !"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/c-7/35
msgctxt "Tony"
msgid "I ain't gonna have a clue who you really are, or if you're hiding a mole under there."
msgstr "J'aurai aucune idée de qui t'es vraiment, ni si tu caches du moisi là-dessous."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/c-7/43
msgctxt "Tony"
msgid "Just the way I like it."
msgstr "Exactement comme j'aime."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/c-8/13
msgctxt "Tony"
msgid "Ay oh, what!?"
msgstr "Eh oh, quoi !?"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/c-8/21/0/s/0
msgctxt "Choix"
msgid "I'm playing hard to get, obviously."
msgstr "Je me fais désirer, évidemment."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/c-8/21/c-0/7
msgctxt "Tony"
msgid "That ain't playin' hard to get, that's playin' disrespectful-like!"
msgstr "C'est pas se faire désirer, ça, c'est du manque de respect !"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/c-8/21/c-0/18
msgctxt "Tony"
msgid "Now my mama didn't raise no jerk-off!"
msgstr "Ma maman a pas élevé un branleur !"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/c-8/21/c-0/26
msgctxt "Tony"
msgid "You apologize to Mama Toolbox and Nonna Toolbox right now!"
msgstr "Tu présentes tes excuses à Maman Toolbox et à Nonna Toolbox tout de suite !"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/c-8/21/c-0/34/0/s/0
msgctxt "Choix"
msgid "What? Why your Nonna?"
msgstr "Quoi ? Pourquoi ta Nonna ?"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/c-8/21/c-0/34/c-0/7
msgctxt "Tony"
msgid "My Nonna was a very big part of raisin' me for the first 35 years of my life!"
msgstr "Ma Nonna a joué un très grand rôle dans mon éducation pendant les 35 premières années de ma vie !"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/c-8/21/c-0/34/c-0/15/0/s/0
msgctxt "Choix"
msgid "\"Sorry Mama and Nonna.\""
msgstr "« Désolé, Maman et Nonna. »"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/c-8/21/c-0/34/c-0/15/1/s/0
msgctxt "Choix"
msgid "Nobody tells me what to do!"
msgstr "Personne me dit quoi faire !"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/c-8/21/c-0/34/c-0/15/2/s/0
msgctxt "Choix"
msgid "That's sweet."
msgstr "C'est touchant."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/c-8/21/c-0/34/c-0/15/c-0/7
msgctxt "Tony"
msgid "Yeah, that's good. Now don't you ever talk bad about my family, capisce?"
msgstr "Ouais, c'est bien. Et maintenant, ne parle plus jamais mal de ma famille, capisce ?"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/c-8/21/c-0/34/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "I really wasn't trying to."
msgstr "Je n'essayais vraiment pas."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/c-8/21/c-0/34/c-0/15/c-0/15/c-0/7
msgctxt "Tony"
msgid "Anyway we ain't here to talk about me. We gotta wrap up this damn test."
msgstr "Bref, on est pas là pour parler de moi. Faut qu'on termine ce satané test."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/c-8/21/c-0/34/c-0/15/c-1/7
msgctxt "Tony"
msgid "You're literally here for me to tell ya what to do, but I guess maybe you forgot."
msgstr "T'es littéralement là pour que je te dise quoi faire, mais je crois que t'as peut-être oublié."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/c-8/21/c-0/34/c-0/15/c-1/15
msgctxt "Tony"
msgid "Whatever. We ain't here to talk about me."
msgstr "Peu importe. On est pas là pour parler de moi."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/c-8/21/c-0/34/c-0/15/c-1/23
msgctxt "Tony"
msgid "Let's wrap up this damn test."
msgstr "Terminons ce satané test."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/c-8/21/c-0/34/c-0/15/c-2/7
msgctxt "Tony"
msgid "I... yeah, I mean I guess. Whatever!"
msgstr "Je... ouais, je suppose. Peu importe !"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/c-8/21/c-0/34/c-0/15/c-2/15
msgctxt "Tony"
msgid "We ain't here to talk about me."
msgstr "On est pas là pour parler de moi."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/c-8/21/c-0/34/c-0/15/c-2/23
msgctxt "Tony"
msgid "Let's just get this damn test over with."
msgstr "Finissons-en avec ce satané test."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/c-9/19
msgctxt "Tony"
msgid "Now that's the stuff right there."
msgstr "Voilà, c'est ça qu'il fallait."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/c-9/27
msgctxt "Tony"
msgid "You give me what I want and you make sure I never have to show you who I am inside?"
msgstr "Tu me donnes ce que je veux et tu t'assures que j'aie jamais à te montrer qui je suis à l'intérieur ?"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/c-9/35
msgctxt "Tony"
msgid "I mean, that's what we in the business call a win-win, baby!"
msgstr "Je veux dire, c'est ce qu'on appelle dans le métier un gagnant-gagnant, bébé !"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/c-9/43/0/s/0
msgctxt "Choix"
msgid "I think everyone calls it that..."
msgstr "Je crois que tout le monde l'appelle comme ça..."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/c-9/43/1/s/0
msgctxt "Choix"
msgid "Win-win, baby!"
msgstr "Gagnant-gagnant, bébé !"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/c-9/43/c-0/7
msgctxt "Tony"
msgid "Shhh shhh shhh. No, no- Trust me."
msgstr "Chhh chhh chhh. Non, non... Crois-moi."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/c-9/43/c-0/15
msgctxt "Tony"
msgid "Definitely a contractor thing."
msgstr "Clairement un truc d'entrepreneur."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/c-9/43/c-1/7
msgctxt "Tony"
msgid "That's what I'm talkin' about!"
msgstr "C'est de ça que je parle !"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/c-9/43/c-1/15/0/s/0
msgctxt "Choix"
msgid "You know what I'm talkin' about!"
msgstr "Tu sais de quoi je parle !"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/c-9/43/c-1/15/1/s/0
msgctxt "Choix"
msgid "Eyyyy!"
msgstr "Eyyyy !"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/c-9/43/c-1/15/c-0/7
msgctxt "Tony"
msgid "That ain't how the bit goes, buddy."
msgstr "C'est pas comme ça que marche le sketch."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-1/c-9/43/c-1/15/c-0/15
msgctxt "Tony"
msgid "You just leave the 'you know what I'm talkin' about's to me, eh?"
msgstr "Tu me laisses les « tu sais de quoi j'parle », hein ?"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-2/0
msgctxt "Tony"
msgid "Alright, time to see how ya did."
msgstr "Bon, voyons comment t'as fait."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-2/8/b/1
msgctxt "Tony"
msgid "Wow. Two questions, and ya failed 'em both."
msgstr "Wow. Deux questions, et tu les as ratées toutes les deux."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-2/8/b/9
msgctxt "Tony"
msgid "Gonna chalk this up to my handsome face and massive package distractin' ya."
msgstr "Je vais mettre ça sur le compte de mon beau visage et de mon énorme paquet qui te distraient."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-2/8/b/17
msgctxt "Tony"
msgid "Cause I really can't be any clearer than I've been."
msgstr "Parce que franchement, je peux pas être plus clair que je l'ai été."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-2/9/b/1
msgctxt "Tony"
msgid "Mmm... well. At least you were half-payin' attention."
msgstr "Mmm... bon. Au moins t'écoutais à moitié."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-2/9/b/9
msgctxt "Tony"
msgid "Just enough to let ol' Tony keep the faith in ya."
msgstr "Juste assez pour que ce vieux Tony garde foi en toi."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-2/9/b/17
msgctxt "Tony"
msgid "I made these lessons as simple as I could, but maybe I'm just too sexy for you to take it all in the first time."
msgstr "J'ai rendu ces leçons aussi simples que possible, mais peut-être que je suis juste trop sexy pour que tu captes tout du premier coup."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-2/9/b/25
msgctxt "Tony"
msgid "We can practice anytime you need."
msgstr "On peut s'entraîner quand tu veux."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-2/10/b/1
msgctxt "Tony"
msgid "Eyyyy! Look at that. I knew you'd make me proud."
msgstr "Eyyyy ! Regarde-moi ça. Je savais que tu me rendrais fier."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-2/10/b/12
msgctxt "Tony"
msgid "The student has become the master..."
msgstr "L'élève a dépassé le maître..."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-2/10/b/20
msgctxt "Tony"
msgid "Can't ask for better'n that."
msgstr "Je pourrais pas demander mieux."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-2/13/0
msgctxt "Tony"
msgid "Alright, that's all I had for the workshop."
msgstr "Bon, c'est tout ce que j'avais pour l'atelier."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-2/13/8/s/0
msgctxt "Choix"
msgid "You only had two lessons?"
msgstr "Tu n'avais que deux leçons ?"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-2/13/9/s/0
msgctxt "Choix"
msgid "I'm spent from all this learning."
msgstr "Tout ce savoir m'a mis K.O."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-2/13/11/s/0
msgctxt "Choix"
msgid "Thanks for the lessons, Tony."
msgstr "Merci pour les leçons, Tony."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-2/13/c-10/7
msgctxt "Tony"
msgid "Look. My wisdom's simple n'clean."
msgstr "Écoute. Ma sagesse est simple et nette."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-2/13/c-10/15
msgctxt "Tony"
msgid "Little contractin' wisdom for ya—you get the job done faster'n cheaper you can pocket the rest for yourself."
msgstr "Petite sagesse d'entrepreneur pour toi : si tu finis le boulot plus vite et pour moins cher, tu empoches le reste."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-2/13/c-11/7
msgctxt "Tony"
msgid "It IS a lot to take in, I know."
msgstr "Ça fait BEAUCOUP à digérer, je sais."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-2/13/c-12/7
msgctxt "Tony"
msgid "School's out, nerd. Cut that shit out!"
msgstr "La récré est finie, intello. Arrête ces conneries !"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-2/13/c-13/7
msgctxt "Tony"
msgid "You know I got you!"
msgstr "Tu sais que je gère !"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-4/0
msgctxt "Tony"
msgid "Now that that's all over... let's hear it. Gimme your feedback."
msgstr "Maintenant que c'est fini... voyons ça. Donne-moi ton retour."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-4/8
msgctxt "Tony"
msgid "Let me know what I can do for the next suck-"
msgstr "Dis-moi ce que je peux faire pour le prochain pig-"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-4/16
msgctxt "Tony"
msgid "I mean, student."
msgstr "Je veux dire, élève."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-4/24/0/s/0
msgctxt "Choix"
msgid "This was amazing. I just have a few notes."
msgstr "C'était génial. J'ai juste quelques remarques."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-4/24/1/s/0
msgctxt "Choix"
msgid "No notes. You're perfect."
msgstr "Pas de remarques. Tu es parfait."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-4/24/2/s/0
msgctxt "Choix"
msgid "You need to hang up your hard hat. You're a fraud."
msgstr "Tu devrais raccrocher ton casque. Tu es un imposteur."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-4/24/c-14/13
msgctxt "Tony"
msgid "Oh yeah? Lay it on me."
msgstr "Ah ouais ? Vas-y, balance."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-4/24/c-15/13
msgctxt "Tony"
msgid "I knew you had a good eye."
msgstr "Je savais que t'avais l'oeil."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-4/24/c-15/21
msgctxt "Tony"
msgid "This right here's solid construction, baby."
msgstr "Ça, c'est de la construction solide, bébé."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-4/24/c-15/29
msgctxt "Tony"
msgid "So now that you're an expert, let's just test all that new knowledge you got."
msgstr "Donc maintenant que t'es expert, testons toutes ces nouvelles connaissances."

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-4/24/c-16/7
msgctxt "Tony"
msgid "What the hell! That ain't feedback!"
msgstr "Qu'est-ce que c'est que ça ! C'est pas un retour, ça !"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-4/24/c-16/18
msgctxt "Tony"
msgid "Ain't you ever heard 'a constructive feedback?"
msgstr "T'as jamais entendu parler de critique constructive ?"

# Traduction IA – à relire
#: tony_toolbox/third_encounter/0/g-4/24/c-16/26
msgctxt "Tony"
msgid "It's called constructive 'cause it helps ya construct things, understand?"
msgstr "On dit constructive parce que ça t'aide à construire des trucs, tu captes ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_LoveAdvice/0/0/s/0
msgctxt "Choix"
msgid "You don't ignore people you like. You talk with them, flirt, etcetera."
msgstr "On n'ignore pas les gens qu'on aime. On leur parle, on flirte, et cetera."

# Traduction IA – à relire
#: tony_toolbox/Tony_LoveAdvice/0/c-0/7
msgctxt "Tony"
msgid "Hmmm ... I don't know about that."
msgstr "Hmmm... je sais pas trop."

# Traduction IA – à relire
#: tony_toolbox/Tony_LoveAdvice/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "You also don't try to be someone you're not. Just be yourself."
msgstr "On n'essaie pas non plus d'être quelqu'un qu'on n'est pas. Sois toi-même."

# Traduction IA – à relire
#: tony_toolbox/Tony_LoveAdvice/0/c-0/15/c-0/7
msgctxt "Tony"
msgid "Yeah, I think I want a second opinion."
msgstr "Ouais, je crois que je veux un deuxième avis."

# Traduction IA – à relire
#: tony_toolbox/Tony_LoveAdvice/0/c-0/15/c-0/15
msgctxt "Tony"
msgid "Y'know, on account of your roh-mantic life being a dumpster fire. No offense."
msgstr "Tu vois, vu que ta vie ro-mantique est un incendie de benne à ordures. Sans vouloir te vexer."

# Traduction IA – à relire
#: tony_toolbox/Tony_LoveAdvice/0/c-0/15/c-0/23/0/s/0
msgctxt "Choix"
msgid "I don't have to be a romantic prodigy to know bad advice when I hear it."
msgstr "Pas besoin d'être un prodige de l'amour pour reconnaître un mauvais conseil quand j'en entends un."

# Traduction IA – à relire
#: tony_toolbox/Tony_LoveAdvice/0/c-0/15/c-0/23/1/s/0
msgctxt "Choix"
msgid "None taken. It's a very pot-meet-kettle situation."
msgstr "Pas vexé. C'est un peu la poêle qui se moque du chaudron."

# Traduction IA – à relire
#: tony_toolbox/Tony_LoveAdvice/0/g-0/0
msgctxt "Tony"
msgid "We're gonna need to bring Rainey in here. And by we I mean you."
msgstr "Faudra qu'on fasse venir Rainey ici. Et par « on », je veux dire toi."

# Traduction IA – à relire
#: tony_toolbox/Tony_LoveAdvice/0/g-0/8/s/0
msgctxt "Choix"
msgid "Rainey as in record player Rainey?"
msgstr "Rainey, comme le tourne-disque Rainey ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_LoveAdvice/0/g-0/c-1/7
msgctxt "Tony"
msgid "Yeah, that's the one. A real doll. Real musical genius."
msgstr "Ouais, c'est elle. Une vraie poupée. Un vrai génie de la musique."

# Traduction IA – à relire
#: tony_toolbox/Tony_LoveAdvice/0/g-0/c-2/7
msgctxt "Tony"
msgid "The record player. Rainey!"
msgstr "Le tourne-disque. Rainey !"

# Traduction IA – à relire
#: tony_toolbox/Tony_LoveAdvice/0/g-1/0/s/0
msgctxt "Choix"
msgid "I'm not hauling a record player in here, Tony. And also, why?"
msgstr "Je ne vais pas trimballer un tourne-disque ici, Tony. Et en plus, pourquoi ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_LoveAdvice/0/g-1/1/s/0
msgctxt "Choix"
msgid "I mean I can talk to her I guess?"
msgstr "Je peux lui parler, je suppose ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_LoveAdvice/0/g-1/c-3/7
msgctxt "Tony"
msgid "Rainey happens to know more about affairs of the heart."
msgstr "Il se trouve que Rainey en sait plus sur les affaires de coeur."

# Traduction IA – à relire
#: tony_toolbox/Tony_LoveAdvice/0/g-1/c-3/15
msgctxt "Tony"
msgid "Y'know on account of all the love songs."
msgstr "Tu vois, vu toutes les chansons d'amour."

# Traduction IA – à relire
#: tony_toolbox/Tony_LoveAdvice/0/g-1/c-3/23
msgctxt "Tony"
msgid "Besides. You can see the ol' Tony charm in action on someone else."
msgstr "En plus. Tu pourras voir le charme du vieux Tony en action sur quelqu'un d'autre."

# Traduction IA – à relire
#: tony_toolbox/Tony_LoveAdvice/0/g-1/c-3/31
msgctxt "Tony"
msgid "Ergo, i.e., etcetera, you gotta bring the water to the horse."
msgstr "Ergo, c'est-à-dire, et cetera, faut amener l'eau à l'âne."

# Traduction IA – à relire
#: tony_toolbox/Tony_LoveAdvice/0/g-1/c-3/39
msgctxt "Tony"
msgid "And besides. You owe me for the relationship advice."
msgstr "Et puis. Tu me dois bien ça pour les conseils sur les relations."

# Traduction IA – à relire
#: tony_toolbox/Tony_LoveAdvice/0/g-1/c-3/47/0/s/0
msgctxt "Choix"
msgid "All of which amounted to \"Ignore anyone you have a crush on\" and \"Hide your problems.\""
msgstr "Qui se résumaient à « Ignore tous ceux pour qui t'as le béguin » et « Cache tes problèmes »."

# Traduction IA – à relire
#: tony_toolbox/Tony_LoveAdvice/0/g-1/c-3/47/c-0/7
msgctxt "Tony"
msgid "Well anything sounds stupid when you say it all shitty."
msgstr "Eh ben tout sonne con quand on le dit de façon minable."

# Traduction IA – à relire
#: tony_toolbox/Tony_LoveAdvice/0/g-1/c-4/7
msgctxt "Tony"
msgid "Talk, haul. Same difference in the construction biz."
msgstr "Parler, porter. Même combat dans le BTP."

# Traduction IA – à relire
#: tony_toolbox/Tony_LoveAdvice/0/g-2/0
msgctxt "Tony"
msgid "Now get out there and make me proud, kid."
msgstr "Maintenant file et rends-moi fier."

# Traduction IA – à relire
#: tony_toolbox/Tony_LoveAdvice/0/g-2/8
msgctxt "Tony"
msgid "Don't forget to talk to Rainey next time you come through. I'm gonna take lunch."
msgstr "Oublie pas de parler à Rainey la prochaine fois que tu passes. Je vais déjeuner."

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/0/s/0
msgctxt "Choix"
msgid "Cool. Ask me a question."
msgstr "Cool. Pose-moi une question."

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/c-0/7
msgctxt "Tony"
msgid "Okay. What is the capital of Turks and Caicos?"
msgstr "Ok. Quelle est la capitale des Turks-et-Caïcos ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "I meant a question about dating-"
msgstr "Je voulais dire une question sur la drague..."

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/c-0/15/c-0/7
msgctxt "Tony"
msgid "Cockburn Town!"
msgstr "Cockburn Town !"

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/c-0/15/c-0/15
msgctxt "Tony"
msgid "The capital 'a Turks n' Caicos, and also what happens when ya swing that hammer a little too freely if you know what I mean."
msgstr "La capitale des Turks-et-Caïcos. En anglais, ça s'entend « marteau qui brûle » : ce que tu chopes quand tu balances ton marteau un peu trop librement, si tu vois ce que j'veux dire."

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/c-0/15/c-0/23
msgctxt "Tony"
msgid "You know, hammer..."
msgstr "Tu sais, le marteau..."

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/c-0/15/c-0/31/0/s/0
msgctxt "Choix"
msgid "Yeah I got it, hammer, penis. I made the connection."
msgstr "Ouais, j'ai pigé, marteau, pénis. J'ai fait le lien."

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/c-0/15/c-0/31/1/s/0
msgctxt "Choix"
msgid "Gosh, you mean like demolition?"
msgstr "Mince, tu veux dire genre la démolition ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/c-0/15/c-0/31/c-0/7
msgctxt "Tony"
msgid "You get it? Hahaha. Yeeeahhh... you get it."
msgstr "Tu piges ? Hahaha. Ouaaais... tu piges."

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/c-0/15/c-0/31/c-1/7
msgctxt "Tony"
msgid "Naw, naw. Y' know... the ol' cannoli. Spicy Italian sausage."
msgstr "Nan, nan. Tu sais... le vieux cannolo. La saucisse italienne bien épicée."

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/c-0/15/c-0/31/c-1/15
msgctxt "Tony"
msgid "The freaky meat stromboli. The tubesteak of love?"
msgstr "Le stromboli de viande tordu. Le saucisson de l'amour ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/c-0/15/c-0/31/c-1/23/0/s/0
msgctxt "Choix"
msgid "Oh, those are all so delicious."
msgstr "Oh, c'est tellement délicieux, tout ça."

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/c-0/15/c-0/31/c-1/23/c-0/7
msgctxt "Tony"
msgid "...you're makin' it less fun. I can't be the one to explain this to ya."
msgstr "...tu gâches le plaisir. C'est pas à moi de t'expliquer ça."

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/g-0/0
msgctxt "Tony"
msgid "Well anyway. Alright, alright. You want I should ask you some questions about datin'."
msgstr "Bon bref. Bon, bon. Tu veux que je te pose des questions sur la drague."

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/g-0/8
msgctxt "Tony"
msgid "Let's see..."
msgstr "Voyons voir..."

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/g-0/16
msgctxt "Tony"
msgid "Alright."
msgstr "Bon."

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/g-0/24
msgctxt "Tony"
msgid "You're at the movies and your date pulls the ol' yawn and stretch move. Classic, but a little outdated."
msgstr "T'es au cinéma et ton rencard te fait le coup du bâillement-étirement. Un classique, mais un peu dépassé."

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/g-0/32
msgctxt "Tony"
msgid "What d'you do?"
msgstr "Tu fais quoi ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/g-0/40/s/0
msgctxt "Choix"
msgid "I let it happen and snuggle into them."
msgstr "Je laisse faire et je me blottis contre ton épaule."

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/g-0/41/s/0
msgctxt "Choix"
msgid "I loudly ask 'WHAT ARE YOU DOING?'"
msgstr "Je demande bien fort : « QU'EST-CE QUE TU FAIS ? »"

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/g-0/42/s/0
msgctxt "Choix"
msgid "Our hands collide in mid-air, because I was doing that too."
msgstr "Nos mains se heurtent en plein vol, parce que je faisais pareil."

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/g-0/c-1/7
msgctxt "Tony"
msgid "Aww... that's cute, but dontcha think you deserve someone bolder'n that?"
msgstr "Aww... c'est mignon, mais tu crois pas que tu mérites quelqu'un de plus audacieux ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/g-0/c-1/15/0/s/0
msgctxt "Choix"
msgid "There's nothing wrong with the classic moves."
msgstr "Il n'y a rien de mal avec les classiques."

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/g-0/c-1/15/c-0/7
msgctxt "Tony"
msgid "Hmm... noted."
msgstr "Hmm... noté."

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/g-0/c-2/7
msgctxt "Tony"
msgid "Whoah woah woah. Not cool!"
msgstr "Whoah woah woah. Pas cool !"

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/g-0/c-2/15
msgctxt "Tony"
msgid "Your date is kind of a dweeb for pullin' that but it ain't no reason to insult 'em!"
msgstr "Ton rencard est un peu nul de sortir ça, mais c'est pas une raison pour l'insulter !"

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/g-0/c-3/7
msgctxt "Tony"
msgid "You too? Yeesh."
msgstr "Toi aussi ? Pfff."

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/g-0/c-3/15
msgctxt "Tony"
msgid "You're too cute to be pullin' amateur moves like that. Believe in yourself!"
msgstr "T'as trop de charme pour sortir des techniques d'amateur comme ça. Crois en toi !"

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/g-1/0
msgctxt "Tony"
msgid "Now a real date would just tell ya how hot you are and put their arm around ya with no pretext, but we ain't all me."
msgstr "Un vrai rencard te dirait juste que t'es canon et te passerait le bras autour des épaules sans prétexte, mais on est pas tous moi."

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/g-1/8
msgctxt "Tony"
msgid "We all gotta start somewhere, ya know?"
msgstr "Faut bien commencer quelque part, tu sais ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/g-1/16
msgctxt "Tony"
msgid "But your date should know they gotta do better."
msgstr "Mais ton rencard devrait savoir qu'il doit faire mieux."

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/g-1/24
msgctxt "Tony"
msgid "Alright. Hmm..."
msgstr "Bon. Hmm..."

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/g-1/32
msgctxt "Tony"
msgid "Your date asks ya how you got so damn sexy and why your construction is so impeccable."
msgstr "Ton rencard te demande comment t'es devenu aussi sexy et pourquoi ta construction est aussi impeccable."

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/g-1/40
msgctxt "Tony"
msgid "Your answer?"
msgstr "Ta réponse ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/g-1/48/s/0
msgctxt "Choix"
msgid "I clutch at my face and wonder how I woke up as Tony."
msgstr "Je me prends le visage dans les mains en me demandant comment j'ai pu me réveiller en Tony."

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/g-1/49/s/0
msgctxt "Choix"
msgid "Are we out of questions already?"
msgstr "On est déjà à court de questions ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/g-1/50/s/0
msgctxt "Choix"
msgid "I tell them I was simply born this way."
msgstr "Je lui dis que je suis simplement né comme ça."

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/g-1/c-4/7
msgctxt "Tony"
msgid "Ha! You tryna butter me up?"
msgstr "Ha ! Tu essaies de me passer de la pommade ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/g-1/c-4/15
msgctxt "Tony"
msgid "It's <i>working</i>."
msgstr "Ça <i>marche</i>."

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/g-1/c-5/7
msgctxt "Tony"
msgid "Why would you say that? It's a real common question."
msgstr "Pourquoi tu dirais ça ? C'est une question très courante."

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/g-1/c-5/15
msgctxt "Tony"
msgid "I get asked that just about every day."
msgstr "On me la pose pratiquement tous les jours."

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/g-1/c-6/13
msgctxt "Tony"
msgid "Ohh that's a good one, I'll have to try that one out."
msgstr "Ohh, elle est bonne, celle-là, faudra que je l'essaie."

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/g-2/0/s/0
msgctxt "Choix"
msgid "Maybe instead of all these hypotheticals I could just give you some of my own advice."
msgstr "Peut-être qu'au lieu de toutes ces hypothèses, je pourrais te donner quelques conseils de mon cru."

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/g-2/c-7/7
msgctxt "Tony"
msgid "Man you learn real quick, huh?"
msgstr "Eh ben, tu apprends vite, hein ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_advice_try/0/g-2/c-7/15
msgctxt "Tony"
msgid "Alright, shoot."
msgstr "Bon, vas-y."

# Traduction IA – à relire
#: tony_toolbox/Tony_Offended/0/0/s/0
msgctxt "Choix"
msgid "Your advice is like you putting a swimming pool in the middle of my living room with nothing but a hammer and screwdriver."
msgstr "Tes conseils, c'est comme si tu installais une piscine au milieu de mon salon avec rien d'autre qu'un marteau et un tournevis."

# Traduction IA – à relire
#: tony_toolbox/Tony_Offended/0/c-0/7
msgctxt "Tony"
msgid "WHEN YOU'RE AS GOOD AS I AM THAT'S ALL YOU NEED!"
msgstr "QUAND T'ES AUSSI BON QUE MOI, C'EST TOUT CE QU'IL FAUT !"

# Traduction IA – à relire
#: tony_toolbox/Tony_Offended/0/c-0/18/0/s/0
msgctxt "Choix"
msgid "See what I mean?"
msgstr "Tu vois ce que je veux dire ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_Offended/0/c-0/18/c-0/7
msgctxt "Tony"
msgid "You know what? I've had about enough of your negative attitude."
msgstr "Tu sais quoi ? J'en ai ma claque de ton attitude négative."

# Traduction IA – à relire
#: tony_toolbox/Tony_Offended/0/c-0/18/c-0/15
msgctxt "Tony"
msgid "You are hereby booted from my workshop! Banned for life!"
msgstr "Tu es par la présente viré de mon atelier ! Banni à vie !"

# Traduction IA – à relire
#: tony_toolbox/Tony_Offended/0/c-0/18/c-0/23
msgctxt "Tony"
msgid "And I'm keeping the registration fee!"
msgstr "Et je garde les frais d'inscription !"

# Traduction IA – à relire
#: tony_toolbox/Tony_Offended/0/c-0/18/c-0/31/0/s/0
msgctxt "Choix"
msgid "What registration fee?"
msgstr "Quels frais d'inscription ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_Offended/0/c-0/18/c-0/31/c-0/7
msgctxt "Tony"
msgid "The twenty dollars that you dropped in my supplies last December!"
msgstr "Les vingt dollars que t'as laissé tomber dans mon matériel en décembre dernier !"

# Traduction IA – à relire
#: tony_toolbox/Tony_Offended/0/c-0/18/c-0/31/c-0/15/0/s/0
msgctxt "Choix"
msgid "That doesn't belong to you!"
msgstr "Ça ne t'appartient pas !"

# Traduction IA – à relire
#: tony_toolbox/Tony_Offended/0/c-0/18/c-0/31/c-0/15/c-0/7
msgctxt "Tony"
msgid "IT DOES NOW!"
msgstr "MAINTENANT SI !"

# Traduction IA – à relire
#: tony_toolbox/tony_rainey_wait/0
msgctxt "Tony"
msgid "What are you doin' here? I need to meet up with Rainey and I need you to like, play referee or some shit."
msgstr "Qu'est-ce que tu fais là ? Faut que je retrouve Rainey et j'ai besoin que tu joues les arbitres ou je sais pas quoi."

# Traduction IA – à relire
#: tony_toolbox/tony_rainey_wait/8
msgctxt "Tony"
msgid "I gotta get back to work!"
msgstr "Faut que je retourne bosser !"

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/0
msgctxt "Tony"
msgid "Hey all this talk with Rainey got me thinking about my favorite kinda music."
msgstr "Hé, tout ce blabla avec Rainey m'a fait penser à mon genre de musique préféré."

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/8/s/0
msgctxt "Choix"
msgid "What kind?"
msgstr "Quel genre ?"

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/9/s/0
msgctxt "Choix"
msgid "Don't tell me..."
msgstr "Me dis pas..."

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-0/0
msgctxt "Tony"
msgid "Rock music."
msgstr "Le rock."

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-0/8
msgctxt "Tony"
msgid "Believe me, I know about rocks. You don't work construction and not know your rocks."
msgstr "Crois-moi, je m'y connais en cailloux. On bosse pas dans le bâtiment sans connaître ses cailloux."

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-0/16
msgctxt "Tony"
msgid "I mean on demolition sites alone..."
msgstr "Rien que sur les chantiers de démolition..."

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-0/24/s/0
msgctxt "Choix"
msgid "I got you brand new from the store, Tony. When have you ever set foot on a demolition site?"
msgstr "Je t'ai acheté neuf au magasin, Tony. Quand as-tu jamais mis les pieds sur un chantier de démolition ?"

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-0/25/s/0
msgctxt "Choix"
msgid "Tell me more..."
msgstr "Dis-m'en plus..."

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-0/c-2/7
msgctxt "Tony"
msgid "You know, as lead foreman I really don't get the respect I'm owed around here."
msgstr "Tu sais, en tant que chef de chantier, je reçois pas le respect qui m'est dû dans le coin."

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-0/c-2/15
msgctxt "Tony"
msgid "Have you talked to the the roof yet? That guy don't give me any respect."
msgstr "T'as déjà parlé au toit ? Ce type me montre aucun respect."

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-0/c-2/23/0/s/0
msgctxt "Choix"
msgid "Why would I — what does the roof have to do with anything?"
msgstr "Pourquoi je... qu'est-ce que le toit vient faire là-dedans ?"

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-0/c-3/7
msgctxt "Tony"
msgid "Sure."
msgstr "Bien sûr."

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-1/0
msgctxt "Tony"
msgid "I had an uncle once. Uncle Ton'."
msgstr "J'ai eu un oncle, un jour. Oncle Ton'."

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-1/8/s/0
msgctxt "Choix"
msgid "Your uncle was also named Tony?"
msgstr "Ton oncle s'appelait aussi Tony ?"

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-1/9/s/0
msgctxt "Choix"
msgid "What do you mean 'once'?"
msgstr "Comment ça, « un jour » ?"

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-1/c-4/7
msgctxt "Tony"
msgid "We're all named Tony."
msgstr "On s'appelle tous Tony."

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-1/c-4/15/0/s/0
msgctxt "Choix"
msgid "Everyone?"
msgstr "Tout le monde ?"

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-1/c-4/15/c-0/7
msgctxt "Tony"
msgid "Oh, yeah."
msgstr "Oh, ouais."

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-1/c-4/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "Your dad?"
msgstr "Ton père ?"

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-1/c-4/15/c-0/15/c-0/7 tony_toolbox/rock_chat/0/g-1/c-4/15/c-0/15/c-0/15/c-0/15
msgctxt "Tony"
msgid "Tony."
msgstr "Tony."

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-1/c-4/15/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "Your brothers?"
msgstr "Tes frères ?"

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-1/c-4/15/c-0/15/c-0/15/c-0/7
msgctxt "Tony"
msgid "One brother."
msgstr "Un seul frère."

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-1/c-4/15/c-0/15/c-0/15/c-0/23/0/s/0
msgctxt "Choix"
msgid "Your great-great-grandpa?"
msgstr "Ton arrière-arrière-grand-père ?"

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-1/c-4/15/c-0/15/c-0/15/c-0/23/c-0/7
msgctxt "Tony"
msgid "Big Tony."
msgstr "Big Tony."

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-1/c-4/15/c-0/15/c-0/15/c-0/23/c-0/15/0/s/0
msgctxt "Choix"
msgid "Your great-great-grandma."
msgstr "Ton arrière-arrière-grand-mère."

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-1/c-4/15/c-0/15/c-0/15/c-0/23/c-0/15/c-0/7
msgctxt "Tony"
msgid "Toni with an 'I'."
msgstr "Toni avec un I."

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-1/c-4/15/c-0/15/c-0/15/c-0/23/c-0/15/c-0/15
msgctxt "Tony"
msgid "Same with my mom and all my aunts."
msgstr "Pareil pour ma mère et toutes mes tantes."

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-1/c-4/15/c-0/15/c-0/15/c-0/23/c-0/15/c-0/23
msgctxt "Tony"
msgid "'cept my sister Conchetta."
msgstr "Sauf ma soeur Conchetta."

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-1/c-4/15/c-0/15/c-0/15/c-0/23/c-0/15/c-0/31
msgctxt "Tony"
msgid "Anyway my uncle."
msgstr "Bref, mon oncle."

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-1/c-5/7
msgctxt "Tony"
msgid "One time uncle."
msgstr "Oncle d'un jour."

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-1/c-5/15
msgctxt "Tony"
msgid "You humans have those?"
msgstr "Vous en avez, vous, les humains ?"

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-1/c-5/23/0/s/0
msgctxt "Choix"
msgid "Yep."
msgstr "Ouais."

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-1/c-5/23/1/s/0
msgctxt "Choix"
msgid "No."
msgstr "Non."

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-1/c-5/23/c-0/7
msgctxt "Tony"
msgid "Then you understand."
msgstr "Alors tu comprends."

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-1/c-5/23/c-1/7
msgctxt "Tony"
msgid "It's like you got a tool you're close with, then he leaves the box one day never to be seen again."
msgstr "C'est comme quand t'as un outil avec qui t'es proche, et qu'un jour il quitte la boîte pour jamais revenir."

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-2/0
msgctxt "Tony"
msgid "My Uncle Ton' fell off a crane on a job."
msgstr "Mon oncle Ton' est tombé d'une grue sur un chantier."

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-2/8
msgctxt "Tony"
msgid "I'm talkin' eighty maybe ninety feet."
msgstr "Je parle de vingt-cinq, peut-être trente mètres."

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-2/16
msgctxt "Tony"
msgid "Cracked wide open. Parts everywhere."
msgstr "Éclaté en deux. Des morceaux partout."

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-2/24/0/s/0
msgctxt "Choix"
msgid "Holy shit."
msgstr "Putain de merde."

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-2/24/1/s/0
msgctxt "Choix"
msgid "Why are we talking about this?"
msgstr "Pourquoi on parle de ça ?"

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-2/24/c-6/7
msgctxt "Tony"
msgid "I know."
msgstr "Je sais."

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-2/24/c-6/18
msgctxt "Tony"
msgid "I miss him everyday."
msgstr "Il me manque tous les jours."

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-2/24/c-6/26/0/s/0
msgctxt "Choix"
msgid "I'm so sorry for your loss, Tony."
msgstr "Je suis vraiment désolé pour ta perte, Tony."

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-2/24/c-6/26/c-0/7
msgctxt "Tony"
msgid "Oh, he ain't dead."
msgstr "Oh, il est pas mort."

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-2/24/c-6/26/c-0/15
msgctxt "Tony"
msgid "The old bastard's retired in a basement somewhere in Poughkeepsie. Disability."
msgstr "Ce vieux salaud est à la retraite dans un sous-sol quelque part à Poughkeepsie. Invalidité."

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-2/24/c-7/7
msgctxt "Tony"
msgid "I dunno."
msgstr "Je sais pas."

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-4/0/s/0
msgctxt "Choix"
msgid "Tony! I want to talk about us!"
msgstr "Tony ! Je veux parler de nous !"

# Traduction IA – à relire
#: tony_toolbox/rock_chat/0/g-4/1/s/0
msgctxt "Choix"
msgid "What are your feelings about me...?"
msgstr "Qu'est-ce que tu ressens pour moi... ?"

# Traduction IA – à relire
#: tony_toolbox/love_path/0/0
msgctxt "Tony"
msgid "Hey listen."
msgstr "Hé, écoute."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/8/s/0
msgctxt "Choix"
msgid "Yeah?"
msgstr "Oui ?"

# Traduction IA – à relire
#: tony_toolbox/love_path/0/c-0/7
msgctxt "Tony"
msgid "Look. I been doin' a lotta thinkin' lately..."
msgstr "Écoute. J'ai pas mal réfléchi ces derniers temps..."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/c-0/15
msgctxt "Tony"
msgid "Ain't a lotta folks in my life brave enough to keep it real with me like you do."
msgstr "Y a pas beaucoup de gens dans ma vie qui ont le courage de rester francs avec moi comme tu le fais."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/c-0/23
msgctxt "Tony"
msgid "And I'm not sayin' I'm wrong or whatever, cause I ain't."
msgstr "Et je dis pas que j'ai tort ou quoi, parce que j'ai pas tort."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/c-0/31
msgctxt "Tony"
msgid "But I could use someone like you in my life."
msgstr "Mais j'aurais bien besoin de quelqu'un comme toi dans ma vie."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/c-0/39
msgctxt "Tony"
msgid "You're dependable, like a triangle made of steel."
msgstr "T'es fiable, comme un triangle en acier."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/c-0/47/0/s/0
msgctxt "Choix"
msgid "Is that all I am? Dependable?"
msgstr "C'est tout ce que je suis ? Fiable ?"

# Traduction IA – à relire
#: tony_toolbox/love_path/0/c-0/47/1/s/0
msgctxt "Choix"
msgid "I don't really get that analogy."
msgstr "Je ne comprends pas vraiment cette analogie."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/c-0/47/2/s/0
msgctxt "Choix"
msgid "You're one to talk about made of steel..."
msgstr "Tu es bien placé pour parler d'acier..."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/c-0/47/c-0/7
msgctxt "Tony"
msgid "Nah, that ain't it at all."
msgstr "Non, c'est pas ça du tout."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/c-0/47/c-1/7
msgctxt "Tony"
msgid "Triangles are the most powerful shape in nature and construction... it's a contractor's best friend."
msgstr "Les triangles sont la forme la plus puissante dans la nature et la construction... c'est le meilleur ami de l'entrepreneur."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/c-0/47/c-1/15
msgctxt "Tony"
msgid "But I ain't here to talk about triangles."
msgstr "Mais je suis pas là pour parler de triangles."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/c-0/47/c-2/7
msgctxt "Tony"
msgid "Ohohoho... nothin' gets past you, huh?"
msgstr "Ohohoho... rien ne t'échappe, hein ?"

# Traduction IA – à relire
#: tony_toolbox/love_path/0/c-0/47/c-2/18
msgctxt "Tony"
msgid "I got steel everything. Abs, buns... wrenches..."
msgstr "J'ai de l'acier partout. Abdos, fesses... clés à molette..."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/c-0/47/c-2/26
msgctxt "Tony"
msgid "Other things..."
msgstr "D'autres trucs..."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/c-0/47/c-2/34
msgctxt "Narrator"
msgid "He pauses for far too long, letting the implication hang in the air."
msgstr "Il marque une pause bien trop longue, laissant l'allusion flotter dans l'air."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/c-0/47/c-2/42
msgctxt "Tony"
msgid "Well. You took my workshop. You know what I'm talkin' about."
msgstr "Bon. Tu as suivi mon atelier. Tu sais de quoi j'parle."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/c-0/47/c-2/50
msgctxt "Tony"
msgid "But we ain't here to talk about my beautiful bod and massive schlong."
msgstr "Mais on est pas là pour parler de mon superbe corps et de mon énorme chibre."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/c-0/47/c-2/58
msgctxt "Tony"
msgid "I wanna talk about you."
msgstr "Je veux parler de toi."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/g-0/0
msgctxt "Tony"
msgid "I like you. A lot."
msgstr "Je t'aime bien. Beaucoup."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/g-0/8
msgctxt "Tony"
msgid "You ain't just dependable and strong."
msgstr "T'es pas juste fiable et solide."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/g-0/16
msgctxt "Tony"
msgid "You're hot as shit... and things are just easy with you."
msgstr "T'es sexy comme pas permis... et avec toi, tout est simple."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/g-0/24
msgctxt "Tony"
msgid "I don't even have to pretend to be doin' nothin'."
msgstr "J'ai même pas besoin de faire semblant de rien faire."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/g-0/32/s/0
msgctxt "Choix"
msgid "I like you too."
msgstr "Moi aussi, je t'aime bien."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/g-0/33/s/0 tony_toolbox/love_path/0/g-0/c-3/15/0/s/0
msgctxt "Choix"
msgid "I just want to be friends."
msgstr "Je veux juste qu'on soit amis."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/g-0/34/s/0
msgctxt "Choix"
msgid "Aww, Tony..."
msgstr "Aww, Tony..."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/g-0/c-1/7 tony_toolbox/love_path/0/g-0/c-3/15/c-1/7
msgctxt "Tony"
msgid "I knew it—I could tell. You just couldn't stay away."
msgstr "Je le savais, je le sentais. Tu pouvais pas rester loin."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/g-0/c-1/15 tony_toolbox/love_path/0/g-0/c-3/15/c-1/15
msgctxt "Tony"
msgid "C'mere. I can't keep it in anymore."
msgstr "Viens là. Je peux plus me retenir."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/g-0/c-1/23 tony_toolbox/love_path/0/g-0/c-3/15/c-1/23
msgctxt "Narrator"
msgid "Tony pulls you in close—his body is warmer than you'd expect for a toolbox, and delightfully solid."
msgstr "Tony vous attire tout contre lui. Son corps est plus chaud qu'on ne le croirait pour une boîte à outils, et délicieusement solide."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/g-0/c-1/31/0/s/0 tony_toolbox/love_path/0/g-0/c-3/15/c-1/31/0/s/0
msgctxt "Choix"
msgid "Oh... wow."
msgstr "Oh... wow."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/g-0/c-1/31/c-0/7 tony_toolbox/love_path/0/g-0/c-3/15/c-1/31/c-0/7
msgctxt "Tony"
msgid "Impressive, huh? I told ya I was packin' some serious steel."
msgstr "Impressionnant, hein ? Je t'avais dit que j'avais de l'acier de qualité."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/g-0/c-1/31/c-0/18/0/s/0 tony_toolbox/love_path/0/g-0/c-3/15/c-1/31/c-0/15/0/s/0
msgctxt "Choix"
msgid "Yes, I see that..."
msgstr "Oui, je vois ça..."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/g-0/c-1/31/c-0/18/c-0/7 tony_toolbox/love_path/0/g-0/c-3/15/c-1/31/c-0/15/c-0/7
msgctxt "Tony"
msgid "Let's get outta here."
msgstr "Barrons-nous d'ici."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/g-0/c-2/7 tony_toolbox/love_path/0/g-0/c-3/15/c-0/7
msgctxt "Tony"
msgid "Oh. Well..."
msgstr "Oh. Eh bien..."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/g-0/c-2/15 tony_toolbox/love_path/0/g-0/c-3/15/c-0/18
msgctxt "Tony"
msgid "I guess that'd be nice too."
msgstr "Je suppose que ce serait bien aussi."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/g-0/c-2/23 tony_toolbox/love_path/0/g-0/c-3/15/c-0/26
msgctxt "Tony"
msgid "Friends like you are in real short supply."
msgstr "Les amis comme toi, c'est une denrée rare."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/g-0/c-2/31 tony_toolbox/love_path/0/g-0/c-3/15/c-0/34
msgctxt "Tony"
msgid "Put 'er there, then."
msgstr "Tope là, alors."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/g-0/c-2/39 tony_toolbox/love_path/0/g-0/c-3/15/c-0/42
msgctxt "Narrator"
msgid "He holds his hand out to you, and when you take it he gives you a firm, confident handshake."
msgstr "Il vous tend la main, et quand vous la prenez, il vous offre une poignée de main ferme et assurée."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/g-0/c-2/47/0/s/0 tony_toolbox/love_path/0/g-0/c-3/15/c-0/50/0/s/0
msgctxt "Choix"
msgid "Glad we can be cool."
msgstr "Content qu'on puisse rester cool."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/g-0/c-2/47/c-0/7 tony_toolbox/love_path/0/g-0/c-3/15/c-0/50/c-0/7
msgctxt "Tony"
msgid "Of course! Tony ain't no creep!"
msgstr "Bien sûr ! Tony est pas un pervers !"

# Traduction IA – à relire
#: tony_toolbox/love_path/0/g-0/c-2/47/c-0/15 tony_toolbox/love_path/0/g-0/c-3/15/c-0/50/c-0/15
msgctxt "Tony"
msgid "Now if you ever wanna sign up for my friendship seminar I got plenty a' great advice for you there too."
msgstr "Maintenant si jamais tu veux t'inscrire à mon séminaire sur l'amitié, j'ai plein de super conseils pour toi là aussi."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/g-0/c-2/47/c-0/23/0/s/0 tony_toolbox/love_path/0/g-0/c-3/15/c-0/50/c-0/23/0/s/0
msgctxt "Choix"
msgid "Later, Tony."
msgstr "À plus, Tony."

# Traduction IA – à relire
#: tony_toolbox/love_path/0/g-0/c-2/47/c-0/23/c-0/7 tony_toolbox/love_path/0/g-0/c-3/15/c-0/50/c-0/23/c-0/7
msgctxt "Tony"
msgid "You'll be back!"
msgstr "Tu reviendras !"

# Traduction IA – à relire
#: tony_toolbox/love_path/0/g-0/c-3/7
msgctxt "Tony"
msgid "I know I'm cute. But you feel the way I feel?"
msgstr "Je sais que je suis mignon. Mais tu ressens ce que je ressens ?"

# Traduction IA – à relire
#: tony_toolbox/love_path/0/g-0/c-3/15/1/s/0
msgctxt "Choix"
msgid "I do."
msgstr "Oui."

# Traduction IA – à relire
#: tony_toolbox/friend_path/0/0
msgctxt "Narrator"
msgid "Tony heaves a sigh."
msgstr "Tony pousse un soupir."

# Traduction IA – à relire
#: tony_toolbox/friend_path/0/8
msgctxt "Tony"
msgid "I guess you were right."
msgstr "Je crois que t'avais raison."

# Traduction IA – à relire
#: tony_toolbox/friend_path/0/16
msgctxt "Tony"
msgid "About what went down with Rainey."
msgstr "Sur ce qui s'est passé avec Rainey."

# Traduction IA – à relire
#: tony_toolbox/friend_path/0/24/s/0
msgctxt "Choix"
msgid "I'll refrain from saying I told you so."
msgstr "Je m'abstiendrai de dire que je te l'avais dit."

# Traduction IA – à relire
#: tony_toolbox/friend_path/0/c-0/7
msgctxt "Tony"
msgid "Maybe some part of me knew all along that you were right."
msgstr "Peut-être qu'une partie de moi savait depuis le début que t'avais raison."

# Traduction IA – à relire
#: tony_toolbox/friend_path/0/c-0/15
msgctxt "Tony"
msgid "But damn, who the hell am I if I ain't the love expert I always knew I was?"
msgstr "Mais bordel, qui je suis si je suis pas l'expert de l'amour que j'ai toujours cru être ?"

# Traduction IA – à relire
#: tony_toolbox/friend_path/0/c-0/23/0/s/0
msgctxt "Choix"
msgid "You're still you, Tony."
msgstr "Tu es toujours toi, Tony."

# Traduction IA – à relire
#: tony_toolbox/friend_path/0/c-0/23/1/s/0
msgctxt "Choix"
msgid "Maybe it's time to find out who Tony really is."
msgstr "Il est peut-être temps de découvrir qui est vraiment Tony."

# Traduction IA – à relire
#: tony_toolbox/friend_path/0/c-0/23/2/s/0
msgctxt "Choix"
msgid "You're a great friend."
msgstr "Tu es un super ami."

# Traduction IA – à relire
#: tony_toolbox/friend_path/0/c-0/23/c-0/7
msgctxt "Tony"
msgid "But what the hell does that mean? Who the hell am I really?"
msgstr "Mais qu'est-ce que ça veut dire, bordel ? Qui je suis vraiment ?"

# Traduction IA – à relire
#: tony_toolbox/friend_path/0/c-0/23/c-0/15/0/s/0
msgctxt "Choix"
msgid "Seems like a good time to start figuring that out."
msgstr "Ça me paraît le bon moment pour commencer à le découvrir."

# Traduction IA – à relire
#: tony_toolbox/friend_path/0/c-0/23/c-0/15/c-0/7
msgctxt "Tony"
msgid "Yeah... maybe so."
msgstr "Ouais... peut-être."

# Traduction IA – à relire
#: tony_toolbox/friend_path/0/c-0/23/c-1/7
msgctxt "Tony"
msgid "I don't even know where to start..."
msgstr "Je sais même pas par où commencer..."

# Traduction IA – à relire
#: tony_toolbox/friend_path/0/c-0/23/c-1/15
msgctxt "Tony"
msgid "But maybe you can help?"
msgstr "Mais peut-être que tu peux m'aider ?"

# Traduction IA – à relire
#: tony_toolbox/friend_path/0/c-0/23/c-2/7
msgctxt "Tony"
msgid "Am I? I don't even know if I'm that anymore."
msgstr "Moi ? Je sais même plus si je suis ça."

# Traduction IA – à relire
#: tony_toolbox/friend_path/0/g-0/0
msgctxt "Tony"
msgid "You know the shtick is all an act, don't you?"
msgstr "Tu sais que tout mon numéro, c'est du cinéma, pas vrai ?"

# Traduction IA – à relire
#: tony_toolbox/friend_path/0/g-0/8
msgctxt "Tony"
msgid "I'm a fraud. I don't really know what I'm doing."
msgstr "Je suis un imposteur. Je sais pas vraiment ce que je fais."

# Traduction IA – à relire
#: tony_toolbox/friend_path/0/g-0/16
msgctxt "Tony"
msgid "I talk a big game, but I have no idea how to fix half of what I need to fix."
msgstr "Je fais le fanfaron, mais j'ai aucune idée de comment réparer la moitié de ce que j'ai à réparer."

# Traduction IA – à relire
#: tony_toolbox/friend_path/0/g-0/24/s/0
msgctxt "Choix"
msgid "Yeah, I noticed. But it doesn't mean you can't learn."
msgstr "Ouais, je l'ai remarqué. Mais ça ne veut pas dire que tu peux pas apprendre."

# Traduction IA – à relire
#: tony_toolbox/friend_path/0/g-0/c-1/7
msgctxt "Tony"
msgid "Yeah?"
msgstr "Ouais ?"

# Traduction IA – à relire
#: tony_toolbox/friend_path/0/g-0/c-1/15/0/s/0
msgctxt "Choix"
msgid "Just take your projects step by step, day by day. Ask for help when you need it."
msgstr "Prends tes projets étape par étape, jour après jour. Demande de l'aide quand t'en as besoin."

# Traduction IA – à relire
#: tony_toolbox/friend_path/0/g-0/c-1/15/c-0/7
msgctxt "Tony"
msgid "Think that's what Greg would say?"
msgstr "Tu crois que c'est ce que Greg dirait ?"

# Traduction IA – à relire
#: tony_toolbox/friend_path/0/g-0/c-1/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "I shudder to think what Greg would say."
msgstr "Je frémis à l'idée de ce que Greg dirait."

# Traduction IA – à relire
#: tony_toolbox/friend_path/0/g-0/c-1/15/c-0/15/c-0/7
msgctxt "Tony"
msgid "Well... alright."
msgstr "Bon... d'accord."

# Traduction IA – à relire
#: tony_toolbox/friend_path/0/g-0/c-1/15/c-0/15/c-0/15
msgctxt "Tony"
msgid "Thanks for everything, pal."
msgstr "Merci pour tout."

# Traduction IA – à relire
#: tony_toolbox/friend_path/0/g-0/c-1/15/c-0/15/c-0/23
msgctxt "Tony"
msgid "If I got a true friend like you by my side... ol' Tony's gonna be okay."
msgstr "Si j'ai un vrai ami comme toi à mes côtés... ce vieux Tony s'en sortira."

# Traduction IA – à relire
#: tony_toolbox/friend_path/0/g-0/c-1/15/c-0/15/c-0/31/0/s/0
msgctxt "Choix"
msgid "I'm rooting for you."
msgstr "Je suis de tout coeur avec toi."

# Traduction IA – à relire
#: tony_toolbox/hate_path/0/6
msgctxt "Tony"
msgid "Take that back!"
msgstr "Retire ça !"

# Traduction IA – à relire
#: tony_toolbox/hate_path/0/14/s/0
msgctxt "Choix"
msgid "No! You're a scammer and a fraud and your projects are all worthless junk!"
msgstr "Non ! T'es un arnaqueur et un imposteur et tous tes projets sont de la camelote sans valeur !"

# Traduction IA – à relire
#: tony_toolbox/hate_path/0/c-0/7
msgctxt "Tony"
msgid "YOU'VE CROSSED THE LINE NOW, SCUMBAG!"
msgstr "TU AS FRANCHI LA LIGNE, ESPÈCE D'ORDURE !"

# Traduction IA – à relire
#: tony_toolbox/hate_path/0/c-0/18
msgctxt "Tony"
msgid "Nobody, but NOBODY talks shit about my work!"
msgstr "Personne, mais PERSONNE parle mal de mon boulot !"

# Traduction IA – à relire
#: tony_toolbox/hate_path/0/c-0/26
msgctxt "Tony"
msgid "See if I don't loosen every screw in this goddamn place and bring it all crashing down around you, ballbag!"
msgstr "Tu vas voir si je desserre pas chaque vis de cette putain de baraque pour tout faire s'écrouler sur ta tête, espèce de couille molle !"

# Traduction IA – à relire
#: tony_toolbox/hate_path/0/c-0/34/0/s/0
msgctxt "Choix"
msgid "Good luck finding the screws in the first place, loser."
msgstr "Bonne chance pour trouver les vis, déjà, minable."

# Traduction IA – à relire
#: tony_toolbox/hate_path/0/c-0/34/c-0/7
msgctxt "Tony"
msgid "GET OUTTA MY FACE!"
msgstr "DÉGAGE DE MA VUE !"

# Traduction IA – à relire
#: tony_toolbox/hate_path/0/c-0/34/c-0/18/0/s/0
msgctxt "Choix"
msgid "Sayonara, scammer!"
msgstr "Sayonara, arnaqueur !"

# Traduction IA – à relire
#: tony_toolbox/hate_path/0/c-0/34/c-0/18/c-0/41
msgctxt "Reggie"
msgid "Some of us just don't like honesty."
msgstr "Y en a qui aiment tout simplement pas l'honnêteté."

# Traduction IA – à relire
#: tony_toolbox/hate_path/0/c-0/34/c-0/18/c-0/49
msgctxt "Reggie"
msgid "Me? I love it. Causes all <i>sorts</i> of trouble."
msgstr "Moi ? J'adore ça. Ça cause toutes <i>sortes</i> d'ennuis."

# Traduction IA – à relire
#: tony_toolbox/friend_path_return/0/0
msgctxt "Tony"
msgid "Eyyy!"
msgstr "Eyyy !"

# Traduction IA – à relire
#: tony_toolbox/friend_path_return/0/8/s/0
msgctxt "Choix"
msgid "Tony! You look well!"
msgstr "Tony ! Tu as bonne mine !"

# Traduction IA – à relire
#: tony_toolbox/friend_path_return/0/9/s/0
msgctxt "Choix"
msgid "Eyyyy! Wanna get Realized, Tones?"
msgstr "Eyyyy ! Ça te dit d'être Réalisé, Tonio ?"

# Traduction IA – à relire
#: tony_toolbox/friend_path_return/0/c-0/7
msgctxt "Tony"
msgid "Thanks, bud. Seein' your smilin' face always makes my day."
msgstr "Merci. Voir ta bouille souriante me fait toujours ma journée."

# Traduction IA – à relire
#: tony_toolbox/friend_path_return/0/c-0/15
msgctxt "Narrator"
msgid "Tony salutes you and gets back to what seems to pass as 'work'."
msgstr "Tony vous salue et retourne à ce qui passe pour du « travail »."

# Traduction IA – à relire
#: tony_toolbox/hate_path_return/0/8
msgctxt "Tony"
msgid "Well well well, look who it is."
msgstr "Tiens tiens tiens, regardez qui voilà."

# Traduction IA – à relire
#: tony_toolbox/hate_path_return/0/16
msgctxt "Tony"
msgid "Put any weight on your dining table today yet?"
msgstr "T'as déjà mis du poids sur ta table de salle à manger aujourd'hui ?"

# Traduction IA – à relire
#: tony_toolbox/hate_path_return/0/24/s/0
msgctxt "Choix"
msgid "No... why?"
msgstr "Non... pourquoi ?"

# Traduction IA – à relire
#: tony_toolbox/hate_path_return/0/25/s/0 tony_toolbox/hate_path_return_2/0/9/s/0
msgctxt "Choix"
msgid "Please Tony... won't you take me back? I got so much that needs fixing... (USE CHARM CANDY)"
msgstr "S'il te plaît Tony... tu veux pas me reprendre ? J'ai tellement de choses à réparer... (UTILISER UN BONBON DE CHARME)"

# Traduction IA – à relire
#: tony_toolbox/hate_path_return/0/c-0/7
msgctxt "Tony"
msgid "Well it ain't no fun if I tell you now, is it?"
msgstr "Bah, c'est pas drôle si je te le dis maintenant, hein ?"

# Traduction IA – à relire
#: tony_toolbox/hate_path_return/0/c-1/7 tony_toolbox/hate_path_return_2/0/c-1/7
msgctxt "Tony"
msgid "'Course you do."
msgstr "Bien sûr que oui."

# Traduction IA – à relire
#: tony_toolbox/hate_path_return/0/c-1/21 tony_toolbox/hate_path_return_2/0/c-1/21
msgctxt "Tony"
msgid "It's only natural you looked around at all the shit falling apart around you and you knew... you knew only Tony could save ya."
msgstr "C'est tout naturel que t'aies regardé autour de toi tout ce bazar qui part en miettes et que t'aies compris... compris que seul Tony pouvait te sauver."

# Traduction IA – à relire
#: tony_toolbox/hate_path_return/0/c-1/29/0/s/0 tony_toolbox/hate_path_return_2/0/c-1/29/0/s/0
msgctxt "Choix"
msgid "You're so right. Take me back, construction daddy."
msgstr "Tu as tellement raison. Reprends-moi, papa du chantier."

# Traduction IA – à relire
#: tony_toolbox/hate_path_return/0/c-1/29/c-0/7 tony_toolbox/hate_path_return_2/0/c-1/29/c-0/7
msgctxt "Tony"
msgid "Oh now we're talkin'!"
msgstr "Oh, là on parle !"

# Traduction IA – à relire
#: tony_toolbox/hate_path_return/0/c-1/29/c-0/15 tony_toolbox/hate_path_return_2/0/c-1/29/c-0/15
msgctxt "Tony"
msgid "I'll take you back no problem... but look. I'm a sensitive guy and I ain't ready for nothin' deeper right now."
msgstr "Je te reprends sans problème... mais écoute. Je suis un type sensible et je suis pas prêt pour quelque chose de plus profond maintenant."

# Traduction IA – à relire
