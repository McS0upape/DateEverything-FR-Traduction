#: doug_dread/doug_encounter4/0/g-0/21/s/0
msgctxt "Choix"
msgid "I won’t; I promise."
msgstr ""

#: doug_dread/doug_encounter4/0/g-0/c-4/13
msgctxt "Doug"
msgid "Well sure. Everyone likes bullying; it’s the best."
msgstr ""

#: doug_dread/doug_encounter4/0/g-0/c-4/24
msgctxt "Doug"
