#: mitchell_food/mitchell_realize_join/0/g-0/9/s/0
msgctxt "Choix"
msgid "Hai"
msgstr ""

#: mitchell_food/mitchell_realize_join/0/g-1/0
msgctxt "Mitchell"
msgid "Then my greatest dreams are about to be realized along with me."
msgstr ""

#: mitchell_food/mitchell_realize_join/0/g-1/11
msgctxt "Mitchell"
msgid "Do you have all the ingredients prepared?"
msgstr ""

#: mitchell_food/mitchell_realize_join/0/g-1/28/s/0
msgctxt "Choix"
msgid "My prep station is ready, chef."
msgstr ""

#: mitchell_food/mitchell_realize_join/0/g-1/29/s/0
msgctxt "Choix"
msgid "Not yet..."
msgstr ""

