#: penelope_stationery/penelope_hate_return/0/0
msgctxt "Penelope"
msgid "Well well well!"
msgstr ""

#: penelope_stationery/penelope_hate_return/0/8
msgctxt "Penelope"
msgid "If isn't Casa Casanova!"
msgstr ""

#: penelope_stationery/penelope_hate_return/0/16
msgctxt "Penelope"
msgid "Come to rub the fact that you're dating an entire house in my face?"
