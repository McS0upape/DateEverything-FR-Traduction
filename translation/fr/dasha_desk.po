#: dasha_desk/dasha_hate_crit/0/g-1/c-7/29/c-1/7
msgctxt "Dasha"
msgid "Ah, how kind of you."
msgstr ""

#: dasha_desk/dasha_hate_crit/0/g-1/c-7/29/c-2/7
msgctxt "Dasha"
msgid "Yes, let us move on."
msgstr ""

#: dasha_desk/dasha_hate_crit/0/g-2/c-8/21/c-0/7
msgctxt "Dasha"
msgid "If you continue to speak to me this way I will slap you so hard your head will fly from your shoulders at speed of sound."
msgstr ""

#: dasha_desk/dasha_hate_crit/0/g-2/c-8/21/c-0/18/0/s/0
msgctxt "Choix"
msgid "Damn, sorry."
