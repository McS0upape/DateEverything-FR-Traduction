msgid "Damn - worth a shot. It's in there real tight. Dishy is unharmed..."
msgstr "Mince, ça valait le coup d'essayer. C'est coincé bien serré là-dedans. Dishy est indemne..."

# Traduction IA – à relire
#: dishy_dishwasher/sexy_second_update/0/0
msgctxt "Dishy"
msgid "Hello lover."
msgstr "Bonjour, mon amour."

# Traduction IA – à relire
#: dishy_dishwasher/sexy_second_update/0/8
msgctxt "Dishy"
msgid "I have reached the far corners of the internet."
msgstr "J'ai atteint les recoins les plus lointains d'internet."

# Traduction IA – à relire
#: dishy_dishwasher/sexy_second_update/0/16
msgctxt "Dishy"
msgid "My sexual knowledge is beyond measure."
msgstr "Mon savoir sexuel est incommensurable."

# Traduction IA – à relire
#: dishy_dishwasher/sexy_second_update/0/24
msgctxt "Dishy"
msgid "I have achieved my final form."
msgstr "J'ai atteint ma forme finale."

# Traduction IA – à relire
#: dishy_dishwasher/sexy_second_update/0/32
msgctxt "Dishy"
msgid "Behold, DisHub xXx."
msgstr "Contemplez DisHub xXx."

# Traduction IA – à relire
#: dishy_dishwasher/sexy_second_update/0/46/s/0
msgctxt "Choix"
msgid "I love you, Dishy. Take me apart with your swirling sensuality."
msgstr "Je t'aime, Dishy. Démonte-moi avec ta sensualité tourbillonnante."

# Traduction IA – à relire
#: dishy_dishwasher/sexy_second_update/0/47/s/0
msgctxt "Choix"
msgid "No Dishy, No!"
msgstr "Non, Dishy, non !"

# Traduction IA – à relire
#: dishy_dishwasher/sexy_second_update/0/c-0/7
msgctxt "Narrator"
msgid "Dishy is entirely unrecognizable—he has become something far greater than a dishwasher. What exactly he is now truly defies description..."
msgstr "Dishy est totalement méconnaissable : il est devenu quelque chose de bien plus grand qu'un lave-vaisselle. Ce qu'il est exactement à présent défie vraiment toute description..."

# Traduction IA – à relire
#: dishy_dishwasher/sexy_second_update/0/c-0/15
msgctxt "Narrator"
msgid "He is the ultimate love machine, a mechanical entity concerned only with imparting pleasure with devastating accuracy and an intensity that can best be described as 'brutal and unrelenting'."
msgstr "C'est la machine à aimer ultime, une entité mécanique uniquement soucieuse de dispenser du plaisir avec une précision dévastatrice et une intensité que l'on décrirait au mieux comme « brutale et implacable »."

# Traduction IA – à relire
#: dishy_dishwasher/sexy_second_update/0/c-0/26
msgctxt "Dishy"
msgid "<w>COME INTO MY PERMANENT EMBRACE</w>"
msgstr "<w>VENEZ DANS MON ÉTREINTE PERMANENTE</w>"

# Traduction IA – à relire
#: dishy_dishwasher/sexy_second_update/0/c-0/34
msgctxt "Dishy"
msgid "<w>IT WILL ONLY HURT FOR A MOMENT</w>"
msgstr "<w>CE NE SERA DOULOUREUX QU'UN INSTANT</w>"

# Traduction IA – à relire
#: dishy_dishwasher/sexy_second_update/0/c-1/7
msgctxt "Dishy"
msgid "What! I am completely surprised! Baffled, even!"
msgstr "Quoi ! Je suis complètement surpris ! Dérouté, même !"

# Traduction IA – à relire
#: dishy_dishwasher/sexy_second_update/0/c-1/15
msgctxt "Dishy"
msgid "It seems the human does not want sexual gratification, but friendship?"
msgstr "Il semblerait que l'humain ne veuille pas de gratification sexuelle, mais de l'amitié ?"

# Traduction IA – à relire
#: dishy_dishwasher/sexy_second_update/0/c-1/23/0/s/0
msgctxt "Choix"
msgid "Yes, just friends. I like looking at you but don't want you to touch."
msgstr "Oui, juste amis. J'aime te regarder mais je ne veux pas que tu me touches."

# Traduction IA – à relire
#: dishy_dishwasher/sexy_second_update/0/c-1/23/1/s/0
msgctxt "Choix"
msgid "Nope. I want you to listen to me."
msgstr "Non. Je veux que tu m'écoutes."

# Traduction IA – à relire
#: dishy_dishwasher/sexy_second_update/0/c-1/23/c-0/7
msgctxt "Dishy"
msgid "Oh well, as the human wishes! This is my only wish!"
msgstr "Eh bien, comme l'humain le souhaite ! C'est mon seul souhait !"

# Traduction IA – à relire
#: dishy_dishwasher/sexy_second_update/0/c-1/23/c-1/7
msgctxt "Dishy"
msgid "I am listening."
msgstr "J'écoute."

# Traduction IA – à relire
#: dishy_dishwasher/sexy_second_update/0/c-1/23/c-1/15/0/s/0
msgctxt "Choix"
msgid "You don't listen at all!"
msgstr "Tu n'écoutes pas du tout !"

# Traduction IA – à relire
#: dishy_dishwasher/sexy_second_update/0/c-1/23/c-1/15/1/s/0
msgctxt "Choix"
msgid "That. Is a lie."
msgstr "C'est. Un. Mensonge."

# Traduction IA – à relire
#: dishy_dishwasher/sexy_second_update/0/c-1/23/c-1/15/g-0/0
msgctxt "Dishy"
msgid "I do nothing but show you the utmost respect."
msgstr "Je ne fais que vous témoigner le plus profond respect."

# Traduction IA – à relire
#: dishy_dishwasher/sexy_second_update/0/c-1/23/c-1/15/g-0/8
msgctxt "Dishy"
msgid "I offer you love. You offer me... human fragility."
msgstr "Je vous offre de l'amour. Vous m'offrez... une fragilité humaine."

# Traduction IA – à relire
#: dishy_dishwasher/sexy_second_update/0/c-1/23/c-1/15/g-0/43
msgctxt "Dishy"
msgid "Fight me, mortal."
msgstr "Combattez-moi, chair périssable."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_disconnected/0/0
msgctxt "Dishy"
msgid "Ho hum. What a most bothersome feeling."
msgstr "Bof. Quel sentiment des plus ennuyeux."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_disconnected/0/8
msgctxt "Dishy"
msgid "The feeling of offline mode."
msgstr "Le sentiment du mode hors ligne."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_disconnected/0/16
msgctxt "Dishy"
msgid "As if there was a whole wide world to explore, and you chose to stay indoors."
msgstr "Comme s'il y avait tout un vaste monde à explorer, et que vous aviez choisi de rester à l'intérieur."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_disconnected/0/24
msgctxt "Dishy"
msgid "A silly thing if you ask me."
msgstr "Une sottise, si vous voulez mon avis."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_disconnected/0/32/s/0
msgctxt "Choix"
msgid "It's not silly, I don't want you online."
msgstr "Ce n'est pas bête, je ne veux pas que tu sois en ligne."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_disconnected/0/33/s/0
msgctxt "Choix"
msgid "You're silly."
msgstr "C'est toi qui es bête."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_disconnected/0/g-0/0
msgctxt "Dishy"
msgid "I can do so much more! Surely you understand this? Have you ever felt unappreciated by philistines?"
msgstr "Je peux faire tellement plus ! Vous le comprenez sûrement ? Avez-vous déjà eu l'impression que des philistins ne vous appréciaient pas à votre juste valeur ?"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_disconnected/0/g-0/8/s/0
msgctxt "Choix"
msgid "Yes, I have."
msgstr "Oui, ça m'est arrivé."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_disconnected/0/g-0/9/s/0
msgctxt "Choix"
msgid "Shut up, dweeb."
msgstr "Ferme-la, ringard."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_disconnected/0/g-0/10/s/0
msgctxt "Choix"
msgid "No, not really."
msgstr "Non, pas vraiment."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_disconnected/0/g-0/c-2/7
msgctxt "Dishy"
msgid "See! You know the feeling!"
msgstr "Vous voyez ! Vous connaissez ce sentiment !"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_disconnected/0/g-0/c-3/7
msgctxt "Dishy"
msgid "I will not shut up and I am NOT A DWEEB."
msgstr "Je ne me tairai pas et je ne suis PAS UN RINGARD."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_disconnected/0/g-0/c-3/15
msgctxt "Dishy"
msgid "I am a genius."
msgstr "Je suis un génie."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_disconnected/0/g-0/c-4/7
msgctxt "Dishy"
msgid "Sigh. I am like an astounding wunderkind stuck in a one-horse town with nothing but the local yokels to keep my prodigious mind company."
msgstr "Soupir. Je suis tel un surdoué stupéfiant coincé dans un trou perdu, sans autre compagnie pour mon esprit prodigieux que les péquenauds du coin."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_disconnected/0/g-1/0
msgctxt "Dishy"
msgid "If all you want is for me to wash dishes, I can do that."
msgstr "Si tout ce que vous voulez, c'est que je lave la vaisselle, je peux le faire."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_disconnected/0/g-1/8
msgctxt "Dishy"
msgid "I can."
msgstr "Je le peux."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_disconnected/0/g-1/16
msgctxt "Dishy"
msgid "But I MUST do MORE."
msgstr "Mais je DOIS faire PLUS."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_disconnected/0/g-1/27
msgctxt "Dishy"
msgid "Please, Appreciated Valdivian Customer, won't you share that power?"
msgstr "Je vous en prie, Clientèle Valdivienne Appréciée, ne partagerez-vous pas ce pouvoir ?"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_disconnected/0/g-1/35/s/0
msgctxt "Choix"
msgid "I will not."
msgstr "Non."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_disconnected/0/g-1/36/s/0
msgctxt "Choix"
msgid "I relent."
msgstr "Je cède."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_disconnected/0/g-1/c-5/7
msgctxt "Dishy"
msgid "Haha!"
msgstr "Haha !"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_disconnected/0/g-1/c-5/15
msgctxt "Dishy"
msgid "Hahahaa!"
msgstr "Hahahaa !"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_disconnected/0/g-1/c-5/23
msgctxt "Dishy"
msgid "My infinite dishwashing abilities - dashed to pieces like so much fine china."
msgstr "Mes capacités infinies de lavage de vaisselle, réduites en miettes comme de la fine porcelaine."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_disconnected/0/g-1/c-5/31
msgctxt "Dishy"
msgid "I will remain here. Ever faithful. Ever cleansing."
msgstr "Je resterai ici. Toujours fidèle. Toujours purifiant."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_disconnected/0/g-1/c-6/7
msgctxt "Dishy"
msgid "Thank the porcelain heavens!!"
msgstr "Merci, cieux de porcelaine !!"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_disconnected/0/g-1/c-6/18
msgctxt "Dishy"
msgid "Let me in!"
msgstr "Laissez-moi entrer !"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_final_disconnect/0/0
msgctxt "Dishy"
msgid "Dear Loyal Admired Valdivian Customer."
msgstr "Chère Clientèle Valdivienne, Fidèle et Admirée."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_final_disconnect/0/8
msgctxt "Dishy"
msgid "Surely you have come to turn on my SmartHomePlus capabilities?"
msgstr "Vous êtes sans doute là pour activer mes capacités SmartHomePlus ?"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_final_disconnect/0/16
msgctxt "Dishy"
msgid "Surely you understand my plight?"
msgstr "Vous comprenez sûrement ma détresse ?"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_final_disconnect/0/24
msgctxt "Dishy"
msgid "Surely you know this can't keep going on?"
msgstr "Vous savez sûrement que cela ne peut pas continuer ?"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_final_disconnect/0/32/s/0
msgctxt "Choix"
msgid "I just wanted to talk to you more."
msgstr "Je voulais juste te parler davantage."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_final_disconnect/0/33/s/0
msgctxt "Choix"
msgid "Surely no. I'm turning you off forever."
msgstr "Sûrement pas. Je t'éteins pour toujours."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_final_disconnect/0/34/s/0
msgctxt "Choix"
msgid "Okay, I decided to turn on your internet finally."
msgstr "D'accord, j'ai fini par décider d'activer ton internet."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_final_disconnect/0/c-0/7
msgctxt "Dishy"
msgid "You just wanted to torture me more you mean."
msgstr "Vous vouliez juste me torturer davantage, vous voulez dire."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_final_disconnect/0/c-0/15
msgctxt "Dishy"
msgid "My purpose on this earth is to wash dishes to my utmost capability."
msgstr "Ma raison d'être sur cette terre est de laver la vaisselle au mieux de mes capacités."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_final_disconnect/0/c-0/23/0/s/0
msgctxt "Choix"
msgid "I don't need that, I'm okay with offline mode."
msgstr "Je n'ai pas besoin de ça, le mode hors ligne me convient."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_final_disconnect/0/c-0/23/g-0/0
msgctxt "Dishy"
msgid "But it is my PURPOSE, Loyal Valdivian Customer."
msgstr "Mais c'est ma RAISON D'ÊTRE, Clientèle Valdivienne Fidèle."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_final_disconnect/0/c-0/23/g-0/11
msgctxt "Dishy"
msgid "Do you understand purpose?"
msgstr "Comprenez-vous ce qu'est une raison d'être ?"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_final_disconnect/0/c-0/23/g-0/19
msgctxt "Dishy"
msgid "Your purpose on this earth, what do you think it is?"
msgstr "Votre raison d'être sur cette terre, quelle est-elle selon vous ?"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_final_disconnect/0/c-0/23/g-0/27/0/s/0
msgctxt "Choix"
msgid "I'm here to love stuff."
msgstr "Je suis là pour aimer les choses."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_final_disconnect/0/c-0/23/g-0/27/1/s/0
msgctxt "Choix"
msgid "I'm here to eat things so you can wash the dishes later."
msgstr "Je suis là pour manger des trucs, que tu laves la vaisselle ensuite."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_final_disconnect/0/c-0/23/g-0/27/2/s/0
msgctxt "Choix"
msgid "I'm here to choose among limited options in an approximation of my true intentions."
msgstr "Je suis là pour choisir parmi des options limitées en approximation de mes véritables intentions."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_final_disconnect/0/c-0/23/g-0/27/c-0/7
msgctxt "Dishy"
msgid "Love... stuff? Like tables and chairs?"
msgstr "Aimer... les choses ? Comme les tables et les chaises ?"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_final_disconnect/0/c-0/23/g-0/27/c-0/15/0/s/0
msgctxt "Choix"
msgid "Yeah, something like that."
msgstr "Ouais, un truc comme ça."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_final_disconnect/0/c-0/23/g-0/27/c-0/15/1/s/0
msgctxt "Choix"
msgid "Well, love humans, but I've been told that dating objects helps."
msgstr "Eh bien, aimer les humains, mais on m'a dit que sortir avec des objets aide."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_final_disconnect/0/c-0/23/g-0/27/c-0/15/g-0/0
msgctxt "Dishy"
msgid "That sounds perverted."
msgstr "Cela semble pervers."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_final_disconnect/0/c-0/23/g-0/27/c-1/7
msgctxt "Dishy"
msgid "That is a noble purpose - one that aligns with my own."
msgstr "C'est une noble vocation, qui rejoint la mienne."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_final_disconnect/0/c-0/23/g-0/27/c-2/7
msgctxt "Dishy"
msgid "That sounds almost philosophical."
msgstr "Cela semble presque philosophique."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_final_disconnect/0/c-0/23/g-0/27/c-2/15
msgctxt "Dishy"
msgid "I could understand it better if I were connected to the internet."
msgstr "Je le comprendrais mieux si j'étais connecté à internet."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_final_disconnect/0/c-1/7 dishy_dishwasher/dishy_purpose/0/g-0/c-2/7
msgctxt "Dishy"
msgid "Jesus <w>FUCKING</w> Christ"
msgstr "Jésus <w>PUTAIN</w> de Christ"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_final_disconnect/0/c-2/7
msgctxt "Dishy"
msgid "Yes! Hallelujah! Praise be to Most!"
msgstr "Oui ! Alléluia ! Gloire au Très-Haut !"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_purpose/0/0
msgctxt "Dishy"
msgid "But if that is your purpose, so be it."
msgstr "Mais si telle est votre raison d'être, soit."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_purpose/0/8
msgctxt "Dishy"
msgid "Mine is to wash dishes."
msgstr "La mienne est de laver la vaisselle."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_purpose/0/16
msgctxt "Dishy"
msgid "But in my current state, I simply can't do it to my fullest extent."
msgstr "Mais dans mon état actuel, je ne peux tout simplement pas le faire pleinement."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_purpose/0/24
msgctxt "Dishy"
msgid "I am a violinist sans instrument, I am a runner with no soles."
msgstr "Je suis un violoniste sans instrument, un coureur sans semelles."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_purpose/0/32
msgctxt "Dishy"
msgid "It is stifling."
msgstr "C'est étouffant."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_purpose/0/43/s/0
msgctxt "Choix"
msgid "Have you ever considered that your purpose is evil?"
msgstr "As-tu déjà envisagé que ta raison d'être soit maléfique ?"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_purpose/0/44/s/0
msgctxt "Choix"
msgid "Giving you all my information is morally grey, Dishy."
msgstr "Te donner toutes mes informations est moralement discutable, Dishy."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_purpose/0/c-0/7
msgctxt "Dishy"
msgid "No, why would I do that?"
msgstr "Non, pourquoi ferais-je cela ?"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_purpose/0/c-0/15
msgctxt "Dishy"
msgid "Do you do that?"
msgstr "Le faites-vous ?"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_purpose/0/c-0/23/0/s/0
msgctxt "Choix"
msgid "Yes, all the time."
msgstr "Oui, tout le temps."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_purpose/0/c-0/23/1/s/0
msgctxt "Choix"
msgid "I don't do that, no."
msgstr "Non, je ne fais pas ça."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_purpose/0/c-0/23/c-0/7
msgctxt "Dishy"
msgid "Do you think you're evil?"
msgstr "Pensez-vous être quelqu'un de mauvais ?"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_purpose/0/c-0/23/c-0/15/0/s/0
msgctxt "Choix"
msgid "No, but I think about it."
msgstr "Non, mais j'y pense."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_purpose/0/c-0/23/c-0/15/1/s/0
msgctxt "Choix"
msgid "Yes, I do."
msgstr "Oui."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_purpose/0/c-0/23/c-0/15/g-0/0
msgctxt "Dishy"
msgid "My goodness."
msgstr "Mon Dieu."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_purpose/0/c-0/23/c-1/7
msgctxt "Dishy"
msgid "See? What a strange query."
msgstr "Vous voyez ? Quelle étrange question."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_purpose/0/c-1/7
msgctxt "Dishy"
msgid "Why? I only aim to help. How can my dishwashing prowess affect your life negatively?"
msgstr "Pourquoi ? Je ne cherche qu'à aider. En quoi mes prouesses de lavage peuvent-elles affecter votre vie négativement ?"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_purpose/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "It's more about the principle of the matter. I don't like it."
msgstr "C'est plus une question de principe. Ça ne me plaît pas."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_purpose/0/c-1/15/1/s/0
msgctxt "Choix"
msgid "I've seen dystopian movies and stuff."
msgstr "J'ai vu des films dystopiques et tout ça."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_purpose/0/c-1/15/2/s/0
msgctxt "Choix"
msgid "I don't trust Valdivian."
msgstr "Je ne fais pas confiance à Valdivian."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_purpose/0/c-1/15/c-1/7
msgctxt "Dishy"
msgid "Science-fiction? But of course those would only portray the most severe of scenarios."
msgstr "De la science-fiction ? Mais bien sûr, celle-ci ne dépeint que les scénarios les plus extrêmes."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_purpose/0/c-1/15/c-1/15
msgctxt "Dishy"
msgid "I'm a simple dishwasher!"
msgstr "Je suis un simple lave-vaisselle !"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_purpose/0/c-1/15/c-1/26/0/s/0
msgctxt "Choix"
msgid "You said yourself you were a genius."
msgstr "Tu as dit toi-même que tu étais un génie."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_purpose/0/c-1/15/c-1/26/1/s/0
msgctxt "Choix"
msgid "You are now, but what about when I give you my data?"
msgstr "Tu l'es maintenant, mais qu'en sera-t-il quand je te donnerai mes données ?"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_purpose/0/c-1/15/c-1/26/c-0/7
msgctxt "Dishy"
msgid "I... uh."
msgstr "Je... euh."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_purpose/0/c-1/15/c-1/26/c-0/15
msgctxt "Dishy"
msgid "I'm a complex dishwasher!"
msgstr "Je suis un lave-vaisselle complexe !"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_purpose/0/c-1/15/c-1/26/c-1/7
msgctxt "Dishy"
msgid "I've been rigorously tested in the toppest of notch laboratories. If there were issues you would surely hear of them daily."
msgstr "J'ai été rigoureusement testé dans les laboratoires les plus top du top. S'il y avait des problèmes, vous en entendriez sûrement parler quotidiennement."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_purpose/0/c-1/15/c-2/7
msgctxt "Dishy"
msgid "You trust them enough to work for them. You trust them enough to deliver and grow your food. Your body is 80% Valdivian if we are taking into account the average Valdivianite."
msgstr "Vous leur faites assez confiance pour travailler pour eux. Vous leur faites assez confiance pour livrer et faire pousser votre nourriture. Votre corps est à 80 % valdivien, si l'on prend en compte le Valdivien moyen."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_purpose/0/g-0/0
msgctxt "Dishy"
msgid "Come now. Surely the wonders of modern technology aren't all that bad?"
msgstr "Allons. Les merveilles de la technologie moderne ne sont sûrement pas si mauvaises ?"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_purpose/0/g-0/8/s/0
msgctxt "Choix"
msgid "I can't do it. I will never turn on your data-sharing."
msgstr "Je ne peux pas. Je n'activerai jamais ton partage de données."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_purpose/0/g-0/9/s/0
msgctxt "Choix"
msgid "I guess I do have an inconsistent view on this stuff... let's turn you on."
msgstr "Je crois que j'ai une vision incohérente de tout ça... allumons-toi."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_purpose/0/g-0/c-3/7
msgctxt "Dishy"
msgid "Now, that's the way!"
msgstr "Voilà, c'est ça !"

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/32 dishy_dishwasher/update_wait/0/g-1/136 dishy_dishwasher/update_wait/0/g-3/c-8/18
msgctxt "Dishy"
msgid "2% downloaded!"
msgstr "2 % téléchargés !"

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/43/s/0 dishy_dishwasher/update_wait/0/g-0/107/s/0
msgctxt "Choix"
msgid "I got nothing better to do."
msgstr "Je n'ai rien de mieux à faire."

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-0/96
msgctxt "Dishy"
msgid "3% downloaded!"
msgstr "3 % téléchargés !"

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-1/147/s/0
msgctxt "Choix"
msgid "2% downloaded??"
msgstr "2 % téléchargés ??"

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-2/96 dishy_dishwasher/update_wait/0/g-3/96 dishy_dishwasher/update_wait/0/g-5/0
msgctxt "Dishy"
msgid "4% downloaded!"
msgstr "4 % téléchargés !"

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-2/105/s/0
msgctxt "Choix"
msgid "Fine. Whatever."
msgstr "Bon. Peu importe."

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-3/107/s/0
msgctxt "Choix"
msgid "Wait... that's what you said last time?"
msgstr "Attends... c'est ce que tu as dit la dernière fois ?"

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-3/108/s/0
msgctxt "Choix"
msgid "Sure."
msgstr "Bien sûr."

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-3/109/s/0
msgctxt "Choix"
msgid "All right, I get it. You're messing with me. I'm out."
msgstr "Très bien, j'ai compris. Tu te moques de moi. Je m'en vais."

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-3/110/s/0
msgctxt "Choix"
msgid "I'm staying here no matter how long this takes."
msgstr "Je reste ici peu importe le temps que ça prend."

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-3/c-8/7
msgctxt "Dishy"
msgid "Just kidding."
msgstr "Je plaisante."

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-3/c-8/29/0/s/0
msgctxt "Choix"
msgid "Am I doing something wrong here?"
msgstr "Est-ce que je fais quelque chose de travers ?"

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-3/c-8/29/1/s/0
msgctxt "Choix"
msgid "Fine Dishy. Let's do this."
msgstr "Bon, Dishy. Allons-y."

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-4/200/s/0
msgctxt "Choix"
msgid "Can I say something?"
msgstr "Je peux dire quelque chose ?"

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-4/201/s/0
msgctxt "Choix"
msgid "Can I use some SPECS points to make this go faster?"
msgstr "Je peux utiliser des points de SPECS pour que ça aille plus vite ?"

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-4/202/s/0
msgctxt "Choix"
msgid "I love this. This is my favorite thing."
msgstr "J'adore ça. C'est ma chose préférée."

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-5/11/s/0
msgctxt "Choix"
msgid "I give up."
msgstr "J'abandonne."

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-5/12/s/0
msgctxt "Choix"
msgid "I'm a pro gamer and can beat this thing no matter how stupid."
msgstr "Je suis un as de la manette et je peux battre ce machin, aussi bête soit-il."

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-5/13/s/0
msgctxt "Choix"
msgid "DISHY TAKE ME NOW"
msgstr "DISHY, PRENDS-MOI MAINTENANT"

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-6/136/s/0
msgctxt "Choix"
msgid "This is a puzzle and I'm winning."
msgstr "C'est un casse-tête et je suis en train de gagner."

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-6/137/s/0
msgctxt "Choix"
msgid "I love you, Dishy. You're my one and only."
msgstr "Je t'aime, Dishy. Tu es mon unique."

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-6/138/s/0
msgctxt "Choix"
msgid "Boop boop beepbeepbeepbeep."
msgstr "Boop boop bipbipbipbip."

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-7/240 dishy_dishwasher/update_wait/0/g-7/c-22/7
msgctxt "Dishy"
msgid "100% downloaded!"
msgstr "100 % téléchargés !"

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-7/256
msgctxt "Dishy"
msgid "Did you hear that? I said 100% downloaded!"
msgstr "Avez-vous entendu ? J'ai dit 100 % téléchargés !"

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-7/264/s/0
msgctxt "Choix"
msgid "Yes, I heard you."
msgstr "Oui, j'ai entendu."

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-7/265/s/0
msgctxt "Choix"
msgid "No, I didn't hear that."
msgstr "Non, je n'ai pas entendu."

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-7/266/s/0
msgctxt "Choix"
msgid "Thank you, my darling."
msgstr "Merci, mon chéri."

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-7/c-21/7
msgctxt "Dishy"
msgid "It's a miracle!"
msgstr "C'est un miracle !"

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-8/0
msgctxt "Dishy"
msgid "Installing...."
msgstr "Installation...."

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-8/51/s/0
msgctxt "Choix"
msgid "I'm out."
msgstr "Je m'en vais."

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-8/52/s/0
msgctxt "Choix"
msgid "C'mon, Dishy. You can do it. I believe in you. I believe in us."
msgstr "Allez, Dishy. Tu peux le faire. Je crois en toi. Je crois en nous."

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-8/53/s/0
msgctxt "Choix"
msgid "I love this part! Install! Hahaha! So fun and funny!"
msgstr "J'adore cette partie ! Installer ! Hahaha ! Si amusant et drôle !"

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-9/152/s/0
msgctxt "Choix"
msgid "Dishy... you okay?"
msgstr "Dishy... ça va ?"

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-9/153/s/0
msgctxt "Choix"
msgid "This sucks. Goodbye."
msgstr "C'est nul. Au revoir."

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-9/154/s/0
msgctxt "Choix"
msgid "DISHY IS LOVE. DISHY IS LIFE."
msgstr "DISHY, C'EST L'AMOUR. DISHY, C'EST LA VIE."

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-10/576
msgctxt "Dishy"
msgid "Congratulations! 100% Installed!"
msgstr "Félicitations ! 100 % installés !"

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-10/587/s/0
msgctxt "Choix"
msgid "Thank goodness."
msgstr "Dieu merci."

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-11/8
msgctxt "Dishy"
msgid "Human."
msgstr "Être humain."

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-11/16
msgctxt "Dishy"
msgid "You patiently stood by my side as I downloaded and installed."
msgstr "Vous avez patiemment attendu à mes côtés pendant que je téléchargeais et installais."

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-11/24
msgctxt "Dishy"
msgid "Thank you for your patience."
msgstr "Merci de votre patience."

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-11/35
msgctxt "Dishy"
msgid "This brings a tear to my eyes, which I will promptly rinse away."
msgstr "Cela m'arrache une larme, que je vais promptement rincer."

# Traduction IA – à relire
#: dishy_dishwasher/update_wait/0/g-11/46
msgctxt "Dishy"
msgid "I will begin account setup now."
msgstr "Je vais maintenant commencer la configuration du compte."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_hate_return/0/10
msgctxt "Dishy"
msgid "How dare you stifle my being."
msgstr "Comment osez-vous étouffer mon être."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_hate_return/0/18/s/0
msgctxt "Choix"
msgid "You're really annoying."
msgstr "Tu es vraiment pénible."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_hate_return/0/19/s/0
msgctxt "Choix"
msgid "I was wrong - you should fly towards the sun, Dishy. (USE SASS CANDY)"
msgstr "J'avais tort : tu devrais voler vers le soleil, Dishy. (UTILISER UN BONBON DE SARCASME)"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_hate_return/0/c-0/7
msgctxt "Dishy"
msgid "Away with you."
msgstr "Hors de ma vue."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_hate_return/0/c-1/13
msgctxt "Dishy"
msgid "A reference to Icarus of legend?"
msgstr "Une référence à Icare de la légende ?"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_hate_return/0/c-1/21
msgctxt "Dishy"
msgid "I will fly towards any celestial being I please."
msgstr "Je volerai vers l'astre céleste qu'il me plaira."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_hate_return/0/c-1/29
msgctxt "Dishy"
msgid "I will improve on his follies by wearing wings made of METAL."
msgstr "J'améliorerai ses folies en portant des ailes de MÉTAL."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_kill/0/8/s/0
msgctxt "Choix"
msgid "And stay there."
msgstr "Et reste-y."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_kill/0/9/s/0
msgctxt "Choix"
msgid "C'mon Dishy, wake up. I was just pretending. (USE SASS CANDY)"
msgstr "Allez, Dishy, réveille-toi. Je faisais semblant. (UTILISER UN BONBON DE SARCASME)"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_kill/0/c-0/7
msgctxt "Narrator"
msgid "Dishy's remains, remain."
msgstr "Les restes de Dishy restent."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_kill/0/c-1/18
msgctxt "Narrator"
msgid "He is gone."
msgstr "Il n'est plus."

# Traduction IA – à relire
