#: penelope_stationery/penelope_hate_return/0/c-1/7
msgctxt "Penelope"
msgid "I've always said that though!"
msgstr ""

#: penelope_stationery/penelope_hate_return/0/c-1/15
msgctxt "Penelope"
msgid "We SHOULD be friends!"
msgstr ""

#: penelope_stationery/penelope_hate_return/0/c-1/23
msgctxt "Penelope"
msgid "God I'm just so relieved... hating you sucked big time!"
