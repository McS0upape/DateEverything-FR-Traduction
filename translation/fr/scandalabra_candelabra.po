msgstr "On est amis... tu te souviens ?"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_false_love_return/0/9/s/0
msgctxt "Choix"
msgid "I'm back!"
msgstr "Je suis de retour !"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_false_love_return/0/g-0/0
msgctxt "Scandalabra"
msgid "My lovely labra twitch and twirl in anticipation of another sensuous kiss!"
msgstr "Mes doux labra frémissent et tournoient dans l'attente d'un autre baiser sensuel !"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_false_love_return/0/g-0/11
msgctxt "Scandalabra"
msgid "Would you like me to be astonished at the <w>SCANDAL</w> you raise in this housedom?"
msgstr "Voudrais-tu que je m'étonne du <w>SCANDALE</w> que tu soulèves dans ce logis ?"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_false_love_return/0/g-0/19/s/0
msgctxt "Choix"
msgid "Actually, I'm okay!"
msgstr "Finalement, ça ira !"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_false_love_return/0/g-0/20/s/0
msgctxt "Choix"
msgid "Oh you know I love it when you ejaculate so."
msgstr "Oh, tu sais combien j'adore quand tu éjacules de la sorte."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_false_love_return/0/g-0/21/s/0
msgctxt "Choix"
msgid "I'm ready to Realize you, Scandalabra."
msgstr "Je suis {{prêt|prête|prêt·e}} à te Réaliser, Scandalabra."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_false_love_return/0/g-0/22/s/0 scandalabra_candelabra/exhortation_top/0/10/s/0
msgctxt "Choix"
msgid "Actually there's a new scandal - Maggie has some questions for you."
msgstr "En fait, il y a un nouveau scandale : Maggie a quelques questions pour toi."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_false_love_return/0/g-0/c-2/7
msgctxt "Scandalabra"
msgid "Hmmm.... anticipation eh? I know the feeling."
msgstr "Hmmm.... l'attente, hein ? Je connais ça."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_false_love_return/0/g-0/c-2/15
msgctxt "Scandalabra"
msgid "Swell till turgid... then burst!"
msgstr "Enfler jusqu'à la turgescence... puis éclater !"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_false_love_return/0/g-0/c-3/7
msgctxt "Scandalabra"
msgid "Oh indeed! On we go my sweet!"
msgstr "Oh, certainement ! En avant, mon trésor !"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_false_love_return/0/g-0/c-4/10
msgctxt "Scandalabra"
msgid "Leaving? Why... I have some..."
msgstr "Tu pars ? Mais... j'ai quelques..."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_false_love_return/0/g-0/c-4/18
msgctxt "Scandalabra"
msgid "Unfurnished Business of my own to take care of..."
msgstr "Affaires à démeubler qui me sont propres..."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_false_love_return/0/g-0/c-4/26/0/s/0
msgctxt "Choix"
msgid "What do you still need to do?"
msgstr "Que te reste-t-il encore à faire ?"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_false_love_return/0/g-0/c-4/26/c-0/7
msgctxt "Scandalabra"
msgid "A lady never tells..."
msgstr "Une dame ne dit jamais rien..."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_false_love_return/0/g-0/c-5/7 scandalabra_candelabra/exhortation_top/0/c-2/7
msgctxt "Scandalabra"
msgid "Ha! Let us see what the glass will magnify!"
msgstr "Ha ! Voyons ce que la loupe va grossir !"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_friend_return/0/4
msgctxt "Scandalabra"
msgid "Ah yes, I have done it!"
msgstr "Ah oui, j'y suis arrivé !"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_friend_return/0/12
msgctxt "Scandalabra"
msgid "Well done Jonathan you cad."
msgstr "Bien joué, Jonathan, fripouille."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_friend_return/0/20/s/0
msgctxt "Choix"
msgid "Am I barging in on something again?"
msgstr "Je dérange encore quelque chose ?"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_friend_return/0/21/s/0
msgctxt "Choix"
msgid "Jonathan?"
msgstr "Jonathan ?"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_friend_return/0/g-0/0
msgctxt "Scandalabra"
msgid "Oh, it's you!"
msgstr "Oh, c'est toi !"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_friend_return/0/g-0/8
msgctxt "Scandalabra"
msgid "My 'friend'!"
msgstr "« {{Mon ami|Mon amie|Mon ami·e}} » !"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_friend_return/0/g-0/16
msgctxt "Scandalabra"
msgid "We are friends."
msgstr "Nous sommes amis."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_friend_return/0/g-0/24
msgctxt "Scandalabra"
msgid "Very good friends I might add."
msgstr "De très bons amis, d'ailleurs."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_friend_return/0/g-0/32/s/0
msgctxt "Choix"
msgid "What's with the mystery?"
msgstr "C'est quoi, ce mystère ?"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_friend_return/0/g-0/33/s/0
msgctxt "Choix"
msgid "You sound insane."
msgstr "Tu as l'air complètement dingue."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_friend_return/0/g-1/0
msgctxt "Scandalabra"
msgid "I am a master of relationships, you see. But even a master needs his tools."
msgstr "Je suis un maître des relations, vois-tu. Mais même un maître a besoin de ses outils."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_friend_return/0/g-1/8
msgctxt "Scandalabra"
msgid "I have procured one 'date-a-dex' for mineself, and egad the functionality is fecund!"
msgstr "Je me suis procuré un « date-a-dex » pour moi-même, et palsambleu, quelle fonctionnalité féconde !"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_friend_return/0/g-1/16
msgctxt "Scandalabra"
msgid "I have you in here, see for yourself!"
msgstr "Je t'y ai mis, vois par toi-même !"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_friend_return/0/g-1/27
msgctxt "Scandalabra"
msgid "So much more to go, but I quite love filling in all the little bubbles and baubles!"
msgstr "Il en reste tant à découvrir, mais j'adore remplir toutes ces petites bulles et breloques !"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_friend_return/0/g-1/35
msgctxt "Scandalabra"
msgid "Now that we are friends indeed, you must must show me yours, since I showed you mine."
msgstr "Maintenant que nous sommes bel et bien amis, tu dois absolument me montrer le tien, puisque je t'ai montré le mien."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_friend_return/0/g-1/43/s/0
msgctxt "Choix"
msgid "Okay, sounds fun!"
msgstr "D'accord, ça a l'air marrant !"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_friend_return/0/g-1/44/s/0
msgctxt "Choix"
msgid "No, please don't do that."
msgstr "Non, s'il te plaît, ne fais pas ça."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_friend_return/0/shonuff/4
msgctxt "Scandalabra"
msgid "What! I thought... well yes it says right here!"
msgstr "Quoi ! Je croyais... enfin si, c'est écrit juste là !"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_friend_return/0/shonuff/12
msgctxt "Scandalabra"
msgid "FRIENDS!"
msgstr "AMIS !"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_friend_return/0/shonuff/20
msgctxt "Scandalabra"
msgid "Is that... simply not true?"
msgstr "Est-ce... tout simplement faux ?"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_friend_return/0/shonuff/28/s/0
msgctxt "Choix"
msgid "It's not true. I'm not comfortable with this."
msgstr "C'est faux. Je ne suis pas à l'aise avec ça."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_friend_return/0/shonuff/29/s/0
msgctxt "Choix"
msgid "My mistake, here is my date-a-dex."
msgstr "Mon erreur, voici mon date-a-dex."

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_friend_return/0/shonuff/c-6/7
msgctxt "Scandalabra"
msgid "Then I am no longer comfortable with you!"
msgstr "Alors moi, je ne suis plus à l'aise avec toi !"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_friend_return/0/shonuff/c-6/18
msgctxt "Scandalabra"
msgid "I am stricken! From engaging in delightful little clandestine candelabra capers, to denying me a chance to even peek at your history!"
msgstr "Je suis anéanti ! De délicieuses petites cabrioles clandestines de candélabre... à me refuser même un coup d'oeil sur ton passé !"

# Traduction IA – à relire
#: scandalabra_candelabra/scandalabra_friend_return/0/shonuff/c-6/26/0/s/0
msgctxt "Choix"
msgid "It's over, Scandalabra."
msgstr "C'est fini, Scandalabra."

