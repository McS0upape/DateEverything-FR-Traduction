# Traduction IA – à relire
#: doug_dread/1
msgctxt "Tag Nom d'objet (MAJUSCULES)"
msgid "EXISTENTIAL DREAD"
msgstr "ANGOISSE EXISTENTIELLE"

# Traduction IA – à relire
#: doug_dread/skylar_doug_content/0/3
msgctxt "Skylar"
msgid "Hang on! My Content Aware is going off!"
msgstr "Attends ! Mon Alerte Contenu se déclenche !"

# Traduction IA – à relire
#: doug_dread/skylar_doug_content/0/14
msgctxt "Skylar"
msgid "Doug is a bit of an abusive dude. If you have any issues with constant aggression from someone, I'd recommend skipping him."
msgstr "Doug est un peu un mec violent. Si une agressivité constante de la part de quelqu'un te pose problème, je te conseille de l'éviter."

# Traduction IA – à relire
#: doug_dread/skylar_doug_content/0/25
msgctxt "Skylar"
msgid "You cool with that? Or you want to skip it?"
msgstr "Ça te va ? Ou tu préfères passer ?"

# Traduction IA – à relire
#: doug_dread/skylar_doug_content/0/36/s/0
msgctxt "Choix"
msgid "Let's skip it please!"
msgstr "Passons, s'il te plaît !"

# Traduction IA – à relire
#: doug_dread/skylar_doug_content/0/37/s/0
msgctxt "Choix"
msgid "No, I'm okay with this type of stuff."
msgstr "Non, ce genre de truc ne me dérange pas."

# Traduction IA – à relire
#: doug_dread/skylar_doug_content/0/c-0/16
msgctxt "Skylar"
msgid "No worries - hey, Doug!"
msgstr "Pas de souci. Hé, Doug !"

# Traduction IA – à relire
#: doug_dread/skylar_doug_content/0/c-0/35
msgctxt "Narrator"
msgid "How would you like your relationship with Doug to resolve?"
msgstr "Comment souhaiteriez-vous que votre relation avec Doug se termine ?"

# Traduction IA – à relire
#: doug_dread/skylar_doug_content/0/c-0/40/0/s/0
msgctxt "Choix"
msgid "Love!"
msgstr "Amour !"

# Traduction IA – à relire
#: doug_dread/skylar_doug_content/0/c-0/40/1/s/0
msgctxt "Choix"
msgid "Friendship!"
msgstr "Amitié !"

# Traduction IA – à relire
#: doug_dread/skylar_doug_content/0/c-0/40/2/s/0
msgctxt "Choix"
msgid "Hate!"
msgstr "Haine !"

# Traduction IA – à relire
#: doug_dread/skylar_doug_content/0/c-0/40/c-0/7
msgctxt "Narrator"
msgid "From his face you can clearly see Doug's endless understanding. You are now lovers."
msgstr "Sur son visage, on lit clairement l'infinie compréhension de Doug. Vous voilà amants."

# Traduction IA – à relire
#: doug_dread/skylar_doug_content/0/c-0/40/c-0/15
msgctxt "Skylar"
msgid "It's love!"
msgstr "C'est l'amour !"

# Traduction IA – à relire
#: doug_dread/skylar_doug_content/0/c-0/40/c-0/35 doug_dread/skylar_doug_content/0/c-0/40/c-1/35 doug_dread/skylar_doug_content/0/c-0/40/c-2/35
msgctxt "Skylar"
msgid "See you out there on the next one!"
msgstr "On se retrouve dehors pour la prochaine !"

# Traduction IA – à relire
#: doug_dread/skylar_doug_content/0/c-0/40/c-1/7
msgctxt "Narrator"
msgid "From his face you can clearly see Doug's endless understanding. You are now friends."
msgstr "Sur son visage, on lit clairement l'infinie compréhension de Doug. Vous voilà amis."

# Traduction IA – à relire
#: doug_dread/skylar_doug_content/0/c-0/40/c-1/15
msgctxt "Skylar"
msgid "Aww... friends forever."
msgstr "Aww... amis pour la vie."

# Traduction IA – à relire
#: doug_dread/skylar_doug_content/0/c-0/40/c-2/7
msgctxt "Narrator"
msgid "From his face you can clearly see Doug's endless understanding. You are now enemies."
msgstr "Sur son visage, on lit clairement l'infinie compréhension de Doug. Vous voilà ennemis."

# Traduction IA – à relire
#: doug_dread/skylar_doug_content/0/c-0/40/c-2/15
msgctxt "Skylar"
msgid "Enjoy your... hateship."
msgstr "Profite de ton... inimitié."

# Traduction IA – à relire
#: doug_dread/skylar_doug_content/0/c-0/40/c-2/68 doug_dread/doug_hate_ending/82
msgctxt "Reggie"
msgid "Seems Doug isn't the only one capable of filling others with a feeling of dread!"
msgstr "On dirait que Doug n'est pas le seul à pouvoir remplir les autres d'un sentiment d'angoisse !"

# Traduction IA – à relire
#: doug_dread/skylar_doug_content/0/c-0/40/c-2/76 doug_dread/doug_hate_ending/90
msgctxt "Reggie"
msgid "That took some skill, gotta say."
msgstr "Il y avait du talent là-dedans, faut le dire."

# Traduction IA – à relire
#: doug_dread/skylar_doug_content/0/c-1/7
msgctxt "Skylar"
msgid "Carry on, then!"
msgstr "Continue, alors !"

# Traduction IA – à relire
#: doug_dread/artt_doug_friend_return_dougside/0/0
msgctxt "Doug"
msgid "Oh wowee gee!"
msgstr "Oh waouh, ça alors !"

# Traduction IA – à relire
#: doug_dread/artt_doug_friend_return_dougside/0/8
msgctxt "Doug"
msgid "Hey, Artt, it's our best friend!"
msgstr "Hé, Artt, c'est notre {{meilleur ami|meilleure amie|meilleur·e ami·e}} !"

# Traduction IA – à relire
#: doug_dread/artt_doug_friend_return_dougside/0/22
msgctxt "Artt"
msgid "That was better, Doug. I think you're improving!"
msgstr "C'était mieux, Doug. Je crois que tu progresses !"

# Traduction IA – à relire
#: doug_dread/artt_doug_friend_return_dougside/0/30
msgctxt "Doug"
msgid "The things you do for love."
msgstr "Ce qu'on ne fait pas par amour."

# Traduction IA – à relire
#: doug_dread/artt_doug_friend_return_dougside/0/38/s/0
msgctxt "Choix"
msgid "You guys are very cute together."
msgstr "Vous êtes trop mignons ensemble."

# Traduction IA – à relire
#: doug_dread/artt_doug_friend_return_dougside/0/39/s/0 doug_dread/artt_doug_love_return_dougside/0/18/s/0
msgctxt "Choix"
msgid "I'm ready to Realize you both!"
msgstr "Je suis {{prêt|prête|prêt·e}} à vous Réaliser tous les deux !"

# Traduction IA – à relire
#: doug_dread/artt_doug_friend_return_dougside/0/c-0/7
msgctxt "Doug"
msgid "I'm the cute one."
msgstr "C'est moi, le mignon."

# Traduction IA – à relire
#: doug_dread/artt_doug_friend_return_dougside/0/c-0/15
msgctxt "Artt"
msgid "It's his nose, I think. Like a little button."
msgstr "C'est son nez, je crois. Comme un petit bouton."

# Traduction IA – à relire
#: doug_dread/artt_doug_friend_return_dougside/0/c-0/23
msgctxt "Doug"
msgid "A really little button."
msgstr "Un tout petit bouton."

# Traduction IA – à relire
#: doug_dread/artt_doug_love_return_dougside/0/0
msgctxt "Doug"
msgid "Hello, I'm so in love with you."
msgstr "Salut, je suis tellement amoureux de toi."

# Traduction IA – à relire
#: doug_dread/artt_doug_love_return_dougside/0/8
msgctxt "Doug"
msgid "Artt wrote a song about our love, you know."
msgstr "Artt a écrit une chanson sur notre amour, tu sais."

# Traduction IA – à relire
#: doug_dread/artt_doug_love_return_dougside/0/16/s/0
msgctxt "Choix"
msgid "Can I hear it?"
msgstr "Je peux l'entendre ?"

# Traduction IA – à relire
#: doug_dread/artt_doug_love_return_dougside/0/17/s/0
msgctxt "Choix"
msgid "Just saying hi to my two favorite lovers..."
msgstr "Je dis juste bonjour à mes deux amoureux préférés..."

# Traduction IA – à relire
#: doug_dread/artt_doug_love_return_dougside/0/c-0/7
msgctxt "Doug"
msgid "What do you think?"
msgstr "Alors, t'en penses quoi ?"

# Traduction IA – à relire
#: doug_dread/artt_doug_love_return_dougside/0/c-0/15
msgctxt "Narrator"
msgid "You can't."
msgstr "Vous ne pouvez pas."

# Traduction IA – à relire
#: doug_dread/artt_doug_love_return_dougside/0/c-1/7
msgctxt "Doug"
msgid "I've been watching some videos where corpses get exhumed."
msgstr "Je regarde des vidéos où on exhume des cadavres."

# Traduction IA – à relire
#: doug_dread/artt_doug_love_return_dougside/0/c-1/15
msgctxt "Doug"
msgid "Do you know what the word 'exhumed' means?"
msgstr "Tu sais ce que veut dire « exhumer » ?"

# Traduction IA – à relire
#: doug_dread/artt_doug_love_return_dougside/0/c-1/23
msgctxt "Artt"
msgid "Doug! Is the human there?"
msgstr "Doug ! L'humain·e est là ?"

# Traduction IA – à relire
#: doug_dread/artt_doug_love_return_dougside/0/c-1/28
msgctxt "Doug"
msgid "Gotta go. Nerd alert."
msgstr "Faut que j'y aille. Alerte nerd."

# Traduction IA – à relire
#: doug_dread/doug_artt_realize_return_dougside/0/3
msgctxt "Doug"
msgid "Oh, you're back. With the whole 'bringing us to life thing.'"
msgstr "Oh, te revoilà. Avec ton truc de « nous donner vie »."

# Traduction IA – à relire
#: doug_dread/doug_artt_realize_return_dougside/0/17
msgctxt "Artt"
msgid "It's called Realization and it's wonderful!"
msgstr "Ça s'appelle la Réalisation, et c'est merveilleux !"

# Traduction IA – à relire
#: doug_dread/doug_artt_realize_return_dougside/0/25
msgctxt "Artt"
msgid "Do you have the right doohickeys and hobnobs?"
msgstr "Tu as les bons bidules et les bons machins ?"

# Traduction IA – à relire
#: doug_dread/doug_artt_realize_return_dougside/0/45/s/0
msgctxt "Choix"
msgid "I certainly do!"
msgstr "Bien sûr !"

# Traduction IA – à relire
#: doug_dread/doug_artt_realize_return_dougside/0/46/s/0
msgctxt "Choix"
msgid "Still need to get more hinkers and blinkers."
msgstr "Il me faut encore des trucmuches et des zinzins."

# Traduction IA – à relire
#: doug_dread/doug_artt_realize_return_dougside/0/c-1/16
msgctxt "Doug"
msgid "Get on it, son."
msgstr "Alors bouge-toi."

# Traduction IA – à relire
#: doug_dread/stepford_doug/0/12
msgctxt "Doug"
msgid "You look like you want to ask me something profound or some shit."
msgstr "Tu as l'air de vouloir me poser une question profonde ou un truc du genre."

# Traduction IA – à relire
#: doug_dread/stepford_doug/0/20/s/0
msgctxt "Choix"
msgid "Can I have a fact about existential dread?"
msgstr "Je peux avoir un fait sur l'angoisse existentielle ?"

# Traduction IA – à relire
#: doug_dread/stepford_doug/0/c-0/7 doug_dread/doug_encounter2/0/g-12/c-41/29/c-2/7
msgctxt "Doug"
msgid "Sure."
msgstr "Bien sûr."

# Traduction IA – à relire
#: doug_dread/stepford_doug/0/c-0/15
msgctxt "Doug"
msgid "The two schools of philosophical thought that oppose Existentialism are Positivism and Rationalism."
msgstr "Les deux courants de pensée philosophique qui s'opposent à l'existentialisme sont le positivisme et le rationalisme."

# Traduction IA – à relire
#: doug_dread/stepford_doug/0/c-0/23 doug_dread/doug_encounter1/0/g-4/24
msgctxt "Doug"
msgid "Dork."
msgstr "Nerd."

# Traduction IA – à relire
#: doug_dread/stepford_doug/0/c-0/31/0/s/0
msgctxt "Choix"
msgid "Thanks...?"
msgstr "Merci... ?"

# Traduction IA – à relire
#: doug_dread/stepford_doug/0/c-0/31/1/s/0
msgctxt "Choix"
msgid "Thank you, my love."
msgstr "Merci, mon amour."

# Traduction IA – à relire
#: doug_dread/stepford_doug/0/c-0/31/2/s/0
msgctxt "Choix"
msgid "What does that mean?"
msgstr "Ça veut dire quoi ?"

# Traduction IA – à relire
#: doug_dread/stepford_doug/0/c-0/31/c-0/7
msgctxt "Doug"
msgid "You're welcome."
msgstr "De rien."

# Traduction IA – à relire
#: doug_dread/stepford_doug/0/c-0/31/c-1/7
msgctxt "Doug"
msgid "Ugh whatever."
msgstr "Pfff, peu importe."

# Traduction IA – à relire
#: doug_dread/stepford_doug/0/c-0/31/c-2/7
msgctxt "Doug"
msgid "Who cares what it means."
msgstr "Qui se soucie de ce que ça veut dire."

# Traduction IA – à relire
#: doug_dread/stepford_doug/0/c-0/31/c-2/15/0/s/0
msgctxt "Choix"
msgid "Stepford cares!"
msgstr "Stepford s'en soucie !"

# Traduction IA – à relire
#: doug_dread/stepford_doug/0/c-0/31/c-2/15/1/s/0
msgctxt "Choix"
msgid "I guess it doesn't matter."
msgstr "J'imagine que ça n'a pas d'importance."

# Traduction IA – à relire
#: doug_dread/stepford_doug/0/c-0/31/c-2/15/c-0/7
msgctxt "Doug"
msgid "Who is that."
msgstr "C'est qui, ça."

# Traduction IA – à relire
#: doug_dread/stepford_doug/0/c-0/31/c-2/15/c-0/15
msgctxt "Doug"
msgid "Never mind I already stopped caring."
msgstr "Laisse tomber, j'ai déjà arrêté de m'en soucier."

# Traduction IA – à relire
#: doug_dread/stepford_doug/0/c-0/31/c-2/15/c-0/23 doug_dread/stepford_doug/0/c-0/31/c-2/15/c-1/15 doug_dread/sudoku_leave/0/c-0/23/g-0/8/c-1/7 doug_dread/sudoku_quit/0/g-0/8
msgctxt "Doug"
msgid "Bye."
msgstr "Salut."

# Traduction IA – à relire
#: doug_dread/stepford_doug/0/c-0/31/c-2/15/c-1/7
msgctxt "Doug"
msgid "That's what I've been saying <i>this whole time</i>."
msgstr "C'est ce que je dis depuis <i>tout ce temps</i>."

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/6
msgctxt "Narrator"
msgid "An expanse of blinding white, muscled skin fills your vision—it reminds you of that class field trip to the art museum if not for the torn jeans on this ivory adonis's lower body."
msgstr "Une étendue de peau musclée d'un blanc aveuglant emplit votre champ de vision. Cela vous rappelle cette sortie scolaire au musée d'art, si ce n'étaient les jeans déchirés sur le bas du corps de cet adonis d'ivoire."

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/14
msgctxt "Narrator"
msgid "But as your eyes continue to travel up and take everything in, you note that the similarities to a classic marble statue come to an abrupt and screeching halt at this guy's face."
msgstr "Mais à mesure que votre regard remonte et enregistre tout, vous constatez que les ressemblances avec une statue de marbre classique s'arrêtent net, dans un crissement, au visage de ce type."

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/22
msgctxt "Narrator"
msgid "He almost resembles a bleached bowling ball; his eyes are two dark and unreadable holes, his mouth nothing more than a thin line. He has no nose, no cheekbones, no ears... his shining white face is simply devoid of just about anything."
msgstr "Il ressemble presque à une boule de bowling blanchie ; ses yeux sont deux trous sombres et indéchiffrables, sa bouche un simple trait. Il n'a ni nez, ni pommettes, ni oreilles... son visage blanc et luisant est tout simplement dépourvu de presque tout."

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/30/b/1
msgctxt "Doug"
msgid "Sup baby. Nice ass."
msgstr "Salut bébé. Joli cul."

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/31/b/1
msgctxt "Doug"
msgid "Sup baby. That's a fantastic red shirt you've got."
msgstr "Salut bébé. Elle est fantastique, ta chemise rouge."

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/31/b/9
msgctxt "Doug"
msgid "Glad it doesn't cover your sweet ass."
msgstr "Content qu'elle ne couvre pas ton joli cul."

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/34/s/0
msgctxt "Choix"
msgid "Excuse me?"
msgstr "Pardon ?"

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/35/s/0
msgctxt "Choix"
msgid "Oh! That’s so sweet!"
msgstr "Oh ! C'est trop gentil !"

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/36/s/0
msgctxt "Choix"
msgid "I work out."
msgstr "Je fais de la muscu."

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/c-0/13
msgctxt "Doug"
msgid "Naw I don’t think I will."
msgstr "Nan, je crois pas."

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/c-0/24/0/s/0
msgctxt "Choix"
msgid "Who do you think you are?"
msgstr "Pour qui tu te prends ?"

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/c-0/24/1/s/0
msgctxt "Choix"
msgid "What are you doing right now?"
msgstr "Tu fais quoi, là ?"

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/c-1/13
msgctxt "Doug"
msgid "Yeah well, don’t get used to it."
msgstr "Ouais bah, t'y fais pas."

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/c-1/21/0/s/0
msgctxt "Choix"
msgid "Who are you, mysterious stranger?"
msgstr "Qui es-tu, mystérieux inconnu ?"

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/c-1/21/1/s/0
msgctxt "Choix"
msgid "You come on strong. What's your deal?"
msgstr "Tu y vas fort. C'est quoi ton truc ?"

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/c-2/7
msgctxt "Doug"
msgid "Yeah well not enough."
msgstr "Ouais bah pas assez."

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/c-2/15/0/s/0
msgctxt "Choix"
msgid "Yeah my body dysmorphia agrees."
msgstr "Ouais, ma dysmorphie corporelle est d'accord."

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/c-2/15/c-0/7
msgctxt "Doug"
msgid "Yeah she would, wouldn't she?"
msgstr "Ouais, elle le serait, pas vrai ?"

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/c-2/15/c-0/15
msgctxt "Doug"
msgid "We haven't talked in a bit but last time I checked it's been real."
msgstr "On s'est pas parlé depuis un moment, mais la dernière fois que j'ai vérifié, c'était pour de vrai."

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/c-2/15/c-0/23/0/s/0
msgctxt "Choix"
msgid "Wait, what the hell are you talking about?"
msgstr "Attends, mais de quoi tu parles, bon sang ?"

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/c-2/15/c-0/23/1/s/0
msgctxt "Choix"
msgid "Who are you, anyway?"
msgstr "Et d'ailleurs, t'es qui ?"

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-0/0
msgctxt "Doug"
msgid "Yeesh. I gotta write a whole dissertation for you?"
msgstr "Pfff. Je dois te pondre une dissertation entière ?"

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-0/8
msgctxt "Doug"
msgid "You want some graphs and pie charts?"
msgstr "Tu veux des graphiques et des camemberts ?"

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-0/16
msgctxt "Doug"
msgid "Oooh how about some Venn diagrams?"
msgstr "Oooh, et si on faisait des diagrammes de Venn ?"

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-0/24
msgctxt "Doug"
msgid "Would that help you figure it out?"
msgstr "Ça t'aiderait à piger ?"

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-0/32/s/0
msgctxt "Choix"
msgid "Yes please!"
msgstr "Oui, s'il te plaît !"

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-0/33/s/0
msgctxt "Choix"
msgid "Maybe? Can I see the pie charts?"
msgstr "Peut-être ? Je peux voir les camemberts ?"

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-0/34/s/0
msgctxt "Choix"
msgid "I doubt it."
msgstr "J'en doute."

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-0/c-3/13
msgctxt "Doug"
msgid "Oh my <i>god</i>."
msgstr "Oh mon <i>dieu</i>."

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-0/c-3/21
msgctxt "Doug"
msgid "I was being facetious."
msgstr "Je faisais de l'ironie."

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-0/c-4/7
msgctxt "Doug"
msgid "I dunno, <i>can</i> you?"
msgstr "Je sais pas, t'en es <i>capable</i> ?"

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-0/c-4/15/0/s/0
msgctxt "Choix"
msgid "Yes?"
msgstr "Oui ?"

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-0/c-4/15/1/s/0
msgctxt "Choix"
msgid "No?"
msgstr "Non ?"

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-0/c-4/15/2/s/0
msgctxt "Choix"
msgid "Bro."
msgstr "Mec."

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-1/0
msgctxt "Doug"
msgid "It’s a good thing you’re nice to look at, ‘cause you’re definitely not much in the brains department."
msgstr "Heureusement que t'es agréable à regarder, parce que côté cervelle, on repassera."

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-1/11
msgctxt "Doug"
msgid "Here, I’ll give you a hint about my true secret identity..."
msgstr "Tiens, je te donne un indice sur ma véritable identité secrète..."

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-1/19
msgctxt "Doug"
msgid "I’m what you spend your entire life avoiding."
msgstr "Je suis ce que tu passes ta vie entière à éviter."

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-1/27/s/0
msgctxt "Choix"
msgid "Going outside?"
msgstr "Sortir de chez moi ?"

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-1/28/s/0
msgctxt "Choix"
msgid "Hot cheese?"
msgstr "Le fromage brûlant ?"

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-1/29/s/0
msgctxt "Choix"
msgid "Reconnecting with my estranged parents?"
msgstr "Reprendre contact avec mes parents, avec qui je ne parle plus ?"

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-1/30/s/0
msgctxt "Choix"
msgid "Falling pianos from tall buildings?"
msgstr "Les pianos qui tombent d'un immeuble ?"

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-1/c-6/7
msgctxt "Doug"
msgid "Yeah I can tell."
msgstr "Ouais, ça se voit."

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-1/c-7/7
msgctxt "Doug"
msgid "The fuck? What kinda freak are you?"
msgstr "C'est quoi ce délire ? T'es quoi, comme phénomène ?"

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-1/c-8/7
msgctxt "Doug"
msgid "Mommy and Daddy issues huh?"
msgstr "Des problèmes avec Maman et Papa, hein ?"

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-1/c-8/15
msgctxt "Doug"
msgid "Nice. I can work with that."
msgstr "Pas mal. Je peux faire avec."

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-1/c-9/7
msgctxt "Doug"
msgid "I mean... maybe."
msgstr "Enfin... peut-être."

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-1/c-9/15
msgctxt "Doug"
msgid "I definitely recommend it."
msgstr "Je le recommande vivement."

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-2/0
msgctxt "Doug"
msgid "But not even remotely close. I’m..."
msgstr "Mais même pas près. Je suis..."

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-2/8
msgctxt "Doug"
msgid "<i>Your Overwhelming Sense of Existential Dread.</i>"
msgstr "<i>Ton Sentiment Accablant d'Angoisse Existentielle.</i>"

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-2/19
msgctxt "Doug"
msgid "But my homies call me Doug."
msgstr "Mais mes potes m'appellent Doug."

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-2/36/0/s/0
msgctxt "Choix"
msgid "Hi Doug!"
msgstr "Salut Doug !"

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-2/36/1/s/0
msgctxt "Choix"
msgid "What’s \"existential dread?\""
msgstr "C'est quoi, l'« angoisse existentielle » ?"

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-2/36/2/s/0
msgctxt "Choix"
msgid "So that explains why you don’t have a nose!"
msgstr "Ça explique pourquoi t'as pas de nez !"

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-2/36/3/s/0
msgctxt "Choix"
msgid "Doug. That's just one letter off from 'Dough'."
msgstr "Doug. Il suffit de changer une lettre pour avoir « Doux »."

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-2/36/c-10/13
msgctxt "Doug"
msgid "Did I say <i>we</i> were homies?"
msgstr "J'ai dit qu'<i>on</i> était potes ?"

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-2/36/c-10/21/0/s/0
msgctxt "Choix"
msgid "Oh, I just assumed."
msgstr "Oh, j'avais supposé."

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-2/36/c-10/21/1/s/0
msgctxt "Choix"
msgid "Yes, you did."
msgstr "Oui, tu l'as dit."

# Traduction IA – à relire
#: doug_dread/doug_encounter1/0/g-2/36/c-10/21/c-0/7
msgctxt "Doug"
