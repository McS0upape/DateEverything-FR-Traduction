# Traduction IA – à relire
#: ironaldini_iron/1
msgctxt "Tag Nom d'objet (MAJUSCULES)"
msgid "FOLD-OUT IRONING BOARD"
msgstr "BUREAU DE REPASSAGE PLIANT"

# Traduction IA – à relire
#: ironaldini_iron/ironaldini_stella_convince/0/3/b/1
msgctxt "I, Ronaldini"
msgid "We. Are. CLOSED."
msgstr "Nous. Sommes. FERMÉS."

# Traduction IA – à relire
#: ironaldini_iron/ironaldini_stella_convince/0/4/b/1
msgctxt "I, Ronaldini"
msgid "Mmmmyess?"
msgstr "Mmmmouais ?"

# Traduction IA – à relire
#: ironaldini_iron/ironaldini_stella_convince/0/7/s/0
msgctxt "Choix"
msgid "Stella needs your help."
msgstr "Stella a besoin de ton aide."

# Traduction IA – à relire
#: ironaldini_iron/ironaldini_stella_convince/0/8/s/0
msgctxt "Choix"
msgid "It's Stella. She needs your... Showmanship."
msgstr "C'est Stella. Elle a besoin de ton... sens du spectacle."

# Traduction IA – à relire
#: ironaldini_iron/ironaldini_stella_convince/0/g-0/0
msgctxt "I, Ronaldini"
msgid "The MADAME!"
msgstr "LA MADAME !"

# Traduction IA – à relire
#: ironaldini_iron/ironaldini_stella_convince/0/g-0/8
msgctxt "I, Ronaldini"
msgid "For her. I shall assist."
msgstr "Pour elle. Je prêterai main-forte."

# Traduction IA – à relire
#: ironaldini_iron/ironaldini_stella_convince/0/g-0/16
msgctxt "I, Ronaldini"
msgid "Wonderful audience member, the Madame. Only from afar, mind you, but I've seen her in the distance."
msgstr "Une spectatrice merveilleuse, la Madame. De loin seulement, notez bien, mais je l'ai aperçue au loin."

# Traduction IA – à relire
#: ironaldini_iron/ironaldini_stella_convince/0/g-0/24
msgctxt "I, Ronaldini"
msgid "Kind, quiet soul."
msgstr "Une âme douce et discrète."

# Traduction IA – à relire
#: ironaldini_iron/ironaldini_stella_convince/0/g-0/32
msgctxt "I, Ronaldini"
msgid "Sign me up."
msgstr "Inscrivez-moi."

# Traduction IA – à relire
#: ironaldini_iron/ironaldini_stella_convince/0/g-0/40/s/0
msgctxt "Choix"
msgid "I should warn you it's kind of a scam."
msgstr "Je dois te prévenir, c'est un peu une arnaque."

# Traduction IA – à relire
#: ironaldini_iron/ironaldini_stella_convince/0/g-0/41/s/0
msgctxt "Choix"
msgid "Consider yourself signed."
msgstr "Considère que c'est signé."

# Traduction IA – à relire
#: ironaldini_iron/ironaldini_stella_convince/0/g-0/c-2/7
msgctxt "I, Ronaldini"
msgid "LIFE IS A SCAM!"
msgstr "LA VIE EST UNE ARNAQUE !"

# Traduction IA – à relire
#: ironaldini_iron/ironaldini_stella_convince/0/g-0/c-2/15
msgctxt "I, Ronaldini"
msgid "Sign. Me. Up."
msgstr "Inscrivez. Moi."

# Traduction IA – à relire
#: ironaldini_iron/ironaldini_stella_convince/0/g-0/c-3/7
msgctxt "I, Ronaldini"
msgid "Consider it so."
msgstr "Considérez que c'est fait."

# Traduction IA – à relire
#: ironaldini_iron/IRonaldiniUnlocked/0/3/b/1
msgctxt "Bobby"
msgid "Hey, it's you. What up."
msgstr "Hé, c'est toi. Quoi de neuf."

# Traduction IA – à relire
#: ironaldini_iron/IRonaldiniUnlocked/0/4/b/1
msgctxt "Bobby"
msgid "Came here to spy on me or something? Get outta here."
msgstr "T'es là pour m'espionner ou quoi ? Dégage d'ici."

# Traduction IA – à relire
#: ironaldini_iron/IRonaldiniUnlocked/0/7/s/0
msgctxt "Choix"
msgid "I came to see what was going on in here..."
msgstr "Je voulais voir ce qui se passait ici..."

# Traduction IA – à relire
#: ironaldini_iron/IRonaldiniUnlocked/0/8/s/0
msgctxt "Choix"
msgid "Bobby! How have you been?"
msgstr "Bobby ! Comment ça va ?"

# Traduction IA – à relire
#: ironaldini_iron/IRonaldiniUnlocked/0/g-0/0
msgctxt "???"
msgid "The Great Bobbini! Our training awaits!"
msgstr "Le Grand Bobbini ! Notre entraînement nous attend !"

# Traduction IA – à relire
#: ironaldini_iron/IRonaldiniUnlocked/0/g-0/5
msgctxt "Bobby"
msgid "Ah beans."
msgstr "Ah, zut."

# Traduction IA – à relire
#: ironaldini_iron/IRonaldiniUnlocked/0/g-0/13
msgctxt "Bobby"
msgid "Ronny, I changed my name! I'm Bobby Stickyfingers now!"
msgstr "Ronny, j'ai changé de nom ! Je m'appelle Bobby Stickyfingers maintenant !"

# Traduction IA – à relire
#: ironaldini_iron/IRonaldiniUnlocked/0/g-0/21
msgctxt "???"
msgid "...what?"
msgstr "...quoi ?"

# Traduction IA – à relire
#: ironaldini_iron/IRonaldiniUnlocked/0/g-0/26
msgctxt "Bobby"
msgid "I gotta scram for a bit."
msgstr "Faut que je file un moment."

# Traduction IA – à relire
#: ironaldini_iron/IRonaldiniUnlocked/0/g-0/34
msgctxt "Bobby"
msgid "This ironing board guy?"
msgstr "Ce type, la planche à repasser ?"

# Traduction IA – à relire
#: ironaldini_iron/IRonaldiniUnlocked/0/g-0/42
msgctxt "Bobby"
msgid "He's... a LOT."
msgstr "Il est... BEAUCOUP."

# Traduction IA – à relire
#: ironaldini_iron/IRonaldiniUnlocked/0/g-0/53
msgctxt "???"
msgid "<w>POOF!</w>"
msgstr "<w>POOF !</w>"

# Traduction IA – à relire
#: ironaldini_iron/IRonaldiniUnlocked/0/g-0/63
msgctxt "???"
msgid "Do not be alarmed!"
msgstr "Ne vous alarmez pas !"

# Traduction IA – à relire
#: ironaldini_iron/IRonaldiniUnlocked/0/g-0/68
msgctxt "???"
msgid "Afraid, perhaps..."
msgstr "Effrayez-vous, peut-être..."

# Traduction IA – à relire
#: ironaldini_iron/IRonaldiniUnlocked/0/g-0/73
msgctxt "???"
msgid "For the greatest mystery yet awaits...!!!"
msgstr "Car le plus grand des mystères vous attend encore...!!!"

# Traduction IA – à relire
#: ironaldini_iron/IRonaldiniUnlocked/0/g-0/78/s/0 ironaldini_iron/Intro/0/45/s/0 ironaldini_iron/IRonaldiniReturn/0/35/s/0 ironaldini_iron/Love1/0/10/s/0 ironaldini_iron/Love1/0/c-2/15/0/s/0
msgctxt "Choix"
msgid "AAAAAAAAAAAHHHHHH!"
msgstr "AAAAAAAAAAHHHHHH !"

# Traduction IA – à relire
#: ironaldini_iron/IRonaldiniUnlocked/0/g-0/79/s/0
msgctxt "Choix"
msgid "Holy heck!"
msgstr "Mince alors !"

# Traduction IA – à relire
#: ironaldini_iron/IRonaldiniUnlocked/0/g-0/80/s/0
msgctxt "Choix"
msgid "Ooooo! Ahhhhh!"
msgstr "Ooooo ! Ahhhhh !"

# Traduction IA – à relire
#: ironaldini_iron/IRonaldiniUnlocked/0/g-0/81/s/0
msgctxt "Choix"
msgid "<i>Cough, Cough</i>"
msgstr "<i>Toux, toux</i>"

# Traduction IA – à relire
#: ironaldini_iron/Intro/0/4
msgctxt "I, Ronaldini"
msgid "You have ventured onto the path less travelled."
msgstr "Vous vous êtes {{aventuré|aventurée|aventuré·e}} sur le chemin le moins fréquenté."

# Traduction IA – à relire
#: ironaldini_iron/Intro/0/12
msgctxt "I, Ronaldini"
msgid "A path where no thing is sure. Where the unknown is the only certainty!"
msgstr "Un chemin où rien n'est sûr. Où l'inconnu est la seule certitude !"

# Traduction IA – à relire
#: ironaldini_iron/Intro/0/20
msgctxt "I, Ronaldini"
msgid "You, unfortunate soul, have stumbled into my fearsome presence:"
msgstr "Vous, âme infortunée, avez trébuché dans ma redoutable présence :"

# Traduction IA – à relire
#: ironaldini_iron/Intro/0/31 ironaldini_iron/IRonaldiniReturn/0/16
msgctxt "I, Ronaldini"
msgid "IT IS I, RONALDINI!!! The Great and Terrible!!!"
msgstr "C'EST MOI, RONALDINI !!! LE GRAND ET TERRIBLE !!!"

# Traduction IA – à relire
#: ironaldini_iron/Intro/0/46/s/0 ironaldini_iron/IRonaldiniReturn/0/36/s/0
msgctxt "Choix"
msgid "<i>Cough</i> <i>Cough</i> Your smoke smells weird."
msgstr "<i>Toux</i> <i>toux</i> Ta fumée sent bizarre."

# Traduction IA – à relire
#: ironaldini_iron/Intro/0/47/s/0
msgctxt "Choix"
msgid "Ooooo, I want three wishes!"
msgstr "Ooooo, je veux trois vœux !"

# Traduction IA – à relire
#: ironaldini_iron/Intro/0/48/s/0 ironaldini_iron/IRonaldiniReturn/0/38/s/0
msgctxt "Choix"
msgid "Ooooo! Ahhhhh! Again! Do it again!!!"
msgstr "Ooooo ! Ahhhhh ! Encore ! Refais-le !!!"

# Traduction IA – à relire
#: ironaldini_iron/IRonaldiniBanishReturn/3
msgctxt "I, Ronaldini"
msgid "I see you've come crawling back to prostrate yourself at my feet."
msgstr "Je vois que vous êtes {{revenu|revenue|revenu·e}} ramper pour vous prosterner à mes pieds."

# Traduction IA – à relire
#: ironaldini_iron/IRonaldiniBanishReturn/11/b/1 ironaldini_iron/IRonaldiniBanishReturn/12/b/1 ironaldini_iron/IRonaldiniBanishReturn/13/b/1 ironaldini_iron/IRonaldiniBanishReturn/14/b/1
msgctxt "I, Ronaldini"
msgid "Have you rethought your \"advice\"?"
msgstr "Avez-vous repensé à vos « conseils » ?"

# Traduction IA – à relire
#: ironaldini_iron/love7a_divert/0/0
msgctxt "I, Ronaldini"
msgid "Have you grown less timid?"
msgstr "Votre timidité a-t-elle reculé ?"

# Traduction IA – à relire
#: ironaldini_iron/love7a_divert/0/8/s/0
msgctxt "Choix"
msgid "I have. Let me prove it to you."
msgstr "Oui. Laisse-moi te le prouver."

# Traduction IA – à relire
#: ironaldini_iron/love7a_divert/0/9/s/0
msgctxt "Choix"
msgid "Not timid, just more curious about you. I want to know where you came from."
msgstr "Pas de la timidité, juste plus de curiosité à ton sujet. Je veux savoir d'où tu viens."

# Traduction IA – à relire
#: ironaldini_iron/love7a_divert/0/10/s/0
msgctxt "Choix"
msgid "Nope! I've come back to put you in your place!"
msgstr "Non ! Me revoilà pour te remettre à ta place !"

# Traduction IA – à relire
#: ironaldini_iron/love7a_divert/0/c-0/7
msgctxt "I, Ronaldini"
msgid "All right, but as I said..."
msgstr "Très bien, mais comme je le disais..."

# Traduction IA – à relire
#: ironaldini_iron/IRonaldiniReturn/0/0
msgctxt "I, Ronaldini"
msgid "Ah ha! You've returned? Couldn't resist the draw of my devilish distractions? Of course you couldn't!"
msgstr "Ha ha ! Vous voilà de retour ? Vous n'avez pu résister à l'attrait de mes diaboliques distractions ? Évidemment !"

# Traduction IA – à relire
#: ironaldini_iron/IRonaldiniReturn/0/8
msgctxt "I, Ronaldini"
msgid "Once more you have ventured onto the path less travelled. A path where no thing is sure. Where the unknown is the only certainty! You, unfortunate soul, have stumbled into my fearsome presence:"
msgstr "Une fois de plus, vous vous êtes {{aventuré|aventurée|aventuré·e}} sur le chemin le moins fréquenté. Un chemin où rien n'est sûr. Où l'inconnu est la seule certitude ! Vous, âme infortunée, avez trébuché dans ma redoutable présence :"

# Traduction IA – à relire
#: ironaldini_iron/IRonaldiniReturn/0/24
msgctxt "I, Ronaldini"
msgid "<i>POOF</i> <i>FLASH</i> <i>POOF</i>"
msgstr "<i>POOF</i> <i>FLASH</i> <i>POOF</i>"

# Traduction IA – à relire
#: ironaldini_iron/IRonaldiniReturn/0/37/s/0
msgctxt "Choix"
msgid "The flash and smoke is less impressive the second time."
msgstr "Le flash et la fumée font moins d'effet la deuxième fois."

# Traduction IA – à relire
#: ironaldini_iron/Love1/0/0
msgctxt "I, Ronaldini"
msgid "Forgive me, I too easily forget the terrifying effect my astounding illusions can have on mere mortals."
msgstr "Pardonnez-moi, j'oublie trop aisément l'effet terrifiant que mes illusions stupéfiantes peuvent avoir sur de simples mortels."

# Traduction IA – à relire
#: ironaldini_iron/Love1/0/8/s/0
msgctxt "Choix"
msgid "Just saying <i>poof</i> isn't exactly a magic trick.."
msgstr "Dire <i>poof</i>, ce n'est pas vraiment un tour de magie..."

# Traduction IA – à relire
#: ironaldini_iron/Love1/0/9/s/0
msgctxt "Choix"
msgid "I wouldn't say I'm \"alarmed\" so much as... intrigued."
msgstr "Je ne parlerais pas d'« alarme » mais plutôt de... curiosité."

# Traduction IA – à relire
#: ironaldini_iron/Love1/0/c-2/7
msgctxt "I, Ronaldini"
msgid "Calm Yourself!"
msgstr "Calmez-vous !"

# Traduction IA – à relire
#: ironaldini_iron/Love1/0/c-2/15/c-0/7
msgctxt "I, Ronaldini"
msgid "Sigh. Gaze into my eyes! Find the strength inside and comfort will follow."
msgstr "Soupir. Plongez votre regard dans mes yeux ! Trouvez la force en vous et le réconfort suivra."

# Traduction IA – à relire
#: ironaldini_iron/Love1/0/c-2/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "AAAAAAAAAAHHHHHH!"
msgstr "AAAAAAAAAAHHHHHH !"

# Traduction IA – à relire
#: ironaldini_iron/Love1/0/c-2/15/c-0/15/1/s/0
msgctxt "Choix"
msgid "B-b-but I'm too a-scared!"
msgstr "M-m-mais j'ai trop p-peur !"

# Traduction IA – à relire
#: ironaldini_iron/Love1/0/c-2/15/c-0/15/c-0/7
msgctxt "Narrator"
msgid "Comfort did not follow, and you pass out, filled to the brim with illusions."
msgstr "Le réconfort n'a pas suivi, et vous perdez connaissance, {{rempli|remplie|rempli·e}} jusqu'à la gueule d'illusions."

# Traduction IA – à relire
#: ironaldini_iron/Love1/0/c-2/15/c-0/15/c-1/7
msgctxt "I, Ronaldini"
msgid "DO AS I COMMAND!"
msgstr "FAITES CE QUE JE VOUS ORDONNE !"

# Traduction IA – à relire
#: ironaldini_iron/Love1/0/c-2/15/c-0/15/c-1/18/0/s/0
msgctxt "Choix"
msgid "O-o-okay... feeling better..."
msgstr "D-d-d'accord... ça va mieux..."

# Traduction IA – à relire
#: ironaldini_iron/Love1/0/c-2/15/c-0/15/c-1/18/1/s/0
msgctxt "Choix"
msgid "Show some respect. Technically, I own you."
msgstr "Un peu de respect. Techniquement, tu m'appartiens."

# Traduction IA – à relire
#: ironaldini_iron/Love1/0/c-2/15/c-0/15/c-1/18/2/s/0
msgctxt "Choix"
msgid "You dare command me?"
msgstr "Tu oses me donner des ordres ?"

# Traduction IA – à relire
#: ironaldini_iron/Hate1/0/0
msgctxt "I, Ronaldini"
msgid "It smells of the brimstone from whence it leaps! The heat that emanates from my very soul."
msgstr "Elle sent le soufre d'où elle jaillit ! La chaleur qui émane de mon âme même."

# Traduction IA – à relire
#: ironaldini_iron/Hate1/0/8
msgctxt "I, Ronaldini"
msgid "For I, Ronaldini am a conduit to the darkest of dark magics!"
msgstr "Car moi, Ronaldini, je suis un canal vers les plus sombres des magies noires !"

# Traduction IA – à relire
#: ironaldini_iron/Hate1/0/16
msgctxt "I, Ronaldini"
msgid "I impress - I amaze - I..."
msgstr "J'impressionne - j'ébahis - je..."

# Traduction IA – à relire
#: ironaldini_iron/Hate1/0/24
msgctxt "I, Ronaldini"
msgid "Ronaldini!"
msgstr "Ronaldini !"

# Traduction IA – à relire
#: ironaldini_iron/Hate1/0/35/s/0
msgctxt "Choix"
msgid "Oh yeah? That's neat."
msgstr "Ah ouais ? C'est chouette."

# Traduction IA – à relire
#: ironaldini_iron/Hate1/0/36/s/0
msgctxt "Choix"
msgid "Well that's alarming. I guess."
msgstr "Bon, c'est alarmant. Je suppose."

# Traduction IA – à relire
#: ironaldini_iron/Hate1/0/37/s/0
msgctxt "Choix"
msgid "I've never been \"into magic.\""
msgstr "Je n'ai jamais été « branché magie »."

# Traduction IA – à relire
#: ironaldini_iron/Hate1/0/38/s/0
msgctxt "Choix"
msgid "Mmm. Reminds me of the smell when you blow out a match. Comforting but... scary?"
msgstr "Mmm. Ça me rappelle l'odeur quand on souffle une allumette. Réconfortant mais... effrayant ?"

# Traduction IA – à relire
#: ironaldini_iron/Friend1/0/0
msgctxt "I, Ronaldini"
msgid "I am no genie! How dare you debase and insult me! You, who are but a peon!"
msgstr "Je ne suis pas un génie ! Comment osez-vous me rabaisser et m'insulter ! Vous qui n'êtes qu'une quantité négligeable !"

# Traduction IA – à relire
#: ironaldini_iron/Friend1/0/8
msgctxt "I, Ronaldini"
msgid "'Twas I, Ronaldini, whose prestidigital powers successfully swiped the Great Diamond of the Aga Khan from beneath his very gaze!"
msgstr "C'est moi, Ronaldini, dont les pouvoirs prestidigitateurs ont dérobé avec succès le Grand Diamant de l'Aga Khan sous son nez même !"

# Traduction IA – à relire
#: ironaldini_iron/Friend1/0/16/s/0
msgctxt "Choix"
msgid "That was you!? I think I read about that somewhere."
msgstr "C'était toi ?! Je crois que j'ai lu un truc là-dessus quelque part."

# Traduction IA – à relire
#: ironaldini_iron/Friend1/0/17/s/0
msgctxt "Choix"
msgid "Are you talking about when that button popped off my shirt?"
msgstr "Tu parles de quand un bouton a sauté de ma chemise ?"

# Traduction IA – à relire
#: ironaldini_iron/Friend1/0/18/s/0
msgctxt "Choix"
msgid "My first wish is that you didn't say that."
msgstr "Mon premier vœu, c'est que tu n'aies pas dit ça."

# Traduction IA – à relire
#: ironaldini_iron/Hate2/0/0
msgctxt "I, Ronaldini"
msgid "Harumph! Harumph, I declare!"
msgstr "Hrmpf ! Hrmpf, je le proclame !"

# Traduction IA – à relire
#: ironaldini_iron/Hate2/0/8/s/0
msgctxt "Choix"
msgid "Declare all you want. What's with all the smoke and mirrors?"
msgstr "Proclame tant que tu veux. C'est quoi, toute cette poudre aux yeux ?"

# Traduction IA – à relire
#: ironaldini_iron/Hate2/0/c-0/7
msgctxt "I, Ronaldini"
msgid "Do you imply that I am a charlatan!? That my legerdemain is not craft but folly!?"
msgstr "Insinuez-vous que je suis un charlatan ?! Que mon escamotage n'est pas un art mais une folie ?!"

# Traduction IA – à relire
#: ironaldini_iron/Hate2/0/c-0/18/0/s/0
msgctxt "Choix"
msgid "If the steam swirls..."
msgstr "Si la vapeur tourbillonne..."

# Traduction IA – à relire
#: ironaldini_iron/Hate2/0/c-0/18/1/s/0
msgctxt "Choix"
msgid "I don't know what those words are."
msgstr "Je ne sais pas ce que veulent dire ces mots."

# Traduction IA – à relire
#: ironaldini_iron/Hate2/0/c-0/18/2/s/0
msgctxt "Choix"
msgid "It just seems like you're compensating for something."
msgstr "On dirait juste que tu compenses quelque chose."

# Traduction IA – à relire
#: ironaldini_iron/Hate2/0/c-0/18/3/s/0
msgctxt "Choix"
msgid "Yeah, that."
msgstr "Ouais, ça."

# Traduction IA – à relire
#: ironaldini_iron/Begone/0
msgctxt "I, Ronaldini"
msgid "Then begone! You do not deserve an audience with me, THE I, Ronaldini!"
msgstr "Alors disparaissez ! Vous ne méritez pas une audience avec moi, LE I, Ronaldini !"

# Traduction IA – à relire
#: ironaldini_iron/Hate2a/0/0
msgctxt "I, Ronaldini"
msgid "What!? No one possesses I, Ronaldini save for perhaps the Devil himself!"
msgstr "Quoi ?! Nul ne possède I, Ronaldini, sauf peut-être le Diable en personne !"

# Traduction IA – à relire
#: ironaldini_iron/Hate2a/0/8/s/0
msgctxt "Choix"
msgid "Nah, technically, I own this house. You're in it. I own you."
msgstr "Non, techniquement, cette maison est à moi. Tu es dedans. Tu m'appartiens."

# Traduction IA – à relire
#: ironaldini_iron/Hate2a/0/9/s/0
msgctxt "Choix"
msgid "What about me?"
msgstr "Et moi, alors ?"

# Traduction IA – à relire
#: ironaldini_iron/Hate2b/0/0
msgctxt "I, Ronaldini"
msgid "What \"good\" am I!? None! I work not for the forces of light! I command the forces of evil to do my caustic bidding!"
msgstr "Quel « bien » je fais ?! Aucun ! Je ne travaille pas pour les forces de la lumière ! Je commande aux forces du mal d'exécuter mes ordres corrosifs !"

# Traduction IA – à relire
#: ironaldini_iron/Hate2b/0/8/s/0
msgctxt "Choix"
msgid "Caustic. So THAT's what the smell was."
msgstr "Corrosifs. Donc c'était ÇA, l'odeur."

# Traduction IA – à relire
#: ironaldini_iron/Hate2b/0/9/s/0
msgctxt "Choix"
msgid "I just don't believe in all that nonsense."
msgstr "Je ne crois simplement pas à toutes ces âneries."

# Traduction IA – à relire
#: ironaldini_iron/Hate2b/0/10/s/0
msgctxt "Choix"
msgid "I've never heard of you."
msgstr "Je n'ai jamais entendu parler de toi."

# Traduction IA – à relire
#: ironaldini_iron/Love2/0/0 ironaldini_iron/Love2a/0/8
msgctxt "I, Ronaldini"
msgid "Now do you feel the tendrils of my psyche entwining with yours?"
msgstr "Sentez-vous maintenant les vrilles de mon esprit s'enlacer au vôtre ?"

# Traduction IA – à relire
#: ironaldini_iron/Love2/0/8/s/0 ironaldini_iron/Love2a/0/16/s/0
msgctxt "Choix"
msgid "I do! I do!"
msgstr "Oui ! Oui !"

# Traduction IA – à relire
#: ironaldini_iron/Love2/0/9/s/0
msgctxt "Choix"
msgid "Your tendrils can entwine at will, sir. I am at your command."
msgstr "Tes vrilles peuvent s'enlacer à volonté, monsieur. Je suis à tes ordres."

# Traduction IA – à relire
#: ironaldini_iron/Love2/0/10/s/0 ironaldini_iron/Love2a/0/18/s/0
msgctxt "Choix"
msgid "I feel... something? Like a tickle in my throat?"
msgstr "Je sens... quelque chose ? Comme un chatouillis dans la gorge ?"

# Traduction IA – à relire
#: ironaldini_iron/Love2a/0/0
msgctxt "I, Ronaldini"
msgid "Yessss, yessss, I'm sure that is so! Gaze into my eyes and find the mystery you seek."
msgstr "Ouiii, ouiii, j'en suis sûr ! Plongez votre regard dans mes yeux et trouvez le mystère que vous cherchez."

# Traduction IA – à relire
#: ironaldini_iron/Love2a/0/17/s/0
msgctxt "Choix"
msgid "Your tendrils are welcome to entwine! I am at your command."
msgstr "Tes vrilles sont les bienvenues pour s'enlacer ! Je suis à tes ordres."

# Traduction IA – à relire
#: ironaldini_iron/Friend2/0/0
msgctxt "I, Ronaldini"
msgid "You mock me."
msgstr "Vous vous moquez de moi."

# Traduction IA – à relire
#: ironaldini_iron/Friend2/0/8/s/0
msgctxt "Choix"
msgid "No! I'm just wanting to get to the bottom of this... whole... deal."
msgstr "Non ! Je veux juste aller au fond de... toute cette... histoire."

# Traduction IA – à relire
#: ironaldini_iron/Friend2/0/9/s/0
msgctxt "Choix"
msgid "Correct! You're overcompensating, pal."
msgstr "Exact ! Tu compenses, mon vieux."

# Traduction IA – à relire
#: ironaldini_iron/Friend2/0/10/s/0
msgctxt "Choix"
msgid "Mock THEE? I couldn't."
msgstr "Me moquer de TOI ? Jamais."

# Traduction IA – à relire
#: ironaldini_iron/Friend2/0/11/s/0
msgctxt "Choix"
msgid "In the words of Shania Plane: you don't impress me much."
msgstr "Pour citer Shania Plane : tu ne m'impressionnes pas des masses."

# Traduction IA – à relire
#: ironaldini_iron/Friend2a/0/0
msgctxt "I, Ronaldini"
msgid "I am no genie!"
msgstr "Je ne suis pas un génie !"

# Traduction IA – à relire
#: ironaldini_iron/Friend2a/0/8/s/0
msgctxt "Choix"
msgid "I dunno... You poofed, and genies poof. So gimme my wish!"
msgstr "Je sais pas... Tu as fait poof, et les génies font poof. Alors donne-moi mon vœu !"

# Traduction IA – à relire
#: ironaldini_iron/Friend2a/0/c-0/7
msgctxt "I, Ronaldini"
msgid "I am no Magical Ghoul living in some forsaken cistern!"
msgstr "Je ne suis pas un Djinn Maléfique vivant dans quelque citerne maudite !"

# Traduction IA – à relire
#: ironaldini_iron/Friend2a/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "So... no wishes, then?"
msgstr "Donc... pas de vœux, alors ?"

# Traduction IA – à relire
#: ironaldini_iron/Friend2a/0/c-0/15/c-0/7
msgctxt "I, Ronaldini"
msgid "Of course not! I cannot grant what you wish, unless it is beguilement tinged with the acrid bitterness of fear."
msgstr "Bien sûr que non ! Je ne puis exaucer vos souhaits, sauf s'il s'agit d'un envoûtement teinté de l'âcre amertume de la peur."

# Traduction IA – à relire
#: ironaldini_iron/Friend2a/0/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "Well, that actually does sound interesting..."
msgstr "Eh bien, ça a l'air intéressant, en fait..."

# Traduction IA – à relire
#: ironaldini_iron/Friend2a/0/c-0/15/c-0/15/1/s/0
msgctxt "Choix"
msgid "That sounds exactly what I imagine love to taste like."
msgstr "Ça ressemble exactement au goût que j'imagine à l'amour."

# Traduction IA – à relire
#: ironaldini_iron/Friend2a/0/c-0/15/c-0/15/2/s/0
msgctxt "Choix"
msgid "Well if you can't grant me wishes, what good are ya?"
msgstr "Si tu ne peux pas exaucer mes vœux, tu sers à quoi ?"

# Traduction IA – à relire
#: ironaldini_iron/Love3/0/0
msgctxt "I, Ronaldini"
msgid "I can only assume you are familiar with my dastardly visage from the countless broadsheets and pamphlets strewn about proclaiming my sinister genius."
msgstr "Je ne puis qu'imaginer que mon sinistre visage vous est familier, grâce aux innombrables placards et pamphlets dispersés partout qui proclament mon génie maléfique."

# Traduction IA – à relire
#: ironaldini_iron/Love3/0/8/s/0
msgctxt "Choix"
msgid "Like, your manual?"
msgstr "Genre, ton mode d'emploi ?"

# Traduction IA – à relire
#: ironaldini_iron/Love3/0/c-0/7
msgctxt "I, Ronaldini"
msgid "<w>I, RONALDINI STAND BEFORE YOU!!</w>"
msgstr "<w>MOI, RONALDINI, JE ME DRESSE DEVANT VOUS !!</w>"

# Traduction IA – à relire
#: ironaldini_iron/Love3/0/c-0/18
msgctxt "I, Ronaldini"
msgid "...you may quake, should you choose. Ah! Or perhaps I should MAKE you quake!"
msgstr "...vous pouvez trembler, si vous le souhaitez. Ah ! Ou peut-être devrais-je VOUS faire trembler !"

# Traduction IA – à relire
#: ironaldini_iron/Love3/0/c-0/26/0/s/0
msgctxt "Choix"
msgid "I choose! I choose!"
msgstr "Je choisis ! Je choisis !"

# Traduction IA – à relire
#: ironaldini_iron/Love3/0/c-0/26/1/s/0
msgctxt "Choix"
msgid "You do seem familiar..."
msgstr "Tu me dis quelque chose..."

# Traduction IA – à relire
#: ironaldini_iron/Love3/0/c-0/26/2/s/0
msgctxt "Choix"
msgid "Parts of me are quaking alright."
msgstr "Certaines parties de moi tremblent, en effet."

# Traduction IA – à relire
#: ironaldini_iron/Love3/0/c-0/26/3/s/0
msgctxt "Choix"
msgid "Nope. Never heard of you. Not feeling quake-y."
msgstr "Non. Jamais entendu parler de toi. Je ne tremble pas."

# Traduction IA – à relire
#: ironaldini_iron/Hate3/0/0
msgctxt "I, Ronaldini"
msgid "But I have achieved so much! I have travelled to the four corners of the globe!"
msgstr "Mais j'ai tant accompli ! J'ai parcouru les quatre coins du globe !"

# Traduction IA – à relire
#: ironaldini_iron/Hate3/0/8
msgctxt "I, Ronaldini"
msgid "I have wowed royalty!"
msgstr "J'ai émerveillé des têtes couronnées !"

# Traduction IA – à relire
#: ironaldini_iron/Hate3/0/16
msgctxt "I, Ronaldini"
msgid "I have stunned heads of state!"
msgstr "J'ai sidéré des chefs d'État !"

# Traduction IA – à relire
#: ironaldini_iron/Hate3/0/24
msgctxt "I, Ronaldini"
msgid "I have gobsmacked captains of industry!"
msgstr "J'ai ébahi des capitaines d'industrie !"

# Traduction IA – à relire
#: ironaldini_iron/Hate3/0/32/s/0
msgctxt "Choix"
msgid "Stop reading me your resume and talk to me!"
msgstr "Arrête de me réciter ton CV et parle-moi !"

# Traduction IA – à relire
#: ironaldini_iron/Hate3/0/33/s/0
msgctxt "Choix"
msgid "Quite the world traveller!"
msgstr "Quel globe-trotter !"

# Traduction IA – à relire
#: ironaldini_iron/Hate3/0/34/s/0
msgctxt "Choix"
msgid "Wow, that sounds pretty cool. I'm im-PRESSED. Ha!"
msgstr "Ouah, ça a l'air plutôt cool. Ça, c'est de l'im-PRESSION. Ha !"

# Traduction IA – à relire
#: ironaldini_iron/Hate3a/0/0
msgctxt "I, Ronaldini"
msgid "This? This is YOUR home?"
msgstr "Ceci ? C'est VOTRE demeure ?"

# Traduction IA – à relire
#: ironaldini_iron/Hate3a/0/8/s/0
msgctxt "Choix"
msgid "Yes, indeed. I like it, actually."
msgstr "Oui, tout à fait. Je l'aime bien, en fait."

# Traduction IA – à relire
#: ironaldini_iron/Hate3a/0/9/s/0
msgctxt "Choix"
msgid "Don't sound so shocked."
msgstr "Ne prends pas l'air si choqué."

# Traduction IA – à relire
#: ironaldini_iron/Hate3a/0/g-0/0
msgctxt "I, Ronaldini"
msgid "So you are a property owner of great repute?"
msgstr "Vous êtes donc {{un propriétaire|une propriétaire|un·e propriétaire}} de grande réputation ?"

# Traduction IA – à relire
#: ironaldini_iron/Hate3a/0/g-0/8/s/0
msgctxt "Choix"
msgid "I'd say my repute is average at best."
msgstr "Disons que ma réputation est moyenne, au mieux."

# Traduction IA – à relire
#: ironaldini_iron/Hate3a/0/g-0/9/s/0
msgctxt "Choix"
msgid "Oh, my repute is huge."
msgstr "Oh, ma réputation est énorme."

# Traduction IA – à relire
#: ironaldini_iron/Hate3a/0/g-0/c-2/7
msgctxt "I, Ronaldini"
msgid "Consider me impressed. Perhaps you aren't the pedant I had initially taken you for."
msgstr "Me voilà impressionné, je l'avoue. Peut-être me suis-je mépris sur votre pédanterie."

# Traduction IA – à relire
#: ironaldini_iron/Hate3b/0/0
msgctxt "I, Ronaldini"
msgid "Did you say Shania Plane?"
msgstr "Avez-vous dit Shania Plane ?"

# Traduction IA – à relire
#: ironaldini_iron/Hate3b/0/8/s/0
msgctxt "Choix"
msgid "Uh, yeah."
msgstr "Euh, ouais."

# Traduction IA – à relire
#: ironaldini_iron/Hate3b/0/9/s/0
msgctxt "Choix"
msgid "I'm a big fan!"
msgstr "Je suis fan, grave !"

# Traduction IA – à relire
#: ironaldini_iron/Hate3b/0/g-0/0
msgctxt "I, Ronaldini"
msgid "The Canadian songstress? The shining light of pride for that imperfect nation?"
msgstr "La chanteuse canadienne ? La fierté rayonnante de cette nation imparfaite ?"

# Traduction IA – à relire
#: ironaldini_iron/Hate3b/0/g-0/8/s/0
msgctxt "Choix"
msgid "Imperfect? I mostly just hear nice things about it."
msgstr "Imparfaite ? J'en entends surtout du bien."

# Traduction IA – à relire
#: ironaldini_iron/Hate3b/0/g-0/9/s/0
msgctxt "Choix"
msgid "No nation is perfect, pal. I'm sure Canada does its best."
msgstr "Aucune nation n'est parfaite, mon vieux. Le Canada fait sûrement de son mieux."

# Traduction IA – à relire
#: ironaldini_iron/Hate3b/0/g-1/0
msgctxt "I, Ronaldini"
msgid "Oh, would that I could echo those sentiments. The mere mention of the place sends a shiver down my spine."
msgstr "Oh, que ne puis-je faire écho à ces sentiments. La simple mention de ce lieu me glace l'échine."

# Traduction IA – à relire
#: ironaldini_iron/Hate3b/0/g-1/8/s/0
msgctxt "Choix"
msgid "I HAVE heard it gets chilly."
msgstr "J'AI entendu dire qu'il y fait frisquet."

# Traduction IA – à relire
#: ironaldini_iron/Hate3b/0/g-1/9/s/0
msgctxt "Choix"
msgid "Hm. Sensing some trauma here? Snowy trauma?"
msgstr "Hm. Je sens un traumatisme ? Un traumatisme enneigé ?"

# Traduction IA – à relire
#: ironaldini_iron/Hate3b/0/g-2/0
msgctxt "I, Ronaldini"
msgid "It is not winter's frigid talons casting chills, it is, uh... I'd rather not discuss it."
msgstr "Ce ne sont pas les serres glaciales de l'hiver qui me donnent des frissons, c'est, euh... Je préférerais ne pas en parler."

# Traduction IA – à relire
#: ironaldini_iron/Hate3b/0/g-2/11/s/0
msgctxt "Choix"
msgid "Why not? It might help. Give it a shot, I'm not going anywhere."
msgstr "Pourquoi pas ? Ça pourrait aider. Tente le coup, je ne bouge pas d'ici."

# Traduction IA – à relire
#: ironaldini_iron/Hate3b/0/g-2/12/s/0
msgctxt "Choix"
msgid "You're... afraid. Of Canada. PLEASE explain."
msgstr "Tu as... peur. Du Canada. Explique-moi, VITE."

# Traduction IA – à relire
#: ironaldini_iron/Friend3/0/0
msgctxt "I, Ronaldini"
msgid "You speak in dismissive tones. You cut me to the quick."
msgstr "Vous parlez d'un ton dédaigneux. Vous me blessez au vif."

# Traduction IA – à relire
#: ironaldini_iron/Friend3/0/8/s/0
msgctxt "Choix"
msgid "I don't mean to. I just want to know the iron behind the cape."
msgstr "Ce n'est pas mon intention. Je veux juste connaître le fer derrière la cape."

# Traduction IA – à relire
#: ironaldini_iron/Friend3a/0/0
msgctxt "I, Ronaldini"
msgid "I rarely wear a cape."
msgstr "Je porte rarement une cape."

# Traduction IA – à relire
#: ironaldini_iron/Friend3a/0/8/s/0
msgctxt "Choix"
msgid "What is that you're wearing now?"
msgstr "C'est quoi, ce que tu portes en ce moment ?"

# Traduction IA – à relire
#: ironaldini_iron/Friend3a/0/c-0/7
msgctxt "I, Ronaldini"
msgid "A magical cape!"
msgstr "Une cape magique !"

# Traduction IA – à relire
#: ironaldini_iron/Friend3a/0/c-0/15
msgctxt "I, Ronaldini"
msgid "...okay yes. I have been known to don a silk lined velvet-y affair."
msgstr "...bon, d'accord. On m'a déjà vu enfiler une chose veloutée doublée de soie."

# Traduction IA – à relire
#: ironaldini_iron/Friend3a/0/g-0/0/s/0
msgctxt "Choix"
msgid "And you look smashing in it. And dashing!."
msgstr "Et tu es superbe là-dedans. Et élégant !"

# Traduction IA – à relire
#: ironaldini_iron/Friend3a/0/g-0/1/s/0
msgctxt "Choix"
msgid "Well tell me more about you! No more tricks."
msgstr "Alors dis-m'en plus sur toi ! Plus de tours."

# Traduction IA – à relire
#: ironaldini_iron/Friend3aCON/0/0
msgctxt "I, Ronaldini"
msgid "But I am only tricks."
msgstr "Mais je ne suis que tours."

# Traduction IA – à relire
#: ironaldini_iron/Friend3aCON/0/8
msgctxt "I, Ronaldini"
msgid "And japes!"
msgstr "Et facéties !"

# Traduction IA – à relire
#: ironaldini_iron/Friend3aCON/0/16
msgctxt "I, Ronaldini"
msgid "Mostly tricks though."
msgstr "Surtout des tours, cependant."

# Traduction IA – à relire
#: ironaldini_iron/Friend3aCON/0/24/s/0
msgctxt "Choix"
msgid "So, that. I want to know the man behind that."
msgstr "Justement. C'est l'homme derrière tout ça que je veux connaître."

# Traduction IA – à relire
#: ironaldini_iron/Friend3aCON/0/c-0/7
msgctxt "I, Ronaldini"
msgid "What is there to say? I feel like without the stage, without the allure of illusion, I vanish in a puff of a smoke."
msgstr "Que dire ? J'ai l'impression que sans la scène, sans l'attrait de l'illusion, je m'évanouis dans un nuage de fumée."

# Traduction IA – à relire
#: ironaldini_iron/Friend3aCON/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "A cool trick, I imagine?"
msgstr "Un bon tour, j'imagine ?"

# Traduction IA – à relire
#: ironaldini_iron/Friend3aCON/0/c-0/15/c-0/7
msgctxt "I, Ronaldini"
msgid "No! This \"iron behind the cape\". He ceases to exist when the greasepaint and bespoke tuxedo are returned to their trunk."
msgstr "Non ! Ce « fer derrière la cape ». Il cesse d'exister quand le fard et le smoking sur mesure retournent dans leur malle."

# Traduction IA – à relire
#: ironaldini_iron/Friend3aCON/0/c-0/15/c-0/15
msgctxt "I, Ronaldini"
msgid "When I am returned to my dressing room, folded into the wall and forgotten."
msgstr "Quand on me ramène dans ma loge, plié dans le mur et oublié."

# Traduction IA – à relire
#: ironaldini_iron/Friend3aCON/0/c-0/15/c-0/23/0/s/0
msgctxt "Choix"
msgid "Oh, I see. What if there were someone there to remember?"
msgstr "Oh, je vois. Et si quelqu'un était là pour s'en souvenir ?"

# Traduction IA – à relire
#: ironaldini_iron/Friend3aCON/0/c-0/15/c-0/23/1/s/0
msgctxt "Choix"
msgid "I wouldn't mind seeing what's under that tuxedo, you know."
msgstr "Ça ne me dérangerait pas de voir ce qu'il y a sous ce smoking, tu sais."

# Traduction IA – à relire
#: ironaldini_iron/Friend3aCON/0/c-0/15/c-0/23/c-0/7
msgctxt "I, Ronaldini"
msgid "I suppose I could grant you the benefit of my innermost recesses."
msgstr "Je suppose que je pourrais vous accorder le privilège de mes tréfonds les plus intimes."

# Traduction IA – à relire
#: ironaldini_iron/Love4/0/0
msgctxt "I, Ronaldini"
msgid "Sigh. Another sycophant come to kneel before the great and terrible I, Ronaldini."
msgstr "Soupir. Un autre flagorneur venu s'agenouiller devant le grand et terrible I, Ronaldini."

# Traduction IA – à relire
#: ironaldini_iron/Love4/0/8 ironaldini_iron/Love4a/0/c-0/15
msgctxt "I, Ronaldini"
msgid "He who tamed the Sultan’s treacherous tigers and hedonistic harem in the same legendary night."
msgstr "Lui qui dompta les tigres perfides du Sultan et son harem hédoniste en une seule nuit légendaire."

# Traduction IA – à relire
#: ironaldini_iron/Love4/0/16 ironaldini_iron/Love4a/0/c-0/23
msgctxt "I, Ronaldini"
msgid "How far he has fallen!"
msgstr "Quelle chute !"

# Traduction IA – à relire
#: ironaldini_iron/Love4/0/24/s/0 ironaldini_iron/Love4a/0/c-0/31/0/s/0
msgctxt "Choix"
msgid "I'm not a sycophant. I'm just a regular, kind, sexually adventurous homeowner."
msgstr "Je ne suis pas un flagorneur. Je suis juste {{un propriétaire normal, gentil et sexuellement aventureux|une propriétaire normale, gentille et sexuellement aventureuse|un·e propriétaire normal·e, gentil·le et sexuellement aventureux·se}}."

# Traduction IA – à relire
#: ironaldini_iron/Love4/0/25/s/0
msgctxt "Choix"
msgid "I guess I'm not fancy enough for the \"great and terrible\" IRONING BOARD."
msgstr "Je suppose que je ne suis pas assez chic pour la « grande et terrible » PLANCHE À REPASSER."

# Traduction IA – à relire
#: ironaldini_iron/Love4/0/26/s/0
msgctxt "Choix"
msgid "You haven't tamed me yet... wanna give it a go?"
msgstr "Tu ne m'as pas encore {{dompté|domptée|dompté·e}}... tu veux tenter ta chance ?"

# Traduction IA – à relire
#: ironaldini_iron/Love4a/0/0
msgctxt "I, Ronaldini"
msgid "Simple mental manipulation. I'm capable of so much more. Levitation, escape, I can even press nylon without damage."
msgstr "De la simple manipulation mentale. Je suis capable de bien plus. Lévitation, évasion, je peux même repasser du nylon sans l'abîmer."

# Traduction IA – à relire
#: ironaldini_iron/Love4a/0/8/s/0
msgctxt "Choix"
msgid "How about some physical manipulation?"
msgstr "Et une petite manipulation physique ?"

# Traduction IA – à relire
#: ironaldini_iron/Love4a/0/c-0/7
msgctxt "I, Ronaldini"
msgid "Sigh. Another sycophant come to kneel before me, the great and terrible I, Ronaldini."
msgstr "Soupir. Un autre flagorneur venu s'agenouiller devant moi, le grand et terrible I, Ronaldini."

# Traduction IA – à relire
#: ironaldini_iron/Love4a/0/c-0/31/1/s/0
msgctxt "Choix"
msgid "I've found kneeling to be quite handy, posture wise."
msgstr "Je trouve que s'agenouiller, c'est plutôt pratique pour la posture."

# Traduction IA – à relire
#: ironaldini_iron/Love4a/0/c-0/31/2/s/0
msgctxt "Choix"
msgid "I am sorry that I'm not FANCY enough for the \"great and terrible\" IRONING BOARD."
msgstr "Excuse-moi de ne pas être assez CHIC pour la « grande et terrible » PLANCHE À REPASSER."

# Traduction IA – à relire
#: ironaldini_iron/Love4a/0/c-0/31/3/s/0
msgctxt "Choix"
msgid "You've never tamed me... might be fun!"
msgstr "Personne ne m'a jamais {{dompté|domptée|dompté·e}}... ça pourrait être drôle !"

# Traduction IA – à relire
#: ironaldini_iron/Hate4/0/0
msgctxt "I, Ronaldini"
msgid "I grow weary of your grating presence."
msgstr "Votre présence grinçante me lasse."

# Traduction IA – à relire
#: ironaldini_iron/Hate4/0/8/s/0
msgctxt "Choix"
msgid "Oh yeah? Well I grow weary of YOURS."
msgstr "Ah ouais ? Eh bien la TIENNE me lasse."

# Traduction IA – à relire
#: ironaldini_iron/Hate4/0/9/s/0
msgctxt "Choix"
msgid "Look Ron, I just want to get to know you without all the nonsense."
msgstr "Écoute Ron, je veux juste apprendre à te connaître sans toutes ces bêtises."

# Traduction IA – à relire
#: ironaldini_iron/Hate4/0/c-1/7
msgctxt "I, Ronaldini"
msgid "NEVER CALL ME THAT!"
msgstr "NE M'APPELEZ JAMAIS AINSI !"

# Traduction IA – à relire
#: ironaldini_iron/Hate4/0/c-1/18/0/s/0
msgctxt "Choix"
msgid "What, \"Ron\"?"
msgstr "Quoi, « Ron » ?"

# Traduction IA – à relire
#: ironaldini_iron/Hate4/0/c-1/18/1/s/0
msgctxt "Choix"
msgid "Ooh, touchy!"
msgstr "Ooh, susceptible !"

# Traduction IA – à relire
#: ironaldini_iron/Hate4/0/c-1/18/g-0/0
msgctxt "I, Ronaldini"
msgid "I AM RONALDINI!"
msgstr "JE SUIS RONALDINI !"

# Traduction IA – à relire
#: ironaldini_iron/Hate4/0/c-1/18/g-0/8/0/s/0
msgctxt "Choix"
msgid "What's that, Ronny-boy?"
msgstr "Qu'est-ce que tu dis, Ronny-boy ?"

# Traduction IA – à relire
#: ironaldini_iron/Hate4/0/c-1/18/g-0/8/1/s/0
msgctxt "Choix"
msgid "Ronaldoni Pepperoni?"
msgstr "Ronaldoni Pepperoni ?"

# Traduction IA – à relire
#: ironaldini_iron/Hate4/0/c-1/18/g-0/8/g-0/0
msgctxt "I, Ronaldini"
msgid "CALL ME BY MY NAME!"
msgstr "APPELEZ-MOI PAR MON NOM !"

# Traduction IA – à relire
#: ironaldini_iron/Hate4/0/c-1/18/g-0/8/g-0/11/0/s/0
msgctxt "Choix"
msgid "Mmmmmm RON."
msgstr "Mmmmmm RON."

# Traduction IA – à relire
#: ironaldini_iron/Hate4/0/c-1/18/g-0/8/g-0/11/1/s/0
msgctxt "Choix"
msgid "RON."
msgstr "RON."

# Traduction IA – à relire
#: ironaldini_iron/Hate4/0/c-1/18/g-0/8/g-0/11/2/s/0
msgctxt "Choix"
msgid "I just have this feeling... that your name is simpler than... what you say."
msgstr "J'ai juste l'impression... que ton nom est plus simple que... ce que tu prétends."

# Traduction IA – à relire
#: ironaldini_iron/Hate4/0/c-1/18/g-0/8/g-0/11/c-2/7
msgctxt "I, Ronaldini"
msgid "It's true. I may SEEM like some sort of board-shaped conduit to the swirling mysticism of an outer realm-"
msgstr "C'est vrai. Je peux PARAÎTRE une sorte de conduit en forme de planche vers le mysticisme tourbillonnant d'un royaume extérieur-"

# Traduction IA – à relire
#: ironaldini_iron/Hate4/0/c-1/18/g-0/8/g-0/11/c-2/15/0/s/0
msgctxt "Choix"
msgid "You totally do."
msgstr "Tout à fait."

# Traduction IA – à relire
#: ironaldini_iron/Hate4/0/c-1/18/g-0/8/g-0/11/c-2/15/1/s/0
msgctxt "Choix"
msgid "Fine. Ronaldini. The Great and Terrible Ronaldini!"
msgstr "Bon. Ronaldini. Le Grand et Terrible Ronaldini !"

# Traduction IA – à relire
#: ironaldini_iron/Hate4/0/c-1/18/g-0/8/g-0/11/c-2/15/c-1/7
msgctxt "I, Ronaldini"
msgid "Harumph. Thank you. I'll just rearrange my dishevelment."
msgstr "Hrmpf. Merci. Je vais simplement réarranger mon désordre."

# Traduction IA – à relire
#: ironaldini_iron/Hate4/0/c-1/18/g-0/8/g-0/11/c-2/15/c-1/15/0/s/0
msgctxt "Choix"
msgid "You're welcome. Sorry to have pushed you."
msgstr "De rien. Pardon de t'avoir bousculé."

# Traduction IA – à relire
#: ironaldini_iron/Hate4/0/c-1/18/g-0/8/g-0/11/c-2/15/c-1/15/1/s/0
msgctxt "Choix"
msgid "Go ahead and rearrange. You got messy there."
msgstr "Vas-y, arrange-toi. Tu t'es froissé."

# Traduction IA – à relire
#: ironaldini_iron/Hate4/0/c-1/18/g-0/8/g-0/11/c-2/15/c-1/15/g-0/0
msgctxt "I, Ronaldini"
msgid "I don't even know why that upsets me so much."
msgstr "Je ne sais même pas pourquoi cela me contrarie autant."

# Traduction IA – à relire
#: ironaldini_iron/Hate4/0/c-1/18/g-0/8/g-0/11/c-2/15/c-1/15/g-0/8/0/s/0
msgctxt "Choix"
msgid "Who cares, really."
msgstr "Qui s'en soucie, au fond."

# Traduction IA – à relire
#: ironaldini_iron/Hate4/0/c-1/18/g-0/8/g-0/11/c-2/15/c-1/15/g-0/8/1/s/0
msgctxt "Choix"
msgid "Is it because you're hiding your true self?"
msgstr "C'est parce que tu caches ton vrai moi ?"

# Traduction IA – à relire
#: ironaldini_iron/Hate4/0/c-1/18/g-0/8/g-0/11/c-2/15/c-1/15/g-0/8/2/s/0
msgctxt "Choix"
msgid "I think I pierced the mask, man."
msgstr "Je crois que j'ai percé le masque, mon vieux."

# Traduction IA – à relire
#: ironaldini_iron/Hate4/0/c-1/18/g-0/8/g-0/11/c-2/15/c-1/15/g-0/8/3/s/0
msgctxt "Choix"
msgid "I damaged your defensive posture towards reality?"
msgstr "J'ai ébranlé ta posture défensive face à la réalité ?"

# Traduction IA – à relire
#: ironaldini_iron/Hate4/0/c-1/18/g-0/8/g-0/11/c-2/15/c-1/15/g-0/8/4/s/0
msgctxt "Choix"
msgid "Classic cognitive dissonance. I see it all the time in household objects."
msgstr "De la dissonance cognitive classique. J'en vois tout le temps chez les objets ménagers."

# Traduction IA – à relire
#: ironaldini_iron/Hate4/0/g-0/0
msgctxt "I, Ronaldini"
msgid "Wow."
msgstr "Ouah."

# Traduction IA – à relire
#: ironaldini_iron/Hate4/0/g-0/8/s/0
msgctxt "Choix"
msgid "Right?"
msgstr "N'est-ce pas ?"

# Traduction IA – à relire
#: ironaldini_iron/Hate4/0/g-0/9/s/0
msgctxt "Choix"
msgid "I know. I'm amazing."
msgstr "Je sais. Je suis incroyable."

# Traduction IA – à relire
#: ironaldini_iron/Hate4/0/g-1/0
msgctxt "I, Ronaldini"
msgid "Like. Yeah. Like. Wow."
msgstr "Genre. Ouais. Genre. Ouah."

# Traduction IA – à relire
#: ironaldini_iron/Hate4/0/g-1/8/s/0
msgctxt "Choix"
msgid "I feel like now we're getting somewhere, no?"
msgstr "J'ai l'impression qu'on avance, non ?"

# Traduction IA – à relire
#: ironaldini_iron/Hate4/0/g-1/9/s/0
msgctxt "Choix"
msgid "Your sentences suck now. I think that's a good sign, don't you?"
msgstr "Tes phrases sont nulles, maintenant. Je pense que c'est bon signe, pas toi ?"

# Traduction IA – à relire
#: ironaldini_iron/Hate4/0/g-2/0
msgctxt "I, Ronaldini"
msgid "I think so. I truly do."
msgstr "Je crois bien. Vraiment."

# Traduction IA – à relire
#: ironaldini_iron/Hate4/0/g-2/8
msgctxt "I, Ronaldini"
msgid "You've just pulled off an amazing feat of mentalism on me, the master of that very craft."
msgstr "Vous venez de réussir sur moi un incroyable exploit de mentalisme, à moi, maître de cet art même."

# Traduction IA – à relire
#: ironaldini_iron/Friend4/0/0/s/0
msgctxt "Choix"
msgid "Thanks!"
msgstr "Merci !"

# Traduction IA – à relire
#: ironaldini_iron/Friend4/0/1/s/0
msgctxt "Choix"
msgid "I'll just take a bow real quick."
msgstr "Je fais juste une petite révérence."

# Traduction IA – à relire
#: ironaldini_iron/Friend4/0/c-0/7
msgctxt "I, Ronaldini"
msgid "You are most welcome, O Surprising One."
msgstr "Je vous en prie, ô Surprise incarnée."

# Traduction IA – à relire
#: ironaldini_iron/Friend4/0/c-1/7
msgctxt "I, Ronaldini"
msgid "And what a good bow it is, too! You've had tutoring."
msgstr "Et quelle belle révérence ! Vous avez pris des cours."

# Traduction IA – à relire
#: ironaldini_iron/Friend4/0/c-1/15
msgctxt "I, Ronaldini"
msgid "I wonder..."
msgstr "Je me demande..."

# Traduction IA – à relire
#: ironaldini_iron/Friend4/0/g-0/0
msgctxt "I, Ronaldini"
msgid "Would you allow me the great boon of some transparency? I should like to speak honestly with you."
msgstr "M'accorderiez-vous l'immense faveur d'un peu de transparence ? Je souhaiterais vous parler franchement."

# Traduction IA – à relire
#: ironaldini_iron/Friend4/0/g-0/8/s/0
msgctxt "Choix"
msgid "I'm all ears. Well, not ALL ears. But I do have ears."
msgstr "Je suis tout ouïe. Enfin, pas TOUT ouïe. Mais j'ai bien des oreilles."

# Traduction IA – à relire
#: ironaldini_iron/Friend4/0/g-0/9/s/0
msgctxt "Choix"
msgid "Hm. So we haven't been speaking honestly, then? Good to know."
msgstr "Hm. Donc on ne se parlait pas franchement, jusque-là ? Bon à savoir."

# Traduction IA – à relire
#: ironaldini_iron/Friend4/0/g-0/10/s/0
msgctxt "Choix"
msgid "Fun. I am so helpful. Divulge away!"
msgstr "Super. Je suis d'une aide précieuse. Divulgue !"

# Traduction IA – à relire
#: ironaldini_iron/Friend4/0/g-0/11/s/0
msgctxt "Choix"
msgid "Bring on the honesty."
msgstr "Vas-y, sois franc."

# Traduction IA – à relire
#: ironaldini_iron/Friend4/0/g-0/c-3/7
msgctxt "I, Ronaldini"
msgid "Ah! I've been found out. C'est la vie, I suppose."
msgstr "Ah ! Me voilà démasqué. C'est la vie, je suppose."

# Traduction IA – à relire
#: ironaldini_iron/Friend4/0/g-0/c-3/15
msgctxt "I, Ronaldini"
msgid "Will you still listen, fallen as I am?"
msgstr "Écouterez-vous encore, déchu comme je suis ?"

# Traduction IA – à relire
#: ironaldini_iron/Friend4/0/g-0/c-3/23/0/s/0
msgctxt "Choix"
msgid "Yeah... I guess so."
msgstr "Ouais... je suppose."

# Traduction IA – à relire
#: ironaldini_iron/Friend4/0/g-0/c-3/23/1/s/0
msgctxt "Choix"
msgid "I'm actually more excited now that you're... fallen."
msgstr "Ça m'excite encore plus maintenant que tu es... déchu."

# Traduction IA – à relire
#: ironaldini_iron/Friend4/0/g-0/c-3/23/c-1/7
msgctxt "I, Ronaldini"
msgid "Well, good then. Bend your listening organs to me."
msgstr "Bien, alors. Tendez vos organes d'écoute vers moi."

# Traduction IA – à relire
#: ironaldini_iron/Friend4/0/g-0/c-3/23/g-0/0
msgctxt "I, Ronaldini"
msgid "Whatever type and number of listeners you possess should be quite functional for me now."
msgstr "Quel que soit le type et le nombre d'auditeurs que vous possédez, ils devraient m'être fort utiles à présent."

# Traduction IA – à relire
#: ironaldini_iron/Friend4a/0/0
msgctxt "I, Ronaldini"
msgid "...as impossible as it may sound, it is that I, Ronaldini, the Great and Terrible was not raised by a coven-pack of witch-wolves as my bestselling biography intimated."
msgstr "...aussi impossible que cela puisse paraître, il se trouve que moi, I, Ronaldini, le Grand et Terrible, je n'ai pas été élevé par une meute-clan de loups-sorcières, comme le suggérait ma biographie à succès."

# Traduction IA – à relire
#: ironaldini_iron/Friend4a/0/8/s/0
msgctxt "Choix"
msgid "Gasp!"
msgstr "Ohhh !"

# Traduction IA – à relire
#: ironaldini_iron/Friend4a/0/9/s/0
msgctxt "Choix"
msgid "Noooo.... I can't believe it!"
msgstr "Noooon... Je n'arrive pas à y croire !"

# Traduction IA – à relire
#: ironaldini_iron/Friend4a/0/g-0/0
msgctxt "I, Ronaldini"
msgid "Shocking! I know!"
msgstr "Choquant ! Je sais !"

# Traduction IA – à relire
#: ironaldini_iron/Friend4a/0/g-0/8/s/0
msgctxt "Choix"
msgid "I'm shocked like crazy right now. CRAZY."
msgstr "Je suis sous le choc, là. LE CHOC."

# Traduction IA – à relire
#: ironaldini_iron/Friend4a/0/g-0/9/s/0
msgctxt "Choix"
msgid "So, wait. Was that whole book a lie?"
msgstr "Attends. Tout ce livre était un mensonge ?"

# Traduction IA – à relire
#: ironaldini_iron/Friend4a/0/g-0/c-3/7
msgctxt "I, Ronaldini"
msgid "No! Of course not! Just that bit."
msgstr "Non ! Bien sûr que non ! Juste ce passage."

# Traduction IA – à relire
#: ironaldini_iron/Friend4a/0/g-0/c-3/15
msgctxt "I, Ronaldini"
msgid "Oh, and the one about the Duke of Cornwall's Golden Submersible."
msgstr "Ah, et celui sur le Submersible d'Or du Duc de Cornouailles."

# Traduction IA – à relire
#: ironaldini_iron/Friend4a/0/g-0/c-3/23/0/s/0
msgctxt "Choix"
msgid "Noted. But then, where ARE you from?"
msgstr "Noté. Mais alors, tu viens D'OÙ ?"

# Traduction IA – à relire
#: ironaldini_iron/Friend5/0/0 ironaldini_iron/Friend7a/0/g-2/0
msgctxt "I, Ronaldini"
msgid "I- I-"
msgstr "Je... Je..."

# Traduction IA – à relire
#: ironaldini_iron/Friend5/0/8/s/0
msgctxt "Choix"
msgid "Look Ronaldini, sorry, is it \"I, Ronaldini\" or is it just \"Ronaldini\"?"
msgstr "Écoute Ronaldini, pardon, c'est « I, Ronaldini » ou juste « Ronaldini » ?"

# Traduction IA – à relire
#: ironaldini_iron/Friend5/0/c-0/7
msgctxt "I, Ronaldini"
msgid "It is I! Ronaldini!"
msgstr "C'est moi ! Ronaldini !"

# Traduction IA – à relire
#: ironaldini_iron/Friend5/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "Okay, that doesn't really answer my syntactical question but... I can clearly see you are feeling down."
msgstr "D'accord, ça ne répond pas vraiment à ma question syntaxique mais... je vois bien que tu es abattu."

# Traduction IA – à relire
#: ironaldini_iron/Friend5a/0
msgctxt "I, Ronaldini"
msgid "Ah yes. Shania Plane... Sigh. The finest export from that frozen wasteland until... myself."
msgstr "Ah oui. Shania Plane... Soupir. Le plus bel article d'exportation de ce désert gelé jusqu'à... moi."

# Traduction IA – à relire
#: ironaldini_iron/Friend5b/0/0
msgctxt "I, Ronaldini"
msgid "Me? Ha! I scoff!"
msgstr "Moi ? Ha ! Je ris de dédain !"

# Traduction IA – à relire
#: ironaldini_iron/Friend5b/0/8
msgctxt "I, Ronaldini"
msgid "<i>scoff</i>"
msgstr "<i>ricanement</i>"

# Traduction IA – à relire
#: ironaldini_iron/Friend5b/0/16
msgctxt "I, Ronaldini"
msgid "I am the Great and Terrible I, Ronaldini!! No wordly woe could diminish the pitch black lustre of my..."
msgstr "Je suis le Grand et Terrible I, Ronaldini !! Aucun chagrin terrestre ne saurait ternir l'éclat noir de jais de mon..."

# Traduction IA – à relire
#: ironaldini_iron/Friend5b/0/24/s/0
msgctxt "Choix"
msgid "No... you're crying. Right now."
msgstr "Non... tu pleures. Là, maintenant."

# Traduction IA – à relire
#: ironaldini_iron/Friend5b/0/25/s/0
msgctxt "Choix"
msgid "You do the balance between self-importance and self-pity so well."
msgstr "Tu jongles tellement bien entre l'orgueil et l'apitoiement sur soi."

# Traduction IA – à relire
#: ironaldini_iron/Friend5b/0/26/s/0
msgctxt "Choix"
msgid "Sadness is, in itself, a great and terrible power."
msgstr "La tristesse est, en soi, un grand et terrible pouvoir."

# Traduction IA – à relire
#: ironaldini_iron/Friend5c/0/0
msgctxt "I, Ronaldini"
msgid "I- Wait. It... it is?"
msgstr "Je- Attendez. C'est... c'est vrai ?"

# Traduction IA – à relire
#: ironaldini_iron/Friend5c/0/8/s/0
msgctxt "Choix"
msgid "Sure. It is a realm undiscovered, it would seem."
msgstr "Bien sûr. C'est un royaume inexploré, apparemment."

# Traduction IA – à relire
#: ironaldini_iron/Friend5c/0/9/s/0
msgctxt "Choix"
msgid "Maybe stop fighting it and learn something?"
msgstr "Arrête peut-être de la combattre et apprends-en quelque chose ?"

# Traduction IA – à relire
#: ironaldini_iron/Friend5c/0/g-0/0
msgctxt "I, Ronaldini"
msgid "You're telling me there is a dominion of the soul that I have not yet conquered?"
msgstr "Vous me dites qu'il existe un domaine de l'âme que je n'ai pas encore conquis ?"

# Traduction IA – à relire
#: ironaldini_iron/Friend5c/0/g-0/8/s/0
msgctxt "Choix"
msgid "I'm saying, it may have conquered YOU. Fight back. Tell the truth. Where are you really from, Ron?"
msgstr "Je dis qu'il t'a peut-être conquis, TOI. Bats-toi. Dis la vérité. D'où viens-tu vraiment, Ron ?"

#: ironaldini_iron/Friend5c/0/g-0/9/s/0
msgctxt "Choix"
msgid "If you can just relax, you might be surprised. Come on. Tell the truth about yourself."
msgstr ""

#: ironaldini_iron/Love5/0/0
msgctxt "I, Ronaldini"
msgid "It's just that I am so used to performing in the salons of the wealthy."
msgstr ""

#: ironaldini_iron/Love5/0/8
msgctxt "I, Ronaldini"
msgid "In steamship staterooms crossing the vast unknowable depths of leviathan!"
msgstr ""

#: ironaldini_iron/Love5/0/16
msgctxt "I, Ronaldini"
msgid "Even one time on a Baroness' haunted ski lift."
msgstr ""

#: ironaldini_iron/Love5/0/24
msgctxt "I, Ronaldini"
msgid "I’m accustomed to exposing my long and mighty..."
msgstr ""

#: ironaldini_iron/Love5/0/32
msgctxt "I, Ronaldini"
msgid "My long and mighty..."
msgstr ""

#: ironaldini_iron/Love5/0/40/s/0
msgctxt "Choix"
msgid "Go on..."
msgstr ""

#: ironaldini_iron/Love5/0/41/s/0
msgctxt "Choix"
msgid "Exposing, I like it!"
msgstr ""

#: ironaldini_iron/Love5/0/42/s/0
msgctxt "Choix"
msgid "Uh oh."
msgstr ""

#: ironaldini_iron/Love5/0/g-0/0
msgctxt "I, Ronaldini"
msgid "Great and Terrible..."
msgstr ""

#: ironaldini_iron/Love5/0/g-0/11/s/0
msgctxt "Choix"
msgid "Go onnnnn..."
msgstr ""

#: ironaldini_iron/Love5/0/g-0/12/s/0
msgctxt "Choix"
msgid "Ooh Ronny!"
msgstr ""

#: ironaldini_iron/Love5/0/g-0/13/s/0
msgctxt "Choix"
msgid "Don't, Ron, don't say it!"
msgstr ""

#: ironaldini_iron/Love5/0/g-1/0
msgctxt "I, Ronaldini"
msgid "Powers to the finery of Society's Creme de la Creme."
msgstr ""

#: ironaldini_iron/Love5/0/g-1/8/s/0
msgctxt "Choix"
msgid "That was less spicy than I expected."
msgstr ""

#: ironaldini_iron/Love5/0/g-1/9/s/0
msgctxt "Choix"
msgid "If I'm the homeowner... then I should be the absolute crem-iest."
msgstr ""

#: ironaldini_iron/Love5/0/g-2/0
msgctxt "I, Ronaldini"
msgid "That is true..."
msgstr ""

#: ironaldini_iron/Love5/0/g-2/8/s/0
msgctxt "Choix"
msgid "Expose those \"Great and Terrible\" powers to ME, my dark lord!"
msgstr ""

#: ironaldini_iron/Love5/0/g-2/9/s/0
msgctxt "Choix"
msgid "Did you ever expose your powers to... Shania Plane?"
msgstr ""

#: ironaldini_iron/Love5/0/g-2/10/s/0
msgctxt "Choix"
msgid "You know, there's a lot of value in the not-so-creme-y. Live a little!"
msgstr ""

#: ironaldini_iron/Hate5/0/0
msgctxt "I, Ronaldini"
msgid "...IT'S TRUE! IT'S TRUE! I'M A FAKE! AN IMPOSTER! A FRAUD! A..."
msgstr ""

#: ironaldini_iron/Hate5/0/11/s/0
msgctxt "Choix"
msgid "Phoney?"
msgstr ""

#: ironaldini_iron/Hate5/0/c-0/7
msgctxt "I, Ronaldini"
msgid "A PHONEY! A..."
msgstr ""

#: ironaldini_iron/Hate5/0/c-0/18/0/s/0
msgctxt "Choix"
msgid "Con man?"
msgstr ""

#: ironaldini_iron/Hate5/0/c-0/18/c-0/7
msgctxt "I, Ronaldini"
msgid "A CON MAN! A..."
msgstr ""

#: ironaldini_iron/Hate5/0/c-0/18/c-0/21/0/s/0
msgctxt "Choix"
msgid "Bunko Artist?"
msgstr ""

#: ironaldini_iron/Hate5/0/c-0/18/c-0/21/c-0/7
msgctxt "I, Ronaldini"
msgid "A BUNKO ARTIST!"
msgstr ""

#: ironaldini_iron/Hate5/0/c-0/18/c-0/21/c-0/18/0/s/0
msgctxt "Choix"
msgid "A Flimflam man?"
msgstr ""

#: ironaldini_iron/Hate5/0/c-0/18/c-0/21/c-0/18/c-0/7
msgctxt "I, Ronaldini"
msgid "A... <i>sniff</i> Flimflam man..."
msgstr ""

#: ironaldini_iron/Hate5/0/c-0/18/c-0/21/c-0/18/c-0/18
msgctxt "I, Ronaldini"
msgid "<i>sob</i>"
msgstr ""

#: ironaldini_iron/Hate5/0/c-0/18/c-0/21/c-0/18/c-0/29/0/s/0
msgctxt "Choix"
msgid "A hustler?"
msgstr ""

#: ironaldini_iron/Hate5/0/c-0/18/c-0/21/c-0/18/c-0/29/c-0/7
msgctxt "I, Ronaldini"
msgid "<i>SOB SOB</i>"
msgstr ""

#: ironaldini_iron/Hate5/0/c-0/18/c-0/21/c-0/18/c-0/29/c-0/15/0/s/0
msgctxt "Choix"
msgid "A scammer?"
msgstr ""

#: ironaldini_iron/Hate5/0/c-0/18/c-0/21/c-0/18/c-0/29/c-0/15/c-0/7
msgctxt "I, Ronaldini"
msgid "<w>WEEPY WEEPY SOB SOB</w>"
msgstr ""

#: ironaldini_iron/Hate5/0/c-0/18/c-0/21/c-0/18/c-0/29/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "A swindler?"
msgstr ""

#: ironaldini_iron/Hate5/0/c-0/18/c-0/21/c-0/18/c-0/29/c-0/15/c-0/15/c-0/7
msgctxt "I, Ronaldini"
msgid "<i>sob</i> Please! <i>sniff</i> Please stop! <i>sniffy snort</i> Please!"
msgstr ""

#: ironaldini_iron/Hate5/0/c-0/18/c-0/21/c-0/18/c-0/29/c-0/15/c-0/15/c-0/18/0/s/0
msgctxt "Choix"
msgid "... ell alright then."
msgstr ""

#: ironaldini_iron/Hate5/0/c-0/18/c-0/21/c-0/18/c-0/29/c-0/15/c-0/15/c-0/18/1/s/0
msgctxt "Choix"
msgid "You're also a big baby."
msgstr ""

#: ironaldini_iron/Hate5/0/c-0/18/c-0/21/c-0/18/c-0/29/c-0/15/c-0/15/c-0/18/2/s/0
msgctxt "Choix"
msgid "Sorry. Got a little carried away."
msgstr ""

#: ironaldini_iron/Hate5/0/c-0/18/c-0/21/c-0/18/c-0/29/c-0/15/c-0/15/c-0/18/3/s/0
msgctxt "Choix"
msgid "No! Ya Canucklehead!"
msgstr ""

#: ironaldini_iron/Hate5/0/c-0/18/c-0/21/c-0/18/c-0/29/c-0/15/c-0/15/c-0/18/c-1/7
msgctxt "I, Ronaldini"
msgid "Mercy! I beg!"
msgstr ""

#: ironaldini_iron/Hate5/0/c-0/18/c-0/21/c-0/18/c-0/29/c-0/15/c-0/15/c-0/18/c-1/15/0/s/0
msgctxt "Choix"
msgid "Ron. RON. Get a hold of yourself."
msgstr ""

#: ironaldini_iron/Hate5/0/c-0/18/c-0/21/c-0/18/c-0/29/c-0/15/c-0/15/c-0/18/c-2/7
msgctxt "I, Ronaldini"
msgid "It's fine, I understand. I deserve it."
msgstr ""

#: ironaldini_iron/Hate5a/0/0
msgctxt "I, Ronaldini"
msgid "Yes! Denigrate me! I deserve it! I'm Canadian!"
msgstr ""

#: ironaldini_iron/Hate5a/0/11/s/0
msgctxt "Choix"
msgid "You are!? Blech!"
msgstr ""

#: ironaldini_iron/Hate5a/0/12/s/0
msgctxt "Choix"
msgid "Oh stop being so dramatic!"
msgstr ""

#: ironaldini_iron/Hate5aCON/0/0
msgctxt "I, Ronaldini"
msgid "I can't help it! I'm a performer! Of great renown!"
msgstr ""

#: ironaldini_iron/Hate5aCON/0/8/s/0
msgctxt "Choix"
msgid "Ron? Pull yourself together."
msgstr ""

#: ironaldini_iron/Hate5aCON/0/c-0/7
msgctxt "I, Ronaldini"
msgid "<i>sniff</i> Fine."
msgstr ""

#: ironaldini_iron/Hate5aCON/0/c-0/15
msgctxt "I, Ronaldini"
msgid "<i>sniffle</i>"
msgstr ""

#: ironaldini_iron/Hate5aCON/0/c-0/26/0/s/0
msgctxt "Choix"
msgid "You're clearly feeling soppy. So let's work through it already."
msgstr ""

#: ironaldini_iron/Hate5aCON/0/c-0/26/1/s/0
msgctxt "Choix"
msgid "You are just the tiniest bit ridiculous. You know that, right?"
msgstr ""

#: ironaldini_iron/Hate5aCON/0/c-0/26/c-1/7
msgctxt "I, Ronaldini"
msgid "Of course I do. I would change, I would try to at least..."
msgstr ""

#: ironaldini_iron/Hate5aCON/0/c-0/26/g-0/0
msgctxt "I, Ronaldini"
msgid "But I'm so ashamed!"
msgstr ""

#: ironaldini_iron/Hate5aCON/0/c-0/26/g-0/11/0/s/0
msgctxt "Choix"
msgid "DO AS I COMMAND!"
msgstr ""

#: ironaldini_iron/Hate5aCON/0/c-0/26/g-0/11/1/s/0
msgctxt "Choix"
msgid "Good GRIEF."
msgstr ""

#: ironaldini_iron/Hate5aCON/0/c-0/26/g-0/11/c-0/7
msgctxt "I, Ronaldini"
msgid "Oh the shame! I cannot be commanded!"
msgstr ""

#: ironaldini_iron/Hate5aCanadian/0
msgctxt "I, Ronaldini"
msgid "It's true!"
msgstr ""

#: ironaldini_iron/Friend6/0/0
msgctxt "I, Ronaldini"
msgid "My true origin story is decidedly not astonishing. I... I was manufactured... in Canada."
msgstr ""

#: ironaldini_iron/Friend6/0/11/s/0
msgctxt "Choix"
msgid "Like Shania Plane!"
msgstr ""

#: ironaldini_iron/Friend6/0/12/s/0
msgctxt "Choix"
msgid "Gross!"
msgstr ""

#: ironaldini_iron/Friend6/0/13/s/0
msgctxt "Choix"
msgid "Wow. I didn't even hear an accent. You sneaks are everywhere."
msgstr ""

#: ironaldini_iron/Friend6/0/14/s/0
msgctxt "Choix"
msgid "No way! I had a roommate from Canada. Do you know Gary?"
msgstr ""

#: ironaldini_iron/Friend6/0/c-2/7
msgctxt "I, Ronaldini"
msgid "I'm no sneak!"
msgstr ""

#: ironaldini_iron/Friend6/0/c-2/15/0/s/0
msgctxt "Choix"
msgid "I know! I know. I was just kidding. Tell me about it."
msgstr ""

#: ironaldini_iron/Friend6/0/c-3/7 ironaldini_iron/Friend7Can/0/c-0/7
msgctxt "I, Ronaldini"
msgid "No! Canada is a vast, unknowable space, just because I'm FROM there doesn't mean I know this..."
msgstr ""

#: ironaldini_iron/Friend6/0/c-3/15 ironaldini_iron/Friend7Can/0/c-0/15
msgctxt "I, Ronaldini"
msgid "Gary was it?"
msgstr ""

#: ironaldini_iron/Friend6/0/c-3/23/0/s/0 ironaldini_iron/Friend7Can/0/c-0/23/0/s/0
msgctxt "Choix"
msgid "Yeah, Gary from Vegreville."
msgstr ""

#: ironaldini_iron/Friend6/0/c-3/23/1/s/0
msgctxt "Choix"
msgid "Gary! Super nice guy, kinda portly, wears a lavender tea cozy?"
msgstr ""

#: ironaldini_iron/Friend6/0/c-3/23/g-0/0 ironaldini_iron/Friend7Can/0/g-0/0
msgctxt "I, Ronaldini"
msgid "Oh. I actually do know Gary. Weird."
msgstr ""

#: ironaldini_iron/Friend6/0/c-3/23/g-0/8
msgctxt "I, Ronaldini"
msgid "Though he would never recognize me! Not any longer."
msgstr ""

#: ironaldini_iron/Friend6/0/c-3/23/g-0/16/0/s/0
msgctxt "Choix"
msgid "Of course not. You're a changed board. Dare I say, a better one?"
msgstr ""

#: ironaldini_iron/Friend6/0/c-3/23/g-0/16/1/s/0
msgctxt "Choix"
msgid "Well yeah, you're wearing a LOT of eyeliner right now."
msgstr ""

#: ironaldini_iron/Friend6/0/c-3/23/g-0/16/2/s/0
msgctxt "Choix"
msgid "His loss! You're way more interesting now."
msgstr ""

#: ironaldini_iron/Friend6/0/c-3/23/g-0/16/c-0/7
msgctxt "I, Ronaldini"
msgid "Then why do I feel like less, somehow?"
msgstr ""

#: ironaldini_iron/Friend6/0/c-3/23/g-0/16/c-0/15/0/s/0
msgctxt "Choix"
msgid "I don't know. Tell me about it."
msgstr ""

#: ironaldini_iron/Friend6/0/c-3/23/g-0/16/g-0/0
msgctxt "I, Ronaldini"
msgid "You are kind and generous to say so. But am I not denying my inner truth?"
msgstr ""

#: ironaldini_iron/Friend6/0/c-3/23/g-0/16/g-0/8/0/s/0
msgctxt "Choix"
msgid "\"Inner truth\" is overrated. Your outer truth is fire."
msgstr ""

#: ironaldini_iron/Friend6/0/c-3/23/g-0/16/g-0/8/1/s/0
msgctxt "Choix"
msgid "Yes. You might be. And that's a dangerous game."
msgstr ""

#: ironaldini_iron/Friend6/0/c-3/23/g-0/16/g-0/8/2/s/0
msgctxt "Choix"
msgid "You might be. Who knows? The \"real\" you could be boring as hell."
msgstr ""

#: ironaldini_iron/Friend6/0/c-3/23/g-0/16/g-0/8/c-0/7
msgctxt "I, Ronaldini"
msgid "You think so?"
msgstr ""

#: ironaldini_iron/Friend6/0/c-3/23/g-0/16/g-0/8/c-0/15/0/s/0
msgctxt "Choix"
msgid "Oh I do."
msgstr ""

#: ironaldini_iron/Friend6/0/c-3/23/g-0/16/g-0/8/c-1/7
msgctxt "I, Ronaldini"
msgid "More dangerous than escaping a tiger trap actually filled with tigers?"
msgstr ""

#: ironaldini_iron/Friend6/0/c-3/23/g-0/16/g-0/8/c-1/15/0/s/0
msgctxt "Choix"
msgid "Maybe, maybe not. It's tough to be happy with yourself when you deny where you came from."
msgstr ""

#: ironaldini_iron/Friend6/0/c-3/23/g-0/16/g-0/8/c-1/15/c-0/7
msgctxt "I, Ronaldini"
msgid "Huh."
msgstr ""

#: ironaldini_iron/Friend6/0/c-3/23/g-0/16/g-0/8/c-1/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "Tell me about it."
msgstr ""

#: ironaldini_iron/Love6/0/0
msgctxt "I, Ronaldini"
msgid "The inky vacuum of my proclivities may be too much for a mere mortal to handle..."
msgstr ""

#: ironaldini_iron/Love6/0/8/s/0
msgctxt "Choix"
msgid "I'm willing to be lost forever if need be..."
msgstr ""

#: ironaldini_iron/Love6/0/9/s/0
msgctxt "Choix"
msgid "I'm not afraid of any vacuums. I have one in the closet right now."
msgstr ""

#: ironaldini_iron/Love6/0/g-0/0
msgctxt "I, Ronaldini"
msgid "You have no fear?"
msgstr ""

#: ironaldini_iron/Love6/0/g-0/8/s/0
msgctxt "Choix"
msgid "A little bit, yeah."
msgstr ""

#: ironaldini_iron/Love6/0/g-0/9/s/0
msgctxt "Choix"
msgid "Oh, I'm afraid... but you give me strength."
msgstr ""

#: ironaldini_iron/Love6/0/g-0/c-2/7
msgctxt "I, Ronaldini"
msgid "Too much to venture on to the darker side of our collective psyches?"
msgstr ""

#: ironaldini_iron/Love6/0/g-0/c-2/15/0/s/0
msgctxt "Choix"
msgid "Oh, um... that's too intense. Let's talk a little more, huh? Tell me about you."
msgstr ""

#: ironaldini_iron/Love6/0/g-0/c-3/7
msgctxt "I, Ronaldini"
msgid "I can take that strength away with a wave of my hand."
msgstr ""

#: ironaldini_iron/Love6/0/g-0/c-3/15/0/s/0
msgctxt "Choix"
msgid "Would you rather I were trembling with fear? Or with pleasure?"
msgstr ""

#: ironaldini_iron/Love6/0/g-0/c-3/15/1/s/0
msgctxt "Choix"
msgid "Even the suggestion of it has my knees weak."
msgstr ""

#: ironaldini_iron/Love6/0/g-0/c-3/15/2/s/0
msgctxt "Choix"
msgid "Wave your hand if you dare to. I'll grab your wrist. And I will squeeze."
msgstr ""

#: ironaldini_iron/Love6/0/g-0/c-3/15/c-0/7
msgctxt "I, Ronaldini"
msgid "Why can it not be both?"
msgstr ""

#: ironaldini_iron/Love6/0/g-0/c-3/15/c-1/7
msgctxt "I, Ronaldini"
msgid "As long as parts of you remain strong. The parts I will require."
msgstr ""

#: ironaldini_iron/Love6/0/g-0/c-3/15/c-2/7
msgctxt "I, Ronaldini"
msgid "You think you could catch MY hand? Haha, HAHAHHA!"
msgstr ""

#: ironaldini_iron/Love6/0/g-0/c-3/15/c-2/15
msgctxt "I, Ronaldini"
msgid "Hours upon hours I've trained these hands, gazing into the mirror, until they were able to achieve the impossible."
msgstr ""

#: ironaldini_iron/Love6/0/g-0/c-3/15/c-2/23
msgctxt "I, Ronaldini"
msgid "My sleight of hand is anything but slight."
msgstr ""

#: ironaldini_iron/Love6/0/g-0/c-3/15/c-2/31/0/s/0
msgctxt "Choix"
msgid "I'm up to the challenge."
msgstr ""

#: ironaldini_iron/Love6/0/g-0/c-3/15/c-2/31/c-0/7
msgctxt "I, Ronaldini"
msgid "I tell you, quite simply, that you are not. The fact you would even entertain the notion that you ARE indicates a distressing lack of self awareness."
msgstr ""

#: ironaldini_iron/Love6/0/g-0/c-3/15/c-2/31/c-0/15/0/s/0
msgctxt "Choix"
msgid "You're right. I was just trying to impress you."
msgstr ""

#: ironaldini_iron/Love6/0/g-0/c-3/15/c-2/31/c-0/15/1/s/0
msgctxt "Choix"
msgid "Hm. What's that over by the toaster?"
msgstr ""

#: ironaldini_iron/Love6/0/g-0/c-3/15/c-2/31/c-0/15/c-0/7
msgctxt "I, Ronaldini"
msgid "Well, don't."
msgstr ""

#: ironaldini_iron/Love6/0/g-0/c-3/15/c-2/31/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "Yes, Master."
msgstr ""

#: ironaldini_iron/Love6/0/g-0/c-3/15/c-2/31/c-0/15/c-0/15/1/s/0
msgctxt "Choix"
msgid "Message received."
msgstr ""

#: ironaldini_iron/Love6/0/g-0/c-3/15/c-2/31/c-0/15/c-1/7
msgctxt "I, Ronaldini"
msgid "Hm? What? Where?"
msgstr ""

#: ironaldini_iron/Love6/0/g-0/c-3/15/c-2/31/c-0/15/c-1/23
msgctxt "I, Ronaldini"
msgid "I see."
msgstr ""

#: ironaldini_iron/Love6/0/g-0/c-3/15/c-2/31/c-0/15/c-1/31
msgctxt "I, Ronaldini"
msgid "A ruse - successfully done."
msgstr ""

#: ironaldini_iron/Love6/0/g-0/c-3/15/c-2/31/c-0/15/c-1/39
msgctxt "I, Ronaldini"
msgid "...this does not make me feel well."
msgstr ""

#: ironaldini_iron/Hate6/0/0
msgctxt "I, Ronaldini"
msgid "Wahaahaaaahaaaaaaaah!"
msgstr ""

#: ironaldini_iron/Hate6/0/11/s/0
msgctxt "Choix"
msgid "<i>Snap your fingers.</i>"
msgstr ""

#: ironaldini_iron/Hate6/0/c-0/7
msgctxt "I, Ronaldini"
msgid "Whuh? Huh?"
msgstr ""

#: ironaldini_iron/Hate6/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "Canada. Go."
msgstr ""

#: ironaldini_iron/Hate6/0/c-0/15/1/s/0
msgctxt "Choix"
msgid "You were having a moment about Canada for some reason."
msgstr ""

#: ironaldini_iron/Hate6a/0/4
msgctxt "I, Ronaldini"
msgid "I- I was built in Lloydminster, Saskatchewan. In a factory on a remote windblown plain."
msgstr ""

#: ironaldini_iron/Hate6a/0/15/s/0
msgctxt "Choix"
msgid "I drove through there once. It was pretty flat."
msgstr ""

#: ironaldini_iron/Hate6a/0/16/s/0
msgctxt "Choix"
msgid "Looks pretty windblown by the picture..."
msgstr ""

#: ironaldini_iron/Hate6a/0/c-0/7
msgctxt "I, Ronaldini"
msgid "Gah, it's dreadful. Once the factory dog ran away and I could still see it two days later!"
msgstr ""

#: ironaldini_iron/Hate6a/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "And you didn't go get him? Harsh."
msgstr ""

#: ironaldini_iron/Hate6a/0/c-0/15/1/s/0
msgctxt "Choix"
msgid "Mateo would have something to say about that!"
msgstr ""

#: ironaldini_iron/Hate6a/0/c-0/15/g-0/0
msgctxt "I, Ronaldini"
msgid "He was fine. He got bored and wandered back."
msgstr ""

#: ironaldini_iron/Hate6a/0/c-0/15/g-0/8/0/s/0
msgctxt "Choix"
msgid "Got it. Continue."
msgstr ""

#: ironaldini_iron/Hate6a/0/g-0/0
msgctxt "I, Ronaldini"
msgid "There was no mystery in that icy landscape. Nothing wondrous. No fantasy or escape, save for death by boredom or freezing if you were lucky."
msgstr ""

#: ironaldini_iron/Hate6a/0/g-0/8/s/0
msgctxt "Choix"
msgid "Sounds bleak alright."
msgstr ""

#: ironaldini_iron/Hate6a/0/g-0/9/s/0
msgctxt "Choix"
msgid "Is it really so empty?"
msgstr ""

#: ironaldini_iron/Hate6a/0/g-0/10/s/0
msgctxt "Choix"
msgid "Magic can happen anywhere, I might even be feeling some of it happen right now..."
msgstr ""

#: ironaldini_iron/Hate6a/0/g-0/c-3/7
msgctxt "I, Ronaldini"
msgid "If you were to stare into the distance very carefully, you could see the back of your own head."
msgstr ""

#: ironaldini_iron/Hate6a/0/g-0/c-3/15/0/s/0
msgctxt "Choix"
msgid "Bleak. That's the only word I've got for what you're describing."
msgstr ""

#: ironaldini_iron/Hate6a/0/g-0/c-3/15/1/s/0
msgctxt "Choix"
msgid "I don't get it."
msgstr ""

#: ironaldini_iron/Hate6a/0/g-0/c-3/15/c-0/7
msgctxt "I, Ronaldini"
msgid "Bleak. Yes."
msgstr ""

#: ironaldini_iron/Hate6a/0/g-0/c-3/15/c-1/7
msgctxt "I, Ronaldini"
msgid "And you never will as long as you stay away from there like I have..."
msgstr ""

#: ironaldini_iron/Hate6a/0/g-0/c-4/7
msgctxt "I, Ronaldini"
msgid "The kind that sparkles with a dread fire?"
msgstr ""

#: ironaldini_iron/Hate6a/0/g-0/c-4/15/0/s/0
msgctxt "Choix"
msgid "More like a gentle ember of friendship. Just tell me some more."
msgstr ""

#: ironaldini_iron/Love7/0/0
msgctxt "I, Ronaldini"
msgid "I shall give you no further warning. Once you fall under my sway I will not easily relinquish you."
msgstr ""

#: ironaldini_iron/Love7/0/8/s/0
msgctxt "Choix"
msgid "I was super into this but now I'm getting uncomfortable."
msgstr ""

#: ironaldini_iron/Love7/0/9/s/0
msgctxt "Choix"
msgid "Hey, I volunteer. The sway, the relinquishment, the show, the whole deal."
msgstr ""

#: ironaldini_iron/Love7/0/c-0/7
msgctxt "I, Ronaldini"
msgid "This opportunity will not present itself again. That I'm condescending to speak to you at all is, in itself, a miracle."
msgstr ""

#: ironaldini_iron/Love7/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "Um. Yeah. No. No thanks. Bye!"
msgstr ""

#: ironaldini_iron/Love7/0/c-0/15/1/s/0
msgctxt "Choix"
msgid "Condescend no longer, pal!"
msgstr ""

#: ironaldini_iron/Love7/0/c-0/15/g-0/0
msgctxt "I, Ronaldini"
msgid "Farewell."
msgstr ""

#: ironaldini_iron/Love7/0/c-1/7
msgctxt "I, Ronaldini"
msgid "I rarely choose the most enthusiastic option..."
msgstr ""

#: ironaldini_iron/Love7/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "Well, I can't help it if you excite me."
msgstr ""

#: ironaldini_iron/Love7/0/c-1/15/1/s/0
msgctxt "Choix"
msgid "Let this be one of the rare occasions, then!"
msgstr ""

#: ironaldini_iron/Love7/0/g-0/0
msgctxt "I, Ronaldini"
msgid "You'd best control that excitement. It would be a terrible shame for my command performance to be... shall we say... halted in the first act?"
msgstr ""

#: ironaldini_iron/Love7/0/g-0/8/s/0
msgctxt "Choix"
msgid "It doesn't have to be a single show. I'd buy tickets to an entire run."
msgstr ""

#: ironaldini_iron/Love7/0/g-0/9/s/0
msgctxt "Choix"
msgid "Things happen. There's always tomorrow night..."
msgstr ""

#: ironaldini_iron/Love7/0/g-1/0
msgctxt "I, Ronaldini"
msgid "Then make yourself useful."
msgstr ""

#: ironaldini_iron/Love7/0/g-1/8/s/0
msgctxt "Choix"
msgid "Your wish is my command."
msgstr ""

#: ironaldini_iron/Love7/0/g-1/9/s/0
msgctxt "Choix"
msgid "Gotta love flirtation where I have a 'use'."
msgstr ""

#: ironaldini_iron/Love7/0/g-2/0
msgctxt "I, Ronaldini"
msgid "First you'll need to get into my simple empty little closet."
msgstr ""

#: ironaldini_iron/Love7/0/g-2/8/s/0
msgctxt "Choix"
msgid "Am I getting in alone?"
msgstr ""

#: ironaldini_iron/Love7/0/g-2/9/s/0
msgctxt "Choix"
msgid "But it's dark in there..."
msgstr ""

#: ironaldini_iron/Love7/0/g-3/0
msgctxt "I, Ronaldini"
msgid "NOW are you afraid?"
msgstr ""

#: ironaldini_iron/Love7/0/g-3/8/s/0
msgctxt "Choix"
msgid "Are you gonna saw me in half?"
msgstr ""

#: ironaldini_iron/Love7/0/g-3/9/s/0
msgctxt "Choix"
msgid "Depends what else you keep in here."
msgstr ""

#: ironaldini_iron/Love7/0/g-3/c-8/7
msgctxt "I, Ronaldini"
msgid "Only if you ask nicely."
msgstr ""

#: ironaldini_iron/Love7/0/g-3/c-9/7
msgctxt "I, Ronaldini"
msgid "Oh, just my wand, silk binding rope, a few blindfolds. Tools of the trade, darling..."
msgstr ""

#: ironaldini_iron/Love7/0/g-4/0/s/0
msgctxt "Choix"
msgid "Please get in with me?"
msgstr ""

#: ironaldini_iron/Love7/0/g-4/1/s/0
msgctxt "Choix"
msgid "Much more fun if we're in here together, I think."
msgstr ""

#: ironaldini_iron/Love7/0/g-5/0
msgctxt "I, Ronaldini"
msgid "Ah, but it locks from the outside. I currently have no assistants."
msgstr ""

#: ironaldini_iron/Love7/0/g-5/8/s/0
msgctxt "Choix"
msgid "Will we be trapped in there? Forever?"
msgstr ""

#: ironaldini_iron/Love7/0/g-5/9/s/0
msgctxt "Choix"
msgid "What makes you think I'll want to escape?"
msgstr ""

#: ironaldini_iron/Love7/0/g-5/c-12/7
msgctxt "I, Ronaldini"
msgid "You're never trapped anywhere with I, Ronaldini! Master of Escape!"
msgstr ""

#: ironaldini_iron/Love7/0/g-5/c-12/15/0/s/0
msgctxt "Choix"
msgid "But weren't you trapped in there until Bobby opened it?"
msgstr ""

#: ironaldini_iron/Love7/0/g-5/c-12/15/c-0/7
msgctxt "I, Ronaldini"
msgid "Well, yes... but-"
msgstr ""

#: ironaldini_iron/Love7/0/g-5/c-12/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "That hardly seems like you're a \"Master of Escape\"."
msgstr ""

#: ironaldini_iron/Love7/0/g-5/c-12/15/c-0/15/1/s/0
msgctxt "Choix"
msgid "Kinda killin' the mood right now..."
msgstr ""

#: ironaldini_iron/Love7/0/g-5/c-12/15/c-0/15/g-0/0
msgctxt "I, Ronaldini"
msgid "Well, I mean-"
msgstr ""

#: ironaldini_iron/Love7/0/g-5/c-12/15/c-0/15/g-0/8/0/s/0
msgctxt "Choix"
msgid "In fact, it's sort of pitiful."
msgstr ""

#: ironaldini_iron/Love7/0/g-5/c-13/7
msgctxt "I, Ronaldini"
msgid "What makes you think you won't wish you could?"
msgstr ""

#: ironaldini_iron/Love7/0/g-5/c-13/15/0/s/0
msgctxt "Choix"
msgid "So, what happens when we're in the box?"
msgstr ""

#: ironaldini_iron/Love7/0/g-5/c-13/15/c-0/7
msgctxt "I, Ronaldini"
msgid "Normally someone from the audience shoves a bunch of swords through it."
msgstr ""

#: ironaldini_iron/Love7/0/g-5/c-13/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "Hm. Shoving. We can do that."
msgstr ""

#: ironaldini_iron/Love7/0/g-5/c-13/15/c-0/15/1/s/0
msgctxt "Choix"
msgid "Oh... if you prefer performing in front of an audience I'm game."
msgstr ""

#: ironaldini_iron/Love7/0/g-6/0
msgctxt "I, Ronaldini"
msgid "How... scintillating..."
msgstr ""

#: ironaldini_iron/Love7/0/g-6/8
msgctxt "I, Ronaldini"
msgid "Part the curtains..."
msgstr ""

#: ironaldini_iron/Love7/0/g-6/19/s/0
msgctxt "Choix"
msgid "Master, I am yours. A rapt audience at your mercy. let the show begin!"
msgstr ""

#: ironaldini_iron/hate5a_divert/0/0
msgctxt "I, Ronaldini"
msgid "Why are you being so harsh!?"
msgstr ""

#: ironaldini_iron/hate5a_divert/0/8/s/0
msgctxt "Choix"
msgid "Just tell me the truth."
msgstr ""

#: ironaldini_iron/Love7a/0/0/s/0
msgctxt "Choix"
msgid "Look. I'm terribly interested in you."
msgstr ""

#: ironaldini_iron/Love7a/0/c-0/7
msgctxt "I, Ronaldini"
msgid "Of course you are, I'm terribly interesting."
msgstr ""

#: ironaldini_iron/Love7a/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "But I'm not some sequined assistant here to do your bidding."
msgstr ""

#: ironaldini_iron/Love7a/0/c-0/15/c-0/7
msgctxt "I, Ronaldini"
msgid "I could force you to do my bidding."
msgstr ""

#: ironaldini_iron/Love7a/0/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "And how would you go about doing that?"
msgstr ""

#: ironaldini_iron/Love7a/0/c-0/15/c-0/15/c-0/7
msgctxt "I, Ronaldini"
msgid "I could stare into your eyes, snap my fingers, and your inhibitions would vanish. Your free will gone, bent to serve me."
msgstr ""

#: ironaldini_iron/Love7a/0/c-0/15/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "Oh? And you think I'd be interested in serving you?"
msgstr ""

#: ironaldini_iron/Love7a/0/c-0/15/c-0/15/c-0/15/1/s/0
msgctxt "Choix"
msgid "Then snap those fingers."
msgstr ""

#: ironaldini_iron/Love7a/0/c-0/15/c-0/15/c-0/15/2/s/0
msgctxt "Choix"
msgid "Yeah. I don't think so."
msgstr ""

#: ironaldini_iron/Love7a/0/c-0/15/c-0/15/c-0/15/c-2/7
msgctxt "I, Ronaldini"
msgid "Well, that isn't up to you."
msgstr ""

#: ironaldini_iron/Love7a/0/c-0/15/c-0/15/c-0/15/c-2/15/0/s/0
msgctxt "Choix"
msgid "I can leave if I wish."
msgstr ""

#: ironaldini_iron/Love7a/0/c-0/15/c-0/15/c-0/15/c-2/15/c-0/7
msgctxt "I, Ronaldini"
msgid "And pass up the chance at a command performance?"
msgstr ""

#: ironaldini_iron/Love7a/0/c-0/15/c-0/15/c-0/15/c-2/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "If it's you commanding, I'm not sure I'm interested."
msgstr ""

#: ironaldini_iron/Love7b/0/0
msgctxt "I, Ronaldini"
msgid "I treat my servants well."
msgstr ""

#: ironaldini_iron/Love7b/0/8/s/0
msgctxt "Choix"
msgid "Prove it."
msgstr ""

#: ironaldini_iron/Love7b/0/9/s/0
msgctxt "Choix"
msgid "But I have a concern."
msgstr ""

#: ironaldini_iron/Love7b/0/10/s/0
msgctxt "Choix"
msgid "I just don't know. It's like I'm offering to enable you."
msgstr ""

#: ironaldini_iron/Love7b/0/c-1/7
msgctxt "I, Ronaldini"
msgid "You should."
msgstr ""

#: ironaldini_iron/Love7b/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "Is it true that a magician never performs the same trick twice for an audience?"
msgstr ""

#: ironaldini_iron/Love7b/0/c-1/15/c-0/7
msgctxt "I, Ronaldini"
msgid "That is a part of our code, yes."
msgstr ""

#: ironaldini_iron/Love7b/0/c-1/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "What if I like a particular one of your tricks? A lot?"
msgstr ""

#: ironaldini_iron/Love7b/0/c-1/15/c-0/15/c-0/7
msgctxt "I, Ronaldini"
msgid "I may make an exception if you serve me well."
msgstr ""

#: ironaldini_iron/Love7b/0/c-1/15/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "Well. Now I'm motivated."
msgstr ""

#: ironaldini_iron/Love7b/0/c-2/7
msgctxt "I, Ronaldini"
msgid "Think of what that will enable me to do to you."
msgstr ""

#: ironaldini_iron/Love7b/0/c-2/15/0/s/0
msgctxt "Choix"
msgid "Aaaaaand I'm back on board! Let's do this! I am yours!"
msgstr ""

#: ironaldini_iron/Love7b/0/c-2/15/1/s/0
msgctxt "Choix"
msgid "This, whatever this turns out to be, may wind up being more meaningful if I say no."
msgstr ""

#: ironaldini_iron/Love7b/0/c-2/15/c-1/7
msgctxt "I, Ronaldini"
msgid "Unless I disappear."
msgstr ""

#: ironaldini_iron/Love7b/0/c-2/15/c-1/15/0/s/0
msgctxt "Choix"
msgid "I wouldn't mind \"I, Ronaldini!\" disappearing. I still want to know about the REAL you."
msgstr ""

#: ironaldini_iron/Friend7/0/3
msgctxt "I, Ronaldini"
msgid "Sigh... My truth is uninteresting."
msgstr ""

#: ironaldini_iron/Friend7/0/11/s/0
msgctxt "Choix"
msgid "It's interesting to me."
msgstr ""

#: ironaldini_iron/Friend7/0/c-0/7
msgctxt "I, Ronaldini"
msgid "You don't mean it."
msgstr ""

#: ironaldini_iron/Friend7/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "Sometimes truth holds magic, and that's the magic that interests me."
msgstr ""

#: ironaldini_iron/Friend7/0/c-0/15/c-0/7
msgctxt "I, Ronaldini"
msgid "Surely you're the only human in the world who thinks so."
msgstr ""

#: ironaldini_iron/Friend7/0/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "I doubt that. You're inherently interesting. So go on, tell me."
msgstr ""

#: ironaldini_iron/Friend7/0/c-0/15/c-0/15/c-0/7
msgctxt "I, Ronaldini"
msgid "What is there to say? I'm a world famous master of mystery, a diabolically devious devotee to the dark arts."
msgstr ""

#: ironaldini_iron/Friend7/0/c-0/15/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "And?"
msgstr ""

#: ironaldini_iron/Friend7/0/c-0/15/c-0/15/c-0/15/c-0/7
msgctxt "I, Ronaldini"
msgid "And... I'm a normal iron manufactured in Lloydminster, Saskatchewan."
msgstr ""

#: ironaldini_iron/Friend7Can/0/0/s/0
msgctxt "Choix"
msgid "No way! I had a roommate from Canada! Do you know Gary?"
msgstr ""

#: ironaldini_iron/Friend7Can/0/c-0/23/1/s/0
msgctxt "Choix"
msgid "Super nice guy, kinda portly, wears a lavender tea cozy?"
msgstr ""

#: ironaldini_iron/Friend7Can/0/g-0/8/s/0
msgctxt "Choix"
msgid "Awesome!"
msgstr ""

#: ironaldini_iron/Friend7Can/0/g-0/9/s/0
msgctxt "Choix"
msgid "Lucky you."
msgstr ""

#: ironaldini_iron/Friend7Can/0/g-1/0
msgctxt "I, Ronaldini"
msgid "But I despised that place. The fate I was cast in."
msgstr ""

#: ironaldini_iron/Friend7a/0/0/s/0
msgctxt "Choix"
msgid "So you escaped that boring life and charged into the great wide world."
msgstr ""

#: ironaldini_iron/Friend7a/0/1/s/0
msgctxt "Choix"
msgid "So you left, and became somebody else?"
msgstr ""

#: ironaldini_iron/Friend7a/0/g-0/0
msgctxt "I, Ronaldini"
msgid "That is correct. I live a lie every day."
msgstr ""

#: ironaldini_iron/Friend7a/0/g-0/8/s/0
msgctxt "Choix"
msgid "But which truth is the truest?"
msgstr ""

#: ironaldini_iron/Friend7a/0/g-0/9/s/0
msgctxt "Choix"
msgid "But is it a lie if you do it truthfully?"
msgstr ""

#: ironaldini_iron/Friend7a/0/g-1/0
msgctxt "I, Ronaldini"
msgid "An impossible question."
msgstr ""

#: ironaldini_iron/Friend7a/0/g-1/8/s/0
msgctxt "Choix"
msgid "Come on. Give it a shot."
msgstr ""

#: ironaldini_iron/Friend7a/0/g-1/9/s/0
msgctxt "Choix"
msgid "Those are the best ones for learning about ourselves!"
msgstr ""

#: ironaldini_iron/Friend7a/0/g-2/8/s/0
msgctxt "Choix"
msgid "Escape the straightjacket and padlocks that hold your truth prisoner!"
msgstr ""

#: ironaldini_iron/Friend7a/0/g-2/9/s/0
msgctxt "Choix"
msgid "Reach into the top hat of your heart and pull out the bunny of truth!"
msgstr ""

#: ironaldini_iron/Friend7a/0/g-3/0
msgctxt "I, Ronaldini"
msgid "I see what you're doing here."
msgstr ""

#: ironaldini_iron/Friend7a/0/g-3/8/s/0
msgctxt "Choix"
msgid "I know. I'm so subtle. And creative. And awesome."
msgstr ""

#: ironaldini_iron/Friend7a/0/g-3/9/s/0
msgctxt "Choix"
msgid "This might be your greatest reveal yet!"
msgstr ""

#: ironaldini_iron/Friend7a/0/g-4/0
msgctxt "I, Ronaldini"
msgid "<i>sob</i> DON'T YOU SEE!? 'I' AM MY GREATEST ILLUSION! I'm not great and terrible! I'm not even okay and slightly unnerving."
msgstr ""

#: ironaldini_iron/Friend7a/0/g-4/8
msgctxt "I, Ronaldini"
msgid "I, Ronaldini am nothing!"
msgstr ""

#: ironaldini_iron/Friend7a/0/g-4/16
msgctxt "I, Ronaldini"
msgid "I'm just Ron! Ron from Lloydminster!!! <i>sob</i>"
msgstr ""

#: ironaldini_iron/Friend7a/0/g-4/24/s/0
msgctxt "Choix"
msgid "Well, I'm pleased to meet you, Ron."
msgstr ""

#: ironaldini_iron/Friend7a/0/g-4/25/s/0
msgctxt "Choix"
msgid "Ron's not nothing. In fact, I think he's probably pretty cool."
msgstr ""

#: ironaldini_iron/Friend7a/0/g-5/0
msgctxt "I, Ronaldini"
msgid "Liar! You couldn't possibly be truthful right now! I'm boring! Every breath I draw is false!"
msgstr ""

#: ironaldini_iron/Friend7a/0/g-5/11/s/0
msgctxt "Choix"
msgid "Oh? You haven't performed in all those interesting places?"
msgstr ""

#: ironaldini_iron/Friend7a/0/g-5/12/s/0
msgctxt "Choix"
msgid "Ha. So you haven't taught yourself all those cool illusions, then."
msgstr ""

#: ironaldini_iron/Friend7a/0/g-6/0
msgctxt "I, Ronaldini"
msgid "Of course I have! But it was never ME! It was this costume. This affectation!"
msgstr ""

#: ironaldini_iron/Friend7a/0/g-6/8/s/0
msgctxt "Choix"
msgid "You created the whole affectation though, right? That's amazing!"
msgstr ""

#: ironaldini_iron/Friend7a/0/g-6/9/s/0
msgctxt "Choix"
msgid "But we can agree you are a super talented magician. That's not nothing!"
msgstr ""

#: ironaldini_iron/Friend7a/0/g-7/0
msgctxt "I, Ronaldini"
msgid "I, Ronaldini am the amazing magician. I, Ron, am nothing."
msgstr ""

#: ironaldini_iron/Friend7a/0/g-7/8
msgctxt "I, Ronaldini"
msgid "And yet that, Ron, though I deny it everyday, is the self I most cleave to. I miss that board!"
msgstr ""

#: ironaldini_iron/Friend7a/0/g-7/19/s/0
msgctxt "Choix"
msgid "Wait. You'd rather be Ron than the Great and Terrible?"
msgstr ""

#: ironaldini_iron/Friend7a/0/g-7/20/s/0
msgctxt "Choix"
msgid "I really think you can be both."
msgstr ""

#: ironaldini_iron/Friend7a/0/g-7/c-17/7
msgctxt "I, Ronaldini"
msgid "Oh I don't know. Great this, terrible that."
msgstr ""

#: ironaldini_iron/Friend7a/0/g-8/0
msgctxt "I, Ronaldini"
msgid "I may be Great and Terrible, but most of the time I just feel terrible."
msgstr ""

#: ironaldini_iron/Friend7a/0/g-8/8/s/0
msgctxt "Choix"
msgid "STOP BEING A BABY. Your life is SOOOOOO bleak!"
msgstr ""

#: ironaldini_iron/Friend7a/0/g-8/9/s/0
msgctxt "Choix"
msgid "I think you just miss home."
msgstr ""

#: ironaldini_iron/Friend7a/0/g-8/c-19/7
msgctxt "I, Ronaldini"
msgid "...I do long for the simplicity of the tundra. To tread not the lush ironing board nylon to which my silken feet have grown accustomed, but the endless permafrost of my native land."
msgstr ""

#: ironaldini_iron/Friend7a/0/g-8/c-19/15/0/s/0
msgctxt "Choix"
msgid "Then return there!"
msgstr ""

#: ironaldini_iron/Friend7a/0/g-8/c-19/15/1/s/0
msgctxt "Choix"
msgid "Dude? I'll buy you a ticket right now."
msgstr ""

#: ironaldini_iron/Friend7a/0/g-8/c-19/15/g-0/0
msgctxt "I, Ronaldini"
msgid "I do long for that! But what would I do? There is no call for my brand of seductive rakery there."
msgstr ""

#: ironaldini_iron/Friend8choice/0/0
msgctxt "I, Ronaldini"
msgid "What?"
msgstr ""

#: ironaldini_iron/Friend8choice/0/8/s/0
msgctxt "Choix"
msgid "You could... perform at Birthday parties?"
msgstr ""

#: ironaldini_iron/Friend8choice/0/9/s/0
msgctxt "Choix"
msgid "You could... tour Saskatchewan?"
msgstr ""

#: ironaldini_iron/Friend8choice/0/10/s/0
msgctxt "Choix"
msgid "You could... write a book?"
msgstr ""

#: ironaldini_iron/Friend8choice/0/11/s/0
msgctxt "Choix"
msgid "You could... stop it?"
msgstr ""

#: ironaldini_iron/Friend8choice/0/c-1/7 ironaldini_iron/Friend8choice/0/c-2/7 ironaldini_iron/Friend8choice/0/c-3/7
msgctxt "I, Ronaldini"
msgid "Oh?"
msgstr ""

#: ironaldini_iron/Friend8choice/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "Perform in the grand old theaters of the prairies and introduce the mystery that life there so sorely lacks!"
msgstr ""

#: ironaldini_iron/Friend8choice/0/c-2/15/0/s/0
msgctxt "Choix"
msgid "A tell-all autobiography! The true story! You could call it..."
msgstr ""

#: ironaldini_iron/Friend8choice/0/c-2/15/c-0/7
msgctxt "I, Ronaldini"
msgid "I, Ronaldini!"
msgstr ""

#: ironaldini_iron/Friend8choice/0/c-2/15/c-0/18/0/s/0
msgctxt "Choix"
msgid "Exactly!"
msgstr ""

#: ironaldini_iron/Friend8choice/0/c-3/15/0/s/0
msgctxt "Choix"
msgid "Your illusionist career. Become a professional ironing board. Sounds... doable."
msgstr ""

#: ironaldini_iron/Hate7/0/3
msgctxt "I, Ronaldini"
msgid "It is such a flat place no man can jump to his death, though many wish they could."
msgstr ""

#: ironaldini_iron/Hate7/0/14/s/0
msgctxt "Choix"
msgid "I kinda wish YOU could."
msgstr ""

#: ironaldini_iron/Hate7/0/15/s/0
msgctxt "Choix"
msgid "Ok. Here's my take on the situation."
msgstr ""

#: ironaldini_iron/Hate7/0/c-1/7
msgctxt "I, Ronaldini"
msgid "Go on."
msgstr ""

#: ironaldini_iron/Hate7/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "You clearly miss your home. But you hate your home."
msgstr ""

#: ironaldini_iron/Hate7/0/c-1/15/c-0/7
msgctxt "I, Ronaldini"
msgid "That... that is so."
msgstr ""

#: ironaldini_iron/Hate7/0/c-1/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "You're wildly sucessful as a performer."
msgstr ""

#: ironaldini_iron/Hate7/0/c-1/15/c-0/15/c-0/7
msgctxt "I, Ronaldini"
msgid "Wildly, yes."
msgstr ""

#: ironaldini_iron/Hate7/0/c-1/15/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "Go home. Look around. Remember that you hate it. Write down how much you hate it. Get it engraved on your handle for god's sake."
msgstr ""

#: ironaldini_iron/Hate7/0/c-1/15/c-0/15/c-0/15/c-0/7
msgctxt "I, Ronaldini"
msgid "But why, Ronaldini?"
msgstr ""

#: ironaldini_iron/Hate7/0/c-1/15/c-0/15/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "Then, whenever you're doing this self-pitying whiny deal you'll be reminded that it sucks and you'll not miss it."
msgstr ""

#: ironaldini_iron/Hate7/0/c-1/15/c-0/15/c-0/15/c-0/15/c-0/7
msgctxt "I, Ronaldini"
msgid "So, suppress my inner voice?"
msgstr ""

#: ironaldini_iron/Hate7/0/c-1/15/c-0/15/c-0/15/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "You bet. Tadaaaa!"
msgstr ""

#: ironaldini_iron/Hate7/0/c-1/15/c-0/15/c-0/15/c-0/15/c-0/15/1/s/0
msgctxt "Choix"
msgid "Just the whiny one."
msgstr ""

#: ironaldini_iron/Hate7/0/c-1/15/c-0/15/c-0/15/c-0/15/c-0/15/2/s/0
msgctxt "Choix"
msgid "If you could keep that inner voice inner we wouldn't be having this conversation."
msgstr ""

#: ironaldini_iron/Hate7a/0/0
msgctxt "I, Ronaldini"
msgid "That... doesn't seem... healthy?"
msgstr ""

#: ironaldini_iron/Hate7a/0/8/s/0
msgctxt "Choix"
msgid "Neither is lying around all day feeling sorry for yourself."
msgstr ""

#: ironaldini_iron/Hate7a/0/9/s/0
msgctxt "Choix"
msgid "Health? When did we start talking about health??"
msgstr ""

#: ironaldini_iron/Hate7a/0/g-0/0
msgctxt "I, Ronaldini"
msgid "I... I suppose that's one option..."
msgstr ""

#: ironaldini_iron/Hate7a/0/g-0/8/s/0
msgctxt "Choix"
msgid "Way I see it, that's the ONLY option."
msgstr ""

#: ironaldini_iron/Hate7a/0/g-0/9/s/0
msgctxt "Choix"
msgid "Other option would be beet farming."
msgstr ""

#: ironaldini_iron/Hate7a/0/g-0/c-3/7
msgctxt "I, Ronaldini"
msgid "Ah, no. I've never had much skill with... dirt."
msgstr ""

#: ironaldini_iron/Hate7a/0/g-1/0
msgctxt "I, Ronaldini"
msgid "Okay. I'll do as you say. Thank you. I suppose."
msgstr ""

#: ironaldini_iron/Hate7a/0/g-1/8/s/0
msgctxt "Choix"
msgid "Now show me a card trick or something."
msgstr ""

#: ironaldini_iron/Hate7a/0/g-1/9/s/0
msgctxt "Choix"
msgid "Want to go on a date?"
msgstr ""

#: ironaldini_iron/Hate7a/0/g-2/0
msgctxt "I, Ronaldini"
msgid "I don't really feel... up to it just now. Perhaps give me some time to digest what you've suggested."
msgstr ""

#: ironaldini_iron/Hate7a/0/g-2/8/s/0
msgctxt "Choix"
msgid "Cool man. I'll catch you on the flip side!"
msgstr ""

#: ironaldini_iron/Hate7a/0/g-2/9/s/0
msgctxt "Choix"
msgid "Uh oh. Did I mess this up..."
msgstr ""

#: ironaldini_iron/ironaldini_hate_joiner/31
msgctxt "Reggie"
msgid "Now for my next trick..."
msgstr ""

#: ironaldini_iron/Friend8winA/0/6 ironaldini_iron/magic_tour_begin/0/g-8/c-18/40/c-1/7
msgctxt "I, Ronaldini"
msgid "Of course!"
msgstr ""

#: ironaldini_iron/Friend8winA/0/17/s/0
msgctxt "Choix"
msgid "It's the only way to bring together your two selves!"
msgstr ""

#: ironaldini_iron/Friend8winA/0/18/s/0
msgctxt "Choix"
msgid "Sequins in Saskatchewan. I like it."
msgstr ""

#: ironaldini_iron/Friend8winA/0/c-1/7
msgctxt "I, Ronaldini"
msgid "We can workshop the title later."
msgstr ""

#: ironaldini_iron/Friend8winA/0/g-0/0
msgctxt "I, Ronaldini"
msgid "I will! I will do this very thing! A new tour! A homecoming!"
msgstr ""

#: ironaldini_iron/Friend8winA/0/g-0/8
msgctxt "I, Ronaldini"
msgid "I can see it now! I can see the shining marquee through the blowing snow!"
msgstr ""

#: ironaldini_iron/Friend8winA/0/g-0/16
msgctxt "I, Ronaldini"
msgid "Ron the Iron!"
msgstr ""

#: ironaldini_iron/Friend8winA/0/g-0/24
msgctxt "I, Ronaldini"
msgid "Is!!"
msgstr ""

#: ironaldini_iron/Friend8winA/0/g-0/32
msgctxt "I, Ronaldini"
msgid "I, Ronaldini!!!"
msgstr ""

#: ironaldini_iron/Friend8winA/0/g-0/40/s/0
msgctxt "Choix"
msgid "Hoooorayyyyy! You'll be able to... have your cape and eat it too."
msgstr ""

#: ironaldini_iron/Friend8winA/0/g-0/41/s/0
msgctxt "Choix"
msgid "Look at you. Your greatest illusion becomes your greatest reveal!"
msgstr ""

#: ironaldini_iron/Friend8winA/0/g-0/c-2/11 ironaldini_iron/Friend8winB/0/g-0/8/g-0/24/g-0/8/c-1/7/b/1 ironaldini_iron/Friend8winB/0/g-0/8/g-0/24/g-0/8/c-1/8/b/1
msgctxt "I, Ronaldini"
msgid "Ha-Haaaaa! That didn't make sense and yet I laughed!"
msgstr ""

#: ironaldini_iron/Friend8winA/0/g-0/c-3/7
msgctxt "I, Ronaldini"
msgid "Oh. Oh that was very good. You're witty, aren't you?"
msgstr ""

#: ironaldini_iron/Friend8winA/0/g-1/0/s/0
msgctxt "Choix"
msgid "Magical, huh?"
msgstr ""

#: ironaldini_iron/Friend8winA/0/g-1/1/s/0
msgctxt "Choix"
msgid "I am pretty amazing, let's be honest."
msgstr ""

#: ironaldini_iron/Friend8winA/0/g-2/0
msgctxt "I, Ronaldini"
msgid "Indeed! I thank you dear, sweet thing! I will forever be in your debt! Should you ever find yourself traversing the northern reaches of this self-same continent, do let me know!"
msgstr ""

#: ironaldini_iron/Friend8winA/0/g-2/8/s/0
msgctxt "Choix"
msgid "You'll see my shining face smack dab in the front row."
msgstr ""

#: ironaldini_iron/Friend8winA/0/g-2/9/s/0
msgctxt "Choix"
msgid "I might be busy with other folks... you know how many people I know in Canada, after all."
msgstr ""

#: ironaldini_iron/Friend8winA/0/g-2/c-7/7
msgctxt "I, Ronaldini"
msgid "Ha. Oh you are TOO droll."
msgstr ""

#: ironaldini_iron/Friend8winA/0/g-3/0
msgctxt "I, Ronaldini"
msgid "I must away! So much to plan! So much to prepare! Do you have a good sized box to ship me in?"
msgstr ""

#: ironaldini_iron/Friend8winB/0/6
msgctxt "I, Ronaldini"
msgid "Of course! Why had this not occurred to me before!?"
msgstr ""

#: ironaldini_iron/Friend8winB/0/14/s/0
msgctxt "Choix"
msgid "All that matters is that it's occurred to you now."
msgstr ""

#: ironaldini_iron/Friend8winB/0/15/s/0
msgctxt "Choix"
msgid "Um, obviously because I wasn't here. Duh."
msgstr ""

#: ironaldini_iron/Friend8winB/0/g-0/0
msgctxt "I, Ronaldini"
msgid "By revealing my inner truth I'll no longer be living this tortuous lie!"
msgstr ""

#: ironaldini_iron/Friend8winB/0/g-0/8/0/s/0
msgctxt "Choix"
msgid "Down with inner conflict, I say!"
msgstr ""

#: ironaldini_iron/Friend8winB/0/g-0/8/1/s/0
msgctxt "Choix"
msgid "Truth, always better. Harder, but better."
msgstr ""

#: ironaldini_iron/Friend8winB/0/g-0/8/g-0/0
msgctxt "I, Ronaldini"
msgid "Truth! Honesty!"
msgstr ""

#: ironaldini_iron/Friend8winB/0/g-0/8/g-0/8
msgctxt "I, Ronaldini"
msgid "A life lived in harmony with oneself! A dream I never dared dream! Something if I'm being honest I'm not quite sure I ever really cared about because who would until it starts to rankle at those dark inner reaches?"
msgstr ""

#: ironaldini_iron/Friend8winB/0/g-0/8/g-0/16
msgctxt "I, Ronaldini"
msgid "Thank you dear, sweet thing! I will forever be in your debt! But may I ask you one last favor? Though I feel deliciously greedy for daring to do so?"
msgstr ""

#: ironaldini_iron/Friend8winB/0/g-0/8/g-0/24/0/s/0
msgctxt "Choix"
msgid "Ask away!"
msgstr ""

#: ironaldini_iron/Friend8winB/0/g-0/8/g-0/24/1/s/0
msgctxt "Choix"
msgid "Wow, this favor better taste good after that."
msgstr ""

#: ironaldini_iron/Friend8winB/0/g-0/8/g-0/24/g-0/0
msgctxt "I, Ronaldini"
msgid "Will you write my foreword?"
msgstr ""

#: ironaldini_iron/Friend8winB/0/g-0/8/g-0/24/g-0/8/0/s/0
msgctxt "Choix"
msgid "I... don't know if I'm the write person for that."
msgstr ""

#: ironaldini_iron/Friend8winB/0/g-0/8/g-0/24/g-0/8/1/s/0
msgctxt "Choix"
msgid "Heck, I'll write fivewords."
msgstr ""

#: ironaldini_iron/Friend8winB/0/g-0/8/g-0/24/g-0/8/c-0/7
msgctxt "I, Ronaldini"
msgid "Oh. OH dear me, you ARE droll, aren't you."
msgstr ""

#: ironaldini_iron/Friend8winB/0/g-0/8/g-0/24/g-0/8/c-0/15
msgctxt "I, Ronaldini"
msgid "Enough! It will be done."
msgstr ""

#: ironaldini_iron/Friend8winB/0/g-0/8/g-0/24/g-0/8/c-0/23
msgctxt "I, Ronaldini"
msgid "Away!"
msgstr ""

#: ironaldini_iron/Friend8winB/0/g-0/8/g-0/24/g-0/8/c-1/11/0/s/0
msgctxt "Choix"
msgid "Maybe I should have a show, too."
msgstr ""

#: ironaldini_iron/Friend8winB/0/g-0/8/g-0/24/g-0/8/c-1/11/1/s/0
msgctxt "Choix"
msgid "You'd better go get ready!"
msgstr ""

#: ironaldini_iron/Friend8winB/0/g-0/8/g-0/24/g-0/8/c-1/11/g-0/0
msgctxt "I, Ronaldini"
msgid "Indeed! Now I must away! Preparations! Research! Typewriter ribbons!"
msgstr ""

#: ironaldini_iron/Friend8failA/0/0
msgctxt "I, Ronaldini"
msgid "BIRTHDAY PARTIES!? How dare you!"
msgstr ""

#: ironaldini_iron/Friend8failA/0/14/s/0
msgctxt "Choix"
msgid "But-"
msgstr ""

#: ironaldini_iron/Friend8failA/0/c-0/7
msgctxt "I, Ronaldini"
msgid "After all we've discussed you think children's birthday parties a proper venue for one so magnificent as I!?"
msgstr ""

#: ironaldini_iron/Friend8failA/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "Uh, well, I don't really know where else magicians perform."
msgstr ""

#: ironaldini_iron/Friend8failA/0/c-0/15/1/s/0 ironaldini_iron/Friend8failB/0/15/s/0 ironaldini_iron/Friend8failC/0/c-0/18/0/s/0 ironaldini_iron/Friend8failD/0/c-0/15/2/s/0
msgctxt "Choix"
msgid "No! I was making a joke! Ha. Haha. Heh. What I MEANT to suggest was:"
msgstr ""

#: ironaldini_iron/Friend8failA/0/c-0/15/2/s/0 ironaldini_iron/Friend8failB/0/16/s/0 ironaldini_iron/Friend8failC/0/c-0/18/1/s/0 ironaldini_iron/Friend8failD/0/c-0/15/3/s/0
msgctxt "Choix"
msgid "No! I was making a joke! Ha. Haha. Heh."
msgstr ""

#: ironaldini_iron/Friend8failA/0/c-0/15/c-2/7 ironaldini_iron/Friend8failB/0/c-2/7 ironaldini_iron/Friend8failC/0/c-0/18/c-1/7 ironaldini_iron/Friend8failD/0/c-0/15/c-3/7
msgctxt "I, Ronaldini"
msgid "Is joking in the face of my despair your only contribution?"
msgstr ""

#: ironaldini_iron/Friend8failB/0/0
msgctxt "I, Ronaldini"
msgid "FARMING!? You honestly believe that these painstakingly perfected palms should be wasted on tilling soil!? For god's sake my steam setting would wilt even the hardiest crop!"
msgstr ""

#: ironaldini_iron/Friend8failB/0/14/s/0
msgctxt "Choix"
msgid "I mean, the magic thing doesn't seem to be working out."
msgstr ""

#: ironaldini_iron/Friend8failC/0/0
msgctxt "I, Ronaldini"
msgid "The factory dog? The dog who attempted to run away!? Who abandoned me the way I abandoned my home!?"
msgstr ""

#: ironaldini_iron/Friend8failC/0/14/s/0
msgctxt "Choix"
msgid "Yeah, that one."
msgstr ""

#: ironaldini_iron/Friend8failC/0/c-0/7
msgctxt "I, Ronaldini"
msgid "He died about twenty years ago. And now on top of my crushing existential crisis I miss that dog! Poor Kazaam!"
msgstr ""

#: ironaldini_iron/Friend8failC/0/c-0/18/2/s/0 ironaldini_iron/Friend8failD/0/c-0/15/4/s/0
msgctxt "Choix"
msgid "I was just brainstorming!"
msgstr ""

#: ironaldini_iron/Friend8failD/0/0
msgctxt "I, Ronaldini"
msgid "Perhaps you're right."
msgstr ""

#: ironaldini_iron/Friend8failD/0/8/s/0
msgctxt "Choix"
msgid "I mean, you are kind of set up for that."
msgstr ""

#: ironaldini_iron/Friend8failD/0/c-0/7 ironaldini_iron/Friend8failD/0/c-0/15/c-1/25 ironaldini_iron/Friend8failD/0/c-0/15/c-4/33/c-0/7
msgctxt "I, Ronaldini"
msgid "Then... then I shall. I shall perform my final vanishing act. You will never see me again. At least not in a cape."
msgstr ""

#: ironaldini_iron/Friend8failD/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "K, byeeeeee!"
msgstr ""

#: ironaldini_iron/Friend8failD/0/c-0/15/1/s/0
msgctxt "Choix"
msgid "No! Don't! Ironing is for losers!"
msgstr ""

#: ironaldini_iron/Friend8failD/0/c-0/15/c-1/7
msgctxt "I, Ronaldini"
msgid "This is no joke! I am no marionette to be toyed with! You would suggest I end my career?!"
msgstr ""

#: ironaldini_iron/Friend8failD/0/c-0/15/c-3/22 ironaldini_iron/Friend8failD/0/c-0/15/c-4/33/c-1/10
msgctxt "I, Ronaldini"
msgid "I shall perform my final vanishing act. You will never see me again. At least not in a cape."
msgstr ""

#: ironaldini_iron/Friend8failD/0/c-0/15/c-4/7
msgctxt "I, Ronaldini"
msgid "And THAT is the best thunderclap that occurred during your \"brain storm\"?"
msgstr ""

#: ironaldini_iron/Friend8failD/0/c-0/15/c-4/15
msgctxt "I, Ronaldini"
msgid "More like an upwardly mobile bout of brain diarrhea, wouldn't you say?"
msgstr ""

#: ironaldini_iron/Friend8failD/0/c-0/15/c-4/33/0/s/0
msgctxt "Choix"
msgid "That's so harsh! I wish you would just disappear."
msgstr ""

#: ironaldini_iron/Friend8failD/0/c-0/15/c-4/33/1/s/0
msgctxt "Choix"
msgid "I'm pickin' options that look good to me bud."
msgstr ""

#: ironaldini_iron/iron_book_begin/0/9
msgctxt "I, Ronaldini"
msgid "Book!"
msgstr ""

#: ironaldini_iron/iron_book_begin/0/17
msgctxt "I, Ronaldini"
msgid "Oh at long last to be doing something useful and productive with this up-till-now stagnant pool of my memory!"
msgstr ""

#: ironaldini_iron/iron_book_begin/0/25
msgctxt "I, Ronaldini"
msgid "Where shall I begin? Hm, yes, let's see..."
msgstr ""

#: ironaldini_iron/iron_book_begin/0/33/s/0
msgctxt "Choix"
msgid "I'd start at the beginning, maybe?"
msgstr ""

#: ironaldini_iron/iron_book_begin/0/34/s/0
msgctxt "Choix"
msgid "Start in Canada, Ron. Plenty of good stories begin in Canada."
msgstr ""

#: ironaldini_iron/iron_book_begin/0/g-0/0
msgctxt "I, Ronaldini"
msgid "Yes, brilliant!"
msgstr ""

#: ironaldini_iron/iron_book_begin/0/g-0/8
msgctxt "I, Ronaldini"
msgid "First line..."
msgstr ""

#: ironaldini_iron/iron_book_begin/0/g-0/16
msgctxt "I, Ronaldini"
msgid "...are you listening?"
msgstr ""

#: ironaldini_iron/iron_book_begin/0/g-0/24/s/0
msgctxt "Choix"
msgid "YOU are writing this book. I am not. I'm encouraging you. That's it."
msgstr ""

#: ironaldini_iron/iron_book_begin/0/g-0/25/s/0
msgctxt "Choix"
msgid "You can do this. You don't need my approval. YOU'VE GOT THIS."
msgstr ""

#: ironaldini_iron/iron_book_begin/0/g-1/0
msgctxt "I, Ronaldini"
msgid "Yes. Yes, I know that. Of course."
msgstr ""

#: ironaldini_iron/iron_book_begin/0/g-1/8
msgctxt "I, Ronaldini"
msgid "But I'm sure you can understand how nervous I am. All my other creative endeavors have been lies!"
msgstr ""

#: ironaldini_iron/iron_book_begin/0/g-1/16
msgctxt "I, Ronaldini"
msgid "Ok, well not lies, maybe, we've worked on that. But they've all been a deliberate obfuscation of the truth. I'm not an iron, I'm an illusionist and so forth."
msgstr ""

#: ironaldini_iron/iron_book_begin/0/g-1/24
msgctxt "I, Ronaldini"
msgid "This is the first thing I've ever done where the goal was to <i>reveal</i> rather than obscure... me."
msgstr ""

#: ironaldini_iron/iron_book_begin/0/g-1/32/s/0
msgctxt "Choix"
msgid "I get that. I'm here for you."
msgstr ""

#: ironaldini_iron/iron_book_begin/0/g-1/33/s/0
msgctxt "Choix"
msgid "Yeah... it's gonna be a change of pace, for sure."
msgstr ""

#: ironaldini_iron/iron_book_begin/0/g-1/34/s/0
msgctxt "Choix"
msgid "Just remember some things are only for you and me, my darling..."
msgstr ""

#: ironaldini_iron/iron_book_begin/0/g-1/c-4/7
msgctxt "I, Ronaldini"
msgid "Well then. Onward we go! Now where was I..."
msgstr ""

#: ironaldini_iron/iron_book_begin/0/g-1/c-5/7
msgctxt "I, Ronaldini"
msgid "Change of costume, more like! I'm still going at the speed of good legerdemain!"
msgstr ""

#: ironaldini_iron/iron_book_begin/0/g-1/c-5/15
msgctxt "I, Ronaldini"
msgid "Now. Where did I leave off..."
msgstr ""

#: ironaldini_iron/iron_book_begin/0/g-1/c-6/7
msgctxt "I, Ronaldini"
msgid "Oh of course. The things we shared, and sawed, in the closet are absolutely privileged!"
msgstr ""

#: ironaldini_iron/iron_book_begin/0/g-1/c-6/18
msgctxt "I, Ronaldini"
msgid "Now where were we..."
msgstr ""

#: ironaldini_iron/iron_book_begin/0/g-2/0
msgctxt "I, Ronaldini"
msgid "Ah, yes! Saskatchewan."
msgstr ""

#: ironaldini_iron/iron_book_begin/0/g-2/8
msgctxt "I, Ronaldini"
msgid "\"I was forged in the bitter and unforgiving tundral wastelands of Northern Canada...\""
msgstr ""

#: ironaldini_iron/iron_book_begin/0/g-2/16/s/0
msgctxt "Choix"
msgid "Okay prairie boy... what are you, Gravy Crockett??"
msgstr ""

#: ironaldini_iron/iron_book_begin/0/g-2/17/s/0
msgctxt "Choix"
msgid "Oof. Maybe a little more... relatable?"
msgstr ""

#: ironaldini_iron/iron_book_begin/0/g-2/c-7/7
msgctxt "I, Ronaldini"
msgid "No, I'm..."
msgstr ""

#: ironaldini_iron/iron_book_begin/0/g-2/c-7/15
msgctxt "I, Ronaldini"
msgid "aaahhhh, I see your point! How's this?"
msgstr ""

#: ironaldini_iron/iron_book_begin/0/g-2/c-8/7
msgctxt "I, Ronaldini"
msgid "...relatable. Hm. Yes. Ok..."
msgstr ""

#: ironaldini_iron/iron_book_begin/0/g-3/0
msgctxt "I, Ronaldini"
msgid "\"I was manufactured in a humble factory just outside of Lloydminster, Saskatchewan. It wasn't much, but it played a vital role in making me who I ultimately became.\""
msgstr ""

#: ironaldini_iron/iron_book_begin/0/g-3/8
msgctxt "I, Ronaldini"
msgid "Better?"
msgstr ""

#: ironaldini_iron/iron_book_begin/0/g-3/16/s/0
msgctxt "Choix"
msgid "Oh yeah. Very much more Real."
msgstr ""

#: ironaldini_iron/iron_book_begin/0/g-3/17/s/0
msgctxt "Choix"
msgid "Totally! Now I feel like we're talking about You."
msgstr ""

#: ironaldini_iron/iron_book_begin/0/g-3/18/s/0
msgctxt "Choix"
msgid "You're on the right track, I think."
msgstr ""

#: ironaldini_iron/iron_book_begin/0/g-4/0
msgctxt "I, Ronaldini"
msgid "Excellent! Leave me to write for a bit... I feel those creative seams beginning to tighten!"
msgstr ""

#: ironaldini_iron/iron_book_2/0/0
msgctxt "I, Ronaldini"
msgid "I am glad you're back, I've gotten through a couple of chapters but I have become stuck on this one..."
msgstr ""

#: ironaldini_iron/iron_book_2/0/8
msgctxt "I, Ronaldini"
msgid "Could I read you a short bit and you could maybe help push me through to the other side of this writer's blockage?"
msgstr ""

#: ironaldini_iron/iron_book_2/0/16
msgctxt "I, Ronaldini"
msgid "How fun! I'm now a writer with a blockage!"
msgstr ""

#: ironaldini_iron/iron_book_2/0/24/s/0
msgctxt "Choix"
msgid "Yeah, let's hear it!"
msgstr ""

#: ironaldini_iron/iron_book_2/0/25/s/0
msgctxt "Choix"
msgid "Oh boy. Do I need a drink for this?"
msgstr ""

#: ironaldini_iron/iron_book_2/0/26/s/0
msgctxt "Choix"
msgid "You know... I don't think I have the energy. I'll come back... later."
msgstr ""

#: ironaldini_iron/iron_book_2/0/c-1/7
msgctxt "I, Ronaldini"
msgid "I personally go for a nice Spicy Iron! Steaming hot water, that stain-removing spray, the green bottle is best, and just the tiniest bit of rust."
msgstr ""

#: ironaldini_iron/iron_book_2/0/c-1/15
msgctxt "I, Ronaldini"
msgid "Really, really very tasty."
msgstr ""

#: ironaldini_iron/iron_book_2/0/c-1/23/0/s/0
msgctxt "Choix"
msgid "Uh... I'm good. Let's get on with it!"
msgstr ""

#: ironaldini_iron/iron_book_2/0/c-1/23/1/s/0
msgctxt "Choix"
msgid "Oh, cool! Sounds toxic as hell. Moving on!"
msgstr ""

#: ironaldini_iron/iron_book_2/0/c-2/7
msgctxt "I, Ronaldini"
msgid "Ah! Yes. Well. That's fine, I guess."
msgstr ""

#: ironaldini_iron/iron_book_2/0/c-2/15
msgctxt "I, Ronaldini"
msgid "I am Canadian, after all!"
msgstr ""

#: ironaldini_iron/iron_book_2/0/c-2/23/0/s/0
msgctxt "Choix"
msgid "What the hell does that mean?"
msgstr ""

#: ironaldini_iron/iron_book_2/0/c-2/23/1/s/0
msgctxt "Choix"
msgid "Sure."
msgstr ""

#: ironaldini_iron/iron_book_2/0/c-2/23/c-0/7
msgctxt "I, Ronaldini"
msgid "Oh, I haven't the faintest. Go on, then! Back to the drawing board for me!"
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-0/4/6
msgctxt "I, Ronaldini"
msgid "\"The crowd panted and craned their necks towards the stage... I could almost smell their anticipation, so thick was it in the air..."
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-0/4/14
msgctxt "I, Ronaldini"
msgid "What will he pull from beneath his cape, they wondered?\""
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-0/4/22
msgctxt "I, Ronaldini"
msgid "\"A live parrot? Overflowing handfuls of gems and gold? A lit fire and a whistling tea kettle named Armand??\""
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-0/4/30
msgctxt "I, Ronaldini"
msgid "\"The gangster's goons waited impatiently in the wings for the curtain to come down. They knew as soon as it did, I would have no choice but to go with them and pay them every dime...\""
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-0/4/38
msgctxt "I, Ronaldini"
msgid "\"...but for those moments, with the stage lights burning like the sun of pure love in my eyes, I was invincible!\""
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-0/4/46/s/0
msgctxt "Choix"
msgid "Whoa."
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-0/4/47/s/0
msgctxt "Choix"
msgid "Um... did that really happen?"
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-1/0
msgctxt "I, Ronaldini"
msgid "Oh, yes! And exactly as I've just said, too!"
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-1/8/s/0
msgctxt "Choix"
msgid "...reeeeallly?"
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-1/9/s/0
msgctxt "Choix"
msgid "Oh dear, Ron."
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-2/0
msgctxt "I, Ronaldini"
msgid "Well. Perhaps not completely as written. Though practically... Yes."
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-2/8
msgctxt "I, Ronaldini"
msgid "I'd say the basic premise is accurate."
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-2/16
msgctxt "I, Ronaldini"
msgid "In theory."
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-2/24
msgctxt "I, Ronaldini"
msgid "Mostly."
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-2/32/s/0
msgctxt "Choix"
msgid "Ok. As an experiment, tell me EXACTLY what really happened that night."
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-2/33/s/0
msgctxt "Choix"
msgid "It's cool that you are so creative. But you're also so interesting just as you are."
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-2/c-8/7
msgctxt "I, Ronaldini"
msgid "Hmph. A Canadian ironing board with a talent for up close magic and a riveting stage presence?"
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-2/c-8/15/0/s/0
msgctxt "Choix"
msgid "YES."
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-2/c-8/15/c-0/7
msgctxt "I, Ronaldini"
msgid "Ok ok fine. I'll start over."
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-3/0
msgctxt "I, Ronaldini"
msgid "\"I was in a homegoods store in Muncie, Indiana. Nice place, very nice appliances. I had a little fling with a fast-talking juicer from aisle 14...\""
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-3/8/s/0
msgctxt "Choix"
msgid "And we're focusing..."
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-3/9/s/0
msgctxt "Choix"
msgid "Yeah, we should have a whole chapter on your romantic conquests, probably."
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-3/c-10/7/b/1
msgctxt "I, Ronaldini"
msgid "You will be front and center in that one, you sauce pot!"
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-4/0
msgctxt "I, Ronaldini"
msgid "It wasn't bright stagelight so much as the lights from the emergency exit signs. But it was red! And that was quite lovely and dramatic."
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-4/8
msgctxt "I, Ronaldini"
msgid "I did have an eager audience, though! It gets quite boring in those shops at night, and I was welcomed entertainment."
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-4/16
msgctxt "I, Ronaldini"
msgid "The only things I had to \"conjure\" from beneath my cape were a single purple lightbulb, a pack of sewing needles and one of those plugs that makes one plug into three plugs."
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-4/24/s/0
msgctxt "Choix"
msgid "And no gangster? No goons?"
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-4/c-11/7
msgctxt "I, Ronaldini"
msgid "No... just the juicer. She thought I'd been flirting with the magnetic screwdriver and they happened to be quite good friends. So she was a little peeved at me."
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-4/c-11/15
msgctxt "I, Ronaldini"
msgid "She SEEMED like a gangster's goon in that light, though!"
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-4/c-11/23/0/s/0
msgctxt "Choix"
msgid "I have to tell you the truth."
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-4/c-11/23/1/s/0
msgctxt "Choix"
msgid "I'm glad you told me all this."
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-4/c-11/23/c-0/7
msgctxt "I, Ronaldini"
msgid "I... am ready."
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-4/c-11/23/c-1/7
msgctxt "I, Ronaldini"
msgid "You... you are?"
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-5/0/s/0
msgctxt "Choix"
msgid "IT'S AWESOME!!"
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-5/1/s/0
msgctxt "Choix"
msgid "Your real story is SO MUCH COOLER than the nonsense, albeit <i>colorful</i>, you made up!"
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-6/0
msgctxt "I, Ronaldini"
msgid "REALLY??"
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-6/11/s/0
msgctxt "Choix"
msgid "Yes! Only tell the truth. You have such a cool truth!!"
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-6/12/s/0
msgctxt "Choix"
msgid "Ron. Just trust me, ok?"
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-7/0
msgctxt "I, Ronaldini"
msgid "I... I am reinvigorated! That's why I've had writer's block, because I'm trying to concoct a story instead of just telling one!"
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-7/8
msgctxt "I, Ronaldini"
msgid "Thank you. Thank you yet again my friend, for inspiring me and assisting me and... listening to me. The real me."
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-7/16
msgctxt "I, Ronaldini"
msgid "I am, deeply and sincerely, touched."
msgstr ""

#: ironaldini_iron/iron_book_2/0/g-7/24
msgctxt "I, Ronaldini"
msgid "Now off with you. Ron the Iron has some more biography to reveal to his potential anxious readers!!"
msgstr ""

#: ironaldini_iron/iron_book_end/0/6
msgctxt "I, Ronaldini"
msgid "Welcome back to the home of I, Ron, who is both Ron and I, Ronaldini, an iron, a magician, and...."
msgstr ""

#: ironaldini_iron/iron_book_end/0/14
msgctxt "I, Ronaldini"
msgid "...a writer! An official WRITER."
msgstr ""

#: ironaldini_iron/iron_book_end/0/25/s/0
msgctxt "Choix"
msgid "No way. Does that mean you finished it???"
msgstr ""

#: ironaldini_iron/iron_book_end/0/26/s/0
msgctxt "Choix"
msgid "An iron of many temperatures, I see!"
msgstr ""

#: ironaldini_iron/iron_book_end/0/c-1/7
msgctxt "I, Ronaldini"
msgid "I'm absolutely BURNING UP these days."
msgstr ""

#: ironaldini_iron/iron_book_end/0/g-0/0
msgctxt "I, Ronaldini"
msgid "I have finished my book. And should it please you, oh editor of mine, I'd like to read you just the last few lines?"
msgstr ""

#: ironaldini_iron/iron_book_end/0/g-0/8/s/0
msgctxt "Choix"
msgid "I'd love it."
msgstr ""

#: ironaldini_iron/iron_book_end/0/g-0/9/s/0
msgctxt "Choix"
msgid "Only if they're... true. Ok?"
msgstr ""

#: ironaldini_iron/iron_book_end/0/g-0/c-3/7
msgctxt "I, Ronaldini"
msgid "Oh, they're true. They may be the most truthful in the whole book."
msgstr ""

#: ironaldini_iron/iron_book_end/0/g-1/0
msgctxt "I, Ronaldini"
msgid "A-Hem. \"As I write this, I am an iron. I live in a quiet house. I have some close acquaintances, some intrigues, some dramas like most others.\""
msgstr ""

#: ironaldini_iron/iron_book_end/0/g-1/8
msgctxt "I, Ronaldini"
msgid "\"I am still a magician, and I am developing a brand new show. It's been too long since I had a new show. I am normal in very many respects, and I am happy to be so.\""
msgstr ""

#: ironaldini_iron/iron_book_end/0/g-1/16
msgctxt "I, Ronaldini"
msgid "\"But in one thing, I am special. In one thing above all, I have achieved magnificence."
msgstr ""

#: ironaldini_iron/iron_book_end/0/g-1/24/b/1
msgctxt "I, Ronaldini"
msgid "\"I, Ron, I, Ronaldini, have a wonderful human. He has helped to write this story, by recognizing long before I did that my story was one worth telling.\""
msgstr ""

#: ironaldini_iron/iron_book_end/0/g-1/25/b/1
msgctxt "I, Ronaldini"
msgid "\"I, Ron, I, Ronaldini, have a wonderful human. She has helped to write this story, by recognizing long before I did that my story was one worth telling.\""
msgstr ""

#: ironaldini_iron/iron_book_end/0/g-1/26/b/1
msgctxt "I, Ronaldini"
msgid "\"I, Ron, I, Ronaldini, have a wonderful human. They have helped to write this story, by recognizing long before I did that my story was one worth telling.\""
msgstr ""

#: ironaldini_iron/iron_book_end/0/g-1/29
msgctxt "I, Ronaldini"
msgid "...so? What, um... what do you think?"
msgstr ""

#: ironaldini_iron/iron_book_end/0/g-1/37/s/0
msgctxt "Choix"
msgid "I love it."
msgstr ""

#: ironaldini_iron/iron_book_end/0/g-1/38/s/0
msgctxt "Choix"
msgid "Thank you."
msgstr ""

#: ironaldini_iron/iron_book_end/0/g-1/39/s/0
msgctxt "Choix"
msgid "I think you're a great big softy, Ronny."
msgstr ""

#: ironaldini_iron/iron_book_end/0/g-2/0
msgctxt "I, Ronaldini"
msgid "Well, then. Yes. Yes, indeed!!"
msgstr ""

#: ironaldini_iron/iron_book_end/0/g-2/11
msgctxt "I, Ronaldini"
msgid "Much to do now, as you can imagine... I can't thank you enough."
msgstr ""

#: ironaldini_iron/iron_book_end/0/g-2/22
msgctxt "I, Ronaldini"
msgid "Here, take it!"
msgstr ""

#: ironaldini_iron/iron_book_end/0/g-2/30/s/0
msgctxt "Choix"
msgid "Is that book... invisible?"
msgstr ""

#: ironaldini_iron/iron_book_end/0/g-2/c-7/7
msgctxt "I, Ronaldini"
msgid "An invisible autobiography! My greatest feat!"
msgstr ""

#: ironaldini_iron/iron_book_end/0/g-2/c-7/18
msgctxt "I, Ronaldini"
msgid "Off I go!"
msgstr ""

#: ironaldini_iron/iron_book_end/0/g-2/c-7/29
msgctxt "I, Ronaldini"
msgid "...friend."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/6
msgctxt "Bobby"
msgid "You're here for the show, yeah?"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/14/s/0
msgctxt "Choix"
msgid "I think so!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/15/s/0
msgctxt "Choix"
msgid "What's up?"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-0/0
msgctxt "Bobby"
msgid "Ho boy. Get ready for some real corny stuff."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-0/8/s/0
msgctxt "Choix"
msgid "Hey if working with I, Ronaldini wasn't really your jam, why are you here?"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-0/9/s/0
msgctxt "Choix"
msgid "Fair point, I guess."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-0/10/s/0
msgctxt "Choix"
msgid "You... you are a character, I'll give you that!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-0/c-2/7
msgctxt "Bobby"
msgid "Well... he's kind of a dinosaur... But he's got his charm."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-0/c-2/15
msgctxt "Bobby"
msgid "And, you gotta promise not to tell him this... but he's got this amazing collection of coins."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-0/c-2/23
msgctxt "Bobby"
msgid "Not like, fancy ones or old ones or whatever. Real coins, just plain old high quality cashola."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-0/c-2/31
msgctxt "Bobby"
msgid "And I may or may not liberate several of them on fairly regular occasions!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-0/c-2/39/0/s/0
msgctxt "Choix"
msgid "Like every time you act as his assistant at a show?"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-0/c-2/39/1/s/0
msgctxt "Choix"
msgid "Bobby. That is called theft. Just FYI."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-0/c-2/39/g-0/0
msgctxt "Bobby"
msgid "Well yeah... I may be mostly retired from scammin' but I ain't dead!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-1/9
msgctxt "I, Ronaldini"
msgid "Ah! Ok, you're here. Good. Ha ha! I must confess to being more than a little nervous!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-1/17
msgctxt "I, Ronaldini"
msgid "As long as it's been since I've put on a show, it's even longer since I've had a rehearsal! And especially a rehearsal in front of a human whose opinion I respect!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-1/25
msgctxt "Bobby"
msgid "Welcome... to the world of magic..."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-1/33
msgctxt "I, Ronaldini"
msgid "Thank you... Bobby."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-1/41
msgctxt "I, Ronaldini"
msgid "Welcome welcome, ladies and gentlespoons, to the long-awaited return show of..."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-1/52
msgctxt "I, Ronaldini"
msgid "I, RONALDINI, THE GREAT AND TREMENDOUS!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-1/63/s/0
msgctxt "Choix"
msgid "Whoa. Not terrible anymore?"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-1/c-5/7
msgctxt "I, Ronaldini"
msgid "No no, I was never terrible, really. It was all a cover."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-1/c-5/15
msgctxt "Bobby"
msgid "Yeah. And a good cover, too! You thought he was garbage, didn't ya?"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-1/c-5/23/0/s/0
msgctxt "Choix"
msgid "Oh, big time. Yep."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-1/c-5/23/1/s/0
msgctxt "Choix"
msgid "I get it now. Please continue."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-2/0
msgctxt "I, Ronaldini"
msgid "As you all know, I am a master of many magical feats, any of which would wow and astound you!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-2/8
msgctxt "I, Ronaldini"
msgid "But for this my return show, I shall focus on one area of my brilliance, a skill that has recently and powerfully affected my own existence..."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-2/16
msgctxt "I, Ronaldini"
msgid "...that of TRANSFIGURATION!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-2/27
msgctxt "Bobby"
msgid "I came up with that word, y'know. He was gonna say \"magical switcheroo\"."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-2/35/s/0
msgctxt "Choix"
msgid "Ouch."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-2/c-6/7
msgctxt "Bobby"
msgid "Yyyyuupp."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-2/c-6/15
msgctxt "I, Ronaldini"
msgid "Shush, Bobby! Now. Prepare... Prepare to be AMAZED!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-2/c-6/23
msgctxt "I, Ronaldini"
msgid "I shall begin, as most performers do, with something seemingly simple."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-2/c-6/31
msgctxt "I, Ronaldini"
msgid "In the blink of an eye, I will transport myself from one side of this room to the other! Bobby, is the switcheroo, um, magical switcheroo magic ready?"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-2/c-6/39
msgctxt "Bobby"
msgid "Yessir, O Grand Magus!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-2/c-6/47/0/s/0
msgctxt "Choix"
msgid "Ha! Nice one."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-2/c-6/47/1/s/0
msgctxt "Choix"
msgid "Now Bobby, he's trying, let's be supportive."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-2/c-6/47/g-0/0
msgctxt "I, Ronaldini"
msgid "Presto, like the crack of a whip, Wham-o, like a flash of lighting, I am here..."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-2/c-6/47/g-0/14
msgctxt "I, Ronaldini"
msgid "...and then I am there!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-2/c-6/47/g-0/31
msgctxt "I, Ronaldini"
msgid "Are you amazed?!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-2/c-6/47/g-0/45/0/s/0
msgctxt "Choix"
msgid "Um... not really?"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-2/c-6/47/g-0/45/1/s/0
msgctxt "Choix"
msgid "Oh hell yes! Wonderful! Excellent!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-2/c-6/47/g-0/45/c-0/7
msgctxt "I, Ronaldini"
msgid "...damnation."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-2/c-6/47/g-0/45/c-0/15
msgctxt "I, Ronaldini"
msgid "I shall have to redouble my efforts!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-2/c-6/47/g-0/45/c-1/7
msgctxt "Bobby"
msgid "Oh, brother."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-2/c-6/47/g-0/45/c-1/15
msgctxt "I, Ronaldini"
msgid "I KNEW you would be! Just wait for what comes next!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-3/0
msgctxt "I, Ronaldini"
msgid "I give you..."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-3/11
msgctxt "I, Ronaldini"
msgid "This form!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-3/22/s/0
msgctxt "Choix"
msgid "Woah!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-3/23/s/0
msgctxt "Choix"
msgid "Hi Harper!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-3/24/s/0
msgctxt "Choix"
msgid "Hot."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-4/0
msgctxt "I, Ronaldini"
msgid "Or perhaps this is not the right face, not for right now. I give you, then..."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-4/11
msgctxt "I, Ronaldini"
msgid "A darling teddy bear, who reads you to sleep and holds your heart in his big, capable paws."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-4/22/s/0
msgctxt "Choix"
msgid "That's pretty cool!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-4/23/s/0
msgctxt "Choix"
msgid "Yawn city."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-4/24/s/0
msgctxt "Choix"
msgid "Teddy, how you been?"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-5/0
msgctxt "I, Ronaldini"
msgid "I can even transform our beloved assistant Bobby through the power of my magic!!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-5/8
msgctxt "Bobby"
msgid "My guy, touch me with your magic or otherwise, and lose your wand forever."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-5/19
msgctxt "I, Ronaldini"
msgid "Well. Ahem. Yes. Nevermind that, then. Magic is vitally about the consent of all parties, you see!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-5/30/0
msgctxt "I, Ronaldini"
msgid "Euuughh... Ahhh!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-5/30/11
msgctxt "I, Ronaldini"
msgid "Now... what if we changed something belonging to yourself?"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-5/30/22/s/0
msgctxt "Choix"
msgid "Like, my clothes?"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-5/30/23/s/0
msgctxt "Choix"
msgid "Don't touch me old man."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-5/30/24/s/0
msgctxt "Choix"
msgid "Yeah! Let's go!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-7/0
msgctxt "I, Ronaldini"
msgid "Your SPECS points, for instance?"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-7/11/s/0
msgctxt "Choix"
msgid "Whoa. Bro. Do NOT mess with my points."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-7/12/s/0
msgctxt "Choix"
msgid "No way! Really? Show me!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-8/20
msgctxt "I, Ronaldini"
msgid "My my, what a handsome array of points you have!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-8/28
msgctxt "I, Ronaldini"
msgid "I don't think you're nearly as smart as you say...!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-8/42
msgctxt "I, Ronaldini"
msgid "Yes, you like that, don't you? I imagine I'm looking fairly charming right now, aren't I? I'll just... take some."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-8/56
msgctxt "I, Ronaldini"
msgid "You are charmed by me! I can see it by the gleam in your eye! But if you continue looking at me in that... unguarded way... you are in danger of becoming dispoised!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-8/70
msgctxt "Bobby"
msgid "Dispoised ain't a word... but do your thing, Ronny."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-8/78
msgctxt "I, Ronaldini"
msgid "Sha-POW, Whoosh, your points are mine!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-8/89/s/0
msgctxt "Choix"
msgid "Ha, yeah, you're amazing <i>PUT EM BACK</i>."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-8/c-18/7
msgctxt "I, Ronaldini"
msgid "Ooh. Do I detect a note of sass? That was a sassy comment! You are not deserving of sass!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-8/c-18/18
msgctxt "I, Ronaldini"
msgid "But not to worry. I am not without empathy."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-8/c-18/32
msgctxt "I, Ronaldini"
msgid "Tell me now... are you amazed?"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-8/c-18/40/0/s/0
msgctxt "Choix"
msgid "Indeed I am! You are one heck of a performer!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-8/c-18/40/1/s/0
msgctxt "Choix"
msgid "Yes. I am. You're great. Ron? Put it all back. Now."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-8/c-18/40/c-0/7
msgctxt "Bobby"
msgid "With one hell of an assistant, huh? Huh?"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-8/c-18/40/c-0/15/0/s/0
msgctxt "Choix"
msgid "Oh, my god, totally. Show would not go on without you!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-8/c-18/40/c-0/15/1/s/0
msgctxt "Choix"
msgid "Hey. You're as good an assistant as I am an audience member, let's put it that way."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-9/15
msgctxt "I, Ronaldini"
msgid "There. Everything as it was before."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-9/26
msgctxt "I, Ronaldini"
msgid "Oh my goodness. What is this? What is this?? Surely this is not an object of mine... it must be... could it be..."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-9/34
msgctxt "I, Ronaldini"
msgid "YES! My powers of transfiguration have enabled me to conjure from the air, to transfigure pure nothingness into a solid object, and not even an object of my own!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-9/42
msgctxt "I, Ronaldini"
msgid "But an object belonging to another being entirely."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-9/50/s/0
msgctxt "Choix"
msgid "Pretty cool!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-9/51/s/0
msgctxt "Choix"
msgid "Hm..."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-9/c-20/10
msgctxt "Bobby"
msgid "Do you know how often he practiced this crap on <i>my</i> stuff? A lot."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-10/0
msgctxt "I, Ronaldini"
msgid "Has any feat before equaled this?"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-10/11
msgctxt "I, Ronaldini"
msgid "Will any feat that comes after rival this?"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-10/28
msgctxt "I, Ronaldini"
msgid "I would say to you NO, none, and not ever!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-10/36/s/0
msgctxt "Choix"
msgid "You're doing great, Maestro."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-10/37/s/0
msgctxt "Choix"
msgid "Objects. Yeah yeah, it's good. Decent. What's next?"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-11/3
msgctxt "I, Ronaldini"
msgid "I have transfigured my position in the world, I have transfigured your treasured points, I have even transfigured the air around us to form solid, undeniable objects!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-11/11
msgctxt "I, Ronaldini"
msgid "But I wonder. Could I, against all natural law, transfigure your very thoughts?"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-11/19
msgctxt "I, Ronaldini"
msgid "Feel my influence... we shall calm it down. We shall calm it down to a single point. Under my gaze, under my magical power, you shall think a single thought."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-11/27
msgctxt "I, Ronaldini"
msgid "A thought that I shall give you! An act of pure mentalism!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-11/35/s/0
msgctxt "Choix"
msgid "Oh I hope it's a nice thought!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-11/36/s/0
msgctxt "Choix"
msgid "Really...? I'm game but... I'm doubtful."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-11/c-23/7
msgctxt "Bobby"
msgid "Keep hopin'."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-12/0
msgctxt "I, Ronaldini"
msgid "I give you the thought..."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-12/8
msgctxt "I, Ronaldini"
msgid "...of pickles."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-12/19/s/0
msgctxt "Choix"
msgid "No..."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-12/20/s/0
msgctxt "Choix"
msgid "You can't make me think of that."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-13/0
msgctxt "I, Ronaldini"
msgid "Yyessss, YYEEESS, pickles! Dill ones, bread and butter ones, long spears, lovely round coins, spicy ones, sweet ones, pickle relish..."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-13/8
msgctxt "I, Ronaldini"
msgid "Your mind is full... of pickles."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-13/16
msgctxt "I, Ronaldini"
msgid "Now, take your mind back. It is yours! You may think whatever you wish, anything at all."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-13/24
msgctxt "I, Ronaldini"
msgid "What, my darling audience, would you like to say to me? What is the foremost thought in your mind, your own mind?"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-13/32/s/0 ironaldini_iron/magic_tour_begin/0/g-13/35/s/0
msgctxt "Choix"
msgid "Pickles."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-13/33/s/0
msgctxt "Choix"
msgid "PICKLES, BABY!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-13/34/s/0
msgctxt "Choix"
msgid "Big spicy pickles."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-14/0
msgctxt "I, Ronaldini"
msgid "...do you see? Do you see my powers now?? Behold, THE MAGIC!!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-14/8/s/0
msgctxt "Choix"
msgid "Holy shit!! How did you... that was amazing!!"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-14/9/s/0
msgctxt "Choix"
msgid "Ok ok, pretty cool. I really... I really want a pickle now, though."
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-14/10/s/0
msgctxt "Choix"
msgid "Can I have my brain back, please?"
msgstr ""

#: ironaldini_iron/magic_tour_begin/0/g-14/c-33/7
msgctxt "I, Ronaldini"
msgid "Ha! Yes, of course. I am a generous prestidigitator!"
msgstr ""

#: ironaldini_iron/magic_tour_end/0/12
msgctxt "I, Ronaldini"
msgid "And there you have it! My show. My first original show in so so very long, and you were here, and we did it!"
msgstr ""

#: ironaldini_iron/magic_tour_end/0/23
msgctxt "Bobby"
msgid "That we did!"
msgstr ""

#: ironaldini_iron/magic_tour_end/0/31/s/0
msgctxt "Choix"
msgid "Bobby, I thought you were great. Reluctant, but funny."
msgstr ""

#: ironaldini_iron/magic_tour_end/0/32/s/0
msgctxt "Choix"
msgid "You were a little snarky there, Bob-O."
msgstr ""

#: ironaldini_iron/magic_tour_end/0/c-0/7
msgctxt "Bobby"
msgid "I was. Am. Generally, both of those things."
msgstr ""

#: ironaldini_iron/magic_tour_end/0/c-1/7
msgctxt "Bobby"
msgid "I mighta gone mostly legit, but I'm still me. That's what we in showbiz call consistent characterization, baby!"
msgstr ""

#: ironaldini_iron/magic_tour_end/0/g-0/0
msgctxt "Bobby"
msgid "Anyway. I gotta jet. Usually assistants would help with clean up and stuff but... that just ain't me!"
msgstr ""

#: ironaldini_iron/magic_tour_end/0/g-0/8
msgctxt "Bobby"
msgid "See ya later, old man!"
msgstr ""

#: ironaldini_iron/magic_tour_end/0/g-0/22
msgctxt "I, Ronaldini"
msgid "Bobby, you were extraordinary! Couldn't have done it without you!"
msgstr ""

#: ironaldini_iron/magic_tour_end/0/g-0/30
msgctxt "I, Ronaldini"
msgid "You know, in the wake of such a fabulously successful show, I just have this wave of confessional generosity sweeping over me."
msgstr ""

#: ironaldini_iron/magic_tour_end/0/g-0/38
msgctxt "I, Ronaldini"
msgid "Might I tell you something? It's not something I'm terribly proud of, but I think it does demonstrate a not-insignificant amount of brilliance on my part."
msgstr ""

#: ironaldini_iron/magic_tour_end/0/g-0/46/s/0
msgctxt "Choix"
msgid "Well then I have to hear it."
msgstr ""

#: ironaldini_iron/magic_tour_end/0/g-0/47/s/0
msgctxt "Choix"
msgid "Sure. This about Bobby?"
msgstr ""

#: ironaldini_iron/magic_tour_end/0/g-0/c-2/7
msgctxt "I, Ronaldini"
msgid "It's about our excellent little Pinn."
msgstr ""

#: ironaldini_iron/magic_tour_end/0/g-1/3
msgctxt "I, Ronaldini"
msgid "Yes yes, dear Bobby."
msgstr ""

#: ironaldini_iron/magic_tour_end/0/g-1/11
msgctxt "I, Ronaldini"
msgid "I feel terrible... but I create so much counterfeit coin from my practice that it's terribly difficult to get rid of!"
msgstr ""

#: ironaldini_iron/magic_tour_end/0/g-1/19
msgctxt "I, Ronaldini"
msgid "So having an assistant to offload it all through a nearby fence makes my practice ever more sustainable!"
msgstr ""

#: ironaldini_iron/magic_tour_end/0/g-1/27
msgctxt "I, Ronaldini"
msgid "Ahaha! It does feel better having that off my chest."
msgstr ""

#: ironaldini_iron/magic_tour_end/0/g-1/35/s/0
msgctxt "Choix"
msgid "It's okay, Ron, your secret is safe with me."
msgstr ""

#: ironaldini_iron/magic_tour_end/0/g-1/c-4/7
msgctxt "I, Ronaldini"
msgid "Spoken like a true friend."
msgstr ""

#: ironaldini_iron/magic_tour_end/0/g-1/c-4/15
msgctxt "I, Ronaldini"
msgid "And now I must know. The show. Bobby and myself, our big reveal, well, double reveal..."
msgstr ""

#: ironaldini_iron/magic_tour_end/0/g-2/0
msgctxt "I, Ronaldini"
msgid "What did you think?"
msgstr ""

#: ironaldini_iron/magic_tour_end/0/g-2/8/s/0
msgctxt "Choix"
msgid "Really impressed. I'm... you're just phenomenal!"
msgstr ""

#: ironaldini_iron/magic_tour_end/0/g-2/9/s/0
msgctxt "Choix"
msgid "I think it's a solid start."
msgstr ""

#: ironaldini_iron/magic_tour_end/0/g-2/10/s/0
msgctxt "Choix"
msgid "Honestly... meh. Really wasn't my thing."
msgstr ""

#: ironaldini_iron/magic_tour_end/0/g-2/c-5/7
msgctxt "I, Ronaldini"
msgid "I think so as well!"
msgstr ""

#: ironaldini_iron/magic_tour_end/0/g-2/c-5/15 ironaldini_iron/magic_tour_end/0/g-2/c-6/7 ironaldini_iron/magic_tour_end/0/g-2/c-7/23
msgctxt "I, Ronaldini"
msgid "I, Ronaldini... Away!"
msgstr ""

#: ironaldini_iron/magic_tour_end/0/g-2/c-7/7
msgctxt "I, Ronaldini"
msgid "Ha! As cold as Canada, I hate to say!"
msgstr ""

#: ironaldini_iron/magic_tour_end/0/g-2/c-7/15
msgctxt "I, Ronaldini"
msgid "I am grateful for what you've done for me. Or I suppose for what I've managed to do while you were here..."
msgstr ""

#: ironaldini_iron/iron_love_complete/0/4
msgctxt "I, Ronaldini"
msgid "Ah! My love! My truest companion and most trustworthy lover!"
msgstr ""

#: ironaldini_iron/iron_love_complete/0/12
msgctxt "I, Ronaldini"
msgid "My book is complete - my show was a success...!"
msgstr ""

#: ironaldini_iron/iron_love_complete/0/20
msgctxt "I, Ronaldini"
msgid "I can confidently say, not in my whole existence as an iron, as a magician, as a writer, great hell as a CANADIAN, have I ever been this happy!"
msgstr ""

#: ironaldini_iron/iron_love_complete/0/31
msgctxt "I, Ronaldini"
msgid "I love you, I love you, I LOVE YOU!"
msgstr ""

#: ironaldini_iron/iron_love_complete/0/42/s/0
msgctxt "Choix"
msgid "Oh you silly Canadian goose. I LOVE YOU, TOO!"
msgstr ""

#: ironaldini_iron/iron_love_complete/0/43/s/0
msgctxt "Choix"
msgid "Whoa there, pal! I like you alright... but let's leave it at <i>like</i>, if that's ok?"
msgstr ""

#: ironaldini_iron/iron_love_complete/0/44/s/0
msgctxt "Choix"
msgid "Seeing you in this way after the fling we had makes me respect you more as a friend."
msgstr ""

#: ironaldini_iron/iron_love_complete/0/45/s/0
msgctxt "Choix"
msgid "We're already lovers of the physical sort... but seeing you thrive like this makes it true love."
msgstr ""

#: ironaldini_iron/iron_love_complete/0/c-1/7
msgctxt "I, Ronaldini"
msgid "Oh! Oh, yes, of course, it's it's it's it's it's it's alright."
msgstr ""

#: ironaldini_iron/iron_love_complete/0/c-1/15
msgctxt "I, Ronaldini"
msgid "I... I did get carried away, I suppose."
msgstr ""

#: ironaldini_iron/iron_love_complete/0/c-1/23
msgctxt "I, Ronaldini"
msgid "It will be my great honor to keep you as a friend."
msgstr ""

#: ironaldini_iron/iron_love_complete/0/c-2/7
msgctxt "I, Ronaldini"
msgid "I... cannot tell if this is a good thing!"
msgstr ""

#: ironaldini_iron/iron_love_complete/0/c-2/15
msgctxt "I, Ronaldini"
msgid "But I will take it. Hm. A friend it is."
msgstr ""

#: ironaldini_iron/iron_love_complete/0/c-3/11
msgctxt "I, Ronaldini"
msgid "I couldn't agree more."
msgstr ""

#: ironaldini_iron/ironaldini_love_closet_return/0/3/b/1
msgctxt "I, Ronaldini"
msgid "Oh... my little bunny! I'm always pleased to see you appear."
msgstr ""

#: ironaldini_iron/ironaldini_love_closet_return/0/4/b/1 ironaldini_iron/ironaldini_love_return/0/3
msgctxt "I, Ronaldini"
msgid "My one... my only. How may I be your lovely assistant?"
msgstr ""

#: ironaldini_iron/ironaldini_love_closet_return/0/7/s/0 ironaldini_iron/ironaldini_love_return/0/11/s/0
msgctxt "Choix"
msgid "Mmm... I can't wait to come up with more tricks with you..."
msgstr ""

#: ironaldini_iron/ironaldini_love_closet_return/0/8/s/0 ironaldini_iron/ironaldini_friend_return/0/27/s/0
msgctxt "Choix"
msgid "I could help you write your autobiography?"
msgstr ""

#: ironaldini_iron/ironaldini_love_closet_return/0/9/s/0
msgctxt "Choix"
msgid "Can you show me a real magic show sometime...?"
msgstr ""

#: ironaldini_iron/ironaldini_love_closet_return/0/10/s/0 ironaldini_iron/ironaldini_love_return/0/12/s/0
msgctxt "Choix"
msgid "I'd actually like to perform the greatest trick of all... Making you a human!"
msgstr ""

#: ironaldini_iron/ironaldini_love_closet_return/0/c-0/7
msgctxt "I, Ronaldini"
msgid "I am ... tickled!"
msgstr ""

#: ironaldini_iron/ironaldini_love_closet_return/0/c-1/13 ironaldini_iron/ironaldini_friend_return/0/c-2/13
msgctxt "I, Ronaldini"
msgid "That would be... extraordinary!"
msgstr ""

#: ironaldini_iron/ironaldini_love_closet_return/0/c-1/21 ironaldini_iron/ironaldini_friend_return/0/c-2/21
msgctxt "I, Ronaldini"
msgid "Come back and next time I will have..."
msgstr ""

#: ironaldini_iron/ironaldini_love_closet_return/0/c-1/29 ironaldini_iron/ironaldini_friend_return/0/c-2/29
msgctxt "I, Ronaldini"
msgid "Paper!"
msgstr ""

#: ironaldini_iron/ironaldini_love_closet_return/0/c-2/7
msgctxt "I, Ronaldini"
msgid "A sensual show... yes... very much..."
msgstr ""

#: ironaldini_iron/ironaldini_love_closet_return/0/c-2/15/0/s/0
msgctxt "Choix"
msgid "Not a sensual one this time, actually!"
msgstr ""

#: ironaldini_iron/ironaldini_love_closet_return/0/c-2/15/1/s/0
msgctxt "Choix"
msgid "Abracadabra!"
msgstr ""

#: ironaldini_iron/ironaldini_love_closet_return/0/c-2/15/c-0/7
msgctxt "I, Ronaldini"
msgid "Oh!"
msgstr ""

#: ironaldini_iron/ironaldini_love_closet_return/0/c-2/15/c-0/15
msgctxt "I, Ronaldini"
msgid "Well of course I would. Be. VERY excited."
msgstr ""

#: ironaldini_iron/ironaldini_love_closet_return/0/c-2/15/c-0/26
msgctxt "I, Ronaldini"
msgid "Come by next time and I will do the preparations in the meantime."
msgstr ""

#: ironaldini_iron/ironaldini_love_closet_return/0/c-2/15/c-0/34
msgctxt "I, Ronaldini"
msgid "...as well as rebutton my trousers."
msgstr ""

#: ironaldini_iron/ironaldini_love_return/0/c-0/7
msgctxt "I, Ronaldini"
msgid "I am... tickled!"
msgstr ""

#: ironaldini_iron/ironaldini_friend_return/0/3 ironaldini_iron/ironaldini_friend_candy_return/0/3
msgctxt "I, Ronaldini"
msgid "Dear friend! I'm absolutely swamped with all my preparations!"
msgstr ""

#: ironaldini_iron/ironaldini_friend_return/0/11/b/1
msgctxt "I, Ronaldini"
msgid "I have decided to put on a magic show!"
msgstr ""

#: ironaldini_iron/ironaldini_friend_return/0/14/b/1
msgctxt "I, Ronaldini"
msgid "There is my autobiography just out of reach!"
msgstr ""

#: ironaldini_iron/ironaldini_friend_return/0/17
msgctxt "I, Ronaldini"
msgid "I simply can't talk, but you must know that as soon as I have a free moment, it's yours!"
msgstr ""

#: ironaldini_iron/ironaldini_friend_return/0/25/s/0
msgctxt "Choix"
msgid "I know it! Good luck!"
msgstr ""

#: ironaldini_iron/ironaldini_friend_return/0/26/s/0
msgctxt "Choix"
msgid "I would love to see the magic show."
msgstr ""

#: ironaldini_iron/ironaldini_friend_return/0/28/s/0
msgctxt "Choix"
msgid "Actually, I had a new trick for you to practice... becoming human!!"
msgstr ""

#: ironaldini_iron/ironaldini_friend_return/0/c-1/13
msgctxt "I, Ronaldini"
msgid "...really?"
msgstr ""

#: ironaldini_iron/ironaldini_friend_return/0/c-1/21
msgctxt "I, Ronaldini"
msgid "Then I will finish it quickly for you! Come back... later!"
msgstr ""

#: ironaldini_iron/ironaldini_friend_candy_return/0/11
msgctxt "I, Ronaldini"
msgid "What they are for... I am still in the process of finding out."
msgstr ""

#: ironaldini_iron/ironaldini_friend_candy_return/0/19
msgctxt "I, Ronaldini"
msgid "But you must know that as soon as I have found out what it is I'm doing, I'm all yours!"
msgstr ""

#: ironaldini_iron/ironaldini_friend_candy_return/0/27/s/0
msgctxt "Choix"
msgid "I know it! Good luck on your things!"
msgstr ""

#: ironaldini_iron/ironaldini_friend_candy_return/0/28/s/0
msgctxt "Choix"
msgid "Actually, instead of busying yourself, how do you feel about becoming human?"
msgstr ""

#: ironaldini_iron/ironaldini_hate_return/0/3
msgctxt "I, Ronaldini"
msgid "Ah yes, hello. I confess to still being somewhat lost in reverie. Pondering your... advice. Perhaps another time."
msgstr ""

#: ironaldini_iron/ironaldini_hate_return/0/11/s/0
msgctxt "Choix"
msgid "Perhaps."
msgstr ""

#: ironaldini_iron/ironaldini_hate_return/0/12/s/0
msgctxt "Choix"
msgid "Hey, so I was thinking. (USE SASS CANDY)"
msgstr ""

#: ironaldini_iron/ironaldini_hate_return/0/c-1/7
msgctxt "I, Ronaldini"
msgid "Yes?"
msgstr ""

#: ironaldini_iron/ironaldini_hate_return/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "I was basically telling you that you were a whiny bitch earlier."
msgstr ""

#: ironaldini_iron/ironaldini_hate_return/0/c-1/15/c-0/7
msgctxt "I, Ronaldini"
msgid "Yes."
msgstr ""

#: ironaldini_iron/ironaldini_hate_return/0/c-1/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "But you know who was actually being a whiny bitch?"
msgstr ""

#: ironaldini_iron/ironaldini_hate_return/0/c-1/15/c-0/15/c-0/7
msgctxt "I, Ronaldini"
msgid "Bated breath, darling."
msgstr ""

#: ironaldini_iron/ironaldini_hate_return/0/c-1/15/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "Me."
msgstr ""

#: ironaldini_iron/ironaldini_hate_return/0/c-1/15/c-0/15/c-0/15/1/s/0
msgctxt "Choix"
msgid "You, bitch. Psych!"
msgstr ""

#: ironaldini_iron/ironaldini_hate_return/0/c-1/15/c-0/15/c-0/15/c-0/7
msgctxt "I, Ronaldini"
msgid "Hm."
msgstr ""

#: ironaldini_iron/ironaldini_hate_return/0/c-1/15/c-0/15/c-0/15/c-0/15
msgctxt "I, Ronaldini"
msgid "Would never have expected that to be under your cape."
msgstr ""

#: ironaldini_iron/ironaldini_hate_return/0/c-1/15/c-0/15/c-0/15/c-0/23
msgctxt "I, Ronaldini"
msgid "An interesting take. I agree."
msgstr ""

#: ironaldini_iron/ironaldini_hate_return/0/c-1/15/c-0/15/c-0/15/c-0/31/0/s/0
msgctxt "Choix"
msgid "Can we be friends now?"
msgstr ""

#: ironaldini_iron/ironaldini_hate_return/0/c-1/15/c-0/15/c-0/15/c-0/31/c-0/7
msgctxt "I, Ronaldini"
msgid "Yes, we may."
msgstr ""

#: ironaldini_iron/ironaldini_hate_return/0/c-1/15/c-0/15/c-0/15/c-0/31/c-0/15
msgctxt "I, Ronaldini"
msgid "Though it does depend on how good you are at being sawn in half."
msgstr ""

#: ironaldini_iron/ironaldini_realize_join/0/0
msgctxt "I, Ronaldini"
msgid "Ha! Now YOU are the one playing tricks!"
msgstr ""

#: ironaldini_iron/ironaldini_realize_join/0/8
msgctxt "I, Ronaldini"
msgid "For if you truly meant it, if you truly meant that you were going to Realize me and make me human, well then this would be the most exciting day of my whole existence..."
msgstr ""

#: ironaldini_iron/ironaldini_realize_join/0/16
msgctxt "I, Ronaldini"
msgid "...and when I woke up this morning I was by no means prepared to have the most exciting day of my existence! So."
msgstr ""

#: ironaldini_iron/ironaldini_realize_join/0/24/s/0
msgctxt "Choix"
msgid "Bub? I'm serious."
msgstr ""

#: ironaldini_iron/ironaldini_realize_join/0/25/s/0
msgctxt "Choix"
msgid "Well get prepared. Cuz it's happening."
msgstr ""

#: ironaldini_iron/ironaldini_realize_join/0/g-0/0
msgctxt "I, Ronaldini"
msgid "By all the holy starch and pleats."
msgstr ""

#: ironaldini_iron/ironaldini_realize_join/0/g-0/8
msgctxt "I, Ronaldini"
msgid "YES!!!!!"
msgstr ""

#: ironaldini_iron/ironaldini_realize_join/0/g-0/19
msgctxt "I, Ronaldini"
msgid "Let's do this! Ultimate magic trick, begin!"
msgstr ""

#: ironaldini_iron/ironaldini_realize_join/0/g-0/33/s/0
msgctxt "Choix"
msgid "Ok, here we go, then!"
msgstr ""

#: ironaldini_iron/ironaldini_realize_join/0/g-0/34/s/0
msgctxt "Choix"
msgid "I just have a few more things to get and then I'll be ready!"
msgstr ""

#: ironaldini_iron/ironaldini_realize_join/0/g-0/c-3/10
msgctxt "I, Ronaldini"
msgid "Well. Then, friend, you are a tease. But! It's ok, I can forgive and forget, as long as you come back and quickly!"
msgstr ""

#: ironaldini_iron/ironaldini_realize_return/0/0
msgctxt "I, Ronaldini"
msgid "You're back! Excellent. Are we ready?"
msgstr ""

#: ironaldini_iron/ironaldini_realize_return/0/14/s/0
msgctxt "Choix"
msgid "Oh yes. It's time, my friend."
msgstr ""

#: ironaldini_iron/ironaldini_realize_return/0/15/s/0
msgctxt "Choix"
msgid "Ah, almost, so sorry!"
msgstr ""

#: ironaldini_iron/ironaldini_realize_return/0/c-1/10
msgctxt "I, Ronaldini"
msgid "You will be sorry! When I'm a human and I can do human-sized magic on you!"
msgstr ""

#: ironaldini_iron/ironaldini_realize_return/0/c-1/18
msgctxt "I, Ronaldini"
msgid "Oh, what am I talking about, I'll still be nice to you and love you and... argh, just hurry it up!"
msgstr ""

#: ironaldini_iron/ironaldini_realize_begin/6/b/1
msgctxt "Skylar"
msgid "Can I pull off my greatest trick... Realization?"
msgstr ""

#: ironaldini_iron/ironaldini_realize_begin/9
msgctxt "Skylar"
msgid "Abra-cadabra, I, Ronaldini!"
msgstr ""

#: ironaldini_iron/ironaldini_realize_begin/20
msgctxt "Narrator"
msgid "The spectral energy flows through your dateviators, and what was once merely a fold-out ironing board, becomes...."
msgstr ""

#: ironaldini_iron/ironaldini_realized/0/3
msgctxt "I, Ronaldini"
msgid "I, Ronaldini, the single greatest magician, writer, Canadian ALIVE!"
msgstr ""

#: ironaldini_iron/ironaldini_realized/0/11/s/0
msgctxt "Choix"
msgid "You are truly ready to take on the world, my friend!"
msgstr ""

#: ironaldini_iron/ironaldini_realized/0/12/s/0
msgctxt "Choix"
msgid "Ooh. Now I really wanna be locked in a dark room with you..."
msgstr ""

#: ironaldini_iron/ironaldini_love_divert/0/3
msgctxt "I, Ronaldini"
msgid "Ah my love. My truest little bunny."
msgstr ""

#: ironaldini_iron/ironaldini_love_divert/0/11
msgctxt "I, Ronaldini"
msgid "I happen to have such a closet set aside for us... would you care to step inside and... make some magic of our own?"
msgstr ""

#: ironaldini_iron/ironaldini_love_divert/0/19/s/0
msgctxt "Choix"
msgid "Mmm. I'm feeling magical already."
msgstr ""

#: ironaldini_iron/ironaldini_love_divert/0/c-0/7
msgctxt "Narrator"
msgid "You and I, Ronaldini... repair to the \"closet.\" In truth, it is not a closet at all, but a sumptuously decorated bedroom full of candles, silk, velvet, and the delicate scent of roses."
msgstr ""

#: ironaldini_iron/ironaldini_love_divert/0/c-0/15
msgctxt "Narrator"
msgid "He caresses you. He fools and delights your senses with elegant displays of sleight of hand. And more than a few tricks you have never seen before."
msgstr ""

#: ironaldini_iron/ironaldini_love_divert/0/c-0/23
msgctxt "Narrator"
msgid "He tickles your intellect with riddles and stories of his now more-appreciated homeland of Saskatchewan."
msgstr ""

#: ironaldini_iron/ironaldini_love_divert/0/c-0/31
msgctxt "Narrator"
msgid "He is delighted and tickled in turn by you. By your inquisitive fingers. By your adventurous and loving spirit."
msgstr ""

#: ironaldini_iron/ironaldini_love_divert/0/c-0/39
msgctxt "Narrator"
msgid "By evening's end, you realize that indeed, some magic is quite real."
msgstr ""

#: ironaldini_iron/ironaldini_love_join/0
msgctxt "Narrator"
msgid "I, Ronaldini departed the next morning with his literal bag of tricks as the sun broke over the horizon."
msgstr ""

#: ironaldini_iron/ironaldini_love_join/8
msgctxt "Narrator"
msgid "A magician by trade and in his heart, I, Ronaldini sought out the real-life equivalent of his magicking roots. But unfortunately he quickly proved to be rather clumsy as a human."
msgstr ""

#: ironaldini_iron/ironaldini_love_join/16
msgctxt "Narrator"
msgid "So, he got himself a job in a high-end magic shop with a secret back room where he learned about real mysticism and the real occult. Naturally, his interest was instantly piqued and he thought, at last..."
msgstr ""

#: ironaldini_iron/ironaldini_love_join/24
msgctxt "I, Ronaldini"
msgid "I have found the calling of my new life!"
msgstr ""

#: ironaldini_iron/ironaldini_love_join/32
msgctxt "Narrator"
msgid "Oh dear. He thought so. But he proved to have very little skill as a true occultist, either."
msgstr ""

#: ironaldini_iron/ironaldini_love_join/40
msgctxt "Narrator"
msgid "I, Ronaldini became despondent."
msgstr ""

#: ironaldini_iron/ironaldini_love_join/48
msgctxt "I, Ronaldini"
msgid "If I cannot be a true magician, and I cannot even pursue the mysteries of the occult... what is there for me? My god, what am I, what shall I do?"
msgstr ""

#: ironaldini_iron/ironaldini_love_join/56
msgctxt "Narrator"
msgid "One cold and rainy Tuesday afternoon, as he depressedly restocked the shelves in the magic shop, one of the \"true occultists\" entered in a terrifically rumpled blue velvet cape."
msgstr ""

#: ironaldini_iron/ironaldini_love_join/64
msgctxt "Narrator"
msgid "Almost without thinking, he slipped it from her shoulders."
msgstr ""

#: ironaldini_iron/ironaldini_love_join/72
msgctxt "Narrator"
msgid "His fingers seemed miraculously to regain some of their former dexterity, and it was merely the work of a moment for I, Ronaldini to make that cape look New."
msgstr ""

#: ironaldini_iron/ironaldini_love_join/80
msgctxt "Narrator"
msgid "Better than new. It looked splendid. And that's when he finally realized... this was it."
msgstr ""

#: ironaldini_iron/ironaldini_love_join/88
msgctxt "Narrator"
msgid "By the very next week, Ron was prepared to launch his company MagiFlat."
msgstr ""

#: ironaldini_iron/ironaldini_love_join/96
msgctxt "I, Ronaldini"
msgid "I sell complete, magical clothing press kits that will make even the most delicate or complex fabrics shine like new! You want to look your best? Then you use the best!"
msgstr ""

#: ironaldini_iron/ironaldini_love_join/104
msgctxt "Narrator"
msgid "In short order, I, Ronaldini was no longer working in the magic shop, no longer despondent and no longer doing the ironing by himself."
msgstr ""

#: ironaldini_iron/ironaldini_love_join/112
msgctxt "Narrator"
msgid "Success was so resplendent, the money so plentiful that it could only be ascribed..."
msgstr ""

#: ironaldini_iron/ironaldini_love_join/120
msgctxt "I, Ronaldini"
msgid "...to magic!"
msgstr ""
