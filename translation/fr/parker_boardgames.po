#: parker_boardgames/euro_play/0/g-0/c-6/26
msgctxt "Parker"
msgid "Very well."
msgstr ""

#: parker_boardgames/euro_play/0/g-0/c-7/7
msgctxt "Narrator"
msgid "Parker looks stunned."
msgstr ""

#: parker_boardgames/euro_play/0/g-0/c-7/18
msgctxt "Parker"
msgid "Wait... that. That was supposed to belong to me! To Belgium!"
msgstr ""

#: parker_boardgames/euro_win/0
msgctxt "Narrator"
msgid "Soon, with the bottom falling out of his resource generation, Parker's mighty dairy empire crumbles beneath its own weight."
msgstr ""

#: parker_boardgames/euro_win/11
msgctxt "Narrator"
msgid "You are out-producing him 4:1, and your low-fat milk production has increased exponentially."
