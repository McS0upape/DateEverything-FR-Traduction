msgstr "Ton comportement était un signe de douleur."

# Traduction IA – à relire
#: rebel_duck/Rebel_Breakthrough_3/0/g-7/34/s/0
msgctxt "Choix"
msgid "A hurting hand is connected to a hurting heart."
msgstr "Une main qui blesse est reliée à un cœur blessé."

# Traduction IA – à relire
#: rebel_duck/Rebel_Breakthrough_3/0/g-8/0
