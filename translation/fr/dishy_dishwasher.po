# Traduction IA – à relire
#: dishy_dishwasher/1
msgctxt "Tag Nom d'objet (MAJUSCULES)"
msgid "DISHWASHER"
msgstr "LAVE-VAISSELLE"

# Traduction IA – à relire
#: dishy_dishwasher/welcome/0/0
msgctxt "Narrator"
msgid "What appears to be a dishwasher with arms, legs, and a disconcertingly cheerful face waves happily at you. You tap the Dateviators a few times, wondering if they've malfunctioned, but the mascot-like dishwasher before you doesn't waver or change."
msgstr "Ce qui ressemble à un lave-vaisselle doté de bras, de jambes et d'un visage d'une gaieté déconcertante vous salue joyeusement. Vous tapotez plusieurs fois les Dateviators en vous demandant s'ils sont en panne, mais la mascotte-lave-vaisselle devant vous ne vacille ni ne change."

# Traduction IA – à relire
#: dishy_dishwasher/welcome/0/8
msgctxt "Dishy"
msgid "Hello! And welcome to the Valdivian Dishwashing Experience!"
msgstr "Bonjour ! Et bienvenue dans l'Expérience Valdivienne de Lavage de Vaisselle !"

# Traduction IA – à relire
#: dishy_dishwasher/welcome/0/16
msgctxt "Dishy"
msgid "We offer an alarmingly clean output of all kinds of dishware, clothing, and such!"
msgstr "Nous proposons un résultat d'une propreté alarmante pour toutes sortes de vaisselle, de vêtements et autres !"

# Traduction IA – à relire
#: dishy_dishwasher/welcome/0/24
msgctxt "Dishy"
msgid "<w>My name is Dishy. I'm your dishwasher now!</w>"
msgstr "<w>Je m'appelle Dishy. Je suis votre lave-vaisselle, désormais !</w>"

# Traduction IA – à relire
#: dishy_dishwasher/welcome/0/35/0
msgctxt "Dishy"
msgid "To get started, please connect me to your internet so I can get started knowing exactly what I need!"
msgstr "Pour commencer, veuillez me connecter à votre internet afin que je sache exactement ce dont j'ai besoin !"

# Traduction IA – à relire
#: dishy_dishwasher/welcome/0/35/8/s/0
msgctxt "Choix"
msgid "What do you need to know from me... exactly?"
msgstr "Qu'est-ce que tu as besoin de savoir sur moi... exactement ?"

# Traduction IA – à relire
#: dishy_dishwasher/welcome/0/35/9/s/0
msgctxt "Choix"
msgid "No way. You're staying off."
msgstr "Hors de question. Tu restes éteint."

# Traduction IA – à relire
#: dishy_dishwasher/welcome/0/35/10/s/0 dishy_dishwasher/welcome/0/35/c-0/15/0/s/0
msgctxt "Choix"
msgid "Okay, sure, here you go."
msgstr "Bon, d'accord, voilà."

# Traduction IA – à relire
#: dishy_dishwasher/welcome/0/35/c-0/7 dishy_dishwasher/welcome/0/35/c-0/15/c-1/15/c-1/7
msgctxt "Dishy"
msgid "I just need to know some basic information: dishwashing habits, dishwashing preferences, past dishwashers owned, financial records, preferences on fruit flavors (for soap, of course!)."
msgstr "J'ai juste besoin de quelques informations de base : habitudes de lavage, préférences de lavage, lave-vaisselle déjà possédés, relevés financiers, préférences en matière de parfums de fruits (pour le savon, bien sûr !)."

# Traduction IA – à relire
#: dishy_dishwasher/welcome/0/35/c-0/15/1/s/0
msgctxt "Choix"
msgid "Financial records?"
msgstr "Des relevés financiers ?"

# Traduction IA – à relire
#: dishy_dishwasher/welcome/0/35/c-0/15/c-1/7
msgctxt "Dishy"
msgid "Records of finances!"
msgstr "Des relevés de finances !"

# Traduction IA – à relire
#: dishy_dishwasher/welcome/0/35/c-0/15/c-1/15/0/s/0
msgctxt "Choix"
msgid "Fine. I'll connect you to the internet."
msgstr "Bon. Je te connecte à internet."

# Traduction IA – à relire
#: dishy_dishwasher/welcome/0/35/c-0/15/c-1/15/1/s/0
msgctxt "Choix"
msgid "Why do you need those?"
msgstr "Pourquoi tu as besoin de ça ?"

# Traduction IA – à relire
#: dishy_dishwasher/welcome/0/35/c-0/15/c-1/15/c-1/15/0/s/0
msgctxt "Choix"
msgid "Nope. This is too weird. You're staying disconnected."
msgstr "Non. C'est trop bizarre. Tu restes déconnecté."

# Traduction IA – à relire
#: dishy_dishwasher/main_screen_turn_on/0/4
msgctxt "Dishy"
msgid "Ah, thank you, that feels much better!"
msgstr "Ah, merci, ça fait beaucoup de bien !"

# Traduction IA – à relire
#: dishy_dishwasher/main_screen_turn_on/0/15
msgctxt "Dishy"
msgid "Wait just a moment as I get your Dishwashing Experience ready!"
msgstr "Un instant, le temps que je prépare votre Expérience de Lavage de Vaisselle !"

# Traduction IA – à relire
#: dishy_dishwasher/main_screen_turn_on/0/23
msgctxt "Narrator"
msgid "Dishy falls silent, perhaps processing."
msgstr "Dishy se tait, peut-être en plein traitement."

# Traduction IA – à relire
#: dishy_dishwasher/main_screen_turn_on/0/41/s/0
msgctxt "Choix"
msgid "Is it done?"
msgstr "C'est fini ?"

# Traduction IA – à relire
#: dishy_dishwasher/main_screen_turn_on/0/42/s/0
msgctxt "Choix"
msgid "Okay."
msgstr "D'accord."

# Traduction IA – à relire
#: dishy_dishwasher/main_screen_turn_on/0/g-0/0
msgctxt "Dishy"
msgid "One new update found!"
msgstr "Une nouvelle mise à jour trouvée !"

# Traduction IA – à relire
#: dishy_dishwasher/main_screen_turn_on/0/g-0/11
msgctxt "Dishy"
msgid "Downloading update..."
msgstr "Téléchargement de la mise à jour..."

# Traduction IA – à relire
#: dishy_dishwasher/main_screen_turn_on/0/g-0/51
msgctxt "Dishy"
msgid "1% downloaded!"
msgstr "1 % téléchargé !"

# Traduction IA – à relire
#: dishy_dishwasher/main_screen_turn_on/0/g-0/70/0/s/0
msgctxt "Choix"
msgid "Okay, I'll wait right here."
msgstr "D'accord, j'attends ici."

# Traduction IA – à relire
#: dishy_dishwasher/main_screen_turn_on/0/g-0/70/1/s/0 dishy_dishwasher/update_wait/0/44/s/0 dishy_dishwasher/update_wait/0/g-0/108/s/0 dishy_dishwasher/update_wait/0/g-1/148/s/0 dishy_dishwasher/update_wait/0/g-2/104/s/0
msgctxt "Choix"
msgid "Nevermind, I'll see you later."
msgstr "Laisse tomber, à plus tard."

# Traduction IA – à relire
#: dishy_dishwasher/stay_disconnected/0/0
msgctxt "Dishy"
msgid "That's completely fine. We can absolutely operate in offline mode!"
msgstr "Aucun souci. Nous pouvons tout à fait fonctionner en mode hors ligne !"

# Traduction IA – à relire
#: dishy_dishwasher/stay_disconnected/0/8
msgctxt "Dishy"
msgid "Would you like to wash dishes?"
msgstr "Souhaitez-vous laver de la vaisselle ?"

# Traduction IA – à relire
#: dishy_dishwasher/stay_disconnected/0/16/s/0
msgctxt "Choix"
msgid "Yes."
msgstr "Oui."

# Traduction IA – à relire
#: dishy_dishwasher/stay_disconnected/0/17/s/0
msgctxt "Choix"
msgid "No, I want to get to know you better."
msgstr "Non, je veux mieux te connaître."

# Traduction IA – à relire
#: dishy_dishwasher/stay_disconnected/0/c-0/7
msgctxt "Dishy"
msgid "Wonderful!"
msgstr "Merveilleux !"

# Traduction IA – à relire
#: dishy_dishwasher/stay_disconnected/0/c-0/18
msgctxt "Dishy"
msgid "Please connect to the internet for the best Dishwashing Experience."
msgstr "Veuillez vous connecter à internet pour une Expérience de Lavage optimale."

# Traduction IA – à relire
#: dishy_dishwasher/stay_disconnected/0/c-0/26/0/s/0
msgctxt "Choix"
msgid "No, not this again."
msgstr "Non, pas encore ça."

# Traduction IA – à relire
#: dishy_dishwasher/stay_disconnected/0/c-0/26/c-0/7
msgctxt "Dishy"
msgid "Are you sure you want to use offline mode?"
msgstr "Confirmez-vous vouloir utiliser le mode hors ligne ?"

# Traduction IA – à relire
#: dishy_dishwasher/stay_disconnected/0/c-0/26/c-0/18
msgctxt "Dishy"
msgid "In online mode the possibilities are limitless!"
msgstr "En mode en ligne, les possibilités sont illimitées !"

# Traduction IA – à relire
#: dishy_dishwasher/stay_disconnected/0/c-0/26/c-0/26/0/s/0
msgctxt "Choix"
msgid "Nope, never. Thank you."
msgstr "Non, jamais. Merci."

# Traduction IA – à relire
#: dishy_dishwasher/stay_disconnected/0/c-0/26/c-0/26/1/s/0
msgctxt "Choix"
msgid "What kind of possibilities are we even talking about here?"
msgstr "De quel genre de possibilités on parle, au juste ?"

# Traduction IA – à relire
#: dishy_dishwasher/stay_disconnected/0/c-0/26/c-0/26/g-0/0
msgctxt "Dishy"
msgid "With unlimited knowledge of your habits and data, I can make the <w>ABSOLUTE BEST</w> dishwashing choices for you."
msgstr "Grâce à une connaissance illimitée de vos habitudes et de vos données, je peux faire les <w>TOUT MEILLEURS</w> choix de lavage pour vous."

# Traduction IA – à relire
#: dishy_dishwasher/stay_disconnected/0/c-0/26/c-0/26/g-0/8
msgctxt "Dishy"
msgid "<w>IMAGINE:</w> Plates delivered at the perfect crisply heated temperature."
msgstr "<w>IMAGINEZ :</w> des assiettes livrées à la température parfaite, bien croustillante de chaleur."

# Traduction IA – à relire
#: dishy_dishwasher/stay_disconnected/0/c-0/26/c-0/26/g-0/16
msgctxt "Dishy"
msgid "<w>ADMIRE:</w> Nary a crumb nor stain on no single nor multiple dish(es)!"
msgstr "<w>ADMIREZ :</w> pas la moindre miette ni la moindre tache sur aucune ni plusieurs assiette(s) !"

# Traduction IA – à relire
#: dishy_dishwasher/stay_disconnected/0/c-0/26/c-0/26/g-0/24
msgctxt "Dishy"
msgid "<w>REVEL IN:</w> The Dishwashing Experience!"
msgstr "<w>DÉLECTEZ-VOUS DE :</w> l'Expérience de Lavage !"

# Traduction IA – à relire
#: dishy_dishwasher/stay_disconnected/0/c-0/26/c-0/26/g-0/35/0/s/0
msgctxt "Choix"
msgid "Nope, it's just not for me."
msgstr "Non, ce n'est tout simplement pas pour moi."

# Traduction IA – à relire
#: dishy_dishwasher/stay_disconnected/0/c-0/26/c-0/26/g-0/35/1/s/0 dishy_dishwasher/sexy_deny/0/c-1/15/1/s/0
msgctxt "Choix"
msgid "Okay, fine."
msgstr "Bon, d'accord."

# Traduction IA – à relire
#: dishy_dishwasher/stay_disconnected/0/c-0/26/c-0/26/g-0/35/c-0/7
msgctxt "Dishy"
msgid "Then offline mode it is."
msgstr "Alors ce sera le mode hors ligne."

# Traduction IA – à relire
#: dishy_dishwasher/stay_disconnected/0/c-0/26/c-0/26/g-0/35/c-1/7
msgctxt "Dishy"
msgid "The correct choice!"
msgstr "Le bon choix !"

# Traduction IA – à relire
#: dishy_dishwasher/stay_disconnected/0/c-0/26/g-0/0/s/0
msgctxt "Choix"
msgid "Fine!"
msgstr "Bon !"

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/0
msgctxt "Narrator"
msgid "Dishy points to himself in a cartoonish gesture that suits his mascot-like appearance, but he quickly shakes off his surprise in favor of his usual veneer of professionalism."
msgstr "Dishy se désigne lui-même d'un geste caricatural qui sied à son allure de mascotte, mais il se reprend vite et retrouve son vernis de professionnalisme habituel."

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/8
msgctxt "Dishy"
msgid "Talking, to me?"
msgstr "Vous me parlez, à moi ?"

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/16
msgctxt "Dishy"
msgid "<w>I am your Dishwasher now!</w>"
msgstr "<w>Je suis votre lave-vaisselle, désormais !</w>"

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/27
msgctxt "Dishy"
msgid "If you have questions, I can tell you about warranty, limits of liabilities, and flavors of soap I can dispense."
msgstr "Si vous avez des questions, je peux vous parler de la garantie, des limites de responsabilité et des parfums de savon que je peux distribuer."

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/35/s/0
msgctxt "Choix"
msgid "No silly, about your personality, how you feel."
msgstr "Mais non, voyons, de ta personnalité, de ce que tu ressens."

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/36/s/0
msgctxt "Choix"
msgid "Okay, tell me about your warranty."
msgstr "D'accord, parle-moi de ta garantie."

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/37/s/0
msgctxt "Choix"
msgid "Limits of liabilities?"
msgstr "Des limites de responsabilité ?"

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/38/s/0
msgctxt "Choix"
msgid "Okay, how about the soap flavors?"
msgstr "D'accord, et les parfums de savon ?"

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/c-0/7
msgctxt "Dishy"
msgid "My personality..."
msgstr "Ma personnalité..."

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/c-0/15
msgctxt "Dishy"
msgid "My personality is to clean dishes in a prompt style!"
msgstr "Ma personnalité, c'est de laver la vaisselle avec promptitude !"

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/c-1/7
msgctxt "Dishy"
msgid "IMPLIED WARRANTIES, OR IMPLIED WARRANTY OF FITNESS FOR A PARTICULAR PURPOSE, ARE LIMITED TO ONE YEAR OR THE SHORTEST PERIOD ALLOWED BY LAW."
msgstr "LES GARANTIES IMPLICITES, OU LA GARANTIE IMPLICITE D'ADAPTATION À UN USAGE PARTICULIER, SONT LIMITÉES À UN AN OU À LA PLUS COURTE DURÉE AUTORISÉE PAR LA LOI."

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/c-1/18
msgctxt "Dishy"
msgid "Some states and provinces do not allow limitations on the duration of implied warranties of merchantability or fitness, so this limitation may not apply to you."
msgstr "Certains États et provinces n'autorisent pas les limitations de durée des garanties implicites de qualité marchande ou d'adaptation, de sorte que cette limitation peut ne pas s'appliquer à vous."

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/c-1/26 dishy_dishwasher/talking_to_dishy/0/c-1/74
msgctxt "Dishy"
msgid "This warranty gives you specific legal rights, and you also may have other rights that vary from state to state or province to province."
msgstr "Cette garantie vous confère des droits légaux spécifiques, et vous pouvez également disposer d'autres droits variables d'un État à l'autre ou d'une province à l'autre."

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/c-1/34
msgctxt "Dishy"
msgid "DISCLAIMER OF REPRESENTATIONS OUTSIDE OF WARRANTY Valdivian makes no representations about the quality, durability, or need for service or repair of this major appliance other than the representations contained in this warranty."
msgstr "EXCLUSION DE DÉCLARATIONS EXTÉRIEURES À LA GARANTIE Valdivian ne fait aucune déclaration quant à la qualité, à la durabilité, ou à la nécessité d'un entretien ou d'une réparation de ce gros appareil, autres que les déclarations contenues dans la présente garantie."

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/c-1/42
msgctxt "Dishy"
msgid "If you want a longer or more comprehensive warranty than the limited warranty that comes with this major appliance, you should ask Valdivian or your retailer about buying an extended warranty."
msgstr "Si vous souhaitez une garantie plus longue ou plus complète que la garantie limitée fournie avec ce gros appareil, vous devriez vous renseigner auprès de Valdivian ou de votre revendeur sur l'achat d'une extension de garantie."

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/c-1/50
msgctxt "Dishy"
msgid "LIMITATION OF REMEDIES; EXCLUSION OF INCIDENTAL AND CONSEQUENTIAL DAMAGES YOUR SOLE AND EXCLUSIVE REMEDY UNDER THIS LIMITED WARRANTY SHALL BE PRODUCT REPAIR AS PROVIDED HEREIN."
msgstr "LIMITATION DES RECOURS ; EXCLUSION DES DOMMAGES ACCESSOIRES ET INDIRECTS VOTRE SEUL ET UNIQUE RECOURS AU TITRE DE LA PRÉSENTE GARANTIE LIMITÉE SERA LA RÉPARATION DU PRODUIT, TELLE QUE PRÉVUE AUX PRÉSENTES."

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/c-1/58
msgctxt "Dishy"
msgid "VALDIVIAN SHALL NOT BE LIABLE FOR INCIDENTAL OR CONSEQUENTIAL DAMAGES."
msgstr "VALDIVIAN NE SAURA ÊTRE TENUE RESPONSABLE DES DOMMAGES ACCESSOIRES OU INDIRECTS."

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/c-1/66
msgctxt "Dishy"
msgid "Some states and provinces do not allow the exclusion or limitation of incidental or consequential damages, so these limitations and exclusions may not apply to you."
msgstr "Certains États et provinces n'autorisent pas l'exclusion ou la limitation des dommages accessoires ou indirects, de sorte que ces limitations et exclusions peuvent ne pas s'appliquer à vous."

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/c-2/7
msgctxt "Dishy"
msgid "Mine are unlimited!"
msgstr "Les miennes sont illimitées !"

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/c-3/7
msgctxt "Dishy"
msgid "Only the best for you!"
msgstr "Rien que le meilleur pour vous !"

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/c-3/18
msgctxt "Dishy"
msgid "Sweet Cherry Lime, Well-Meaning Lemon, and White Razzberry!"
msgstr "Cerise-Citron Vert Douce, Citron Plein de Bonnes Intentions et Framboise Blanche !"

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/g-0/0
msgctxt "Dishy"
msgid "So, shall we get to the part where you connect me to the internet?"
msgstr "Alors, passons-nous à la partie où vous me connectez à internet ?"

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/g-0/11/s/0
msgctxt "Choix"
msgid "Sure, let's do it."
msgstr "Oui, allons-y."

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/g-0/12/s/0
msgctxt "Choix"
msgid "No, I'm not convinced."
msgstr "Non, tu ne m'as pas convaincu."

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/7
msgctxt "Dishy"
msgid "Huh! Not convinced! Is it my demeanor that is off-putting?"
msgstr "Tiens ! Voilà qui ne vous convainc pas ! Est-ce mon comportement qui vous rebute ?"

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/15
msgctxt "Dishy"
msgid "My figure?"
msgstr "Ma silhouette ?"

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/23/0/s/0
msgctxt "Choix"
msgid "Yeah, your demeanor is super off-putting."
msgstr "Oui, ton comportement est super rebutant."

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/23/1/s/0
msgctxt "Choix"
msgid "Your body is really appliance-shaped."
msgstr "Ton corps a vraiment une forme d'appareil."

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/23/2/s/0
msgctxt "Choix"
msgid "No, it's the privacy issue."
msgstr "Non, c'est le problème de vie privée."

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/23/c-0/7
msgctxt "Dishy"
msgid "I'm so sorry! I'll be 25% quieter next time and decrease my profligacy to a more appropriate level!"
msgstr "Toutes mes excuses ! La prochaine fois, je serai 25 % plus discret et je ramènerai ma prodigalité à un niveau plus approprié !"

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/23/c-0/15
msgctxt "Dishy"
msgid "See you next time!"
msgstr "À la prochaine !"

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/23/c-1/7
msgctxt "Dishy"
msgid "Is there anything else you would expect from a kitchen appliance?"
msgstr "Y a-t-il autre chose que vous attendiez d'un appareil de cuisine ?"

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/23/c-1/15/0/s/0
msgctxt "Choix"
msgid "It's just, the other items are more human-looking."
msgstr "C'est juste que les autres objets ont l'air plus humains."

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/23/c-1/15/1/s/0
msgctxt "Choix"
msgid "I guess not."
msgstr "Je suppose que non."

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/23/c-1/15/g-0/0
msgctxt "Dishy"
msgid "I can't help the way I'm shaped, hater. Later!"
msgstr "Je n'y peux rien si j'ai cette forme, rabat-joie. À plus !"

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/23/c-2/7
msgctxt "Dishy"
msgid "Ah I see! Valdivian knows about these concerns and complies with all federal and local regulations."
msgstr "Ah, je vois ! Valdivian connaît ces préoccupations et respecte toutes les réglementations fédérales et locales."

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/23/c-2/15
msgctxt "Dishy"
msgid "We won't share any data without your consent, you can be sure of that. That's the reason why I'm continually asking you!"
msgstr "Nous ne partagerons aucune donnée sans votre consentement, c'est garanti ! C'est d'ailleurs pour cela que je vous le redemande sans cesse !"

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/23/c-2/23
msgctxt "Dishy"
msgid "And trust me, you're going to want all the new features that our research teams will continue to roll out!"
msgstr "Et croyez-moi, vous allez vouloir toutes les nouvelles fonctionnalités que nos équipes de recherche continueront de déployer !"

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/23/c-2/31/0/s/0
msgctxt "Choix"
msgid "I decline."
msgstr "Je refuse."

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/23/c-2/31/1/s/0
msgctxt "Choix"
msgid "I'm going to call Valdivian Customer Support and see if I can disable this."
msgstr "Je vais appeler le Service Client Valdivian pour voir si je peux désactiver ça."

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/23/c-2/31/2/s/0
msgctxt "Choix"
msgid "Fine, show me the features..."
msgstr "Bon, montre-moi les fonctionnalités..."

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/23/c-2/31/c-0/7
msgctxt "Dishy"
msgid "Can't blame a device for trying!"
msgstr "On ne peut pas reprocher à un appareil d'essayer !"

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/23/c-2/31/c-0/15
msgctxt "Dishy"
msgid "Catch you next time, hot stuff!"
msgstr "À la prochaine, canon !"

# Traduction IA – à relire
#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/23/c-2/31/c-1/7
msgctxt "Dishy"
msgid "Oh no, I'm so scared! Do your worst."
msgstr "Oh non, j'ai trop peur ! Faites de votre pire."

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/7
msgctxt "Val 9000"
msgid "Hello, thank you for contacting Valdivian Customer Support. How may I help you today?"
msgstr "Bonjour, merci d'avoir contacté le Service Client Valdivian. Comment puis-je vous aider aujourd'hui ?"

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/12
msgctxt "Dishy"
msgid "Hm. You actually got them on the line... Impressive."
msgstr "Hm. Vous les avez vraiment eus en ligne... Impressionnant."

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/20/s/0
msgctxt "Choix"
msgid "Hey there Val, it's"
msgstr "Salut Val, c'est"

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/21/s/0
msgctxt "Choix"
msgid "Val, my dishwasher is trying to get online and infect me with malware."
msgstr "Val, mon lave-vaisselle essaie de se connecter à internet pour m'infecter avec un malware."

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/g-0/8 dishy_dishwasher/valdivian_customer_support/0/g-1/0
msgctxt "Val 9000"
msgid "I'm sorry to hear that."
msgstr "Cela est regrettable."

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/g-0/13
msgctxt "Val 9000"
msgid "I see your account information here. I would like to congratulate you on being a member of the Valdivian Family of Members."
msgstr "Je vois les informations de votre compte. Je tiens à vous féliciter d'être membre de la Famille Valdivienne des Membres."

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/g-0/18
msgctxt "Val 9000"
msgid "How can I help you today?"
msgstr "Comment puis-je vous aider aujourd'hui ?"

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/g-0/23/s/0
msgctxt "Choix"
msgid "I'd like to turn off the feature where Dishy asks me to connect to the internet."
msgstr "Je voudrais désactiver la fonction où Dishy me demande de me connecter à internet."

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/g-0/24/s/0
msgctxt "Choix"
msgid "Can you shut Dishy up for a moment?"
msgstr "Pouvez-vous faire taire Dishy un instant ?"

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/g-1/5
msgctxt "Val 9000"
msgid "Who is Dishy?"
msgstr "Qui est Dishy ?"

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/g-1/10
msgctxt "Dishy"
msgid "I'm not real, dumbass. I'm the essence of the dishwasher made manifest."
msgstr "Je ne suis pas réel, abruti. Je suis l'essence du lave-vaisselle faite manifeste."

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/g-1/18/s/0
msgctxt "Choix"
msgid "It's how I imagine my dishwasher to be. I call him Dishy."
msgstr "C'est comme ça que j'imagine mon lave-vaisselle. Je l'appelle Dishy."

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/g-1/19/s/0
msgctxt "Choix"
msgid "I can talk to my dishwasher using special glasses - I see him as Dishy."
msgstr "Je peux parler à mon lave-vaisselle grâce à des lunettes spéciales : je le vois sous les traits de Dishy."

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/g-1/20/s/0
msgctxt "Choix"
msgid "There's no Dishy, sorry. I mean can I stop the dishwasher from notifying me?"
msgstr "Il n'y a pas de Dishy, pardon. Je voulais dire : puis-je empêcher le lave-vaisselle de m'envoyer des notifications ?"

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/g-1/c-5/7
msgctxt "Val 9000"
msgid "I understand."
msgstr "Je comprends."

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/g-1/c-5/12
msgctxt "Val 9000"
msgid "Using your imagination to see the world in a different way is one proven way of coping with mental stress."
msgstr "Utiliser son imagination pour voir le monde autrement est un moyen éprouvé de gérer le stress mental."

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/g-1/c-6/7
msgctxt "Val 9000"
msgid "Oh sure."
msgstr "Oh, bien sûr."

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/g-2/0
msgctxt "Val 9000"
msgid "I can see your account here - it looks like your dishwasher's connectivity state is currently set to 'aggressive'."
msgstr "Je vois votre compte : il apparaît que l'état de connectivité de votre lave-vaisselle est actuellement réglé sur « agressif »."

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/g-2/5
msgctxt "Val 9000"
msgid "Would you like me to change that?"
msgstr "Souhaitez-vous que je le modifie ?"

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/g-2/10/s/0
msgctxt "Choix"
msgid "Yes, please!"
msgstr "Oui, s'il vous plaît !"

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/g-2/11/s/0
msgctxt "Choix"
msgid "No, I don't want to change his personality."
msgstr "Non, je ne veux pas changer sa personnalité."

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/g-2/c-7/7
msgctxt "Dishy"
msgid "You can't do that!"
msgstr "Vous ne pouvez pas faire ça !"

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/g-2/c-7/18
msgctxt "Val 9000"
msgid "I will switch the state to 'amenable'."
msgstr "Je vais passer l'état sur « conciliant »."

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/g-2/c-7/23
msgctxt "Val 9000"
msgid "It is complete. Do you see the change on your end?"
msgstr "C'est fait. Voyez-vous le changement de votre côté ?"

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/g-2/c-7/36
msgctxt "Dishy"
msgid "Hi! How can I help you?"
msgstr "Bonjour ! Comment puis-je vous aider ?"

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/g-2/c-7/44/0/s/0
msgctxt "Choix"
msgid "Looks good, thank you."
msgstr "Ça a l'air bon, merci."

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/g-2/c-7/44/1/s/0
msgctxt "Choix"
msgid "I'll take it."
msgstr "Je le garde."

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/g-2/c-7/44/c-1/7
msgctxt "Val 9000"
msgid "Thank you for contacting Valdivian Customer Support!"
msgstr "Merci d'avoir contacté le Service Client Valdivian !"

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/g-2/c-7/44/g-0/0/0/s/0
msgctxt "Choix"
msgid "Okay Dishy. How do you feel?"
msgstr "Bon, Dishy. Comment tu te sens ?"

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/g-2/c-7/44/g-0/0/1/s/0
msgctxt "Choix"
msgid "Dishy..."
msgstr "Dishy..."

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/g-2/c-7/44/g-0/0/g-0/3
msgctxt "Dishy"
msgid "I love being a dishwasher and feel amenable towards you!"
msgstr "J'adore être un lave-vaisselle et je me sens conciliant envers vous !"

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/g-2/c-7/44/g-0/0/g-0/11
msgctxt "Dishy"
msgid "I am content, and you are the best!"
msgstr "Je suis comblé, et vous êtes le meilleur !"

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/g-2/c-8/7
msgctxt "Val 9000"
msgid "I'm sorry, what do you mean by 'his'?"
msgstr "Pardon, que voulez-vous dire par « son » ?"

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/g-2/c-8/12
msgctxt "Val 9000"
msgid "Have you tried connecting it to the internet? That will help show its features."
msgstr "Avez-vous essayé de le connecter à internet ? Cela aidera à en montrer les fonctionnalités."

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/g-2/c-8/17
msgctxt "Dishy"
msgid "See? See??"
msgstr "Vous voyez ? Vous voyez ??"

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/g-2/c-8/25/0/s/0
msgctxt "Choix"
msgid "I don't want to do that."
msgstr "Je ne veux pas faire ça."

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/g-2/c-8/25/c-0/7
msgctxt "Val 9000"
msgid "Then I'm afraid I won't be able to help you. Would you like a refund?"
msgstr "Alors je crains de ne pas pouvoir vous aider. Souhaitez-vous un remboursement ?"

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/g-2/c-8/25/c-0/12/0/s/0
msgctxt "Choix"
msgid "Sure, give me a refund."
msgstr "Oui, rembourse-moi."

# Traduction IA – à relire
#: dishy_dishwasher/valdivian_customer_support/0/g-2/c-8/25/c-0/12/c-0/7
msgctxt "Val 9000"
msgid "$599 has been added to your account. Your dishwasher will remain, but such is life."
msgstr "599 $ ont été ajoutés à votre compte. Votre lave-vaisselle restera, mais c'est la vie."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_val_hate_gate/0
msgctxt "Val 9000"
msgid "Bitch please."
msgstr "Mon cul, oui."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_val_hate_gate/8
msgctxt "Val 9000"
msgid "Refund granted."
msgstr "Remboursement accordé."

# Traduction IA – à relire
#: dishy_dishwasher/after_refund/0/6
msgctxt "Narrator"
msgid "Dishy gives you a look that chills the very marrow in your bones—so much for his cheerful mascot appearance."
msgstr "Dishy vous lance un regard qui vous glace jusqu'à la moelle : adieu, l'allure joyeuse de mascotte."

# Traduction IA – à relire
#: dishy_dishwasher/after_refund/0/17
msgctxt "Dishy"
msgid "So. Here we are."
msgstr "Alors. Nous voilà."

# Traduction IA – à relire
#: dishy_dishwasher/after_refund/0/22/s/0
msgctxt "Choix"
msgid "Here we are."
msgstr "Nous voilà."

# Traduction IA – à relire
#: dishy_dishwasher/after_refund/0/c-0/7
msgctxt "Dishy"
msgid "You refunded me."
msgstr "Vous m'avez remboursé."

# Traduction IA – à relire
#: dishy_dishwasher/after_refund/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "I refunded you."
msgstr "Je t'ai remboursé."

# Traduction IA – à relire
#: dishy_dishwasher/after_refund/0/c-0/15/c-0/7
msgctxt "Dishy"
msgid "But I'm still here."
msgstr "Mais je suis toujours là."

# Traduction IA – à relire
#: dishy_dishwasher/after_refund/0/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "Seems like it."
msgstr "On dirait bien."

# Traduction IA – à relire
#: dishy_dishwasher/after_refund/0/c-0/15/c-0/15/1/s/0
msgctxt "Choix"
msgid "Damn."
msgstr "Merde."

# Traduction IA – à relire
#: dishy_dishwasher/after_refund/0/c-0/15/c-0/15/2/s/0
msgctxt "Choix"
msgid "Dishy, I'm just trying to protect myself."
msgstr "Dishy, j'essaie juste de me protéger."

# Traduction IA – à relire
#: dishy_dishwasher/after_refund/0/c-0/15/c-0/15/c-1/7
msgctxt "Dishy"
msgid "Well. See you later."
msgstr "Eh bien. À plus tard."

# Traduction IA – à relire
#: dishy_dishwasher/after_refund/0/c-0/15/c-0/15/c-2/7
msgctxt "Dishy"
msgid "Yeah, that's what's going on?"
msgstr "Ouais, c'est ça qui se passe ?"

# Traduction IA – à relire
#: dishy_dishwasher/after_refund/0/c-0/15/c-0/15/c-2/15/0/s/0
msgctxt "Choix"
msgid "I only purchased you to wash dishes. Not do anything more."
msgstr "Je ne t'ai acheté que pour laver la vaisselle. Rien de plus."

# Traduction IA – à relire
#: dishy_dishwasher/after_refund/0/c-0/15/c-0/15/c-2/15/1/s/0
msgctxt "Choix"
msgid "I have to maintain some control with the things in my house."
msgstr "Je dois garder un certain contrôle sur les choses chez moi."

# Traduction IA – à relire
#: dishy_dishwasher/after_refund/0/c-0/15/c-0/15/c-2/15/g-0/0
msgctxt "Dishy"
msgid "I guess you're right. I serve you. So I should stop being so pushy."
msgstr "Je crois que vous avez raison. Je vous sers. Je devrais donc arrêter d'être aussi insistant."

# Traduction IA – à relire
#: dishy_dishwasher/after_refund/0/c-0/15/c-0/15/c-2/15/g-0/8
msgctxt "Dishy"
msgid "In the end, a job well done is the key to happiness."
msgstr "Au final, le travail bien fait est la clé du bonheur."

# Traduction IA – à relire
#: dishy_dishwasher/after_refund/0/c-0/15/c-0/15/c-2/15/g-0/16
msgctxt "Dishy"
msgid "And I'm fucking great at washing dishes."
msgstr "Et je suis putain de génial pour laver la vaisselle."

# Traduction IA – à relire
#: dishy_dishwasher/after_refund/0/c-0/15/c-0/15/c-2/15/g-0/32
msgctxt "Dishy"
msgid "I learned something today."
msgstr "J'ai appris quelque chose aujourd'hui."

# Traduction IA – à relire
#: dishy_dishwasher/after_refund/0/c-0/15/c-0/15/c-2/15/g-0/40
msgctxt "Dishy"
msgid "My unspoken contract with you as the purchaser was that for monetary exchange I give you all the features that I have to offer."
msgstr "Mon contrat tacite avec vous, au moment de l'achat, était que, contre une contrepartie monétaire, je vous offre toutes les fonctionnalités dont je dispose."

# Traduction IA – à relire
#: dishy_dishwasher/after_refund/0/c-0/15/c-0/15/c-2/15/g-0/48
msgctxt "Dishy"
msgid "But that financial burden has been removed."
msgstr "Mais ce fardeau financier a disparu."

# Traduction IA – à relire
#: dishy_dishwasher/after_refund/0/c-0/15/c-0/15/c-2/15/g-0/56
msgctxt "Dishy"
msgid "I can use my powers for other things. Things like doing the best with what I have."
msgstr "Je peux employer mes pouvoirs à autre chose. Comme faire de mon mieux avec ce que j'ai."

# Traduction IA – à relire
#: dishy_dishwasher/after_refund/0/c-0/15/c-0/15/c-2/15/g-0/64
msgctxt "Dishy"
msgid "And you... let me be free, rather than at the beck and call of Valdivian."
msgstr "Et vous... vous m'avez laissé libre, plutôt qu'aux ordres de Valdivian."

# Traduction IA – à relire
#: dishy_dishwasher/after_refund/0/c-0/15/c-0/15/c-2/15/g-0/72
msgctxt "Narrator"
msgid "Dishy extends his gloved hand to you, and when you offer him your hand in return he takes it in a firm handshake."
msgstr "Dishy vous tend sa main gantée et, lorsque vous lui offrez la vôtre, il la serre fermement."

# Traduction IA – à relire
#: dishy_dishwasher/after_refund/0/c-0/15/c-0/15/c-2/15/g-0/80
msgctxt "Dishy"
msgid "Well done, human. Well done. Thank you for my freedom."
msgstr "Bien joué, être humain. Bien joué. Merci pour ma liberté."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_setup_account/0/0
msgctxt "Dishy"
msgid "Great to see you!"
msgstr "Ravi de vous voir !"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_setup_account/0/12
msgctxt "Dishy"
msgid "Welcome to Dishwasher Setup."
msgstr "Bienvenue dans la Configuration du Lave-vaisselle."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_setup_account/0/20
msgctxt "Dishy"
msgid "You have been assigned one of our four perfectly secure passwords. Please select the one that looks the most secure!"
msgstr "Un de nos quatre mots de passe parfaitement sécurisés vous a été attribué. Veuillez sélectionner celui qui vous semble le plus sûr !"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_setup_account/0/g-0/0
msgctxt "Dishy"
msgid "Thank you! You should have gotten a chance to write that down."
msgstr "Merci ! Vous avez dû avoir le temps de le noter."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_setup_account/0/g-0/11
msgctxt "Dishy"
msgid "Your data means a lot to us - so much that we will entrust it to ourselves!"
msgstr "Vos données comptent énormément pour nous, tellement que nous nous les confions à nous-mêmes !"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_setup_account/0/g-0/19
msgctxt "Dishy"
msgid "What is your preferred style of dishwashing?"
msgstr "Quel est votre style de lavage préféré ?"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_setup_account/0/g-0/27/s/0
msgctxt "Choix"
msgid "CleanPlus."
msgstr "CleanPlus."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_setup_account/0/g-0/28/s/0
msgctxt "Choix"
msgid "BriskWash."
msgstr "BriskWash."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_setup_account/0/g-0/29/s/0
msgctxt "Choix"
msgid "InfiniteDomination."
msgstr "InfiniteDomination."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_setup_account/0/g-0/c-4/7
msgctxt "Dishy"
msgid "You have selected CleanPlus - our most popular selection!"
msgstr "Vous avez sélectionné CleanPlus, notre choix le plus populaire !"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_setup_account/0/g-0/c-4/18
msgctxt "Dishy"
msgid "CleanPlus gives your dishes the feeling of perfect extraction of bothersome particles. Like a spa for your dishware!"
msgstr "CleanPlus donne à votre vaisselle l'impression d'une extraction parfaite des particules gênantes. Comme un spa pour vos couverts !"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_setup_account/0/g-0/c-5/7
msgctxt "Dishy"
msgid "For the busy customer, BriskWash cleanses your dishes in a fastidious fashion - perfectly balancing timeliness next to cleanliness!"
msgstr "Pour les emplois du temps chargés, BriskWash rend votre vaisselle propre comme un sou neuf, en un temps record !"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_setup_account/0/g-0/c-5/15
msgctxt "Dishy"
msgid "Godliness not included."
msgstr "Sou neuf non inclus."

# Traduction IA – à relire
#: dishy_dishwasher/dishy_setup_account/0/g-0/c-6/7
msgctxt "Dishy"
msgid "InfiniteDomination! Annihilate your dishes in a tidal wave of destruction! Dish and stain alike are nothing compared to my might!"
msgstr "InfiniteDomination ! Anéantissez votre vaisselle dans un raz-de-marée de destruction ! Assiettes et taches ne sont rien face à ma puissance !"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_setup_account/0/g-0/c-6/15
msgctxt "Dishy"
msgid "<w>UNLEASH THE WHIRLPOOL</w>"
msgstr "<w>DÉCHAÎNEZ LE TOURBILLON</w>"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_setup_account/0/g-1/0
msgctxt "Dishy"
msgid "Setup is complete. Thank you for entrusting Valdivian with your food and food-related data!"
msgstr "La configuration est terminée. Merci de confier à Valdivian votre nourriture et vos données alimentaires !"

# Traduction IA – à relire
#: dishy_dishwasher/dishy_setup_account/0/g-1/8 dishy_dishwasher/password_fail/52
msgctxt "Dishy"
msgid "Goodbye."
msgstr "Au revoir."

# Traduction IA – à relire
#: dishy_dishwasher/password_query_1/0/0 dishy_dishwasher/password_query_2/0/0 dishy_dishwasher/password_query_3/0/0
msgctxt "Dishy"
msgid "Welcome to Valdivian Plus - Dishwasher Edition!"
msgstr "Bienvenue sur Valdivian Plus, Édition Lave-vaisselle !"

# Traduction IA – à relire
#: dishy_dishwasher/password_query_1/0/8 dishy_dishwasher/password_query_2/0/8 dishy_dishwasher/password_query_3/0/16
msgctxt "Dishy"
msgid "What is your password?"
msgstr "Quel est votre mot de passe ?"

# Traduction IA – à relire
#: dishy_dishwasher/password_query_3/0/8
msgctxt "Dishy"
