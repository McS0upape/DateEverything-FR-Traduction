msgstr "Tu... tu as fait quoi ?"

# Traduction IA – à relire
#: dasha_desk/the_strip_club/0/g-1/c-8/15
msgctxt "Dasha"
msgid "You stuck your fingers in your nasty pockets..."
msgstr "Tu as plongé les doigts dans tes poches dégoûtantes..."

# Traduction IA – à relire
#: dasha_desk/the_strip_club/0/g-1/c-8/23
msgctxt "Dasha"
