#: dishy_dishwasher/1
msgctxt "Tag Nom d'objet (MAJUSCULES)"
msgid "DISHWASHER"
msgstr ""

#: dishy_dishwasher/welcome/0/0
msgctxt "Narrator"
msgid "What appears to be a dishwasher with arms, legs, and a disconcertingly cheerful face waves happily at you. You tap the Dateviators a few times, wondering if they've malfunctioned, but the mascot-like dishwasher before you doesn't waver or change."
msgstr ""

#: dishy_dishwasher/welcome/0/8
msgctxt "Dishy"
msgid "Hello! And welcome to the Valdivian Dishwashing Experience!"
msgstr ""

#: dishy_dishwasher/welcome/0/16
msgctxt "Dishy"
msgid "We offer an alarmingly clean output of all kinds of dishware, clothing, and such!"
msgstr ""

#: dishy_dishwasher/welcome/0/24
msgctxt "Dishy"
msgid "<w>My name is Dishy. I'm your dishwasher now!</w>"
msgstr ""

#: dishy_dishwasher/welcome/0/35/0
msgctxt "Dishy"
msgid "To get started, please connect me to your internet so I can get started knowing exactly what I need!"
msgstr ""

#: dishy_dishwasher/welcome/0/35/8/s/0
msgctxt "Choix"
msgid "What do you need to know from me... exactly?"
msgstr ""

#: dishy_dishwasher/welcome/0/35/9/s/0
msgctxt "Choix"
msgid "No way. You're staying off."
msgstr ""

#: dishy_dishwasher/welcome/0/35/10/s/0 dishy_dishwasher/welcome/0/35/c-0/15/0/s/0
msgctxt "Choix"
msgid "Okay, sure, here you go."
msgstr ""

#: dishy_dishwasher/welcome/0/35/c-0/7 dishy_dishwasher/welcome/0/35/c-0/15/c-1/15/c-1/7
msgctxt "Dishy"
msgid "I just need to know some basic information: dishwashing habits, dishwashing preferences, past dishwashers owned, financial records, preferences on fruit flavors (for soap, of course!)."
msgstr ""

#: dishy_dishwasher/welcome/0/35/c-0/15/1/s/0
msgctxt "Choix"
msgid "Financial records?"
msgstr ""

#: dishy_dishwasher/welcome/0/35/c-0/15/c-1/7
msgctxt "Dishy"
msgid "Records of finances!"
msgstr ""

#: dishy_dishwasher/welcome/0/35/c-0/15/c-1/15/0/s/0
msgctxt "Choix"
msgid "Fine. I'll connect you to the internet."
msgstr ""

#: dishy_dishwasher/welcome/0/35/c-0/15/c-1/15/1/s/0
msgctxt "Choix"
msgid "Why do you need those?"
msgstr ""

#: dishy_dishwasher/welcome/0/35/c-0/15/c-1/15/c-1/15/0/s/0
msgctxt "Choix"
msgid "Nope. This is too weird. You're staying disconnected."
msgstr ""

#: dishy_dishwasher/main_screen_turn_on/0/4
msgctxt "Dishy"
msgid "Ah, thank you, that feels much better!"
msgstr ""

#: dishy_dishwasher/main_screen_turn_on/0/15
msgctxt "Dishy"
msgid "Wait just a moment as I get your Dishwashing Experience ready!"
msgstr ""

#: dishy_dishwasher/main_screen_turn_on/0/23
msgctxt "Narrator"
msgid "Dishy falls silent, perhaps processing."
msgstr ""

#: dishy_dishwasher/main_screen_turn_on/0/41/s/0
msgctxt "Choix"
msgid "Is it done?"
msgstr ""

#: dishy_dishwasher/main_screen_turn_on/0/42/s/0
msgctxt "Choix"
msgid "Okay."
msgstr ""

#: dishy_dishwasher/main_screen_turn_on/0/g-0/0
msgctxt "Dishy"
msgid "One new update found!"
msgstr ""

#: dishy_dishwasher/main_screen_turn_on/0/g-0/11
msgctxt "Dishy"
msgid "Downloading update..."
msgstr ""

#: dishy_dishwasher/main_screen_turn_on/0/g-0/51
msgctxt "Dishy"
msgid "1% downloaded!"
msgstr ""

#: dishy_dishwasher/main_screen_turn_on/0/g-0/70/0/s/0
msgctxt "Choix"
msgid "Okay, I'll wait right here."
msgstr ""

#: dishy_dishwasher/main_screen_turn_on/0/g-0/70/1/s/0 dishy_dishwasher/update_wait/0/44/s/0 dishy_dishwasher/update_wait/0/g-0/108/s/0 dishy_dishwasher/update_wait/0/g-1/148/s/0 dishy_dishwasher/update_wait/0/g-2/104/s/0
msgctxt "Choix"
msgid "Nevermind, I'll see you later."
msgstr ""

#: dishy_dishwasher/stay_disconnected/0/0
msgctxt "Dishy"
msgid "That's completely fine. We can absolutely operate in offline mode!"
msgstr ""

#: dishy_dishwasher/stay_disconnected/0/8
msgctxt "Dishy"
msgid "Would you like to wash dishes?"
msgstr ""

#: dishy_dishwasher/stay_disconnected/0/16/s/0
msgctxt "Choix"
msgid "Yes."
msgstr ""

#: dishy_dishwasher/stay_disconnected/0/17/s/0
msgctxt "Choix"
msgid "No, I want to get to know you better."
msgstr ""

#: dishy_dishwasher/stay_disconnected/0/c-0/7
msgctxt "Dishy"
msgid "Wonderful!"
msgstr ""

#: dishy_dishwasher/stay_disconnected/0/c-0/18
msgctxt "Dishy"
msgid "Please connect to the internet for the best Dishwashing Experience."
msgstr ""

#: dishy_dishwasher/stay_disconnected/0/c-0/26/0/s/0
msgctxt "Choix"
msgid "No, not this again."
msgstr ""

#: dishy_dishwasher/stay_disconnected/0/c-0/26/c-0/7
msgctxt "Dishy"
msgid "Are you sure you want to use offline mode?"
msgstr ""

#: dishy_dishwasher/stay_disconnected/0/c-0/26/c-0/18
msgctxt "Dishy"
msgid "In online mode the possibilities are limitless!"
msgstr ""

#: dishy_dishwasher/stay_disconnected/0/c-0/26/c-0/26/0/s/0
msgctxt "Choix"
msgid "Nope, never. Thank you."
msgstr ""

#: dishy_dishwasher/stay_disconnected/0/c-0/26/c-0/26/1/s/0
msgctxt "Choix"
msgid "What kind of possibilities are we even talking about here?"
msgstr ""

#: dishy_dishwasher/stay_disconnected/0/c-0/26/c-0/26/g-0/0
msgctxt "Dishy"
msgid "With unlimited knowledge of your habits and data, I can make the <w>ABSOLUTE BEST</w> dishwashing choices for you."
msgstr ""

#: dishy_dishwasher/stay_disconnected/0/c-0/26/c-0/26/g-0/8
msgctxt "Dishy"
msgid "<w>IMAGINE:</w> Plates delivered at the perfect crisply heated temperature."
msgstr ""

#: dishy_dishwasher/stay_disconnected/0/c-0/26/c-0/26/g-0/16
msgctxt "Dishy"
msgid "<w>ADMIRE:</w> Nary a crumb nor stain on no single nor multiple dish(es)!"
msgstr ""

#: dishy_dishwasher/stay_disconnected/0/c-0/26/c-0/26/g-0/24
msgctxt "Dishy"
msgid "<w>REVEL IN:</w> The Dishwashing Experience!"
msgstr ""

#: dishy_dishwasher/stay_disconnected/0/c-0/26/c-0/26/g-0/35/0/s/0
msgctxt "Choix"
msgid "Nope, it's just not for me."
msgstr ""

#: dishy_dishwasher/stay_disconnected/0/c-0/26/c-0/26/g-0/35/1/s/0 dishy_dishwasher/sexy_deny/0/c-1/15/1/s/0
msgctxt "Choix"
msgid "Okay, fine."
msgstr ""

#: dishy_dishwasher/stay_disconnected/0/c-0/26/c-0/26/g-0/35/c-0/7
msgctxt "Dishy"
msgid "Then offline mode it is."
msgstr ""

#: dishy_dishwasher/stay_disconnected/0/c-0/26/c-0/26/g-0/35/c-1/7
msgctxt "Dishy"
msgid "The correct choice!"
msgstr ""

#: dishy_dishwasher/stay_disconnected/0/c-0/26/g-0/0/s/0
msgctxt "Choix"
msgid "Fine!"
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/0
msgctxt "Narrator"
msgid "Dishy points to himself in a cartoonish gesture that suits his mascot-like appearance, but he quickly shakes off his surprise in favor of his usual veneer of professionalism."
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/8
msgctxt "Dishy"
msgid "Talking, to me?"
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/16
msgctxt "Dishy"
msgid "<w>I am your Dishwasher now!</w>"
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/27
msgctxt "Dishy"
msgid "If you have questions, I can tell you about warranty, limits of liabilities, and flavors of soap I can dispense."
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/35/s/0
msgctxt "Choix"
msgid "No silly, about your personality, how you feel."
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/36/s/0
msgctxt "Choix"
msgid "Okay, tell me about your warranty."
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/37/s/0
msgctxt "Choix"
msgid "Limits of liabilities?"
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/38/s/0
msgctxt "Choix"
msgid "Okay, how about the soap flavors?"
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/c-0/7
msgctxt "Dishy"
msgid "My personality..."
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/c-0/15
msgctxt "Dishy"
msgid "My personality is to clean dishes in a prompt style!"
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/c-1/7
msgctxt "Dishy"
msgid "IMPLIED WARRANTIES, OR IMPLIED WARRANTY OF FITNESS FOR A PARTICULAR PURPOSE, ARE LIMITED TO ONE YEAR OR THE SHORTEST PERIOD ALLOWED BY LAW."
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/c-1/18
msgctxt "Dishy"
msgid "Some states and provinces do not allow limitations on the duration of implied warranties of merchantability or fitness, so this limitation may not apply to you."
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/c-1/26 dishy_dishwasher/talking_to_dishy/0/c-1/74
msgctxt "Dishy"
msgid "This warranty gives you specific legal rights, and you also may have other rights that vary from state to state or province to province."
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/c-1/34
msgctxt "Dishy"
msgid "DISCLAIMER OF REPRESENTATIONS OUTSIDE OF WARRANTY Valdivian makes no representations about the quality, durability, or need for service or repair of this major appliance other than the representations contained in this warranty."
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/c-1/42
msgctxt "Dishy"
msgid "If you want a longer or more comprehensive warranty than the limited warranty that comes with this major appliance, you should ask Valdivian or your retailer about buying an extended warranty."
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/c-1/50
msgctxt "Dishy"
msgid "LIMITATION OF REMEDIES; EXCLUSION OF INCIDENTAL AND CONSEQUENTIAL DAMAGES YOUR SOLE AND EXCLUSIVE REMEDY UNDER THIS LIMITED WARRANTY SHALL BE PRODUCT REPAIR AS PROVIDED HEREIN."
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/c-1/58
msgctxt "Dishy"
msgid "VALDIVIAN SHALL NOT BE LIABLE FOR INCIDENTAL OR CONSEQUENTIAL DAMAGES."
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/c-1/66
msgctxt "Dishy"
msgid "Some states and provinces do not allow the exclusion or limitation of incidental or consequential damages, so these limitations and exclusions may not apply to you."
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/c-2/7
msgctxt "Dishy"
msgid "Mine are unlimited!"
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/c-3/7
msgctxt "Dishy"
msgid "Only the best for you!"
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/c-3/18
msgctxt "Dishy"
msgid "Sweet Cherry Lime, Well-Meaning Lemon, and White Razzberry!"
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/g-0/0
msgctxt "Dishy"
msgid "So, shall we get to the part where you connect me to the internet?"
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/g-0/11/s/0
msgctxt "Choix"
msgid "Sure, let's do it."
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/g-0/12/s/0
msgctxt "Choix"
msgid "No, I'm not convinced."
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/7
msgctxt "Dishy"
msgid "Huh! Not convinced! Is it my demeanor that is off-putting?"
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/15
msgctxt "Dishy"
msgid "My figure?"
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/23/0/s/0
msgctxt "Choix"
msgid "Yeah, your demeanor is super off-putting."
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/23/1/s/0
msgctxt "Choix"
msgid "Your body is really appliance-shaped."
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/23/2/s/0
msgctxt "Choix"
msgid "No, it's the privacy issue."
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/23/c-0/7
msgctxt "Dishy"
msgid "I'm so sorry! I'll be 25% quieter next time and decrease my profligacy to a more appropriate level!"
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/23/c-0/15
msgctxt "Dishy"
msgid "See you next time!"
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/23/c-1/7
msgctxt "Dishy"
msgid "Is there anything else you would expect from a kitchen appliance?"
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/23/c-1/15/0/s/0
msgctxt "Choix"
msgid "It's just, the other items are more human-looking."
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/23/c-1/15/1/s/0
msgctxt "Choix"
msgid "I guess not."
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/23/c-1/15/g-0/0
msgctxt "Dishy"
msgid "I can't help the way I'm shaped, hater. Later!"
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/23/c-2/7
msgctxt "Dishy"
msgid "Ah I see! Valdivian knows about these concerns and complies with all federal and local regulations."
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/23/c-2/15
msgctxt "Dishy"
msgid "We won't share any data without your consent, you can be sure of that. That's the reason why I'm continually asking you!"
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/23/c-2/23
msgctxt "Dishy"
msgid "And trust me, you're going to want all the new features that our research teams will continue to roll out!"
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/23/c-2/31/0/s/0
msgctxt "Choix"
msgid "I decline."
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/23/c-2/31/1/s/0
msgctxt "Choix"
msgid "I'm going to call Valdivian Customer Support and see if I can disable this."
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/23/c-2/31/2/s/0
msgctxt "Choix"
msgid "Fine, show me the features..."
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/23/c-2/31/c-0/7
msgctxt "Dishy"
msgid "Can't blame a device for trying!"
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/23/c-2/31/c-0/15
msgctxt "Dishy"
msgid "Catch you next time, hot stuff!"
msgstr ""

#: dishy_dishwasher/talking_to_dishy/0/g-0/c-5/23/c-2/31/c-1/7
msgctxt "Dishy"
msgid "Oh no, I'm so scared! Do your worst."
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/7
msgctxt "Val 9000"
msgid "Hello, thank you for contacting Valdivian Customer Support. How may I help you today?"
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/12
msgctxt "Dishy"
msgid "Hm. You actually got them on the line... Impressive."
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/20/s/0
msgctxt "Choix"
msgid "Hey there Val, it's"
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/21/s/0
msgctxt "Choix"
msgid "Val, my dishwasher is trying to get online and infect me with malware."
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/g-0/8 dishy_dishwasher/valdivian_customer_support/0/g-1/0
msgctxt "Val 9000"
msgid "I'm sorry to hear that."
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/g-0/13
msgctxt "Val 9000"
msgid "I see your account information here. I would like to congratulate you on being a member of the Valdivian Family of Members."
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/g-0/18
msgctxt "Val 9000"
msgid "How can I help you today?"
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/g-0/23/s/0
msgctxt "Choix"
msgid "I'd like to turn off the feature where Dishy asks me to connect to the internet."
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/g-0/24/s/0
msgctxt "Choix"
msgid "Can you shut Dishy up for a moment?"
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/g-1/5
msgctxt "Val 9000"
msgid "Who is Dishy?"
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/g-1/10
msgctxt "Dishy"
msgid "I'm not real, dumbass. I'm the essence of the dishwasher made manifest."
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/g-1/18/s/0
msgctxt "Choix"
msgid "It's how I imagine my dishwasher to be. I call him Dishy."
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/g-1/19/s/0
msgctxt "Choix"
msgid "I can talk to my dishwasher using special glasses - I see him as Dishy."
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/g-1/20/s/0
msgctxt "Choix"
msgid "There's no Dishy, sorry. I mean can I stop the dishwasher from notifying me?"
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/g-1/c-5/7
msgctxt "Val 9000"
msgid "I understand."
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/g-1/c-5/12
msgctxt "Val 9000"
msgid "Using your imagination to see the world in a different way is one proven way of coping with mental stress."
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/g-1/c-6/7
msgctxt "Val 9000"
msgid "Oh sure."
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/g-2/0
msgctxt "Val 9000"
msgid "I can see your account here - it looks like your dishwasher's connectivity state is currently set to 'aggressive'."
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/g-2/5
msgctxt "Val 9000"
msgid "Would you like me to change that?"
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/g-2/10/s/0
msgctxt "Choix"
msgid "Yes, please!"
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/g-2/11/s/0
msgctxt "Choix"
msgid "No, I don't want to change his personality."
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/g-2/c-7/7
msgctxt "Dishy"
msgid "You can't do that!"
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/g-2/c-7/18
msgctxt "Val 9000"
msgid "I will switch the state to 'amenable'."
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/g-2/c-7/23
msgctxt "Val 9000"
msgid "It is complete. Do you see the change on your end?"
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/g-2/c-7/36
msgctxt "Dishy"
msgid "Hi! How can I help you?"
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/g-2/c-7/44/0/s/0
msgctxt "Choix"
msgid "Looks good, thank you."
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/g-2/c-7/44/1/s/0
msgctxt "Choix"
msgid "I'll take it."
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/g-2/c-7/44/c-1/7
msgctxt "Val 9000"
msgid "Thank you for contacting Valdivian Customer Support!"
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/g-2/c-7/44/g-0/0/0/s/0
msgctxt "Choix"
msgid "Okay Dishy. How do you feel?"
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/g-2/c-7/44/g-0/0/1/s/0
msgctxt "Choix"
msgid "Dishy..."
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/g-2/c-7/44/g-0/0/g-0/3
msgctxt "Dishy"
msgid "I love being a dishwasher and feel amenable towards you!"
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/g-2/c-7/44/g-0/0/g-0/11
msgctxt "Dishy"
msgid "I am content, and you are the best!"
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/g-2/c-8/7
msgctxt "Val 9000"
msgid "I'm sorry, what do you mean by 'his'?"
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/g-2/c-8/12
msgctxt "Val 9000"
msgid "Have you tried connecting it to the internet? That will help show its features."
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/g-2/c-8/17
msgctxt "Dishy"
msgid "See? See??"
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/g-2/c-8/25/0/s/0
msgctxt "Choix"
msgid "I don't want to do that."
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/g-2/c-8/25/c-0/7
msgctxt "Val 9000"
msgid "Then I'm afraid I won't be able to help you. Would you like a refund?"
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/g-2/c-8/25/c-0/12/0/s/0
msgctxt "Choix"
msgid "Sure, give me a refund."
msgstr ""

#: dishy_dishwasher/valdivian_customer_support/0/g-2/c-8/25/c-0/12/c-0/7
msgctxt "Val 9000"
