#: penelope_stationery/penelope_hate_return/0/24/s/0
msgctxt "Choix"
msgid "Basically."
msgstr ""

#: penelope_stationery/penelope_hate_return/0/25/s/0
msgctxt "Choix"
msgid "Come on, Penelope... we should be friends. (USE EMPATHY CANDY)"
