msgstr ""

#: tim_clock/timmy_hate_return/0/11/s/0
msgctxt "Choix"
msgid "Nothing, weirdo. Leave me alone."
msgstr ""

#: tim_clock/timmy_hate_return/0/12/s/0
msgctxt "Choix"
msgid "I'm sorry, Timmy... can we just be friends please? (USE SMARTS CANDY)"
