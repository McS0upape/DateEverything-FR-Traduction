#: mikey_micro/mikey_start/0/g-2/8
msgctxt "Mikey"
msgid "You get 5 <w>Money</w> per day! Save up for <w>big pulls</w>!"
msgstr ""

#: mikey_micro/mikey_start/0/g-2/16/s/0
msgctxt "Choix"
msgid "How do I get money if I don't have a job?"
msgstr ""

#: mikey_micro/mikey_start/0/g-2/17/s/0 mikey_micro/boots_fuse/0/40/s/0
msgctxt "Choix"
msgid "Awesome!"
msgstr ""

#: mikey_micro/mikey_start/0/g-2/c-13/7
msgctxt "Mikey"
msgid "Ah you're asking those <w>thinker</w> type questions!"
msgstr ""

#: mikey_micro/mikey_start/0/g-2/c-13/15
msgctxt "Mikey"
msgid "I love it - and I always have a <w>great explanation</w>!"
