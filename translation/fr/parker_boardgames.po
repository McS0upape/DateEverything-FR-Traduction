# Traduction IA – à relire
#: parker_boardgames/1
msgctxt "Tag Nom d'objet (MAJUSCULES)"
msgid "BOARD GAMES"
msgstr "JEUX DE SOCIÉTÉ"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/6
msgctxt "Narrator"
msgid "A colorfully-dressed board gamer beams at you, but even though his expression is ostensibly friendly, something about his energy is a little off."
msgstr "Un joueur de société à la tenue bariolée vous sourit jusqu'aux oreilles, mais malgré son air ostensiblement amical, quelque chose dans son énergie cloche un peu."

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/14
msgctxt "Narrator"
msgid "His smile is a little too wide, his stare a little too intense... you feel rather like a mouse that's just been spotted by a bored housecat."
msgstr "Son sourire est un peu trop large, son regard un peu trop intense... vous vous sentez comme une souris que vient de repérer un chat de maison qui s'ennuie."

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/19
msgctxt "Parker"
msgid "Why a gee gosh golly and a hidey-ho!"
msgstr "Mais dites donc, ça alors, et un coucou-hou !"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/27
msgctxt "Parker"
msgid "I'm Parker, the Board Games... and away we go!"
msgstr "Moi c'est Parker, les Jeux de Société... et c'est parti, mon kiki !"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/38/s/0
msgctxt "Choix"
msgid "Hi Parker!"
msgstr "Salut Parker !"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/39/s/0
msgctxt "Choix"
msgid "You seem to be... a lot."
msgstr "Tu as l'air d'être... beaucoup."

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/c-0/7
msgctxt "Parker"
msgid "Hi there! I do love meeting new people to play with."
msgstr "Salut, toi ! J'adore rencontrer de nouvelles personnes avec qui jouer."

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/c-0/15
msgctxt "Parker"
msgid "And I do need new people to play with these days. I'm awful lonely up here in the big ol' attic."
msgstr "Et ces temps-ci, j'ai bien besoin de nouveaux partenaires de jeu. Je me sens affreusement seul ici, dans le grand vieux grenier."

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/c-0/23/b/1
msgctxt "Parker"
msgid "But you seem like a nice sorta fella already!"
msgstr "Mais tu as déjà l'air d'un gars sympa !"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/c-0/24/b/1
msgctxt "Parker"
msgid "But you seem like a nice sorta gal already!"
msgstr "Mais tu as déjà l'air d'une fille sympa !"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/c-0/25/b/1
msgctxt "Parker"
msgid "But you seem like a nice sorta someone already!"
msgstr "Mais tu as déjà l'air de quelqu'un de sympa !"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/c-0/28
msgctxt "Parker"
msgid "Maybe you could be my next relationship..."
msgstr "Peut-être que tu pourrais être ma prochaine relation..."

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/c-0/36
msgctxt "Parker"
msgid "Would you like that?"
msgstr "Ça te plairait ?"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/c-0/44/0/s/0
msgctxt "Choix"
msgid "I would!"
msgstr "Oui !"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/c-0/44/1/s/0
msgctxt "Choix"
msgid "Not really."
msgstr "Pas vraiment."

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/c-0/44/c-0/7
msgctxt "Parker"
msgid "Oh boy! If only it were up to me..."
msgstr "Oh là là ! Si seulement ça ne dépendait que de moi..."

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/c-0/44/c-1/7
msgctxt "Parker"
msgid "Intriguing! If only it were up to me though..."
msgstr "Intrigant ! Si seulement ça ne dépendait que de moi, pourtant..."

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/c-0/44/g-0/0
msgctxt "Parker"
msgid "Y'see, my whole deal with relationships has to do with Rules."
msgstr "Vois-tu, tout mon truc avec les relations, c'est une histoire de Règles."

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/c-0/44/g-0/8
msgctxt "Parker"
msgid "I <i>love</i> Rules."
msgstr "J'<i>adore</i> les Règles."

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/c-1/7
msgctxt "Parker"
msgid "Oh boy I certainly am. I got all sortsa proclivities."
msgstr "Ah ça, oui ! J'ai toutes sortes de penchants."

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/c-1/15
msgctxt "Parker"
msgid "Wanna hear my favorite thing?"
msgstr "Tu veux savoir ma chose préférée ?"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/c-1/23/0/s/0
msgctxt "Choix"
msgid "Is it board games?"
msgstr "Ce sont les jeux de société ?"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/c-1/23/1/s/0
msgctxt "Choix"
msgid "Is it being annoying?"
msgstr "C'est d'être casse-pieds ?"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/c-1/23/2/s/0
msgctxt "Choix"
msgid "Is it rules?"
msgstr "Ce sont les règles ?"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/c-1/23/c-0/7
msgctxt "Parker"
msgid "Nope! You'd think but then I'd be awful full of myself wouldn't I."
msgstr "Non ! On pourrait le croire, mais alors je serais bien imbu de moi-même, non ?"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/c-1/23/c-1/7
msgctxt "Parker"
msgid "Nope. That's just my personality!"
msgstr "Non. Ça, c'est juste ma personnalité !"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/c-1/23/c-2/7
msgctxt "Parker"
msgid "You guessed it! That was a fun game!"
msgstr "Bien vu ! C'était une partie amusante !"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/g-0/0
msgctxt "Parker"
msgid "My favorite thing is Rules!"
msgstr "Ma chose préférée, ce sont les Règles !"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/g-0/8/0
msgctxt "Parker"
msgid "If you want any sort of relationship with me, good or bad, we have to go through the Rules!"
msgstr "Si tu veux une relation avec moi, bonne ou mauvaise, il faut passer par les Règles !"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/g-0/8/8
msgctxt "Parker"
msgid "Wanna hear 'em? As they pertain to me?"
msgstr "Tu veux les entendre ? Telles qu'elles me concernent ?"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/g-0/8/16
msgctxt "Parker"
msgid "As they pertain to my whole deal and how this is gonna turn out?"
msgstr "Telles qu'elles concernent tout mon truc et la façon dont ça va tourner ?"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/g-0/8/24/s/0
msgctxt "Choix"
msgid "Sure, why not?"
msgstr "Bien sûr, pourquoi pas ?"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/g-0/8/25/s/0
msgctxt "Choix"
msgid "Okay weirdo."
msgstr "D'accord, bizarroïde."

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/g-0/8/26/s/0 parker_boardgames/parker_big_roll_return/0/22/s/0
msgctxt "Choix"
msgid "No."
msgstr "Non."

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/g-0/8/c-2/7
msgctxt "Parker"
msgid "Glorious!"
msgstr "Glorieux !"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/g-0/8/c-3/7
msgctxt "Parker"
msgid "Ha ha I <i>am</i> a weirdo!"
msgstr "Ha ha, c'est vrai que je <i>suis</i> un bizarroïde !"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/g-0/8/c-4/11
msgctxt "Parker"
msgid "No?"
msgstr "Non ?"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/g-0/8/c-4/19
msgctxt "Parker"
msgid "Living dangerously, eh?"
msgstr "On aime vivre dangereusement, hein ?"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/g-0/8/c-4/27
msgctxt "Parker"
msgid "You'll still have to abide by them, even though you don't know what they are."
msgstr "Tu devras quand même les respecter, même si tu ne sais pas lesquelles elles sont."

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/g-0/8/c-4/35
msgctxt "Parker"
msgid "Okay then... I guess I'll just see you next time and we'll begin!"
msgstr "Bon, eh bien... je suppose que je te verrai la prochaine fois et qu'on commencera !"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/g-1/0
msgctxt "Parker"
msgid "In order to achieve a relationship with me, you must play these board games three!"
msgstr "Pour nouer une idylle avec moi, à trois jeux tu joueras, c'est la loi !"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/g-1/8
msgctxt "Parker"
msgid "If you beat me or unseat me, more chances for love will greet thee!"
msgstr "Bats-moi ou détrône-moi, et l'amour s'approchera de toi !"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/g-1/16
msgctxt "Parker"
msgid "At the end I roll a die to achieve a status - this in the end will be our dating apparatus!"
msgstr "À la fin, je lance un dé, et notre statut sera décidé !"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/g-1/24/s/0
msgctxt "Choix"
msgid "So... our relationship is just up to chance?"
msgstr "Donc... notre relation dépend juste du hasard ?"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/g-1/c-5/7
msgctxt "Parker"
msgid "Ultimately yes, but your actions during each game can change the weight of the die!"
msgstr "En fin de compte, oui, mais tes actions durant chaque partie peuvent changer le poids du dé !"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/g-1/c-5/15
msgctxt "Parker"
msgid "The more you win, the more chances to love me!"
msgstr "Plus tu gagnes, plus tu as de chances de m'aimer !"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/g-1/c-5/26/0/s/0
msgctxt "Choix"
msgid "What if I want you to hate me?"
msgstr "Et si je veux que tu me détestes ?"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/g-1/c-5/26/1/s/0
msgctxt "Choix"
msgid "Okay... that seems really hard to wrap my head around."
msgstr "D'accord... ça a l'air vraiment dur à comprendre."

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/g-1/c-5/26/2/s/0
msgctxt "Choix"
msgid "Interesting - I like a challenge!"
msgstr "Intéressant, j'aime les défis !"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/g-1/c-5/26/c-0/7
msgctxt "Parker"
msgid "Then lose, silly!"
msgstr "Alors perds, voyons !"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/g-1/c-5/26/c-1/7
msgctxt "Parker"
msgid "Don't worry, I'll do all the thinking for us."
msgstr "Ne t'en fais pas, je réfléchirai pour nous deux."

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/g-1/c-5/26/c-2/7
msgctxt "Parker"
msgid "Tee hee! I'm falling in love with you!"
msgstr "Hihi ! Je tombe amoureux de toi !"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/g-1/c-5/26/c-2/21
msgctxt "Parker"
msgid "Just kidding - only the final roll will tell me how I feel about you."
msgstr "Je plaisante : seul le lancer final me dira ce que je ressens pour toi."

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/g-2/0
msgctxt "Parker"
msgid "Meet me here next time for our first game... Sandyland! Woohooohooo!!"
msgstr "Retrouve-moi ici la prochaine fois pour notre première partie... Sandyland ! Woohoohoo !!"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/g-2/8/s/0
msgctxt "Choix"
msgid "I'm scared."
msgstr "J'ai peur."

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/g-2/9/s/0
msgctxt "Choix"
msgid "Okay - can't wait!"
msgstr "D'accord, j'ai hâte !"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/g-2/10/s/0
msgctxt "Choix"
msgid "Sounds like a kids' game."
msgstr "Ça ressemble à un jeu pour enfants."

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/g-2/c-6/7
msgctxt "Parker"
msgid "Oh don't be scared. I only bite a little."
msgstr "Oh, n'aie pas peur. Je ne mords qu'un tout petit peu."

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/g-2/c-6/31
msgctxt "Parker"
msgid "I love <i>biting</i> things very much!"
msgstr "J'adore <i>mordre</i> les choses !"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/g-2/c-6/42
msgctxt "Narrator"
msgid "Parker bares his teeth at you, clacking them together in a horrifying way. He's joking... probably... but it is unnerving."
msgstr "Parker vous montre les dents et les fait claquer d'une manière effroyable. Il plaisante... probablement... mais c'est déstabilisant."

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/g-2/c-6/50
msgctxt "Parker"
msgid "<w>chomp chomp chomp</w>"
msgstr "<w>croc croc croc</w>"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/g-2/c-7/7
msgctxt "Parker"
msgid "Wowee!"
msgstr "Ça alors !"

# Traduction IA – à relire
#: parker_boardgames/parker_intro/0/g-2/c-8/7
msgctxt "Parker"
msgid "Well then you'll have <i>no</i> problem beating me you big smart human you."
msgstr "Alors tu n'auras <i>aucun</i> mal à me battre, grand malin d'humain que tu es."

# Traduction IA – à relire
#: parker_boardgames/parker_sandyrules_skipped/0/0
msgctxt "Parker"
msgid "You skipped the rules before, do you want to again?"
msgstr "Tu as sauté les règles tout à l'heure, tu veux les sauter encore ?"

# Traduction IA – à relire
#: parker_boardgames/parker_sandyrules_skipped/0/8/s/0
msgctxt "Choix"
msgid "Yeah, let's just play!"
msgstr "Ouais, jouons !"

# Traduction IA – à relire
#: parker_boardgames/parker_sandyrules_skipped/0/9/s/0
msgctxt "Choix"
msgid "No, how do you play?"
msgstr "Non, comment on joue ?"

# Traduction IA – à relire
#: parker_boardgames/parker_sandyrules_skipped/0/c-0/7 parker_boardgames/parker_sandyland/0/c-0/7
msgctxt "Parker"
msgid "Onward, to the sunny shores!"
msgstr "En avant, vers les rivages ensoleillés !"

# Traduction IA – à relire
#: parker_boardgames/parker_sandyrules_skipped/0/c-1/7 parker_boardgames/parker_sandyland/0/c-1/7
msgctxt "Parker"
msgid "Both of our pieces are at the starting spot - home!"
msgstr "Nos deux pions sont sur la case de départ : la maison !"

# Traduction IA – à relire
#: parker_boardgames/parker_sandyrules_skipped/0/c-1/15 parker_boardgames/parker_sandyland/0/c-1/15
msgctxt "Parker"
msgid "There are 12 spaces in between here and the Sandy Kingdom, some with different rules!"
msgstr "Il y a 12 cases entre ici et le Royaume de Sable, certaines avec des règles particulières !"

# Traduction IA – à relire
#: parker_boardgames/parker_sandyrules_skipped/0/c-1/23 parker_boardgames/parker_sandyland/0/c-1/23
msgctxt "Parker"
msgid "Each turn, we both spin a spinner to determine how far we go."
msgstr "À chaque tour, on fait tourner chacun une roulette pour savoir jusqu'où on avance."

# Traduction IA – à relire
#: parker_boardgames/parker_sandyrules_skipped/0/c-1/31 parker_boardgames/parker_sandyland/0/c-1/31
msgctxt "Parker"
msgid "Then, after landing, we follow the outcome!"
msgstr "Puis, une fois arrivés, on applique le résultat !"

# Traduction IA – à relire
#: parker_boardgames/parker_sandyrules_skipped/0/c-1/39 parker_boardgames/parker_sandyland/0/c-1/39
msgctxt "Parker"
msgid "First one to the Sandy Shores wins the game!"
msgstr "Le premier à atteindre les Rivages de Sable gagne la partie !"

# Traduction IA – à relire
#: parker_boardgames/parker_sandyrules_skipped/0/c-1/47 parker_boardgames/parker_sandyland/0/c-1/47
msgctxt "Parker"
msgid "Now, what color would you like to be?"
msgstr "Maintenant, quelle couleur veux-tu être ?"

# Traduction IA – à relire
#: parker_boardgames/parker_sandyrules_skipped/0/c-1/55/0/s/0 parker_boardgames/parker_sandyland/0/c-1/55/0/s/0
msgctxt "Choix"
msgid "Blue"
msgstr "Bleu"

# Traduction IA – à relire
#: parker_boardgames/parker_sandyrules_skipped/0/c-1/55/1/s/0 parker_boardgames/parker_sandyland/0/c-1/55/1/s/0
msgctxt "Choix"
msgid "Red"
msgstr "Rouge"

# Traduction IA – à relire
#: parker_boardgames/parker_sandyrules_skipped/0/c-1/55/2/s/0 parker_boardgames/parker_sandyland/0/c-1/55/2/s/0
msgctxt "Choix"
msgid "Green"
msgstr "Vert"

# Traduction IA – à relire
#: parker_boardgames/parker_sandyrules_skipped/0/c-1/55/3/s/0 parker_boardgames/parker_sandyland/0/c-1/55/3/s/0
msgctxt "Choix"
msgid "Large, eerie, floating, colorless cube"
msgstr "Cube immense, sinistre, flottant et incolore"

# Traduction IA – à relire
#: parker_boardgames/parker_sandyrules_skipped/0/c-1/55/c-0/7 parker_boardgames/parker_sandyland/0/c-1/55/c-0/7
msgctxt "Parker"
msgid "Blue... Honestly I don't understand why but there you go!"
msgstr "Bleu... Franchement, je ne comprends pas pourquoi, mais voilà !"

# Traduction IA – à relire
#: parker_boardgames/parker_sandyrules_skipped/0/c-1/55/c-1/7 parker_boardgames/parker_sandyland/0/c-1/55/c-1/7
msgctxt "Parker"
msgid "Haha! Hahahahahaha! Okay sure!"
msgstr "Ha ha ! Hahahahaha ! D'accord, très bien !"

# Traduction IA – à relire
#: parker_boardgames/parker_sandyrules_skipped/0/c-1/55/c-2/7 parker_boardgames/parker_sandyland/0/c-1/55/c-2/7
msgctxt "Parker"
msgid "Interesting choice!"
msgstr "Choix intéressant !"

# Traduction IA – à relire
#: parker_boardgames/parker_sandyrules_skipped/0/c-1/55/c-3/7 parker_boardgames/parker_sandyland/0/c-1/55/c-3/7
msgctxt "Parker"
msgid "Oh, that one. Hm. Okay!"
msgstr "Ah, celui-là. Hm. D'accord !"

# Traduction IA – à relire
#: parker_boardgames/parker_sandyrules_skipped/0/g-0/0 parker_boardgames/parker_sandyland/0/g-0/0
msgctxt "Parker"
msgid "The pieces are all set up. I'll be the banker and the rule-tender."
msgstr "Les pions sont en place. Je serai le banquier et le gardien des règles."

# Traduction IA – à relire
#: parker_boardgames/parker_sandyrules_skipped/0/g-0/8 parker_boardgames/parker_sandyland/0/g-0/8
msgctxt "Parker"
msgid "We are both at home! Shall we race each other to the beach?"
msgstr "On est tous les deux à la maison ! On fait la course jusqu'à la plage ?"

# Traduction IA – à relire
#: parker_boardgames/parker_sandyland/0/6
msgctxt "Parker"
msgid "Ah hello! And welcome... to Sandyland!"
msgstr "Ah, bonjour ! Et bienvenue... à Sandyland !"

# Traduction IA – à relire
#: parker_boardgames/parker_sandyland/0/14
msgctxt "Parker"
msgid "A magical beach themed board game awaits us - as we venture through the Traffic to the Parking Lot to the Sandy Kingdom where beach-goers frolic among ice cream and sunscreen!"
msgstr "Un jeu de société magique sur le thème de la plage nous attend : on traversera les Embouteillages, puis le Parking, jusqu'au Royaume de Sable où les baigneurs batifolent parmi les glaces et la crème solaire !"

# Traduction IA – à relire
#: parker_boardgames/parker_sandyland/0/25 parker_boardgames/parker_eurogame/0/30
msgctxt "Parker"
msgid "Would you like to hear the rules?"
msgstr "Tu veux entendre les règles ?"

# Traduction IA – à relire
#: parker_boardgames/parker_sandyland/0/33/s/0
msgctxt "Choix"
msgid "Nah, let's play!"
msgstr "Bof, jouons !"

# Traduction IA – à relire
#: parker_boardgames/parker_sandyland/0/34/s/0
msgctxt "Choix"
msgid "Yes, how do you play?"
msgstr "Oui, comment on joue ?"

# Traduction IA – à relire
#: parker_boardgames/beach_game_first/0/0 parker_boardgames/beach_game_return/0/0
msgctxt "Parker"
msgid "It's your turn! What will you do?"
msgstr "C'est à toi ! Que vas-tu faire ?"

# Traduction IA – à relire
#: parker_boardgames/beach_game_first/0/8/s/0 parker_boardgames/beach_game_return/0/8/s/0 parker_boardgames/beach_game_return_swimsuit/0/8/s/0
msgctxt "Choix"
msgid "Spin the spinner!"
msgstr "Faire tourner la roulette !"

# Traduction IA – à relire
#: parker_boardgames/beach_game_first/0/9/s/0
msgctxt "Choix"
msgid "Before we start, let's get in the mood for a beachy day and take off our clothes..."
msgstr "Avant de commencer, mettons-nous dans l'ambiance d'une journée à la plage et enlevons nos vêtements..."

# Traduction IA – à relire
#: parker_boardgames/beach_game_return/0/9/s/0 parker_boardgames/beach_game_return_swimsuit/0/9/s/0
msgctxt "Choix"
msgid "<i>Sneeze loudly, knocking the pieces askew.</i>"
msgstr "<i>Éternuer bruyamment en bousculant les pions.</i>"

# Traduction IA – à relire
#: parker_boardgames/beach_game_return/0/10/s/0
msgctxt "Choix"
msgid "Actually, let's get in the mood for a beachy day and take off our clothes..."
msgstr "En fait, mettons-nous dans l'ambiance d'une journée à la plage et enlevons nos vêtements..."

# Traduction IA – à relire
#: parker_boardgames/beach_game_return/0/c-1/7 parker_boardgames/beach_game_return_swimsuit/0/c-1/7
msgctxt "Narrator"
msgid "You do your best loud, fake sneeze, lurching forward and crashing into the board. You successfully overturn the pieces, sending them rolling in opposite directions."
msgstr "Vous faites de votre mieux pour pousser un faux éternuement bien fort, vous projetant en avant et vous écrasant contre le plateau. Vous renversez les pions avec succès, les envoyant rouler dans des directions opposées."

# Traduction IA – à relire
#: parker_boardgames/beach_game_return/0/c-1/15 parker_boardgames/beach_game_return_swimsuit/0/c-1/15
msgctxt "Parker"
msgid "Oh! Gesundheit!"
msgstr "Oh ! À tes souhaits !"

# Traduction IA – à relire
#: parker_boardgames/beach_game_return/0/c-1/23 parker_boardgames/beach_game_return_swimsuit/0/c-1/23
msgctxt "Parker"
msgid "It can be a little musty up here in this attic..."
msgstr "Ça peut sentir un peu le renfermé, dans ce grenier..."

# Traduction IA – à relire
#: parker_boardgames/beach_game_return/0/c-1/34 parker_boardgames/beach_game_return_swimsuit/0/c-1/34
msgctxt "Parker"
msgid "I remember that my piece was here..."
msgstr "Je me souviens que mon pion était là..."

# Traduction IA – à relire
#: parker_boardgames/beach_game_return/0/c-1/42 parker_boardgames/beach_game_return_swimsuit/0/c-1/42
msgctxt "Parker"
msgid "...and where were you?"
msgstr "...et toi, où étais-tu ?"

# Traduction IA – à relire
#: parker_boardgames/beach_game_return/0/c-1/50/0/s/0 parker_boardgames/beach_game_return_swimsuit/0/c-1/50/0/s/0
msgctxt "Choix"
msgid "I was on the 10th space, close to the end."
msgstr "J'étais sur la 10e case, près de la fin."

# Traduction IA – à relire
#: parker_boardgames/beach_game_return/0/c-1/50/1/s/0 parker_boardgames/beach_game_return_swimsuit/0/c-1/50/1/s/0
msgctxt "Choix"
msgid "I was on the 11th space, right at the end."
msgstr "J'étais sur la 11e case, tout au bout."

# Traduction IA – à relire
#: parker_boardgames/beach_game_return/0/c-1/50/2/s/0 parker_boardgames/beach_game_return_swimsuit/0/c-1/50/2/s/0
msgctxt "Choix"
msgid "I was on space number"
msgstr "J'étais sur la case numéro"

# Traduction IA – à relire
#: parker_boardgames/beach_game_return/0/c-1/50/c-0/17 parker_boardgames/beach_game_return/0/c-1/50/c-1/21 parker_boardgames/beach_game_return_swimsuit/0/c-1/50/c-1/21
msgctxt "Parker"
msgid "Ah yes yes! You were about to win! I'll have to spin better!"
msgstr "Ah oui, oui ! Tu étais sur le point de gagner ! Je vais devoir mieux tourner !"

# Traduction IA – à relire
#: parker_boardgames/beach_game_return/0/c-1/50/c-2/7 parker_boardgames/beach_game_return_swimsuit/0/c-1/50/c-2/7
msgctxt "Parker"
msgid "That's right, you were!"
msgstr "C'est vrai, tu l'étais !"

# Traduction IA – à relire
#: parker_boardgames/beach_game_return/0/c-1/50/g-0/0 parker_boardgames/beach_game_return_swimsuit/0/c-1/50/g-0/0
msgctxt "Narrator"
msgid "Parker rearranges the pieces on the board, seemingly satisfied with their positions."
msgstr "Parker réarrange les pions sur le plateau, apparemment satisfait de leurs positions."

# Traduction IA – à relire
#: parker_boardgames/beach_game_return/0/c-1/50/g-0/8 parker_boardgames/beach_game_return_swimsuit/0/c-1/50/g-0/8
msgctxt "Parker"
msgid "Okay, that should settle it! I'll have to bring a hanky next time!"
msgstr "Bon, ça devrait régler le problème ! La prochaine fois, j'apporterai un mouchoir !"

# Traduction IA – à relire
#: parker_boardgames/parker_beach_form/4
msgctxt "Narrator"
msgid "You weren't really anticipating stripping down when you first spoke to Parker, but what better way to make things interesting? You make short work of your clothes, getting down to just your underwear and leaving your clothing in a messy little pile on the floor."
msgstr "Vous ne vous attendiez pas vraiment à vous déshabiller en parlant à Parker pour la première fois, mais quelle meilleure façon de pimenter les choses ? Vous vous débarrassez vite de vos vêtements, ne gardant que vos sous-vêtements et laissant le reste en un petit tas désordonné par terre."

# Traduction IA – à relire
#: parker_boardgames/parker_beach_form/12
msgctxt "Narrator"
msgid "Parker stares at you just a little too long—it seems he wasn't prepared for things to be quite this <i>interesting</i>. His pale cheeks flush as his eyes roam over your body."
msgstr "Parker vous dévisage un peu trop longtemps : il n'était visiblement pas préparé à ce que ce soit aussi <i>intéressant</i>. Ses joues pâles rougissent tandis que son regard parcourt votre corps."

# Traduction IA – à relire
#: parker_boardgames/parker_beach_form/20
msgctxt "Parker"
msgid "Oh! OH!"
msgstr "Oh ! OH !"

# Traduction IA – à relire
#: parker_boardgames/parker_beach_form/28
msgctxt "Parker"
msgid "Hehe. Um."
msgstr "Hihi. Euh."

# Traduction IA – à relire
#: parker_boardgames/parker_beach_form/39
msgctxt "Parker"
msgid "All right, as you wish..."
msgstr "Très bien, comme tu veux..."

# Traduction IA – à relire
#: parker_boardgames/parker_beach_form/47
msgctxt "Narrator"
msgid "It takes him a moment to compose himself, but he eventually manages to tear his gaze away from you, stripping down to a swimsuit. He seems somewhat unsettled, if his reddening cheeks and nervous demeanor are any indication."
msgstr "Il lui faut un moment pour se ressaisir, mais il parvient enfin à détourner les yeux, puis se met en maillot de bain. Il semble assez troublé, à en juger par ses joues de plus en plus rouges et son air nerveux."

# Traduction IA – à relire
#: parker_boardgames/parker_beach_form/61
msgctxt "Parker"
msgid "Here is my beach-going form. Ready for a typical day at the b-beach!"
msgstr "Voici ma tenue de plage. Prêt pour une journée type à la pl-plage !"

# Traduction IA – à relire
#: parker_boardgames/player_beach_roller/7 parker_boardgames/player_beach_roller_swimsuit/7
msgctxt "Parker"
msgid "You spun a..."
msgstr "Tu as obtenu un..."

# Traduction IA – à relire
#: parker_boardgames/player_board_outcome/0/b/5 parker_boardgames/player_board_outcome_swimsuit/0/b/5
msgctxt "Parker"
msgid "The delicious ice cream is filling you with joy! You'll be able to move again after this turn!"
msgstr "La délicieuse glace vous emplit de joie ! Vous pourrez rebouger après ce tour !"

# Traduction IA – à relire
#: parker_boardgames/player_board_outcome/0/b/13 parker_boardgames/player_board_outcome/18 parker_boardgames/player_board_outcome_swimsuit/18
msgctxt "Parker"
msgid "My turn..."
msgstr "À moi..."

# Traduction IA – à relire
#: parker_boardgames/player_board_outcome/3/b/1 parker_boardgames/player_board_outcome_swimsuit/3/b/1
msgctxt "Parker"
msgid "You're on the first space - traffic! Tough to get out of..."
msgstr "Tu es sur la première case : les embouteillages ! Difficile d'en sortir..."

# Traduction IA – à relire
#: parker_boardgames/player_board_outcome/4/b/1 parker_boardgames/player_board_outcome_swimsuit/4/b/1
msgctxt "Parker"
msgid "You're on the second space - The Parking Lot Entrance! With the high fees at the beach you'll have to move back one space I'm afraid to find a better price..."
msgstr "Tu es sur la deuxième case : l'Entrée du Parking ! Avec les tarifs exorbitants de la plage, tu dois reculer d'une case pour trouver un meilleur prix, j'en ai peur..."

# Traduction IA – à relire
#: parker_boardgames/player_board_outcome/5/b/1 parker_boardgames/player_board_outcome_swimsuit/5/b/1
msgctxt "Parker"
msgid "You're on the third space - The Open Space at the Parking Lot! Well done!"
msgstr "Tu es sur la troisième case : la Place Libre du Parking ! Bien joué !"

# Traduction IA – à relire
#: parker_boardgames/player_board_outcome/6/b/1 parker_boardgames/player_board_outcome_swimsuit/6/b/1
msgctxt "Parker"
msgid "You're on the fourth space - Getting Stuff Out of the Car! Good thing you brought the sunscreen!"
msgstr "Tu es sur la quatrième case : Sortir les Affaires de la Voiture ! Heureusement que tu as pris la crème solaire !"

# Traduction IA – à relire
#: parker_boardgames/player_board_outcome/7/b/1 parker_boardgames/player_board_outcome_swimsuit/7/b/1
msgctxt "Parker"
msgid "You're on the fifth space - Hot Sand! The intense heat on the soles of your feet cause you to run forward three spaces!"
msgstr "Tu es sur la cinquième case : Sable Brûlant ! La chaleur intense sous la plante de tes pieds te fait courir de trois cases en avant !"

# Traduction IA – à relire
#: parker_boardgames/player_board_outcome/8/b/1 parker_boardgames/player_board_outcome_swimsuit/8/b/1
msgctxt "Parker"
msgid "You're on the sixth space - Ice Cream! You can't help but stop for a tasty treat, and you lose a turn!"
msgstr "Tu es sur la sixième case : Glace ! Tu ne peux pas t'empêcher de t'arrêter pour une gourmandise, et tu perds un tour !"

# Traduction IA – à relire
#: parker_boardgames/player_board_outcome/9/b/1
msgctxt "Parker"
msgid "You're on the seventh space - Looking for a Sunny Spot! It sure is crowded today..."
msgstr "Tu es sur la septième case : À la Recherche d'un Coin Ensoleillé ! Il y a un monde fou aujourd'hui..."

# Traduction IA – à relire
#: parker_boardgames/player_board_outcome/10/b/1 parker_boardgames/player_board_outcome_swimsuit/10/b/1
msgctxt "Parker"
msgid "You're on the eighth space - The Perfect Spot! Now to set up your blanket..."
msgstr "Tu es sur la huitième case : L'Endroit Parfait ! Il ne reste plus qu'à installer ta serviette..."

# Traduction IA – à relire
#: parker_boardgames/player_board_outcome/11/b/1
msgctxt "Parker"
msgid "You're on the ninth space - Loud Music Family! You're set up next to a family blasting tunes - looks like you'll have to go back two spaces to find another spot!"
msgstr "Tu es sur la neuvième case : La Famille au Son Trop Fort ! Ta serviette est à côté d'une famille qui hurle sa musique : tu dois reculer de deux cases pour trouver une autre place !"

# Traduction IA – à relire
#: parker_boardgames/player_board_outcome/12/b/1
msgctxt "Parker"
msgid "You're on the tenth space - Big Bad Sun! You didn't bring sunscreen out of the car so you'll have to go back all the way to space 4... oh dear!"
msgstr "Tu es sur la dixième case : Le Grand Méchant Soleil ! Tu n'as pas sorti la crème solaire de la voiture, donc retour à la case 4... Oh là là !"

# Traduction IA – à relire
#: parker_boardgames/player_board_outcome/13/b/1
msgctxt "Parker"
msgid "You're on the tenth space - Big Bad Sun! Good thing you brought the sunscreen out of the car! You move forward one space!"
msgstr "Tu es sur la dixième case : Le Grand Méchant Soleil ! Heureusement que tu as sorti la crème solaire de la voiture ! Tu avances d'une case !"

# Traduction IA – à relire
#: parker_boardgames/player_board_outcome/14/b/1 parker_boardgames/player_board_outcome_swimsuit/14/b/1
msgctxt "Parker"
msgid "You're on the eleventh space - Notifications Off! You're almost to a perfect Sandy Holiday!"
msgstr "Tu es sur la onzième case : Notifications Coupées ! Tu es presque à des Vacances de Sable parfaites !"

# Traduction IA – à relire
#: parker_boardgames/player_board_outcome/15/b/1
msgctxt "Parker"
msgid "You're made it to the Sandy Kingdom! You win!"
msgstr "Tu as atteint le Royaume de Sable ! Tu gagnes !"

# Traduction IA – à relire
#: parker_boardgames/parker_beach_roller/7
msgctxt "Parker"
msgid "I spun a..."
msgstr "J'ai obtenu un..."

# Traduction IA – à relire
#: parker_boardgames/parker_board_outcome/0/b/5
msgctxt "Parker"
msgid "The delicious ice cream is filling me with joy! I'll be able to move again after this turn!"
msgstr "La délicieuse glace m'emplit de joie ! Je pourrai rebouger après ce tour !"

# Traduction IA – à relire
#: parker_boardgames/parker_board_outcome/0/b/13
msgctxt "Parker"
msgid "Looks like it's back to you!"
msgstr "On dirait que c'est de nouveau à toi !"

# Traduction IA – à relire
#: parker_boardgames/parker_board_outcome/3/b/1
msgctxt "Parker"
msgid "I'm on the first space - traffic! Tough to get out of..."
