msgstr "Oui ! C'est excitant, non !"

# Traduction IA – à relire
#: hime_anime/hetor_love_return/0/c-1/23/1/s/0
msgctxt "Choix"
msgid "Just like me!"
msgstr "Comme moi !"

# Traduction IA – à relire
#: hime_anime/hero_friend_return/0/8
msgctxt "Hero-Hime"
msgid "Yo! It's always nice to see you, friend!"
msgstr "Yo ! Toujours un plaisir de te voir, partenaire !"

# Traduction IA – à relire
#: hime_anime/hero_friend_return/0/16 hime_anime/hero_friend_return_bailout/0/8
msgctxt "Hero-Hime"
msgid "Let's try to reach a hundred hit rally today!"
msgstr "Essayons d'atteindre un échange de cent frappes aujourd'hui !"

# Traduction IA – à relire
#: hime_anime/hero_friend_return/0/24/s/0 hime_anime/hero_friend_return_bailout/0/16/s/0
msgctxt "Choix"
msgid "Game on!"
msgstr "C'est parti !"

# Traduction IA – à relire
#: hime_anime/hero_friend_return/0/25/s/0 hime_anime/hero_friend_return_bailout/0/17/s/0
msgctxt "Choix"
msgid "Actually, I'm here to Realize you!"
msgstr "En fait, je suis là pour te Réaliser !"

# Traduction IA – à relire
#: hime_anime/hero_friend_return_bailout/0/0
msgctxt "Hero-Hime"
msgid "Hello there, fellow Heart Ace Academy student!"
msgstr "Salut, camarade de l'Académie Heart Ace !"

# Traduction IA – à relire
#: hime_anime/hero_hate_return/0/0
msgctxt "Hero-Hime"
msgid "So much power..."
msgstr "Tant de puissance..."

# Traduction IA – à relire
#: hime_anime/hero_hate_return/0/8
msgctxt "Hero-Hime"
msgid "This feels familiar..."
msgstr "Ça me rappelle quelque chose..."

# Traduction IA – à relire
#: hime_anime/hero_hate_return/0/16/s/0
msgctxt "Choix"
msgid "Yikes..."
msgstr "Aïe..."

# Traduction IA – à relire
#: hime_anime/hero_hate_return/0/17/s/0
msgctxt "Choix"
msgid "Hero... listen to me. (USE POISE CANDY)"
msgstr "Hero... écoute-moi. (UTILISER UN BONBON DE PRESTANCE)"

# Traduction IA – à relire
#: hime_anime/hero_hate_return/0/c-0/10
msgctxt "Hero-Hime"
msgid "<i>Neko... neko... </i>"
msgstr "<i>Neko... neko... </i>"

# Traduction IA – à relire
#: hime_anime/hero_hate_return/0/c-0/21
msgctxt "Hero-Hime"
msgid "<i>Nekoboru... </i>"
msgstr "<i>Nekoboru... </i>"

# Traduction IA – à relire
#: hime_anime/hero_hate_return/0/c-1/24/0/s/0
msgctxt "Choix"
msgid "I made a mistake. I thought that by letting you win it would prevent this from happening."
msgstr "J'ai fait une erreur. Je pensais qu'en te laissant gagner, j'éviterais que ça arrive."

# Traduction IA – à relire
#: hime_anime/hero_hate_return/0/c-1/24/c-0/15/0/s/0
msgctxt "Choix"
msgid "I was wrong. But so is the dread."
msgstr "Je me trompais. Mais l'Effroi aussi."

# Traduction IA – à relire
#: hime_anime/hero_hate_return/0/c-1/24/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "Dread! Stay away from this pure Tennistar!"
msgstr "Effroi ! Éloigne-toi de cette pure Tennistar !"

# Traduction IA – à relire
#: hime_anime/hero_hate_return/0/c-1/24/c-0/15/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "With the power of squad and anime on my side - you are banished!"
msgstr "Avec la puissance de l'équipe et de l'anime à mes côtés, tu es banni !"

# Traduction IA – à relire
#: hime_anime/hero_hate_return/0/c-1/24/c-0/15/c-0/15/c-0/15/c-0/18
msgctxt "Hero-Hime"
msgid "You did it!"
msgstr "Tu as réussi !"

# Traduction IA – à relire
#: hime_anime/hero_hate_return/0/c-1/24/c-0/15/c-0/15/c-0/15/c-0/29
msgctxt "Hero-Hime"
msgid "Thank you for being the act four twist ending for me!"
msgstr "Merci d'avoir été pour moi le rebondissement final de l'acte quatre !"

# Traduction IA – à relire
#: hime_anime/hero_hate_return/0/c-1/24/c-0/15/c-0/15/c-0/15/c-0/37
msgctxt "Hero-Hime"
msgid "It got me an extra episode and everything."
msgstr "Ça m'a valu un épisode en plus et tout."

# Traduction IA – à relire
#: hime_anime/hero_hate_return/0/c-1/24/c-0/15/c-0/15/c-0/15/c-0/45
msgctxt "Hero-Hime"
msgid "You're the best!"
msgstr "Tu es la meilleure personne !"

# Traduction IA – à relire
#: hime_anime/hero_hate_return_bailout/0/0
msgctxt "Hero-Hime"
msgid "Go away! You messed with my plot for the last time!"
msgstr "Va-t'en ! Tu as touché à mon intrigue pour la dernière fois !"

# Traduction IA – à relire
#: hime_anime/hero_hate_return_bailout/0/8/s/0
msgctxt "Choix"
msgid "Fine."
msgstr "Très bien."

# Traduction IA – à relire
#: hime_anime/hero_hate_return_bailout/0/9/s/0
msgctxt "Choix"
msgid "<i>Show Hero some fancy footwork.</i> (USE POISE CANDY)"
msgstr "<i>Montrer à Hero un joli jeu de jambes.</i> (UTILISER UN BONBON DE PRESTANCE)"

# Traduction IA – à relire
#: hime_anime/hero_hate_return_bailout/0/c-1/21
msgctxt "Hero-Hime"
msgid "Well... at least you learned something."
msgstr "Eh bien... au moins, tu as appris quelque chose."

# Traduction IA – à relire
#: hime_anime/hero_hate_return_bailout/0/c-1/29
msgctxt "Hero-Hime"
msgid "Maybe instead of my rival, you were always supposed to just be my kouhai."
msgstr "Peut-être qu'au lieu d'être ma rivale, tu étais toujours censé être juste mon kouhai."

# Traduction IA – à relire
#: hime_anime/hero_hate_return_bailout/0/c-1/37
msgctxt "Hero-Hime"
msgid "We can be friends, then."
msgstr "On pourra être amis, alors."

# Traduction IA – à relire
#: hime_anime/hime_realize_join/0/0
msgctxt "Hero-Hime"
msgid "I'm excited!"
msgstr "Je suis tout excitée !"

# Traduction IA – à relire
#: hime_anime/hime_realize_join/0/8
msgctxt "Hero-Hime"
msgid "But... do you have what we need to turn me from 1/8ths scale all the way to 1!?"
msgstr "Mais... as-tu ce qu'il faut pour me faire passer de l'échelle 1/8 jusqu'à l'échelle 1 !?"

# Traduction IA – à relire
#: hime_anime/hime_realize_join/0/25/s/0
msgctxt "Choix"
msgid "I do."
msgstr "Oui."

# Traduction IA – à relire
#: hime_anime/hime_realize_join/0/26/s/0
msgctxt "Choix"
msgid "I do not."
msgstr "Non."

# Traduction IA – à relire
#: hime_anime/hime_realize_join/0/c-1/10 hime_anime/hime_realize_return/0/c-1/10
msgctxt "Hero-Hime"
msgid "Don't worry. I'll practice my serves until you're back."
msgstr "Ne t'inquiète pas. Je m'entraînerai à servir jusqu'à ton retour."

# Traduction IA – à relire
#: hime_anime/hime_realize_return/0/0
msgctxt "Hero-Hime"
msgid "You're back!"
msgstr "Te revoilà !"

# Traduction IA – à relire
#: hime_anime/hime_realize_return/0/8
msgctxt "Hero-Hime"
msgid "I'm warmed up and ready if you are!"
msgstr "Je suis échauffée et prête si tu l'es !"

# Traduction IA – à relire
#: hime_anime/hime_realize_return/0/25/s/0
msgctxt "Choix"
msgid "I am!"
msgstr "Je le suis !"

# Traduction IA – à relire
#: hime_anime/hime_realize_return/0/26/s/0
msgctxt "Choix"
msgid "I am not."
msgstr "Non."

# Traduction IA – à relire
#: hime_anime/hime_realize_begin/6/b/1
msgctxt "Skylar"
msgid "I'm so excited! The Hero Hime, made real? Hopefully, realization can work!"
msgstr "Je suis trop excitée ! Hero Hime, rendue réelle ? J'espère que la Réalisation va marcher !"

# Traduction IA – à relire
#: hime_anime/hime_realize_begin/9
msgctxt "Skylar"
msgid "Ganbatte!"
msgstr "Ganbatte !"

# Traduction IA – à relire
#: hime_anime/hime_realize_begin/20
msgctxt "Narrator"
msgid "The spectral energy flows through your dateviators, and what was once merely a statue of an anime waifu, becomes...."
msgstr "L'énergie spectrale traverse vos Dateviators, et ce qui n'était jadis qu'une statue de waifu d'anime devient..."

# Traduction IA – à relire
#: hime_anime/hime_realized/0/0
msgctxt "Narrator"
msgid "Before you stands Human Hime, the dreams of a manga-ka made real."
msgstr "Devant vous se tient Hime l'Humaine, les rêves d'un mangaka rendus réels."

# Traduction IA – à relire
#: hime_anime/hime_realized/0/8
msgctxt "Hero-Hime"
msgid "Woah! So this is what being alive feels like!"
msgstr "Ouah ! Alors c'est ça, être en vie !"

# Traduction IA – à relire
#: hime_anime/hime_realized/0/16
msgctxt "Hero-Hime"
msgid "Lemme test out these limbs!"
msgstr "Voyons voir ce que valent ces membres !"

# Traduction IA – à relire
#: hime_anime/hime_realized/0/24
msgctxt "Narrator"
msgid "Hero Hime gingerly at first tests out her new arms and legs. Assessing the limits of her reach."
msgstr "Hero Hime essaie d'abord avec précaution ses nouveaux bras et ses nouvelles jambes, évaluant les limites de sa portée."

# Traduction IA – à relire
#: hime_anime/hime_realized/0/32
msgctxt "Hero-Hime"
msgid "Well, everything checks out. I'm ready to hit the courts!"
msgstr "Bon, tout fonctionne. Je suis prête à filer sur les courts !"

# Traduction IA – à relire
#: hime_anime/hime_realized/0/40/s/0
msgctxt "Choix"
msgid "Wait, what about us?"
msgstr "Attends, et nous, alors ?"

# Traduction IA – à relire
#: hime_anime/hime_realized/0/41/s/0
msgctxt "Choix"
msgid "Okay, have fun!"
msgstr "D'accord, amuse-toi bien !"

# Traduction IA – à relire
#: hime_anime/hime_realized/0/g-0/0
msgctxt "Hero-Hime"
msgid "Well, you're coming with me silly!"
msgstr "Eh bien, tu viens avec moi, bêta !"

# Traduction IA – à relire
#: hime_anime/hime_realized/0/g-0/8
msgctxt "Hero-Hime"
msgid "Hold on, what happened to Nekoboru?"
msgstr "Attends, qu'est-il arrivé à Nekoboru ?"

# Traduction IA – à relire
#: hime_anime/hime_realized/0/g-0/27
msgctxt "Narrator"
msgid "A once omnipotent god in the form of a cat-shaped tennis ball was caught in the rays of the dateviators."
msgstr "Un dieu jadis tout-puissant, sous la forme d'une balle de tennis en forme de chat, a été pris dans les rayons des Dateviators."

# Traduction IA – à relire
#: hime_anime/hime_realized/0/g-0/35
msgctxt "Narrator"
msgid "He is now a physical specimen befitting a deity of his status."
msgstr "Il est désormais un spécimen physique digne d'une divinité de son rang."

# Traduction IA – à relire
#: hime_anime/hime_realized/0/g-0/43
msgctxt "Hero-Hime"
msgid "What???"
msgstr "Quoi ???"

# Traduction IA – à relire
#: hime_anime/hime_realized/0/g-0/51/s/0
msgctxt "Choix"
msgid "Dude, you're hot!"
msgstr "Mec, t'es canon !"

# Traduction IA – à relire
#: hime_anime/hime_realized/0/g-0/52/s/0
msgctxt "Choix"
msgid "Umm... this is making me uncomfortable."
msgstr "Euh... ça me met mal à l'aise."

# Traduction IA – à relire
#: hime_anime/hime_realized/0/g-1/8
msgctxt "Hero-Hime"
msgid "Wait. You still only say Nekoboru?"
msgstr "Attends. Tu ne dis toujours que Nekoboru ?"

# Traduction IA – à relire
#: hime_anime/hime_realized/0/g-1/16
msgctxt "Nekoboru"
msgid "Sorry, force of habit."
msgstr "Désolé, force de l'habitude."

# Traduction IA – à relire
#: hime_anime/hime_realized/0/g-1/24
msgctxt "Nekoboru"
msgid "Hero-Hime, real tennis doesn't involve Starlight Smashes. You're going to need a coach who can help you navigate the grim realities of the real world."
msgstr "Hero-Hime, le vrai tennis ne comporte pas de Smash Étoilé. Il te faudra un entraîneur capable de t'aider à affronter les dures réalités du monde réel."

# Traduction IA – à relire
#: hime_anime/hime_realized/0/g-1/32
msgctxt "Hero-Hime"
msgid "Hm."
msgstr "Hm."

# Traduction IA – à relire
#: hime_anime/hime_realized/0/g-1/40
msgctxt "Hero-Hime"
msgid "Do I still get to run around on a court and swing a racket?"
msgstr "Je pourrai quand même courir sur un court et agiter une raquette ?"

# Traduction IA – à relire
#: hime_anime/hime_realized/0/g-1/48
msgctxt "Nekoboru"
msgid "Yes, of course."
msgstr "Oui, bien sûr."

# Traduction IA – à relire
#: hime_anime/hime_realized/0/g-1/56
msgctxt "Hero-Hime"
msgid "Then I don't need Starlight Smash! Let's go!"
msgstr "Alors je n'ai pas besoin de Smash Étoilé ! Allons-y !"

# Traduction IA – à relire
#: hime_anime/hime_realized/0/g-1/64/s/0
msgctxt "Choix"
msgid "That's the spirit!"
msgstr "Voilà l'esprit !"

# Traduction IA – à relire
#: hime_anime/hime_realized/0/g-1/65/s/0
msgctxt "Choix"
msgid "I can tell Season Three is going to be really good."
msgstr "Je sens que la saison trois va être vraiment bien."

# Traduction IA – à relire
#: hime_anime/hime_realized/0/g-2/0
msgctxt "Narrator"
msgid "In a flash, Hime is by the door ready to depart."
msgstr "En un éclair, Hime est près de la porte, prête à partir."

# Traduction IA – à relire
#: hime_anime/hime_realized/0/g-2/8/s/0
msgctxt "Choix"
msgid "Here's a little something for good luck."
msgstr "Voilà un petit quelque chose pour te porter chance."

# Traduction IA – à relire
#: hime_anime/hime_realized/0/g-2/9/s/0
msgctxt "Choix"
msgid "Have fun Hime - I can't wait to see all your matches!"
msgstr "Amuse-toi bien, Hime, j'ai hâte de voir tous tes matchs !"

# Traduction IA – à relire
#: hime_anime/hime_realized/0/g-2/c-6/10
msgctxt "Narrator"
msgid "Her neatly tied hair swings slightly as she turns your way."
msgstr "Ses cheveux soigneusement attachés ondulent légèrement quand elle se tourne vers vous."

# Traduction IA – à relire
#: hime_anime/hime_realized/0/g-2/c-6/18
msgctxt "Hero-Hime"
msgid "What's that?"
msgstr "C'est quoi, ça ?"

# Traduction IA – à relire
#: hime_anime/hime_realized/0/g-2/c-6/26/0/s/0
msgctxt "Choix"
msgid "<i>Kiss her on the lips.</i>"
msgstr "<i>L'embrasser sur la bouche.</i>"

# Traduction IA – à relire
#: hime_anime/hime_realized/0/g-2/c-6/26/1/s/0
msgctxt "Choix"
msgid "<i>Kiss her on the cheek.</i>"
msgstr "<i>L'embrasser sur la joue.</i>"

# Traduction IA – à relire
#: hime_anime/hime_realized/0/g-2/c-6/26/g-0/0
msgctxt "Hero-Hime"
msgid "Oh my!!"
msgstr "Oh là là !!"

# Traduction IA – à relire
#: hime_anime/hime_realized/0/g-2/c-6/26/g-0/11
msgctxt "Narrator"
msgid "Even though she is no longer in an anime, you swear you can see effervescent cherry blossoms swirling around her in the air."
msgstr "Bien qu'elle ne soit plus dans un anime, vous jureriez voir des cerisiers en fleurs effervescents tourbillonner autour d'elle dans l'air."

# Traduction IA – à relire
#: hime_anime/hime_realized/0/g-2/c-6/26/g-0/19
msgctxt "Nekoboru"
msgid "The power of the Starlight Smash lives inside you after all...."
msgstr "La puissance du Smash Étoilé vit en toi, après tout...."

# Traduction IA – à relire
#: hime_anime/hime_realized/0/g-2/c-6/26/g-0/27/0/s/0
msgctxt "Choix"
msgid "<i>Kiss him on the lips.</i>"
msgstr "<i>L'embrasser sur la bouche.</i>"

# Traduction IA – à relire
#: hime_anime/hime_realized/0/g-2/c-6/26/g-0/27/1/s/0
msgctxt "Choix"
msgid "<i>Wave goodbye.</i>"
msgstr "<i>Lui faire au revoir de la main.</i>"

# Traduction IA – à relire
#: hime_anime/hime_realized/0/g-2/c-6/26/g-0/27/c-1/7 hime_anime/hime_realized/0/g-2/c-7/7
msgctxt "Hero-Hime"
msgid "I'll reserve you a seat in the front row!"
msgstr "Je te réserverai une place au premier rang !"

# Traduction IA – à relire
#: hime_anime/hime_postrealize_join/0/0
msgctxt "Narrator"
msgid "It won't be long until you receive a grand invitation to Thimbledon, the most important tournament in the world."
msgstr "Il ne faudra pas longtemps avant que vous receviez une prestigieuse invitation à Thimbledon, le tournoi le plus important du monde."

# Traduction IA – à relire
#: hime_anime/hime_postrealize_join/0/11
msgctxt "Narrator"
msgid "Hime was a natural at translating her abilities to the real world, including her uncanny knack for finding the best brand deals."
msgstr "Hime s'est avérée une experte pour transposer ses talents dans le monde réel, y compris son flair étonnant pour dénicher les meilleurs contrats de partenariat."

# Traduction IA – à relire
#: hime_anime/hime_postrealize_join/0/22
msgctxt "Narrator"
msgid "Along with the usual assortment of energy drinks and fancy watches, she found herself successfully landing an anime adaptation of her real world prowess."
msgstr "Outre l'assortiment habituel de boissons énergisantes et de montres de luxe, elle a réussi à décrocher une adaptation en anime de ses prouesses du monde réel."

# Traduction IA – à relire
#: hime_anime/hime_postrealize_join/0/30
msgctxt "Narrator"
msgid "Starring herself, of course."
msgstr "Dans son propre rôle, bien sûr."

# Traduction IA – à relire
#: hime_anime/hime_postrealize_join/0/38
msgctxt "Narrator"
msgid "Also Nekoboru became a best-seller with his book \"I Was God, Then a Ball, Then a Dude with Balls.\""
msgstr "Nekoboru est aussi devenu un best-seller avec son livre « J'étais Dieu, puis une Balle, puis un Mec avec des Balloches »."
