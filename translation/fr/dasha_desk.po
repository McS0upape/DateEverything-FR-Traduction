msgstr "Ahh, camarade... Je commence à me faire beaucoup de souci pour toi."

# Traduction IA – à relire
#: dasha_desk/the_strip_club/0/9
msgctxt "Dasha"
msgid "Well. Ahem. Here we are at strip club."
msgstr "Bon. Hum. Nous voici au club de strip-tease."

# Traduction IA – à relire
#: dasha_desk/the_strip_club/0/17
