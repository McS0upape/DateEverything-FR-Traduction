#: skylar_specs/suspension_explain/0/g-0/c-4/7
msgctxt "Skylar"
msgid "Thanks..."
msgstr ""

#: skylar_specs/suspension_explain/0/g-1/0
msgctxt "Skylar"
msgid "It's a very special type of suspension."
msgstr ""

#: skylar_specs/suspension_explain/0/g-1/8
msgctxt "Skylar"
msgid "A Suspension of Disbelief."
msgstr ""

#: skylar_specs/suspension_explain/0/g-1/16/s/0
msgctxt "Choix"
msgid "You're kidding me."
msgstr ""

#: skylar_specs/suspension_explain/0/g-1/17/s/0
msgctxt "Choix"
msgid "Oh..."
msgstr ""

#: skylar_specs/suspension_explain/0/g-1/18/s/0
msgctxt "Choix"
msgid "What does that mean?"
msgstr ""

#: skylar_specs/suspension_explain/0/g-1/c-5/7
msgctxt "Skylar"
msgid "I'm not!"
msgstr ""

#: skylar_specs/suspension_explain/0/g-1/c-6/7
msgctxt "Skylar"
msgid "I know... I'm a sad pair of lenses here."
msgstr ""

#: skylar_specs/suspension_explain/0/g-2/0
msgctxt "Skylar"
msgid "Basically it works super hard to make everything in this little love experiment work."
msgstr ""

#: skylar_specs/suspension_explain/0/g-2/8
msgctxt "Skylar"
msgid "But it's strained, really strained, with all these wild things going on around here!"
msgstr ""

#: skylar_specs/suspension_explain/0/g-2/16
msgctxt "Skylar"
msgid "Talking to objects?"
msgstr ""

#: skylar_specs/suspension_explain/0/g-2/24/b/1
msgctxt "Skylar"
msgid "Bringing them to life?"
msgstr ""

#: skylar_specs/suspension_explain/0/g-2/27
msgctxt "Skylar"
msgid "Objects having names and hidden lives and sexy human bodies and everything?"
msgstr ""

#: skylar_specs/suspension_explain/0/g-2/35
msgctxt "Skylar"
msgid "It can barely handle it!"
msgstr ""

#: skylar_specs/suspension_explain/0/g-2/43/s/0
msgctxt "Choix"
msgid "How can I help?"
msgstr ""

#: skylar_specs/suspension_explain/0/g-2/44/s/0
msgctxt "Choix"
msgid "This is pretty silly, you have to admit."
msgstr ""

#: skylar_specs/suspension_explain/0/g-2/45/s/0
msgctxt "Choix"
msgid "I'm okay with the metaphor here, but I still think it's important for lore to work."
msgstr ""

#: skylar_specs/suspension_explain/0/g-2/c-8/7
msgctxt "Skylar"
msgid "Just... give it a little love."
msgstr ""

#: skylar_specs/suspension_explain/0/g-2/c-9/7
msgctxt "Skylar"
msgid "No no no no no... I really don't want to admit that."
msgstr ""

#: skylar_specs/suspension_explain/0/g-2/c-9/15
msgctxt "Skylar"
msgid "It would hurt her too much..."
msgstr ""

#: skylar_specs/suspension_explain/0/g-2/c-10/7
msgctxt "Skylar"
msgid "Ohhh yeah... you're one of those."
msgstr ""

#: skylar_specs/suspension_explain/0/g-2/c-10/15
msgctxt "Skylar"
msgid "No problem. We'll try harder next time."
msgstr ""

#: skylar_specs/suspension_explain/0/g-3/0
msgctxt "Skylar"
msgid "Anyway..."
msgstr ""

#: skylar_specs/first_suspension_score_good/0/0
msgctxt "Narrator"
msgid "You take a closer look at Skylar's suspension of disbelief. It's hard to be sure, but she seems pleased."
msgstr ""

#: skylar_specs/first_suspension_score_good/0/8
msgctxt "Skylar"
msgid "You just believed in her, so she feels strengthened."
msgstr ""

#: skylar_specs/first_suspension_score_good/0/19 skylar_specs/suspension_2/20/b/20
msgctxt "Skylar"
msgid "Thanks for that... It really means a lot to me."
msgstr ""

#: skylar_specs/first_suspension_score_good/0/27/s/0
msgctxt "Choix"
msgid "No problem!"
msgstr ""

#: skylar_specs/first_suspension_score_good/0/28/s/0
msgctxt "Choix"
msgid "Well, only because what you said made sense."
msgstr ""

#: skylar_specs/first_suspension_score_good/0/c-0/7
msgctxt "Narrator"
msgid "Skylar smiles warmly and lets you go."
msgstr ""

#: skylar_specs/first_suspension_score_good/0/c-1/7
msgctxt "Skylar"
msgid "Good enough, I guess."
msgstr ""

#: skylar_specs/first_suspension_score_bad/0/0
msgctxt "Narrator"
msgid "You take a closer look at Skylar's suspension of disbelief. It's hard to be sure, but she seems upset."
msgstr ""

#: skylar_specs/first_suspension_score_bad/0/8
msgctxt "Skylar"
msgid "You just thought she did a bad job with our explanation, so she's hurt."
msgstr ""

#: skylar_specs/first_suspension_score_bad/0/16 skylar_specs/suspension_2/21/b/17
msgctxt "Skylar"
msgid "This... kinda means a lot to me. So please try to be careful."
msgstr ""

#: skylar_specs/first_suspension_score_bad/0/24/s/0
msgctxt "Choix"
msgid "No promises."
msgstr ""

#: skylar_specs/first_suspension_score_bad/0/25/s/0
msgctxt "Choix"
msgid "You got it, Skylar."
msgstr ""

#: skylar_specs/suspension_2/0
msgctxt "Skylar"
msgid "Um... my Suspension just gave a little wiggle."
msgstr ""

#: skylar_specs/suspension_2/11
msgctxt "Narrator"
msgid "Skylar shows you her dateviators, turning them so that you can see her Suspension of Disbelief."
msgstr ""

#: skylar_specs/suspension_2/19/b/1 skylar_specs/suspension_3/19/b/1 skylar_specs/suspension_3/20/b/1
msgctxt "Narrator"
msgid "Skylar's Suspension looks uncertain somehow, as if, perhaps, she could use some reassurance."
msgstr ""

#: skylar_specs/suspension_2/19/b/9 skylar_specs/suspension_3/19/b/9 skylar_specs/suspension_3/20/b/9
msgctxt "Skylar"
msgid "She feels a little shaky... torn between two poles."
msgstr ""

#: skylar_specs/suspension_2/19/b/17 skylar_specs/suspension_3/19/b/25 skylar_specs/suspension_3/20/b/25
msgctxt "Skylar"
msgid "Try to give her a little more love next time yeah?"
msgstr ""

#: skylar_specs/suspension_2/20/b/1
msgctxt "Narrator"
msgid "Skylar's Suspension seems buoyed somehow, happier than you'd last seen her."
msgstr ""

#: skylar_specs/suspension_2/20/b/9
msgctxt "Skylar"
msgid "You believed in her again, so she feels even stronger."
msgstr ""

#: skylar_specs/suspension_2/21/b/1
msgctxt "Narrator"
msgid "Skylar's Suspension looks worse for wear, clear hurt in her eyes."
msgstr ""

#: skylar_specs/suspension_2/21/b/9
msgctxt "Skylar"
msgid "You were skeptical again... she doesn't do well with that."
msgstr ""

#: skylar_specs/suspension_3/0
msgctxt "Skylar"
msgid "Oh... my Suspension. What's that she's saying...?"
msgstr ""

#: skylar_specs/suspension_3/11
msgctxt "Narrator"
msgid "Skylar removes her dateviators, holding them out so that you can see her Suspension of Disbelief."
msgstr ""

#: skylar_specs/suspension_3/19/b/17
msgctxt "Skylar"
msgid "But leaning towards a darker side..."
msgstr ""

#: skylar_specs/suspension_3/20/b/17
msgctxt "Skylar"
msgid "Fortunately heading more towards a healthy side... but no guarantees."
msgstr ""

#: skylar_specs/suspension_4/0
msgctxt "Skylar"
msgid "The Suspension of Disbelief just wiggled ferociously!"
msgstr ""

#: skylar_specs/suspension_4/11
msgctxt "Narrator"
msgid "Skylar takes off her glasses, peering at the Suspension nestled within the hinge. She turns them to show you, concern etched into her pretty face."
