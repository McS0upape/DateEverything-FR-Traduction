msgctxt "Mitchell"
msgid "Does that mean I'll get to experience Paris?"
msgstr ""

#: mitchell_food/mitchell_realize_join/0/8/s/0 mitchell_food/mitchell_realize_join/0/g-0/8/s/0
msgctxt "Choix"
msgid "Yes"
