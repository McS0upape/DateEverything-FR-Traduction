# Traduction IA – à relire
#: hoove_vacuum/1
msgctxt "Tag Nom d'objet (MAJUSCULES)"
msgid "VACUUM CLEANER"
msgstr "ASPIRATEUR"

# Traduction IA – à relire
#: hoove_vacuum/hoove_maggie_quest/0/18/b/1
msgctxt "Hoove"
msgid "Hey! Uh... I feel a little ambushed here."
msgstr "Hé ! Euh... j'ai un peu l'impression de m'être fait tendre une embuscade."

# Traduction IA – à relire
#: hoove_vacuum/hoove_maggie_quest/0/21/b/1
msgctxt "Hoove"
msgid "You hate me that much you brought the cops?"
msgstr "Tu me détestes à ce point pour ramener les flics ?"

# Traduction IA – à relire
#: hoove_vacuum/hoove_maggie_quest/0/24/s/0
msgctxt "Choix"
msgid "No, don't worry, it's not about you!"
msgstr "Non, t'inquiète, ça ne te concerne pas !"

# Traduction IA – à relire
#: hoove_vacuum/hoove_maggie_quest/0/c-0/7
msgctxt "Hoove"
msgid "Hm..."
msgstr "Hm..."

# Traduction IA – à relire
#: hoove_vacuum/hoove_maggie_quest/0/c-0/15
msgctxt "Maggie"
msgid "Sorry to bother you, Henry, but we're looking for any information on a counterfeit item in the house."
msgstr "Désolée de vous déranger, Henry, mais nous cherchons des informations sur un objet contrefait dans la maison."

# Traduction IA – à relire
#: hoove_vacuum/hoove_maggie_quest/0/c-0/23
msgctxt "Maggie"
msgid "Have you found anything... perhaps at one of our Grime Scenes?"
msgstr "Avez-vous trouvé quelque chose... peut-être sur l'une de nos Scènes de crasse ?"

# Traduction IA – à relire
#: hoove_vacuum/hoove_maggie_quest/0/c-0/31
msgctxt "Hoove"
msgid "Well yeah, when I was upstairs cleaning under the trophy shelf I heard Stepford saying some nasty stuff."
msgstr "Ben ouais, quand j'étais à l'étage en train de nettoyer sous l'étagère à trophées, j'ai entendu Stepford sortir des trucs bien vilains."

# Traduction IA – à relire
#: hoove_vacuum/hoove_maggie_quest/0/g-0/0
msgctxt "Hoove"
msgid "You should go check with him."
msgstr "Tu devrais aller le voir."

# Traduction IA – à relire
#: hoove_vacuum/hoove_maggie_quest/0/g-0/11/b/1
msgctxt "Hoove"
msgid "Now get outta here."
msgstr "Allez, maintenant, dégage."

# Traduction IA – à relire
#: hoove_vacuum/hoove_maggie_goodbye/0/0
msgctxt "Hoove"
msgid "You down for a drink later?"
msgstr "Ça te dit, un verre plus tard ?"

# Traduction IA – à relire
#: hoove_vacuum/hoove_maggie_goodbye/0/8/s/0
msgctxt "Choix"
msgid "Sure, I'll be back!"
msgstr "Carrément, je reviens !"

# Traduction IA – à relire
#: hoove_vacuum/hoove_maggie_goodbye/0/9/s/0
msgctxt "Choix"
msgid "No, I'm on the case."
msgstr "Non, je suis sur une enquête."

# Traduction IA – à relire
#: hoove_vacuum/hoove_maggie_goodbye/0/c-0/7 hoove_vacuum/hoove_inanimals/0/g-0/c-2/20/b/7 hoove_vacuum/hoove_inanimals/0/g-0/c-2/21/b/1
msgctxt "Hoove"
msgid "Sweet! See you around!"
msgstr "Super ! À plus !"

# Traduction IA – à relire
#: hoove_vacuum/hoove_maggie_goodbye/0/c-1/7
msgctxt "Hoove"
msgid "Ah I know how it is..."
msgstr "Ah, je vois le genre..."

# Traduction IA – à relire
#: hoove_vacuum/hoove_keyes_quest/0/6/b/1
msgctxt "Hoove"
msgid "Yo, what's up?"
msgstr "Yo, quoi de neuf ?"

# Traduction IA – à relire
#: hoove_vacuum/hoove_keyes_quest/0/9/b/1
msgctxt "Hoove"
msgid "What? You need me to clean something?"
msgstr "Quoi ? Tu as besoin que je nettoie un truc ?"

# Traduction IA – à relire
#: hoove_vacuum/hoove_keyes_quest/0/12/s/0
msgctxt "Choix"
msgid "I'm here for Keyes... she wants you to clean her pedals better."
msgstr "Je viens de la part de Keyes... elle voudrait que tu nettoies mieux ses pédales."

# Traduction IA – à relire
#: hoove_vacuum/hoove_keyes_quest/0/c-0/7
msgctxt "Hoove"
msgid "Man."
msgstr "Pff."

# Traduction IA – à relire
#: hoove_vacuum/hoove_keyes_quest/0/c-0/15
msgctxt "Hoove"
msgid "The nerve on that instrument."
msgstr "Il en faut, du culot, à cet instrument."

# Traduction IA – à relire
#: hoove_vacuum/hoove_keyes_quest/0/c-0/23/0/s/0
msgctxt "Choix"
msgid "What's wrong?"
msgstr "Qu'est-ce qui ne va pas ?"

# Traduction IA – à relire
#: hoove_vacuum/hoove_keyes_quest/0/c-0/23/c-0/7
msgctxt "Hoove"
msgid "She thinks she's so fancy that she wants me to pay special attention to cleaning her feet?"
msgstr "Elle se prend pour qui, pour exiger que je m'occupe tout spécialement de ses pieds ?"

# Traduction IA – à relire
#: hoove_vacuum/hoove_keyes_quest/0/c-0/23/c-0/15
msgctxt "Hoove"
msgid "That's not a vacuum's job. It's her own damn fault no one wants to play her anymore."
msgstr "C'est pas le boulot d'un aspirateur. Si plus personne ne veut jouer d'elle, c'est bien fait pour sa pomme."

# Traduction IA – à relire
#: hoove_vacuum/hoove_keyes_quest/0/c-0/23/c-0/23
msgctxt "Hoove"
msgid "If she were nicer, there wouldn't be any dust!"
msgstr "Si elle était plus aimable, il n'y aurait pas de poussière !"

# Traduction IA – à relire
#: hoove_vacuum/hoove_keyes_quest/0/c-0/23/c-0/34
msgctxt "Hoove"
msgid "Sorry. I just get worked up when people have attitude."
msgstr "Désolé. Je m'énerve quand les gens ont de l'attitude."

# Traduction IA – à relire
#: hoove_vacuum/hoove_keyes_quest/0/c-0/23/c-0/42/b/1
msgctxt "Hoove"
msgid "Like you."
msgstr "Comme toi."

# Traduction IA – à relire
#: hoove_vacuum/hoove_keyes_quest/0/c-0/23/c-0/45/b/1
msgctxt "Hoove"
msgid "Tell her I ain't interested."
msgstr "Dis-lui que ça ne m'intéresse pas."

# Traduction IA – à relire
#: hoove_vacuum/hoove_inanimals/0/0
msgctxt "Hoove"
msgid "You know Harper? The hamper?"
msgstr "Tu connais Harper ? Le panier à linge ?"

# Traduction IA – à relire
#: hoove_vacuum/hoove_inanimals/0/11/s/0
msgctxt "Choix"
msgid "Yeah...?"
msgstr "Ouais... ?"

# Traduction IA – à relire
#: hoove_vacuum/hoove_inanimals/0/12/s/0
msgctxt "Choix"
msgid "No, but I guess that's my hamper."
msgstr "Non, mais je crois que c'est mon panier à linge."

# Traduction IA – à relire
#: hoove_vacuum/hoove_inanimals/0/g-0/0
msgctxt "Hoove"
msgid "Well, recently, when I was cleaning up around her..."
msgstr "Eh bien, récemment, pendant que je faisais le ménage autour d'elle..."

# Traduction IA – à relire
#: hoove_vacuum/hoove_inanimals/0/g-0/8
msgctxt "Hoove"
msgid "I happened to see one of the inanimals!"
msgstr "Je suis tombé sur un des inanimaux !"

# Traduction IA – à relire
#: hoove_vacuum/hoove_inanimals/0/g-0/16
msgctxt "Hoove"
msgid "If you're looking for them, you might want to check that area."
msgstr "Si tu les cherches, tu devrais jeter un oeil dans ce coin."

# Traduction IA – à relire
#: hoove_vacuum/hoove_inanimals/0/g-0/24/s/0
msgctxt "Choix"
msgid "Thanks!"
msgstr "Merci !"

# Traduction IA – à relire
#: hoove_vacuum/hoove_inanimals/0/g-0/c-2/19/b/1
msgctxt "Hoove"
msgid "What's up?"
msgstr "Quoi de neuf ?"

# Traduction IA – à relire
#: hoove_vacuum/intro/0/0
msgctxt "Narrator"
msgid "There's something strange about the handsome figure you see standing before you—it's not his clothing, even though he does appear to be dressed in some sort of plastic armor."
msgstr "Quelque chose cloche chez le beau gosse qui se tient devant vous. Ce n'est pas sa tenue, même s'il semble vêtu d'une sorte d'armure en plastique."

# Traduction IA – à relire
#: hoove_vacuum/intro/0/8
msgctxt "Narrator"
msgid "No, it's something about his face... handsome though it may be, you can't quite place his expression."
msgstr "Non, c'est son visage... aussi séduisant soit-il, impossible de déchiffrer son expression."

# Traduction IA – à relire
#: hoove_vacuum/intro/0/16
msgctxt "Narrator"
msgid "Stranger still, he doesn't speak to you at all; he just stares, his face screwed up in concentration and his lips pressed together."
msgstr "Plus étrange encore, il ne vous adresse pas la parole ; il se contente de vous fixer, les traits crispés par la concentration et les lèvres serrées."

# Traduction IA – à relire
#: hoove_vacuum/intro/0/40
msgctxt "Hoove"
msgid "One sec!"
msgstr "Une seconde !"

# Traduction IA – à relire
#: hoove_vacuum/intro/0/67
msgctxt "Narrator"
msgid "He lets out the breath he's evidently been holding, bending forward with his hands on his hips as he inhales and exhales deeply."
msgstr "Il expire enfin le souffle qu'il retenait visiblement, se penche en avant, les mains sur les hanches, et respire profondément."

# Traduction IA – à relire
#: hoove_vacuum/intro/0/75
msgctxt "Hoove"
msgid "<w>...pheewwwwwwww.....</w>"
msgstr "<w>...pfiouuuuuuuu.....</w>"

# Traduction IA – à relire
#: hoove_vacuum/intro/0/86
msgctxt "Hoove"
msgid "Sorry about that. Just trying to see how long I could hold my breath for."
msgstr "Désolé. J'essayais de voir combien de temps je pouvais retenir ma respiration."

# Traduction IA – à relire
#: hoove_vacuum/intro/0/94/s/0
msgctxt "Choix"
msgid "Weird that I walked in on that."
msgstr "Bizarre que je tombe pile là-dessus."

# Traduction IA – à relire
#: hoove_vacuum/intro/0/95/s/0
msgctxt "Choix"
msgid "Seemed like a while!"
msgstr "Ça avait l'air long !"

# Traduction IA – à relire
#: hoove_vacuum/intro/0/96/s/0
msgctxt "Choix"
msgid "I regret coming here."
msgstr "Je regrette d'avoir mis les pieds ici."

# Traduction IA – à relire
#: hoove_vacuum/intro/0/c-0/7
msgctxt "Hoove"
msgid "It is super weird. You have the most bizarre timing."
msgstr "C'est super bizarre, oui. Tu as un timing vraiment étrange."

# Traduction IA – à relire
#: hoove_vacuum/intro/0/c-1/7
msgctxt "Hoove"
msgid "I'm up to 3 hours!"
msgstr "J'en suis à 3 heures !"

# Traduction IA – à relire
#: hoove_vacuum/intro/0/c-2/7
msgctxt "Hoove"
msgid "Oh! Thanks! Guess I'm getting tired."
msgstr "Oh ! Merci ! Je crois que je commence à fatiguer."

# Traduction IA – à relire
#: hoove_vacuum/intro/0/g-0/0
msgctxt "Hoove"
msgid "Alright! Now that that's taken care of..."
msgstr "Bon ! Maintenant que c'est réglé..."

# Traduction IA – à relire
#: hoove_vacuum/intro/0/g-0/8
msgctxt "Hoove"
msgid "I can give you my full attention!"
msgstr "Je peux te consacrer toute mon attention !"

# Traduction IA – à relire
#: hoove_vacuum/intro/0/g-0/16
msgctxt "Hoove"
msgid "Name's Hoover. My friends just call me 'Hoove,' though."
msgstr "Je m'appelle Hoover. Mes potes m'appellent juste Hoove, par contre."

# Traduction IA – à relire
#: hoove_vacuum/intro/0/g-0/27
msgctxt "Hoove"
msgid "You here to chat, or is there another incident to clean up?"
msgstr "Tu viens pour discuter, ou y a un autre incident à nettoyer ?"

# Traduction IA – à relire
#: hoove_vacuum/intro/0/g-0/35
msgctxt "Hoove"
msgid "Today was supposed to be my day off..."
msgstr "Aujourd'hui, c'était censé être mon jour de congé..."

# Traduction IA – à relire
#: hoove_vacuum/intro/0/g-0/43/s/0
msgctxt "Choix"
msgid "I'd love to chat."
msgstr "J'adorerais discuter."

# Traduction IA – à relire
#: hoove_vacuum/intro/0/g-0/44/s/0
msgctxt "Choix"
msgid "I <i>might</i> have dropped a whole packet of wet noodles..."
msgstr "J'ai <i>peut-être</i> renversé un paquet entier de nouilles mouillées..."

# Traduction IA – à relire
#: hoove_vacuum/intro/0/g-0/c-3/7
msgctxt "Hoove"
msgid "Sure! What about?"
msgstr "Bien sûr ! De quoi ?"

# Traduction IA – à relire
#: hoove_vacuum/intro/0/g-0/c-4/7
msgctxt "Hoove"
msgid "Oh no... they're wet?"
msgstr "Oh non... elles sont mouillées ?"

# Traduction IA – à relire
#: hoove_vacuum/intro/0/g-0/c-4/18/0/s/0
msgctxt "Choix"
msgid "On the stairs. And then stepped on them."
msgstr "Dans l'escalier. Et ensuite j'ai marché dessus."

# Traduction IA – à relire
#: hoove_vacuum/intro/0/g-0/c-4/18/1/s/0
msgctxt "Choix"
msgid "I'm just kidding!"
msgstr "Je rigole !"

# Traduction IA – à relire
#: hoove_vacuum/intro/0/g-0/c-4/18/c-0/7
msgctxt "Hoove"
msgid "W-wha wha WHAT were you doing with noodles on stairs! They don't belong there!"
msgstr "Q-quoi quoi QUOI, tu faisais quoi avec des nouilles dans l'escalier ! Elles n'ont rien à y faire !"

# Traduction IA – à relire
#: hoove_vacuum/intro/0/g-0/c-4/18/c-0/15
msgctxt "Hoove"
msgid "Sigh."
msgstr "Soupir."

# Traduction IA – à relire
#: hoove_vacuum/intro/0/g-0/c-4/18/c-0/23
msgctxt "Hoove"
msgid "It's not up to me to make sense of it. Just there to be the point of contact on the scene."
msgstr "C'est pas à moi de comprendre. Je suis juste là pour être le premier contact sur la scène."

# Traduction IA – à relire
#: hoove_vacuum/intro/0/g-0/c-4/18/c-0/31
msgctxt "Hoove"
msgid "Guess I'll try to make a little more room in this bag."
msgstr "Je vais essayer de faire un peu plus de place dans ce sac."

# Traduction IA – à relire
#: hoove_vacuum/intro/0/g-0/c-4/18/c-0/39/0/s/0
msgctxt "Choix"
msgid "It was just a joke, Hoove. You can relax!"
msgstr "C'était une blague, Hoove. Tu peux te détendre !"

# Traduction IA – à relire
#: hoove_vacuum/intro/0/g-0/c-4/18/c-0/39/1/s/0
msgctxt "Choix"
msgid "I'll just watch while you clean up with those big muscles of yours..."
msgstr "Je vais juste regarder pendant que tu nettoies avec tes gros muscles..."

# Traduction IA – à relire
#: hoove_vacuum/intro/0/g-0/c-4/18/c-0/39/c-0/7
msgctxt "Hoove"
msgid "What? Oh man! You had me going there!"
msgstr "Quoi ? Oh la vache ! Tu m'as bien eu !"

# Traduction IA – à relire
#: hoove_vacuum/intro/0/g-0/c-4/18/c-0/39/c-0/18
msgctxt "Hoove"
msgid "Gotta say, I'm relieved!"
msgstr "Je dois dire que je suis soulagé !"

# Traduction IA – à relire
#: hoove_vacuum/intro/0/g-0/c-4/18/c-0/39/c-1/7
msgctxt "Hoove"
msgid "Heh. Can't say I don't like that kinda talk."
msgstr "Héhé. Je peux pas dire que ce genre de discours me déplaise."

# Traduction IA – à relire
#: hoove_vacuum/intro/0/g-0/c-4/18/c-1/7
msgctxt "Hoove"
msgid "You are? Haha! You had me there for a second..."
msgstr "Vraiment ? Haha ! Tu m'as eu, une seconde..."

# Traduction IA – à relire
#: hoove_vacuum/intro/0/g-0/c-4/18/c-1/15
msgctxt "Hoove"
msgid "Have to say I'm relieved though."
msgstr "Je dois dire que ça me soulage, quand même."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/0/s/0
msgctxt "Choix"
msgid "I've been looking for some inanimals... Seen any?"
msgstr "Je cherche des inanimaux... Tu en as vu ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/1/s/0
msgctxt "Choix"
msgid "I'll bet you've been all over the house!"
msgstr "Je parie que tu es passé partout dans la maison !"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/2/s/0
msgctxt "Choix"
msgid "So you're the one who is the investigator?"
msgstr "Alors c'est toi, l'enquêteur ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/3/s/0
msgctxt "Choix"
msgid "You seem tired."
msgstr "Tu as l'air fatigué."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-0/11
msgctxt "Narrator"
msgid "He taps his fingers on his chin, considering."
msgstr "Il se tapote le menton du bout des doigts, pensif."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-0/19
msgctxt "Hoove"
msgid "Hmmm... Maybe..."
msgstr "Hmmm... Peut-être..."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-0/27/0/s/0
msgctxt "Choix"
msgid "Visualization is an excellent memory aid!"
msgstr "La visualisation, c'est excellent pour la mémoire !"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-0/27/1/s/0
msgctxt "Choix"
msgid "Anything?"
msgstr "Quelque chose ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-0/27/2/s/0
msgctxt "Choix"
msgid "Maybe if you retraced your route?"
msgstr "Et si tu refaisais ton trajet ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-0/27/c-0/7
msgctxt "Hoove"
msgid "Oh, oh! Let me try that... Ah! Ok!"
msgstr "Oh, oh ! Laisse-moi essayer... Ah ! Ok !"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-0/27/c-1/7
msgctxt "Hoove"
msgid "Dang... Sorry. Nothing coming up!"
msgstr "Zut... Désolé. Rien qui me revient !"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-0/27/c-2/7
msgctxt "Hoove"
msgid "I'd love to but... I'm a little tired today."
msgstr "J'adorerais mais... je suis un peu fatigué aujourd'hui."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-0/27/c-2/15
msgctxt "Hoove"
msgid "Sorry!"
msgstr "Désolé !"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-1/11
msgctxt "Hoove"
msgid "You know it! I've been everywhere except the crawlspace, I think!"
msgstr "Tu parles ! J'ai écumé toute la maison, sauf le vide sanitaire, je crois !"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-1/19
msgctxt "Hoove"
msgid "I mean you never know, there are always places I might not know about."
msgstr "Enfin, on ne sait jamais, il y a toujours des endroits que je ne connais pas."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-1/27
msgctxt "Hoove"
msgid "I have heard rumors about a haunted attic..."
msgstr "J'ai entendu des rumeurs sur un grenier hanté..."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-1/35
msgctxt "Hoove"
msgid "But I'm sure that's nothing but hearsay!"
msgstr "Mais je suis sûr que ce ne sont que des on-dit !"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-1/43/0/s/0
msgctxt "Choix"
msgid "Did you say 'haunted attic?'"
msgstr "Tu as bien dit « grenier hanté » ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-1/43/1/s/0
msgctxt "Choix"
msgid "I haven't been to the crawlspace either..."
msgstr "Je ne suis pas allé dans le vide sanitaire non plus..."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-1/43/c-0/7
msgctxt "Hoove"
msgid "Did I? Just a rumor, I'm sure."
msgstr "Moi ? Juste une rumeur, j'imagine."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-1/43/c-1/7
msgctxt "Hoove"
msgid "A mystery that will never be solved. Trust me."
msgstr "Un mystère qui ne sera jamais résolu. Crois-moi."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/11
msgctxt "Hoove"
msgid "That's right - Grime Scene Investigation."
msgstr "Exactement : Investigation sur Scène de Crasse."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/22
msgctxt "Hoove"
msgid "I love my work, but it can be hard to put it away at times."
msgstr "J'adore mon boulot, mais il est parfois difficile de le laisser de côté."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/30
msgctxt "Hoove"
msgid "I do tend to keep it all in my bag."
msgstr "J'ai tendance à tout garder dans mon sac."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/0/s/0
msgctxt "Choix"
msgid "Looks... big."
msgstr "Il a l'air... gros."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/1/s/0
msgctxt "Choix"
msgid "Seems pretty full."
msgstr "Il a l'air plutôt plein."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/2/s/0
msgctxt "Choix"
msgid "What kind of stuff do you investigate?"
msgstr "Quel genre de trucs tu fais comme enquêtes ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-0/7
msgctxt "Hoove"
msgid "Oh, it is. Big enough to take whatever needs taking."
msgstr "Oh, il l'est. Assez grand pour avaler tout ce qui doit l'être."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-0/15/0/s/0
msgctxt "Choix"
msgid "And... um... How do you 'take it?'"
msgstr "Et... euh... comment tu fais pour « avaler » ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-0/15/1/s/0
msgctxt "Choix"
msgid "I meant like, it looks like your bag needs to be emptied."
msgstr "Je voulais dire que ton sac a l'air d'avoir besoin d'être vidé."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-0/15/c-0/7
msgctxt "Hoove"
msgid "I'm all purpose, on whatever surface, baby!"
msgstr "Je suis polyvalent, sur n'importe quelle surface, bébé !"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-0/15/c-0/15
msgctxt "Hoove"
msgid "Hard or soft, rough or smooth, I can do it any way it needs to be done."
msgstr "Dur ou mou, rugueux ou lisse, je peux le faire de toutes les façons qu'il faut."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-0/15/c-0/23
msgctxt "Hoove"
msgid "Only thing I'm not so good with is liquid..."
msgstr "Le seul truc où je suis nul, c'est le liquide..."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-0/15/c-0/31/0/s/0
msgctxt "Choix"
msgid "Ah, yes. Spills. We're talking about spills, of course."
msgstr "Ah, oui. Les dégâts des eaux. On parle de dégâts des eaux, bien sûr."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-0/15/c-0/31/c-0/7
msgctxt "Hoove"
msgid "What else would we be talking about?"
msgstr "De quoi d'autre on parlerait ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-0/15/c-0/31/c-0/15/0/s/0
msgctxt "Choix"
msgid "Nothing."
msgstr "De rien."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-0/15/c-0/31/c-0/15/1/s/0
msgctxt "Choix"
msgid "Just... Um... Other dirty things."
msgstr "Juste... euh... d'autres trucs sales."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-0/15/c-0/31/c-0/15/c-0/7
msgctxt "Hoove"
msgid "Huh. Ok!"
msgstr "Hein. Ok !"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-0/15/c-0/31/c-0/15/c-1/7
msgctxt "Hoove"
msgid "Right! Exactly. My specialty."
msgstr "Ah ! Exactement. Ma spécialité."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-0/15/c-0/31/c-0/15/c-1/15
msgctxt "Hoove"
msgid "Investigating dirt."
msgstr "Enquêter sur la saleté."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-0/15/c-0/31/c-0/15/c-1/23
msgctxt "Hoove"
msgid "And other things."
msgstr "Et sur d'autres choses."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-0/15/c-1/7
msgctxt "Hoove"
msgid "Oh this? No, plenty of room left!"
msgstr "Oh, ça ? Non, il reste plein de place !"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-0/15/c-1/18
msgctxt "Hoove"
msgid "But let's chat about something else."
msgstr "Mais parlons d'autre chose."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-1/7
msgctxt "Hoove"
msgid "Oh, there's plenty of room in there."
msgstr "Oh, il y a plein de place là-dedans."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-1/15/0/s/0
msgctxt "Choix"
msgid "Really? Looks ready to burst!"
msgstr "Vraiment ? On dirait qu'il va exploser !"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-1/15/1/s/0
msgctxt "Choix"
msgid "Guess you'd know better than me."
msgstr "Tu dois mieux le savoir que moi."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-1/15/c-0/7
msgctxt "Hoove"
msgid "This old thing?"
msgstr "Ce vieux machin ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-1/15/c-0/15
msgctxt "Hoove"
msgid "Nah... It's... It's fine."
msgstr "Nan... C'est... C'est bon."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-1/15/c-0/26
msgctxt "Hoove"
msgid "Let's change the topic."
msgstr "Changeons de sujet."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-1/15/c-1/7
msgctxt "Hoove"
msgid "Yeah... Maybe."
msgstr "Ouais... Peut-être."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-2/7
msgctxt "Hoove"
msgid "You wouldn't believe the sorts of things I'm called for to check out!"
msgstr "Tu ne croirais pas les trucs pour lesquels on m'appelle !"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-2/15
msgctxt "Hoove"
msgid "The evidence I pick up gets to be real interesting sometimes..."
msgstr "Les preuves que je ramasse sont parfois super intéressantes..."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-2/23
msgctxt "Hoove"
msgid "Hair, bits of your dead skin, fingernail clippings..."
msgstr "Des cheveux, des bouts de ta peau morte, des rognures d'ongles..."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-2/31/0/s/0
msgctxt "Choix"
msgid "That's... embarrassing."
msgstr "C'est... gênant."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-2/31/1/s/0
msgctxt "Choix"
msgid "Ok, ok, what else?"
msgstr "Ok, ok, quoi d'autre ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-2/31/c-0/7 hoove_vacuum/HooveChat1/0/c-2/38/c-2/31/c-1/15/c-0/7
msgctxt "Hoove"
msgid "I don't mind! Part of the job."
msgstr "Ça me dérange pas ! Ça fait partie du boulot."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-2/31/c-1/7
msgctxt "Hoove"
msgid "Did I mention lots of your hair?"
msgstr "Je t'ai dit qu'il y avait plein de tes cheveux ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-2/31/c-1/15/0/s/0
msgctxt "Choix"
msgid "YES."
msgstr "OUI."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-2/31/c-1/15/1/s/0
msgctxt "Choix"
msgid "Youdidnowpleasenevermentionitagain."
msgstr "Tul'asditsilteplaîtnelerediplusjamais."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-2/31/c-1/15/c-1/7
msgctxt "Hoove"
msgid "Haha! Alright. Got it!"
msgstr "Haha ! Très bien. Compris !"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-2/31/g-0/0
msgctxt "Hoove"
msgid "I also end up finding buttons, lint, paper clips, coins..."
msgstr "Je finis aussi par trouver des boutons, des peluches, des trombones, des pièces..."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-2/31/g-0/8
msgctxt "Hoove"
msgid "You name it!"
msgstr "Tout ce que tu veux !"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-2/31/g-0/16
msgctxt "Hoove"
msgid "If it's smaller than a quarter, I've probably got one somewhere in here."
msgstr "Si c'est plus petit qu'une pièce de monnaie, j'en ai sûrement un exemplaire quelque part là-dedans."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-2/31/g-0/24/s/0
msgctxt "Choix"
msgid "What if you run out of space?"
msgstr "Et si tu n'as plus de place ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-2/31/g-0/25/s/0
msgctxt "Choix"
msgid "Seems like you're packed pretty full."
msgstr "Tu as l'air plutôt bien rempli."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-2/31/g-1/0
msgctxt "Hoove"
msgid "I wouldn't worry about that!"
msgstr "Je m'en ferais pas pour ça !"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-2/38/c-2/31/g-1/8
msgctxt "Hoove"
msgid "Plenty of room, still."
msgstr "Il reste encore plein de place."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/11
msgctxt "Hoove"
msgid "Yeah, a bit. It's been a long week."
msgstr "Ouais, un peu. La semaine a été longue."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/19
msgctxt "Hoove"
msgid "But I enjoy working hard!"
msgstr "Mais j'aime bosser dur !"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/27
msgctxt "Hoove"
msgid "Makes that can of oil at the end of the day taste all that much better."
msgstr "Ça rend la canette d'huile de fin de journée encore meilleure."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/35/0/s/0
msgctxt "Choix"
msgid "What's the hardest part about your job?"
msgstr "C'est quoi, le plus dur dans ton métier ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/35/1/s/0
msgctxt "Choix"
msgid "What do you enjoy most about the work?"
msgstr "Qu'est-ce que tu préfères dans ce travail ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/35/2/s/0
msgctxt "Choix"
msgid "What do you do for fun?"
msgstr "Qu'est-ce que tu fais pour t'amuser ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/35/c-0/7
msgctxt "Hoove"
msgid "Hmm. Probably trying to get stuff out from under Koa!"
msgstr "Hmm. Probablement sortir des trucs de sous Koa !"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/35/c-0/18
msgctxt "Hoove"
msgid "Sometimes he can be a bit <i>too</i> easy going..."
msgstr "Des fois, il est un peu <i>trop</i> décontracté..."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/35/c-0/26
msgctxt "Hoove"
msgid "He just lies there and I've gotta work hard to clean up around him."
msgstr "Il reste allongé là et je dois bosser dur pour nettoyer autour de lui."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/35/c-0/34
msgctxt "Hoove"
msgid "But I love the guy. Can't help but admire his chill!"
msgstr "Mais je l'adore, ce gars. Je ne peux qu'admirer son calme !"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/35/c-1/7
msgctxt "Hoove"
msgid "I love making the rounds and saying hi to everyone."
msgstr "J'adore faire ma tournée et dire bonjour à tout le monde."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/35/c-1/15
msgctxt "Hoove"
msgid "My job makes it so that I can spend time all around the house."
msgstr "Grâce à mon boulot, je peux passer du temps partout dans la maison."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/35/c-1/23
msgctxt "Hoove"
msgid "And that's really nice."
msgstr "Et c'est vraiment agréable."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/35/c-1/31
msgctxt "Hoove"
msgid "I have a chance to see all my favorite folks!"
msgstr "J'ai l'occasion de voir tous mes gens préférés !"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/35/c-1/39
msgctxt "Hoove"
msgid "Keeps me from feeling... empty."
msgstr "Ça m'évite de me sentir... vide."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/35/c-1/47/0/s/0
msgctxt "Choix"
msgid "Do you have a favorite object in the house?"
msgstr "Tu as un objet préféré dans la maison ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/35/c-1/47/1/s/0
msgctxt "Choix"
msgid "Is feeling empty a thing you worry about?"
msgstr "Te sentir vide, c'est quelque chose qui t'inquiète ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/35/c-1/47/c-0/7
msgctxt "Hoove"
msgid "Couldn't pick if I tried!"
msgstr "Impossible de choisir, même en essayant !"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/35/c-1/47/c-0/15
msgctxt "Hoove"
msgid "I've always had a soft spot for ol' Bobby Pinn..."
msgstr "J'ai toujours eu un faible pour ce bon vieux Bobby Pinn..."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/35/c-1/47/c-0/23
msgctxt "Hoove"
msgid "We had history once upon a time."
msgstr "On a un passé commun, il fut un temps."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/35/c-1/47/c-0/31
msgctxt "Hoove"
msgid "Nothing romantic, just a deep friendship in another life."
msgstr "Rien de romantique, juste une profonde amitié dans une autre vie."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/35/c-1/47/c-0/39
msgctxt "Hoove"
msgid "But I love everyone here!"
msgstr "Mais j'aime tout le monde ici !"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/35/c-1/47/c-0/47
msgctxt "Hoove"
msgid "I'm easy going like that."
msgstr "Je suis comme ça, facile à vivre."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/35/c-1/47/c-0/55/0/s/0
msgctxt "Choix"
msgid "Tell me more about Bobby Pinn."
msgstr "Parle-moi plus de Bobby Pinn."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/35/c-1/47/c-0/55/1/s/0
msgctxt "Choix"
msgid "You sure about that? Nothing hidden in your bag?"
msgstr "Tu es sûr de ça ? Rien de caché dans ton sac ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/35/c-1/47/c-0/55/2/s/0
msgctxt "Choix"
msgid "I guess you are!"
msgstr "Je suppose que oui !"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/35/c-1/47/c-0/55/c-0/7
msgctxt "Hoove"
msgid "About our relationship? Hmm."
msgstr "Notre relation ? Hmm."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/35/c-1/47/c-0/55/c-0/15
msgctxt "Hoove"
msgid "I had them hiding away in my bag, but they left recently to 'find the next big thing'."
msgstr "Iel se cachait dans mon sac, mais iel est parti·e récemment « chercher la prochaine grande chose »."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/35/c-1/47/c-0/55/c-0/23
msgctxt "Hoove"
msgid "Which is odd because they're pretty small. If you haven't talked to them yet I'd get as close to the ground as you can."
msgstr "Ce qui est bizarre, vu qu'iel est plutôt petit·e. Si tu ne lui as pas encore parlé, mets-toi le plus près du sol possible."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/35/c-1/47/c-0/55/c-1/7
msgctxt "Hoove"
msgid "There's a lot more to this house than meets the eye, my friend..."
msgstr "Il y a bien plus dans cette maison qu'il n'y paraît, {{mon ami|mon amie|mon ami·e}}..."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/35/c-1/47/c-1/7
msgctxt "Hoove"
msgid "Oh... I mean... Not a lot."
msgstr "Oh... enfin... pas tant que ça."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/35/c-1/47/c-1/15
msgctxt "Hoove"
msgid "I'm just glad I've got friends around, that's all."
msgstr "Je suis juste content d'avoir des amis autour de moi, c'est tout."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/35/c-2/7
msgctxt "Hoove"
msgid "Well, I used to do a lot of things for fun..."
msgstr "Eh bien, avant, je faisais plein de choses pour m'amuser..."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/35/c-2/15
msgctxt "Hoove"
msgid "I used to love watching a good game."
msgstr "J'adorais regarder un bon match."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/35/c-2/23
msgctxt "Hoove"
msgid "Especially with fellow fans!"
msgstr "Surtout avec d'autres fans !"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/35/c-2/31
msgctxt "Hoove"
msgid "And sometimes I'd have a drink after a long day's work."
msgstr "Et parfois, je m'offrais un verre après une longue journée de boulot."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/35/c-2/39
msgctxt "Hoove"
msgid "But these days, I don't know. I've just felt a bit too... cluttered."
msgstr "Mais ces temps-ci, je sais pas. Je me sens juste un peu trop... encombré."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/c-3/35/c-2/47
msgctxt "Hoove"
msgid "Nothing to worry about though!"
msgstr "Rien d'inquiétant, cela dit !"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/g-0/0
msgctxt "Hoove"
msgid "Hey, it's been great talking to you..."
msgstr "Hé, c'était super de discuter avec toi..."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/g-0/8
msgctxt "Hoove"
msgid "But I gotta finish up my work and call it a day."
msgstr "Mais je dois finir mon travail et en rester là pour aujourd'hui."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/g-0/16
msgctxt "Hoove"
msgid "How about you come back and see me next time you've got a minute?"
msgstr "Et si tu repassais me voir quand tu auras une minute ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/g-0/24
msgctxt "Hoove"
msgid "I feel like I haven't gotten out to do something fun in a while."
msgstr "J'ai l'impression que ça fait longtemps que je ne suis pas sorti faire un truc sympa."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/g-0/32
msgctxt "Hoove"
msgid "And maybe the two of us could..."
msgstr "Et peut-être que tous les deux, on pourrait..."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/g-0/40
msgctxt "Hoove"
msgid "I don't know... catch a game or have a drink?"
msgstr "Je sais pas... regarder un match ou boire un verre ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/g-0/48/s/0
msgctxt "Choix"
msgid "Sounds good!"
msgstr "Ça marche !"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/g-0/49/s/0
msgctxt "Choix"
msgid "See you soon, Hoove!"
msgstr "À bientôt, Hoove !"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/g-0/50/s/0
msgctxt "Choix"
msgid "I'd love to go some place with you!"
msgstr "J'adorerais aller quelque part avec toi !"

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/g-0/c-4/7
msgctxt "Hoove"
msgid "It's a promise."
msgstr "C'est promis."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/g-0/c-5/7
msgctxt "Hoove"
msgid "You got it! Anything needs investigating lemme know."
msgstr "Comme tu veux ! S'il y a un truc à enquêter, dis-le-moi."

# Traduction IA – à relire
#: hoove_vacuum/HooveChat1/0/g-0/c-6/7
msgctxt "Hoove"
msgid "Sounds like a plan."
msgstr "Ça me paraît un bon plan."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter2/0/4
msgctxt "Hoove"
msgid "Ayyyyyy! Nice to see you again!"
msgstr "Ayyyyyy ! Content de te revoir !"

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter2/0/12
msgctxt "Hoove"
msgid "Uh..."
msgstr "Euh..."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter2/0/20
msgctxt "Narrator"
msgid "Hoove holds one finger up to you, his chest rising and falling with panted breaths. He bends over, both hands on his knees, his forehead and cheeks shining."
msgstr "Hoove lève un doigt vers vous, la poitrine qui se soulève au rythme de son souffle haletant. Il se plie en deux, les mains sur les genoux, le front et les joues luisants."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter2/0/28
msgctxt "Hoove"
msgid "Gimme... Just a sec."
msgstr "Donne-moi... juste une seconde."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter2/0/39/s/0
msgctxt "Choix"
msgid "You okay...?"
msgstr "Ça va... ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter2/0/41/s/0
msgctxt "Choix"
msgid "Oh no, do I need to call Farya?"
msgstr "Oh non, il faut que j'appelle Farya ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter2/0/c-0/7
msgctxt "Hoove"
msgid "... yep!"
msgstr "... ouais !"

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter2/0/c-2/7
msgctxt "Hoove"
msgid "Not... just yet..."
msgstr "Pas... tout de suite..."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter2/0/g-0/0
msgctxt "Hoove"
msgid "Whew! Ok. That was... A little difficult!"
msgstr "Ouf ! Ok. C'était... un peu difficile !"

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter2/0/g-0/8/s/0
msgctxt "Choix"
msgid "Talking is hard for you?"
msgstr "Parler, c'est dur pour toi ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter2/0/g-0/9/s/0
msgctxt "Choix"
msgid "You seem pretty winded."
msgstr "Tu as l'air plutôt essoufflé."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter2/0/g-0/10/s/0
msgctxt "Choix"
msgid "Why don't you take a break?"
msgstr "Pourquoi tu ne prendrais pas une pause ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter2/0/g-0/11/s/0
msgctxt "Choix"
msgid "You're all... Sweaty..."
msgstr "Tu es tout... en sueur..."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter2/0/g-0/c-3/7
msgctxt "Hoove"
msgid "I just get a little excited sometimes... that's all."
msgstr "Je m'emballe parfois un peu, c'est tout."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter2/0/g-0/c-4/7
msgctxt "Hoove"
msgid "Phew... yeah, seems like my suction is a little light right now."
msgstr "Ouf... ouais, on dirait que mon aspiration est un peu faible en ce moment."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter2/0/g-0/c-4/15
msgctxt "Hoove"
msgid "Maybe I better take a second to catch my breath."
msgstr "Je ferais peut-être mieux de reprendre mon souffle une seconde."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter2/0/g-0/c-5/7
msgctxt "Hoove"
msgid "Yeah, I guess I ought to sit down for a minute."
msgstr "Ouais, je crois que je ferais bien de m'asseoir une minute."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter2/0/g-0/c-6/7
msgctxt "Hoove"
msgid "Oh, am I?"
msgstr "Oh, vraiment ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter2/0/g-0/c-6/15
msgctxt "Hoove"
msgid "Guess I'll have to towel off sometime soon.."
msgstr "Je vais devoir me sécher avec une serviette bientôt..."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter2/0/g-1/0
msgctxt "Hoove"
msgid "So, what brings you by?"
msgstr "Alors, qu'est-ce qui t'amène ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter2/0/g-1/8/s/0
msgctxt "Choix"
msgid "I was thinking we could do something together."
msgstr "Je pensais qu'on pourrait faire un truc ensemble."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter2/0/g-1/9/s/0
msgctxt "Choix"
msgid "I just wanted to get to know you a bit."
msgstr "Je voulais juste apprendre à mieux te connaître."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter2/0/g-1/c-7/7
msgctxt "Hoove"
msgid "I'd love that! What did you have in mind?"
msgstr "J'adorerais ! Tu avais quoi en tête ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter2/0/g-1/c-7/18
msgctxt "Hoove"
msgid "Not sure if I mentioned it last time, but I'm a big sports fan!"
msgstr "Je sais pas si je te l'ai dit la dernière fois, mais je suis un gros fan de sport !"

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter2/0/g-1/c-7/26
msgctxt "Hoove"
msgid "And I'll never turn down a nice can of lubricant."
msgstr "Et je ne dis jamais non à une bonne canette de lubrifiant."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter2/0/g-1/c-7/34
msgctxt "Hoove"
msgid "As long as I'm not on the job..."
msgstr "Tant que je suis pas en service..."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter2/0/g-1/c-7/42/0/s/0
msgctxt "Choix"
msgid "It's five o'clock somewhere! How about a drink?"
msgstr "Il est cinq heures quelque part ! Et si on prenait un verre ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter2/0/g-1/c-7/42/1/s/0
msgctxt "Choix"
msgid "Ooh! Is there a game on?"
msgstr "Ooh ! Il y a un match ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter2/0/g-1/c-8/7 hoove_vacuum/HooveLetGo2_pre/0/c-0/7 hoove_vacuum/HooveHanksWin/0/g-0/c-4/7
msgctxt "Hoove"
msgid "I'd love that!"
msgstr "J'adorerais !"

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter2/0/g-1/c-8/15
msgctxt "Hoove"
msgid "Wanna go somewhere, first, though? I'd love to do something fun!"
msgstr "Mais on irait d'abord quelque part ? J'ai envie de faire un truc sympa !"

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter2/0/g-1/c-8/23
msgctxt "Hoove"
msgid "Truth is I haven't been out in a while to do anything fun."
msgstr "La vérité, c'est que ça fait longtemps que je ne suis pas sorti m'amuser."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter2/0/g-1/c-8/31
msgctxt "Hoove"
msgid "Kinda on the go because of my job."
msgstr "Je suis un peu tout le temps en déplacement à cause de mon boulot."

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter2/0/g-1/c-8/39/0/s/0
msgctxt "Choix"
msgid "Let's just be homebodies and chat here!"
msgstr "Restons casaniers et discutons ici !"

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter2/0/g-1/c-8/39/1/s/0
msgctxt "Choix"
msgid "Maybe we go get a drink?"
msgstr "On irait peut-être boire un verre ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter2/0/g-1/c-8/39/2/s/0
msgctxt "Choix"
msgid "How about catching a game? Is one on?"
msgstr "Et si on regardait un match ? Il y en a un ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveEncounter2/0/g-1/c-8/39/c-0/7
msgctxt "Hoove"
msgid "Huh... I guess that would be alright."
msgstr "Hein... Je suppose que ça irait."

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/4
msgctxt "Hoove"
msgid "You read my mind. Let's crack a can..."
msgstr "Tu lis dans mes pensées. Ouvrons une canette..."

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/15
msgctxt "Narrator"
msgid "Hoove hands you a martini glass filled with a suspiciously dark liquid. It smells like alcohol, sure, but there's another strange scent you can't quite place..."
msgstr "Hoove vous tend un verre à martini rempli d'un liquide suspicieusement sombre. Ça sent l'alcool, certes, mais il y a une autre odeur étrange que vous n'arrivez pas à identifier..."

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/23
msgctxt "Hoove"
msgid "Cheers!"
msgstr "Santé !"

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/31 hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/43/c-2/59/c-2/37 hoove_vacuum/HooveHaveaDrink2/0/g-0/c-4/21 hoove_vacuum/HooveFriendMeet/0/c-1/10
msgctxt "Hoove"
msgid "<w>glug glug glug</w>"
msgstr "<w>glou glou glou</w>"

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/39
msgctxt "Hoove"
msgid "Mmmmm."
msgstr "Mmmmm."

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/56
msgctxt "Narrator"
msgid "The drink tastes distinctly like the scent of motor oil, and it leaves an unpleasantly greasy feeling behind."
msgstr "La boisson a clairement un goût d'huile de moteur et laisse une désagréable sensation de gras."

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/64/s/0
msgctxt "Choix"
msgid "That's delicious!"
msgstr "C'est délicieux !"

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/65/s/0
msgctxt "Choix"
msgid "Hmm. Tastes like... Lubrication."
msgstr "Hmm. Ça a le goût de... lubrification."

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/66/s/0
msgctxt "Choix"
msgid "Bit greasy for my taste."
msgstr "Un peu gras à mon goût."

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/c-0/7
msgctxt "Hoove"
msgid "It's a craft-brew. Got a few drops of engine oil in the mix."
msgstr "C'est une bière artisanale. Avec quelques gouttes d'huile de vidange dans le mélange."

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/c-0/15
msgctxt "Hoove"
msgid "Really gets my motor running."
msgstr "Ça me fait vraiment tourner le moteur."

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/c-1/7
msgctxt "Hoove"
msgid "I know! Isn't it great?"
msgstr "Je sais ! C'est génial, non ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/c-2/7
msgctxt "Hoove"
msgid "The grease is my favorite part!"
msgstr "Le gras, c'est ce que je préfère !"

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/3
msgctxt "Hoove"
msgid "So, how are you feeling?"
msgstr "Alors, comment tu te sens ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/11/s/0
msgctxt "Choix"
msgid "Like I'd like to know more about you."
msgstr "J'aimerais en savoir plus sur toi."

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/12/s/0
msgctxt "Choix"
msgid "I feel like watching a game. Isn't there one tonight?"
msgstr "J'ai envie de regarder un match. Il n'y en a pas un ce soir ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/13/s/0
msgctxt "Choix"
msgid "Like I want another!"
msgstr "J'en veux un autre !"

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/7
msgctxt "Hoove"
msgid "Round two, coming up!"
msgstr "Deuxième tournée, ça arrive !"

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/18
msgctxt "Hoove"
msgid "<w>glug glug</w>"
msgstr "<w>glou glou</w>"

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/26
msgctxt "Hoove"
msgid "Ahh... Ooo, nice buzz goin now..."
msgstr "Ahh... Ooo, c'est bon, cette petite ivresse..."

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/43/0/s/0
msgctxt "Choix"
msgid "Say... Didn't you say there was a game tonight?"
msgstr "Dis... Tu n'avais pas parlé d'un match ce soir ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/43/1/s/0
msgctxt "Choix"
msgid "Me too. Let's eat some snacks and get to know each other better..."
msgstr "Moi aussi. Mangeons des trucs à grignoter et apprenons à mieux nous connaître..."

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/43/2/s/0
msgctxt "Choix"
msgid "How about another? On me this time!"
msgstr "Et un autre ? C'est ma tournée, cette fois !"

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/43/c-2/7
msgctxt "Hoove"
msgid "That kinda night, huh? I'm game!"
msgstr "C'est ce genre de soirée, hein ? Je suis partant !"

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/43/c-2/15
msgctxt "Hoove"
msgid "Bottom's up!"
msgstr "Cul sec !"

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/43/c-2/26
msgctxt "Hoove"
msgid "<w>gluggity gluggity glug</w>"
msgstr "<w>glougli glougli glou</w>"

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/43/c-2/34
msgctxt "Narrator"
msgid "Hoove looks relaxed... perhaps a bit too relaxed."
msgstr "Hoove a l'air détendu... peut-être un peu trop détendu."

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/43/c-2/42
msgctxt "Hoove"
msgid "Whew... Definitely feelin' it now."
msgstr "Ouf... Là, je le sens bien."

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/43/c-2/59/0/s/0
msgctxt "Choix"
msgid "Didn't you say there was a game tonight?"
msgstr "Tu n'avais pas dit qu'il y avait un match ce soir ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/43/c-2/59/1/s/0
msgctxt "Choix"
msgid "Maybe we take a break and get to know each other a bit?"
msgstr "Et si on faisait une pause pour mieux se connaître ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/43/c-2/59/2/s/0
msgctxt "Choix"
msgid "Can't stop at three!"
msgstr "On ne peut pas s'arrêter à trois !"

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/43/c-2/59/c-2/7
msgctxt "Hoove"
msgid "I mean we could."
msgstr "Je veux dire, on pourrait."

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/43/c-2/59/c-2/15
msgctxt "Hoove"
msgid "But why WOULD we?!"
msgstr "Mais POURQUOI on le ferait ?!"

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/43/c-2/59/c-2/23
msgctxt "Hoove"
msgid "Let's goooo!"
msgstr "Allons-y !"

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/43/c-2/59/c-2/45
msgctxt "Narrator"
msgid "Hoove is beginning to look unsteady on his feet. It seems clear he's gone past the point of 'buzzed' and is beginning to cross over into 'wasted'."
msgstr "Hoove commence à tituber. Il est clair qu'il a dépassé le stade « pompette » et qu'il glisse vers le « complètement cuit »."

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/43/c-2/59/c-2/53
msgctxt "Hoove"
msgid "This was a <w>hic</w> great idea."
msgstr "C'était une <w>hic</w> super idée."

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/43/c-2/59/c-2/67
msgctxt "Hoove"
msgid "I'm ready to <w>hic</w> have another... Zzzzz"
msgstr "Je suis prêt à <w>hic</w> en reprendre un... Zzzzz"

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/43/c-2/59/c-2/81/0/s/0
msgctxt "Choix"
msgid "Hoove? You alright?"
msgstr "Hoove ? Ça va ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/43/c-2/59/c-2/81/1/s/0
msgctxt "Choix"
msgid "Wake up!"
msgstr "Réveille-toi !"

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/43/c-2/59/c-2/81/g-0/0
msgctxt "Hoove"
msgid "Huh? What? Where am I?"
msgstr "Hein ? Quoi ? Où je suis ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/43/c-2/59/c-2/81/g-0/11
msgctxt "Hoove"
msgid "Did the badger make it to the microwave?"
msgstr "Le blaireau a réussi à atteindre le micro-ondes ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/43/c-2/59/c-2/81/g-0/19/0/s/0
msgctxt "Choix"
msgid "I think you might be drunk... I think I might be drunk."
msgstr "Je crois que tu es ivre... je crois que je suis ivre."

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/43/c-2/59/c-2/81/g-0/19/1/s/0
msgctxt "Choix"
msgid "Maybe we can chat now?"
msgstr "On peut peut-être discuter, maintenant ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/43/c-2/59/c-2/81/g-0/19/c-0/7
msgctxt "Hoove"
msgid "I think I better <w>hic</w> call it a night."
msgstr "Je crois que je ferais mieux d'en <w>hic</w> rester là pour ce soir."

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/43/c-2/59/c-2/81/g-0/19/c-0/18
msgctxt "Hoove"
msgid "Come around some other time and we can... <w>hic</w>"
msgstr "Repasse un autre jour et on pourra... <w>hic</w>"

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/43/c-2/59/c-2/81/g-0/19/c-0/26
msgctxt "Hoove"
msgid "Do it again!"
msgstr "Refaire ça !"

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/43/c-2/59/c-2/81/g-0/19/c-1/7
msgctxt "Hoove"
msgid "OOh sure!"
msgstr "OOh bien sûr !"

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/43/c-2/59/c-2/81/g-0/19/c-1/15
msgctxt "Hoove"
msgid "Let's chat about... Fuzzy teddy bears."
msgstr "Parlons de... nounours tout doux."

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/43/c-2/59/c-2/81/g-0/19/c-1/26
msgctxt "Hoove"
msgid "Or how HOT you are. <w>hic</w> Like a FIRE."
msgstr "Ou de à quel point tu es CHAUD. <w>hic</w> Comme un FEU."

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/43/c-2/59/c-2/81/g-0/19/c-1/34
msgctxt "Hoove"
msgid "Better not say that too loud or Arma will come running!"
msgstr "Vaut mieux pas le dire trop fort ou Arma va rappliquer !"

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/43/c-2/59/c-2/81/g-0/19/c-1/45
msgctxt "Hoove"
msgid "Hahahaha <w>hic</w> ohhhh boy."
msgstr "Hahahaha <w>hic</w> ohhhh là là."

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/43/c-2/59/c-2/81/g-0/19/c-1/56
msgctxt "Hoove"
msgid "I'm... Gonna do a BIG Sleeps."
msgstr "Je vais... faire un GROS dodo."

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/43/c-2/59/c-2/81/g-0/19/c-1/64
msgctxt "Hoove"
msgid "Come around nother time!"
msgstr "Reviens une aut' fois !"

# Traduction IA – à relire
#: hoove_vacuum/HooveHaveaDrink/0/g-0/c-5/43/c-2/59/c-2/81/g-0/19/c-1/72
msgctxt "Hoove"
msgid "This was fug."
msgstr "C'était ouf."

# Traduction IA – à relire
#: hoove_vacuum/HooveHanksGame/0/4
msgctxt "Hoove"
msgid "You'd better believe it!"
msgstr "Tu peux me croire !"

# Traduction IA – à relire
#: hoove_vacuum/HooveHanksGame/0/12
msgctxt "Hoove"
msgid "The Hankees are playing the Socks!"
msgstr "Les Hankees jouent contre les Socks !"

# Traduction IA – à relire
#: hoove_vacuum/HooveHanksGame/0/20/s/0
msgctxt "Choix"
msgid "I love the Hanks!"
msgstr "J'adore les Hanks !"

# Traduction IA – à relire
#: hoove_vacuum/HooveHanksGame/0/21/s/0
msgctxt "Choix"
msgid "I'm more of a Socks fan, myself."
msgstr "Moi, je suis plutôt fan des Socks."

# Traduction IA – à relire
#: hoove_vacuum/HooveHanksGame/0/22/s/0
msgctxt "Choix"
msgid "I am familiar with both of these 'sport teams.'"
msgstr "Je connais ces deux « équipes de sport »."

# Traduction IA – à relire
#: hoove_vacuum/HooveHanksGame/0/c-0/7
msgctxt "Hoove"
msgid "No way! Me too! I'm an absolute die hard!"
msgstr "Pas possible ! Moi aussi ! Je suis un inconditionnel !"

# Traduction IA – à relire
#: hoove_vacuum/HooveHanksGame/0/c-0/18
msgctxt "Hoove"
msgid "Are you a serious fan? Or just casual?"
msgstr "Tu es un vrai fan ? Ou juste occasionnel ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveHanksGame/0/c-0/26/0/s/0
msgctxt "Choix"
msgid "As serious as they come!"
msgstr "Aussi vrai qu'on peut l'être !"

# Traduction IA – à relire
#: hoove_vacuum/HooveHanksGame/0/c-0/26/1/s/0
msgctxt "Choix"
msgid "Just casual."
msgstr "Juste occasionnel."

# Traduction IA – à relire
#: hoove_vacuum/HooveHanksGame/0/c-0/26/c-0/7
msgctxt "Hoove"
msgid "Then I guess you won't object to a little test..."
msgstr "Alors je suppose que tu ne diras pas non à un petit test..."

# Traduction IA – à relire
#: hoove_vacuum/HooveHanksGame/0/c-0/26/c-0/15
msgctxt "Hoove"
msgid "Who was their MVP pitcher in the 1954 season?"
msgstr "Qui était leur meilleur lanceur de la saison 1954 ?"

# Traduction IA – à relire
#: hoove_vacuum/HooveHanksGame/0/c-0/26/c-0/23/0/s/0
msgctxt "Choix"
msgid "Duh. Dan Banna."
msgstr "Facile. Dan Banna."

# Traduction IA – à relire
#: hoove_vacuum/HooveHanksGame/0/c-0/26/c-0/23/1/s/0
msgctxt "Choix"
msgid "Obviously it was Hannah Kerchief."
msgstr "Évidemment, c'était Hannah Kerchief."

# Traduction IA – à relire
#: hoove_vacuum/HooveHanksGame/0/c-0/26/c-0/23/2/s/0
msgctxt "Choix"
msgid "You trying to trick me? It was the French player Papiér Towelle!"
msgstr "Tu essaies de me piéger ? C'était le joueur français Papiér Towelle !"

# Traduction IA – à relire
#: hoove_vacuum/HooveHanksGame/0/c-0/26/c-0/23/c-0/7 hoove_vacuum/HooveHanksGame/0/c-0/26/c-0/23/c-1/7
msgctxt "Hoove"
msgid "Nice try. But you can't pull one over on me!"
msgstr "Bien essayé. Mais on ne me la fait pas !"

# Traduction IA – à relire
