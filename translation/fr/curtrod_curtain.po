#: curtrod_curtain/shade_laundry/0/g-1/72
msgctxt "Curt"
msgid "Right now."
msgstr ""

#: curtrod_curtain/shade_laundry/0/g-1/80
msgctxt "Wyndolyn"
msgid "I think you should leave before they explode from embarrassment."
msgstr ""

#: curtrod_curtain/shade_laundry/0/g-1/88
msgctxt "Curt"
msgid "That... that can happen?"
