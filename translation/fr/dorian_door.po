msgstr "Pardon, c'est ma faute."

# Traduction IA – à relire
#: dorian_door/dorian_complete_reggie_needed/0/65/s/0 dorian_door/dorian_complete_reggie_needed_front/0/65/s/0 dorian_door/dorian_complete_reggie_needed_back/0/65/s/0 dorian_door/dorian_complete_reggie_needed_tiny/0/65/s/0 dorian_door/dorian_complete_reggie_needed_trap/0/62/s/0 dorian_door/dorian_complete_reggie_needed_realized/0/84/s/0
msgctxt "Choix"
msgid "Exactly! I'm looking to make friends with everyone!"
msgstr "Exactement ! Je veux me lier d'amitié avec tout le monde !"

# Traduction IA – à relire
#: dorian_door/dorian_complete_reggie_needed/0/c-0/7 dorian_door/dorian_complete_reggie_needed_front/0/c-0/7 dorian_door/dorian_complete_reggie_needed_back/0/c-0/7 dorian_door/dorian_complete_reggie_needed_tiny/0/c-0/7 dorian_door/dorian_complete_reggie_needed_trap/0/c-0/7 dorian_door/dorian_complete_reggie_needed_realized/0/c-0/7
msgctxt "Reggie"
msgid "Yeah, seems like it, bucko."
