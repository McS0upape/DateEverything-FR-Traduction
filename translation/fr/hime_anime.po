msgstr "As-tu l'intention de nous condamner tous ?"

# Traduction IA – à relire
#: hime_anime/Nekoboru_2/0/g-0/0/s/0
msgctxt "Choix"
msgid "You're too protective of her, Nekoboru."
msgstr "Tu la protèges trop, Nekoboru."

# Traduction IA – à relire
#: hime_anime/Nekoboru_2/0/g-0/1/s/0 hime_anime/Nekoboru_3/0/g-0/24/s/0
msgctxt "Choix"
