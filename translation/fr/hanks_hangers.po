# Traduction IA – à relire
#: hanks_hangers/1
msgctxt "Tag Nom d'objet (MAJUSCULES)"
msgid "HANGERS"
msgstr "CINTRES"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/4
msgctxt "Narrator"
msgid "Five handsome himbos in colorful jumpsuits are flexing and chatting animatedly amongst themselves—when they notice you they begin to buzz with excitement, all speaking in rapid-fire sequence."
msgstr "Cinq beaux gosses un peu simplets, en combinaisons colorées, jouent des muscles et papotent avec animation. Quand ils vous remarquent, ils s'agitent d'excitation et parlent tous en rafale."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/24
msgctxt "Hank 4"
msgid "Yooo! Check it!"
msgstr "Yooo ! Matez ça !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/32
msgctxt "Hank 1"
msgid "Quick dudes clean up the digs! We’ve got company!"
msgstr "Vite les gars, on range la piaule ! On a de la visite !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/40
msgctxt "Hank 3"
msgid "Some real fine company... if you know what I’m sayin’."
msgstr "Une visite de qualité... si vous voyez ce que je veux dire."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/48
msgctxt "Hank 2"
msgid "How’s it hangin’ homie?!"
msgstr "Ça pend comment, poto ?!"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/56/s/0
msgctxt "Choix"
msgid "All good fam!"
msgstr "Tout roule, fam !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/57/s/0
msgctxt "Choix"
msgid "The world is a bleak and unforgiving hellscape."
msgstr "Le monde est un enfer désolé et impitoyable."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/58/s/0
msgctxt "Choix"
msgid "I’m not your homie."
msgstr "Je suis pas ton poto."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/c-0/13
msgctxt "Hank 4"
msgid "Word!"
msgstr "Carrément !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/c-0/24
msgctxt "Hank 1"
msgid "Oh, that's FACTS, amigo!"
msgstr "Ah ça, c'est des FAITS, poto !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/c-1/13
msgctxt "Hank 4"
msgid "Ah naur!"
msgstr "Ah naaan !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/c-1/24
msgctxt "Hank 2"
msgid "Throwing ALL my chakras all outta alignment to hear you’re in such a dark headspace amigo."
msgstr "Ça me met TOUS mes chakras de travers d'entendre que t'es dans un état d'esprit aussi sombre, poto."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/c-1/32
msgctxt "Hank 1"
msgid "But don’t you worry none, ‘cause we’re here to pump some dopamine into those veins, brah!"
msgstr "Mais t'inquiète, on est là pour te pomper un peu de dopamine dans les veines !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/c-1/43
msgctxt "Hank 4"
msgid "GET AMPED FAM!!"
msgstr "ON SE BOOSTE, FAM !!"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/c-2/13
msgctxt "Hank 2"
msgid "Talk about a vibe killer..."
msgstr "Quel plombeur d'ambiance..."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/c-2/21
msgctxt "Hank 1"
msgid "Naw it’s gucci fam. Strangers are just homies you haven’t vibed with yet!"
msgstr "Nan c'est gucci, fam. Les inconnus, c'est juste des potos avec qui t'as pas encore vibré !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/c-2/29
msgctxt "Hank 4"
msgid "No cap!"
msgstr "No cap !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/c-2/40/0/s/0
msgctxt "Choix"
msgid "I guess..."
msgstr "Je suppose..."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/c-2/40/1/s/0
msgctxt "Choix"
msgid "Hey yeah, you’re right!"
msgstr "Hé oui, t'as raison !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/c-2/40/2/s/0
msgctxt "Choix"
msgid "I’ve never heard that."
msgstr "Jamais entendu ça."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/c-2/40/c-1/13
msgctxt "Hank 1"
msgid "Of course we’re right!"
msgstr "Évidemment qu'on a raison !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/c-2/40/c-1/21
msgctxt "Hank 2"
msgid "We’re tapped into the energy freeway of the universe, dawg!"
msgstr "On est branchés sur l'autoroute énergétique de l'univers, poto !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/c-2/40/c-1/29
msgctxt "Hank 4"
msgid "Ha! It slaps!"
msgstr "Ha ! Ça déchire !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/c-2/40/c-2/7
msgctxt "Hank 1"
msgid "Pfft. It's facts, broski."
msgstr "Pfff. C'est des faits, poto."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-0/0
msgctxt "Hank 1"
msgid "Well, what are you waitin' for? Slide on in here and take a load off!"
msgstr "Alors, t'attends quoi ? Glisse-toi par ici et pose-toi !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-0/8
msgctxt "Hank 3"
msgid "And anything else you wanna take off..."
msgstr "Et tout ce que tu veux poser d'autre..."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-0/19
msgctxt "Hank 2"
msgid "Welcome: to the extremest dojo in the pad! The perfect place to sit back, chillax and recharge your batts."
msgstr "Bienvenue : dans le dojo le plus extrême de la baraque ! L'endroit parfait pour se poser, chiller et recharger ses batteries."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-0/27 hanks_hangers/hanks2ndjoin/0/g-1/c-10/37
msgctxt "Hank 4"
msgid "Hell yeah!"
msgstr "Ouais de ouf !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-0/38/s/0
msgctxt "Choix"
msgid "Tight!"
msgstr "Stylé !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-0/39/s/0
msgctxt "Choix"
msgid "Doesn’t seem that extreme?"
msgstr "Ça a pas l'air si extrême ?"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-0/40/s/0
msgctxt "Choix"
msgid "Are you flirting with me?"
msgstr "Tu flirtes avec moi ?"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-0/c-3/13
msgctxt "Hank 4"
msgid "Fire!"
msgstr "Feu !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-0/c-4/13
msgctxt "Hank 5"
msgid "That is where you might find yourself mistaken my friend!"
msgstr "Et c'est là que tu te trompes, mon ami !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-0/c-4/21
msgctxt "Hank 1"
msgid "Everything we do is extreme."
msgstr "Tout ce qu'on fait est extrême."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-0/c-4/29
msgctxt "Hank 2"
msgid "No one is more hardcore than us!"
msgstr "Personne est plus hardcore que nous !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-0/c-5/7
msgctxt "Hank 3"
msgid "Hell yeah... you’re a snacc, baby."
msgstr "Ouais de ouf... t'es un morceau de choix, bébé."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-0/c-5/18
msgctxt "Hank 1"
msgid "Don’t mind Hank no.3. His game is super cringe."
msgstr "Écoute pas Hank n°3. Son plan drague est super cringe."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-0/c-5/26
msgctxt "Hank 4"
msgid "Lowkey embarrassing, Hank no.3!"
msgstr "Un peu la honte, Hank n°3 !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-1/0
msgctxt "Hank 1"
msgid "Right now you’re hanging with the wildest, dopest, GNARLIEST squad of bussin athletes around, homie!"
msgstr "Là, tu traînes avec l'équipe d'athlètes la plus folle, la plus dingue, la plus GNARLY de toute la place, poto !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-1/11 hanks_hangers/first_encounter/0/g-8/c-22/23 hanks_hangers/first_encounter/0/g-11/16/b/17
msgctxt "Hanks"
msgid "THE HANKS!"
msgstr "LES HANKS !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-1/49/s/0
msgctxt "Choix"
msgid "Wait, so if you're the \"Hanks\" does that mean you're all named \"Hank\"?"
msgstr "Attends, si vous êtes les « Hanks », ça veut dire que vous vous appelez tous « Hank » ?"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-1/50/s/0
msgctxt "Choix"
msgid "Well, who's who?"
msgstr "Bon, qui est qui ?"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-1/c-6/7
msgctxt "Hanks"
msgid "Yup!!!"
msgstr "Ouaip !!!"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-1/c-7/7
msgctxt "Hank 4"
msgid "Oh man! You don't know?!"
msgstr "Oh la la ! Tu sais pas ?!"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-2/3/s/0
msgctxt "Choix"
msgid "Okay, I got that, but how do I tell you apart?"
msgstr "D'accord, j'ai compris, mais comment je fais pour vous distinguer ?"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-2/c-8/7
msgctxt "Hank 1"
msgid "Numbers are kickass!"
msgstr "Les numéros, c'est du lourd !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-3/0
msgctxt "Narrator"
msgid "The Hanks all stand in formation, each of them striking a unique pose as they introduce themselves. You get the distinct feeling they do this often."
msgstr "Les Hanks se mettent en formation, chacun prenant une pose unique pour se présenter. Vous avez la nette impression qu'ils font ça souvent."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-3/20/6
msgctxt "Hank 1"
msgid "I'm Hank number 1!!"
msgstr "Moi c'est Hank numéro 1 !!"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-3/20/20
msgctxt "Hank 2"
msgid "I'm Hank number 2!!"
msgstr "Moi c'est Hank numéro 2 !!"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-3/20/34
msgctxt "Hank 3"
msgid "I'm Hank number 3!!"
msgstr "Moi c'est Hank numéro 3 !!"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-3/20/48
msgctxt "Hank 4"
msgid "I'm Hank number 4!!"
msgstr "Moi c'est Hank numéro 4 !!"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-3/20/62
msgctxt "Hank 5"
msgid "And I'm Hank number 5!!"
msgstr "Et moi c'est Hank numéro 5 !!"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-3/20/76 hanks_hangers/first_encounter/0/g-3/20/137/c-11/7 hanks_hangers/first_encounter/0/g-3/20/137/c-12/15
msgctxt "Hanks"
msgid "We're the HANKS!!"
msgstr "On est les HANKS !!"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-3/20/126
msgctxt "Hank 5"
msgid "Brought to you by Red Bowl!"
msgstr "Avec le soutien de Red Bowl !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-3/20/134/b/1
msgctxt "Hank 2"
msgid "Jesus Christ I'm really fucking winded bros."
msgstr "Putain de bordel, je suis vraiment à bout de souffle les gars."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-3/20/137/0/s/0
msgctxt "Choix"
msgid "Oh, you all have the same name! Thanks for clearing that up!"
msgstr "Ah, vous avez tous le même nom ! Merci d'avoir éclairci ça !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-3/20/137/1/s/0
msgctxt "Choix"
msgid "Well, that explains it."
msgstr "Eh bien, ça explique tout."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-3/20/137/2/s/0
msgctxt "Choix"
msgid "I'm not sure I get it. Who are you again?"
msgstr "Je pige pas trop. Vous êtes qui déjà ?"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-3/20/137/3/s/0
msgctxt "Choix"
msgid "Do you play for Hoove's favorite ball team?"
msgstr "Vous jouez pour l'équipe de balle préférée de Hoove ?"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-3/20/137/c-9/7 hanks_hangers/first_encounter/0/g-3/20/137/c-11/42/c-1/23
msgctxt "Hank 4"
msgid "You're funny!"
msgstr "T'es drôle !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-3/20/137/c-10/7
msgctxt "Hanks"
msgid "COOL!!!"
msgstr "COOL !!!"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-3/20/137/c-11/42/0/s/0
msgctxt "Choix"
msgid "The who??"
msgstr "Les quoi ??"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-3/20/137/c-11/42/1/s/0
msgctxt "Choix"
msgid "I know, I was kidding."
msgstr "Je sais, je plaisantais."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-3/20/137/c-11/42/c-1/7
msgctxt "Hank 2"
msgid "Huh?"
msgstr "Hein ?"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-3/20/137/c-11/42/c-1/15
msgctxt "Hank 1"
msgid "Ooooh, I get it."
msgstr "Ooooh, j'ai pigé."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-3/20/137/c-12/7
msgctxt "Hank 3"
msgid "Nah, they're the Hank<i>ies</i>."
msgstr "Nan, eux, c'est les Hank<i>ees</i>."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-3/20/137/c-12/65/0/s/0
msgctxt "Choix"
msgid "So I've been told..."
msgstr "C'est ce qu'on m'a dit..."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-3/20/137/c-12/65/1/s/0
msgctxt "Choix"
msgid "Sure, makes perfect sense."
msgstr "Bien sûr, ça se tient parfaitement."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-3/20/137/c-12/65/c-0/7
msgctxt "Hank 1"
msgid "Listening is maybe the most extreme sport there is!"
msgstr "Écouter, c'est peut-être le sport le plus extrême qui soit !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-3/20/137/c-12/65/c-1/7
msgctxt "Hank 1"
msgid "We make so much sense!"
msgstr "On est tellement cohérents !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-3/20/137/c-12/65/c-1/15
msgctxt "Hank 3"
msgid "We are totally into sensuality..."
msgstr "On est à fond dans la sensualité..."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-5/0/s/0
msgctxt "Choix"
msgid "What are you guys getting up to in here? Seems pretty... sporty."
msgstr "Qu'est-ce que vous fabriquez par ici ? Ça a l'air plutôt... sportif."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-5/c-13/7
msgctxt "Hank 3"
msgid "That's right! We're the wildest, most fearless, GNARLIEST squad of extreme athletes in the house."
msgstr "Exactement ! On est l'équipe d'athlètes extrêmes la plus folle, la plus intrépide, la plus GNARLY de la maison."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-5/c-13/18
msgctxt "Hank 1"
msgid "We base jump — we lava board — we cheese roll."
msgstr "On fait du base jump, du lava board, du cheese rolling."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-5/c-13/26
msgctxt "Hank 3"
msgid "If something is hot enough, we’ll ride it all... night... long..."
msgstr "Si c'est assez chaud, on le chevauche toute... la... nuit..."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-5/c-13/34
msgctxt "Hank 5"
msgid "We laugh in the face of danger!"
msgstr "On rit au nez du danger !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-5/c-13/45
msgctxt "Hank 2"
msgid "Even though we probably shouldn’t..."
msgstr "Même si on devrait probablement pas..."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-5/c-13/53
msgctxt "Hank 4"
msgid "We’ve tasted the adrenaline of them all!"
msgstr "On a goûté à l'adrénaline de chacun d'eux !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-5/c-13/61/0/s/0
msgctxt "Choix"
msgid "What’s adrenaline taste like?"
msgstr "Ça a quel goût, l'adrénaline ?"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-5/c-13/61/1/s/0
msgctxt "Choix"
msgid "What’s your favorite extreme sport?"
msgstr "C'est quoi, votre sport extrême préféré ?"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-5/c-13/61/2/s/0
msgctxt "Choix"
msgid "What was your least favorite sport?"
msgstr "C'est quoi le sport que vous avez le moins aimé ?"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-5/c-13/61/c-0/13
msgctxt "Hank 1"
msgid "Believe it or not: grape!"
msgstr "Crois-le ou non : raisin !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-5/c-13/61/c-0/21
msgctxt "Hank 5"
msgid "You wouldn’t think that, but it’s actually true."
msgstr "On croirait pas, mais c'est vrai."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-5/c-13/61/c-0/29
msgctxt "Hank 4"
msgid "High key slaps, brahhh!"
msgstr "Ça déchire grave, poto !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-5/c-13/61/c-0/40/0/s/0 hanks_hangers/first_encounter/0/g-5/c-13/61/c-1/44/0/s/0
msgctxt "Choix"
msgid "Man you guys are just adrenaline junkies aren’t you?"
msgstr "Dites donc, vous êtes des accros à l'adrénaline, c'est ça ?"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-5/c-13/61/c-1/11
msgctxt "Hank 2"
msgid "Hank Gliding!"
msgstr "Delta-Hank !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-5/c-13/61/c-1/22
msgctxt "Hank 1"
msgid "It's like Hang Gliding - but with us!"
msgstr "C'est comme le deltaplane, mais avec nous !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-5/c-13/61/c-1/33
msgctxt "Hank 4"
msgid "We're the Hanks!"
msgstr "On est les Hanks !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-5/c-13/61/c-2/7
msgctxt "Hank 1"
msgid "Extreme Unicycling."
msgstr "Monocycle extrême."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-5/c-13/61/c-2/15
msgctxt "Hank 2"
msgid "Shit sucks bro."
msgstr "C'est de la merde, poto."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-5/c-13/61/c-2/23/0/s/0
msgctxt "Choix"
msgid "You guys are just adrenaline junkies aren’t you?"
msgstr "Vous êtes des accros à l'adrénaline, c'est ça ?"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-6/0
msgctxt "Hank 3"
msgid "Oh we’re <i>way</i> beyond junkies, hot stuff."
msgstr "Oh, on est <i>bien</i> au-delà de l'accro, beau gosse."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-6/8
msgctxt "Hank 1"
msgid "It's legit insane - but no cap we live here with you!!"
msgstr "C'est complètement dingue, mais no cap, on habite ici avec toi !!"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-6/16
msgctxt "Hank 4"
msgid "We’re casa roomies, amigo!"
msgstr "On est des colocs, poto !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-6/24/s/0
msgctxt "Choix"
msgid "Yeah I get that."
msgstr "Ouais, je vois."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-6/25/s/0
msgctxt "Choix"
msgid "And yet you don’t pay any rent."
msgstr "Et pourtant vous payez pas de loyer."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-6/26/s/0
msgctxt "Choix"
msgid "I’ve always wanted roommates!"
msgstr "J'ai toujours voulu avoir des colocs !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-6/c-14/7
msgctxt "Hank 1"
msgid "We don’t plan on crashing here for much longer though."
msgstr "On compte pas squatter ici beaucoup plus longtemps, cela dit."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-6/c-14/15
msgctxt "Hank 4"
msgid "With our new sponsor the cash is gonna start rolling in!"
msgstr "Avec notre nouveau sponsor, le fric va commencer à tomber !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-6/c-14/23
msgctxt "Hank 2"
msgid "<i>Maybe.</i>"
msgstr "<i>Peut-être.</i>"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-6/c-14/31/0/s/0
msgctxt "Choix"
msgid "Yeah? Who’s your sponsor?"
msgstr "Ah ouais ? C'est qui, votre sponsor ?"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-6/c-15/13
msgctxt "Hank 2"
msgid "Ah, totally our oversight, homie."
msgstr "Ah, un oubli total de notre part, poto."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-6/c-15/21
msgctxt "Hank 1"
msgid "Things are a little tight right now, but once we start winning some wicked, extreme challenges our sponsor is gonna start paying out."
msgstr "C'est un peu juste en ce moment, mais dès qu'on commencera à remporter des défis extrêmes de malade, notre sponsor va se mettre à cracher."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-6/c-15/29
msgctxt "Hank 4"
msgid "Like a slot machine, roomie!"
msgstr "Comme une machine à sous, coloc !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-6/c-15/40/0/s/0
msgctxt "Choix"
msgid "Who’s your sponsor?"
msgstr "C'est qui, votre sponsor ?"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-6/c-16/13
msgctxt "Hank 4"
msgid "Right?! Life’s way more gucci with friends!"
msgstr "N'est-ce pas ?! La vie est bien plus gucci avec des amis !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-6/c-16/21
msgctxt "Hank 3"
msgid "Or friends with benefits..."
msgstr "Ou des amis avec bénéfices..."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-6/c-16/29
msgctxt "Hank 1"
msgid "That’s why we partnered with Red Bowl!"
msgstr "C'est pour ça qu'on s'est associés à Red Bowl !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-6/c-16/37/0/s/0
msgctxt "Choix"
msgid "What is Red Bowl anyway?"
msgstr "Red Bowl, c'est quoi au juste ?"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-7/0
msgctxt "Hank 4"
msgid "Red Bowl is our sponsor, brah!"
msgstr "Red Bowl, c'est notre sponsor, poto !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-7/8/s/0
msgctxt "Choix"
msgid "Very cool!"
msgstr "Très cool !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-7/9/s/0
msgctxt "Choix"
msgid "Got it."
msgstr "Compris."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-7/10/s/0
msgctxt "Choix"
msgid "And what’s that? Some kinda energy drink?"
msgstr "Et c'est quoi ça ? Une sorte de boisson énergisante ?"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-7/c-17/13
msgctxt "Hank 4"
msgid "Their bowls have the <i>most</i> rizz, no cap!"
msgstr "Leurs bols ont <i>le plus</i> de rizz, no cap !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-7/c-17/21/0/s/0
msgctxt "Choix"
msgid "Sure ok."
msgstr "Ouais, ok."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-7/c-17/21/1/s/0
msgctxt "Choix"
msgid "No cap?"
msgstr "No cap ?"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-7/c-17/21/2/s/0
msgctxt "Choix"
msgid "I’m sorry... are you saying \"bowls?\""
msgstr "Pardon... tu dis des « bols » ?"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-7/c-17/21/c-1/13
msgctxt "Hank 4"
msgid "Not a single cap, amigo!"
msgstr "Pas une seule cap, poto !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-7/c-17/21/c-2/7
msgctxt "Hank 3"
msgid "Yes they are a company that manufactures exclusively red-colored bowls."
msgstr "Oui, c'est une entreprise qui fabrique exclusivement des bols de couleur rouge."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-7/c-17/21/c-2/15
msgctxt "Hank 4"
msgid "It’s so lit!!!"
msgstr "C'est trop lit !!!"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-7/c-19/7
msgctxt "Hank 1"
msgid "No dude, it’s a company that makes red bowls!"
msgstr "Mais non, c'est une boîte qui fait des bols rouges !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-7/c-19/15
msgctxt "Hank 3"
msgid "For like cereal or soup or whatever."
msgstr "Pour les céréales, la soupe ou je sais pas quoi."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-7/c-19/23
msgctxt "Hank 4"
msgid "That’s why we get so many free red bowls!"
msgstr "C'est pour ça qu'on reçoit plein de bols rouges gratos !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-7/c-19/31
msgctxt "Hank 2"
msgid "We don’t exactly know what to do with them all, but we’ll figure it out."
msgstr "On sait pas trop quoi en faire, mais on trouvera bien."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-7/c-19/39/0/s/0
msgctxt "Choix"
msgid "Ah, that does explain all the red bowls."
msgstr "Ah, ça explique tous ces bols rouges."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-8/0
msgctxt "Hank 3"
msgid "And they're not just a sponsor, they're our fam."
msgstr "Et c'est pas juste un sponsor, c'est notre famille."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-8/8
msgctxt "Hank 5"
msgid "They fuel our adventures!"
msgstr "Ils alimentent nos aventures !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-8/19
msgctxt "Hank 1"
msgid "They provide our wicked gear — get our exploits killer exposure — and provide the best medical support when things get gnarly."
msgstr "Ils nous fournissent du matos de malade, une exposition de ouf à nos exploits, et la meilleure assistance médicale quand ça devient gnarly."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-8/27
msgctxt "Hank 2"
msgid "And let’s be real, they <i>do</i> get gnarly."
msgstr "Et soyons honnêtes, ça <i>devient</i> gnarly."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-8/35
msgctxt "Hank 4"
msgid "If by gnarly you mean dope af!!!"
msgstr "Si par gnarly tu veux dire ultra stylé !!!"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-8/46/s/0
msgctxt "Choix"
msgid "Sounds like a great partnership!"
msgstr "Ça a l'air d'être un super partenariat !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-8/47/s/0
msgctxt "Choix"
msgid "Ok sure whatever."
msgstr "Ok, d'accord, peu importe."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-8/48/s/0
msgctxt "Choix"
msgid "Wait what happens when things get gnarly?"
msgstr "Attends, qu'est-ce qui se passe quand ça devient gnarly ?"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-8/c-20/13
msgctxt "Hank 1"
msgid "Through every stunt, they’ve always got our backs!"
msgstr "À chaque cascade, ils sont là pour nous couvrir !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-8/c-22/7
msgctxt "Hank 4"
msgid "Gnarly just means awesome!"
msgstr "Gnarly, ça veut juste dire génial !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-8/c-22/15
msgctxt "Hank 1"
msgid "And things are always awesome when you’re hanging out with..."
msgstr "Et tout est toujours génial quand tu traînes avec..."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-9/0
msgctxt "Hank 4"
msgid "We high key love it all, homie!"
msgstr "On kiffe tout grave, poto !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-9/8/s/0
msgctxt "Choix"
msgid "Sounds like a good way to break your neck."
msgstr "Ça sent le bon plan pour se briser la nuque."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-9/9/s/0
msgctxt "Choix"
msgid "And you’re what... like a hivemind or something?"
msgstr "Et vous êtes quoi... une sorte d'esprit de ruche ou un truc du genre ?"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-9/10/s/0
msgctxt "Choix"
msgid "So what, you just like, 'hang around'?"
msgstr "Alors quoi, vous êtes juste là à « pendre » ?"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-9/11/s/0
msgctxt "Choix"
msgid "Seems like you're geared up for an adventure."
msgstr "On dirait que vous êtes équipés pour l'aventure."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-9/c-23/13
msgctxt "Hank 2"
msgid "Yeah... that’s not entirely inaccurate."
msgstr "Ouais... c'est pas totalement faux."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-9/c-24/7
msgctxt "Hank 2"
msgid "Hive mind?"
msgstr "Esprit de ruche ?"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-9/c-24/15
msgctxt "Hank 1"
msgid "Ya know, I dunno."
msgstr "Tu sais, j'en sais rien."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-9/c-24/23
msgctxt "Hank 5"
msgid "Not a lot of time to question that sort of thing when you’re too busy living the most extreme life possible."
msgstr "On a pas trop le temps de se poser ce genre de questions quand on est trop occupés à vivre la vie la plus extrême possible."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-9/c-24/31
msgctxt "Hank 4"
msgid "We’re the Hanks!"
msgstr "On est les Hanks !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-9/c-25/7
msgctxt "Hank 4"
msgid "Haha! Yup! Well, we hang around most days, but when the conditions are right we love getting out of the closet."
msgstr "Haha ! Ouaip ! Bon, on traîne à la maison la plupart du temps, mais quand les conditions sont réunies, on adore sortir du placard."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-9/c-26/13
msgctxt "Hank 2"
msgid "Yup! A broski ALWAYS prepares!"
msgstr "Ouaip ! Un bro est TOUJOURS prêt !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-9/c-26/24
msgctxt "Hank 1"
msgid "You never know when a ripping thermal or vase jump opportunity is gonna come your way! Yeah!!"
msgstr "On sait jamais quand une thermique de folie ou une occase de saut en vase va se présenter ! Ouais !!"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-10/0/s/0
msgctxt "Choix"
msgid "Sounds exciting!"
msgstr "Ça a l'air excitant !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-10/1/s/0
msgctxt "Choix"
msgid "Sounds dangerous..."
msgstr "Ça a l'air dangereux..."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-10/2/s/0
msgctxt "Choix"
msgid "Sounds intimidating!"
msgstr "Ça a l'air intimidant !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-10/3/s/0
msgctxt "Choix"
msgid "Sounds sketchy..."
msgstr "Ça a l'air louche..."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-10/c-27/7 hanks_hangers/first_encounter/0/g-10/c-28/7 hanks_hangers/first_encounter/0/g-10/c-29/7 hanks_hangers/first_encounter/0/g-10/c-30/7 hanks_hangers/fourth_encounter/0/g-12/c-36/7 hanks_hangers/fourth_encounter/0/g-12/c-37/7 hanks_hangers/fourth_encounter/0/g-12/c-38/7 hanks_hangers/fifth_encounter/0/g-1/c-5/58/c-1/7 hanks_hangers/fifth_encounter/0/g-1/c-5/58/c-2/7 hanks_hangers/fifth_encounter/0/g-1/c-5/58/c-3/7
msgctxt "Hanks"
msgid "IT IS!"
msgstr "ÇA L'EST !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-11/0
msgctxt "Hank 5"
msgid "Speaking of which..."
msgstr "À ce propos..."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-11/8
msgctxt "Hank 1"
msgid "We were just about to head out for a little Hank Gliding."
msgstr "On allait justement partir faire un petit Delta-Hank."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-11/16/b/1
msgctxt "Hank 3"
msgid "It's just like hang gliding, but with us!"
msgstr "C'est comme le deltaplane, mais avec nous !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-11/16/b/9
msgctxt "Hank 2"
msgid "You know!"
msgstr "Tu sais !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-11/19
msgctxt "Hank 4"
msgid "What do you think?"
msgstr "Qu'est-ce que t'en penses ?"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-11/27
msgctxt "Hanks"
msgid "WANNA COME?!"
msgstr "TU VEUX VENIR ?!"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-11/47
msgctxt "Hank 4"
msgid "It high key slaps, homie! You in?!"
msgstr "Ça déchire grave, poto ! T'en es ?!"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-11/55/s/0
msgctxt "Choix"
msgid "Is that sexual?"
msgstr "C'est sexuel ?"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-11/56/s/0
msgctxt "Choix"
msgid "Ok but how high key does it slap?"
msgstr "Ok mais ça déchire à quel point, grave ?"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-11/c-31/7
msgctxt "Hank 3"
msgid "It can be if you want it to be..."
msgstr "Ça peut l'être si tu veux..."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-11/c-32/7
msgctxt "Hank 4"
msgid "It's goated, brah!"
msgstr "C'est goatesque, poto !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-12/0
msgctxt "Hank 1"
msgid "What do you say??"
msgstr "Qu'est-ce que t'en dis ??"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-12/8/s/0
msgctxt "Choix"
msgid "I dunno, I... Oh why not! Sure. Uh, sounds... RAD!"
msgstr "Je sais pas, je... Oh et puis pourquoi pas ! Ok. Euh, ça a l'air... GÉNIAL !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-12/9/s/0
msgctxt "Choix"
msgid "Nah, I don't think so. I'm kind of afraid of heights. And falling. And, you know... death."
msgstr "Non, je crois pas. J'ai un peu peur du vide. Et de la chute. Et, vous savez... de la mort."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-12/10/s/0
msgctxt "Choix"
msgid "That's a big commitment. I don't really know you guys. Or how to actually do any of this for that matter."
msgstr "C'est un gros engagement. Je vous connais pas vraiment. Ni comment on fait tout ça, d'ailleurs."

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-12/c-35/7
msgctxt "Hanks"
msgid "We'll teach you!"
msgstr "On t'apprendra !"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-12/c-35/42/0/s/0
msgctxt "Choix"
msgid "Ugh. Well, you only live once. I'm in!!"
msgstr "Pfff. Bon, on n'a qu'une vie. J'en suis !!"

# Traduction IA – à relire
#: hanks_hangers/first_encounter/0/g-12/c-35/42/1/s/0
msgctxt "Choix"
msgid "No, not just yet. I'll watch from here. Maybe on the next one?"
msgstr "Non, pas tout de suite. Je regarde d'ici. Peut-être la prochaine fois ?"

# Traduction IA – à relire
#: hanks_hangers/say_no1/0/6
msgctxt "Hanks"
msgid "BUMMER!!!"
msgstr "DOMMAGE !!!"

# Traduction IA – à relire
#: hanks_hangers/say_no1/0/29/s/0
msgctxt "Choix"
msgid "Sorry to disappoint you."
msgstr "Pardon de vous décevoir."

# Traduction IA – à relire
#: hanks_hangers/say_no1/0/30/s/0
msgctxt "Choix"
msgid "Don't be sad!"
msgstr "Soyez pas tristes !"

# Traduction IA – à relire
#: hanks_hangers/say_no1/0/31/s/0
msgctxt "Choix"
msgid "What can I say? I'm kind of a chicken."
msgstr "Que dire ? J'ai un peu la trouille."

# Traduction IA – à relire
#: hanks_hangers/say_no1/0/c-0/7
msgctxt "Hank 1"
msgid "We're not disappointed! Heck, we just met."
msgstr "On est pas déçus ! Franchement, on vient de se rencontrer."

# Traduction IA – à relire
#: hanks_hangers/say_no1/0/c-1/7
msgctxt "Hank 1"
msgid "It's all good! We get it. We just met."
msgstr "Pas de souci ! On comprend. On vient de se rencontrer."

# Traduction IA – à relire
#: hanks_hangers/say_no1/0/c-2/7
msgctxt "Hank 5"
msgid "Ahhh, but even chickens can GLIDE!"
msgstr "Ahhh, mais même les poules peuvent PLANER !"

# Traduction IA – à relire
#: hanks_hangers/say_no1/0/c-2/18
msgctxt "Hank 1"
msgid "JK. We get it. You just met us!"
msgstr "Je rigole. On comprend. Tu viens juste de nous rencontrer !"

# Traduction IA – à relire
#: hanks_hangers/say_no1/0/c-2/26
msgctxt "Hank 2"
msgid "It's totally chill if you don't want to rip with the squad this time."
msgstr "C'est totalement chill si t'as pas envie de déchirer avec la team cette fois."

# Traduction IA – à relire
#: hanks_hangers/say_no1/0/g-0/0
msgctxt "Hank 3"
msgid "This stuff takes trust. Another day..."
msgstr "Ces trucs-là demandent de la confiance. Un autre jour..."

# Traduction IA – à relire
#: hanks_hangers/say_no1/0/g-0/8
msgctxt "Hank 2"
msgid "Another adventure!! If you change your mind, we'll be hanging out here; as per ushe."
msgstr "Une autre aventure !! Si tu changes d'avis, on sera là à traîner, comme d'hab."

# Traduction IA – à relire
#: hanks_hangers/say_no1/0/g-0/16
msgctxt "Hank 1"
msgid "But we'll probably only head out four more times this season, so don't miss out!"
msgstr "Mais on ne sortira probablement plus que quatre fois cette saison, alors rate pas ça !"

# Traduction IA – à relire
#: hanks_hangers/say_no1/0/g-0/24/s/0
msgctxt "Choix"
msgid "Okay then Hanks... Sounds like a plan."
msgstr "Bon d'accord les Hanks... Ça marche."

# Traduction IA – à relire
#: hanks_hangers/say_no1/0/g-0/25/s/0
msgctxt "Choix"
msgid "Alrighty, I'll think about it."
msgstr "Ok, je vais y réfléchir."

# Traduction IA – à relire
#: hanks_hangers/say_no1/0/g-0/26/s/0
msgctxt "Choix"
msgid "I still think this stuff is pretty scary."
msgstr "Je trouve toujours que ça fait assez peur."

# Traduction IA – à relire
#: hanks_hangers/say_no1/0/g-0/c-3/7
msgctxt "Hank 1"
msgid "That's what I like to hear House Homie!!"
msgstr "C'est ça que j'aime entendre, coloc de la maison !!"

# Traduction IA – à relire
#: hanks_hangers/say_no1/0/g-0/c-3/18 hanks_hangers/say_no1/0/g-0/c-4/15 hanks_hangers/say_no1/0/g-0/c-5/15 hanks_hangers/say_yes1/86 hanks_hangers/hanks3rdjoin/0/g-5/c-17/29
msgctxt "Hanks"
msgid "<w>Hanks... AWWWAAAAAYYYYYY!!!</w>"
msgstr "<w>Hanks... EN AVAAAAAAANT !!!</w>"

# Traduction IA – à relire
#: hanks_hangers/say_no1/0/g-0/c-4/7
msgctxt "Hank 3"
msgid "So you're sayin' there's a chance!!"
msgstr "Donc tu dis qu'il y a une chance !!"

# Traduction IA – à relire
#: hanks_hangers/say_no1/0/g-0/c-5/7
msgctxt "Hank 5"
msgid "You know what they say, \"Curiosity will conquer fear even more than bravery will.\" Sweet quote, am I right?!!"
msgstr "Tu sais ce qu'on dit : « La curiosité vaincra la peur encore mieux que le courage. » Belle citation, non ?!!"

# Traduction IA – à relire
#: hanks_hangers/say_yes1/0
msgctxt "Hanks"
msgid "SWEEEEEEET!!!"
msgstr "TROP BIEEEEEN !!!"

# Traduction IA – à relire
#: hanks_hangers/say_yes1/23
msgctxt "Hank 1"
msgid "You're one adventurous spirit!"
msgstr "T'es un esprit aventurier !"

# Traduction IA – à relire
#: hanks_hangers/say_yes1/31
msgctxt "Hank 5"
msgid "We love it!!!"
msgstr "On adore ça !!!"

# Traduction IA – à relire
#: hanks_hangers/say_yes1/48
msgctxt "Hank 1"
msgid "Epic! Just remember to stay focused and trust the wind."
msgstr "Épique ! Rappelle-toi juste de rester focus et de faire confiance au vent."

# Traduction IA – à relire
#: hanks_hangers/say_yes1/56
msgctxt "Hank 3"
msgid "And hold onto me <i>real</i> tight."
msgstr "Et accroche-toi à moi <i>bien</i> fort."

# Traduction IA – à relire
#: hanks_hangers/say_yes1/67
msgctxt "Hank 5"
msgid "Follow our lead, and we'll be shredding thermals in no time."
msgstr "Suis notre exemple, et tu vas déchirer les thermiques en un rien de temps."

# Traduction IA – à relire
#: hanks_hangers/say_yes1/75
msgctxt "Hank 5"
msgid "Get ready to soar, house homie!"
msgstr "Prépare-toi à t'envoler, coloc !"

# Traduction IA – à relire
#: hanks_hangers/hanks2ndbad/0/0
msgctxt "Hank 1"
