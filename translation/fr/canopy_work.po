#: canopy_work/canopy_paperclips/0/26/c-0/19/c-1/25/c-1/24/c-1/9
msgctxt "Customer"
msgid "There are those who think they can play with Emmanuel."
msgstr "Il en est qui croient pouvoir se jouer d'Emmanuel."

# Traduction IA – à relire
#: canopy_work/canopy_paperclips/0/26/c-0/19/c-1/25/c-1/24/c-1/14
msgctxt "Customer"
msgid "Those who think that because of my stature I am one to be toyed with."
msgstr "Ceux qui pensent qu'en raison de ma stature, on peut me traiter à la légère."

# Traduction IA – à relire
#: canopy_work/canopy_paperclips/0/26/c-0/19/c-1/25/c-1/24/c-1/19
msgctxt "Customer"
msgid "I have lived 41 years on this earth."
msgstr "J'ai vécu 41 ans sur cette terre."

# Traduction IA – à relire
#: canopy_work/canopy_paperclips/0/26/c-0/19/c-1/25/c-1/24/c-1/24
msgctxt "Customer"
msgid "And the only reason I still keep living"
msgstr "Et la seule raison pour laquelle je vis encore"

# Traduction IA – à relire
#: canopy_work/canopy_paperclips/0/26/c-0/19/c-1/25/c-1/24/c-1/29
msgctxt "Customer"
msgid "Is because I am not one to be trifled with."
msgstr "C'est que je ne suis pas homme à qui l'on se frotte."

# Traduction IA – à relire
#: canopy_work/canopy_paperclips/0/26/c-0/19/c-1/25/c-1/24/c-1/34
msgctxt "Customer"
msgid "This path you are going on. It is dangerous."
msgstr "Le chemin que vous empruntez est dangereux."

# Traduction IA – à relire
#: canopy_work/canopy_paperclips/0/26/c-0/19/c-1/25/c-1/24/c-1/39
msgctxt "Customer"
msgid "Are you certain you want to do this, my friend?"
msgstr "Voulez-vous vraiment cela, mon ami ?"

# Traduction IA – à relire
#: canopy_work/canopy_paperclips/0/26/c-0/19/c-1/25/c-1/24/c-1/44/0/s/0
msgctxt "Choix"
msgid "You are right... I'll refund you."
msgstr "Vous avez raison... je vous rembourse."

# Traduction IA – à relire
#: canopy_work/canopy_paperclips/0/26/c-0/19/c-1/25/c-1/24/c-1/44/1/s/0
msgctxt "Choix"
msgid "Do your worst, Emmanuel."
msgstr "Faites de votre pire, Emmanuel."

# Traduction IA – à relire
#: canopy_work/canopy_paperclips/0/26/c-0/19/c-1/25/c-1/24/c-1/44/c-0/7
msgctxt "Player"
msgid "You are right... I'll refund you."
msgstr "Vous avez raison... je vous rembourse."

# Traduction IA – à relire
