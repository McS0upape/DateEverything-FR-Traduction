# Traduction IA – à relire
#: tyrell_towel/1 tyrell_towel/intro_shower/0/1 tyrell_towel/tyrell_bedroom/0/1 tyrell_towel/tyrell_laundry/0/1 tyrell_towel/tyrell_kitchen/0/1
msgctxt "Tag Nom d'objet (MAJUSCULES)"
msgid "TOWEL"
msgstr "SERVIETTE"

# Traduction IA – à relire
#: tyrell_towel/intro_first/0/0
msgctxt "Narrator"
msgid "It's not all that surprising that your towels would have a look that one can only describe as 'fresh out of the shower'—the fluffy terrycloth clothing and glistening skin are expected."
msgstr "Il n'est pas très surprenant que vos serviettes aient un look que l'on ne peut décrire que comme « tout juste sorties de la douche » : le vêtement en tissu éponge moelleux et la peau luisante sont de rigueur."

# Traduction IA – à relire
#: tyrell_towel/intro_first/0/8
msgctxt "Narrator"
msgid "What you did not expect to see, however, was a six pack you could do your laundry on."
msgstr "Ce à quoi vous ne vous attendiez pas, en revanche, c'était des abdos sur lesquels vous pourriez frotter votre linge."

# Traduction IA – à relire
#: tyrell_towel/intro_first/0/16 tyrell_towel/tyrell_friendship_1/0/g-0/32/0
msgctxt "Tyrell"
msgid "Wait! Hold still."
msgstr "Attends ! Bouge pas."

# Traduction IA – à relire
#: tyrell_towel/intro_first/0/27
msgctxt "Narrator"
msgid "He holds his hands out in front of him, stopping you in your tracks."
msgstr "Il tend les mains devant lui et vous arrête net."

# Traduction IA – à relire
#: tyrell_towel/intro_first/0/35/s/0
msgctxt "Choix"
msgid "What? What's wrong? What did I do?"
msgstr "Quoi ? Qu'est-ce qui se passe ? Qu'est-ce que j'ai fait ?"

# Traduction IA – à relire
#: tyrell_towel/intro_first/0/36/s/0
msgctxt "Choix"
msgid "Why should I do what you say?"
msgstr "Pourquoi je ferais ce que tu dis ?"

# Traduction IA – à relire
#: tyrell_towel/intro_first/0/c-0/7
msgctxt "Tyrell"
msgid "You didn't do anything..."
msgstr "Tu n'as rien fait..."

# Traduction IA – à relire
#: tyrell_towel/intro_first/0/c-1/13
msgctxt "Tyrell"
msgid "Hostile from the start? Trust the plush!"
msgstr "Hostile dès le départ ? Fais confiance au moelleux !"

# Traduction IA – à relire
#: tyrell_towel/intro_first/0/g-0/0
msgctxt "Narrator"
msgid "He backs away from you, slowly and carefully."
msgstr "Il recule, lentement et avec précaution."

# Traduction IA – à relire
#: tyrell_towel/intro_first/0/g-0/8
msgctxt "Tyrell"
msgid "Just don't move..."
msgstr "Surtout, ne bouge pas..."

# Traduction IA – à relire
#: tyrell_towel/intro_first/0/g-0/16
msgctxt "Tyrell"
msgid "There's some water on the floor!"
msgstr "Il y a de l'eau par terre !"

# Traduction IA – à relire
#: tyrell_towel/intro_first/0/g-0/24
msgctxt "Tyrell"
msgid "Let me get that before you slip and fall."
msgstr "Laisse-moi m'en occuper avant que tu glisses et que tu tombes."

# Traduction IA – à relire
#: tyrell_towel/intro_first/0/g-0/35
msgctxt "Narrator"
msgid "He bends down to mop up a tiny puddle, standing back up with a grin."
msgstr "Il se penche pour éponger une minuscule flaque, puis se redresse avec un grand sourire."

# Traduction IA – à relire
#: tyrell_towel/intro_first/0/g-0/46
msgctxt "Tyrell"
msgid "There! All good!"
msgstr "Voilà ! Tout est bon !"

# Traduction IA – à relire
#: tyrell_towel/intro_first/0/g-0/57/s/0
msgctxt "Choix"
msgid "Phew! That was a close one."
msgstr "Ouf ! On l'a échappé belle."

# Traduction IA – à relire
#: tyrell_towel/intro_first/0/g-0/58/s/0
msgctxt "Choix"
msgid "You didn't have to do that for me."
msgstr "Tu n'étais pas obligé de faire ça pour moi."

# Traduction IA – à relire
#: tyrell_towel/intro_first/0/g-0/c-2/7
msgctxt "Tyrell"
msgid "Ha ha ha!"
msgstr "Ha ha ha !"

# Traduction IA – à relire
#: tyrell_towel/intro_first/0/g-0/c-3/7
msgctxt "Tyrell"
msgid "It's my pleasure."
msgstr "Avec plaisir."

# Traduction IA – à relire
#: tyrell_towel/intro_first/0/g-1/0
msgctxt "Tyrell"
msgid "Some might say that I saved your life!"
msgstr "On pourrait dire que je t'ai sauvé la vie !"

# Traduction IA – à relire
#: tyrell_towel/intro_first/0/g-1/11
msgctxt "Tyrell"
msgid "Did you see that, dude?"
msgstr "Tu as vu ça, {{mec|meuf|poto}} ?"

# Traduction IA – à relire
#: tyrell_towel/intro_first/0/g-1/19/s/0
msgctxt "Choix"
msgid "Are you talking to me?"
msgstr "C'est à moi que tu parles ?"

# Traduction IA – à relire
#: tyrell_towel/intro_first/0/g-1/20/s/0
msgctxt "Choix"
msgid "I'm not a dude..."
msgstr "Je ne suis pas un mec..."

# Traduction IA – à relire
#: tyrell_towel/intro_first/0/g-1/21/s/0
msgctxt "Choix"
msgid "Yes! You are my hero!"
msgstr "Oui ! Tu es mon héros !"

# Traduction IA – à relire
#: tyrell_towel/intro_shower/0/28
msgctxt "Narrator"
msgid "You see Tyrell confidently strutting through the room he seems to know best."
msgstr "Vous voyez Tyrell se pavaner avec assurance dans la pièce qu'il semble connaître le mieux."

# Traduction IA – à relire
#: tyrell_towel/intro_shower/0/36
msgctxt "Tyrell"
msgid "Tyrell is my name and cleanin' water is my game."
msgstr "Tyrell, mon nom ; éponger l'eau, mon don !"

# Traduction IA – à relire
#: tyrell_towel/intro_shower/0/44/s/0
msgctxt "Choix"
msgid "Hey Tyrell! What's up with you today?"
msgstr "Salut Tyrell ! Quoi de neuf aujourd'hui ?"

# Traduction IA – à relire
#: tyrell_towel/intro_shower/0/45/s/0
msgctxt "Choix"
msgid "I was wondering if you could help me with something."
msgstr "Je me demandais si tu pouvais m'aider pour un truc."

# Traduction IA – à relire
#: tyrell_towel/intro_shower/0/c-0/7
msgctxt "Tyrell"
msgid "Keeping it fluffy!"
msgstr "Toujours moelleux !"

# Traduction IA – à relire
#: tyrell_towel/intro_shower/0/c-0/15
msgctxt "Tyrell"
msgid "And uh... thoughtful."
msgstr "Et euh... pensif."

# Traduction IA – à relire
#: tyrell_towel/intro_shower/0/c-0/23/0/s/0
msgctxt "Choix"
msgid "Thoughtful...?"
msgstr "Pensif... ?"

# Traduction IA – à relire
#: tyrell_towel/intro_shower/0/c-0/23/1/s/0
msgctxt "Choix"
msgid "Hey we don't like thoughts 'round these parts."
msgstr "Eh, ici, on n'aime pas les pensées."

# Traduction IA – à relire
#: tyrell_towel/intro_shower/0/c-0/23/c-0/7
msgctxt "Tyrell"
msgid "Just had a bit on my mind lately."
msgstr "J'ai juste pas mal de choses en tête ces derniers temps."

# Traduction IA – à relire
#: tyrell_towel/intro_shower/0/c-0/23/c-1/7
msgctxt "Tyrell"
msgid "Really?"
msgstr "Vraiment ?"

# Traduction IA – à relire
#: tyrell_towel/intro_shower/0/c-1/7
msgctxt "Tyrell"
msgid "Is it another floor job? Because, I'll be honest, those aren't my favorite."
msgstr "C'est encore un boulot de sol ? Parce que, franchement, c'est pas mon préféré."

# Traduction IA – à relire
#: tyrell_towel/intro_shower/0/c-1/15
msgctxt "Tyrell"
msgid "I'm more about that body warmth stuff, ya know? Not that I want you to slip and fall or anything."
msgstr "Moi, c'est plutôt la chaleur corporelle, tu vois ? Pas que je veuille que tu glisses et que tu tombes, hein."

# Traduction IA – à relire
#: tyrell_towel/intro_shower/0/c-1/23
msgctxt "Tyrell"
msgid "So, if you NEED me to soak up water from the tile, I totally will. I just... I'm rambling."
msgstr "Alors si tu AS BESOIN que j'absorbe l'eau du carrelage, je le ferai sans problème. C'est juste que... je divague."

# Traduction IA – à relire
#: tyrell_towel/shower_part2/0/0/b/1
msgctxt "Tyrell"
msgid "I'll admit, I heard you talking to Johnny. I'm used to cleaning up after him."
msgstr "Je l'avoue, je t'ai entendu parler à Johnny. J'ai l'habitude de nettoyer derrière lui."

# Traduction IA – à relire
#: tyrell_towel/shower_part2/0/3/b/1
msgctxt "Tyrell"
msgid "I heard you splish-splashin' with Johnny and Bathsheba. Things tend to get a little wet with them, so I just expected... never mind."
msgstr "Je t'ai entendu patauger avec Johnny et Bathsheba. Avec eux, ça finit toujours un peu mouillé, alors je m'attendais à... laisse tomber."

# Traduction IA – à relire
#: tyrell_towel/shower_part2/0/6/b/1
msgctxt "Tyrell"
msgid "I'll admit, I heard you talking to Bathsheba. I'm used to cleaning up after her."
msgstr "Je l'avoue, je t'ai entendu parler à Bathsheba. J'ai l'habitude de nettoyer derrière elle."

# Traduction IA – à relire
#: tyrell_towel/shower_part2/0/9/b/1
msgctxt "Tyrell"
msgid "I see you walking in here, giving Johnny Splash and Bathsheba Bathtub the eye like you wanna get naked with 'em."
msgstr "Je te vois entrer ici et lorgner Johnny Splash et Bathsheba Bathtub comme si tu voulais te mettre à poil avec eux."

# Traduction IA – à relire
#: tyrell_towel/shower_part2/0/24/s/0
msgctxt "Choix"
msgid "Were you eavesdropping?"
msgstr "Tu écoutais aux portes ?"

# Traduction IA – à relire
#: tyrell_towel/shower_part2/0/25/s/0
msgctxt "Choix"
msgid "Those were private conversations!"
msgstr "C'étaient des conversations privées !"

# Traduction IA – à relire
#: tyrell_towel/shower_part2/0/c-0/7
msgctxt "Tyrell"
msgid "Leave Eeves out of this!"
msgstr "Ne mêle pas Ouï-Dire à ça !"

# Traduction IA – à relire
#: tyrell_towel/shower_part2/0/g-0/0
msgctxt "Tyrell"
msgid "Don't worry. I didn't HEAR hear anything. I was just..."
msgstr "Ne t'inquiète pas. Je n'ai rien ENTENDU entendu. J'étais juste..."

# Traduction IA – à relire
#: tyrell_towel/shower_part2/0/g-0/8
msgctxt "Tyrell"
msgid "I heard."
msgstr "J'ai entendu."

# Traduction IA – à relire
#: tyrell_towel/shower_part2/0/g-0/16
msgctxt "Tyrell"
msgid "But the water on the floor was a dead giveaway."
msgstr "Mais l'eau par terre était un indice qui ne trompait pas."

# Traduction IA – à relire
#: tyrell_towel/shower_part2/0/g-0/24/0
msgctxt "Tyrell"
msgid "Sorry if it seems like my tassels are in a twist."
msgstr "Désolé si j'ai l'air d'avoir les franges en pagaille."

# Traduction IA – à relire
#: tyrell_towel/shower_part2/0/g-0/24/8
msgctxt "Tyrell"
msgid "Ya boy is all good."
msgstr "Tyrell va très bien, merci."

# Traduction IA – à relire
#: tyrell_towel/shower_part2/0/g-0/24/16/s/0
msgctxt "Choix"
msgid "You have something against Johnny?"
msgstr "Tu as quelque chose contre Johnny ?"

# Traduction IA – à relire
#: tyrell_towel/shower_part2/0/g-0/24/17/s/0
msgctxt "Choix"
msgid "Is there something wrong with Bathsheba?"
msgstr "Il y a un problème avec Bathsheba ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_johnny/0/0
msgctxt "Tyrell"
msgid "I don't like... I mean I don't have anything <i>AGAINST</i> him."
msgstr "Je n'aime pas... enfin, je n'ai rien <i>CONTRE</i> lui."

# Traduction IA – à relire
#: tyrell_towel/tyrell_johnny/0/8
msgctxt "Tyrell"
msgid "I think he can be a bit awkward but. And, is Johnny even his real name? Not that I'm judging!"
msgstr "Je le trouve un peu bizarre, mais bon. Et puis, Johnny, c'est vraiment son vrai prénom ? Je ne juge pas, hein !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_johnny/0/16
msgctxt "Tyrell"
msgid "Be whoever you wanna be, you know?"
msgstr "Sois qui tu veux être, tu sais ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_johnny/0/24
msgctxt "Tyrell"
msgid "I can tell you that my fibers don't change. No matter how many times you wash me, I'm gonna be Tyrell."
msgstr "Moi, je peux te dire que mes fibres ne changent pas. Tu peux me laver autant de fois que tu veux, je resterai Tyrell."

# Traduction IA – à relire
#: tyrell_towel/tyrell_johnny/0/32/s/0
msgctxt "Choix"
msgid "Did he do something to you?"
msgstr "Il t'a fait quelque chose ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_johnny/0/33/s/0
msgctxt "Choix"
msgid "He's just a shower head chasing his dreams."
msgstr "C'est juste une pomme de douche qui poursuit ses rêves."

# Traduction IA – à relire
#: tyrell_towel/tyrell_johnny/0/c-0/7
msgctxt "Tyrell"
msgid "No... not exactly..."
msgstr "Non... pas exactement..."

# Traduction IA – à relire
#: tyrell_towel/tyrell_johnny/0/g-0/0
msgctxt "Tyrell"
msgid "He's a good rinser, alright?"
msgstr "Il rince bien, d'accord ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_johnny/0/g-0/8
msgctxt "Tyrell"
msgid "But he keeps me up all night. Every night. He's singin' all the time! Notes just pouring out."
msgstr "Mais il m'empêche de dormir toute la nuit. Toutes les nuits. Il chante sans arrêt ! Les notes coulent à flots."

# Traduction IA – à relire
#: tyrell_towel/tyrell_johnny/0/g-0/16
msgctxt "Tyrell"
msgid "Does he not need rest? 'Cause I need rest. It keeps me soft!"
msgstr "Il n'a pas besoin de repos, lui ? Parce que moi, si. Ça me garde tout doux !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_johnny/0/g-0/24
msgctxt "Tyrell"
msgid "I don't get my sleep, I'll fall apart into a rag in no time."
msgstr "Si je ne dors pas, je vais me transformer en serpillière en un rien de temps."

# Traduction IA – à relire
#: tyrell_towel/tyrell_johnny/0/g-0/32
msgctxt "Tyrell"
msgid "Imagine it. One day, there's a puddle of water on the floor. A big one. You reach for me, but I unravel in your hands."
msgstr "Imagine un peu. Un jour, il y a une flaque par terre. Une grosse. Tu me prends, mais je m'effiloche entre tes mains."

# Traduction IA – à relire
#: tyrell_towel/tyrell_johnny/0/g-0/40
msgctxt "Tyrell"
msgid "Why? Because I didn't have time to rebuild my strength. My threads are bare."
msgstr "Pourquoi ? Parce que je n'ai pas eu le temps de reprendre des forces. Mes fils sont à nu."

# Traduction IA – à relire
#: tyrell_towel/tyrell_johnny/0/g-0/48
msgctxt "Tyrell"
msgid "Next thing I know, you leave me folded in the closet. I never get to hang around the house again."
msgstr "Et la fois d'après, tu me laisses plié au fond du placard. Je ne remets plus jamais les pieds dans la maison."

# Traduction IA – à relire
#: tyrell_towel/tyrell_johnny/0/g-0/56
msgctxt "Tyrell"
msgid "You will never reach for me to wrap you up. To keep you warm."
msgstr "Tu ne me prendras plus jamais pour t'envelopper. Pour te tenir chaud."

# Traduction IA – à relire
#: tyrell_towel/tyrell_johnny/0/g-0/64
msgctxt "Tyrell"
msgid "I'll never clean up the floor puddles again. If I can't do that, what's the use?"
msgstr "Je n'essuierai plus jamais les flaques du sol. Et si je ne peux plus faire ça, à quoi je sers ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_johnny/0/g-0/72/s/0
msgctxt "Choix"
msgid "Floor puddles? That's your dream?"
msgstr "Des flaques par terre ? C'est ça, ton rêve ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_johnny/0/g-0/73/s/0
msgctxt "Choix"
msgid "I think you're being overdramatic."
msgstr "Je crois que tu exagères un peu."

# Traduction IA – à relire
#: tyrell_towel/tyrell_johnny/0/g-0/c-2/7
msgctxt "Tyrell"
msgid "I have dreams of cleanliness you wouldn't believe... In fact..."
msgstr "J'ai des rêves de propreté que tu n'imagines même pas... D'ailleurs..."

# Traduction IA – à relire
#: tyrell_towel/tyrell_johnny/0/g-0/c-3/13
msgctxt "Tyrell"
msgid "Overdramatic?!"
msgstr "J'exagère ?!"

# Traduction IA – à relire
#: tyrell_towel/tyrell_johnny/0/g-0/c-3/24
msgctxt "Tyrell"
msgid "I'm no Chairemi, but I am NOT acting here!"
msgstr "Je ne suis pas Chairemi, mais là, je ne joue PAS la comédie !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_johnny/0/g-0/c-3/35
msgctxt "Tyrell"
msgid "My job has true worth! To soak is spiritual! To wring, divine!"
msgstr "Mon métier a une vraie valeur ! Éponger est humain, essorer est divin !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_johnny/0/g-1/0
msgctxt "Tyrell"
msgid "...huh?"
msgstr "...hein ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_johnny/0/g-1/11
msgctxt "Narrator"
msgid "Tyrell holds his swan up to his ear, nodding as though it were speaking to him."
msgstr "Tyrell porte son cygne à son oreille et hoche la tête comme si celui-ci lui parlait."

# Traduction IA – à relire
#: tyrell_towel/tyrell_johnny/0/g-1/19
msgctxt "Tyrell"
msgid "<i>What's up?</i>"
msgstr "<i>Qu'est-ce qu'il y a ?</i>"

# Traduction IA – à relire
#: tyrell_towel/tyrell_johnny/0/g-1/27
msgctxt "Tyrell"
msgid "<i>Oh, you're right. Good point.</i>"
msgstr "<i>Ah, tu as raison. Bien vu.</i>"

# Traduction IA – à relire
#: tyrell_towel/tyrell_johnny/0/g-1/38
msgctxt "Tyrell"
msgid "My buddy here is right. I can't go pouring my heart out during our first conversation."
msgstr "Mon pote que voilà a raison. Je ne peux pas me mettre à vider mon sac dès notre première conversation."

# Traduction IA – à relire
#: tyrell_towel/tyrell_johnny/0/g-1/46
msgctxt "Tyrell"
msgid "How will I know if you can absorb all the feelings I have?"
msgstr "Comment je saurais si tu es capable d'absorber tout ce que je ressens ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_johnny/0/g-1/54
msgctxt "Tyrell"
msgid "How 'bout this? Let's talk again soon. You might be able to squeeze something out of me."
msgstr "Et si on faisait comme ça ? On se reparle bientôt. À force de me presser, tu arriveras peut-être à m'en tirer quelque chose."

# Traduction IA – à relire
#: tyrell_towel/tyrell_johnny/0/g-1/62
msgctxt "Tyrell"
msgid "But, right now? I've got something I wanna try. I'll see you around the house, yeah?"
msgstr "Mais là, tout de suite ? J'ai un truc à essayer. On se voit dans la maison, d'accord ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_johnny/0/g-1/70/s/0
msgctxt "Choix"
msgid "Okay, see ya!"
msgstr "D'accord, à plus !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_johnny/0/g-1/71/s/0
msgctxt "Choix"
msgid "Sure, Tyrell... sure."
msgstr "Bien sûr, Tyrell... bien sûr."

# Traduction IA – à relire
#: tyrell_towel/tyrell_johnny/0/g-1/c-4/7
msgctxt "Tyrell"
msgid "See ya!"
msgstr "À plus !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_johnny/0/g-1/c-5/7
msgctxt "Tyrell"
msgid "You'll see!"
msgstr "Tu verras !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_johnny/0/g-2/0
msgctxt "Tyrell"
msgid "<i>Hey, buuuuuuddy!</i>"
msgstr "<i>Hé, mon poooooote !</i>"

# Traduction IA – à relire
#: tyrell_towel/tyrell_johnny/0/g-2/11
msgctxt "Tyrell"
msgid "I've got an idea!"
msgstr "J'ai une idée !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathsheba/0/0
msgctxt "Tyrell"
msgid "Oh, no, no! Bathsheba is great! I want to make that clear."
msgstr "Oh, non, non ! Bathsheba est géniale ! Je tiens à ce que ce soit clair."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathsheba/0/8
msgctxt "Tyrell"
msgid "I just... sometimes I get a little... concerned?"
msgstr "C'est juste que... parfois, je suis un peu... inquiet ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathsheba/0/16
msgctxt "Tyrell"
msgid "Like, I just wish you had talked to me sooner?"
msgstr "Genre, j'aurais aimé que tu me parles plus tôt ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathsheba/0/24
msgctxt "Tyrell"
msgid "But I'm glad you got to visit with Bathsheba. I really am."
msgstr "Mais je suis content que tu aies passé du temps avec Bathsheba. Vraiment."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathsheba/0/32/s/0
msgctxt "Choix"
msgid "You are cute when you are jealous!"
msgstr "Tu es mignon quand tu es jaloux !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathsheba/0/33/s/0
msgctxt "Choix"
msgid "Jealous so quickly! I'm not sure I like that."
msgstr "Jaloux aussi vite ! Je ne suis pas sûr que ça me plaise."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathsheba/0/c-0/7
msgctxt "Tyrell"
msgid "Thanks! I mean... it would be true if I were jealous!"
msgstr "Merci ! Enfin... ce serait vrai si j'étais jaloux !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathsheba/0/c-0/15
msgctxt "Tyrell"
msgid "Which, I'm totally not!"
msgstr "Ce que je ne suis absolument pas !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathsheba/0/c-0/26/0/s/0 tyrell_towel/tyrell_bathsheba/0/c-1/66/0/s/0
msgctxt "Choix"
msgid "You sure about that?"
msgstr "Tu en es sûr ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathsheba/0/c-1/7 tyrell_towel/tyrell_bathsheba/0/c-1/42
msgctxt "Tyrell"
msgid "Me?"
msgstr "Moi ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathsheba/0/c-1/15 tyrell_towel/tyrell_bathsheba/0/c-1/50
msgctxt "Tyrell"
msgid "Jealous?"
msgstr "Jaloux ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathsheba/0/c-1/26 tyrell_towel/tyrell_bathsheba/0/c-1/58
msgctxt "Tyrell"
msgid "Psh."
msgstr "Pfff."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathsheba/0/c-1/34
msgctxt "Tyrell"
msgid "Far from it."
msgstr "Loin de là."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathsheba/0/c-1/66/1/s/0
msgctxt "Choix"
msgid "You totally are! You are so jelly!"
msgstr "Mais si, tu l'es ! Tu es vert de jalousie !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_denial/0/0
msgctxt "Tyrell"
msgid "Of course I'm sure!"
msgstr "Bien sûr que j'en suis sûr !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_denial/0/8
msgctxt "Tyrell"
msgid "I mean, I know y'all splash around, having a good time."
msgstr "Enfin, je sais bien que vous barbotez ensemble, que vous vous amusez bien."

# Traduction IA – à relire
#: tyrell_towel/tyrell_denial/0/16
msgctxt "Tyrell"
msgid "Leaving water all over the floor. Water that I have to clean up!"
msgstr "Que vous laissez de l'eau partout par terre. De l'eau que c'est moi qui dois essuyer !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_denial/0/27/s/0
msgctxt "Choix"
msgid "Am I making too much of a mess?"
msgstr "Je fais trop de dégâts ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_denial/0/28/s/0
msgctxt "Choix"
msgid "Is that what this is about?"
msgstr "C'est de ça qu'il s'agit ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_denial/0/c-0/7
msgctxt "Tyrell"
msgid "No! You're great."
msgstr "Non ! Tu es super."

# Traduction IA – à relire
#: tyrell_towel/tyrell_denial/0/c-1/7
msgctxt "Tyrell"
msgid "Well... no!"
msgstr "Enfin... non !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_denial/0/c-1/15
msgctxt "Tyrell"
msgid "Look..."
msgstr "Écoute..."

# Traduction IA – à relire
#: tyrell_towel/tyrell_denial/0/g-0/0
msgctxt "Tyrell"
msgid "I don't mind cleaning it up. It is my specialty. Absorbent is my middle name."
msgstr "Ça ne me dérange pas de nettoyer. C'est ma spécialité. Absorbant, c'est mon deuxième prénom."

# Traduction IA – à relire
#: tyrell_towel/tyrell_denial/0/g-0/8/s/0
msgctxt "Choix"
msgid "Is it really?"
msgstr "Vraiment ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_denial/0/g-0/9/s/0
msgctxt "Choix"
msgid "I can be more careful next time I take a bath. I promise."
msgstr "Je ferai plus attention la prochaine fois que je prendrai un bain. Promis."

# Traduction IA – à relire
#: tyrell_towel/tyrell_denial/0/g-0/c-2/7
msgctxt "Tyrell"
msgid "No. It's actually Terry."
msgstr "Non. En fait, c'est Éponge."

# Traduction IA – à relire
#: tyrell_towel/tyrell_denial/0/g-0/c-2/15
msgctxt "Tyrell"
msgid "But that's not the point."
msgstr "Mais ce n'est pas la question."

# Traduction IA – à relire
#: tyrell_towel/tyrell_denial/0/g-0/c-3/7
msgctxt "Tyrell"
msgid "No. It's fine."
msgstr "Non. Ça va."

# Traduction IA – à relire
#: tyrell_towel/tyrell_denial/0/g-1/0
msgctxt "Tyrell"
msgid "I'm just... I'm used to coming second, I guess."
msgstr "C'est juste que... j'ai l'habitude de passer en second, je crois."

# Traduction IA – à relire
#: tyrell_towel/tyrell_denial/0/g-1/8/s/0
msgctxt "Choix"
msgid "What makes you say that?"
msgstr "Qu'est-ce qui te fait dire ça ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_denial/0/g-1/9/s/0
msgctxt "Choix"
msgid "Honestly I would never put a towel as the main character in anything."
msgstr "Honnêtement, je ne mettrais jamais une serviette en personnage principal, quoi que ce soit."

# Traduction IA – à relire
#: tyrell_towel/tyrell_denial/0/g-1/c-5/13
msgctxt "Tyrell"
msgid "Damn you."
msgstr "Merci bien."

# Traduction IA – à relire
#: tyrell_towel/tyrell_denial/0/g-1/c-5/24
msgctxt "Tyrell"
msgid "...but it's true. I'm just a side guy. Behind the scenes... never the star."
msgstr "...mais c'est vrai. Je suis un second rôle. Dans les coulisses... jamais la vedette."

# Traduction IA – à relire
#: tyrell_towel/tyrell_denial/0/g-2/0
msgctxt "Tyrell"
msgid "I'm always there for the messes in life. Never the memories."
msgstr "Je suis toujours là pour les dégâts de la vie. Jamais pour les souvenirs."

# Traduction IA – à relire
#: tyrell_towel/tyrell_denial/0/g-2/8
msgctxt "Tyrell"
msgid "Look at me! Getting all sentimental and we just met."
msgstr "Regarde-moi ! Je deviens sentimental alors qu'on vient à peine de se rencontrer."

# Traduction IA – à relire
#: tyrell_towel/tyrell_denial/0/g-2/16
msgctxt "Tyrell"
msgid "You think I'm jealous? How about this. Let's get to know each other a bit."
msgstr "Tu me trouves jaloux ? Alors faisons ça : apprenons à nous connaître un peu."

# Traduction IA – à relire
#: tyrell_towel/tyrell_denial/0/g-2/24
msgctxt "Tyrell"
msgid "Then you might make me spill the beans."
msgstr "Peut-être que tu arriveras à m'essorer les confidences."

# Traduction IA – à relire
#: tyrell_towel/tyrell_denial/0/g-2/32
msgctxt "Tyrell"
msgid "Until then, splash away!"
msgstr "D'ici là, éclabousse-toi tant que tu veux !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_denial/0/g-2/40
msgctxt "Tyrell"
msgid "I'll get the puddles. Don't worry."
msgstr "Je m'occupe des flaques. Ne t'en fais pas."

# Traduction IA – à relire
#: tyrell_towel/tyrell_admission/0/0
msgctxt "Tyrell"
msgid "I mean... maybe. Just a little."
msgstr "Je veux dire... peut-être. Un tout petit peu."

# Traduction IA – à relire
#: tyrell_towel/tyrell_admission/0/8
msgctxt "Tyrell"
msgid "But it's not that big of a deal."
msgstr "Mais ce n'est pas si grave."

# Traduction IA – à relire
#: tyrell_towel/tyrell_admission/0/16/s/0
msgctxt "Choix"
msgid "Are you sure??"
msgstr "Tu es sûr ??"

# Traduction IA – à relire
#: tyrell_towel/tyrell_admission/0/17/s/0
msgctxt "Choix"
msgid "If you're upset, it's a big deal."
msgstr "Si tu es contrarié, c'est grave."

# Traduction IA – à relire
#: tyrell_towel/tyrell_admission/0/c-1/7
msgctxt "Tyrell"
msgid "I guess it is bothering me more than I thought it was."
msgstr "Je crois que ça me dérange plus que je ne le pensais."

# Traduction IA – à relire
#: tyrell_towel/tyrell_admission/0/c-1/15
msgctxt "Tyrell"
msgid "It's just... I'm not really sure how to explain it."
msgstr "C'est juste que... je ne sais pas trop comment l'expliquer."

# Traduction IA – à relire
#: tyrell_towel/tyrell_admission/0/c-1/23
msgctxt "Tyrell"
msgid "Maybe if you give me some time to think about it, I'll be able to put it to words."
msgstr "Si tu me laisses un peu de temps pour y réfléchir, j'arriverai peut-être à le mettre en mots."

# Traduction IA – à relire
#: tyrell_towel/tyrell_admission/0/c-1/31
msgctxt "Tyrell"
msgid "But, that means you've gotta come back and talk to me again. Cool?"
msgstr "Mais ça veut dire que tu dois revenir me parler. Ça marche ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_admission/0/c-1/39
msgctxt "Tyrell"
msgid "If you come back, I'll be able to show you something pretty fun."
msgstr "Si tu reviens, je pourrai te montrer un truc plutôt marrant."

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/0
msgctxt "Narrator"
msgid "Tyrell looks delighted to see you as you come across him again in the bathroom."
msgstr "Tyrell a l'air ravi de vous voir quand vous le recroisez dans la salle de bain."

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/8
msgctxt "Tyrell"
msgid "Lemme see those damp hands!"
msgstr "Montre-moi tes mains humides !"

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/16/s/0
msgctxt "Choix"
msgid "Here you go!"
msgstr "Tiens, voilà !"

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/17/s/0
msgctxt "Choix"
msgid "No way, I love my drip."
msgstr "Hors de question, j'adore mon drip."

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/18/s/0
msgctxt "Choix"
msgid "You... like my damp hands?"
msgstr "Tu... aimes mes mains humides ?"

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/c-0/13
msgctxt "Tyrell"
msgid "Yeah!"
msgstr "Ouais !"

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/c-0/21 tyrell_towel/bathroom_tyrell_join_start/0/c-2/18
msgctxt "Narrator"
msgid "He cozies up against you, spreading warmth through your hands, all the way up your body."
msgstr "Il se blottit contre vous et répand sa chaleur dans vos mains, puis dans tout votre corps."

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/c-0/29
msgctxt "Tyrell"
msgid "Mmmm..."
msgstr "Mmmm..."

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/c-0/37
msgctxt "Tyrell"
msgid "Gotta say... I love making you toasty more than anything."
msgstr "Je dois dire que... rien ne me plaît plus que de te réchauffer."

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/c-0/48/0/s/0
msgctxt "Choix"
msgid "Thanks..."
msgstr "Merci..."

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/c-0/48/1/s/0
msgctxt "Choix"
msgid "Okay."
msgstr "D'accord."

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/c-0/48/2/s/0
msgctxt "Choix"
msgid "Stick to the cleaning, buddy."
msgstr "Contente-toi du ménage, poto."

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/c-0/48/c-0/7
msgctxt "Tyrell"
msgid "My pleasure..."
msgstr "Avec plaisir..."

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/c-0/48/c-2/7
msgctxt "Tyrell"
msgid "Hey c'mon, a towel can't have a little fun? Sheesh..."
msgstr "Oh, allez, une serviette n'a pas le droit de s'amuser un peu ? Pfff..."

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/c-1/7
msgctxt "Tyrell"
msgid "Uh..."
msgstr "Euh..."

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/c-1/15
msgctxt "Tyrell"
msgid "That is not the kinda drip that everyone's talkin' about these days."
msgstr "C'est pas ce genre de drip dont tout le monde parle en ce moment."

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/c-1/23/0/s/0
msgctxt "Choix"
msgid "I like soggy hands, dude."
msgstr "J'aime les mains détrempées, {{mec|meuf|poto}}."

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/c-1/23/1/s/0
msgctxt "Choix"
msgid "Ohh... sorry I'm out of touch."
msgstr "Ohh... désolé, je suis complètement dépassé."

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/c-1/23/c-0/7
msgctxt "Tyrell"
msgid "I'm... just gonna change subject..."
msgstr "Je vais juste... changer de sujet..."

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/c-1/23/c-0/15
msgctxt "Tyrell"
msgid "Now."
msgstr "Voilà."

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/c-1/23/c-1/7
msgctxt "Tyrell"
msgid "Yeah, a little..."
msgstr "Ouais, un peu..."

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/c-2/7
msgctxt "Tyrell"
msgid "Nothing better. I get to soak up all you've got goin' on and leave you feeling refreshed!"
msgstr "Rien de mieux. J'absorbe tout ce qui te tracasse et je te laisse tout frais !"

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/c-2/29 tyrell_towel/tyrell_nervous/0/g-2/c-11/15/c-0/7
msgctxt "Tyrell"
msgid "Phew!"
msgstr "Ouf !"

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/g-0/0
msgctxt "Tyrell"
msgid "Okay, soooo..."
msgstr "Bon, alors..."

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/g-0/8
msgctxt "Tyrell"
msgid "Last time you came by here I might've been a little, uh, jealous of the attentions you've been giving others."
msgstr "La dernière fois que tu es passé par ici, j'étais peut-être un peu, euh, jaloux des attentions que tu portais aux autres."

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/g-0/16
msgctxt "Tyrell"
msgid "But that's water under the fridge now!"
msgstr "Mais de l'eau a coulé sous le frigo depuis !"

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/g-0/24/s/0
msgctxt "Choix"
msgid "I'm glad to hear it!"
msgstr "Ça me fait plaisir !"

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/g-0/25/s/0
msgctxt "Choix"
msgid "Aw, what's dating everything all about if not causing jealousy?"
msgstr "Ben quoi, sortir avec tout le monde, c'est quoi si ce n'est rendre jaloux ?"

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/g-0/26/s/0
msgctxt "Choix"
msgid "Sure..."
msgstr "Bien sûr..."

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/g-0/27/s/0
msgctxt "Choix"
msgid "Under the fridge? Do you do that?"
msgstr "Sous le frigo ? Tu fais ça, toi ?"

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/g-0/c-3/7
msgctxt "Tyrell"
msgid "Glad to hear you're glad to hear it!"
msgstr "Content que tu sois content de l'entendre !"

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/g-0/c-4/7
msgctxt "Tyrell"
msgid "Well put!"
msgstr "Bien dit !"

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/g-0/c-6/7
msgctxt "Tyrell"
msgid "Nuh-uh. That's strictly a mop level situation."
msgstr "Non, non. Ça, c'est strictement du niveau serpillière."

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/g-0/c-6/15/0/s/0
msgctxt "Choix"
msgid "I don't have a mop."
msgstr "Je n'ai pas de serpillière."

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/g-0/c-6/15/1/s/0
msgctxt "Choix"
msgid "Good to know."
msgstr "Bon à savoir."

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/g-0/c-6/15/c-0/7
msgctxt "Tyrell"
msgid "Then that particular water is staying under the fridge."
msgstr "Alors cette eau-là reste sous le frigo."

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/g-0/c-6/15/c-1/7
msgctxt "Tyrell"
msgid "Thank you."
msgstr "Merci."

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/g-1/0
msgctxt "Tyrell"
msgid "And look... since you came by... you get to see my newest... oh, I never know what to call it."
msgstr "Et regarde... puisque tu es passé... tu vas voir ma toute dernière... oh, je ne sais jamais comment l'appeler."

# Traduction IA – à relire
#: tyrell_towel/bathroom_tyrell_join_start/0/g-1/8 tyrell_towel/tyrell_bedroom/0/g-0/16
msgctxt "Tyrell"
msgid "Creation? Formation?"
msgstr "Création ? Formation ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/7
msgctxt "Tyrell"
msgid "I'm so glad you're here, we've got to talk."
msgstr "Je suis si content que tu sois là, il faut qu'on parle."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/15/s/0
msgctxt "Choix"
msgid "Are things progressing with us that quickly?"
msgstr "Les choses avancent aussi vite entre nous ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/16/s/0
msgctxt "Choix"
msgid "C'mon, what is this..."
msgstr "Oh, allez, c'est quoi, ça..."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/17/s/0
msgctxt "Choix"
msgid "Why? What's wrong?"
msgstr "Pourquoi ? Qu'est-ce qui ne va pas ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/c-1/7
msgctxt "Tyrell"
msgid "This is an intervention."
msgstr "C'est une intervention."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/c-2/7
msgctxt "Tyrell"
msgid "What's wrong?"
msgstr "Qu'est-ce qui ne va pas ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-0/0
msgctxt "Tyrell"
msgid "I've been thinking that maybe..."
msgstr "Je me disais que peut-être..."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-0/16
msgctxt "Tyrell"
msgid "You need to redo this bathroom."
msgstr "Il faut que tu refasses cette salle de bain."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-0/27
msgctxt "Tyrell"
msgid "Like, a fresh coat of paint or something!"
msgstr "Genre, un petit coup de peinture fraîche !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-0/35
msgctxt "Tyrell"
msgid "You know what it's like to come to work and see the same thing EVERY DAY?"
msgstr "Tu sais ce que ça fait d'arriver au travail et de voir la même chose TOUS LES JOURS ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-0/43/s/0
msgctxt "Choix"
msgid "Yeah... I do."
msgstr "Ouais... je sais."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-0/44/s/0
msgctxt "Choix"
msgid "Imagine looking at a screen all day."
msgstr "Imagine regarder un écran toute la journée."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-0/45/s/0
msgctxt "Choix"
msgid "I don't leave the house at all."
msgstr "Je ne quitte jamais la maison."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-1/0
msgctxt "Tyrell"
msgid "...you make a valid point."
msgstr "...tu marques un point."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-1/8
msgctxt "Tyrell"
msgid "Why is it that I always make a fool out of myself in here?"
msgstr "Pourquoi est-ce que je me ridiculise toujours ici ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-1/16
msgctxt "Tyrell"
msgid "I guess if there is any place for crap to come out of my mouth, this would be it."
msgstr "Je suppose que s'il y a un endroit où des conneries peuvent sortir de ma bouche, c'est bien celui-là."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-1/24
msgctxt "Tyrell"
msgid "Hey that one was pretty good."
msgstr "Eh, celle-là était plutôt bonne."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-1/32
msgctxt "Tyrell"
msgid "<i>Say it was pretty good.</i>"
msgstr "<i>Dis que c'était plutôt bon.</i>"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-1/40/s/0
msgctxt "Choix"
msgid "It was pretty good!"
msgstr "C'était plutôt bon !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-1/41/s/0
msgctxt "Choix"
msgid "It was pretty good."
msgstr "C'était plutôt bon."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-1/42/s/0
msgctxt "Choix"
msgid "You're ridiculous."
msgstr "Tu es ridicule."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-1/43/s/0
msgctxt "Choix"
msgid "That was awful."
msgstr "C'était nul."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-1/c-6/13
msgctxt "Tyrell"
msgid "And I'm back!"
msgstr "Et me revoilà !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-1/c-7/7
msgctxt "Tyrell"
msgid "Hmm.... I noticed that punctuation choice."
msgstr "Hmm.... J'ai remarqué ce choix de ponctuation."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-1/c-8/13
msgctxt "Tyrell"
msgid "Ridiculously soft!"
msgstr "Ridiculement doux !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-1/c-9/13
msgctxt "Tyrell"
msgid "But I know my smile makes up for it."
msgstr "Mais je sais que mon sourire rattrape le coup."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-2/0
msgctxt "Tyrell"
msgid "Oh! I know what can turn this conversation around."
msgstr "Oh ! Je sais ce qui peut remonter cette conversation."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-2/8
msgctxt "Tyrell"
msgid "I have something to shoooow yooooou!"
msgstr "J'ai un truc à te mooooontrer !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-2/16
msgctxt "Tyrell"
msgid "Now, I need you to be kind, okay? This is our first time attempting this one."
msgstr "Là, je compte sur ta bienveillance, d'accord ? C'est la première fois qu'on tente celui-là."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-2/24/s/0
msgctxt "Choix"
msgid "Our?"
msgstr "On ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-2/c-10/7
msgctxt "Tyrell"
msgid "Oh, me and my towel buddy!"
msgstr "Oh, moi et ma Serviette-Pote !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-2/c-10/15
msgctxt "Tyrell"
msgid "Just wait until you see what we've been able to pull off."
msgstr "Attends de voir ce qu'on a réussi à faire."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-2/c-10/23
msgctxt "Tyrell"
msgid "Without further ado... I present to you... TOWEL TURTLE!"
msgstr "Sans plus attendre... je vous présente... la TORTUE-SERVIETTE !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-3/3 tyrell_towel/tyrell_bedroom/0/g-1/22 tyrell_towel/tyrell_laundry/0/g-1/22
msgctxt "Narrator"
msgid "Tyrell holds his towel buddy out to you—a sweet, absorbent little turtle."
msgstr "Tyrell vous tend sa serviette-pote : une adorable petite tortue absorbante."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-3/11
msgctxt "Tyrell"
msgid "What do you think? Precious, right?"
msgstr "Qu'est-ce que tu en penses ? Précieuse, non ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-3/19/s/0
msgctxt "Choix"
msgid "So cuuuute!"
msgstr "Trop mignooooon !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-3/20/s/0
msgctxt "Choix"
msgid "It's whatever."
msgstr "Bof, c'est correct."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-3/c-11/7
msgctxt "Tyrell"
msgid "I know! I love them, too!"
msgstr "Je sais ! Moi aussi, je l'adore !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-3/c-12/13
msgctxt "Tyrell"
msgid "You can play hard to impress all you want. I know you wanna snuggle with it."
msgstr "Tu as beau jouer l'indifférence, je sais que tu as envie de lui faire un câlin."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-4/0
msgctxt "Tyrell"
msgid "The shell was the hardest part."
msgstr "La carapace, c'était le plus dur."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-4/8
msgctxt "Tyrell"
msgid "But, I'm super happy how it turned out."
msgstr "Mais je suis super content du résultat."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-4/16
msgctxt "Tyrell"
msgid "And my little buddy is happy, too!"
msgstr "Et mon petit pote est content aussi !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-4/24/s/0
msgctxt "Choix"
msgid "Why do you keep changing the way your animal friend looks?"
msgstr "Pourquoi tu changes tout le temps l'apparence de ton ami animal ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-4/25/s/0
msgctxt "Choix"
msgid "What brought the two of you together?"
msgstr "Qu'est-ce qui vous a réunis, tous les deux ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-4/26/s/0 tyrell_towel/tyrell_laundry/0/g-2/16/0/s/0
msgctxt "Choix"
msgid "Sounds pretty silly to me. Why don't you just fold yourself?"
msgstr "Ça me paraît un peu idiot. Pourquoi tu ne te plies pas toi-même ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-4/c-13/7
msgctxt "Tyrell"
msgid "That's... well... if you must know."
msgstr "C'est que... bon... si tu veux tout savoir."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-4/c-15/13 tyrell_towel/tyrell_laundry/0/g-2/16/c-6/13
msgctxt "Tyrell"
msgid "I do... but it can hurt sometimes you know?"
msgstr "Je le fais... mais ça peut faire mal parfois, tu sais ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bathroom_2/0/g-4/c-15/24 tyrell_towel/tyrell_laundry/0/g-2/16/c-6/24
msgctxt "Tyrell"
msgid "I don't like discovering that I've twisted myself the wrong way and I've got creases in all the wrong places."
msgstr "Je déteste m'apercevoir que je me suis tordu dans le mauvais sens et que j'ai des plis aux mauvais endroits."

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/0
msgctxt "Narrator"
msgid "Tyrell shifts uncomfortably, still seeming to address someone you can't see."
msgstr "Tyrell se tortille, mal à l'aise, et semble toujours s'adresser à quelqu'un que vous ne voyez pas."

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/8
msgctxt "Tyrell"
msgid "Agh. C'mon man..."
msgstr "Aïe. Allez, mon vieux..."

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/16
msgctxt "Tyrell"
msgid "<i>I know I'm bombing!</i>"
msgstr "<i>Je sais que je fais un bide !</i>"

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/24
msgctxt "Narrator"
msgid "He gives you a sheepish little smile."
msgstr "Il vous adresse un petit sourire penaud."

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/32
msgctxt "Tyrell"
msgid "Don't mind me. Just talking to my towel buddy."
msgstr "Ne fais pas attention à moi. Je parle juste à ma Serviette-Pote."

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/40/s/0
msgctxt "Choix"
msgid "Towel... buddy?"
msgstr "Serviette... pote ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/41/s/0
msgctxt "Choix"
msgid "What is that?"
msgstr "C'est quoi, ça ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/c-0/7
msgctxt "Tyrell"
msgid "Nah faster, like 'Towel Buddy'."
msgstr "Non, plus vite : « Serviette-Pote »."

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/g-0/0
msgctxt "Tyrell"
msgid "Well, it is whatever I fold it up to be."
msgstr "Eh bien, c'est ce que j'ai décidé de plier."

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/g-0/8
msgctxt "Tyrell"
msgid "But today, it's a swan."
msgstr "Mais aujourd'hui, c'est un cygne."

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/g-0/19 tyrell_towel/tyrell_hero/0/54
msgctxt "Narrator"
msgid "He holds out a small, swan-shaped towel for your inspection. It's quite charming."
msgstr "Il vous tend un petit cygne en serviette pour que vous l'examiniez. Il est tout à fait charmant."

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/g-0/27
msgctxt "Tyrell"
msgid "...I can get a bit bored is all..."
msgstr "...je m'ennuie un peu, c'est tout..."

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/g-0/35 tyrell_towel/tyrell_nervous/0/g-2/c-11/15/c-1/7
msgctxt "Tyrell"
msgid "Yeah..."
msgstr "Ouais..."

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/g-0/51
msgctxt "Narrator"
msgid "You and Tyrell look at each other, neither of you speaking. The silence is long... and awkward."
msgstr "Vous et Tyrell vous regardez sans rien dire. Le silence dure longtemps... et il est gênant."

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/g-0/59
msgctxt "Tyrell"
msgid "Come here often?"
msgstr "Tu viens souvent ici ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/g-0/70/s/0
msgctxt "Choix"
msgid "Yeah. It <i>is</i> the bathroom."
msgstr "Ouais. C'<i>est</i> la salle de bain."

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/g-0/71/s/0
msgctxt "Choix"
msgid "Yeah. It <i>is</i> my bedroom."
msgstr "Ouais. C'<i>est</i> ma chambre."

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/g-0/72/s/0
msgctxt "Choix"
msgid "Yeah. It <i>is</i> the kitchen."
msgstr "Ouais. C'<i>est</i> la cuisine."

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/g-0/73/s/0
msgctxt "Choix"
msgid "The laundry room? Sometimes... I guess?"
msgstr "La buanderie ? Parfois... je suppose ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/g-0/74/s/0
msgctxt "Choix"
msgid "Not often enough, honestly."
msgstr "Pas assez souvent, honnêtement."

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/g-0/c-2/7 tyrell_towel/tyrell_nervous/0/g-0/c-3/7 tyrell_towel/tyrell_nervous/0/g-0/c-4/7 tyrell_towel/tyrell_nervous/0/g-0/c-5/7
msgctxt "Tyrell"
msgid "Right, right."
msgstr "Oui, oui."

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/g-0/c-6/7
msgctxt "Tyrell"
msgid "Yeah, that's an odd question to ask..."
msgstr "Ouais, c'est une drôle de question..."

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/g-1/0
msgctxt "Tyrell"
msgid "I'm coming off a bit dry, aren't I?"
msgstr "Je fais un peu sec, non ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/g-1/8/s/0
msgctxt "Choix"
msgid "You just seem nervous."
msgstr "Tu as juste l'air nerveux."

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/g-1/9/s/0
msgctxt "Choix"
msgid "Maybe I should go..."
msgstr "Je devrais peut-être y aller..."

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/g-1/c-7/7
msgctxt "Tyrell"
msgid "I seem that way because I am!"
msgstr "J'ai l'air nerveux parce que je le suis !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/g-1/c-8/7
msgctxt "Tyrell"
msgid "Not after so little time..."
msgstr "Pas après si peu de temps..."

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/g-2/0
msgctxt "Tyrell"
msgid "Can I just start again?"
msgstr "Je peux recommencer à zéro ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/g-2/8
msgctxt "Narrator"
msgid "He extends his hand to you, and when you take it he gives it a firm, confident shake."
msgstr "Il vous tend la main, et quand vous la prenez, il la serre avec fermeté et assurance."

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/g-2/16
msgctxt "Tyrell"
msgid "I'm Tyrell."
msgstr "Je m'appelle Tyrell."

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/g-2/24
msgctxt "Tyrell"
msgid "If you've got a spill, call me and chill."
msgstr "Si ça déborde, appelle-moi, on se détend !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/g-2/32/s/0
msgctxt "Choix"
msgid "That sucks, honestly."
msgstr "Honnêtement, c'est nul."

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/g-2/33/s/0
msgctxt "Choix"
msgid "Did you think of that all on your own?"
msgstr "Tu as trouvé ça tout seul ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/g-2/34/s/0
msgctxt "Choix"
msgid "That's pretty clever!"
msgstr "C'est plutôt malin !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/g-2/c-9/7
msgctxt "Tyrell"
msgid "Oh damn..."
msgstr "Oh, mince..."

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/g-2/c-9/15
msgctxt "Tyrell"
msgid "I just get lost in my work sometimes."
msgstr "Je me perds parfois dans mon travail."

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/g-2/c-9/23/0/s/0
msgctxt "Choix"
msgid "What do you mean?"
msgstr "Comment ça ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/g-2/c-9/23/1/s/0
msgctxt "Choix"
msgid "Don't you just clean up messes?"
msgstr "Tu ne fais pas juste éponger des dégâts ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/g-2/c-10/7 tyrell_towel/tyrell_nervous/0/g-2/c-11/7
msgctxt "Tyrell"
msgid "It's just something I'm workshopping."
msgstr "C'est juste un truc que je peaufine."

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/g-2/c-11/15/0/s/0
msgctxt "Choix"
msgid "It's really good!"
msgstr "C'est très bien !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/g-2/c-11/15/1/s/0
msgctxt "Choix"
msgid "It could use another pass, I think."
msgstr "Ça mériterait une autre passe, je crois."

# Traduction IA – à relire
#: tyrell_towel/tyrell_nervous/0/g-3/0
msgctxt "Tyrell"
msgid "I'm trying too hard. I tend to do that."
msgstr "J'essaie trop fort. J'ai tendance à faire ça."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/0
msgctxt "Tyrell"
msgid "I may be soft, but I'm hard against spills."
msgstr "Je suis peut-être tout doux, mais je suis dur avec les dégâts !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/11
msgctxt "Narrator"
msgid "He mimes playing a trumpet, imitating the instrument with his mouth."
msgstr "Il mime un joueur de trompette en imitant l'instrument avec sa bouche."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/19
msgctxt "Tyrell"
msgid "Fttrrr fr frrruh!"
msgstr "Fttrrr fr frrruh !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/27
msgctxt "Tyrell"
msgid "I dry as quick as my wit!"
msgstr "Je sèche aussi vite que ma répartie !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/35
msgctxt "Tyrell"
msgid "If you get wet, don't get upset!"
msgstr "Si t'es mouillé, pas de quoi pleurer : je viens te sécher !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/43
msgctxt "Tyrell"
msgid "Isn't that right, my absorbent sidekick?"
msgstr "N'est-ce pas, mon acolyte absorbant ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/62
msgctxt "Tyrell"
msgid "<w>Squack!</w>"
msgstr "<w>Couac !</w>"

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/73/s/0
msgctxt "Choix"
msgid "Woah! What is that?"
msgstr "Waouh ! C'est quoi, ça ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/74/s/0
msgctxt "Choix"
msgid "You have a sidekick?"
msgstr "Tu as un acolyte ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/c-0/7
msgctxt "Tyrell"
msgid "Oh this...?"
msgstr "Ah, ça... ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/c-1/7
msgctxt "Tyrell"
msgid "Kinda...?"
msgstr "En quelque sorte... ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/g-0/0
msgctxt "Tyrell"
msgid "This is little buddy. He's pretty cool. I can fold him into anything I want."
msgstr "C'est mon petit pote. Il est plutôt cool. Je peux le plier en tout ce que je veux."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/g-0/8
msgctxt "Tyrell"
msgid "Today? A swan. Tomorrow? Who knows what the fabric of the universe will weave..."
msgstr "Aujourd'hui ? Un cygne. Demain ? Qui sait ce que la trame de l'univers va tisser..."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/g-0/16
msgctxt "Tyrell"
msgid "I mean, I only know how to fold like... two others... but still."
msgstr "Enfin, je ne sais plier que, genre... deux autres trucs... mais quand même."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/g-0/24
msgctxt "Tyrell"
msgid "It keeps me busy between cleaning spills and warming up your body."
msgstr "Ça m'occupe entre les dégâts à éponger et ton corps à réchauffer."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/g-0/32/s/0
msgctxt "Choix"
msgid "Damn that was quick."
msgstr "Mince, c'était rapide."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/g-0/33/s/0
msgctxt "Choix"
msgid "Warming my body, you say?"
msgstr "Réchauffer mon corps, dis-tu ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/g-0/34/s/0
msgctxt "Choix"
msgid "Oooo. Saucy!"
msgstr "Oooh. Coquin !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/g-0/35/s/0
msgctxt "Choix"
msgid "Anyone would be lucky to be wrapped up in you."
msgstr "On aurait bien de la chance de s'enrouler dans tes plis."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/g-0/c-2/7
msgctxt "Tyrell"
msgid "I SEE YOU NAKED ALL THE TIME!"
msgstr "JE TE VOIS À POIL TOUT LE TEMPS !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/g-0/c-2/15
msgctxt "Tyrell"
msgid "And that's totally normal for a towel."
msgstr "Et c'est tout à fait normal pour une serviette."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/g-0/c-2/23
msgctxt "Tyrell"
msgid "It's my job."
msgstr "C'est mon boulot."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/g-0/c-2/31/0/s/0
msgctxt "Choix"
msgid "Is your job flirting or drying?"
msgstr "Ton boulot, c'est de flirter ou de sécher ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/g-0/c-2/31/c-0/7
msgctxt "Tyrell"
msgid "Heh... what's wrong with both?"
msgstr "Heh... qu'est-ce qui cloche avec les deux ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/g-0/c-2/31/c-0/15
msgctxt "Tyrell"
msgid "I keep myself pretty busy."
msgstr "Je ne chôme pas."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/g-0/c-3/7
msgctxt "Tyrell"
msgid "You heard me!"
msgstr "Tu m'as bien entendu !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/g-0/c-3/15
msgctxt "Tyrell"
msgid "It's my job after all."
msgstr "C'est mon boulot, après tout."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/g-0/c-4/7
msgctxt "Tyrell"
msgid "Who doesn't like being close to someone?"
msgstr "Qui n'aime pas être proche de quelqu'un ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/g-0/c-4/15
msgctxt "Tyrell"
msgid "I'm just lucky that it's a part of my job."
msgstr "J'ai de la chance que ça fasse partie de mon boulot."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/g-0/c-5/7
msgctxt "Tyrell"
msgid "Oh, you are a forward one, aren't you?"
msgstr "Eh bien, tu ne perds pas de temps, toi !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/g-0/c-5/15/0/s/0
msgctxt "Choix"
msgid "I'm comfortable around you."
msgstr "Je suis à l'aise avec toi."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/g-0/c-5/15/1/s/0
msgctxt "Choix"
msgid "Confidence is attractive."
msgstr "La confiance en soi, c'est attirant."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/g-0/c-5/15/c-0/7
msgctxt "Tyrell"
msgid "I'm glad you think so - I'm a plushy guy."
msgstr "Content que tu le penses. Je suis un gars tout doux, moi."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/g-0/c-5/15/c-1/7
msgctxt "Tyrell"
msgid "So are folding skills!"
msgstr "Mes talents de pliage aussi !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/g-0/c-5/15/c-1/15
msgctxt "Tyrell"
msgid "I've been told."
msgstr "On me l'a dit."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/g-0/c-5/15/g-0/0
msgctxt "Tyrell"
msgid "Gotta say... This is the most fun I've had talking in awhile."
msgstr "Je dois dire que... c'est la conversation la plus agréable que j'aie eue depuis un moment."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/g-0/c-5/15/g-0/8
msgctxt "Tyrell"
msgid "I keep myself pretty busy with my job."
msgstr "Mon boulot me tient pas mal occupé."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/g-0/c-5/15/g-0/16/0/s/0
msgctxt "Choix"
msgid "Tell me about it."
msgstr "À qui le dis-tu."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/g-0/c-5/15/g-0/16/1/s/0
msgctxt "Choix"
msgid "I'm not making too much work for you, am I?"
msgstr "Je ne te donne pas trop de travail, au moins ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_hero/0/g-0/c-5/15/g-0/16/c-1/7
msgctxt "Tyrell"
msgid "Nahh...."
msgstr "Nonnn...."

# Traduction IA – à relire
#: tyrell_towel/tyrell_work/0/0
msgctxt "Tyrell"
msgid "Spills happen every day. No big thing. But the hard part is getting dry."
msgstr "Il y a des dégâts tous les jours. Pas de quoi en faire un plat. Mais le plus dur, c'est de sécher."

# Traduction IA – à relire
#: tyrell_towel/tyrell_work/0/8
msgctxt "Tyrell"
msgid "For the big jobs, I work with Washford and Drysdale."
msgstr "Pour les gros travaux, je bosse avec Washford et Drysdale."

# Traduction IA – à relire
#: tyrell_towel/tyrell_work/0/22
msgctxt "Tyrell"
msgid "But, I work pretty independently, you know?"
msgstr "Mais je travaille plutôt en indépendant, tu vois ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_work/0/30/s/0
msgctxt "Choix"
msgid "I can make a bit of a mess."
msgstr "Je peux faire un peu de désordre."

# Traduction IA – à relire
#: tyrell_towel/tyrell_work/0/31/s/0
msgctxt "Choix"
msgid "Being clean is one of my life goals."
msgstr "Être propre est l'un de mes objectifs de vie."

# Traduction IA – à relire
#: tyrell_towel/tyrell_work/0/c-0/7
msgctxt "Tyrell"
msgid "I'm here regardless. I'm pretty dependable."
msgstr "Je suis là quoi qu'il arrive. On peut compter sur moi."

# Traduction IA – à relire
#: tyrell_towel/tyrell_work/0/c-0/15
msgctxt "Tyrell"
msgid "It takes someone of strong woven integrity to be as reliable as me, you know."
msgstr "Il faut une intégrité solidement tissée pour être aussi fiable que moi, tu sais."

# Traduction IA – à relire
#: tyrell_towel/tyrell_work/0/c-1/7
msgctxt "Tyrell"
msgid "Don't I know it!"
msgstr "Et comment !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_work/0/c-1/15
msgctxt "Tyrell"
msgid "Even though you don't spill too much, I'm there 24/7 on call."
msgstr "Même si tu ne renverses pas grand-chose, je suis de garde 24h/24, 7j/7."

# Traduction IA – à relire
#: tyrell_towel/tyrell_work/0/c-1/23
msgctxt "Tyrell"
msgid "Not to tug on my own thread, but... I'm proud of the work I do."
msgstr "Sans vouloir tirer sur mon propre fil, mais... je suis fier du travail que je fais."

# Traduction IA – à relire
#: tyrell_towel/tyrell_work/0/g-0/0/s/0
msgctxt "Choix"
msgid "Is work all you care about?"
msgstr "Il n'y a que ton travail qui compte ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_work/0/g-0/1/s/0
msgctxt "Choix"
msgid "Surely, you have bigger aspirations."
msgstr "Tu as sûrement de plus grandes ambitions."

# Traduction IA – à relire
#: tyrell_towel/tyrell_work/0/g-0/c-2/7
msgctxt "Tyrell"
msgid "I mean, who doesn't?"
msgstr "Je veux dire, qui n'en a pas ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_work/0/g-0/c-3/7
msgctxt "Tyrell"
msgid "Oh like you have bigger ones? What do you want?"
msgstr "Oh, parce que toi, tu en as de plus grandes ? Tu veux quoi, toi ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_work/0/g-0/c-3/15/0/s/0
msgctxt "Choix"
msgid "To be the best customer service rep who ever lived."
msgstr "Être la personne la plus douée de l'histoire du service client."

# Traduction IA – à relire
#: tyrell_towel/tyrell_work/0/g-0/c-3/15/1/s/0
msgctxt "Choix"
msgid "To travel the world and eat all the good stuff - but have it all be free."
msgstr "Faire le tour du monde et manger tout ce qu'il y a de bon, mais que tout soit gratuit."

# Traduction IA – à relire
#: tyrell_towel/tyrell_work/0/g-0/c-3/15/2/s/0
msgctxt "Choix"
msgid "Get through next Tuesday."
msgstr "Survivre jusqu'à mardi prochain."

# Traduction IA – à relire
#: tyrell_towel/tyrell_work/0/g-0/c-3/15/c-0/7
msgctxt "Tyrell"
msgid "Admirable - though I figure that job might be in short supply."
msgstr "Admirable, même si je suppose que ce poste doit être en pénurie."

# Traduction IA – à relire
#: tyrell_towel/tyrell_work/0/g-0/c-3/15/c-1/7
msgctxt "Tyrell"
msgid "Hmmm... sounds impossibly ambitious."
msgstr "Hmmm... ça paraît d'une ambition impossible."

# Traduction IA – à relire
#: tyrell_towel/tyrell_work/0/g-0/c-3/15/c-2/7
msgctxt "Tyrell"
msgid "Honestly that sounds like a pretty damn huge aspiration."
msgstr "Franchement, ça ressemble à une sacrée putain d'aspiration."

# Traduction IA – à relire
#: tyrell_towel/tyrell_work/0/g-1/0
msgctxt "Tyrell"
msgid "There are things I want to do but, my job is important, you know?"
msgstr "Il y a des choses que je veux faire, mais mon travail est important, tu sais ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_work/0/g-1/8
msgctxt "Tyrell"
msgid "Those spills ain't gonna un-spill themselves!"
msgstr "Ces dégâts ne vont pas se réabsorber tout seuls !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_work/0/g-1/16
msgctxt "Tyrell"
msgid "And I won't be spillin' things to you until I get to know you better."
msgstr "Et je ne m'épancherai pas avant de mieux te connaître."

# Traduction IA – à relire
#: tyrell_towel/tyrell_work/0/g-1/24
msgctxt "Tyrell"
msgid "So, let's make a deal."
msgstr "Alors, faisons un marché."

# Traduction IA – à relire
#: tyrell_towel/tyrell_work/0/g-1/32
msgctxt "Tyrell"
msgid "Next time you see me, I'll show you something cool and MAYBE, I'll tell you a bit about myself."
msgstr "La prochaine fois que tu me vois, je te montre un truc cool et PEUT-ÊTRE que je te parlerai un peu de moi."

# Traduction IA – à relire
#: tyrell_towel/tyrell_work/0/g-1/40
msgctxt "Tyrell"
msgid "I'll show you an idea I have."
msgstr "Je te montrerai une idée que j'ai eue."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bedroom/0/18
msgctxt "Narrator"
msgid "Tyrell yawns and stretches—he looks as if he might have been napping."
msgstr "Tyrell bâille et s'étire : on dirait qu'il faisait la sieste."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bedroom/0/26
msgctxt "Tyrell"
msgid "What time is it? Did I oversleep?"
msgstr "Quelle heure est-il ? J'ai trop dormi ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bedroom/0/34
msgctxt "Tyrell"
msgid "It's nice of you to come by when I'm off peak hours. Sorry that my shelf isn't more... done up. I'm not much of a \"guest\" towel, ya know?"
msgstr "C'est gentil de passer quand c'est creux. Désolé que mon étagère ne soit pas plus... apprêtée. Je ne suis pas vraiment une serviette « d'invités », tu vois ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bedroom/0/42/s/0
msgctxt "Choix"
msgid "I'm surprised you don't have more guests."
msgstr "Je suis surpris que tu n'aies pas plus d'invités."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bedroom/0/43/s/0
msgctxt "Choix"
msgid "You could totally throw a party in this closet!"
msgstr "Tu pourrais carrément faire une fête dans ce placard !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bedroom/0/c-0/7
msgctxt "Tyrell"
msgid "So am I!"
msgstr "Moi aussi !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bedroom/0/c-1/7
msgctxt "Tyrell"
msgid "It can be kind of hard since I'm not the only one who resides here."
msgstr "C'est un peu compliqué, vu que je ne suis pas le seul à habiter ici."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bedroom/0/g-0/0
msgctxt "Tyrell"
msgid "Still, I'm content with using the time in here to think of ways to fold my fabric friend into new shapes."
msgstr "Mais je me contente de profiter du temps passé ici pour réfléchir à de nouvelles formes à donner à mon ami en tissu."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bedroom/0/g-0/8
msgctxt "Tyrell"
msgid "Which, since you came by... you get to see my newest... oh, I never know what to call it."
msgstr "Et comme tu es passé... tu vas voir ma toute dernière... oh, je ne sais jamais comment l'appeler."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bedroom/0/g-0/24/0/s/0
msgctxt "Choix"
msgid "Fabrication?"
msgstr "Fabrication ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bedroom/0/g-0/24/1/s/0
msgctxt "Choix"
msgid "Design?"
msgstr "Modèle ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bedroom/0/g-0/24/2/s/0
msgctxt "Choix"
msgid "Fabric Friend?"
msgstr "Ami Tissu ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bedroom/0/g-0/24/c-2/7 tyrell_towel/tyrell_bedroom/0/g-0/24/c-3/7
msgctxt "Tyrell"
msgid "No. It still sounds too stiff."
msgstr "Non. Ça fait encore trop raide."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bedroom/0/g-0/24/c-2/15 tyrell_towel/tyrell_bedroom/0/g-0/24/c-3/15
msgctxt "Tyrell"
msgid "Oh! How about this..."
msgstr "Oh ! Et si on disait..."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bedroom/0/g-0/24/c-4/11
msgctxt "Tyrell"
msgid "We can work with that!"
msgstr "Avec ça, on peut travailler !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bedroom/0/g-1/0
msgctxt "Tyrell"
msgid "Let me introduce you to the newest <i>iteration</i> of my buddy!"
msgstr "Laisse-moi te présenter la toute dernière <i>itération</i> de mon pote !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bedroom/0/g-1/8/b/1
msgctxt "Tyrell"
msgid "My dear Fabric Friend!"
msgstr "Mon cher Ami Tissu !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bedroom/0/g-1/11
msgctxt "Tyrell"
msgid "Towel Turtle!"
msgstr "Tortue-Serviette !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bedroom/0/g-1/30
msgctxt "Tyrell"
msgid "Let me tell you, it took us a couple tries to get the shell just right."
msgstr "Je peux te dire qu'il nous a fallu plusieurs essais pour réussir la carapace."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bedroom/0/g-1/38
msgctxt "Tyrell"
msgid "But it was worth it!"
msgstr "Mais ça en valait la peine !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bedroom/0/g-1/46/s/0
msgctxt "Choix"
msgid "Is this what you want to do with your time?"
msgstr "C'est ça que tu veux faire de ton temps ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bedroom/0/g-1/47/s/0
msgctxt "Choix"
msgid "You're really good at this! Maybe this could be your career!"
msgstr "Tu es vraiment doué ! Ça pourrait peut-être devenir ton métier !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bedroom/0/g-1/c-5/13
msgctxt "Tyrell"
msgid "And you do better? I see how much you look at Phoenicia."
msgstr "Et toi, tu fais mieux ? Je vois bien à quel point tu regardes Phoenicia."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bedroom/0/g-1/c-6/7
msgctxt "Tyrell"
msgid "What? Making towel animals?"
msgstr "Quoi ? Faire des animaux en serviette ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bedroom/0/g-2/0
msgctxt "Tyrell"
msgid "This really is just a thing for me. A way for me to express myself."
msgstr "C'est vraiment juste un truc à moi. Une façon de m'exprimer."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bedroom/0/g-2/8
msgctxt "Tyrell"
msgid "Plus me and my buddy have a special bond."
msgstr "Et puis mon pote et moi, on a un lien spécial."

# Traduction IA – à relire
#: tyrell_towel/tyrell_bedroom/0/g-2/16/s/0
msgctxt "Choix"
msgid "Why do you keep them around?"
msgstr "Pourquoi tu le gardes avec toi ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bedroom/0/g-2/17/s/0
msgctxt "Choix"
msgid "What's so special about a towel turtle?"
msgstr "Qu'est-ce qu'il a de si spécial, une tortue en serviette ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bedroom/0/g-2/c-7/7
msgctxt "Tyrell"
msgid "They've seen me through a lot!"
msgstr "Il m'a aidé à traverser bien des choses !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_bedroom/0/g-2/c-8/7
msgctxt "Tyrell"
msgid "They are more than just a towel turtle!"
msgstr "C'est bien plus qu'une simple tortue en serviette !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/21/b/1
msgctxt "Narrator"
msgid "You come upon Tyrell deep in discussion with a laundry-themed acrobat."
msgstr "Vous trouvez Tyrell plongé dans une grande discussion avec un acrobate qui a pour thème la lessive."

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/22/b/1
msgctxt "Narrator"
msgid "You come upon Tyrell deep in discussion with Washford."
msgstr "Vous trouvez Tyrell plongé dans une grande discussion avec Washford."

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/25
msgctxt "Tyrell"
msgid "Hey, Washford, can you tell me that pre-soak technique again?"
msgstr "Dis, Washford, tu peux me redire la technique du pré-trempage ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/33
msgctxt "Washford"
msgid "Have you obtained a stain?"
msgstr "As-tu écopé d'une tache ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/44
msgctxt "Tyrell"
msgid "Not yet! I'm trying to be proactive."
msgstr "Pas encore ! J'essaie d'être proactif."

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/52
msgctxt "Washford"
msgid "Well then please continue..."
msgstr "Eh bien, dans ce cas, continue..."

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/60
msgctxt "Washford"
msgid "Although, I do hope you commit it to memory this time."
msgstr "Même si j'espère que, cette fois, tu la graveras dans ta mémoire."

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/68
msgctxt "Tyrell"
msgid "I know, I know! It just keeps slipping my stitches."
msgstr "Je sais, je sais ! Ça me file entre les mailles."

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/76/s/0
msgctxt "Choix"
msgid "Always prepared, Tyrell! I like it!"
msgstr "Toujours prêt, Tyrell ! J'aime bien !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/77/s/0
msgctxt "Choix"
msgid "You are more than just your job, my dude."
msgstr "Tu es bien plus que ton métier, poto."

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/c-0/7
msgctxt "Tyrell"
msgid "I try to be! You've got to be ready for anything."
msgstr "J'essaie de l'être ! Il faut être prêt à tout."

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/c-1/7
msgctxt "Tyrell"
msgid "I know that. Having a handy tip up my sleeve never hurt though."
msgstr "Je sais. Mais avoir une astuce sous le coude, ça n'a jamais fait de mal."

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/g-0/0
msgctxt "Washford"
msgid "I will let you two converse. We will speak of stains later, Tyrell."
msgstr "Je vous laisse discuter. Nous reparlerons de taches plus tard, Tyrell."

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/g-0/14
msgctxt "Tyrell"
msgid "Washford is my machine! Always taking care of me and my towel buddy."
msgstr "Washford, c'est ma machine ! Il prend toujours soin de moi et de mon petit pote."

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/g-0/22/s/0
msgctxt "Choix"
msgid "Does your pet have a name?"
msgstr "Ton compagnon a un nom ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/g-0/c-2/7
msgctxt "Tyrell"
msgid "Naw. They change so often, mostly with my mood, that we decided long ago not to lock them into anything."
msgstr "Nan. Il change tellement souvent, surtout selon mon humeur, qu'on a décidé depuis longtemps de ne pas l'enfermer dans quoi que ce soit."

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/g-0/c-2/15
msgctxt "Tyrell"
msgid "They contain multitudes!"
msgstr "Il contient des multitudes !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/g-0/c-2/23
msgctxt "Tyrell"
msgid "And, sometimes, spilled grape juice."
msgstr "Et, parfois, du jus de raisin renversé."

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/g-0/c-2/31
msgctxt "Tyrell"
msgid "Speaking of which, do you wanna see what they are today?"
msgstr "À ce propos, tu veux voir ce qu'il est aujourd'hui ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/g-0/c-2/39/0/s/0
msgctxt "Choix"
msgid "Of course!"
msgstr "Bien sûr !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/g-0/c-2/39/1/s/0
msgctxt "Choix"
msgid "You're gonna show me anyway..."
msgstr "De toute façon, tu vas me le montrer..."

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/g-0/c-2/39/c-0/7
msgctxt "Tyrell"
msgid "Excellent!"
msgstr "Excellent !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/g-0/c-2/39/c-1/7
msgctxt "Tyrell"
msgid "Nope!"
msgstr "Non !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/g-0/c-2/39/c-1/23
msgctxt "Tyrell"
msgid "I mean... yeah. I am."
msgstr "Enfin... ouais. C'est vrai."

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/g-1/0
msgctxt "Tyrell"
msgid "This is the first I've been able to do this one, but..."
msgstr "C'est la première fois que j'arrive à faire celui-là, mais..."

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/g-1/8
msgctxt "Tyrell"
msgid "Ta-da!"
msgstr "Tadaaa !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/g-1/30
msgctxt "Tyrell"
msgid "The shell was the tricky part, but I finally got it!"
msgstr "La carapace, c'était le plus délicat, mais j'y suis enfin arrivé !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/g-1/38/s/0
msgctxt "Choix"
msgid "You'll do better next time."
msgstr "Tu feras mieux la prochaine fois."

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/g-1/39/s/0
msgctxt "Choix"
msgid "Wow, that's pretty awesome!"
msgstr "Waouh, c'est vraiment génial !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/g-1/40/s/0
msgctxt "Choix"
msgid "You've got a real skill for this."
msgstr "Tu as un vrai talent pour ça."

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/g-1/c-3/13
msgctxt "Tyrell"
msgid "What?? This is my passion!"
msgstr "Quoi ?? C'est ma passion !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/g-1/c-3/24
msgctxt "Tyrell"
msgid "...I always do better each new time."
msgstr "...je fais toujours mieux à chaque nouvel essai."

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/g-1/c-4/13
msgctxt "Tyrell"
msgid "Hey that's the kinda thing I like to hear."
msgstr "Eh, c'est exactement le genre de truc que j'aime entendre."

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/g-1/c-5/13
msgctxt "Tyrell"
msgid "Thanks for that! I bet you didn't expect me to be so talented."
msgstr "Merci pour ça ! Je parie que tu ne t'attendais pas à ce que je sois aussi talentueux."

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/g-1/c-5/24
msgctxt "Tyrell"
msgid "I'm kidding. I know you did."
msgstr "Je plaisante. Je sais que si."

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/g-2/0
msgctxt "Tyrell"
msgid "I wouldn't be able to do it without my little buddy."
msgstr "Je n'y arriverais pas sans mon petit pote."

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/g-2/8
msgctxt "Tyrell"
msgid "We've gotten pretty close."
msgstr "On est devenus assez proches."

# Traduction IA – à relire
#: tyrell_towel/tyrell_laundry/0/g-2/16/1/s/0
msgctxt "Choix"
msgid "How long have you had them?"
msgstr "Ça fait combien de temps que tu le connais ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_kitchen/0/18
msgctxt "Tyrell"
msgid "Hi!"
msgstr "Salut !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_kitchen/0/34
msgctxt "Tyrell"
msgid "So..."
msgstr "Alors..."

# Traduction IA – à relire
#: tyrell_towel/tyrell_kitchen/0/42
msgctxt "Tyrell"
msgid "Before you go any further..."
msgstr "Avant que tu n'ailles plus loin..."

# Traduction IA – à relire
#: tyrell_towel/tyrell_kitchen/0/50
msgctxt "Tyrell"
msgid "I'll be honest, I hang out here in case of emergency."
msgstr "Je vais être honnête, je traîne ici en cas d'urgence."

# Traduction IA – à relire
#: tyrell_towel/tyrell_kitchen/0/58
msgctxt "Tyrell"
msgid "I'm really just here to look good, you know? Hang me off the stove, place me on a hook, something like that."
msgstr "Je suis surtout là pour faire joli, tu vois ? Accroche-moi à la poignée du four, mets-moi sur un crochet, un truc comme ça."

# Traduction IA – à relire
#: tyrell_towel/tyrell_kitchen/0/66
msgctxt "Tyrell"
msgid "Here, I give you décor, not function. But, if you need me..."
msgstr "Ici, je suis de la déco, pas de la fonction. Mais si tu as besoin de moi..."

# Traduction IA – à relire
#: tyrell_towel/tyrell_kitchen/0/74
msgctxt "Tyrell"
msgid "Just know, there's so much in here that I don't really want to deal with."
msgstr "Sache juste qu'il y a plein de choses ici dont je n'ai vraiment pas envie de m'occuper."

# Traduction IA – à relire
#: tyrell_towel/tyrell_kitchen/0/82
msgctxt "Tyrell"
msgid "If it is milk or water you want me to clean up, I'm game."
msgstr "Si c'est du lait ou de l'eau que tu veux que j'éponge, je suis partant."

# Traduction IA – à relire
#: tyrell_towel/tyrell_kitchen/0/90
msgctxt "Tyrell"
msgid "But if it is anything that stains.... I'm not down."
msgstr "Mais si ça tache, quoi que ce soit... là, je ne suis pas d'accord."

# Traduction IA – à relire
#: tyrell_towel/tyrell_kitchen/0/98
msgctxt "Tyrell"
msgid "And don't you DARE use bleach on me! Ugh!"
msgstr "Et n'ose PAS utiliser de l'eau de Javel sur moi ! Beurk !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_kitchen/0/106
msgctxt "Tyrell"
msgid "Or use me to pick up grease or oil... or jam or butter or... most things in here."
msgstr "Ou m'utiliser pour ramasser de la graisse ou de l'huile... ou de la confiture ou du beurre ou... presque tout ce qu'il y a ici."

# Traduction IA – à relire
#: tyrell_towel/tyrell_kitchen/0/120
msgctxt "Narrator"
msgid "Tyrell holds a small turtle made of towels up to his ear, as though he were listening to the small creature."
msgstr "Tyrell porte à son oreille une petite tortue faite de serviettes, comme s'il écoutait la petite créature."

# Traduction IA – à relire
#: tyrell_towel/tyrell_kitchen/0/136
msgctxt "Tyrell"
msgid "What?"
msgstr "Quoi ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_kitchen/0/144
msgctxt "Tyrell"
msgid "<i>No, I don't think I'm overreacting! You know I don't like it here!</i>"
msgstr "<i>Non, je ne pense pas que j'exagère ! Tu sais bien que je n'aime pas être ici !</i>"

# Traduction IA – à relire
#: tyrell_towel/tyrell_kitchen/0/152/s/0
msgctxt "Choix"
msgid "Woah! You have a turtle now!"
msgstr "Waouh ! Tu as une tortue maintenant !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_kitchen/0/153/s/0
msgctxt "Choix"
msgid "Wasn't that thing a swan before?"
msgstr "C'était pas un cygne, avant ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_kitchen/0/c-0/7
msgctxt "Tyrell"
msgid "I HAVE A TURTLE NOW!"
msgstr "J'AI UNE TORTUE MAINTENANT !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_kitchen/0/c-1/7
msgctxt "Tyrell"
msgid "That THING is my buddy!"
msgstr "Ce TRUC, c'est mon pote !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_kitchen/0/g-0/0
msgctxt "Tyrell"
msgid "We did a get-together last night and turned them into a turtle!"
msgstr "On s'est réunis hier soir et on l'a transformé en tortue !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_kitchen/0/g-0/8
msgctxt "Tyrell"
msgid "Isn't it cool? It kind of just came to me in a vision."
msgstr "Il est cool, non ? Ça m'est venu comme une vision."

# Traduction IA – à relire
#: tyrell_towel/tyrell_kitchen/0/g-0/16/s/0
msgctxt "Choix"
msgid "That's really awesome!"
msgstr "C'est vraiment génial !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_kitchen/0/g-0/17/s/0
msgctxt "Choix"
msgid "I liked the swan better."
msgstr "Je préférais le cygne."

# Traduction IA – à relire
#: tyrell_towel/tyrell_kitchen/0/g-0/c-2/13
msgctxt "Tyrell"
msgid "Thank you so much!"
msgstr "Merci beaucoup !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_kitchen/0/g-0/c-3/13
msgctxt "Tyrell"
msgid "To each their own, I guess. But, this is really an expression of where I'm at."
msgstr "Chacun ses goûts, je suppose. Mais là, c'est vraiment l'expression de là où j'en suis."

# Traduction IA – à relire
#: tyrell_towel/tyrell_kitchen/0/buddyjoin/0
msgctxt "Tyrell"
msgid "Me and the little buddy like to change our shape around every now and then."
msgstr "Mon petit pote et moi, on aime changer de forme de temps en temps."

# Traduction IA – à relire
#: tyrell_towel/tyrell_kitchen/0/buddyjoin/8
msgctxt "Tyrell"
msgid "You know, to fit the vibe. The mood. The emotion."
msgstr "Tu sais, pour coller à l'ambiance. À l'humeur. À l'émotion."

# Traduction IA – à relire
#: tyrell_towel/tyrell_kitchen/0/buddyjoin/16
msgctxt "Tyrell"
msgid "We really try to soak it up."
msgstr "On essaie vraiment de tout absorber."

# Traduction IA – à relire
#: tyrell_towel/tyrell_kitchen/0/buddyjoin/24
msgctxt "Tyrell"
msgid "Unlike kitchen spills. I hate those."
msgstr "Contrairement aux dégâts de cuisine. Ça, je déteste."

# Traduction IA – à relire
#: tyrell_towel/tyrell_kitchen/0/buddyjoin/35/s/0
msgctxt "Choix"
msgid "What do you have against kitchen spills?"
msgstr "Qu'est-ce que tu as contre les dégâts de cuisine ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_kitchen/0/buddyjoin/36/s/0
msgctxt "Choix"
msgid "Your reaction was a bit much, don't you think?"
msgstr "Ta réaction était un peu excessive, tu ne trouves pas ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_kitchen/0/buddyjoin/37/s/0
msgctxt "Choix"
msgid "This all sounds very silly to me."
msgstr "Tout ça me paraît très idiot."

# Traduction IA – à relire
#: tyrell_towel/tyrell_kitchen/0/buddyjoin/c-4/7
msgctxt "Tyrell"
msgid "Oh... I guess you wouldn't know."
msgstr "Oh... je suppose que tu ne peux pas savoir."

# Traduction IA – à relire
#: tyrell_towel/tyrell_kitchen/0/buddyjoin/c-5/7
msgctxt "Tyrell"
msgid "Not if you knew why I feel this way."
msgstr "Pas si tu savais pourquoi je ressens ça."

# Traduction IA – à relire
#: tyrell_towel/tyrell_kitchen/0/buddyjoin/c-6/13
msgctxt "Tyrell"
msgid "I'll just soak up that comment, no problem."
msgstr "Je vais juste éponger cette remarque, pas de souci."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/0
msgctxt "Tyrell"
msgid "Remember when you got me from that thrift store? I was wrapped with my towel buddy. I remember you saying it was as good as new."
msgstr "Tu te souviens quand tu m'as pris à la friperie ? J'étais enroulé avec mon petit pote. Je me souviens que tu as dit que c'était comme neuf."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/8
msgctxt "Tyrell"
msgid "Well, let me tell ya. I've seen some massive spills in my day. Things you wouldn't believe."
msgstr "Eh bien, laisse-moi te dire un truc. J'en ai vu, des dégâts monumentaux, de mon temps. Des choses que tu ne croirais pas."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/16
msgctxt "Tyrell"
msgid "Did you know what pasta sauce can do to grout? It ain't pretty."
msgstr "Tu sais ce que la sauce des pâtes peut faire aux joints ? C'est pas beau à voir."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/24
msgctxt "Tyrell"
msgid "But, I didn't have to take on the task alone, nope! There was a team of us, all dedicated to helping keep things nice and dry."
msgstr "Mais je n'avais pas à m'attaquer à la tâche tout seul, non ! On était toute une équipe, dévouée à garder les choses bien propres et bien sèches."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/32
msgctxt "Tyrell"
msgid "I was happy to be with my friends, working together."
msgstr "J'étais heureux d'être avec mes amis, à travailler ensemble."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/40
msgctxt "Tyrell"
msgid "Hell, we used to hang out at the bathroom bar most nights and just chill."
msgstr "Bon sang, on traînait presque tous les soirs au bar de la salle de bain, juste pour se détendre."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/48/s/0
msgctxt "Choix"
msgid "There was a bar in your old bathroom?"
msgstr "Il y avait un bar dans ton ancienne salle de bain ?"

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/49/s/0
msgctxt "Choix"
msgid "Sounds like a nice way to relax."
msgstr "Ça a l'air d'une chouette façon de se détendre."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/c-0/7
msgctxt "Tyrell"
msgid "He heh... The TOWEL bar! ...you silly."
msgstr "Hé hé... La BARRE à serviettes ! ...tête en l'air."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/c-1/7
msgctxt "Tyrell"
msgid "Oh, it was the shit! Hanging out with people who get what you do? Nothing like it!"
msgstr "Oh, c'était génial ! Traîner avec des gens qui comprennent ce que tu fais ? Rien de tel !"

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-0/0
msgctxt "Tyrell"
msgid "Towel buddy over here would do tricks, turning into different things, makin' us laugh."
msgstr "Mon petit pote que voilà faisait des tours, se transformait en plein de choses, il nous faisait rire."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-0/8
msgctxt "Tyrell"
msgid "Every color towel you could think of, all in one place."
msgstr "Des serviettes de toutes les couleurs imaginables, réunies au même endroit."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-0/16
msgctxt "Tyrell"
msgid "And the linen closet? Always a party! Sometimes, it was so full, you couldn't get a shelf!"
msgstr "Et le placard à linge ? Toujours la fête ! Parfois, il y avait tant de monde qu'on ne trouvait plus une étagère de libre !"

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-0/27
msgctxt "Tyrell"
msgid "Those were the good times..."
msgstr "C'était le bon temps..."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-0/35/s/0
msgctxt "Choix"
msgid "Where is everyone else?"
msgstr "Où sont tous les autres ?"

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-0/36/s/0
msgctxt "Choix"
msgid "This story is way too long."
msgstr "Cette histoire est beaucoup trop longue."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-0/37/s/0
msgctxt "Choix"
msgid "I feel a twist in the story coming..."
msgstr "Je sens venir un coup de théâtre..."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-0/c-2/13
msgctxt "Tyrell"
msgid "It makes me shudder to think of it..."
msgstr "Rien que d'y penser, j'en frissonne..."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-0/c-3/13
msgctxt "Tyrell"
msgid "Aright, no worries."
msgstr "Bon, pas de souci."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-0/c-4/13
msgctxt "Tyrell"
msgid "One hell of a twist..."
msgstr "Un sacré coup de théâtre..."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-1/0
msgctxt "Tyrell"
msgid "It was a day that will go down in infamy."
msgstr "C'est un jour qui restera dans l'infamie."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-1/8
msgctxt "Tyrell"
msgid "It was spring. It was raining somethin' crazy. And our owner had their grandkids over."
msgstr "C'était le printemps. Il pleuvait comme vache qui pisse. Et notre propriétaire avait ses petits-enfants à la maison."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-1/16/s/0
msgctxt "Choix"
msgid "Aww, that's cute!"
msgstr "Aww, c'est mignon !"

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-1/17/s/0
msgctxt "Choix"
msgid "Rain... children... towels..."
msgstr "De la pluie... des enfants... des serviettes..."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-1/c-5/7
msgctxt "Tyrell"
msgid "HA! Cute ain't even the half of it..."
msgstr "HA ! Mignon, c'est même pas la moitié de l'histoire..."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-1/c-6/7
msgctxt "Tyrell"
msgid "You guessed it."
msgstr "Tu as deviné."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-2/0
msgctxt "Tyrell"
msgid "All SEVEN grandchildren came over."
msgstr "Les SEPT petits-enfants sont venus."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-2/8
msgctxt "Tyrell"
msgid "All SEVEN of them decided to play... in mud!"
msgstr "Les SEPT ont décidé de jouer... dans la boue !"

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-2/19
msgctxt "Tyrell"
msgid "And when they came back in, they just started snatching my friends from the closet."
msgstr "Et en rentrant, ils se sont mis à arracher mes amis du placard."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-2/27
msgctxt "Tyrell"
msgid "Towel buddy and I just watched in horror."
msgstr "Mon petit pote et moi, on regardait ça, horrifiés."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-2/35
msgctxt "Tyrell"
msgid "They took them all, one by one! But me? I was on the bottom. And I just saw it happen."
msgstr "Ils les ont tous pris, un par un ! Mais moi ? J'étais tout en bas. Et j'ai tout vu."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-2/43
msgctxt "Tyrell"
msgid "I whispered to myself -"
msgstr "Je me suis murmuré à moi-même :"

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-2/51
msgctxt "Tyrell"
msgid "\"Those are some tough towels! They'll be fine!\""
msgstr "« Ce sont de solides serviettes ! Elles s'en sortiront ! »"

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-2/59
msgctxt "Tyrell"
msgid "But when they came back from the laundry room a few days later it was... it was too late."
msgstr "Mais quand elles sont revenues de la buanderie quelques jours plus tard, c'était... c'était trop tard."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-2/67
msgctxt "Tyrell"
msgid "They had become...."
msgstr "Elles étaient devenues...."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-2/83
msgctxt "Narrator"
msgid "He pauses, as though overwhelmed by the horror."
msgstr "Il marque une pause, comme submergé par l'horreur."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-2/91
msgctxt "Tyrell"
msgid "RAGS!"
msgstr "DES CHIFFONS !"

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-2/102/s/0
msgctxt "Choix"
msgid "What?! Not rags!"
msgstr "Quoi ?! Pas des chiffons !"

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-2/103/s/0
msgctxt "Choix"
msgid "What's the big deal about that?"
msgstr "Où est le problème, au juste ?"

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-2/c-7/13
msgctxt "Tyrell"
msgid "RAAAGGGSS!!"
msgstr "DES CHIFFOOOONS !!"

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-2/c-8/13
msgctxt "Tyrell"
msgid "I'm emotional here! Do you really have to ask that?"
msgstr "Je suis sous le coup de l'émotion, là ! Tu as vraiment besoin de poser la question ?"

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-3/0
msgctxt "Tyrell"
msgid "You've gotta be stain-resistant to stay in the game."
msgstr "Il faut résister aux taches pour rester dans la course."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-3/8
msgctxt "Tyrell"
msgid "That grape juice? You can't let it stick to you."
msgstr "Ce jus de raisin ? Tu ne peux pas le laisser s'accrocher à toi."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-3/16
msgctxt "Tyrell"
msgid "But if you let mud stay on a towel for DAYS?! It can be too much."
msgstr "Mais si tu laisses la boue sur une serviette pendant des JOURS ?! Ça peut être trop."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-3/24
msgctxt "Tyrell"
msgid "I know that if Washford and Drysdale had been there, it would've been a different story. They could have saved a few of them before the stain got in too deep."
msgstr "Je sais que si Washford et Drysdale avaient été là, ça aurait été une autre histoire. Ils auraient pu en sauver quelques-unes avant que la tache ne s'incruste trop."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-3/32
msgctxt "Tyrell"
msgid "The way they were treated was way too much for them."
msgstr "Le traitement qu'elles ont subi, c'était vraiment trop pour elles."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-3/40
msgctxt "Tyrell"
msgid "When the rest became rags, our old boss wanted a completely new set."
msgstr "Quand les autres sont devenues des chiffons, notre ancien patron a voulu un tout nouveau lot."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-3/48
msgctxt "Tyrell"
msgid "He saw that I was still strong and decided to donate me."
msgstr "Il a vu que j'étais encore solide et a décidé de me donner."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-3/56/s/0
msgctxt "Choix"
msgid "Were you scared?"
msgstr "Tu as eu peur ?"

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-3/57/s/0
msgctxt "Choix"
msgid "This all sounds so dramatic!"
msgstr "Tout ça paraît tellement dramatique !"

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-3/c-9/15
msgctxt "Tyrell"
msgid "I was NOT scared."
msgstr "Je n'avais PAS peur."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-3/c-10/7
msgctxt "Tyrell"
msgid "It is though!"
msgstr "Mais ça l'est !"

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-4/0
msgctxt "Tyrell"
msgid "It was a hell of a disaster! But, I had my little buddy with me and we kept each other company."
msgstr "C'était un sacré désastre ! Mais j'avais mon petit pote avec moi et on se tenait compagnie."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-4/8
msgctxt "Tyrell"
msgid "And I knew I would make it. I'm resilient. It's in my fibers."
msgstr "Et je savais que j'allais m'en sortir. Je suis résistant. C'est dans mes fibres."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-4/19
msgctxt "Tyrell"
msgid "Can I see your hand?"
msgstr "Je peux voir ta main ?"

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-4/27/s/0
msgctxt "Choix"
msgid "Why do you want my hand?"
msgstr "Pourquoi tu veux ma main ?"

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-4/28/s/0
msgctxt "Choix"
msgid "You're looking at it..."
msgstr "Tu es en train de la regarder..."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-4/29/s/0
msgctxt "Choix"
msgid "<i>Give Tyrell your hand</i>"
msgstr "<i>Donner la main à Tyrell</i>"

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-4/c-11/7
msgctxt "Tyrell"
msgid "I've touched you all over - do you really have to ask?"
msgstr "Je t'ai touché de partout, tu as vraiment besoin de poser la question ?"

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-4/c-12/7
msgctxt "Tyrell"
msgid "C'mon..."
msgstr "Allez..."

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-5/0
msgctxt "Tyrell"
msgid "Just trust me!"
msgstr "Fais-moi confiance !"

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-5/8/s/0
msgctxt "Choix"
msgid "<i>Give Tyrell your hand.</i>"
msgstr "<i>Donner la main à Tyrell.</i>"

# Traduction IA – à relire
#: tyrell_towel/rags_to_riches/0/g-5/9/s/0
msgctxt "Choix"
msgid "Naw. I'm okay."
msgstr "Nan. Ça va."

# Traduction IA – à relire
#: tyrell_towel/touch_test/0/6
msgctxt "Narrator"
msgid "You extend your hand to Tyrell, and he takes it, his touch gentle and unassuming."
msgstr "Vous tendez la main à Tyrell, qui la prend, son contact doux et sans prétention."

# Traduction IA – à relire
#: tyrell_towel/touch_test/0/14
msgctxt "Tyrell"
msgid "When you touch me by my hand, what do you feel?"
msgstr "Quand tu me touches par la main, qu'est-ce que tu ressens ?"

# Traduction IA – à relire
#: tyrell_towel/touch_test/0/22/s/0
msgctxt "Choix"
msgid "That spark?"
msgstr "Cette étincelle ?"

# Traduction IA – à relire
#: tyrell_towel/touch_test/0/23/s/0
msgctxt "Choix"
msgid "Something, but I'm not sure..."
msgstr "Quelque chose, mais je ne suis pas sûr..."

# Traduction IA – à relire
#: tyrell_towel/touch_test/0/c-0/7
msgctxt "Tyrell"
msgid "You felt that, too?"
msgstr "Tu l'as senti aussi ?"

# Traduction IA – à relire
#: tyrell_towel/touch_test/0/c-0/15/b/1
msgctxt "Tyrell"
msgid "I don't think it's just static electricity, either."
msgstr "Et je ne pense pas que ce soit juste de l'électricité statique non plus."

# Traduction IA – à relire
#: tyrell_towel/touch_test/0/c-0/18
msgctxt "Tyrell"
msgid "But, there's something else."
msgstr "Mais il y a autre chose."

# Traduction IA – à relire
#: tyrell_towel/touch_test/0/c-1/7
msgctxt "Tyrell"
msgid "That's okay. Concentrate."
msgstr "Ce n'est pas grave. Concentre-toi."

# Traduction IA – à relire
#: tyrell_towel/touch_test/0/g-0/0
msgctxt "Tyrell"
msgid "Feel the texture of my hand. The way I'm made."
msgstr "Sens la texture de ma main. La façon dont je suis fait."

# Traduction IA – à relire
#: tyrell_towel/touch_test/0/g-0/8
msgctxt "Tyrell"
msgid "Soft, but sturdy. Hard-working, yet comforting."
msgstr "Doux, mais robuste. Travailleur, mais réconfortant."

# Traduction IA – à relire
#: tyrell_towel/touch_test/0/g-0/16
msgctxt "Tyrell"
msgid "I'm warm."
msgstr "Je suis chaud."

# Traduction IA – à relire
#: tyrell_towel/touch_test/0/g-0/24/s/0
msgctxt "Choix"
msgid "Very... very warm."
msgstr "Très... très chaud."

# Traduction IA – à relire
#: tyrell_towel/touch_test/0/g-0/25/s/0
msgctxt "Choix"
msgid "Too hot for me."
msgstr "Trop chaud pour moi."

# Traduction IA – à relire
#: tyrell_towel/touch_test/0/g-0/c-2/13
msgctxt "Tyrell"
msgid "You noticed, eh?"
msgstr "Tu as remarqué, hein ?"

# Traduction IA – à relire
#: tyrell_towel/touch_test/0/g-0/c-3/7
msgctxt "Tyrell"
msgid "You just gotta get used to it."
msgstr "Il faut juste s'y habituer."

# Traduction IA – à relire
#: tyrell_towel/touch_test/0/g-1/0
msgctxt "Tyrell"
msgid "And my little buddy here helps me channel all those bad things into a way I can express my emotions."
msgstr "Et mon petit pote que voilà m'aide à canaliser toutes ces mauvaises choses pour que je puisse exprimer mes émotions."

# Traduction IA – à relire
#: tyrell_towel/touch_test/0/g-1/8
msgctxt "Tyrell"
msgid "All that to say: I'm premium."
msgstr "Tout ça pour dire : je suis de qualité supérieure."

# Traduction IA – à relire
#: tyrell_towel/touch_test/0/g-1/16
msgctxt "Tyrell"
msgid "That's why they call me the Lord of the Wrings."
msgstr "C'est pour ça qu'on m'appelle le Seigneur des Essorages."

# Traduction IA – à relire
#: tyrell_towel/touch_test/0/g-1/32
msgctxt "Tyrell"
msgid "You get it??"
msgstr "Tu piges ??"

# Traduction IA – à relire
#: tyrell_towel/touch_test/0/g-1/40/s/0
msgctxt "Choix"
msgid "...I don't get the reference."
msgstr "...je ne comprends pas la référence."

# Traduction IA – à relire
#: tyrell_towel/touch_test/0/g-1/41/s/0
msgctxt "Choix"
msgid "I'll let you have that one."
msgstr "Je te laisse celle-là."

# Traduction IA – à relire
#: tyrell_towel/touch_test/0/g-1/42/s/0
msgctxt "Choix"
msgid "I get it and I love it."
msgstr "Je comprends et j'adore."

# Traduction IA – à relire
#: tyrell_towel/touch_test/0/g-1/c-4/7
msgctxt "Tyrell"
msgid "... You're lying, right?"
msgstr "... Tu mens, hein ?"

# Traduction IA – à relire
#: tyrell_towel/touch_test/0/g-1/c-4/15
msgctxt "Tyrell"
msgid "<i>Maybe it's true Towel Buddy... humans did stop reading stuff.</i>"
msgstr "<i>C'est peut-être vrai, Serviette-Pote... les humains ont arrêté de lire.</i>"

# Traduction IA – à relire
#: tyrell_towel/touch_test/0/g-1/c-5/7
msgctxt "Tyrell"
msgid "It's a good one, I know."
msgstr "Elle est bonne, je sais."

# Traduction IA – à relire
#: tyrell_towel/touch_test/0/g-1/c-6/7
msgctxt "Tyrell"
msgid "Yeah!!"
msgstr "Ouais !!"

# Traduction IA – à relire
#: tyrell_towel/touch_test/0/g-2/0/s/0
msgctxt "Choix"
msgid "After all that, and you still want to do the same work?"
msgstr "Après tout ça, tu veux toujours faire le même travail ?"

# Traduction IA – à relire
#: tyrell_towel/touch_test/0/g-2/1/s/0
msgctxt "Choix"
msgid "I'm surprised you still love what you do."
msgstr "Je suis surpris que tu aimes toujours ce que tu fais."

# Traduction IA – à relire
#: tyrell_towel/touch_test/0/g-2/c-7/7
msgctxt "Tyrell"
msgid "Well, you want to know a secret?"
msgstr "Bon, tu veux connaître un secret ?"

# Traduction IA – à relire
#: tyrell_towel/touch_test/0/g-2/c-7/15/0/s/0
msgctxt "Choix"
msgid "Of course?"
msgstr "Bien sûr ?"

# Traduction IA – à relire
#: tyrell_towel/touch_test/0/g-2/c-7/15/1/s/0
msgctxt "Choix"
msgid "Haven't you told me enough?"
msgstr "Tu ne m'en as pas déjà assez dit ?"

# Traduction IA – à relire
#: tyrell_towel/touch_test/0/g-2/c-7/15/c-1/13
msgctxt "Tyrell"
msgid "I... guess I have."
msgstr "Je... suppose que si."

# Traduction IA – à relire
#: tyrell_towel/touch_test/0/g-2/c-8/7
msgctxt "Tyrell"
msgid "I like it... but it isn't what I want to do forever."
msgstr "J'aime ça... mais ce n'est pas ce que je veux faire pour toujours."

# Traduction IA – à relire
#: tyrell_towel/touch_test/0/g-2/c-8/15/0/s/0
msgctxt "Choix"
msgid "What else do you want to do?"
msgstr "Qu'est-ce que tu voudrais faire d'autre ?"

# Traduction IA – à relire
#: tyrell_towel/touch_test/0/g-2/c-8/15/1/s/0
msgctxt "Choix"
msgid "It's either that or fold towel animals. Not a lot of choices."
msgstr "C'est ça ou plier des animaux en serviette. Pas beaucoup de choix."

# Traduction IA – à relire
#: tyrell_towel/touch_test/0/g-2/c-8/15/c-1/13
msgctxt "Tyrell"
msgid "I had never thought of it that way."
msgstr "Je n'y avais jamais pensé comme ça."

# Traduction IA – à relire
#: tyrell_towel/no_touch/0/0
msgctxt "Tyrell"
msgid "Hey, no problem! I respect your choice."
msgstr "Eh, pas de souci ! Je respecte ton choix."

# Traduction IA – à relire
#: tyrell_towel/no_touch/0/8
msgctxt "Tyrell"
msgid "I'm just..."
msgstr "C'est juste que..."

# Traduction IA – à relire
#: tyrell_towel/no_touch/0/16
msgctxt "Tyrell"
msgid "I'm just really proud of the way I'm woven."
msgstr "C'est juste que je suis vraiment fier de la façon dont je suis tissé."

# Traduction IA – à relire
#: tyrell_towel/no_touch/0/24
msgctxt "Tyrell"
msgid "I know I'm premium!"
msgstr "Je sais que je suis de qualité supérieure !"

# Traduction IA – à relire
#: tyrell_towel/no_touch/0/32/s/0
msgctxt "Choix"
msgid "I can tell from here you're well made."
msgstr "Je vois d'ici que tu es bien fabriqué."

# Traduction IA – à relire
#: tyrell_towel/no_touch/0/33/s/0
msgctxt "Choix"
msgid "Don't be so full of yourself."
msgstr "Ne te prends pas pour un autre."

# Traduction IA – à relire
#: tyrell_towel/no_touch/0/c-0/13
msgctxt "Tyrell"
msgid "They don't call me Lord of the Wrings for nothin'!"
msgstr "On ne m'appelle pas le Seigneur des Essorages pour rien !"

# Traduction IA – à relire
#: tyrell_towel/no_touch/0/c-0/29
msgctxt "Tyrell"
msgid "Okay... no one calls me that."
msgstr "Bon... personne ne m'appelle comme ça."

# Traduction IA – à relire
#: tyrell_towel/no_touch/0/c-1/7
msgctxt "Tyrell"
msgid "I didn't think I was... But, okay."
msgstr "Je ne pensais pas... Mais bon, d'accord."

# Traduction IA – à relire
#: tyrell_towel/no_touch/0/g-0/0
msgctxt "Tyrell"
msgid "My little buddy has been with me every step of the way."
msgstr "Mon petit pote est resté à mes côtés à chaque étape."

# Traduction IA – à relire
#: tyrell_towel/no_touch/0/g-0/8
msgctxt "Tyrell"
msgid "And, truthfully, I'm not sure I would have made it without them."
msgstr "Et, franchement, je ne suis pas sûr que j'y serais arrivé sans lui."

# Traduction IA – à relire
#: tyrell_towel/no_touch/0/g-0/19/s/0
msgctxt "Choix"
msgid "Your team would be super proud of you."
msgstr "Ton équipe serait super fière de toi."

# Traduction IA – à relire
#: tyrell_towel/no_touch/0/g-0/c-2/7
msgctxt "Tyrell"
msgid "I sure hope so. I'm trying to live up to their legacy."
msgstr "Je l'espère bien. J'essaie d'être à la hauteur de leur héritage."

# Traduction IA – à relire
#: tyrell_towel/no_touch/0/g-0/c-2/15
msgctxt "Tyrell"
msgid "Although..."
msgstr "Même si..."

# Traduction IA – à relire
#: tyrell_towel/no_touch/0/g-0/c-2/23
msgctxt "Tyrell"
msgid "There are times I wish I could do something else."
msgstr "Il y a des moments où j'aimerais pouvoir faire autre chose."

# Traduction IA – à relire
#: tyrell_towel/no_touch/0/g-0/c-2/31/0/s/0
msgctxt "Choix"
msgid "You are great at what you do. No need to change it up!"
msgstr "Tu es excellent dans ce que tu fais. Pas besoin de changer !"

# Traduction IA – à relire
#: tyrell_towel/no_touch/0/g-0/c-2/31/1/s/0
msgctxt "Choix"
msgid "What do you have in mind?"
msgstr "Qu'est-ce que tu as en tête ?"

# Traduction IA – à relire
#: tyrell_towel/no_touch/0/g-0/c-2/31/c-0/7
msgctxt "Tyrell"
msgid "Yeah. I guess so. If it ain't broke, right?"
msgstr "Ouais. Je suppose. Si ça marche, on n'y touche pas, hein ?"

# Traduction IA – à relire
#: tyrell_towel/no_touch/0/g-0/c-2/31/c-1/7
msgctxt "Tyrell"
msgid "Well... since you asked..."
msgstr "Eh bien... puisque tu demandes..."

# Traduction IA – à relire
#: tyrell_towel/tyrell_wrapup_1/0/3
msgctxt "Tyrell"
msgid "I guess I'll just keep doing what I'm doing. Not that I don't like what I'm doing."
msgstr "Je vais sans doute continuer ce que je fais. Pas que je n'aime pas ce que je fais."

# Traduction IA – à relire
#: tyrell_towel/tyrell_wrapup_1/0/11
msgctxt "Tyrell"
msgid "I've talked your ear off."
msgstr "Je t'ai assommé de paroles."

# Traduction IA – à relire
#: tyrell_towel/tyrell_wrapup_1/0/19
msgctxt "Tyrell"
msgid "What do you think about all of this?"
msgstr "Qu'est-ce que tu penses de tout ça ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_wrapup_1/0/27/s/0
msgctxt "Choix"
msgid "I don't think you should complain so much."
msgstr "Je ne crois pas que tu devrais autant te plaindre."

# Traduction IA – à relire
#: tyrell_towel/tyrell_wrapup_1/0/28/s/0
msgctxt "Choix"
msgid "Your friends would be proud of you if they could see you now!"
msgstr "Tes amis seraient fiers de toi s'ils te voyaient maintenant !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_wrapup_1/0/c-0/7
msgctxt "Tyrell"
msgid "Complain? I thought we were bonding more than anything."
msgstr "Me plaindre ? Je croyais qu'on était surtout en train de tisser des liens."

# Traduction IA – à relire
#: tyrell_towel/tyrell_wrapup_1/0/c-0/18/0/s/0
msgctxt "Choix"
msgid "You're a towel. Towels clean up messes. That's how it works."
msgstr "Tu es une serviette. Les serviettes nettoient les dégâts. C'est comme ça que ça marche."

# Traduction IA – à relire
#: tyrell_towel/tyrell_wrapup_1/0/c-0/18/1/s/0
msgctxt "Choix"
msgid "Everyone has a sad story. It's not that big of a deal."
msgstr "Tout le monde a une histoire triste. Ce n'est pas si grave."

# Traduction IA – à relire
#: tyrell_towel/tyrell_wrapup_1/0/c-0/18/2/s/0
msgctxt "Choix"
msgid "You are good at being you. Shouldn't that be enough?"
msgstr "Tu es doué pour être toi. Ça ne devrait pas suffire ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_wrapup_1/0/c-0/18/c-2/7
msgctxt "Tyrell"
msgid "You know what? I am good at being me! I'm the best me there ever could be!"
msgstr "Tu sais quoi ? Je suis doué pour être moi ! Je suis le meilleur moi qui puisse exister !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_wrapup_1/0/c-1/7
msgctxt "Tyrell"
msgid "Yeah... I think they would be!"
msgstr "Ouais... je crois qu'ils le seraient !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_wrapup_1/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "I really appreciate what you do for me!"
msgstr "J'apprécie vraiment ce que tu fais pour moi !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_wrapup_1/0/c-1/15/1/s/0
msgctxt "Choix"
msgid "You are the one and only you. That means something special!"
msgstr "Tu es unique en ton genre. Ça veut dire quelque chose de spécial !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_wrapup_1/0/c-1/15/c-0/7
msgctxt "Tyrell"
msgid "Aww... hey, that's really nice to hear!"
msgstr "Aww... eh, ça fait vraiment plaisir à entendre !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_wrapup_1/0/c-1/15/c-1/7
msgctxt "Tyrell"
msgid "Thanks for reminding me of that. Towel pal appreciates it, too!"
msgstr "Merci de me l'avoir rappelé. Mon petit pote apprécie aussi !"

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/0
msgctxt "Tyrell"
msgid "Picture it! The music of summer playing over a speaker, perhaps bluetooth."
msgstr "Imagine ! De la musique d'été qui sort d'une enceinte, peut-être en bluetooth."

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/8
msgctxt "Tyrell"
msgid "The smell of sea salt and tight canvas in the air."
msgstr "Une odeur de sel marin et de toile tendue dans l'air."

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/16
msgctxt "Tyrell"
msgid "To your right, one of those tall lifeguard stands that someone in bright red shorts sits on."
msgstr "À ta droite, une de ces hautes chaises de maître nageur où est assis quelqu'un en short rouge vif."

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/24
msgctxt "Tyrell"
msgid "To your left, a couple that most likely had an argument in the car. They both try to make the best of the day. It's super awkward!"
msgstr "À ta gauche, un couple qui s'est sûrement disputé dans la voiture. Ils essaient tous les deux de profiter de la journée malgré tout. C'est super gênant !"

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/32
msgctxt "Tyrell"
msgid "And there I am, with you, stretched out in the sand, a giant umbrella behind us, blocking out the sun..."
msgstr "Et moi, là, avec toi, allongés dans le sable, un immense parasol derrière nous qui bloque le soleil..."

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/40
msgctxt "Tyrell"
msgid "...and us just chilling."
msgstr "...et nous deux qui nous la coulons douce."

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/48
msgctxt "Tyrell"
msgid "Can you guess what I want to do?"
msgstr "Tu devines ce que j'aimerais faire ?"

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/56/s/0
msgctxt "Choix"
msgid "I have no idea."
msgstr "Aucune idée."

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/57/s/0
msgctxt "Choix"
msgid "You want to be a beach towel?"
msgstr "Tu veux être une serviette de plage ?"

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/c-0/7
msgctxt "Tyrell"
msgid "It's pretty obvious. I want to be a beach towel!"
msgstr "C'est assez évident. Je veux être une serviette de plage !"

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/c-1/7
msgctxt "Tyrell"
msgid "Ding ding ding! That's right!"
msgstr "Ding ding ding ! Bingo !"

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/g-0/0
msgctxt "Tyrell"
msgid "Beach towels have it made! They just lay in the sand all day, taking in all the sights."
msgstr "Les serviettes de plage, elles ont tout compris ! Elles restent allongées sur le sable toute la journée à admirer le paysage."

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/g-0/8
msgctxt "Tyrell"
msgid "At night, they get to sit next to a fire and listen to someone play one of three songs they know on guitar."
msgstr "Le soir, elles s'installent près d'un feu et écoutent quelqu'un jouer à la guitare l'une des trois chansons qu'il connaît."

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/g-0/16
msgctxt "Tyrell"
msgid "I'd still get to dry people off AND the sun would help me do my job better!"
msgstr "Je continuerais à sécher les gens ET le soleil m'aiderait à mieux faire mon travail !"

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/g-0/24
msgctxt "Tyrell"
msgid "And who could ask for a better view? Clear blue waters. Open skies. My towel buddy could be there, too!"
msgstr "Et qui voudrait une plus belle vue ? Des eaux bleues et limpides. Un ciel dégagé. Mon petit pote pourrait y être aussi !"

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/g-0/32
msgctxt "Tyrell"
msgid "Oh! I could fold you into a fish! Or a seagull!"
msgstr "Oh ! Je pourrais te plier en poisson ! Ou en mouette !"

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/g-0/40/s/0
msgctxt "Choix"
msgid "Would you want me to go with you?"
msgstr "Tu voudrais que je vienne avec toi ?"

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/g-0/41/s/0
msgctxt "Choix"
msgid "That means, I'd have to leave the house."
msgstr "Ça veut dire que je devrais quitter la maison."

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/g-0/c-2/7
msgctxt "Tyrell"
msgid "Oh, of course! We'd have to go together."
msgstr "Oh, bien sûr ! On y irait ensemble."

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/g-0/c-2/15
msgctxt "Tyrell"
msgid "Just, promise me you won't get mad if I track sand in the car."
msgstr "Promets-moi juste de ne pas te fâcher si je mets du sable dans la voiture."

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/g-0/c-2/27
msgctxt "Tyrell"
msgid "It's kind of a hazard of the job."
msgstr "C'est un peu un risque du métier."

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/g-0/c-3/7
msgctxt "Tyrell"
msgid "Well, yeah. Which I know has been... tough."
msgstr "Eh bien, oui. Je sais que ça a été... dur."

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/g-0/c-3/15
msgctxt "Tyrell"
msgid "But, when you're ready, it's a better place to go, right?"
msgstr "Mais quand tu seras prêt, c'est un endroit où il fait meilleur aller, non ?"

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/g-0/c-3/23
msgctxt "Tyrell"
msgid "We would have so much fun!"
msgstr "On s'amuserait tellement !"

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/g-1/0/s/0
msgctxt "Choix"
msgid "I'd go to the beach with you. Just to see you smile!"
msgstr "J'irais à la plage avec toi. Rien que pour voir ton sourire !"

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/g-1/1/s/0
msgctxt "Choix"
msgid "But you do great work here! We need you here!"
msgstr "Mais tu fais du super boulot ici ! On a besoin de toi ici !"

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/g-1/2/s/0
msgctxt "Choix"
msgid "I don't think you as a beach towel would work."
msgstr "Je ne crois pas que ça marcherait, toi en serviette de plage."

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/g-1/3/s/0
msgctxt "Choix"
msgid "Yeah... I don't think I can leave the house yet."
msgstr "Ouais... je ne crois pas pouvoir quitter la maison pour l'instant."

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/g-1/c-4/7
msgctxt "Tyrell"
msgid "You would? You would leave the house for me?"
msgstr "Tu le ferais ? Tu quitterais la maison pour moi ?"

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/g-1/c-4/18/0/s/0
msgctxt "Choix"
msgid "I think you would make an awesome beach towel. I'd love to see it!"
msgstr "Je pense que tu ferais une super serviette de plage. J'adorerais voir ça !"

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/g-1/c-4/18/1/s/0
msgctxt "Choix"
msgid "Getting to lie out with you sounds like a perfect day!"
msgstr "Me prélasser avec toi, ça me paraît une journée parfaite !"

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/g-1/c-4/18/c-0/7
msgctxt "Tyrell"
msgid "I think I'd be good at it, too!"
msgstr "Je pense que je serais doué pour ça, moi aussi !"

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/g-1/c-4/18/c-1/7
msgctxt "Tyrell"
msgid "We would turn heads, that's for sure!"
msgstr "On ferait tourner les têtes, c'est sûr !"

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/g-1/c-5/7
msgctxt "Tyrell"
msgid "Really? I didn't know you felt that way. That makes me feel great!"
msgstr "Vraiment ? Je ne savais pas que tu le voyais comme ça. Ça me fait un bien fou !"

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/g-1/c-6/7
msgctxt "Tyrell"
msgid "Why... why not?"
msgstr "Pourquoi... pourquoi pas ?"

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/g-1/c-6/18/0/s/0
msgctxt "Choix"
msgid "You weren't made for it. Simple as that."
msgstr "Tu n'as pas été fait pour ça. C'est aussi simple que ça."

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/g-1/c-6/18/1/s/0
msgctxt "Choix"
msgid "You should be happy where you are."
msgstr "Tu devrais être heureux là où tu es."

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/g-1/c-7/7
msgctxt "Tyrell"
msgid "It isn't like it has to be right now or anything."
msgstr "Ce n'est pas comme si ça devait être tout de suite ou quoi."

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/g-1/c-7/15
msgctxt "Tyrell"
msgid "Just, eventually, you know?"
msgstr "Juste, un jour, tu vois ?"

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/g-1/c-7/23/0/s/0
msgctxt "Choix"
msgid "Stop thinking about it. It's a dumb idea."
msgstr "Arrête d'y penser. C'est une idée stupide."

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/g-1/c-7/23/1/s/0
msgctxt "Choix"
msgid "Why change anything? You are great here!"
msgstr "Pourquoi changer quoi que ce soit ? Tu es génial ici !"

# Traduction IA – à relire
#: tyrell_towel/beach_day/0/g-1/c-7/23/c-1/7
msgctxt "Tyrell"
msgid "It would be fun... But, it's nice to know I'm appreciated, I guess."
msgstr "Ça aurait été marrant... Mais c'est bon de savoir qu'on m'apprécie, je suppose."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate/0/0
msgctxt "Tyrell"
msgid "I... uhh... didn't see that coming."
msgstr "Je... euh... je ne m'y attendais pas."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate/0/8
msgctxt "Tyrell"
msgid "You really feel that way, don't you?"
msgstr "Tu le penses vraiment, hein ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate/0/16
msgctxt "Tyrell"
msgid "Can you hold on a second? I've gotta do something."
msgstr "Tu peux patienter une seconde ? J'ai un truc à faire."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate/0/30
msgctxt "Narrator"
msgid "He refolds his towel buddy into a new shape with a few swift, expert movements."
msgstr "Il replie sa Serviette-Pote en une nouvelle forme, en quelques mouvements rapides et experts."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate/0/38/s/0
msgctxt "Choix"
msgid "Wow. That was fast."
msgstr "Waouh. C'était rapide."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate/0/39/s/0
msgctxt "Choix"
msgid "That monkey looks pissed."
msgstr "Ce singe a l'air furax."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate/0/c-0/7
msgctxt "Tyrell"
msgid "Just like our relationship."
msgstr "Un peu comme notre relation."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate/0/c-1/7
msgctxt "Tyrell"
msgid "Oh, don't worry about them."
msgstr "Oh, ne t'inquiète pas pour lui."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate/0/g-0/0
msgctxt "Tyrell"
msgid "I'm... I'm gonna get back to work."
msgstr "Je... je vais me remettre au travail."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate/0/g-0/8
msgctxt "Tyrell"
msgid "I should just appreciate what I have, right?"
msgstr "Je devrais juste apprécier ce que j'ai, non ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate/0/g-0/16
msgctxt "Tyrell"
msgid "This is my lot in life."
msgstr "C'est mon sort dans la vie."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate/0/g-0/24
msgctxt "Tyrell"
msgid "Which is fine. I guess."
msgstr "Ce qui est très bien. Je suppose."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate/0/g-0/32
msgctxt "Tyrell"
msgid "If you have a spill or whatever, let me know. But... outside of that?"
msgstr "Si tu as des dégâts ou quoi, dis-le-moi. Mais... à part ça ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate/0/g-0/40
msgctxt "Tyrell"
msgid "...I think I'll stick to my towel buddy."
msgstr "...je crois que je vais m'en tenir à mon petit pote."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate/0/g-0/51
msgctxt "Tyrell"
msgid "They know how to support somebody."
msgstr "Lui, il sait soutenir quelqu'un."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate/0/g-0/93
msgctxt "Reggie"
msgid "Really dried him out, huh..."
msgstr "Tu l'as complètement asséché, hein..."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate/0/g-0/101
msgctxt "Reggie"
msgid "What happened? Too self-absorbed?"
msgstr "Qu'est-ce qui s'est passé ? Trop imbu de lui-même ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_friendship_1/0/0
msgctxt "Tyrell"
msgid "I've got to remember that I've earned the right to be this awesome!"
msgstr "Je dois me rappeler que j'ai gagné le droit d'être aussi génial !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_friendship_1/0/8
msgctxt "Tyrell"
msgid "Really, I've been going around in circles about this for awhile."
msgstr "Franchement, ça fait un moment que je tourne en rond là-dessus."

# Traduction IA – à relire
#: tyrell_towel/tyrell_friendship_1/0/16
msgctxt "Tyrell"
msgid "It can often feel like you aren't making progress."
msgstr "On a souvent l'impression de ne pas avancer."

# Traduction IA – à relire
#: tyrell_towel/tyrell_friendship_1/0/24/s/0
msgctxt "Choix"
msgid "I know exactly what you mean!"
msgstr "Je vois exactement ce que tu veux dire !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_friendship_1/0/25/s/0
msgctxt "Choix"
msgid "I have never experienced that."
msgstr "Je n'ai jamais vécu ça."

# Traduction IA – à relire
#: tyrell_towel/tyrell_friendship_1/0/c-0/7
msgctxt "Tyrell"
msgid "All the more reason to appreciate you reminding me that it's okay to just be me!"
msgstr "Raison de plus pour te remercier de m'avoir rappelé que c'est bien d'être juste moi !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_friendship_1/0/c-1/7
msgctxt "Tyrell"
msgid "Consider yourself lucky then!"
msgstr "Alors estime-toi heureux !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_friendship_1/0/g-0/0
msgctxt "Tyrell"
msgid "I guess I do have a pretty good setup here."
msgstr "Je crois que j'ai plutôt une bonne situation, ici."

# Traduction IA – à relire
#: tyrell_towel/tyrell_friendship_1/0/g-0/8
msgctxt "Tyrell"
msgid "And towel buddy is safe with me."
msgstr "Et mon petit pote est en sécurité avec moi."

# Traduction IA – à relire
#: tyrell_towel/tyrell_friendship_1/0/g-0/16
msgctxt "Tyrell"
msgid "Oh!"
msgstr "Oh !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_friendship_1/0/g-0/24
msgctxt "Tyrell"
msgid "An idea just came to me!"
msgstr "Une idée vient de me venir !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_friendship_1/0/g-0/32/14
msgctxt "Narrator"
msgid "Tyrell walks off for a few moments. When he returns you notice the towel buddy he carries has a new shape."
msgstr "Tyrell s'éloigne quelques instants. À son retour, vous remarquez que la Serviette-Pote qu'il porte a pris une nouvelle forme."

# Traduction IA – à relire
#: tyrell_towel/tyrell_friendship_1/0/g-0/32/25/s/0
msgctxt "Choix"
msgid "Awww! Look at them! They are so cute!"
msgstr "Awww ! Regarde-le ! Il est trop mignon !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_friendship_1/0/g-0/32/26/s/0
msgctxt "Choix"
msgid "I LOVE ELEPHANTS!"
msgstr "J'ADORE LES ÉLÉPHANTS !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_friendship_1/0/g-0/32/c-2/7
msgctxt "Tyrell"
msgid "Right??"
msgstr "Pas vrai ??"

# Traduction IA – à relire
#: tyrell_towel/tyrell_friendship_1/0/g-0/32/c-3/7
msgctxt "Tyrell"
msgid "ME TOO!"
msgstr "MOI AUSSI !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_friendship_1/0/g-1/0
msgctxt "Tyrell"
msgid "Now, towel buddy will help me remember how lucky I really am!"
msgstr "Maintenant, mon petit pote m'aidera à me rappeler la chance que j'ai vraiment !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_friendship_1/0/g-1/8
msgctxt "Tyrell"
msgid "Thanks for hearing me out. I haven't told that story to anyone."
msgstr "Merci de m'avoir écouté. Je n'avais raconté cette histoire à personne."

# Traduction IA – à relire
#: tyrell_towel/tyrell_friendship_1/0/g-1/16
msgctxt "Tyrell"
msgid "It's nice to be heard."
msgstr "Ça fait du bien d'être écouté."

# Traduction IA – à relire
#: tyrell_towel/tyrell_friendship_1/0/g-1/24
msgctxt "Tyrell"
msgid "I'm glad that you showed me so much support."
msgstr "Je suis content que tu m'aies autant soutenu."

# Traduction IA – à relire
#: tyrell_towel/tyrell_friendship_1/0/g-1/32
msgctxt "Tyrell"
msgid "I'm gonna go play with towel buddy. We'll check you later!"
msgstr "Je vais jouer avec mon petit pote. On se voit plus tard !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_friendship_2/0/0
msgctxt "Tyrell"
msgid "I... I didn't realize how much I needed to hear that."
msgstr "Je... je ne me rendais pas compte à quel point j'avais besoin d'entendre ça."

# Traduction IA – à relire
#: tyrell_towel/tyrell_friendship_2/0/11
msgctxt "Tyrell"
msgid "I do great work here, don't I?"
msgstr "Je fais du bon boulot ici, non ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_friendship_2/0/19
msgctxt "Tyrell"
msgid "Sure, I can get annoyed with certain people singing in the shower all night, and sometimes the work can seem thankless."
msgstr "Bien sûr, certains qui chantent sous la douche toute la nuit peuvent m'agacer, et le travail paraît parfois ingrat."

# Traduction IA – à relire
#: tyrell_towel/tyrell_friendship_2/0/27
msgctxt "Tyrell"
msgid "But you just reminded me that I'm made for this kind of life!"
msgstr "Mais tu viens de me rappeler que je suis fait pour cette vie-là !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_friendship_2/0/35
msgctxt "Tyrell"
msgid "And hell, I look good doing it!"
msgstr "Et bon sang, je suis beau à regarder en le faisant !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_friendship_2/0/43/s/0
msgctxt "Choix"
msgid "You sure do!"
msgstr "Ça, c'est sûr !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_friendship_2/0/44/s/0
msgctxt "Choix"
msgid "That's the spirit!"
msgstr "Voilà l'état d'esprit !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_friendship_2/0/c-0/7
msgctxt "Tyrell"
msgid "Tee hee!"
msgstr "Hi hi !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_friendship_2/0/c-1/7
msgctxt "Tyrell"
msgid "It <i>is</i> the spirit, dammit!"
msgstr "C'<i>est</i> bien ça, l'état d'esprit, bon sang !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_friendship_2/0/g-0/0
msgctxt "Tyrell"
msgid "I can forget that sometimes. You get so caught up in everything and the day to day, that you lose sight of who you are."
msgstr "On peut l'oublier, parfois. On est tellement pris par tout et par le quotidien qu'on perd de vue qui on est."

# Traduction IA – à relire
#: tyrell_towel/tyrell_friendship_2/0/g-0/8
msgctxt "Tyrell"
msgid "I appreciate you for reminding me of all of this."
msgstr "Je te remercie de m'avoir rappelé tout ça."

# Traduction IA – à relire
#: tyrell_towel/tyrell_friendship_2/0/g-0/16
msgctxt "Tyrell"
msgid "You know what? I have an idea!"
msgstr "Tu sais quoi ? J'ai une idée !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/0
msgctxt "Tyrell"
msgid "You know... that's the first time I've told anyone my dream."
msgstr "Tu sais... c'est la première fois que je raconte mon rêve à quelqu'un."

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/8
msgctxt "Tyrell"
msgid "I'll be honest, I was a little worried that you might think it was silly."
msgstr "Je vais être honnête, j'avais un peu peur que tu le trouves idiot."

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/16/s/0
msgctxt "Choix"
msgid "I don't think it's silly at all!"
msgstr "Je ne le trouve pas idiot du tout !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/17/s/0
msgctxt "Choix"
msgid "We all have dreams! There isn't anything wrong with that!"
msgstr "On a tous des rêves ! Il n'y a rien de mal à ça !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/18/s/0
msgctxt "Choix"
msgid "It was silly... you're too small and dainty to be a beach towel!"
msgstr "C'était idiot... tu es trop petit et trop délicat pour être une serviette de plage !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/c-0/7
msgctxt "Tyrell"
msgid "What do you think?"
msgstr "Qu'est-ce que tu en penses ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "I think it's absolutely awesome, we'll make it happen one day."
msgstr "Je trouve ça absolument génial, on le réalisera un jour."

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/c-0/15/1/s/0
msgctxt "Choix"
msgid "I think it's unobtainable and brazenly stupid."
msgstr "Je trouve ça inaccessible et d'une bêtise éhontée."

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/c-0/15/c-0/7
msgctxt "Tyrell"
msgid "Yes!"
msgstr "Oui !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/c-0/15/c-0/18/b/1
msgctxt "Tyrell"
msgid "Though remember... no promises about tracking sand into your car, okay?"
msgstr "Mais rappelle-toi... aucune promesse pour le sable dans ta voiture, d'accord ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/c-1/7
msgctxt "Narrator"
msgid "Tyrell fans his face with his hands."
msgstr "Tyrell s'évente le visage avec les mains."

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/c-1/15
msgctxt "Tyrell"
msgid "Tyrell.... don't cry..."
msgstr "Tyrell.... ne pleure pas..."

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/c-1/23
msgctxt "Tyrell"
msgid "Who is gonna dry you up...?"
msgstr "Qui va te sécher, après ?..."

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-0/0
msgctxt "Tyrell"
msgid "You're the best, you know that?"
msgstr "Tu es le meilleur, tu le sais ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-0/8
msgctxt "Tyrell"
msgid "And think of all the sunsets we could watch together."
msgstr "Et pense à tous les couchers de soleil qu'on pourrait regarder ensemble."

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-0/16
msgctxt "Tyrell"
msgid "You and me. Cuddled up real close."
msgstr "Toi et moi. Blottis tout près l'un de l'autre."

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-0/27
msgctxt "Tyrell"
msgid "It would be like nothing else mattered, even if it was just for a few moments."
msgstr "Ce serait comme si plus rien d'autre n'avait d'importance, même rien que quelques instants."

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-0/35
msgctxt "Tyrell"
msgid "That would be AWESOME! We've gotta make it happen."
msgstr "Ce serait GÉNIAL ! Il faut qu'on le fasse."

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-0/43/s/0
msgctxt "Choix"
msgid "As long as I'm there with you, I know it will be perfect!"
msgstr "Tant que je suis là avec toi, je sais que ce sera parfait !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-0/44/s/0
msgctxt "Choix"
msgid "All that... except the cuddling."
msgstr "Tout ça... sauf les câlins."

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-0/45/s/0
msgctxt "Choix"
msgid "I'll be happy to help make your dream come true."
msgstr "Je serai heureux de t'aider à réaliser ton rêve."

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-0/c-3/7
msgctxt "Tyrell"
msgid "Nothing will keep us apart."
msgstr "Rien ne nous séparera."

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-0/c-5/7
msgctxt "Tyrell"
msgid "It's settled."
msgstr "C'est réglé."

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-1/0
msgctxt "Tyrell"
msgid "You know what the really cool part of this is?"
msgstr "Tu sais ce qu'il y a de vraiment bien là-dedans ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-1/8
msgctxt "Tyrell"
msgid "You are a part of that dream now, too."
msgstr "Tu fais partie de ce rêve, toi aussi, maintenant."

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-1/16
msgctxt "Tyrell"
msgid "Hey!"
msgstr "Eh !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-1/24
msgctxt "Tyrell"
msgid "I've got an idea."
msgstr "J'ai une idée."

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-1/32 tyrell_towel/tyrell_friend_backout/0/24
msgctxt "Tyrell"
msgid "Towel buddy!"
msgstr "Serviette-Pote !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-1/43 tyrell_towel/tyrell_friend_backout/0/35
msgctxt "Tyrell"
msgid "<i>Remember that one I've been saving for a special moment? I think it's time!</i>"
msgstr "<i>Tu te rappelles celle que je gardais pour un moment spécial ? Je crois que c'est l'heure !</i>"

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-1/51 tyrell_towel/tyrell_friend_backout/0/43
msgctxt "Tyrell"
msgid "We'll be right back!"
msgstr "On revient tout de suite !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-1/65 tyrell_towel/tyrell_friend_backout/0/57
msgctxt "Narrator"
msgid "Tyrell disappears from view for a few moments."
msgstr "Tyrell disparaît de votre vue quelques instants."

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-1/70 tyrell_towel/tyrell_friend_backout/0/67
msgctxt "Tyrell"
msgid "<i>Yep... just like that. Tuck it under!</i>"
msgstr "<i>Oui... comme ça. Rentre-le dessous !</i>"

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-1/78 tyrell_towel/tyrell_friend_backout/0/72
msgctxt "Tyrell"
msgid "<i>You look so good!</i>"
msgstr "<i>Tu es trop beau !</i>"

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-1/89 tyrell_towel/tyrell_friend_backout/0/80
msgctxt "Narrator"
msgid "When he returns, he holds his towel buddy out to you, now in a new and delightful shape."
msgstr "À son retour, il vous tend sa Serviette-Pote, dans une forme nouvelle et ravissante."

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-1/97 tyrell_towel/tyrell_friend_backout/0/88
msgctxt "Tyrell"
msgid "Well?"
msgstr "Alors ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-1/108/s/0 tyrell_towel/tyrell_friend_backout/0/99/s/0 tyrell_towel/tyrell_hate_return/0/g-0/33/s/0
msgctxt "Choix"
msgid "Look at the cute piggy!!!"
msgstr "Regarde le mignon cochon !!!"

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-1/109/s/0 tyrell_towel/tyrell_friend_backout/0/100/s/0 tyrell_towel/tyrell_hate_return/0/g-0/34/s/0
msgctxt "Choix"
msgid "OH. MY. GOODNESS! So precious!"
msgstr "OH. MON. DIEU ! Trop adorable !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-1/c-6/7 tyrell_towel/tyrell_friend_backout/0/c-0/7
msgctxt "Tyrell"
msgid "He's a little poopy pie!"
msgstr "C'est un petit chou d'amour !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-1/c-7/7 tyrell_towel/tyrell_friend_backout/0/c-1/7
msgctxt "Tyrell"
msgid "I knoowww!!"
msgstr "Je sais !!"

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-2/0 tyrell_towel/tyrell_friend_backout/0/g-0/0 tyrell_towel/tyrell_hate_return/0/g-1/0
msgctxt "Tyrell"
msgid "I had to make sure I got the nose just right."
msgstr "Il fallait que je réussisse bien le nez."

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-2/8 tyrell_towel/tyrell_friend_backout/0/g-0/8
msgctxt "Tyrell"
msgid "I think towel buddy will be like this for awhile."
msgstr "Je pense que ma Serviette-Pote restera comme ça un moment."

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-2/16 tyrell_towel/tyrell_friend_backout/0/g-0/13
msgctxt "Tyrell"
msgid "And, you know..."
msgstr "Et, tu sais..."

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-2/24 tyrell_towel/tyrell_friend_backout/0/g-0/18
msgctxt "Tyrell"
msgid "...you can wrap me around you... anytime you want..."
msgstr "...tu peux t'enrouler dans moi... quand tu veux..."

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-2/32 tyrell_towel/tyrell_friend_backout/0/g-0/26
msgctxt "Tyrell"
msgid "I'm cozy regardless of the circumstances."
msgstr "Je suis douillet quelles que soient les circonstances."

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-2/40 tyrell_towel/tyrell_friend_backout/0/g-0/31
msgctxt "Tyrell"
msgid "You get me?"
msgstr "Tu vois ce que je veux dire ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-2/48/s/0 tyrell_towel/tyrell_friend_backout/0/g-0/36/s/0
msgctxt "Choix"
msgid "Hubba hubba."
msgstr "Ouh là là."

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-2/49/s/0 tyrell_towel/tyrell_friend_backout/0/g-0/37/s/0
msgctxt "Choix"
msgid "I do get you, Tyrell."
msgstr "Je vois très bien, Tyrell."

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-2/50/s/0 tyrell_towel/tyrell_friend_backout/0/g-0/38/s/0
msgctxt "Choix"
msgid "<i>Start sweating.</i>"
msgstr "<i>Commencer à transpirer.</i>"

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-3/3 tyrell_towel/tyrell_friend_backout/0/g-1/3
msgctxt "Tyrell"
msgid "<i>Oh! Sorry.</i>"
msgstr "<i>Oh ! Pardon.</i>"

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-3/14 tyrell_towel/tyrell_friend_backout/0/g-1/11
msgctxt "Tyrell"
msgid "I shouldn't talk like this in front of towel buddy. He's just a washcloth, after all."
msgstr "Je ne devrais pas parler comme ça devant ma Serviette-Pote. Ce n'est qu'un gant de toilette, après tout."

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-3/22 tyrell_towel/tyrell_friend_backout/0/g-1/19
msgctxt "Tyrell"
msgid "But the offer still stands, okay?"
msgstr "Mais l'offre tient toujours, d'accord ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_love/0/g-3/30 tyrell_towel/tyrell_friend_backout/0/g-1/24
msgctxt "Tyrell"
msgid "I look forward to those sunsets!"
msgstr "J'ai hâte de voir ces couchers de soleil !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_friend_backout/0/0
msgctxt "Tyrell"
msgid "Oh don't worry... if we're friends and I happen to be pressed against your body, I won't peek."
msgstr "Oh, ne t'inquiète pas... si on est amis et que je me retrouve plaqué contre ton corps, je ne regarderai pas."

# Traduction IA – à relire
#: tyrell_towel/tyrell_friend_backout/0/8
msgctxt "Tyrell"
msgid "It's the towelmanly thing to do after all."
msgstr "C'est ce que ferait tout parfait serviettleman, après tout."

# Traduction IA – à relire
#: tyrell_towel/tyrell_friend_backout/0/16
msgctxt "Tyrell"
msgid "Hey! I've got an idea."
msgstr "Eh ! J'ai une idée."

# Traduction IA – à relire
#: tyrell_towel/tyrell_love_return/0/3
msgctxt "Tyrell"
msgid "You ready to get wrapped up in Tyrell? Because I'm always ready for some of you!"
msgstr "Tu es prêt à te laisser envelopper par Tyrell ? Parce que moi, je suis toujours prêt pour un peu de toi !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_love_return/0/11/s/0 tyrell_towel/tyrell_friend_return/0/14/s/0
msgctxt "Choix"
msgid "How's towel buddy?"
msgstr "Comment va Serviette-Pote ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_love_return/0/12/s/0
msgctxt "Choix"
msgid "I can't wait to make a mess with you."
msgstr "J'ai hâte de faire des dégâts avec toi."

# Traduction IA – à relire
#: tyrell_towel/tyrell_love_return/0/13/s/0
msgctxt "Choix"
msgid "I'd love to make you Realized."
msgstr "J'adorerais te Réaliser."

# Traduction IA – à relire
#: tyrell_towel/tyrell_love_return/0/c-0/7 tyrell_towel/tyrell_friend_return/0/c-0/7
msgctxt "Tyrell"
msgid "Towel buddy is doing great!"
msgstr "Serviette-Pote va très bien !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_love_return/0/c-0/15 tyrell_towel/tyrell_friend_return/0/c-0/15
msgctxt "Narrator"
msgid "He holds the towel creature up to his ear, listening intently."
msgstr "Il porte la créature en tissu à son oreille et écoute attentivement."

# Traduction IA – à relire
#: tyrell_towel/tyrell_love_return/0/c-0/31 tyrell_towel/tyrell_friend_return/0/c-0/31
msgctxt "Tyrell"
msgid "<i>What!</i>"
msgstr "<i>Quoi !</i>"

# Traduction IA – à relire
#: tyrell_towel/tyrell_love_return/0/c-0/47 tyrell_towel/tyrell_friend_return/0/c-0/47
msgctxt "Tyrell"
msgid "Ah don't worry, they're just kiddin'...!"
msgstr "Ah, ne t'en fais pas, il plaisante...!"

# Traduction IA – à relire
#: tyrell_towel/tyrell_love_return/0/c-0/55 tyrell_towel/tyrell_friend_return/0/c-0/55
msgctxt "Narrator"
msgid "Assured that towel buddy didn't mean it, the three of you practice new folding techniques - with ever new towel buddies on the horizon."
msgstr "Rassurés sur les intentions de Serviette-Pote, vous vous exercez tous les trois à de nouvelles techniques de pliage, avec toujours plus de nouvelles Serviettes-Potes à l'horizon."

# Traduction IA – à relire
#: tyrell_towel/tyrell_love_return/0/c-1/7
msgctxt "Tyrell"
msgid "Ooo, I didn't know I would ever like someone so dirty."
msgstr "Ooh, je ne pensais pas qu'un jour j'aimerais quelqu'un d'aussi sale."

# Traduction IA – à relire
#: tyrell_towel/tyrell_love_return/0/c-1/18
msgctxt "Tyrell"
msgid "Come on here, now! Let me get in real close!"
msgstr "Allez, viens ! Laisse-moi me glisser tout contre toi !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_love_return/0/c-1/26
msgctxt "Narrator"
msgid "No one knows your nooks or crannies quite as well as your towel."
msgstr "Personne ne connaît vos moindres recoins aussi bien que votre serviette."

# Traduction IA – à relire
#: tyrell_towel/tyrell_love_return/0/c-1/34
msgctxt "Narrator"
msgid "Tyrell leaves you feeling fuzzy and warm, even a little shiny."
msgstr "Tyrell vous laisse tout doux et tout chaud, et même un peu luisant."

# Traduction IA – à relire
#: tyrell_towel/tyrell_realize_join/0/3
msgctxt "Tyrell"
msgid "What? You mean... me?"
msgstr "Quoi ? Tu veux dire... moi ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_realize_join/0/11
msgctxt "Tyrell"
msgid "I could... live out there? I could do something to make my family proud."
msgstr "Je pourrais... vivre là-bas ? Je pourrais faire quelque chose pour rendre ma famille fière."

# Traduction IA – à relire
#: tyrell_towel/tyrell_realize_join/0/19
msgctxt "Tyrell"
msgid "I mean... that's if you really are okay with me being Realized."
msgstr "Enfin... si tu es vraiment d'accord pour que je sois Réalisé."

# Traduction IA – à relire
#: tyrell_towel/tyrell_realize_join/0/27/s/0
msgctxt "Choix"
msgid "Without a doubt!"
msgstr "Sans aucun doute !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_realize_join/0/c-0/7
msgctxt "Tyrell"
msgid "Well, this is AWESOME!"
msgstr "Eh bien, c'est GÉNIAL !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_realize_join/0/c-0/18
msgctxt "Tyrell"
msgid "Do you have what you need to make it happen?"
msgstr "Tu as ce qu'il faut pour que ça arrive ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_realize_join/0/c-0/35/0/s/0
msgctxt "Choix"
msgid "I sure do!"
msgstr "Et comment !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_realize_join/0/c-0/35/1/s/0
msgctxt "Choix"
msgid "I need a bit more time."
msgstr "Il me faut encore un peu de temps."

# Traduction IA – à relire
#: tyrell_towel/tyrell_realize_join/0/c-0/35/c-1/10
msgctxt "Tyrell"
msgid "No big deal. I'll just hang around here and wait for you."
msgstr "Pas de souci. Je vais traîner par ici en t'attendant."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate_return/0/3
msgctxt "Tyrell"
msgid "Hey. I'll get you whatever you need when I can. I've gotta go."
msgstr "Eh. Je te trouverai ce qu'il te faut dès que je pourrai. Je dois y aller."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate_return/0/11/s/0
msgctxt "Choix"
msgid "Really?"
msgstr "Vraiment ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate_return/0/12/s/0
msgctxt "Choix"
msgid "I do have something I want from you. (USE EMPATHY CANDY)"
msgstr "J'ai quelque chose à te demander. (UTILISER UN BONBON D'EMPATHIE)"

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate_return/0/c-0/7
msgctxt "Tyrell"
msgid "Unless you have something you want me to do... I'd rather be alone."
msgstr "À moins que tu veuilles que je fasse quelque chose... je préférerais être seul."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate_return/0/c-1/7
msgctxt "Tyrell"
msgid "Lint? I'm fresh out."
msgstr "Des peluches ? Je n'en ai plus."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate_return/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "No. To start fresh. As friends."
msgstr "Non. Pour repartir de zéro. En amis."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate_return/0/c-1/15/c-0/7
msgctxt "Tyrell"
msgid "Hm."
msgstr "Hm."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate_return/0/c-1/15/c-0/15
msgctxt "Tyrell"
msgid "Well."
msgstr "Bon."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate_return/0/c-1/15/c-0/23
msgctxt "Tyrell"
msgid "I've been working on something... wanna see?"
msgstr "J'ai travaillé sur quelque chose... tu veux voir ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate_return/0/c-1/15/c-0/31/0/s/0
msgctxt "Choix"
msgid "Definitely!"
msgstr "Carrément !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate_return/0/c-1/15/c-0/31/c-0/7
msgctxt "Tyrell"
msgid "'k."
msgstr "Ok."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate_return/0/c-1/15/c-0/31/c-0/15
msgctxt "Tyrell"
msgid "I think it's time."
msgstr "Je crois qu'il est temps."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate_return/0/c-1/15/c-0/31/c-0/23
msgctxt "Tyrell"
msgid "I'll be right back."
msgstr "Je reviens tout de suite."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate_return/0/g-0/6
msgctxt "Narrator"
msgid "Tyrell exits the room, but you can hear the sound of cloth folding."
msgstr "Tyrell sort de la pièce, mais vous entendez un bruit de tissu qu'on plie."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate_return/0/g-0/25
msgctxt "Narrator"
msgid "When he returns, Tyrell holds his towel buddy out to you, now in a new and improved shape."
msgstr "À son retour, Tyrell vous tend sa Serviette-Pote, dans une forme nouvelle et améliorée."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate_return/0/g-0/c-2/7
msgctxt "Tyrell"
msgid "I know!!"
msgstr "Je sais !!"

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate_return/0/g-0/c-3/7
msgctxt "Tyrell"
msgid "So precious!!"
msgstr "Trop adorable !!"

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate_return/0/g-1/8
msgctxt "Tyrell"
msgid "I'm very glad you like it."
msgstr "Je suis très content que ça te plaise."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate_return/0/g-1/16
msgctxt "Tyrell"
msgid "Thanks for honoring my choices. I can tell you've changed."
msgstr "Merci de respecter mes choix. Je vois bien que tu as changé."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate_return/0/g-1/24
msgctxt "Tyrell"
msgid "Aw who am I kidding... I'm lonely as hell!"
msgstr "Bah, qui j'essaie de duper... je suis seul comme un chien !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate_return/0/g-1/32
msgctxt "Tyrell"
msgid "Let's be friends."
msgstr "Soyons amis."

# Traduction IA – à relire
#: tyrell_towel/tyrell_hate_return/0/g-1/40
msgctxt "Tyrell"
msgid "...I think towel buddy is gonna stay like this for awhile."
msgstr "...je crois que ma Serviette-Pote va rester comme ça un moment."

# Traduction IA – à relire
#: tyrell_towel/tyrell_friend_return/0/3
msgctxt "Tyrell"
msgid "Hey there, buddy! It's great to see you again!"
msgstr "Salut, poto ! Ça fait plaisir de te revoir !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_friend_return/0/15/s/0
msgctxt "Choix"
msgid "Tyrell! Got any news?"
msgstr "Tyrell ! Des nouvelles ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_friend_return/0/16/s/0
msgctxt "Choix"
msgid "I think it's time I Realized you!"
msgstr "Je crois qu'il est temps de te Réaliser !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_friend_return/0/c-1/7
msgctxt "Tyrell"
msgid "Did you see how quickly I got that water off the floor? I think I'm getting faster!"
msgstr "Tu as vu à quelle vitesse j'ai nettoyé l'eau par terre ? Je crois que je m'améliore !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_friend_return/0/c-1/18
msgctxt "Narrator"
msgid "You and your friend Tyrell discuss the latest in water-wiping innovations, more than you ever thought you could."
msgstr "Vous et votre ami Tyrell discutez des dernières innovations en matière d'épongeage, bien plus que vous ne l'auriez cru possible."

# Traduction IA – à relire
#: tyrell_towel/tyrell_realize_return/0/0
msgctxt "Tyrell"
msgid "Hey! You're back!"
msgstr "Eh ! Te revoilà !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_realize_return/0/8
msgctxt "Tyrell"
msgid "Ready to make this thing happen?"
msgstr "Prêt à faire en sorte que ça arrive ?"

# Traduction IA – à relire
#: tyrell_towel/tyrell_realize_return/0/25/s/0
msgctxt "Choix"
msgid "Prepare to be Realized..."
msgstr "Prépare-toi à être Réalisé..."

# Traduction IA – à relire
#: tyrell_towel/tyrell_realize_return/0/26/s/0
msgctxt "Choix"
msgid "Almost! But not yet."
msgstr "Presque ! Mais pas encore."

# Traduction IA – à relire
#: tyrell_towel/tyrell_realize_return/0/c-1/10
msgctxt "Tyrell"
msgid "It's all good. I'll wait here for you."
msgstr "Pas de souci. Je t'attends ici."

# Traduction IA – à relire
#: tyrell_towel/tyrell_realize_begin/6/b/1
msgctxt "Skylar"
msgid "Our first Realization is awful fluffy. I'm into it."
msgstr "Notre première Réalisation est terriblement duveteuse. J'adore."

# Traduction IA – à relire
#: tyrell_towel/tyrell_realize_begin/9
msgctxt "Skylar"
msgid "Okay Tyrell - let's wring you out into something spectacular!"
msgstr "Bon, Tyrell, on va t'essorer pour en faire quelque chose de spectaculaire !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_realize_begin/23
msgctxt "Narrator"
msgid "The spectral energy flows through your dateviators, and what was once merely a towel, becomes...."
msgstr "L'énergie spectrale traverse vos Dateviators, et ce qui n'était jadis qu'une serviette devient...."

# Traduction IA – à relire
#: tyrell_towel/tyrell_realized/0/3
msgctxt "Tyrell"
msgid "Oh ho ho! Look at this!"
msgstr "Oh oh oh ! Regardez-moi ça !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_realized/0/11
msgctxt "Tyrell"
msgid "I look gooooood!"
msgstr "Je suis trooooop beau !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_realized/0/19
msgctxt "Narrator"
msgid "There Tyrell stands, his smile just as warm as it was before."
msgstr "Tyrell est là, debout, son sourire aussi chaleureux qu'avant."

# Traduction IA – à relire
#: tyrell_towel/tyrell_realized/0/27
msgctxt "Narrator"
msgid "And his body, while less fuzzy, remains as inviting and cozy as ever."
msgstr "Et son corps, bien que moins duveteux, reste aussi accueillant et douillet que jamais."

# Traduction IA – à relire
#: tyrell_towel/tyrell_realized/0/35
msgctxt "Tyrell"
msgid "I can't believe this is really happening!"
msgstr "Je n'arrive pas à croire que ça arrive pour de vrai !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_realized/0/43
msgctxt "Tyrell"
msgid "Check out the hair!"
msgstr "Regardez-moi ces cheveux !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_realized/0/51/s/0
msgctxt "Choix"
msgid "You look as human as human can be!"
msgstr "Tu es aussi humain qu'un humain peut l'être !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_realized/0/52/s/0
msgctxt "Choix"
msgid "So... about making a mess together..."
msgstr "Alors... à propos de faire des dégâts ensemble..."

# Traduction IA – à relire
#: tyrell_towel/tyrell_realized/0/c-1/7
msgctxt "Tyrell"
msgid "Oh, I'm so glad you asked!"
msgstr "Oh, je suis si content que tu poses la question !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_realize_love_path/3
msgctxt "Tyrell"
msgid "Don't worry about a thing. I'll lie down first."
msgstr "Ne t'inquiète de rien. Je m'allonge en premier."

# Traduction IA – à relire
#: tyrell_towel/tyrell_realize_love_path/11
msgctxt "Tyrell"
msgid "Toss whatever you want my way."
msgstr "Balance-moi tout ce que tu veux."

# Traduction IA – à relire
#: tyrell_towel/tyrell_realize_love_path/19
msgctxt "Tyrell"
msgid "I'm good at getting the hard-to-reach places."
msgstr "Je suis doué pour atteindre les endroits difficiles d'accès."

# Traduction IA – à relire
#: tyrell_towel/tyrell_realize_love_path/30
msgctxt "Narrator"
msgid "Indeed."
msgstr "En effet."

# Traduction IA – à relire
#: tyrell_towel/tyrell_realize_love_path/38
msgctxt "Narrator"
msgid "Tyrell is indeed good at getting to those hard-to-reach places. He takes a particular joy in getting dirty with you—after all, tonight, cleanup is on someone else."
msgstr "Tyrell est en effet doué pour atteindre ces endroits difficiles d'accès. Il prend un plaisir tout particulier à se salir avec vous : après tout, ce soir, le nettoyage, c'est pour quelqu'un d'autre."

# Traduction IA – à relire
#: tyrell_towel/tyrell_realize_friend_join/0
msgctxt "Narrator"
msgid "Satiated and excited to see what life had to offer, Tyrell left the house with his towel friends in tow."
msgstr "Rassasié et impatient de voir ce que la vie avait à offrir, Tyrell quitta la maison, suivi de ses amis serviettes."

# Traduction IA – à relire
#: tyrell_towel/tyrell_realize_friend_join/8
msgctxt "Narrator"
msgid "And it didn't take long for Tyrell to find one of the wetter things around - a car wash."
msgstr "Et il ne lui fallut pas longtemps pour trouver l'un des endroits les plus humides du coin : une station de lavage auto."

# Traduction IA – à relire
#: tyrell_towel/tyrell_realize_friend_join/16
msgctxt "Tyrell"
msgid "Look at all the drying capabilities... Those things are HUGE and WEIRDLY SHAPED!"
msgstr "Regardez-moi toutes ces capacités de séchage... Ces machins sont ÉNORMES et de forme BIZARRE !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_realize_friend_join/24
msgctxt "Narrator"
msgid "Thinking of his towel friends, Tyrell decided in that moment on his newest calling:"
msgstr "En pensant à ses amis serviettes, Tyrell décida sur-le-champ de sa nouvelle vocation :"

# Traduction IA – à relire
#: tyrell_towel/tyrell_realize_friend_join/32
msgctxt "Narrator"
msgid "...to give all those who feel like they are rags a chance to make riches."
msgstr "...offrir à tous ceux qui se sentent réduits à l'état de chiffons une chance de passer du chiffon à la fortune."

# Traduction IA – à relire
#: tyrell_towel/tyrell_realize_friend_join/40
msgctxt "Narrator"
msgid "He coordinated with a Second Chance shelter, and opened up Tidy Tyrell's Full Service Car Wash and Dry."
msgstr "Il s'associa à un refuge Seconde Chance et ouvrit Tyrell Impec' : Lavage et Séchage tous services."

# Traduction IA – à relire
#: tyrell_towel/tyrell_realize_friend_join/48
msgctxt "Narrator"
msgid "His employees participate in a profit sharing system that allows those who were once put aside to get back on their feet."
msgstr "Ses employés participent à un système de partage des bénéfices qui permet à ceux qu'on avait mis de côté de se remettre sur pied."

# Traduction IA – à relire
#: tyrell_towel/tyrell_realize_friend_join/56
msgctxt "Narrator"
msgid "And of course, every customer gets a custom folded towel animal to take home."
msgstr "Et bien sûr, chaque client repart avec un animal en serviette plié sur mesure."

# Traduction IA – à relire
#: tyrell_towel/tyrell_realize_friend_join/64
msgctxt "Tyrell"
msgid "Hey, kid! Don't forget your antelope!"
msgstr "Eh, toi ! N'oublie pas ton antilope !"

# Traduction IA – à relire
#: tyrell_towel/tyrell_realize_friend_join/72
msgctxt "Narrator"
msgid "Customers love Tidy Tyrell's passion - making his business a huge success."
msgstr "Les clients adorent la passion de Tyrell, ce qui fait le succès colossal de son entreprise."

# Traduction IA – à relire
#: tyrell_towel/tyrell_realize_friend_join/80
msgctxt "Tyrell"
msgid "Seriously, kid... I have wayyyy too many antelopes! Take it!"
msgstr "Sérieux... j'ai beaucoup trop d'antilopes ! Prends-la !"
