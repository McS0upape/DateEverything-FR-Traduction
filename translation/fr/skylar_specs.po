msgid "Valdivian Data Drones will take me away!"
msgstr "Les Drones de Données Valdivian vont m'emporter !"

# Traduction IA – à relire
#: skylar_specs/skylar_leave/0/c-0/23/0/s/0
msgctxt "Choix"
msgid "Not Valdivian Data Drones!"
msgstr "Pas les Drones de Données Valdivian !"

