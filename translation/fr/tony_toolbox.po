# Traduction IA – à relire
#: tony_toolbox/1
msgctxt "Tag Nom d'objet (MAJUSCULES)"
msgid "TOOLBOX"
msgstr "BOÎTE À OUTILS"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/6
msgctxt "Narrator"
msgid "The handsome construction worker currently invading your space makes you feel as though you've accidentally wandered into an active building site."
msgstr "Le séduisant ouvrier du bâtiment qui envahit actuellement votre espace vous donne l'impression d'avoir atterri par erreur sur un chantier en pleine activité."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/14
msgctxt "Narrator"
msgid "He holds up his hands to stop you from going any further, glaring at you as he looks you up and down."
msgstr "Il lève les mains pour vous empêcher d'avancer et vous dévisage de haut en bas d'un œil mauvais."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/22
msgctxt "Tony"
msgid "Hey, whoa whoa! Where do you think you're going?"
msgstr "Hé, houlà houlà ! Tu vas où comme ça ?"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/33/s/0
msgctxt "Choix"
msgid "This is my house!"
msgstr "C'est chez moi, ici !"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/34/s/0
msgctxt "Choix"
msgid "Closet?"
msgstr "Dans le placard ?"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/35/s/0
msgctxt "Choix"
msgid "To my next lover..."
msgstr "Vers mon prochain amant..."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/c-2/7
msgctxt "Tony"
msgid "Eh?"
msgstr "Hein ?"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-0/0
msgctxt "Tony"
msgid "I can't let you in here without the proper PPE."
msgstr "Je peux pas te laisser entrer sans les EPI réglementaires."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-0/11
msgctxt "Narrator"
msgid "Tony puts his fingers to his mouth and whistles."
msgstr "Tony porte ses doigts à sa bouche et siffle."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-0/19
msgctxt "Tony"
msgid "Ayo! Get 'em outta here."
msgstr "Ohé ! Virez-moi ça d'ici."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-0/27/s/0
msgctxt "Choix"
msgid "Hang on a minute. PP-what?"
msgstr "Une seconde. Les E-quoi ?"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-0/c-3/7
msgctxt "Tony"
msgid "Your hard hat, your boots, your hi-viz vest..."
msgstr "Ton casque, tes bottes, ton gilet jaune..."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-0/c-3/15
msgctxt "Tony"
msgid "C'mon, this is a job site."
msgstr "Allez, c'est un chantier ici."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-0/c-3/23/0/s/0
msgctxt "Choix"
msgid "Except it's the breaker box closet..."
msgstr "Sauf que c'est le placard du tableau électrique..."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-0/c-3/23/c-0/7
msgctxt "Tony"
msgid "Don't even get me started."
msgstr "Me lance pas là-dessus."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-0/c-3/23/c-0/15
msgctxt "Tony"
msgid "Not when Johnny Wannabe next door's got a whole garage to himself!"
msgstr "Pas quand ce Jojo le Prétentieux d'à côté a tout un garage pour lui tout seul !"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-0/c-3/23/c-0/23
msgctxt "Tony"
msgid "I'm talking wall-to-wall pegboard, six kinds of saws and he's got this 12\" auger — man, those things go deep."
msgstr "Je te parle de panneaux perforés du sol au plafond, de six sortes de scies, et d'une tarière de 30 centimètres... mec, ces trucs-là, ça pénètre en profondeur."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-0/c-3/23/c-0/31/0/s/0
msgctxt "Choix"
msgid "Someone's hot and bothered."
msgstr "Quelqu'un a des bouffées de chaleur."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-0/c-3/23/c-0/31/1/s/0
msgctxt "Choix"
msgid "That lucky bastard."
msgstr "Quel veinard, ce salaud."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-0/c-3/23/c-0/31/2/s/0
msgctxt "Choix"
msgid "An auger — that's like a root vegetable, right?"
msgstr "Une tarière, c'est un genre de légume-racine, non ?"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-0/c-3/23/c-0/31/c-0/7
msgctxt "Tony"
msgid "Yeah, well well, what can I say. Professional jealousy."
msgstr "Ouais, bah, qu'est-ce que tu veux que j'te dise. La jalousie professionnelle."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-0/c-3/23/c-0/31/c-1/7
msgctxt "Tony"
msgid "Man, you're tellin' me, one percenters, right?"
msgstr "Mec, tu m'étonnes, les 1 %, hein ?"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-0/c-3/23/c-0/31/c-2/7
msgctxt "Tony"
msgid "A veg-... WHAT?"
msgstr "Un légu-... QUOI ?"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-0/c-3/23/c-0/31/c-2/15
msgctxt "Tony"
msgid "You don't know nuthin', do ya?"
msgstr "Tu y connais rien, hein ?"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-1/0
msgctxt "Tony"
msgid "Look, all's I'm saying is I want a little more space too."
msgstr "Écoute, tout ce que j'dis, c'est que moi aussi, j'veux un peu plus de place."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-1/8
msgctxt "Tony"
msgid "Y'know, for entertaining."
msgstr "Tu vois, pour recevoir."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-1/16/s/0
msgctxt "Choix"
msgid "Host a lot of cocktail parties?"
msgstr "Tu organises beaucoup de cocktails ?"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-1/c-4/7
msgctxt "Tony"
msgid "I'm a popular tool."
msgstr "Je suis un outil très demandé."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-1/c-4/15
msgctxt "Tony"
msgid "It's always \"Hi Tony this\" or \"Thanks Tony that\" or \"Ton', my ass is leaking.\""
msgstr "C'est toujours « Salut Tony, ceci » ou « Merci Tony, cela » ou « Ton', j'ai une fuite au cul »."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-1/c-4/23/0/s/0
msgctxt "Choix"
msgid "Please don't tell me whose..."
msgstr "Me dis pas à qui..."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-1/c-4/23/c-0/7
msgctxt "Tony"
msgid "Jean Loo."
msgstr "Jean Loo."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-1/c-4/23/c-0/15
msgctxt "Tony"
msgid "Incontinence."
msgstr "Incontinence."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-1/c-4/23/c-0/23
msgctxt "Tony"
msgid "You didn't hear it from me though. HIPAA."
msgstr "Mais t'as rien entendu de moi, hein. Secret médical."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-1/c-4/23/c-0/31/0/s/0
msgctxt "Choix"
msgid "That's not how HIPAA works."
msgstr "Le secret médical, ça marche pas comme ça."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-1/c-4/23/c-0/31/1/s/0
msgctxt "Choix"
msgid "What's that?"
msgstr "C'est quoi, ça ?"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-1/c-4/23/c-0/31/c-1/7
msgctxt "Tony"
msgid "It's when your ass leaks."
msgstr "C'est quand t'as une fuite au cul."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-1/c-4/23/c-0/31/c-1/15
msgctxt "Tony"
msgid "My fault for using $10 words like 'incontinence.'"
msgstr "Ma faute, j'utilise des mots à dix balles comme « incontinence »."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/0
msgctxt "Tony"
msgid "Anyways, objects need somewhere bigger than this to come see me for what ails 'em."
msgstr "Bref, les objets ont besoin d'un endroit plus grand pour venir me voir quand ils ont un souci."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/8
msgctxt "Tony"
msgid "And uhhh... sometimes ol' Ton' might also wanna have \"special company\" over."
msgstr "Et euh... des fois, ce vieux Ton' voudrait aussi recevoir de la « compagnie spéciale »."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/16
msgctxt "Tony"
msgid "...you know what I'm talking about, huh?"
msgstr "...tu vois de quoi j'parle, hein ?"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/24
msgctxt "Narrator"
msgid "Tony nods, grinning smugly at you."
msgstr "Tony hoche la tête en vous adressant un sourire suffisant."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/32/s/0
msgctxt "Choix"
msgid "I have no idea what you're talking about, actually."
msgstr "En fait, je vois pas du tout de quoi tu parles."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/33/s/0
msgctxt "Choix"
msgid "Special company makes me break out in hives."
msgstr "La compagnie spéciale me donne de l'urticaire."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/34/s/0
msgctxt "Choix"
msgid "Hell yes I do."
msgstr "Et comment que je vois !"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/35/s/0
msgctxt "Choix"
msgid "Hell yeah!"
msgstr "Ouais, carrément !"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/36/s/0
msgctxt "Choix"
msgid "I guess."
msgstr "Je suppose."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-5/7
msgctxt "Tony"
msgid "Y'know... when you wanna get your screws in nice 'n tight."
msgstr "Tu vois... quand tu veux visser bien serré."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-5/15
msgctxt "Tony"
msgid "Maybe you call someone over, do a lil bakin'... fill their cannoli, you know."
msgstr "Peut-être que t'appelles quelqu'un, tu fais une p'tite pâtisserie... tu fourres son cannolo, tu vois."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-5/23/0/s/0
msgctxt "Choix"
msgid "You're making desserts?"
msgstr "Tu fais des desserts ?"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-5/23/1/s/0
msgctxt "Choix"
msgid "Your innuendo is terrible."
msgstr "Ton allusion est nulle."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-5/23/2/s/0
msgctxt "Choix"
msgid "Do hands count as special company?"
msgstr "Les mains, ça compte comme compagnie spéciale ?"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-5/23/c-0/7
msgctxt "Tony"
msgid "Oh for the love of... talkin' about smashin'! Bangin'! SEX!"
msgstr "Oh, pour l'amour du... je parle de se la jouer ! De tringler ! DU SEXE !"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-5/23/c-0/15/0/s/0
msgctxt "Choix"
msgid "Just say that next time... but no. Not doing any of that these days."
msgstr "Dis-le comme ça la prochaine fois... mais non. Je fais rien de tout ça en ce moment."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-5/23/c-1/7
msgctxt "Tony"
msgid "So's your attitude."
msgstr "Ton attitude non plus."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-5/23/c-2/7
msgctxt "Tony"
msgid "Your hands or someone else's?"
msgstr "Tes mains ou celles de quelqu'un d'autre ?"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-5/23/c-2/15/0/s/0
msgctxt "Choix"
msgid "Mine...?"
msgstr "Les miennes... ?"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-5/23/c-2/15/1/s/0
msgctxt "Choix"
msgid "Someone else's."
msgstr "Celles de quelqu'un d'autre."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-5/23/c-2/15/c-0/7
msgctxt "Narrator"
msgid "Tony places a hand on your shoulder, looking you squarely in the eyes."
msgstr "Tony pose une main sur votre épaule et vous regarde droit dans les yeux."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-5/23/c-2/15/c-0/15
msgctxt "Tony"
msgid "Listen pal, I know you been datin' five-finger fanny since middle school."
msgstr "Écoute-moi bien, je sais que tu fréquentes Madame Cinq Doigts depuis le collège."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-5/23/c-2/15/c-0/23
msgctxt "Tony"
msgid "But you gotta dream bigger."
msgstr "Mais faut voir plus grand."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-5/23/c-2/15/c-1/7
msgctxt "Tony"
msgid "Uh... well yeah. Any part'a somebody else is special company... but maybe you keep 'em in one piece, eh?"
msgstr "Euh... ouais. N'importe quelle partie de quelqu'un d'autre, c'est de la compagnie spéciale... mais peut-être que tu la gardes en un seul morceau, hein ?"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-6/7
msgctxt "Tony"
msgid "Oooo, you should really tell your partners."
msgstr "Ooooh, faudrait vraiment prévenir tes partenaires."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-6/15
msgctxt "Tony"
msgid "It's only fair that they know what they're gettin' themselves into."
msgstr "C'est juste normal qu'ils sachent dans quoi ils mettent les pieds."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-6/23/0/s/0
msgctxt "Choix"
msgid "Not <i>those</i> kind of hives!"
msgstr "Pas <i>ce</i> genre d'urticaire !"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-6/23/c-0/7
msgctxt "Tony"
msgid "Oh, hey. Oh, okay. Sorry."
msgstr "Oh, hé. Oh, d'accord. Pardon."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-6/23/c-0/15
msgctxt "Tony"
msgid "For the record ain't nothing wrong with \"those kind\" either."
msgstr "Pour info, y a rien de mal à « ce genre » non plus."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-6/23/c-0/23
msgctxt "Tony"
msgid "I mean, it just goes to show you've lived a little, am I right? Heh. Bada-bing. Heh heh. I'm not saying anything about myself."
msgstr "Je veux dire, ça prouve que t'as un peu vécu, non ? Hé hé. Ba-da-boum. Hé hé hé. Je dis rien sur moi, hein."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-2/c-7/7 tony_toolbox/second_encounter/0/g-1/c-6/7
msgctxt "Tony"
msgid "You know what I'm TALKING about!"
msgstr "Tu sais de quoi j'PARLE !"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-3/0 tony_toolbox/second_encounter/0/g-3/0
msgctxt "Tony"
msgid "You KNOW what I'm talking about!"
msgstr "Tu SAIS de quoi j'parle !"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-3/11/s/0
msgctxt "Choix"
msgid "You KNOW it buddy! AWOOOOO!"
msgstr "Tu l'as dit, mon pote ! AWOOOOO !"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-3/12/s/0
msgctxt "Choix"
msgid "Sure do."
msgstr "Et comment."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-4/0 tony_toolbox/second_encounter/0/g-4/0
msgctxt "Tony"
msgid "YOU know what I'm talking about!"
msgstr "TU sais de quoi j'parle !"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-4/11/s/0
msgctxt "Choix"
msgid "Yeah."
msgstr "Ouais."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-4/12/s/0
msgctxt "Choix"
msgid "Oh you know it you know it you know it!"
msgstr "Oh que oui, que oui, que oui !"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-5/0 tony_toolbox/second_encounter/0/g-5/0
msgctxt "Tony"
msgid "You know what I'M talking about!"
msgstr "Tu sais de quoi J'parle !"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-5/11/s/0
msgctxt "Choix"
msgid "Mhm."
msgstr "Mhm."

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-5/12/s/0
msgctxt "Choix"
msgid "All day baby all day!"
msgstr "Toute la journée, mon grand, toute la journée !"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-6/0
msgctxt "Tony"
msgid "You know what I'm talking ABOUT!!! Whoo!"
msgstr "Tu sais de quoi j'PARLE !!! Ouhou !"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-6/11/s/0
msgctxt "Choix"
msgid "I KNOW WHAT YOU'RE TALKIN' ABOUT!"
msgstr "JE SAIS DE QUOI TU PARLES !"

# Traduction IA – à relire
#: tony_toolbox/first_encounter/0/g-6/c-16/13
msgctxt "Narrator"
msgid "Tony nods at you, you nod at him, and you nod at each other, both entirely pleased that you each KNOW what the OTHER is TALKING ABOUT."
msgstr "Tony vous fait un signe de tête, vous lui en faites un, et vous hochez la tête l'un vers l'autre, parfaitement ravis de SAVOIR chacun de quoi l'AUTRE PARLE."

# Traduction IA – à relire
#: tony_toolbox/tony_talking/0/0
msgctxt "Tony"
msgid "So you get it! I need more space!"
msgstr "Donc t'as compris ! Il me faut plus de place !"

# Traduction IA – à relire
#: tony_toolbox/tony_talking/0/8
msgctxt "Tony"
msgid "Space for all sorts a things I may or may not be insinuatin'."
msgstr "De la place pour toutes sortes de trucs que je suggère peut-être, ou peut-être pas."

# Traduction IA – à relire
#: tony_toolbox/tony_talking/0/16/s/0
msgctxt "Choix"
msgid "Makes sense."
msgstr "C'est logique."

# Traduction IA – à relire
#: tony_toolbox/tony_talking/0/17/s/0
msgctxt "Choix"
msgid "What other things do you like to insinuate...?"
msgstr "Quelles autres choses aimes-tu suggérer... ?"

# Traduction IA – à relire
#: tony_toolbox/tony_talking/0/c-0/7
msgctxt "Tony"
msgid "I got a pitch for ya."
msgstr "J'ai un plan pour toi."

# Traduction IA – à relire
#: tony_toolbox/tony_talking/0/c-1/7
msgctxt "Tony"
msgid "Relax tiger, it's Tony time. I gotta pitch for ya."
msgstr "Détends-toi, c'est l'heure de Tony. J'ai un plan pour toi."

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/0
msgctxt "Tony"
msgid "So, you're telling me you don't get out there roh-mantically?"
msgstr "Alors, tu me dis que tu sors pas côté ro-mantique ?"

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/8/s/0
msgctxt "Choix"
msgid "Nope."
msgstr "Non."

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/9/s/0
msgctxt "Choix"
msgid "I have, but it's complicated."
msgstr "Si, mais c'est compliqué."

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/10/s/0
msgctxt "Choix"
msgid "Why would I? It's bleak enough out there as it is."
msgstr "Pourquoi je le ferais ? C'est déjà assez glauque dehors."

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/c-0/7
msgctxt "Tony"
msgid "Probably has to do with the look of this place."
msgstr "Ça vient probablement de l'allure de cette baraque."

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/c-1/7
msgctxt "Tony"
msgid "Ol' Tony knows complicated. But you could probably pull more partners with better digs."
msgstr "Ce vieux Tony s'y connaît en compliqué. Mais tu pourrais sûrement attirer plus de partenaires avec un meilleur logis."

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/c-2/7
msgctxt "Tony"
msgid "Yeah you would have that outlook with a place like this."
msgstr "Ouais, forcément que t'aurais cette vision-là avec un endroit pareil."

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/0/s/0
msgctxt "Choix"
msgid "What does that mean?"
msgstr "Ça veut dire quoi ?"

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/7
msgctxt "Tony"
msgid "Well, it doesn't exactly scream Randy Andy, does it?"
msgstr "Bah, ça évoque pas franchement Dédé la Braise, hein ?"

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/15
msgctxt "Tony"
msgid "A roh-mantic prospect wants to know that <i>you</i> know your way around a toolbox."
msgstr "Un prétendant ro-mantique veut savoir que <i>tu</i> sais te servir d'une boîte à outils."

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/23
msgctxt "Tony"
msgid "That you're good with your hands."
msgstr "Que t'es doué de tes mains."

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/31
msgctxt "Tony"
msgid "A fixer."
msgstr "Un réparateur."

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/39
msgctxt "Tony"
msgid "And this place ... uhhh ... it doesn't exactly show it."
msgstr "Et cet endroit... euh... ça se voit pas trop."

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/47
msgctxt "Tony"
msgid "You know what I mean?"
msgstr "Tu vois ce que j'veux dire ?"

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/55
msgctxt "Tony"
msgid "No bells, no whistles, nothing."
msgstr "Pas de fioritures, rien."

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/63/0/s/0
msgctxt "Choix"
msgid "Okay genius. What do you have in mind?"
msgstr "Très bien, génie. Qu'est-ce que tu as en tête ?"

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/63/1/s/0
msgctxt "Choix"
msgid "I don't know. I think this place is actually ok."
msgstr "Je sais pas. Je trouve que cet endroit est plutôt bien, en fait."

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/63/2/s/0
msgctxt "Choix"
msgid "I'm pretty handy. I can do it myself."
msgstr "Je me débrouille plutôt bien en bricolage. Je peux le faire moi-même."

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/63/c-1/7
msgctxt "Tony"
msgid "How about you just hear my pitch. Alright?"
msgstr "Si tu écoutais juste mon plan ? D'accord ?"

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/63/c-2/7
msgctxt "Tony"
msgid "If it goes anything like that bird bath you tried to build I can't wait to see it."
msgstr "Si c'est comme ce bain d'oiseaux que t'as essayé de construire, j'ai hâte de voir ça."

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/63/c-2/15/0/s/0
msgctxt "Choix"
msgid "Lots of architecture leans to the side!"
msgstr "Plein d'architecture penche d'un côté !"

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/63/c-2/15/1/s/0
msgctxt "Choix"
msgid "It's not my fault the birds flew in before the cement dried!"
msgstr "C'est pas ma faute si les oiseaux sont entrés avant que le ciment sèche !"

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/63/c-2/15/2/s/0
msgctxt "Choix"
msgid "The basin was supposed to leak! It was the artist's statement on the fleeting nature of WATER!"
msgstr "La vasque était censée fuir ! C'était la déclaration de l'artiste sur la nature éphémère de l'EAU !"

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/63/c-2/15/c-0/7
msgctxt "Tony"
msgid "Yeah, and lots of architecture gets condemned and demolished."
msgstr "Ouais, et plein d'architecture est condamnée et démolie."

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/63/c-2/15/c-0/15
msgctxt "Tony"
msgid "That what you want? You want a wrecking ball should come flyin' in here?"
msgstr "C'est ça que tu veux ? Tu veux qu'une boule de démolition arrive en volant ici ?"

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/63/c-2/15/c-1/7
msgctxt "Tony"
msgid "Yeah, I'd argue it was exactly your fault the birds flew in before the cement dried, but let's leave the past in the past, eh?"
msgstr "Ouais, je dirais que c'était exactement ta faute si les oiseaux sont entrés avant que le ciment sèche, mais laissons le passé où il est, hein ?"

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-0/c-3/63/c-2/15/c-2/7
msgctxt "Tony"
msgid "This ain't an art gallery, and I ain't an art dealer—so I ain't buyin' it."
msgstr "C'est pas une galerie d'art ici, et je suis pas marchand d'art, donc j'achète pas."

# Traduction IA – à relire
#: tony_toolbox/tony_2/0/g-1/0
msgctxt "Tony"
msgid "You just hear me out, ok?"
msgstr "Écoute-moi juste jusqu'au bout, ok ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch1/0/3
msgctxt "Tony"
msgid "A drawbridge."
msgstr "Un pont-levis."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch1/0/14/s/0
msgctxt "Choix"
msgid "Like from ye olden times?"
msgstr "Comme au bon vieux temps ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch1/0/c-0/7
msgctxt "Tony"
msgid "Think about it."
msgstr "Réfléchis-y."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch1/0/c-0/15
msgctxt "Tony"
msgid "Your lover pulls up for a date and the drawbridge lowers to let 'em in."
msgstr "Ton amant arrive pour un rencard et le pont-levis s'abaisse pour le laisser entrer."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch1/0/c-0/23
msgctxt "Tony"
msgid "Pretty freakin' impressive, huh?"
msgstr "Sacrément impressionnant, hein ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch1/0/c-0/31/0/s/0
msgctxt "Choix"
msgid "Back up. You know how to do that?"
msgstr "Attends. Tu sais faire ça ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch1/0/c-0/31/1/s/0
msgctxt "Choix"
msgid "That is impressive..."
msgstr "C'est impressionnant..."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch1/0/c-0/31/c-0/7
msgctxt "Tony"
msgid "Oh, yeah. Got everything I need on hand."
msgstr "Oh, ouais. J'ai tout ce qu'il me faut sous la main."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch1/0/c-0/31/c-1/7
msgctxt "Tony"
msgid "Damn straight."
msgstr "Putain, ouais."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch1/0/c-0/31/c-1/15
msgctxt "Tony"
msgid "...is how I would build it using my tools. No curves in this drawbridge."
msgstr "...c'est comme ça que je le construirais avec mes outils. Pas de courbes dans ce pont-levis."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch1/0/g-0/0
msgctxt "Tony"
msgid "The flat lookin' screwdriver, the pointy, star-shaped one, a hammer and the spearmint gum you've had in here since April."
msgstr "Le tournevis plat, le pointu en forme d'étoile, un marteau et le chewing-gum à la menthe verte que t'as laissé là depuis avril."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch1/0/g-0/8/s/0
msgctxt "Choix"
msgid "Please tell me there's a moat."
msgstr "Dis-moi qu'il y a des douves."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch1/0/g-0/9/s/0
msgctxt "Choix"
msgid "Yeah... that could definitely be a thing. Very death trappy."
msgstr "Ouais... ça pourrait carrément être un truc. Très piège mortel."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch1/0/g-0/10/s/0
msgctxt "Choix"
msgid "I don't know much about architecture, but I think this might be a bit beyond the capabilities of a toolbox."
msgstr "Je m'y connais pas trop en architecture, mais je crois que ça dépasse un peu les capacités d'une boîte à outils."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch1/0/g-0/c-1/13
msgctxt "Tony"
msgid "Absolutely! See, you get it."
msgstr "Absolument ! Tu vois, t'as compris."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch1/0/g-0/c-1/21
msgctxt "Tony"
msgid "Which leads into my next idea:"
msgstr "Ce qui nous amène à mon idée suivante :"

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch1/0/g-0/c-2/13
msgctxt "Tony"
msgid "Alright. Alright. You like it but you don't love it. I get that. How about this —"
msgstr "Bon. Bon. Ça te plaît mais t'adhères pas. J'ai compris. Et si on faisait ça —"

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch1/0/g-0/c-3/7
msgctxt "Tony"
msgid "I get it. You're a tough customer, but there's no need to get personal. At least hear the rest of my pitch, huh."
msgstr "J'ai compris. T'es un client difficile, mais pas besoin de se froisser. Écoute au moins la suite de mon plan, hein."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/3
msgctxt "Tony"
msgid "<i>Ahem</i>"
msgstr "<i>Hum hum</i>"

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/14
msgctxt "Tony"
msgid "Indoor slide."
msgstr "Toboggan d'intérieur."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/25
msgctxt "Tony"
msgid "We get rid of the stairs, replace them with a slide."
msgstr "On vire les escaliers, on les remplace par un toboggan."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/33
msgctxt "Tony"
msgid "Great to travel from upstairs to downstairs."
msgstr "Génial pour aller de l'étage au rez-de-chaussée."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/41/s/0
msgctxt "Choix"
msgid "What about going from downstairs to upstairs?"
msgstr "Et pour aller du rez-de-chaussée à l'étage ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/42/s/0
msgctxt "Choix"
msgid "What about Stella?"
msgstr "Et Stella ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-0/7
msgctxt "Tony"
msgid "Way ahead of you."
msgstr "J'ai déjà prévu le coup."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-0/15
msgctxt "Tony"
msgid "All us construction guys do this. It's an industry standard."
msgstr "Tous les gars du bâtiment font ça. C'est la norme du secteur."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-0/23
msgctxt "Tony"
msgid "You ready?"
msgstr "On y va ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-0/31/0/s/0
msgctxt "Choix"
msgid "Hit me."
msgstr "Vas-y, balance."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-0/31/c-0/7
msgctxt "Tony"
msgid "Grippy socks."
msgstr "Des chaussettes antidérapantes."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-0/31/c-0/18/0/s/0
msgctxt "Choix"
msgid "Oh, hell yeah! Can I get a ninety degree incline on the slide?"
msgstr "Oh, putain, ouais ! Je peux avoir une pente à quatre-vingt-dix degrés sur le toboggan ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-0/31/c-0/18/1/s/0
msgctxt "Choix"
msgid "Sounds super fun and not at all inconvenient. Can I sleep on it?"
msgstr "Ça a l'air super marrant et pas du tout gênant. Je peux dormir dessus ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-0/31/c-0/18/2/s/0
msgctxt "Choix"
msgid "I think our stairs might be load bearing... so I'm gonna say no."
msgstr "Je crois que notre escalier est porteur... donc je vais dire non."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-0/31/c-0/18/c-0/7
msgctxt "Tony"
msgid "It can be as steep as you want. Your house, your rules!"
msgstr "Ça peut être aussi raide que tu veux. Ta maison, tes règles !"

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-0/31/c-0/18/c-1/7
msgctxt "Tony"
msgid "Course you can. Just don't take too long. I tend to book out 6-8 weeks in advance."
msgstr "Bien sûr. Mais traîne pas trop. J'ai tendance à être complet 6 à 8 semaines à l'avance."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-0/31/c-0/18/c-2/7
msgctxt "Tony"
msgid "Alright. You're the boss. <i>(what the heck is a \"load-bearing\")</i>"
msgstr "Bon. T'es le patron. <i>(c'est quoi, un « porteur », bon sang)</i>"

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-1/7
msgctxt "Tony"
msgid "Hey, yeah she can get in on this too."
msgstr "Hé, ouais, elle peut participer aussi."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-1/15
msgctxt "Tony"
msgid "She'd become... Indora the Indoor Slide."
msgstr "Elle deviendrait... Intéria, le Toboggan d'Intérieur."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-1/23
msgctxt "Tony"
msgid "Totally fine. Changes like that happen all the time."
msgstr "Aucun souci. Des changements comme ça, ça arrive tout le temps."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-1/31
msgctxt "Tony"
msgid "You just gotta fill out a buncha boring forms."
msgstr "Faut juste remplir une tripotée de formulaires barbants."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-1/39
msgctxt "Tony"
msgid "$200 fee."
msgstr "200 $ de frais."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-1/47/0/s/0
msgctxt "Choix"
msgid "Sounds good."
msgstr "Ça me va."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-1/47/1/s/0
msgctxt "Choix"
msgid "I have to pass."
msgstr "Je passe mon tour."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-1/47/c-0/7
msgctxt "Tony"
msgid "But wait there's more..."
msgstr "Mais attends, c'est pas fini..."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/c-1/47/c-1/7
msgctxt "Tony"
msgid "Sure, of course, yeah, because an indoor slide would be ridiculous."
msgstr "Bien sûr, évidemment, ouais, parce qu'un toboggan d'intérieur, ce serait ridicule."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/3
msgctxt "Tony"
msgid "Now... how do you feel about indoor pools?"
msgstr "Alors... que penses-tu des piscines d'intérieur ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/11
msgctxt "Tony"
msgid "Because if we rip out the floor in the living room, we can get you an indoor pool."
msgstr "Parce que si on arrache le sol du salon, on peut te faire une piscine d'intérieur."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/19/s/0
msgctxt "Choix"
msgid "Is that safe? I feel like that's a recipe for electrocution."
msgstr "C'est sans danger ? J'ai l'impression que c'est la recette parfaite pour l'électrocution."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/20/s/0
msgctxt "Choix"
msgid "I'm in! Let's do it!"
msgstr "Je suis partant ! Allons-y !"

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-2/7
msgctxt "Tony"
msgid "Course it is, but that's what the chewing gum is for."
msgstr "Bien sûr que oui, mais c'est à ça que sert le chewing-gum."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-2/15
msgctxt "Tony"
msgid "You just stick some of it in the outlet holes and viola, it's now all shockproof."
msgstr "Tu colles un peu de gomme dans les trous des prises et voilà, c'est à l'épreuve des chocs."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-2/23
msgctxt "Tony"
msgid "That concludes my remodeling advice."
msgstr "Ça conclut mes conseils de rénovation."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-2/31
msgctxt "Tony"
msgid "Now for the actual dating advice, you'll just have to sign up for my workshop."
msgstr "Pour les vrais conseils de drague, faudra t'inscrire à mon atelier."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-2/39/0/s/0
msgctxt "Choix"
msgid "I hope there'll be a hands-on demonstration."
msgstr "J'espère qu'il y aura une démonstration pratique."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-2/39/1/s/0
msgctxt "Choix"
msgid "Workshop? Sounds expensive."
msgstr "Un atelier ? Ça sent la dépense."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-2/39/2/s/0
msgctxt "Choix"
msgid "You must really know your stuff."
msgstr "Tu dois vraiment t'y connaître."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-2/39/c-0/13
msgctxt "Tony"
msgid "Oh you better believe it."
msgstr "Oh, tu peux me croire."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-2/39/c-0/21
msgctxt "Tony"
msgid "I'll be payin' real close attention... so you better make sure you're takin' notes."
msgstr "Je vais y regarder de très près... alors t'as intérêt à prendre des notes."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-2/39/c-1/13
msgctxt "Tony"
msgid "C'man, I'm givin' it to ya for free."
msgstr "Allez, je te le donne gratuit."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-2/39/c-1/21
msgctxt "Tony"
msgid "Everybody's a critic..."
msgstr "Tout le monde est critique..."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-2/39/c-2/13
msgctxt "Tony"
msgid "'Course I do. And lucky you, you're gonna get to know my stuff too."
msgstr "Bien sûr que oui. Et t'as de la chance, toi aussi tu vas apprendre à connaître mes affaires."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-3/7
msgctxt "Tony"
msgid "Eyyyy!"
msgstr "Eyyyy !"

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-3/15
msgctxt "Tony"
msgid "Lemme get the permits goin', see if I can get my best tools on the job."
msgstr "Laisse-moi lancer les permis, voir si je peux mettre mes meilleurs outils sur le coup."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-3/23
msgctxt "Tony"
msgid "Hammer's availability has been SHOT ever since... the incident."
msgstr "Les dispos de Marteau sont FOUTUES depuis... l'incident."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-3/31/0/s/0 tony_toolbox/Tony_Pitch2/0/g-0/c-3/31/c-0/31/0/s/0
msgctxt "Choix"
msgid "What incident?"
msgstr "Quel incident ?"

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-3/31/c-0/7
msgctxt "Narrator"
msgid "Tony slides past your question without skipping a beat."
msgstr "Tony esquive votre question sans sourciller."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-3/31/c-0/15
msgctxt "Tony"
msgid "Anyway that's enough about that guy. Let me tell you about my best-sellin' workshop."
msgstr "Bref, assez parlé de ce type. Laisse-moi te parler de mon atelier best-seller."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-3/31/c-0/23
msgctxt "Tony"
msgid "It's a workshop about lovin'."
msgstr "C'est un atelier sur l'amour."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-3/31/c-0/31/1/s/0
msgctxt "Choix"
msgid "Okay... tell me more."
msgstr "D'accord... dis-m'en plus."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-0/c-3/31/c-0/31/c-0/7
msgctxt "Narrator"
msgid "You might as well have said absolutely nothing—Tony doesn't budge from his sales pitch."
msgstr "Vous auriez tout aussi bien pu ne rien dire du tout, Tony ne démord pas de son argumentaire."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-1/3
msgctxt "Tony"
msgid "I'm gonna make it real easy for ya."
msgstr "Je vais te faciliter la vie."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-1/11
msgctxt "Tony"
msgid "You wanna take my workshop all's you gotta do is show up. No paperwork or nothin'."
msgstr "Tu veux suivre mon atelier, tout ce que t'as à faire, c'est te pointer. Pas de paperasse ni rien."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-1/19
msgctxt "Tony"
msgid "Now, I don't mean to hustle you outta here, but I gotta take lunch."
msgstr "Bon, je veux pas te presser de partir, mais faut que j'aille déjeuner."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-1/27
msgctxt "Tony"
msgid "Union rules."
msgstr "Règles du syndicat."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-1/35
msgctxt "Tony"
msgid "But you come back later and we'll see what we can do."
msgstr "Mais repasse plus tard et on verra ce qu'on peut faire."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-1/43
msgctxt "Tony"
msgid "Y'know, help you fix up your roh-mantic affairs."
msgstr "Tu sais, t'aider à arranger tes affaires ro-mantiques."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-1/51/s/0
msgctxt "Choix"
msgid "You will not make me a project, Tony."
msgstr "Tu ne feras pas de moi un projet, Tony."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-1/52/s/0
msgctxt "Choix"
msgid "All right you old so 'n so."
msgstr "Très bien, vieux machin."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-1/c-4/7
msgctxt "Tony"
msgid "Who, me? Never."
msgstr "Qui, moi ? Jamais."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-1/c-4/15
msgctxt "Tony"
msgid "Now, get outta here before a crane hits you in the face."
msgstr "Allez, dégage avant qu'une grue te cogne en pleine figure."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-1/c-4/23/0/s/0
msgctxt "Choix"
msgid "I should be so lucky."
msgstr "J'aurais de la chance."

# Traduction IA – à relire
#: tony_toolbox/Tony_Pitch2/0/g-1/c-5/7
msgctxt "Tony"
msgid "See you around."
msgstr "À plus."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/9
msgctxt "Tony"
msgid "All right. You ready for your first workshop?"
msgstr "Bon. On passe à ton premier atelier ?"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/17/s/0
msgctxt "Choix"
msgid "I still don't understand why you're qualified to give relationship advice."
msgstr "Je ne comprends toujours pas ce qui te qualifie pour donner des conseils sur les relations."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/18/s/0
msgctxt "Choix"
msgid "I'm ready!"
msgstr "Allons-y !"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/7
msgctxt "Tony"
msgid "The way I see it, building a relationship's no different from building, well ... anything."
msgstr "Comme je vois les choses, construire une relation, c'est pas différent de construire, euh... n'importe quoi."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/15
msgctxt "Tony"
msgid "And seeing how I'm a master builder..."
msgstr "Et vu que je suis un maître bricoleur..."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/0/s/0
msgctxt "Choix"
msgid "More like a master baiter."
msgstr "Plutôt un maître branleur."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-0/7 tony_toolbox/second_encounter/0/c-0/23/c-1/13
msgctxt "Tony"
msgid "What?"
msgstr "Quoi ?"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-0/15/0/s/0
msgctxt "Choix"
msgid "What?"
msgstr "Quoi ?"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-0/15/c-0/7
msgctxt "Tony"
msgid "You callin' me a jerk-off?"
msgstr "Tu me traites de branleur ?"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "What? No. You just teed it up too perfectly."
msgstr "Quoi ? Non. Tu me l'as juste servi sur un plateau."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-0/15/c-0/15/c-0/7
msgctxt "Tony"
msgid "Okay..."
msgstr "Ok..."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-0/15/c-0/15/c-0/15
msgctxt "Tony"
msgid "Anyway I'm qualified just fine."
msgstr "Enfin bref, je suis très bien qualifié."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-1/21/0/s/0
msgctxt "Choix"
msgid "I'm not gonna say it."
msgstr "Je ne vais pas le dire."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-1/21/c-0/7
msgctxt "Tony"
msgid "Whatever."
msgstr "Peu importe."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-1/21/c-0/15
msgctxt "Tony"
msgid "I'm qualified just fine."
msgstr "Je suis très bien qualifié."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-1/21/c-0/23/0/s/0
msgctxt "Choix"
msgid "You're a tool box, Tony. Which means you only know as much as I do."
msgstr "T'es une boîte à outils, Tony. Ce qui veut dire que t'en sais autant que moi."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-1/21/c-0/23/c-0/7
msgctxt "Tony"
msgid "Ehhh, I gotta disagree."
msgstr "Ehhh, je suis pas d'accord."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-1/21/c-0/23/c-0/15
msgctxt "Tony"
msgid "You forget I studied under Greg. The contractor."
msgstr "T'oublies que j'ai étudié sous Greg. L'entrepreneur."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-1/21/c-0/23/c-0/23/0/s/0 tony_toolbox/Tony_LoveAdvice/0/g-0/9/s/0
msgctxt "Choix"
msgid "Who?"
msgstr "Qui ?"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-1/21/c-0/23/c-0/23/c-0/7
msgctxt "Tony"
msgid "Yeah, you know the guy ... you brought him in to spiff up the joint after we moved in."
msgstr "Ouais, tu vois le gars... tu l'as fait venir pour retaper la baraque après qu'on a emménagé."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-1/21/c-0/23/c-0/23/c-0/15/0/s/0
msgctxt "Choix"
msgid "You don't mean Greg from Gregslist!"
msgstr "Tu parles pas de Greg de Gregslist !"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-1/21/c-0/23/c-0/23/c-0/15/c-0/7
msgctxt "Tony"
msgid "That's the one!"
msgstr "C'est lui !"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-1/21/c-0/23/c-0/23/c-0/15/c-0/15
msgctxt "Tony"
msgid "He took me all around the house that week."
msgstr "Il m'a trimballé dans toute la maison cette semaine-là."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-1/21/c-0/23/c-0/23/c-0/15/c-0/23
msgctxt "Tony"
msgid "Taught me everything I know."
msgstr "M'a appris tout ce que je sais."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-1/21/c-0/23/c-0/23/c-0/15/c-0/31/0/s/0
msgctxt "Choix"
msgid "That man was not a contractor. I literally paid him in deli meat. Per his request."
msgstr "Ce type n'était pas entrepreneur. Je l'ai littéralement payé en charcuterie. À sa demande."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-1/21/c-0/23/c-0/23/c-0/15/c-0/31/1/s/0
msgctxt "Choix"
msgid "I guess that makes sense."
msgstr "Je suppose que ça se tient."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-1/21/c-0/23/c-0/23/c-0/15/c-0/31/c-0/7
msgctxt "Tony"
msgid "Well, you got a scream of a deal. He really knew his stuff."
msgstr "Bah, t'as fait une affaire à hurler. Il s'y connaissait vraiment."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-1/21/c-0/23/c-0/23/c-0/15/c-0/31/c-0/15/0/s/0
msgctxt "Choix"
msgid "Alright, then. Blow me away."
msgstr "Très bien, alors. Épate-moi."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-0/23/c-1/21/c-0/23/c-0/23/c-0/15/c-0/31/c-1/7
msgctxt "Tony"
msgid "'Course it does. I learned from the best and now I'm givin' you the best!"
msgstr "Bien sûr que oui. J'ai appris des meilleurs et maintenant je te donne le meilleur !"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-1/7
msgctxt "Tony"
msgid "That's what I'm talking about! Alright, come to the job site prepared and with a can-do attitude."
msgstr "C'est de ça que je parle ! Bon, viens sur le chantier préparé et avec la niaque."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "I just want to impress you is all."
msgstr "Je veux juste t'impressionner, c'est tout."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-1/15/1/s/0
msgctxt "Choix"
msgid "I like getting the job done."
msgstr "J'aime que le boulot soit fait."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/c-1/15/c-0/7
msgctxt "Tony"
msgid "Heh. It's working."
msgstr "Hé. Ça marche."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-0/0
msgctxt "Tony"
msgid "A good job is never done."
msgstr "Un bon boulot est jamais fini."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-0/8
msgctxt "Tony"
msgid "Unless it's done-zo."
msgstr "Sauf s'il est fini-zo."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-0/16
msgctxt "Tony"
msgid "You ever heard of done-zo?"
msgstr "T'as déjà entendu parler du fini-zo ?"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-0/25/s/0
msgctxt "Choix"
msgid "No, wuzzat?"
msgstr "Non, c'est quoi ?"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-0/26/s/0
msgctxt "Choix"
msgid "Tell me, oh wise one."
msgstr "Dis-moi, ô sage."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-1/0
msgctxt "Tony"
msgid "One step ABOVE done. The ultimate done."
msgstr "Une étape AU-DESSUS de fini. Le fini ultime."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-1/8
msgctxt "Tony"
msgid "Be careful though, I knew a screw who had a little too much done-zo if you know what I'm talkin' about."
msgstr "Fais gaffe quand même, j'ai connu une vis qui avait pris un peu trop de fini-zo, si tu vois ce que j'veux dire."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-1/16
msgctxt "Narrator"
msgid "Tony grins, flashing you a pair of finger guns as he waggles his eyebrows at you."
msgstr "Tony sourit, vous adresse deux pistolets avec les doigts et remue les sourcils."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-1/24/s/0
msgctxt "Choix"
msgid "I'm not doing this."
msgstr "Je ne fais pas ça."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-1/25/s/0
msgctxt "Choix"
msgid "Oh I KNOW what you're talkin' about."
msgstr "Oh, je SAIS de quoi tu parles."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-2/0/s/0
msgctxt "Choix"
msgid "Oh you know I know, baby!"
msgstr "Oh, tu sais que je sais, chéri !"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-2/1/s/0
msgctxt "Choix"
msgid "Yeah, and that's all that needs to be said about it."
msgstr "Ouais, et c'est tout ce qu'il y a à en dire."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-3/11/s/0
msgctxt "Choix"
msgid "I KNOW what you're talkin' about!"
msgstr "Je SAIS de quoi tu parles !"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-3/12/s/0
msgctxt "Choix"
msgid "Yes, very much so. Quite."
msgstr "Oui, tout à fait. Parfaitement."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-4/11/s/0
msgctxt "Choix"
msgid "Feels like the premise is well-established now."
msgstr "J'ai l'impression que le principe est bien établi, maintenant."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-4/12/s/0
msgctxt "Choix"
msgid "Oh I know. I KNOW!"
msgstr "Oh je sais. Je SAIS !"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-5/11/s/0
msgctxt "Choix"
msgid "I think the entire house knows at this point."
msgstr "Je crois que toute la maison est au courant à ce stade."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-5/12/s/0
msgctxt "Choix"
msgid "I know what I know, and baby, I KNOW what you're TALKIN' ABOUT!"
msgstr "Je sais ce que je sais, et chéri, je SAIS de quoi tu PARLES !"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-6/0
msgctxt "Tony"
msgid "You know what I'm talking ABOUT!!!"
msgstr "Tu sais de quoi j'PARLE !!!"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-6/17/s/0
msgctxt "Choix"
msgid "I KNOW IT AND YOU KNOW IT!"
msgstr "JE LE SAIS ET TU LE SAIS !"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-6/c-15/7
msgctxt "Tony"
msgid "AYYYY!"
msgstr "AYYYY !"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-6/c-15/18/0/s/0
msgctxt "Choix"
msgid "AYYYY!"
msgstr "AYYYY !"

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-6/c-15/18/c-0/7
msgctxt "Narrator"
msgid "Tony beams at you, validated by your admission that you KNOW what he's TALKIN' ABOUT."
msgstr "Tony vous sourit de toutes ses dents, conforté par votre aveu que vous SAVEZ de quoi il PARLE."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-6/c-15/18/c-0/15
msgctxt "Tony"
msgid "Me 'n you? Same page. But since I got integrity as a workshop instructor 'n whatnot..."
msgstr "Toi et moi ? Sur la même longueur d'onde. Mais comme j'ai de l'intégrité en tant que formateur et tout..."

# Traduction IA – à relire
#: tony_toolbox/second_encounter/0/g-6/c-15/18/c-0/23
msgctxt "Tony"
msgid "I'm just gonna pretend you don't know shit about shit and start at square one. Capiche?"
msgstr "Je vais faire comme si t'y connaissais que dalle et repartir de zéro. Capiche ?"

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/0
msgctxt "Tony"
msgid "First thing's first: In a courtship as on a job site, you wanna look busy."
msgstr "Première chose : dans la séduction comme sur un chantier, faut avoir l'air occupé."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/8
msgctxt "Tony"
msgid "You don't gotta be doin' nothin', you just gotta look it."
msgstr "Faut pas faire quoi que ce soit, juste en avoir l'air."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/16/s/0
msgctxt "Choix"
msgid "Are you telling me that's what Greg was doing?!"
msgstr "Tu es en train de me dire que c'est ce que faisait Greg ?!"

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/17/s/0
msgctxt "Choix"
msgid "Wouldn't it be easier to just talk to whoever you're trying to impress?"
msgstr "Ce ne serait pas plus simple de parler à la personne qu'on veut impressionner ?"

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/18/s/0 tony_toolbox/workshop_tony_start/0/c-0/23/1/s/0 tony_toolbox/workshop_tony_start/0/g-0/8/s/0 tony_toolbox/workshop_tony_start/0/g-1/9/s/0 tony_toolbox/workshop_tony_start/0/g-4/29/s/0 tony_toolbox/third_encounter/0/g-2/13/10/s/0
msgctxt "Choix"
msgid "<i>Take detailed notes with look of intense concentration.</i>"
msgstr "<i>Prendre des notes détaillées avec un air de concentration intense.</i>"

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-0/7
msgctxt "Tony"
msgid "That's neither here nor there."
msgstr "Là n'est pas la question."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-0/15
msgctxt "Tony"
msgid "Point is, it makes you look good."
msgstr "L'important, c'est que ça te met en valeur."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-0/23/0/s/0
msgctxt "Choix"
msgid "Hm."
msgstr "Hm."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-0/23/c-1/13
msgctxt "Tony"
msgid "That's the spirit."
msgstr "C'est ça, l'esprit."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-0/23/g-0/0
msgctxt "Tony"
msgid "Take this for example: The other day I was fixin' somethin' in the other closet."
msgstr "Prends cet exemple : l'autre jour, je réparais un truc dans l'autre placard."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-0/23/g-0/8
msgctxt "Tony"
msgid "I wasn't DOIN' nothin', but I damn sure looked like I was."
msgstr "Je FAISAIS rien du tout, mais putain, j'avais l'air de bosser."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-0/23/g-0/16
msgctxt "Tony"
msgid "I just carried a sack 'a nuts around the job site for 2 hours."
msgstr "J'ai juste trimballé un sac d'écrous sur le chantier pendant 2 heures."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-0/23/g-0/24
msgctxt "Tony"
msgid "Makes your muscles look real good."
msgstr "Ça met drôlement bien tes muscles en valeur."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-1/7
msgctxt "Tony"
msgid "Uhhh no?"
msgstr "Euh non ?"

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-1/15
msgctxt "Tony"
msgid "Come on, you think I gotta do much talking when I walk around lookin' like this? Check out this toolbelt."
msgstr "Allez, tu crois que j'ai besoin de beaucoup parler quand je me balade avec cette gueule ? Regarde-moi cette ceinture à outils."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-1/26
msgctxt "Tony"
msgid "Folks dig the construction thing."
msgstr "Les gens adorent le côté chantier."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-1/34/0/s/0
msgctxt "Choix"
msgid "Mmm, that belt's packing some serious heat."
msgstr "Mmm, cette ceinture, elle envoie du lourd."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-1/34/1/s/0
msgctxt "Choix"
msgid "You just have so much charm, you know? Why waste it?"
msgstr "T'as tellement de charme, tu sais ? Pourquoi le gâcher ?"

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-1/34/2/s/0
msgctxt "Choix"
msgid "Gross."
msgstr "Beurk."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-1/34/c-0/13
msgctxt "Tony"
msgid "Glad you noticed."
msgstr "Content que tu l'aies remarqué."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-1/34/c-1/7
msgctxt "Tony"
msgid "I ain't wastin' it! Just savin' my energy."
msgstr "Je le gâche pas ! J'économise mon énergie."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-1/34/c-1/15
msgctxt "Tony"
msgid "That's energy I can use to carry heavy things and look busy."
msgstr "Cette énergie, je peux l'utiliser pour porter des trucs lourds et avoir l'air occupé."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-1/34/c-2/13
msgctxt "Tony"
msgid "Gross? That ain't no way to talk to the man who's schoolin' you."
msgstr "Beurk ? On parle pas comme ça à l'homme qui t'instruit."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-1/34/c-2/21
msgctxt "Tony"
msgid "I'm sharin' some absolute jewels here. Real pearls of wisdom."
msgstr "Je te livre de vrais joyaux, là. De vraies perles de sagesse."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-1/34/g-0/0
msgctxt "Tony"
msgid "Anyway I'm gettin' off-track."
msgstr "Enfin bref, je m'égare."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/c-2/13
msgctxt "Tony"
msgid "Ahhh... the sweet sounds of education."
msgstr "Ahhh... le doux son de l'éducation."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-0/0
msgctxt "Tony"
msgid "Lesson number 2!"
msgstr "Leçon numéro 2 !"

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-0/9/s/0
msgctxt "Choix"
msgid "Greg help us..."
msgstr "Que Greg nous vienne en aide..."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-0/c-3/13
msgctxt "Tony"
msgid "You just wrote down 'Lesson number 2'?"
msgstr "Tu viens d'écrire « Leçon numéro 2 » ?"

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-0/c-3/21/0/s/0
msgctxt "Choix"
msgid "<i>Nod furiously</i>"
msgstr "<i>Hocher la tête avec frénésie</i>"

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-0/c-3/21/c-0/13
msgctxt "Tony"
msgid "Wow. Commitment."
msgstr "Wow. L'engagement."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-1/0
msgctxt "Tony"
msgid "It's what's on the outside that counts."
msgstr "C'est ce qu'il y a à l'extérieur qui compte."

# Traduction IA – à relire
#: tony_toolbox/workshop_tony_start/0/g-1/8/s/0
msgctxt "Choix"
msgid "Really? That's not what I've heard..."
msgstr "Vraiment ? Ce n'est pas ce que j'ai entendu..."

# Traduction IA – à relire
