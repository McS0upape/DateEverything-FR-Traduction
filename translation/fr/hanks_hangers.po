msgstr "Hahahah, poto, t'es <i>MOU</i> !!"

# Traduction IA – à relire
#: hanks_hangers/hanks_realized/0/89
msgctxt "Hank 2"
msgid "Bro, <i>you're</i> squishy!!"
msgstr "Poto, c'est <i>toi</i> qui es mou !!"

# Traduction IA – à relire
#: hanks_hangers/hanks_realized/0/97
msgctxt "Hank 4"
msgid "OMG bro, I totally get it now! Why humans are so scared of extreme sports!"
msgstr "OMG poto, je comprends tout maintenant ! Pourquoi les humains ont si peur des sports extrêmes !"

# Traduction IA – à relire
#: hanks_hangers/hanks_realized/0/105
msgctxt "Hank 1"
msgid "Totally!! If your chute didn't deploy in <i>this</i> body it would be MAD BAD!"
msgstr "Carrément !! Si ton parachute s'ouvrait pas dans <i>ce</i> corps, ce serait TROP GRAVE !"

# Traduction IA – à relire
#: hanks_hangers/hanks_realized/0/113
msgctxt "Hanks"
msgid "MAD BAD!!!! HAHAHAHAHAHAH!!!!"
msgstr "TROP GRAVE !!!! HAHAHAHAHAHAH !!!!"

# Traduction IA – à relire
#: hanks_hangers/hanks_realized/0/151
