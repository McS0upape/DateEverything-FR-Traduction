# Traduction IA – à relire
#: jacques_ship/1
msgctxt "Tag Nom d'objet (MAJUSCULES)"
msgid "SHIP-IN-A-BOTTLE"
msgstr "NAVIRE EN BOUTEILLE"

# Traduction IA – à relire
#: jacques_ship/abel_jacques/0/0
msgctxt "Jacques"
msgid "You want a story about a table?"
msgstr "Tu veux une histoire sur une table ?"

# Traduction IA – à relire
#: jacques_ship/abel_jacques/0/8
msgctxt "Jacques"
msgid "I am a table. I am boring. The end."
msgstr "Je suis une table. Je suis ennuyeux. Fin."

# Traduction IA – à relire
#: jacques_ship/abel_jacques/0/16/s/0
msgctxt "Choix"
msgid "That's it? I've been on this fetch quest for forever."
msgstr "C'est tout ? Je suis sur cette quête de livraison depuis des siècles."

# Traduction IA – à relire
#: jacques_ship/abel_jacques/0/17/s/0
msgctxt "Choix"
msgid "Sounds about right."
msgstr "Ça me paraît cohérent."

# Traduction IA – à relire
#: jacques_ship/abel_jacques/0/g-0/0
msgctxt "Jacques"
msgid "That's right."
msgstr "Exactement."

# Traduction IA – à relire
#: jacques_ship/abel_jacques/0/g-0/8
msgctxt "Jacques"
msgid "Thinks he can hide his little crush for the big desk."
msgstr "Il croit pouvoir cacher son petit béguin pour le grand bureau."

# Traduction IA – à relire
#: jacques_ship/abel_jacques/0/g-0/16
msgctxt "Jacques"
msgid "Pish."
msgstr "Peuh."

# Traduction IA – à relire
#: jacques_ship/abel_jacques/0/g-0/24/s/0
msgctxt "Choix"
msgid "What's that now?"
msgstr "Pardon, quoi ?"

# Traduction IA – à relire
#: jacques_ship/abel_jacques/0/g-0/c-2/7
msgctxt "Jacques"
msgid "I said 'pish'."
msgstr "J'ai dit « peuh »."

# Traduction IA – à relire
#: jacques_ship/abel_jacques/0/g-0/c-2/15
msgctxt "Jacques"
msgid "Good day."
msgstr "Bonne journée."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/6
msgctxt "Narrator"
msgid "A petite pirate glares at you—there's so much to take in here, but you don't dare to get a good look in when he looks like he's contemplating running you through."
msgstr "Un minuscule pirate vous fusille du regard. Il y a tant à observer ici, mais vous n'osez pas le dévisager alors qu'il a l'air de songer à vous passer par le fil de l'épée."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/21
msgctxt "Jacques"
msgid "Oh, look. It's you. Come to make fun, have you?"
msgstr "Oh, tiens. C'est toi. Tu viens te moquer, c'est ça ?"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/29/s/0
msgctxt "Choix"
msgid "Make fun of who?"
msgstr "Me moquer de qui ?"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/30/s/0
msgctxt "Choix"
msgid "Yep, that's my plan!"
msgstr "Oui, c'est mon plan !"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/31/s/0
msgctxt "Choix"
msgid "Startin' off well, I see."
msgstr "Ça commence bien, je vois."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/c-0/7
msgctxt "Jacques"
msgid "WHO ELSE D'YE SEE?"
msgstr "DE QUI D'AUTRE, SELON TOI ?"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/c-1/7
msgctxt "Jacques"
msgid "Well, go ahead, you scallywag. Do you think I haven't heard it?"
msgstr "Eh bien, vas-y, canaille. Tu crois que je ne l'ai pas déjà entendue, celle-là ?"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/0
msgctxt "Jacques"
msgid "Do you legitimately imagine anything that cascaded out of that brobdingnagian mouth of yours could shock me?"
msgstr "Imagines-tu sincèrement que quoi que ce soit de ce qui a dégringolé de ta bouche pantagruélique puisse me choquer ?"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/8
msgctxt "Jacques"
msgid "DO YOU HONESTLY BELIEVE I CAN BE SHOCKED??"
msgstr "CROIS-TU VRAIMENT QUE JE PUISSE ÊTRE CHOQUÉ ??"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/16/s/0
msgctxt "Choix"
msgid "...whoa."
msgstr "...waouh."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/17/s/0
msgctxt "Choix"
msgid "Brobdingnagian?"
msgstr "Pantagruélique ?"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/18/s/0
msgctxt "Choix"
msgid "You look shocked to me!"
msgstr "Tu as l'air choqué, pourtant !"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/19/s/0
msgctxt "Choix"
msgid "Don't know don't care. You are a little much."
msgstr "Je ne sais pas, je m'en fiche. Tu en fais un peu trop."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-3/7
msgctxt "Jacques"
msgid "Yes. Yes, my newest neophyte... I am whoa."
msgstr "Oui. Oui, mon tout nouveau néophyte... je suis waouh."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-3/15
msgctxt "Jacques"
msgid "I am very whoa, whoa of the deepest and most terrible kind..."
msgstr "Je suis très waouh, waouh de la plus profonde et de la plus terrible espèce..."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-3/23
msgctxt "Jacques"
msgid "I am WOE! Woe unto mine enemies!"
msgstr "Je suis MALHEUR ! Malheur à mes ennemis !"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-4/7
msgctxt "Jacques"
msgid "You see? I told you. I cannot be shocked."
msgstr "Tu vois ? Je te l'avais dit. On ne peut pas me choquer."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-4/15
msgctxt "Jacques"
msgid "Of course you've not heard a word as long and treacherously spelled as 'brobdingnagian'."
msgstr "Bien sûr que tu n'as jamais entendu un mot aussi long et traîtreusement orthographié que « pantagruélique »."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-4/23
msgctxt "Jacques"
msgid "This does not shock me."
msgstr "Cela ne me choque pas."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-4/31
msgctxt "Jacques"
msgid "It... disappoints me. I am..."
msgstr "Cela me... déçoit. Je suis..."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-4/39
msgctxt "Jacques"
msgid "Sails above, I haven't the word..."
msgstr "Sabords, les mots me manquent..."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-4/47/0/s/0
msgctxt "Choix"
msgid "Bummed?"
msgstr "Sur le cul ?"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-4/47/1/s/0
msgctxt "Choix"
msgid "Woeful?"
msgstr "Affligé ?"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-4/47/2/s/0
msgctxt "Choix"
msgid "Lacrimose?"
msgstr "Lacrymal ?"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-4/47/c-0/7
msgctxt "Jacques"
msgid "Bummed. No, I don't think bummed is it."
msgstr "Sur le cul. Non, je ne crois pas que ce soit ça."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-4/47/c-0/15
msgctxt "Jacques"
msgid "I am clearly not any more or less characterized by my rear end because of your appallingly underwhelming level of literacy."
msgstr "Je ne suis assurément ni plus ni moins défini par mon postérieur à cause de ton niveau de lecture affligeant."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-4/47/c-0/23
msgctxt "Jacques"
msgid "Your idiocy ignites the fires in me, the fires of rage, the fires of battle!"
msgstr "Ton idiotie allume en moi des brasiers, les brasiers de la rage, les brasiers du combat !"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-4/47/c-1/7
msgctxt "Jacques"
msgid "Woeful! Woeful indeed. Full of the Woe I inflict on any enemy, every landlubbing bilge-sucker foolish enough to cross me path!"
msgstr "Affligé ! Affligé en effet ! Plein du Malheur que j'inflige à tout ennemi, à chaque rat de cale terrien assez stupide pour croiser ma route !"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-4/47/c-2/7
msgctxt "Jacques"
msgid "Ahhh... you must've owned a dictionary as a child."
msgstr "Ahhh... tu as dû posséder un dictionnaire, enfant."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-4/47/c-2/15
msgctxt "Jacques"
msgid "But what am I talking about, of course you did."
msgstr "Mais que dis-je, évidemment que oui."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-4/47/c-2/23
msgctxt "Jacques"
msgid "It's the dusty and disused hunk of former tree sitting on the shelf just east of my bottle."
msgstr "C'est ce bloc d'ancien arbre poussiéreux et délaissé, sur l'étagère juste à l'est de ma bouteille."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-4/47/c-2/31
msgctxt "Jacques"
msgid "Don't use it much. Do you."
msgstr "Tu ne t'en sers guère. N'est-ce pas."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-4/47/c-2/39/0/s/0
msgctxt "Choix"
msgid "I mean, not as much as I used to..."
msgstr "Enfin, moins qu'avant..."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-4/47/c-2/39/1/s/0
msgctxt "Choix"
msgid "I look up stuff from time to time!"
msgstr "Je cherche des trucs de temps en temps !"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-4/47/c-2/39/c-0/7
msgctxt "Jacques"
msgid "Not at all, more like, you ship-jumping rat!"
msgstr "Pas du tout, plutôt, espèce de rat qui quitte le navire !"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-4/47/c-2/39/c-1/7
msgctxt "Jacques"
msgid "Oh do you?"
msgstr "Ah oui, vraiment ?"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-4/47/c-2/39/c-1/15
msgctxt "Jacques"
msgid "Up your own arse I bet!"
msgstr "Dans ton postérieur, je parie !"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-4/47/c-2/39/g-0/0/0/s/0
msgctxt "Choix"
msgid "Hey, you wanna cool down a little bit?"
msgstr "Hé, tu ne voudrais pas te calmer un peu ?"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-4/47/c-2/39/g-0/0/c-0/7
msgctxt "Jacques"
msgid "Never! I am never cool. I am fire. I am boiling oil, I am lava!"
msgstr "Jamais ! Je ne suis jamais calme. Je suis le feu. Je suis l'huile bouillante, je suis la lave !"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-4/47/c-2/39/g-0/0/c-0/15
msgctxt "Jacques"
msgid "And I am infinitely smarter and more fearsome than you."
msgstr "Et je suis infiniment plus intelligent et plus redoutable que toi."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-4/47/c-2/39/g-0/0/c-0/23
msgctxt "Jacques"
msgid "You... hornswaggling snail."
msgstr "Toi... escargot enjôleur."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-4/47/c-2/39/g-0/0/c-0/31/0/s/0
msgctxt "Choix"
msgid "You wanna fight, right? Let's do it."
msgstr "Tu veux te battre, c'est ça ? Allons-y."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-4/47/c-2/39/g-0/0/c-0/31/1/s/0
msgctxt "Choix"
msgid "Are we fighting or falling in love?"
msgstr "On se bat ou on tombe amoureux ?"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-4/47/c-2/39/g-0/0/c-0/31/c-1/7
msgctxt "Jacques"
msgid "Perhaps a little bit of both!"
msgstr "Un peu des deux, peut-être !"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-5/7
msgctxt "Jacques"
msgid "I am emotionally quite contained! In fact, one could say I am quite bottled up!"
msgstr "Je suis émotionnellement fort bien contenu ! On pourrait même dire que je suis fort embouteillé !"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-5/15
msgctxt "Jacques"
msgid "Trapped within tubular glassy confines..."
msgstr "Prisonnier de confins tubulaires et vitreux..."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-5/23/0/s/0
msgctxt "Choix"
msgid "Well, what would you like to be doing instead?"
msgstr "Bon, et qu'aimerais-tu faire à la place ?"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-5/23/1/s/0
msgctxt "Choix"
msgid "You saying want me to bring more spice to this burrito?"
msgstr "Tu veux dire qu'il faut que j'ajoute du piment à ce burrito ?"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-5/23/c-0/7
msgctxt "Jacques"
msgid "Hunting. I would like to be questing, I would like to find an enemy."
msgstr "Chasser. J'aimerais partir en quête, j'aimerais trouver un ennemi."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-5/23/c-0/15
msgctxt "Jacques"
msgid "I would like to pin said enemy down. I would like to blast my cannon with its glorious, deafening, bone-rattling crack..."
msgstr "J'aimerais clouer ledit ennemi sur place. J'aimerais faire tonner mon canon, avec sa détonation glorieuse, assourdissante, à vous briser les os..."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-5/23/c-0/23
msgctxt "Jacques"
msgid "Blow them off the face of the Earth and watch the decimated corpse of their ship bubble helplessly beneath the gleaming main!"
msgstr "Les rayer de la surface de la Terre et regarder la carcasse décimée de leur navire bouillonner, impuissante, sous la mer étincelante !"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-5/23/c-0/31
msgctxt "Jacques"
msgid "I would like to send something, anything, EVERYTHING to that glorious netherworld!"
msgstr "J'aimerais envoyer quelque chose, n'importe quoi, TOUT dans ce glorieux séjour des morts !"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-5/23/c-1/7
msgctxt "Jacques"
msgid "What in glossy hell is a burrito."
msgstr "C'est quoi, par l'enfer luisant, un burrito."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-5/23/c-1/15/0/s/0
msgctxt "Choix"
msgid "Oh wow, you've never had a burrito??"
msgstr "Oh là là, tu n'as jamais mangé de burrito ??"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-5/23/c-1/15/1/s/0
msgctxt "Choix"
msgid "Glossy hell?"
msgstr "L'enfer luisant ?"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-5/23/c-1/15/2/s/0
msgctxt "Choix"
msgid "They're overrated, forget it."
msgstr "Ils sont surcotés, oublie."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-5/23/c-1/15/c-0/7
msgctxt "Jacques"
msgid "OBVIOUSLY I've never had one if I don't even know what it is! What is it with you and excitement? Positivity? SHARING?"
msgstr "ÉVIDEMMENT que je n'en ai jamais mangé si je ne sais même pas ce que c'est ! Qu'est-ce que c'est que cette obsession de l'enthousiasme ? De la positivité ? Du PARTAGE ?"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-5/23/c-1/15/c-0/18
msgctxt "Jacques"
msgid "Great Hades, it turns my stomach sour."
msgstr "Grand Hadès, j'en ai l'estomac retourné."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-5/23/c-1/15/c-0/26/0/s/0
msgctxt "Choix"
msgid "You're making this conversation thing really unpleasant."
msgstr "Tu rends cette conversation vraiment désagréable."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-5/23/c-1/15/c-0/26/1/s/0
msgctxt "Choix"
msgid "A burrito is rice and beans and spices and you wrap it up in a big tortilla."
msgstr "Un burrito, c'est du riz, des haricots, des épices, le tout enroulé dans une grande tortilla."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-5/23/c-1/15/c-0/26/c-1/15
msgctxt "Jacques"
msgid "You're comparing the insoluble crisis of my existence... to lunch?"
msgstr "Tu compares l'insoluble crise de mon existence... à un déjeuner ?"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-5/23/c-1/15/c-0/26/c-1/23/0/s/0
msgctxt "Choix"
msgid "I mean, I guess?"
msgstr "Euh, on dirait ?"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-5/23/c-1/15/c-1/7
msgctxt "Jacques"
msgid "Glass? Shiny, glossy, hell, my own purgatory, this bottle! My hell, which is, in fact, glossy."
msgstr "Verre ? Luisant, brillant, l'enfer, mon propre purgatoire, cette bouteille ! Mon enfer, qui est, de fait, luisant."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-5/23/c-1/15/c-1/15
msgctxt "Jacques"
msgid "Try to keep up."
msgstr "Essaie de suivre."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-5/23/c-1/15/c-1/23/0/s/0
msgctxt "Choix"
msgid "Got it now."
msgstr "Compris, cette fois."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-5/23/c-1/15/c-1/23/1/s/0
msgctxt "Choix"
msgid "Oy vey."
msgstr "Oy vey."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-5/23/c-1/15/c-1/23/c-0/7
msgctxt "Jacques"
msgid "Ah, wonders never cease."
msgstr "Ah, les miracles n'ont décidément pas de fin."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-5/23/c-1/15/c-1/23/c-0/15
msgctxt "Jacques"
msgid "And since I am in hell, we might as well get to it..."
msgstr "Et puisque je suis en enfer, autant nous y mettre..."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-5/23/c-1/15/c-1/23/c-1/7
msgctxt "Jacques"
msgid "Ha! How little it takes to exhaust you!"
msgstr "Ha ! Comme il en faut peu pour t'épuiser !"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-5/23/c-1/15/c-1/23/c-1/15
msgctxt "Jacques"
msgid "This is shaping up to be a disappointingly easy day for me..."
msgstr "Cette journée s'annonce d'une facilité décevante pour moi..."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-5/23/c-1/15/c-2/7
msgctxt "Jacques"
msgid "So now I'm not even worthy of a lesson from your Greatness? How little you must think of me."
msgstr "Alors je ne mérite même plus une leçon de Votre Grandeur ? Quelle piètre opinion tu as de moi."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-5/23/c-1/15/c-2/15
msgctxt "Jacques"
msgid "Ah, oh god, wait, is it because I'm LITTLE?!?! I knew it!"
msgstr "Ah, oh mon dieu, attends, c'est parce que je suis PETIT ?!?! Je le savais !"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-6/7
msgctxt "Jacques"
msgid "Your idiomatic flippance is shockingly on target."
msgstr "Ta désinvolture idiomatique tape étonnamment juste."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-6/15
msgctxt "Jacques"
msgid "Is that it? Have you woken me and distracted and disturbed me to tell me... \"I'm a little much?\""
msgstr "C'est donc ça ? Tu m'as réveillé, distrait et dérangé pour me dire... « Tu en fais un peu trop » ?"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-6/23
msgctxt "Jacques"
msgid "You worm! Of COURSE I am a little much!"
msgstr "Vermine ! Évidemment que j'en fais un peu trop !"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-6/31/0/s/0
msgctxt "Choix"
msgid "Hang on, 'worm'?!"
msgstr "Attends, « vermine » ?!"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-6/31/c-0/7
msgctxt "Jacques"
msgid "Ahhh, at last, a spark in your beady little eye! Do I dream? Does a worthy opponent lurk beneath this domesticated exterior?"
msgstr "Ahhh, enfin, une étincelle dans ton petit oeil de fouine ! Est-ce que je rêve ? Un adversaire digne de ce nom se cache-t-il sous cet extérieur domestiqué ?"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-6/31/c-0/15/0/s/0
msgctxt "Choix"
msgid "I'm not trying to pick a fight with you!"
msgstr "Je ne cherche pas la bagarre avec toi !"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-6/31/c-0/15/1/s/0
msgctxt "Choix"
msgid "I am not a worm!"
msgstr "Je ne suis pas de la vermine !"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-6/31/c-0/15/2/s/0
msgctxt "Choix"
msgid "Who you calling domesticated?"
msgstr "Qui traites-tu de domestiqué ?"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-6/31/c-0/15/3/s/0
msgctxt "Choix"
msgid "Hell yeah, what's this game? I'll play!"
msgstr "Et comment, c'est quoi ce jeu ? Je suis partant !"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-6/31/c-0/15/c-0/7
msgctxt "Jacques"
msgid "I 'spose that means you're having an unsatisfying day then..."
msgstr "Je suppose que cela signifie que ta journée est insatisfaisante..."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-6/31/c-0/15/c-0/15
msgctxt "Jacques"
msgid "Because battle is joined!"
msgstr "Car le combat est engagé !"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-6/31/c-0/15/c-1/7
msgctxt "Jacques"
msgid "Fine. You're not a worm. Worms eat dirt. Which I imagine you don't. What do you eat? Paleo? Keto?"
msgstr "Soit. Tu n'es pas un ver. Les vers mangent de la terre. Ce que tu ne fais pas, j'imagine. Que manges-tu ? Paléo ? Keto ?"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-6/31/c-0/15/c-1/15
msgctxt "Jacques"
msgid "No wait, permit me... You're... a vegan."
msgstr "Non, attends, permets-moi... Tu es... végane."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-6/31/c-0/15/c-1/23/0/s/0
msgctxt "Choix"
msgid "Now you have a problem with what I eat?!"
msgstr "Maintenant tu as un problème avec ce que je mange ?!"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-6/31/c-0/15/c-1/23/1/s/0
msgctxt "Choix"
msgid "I'm not a vegan..."
msgstr "Je ne suis pas végane..."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-6/31/c-0/15/c-1/23/c-0/11
msgctxt "Jacques"
msgid "YES, I have a problem with what you eat."
msgstr "OUI, j'ai un problème avec ce que tu manges."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-6/31/c-0/15/c-1/23/c-0/19
msgctxt "Jacques"
msgid "I have problems with EVERYTHING, haven't you been paying attention?"
msgstr "J'ai un problème avec TOUT, tu n'as donc pas suivi ?"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-6/31/c-0/15/c-1/23/c-0/27
msgctxt "Jacques"
msgid "Veganism is for people who are afraid of chicken cutlets wrapped in cellophane..."
msgstr "Le véganisme est pour les gens qui ont peur des escalopes de poulet sous cellophane..."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-6/31/c-0/15/c-1/23/c-0/35
msgctxt "Jacques"
msgid "People who balk at the time-honored complexities of a steak served on a thick plate and a mug of grog..."
msgstr "Pour ceux qui reculent devant les subtilités séculaires d'un bifteck servi sur une grosse assiette avec une chope de grog..."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-6/31/c-0/15/c-1/23/c-0/43
msgctxt "Jacques"
msgid "For people who think that EGGPLANT is actually something a human being should EVER eat!"
msgstr "Pour ceux qui pensent que l'AUBERGINE est réellement quelque chose qu'un être humain devrait JAMAIS manger !"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-6/31/c-0/15/c-1/23/c-0/51
msgctxt "Jacques"
msgid "Have at thee, O Deluded One!"
msgstr "En garde, ô Égaré !"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-6/31/c-0/15/c-1/23/c-1/7
msgctxt "Jacques"
msgid "Of course not! That would require forethought, tenacity, commitment, follow-through and mature decision-making!"
msgstr "Bien sûr que non ! Cela exigerait de la prévoyance, de la ténacité, de l'engagement, de la constance et des décisions de grande personne !"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-6/31/c-0/15/c-1/23/c-1/15/0/s/0
msgctxt "Choix"
msgid "Wait, it sounded like you thought veganism was dumb?"
msgstr "Attends, on dirait que tu trouves le véganisme idiot ?"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-6/31/c-0/15/c-1/23/c-1/15/c-0/7
msgctxt "Jacques"
msgid "I do! I think whatever you don't think, because whatever you think must be landlubber nonsense spewing from a tainted cask."
msgstr "Oui ! Je pense tout ce que tu ne penses pas, car tout ce que tu penses ne peut être que sornettes de terrien jaillies d'un tonneau vicié."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-6/31/c-0/15/c-1/23/c-1/15/c-0/15
msgctxt "Jacques"
msgid "Now stop distracting me, you organophobic troglodyte!"
msgstr "Et cesse de me distraire, troglodyte organophobe !"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-6/31/c-0/15/c-1/23/c-1/15/c-0/23
msgctxt "Jacques"
msgid "Put up your sword, prepare your soul for its imminent meeting with Commodore Davy Phones!"
msgstr "Tire ton épée, prépare ton âme à son rendez-vous imminent avec le Commodore Davy Phones !"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-6/31/c-0/15/c-2/7
msgctxt "Jacques"
msgid "You, of course."
msgstr "Toi, bien sûr."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-6/31/c-0/15/c-2/15
msgctxt "Jacques"
msgid "You... tavern cat."
msgstr "Toi... chat de taverne."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-6/31/c-0/15/c-2/23/0/s/0
msgctxt "Choix"
msgid "Tavern cat. Yup, that's it. Let's go."
msgstr "Chat de taverne. Ouais, c'est ça. Allons-y."

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-6/31/c-0/15/c-3/7
msgctxt "Jacques"
msgid "...you will?"
msgstr "...vraiment ?"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-6/31/c-0/15/c-3/15
msgctxt "Jacques"
msgid "really?"
msgstr "Vraiment ?"

# Traduction IA – à relire
#: jacques_ship/the_bitter_pirate/0/g-0/c-6/31/c-0/15/c-3/23/0/s/0
msgctxt "Choix"
msgid "Absolutely! I don't take insults lying down, let's go."
msgstr "Absolument ! Je ne me laisse pas insulter sans réagir, allons-y."

# Traduction IA – à relire
#: jacques_ship/lets_go/0/0
msgctxt "Jacques"
msgid "Um... well, yes, indeed we shall commence with your destruction, let me..."
msgstr "Hum... eh bien, oui, nous allons procéder à ta destruction, laisse-moi..."

# Traduction IA – à relire
#: jacques_ship/lets_go/0/8
msgctxt "Jacques"
msgid "Let me prepare myself for battle, prepare my dreadsome ship for its voyage unto Doom..."
msgstr "Laisse-moi me préparer au combat, préparer mon redoutable navire pour son voyage vers la Damnation..."

# Traduction IA – à relire
#: jacques_ship/lets_go/0/16
msgctxt "Jacques"
msgid "...hang on..."
msgstr "...attends..."

# Traduction IA – à relire
#: jacques_ship/lets_go/0/24/s/0
msgctxt "Choix"
msgid "Have you forgotten the name of your ship or something?"
msgstr "Tu as oublié le nom de ton navire ou quoi ?"

# Traduction IA – à relire
#: jacques_ship/lets_go/0/c-0/7
msgctxt "Jacques"
msgid "Its name! Of course, it's the 'Queen Divan's'..."
msgstr "Son nom ! Mais bien sûr, c'est le « Divan de la Reine »..."

# Traduction IA – à relire
#: jacques_ship/lets_go/0/c-0/15
msgctxt "Jacques"
msgid "What day of the week be it? Tuesday?"
msgstr "On est quel jour de la semaine ? Mardi ?"

# Traduction IA – à relire
#: jacques_ship/lets_go/0/c-0/23/0/s/0
msgctxt "Choix"
msgid "It is!"
msgstr "Oui !"

# Traduction IA – à relire
#: jacques_ship/lets_go/0/c-0/23/1/s/0
msgctxt "Choix"
msgid "It is not..."
msgstr "Non..."

# Traduction IA – à relire
#: jacques_ship/lets_go/0/c-0/23/2/s/0
msgctxt "Choix"
msgid "Why would it matter if it's Tuesday or not?"
msgstr "Pourquoi ça compterait, qu'on soit mardi ou pas ?"

# Traduction IA – à relire
#: jacques_ship/lets_go/0/c-0/23/c-0/7 jacques_ship/lets_go/0/c-0/23/c-1/7
msgctxt "Jacques"
msgid "Oh, yes, well then it's the 'Queen Divan's Revenge'."
msgstr "Ah, oui, eh bien dans ce cas c'est « La Vengeance du Divan de la Reine »."

# Traduction IA – à relire
#: jacques_ship/lets_go/0/c-0/23/c-2/7
msgctxt "Jacques"
msgid "It doesn't!"
msgstr "Ça ne compte pas !"

# Traduction IA – à relire
#: jacques_ship/lets_go/0/c-0/23/c-2/15
msgctxt "Jacques"
msgid "I change it sometimes."
msgstr "Je le change de temps en temps."

# Traduction IA – à relire
#: jacques_ship/lets_go/0/c-0/23/c-2/23
msgctxt "Jacques"
msgid "And now it is called the 'Queen Divan's Revenge!'"
msgstr "Et maintenant il s'appelle « La Vengeance du Divan de la Reine » !"

# Traduction IA – à relire
#: jacques_ship/lets_go/0/g-0/0
msgctxt "Jacques"
msgid "Because I'm so unpredictably terrifying. And now!"
msgstr "Parce que je suis d'une terreur imprévisible. Et maintenant !"

# Traduction IA – à relire
#: jacques_ship/lets_go/0/g-0/9/s/0
msgctxt "Choix"
msgid "Need a little help there?"
msgstr "Un petit coup de main ?"

# Traduction IA – à relire
#: jacques_ship/lets_go/0/g-0/10/s/0
msgctxt "Choix"
msgid "Don't you think you went to a 10, like, quickly?"
msgstr "Tu ne trouves pas que tu es monté dans les tours, là, un peu vite ?"

# Traduction IA – à relire
#: jacques_ship/lets_go/0/g-0/c-1/7
msgctxt "Jacques"
msgid "Back off, you tentacled dogsbody!"
msgstr "Recule, souillon tentaculaire !"

# Traduction IA – à relire
#: jacques_ship/lets_go/0/g-0/c-1/15
msgctxt "Jacques"
msgid "This ship is very finely balanced, like a racehorse, or... like one of those acrobats who hold up a bunch of plates and bowls on their chins... youknowtheones?"
msgstr "Ce navire est très finement équilibré, comme un pur-sang, ou... comme ces acrobates qui tiennent des piles d'assiettes et de bols sur leur menton... tu vois lesquels ?"

# Traduction IA – à relire
#: jacques_ship/lets_go/0/g-0/c-1/23
msgctxt "Jacques"
msgid "Besides, you are AFRAID to help me, because my very exuded breath shrouds you in danger and hopelessness! And now..."
msgstr "D'ailleurs, tu as PEUR de m'aider, parce que mon souffle même t'enveloppe de danger et de désespoir ! Et maintenant..."

# Traduction IA – à relire
#: jacques_ship/lets_go/0/g-0/c-2/7
msgctxt "Jacques"
msgid "Of course I did! It's what I do!"
msgstr "Bien sûr que oui ! C'est mon métier !"

# Traduction IA – à relire
#: jacques_ship/lets_go/0/g-0/c-2/15
msgctxt "Jacques"
msgid "You would be at full-sail, too, if you were trapped, homicidal and brandishing a hot pink plastic sword!"
msgstr "Tu ferais toutes voiles dehors, toi aussi, si tu étais piégé, homicide et brandissant une épée en plastique rose fluo !"

# Traduction IA – à relire
#: jacques_ship/cool_enemies/0/0/s/0
msgctxt "Choix"
msgid "Ok, I'm sensing some unresolved anger here."
msgstr "Ok, je sens de la colère non résolue ici."

# Traduction IA – à relire
#: jacques_ship/cool_enemies/0/1/s/0
msgctxt "Choix"
msgid "Cool, you have enemies?"
msgstr "Cool, tu as des ennemis ?"

# Traduction IA – à relire
#: jacques_ship/cool_enemies/0/c-0/7
msgctxt "Jacques"
msgid "Unresolved... unrelenting... it is a wildfire of pitch and black powder, always fed, never sated."
msgstr "Non résolue... implacable... c'est un incendie de poix et de poudre noire, toujours alimenté, jamais rassasié."

# Traduction IA – à relire
#: jacques_ship/cool_enemies/0/c-1/7
msgctxt "Jacques"
msgid "I do..."
msgstr "J'en ai..."

# Traduction IA – à relire
#: jacques_ship/cool_enemies/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "Do they rub you the wrong way?"
msgstr "Ils te prennent à rebrousse-poil ?"

# Traduction IA – à relire
#: jacques_ship/cool_enemies/0/c-1/15/1/s/0
msgctxt "Choix"
msgid "Wanna talk about it? It's dangerous to keep that anger bottled up."
msgstr "Tu veux en parler ? C'est dangereux de garder cette colère en bouteille."

# Traduction IA – à relire
#: jacques_ship/cool_enemies/0/c-1/15/c-0/7
msgctxt "Jacques"
msgid "Rub me? As in rub the bottle? You must take me for some kind of hell-fired genie!"
msgstr "Me frotter ? Comme on frotte la bouteille ? Tu me prends pour un génie de l'enfer !"

# Traduction IA – à relire
#: jacques_ship/bottle_joke/0/0
msgctxt "Jacques"
msgid "It's a bottle joke, then! Your first shot is fired, cannon roaring at the attack..."
msgstr "C'est donc une blague de bouteille ! Ton premier coup est tiré, le canon rugit à l'abordage..."

# Traduction IA – à relire
#: jacques_ship/bottle_joke/0/8
msgctxt "Jacques"
msgid "The wind of the hunt cracking, the spray flying, the bowsprit dripping bloody avarice as you come for me!"
msgstr "Le vent de la chasse qui claque, les embruns qui giclent, le beaupré dégoulinant d'avidité sanguinaire tandis que tu fonces sur moi !"

# Traduction IA – à relire
#: jacques_ship/bottle_joke/0/16/s/0
msgctxt "Choix"
msgid "Yeah... I actually didn't mean to insult you."
msgstr "Ouais... en fait, je ne voulais pas t'insulter."

# Traduction IA – à relire
#: jacques_ship/bottle_joke/0/17/s/0
msgctxt "Choix"
msgid "Hell yeah, keep talking, this is beautiful!"
msgstr "Et comment, continue, c'est magnifique !"

# Traduction IA – à relire
#: jacques_ship/bottle_joke/0/c-1/7
msgctxt "Jacques"
msgid "Beauty in death!"
msgstr "La beauté dans la mort !"

# Traduction IA – à relire
#: jacques_ship/the_first_death/0/0
msgctxt "Jacques"
msgid "Too much, the line is crossed, your pitiful life is forfeit to my magnificence!"
msgstr "C'en est trop, la ligne est franchie, ta pitoyable vie est confisquée au profit de ma magnificence !"

# Traduction IA – à relire
#: jacques_ship/the_first_death/0/8/s/0
msgctxt "Choix"
msgid "Cool!"
msgstr "Cool !"

# Traduction IA – à relire
#: jacques_ship/the_first_death/0/9/s/0
msgctxt "Choix"
msgid "What does that mean exactly?"
msgstr "Ça veut dire quoi, exactement ?"

# Traduction IA – à relire
#: jacques_ship/the_first_death/0/10/s/0
msgctxt "Choix"
msgid "I'm falling in love with your magnificence..."
msgstr "Je tombe amoureux de ta magnificence..."

# Traduction IA – à relire
#: jacques_ship/the_first_death/0/c-0/7
msgctxt "Jacques"
msgid "Nothing 'cool' about it, blackguard."
msgstr "Il n'y a rien de « cool » là-dedans, crapule."

# Traduction IA – à relire
#: jacques_ship/the_first_death/0/c-0/15
msgctxt "Jacques"
msgid "I will destroy you."
msgstr "Je vais te détruire."

# Traduction IA – à relire
#: jacques_ship/the_first_death/0/c-1/7
msgctxt "Jacques"
msgid "It means you'll be destroyed!"
msgstr "Ça veut dire que tu seras détruit !"

# Traduction IA – à relire
#: jacques_ship/the_first_death/0/c-2/13
msgctxt "Jacques"
msgid "Love? Think ye I look for love?"
msgstr "De l'amour ? Crois-tu que je cherche l'amour ?"

# Traduction IA – à relire
#: jacques_ship/the_first_death/0/c-2/21
msgctxt "Jacques"
msgid "Your insolence brings you only death!"
msgstr "Ton insolence ne t'apportera que la mort !"

# Traduction IA – à relire
#: jacques_ship/destroyed/0/0/s/0
msgctxt "Choix"
msgid "You're going to kill me?"
msgstr "Tu vas me tuer ?"

# Traduction IA – à relire
#: jacques_ship/destroyed/0/c-0/7
msgctxt "Jacques"
msgid "Dear sweet DAVY PHONES, if you insist on reducing everything to its simplest expression..."
msgstr "Cher et doux DAVY PHONES, si tu tiens à tout réduire à sa plus simple expression..."

# Traduction IA – à relire
#: jacques_ship/destroyed/0/c-0/15
msgctxt "Jacques"
msgid "Yes, yes. I am going to kill you."
msgstr "Oui, oui. Je vais te tuer."

# Traduction IA – à relire
#: jacques_ship/destroyed/0/c-0/23/0/s/0
msgctxt "Choix"
msgid "Hang on, what did I do?!"
msgstr "Attends, qu'est-ce que j'ai fait ?!"

# Traduction IA – à relire
#: jacques_ship/destroyed/0/c-0/23/c-0/7
msgctxt "Jacques"
msgid "You require an accounting??"
msgstr "Tu exiges des comptes ??"

# Traduction IA – à relire
#: jacques_ship/destroyed/0/c-0/23/c-0/15
msgctxt "Jacques"
msgid "You insulted and demeaned me! You passed judgment on an existence you could not possibly understand or hope to equal, you BELITTLED ME..."
msgstr "Tu m'as insulté et rabaissé ! Tu as jugé une existence que tu ne pourrais ni comprendre ni espérer égaler, tu m'as DÉNIGRÉ..."

# Traduction IA – à relire
#: jacques_ship/destroyed/0/c-0/23/c-0/23/0/s/0
msgctxt "Choix"
msgid "I didn't do any of those things!"
msgstr "Je n'ai rien fait de tout ça !"

# Traduction IA – à relire
#: jacques_ship/destroyed/0/c-0/23/c-0/23/1/s/0
msgctxt "Choix"
msgid "Oh man, what a drama queen..."
msgstr "Oh là là, quelle reine du drame..."

# Traduction IA – à relire
#: jacques_ship/destroyed/0/c-0/23/c-0/23/c-0/7
msgctxt "Jacques"
msgid "...maybe you didn't..."
msgstr "...peut-être pas..."

# Traduction IA – à relire
#: jacques_ship/destroyed/0/c-0/23/c-0/23/c-0/15
msgctxt "Jacques"
msgid "But you EXIST and you're HERE and I have to END SOMETHING..."
msgstr "Mais tu EXISTES et tu es LÀ et il faut que je FINISSE quelque chose..."

# Traduction IA – à relire
#: jacques_ship/destroyed/0/c-0/23/c-0/23/c-1/7
msgctxt "Jacques"
msgid "I am no queen. I am no king. I am purely... Scourge."
msgstr "Je ne suis ni reine ni roi. Je suis purement... Fléau."

# Traduction IA – à relire
#: jacques_ship/destroyed/0/c-0/23/c-0/23/c-1/15
msgctxt "Jacques"
msgid "I am without confines the way the sea is without the confines of a bank or a riverbed, it is endless and all-encompassing in it's merciless endlessness!"
msgstr "Je suis sans limites comme la mer est sans les limites d'une berge ou d'un lit de rivière, infinie et omniprésente dans son infinitude impitoyable !"

# Traduction IA – à relire
#: jacques_ship/destroyed/0/c-0/23/c-0/23/c-1/23/0/s/0
msgctxt "Choix"
msgid "You're literally confined. In a bottle."
msgstr "Tu es littéralement limité. Dans une bouteille."

# Traduction IA – à relire
#: jacques_ship/undoing/0/0
msgctxt "Jacques"
msgid "Bear witness to your undoing!"
msgstr "Sois témoin de ta perte !"

# Traduction IA – à relire
#: jacques_ship/undoing/0/8/s/0
msgctxt "Choix"
msgid "I'm watching!"
msgstr "Je regarde !"

# Traduction IA – à relire
#: jacques_ship/undoing/0/10/s/0
msgctxt "Choix"
msgid "I'm bearing... I'm bearing!"
msgstr "Je témoigne... je témoigne !"

# Traduction IA – à relire
#: jacques_ship/encounter_two_jacques_kills_you/0/0
msgctxt "Jacques"
msgid "Can you not feel it? Do you beg for quarter, for mercy from the most murderous, blood-eyed cudger to plow the fathomless flood??"
msgstr "Ne le sens-tu pas ? Implores-tu grâce, miséricorde auprès du plus meurtrier, du plus injecté de sang des gourdins à sillonner le flot insondable ??"

# Traduction IA – à relire
#: jacques_ship/encounter_two_jacques_kills_you/0/8/s/0
msgctxt "Choix"
msgid "I thought you were... going to kill me?"
msgstr "Je croyais que tu allais... me tuer ?"

# Traduction IA – à relire
#: jacques_ship/encounter_two_jacques_kills_you/0/c-0/7
msgctxt "Jacques"
msgid "Of course I am! I am killing you, right now!"
msgstr "Bien sûr que oui ! Je te tue, en ce moment même !"

# Traduction IA – à relire
#: jacques_ship/encounter_two_jacques_kills_you/0/c-0/15
msgctxt "Jacques"
msgid "I am tearing you limb from limb and dangling your bits from the rigging to tempt the crows!"
msgstr "Je t'arrache les membres un à un et j'accroche tes morceaux au gréement pour attirer les corbeaux !"

# Traduction IA – à relire
#: jacques_ship/encounter_two_jacques_kills_you/0/c-0/23
msgctxt "Narrator"
msgid "You take a moment to inspect yourself. Your limbs and bits all appear to be just where you left them."
msgstr "Vous prenez un instant pour vous inspecter. Vos membres et vos morceaux semblent tous être exactement là où vous les aviez laissés."

# Traduction IA – à relire
#: jacques_ship/encounter_two_jacques_kills_you/0/c-0/31/0/s/0
msgctxt "Choix"
msgid "Seems like you're talking a lot about it and not... doing anything."
msgstr "On dirait que tu en parles beaucoup mais que tu ne fais... rien du tout."

# Traduction IA – à relire
#: jacques_ship/encounter_two_jacques_kills_you/0/c-0/31/c-0/7
msgctxt "Jacques"
msgid "Oh, but I am."
msgstr "Oh, mais si."

# Traduction IA – à relire
#: jacques_ship/encounter_two_jacques_kills_you/0/c-0/31/c-0/15
msgctxt "Jacques"
msgid "I'm fileting your sorry rind."
msgstr "Je suis en train de te fileter ta misérable couenne."

# Traduction IA – à relire
#: jacques_ship/encounter_two_jacques_kills_you/0/c-0/31/c-0/31
msgctxt "Jacques"
msgid "In my mind."
msgstr "Dans ma tête."

# Traduction IA – à relire
#: jacques_ship/encounter_two_jacques_kills_you/0/c-0/31/c-0/39/0/s/0
msgctxt "Choix"
msgid "Oh. A speculative stabbing."
msgstr "Oh. Un coup de couteau spéculatif."

# Traduction IA – à relire
#: jacques_ship/encounter_two_jacques_kills_you/0/c-0/31/c-0/39/c-0/7
msgctxt "Jacques"
msgid "Damn yer hide, speculative! It's as real as the snap of sail in the wind, the squish of flesh and bone as it makes way for my blade!"
msgstr "Maudite soit ta peau, spéculatif ! C'est aussi réel que le claquement de la voile au vent, que le floc de la chair et de l'os qui s'écartent devant ma lame !"

# Traduction IA – à relire
#: jacques_ship/encounter_two_jacques_kills_you/0/c-0/31/c-0/39/c-0/15/0/s/0
msgctxt "Choix"
msgid "This talk of flesh and bone is too graphic for me."
msgstr "Ces histoires de chair et d'os, c'est trop imagé pour moi."

# Traduction IA – à relire
#: jacques_ship/encounter_two_jacques_kills_you/0/c-0/31/c-0/39/c-0/15/1/s/0
msgctxt "Choix"
msgid "That was kinda poetic."
msgstr "C'était presque poétique."

# Traduction IA – à relire
#: jacques_ship/encounter_two_jacques_kills_you/0/c-0/31/c-0/39/c-0/15/2/s/0
msgctxt "Choix"
msgid "I am not in fact stabbed, though."
msgstr "Pourtant, je ne suis pas poignardé, en fait."

# Traduction IA – à relire
#: jacques_ship/hate_track/0/0
msgctxt "Jacques"
msgid "You lily-livered worm... was it too much for you? Too much glorious gore?"
msgstr "Ver froussard... c'était trop pour toi ? Trop de gloire sanguinolente ?"

# Traduction IA – à relire
#: jacques_ship/hate_track/0/8/s/0
msgctxt "Choix"
msgid "Well kinda, yeah. Why do you have to be so gross?"
msgstr "Un peu, ouais. Pourquoi faut-il que tu sois aussi dégoûtant ?"

# Traduction IA – à relire
#: jacques_ship/hate_track/0/9/s/0
msgctxt "Choix"
msgid "This whole time, all you've done is rage at the world and insult me."
msgstr "Depuis le début, tout ce que tu fais, c'est râler contre le monde et m'insulter."

# Traduction IA – à relire
#: jacques_ship/hate_track/0/10/s/0
msgctxt "Choix"
msgid "Can't we just be nice to each other?"
msgstr "On ne peut pas simplement être gentils l'un avec l'autre ?"

# Traduction IA – à relire
#: jacques_ship/hate_track/0/c-0/7
msgctxt "Jacques"
msgid "I LIKE IT."
msgstr "J'AIME ÇA."

# Traduction IA – à relire
#: jacques_ship/hate_track/0/c-1/7 jacques_ship/hate_track/0/c-2/18
msgctxt "Jacques"
msgid "What grand violent adventure is BEING NICE?!"
msgstr "Quelle grande aventure violente y a-t-il à ÊTRE GENTIL ?!"

# Traduction IA – à relire
#: jacques_ship/hate_track/0/c-2/7
msgctxt "Jacques"
msgid "Nice. Niiiiice to each other. What glory is there in \"nice\"? What power?"
msgstr "Gentil. Gentiiil l'un avec l'autre. Quelle gloire y a-t-il dans la « gentillesse » ? Quelle puissance ?"

# Traduction IA – à relire
#: jacques_ship/hate_track/0/g-0/0/s/0
msgctxt "Choix"
msgid "Not everything in life has to be a grand adventure!"
msgstr "Tout dans la vie n'a pas à être une grande aventure !"

# Traduction IA – à relire
#: jacques_ship/hate_track/0/g-0/1/s/0
msgctxt "Choix"
msgid "You are so obsessed with violence!"
msgstr "Tu es tellement obsédé par la violence !"

# Traduction IA – à relire
#: jacques_ship/hate_track/0/g-0/2/s/0
msgctxt "Choix"
msgid "You're just living in a world that doesn't even exist anymore."
msgstr "Tu vis dans un monde qui n'existe même plus."

# Traduction IA – à relire
#: jacques_ship/hate_track/0/g-1/0
msgctxt "Jacques"
msgid "I shudder to think of the world you would create. My skin crawls with the lice of insidious niceness, shrunken beings squirreling themselves into the goat cage of niceness."
msgstr "Je frémis à l'idée du monde que tu créerais. Ma peau grouille des poux de la gentillesse insidieuse, d'êtres rabougris se terrant dans la cage à chèvres de la gentillesse."

# Traduction IA – à relire
#: jacques_ship/hate_track/0/g-1/8
msgctxt "Jacques"
msgid "Dear sweet Davy Phones... what would you have but a world where no one wants to make waves?"
msgstr "Cher et doux Davy Phones... que resterait-il, sinon un monde où personne ne veut faire de vagues ?"

# Traduction IA – à relire
#: jacques_ship/hate_track/0/g-1/16
msgctxt "Jacques"
msgid "Will no one rock the boat, hey! Will no one dare to hang from the bowsprit, cutlass flaring, and declare in a bellow that they will no longer be \"nice\"??"
msgstr "Personne ne secouera-t-il donc la barque, hé ! Personne n'osera-t-il se pendre au beaupré, coutelas au clair, et proclamer d'une voix tonitruante qu'il ne sera plus « gentil » ??"

# Traduction IA – à relire
#: jacques_ship/hate_track/0/g-1/24
msgctxt "Jacques"
msgid "I am a pirate, you deck-kneeling dog! Without a wave to crest and furrough, there is no life for me! There is no passion for me but before the mast!"
msgstr "Je suis un pirate, chien agenouillé sur le pont ! Sans vague à chevaucher et à sillonner, il n'y a pas de vie pour moi ! Il n'y a pas de passion pour moi hors du mât !"

# Traduction IA – à relire
#: jacques_ship/hate_track/0/g-1/32/s/0
msgctxt "Choix"
msgid "You are insane."
msgstr "Tu es fou."

# Traduction IA – à relire
#: jacques_ship/hate_track/0/g-1/33/s/0
msgctxt "Choix"
msgid "If you insult me one more time..."
msgstr "Si tu m'insultes encore une fois..."

# Traduction IA – à relire
#: jacques_ship/hate_track/0/g-2/0
msgctxt "Jacques"
msgid "I"
msgstr "JE"

# Traduction IA – à relire
#: jacques_ship/hate_track/0/g-2/8
msgctxt "Jacques"
msgid "REGRET"
msgstr "NE REGRETTE"

# Traduction IA – à relire
#: jacques_ship/hate_track/0/g-2/16
msgctxt "Jacques"
msgid "NOTHING"
msgstr "RIEN"

# Traduction IA – à relire
#: jacques_ship/hate_track/0/g-2/27/s/0
msgctxt "Choix"
msgid "I'm sure you don't."
msgstr "J'en suis sûr."

# Traduction IA – à relire
#: jacques_ship/hate_track/0/g-2/28/s/0
msgctxt "Choix"
msgid "I. HATE. YOU."
msgstr "JE. TE. HAIS."

# Traduction IA – à relire
#: jacques_ship/hate_track/0/g-2/c-8/7
msgctxt "Jacques"
msgid "I want to be clear."
msgstr "Je veux être clair."

# Traduction IA – à relire
#: jacques_ship/hate_track/0/g-2/c-8/15
msgctxt "Jacques"
msgid "If I see you again, if your shadow touches even the dessicated cork in the dust-crusted neck of this wretched bottle..."
msgstr "Si je te revois, si ton ombre touche ne serait-ce que le bouchon desséché dans le goulot poussiéreux de cette misérable bouteille..."

# Traduction IA – à relire
#: jacques_ship/hate_track/0/g-2/c-8/23
msgctxt "Jacques"
msgid "I will kill you."
msgstr "Je te tuerai."

# Traduction IA – à relire
#: jacques_ship/hate_track/0/g-2/c-8/31/0/s/0
msgctxt "Choix"
msgid "Or you'll imagine killing me, anyway."
msgstr "Ou tu imagineras me tuer, en tout cas."

# Traduction IA – à relire
#: jacques_ship/hate_track/0/g-3/0
msgctxt "Narrator"
msgid "Jacques pulls a pink cocktail sword from his waist, menacing you with it as though it were a proper pirate cutlass."
msgstr "Jacques tire de sa ceinture une épée à cocktail rose, qu'il brandit vers vous comme s'il s'agissait d'un authentique coutelas de pirate."

# Traduction IA – à relire
#: jacques_ship/hate_track/0/g-3/8
msgctxt "Jacques"
msgid "Flee me, knave!!!"
msgstr "Fuis-moi, canaille !!!"

# Traduction IA – à relire
#: jacques_ship/hate_track/0/g-3/16
msgctxt "Jacques"
msgid "For I am the fearsome Captain Jacques Pierrot — the plague of the high seas."
msgstr "Car je suis le redoutable Capitaine Jacques Pierrot, le fléau des mers !"

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/0
msgctxt "Jacques"
msgid "What did you say?!"
msgstr "Qu'as-tu dit ?!"

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/8/s/0
msgctxt "Choix"
msgid "I'm not stabbed?"
msgstr "Je ne suis pas poignardé ?"

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/c-0/7
msgctxt "Jacques"
msgid "How is this possible?"
msgstr "Comment est-ce possible ?"

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/c-0/15
msgctxt "Jacques"
msgid "Blimey, I can see me own hand rendering you like a fish still wriggling on the deck and you are standing there talking with lungs full of free air!"
msgstr "Mille sabords, je vois ma propre main te trancher comme un poisson qui se débat encore sur le pont, et toi tu restes là à parler, les poumons pleins d'air libre !"

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/c-0/23/0/s/0
msgctxt "Choix"
msgid "I think I get it."
msgstr "Je crois que j'ai compris."

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/c-0/23/1/s/0
msgctxt "Choix"
msgid "You can't actually murder me with a plastic cocktail stick."
msgstr "Tu ne peux pas vraiment me tuer avec un pic à cocktail en plastique."

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/c-0/23/c-0/7
msgctxt "Jacques"
msgid "What do ye get, if it's not the violence of the murder I do on ye?"
msgstr "Que comprends-tu, si ce n'est la violence du meurtre que je commets sur toi ?"

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/c-0/23/c-1/7
msgctxt "Jacques"
msgid "How dare yer lips mouth 'round such traitorous syllables!"
msgstr "Comment oses-tu faire rouler sur tes lèvres de si traîtresses syllabes !"

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-0/0/s/0
msgctxt "Choix"
msgid "I'm getting tired of these stupid and violent turns of phrases."
msgstr "Je commence à en avoir marre de ces expressions stupides et violentes."

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-0/1/s/0
msgctxt "Choix"
msgid "But even if right now you can't kill me... you would if you could."
msgstr "Mais même si là, tout de suite, tu ne peux pas me tuer... tu le ferais si tu pouvais."

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-0/2/s/0
msgctxt "Choix"
msgid "Honestly... sounds like a kick ass world!"
msgstr "Franchement... ça a l'air d'être un monde du tonnerre !"

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-0/3/s/0
msgctxt "Choix"
msgid "Gotcha. Now, truly, do I fear you."
msgstr "Compris. Maintenant, je te crains vraiment."

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-0/c-2/7
msgctxt "Jacques"
msgid "I would if I could and I can! It is the world of swashbuckling and a rum sun, where I am pistol proof!"
msgstr "Je le ferais si je pouvais, et je le peux ! C'est le monde des fiers-à-bras et du soleil de rhum, où je suis à l'épreuve des pistolets !"

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-0/c-3/7
msgctxt "Jacques"
msgid "It is and does!"
msgstr "C'est le cas, et il l'est !"

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-0/c-4/7
msgctxt "Jacques"
msgid "As you should."
msgstr "Comme il se doit."

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-1/0
msgctxt "Jacques"
msgid "But be wary with your familiarity..."
msgstr "Mais méfie-toi de ta familiarité..."

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-1/8
msgctxt "Jacques"
msgid "A hearty may tolerate the rats... but he will still skewer them when the hunger sets in."
msgstr "Un brave peut tolérer les rats... mais il les embrochera quand même quand la faim se fera sentir."

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-1/16/s/0
msgctxt "Choix"
msgid "Point taken."
msgstr "Message reçu."

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-1/17/s/0
msgctxt "Choix"
msgid "That's... descriptive. Thanks."
msgstr "C'est... descriptif. Merci."

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-1/18/s/0
msgctxt "Choix"
msgid "Ew, you'd eat a rat...?"
msgstr "Beurk, tu mangerais un rat... ?"

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-1/c-7/7
msgctxt "Jacques"
msgid "I—"
msgstr "Je—"

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-1/c-7/15/0/s/0
msgctxt "Choix"
msgid "Nevermind, I don't wanna know."
msgstr "Laisse tomber, je ne veux pas savoir."

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-2/0/s/0
msgctxt "Choix"
msgid "I just realized. You never actually introduced yourself."
msgstr "Je viens de réaliser. Tu ne t'es jamais vraiment présenté."

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-2/c-8/7
msgctxt "Jacques"
msgid "How can you not know my name."
msgstr "Comment peux-tu ne pas connaître mon nom."

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-2/c-8/15/0/s/0
msgctxt "Choix"
msgid "I never asked, I guess?"
msgstr "Je ne l'ai jamais demandé, je suppose ?"

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-2/c-8/15/1/s/0
msgctxt "Choix"
msgid "I can see on the screen it says \"Jacques\"."
msgstr "Je vois à l'écran que ça dit « Jacques »."

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-2/c-8/15/c-0/7
msgctxt "Jacques"
msgid "No, that's true, ye blaggard."
msgstr "Non, c'est vrai, canaille."

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-2/c-8/15/c-1/7
msgctxt "Jacques"
msgid "Y'know, before I had my own ship, if someone in the crew had started spouting the kind of nonsense you are dripping out of your gob..."
msgstr "Tu sais, avant d'avoir mon propre navire, si quelqu'un de l'équipage s'était mis à débiter le genre de sornettes que tu dégoulines de ton clapet..."

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-2/c-8/15/c-1/15
msgctxt "Jacques"
msgid "They would make him walk the plank with his drawers stuffed in his mouth."
msgstr "On lui aurait fait marcher sur la planche, le caleçon enfoncé dans la bouche."

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/ratjoin/0
msgctxt "Jacques"
msgid "But you haven't heard my moniker, say, closely whispered in the passageways of your nightmares?"
msgstr "Mais tu n'as jamais entendu mon surnom, disons, chuchoté tout bas dans les coursives de tes cauchemars ?"

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/ratjoin/8/s/0
msgctxt "Choix"
msgid "...nope, can't say I have."
msgstr "...non, je ne crois pas."

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/ratjoin/9/s/0
msgctxt "Choix"
msgid "My nightmares are more insect-based."
msgstr "Mes cauchemars sont plutôt à base d'insectes."

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/ratjoin/10/s/0
msgctxt "Choix"
msgid "I'm literally in love with my nightmares."
msgstr "Je suis littéralement amoureux de mes cauchemars."

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/ratjoin/c-9/7
msgctxt "Jacques"
msgid "I need a new PR manager then."
msgstr "Il me faut donc un nouveau responsable de communication."

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/ratjoin/c-9/18
msgctxt "Jacques"
msgid "<w>PIRATE RELATIONS</w> before you even ask."
msgstr "<w>RELATIONS PIRATES</w> avant même que tu demandes."

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/ratjoin/c-10/7
msgctxt "Jacques"
msgid "Ah. Insects. If only I had ten thousand crushing bootheels... I'd have ten thousand delicious, crispy flapjacks!"
msgstr "Ah. Des insectes. Si seulement j'avais dix mille talons pour les écraser... j'aurais dix mille délicieuses crêpes croustillantes !"

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/ratjoin/c-11/7
msgctxt "Jacques"
msgid "Hmph. Then I have a many-tentacled hermit crab I would like to introduce you to."
msgstr "Hmph. Alors j'ai un bernard-l'ermite à mille tentacules que j'aimerais te présenter."

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/ratjoin/c-11/15
msgctxt "Jacques"
msgid "Sounds like you two would hit it off..."
msgstr "J'ai l'impression que vous vous entendriez à merveille..."

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-3/0 jacques_ship/love_track/0/c-0/21 jacques_ship/beau/0/beautwo/16
msgctxt "Jacques"
msgid "I..."
msgstr "Je..."

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-3/8 jacques_ship/love_track/0/c-0/29
msgctxt "Jacques"
msgid "I am the fearsome Captain Jacques Pierrot. I am the plague of the high seas."
msgstr "Je suis le redoutable Capitaine Jacques Pierrot. Je suis le fléau des mers."

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-3/16 jacques_ship/love_track/0/c-0/37
msgctxt "Jacques"
msgid "I deal in death, spectacle, and warning!"
msgstr "Je fais commerce de mort, de spectacle et d'avertissements !"

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-3/27/s/0
msgctxt "Choix"
msgid "Captain Jacques Pierrot. Doesn't that sound like that other famous pirate?"
msgstr "Capitaine Jacques Pierrot. Ça ne ressemble pas à cet autre pirate célèbre ?"

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-3/28/s/0
msgctxt "Choix"
msgid "Do you know any of the others here?"
msgstr "Tu en connais d'autres, ici ?"

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-3/c-12/7
msgctxt "Jacques"
msgid "That it is, ye cudger. I pirated his own name from one of the best pirates around!"
msgstr "Tout à fait, garnement. J'ai piraté son propre nom à l'un des meilleurs pirates qui soient !"

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-3/c-12/15/0/s/0
msgctxt "Choix"
msgid "Why don't you call yourself that if you already knew you were stealing it?"
msgstr "Pourquoi tu ne t'appelles pas autrement, si tu savais que tu le volais ?"

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-3/c-12/15/c-0/7
msgctxt "Jacques"
msgid "I say it in French."
msgstr "Je le dis en anglais."

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-3/c-12/15/c-0/15
msgctxt "Jacques"
msgid "Because French... is scarier."
msgstr "Parce que l'anglais... est plus effrayant."

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-3/c-12/15/c-0/23/0/s/0
msgctxt "Choix"
msgid "Oh. Of course."
msgstr "Oh. Évidemment."

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-3/c-12/15/c-0/23/1/s/0
msgctxt "Choix"
msgid "No it isn't."
msgstr "Non, pas du tout."

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-3/c-12/15/c-0/23/2/s/0
msgctxt "Choix"
msgid "Bien sûr."
msgstr "Of course."

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-3/c-12/15/c-0/23/c-2/7
msgctxt "Jacques"
msgid "Formidable!"
msgstr "Wonderful !"

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-3/c-12/15/c-0/23/g-0/0
msgctxt "Jacques"
msgid "OUI."
msgstr "YES."

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-3/c-13/7
msgctxt "Jacques"
msgid "Maybe. Depends on who they are. Most I've encountered from this god-forsaken flagon have been repulsively skittish."
msgstr "Peut-être. Ça dépend de qui. La plupart de ceux que j'ai croisés dans ce flacon maudit des dieux étaient d'une pusillanimité répugnante."

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-3/c-13/15/0/s/0
msgctxt "Choix"
msgid "Did you try to kill them?"
msgstr "Tu as essayé de les tuer ?"

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-3/c-13/15/c-0/7
msgctxt "Jacques"
msgid "Aye, indeed! The craving for mayhem is unrelenting!"
msgstr "Oui, pardi ! L'envie de grabuge est inextinguible !"

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-3/c-13/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "That might help explain your lack of a social life."
msgstr "Ça pourrait expliquer ton absence de vie sociale."

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-3/c-13/15/c-0/15/1/s/0
msgctxt "Choix"
msgid "I'll bet I can find some brave ones."
msgstr "Je parie que je peux en dénicher des courageux."

# Traduction IA – à relire
#: jacques_ship/friendship_track/0/g-4/0
msgctxt "Jacques"
msgid "I will try to kill anyone you bring onto my ocean. If they don't die, we'll see."
msgstr "J'essaierai de tuer quiconque tu amèneras sur mon océan. S'ils ne meurent pas, on verra."

# Traduction IA – à relire
#: jacques_ship/love_track/0/0
msgctxt "Jacques"
msgid "Blech. Poetry. Never could stomach the stuff."
msgstr "Beurk. La poésie. Jamais pu avaler ces trucs-là."

# Traduction IA – à relire
#: jacques_ship/love_track/0/8/s/0
msgctxt "Choix"
msgid "But... you speak so beautifully!"
msgstr "Mais... tu parles si bien !"

# Traduction IA – à relire
#: jacques_ship/love_track/0/c-0/13
msgctxt "Jacques"
msgid "Hold fast there, I do NOT speak beeeyoootifoooleee."
msgstr "Minute, je ne parle PAS de façon meeerveeeilleuuuse."

# Traduction IA – à relire
#: jacques_ship/love_track/0/c-0/48
msgctxt "Jacques"
msgid "I spout the macabre! I vomit forth danger and horror."
msgstr "Je profère le macabre ! Je vomis le danger et l'horreur."

# Traduction IA – à relire
#: jacques_ship/love_track/0/c-0/56
msgctxt "Jacques"
msgid "There is nothing beautiful in my world, least of all my DAMNED SELF!"
msgstr "Il n'y a rien de beau dans mon monde, et surtout pas MA SATANÉE PERSONNE !"

# Traduction IA – à relire
#: jacques_ship/love_track/0/c-0/64/0/s/0
msgctxt "Choix"
msgid "Oh, um... Maybe beautiful was the wrong word."
msgstr "Oh, euh... « beau » n'était peut-être pas le bon mot."

# Traduction IA – à relire
#: jacques_ship/love_track/0/c-0/64/1/s/0
msgctxt "Choix"
msgid "But you look beautiful to me..."
msgstr "Mais tu me parais beau..."

# Traduction IA – à relire
#: jacques_ship/love_track/0/c-0/64/g-0/0
msgctxt "Narrator"
msgid "Jacques makes a strange noise almost akin to a growl. He looks positively put out."
msgstr "Jacques émet un drôle de bruit, presque un grognement. Il a l'air franchement contrarié."

# Traduction IA – à relire
#: jacques_ship/love_track/0/c-0/64/g-0/8
msgctxt "Jacques"
msgid "<w>urghghughgh... </w>"
msgstr "<w>urghghughgh... </w>"

# Traduction IA – à relire
#: jacques_ship/love_track/0/c-0/64/g-0/16
msgctxt "Jacques"
msgid "Damn."
msgstr "Zut."

# Traduction IA – à relire
#: jacques_ship/love_track/0/c-0/64/g-0/24/0/s/0
msgctxt "Choix"
msgid "What the hell was that noise?"
msgstr "C'était quoi, ce bruit ?"

# Traduction IA – à relire
#: jacques_ship/love_track/0/c-0/64/g-0/24/c-0/7
msgctxt "Jacques"
msgid "Oh, nothin'. I was hoping you would argue with me and I could try to kill you again."
msgstr "Oh, rien. J'espérais que tu me contredirais et que je pourrais essayer de te tuer à nouveau."

# Traduction IA – à relire
#: jacques_ship/love_track/0/c-0/64/g-0/24/c-0/15
msgctxt "Jacques"
msgid "It makes me growl when people are... conciliatory."
msgstr "Ça me fait grogner quand les gens sont... conciliants."

# Traduction IA – à relire
#: jacques_ship/love_track/0/c-0/64/g-0/24/c-0/23/0/s/0
msgctxt "Choix"
msgid "You don't like it when people are nice to you?"
msgstr "Tu n'aimes pas qu'on soit gentil avec toi ?"

# Traduction IA – à relire
#: jacques_ship/love_track/0/c-0/64/g-0/24/c-0/23/1/s/0
msgctxt "Choix"
msgid "It's the worst when you just want to fight and nobody will take you up on it."
msgstr "C'est le pire, quand on veut juste se battre et que personne ne te suit."

# Traduction IA – à relire
#: jacques_ship/love_track_three/0/0
msgctxt "Jacques"
msgid "NO! Haven't you been paying attention??!"
msgstr "NON ! Tu n'as donc rien écouté ??!"

# Traduction IA – à relire
#: jacques_ship/love_track_three/0/8
msgctxt "Jacques"
msgid "I want CONFLICT! Urghghghghur, one more false step out of you and I swear to Davy Phones I'll swing ye from the yard arm!"
msgstr "Je veux du CONFLIT ! Urghghghghur, encore un faux pas et je jure sur Davy Phones que je te pends à la vergue !"

# Traduction IA – à relire
#: jacques_ship/love_track_three/0/16/s/0
msgctxt "Choix"
msgid "What yardarm? That toothpick up there?"
msgstr "Quelle vergue ? Ce cure-dent, là-haut ?"

# Traduction IA – à relire
#: jacques_ship/love_track_three/0/17/s/0
msgctxt "Choix"
msgid "What the hell's a yardarm?"
msgstr "C'est quoi, une vergue ?"

# Traduction IA – à relire
#: jacques_ship/love_track_three/0/18/s/0
msgctxt "Choix"
msgid "You even try it and I'll decimate you with a rolled up Thyme Magazine, bub!"
msgstr "Essaie seulement et je te massacre à coups de Thym Magazine roulé, mon coco !"

# Traduction IA – à relire
#: jacques_ship/love_track_three/0/c-0/7
msgctxt "Jacques"
msgid "Are ye disrespecting my ship?"
msgstr "Tu manques de respect à mon navire ?"

# Traduction IA – à relire
#: jacques_ship/love_track_three/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "This isn't a ship. It's a paperweight."
msgstr "Ce n'est pas un navire. C'est un presse-papier."

# Traduction IA – à relire
#: jacques_ship/love_track_three/0/c-0/15/1/s/0
msgctxt "Choix"
msgid "Absolutely I am. Whatever will fan the flames of conflict, I'm in!"
msgstr "Absolument. Tout ce qui attisera les flammes du conflit, je suis partant !"

# Traduction IA – à relire
#: jacques_ship/love_track_three/0/c-0/15/c-1/7
msgctxt "Jacques"
msgid "Oh, glorious! Thanks be to all the corpses suspended in the sea, someone has finally been stupid enough to truly boil my bile!"
msgstr "Oh, glorieux ! Grâces soient rendues à tous les cadavres suspendus dans la mer, quelqu'un a enfin été assez stupide pour faire vraiment bouillir ma bile !"

# Traduction IA – à relire
#: jacques_ship/love_track_three/0/c-1/7
msgctxt "Jacques"
msgid "Are you disrespecting my ship?"
msgstr "Tu manques de respect à mon navire ?"

# Traduction IA – à relire
#: jacques_ship/love_track_three/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "Damn right I am, it's basically paper mache, you moron."
msgstr "Et comment, c'est du papier mâché, espèce d'imbécile."

# Traduction IA – à relire
#: jacques_ship/love_track_three/0/c-1/15/1/s/0
msgctxt "Choix"
msgid "Of course I'm not. I'm just disagreeing with you! VIOLENTLY!"
msgstr "Bien sûr que non. Je ne fais que ne pas être d'accord avec toi ! VIOLEMMENT !"

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/6
msgctxt "Jacques"
msgid "Let there be blood. I load my cannon with heavy, iron rounds to tear through anything and everything you might pray to put between us."
msgstr "Que le sang coule. Je charge mon canon de lourds boulets de fer pour déchiqueter tout ce que tu prieras de mettre entre nous."

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/14/s/0
msgctxt "Choix"
msgid "I laugh in the face of your chia seed cannon."
msgstr "Je ris au nez de ton canon à graines de chia."

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/15/s/0
msgctxt "Choix"
msgid "Ah yes, cannon... I can evade that easily. I'll turn my face fully to you, no broadsides today, buccaneer!"
msgstr "Ah oui, le canon... je l'esquive sans peine. Je te ferai face de plein fouet, pas de bordée aujourd'hui, boucanier !"

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/c-0/7
msgctxt "Jacques"
msgid "How dare you! Even if I did use seeds, in my horrible hands, they would be more deadly than curare!"
msgstr "Comment oses-tu ! Même si j'utilisais des graines, entre mes horribles mains, elles seraient plus mortelles que le curare !"

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "Ha! I sip a good curare when I can't sleep... it soothes me."
msgstr "Ha ! Je sirote un bon curare quand je n'arrive pas à dormir... ça m'apaise."

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/c-0/15/1/s/0
msgctxt "Choix"
msgid "I do not know this strange word and yet it matters not!"
msgstr "Je ne connais pas ce mot étrange et pourtant peu importe !"

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/c-0/15/c-0/7
msgctxt "Jacques"
msgid "Ye must be devilish indeed, that a deadly elixir is at home in your gut."
msgstr "Tu dois être diablement retors pour qu'un élixir mortel se sente chez lui dans tes entrailles."

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/c-0/15/c-0/15/0/s/0
msgctxt "Choix"
msgid "Indeed I am. Devilish and pugnacious."
msgstr "En effet. Diabolique et pugnace."

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/c-0/15/c-0/15/c-0/7
msgctxt "Jacques"
msgid "Oh, there ye go again, you two-legged thesaurus! Ye toss words in my face like so many netted squid that I find that they... they strike me!"
msgstr "Oh, ça y est, tu recommences, dictionnaire des synonymes sur pattes ! Tu me jettes des mots à la figure comme autant de calmars sortis du filet, et je trouve qu'ils... qu'ils me frappent !"

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/c-0/15/c-0/15/c-0/15
msgctxt "Jacques"
msgid "they strike me..."
msgstr "qu'ils me frappent..."

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/c-0/15/c-0/15/c-0/23/0/s/0
msgctxt "Choix"
msgid "Yes? Are they slimy? Are they cold? Are they wriggly and revolting?"
msgstr "Oui ? Ils sont visqueux ? Ils sont froids ? Ils frétillent, ils sont répugnants ?"

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/c-0/15/c-0/15/c-0/23/1/s/0
msgctxt "Choix"
msgid "I'm aiming to strike you, Jacques."
msgstr "J'ai l'intention de te frapper, Jacques."

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/c-0/15/c-0/15/c-0/23/2/s/0
msgctxt "Choix"
msgid "I'm aiming to blow you, straight down to the Locker!"
msgstr "J'ai l'intention de te souffler, tout droit jusqu'au fond du Coffre !"

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/c-0/15/c-0/15/c-0/23/g-0/0
msgctxt "Jacques"
msgid "Watch your step, landlubber!"
msgstr "Fais attention où tu mets les pieds, rat de terre !"

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/c-0/15/c-0/15/c-0/23/g-0/8
msgctxt "Jacques"
msgid "My fathomless depths are ripe for plumbing but they might swallow you whole."
msgstr "Mes profondeurs insondables sont mûres pour être sondées, mais elles pourraient t'avaler tout cru."

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/c-0/15/c-0/15/c-0/23/g-0/16/0/s/0
msgctxt "Choix"
msgid "Swallow you, huh?"
msgstr "T'avaler, hein ?"

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/c-0/15/c-0/15/c-0/23/g-0/16/1/s/0
msgctxt "Choix"
msgid "This is starting to sound pretty hot."
msgstr "Ça commence à sonner plutôt chaud."

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/c-0/15/c-1/7
msgctxt "Jacques"
msgid "Explain yourself!"
msgstr "Explique-toi !"

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/c-0/15/c-1/15/0/s/0
msgctxt "Choix"
msgid "For with my formidable form I harness your very own!"
msgstr "Car de ma forme formidable je m'empare de la tienne !"

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/c-0/15/c-1/15/1/s/0
msgctxt "Choix"
msgid "I shut that rampant mouth of yours with a kiss!"
msgstr "Je ferme ta bouche débridée d'un baiser !"

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/c-1/7
msgctxt "Jacques"
msgid "You've picked up one smidge of strategy from some painted tavern doxie and you imagine yourself my equal!"
msgstr "Tu as grappillé une once de stratégie auprès d'une catin de taverne fardée et tu te crois mon égal !"

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "Your equal and so much more!"
msgstr "Ton égal et bien plus encore !"

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/c-1/15/1/s/0
msgctxt "Choix"
msgid "What do you say we take this to deeper water?"
msgstr "Et si on allait en eaux plus profondes ?"

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/c-1/15/c-0/7
msgctxt "Jacques"
msgid "Ha! The gall! The moxie!"
msgstr "Ha ! Quel culot ! Quel cran !"

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/c-1/15/c-0/15
msgctxt "Jacques"
msgid "...my pantaloons tent in anticipation..."
msgstr "...mon haut-de-chausses fait la tente d'impatience..."

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/c-1/15/c-0/23
msgctxt "Narrator"
msgid "Jacques falls silent, his cheeks ruddy. Perhaps he didn't intend to say that part out loud."
msgstr "Jacques se tait, les joues empourprées. Il n'avait peut-être pas l'intention de dire cette partie à voix haute."

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/c-1/15/c-0/39
msgctxt "Jacques"
msgid "Eh."
msgstr "Euh."

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/c-1/15/c-0/47
msgctxt "Jacques"
msgid "Uh!"
msgstr "Heu !"

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/c-1/15/c-1/7
msgctxt "Jacques"
msgid "Ah, deeper wat..."
msgstr "Ah, des eaux plus prof..."

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/c-1/15/c-1/15
msgctxt "Jacques"
msgid "AH! Yes, wait. Well. Dammit."
msgstr "AH ! Oui, attends. Eh bien. Zut."

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/g-0/0
msgctxt "Narrator"
msgid "Jacques looks all around the room as he speaks, one hand awkwardly clutching his sword handle. You've never seen him look so unsure of himself."
msgstr "Jacques scrute toute la pièce en parlant, une main agrippant maladroitement la poignée de son épée. Vous ne l'avez jamais vu aussi peu sûr de lui."

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/g-0/8
msgctxt "Jacques"
msgid "I... you know, I've just remembered that I have to..."
msgstr "Je... tu sais, je viens de me rappeler que je dois..."

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/g-0/16
msgctxt "Jacques"
msgid "Swab the deck! Yes!"
msgstr "Briquer le pont ! Oui !"

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/g-0/24
msgctxt "Jacques"
msgid "The deck needs a good swabbing before I do any intercourse... EH I mean killing and battling and all the other lovely violent things!"
msgstr "Le pont a besoin d'un bon briquage avant que je me livre à quelque commerce... EUH je veux dire carnage, combats et toutes les autres charmantes violences !"

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/g-0/32
msgctxt "Jacques"
msgid "So, another time."
msgstr "Donc, une autre fois."

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/g-0/43
msgctxt "Jacques"
msgid "Post swab."
msgstr "Après le briquage."

# Traduction IA – à relire
#: jacques_ship/choose_your_sexiness/0/g-0/51
msgctxt "Jacques"
msgid "Ye bastard!"
msgstr "Fripouille !"

# Traduction IA – à relire
#: jacques_ship/hate_track_a/0
msgctxt "Jacques"
msgid "Yes, graphic."
msgstr "Oui, imagé."

# Traduction IA – à relire
#: jacques_ship/hate_track_a/8
msgctxt "Jacques"
msgid "What the hell is the point of life if it is not graphic??"
msgstr "À quoi bon la vie si elle n'est pas imagée ??"

# Traduction IA – à relire
#: jacques_ship/hate_track_a/16
msgctxt "Jacques"
msgid "My god, you'd rather live a life where everything is pastels, and it's never too hot, never too cold, everyone is pleasant and the coffee is always a little too fancy and a little too expensive but you just can't help yourself!"
msgstr "Mon dieu, tu préférerais vivre une vie où tout est en pastel, où il ne fait jamais trop chaud, jamais trop froid, où tout le monde est aimable et où le café est toujours un peu trop chic et un peu trop cher mais tu ne peux pas t'en empêcher !"

# Traduction IA – à relire
#: jacques_ship/hate_track_a/24
msgctxt "Jacques"
msgid "Give me blood or give me nothing."
msgstr "Du sang ou rien."

# Traduction IA – à relire
#: jacques_ship/hate_track_a/32
msgctxt "Jacques"
msgid "Show me gore or show me no more!"
msgstr "Montre-moi des tripes ou ne me montre plus rien !"

# Traduction IA – à relire
#: jacques_ship/hate_track_a/40
msgctxt "Jacques"
msgid "In fact, get out before I satisfy my \"graphic\" needs with your entrails!"
msgstr "D'ailleurs, sors d'ici avant que je ne satisfasse mes besoins « imagés » avec tes entrailles !"

# Traduction IA – à relire
#: jacques_ship/hate_track_two/0/0
msgctxt "Jacques"
msgid "Ah... and now we are in new waters. The violence has a different flavor here, the flavor of true hatred and destruction..."
msgstr "Ah... et nous voici en eaux nouvelles. La violence a ici une autre saveur, la saveur de la haine véritable et de la destruction..."

# Traduction IA – à relire
#: jacques_ship/hate_track_two/0/8
msgctxt "Jacques"
msgid "Think of eating a hot coal, burning from the inside out as it sticks and stalls in ye trembling throat..."
msgstr "Imagine que tu avales un charbon ardent, qui te brûle de l'intérieur en s'accrochant et en stagnant dans ta gorge tremblante..."

# Traduction IA – à relire
#: jacques_ship/hate_track_two/0/16
msgctxt "Jacques"
msgid "All the waters in all the seas could not quench this fire..."
msgstr "Toutes les eaux de toutes les mers ne pourraient éteindre ce feu..."

# Traduction IA – à relire
#: jacques_ship/hate_track_two/0/24
msgctxt "Jacques"
msgid "NOBODY. DISRESPECTS. THE SAN BARCOMIEDO!"
msgstr "PERSONNE. NE MANQUE. DE RESPECT. AU SAN BARCOMIEDO !"

# Traduction IA – à relire
#: jacques_ship/hate_track_two/0/38/s/0
msgctxt "Choix"
msgid "So, I do know a little Spanish..."
msgstr "Alors, je parle un peu espagnol, moi..."

# Traduction IA – à relire
#: jacques_ship/hate_track_two/0/39/s/0
msgctxt "Choix"
msgid "I do and I will continue to do so!"
msgstr "Oui, et je continuerai !"

# Traduction IA – à relire
#: jacques_ship/hate_track_two/0/40/s/0
msgctxt "Choix"
msgid "I thought it was called 'Queen Divan's Revenge'?"
msgstr "Je croyais qu'il s'appelait « La Vengeance du Divan de la Reine » ?"

# Traduction IA – à relire
#: jacques_ship/hate_track_two/0/c-0/7
msgctxt "Jacques"
msgid "I am not impressed."
msgstr "Je ne suis pas impressionné."

# Traduction IA – à relire
#: jacques_ship/hate_track_two/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "Did you really name your ship... Saint ScaryBoat?"
msgstr "Tu as vraiment appelé ton navire... Saint Bateau-Peur ?"

# Traduction IA – à relire
#: jacques_ship/hate_track_two/0/c-2/7
msgctxt "Jacques"
msgid "I AM WORKSHOPPING THE NAME EVEN NOW!"
msgstr "JE PEAUFINE ENCORE LE NOM À CET INSTANT !"

# Traduction IA – à relire
#: jacques_ship/hate_track_two/0/g-0/0
msgctxt "Narrator"
msgid "Jacques pulls the pink cocktail sword from his waist, aiming it directly at your throat. He's been angry, but this is a new level of intensity."
msgstr "Jacques tire l'épée à cocktail rose de sa ceinture et la pointe droit sur votre gorge. Il était déjà en colère, mais là, c'est un autre niveau d'intensité."

# Traduction IA – à relire
#: jacques_ship/hate_track_two/0/g-0/8
msgctxt "Jacques"
msgid "FLEE BEFORE ME, SCUM! I hate you."
msgstr "FUIS DEVANT MOI, VERMINE ! Je te déteste."

# Traduction IA – à relire
#: jacques_ship/hate_track_two/0/g-0/19
msgctxt "Jacques"
msgid "AND NOT IN A GOOD WAY!"
msgstr "ET PAS DANS LE BON SENS !"

# Traduction IA – à relire
#: jacques_ship/encounter_three/0/6
msgctxt "Jacques"
msgid "Ah, you're back."
msgstr "Ah, te revoilà."

# Traduction IA – à relire
#: jacques_ship/encounter_three/0/14
msgctxt "Jacques"
msgid "I have to say... it is difficult to surprise me... I'm so accustomed to being disappointed and enraged by turns that genuine shock is a sea-lane less travelled."
msgstr "Je dois dire... il est difficile de me surprendre... j'ai si bien l'habitude d'alterner déception et fureur qu'un véritable choc est une route maritime peu fréquentée."

# Traduction IA – à relire
#: jacques_ship/encounter_three/0/22
msgctxt "Jacques"
msgid "I thought for one reason or another, you'd have given me a wide berth!"
msgstr "Je pensais que, pour une raison ou une autre, tu m'aurais tenu à bonne distance !"

# Traduction IA – à relire
#: jacques_ship/encounter_three/0/30/s/0
msgctxt "Choix"
msgid "What can I say, I'm a glutton for punishment."
msgstr "Que veux-tu, j'adore me faire punir."

# Traduction IA – à relire
#: jacques_ship/encounter_three/0/31/s/0
msgctxt "Choix"
msgid "Are you kidding? You're SO much fun."
msgstr "Tu plaisantes ? Tu es TELLEMENT drôle."

# Traduction IA – à relire
#: jacques_ship/encounter_three/0/32/s/0
msgctxt "Choix"
msgid "Eh. I might bail. Haven't decided yet."
msgstr "Bof. Je vais peut-être me barrer. Je n'ai pas encore décidé."

# Traduction IA – à relire
#: jacques_ship/encounter_three/0/g-0/0
msgctxt "Jacques"
msgid "Well. In any case."
msgstr "Bien. Quoi qu'il en soit."

# Traduction IA – à relire
#: jacques_ship/encounter_three/0/g-0/8
msgctxt "Jacques"
msgid "I would hope at the least you're not woolheaded enough to put yourself in danger without a good reason."
msgstr "J'espère au moins que tu n'as pas la tête assez creuse pour te mettre en danger sans bonne raison."

# Traduction IA – à relire
#: jacques_ship/encounter_three/0/g-0/16
msgctxt "Jacques"
msgid "And yes, before you ask me, you are absolutely in danger right now, you're around ME, aren't you, don't be a boob."
msgstr "Et oui, avant que tu me poses la question, tu es absolument en danger en ce moment, tu es auprès de MOI, non ? Ne sois pas bête."

# Traduction IA – à relire
#: jacques_ship/encounter_three/0/g-0/24
msgctxt "Jacques"
msgid "So what reason have you for returning to the lair of the beast?"
msgstr "Alors, quelle raison te ramène dans l'antre de la bête ?"

# Traduction IA – à relire
#: jacques_ship/encounter_three/0/g-0/32/s/0
msgctxt "Choix"
msgid "Well, I met a box you might like."
msgstr "Eh bien, j'ai rencontré une boîte qui pourrait te plaire."

# Traduction IA – à relire
#: jacques_ship/encounter_three/0/g-0/33/s/0
msgctxt "Choix"
msgid "Oh, just hoping we can fight/flirt some more."
msgstr "Oh, j'espérais juste qu'on puisse encore se battre / flirter un peu."

# Traduction IA – à relire
#: jacques_ship/encounter_three/0/g-0/34/s/0
msgctxt "Choix"
msgid "Wondering if you're still a berserker, honestly!"
msgstr "Je me demandais si tu étais toujours un berserker, franchement !"

# Traduction IA – à relire
#: jacques_ship/beau/0/0
msgctxt "Jacques"
msgid "HA!"
msgstr "HA !"

# Traduction IA – à relire
#: jacques_ship/beau/0/8
msgctxt "Jacques"
msgid "Still an IDIOT, I see. I like NO ONE!"
msgstr "Toujours en pleine IDIOTIE, je vois. Je n'aime PERSONNE !"

# Traduction IA – à relire
#: jacques_ship/beau/0/16
msgctxt "Jacques"
msgid "I would've thought that to be fairly plain."
msgstr "J'aurais cru que c'était assez évident."

# Traduction IA – à relire
#: jacques_ship/beau/0/24/s/0
msgctxt "Choix"
msgid "Yeah... but this is one tough box."
msgstr "Ouais... mais c'est une boîte coriace."

# Traduction IA – à relire
#: jacques_ship/beau/0/25/s/0
msgctxt "Choix"
msgid "No. No, I got that."
msgstr "Non. Non, ça, j'avais compris."

# Traduction IA – à relire
#: jacques_ship/beau/0/g-0/0
msgctxt "Jacques"
msgid "So what lamb-to-slaughter have you to put forward?"
msgstr "Alors, quel agneau à l'abattoir as-tu à me présenter ?"

# Traduction IA – à relire
#: jacques_ship/beau/0/g-0/8/s/0
msgctxt "Choix"
msgid "Do you know Beau?"
msgstr "Tu connais Beau ?"

# Traduction IA – à relire
#: jacques_ship/beau/0/g-0/9/s/0
msgctxt "Choix"
msgid "Well damn, if you put it that way, maybe I'm gonna save her the trouble!"
msgstr "Eh bien zut, si tu le prends comme ça, je vais peut-être lui épargner la peine !"

# Traduction IA – à relire
#: jacques_ship/beau/0/g-0/c-3/7
msgctxt "Jacques"
msgid "It's a her? A She? A femme demone??"
msgstr "C'est une elle ? Une FEMME ? Une démone ??"

# Traduction IA – à relire
#: jacques_ship/beau/0/g-0/c-3/15/0/s/0
msgctxt "Choix"
msgid "Oh yeah."
msgstr "Oh oui."

# Traduction IA – à relire
#: jacques_ship/beau/0/g-0/c-3/15/1/s/0
msgctxt "Choix"
msgid "She's hot!."
msgstr "Elle est canon !"

# Traduction IA – à relire
#: jacques_ship/beau/0/g-1/0
msgctxt "Jacques"
msgid "You're telling me you've found a female hidden in the recesses of this house who would actually come face to face with the Harried Horror of the Bounding Main?"
msgstr "Tu me dis que tu as déniché, dans les recoins de cette maison, une femme qui oserait se retrouver face à face avec l'Horreur Acharnée des Mers Bondissantes ?"

# Traduction IA – à relire
#: jacques_ship/beau/0/g-1/8/s/0
msgctxt "Choix"
msgid "Girls can be brave, y'know."
msgstr "Les filles peuvent être courageuses, tu sais."

# Traduction IA – à relire
#: jacques_ship/beau/0/g-1/9/s/0
msgctxt "Choix"
msgid "You do name yourself a lot, don't you?"
msgstr "Tu te nommes beaucoup toi-même, non ?"

# Traduction IA – à relire
#: jacques_ship/beau/0/g-1/c-5/7
msgctxt "Jacques"
msgid "I'm fearsome."
msgstr "Je suis redoutable."

# Traduction IA – à relire
#: jacques_ship/beau/0/g-1/c-5/15
msgctxt "Jacques"
msgid "And therefore worth many names."
msgstr "Et donc digne de nombreux noms."

# Traduction IA – à relire
#: jacques_ship/beau/0/g-2/0
msgctxt "Jacques"
msgid "Who?? Who!!! Who am I to meet and do fierce business with?"
msgstr "Qui ?? Qui !!! Qui dois-je rencontrer pour affaires féroces ?"

# Traduction IA – à relire
#: jacques_ship/beau/0/g-2/8/s/0
msgctxt "Choix"
msgid "Jeez, hold your horses. It's Beau!"
msgstr "Oh là, minute. C'est Beau !"

# Traduction IA – à relire
#: jacques_ship/beau/0/beautwo/0
msgctxt "Narrator"
msgid "Jacques is dumbfounded. His mouth opens and closes, his face reddening."
msgstr "Jacques est stupéfait. Sa bouche s'ouvre et se ferme, son visage rougit."

# Traduction IA – à relire
#: jacques_ship/beau/0/beautwo/8
msgctxt "Jacques"
msgid "You..."
msgstr "Tu..."

# Traduction IA – à relire
#: jacques_ship/beau/0/beautwo/24
msgctxt "Jacques"
msgid "WHAT SACRILEGE DO YOU SPOUT AT ME!!!"
msgstr "QUEL SACRILÈGE VIENS-TU DE PROFÉRER !!!"

# Traduction IA – à relire
#: jacques_ship/beau/0/beautwo/38
msgctxt "Jacques"
msgid "Beau isn't fit company for a bilge rat! She is a thief, a pretender, a scallawag, a LOUT!"
msgstr "Beau n'est pas une compagnie fréquentable, même pour un rat de cale ! C'est une voleuse, une usurpatrice, une canaille, une BRUTE !"

# Traduction IA – à relire
#: jacques_ship/beau/0/beautwo/46
msgctxt "Jacques"
msgid "By now you should know how accomplished I am in the art of blind and directionless hatred but Beau tasks my skills to their breaking point."
msgstr "À présent tu devrais savoir à quel point je suis expert en haine aveugle et sans but, mais Beau met mes talents à rude épreuve."

# Traduction IA – à relire
#: jacques_ship/beau/0/beautwo/54
msgctxt "Jacques"
msgid "That is how much I hate her."
msgstr "Voilà à quel point je la hais."

# Traduction IA – à relire
#: jacques_ship/beau/0/beautwo/62
msgctxt "Jacques"
msgid "She has tried to steal from me, MORE THAN ONCE, the single most precious possession of my life."
msgstr "Elle a tenté de me voler, PLUS D'UNE FOIS, la plus précieuse possession de ma vie."

# Traduction IA – à relire
#: jacques_ship/beau/0/beautwo/70/s/0
msgctxt "Choix"
msgid "Whoa. Um. Ok..."
msgstr "Waouh. Euh. Ok..."

# Traduction IA – à relire
#: jacques_ship/beau/0/beautwo/71/s/0
msgctxt "Choix"
msgid "So... you wouldn't want to spend a little bit of time with her, then."
msgstr "Donc... tu ne voudrais pas passer un peu de temps avec elle, alors."

# Traduction IA – à relire
#: jacques_ship/beau/0/g-3/0
msgctxt "Jacques"
msgid "No, no, I- I take that back..."
msgstr "Non, non, je- je retire ce que j'ai dit..."

# Traduction IA – à relire
#: jacques_ship/beau/0/g-3/8
msgctxt "Jacques"
msgid "I would have to be forced to sit through a nice dinner with multiple courses and... have... wine pairings... before I would even CONSIDER doing ANYTHING with Beau."
msgstr "Il faudrait me forcer à subir un bon dîner de plusieurs services avec... des... accords mets-vins... avant que j'envisage ne serait-ce que DE FAIRE QUOI QUE CE SOIT avec Beau."

# Traduction IA – à relire
#: jacques_ship/beau/0/g-3/16/s/0
msgctxt "Choix"
msgid "What if I told you it was an Adventure? Of the highest order?"
msgstr "Et si je te disais que c'est une Aventure ? De la plus haute espèce ?"

# Traduction IA – à relire
#: jacques_ship/beau/0/g-3/17/s/0
msgctxt "Choix"
msgid "But it's an Adventure!"
msgstr "Mais c'est une Aventure !"

# Traduction IA – à relire
#: jacques_ship/beau/0/g-4/8
msgctxt "Jacques"
msgid "An Adventure, you say..."
msgstr "Une Aventure, dis-tu..."

# Traduction IA – à relire
#: jacques_ship/fight_flirt/0/0
msgctxt "Jacques"
msgid "...you want to what?"
msgstr "...tu veux quoi ?"

# Traduction IA – à relire
#: jacques_ship/fight_flirt/0/8/s/0
msgctxt "Choix"
msgid "Fight and flirt at the same time."
msgstr "Se battre et flirter en même temps."

# Traduction IA – à relire
#: jacques_ship/fight_flirt/0/9/s/0
msgctxt "Choix"
msgid "Wanna lick your salty deck, ya rogue."
msgstr "J'ai envie de lécher ton pont salé, vaurien."

# Traduction IA – à relire
#: jacques_ship/fight_flirt/0/g-0/0
msgctxt "Jacques"
msgid "I'm..."
msgstr "Je suis..."

# Traduction IA – à relire
#: jacques_ship/fight_flirt/0/g-0/8
msgctxt "Jacques"
msgid "Of for the love of Davy Phones what nonsense is this?? I am not a flirter."
msgstr "Oh, par l'amour de Davy Phones, quelles sornettes sont-ce là ?? Je ne suis pas un dragueur."

# Traduction IA – à relire
#: jacques_ship/fight_flirt/0/g-0/16
msgctxt "Jacques"
msgid "I do not flirt."
msgstr "Je ne drague pas."

# Traduction IA – à relire
#: jacques_ship/fight_flirt/0/g-0/24
msgctxt "Jacques"
msgid "As far as I'm concerned, flirting is something people do when they haven't the bollocks to get right down to the business of killing!"
msgstr "Pour moi, draguer, c'est ce que font les gens qui n'ont pas les burnes d'en venir directement au vif du sujet, c'est-à-dire tuer !"

# Traduction IA – à relire
#: jacques_ship/fight_flirt/0/g-0/32/s/0
msgctxt "Choix"
msgid "What about foreplay?"
msgstr "Et les préliminaires ?"

# Traduction IA – à relire
#: jacques_ship/fight_flirt/0/g-0/33/s/0
msgctxt "Choix"
msgid "Ah. And kissing?"
msgstr "Ah. Et les baisers ?"

# Traduction IA – à relire
#: jacques_ship/fight_flirt/0/g-0/34/s/0
msgctxt "Choix"
msgid "What about tickling, nibbling, general canoodling?"
msgstr "Et les chatouilles, les mordillements, les câlins en général ?"

# Traduction IA – à relire
#: jacques_ship/fight_flirt/0/g-1/0
msgctxt "Jacques"
msgid "Postponement! And a waste of my time!"
msgstr "Du report ! Et une perte de mon temps !"

# Traduction IA – à relire
#: jacques_ship/fight_flirt/0/g-1/8
msgctxt "Jacques"
msgid "Ye gods, like my time has any value... What am I going to do, brandish my pink plastic fear-poker HARDER? Sail nowhere FASTER? Frighten my own shadow with even more bone-rattling intensity?"
msgstr "Grands dieux, comme si mon temps avait de la valeur... Que vais-je faire, brandir mon tisonnier d'épouvante en plastique rose avec PLUS de force ? Naviguer vers nulle part PLUS VITE ? Effrayer ma propre ombre avec une intensité encore plus glaçante ?"

# Traduction IA – à relire
#: jacques_ship/fight_flirt/0/g-1/16
msgctxt "Jacques"
msgid "Even thinking about how useless I am lights the fires of demonic rage in my sun-charred heart!"
msgstr "Rien que de penser à mon inutilité, j'allume les feux d'une rage démoniaque dans mon coeur brûlé de soleil !"

# Traduction IA – à relire
#: jacques_ship/fight_flirt/0/g-1/24
msgctxt "Jacques"
msgid "If rage is my companion, nemesis and bedfellow, might as well get down to it and follow where the blazing ire leads!"
msgstr "Si la rage est ma compagne, ma nemesis et ma bonne amie de lit, autant s'y mettre et suivre où mène cette ire flamboyante !"

# Traduction IA – à relire
#: jacques_ship/fight_flirt/0/g-1/32/s/0
msgctxt "Choix"
msgid "Damn. See? This is what I'm lookin' for!"
msgstr "Zut. Tu vois ? C'est exactement ce que je cherche !"

# Traduction IA – à relire
#: jacques_ship/fight_flirt/0/g-1/33/s/0
msgctxt "Choix"
msgid "You delicious little hate nugget. Say more things."
msgstr "Petite pépite de haine délicieuse. Dis-en d'autres."

# Traduction IA – à relire
#: jacques_ship/fight_flirt/0/g-2/0
msgctxt "Jacques"
msgid "What madness possesses you??"
msgstr "Quelle folie te possède ??"

# Traduction IA – à relire
#: jacques_ship/fight_flirt/0/g-2/8
msgctxt "Jacques"
msgid "Stop it at once, I say!"
msgstr "Cesse immédiatement, je te l'ordonne !"

# Traduction IA – à relire
#: jacques_ship/fight_flirt/0/g-2/16
msgctxt "Jacques"
msgid "Do not think that because I didn't kill you the first time we met, that I am above doing so now!"
msgstr "Ne crois pas que parce que je ne t'ai pas tué la première fois, je ne m'abaisserais pas à le faire maintenant !"

# Traduction IA – à relire
#: jacques_ship/fight_flirt/0/g-2/24/s/0
msgctxt "Choix"
msgid "I'm really hoping you'll try..."
msgstr "J'espère vraiment que tu vas essayer..."

# Traduction IA – à relire
#: jacques_ship/fight_flirt/0/g-2/25/s/0
msgctxt "Choix"
msgid "Bring it on, my tiny tyrant!"
msgstr "Viens, mon petit tyran !"

# Traduction IA – à relire
#: jacques_ship/fight_flirt/0/g-3/0
msgctxt "Narrator"
msgid "Jacques looks at you as though seeing you for the first time—you're not quite certain if that's disgust in his gaze or admiration."
msgstr "Jacques vous regarde comme s'il vous voyait pour la première fois. Impossible de dire si c'est du dégoût ou de l'admiration dans son regard."

# Traduction IA – à relire
#: jacques_ship/fight_flirt/0/g-3/8
msgctxt "Jacques"
msgid "Dear Sweet Davy Phones."
msgstr "Cher et doux Davy Phones."

# Traduction IA – à relire
#: jacques_ship/fight_flirt/0/g-3/16
msgctxt "Jacques"
msgid "In a hundred thousand turns of the stars, it would never have occurred to me that there existed someone more deranged than myself..."
msgstr "En cent mille révolutions des étoiles, il ne m'aurait jamais traversé l'esprit qu'il existât quelqu'un de plus dérangé que moi..."

# Traduction IA – à relire
#: jacques_ship/fight_flirt/0/g-3/24
msgctxt "Jacques"
msgid "And yet here you are."
msgstr "Et pourtant te voilà."

# Traduction IA – à relire
#: jacques_ship/fight_flirt/0/g-3/32
msgctxt "Jacques"
msgid "It seems I must come up with another way to frighten you out of me harbor..."
msgstr "Il semble que je doive trouver un autre moyen de te faire fuir de mon port..."

# Traduction IA – à relire
#: jacques_ship/fight_flirt/0/g-3/40
msgctxt "Jacques"
msgid "Ha! What an excellent opportunity you've provided me to use my cunning intellect!"
msgstr "Ha ! Quelle excellente occasion tu m'offres d'user de ma redoutable intelligence !"

# Traduction IA – à relire
#: jacques_ship/fight_flirt/0/g-3/48/s/0
msgctxt "Choix"
msgid "Why do you want me to leave so badly?"
msgstr "Pourquoi tiens-tu tant à ce que je parte ?"

# Traduction IA – à relire
#: jacques_ship/fight_flirt/0/g-3/49/s/0
msgctxt "Choix"
msgid "Oh god, I'd forgotten about your BRAIN...!"
msgstr "Oh mon dieu, j'avais oublié ton CERVEAU...!"

# Traduction IA – à relire
#: jacques_ship/fight_flirt/0/g-4/0
msgctxt "Jacques"
msgid "If I cannot dissuade you with violence, I must use guile! Heheheheh..."
msgstr "Si je ne puis te dissuader par la violence, je dois user de ruse ! Hehehehe..."

# Traduction IA – à relire
#: jacques_ship/fight_flirt/0/g-4/8
msgctxt "Jacques"
msgid "I have already begun, by whispering this revelation to myself instead of speaking it aloud at full volume! It is impossible that you could hear my whisper! I am indeed a genius."
msgstr "J'ai déjà commencé, en me murmurant cette révélation à moi-même au lieu de la déclamer à pleine voix ! Il est impossible que tu entendes mon murmure ! Je suis décidément un génie."

# Traduction IA – à relire
#: jacques_ship/fight_flirt/0/g-4/16
msgctxt "Jacques"
msgid "I can think of one way, and only one way for us to be together in the..."
msgstr "Je ne vois qu'une façon, une seule, pour nous d'être ensemble dans le..."

# Traduction IA – à relire
#: jacques_ship/fight_flirt/0/g-4/24
msgctxt "Jacques"
msgid "The way you wish. The... way you seem to be implying with your words and your..."
msgstr "À ta façon. La... façon que tu sembles sous-entendre par tes paroles et par tes..."

# Traduction IA – à relire
#: jacques_ship/fight_flirt/0/g-4/32
msgctxt "Jacques"
msgid "...gyrating."
msgstr "...déhanchements."

# Traduction IA – à relire
#: jacques_ship/fight_flirt/0/g-4/40/s/0
msgctxt "Choix"
msgid "Thank Poseidon, tell me!"
msgstr "Merci Poséidon, dis-moi !"

# Traduction IA – à relire
#: jacques_ship/fight_flirt/0/g-4/41/s/0
msgctxt "Choix"
msgid "I knew you'd come UP with something."
msgstr "Je savais que tu trouverais quelque chose qui TIENNE DEBOUT."

# Traduction IA – à relire
#: jacques_ship/berserker/0/0
msgctxt "Jacques"
msgid "Berserker!"
msgstr "Berserker !"

# Traduction IA – à relire
#: jacques_ship/berserker/0/8
msgctxt "Jacques"
msgid "My god what a glorious new mantle to place around my burdened and bull-like shoulders!"
msgstr "Mon dieu, quel glorieux manteau neuf à poser sur mes épaules taurines et accablées !"

# Traduction IA – à relire
#: jacques_ship/berserker/0/16
msgctxt "Jacques"
msgid "I am indeed a BERSERKER."
msgstr "Je suis bel et bien un BERSERKER."

# Traduction IA – à relire
#: jacques_ship/berserker/0/24
msgctxt "Jacques"
msgid "And should you have any misapprehensions that I will cease to be so, allow me to put your mind at ease..."
msgstr "Et si tu nourris la moindre illusion que je cesserai de l'être, permets-moi de te rassurer..."

# Traduction IA – à relire
#: jacques_ship/berserker/0/32
msgctxt "Jacques"
msgid "I shall only become more berserk, more insane, more rabid as time goes on. Should you scurry away yet again and return in a day, a week, a month..."
msgstr "Je ne deviendrai que plus berserk, plus fou, plus enragé avec le temps. Si tu détales encore une fois et reviens dans un jour, une semaine, un mois..."

# Traduction IA – à relire
#: jacques_ship/berserker/0/40
msgctxt "Jacques"
msgid "...you should find me even MORE SO myself than the dreadful delight you see before you!"
msgstr "...tu me trouveras PLUS ENCORE moi-même que le terrible ravissement que tu vois devant toi !"

# Traduction IA – à relire
#: jacques_ship/berserker/0/48/s/0
msgctxt "Choix"
msgid "Yeah. I was afraid you were gonna say that."
msgstr "Ouais. Je craignais que tu dises ça."

# Traduction IA – à relire
#: jacques_ship/berserker/0/49/s/0
msgctxt "Choix"
msgid "Fantastic. Just checking."
msgstr "Fantastique. Je vérifiais."

# Traduction IA – à relire
#: jacques_ship/berserker/0/g-0/0
msgctxt "Jacques"
msgid "In fact, ye've just given me an idea."
msgstr "D'ailleurs, tu viens de me donner une idée."

# Traduction IA – à relire
#: jacques_ship/berserker/0/g-0/8
msgctxt "Jacques"
msgid "Ah yes, the fear scuds across your coward's mug the way a wisp of cloud tries to hide from a blazing sun!"
msgstr "Ah oui, la peur file sur ta face de poltron comme un filet de nuage qui tente de se cacher d'un soleil ardent !"

# Traduction IA – à relire
#: jacques_ship/berserker/0/g-0/16
msgctxt "Jacques"
msgid "You will go. You will leave me and you will find me a gift."
msgstr "Tu vas partir. Tu vas me quitter et tu vas me trouver un cadeau."

# Traduction IA – à relire
#: jacques_ship/berserker/0/g-0/24/s/0
msgctxt "Choix"
msgid "Wait, what?"
msgstr "Attends, quoi ?"

# Traduction IA – à relire
#: jacques_ship/berserker/0/g-0/25/s/0
msgctxt "Choix"
msgid "Ooh, can it be a macaroni necklace?"
msgstr "Ooh, ça peut être un collier de macaronis ?"

# Traduction IA – à relire
#: jacques_ship/berserker/0/g-0/26/s/0
msgctxt "Choix"
msgid "I'm not giving you a damn thing."
msgstr "Je ne te donnerai rien du tout."

# Traduction IA – à relire
#: jacques_ship/berserker/0/g-1/0
msgctxt "Jacques"
msgid "A gift, I say!! The only gift that would ever matter to me..."
msgstr "Un cadeau, te dis-je !! Le seul cadeau qui compterait jamais pour moi..."

# Traduction IA – à relire
#: jacques_ship/berserker/0/g-1/8
msgctxt "Jacques"
msgid "You will find me an adventure, a great expedition worthy of this BERSERKER in boots!"
msgstr "Tu vas me trouver une aventure, une grande expédition digne de ce BERSERKER en bottes !"

# Traduction IA – à relire
#: jacques_ship/adventure_or_nothing/0/0
msgctxt "Jacques"
msgid "Adventure!"
msgstr "L'aventure !"

# Traduction IA – à relire
#: jacques_ship/adventure_or_nothing/0/8
msgctxt "Jacques"
msgid "To any question it is the answer, to any loss it is the finding, to any rage it is the balm that creates the beautiful destruction and so assuages the soul-deep burn of unmet ire!"
msgstr "À toute question elle est la réponse, à toute perte elle est la trouvaille, à toute rage elle est le baume qui engendre la belle destruction et apaise ainsi la brûlure profonde de l'ire inassouvie !"

# Traduction IA – à relire
#: jacques_ship/adventure_or_nothing/0/16
msgctxt "Jacques"
msgid "Bring this adventure back to me. Find it, or mold it from your own flimsy, cake-soft fingers and bring it here."
msgstr "Rapporte-moi cette aventure. Trouve-la, ou façonne-la de tes doigts flasques et mous comme du gâteau, et apporte-la ici."

# Traduction IA – à relire
#: jacques_ship/adventure_or_nothing/0/24
msgctxt "Jacques"
msgid "Return without it and face my wrath!"
msgstr "Reviens sans elle et affronte mon courroux !"

# Traduction IA – à relire
#: jacques_ship/adventure_or_nothing/0/32
msgctxt "Jacques"
msgid "Return with an adventure unworthy... and there will be wrath... but also mockery."
msgstr "Reviens avec une aventure indigne... et il y aura du courroux... mais aussi des moqueries."

# Traduction IA – à relire
#: jacques_ship/adventure_or_nothing/0/40
msgctxt "Jacques"
msgid "That's right. You have mocked me... and I shall mock you. The patch will cover the other eye, and we shall see how long it takes your gelatinous self-respect to melt to goo!"
msgstr "C'est cela. Tu as ri à mes dépens... et je rirai aux tiens. Le bandeau couvrira l'autre oeil, et nous verrons combien de temps met ton amour-propre gélatineux à fondre en bouillie !"

# Traduction IA – à relire
#: jacques_ship/adventure_or_nothing/0/48/s/0
msgctxt "Choix"
msgid "Cool. I'll just.. I'll be back."
msgstr "Cool. Je vais juste... je reviens."

# Traduction IA – à relire
#: jacques_ship/adventure_or_nothing/0/49/s/0
msgctxt "Choix"
msgid "Anything you say, nugget!"
msgstr "Comme tu voudras, pépite !"

# Traduction IA – à relire
#: jacques_ship/adventure_or_nothing/0/50/s/0
msgctxt "Choix"
msgid "Ha! Love it. Don't get too comfortable!"
msgstr "Ha ! J'adore. Ne t'installe pas trop !"

# Traduction IA – à relire
#: jacques_ship/keep_looking/0/0
msgctxt "Jacques"
msgid "You?"
msgstr "Toi ?"

# Traduction IA – à relire
#: jacques_ship/keep_looking/0/8
msgctxt "Jacques"
msgid "But why."
msgstr "Mais pourquoi."

# Traduction IA – à relire
#: jacques_ship/keep_looking/0/16
msgctxt "Jacques"
msgid "Was I not clear?"
msgstr "N'étais-je pas clair ?"

# Traduction IA – à relire
#: jacques_ship/keep_looking/0/24
msgctxt "Jacques"
msgid "Have you returned without my adventure?"
msgstr "Est-ce un retour sans mon aventure ?"

# Traduction IA – à relire
#: jacques_ship/keep_looking/0/32
msgctxt "Jacques"
msgid "Or have you returned with an adventure so puny, so inconsequential that it can hide in those stupid, tight little afterthoughts you call pockets?"
msgstr "Ou m'apportes-tu une aventure si minuscule, si insignifiante qu'elle peut se cacher dans ces stupides petits appendices serrés que tu appelles poches ?"

# Traduction IA – à relire
#: jacques_ship/keep_looking/0/40/s/0
msgctxt "Choix"
msgid "Are you seriously insulting POCKETS right now?"
msgstr "Tu insultes sérieusement les POCHES, là ?"

# Traduction IA – à relire
#: jacques_ship/keep_looking/0/41/s/0
msgctxt "Choix"
msgid "I don't have it yet, but I promise I'm looking!"
msgstr "Je ne l'ai pas encore, mais je te promets que je cherche !"

# Traduction IA – à relire
#: jacques_ship/keep_looking/0/42/s/0
msgctxt "Choix"
msgid "Oh crap, right, I forgot about that..."
msgstr "Oh zut, c'est vrai, j'avais oublié..."

# Traduction IA – à relire
#: jacques_ship/keep_looking/0/43/s/0
msgctxt "Choix"
msgid "Actually, I deliberately removed the potential for adventure!"
msgstr "En fait, j'ai délibérément supprimé tout potentiel d'aventure !"

# Traduction IA – à relire
#: jacques_ship/keep_looking/0/c-0/7
msgctxt "Jacques"
msgid "Nothing is safe from my whip-crack dissatisfaction..."
msgstr "Rien n'échappe à mon mécontentement qui claque comme un fouet..."

# Traduction IA – à relire
#: jacques_ship/keep_looking/0/c-3/7
msgctxt "Jacques"
msgid "You... you what?"
msgstr "Tu... tu quoi ?"

# Traduction IA – à relire
#: jacques_ship/keep_looking/0/c-3/15
msgctxt "Jacques"
msgid "Well... I think I did feel that happen."
msgstr "Eh bien... je crois bien avoir senti ça."

# Traduction IA – à relire
#: jacques_ship/keep_looking/0/c-3/23 jacques_ship/jacques_no_quest_endings/0/16
msgctxt "Jacques"
msgid "In fact... I felt... a cracking in the air... distantly."
msgstr "En fait... j'ai senti... un craquement dans l'air... au loin."

# Traduction IA – à relire
#: jacques_ship/keep_looking/0/c-3/31 jacques_ship/jacques_no_quest_endings/0/24
msgctxt "Jacques"
msgid "The sound of a potential adventure broken."
msgstr "Le bruit d'une aventure potentielle brisée."

# Traduction IA – à relire
#: jacques_ship/keep_looking/0/c-3/39/0/s/0
msgctxt "Choix"
msgid "That was me!"
msgstr "C'était moi !"

# Traduction IA – à relire
#: jacques_ship/keep_looking/0/c-3/39/1/s/0
msgctxt "Choix"
msgid "Yeah... sorry..."
msgstr "Ouais... {{désolé|désolée|désolé·e}}..."

# Traduction IA – à relire
#: jacques_ship/keep_looking/0/c-3/39/g-0/0 jacques_ship/jacques_no_quest_endings/0/c-0/23
msgctxt "Jacques"
msgid "I feel there is little hope for any more adventures of that kind 'round this domicile."
msgstr "Je crains qu'il n'y ait plus guère d'espoir pour d'autres aventures de ce genre dans ce domicile."

# Traduction IA – à relire
#: jacques_ship/keep_looking/0/c-3/39/g-0/8 jacques_ship/jacques_no_quest_endings/0/c-0/31
msgctxt "Jacques"
msgid "So I bid you adieu."
msgstr "Alors je te dis adieu."

# Traduction IA – à relire
#: jacques_ship/keep_looking/0/g-0/0
msgctxt "Jacques"
msgid "Come back without it again... and you will beg for the release of the Locker before I have done..."
msgstr "Reviens encore sans elle... et tu supplieras qu'on te libère dans le Coffre avant que j'aie fini..."

# Traduction IA – à relire
#: jacques_ship/quick_encounter_five/0/0
msgctxt "Jacques"
msgid "Well. I've not felt quite this elevated since... my god, since I can remember!"
msgstr "Eh bien. Je ne me suis pas senti aussi exalté depuis... mon dieu, depuis que je m'en souvienne !"

# Traduction IA – à relire
#: jacques_ship/quick_encounter_five/0/8
msgctxt "Jacques"
msgid "What a jape, what a rip-roaring ramble through daring, danger, death and great deeds!"
msgstr "Quelle farce, quelle chevauchée fracassante à travers l'audace, le danger, la mort et les hauts faits !"

# Traduction IA – à relire
#: jacques_ship/quick_encounter_five/0/16
msgctxt "Jacques"
msgid "Have you seen? Have you noticed?"
msgstr "As-tu vu ? As-tu remarqué ?"

# Traduction IA – à relire
#: jacques_ship/quick_encounter_five/0/24
msgctxt "Jacques"
msgid "Shield your eyes if you must..."
msgstr "Protège tes yeux si nécessaire..."

# Traduction IA – à relire
#: jacques_ship/quick_encounter_five/0/32
msgctxt "Jacques"
msgid "I am <w>MOBILE!</w>"
msgstr "Je suis <w>MOBILE !</w>"

# Traduction IA – à relire
#: jacques_ship/quick_encounter_five/0/49
msgctxt "Narrator"
msgid "A mass of cockroaches dressed as pirates and armed with cocktail swords materialize from seemingly nowhere, brandishing their weapons at you."
msgstr "Une horde de cafards déguisés en pirates et armés d'épées à cocktail se matérialise de nulle part en brandissant ses armes vers vous."

# Traduction IA – à relire
#: jacques_ship/quick_encounter_five/0/57/s/0
msgctxt "Choix"
msgid "Oh my god, is that the cockroach army??"
msgstr "Oh mon dieu, c'est l'armée de cafards ??"

# Traduction IA – à relire
#: jacques_ship/quick_encounter_five/0/58/s/0
msgctxt "Choix"
msgid "You can go anywhere you want?"
msgstr "Tu peux aller où tu veux ?"

# Traduction IA – à relire
#: jacques_ship/quick_encounter_five/0/g-0/0
msgctxt "Jacques"
msgid "Indeed! Haha!!"
msgstr "En effet ! Haha !!"

# Traduction IA – à relire
#: jacques_ship/quick_encounter_five/0/g-0/8
msgctxt "Jacques"
msgid "My new friends here are really quite amenable, and exceedingly well-disciplined."
msgstr "Mes nouveaux amis sont fort accommodants, et d'une discipline exemplaire."

# Traduction IA – à relire
#: jacques_ship/quick_encounter_five/0/g-0/16
msgctxt "Jacques"
msgid "All I need do is issue the command and they muster, en masse beneath my bottle and then we're off!"
msgstr "Il me suffit de donner l'ordre et ils se rassemblent en masse sous ma bouteille, et nous voilà partis !"

# Traduction IA – à relire
#: jacques_ship/quick_encounter_five/0/g-0/24
msgctxt "Jacques"
msgid "Do you know since we returned from our great expedition, I have been to the kitchen, the bathroom and the foot of the stairs?!"
msgstr "Sais-tu que depuis notre retour de la grande expédition, j'ai visité la cuisine, la salle de bains et le pied de l'escalier ?!"

# Traduction IA – à relire
#: jacques_ship/quick_encounter_five/0/g-0/32
msgctxt "Jacques"
msgid "I am unstoppable! I'm a force!"
msgstr "Je suis inarrêtable ! Je suis une force !"

# Traduction IA – à relire
#: jacques_ship/quick_encounter_five/0/g-0/40
msgctxt "Jacques"
msgid "And when we do stop, to drink rum and swap wild tales of our exploits, I find I quite enjoy their humor."
msgstr "Et quand nous faisons halte pour boire du rhum et échanger des récits fous de nos exploits, je constate que j'apprécie fort leur humour."

# Traduction IA – à relire
#: jacques_ship/quick_encounter_five/0/g-0/48
msgctxt "Jacques"
msgid "I believe that as a species they may have gotten a somewhat undeservedly poor reputation. They're quite funny."
msgstr "Je crois que, en tant qu'espèce, ils se sont attiré une mauvaise réputation quelque peu imméritée. Ils sont très drôles."

# Traduction IA – à relire
#: jacques_ship/quick_encounter_five/0/g-0/56/s/0
msgctxt "Choix"
msgid "They're dirty."
msgstr "Ils sont sales."

# Traduction IA – à relire
#: jacques_ship/quick_encounter_five/0/g-0/57/s/0
msgctxt "Choix"
msgid "They're terrifying."
msgstr "Ils sont terrifiants."

# Traduction IA – à relire
#: jacques_ship/quick_encounter_five/0/g-0/58/s/0
msgctxt "Choix"
msgid "They're HUGE."
msgstr "Ils sont ÉNORMES."

# Traduction IA – à relire
#: jacques_ship/quick_encounter_five/0/g-1/0
msgctxt "Jacques"
msgid "Oh yes yes, quite. Quite true."
msgstr "Oh oui oui, tout à fait. Tout à fait vrai."

# Traduction IA – à relire
#: jacques_ship/quick_encounter_five/0/g-1/8
msgctxt "Jacques"
msgid "But they're... funny."
msgstr "Mais ils sont... drôles."

# Traduction IA – à relire
#: jacques_ship/quick_encounter_five/0/g-1/16
msgctxt "Jacques"
msgid "And after all, couldn't the same things be said about me?"
msgstr "Et après tout, ne pourrait-on pas en dire autant de moi ?"

# Traduction IA – à relire
#: jacques_ship/quick_encounter_five/0/g-1/27/b/1
msgctxt "Jacques"
msgid "With the possible exception of \"huge\"... although, in recent days, I've begun to think that perhaps there might be some advantages to how I am sized."
msgstr "À l'exception possible d'« énormes »... quoique, ces derniers jours, j'ai commencé à penser que ma taille pourrait peut-être présenter certains avantages."

# Traduction IA – à relire
#: jacques_ship/quick_encounter_five/0/g-1/30
msgctxt "Jacques"
msgid "But enough of this tomfoolery! What brings you back to the foot of the Ocean's Own Overthrow?"
msgstr "Mais assez de balivernes ! Qu'est-ce qui te ramène au pied du Renversement de l'Océan lui-même ?"

# Traduction IA – à relire
#: jacques_ship/quick_encounter_five/0/g-1/38/s/0
msgctxt "Choix"
msgid "Wanted to see if you were still weak enough to get hurt when I make fun of you."
msgstr "Je voulais voir si tu étais toujours assez faible pour être blessé quand je me moque de toi."

# Traduction IA – à relire
#: jacques_ship/quick_encounter_five/0/g-1/39/s/0
msgctxt "Choix"
msgid "I still don't get your self-naming... but I just wanted to say hi!"
msgstr "Je ne comprends toujours pas pourquoi tu te nommes toi-même... mais je voulais juste dire coucou !"

# Traduction IA – à relire
#: jacques_ship/quick_encounter_five/0/g-1/40/s/0
msgctxt "Choix"
msgid "Are you kidding? I'm here to claim the heart of a pirate."
msgstr "Tu plaisantes ? Je suis là pour conquérir le coeur d'un pirate."

# Traduction IA – à relire
#: jacques_ship/jacques_before_quest/0
msgctxt "Jacques"
msgid "Here? The mantelpiece?"
msgstr "Ici ? Sur la cheminée ?"

# Traduction IA – à relire
#: jacques_ship/jacques_before_quest/8
msgctxt "Jacques"
msgid "No... we need to meet at the boxes."
msgstr "Non... il nous faut nous retrouver auprès des boîtes."

# Traduction IA – à relire
#: jacques_ship/jacques_before_quest/16
msgctxt "Jacques"
msgid "So many of them... just one of me."
msgstr "Il y en a tant... et un seul de moi."

# Traduction IA – à relire
#: jacques_ship/jacques_before_quest/24
msgctxt "Jacques"
msgid "Quality! Not quantity...."
msgstr "La qualité ! Pas la quantité...."

# Traduction IA – à relire
#: jacques_ship/hate_ending_one/0/0
msgctxt "Jacques"
msgid "Truly."
msgstr "Vraiment."

# Traduction IA – à relire
#: jacques_ship/hate_ending_one/0/8
msgctxt "Jacques"
msgid "You've disrupted me for <i>that</i>."
msgstr "Tu m'as dérangé pour <i>ça</i>."

# Traduction IA – à relire
#: jacques_ship/hate_ending_one/0/16
msgctxt "Jacques"
msgid "To see if you could hurt me."
msgstr "Pour voir si tu pouvais me blesser."

# Traduction IA – à relire
#: jacques_ship/hate_ending_one/0/24
msgctxt "Jacques"
msgid "HAVE WE MET?!"
msgstr "ON SE CONNAÎT ?!"

# Traduction IA – à relire
#: jacques_ship/hate_ending_one/0/32/s/0
msgctxt "Choix"
msgid "Now you say it, that's kinda mean of me. Nevermind."
msgstr "Maintenant que tu le dis, c'est assez méchant de ma part. Oublie."

# Traduction IA – à relire
#: jacques_ship/hate_ending_one/0/33/s/0
msgctxt "Choix"
msgid "Yeah we have. I remember a time when you were pretty flimsy, actually."
msgstr "Si, on se connaît. Je me souviens d'une époque où tu étais plutôt fragile, d'ailleurs."

# Traduction IA – à relire
#: jacques_ship/hate_ending_one/0/c-0/7
msgctxt "Jacques"
msgid "Nevermind, is it?"
msgstr "Oublie, hein ?"

# Traduction IA – à relire
#: jacques_ship/hate_ending_one/0/c-0/15
msgctxt "Jacques"
msgid "Oh, I see! You believe you can back off of this path. You think somehow, in your distorted brain, that I will forgive, or forget..."
msgstr "Oh, je vois ! Tu crois pouvoir faire marche arrière. Tu t'imagines, dans ton cerveau tordu, que je pardonnerai, ou que j'oublierai..."

# Traduction IA – à relire
#: jacques_ship/hate_ending_one/0/c-0/23
msgctxt "Jacques"
msgid "... or release you from the bind into which you've placed your own scrawny, gruel-gulping throat!"
msgstr "... ou que je te libérerai du piège dans lequel tu as toi-même fourré ta gorge maigrichonne avale-gruau !"

# Traduction IA – à relire
#: jacques_ship/hate_ending_one/0/c-0/31
msgctxt "Jacques"
msgid "Well I won't."
msgstr "Eh bien non."

# Traduction IA – à relire
#: jacques_ship/hate_ending_one/0/c-0/39
msgctxt "Jacques"
msgid "I am not any kind of fool. Least of all the kind who would turn his back on an enemy so witlessly and brazenly declared!"
msgstr "Je ne suis pas un sot. Surtout pas de ceux qui tourneraient le dos à un ennemi aussi bêtement et effrontément déclaré !"

# Traduction IA – à relire
#: jacques_ship/hate_ending_one/0/c-0/47
msgctxt "Jacques"
msgid "Get out. Flee if you can, live in the shadows and fear the penetrating sun of my gaze."
msgstr "Dehors. Fuis si tu le peux, vis dans l'ombre et crains le soleil perçant de mon regard."

# Traduction IA – à relire
#: jacques_ship/hate_ending_one/0/c-0/55
msgctxt "Jacques"
msgid "Should it fall upon you again, your roasting will be slow. And of a vomitous stink."
msgstr "S'il retombe sur toi, ton rôtissage sera lent. Et d'une puanteur à vomir."

# Traduction IA – à relire
#: jacques_ship/hate_ending_one/0/c-1/7
msgctxt "Jacques"
msgid "How dare you. You would throw a moment of quietude back in my face."
msgstr "Comment oses-tu. Tu voudrais me jeter à la figure un instant de quiétude."

# Traduction IA – à relire
#: jacques_ship/hate_ending_one/0/c-1/15
msgctxt "Jacques"
msgid "You would dare the Unleashing to attempt to, what, blackmail me?"
msgstr "Tu oserais défier le Déchaînement pour tenter de, quoi, me faire chanter ?"

# Traduction IA – à relire
#: jacques_ship/hate_ending_one/0/c-1/23/0/s/0
msgctxt "Choix"
msgid "No. No blackmail. It was fun to see you shamed, for once."
msgstr "Non. Pas de chantage. C'était amusant de te voir humilié, pour une fois."

# Traduction IA – à relire
#: jacques_ship/hate_ending_one/0/c-1/23/1/s/0
msgctxt "Choix"
msgid "Yup. I dare. You're about as scary as a dead leaf."
msgstr "Ouais. J'ose. Tu fais à peu près aussi peur qu'une feuille morte."

# Traduction IA – à relire
#: jacques_ship/hate_ending_one/0/g-0/0
msgctxt "Jacques"
msgid "Why. You insolent, black-hearted, knave of no nation!"
msgstr "Pourquoi. Petit insolent au coeur noir, gredin sans patrie !"

# Traduction IA – à relire
#: jacques_ship/hate_ending_one/0/g-0/8/s/0
msgctxt "Choix"
msgid "Isn't that what you call yourself?"
msgstr "N'est-ce pas ainsi que tu te nommes toi-même ?"

# Traduction IA – à relire
#: jacques_ship/hate_ending_one/0/g-0/9/s/0
msgctxt "Choix"
msgid "Lay it on. This is better than stand-up."
msgstr "Vas-y, continue. C'est mieux que du stand-up."

# Traduction IA – à relire
#: jacques_ship/hate_ending_one/0/g-1/0
msgctxt "Jacques"
msgid "You're... you're enjoying this?"
msgstr "Tu... tu t'amuses ?"

# Traduction IA – à relire
#: jacques_ship/hate_ending_one/0/g-1/8/s/0
msgctxt "Choix"
msgid "Sure am! It's fun to see a fly squirm."
msgstr "Et comment ! C'est drôle de voir une mouche se tortiller."

# Traduction IA – à relire
#: jacques_ship/hate_ending_one/0/g-1/9/s/0
msgctxt "Choix"
msgid "Nah, not really. I'm bored now. Gonna head out."
msgstr "Bof, pas vraiment. Je m'ennuie maintenant. Je file."

# Traduction IA – à relire
#: jacques_ship/hate_ending_one/0/g-1/c-5/7
msgctxt "Jacques"
msgid "You do that."
msgstr "Fais donc."

# Traduction IA – à relire
#: jacques_ship/hate_ending_one/0/g-1/c-5/15
msgctxt "Jacques"
msgid "Take your head and get out."
msgstr "Prends ta tête et dehors."

# Traduction IA – à relire
#: jacques_ship/hate_ending_one/0/g-1/c-5/23
msgctxt "Jacques"
msgid "Don't you dare come back."
msgstr "Ne t'avise pas de revenir."

# Traduction IA – à relire
#: jacques_ship/hate_ending_two/0/0
msgctxt "Jacques"
msgid "I am no fly!"
msgstr "Je ne suis pas une mouche !"

# Traduction IA – à relire
#: jacques_ship/hate_ending_two/0/8/s/0
msgctxt "Choix"
msgid "Oh? The sizing is right."
msgstr "Oh ? La taille correspond."

# Traduction IA – à relire
#: jacques_ship/hate_ending_two/0/9/s/0
msgctxt "Choix"
msgid "Sure you are! Small, stupid, annoying."
msgstr "Bien sûr que si ! Petit, stupide, agaçant."

# Traduction IA – à relire
#: jacques_ship/hate_ending_two/0/10/s/0
msgctxt "Choix"
msgid "Right. You're not a fly. Notice we had to check, though."
msgstr "D'accord. Tu n'es pas une mouche. Mais remarque qu'on a dû vérifier."

# Traduction IA – à relire
#: jacques_ship/hate_ending_two/0/g-0/0
msgctxt "Jacques"
msgid "Why... with what deluded notions of self do you come here and treat me this way?"
msgstr "Pourquoi... avec quelles idées délirantes sur toi-même viens-tu ici me traiter de la sorte ?"

# Traduction IA – à relire
#: jacques_ship/hate_ending_two/0/g-0/8
msgctxt "Jacques"
msgid "How dare you? Give me a reason!"
msgstr "Comment oses-tu ? Donne-moi une raison !"

# Traduction IA – à relire
#: jacques_ship/hate_ending_two/0/g-0/16/s/0
msgctxt "Choix"
msgid "I'm more of an instinct person, myself."
msgstr "Moi, je suis plutôt du genre instinctif."

# Traduction IA – à relire
#: jacques_ship/hate_ending_two/0/g-0/17/s/0 jacques_ship/secret_sword/0/g-5/c-11/47/c-0/47/c-0/39/0/s/0
msgctxt "Choix"
msgid "No."
msgstr "Non."

# Traduction IA – à relire
#: jacques_ship/hate_ending_two/0/g-1/0
msgctxt "Jacques"
msgid "Cruelty for no reason. Cruelty without glory, cruelty without overwhelming and implaccable rage, cold cruelty."
msgstr "De la cruauté sans raison. De la cruauté sans gloire, de la cruauté sans rage écrasante et implacable, une cruauté froide."

# Traduction IA – à relire
#: jacques_ship/hate_ending_two/0/g-1/8
msgctxt "Jacques"
msgid "There are names for people like you, names that we of honor do not dignify with breath."
msgstr "Il existe des noms pour les gens de ton espèce, des noms que nous autres hommes d'honneur ne daignons pas prononcer."

# Traduction IA – à relire
#: jacques_ship/hate_ending_two/0/g-1/16
msgctxt "Jacques"
msgid "Blighter. Tormentor. Coward."
msgstr "Scélérat. Bourreau. Poltron."

# Traduction IA – à relire
#: jacques_ship/hate_ending_two/0/g-1/24/s/0
msgctxt "Choix"
msgid "Ha! This is you fighting back?"
msgstr "Ha ! C'est ça, ta riposte ?"

# Traduction IA – à relire
#: jacques_ship/hate_ending_two/0/g-1/25/s/0
msgctxt "Choix"
msgid "What happened to you?"
msgstr "Qu'est-ce qui t'est arrivé ?"

# Traduction IA – à relire
#: jacques_ship/hate_ending_two/0/g-2/0
msgctxt "Jacques"
msgid "I...."
msgstr "Je...."

# Traduction IA – à relire
#: jacques_ship/hate_ending_two/0/g-2/8
msgctxt "Jacques"
msgid "Dammit I don't understand. Before that bloody quest, I would have shredded you! I would've played targets on your organs and laughed as your blood painted the glass of this bottle!"
msgstr "Bon sang, je ne comprends pas. Avant cette maudite quête, je t'aurais mis en lambeaux ! J'aurais joué aux fléchettes sur tes organes et j'aurais ri en regardant ton sang peindre la paroi de cette bouteille !"

# Traduction IA – à relire
#: jacques_ship/hate_ending_two/0/g-2/16
msgctxt "Jacques"
msgid "Something has happened to me."
msgstr "Quelque chose m'est arrivé."

# Traduction IA – à relire
#: jacques_ship/hate_ending_two/0/g-2/24
msgctxt "Jacques"
msgid "I was a fool. I left the sanctum, I met, I trusted, I tried..."
msgstr "J'ai été un sot. J'ai quitté le sanctuaire, j'ai rencontré, j'ai fait confiance, j'ai essayé..."

# Traduction IA – à relire
#: jacques_ship/hate_ending_two/0/g-2/32
msgctxt "Jacques"
msgid "And it has weakened me. I am no better than those weak and simpering faceless I grind to dust under my pillaging flag!"
msgstr "Et cela m'a affaibli. Je ne vaux pas mieux que ces êtres sans visage, faibles et minaudants que je réduis en poussière sous mon pavillon de pillage !"

# Traduction IA – à relire
#: jacques_ship/hate_ending_two/0/g-2/40/s/0
msgctxt "Choix"
msgid "Bingo. Good self awareness, right there."
msgstr "Bingo. Belle lucidité, là."

# Traduction IA – à relire
#: jacques_ship/hate_ending_two/0/g-2/41/s/0
msgctxt "Choix"
msgid "Should've stayed alone, I guess."
msgstr "J'aurais dû rester seul, je suppose."

# Traduction IA – à relire
#: jacques_ship/hate_ending_three/0
msgctxt "Jacques"
msgid "I cannot go back, can I."
msgstr "Je ne peux pas revenir en arrière, n'est-ce pas."

# Traduction IA – à relire
#: jacques_ship/hate_ending_three/8
msgctxt "Jacques"
msgid "I can never be as I was. Fierce, rageful. Powerful."
msgstr "Je ne pourrai jamais redevenir ce que j'étais. Féroce, rageur. Puissant."

# Traduction IA – à relire
#: jacques_ship/hate_ending_three/16
msgctxt "Jacques"
msgid "I have been undercut by this, this insidious poison of friendship. Of trust."
msgstr "J'ai été sapé par ce poison insidieux qu'est l'amitié. La confiance."

# Traduction IA – à relire
#: jacques_ship/hate_ending_three/24
msgctxt "Jacques"
msgid "And you... you knew. You knew it would be this. You knew what would happen."
msgstr "Et toi... tu savais. Tu savais que ce serait ainsi. Tu savais ce qui arriverait."

# Traduction IA – à relire
#: jacques_ship/hate_ending_three/32
msgctxt "Jacques"
msgid "And you have come to revel in my downfall."
msgstr "Et voilà que tu viens te délecter de ma chute."

# Traduction IA – à relire
#: jacques_ship/hate_ending_three/40
msgctxt "Jacques"
msgid "What genius. What diabolical, cold-hearted instinct, the instincts of a snake."
msgstr "Quel génie. Quel instinct diabolique, au coeur glacé, l'instinct d'un serpent."

# Traduction IA – à relire
#: jacques_ship/hate_ending_three/48
msgctxt "Jacques"
msgid "I have never said what I am about to say."
msgstr "Je n'ai jamais dit ce que je m'apprête à dire."

# Traduction IA – à relire
#: jacques_ship/hate_ending_three/56
msgctxt "Jacques"
msgid "But glory to the victor."
msgstr "Mais gloire au vainqueur."

# Traduction IA – à relire
#: jacques_ship/hate_ending_three/64
msgctxt "Jacques"
msgid "It is not me. It shall never be me again."
msgstr "Ce n'est pas moi. Ce ne sera plus jamais moi."

# Traduction IA – à relire
#: jacques_ship/hate_ending_three/72
msgctxt "Jacques"
msgid "I will hate you forever."
msgstr "Je te haïrai pour toujours."

# Traduction IA – à relire
#: jacques_ship/jacques_hates_joiner/31
msgctxt "Reggie"
msgid "Avast! You've plundered his treasure trust."
msgstr "Ohé du bateau ! Vous avez pillé son coffre-fort de confiance."

# Traduction IA – à relire
#: jacques_ship/jacques_hates_joiner/39
msgctxt "Reggie"
msgid "Set sail for the isles of hate."
msgstr "Cap sur les îles de la haine."

# Traduction IA – à relire
#: jacques_ship/friendship_ending/0/0
msgctxt "Jacques"
msgid "Ugh."
msgstr "Pff."

# Traduction IA – à relire
#: jacques_ship/friendship_ending/0/8
msgctxt "Jacques"
msgid "I see you are still a waster of time!"
msgstr "Je vois que tu gaspilles toujours mon temps !"

# Traduction IA – à relire
#: jacques_ship/friendship_ending/0/16
msgctxt "Jacques"
msgid "How bring you \"hi\" to me when you could be bringing me adventure! Or captives! Or even a piece of jewelry or a fascinating chicken who crossed your path, or a dagger!"
msgstr "Comment peux-tu m'apporter un « coucou » alors que tu pourrais m'apporter de l'aventure ! Ou des prisonniers ! Ou même un bijou, ou une fascinante poule qui aurait croisé ton chemin, ou un poignard !"

# Traduction IA – à relire
#: jacques_ship/friendship_ending/0/24
msgctxt "Jacques"
msgid "But no. You bring me \"hi.\""
msgstr "Mais non. Tu m'apportes un « coucou »."

# Traduction IA – à relire
#: jacques_ship/friendship_ending/0/32
msgctxt "Jacques"
msgid "I have decided that I do not hate you."
msgstr "J'ai décidé que je ne te haïssais pas."

# Traduction IA – à relire
#: jacques_ship/friendship_ending/0/40/s/0
msgctxt "Choix"
msgid "Oh! Um, great!"
msgstr "Oh ! Euh, super !"

# Traduction IA – à relire
#: jacques_ship/friendship_ending/0/41/s/0
msgctxt "Choix"
msgid "Excellent. That's what I was going for."
msgstr "Excellent. C'était mon but."

# Traduction IA – à relire
#: jacques_ship/friendship_ending/0/g-0/0
msgctxt "Jacques"
msgid "I doubt we shall ever be close bosom companions, but I will not kill you."
msgstr "Je doute que nous soyons jamais de proches compagnons de coeur, mais je ne te tuerai pas."

# Traduction IA – à relire
#: jacques_ship/friendship_ending/0/g-0/8
msgctxt "Jacques"
msgid "I may occasionally try to kill you, truth be told. But that is my nature and in your case, I do not necessarily mean it as anything personal."
msgstr "Il m'arrivera peut-être d'essayer de te tuer, à vrai dire. Mais c'est ma nature et, dans ton cas, je n'y mets pas forcément de rancune personnelle."

# Traduction IA – à relire
#: jacques_ship/friendship_ending/0/g-0/16/s/0
msgctxt "Choix"
msgid "So... I'm sorry, are we friends?"
msgstr "Alors... excuse-moi, on est amis ?"

# Traduction IA – à relire
#: jacques_ship/friendship_ending/0/g-0/17/s/0
msgctxt "Choix"
msgid "I'll be very comforted by that, thank you, Jacques."
msgstr "Ça me rassure beaucoup, merci, Jacques."

# Traduction IA – à relire
#: jacques_ship/friendship_ending/0/g-1/0
msgctxt "Jacques"
msgid "As closely as I can approximate the concept of \"friendship,\" to be truthful the word sticks in my throat like an overripe date, we are friends."
msgstr "Aussi près que je puisse approcher le concept d'« amitié », à vrai dire le mot me reste en travers de la gorge comme une datte blette, nous sommes amis."

# Traduction IA – à relire
#: jacques_ship/friendship_ending/0/g-1/11
msgctxt "Jacques"
msgid "Ask nothing of me, and don't push your luck with smiling, or waving or trying to pat me on the shoulder or anything."
msgstr "Ne me demande rien, et ne tente pas ta chance en souriant, en me faisant signe, ou en essayant de me tapoter l'épaule ou quoi que ce soit."

# Traduction IA – à relire
#: jacques_ship/friendship_ending/0/g-1/19
msgctxt "Jacques"
msgid "But I do not hate you, and I will not kill you."
msgstr "Mais je ne te hais pas, et je ne te tuerai pas."

# Traduction IA – à relire
#: jacques_ship/friendship_ending/0/g-1/27
msgctxt "Jacques"
msgid "Congratulations."
msgstr "Félicitations."

# Traduction IA – à relire
#: jacques_ship/friendship_ending/0/g-1/35/s/0
msgctxt "Choix"
msgid "Congratulations? For what?"
msgstr "Félicitations ? Pour quoi ?"

# Traduction IA – à relire
#: jacques_ship/friendship_ending/0/g-1/36/s/0
msgctxt "Choix"
msgid "Like I'd touch you without permission."
msgstr "Comme si j'allais te toucher sans permission."

# Traduction IA – à relire
#: jacques_ship/friendship_ending/0/g-2/0
msgctxt "Jacques"
msgid "There are very few beings on my list of \"do not hate/will not kill.\""
msgstr "Il y a très peu d'êtres sur ma liste « ne pas haïr / ne pas tuer »."

# Traduction IA – à relire
#: jacques_ship/friendship_ending/0/g-2/8
msgctxt "Jacques"
msgid "And now I am off! Myself and my army, off to the horizon and beyond in search of good violence and glory!"
msgstr "Et maintenant je m'en vais ! Moi et mon armée, vers l'horizon et au-delà, en quête de bonne violence et de gloire !"

# Traduction IA – à relire
#: jacques_ship/love_ending/0/0
msgctxt "Jacques"
msgid "Ah."
msgstr "Ah."

# Traduction IA – à relire
#: jacques_ship/love_ending/0/8
msgctxt "Jacques"
msgid "Well, I am nothing if not honorable, and if my side of the bargain entails rolling heedlessly in the sheets until we are sweat-soaked and exhausted, then so be it!"
msgstr "Eh bien, je suis l'honneur même, et si ma part du marché consiste à nous rouler sans retenue dans les draps jusqu'à ce que nous soyons trempés de sueur et épuisés, alors soit !"

# Traduction IA – à relire
#: jacques_ship/love_ending/0/16
msgctxt "Jacques"
msgid "You will have to accustom yourself to my diminutive stature, of course."
msgstr "Il faudra bien sûr t'accoutumer à ma stature réduite."

# Traduction IA – à relire
#: jacques_ship/love_ending/0/24/s/0
msgctxt "Choix"
msgid "Oh please. That's half of why I'm into this."
msgstr "Oh, je t'en prie. C'est la moitié de ce qui me plaît là-dedans."

# Traduction IA – à relire
#: jacques_ship/love_ending/0/25/s/0
msgctxt "Choix"
msgid "I just hope I don't crush you before we get to have any fun."
msgstr "J'espère juste ne pas t'écraser avant qu'on ait pu s'amuser."

# Traduction IA – à relire
#: jacques_ship/love_ending/0/g-0/0
msgctxt "Jacques"
msgid "Well, then."
msgstr "Eh bien, alors."

# Traduction IA – à relire
#: jacques_ship/love_ending/0/g-0/8
msgctxt "Jacques"
msgid "On we go! Breeches, off, sword belt, ON."
msgstr "En avant ! Haut-de-chausses : ôté. Ceinturon : ENFILÉ."

# Traduction IA – à relire
#: jacques_ship/jacques_hate_return/0/8
msgctxt "Jacques"
msgid "Even a simmering pot will boil, you prideful fool."
msgstr "Même une marmite qui mijote finit par bouillir, ô orgueil sur pattes."

# Traduction IA – à relire
#: jacques_ship/jacques_hate_return/0/16
msgctxt "Jacques"
msgid "Get thee gone!"
msgstr "Va-t'en !"

# Traduction IA – à relire
#: jacques_ship/jacques_hate_return/0/27/s/0
msgctxt "Choix"
msgid "I'm getting gone..."
msgstr "Je m'en vais..."

# Traduction IA – à relire
#: jacques_ship/jacques_hate_return/0/28/s/0
msgctxt "Choix"
msgid "You may be small, but my behavior shrank me to insignificance. (USE POISE CANDY)"
msgstr "Tu es peut-être petit, mais mon comportement m'a réduit à l'insignifiance. (UTILISER UN BONBON DE PRESTANCE)"

# Traduction IA – à relire
#: jacques_ship/jacques_hate_return/0/c-0/7
msgctxt "Narrator"
msgid "You get ye gone."
msgstr "Vous déguerpissez, ainsi qu'on vous l'a ordonné."

# Traduction IA – à relire
#: jacques_ship/jacques_hate_return/0/c-1/21 jacques_ship/jacques_hate_return_no_quest/0/c-1/21
msgctxt "Jacques"
msgid "Oh?"
msgstr "Oh ?"

# Traduction IA – à relire
#: jacques_ship/jacques_hate_return/0/c-1/29/0/s/0
msgctxt "Choix"
msgid "I was just a jerk. I'm so sorry."
msgstr "J'ai fait mon crétin. Je suis vraiment {{désolé|désolée|désolé·e}}."

# Traduction IA – à relire
#: jacques_ship/jacques_hate_return/0/c-1/29/c-0/7 jacques_ship/jacques_hate_return_no_quest/0/c-1/29/c-0/7
msgctxt "Jacques"
msgid "You were indeed."
msgstr "En effet."

# Traduction IA – à relire
#: jacques_ship/jacques_hate_return/0/c-1/29/c-0/15 jacques_ship/jacques_hate_return_no_quest/0/c-1/29/c-0/15
msgctxt "Jacques"
msgid "But any good scallywag has their dark moments."
msgstr "Mais tout bon forban a ses moments sombres."

# Traduction IA – à relire
#: jacques_ship/jacques_hate_return/0/c-1/29/c-0/23
msgctxt "Jacques"
msgid "It's a wide ocean, and there's room enough for both of us."
msgstr "L'océan est vaste, il y a assez de place pour nous deux."

# Traduction IA – à relire
#: jacques_ship/jacques_hate_return/0/c-1/29/c-0/31 jacques_ship/jacques_hate_return_no_quest/0/c-1/29/c-0/31
msgctxt "Jacques"
msgid "Welcome aboard."
msgstr "Bienvenue à bord."

# Traduction IA – à relire
#: jacques_ship/jacques_hate_return_no_quest/0/0
msgctxt "Jacques"
msgid "... Ahoy."
msgstr "... Ohé."

# Traduction IA – à relire
#: jacques_ship/jacques_hate_return_no_quest/0/8/s/0
msgctxt "Choix"
msgid "Ahoy."
msgstr "Ohé."

# Traduction IA – à relire
#: jacques_ship/jacques_hate_return_no_quest/0/9/s/0
msgctxt "Choix"
msgid "I was wrong to turn down adventure. (USE POISE CANDY)"
msgstr "J'ai eu tort de refuser l'aventure. (UTILISER UN BONBON DE PRESTANCE)"

# Traduction IA – à relire
#: jacques_ship/jacques_hate_return_no_quest/0/c-0/7
msgctxt "Narrator"
msgid "Jacques turns away from you, as your attempt at an 'ahoy' did not have the requisite amount of adventuring spirit."
msgstr "Jacques se détourne de vous, car votre tentative de « ohé » ne contenait pas assez d'esprit d'aventure."

# Traduction IA – à relire
#: jacques_ship/jacques_hate_return_no_quest/0/c-1/29/0/s/0
msgctxt "Choix"
msgid "I was just a scared. I'm not now."
msgstr "J'avais juste peur. Plus maintenant."

# Traduction IA – à relire
#: jacques_ship/jacques_hate_return_no_quest/0/c-1/29/c-0/23
msgctxt "Jacques"
msgid "It's a wide ocean, there's room enough for both of us."
msgstr "L'océan est vaste, il y a assez de place pour nous deux."

# Traduction IA – à relire
#: jacques_ship/jacques_love_return/0/0
msgctxt "Jacques"
msgid "Ahahaha, my salt-crusted paramour!"
msgstr "Ahahaha, mon amant croûté de sel !"

# Traduction IA – à relire
#: jacques_ship/jacques_love_return/0/8
msgctxt "Jacques"
msgid "Looks like you may be due for a good swabbing."
msgstr "On dirait que tu as besoin d'un bon briquage."

# Traduction IA – à relire
#: jacques_ship/jacques_love_return/0/16/s/0 jacques_ship/jacques_friend_return/0/44/s/0
msgctxt "Choix"
msgid "Nice to see you too, Jacques."
msgstr "Ça me fait plaisir de te voir aussi, Jacques."

# Traduction IA – à relire
#: jacques_ship/jacques_love_return/0/17/s/0
msgctxt "Choix"
msgid "Never thought I'd get turned on by the word \"swabbing.\""
msgstr "Jamais je n'aurais cru être excité par le mot « briquage »."

# Traduction IA – à relire
#: jacques_ship/jacques_love_return/0/18/s/0 jacques_ship/jacques_friend_return_2/0/9/s/0 jacques_ship/jacques_friend_no_quest_return/0/10/s/0
msgctxt "Choix"
msgid "I'm here for the greatest adventure - Realizing you!"
msgstr "Je suis là pour la plus grande des aventures : te Réaliser !"

# Traduction IA – à relire
#: jacques_ship/jacques_love_return/0/c-0/7
msgctxt "Jacques"
msgid "Another roll on the main, is it?"
msgstr "Encore un petit roulis sur les flots, c'est ça ?"

# Traduction IA – à relire
#: jacques_ship/jacques_love_return/0/c-0/15
msgctxt "Narrator"
msgid "The two of you swab away as only the two of you can."
msgstr "Vous briquez tous les deux comme vous seuls savez le faire."

# Traduction IA – à relire
#: jacques_ship/jacques_love_return/0/c-1/7
msgctxt "Jacques"
msgid "It's not just for cleaning the ears..."
msgstr "Ça ne sert pas qu'à se nettoyer les oreilles..."

# Traduction IA – à relire
#: jacques_ship/jacques_love_return/0/c-1/15
msgctxt "Jacques"
msgid "While we're at it, all these decks need a good seeing-to before we crest the rolling main!"
msgstr "Tant qu'on y est, tous ces ponts ont besoin qu'on s'en occupe sérieusement avant de chevaucher la houle !"

# Traduction IA – à relire
#: jacques_ship/jacques_love_return/0/c-1/23
msgctxt "Jacques"
msgid "Buck up, me heartie... I see a swell on the horizon!"
msgstr "Courage, mon brave... je vois une houle se gonfler à l'horizon !"

# Traduction IA – à relire
#: jacques_ship/jacques_friend_return/0/20
msgctxt "Jacques"
msgid "Well well well!"
msgstr "Eh bien eh bien eh bien !"

# Traduction IA – à relire
#: jacques_ship/jacques_friend_return/0/28
msgctxt "Jacques"
msgid "My \"friend\" is back. URGH."
msgstr "Mon « ami » est de retour. URGH."

# Traduction IA – à relire
#: jacques_ship/jacques_friend_return/0/36
msgctxt "Jacques"
msgid "I feel as though I've swallowed a live frog."
msgstr "J'ai l'impression d'avoir avalé une grenouille vivante."

# Traduction IA – à relire
#: jacques_ship/jacques_friend_return/0/45/s/0
msgctxt "Choix"
msgid "Wow, that's... that's vivid."
msgstr "Wow, c'est... c'est imagé."

# Traduction IA – à relire
#: jacques_ship/jacques_friend_return/0/g-0/0
msgctxt "Jacques"
msgid "Oh come come. I've been doing research since I saw you last, on what precisely it means to \"friend\" someone."
msgstr "Oh voyons. Je me suis documenté depuis ta dernière visite sur ce que signifie précisément « faire ami-ami » avec quelqu'un."

# Traduction IA – à relire
#: jacques_ship/jacques_friend_return/0/g-0/8
msgctxt "Jacques"
msgid "Forgiveness for their peculiarities of speech and occasional lapses in comportment are very much part of the bill of lading."
msgstr "Le pardon de leurs particularités de langage et de leurs écarts de conduite occasionnels fait pleinement partie du connaissement."

# Traduction IA – à relire
#: jacques_ship/jacques_friend_return/0/g-0/16
msgctxt "Jacques"
msgid "And your hold, friend, may be getting quite full."
msgstr "Et ta cale, mon ami, risque d'être bien remplie."

# Traduction IA – à relire
#: jacques_ship/jacques_friend_return/0/g-0/24
msgctxt "Jacques"
msgid "I have zero intention on being any nicer to you or more pleasant as a general rule than I am right now."
msgstr "Je n'ai aucune intention d'être plus gentil ou plus agréable avec toi, en règle générale, que je ne le suis en ce moment."

# Traduction IA – à relire
#: jacques_ship/jacques_friend_return/0/g-0/32
msgctxt "Jacques"
msgid "So put that on your oar and stroke it."
msgstr "Alors mets ça sur ta rame et astique."

# Traduction IA – à relire
#: jacques_ship/jacques_friend_return/0/g-0/37/s/0
msgctxt "Choix"
msgid "I would expect nothing less."
msgstr "Je n'en attendais pas moins."

# Traduction IA – à relire
#: jacques_ship/jacques_friend_return/0/g-0/38/s/0
msgctxt "Choix"
msgid "Stroking. Per instruction."
msgstr "J'astique. Selon les consignes."

# Traduction IA – à relire
#: jacques_ship/jacques_friend_return/0/g-0/c-2/7
msgctxt "Jacques"
msgid "Hmph. Good. Well."
msgstr "Hmph. Bien. Eh bien."

# Traduction IA – à relire
#: jacques_ship/jacques_friend_return/0/g-0/c-2/15
msgctxt "Jacques"
msgid "Get along with you now."
msgstr "File, maintenant."

# Traduction IA – à relire
#: jacques_ship/jacques_friend_return/0/g-0/c-2/23
msgctxt "Jacques"
msgid "That's more than enough non-confrontational dialogue for one day."
msgstr "C'est largement assez de dialogue non belliqueux pour une journée."

# Traduction IA – à relire
#: jacques_ship/jacques_friend_return/0/g-0/c-3/7
msgctxt "Jacques"
msgid "That sounded like innuendo."
msgstr "Ça ressemblait à un sous-entendu."

# Traduction IA – à relire
#: jacques_ship/jacques_friend_return/0/g-0/c-3/15
msgctxt "Jacques"
msgid "Innuendo makes me quite hostile."
msgstr "Les sous-entendus me rendent fort hostile."

# Traduction IA – à relire
#: jacques_ship/jacques_friend_return/0/g-0/c-3/23
msgctxt "Jacques"
msgid "Imply at your peril, you lobster!"
msgstr "Sous-entends à tes risques et périls, espèce de homard !"

# Traduction IA – à relire
#: jacques_ship/jacques_friend_return/0/g-0/c-3/31
msgctxt "Jacques"
msgid "In fact, off with you. Off to the boil, if you insist!"
msgstr "D'ailleurs, ouste. À l'ébullition, si tu y tiens !"

# Traduction IA – à relire
#: jacques_ship/jacques_friend_return/0/g-0/c-3/39
msgctxt "Jacques"
msgid "I have to find something to kill now and as already promised, it cannot be you."
msgstr "Je dois trouver quelque chose à tuer maintenant et, comme promis, ça ne peut pas être toi."

# Traduction IA – à relire
#: jacques_ship/jacques_friend_return/0/g-0/c-3/47
msgctxt "Jacques"
msgid "Damned inconvenient, this \"friendship\" thing."
msgstr "Fichtrement gênant, cette histoire d'« amitié »."

# Traduction IA – à relire
#: jacques_ship/jacques_friend_return_2/0/0
msgctxt "Jacques"
msgid "You're back."
msgstr "Te revoilà."

# Traduction IA – à relire
#: jacques_ship/jacques_friend_return_2/0/8/s/0
msgctxt "Choix"
msgid "I'm back!"
msgstr "Je suis de retour !"

# Traduction IA – à relire
#: jacques_ship/jacques_friend_return_2/0/c-0/7
msgctxt "Jacques"
msgid "Why."
msgstr "Pourquoi."

# Traduction IA – à relire
#: jacques_ship/jacques_friend_return_2/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "Uh... missed you?"
msgstr "Euh... tu m'as manqué ?"

# Traduction IA – à relire
#: jacques_ship/jacques_friend_return_2/0/c-0/15/c-0/7
msgctxt "Jacques"
msgid "How inane."
msgstr "Quelle inanité."

# Traduction IA – à relire
#: jacques_ship/jacques_friend_return_2/0/c-0/15/c-0/15
msgctxt "Jacques"
msgid "Fine fine, nice to see you."
msgstr "Bon bon, content de te voir."

# Traduction IA – à relire
#: jacques_ship/jacques_friend_return_2/0/c-0/15/c-0/23 jacques_ship/jacques_friend_no_quest_return/0/g-0/0
msgctxt "Jacques"
msgid "Now paddle away! I'm busy planning a conquering."
msgstr "Maintenant pagaie loin d'ici ! Je suis occupé à planifier une conquête."

# Traduction IA – à relire
#: jacques_ship/jacques_friend_no_quest_return/0/0
msgctxt "Jacques"
msgid "My good friend. Perhaps an adventure is afoot?"
msgstr "Mon bon ami. Peut-être une aventure se prépare-t-elle ?"

# Traduction IA – à relire
#: jacques_ship/jacques_friend_no_quest_return/0/8/s/0
msgctxt "Choix"
msgid "I'll look for one, always."
msgstr "J'en chercherai une, toujours."

# Traduction IA – à relire
#: jacques_ship/jacques_friend_no_quest_return/0/9/s/0
msgctxt "Choix"
msgid "Nah, not my style."
msgstr "Bof, pas mon style."

# Traduction IA – à relire
#: jacques_ship/jacques_friend_no_quest_return/0/c-0/7
msgctxt "Jacques"
msgid "Oh. Excellent."
msgstr "Oh. Excellent."

# Traduction IA – à relire
#: jacques_ship/jacques_friend_no_quest_return/0/c-1/7
msgctxt "Jacques"
msgid "Heh heh hehe!"
msgstr "Hé hé héhé !"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/9
msgctxt "Beau"
msgid "And here we are."
msgstr "Et nous y voilà."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/17
msgctxt "Beau"
msgid "Now listen."
msgstr "Maintenant, écoute."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/25
msgctxt "Narrator"
msgid "Beau holds a finger up to her lips, lowering her voice."
msgstr "Beau porte un doigt à ses lèvres et baisse la voix."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/33
msgctxt "Beau"
msgid "We have to at least try to be very very sneaky."
msgstr "Il faut au moins essayer d'être très très discrets."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/41/s/0
msgctxt "Choix"
msgid "So that Jacques doesn't hear us?"
msgstr "Pour que Jacques ne nous entende pas ?"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/42/s/0
msgctxt "Choix"
msgid "I thought you were a great cat burglar!"
msgstr "Je croyais que tu étais une grande cambrioleuse !"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/c-0/7
msgctxt "Beau"
msgid "Precisely."
msgstr "Précisément."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/c-1/7
msgctxt "Beau"
msgid "I am! I'm the best. But even cats make noise sometimes."
msgstr "Ça, je le suis ! Je suis la meilleure. Mais même les chats font du bruit parfois."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-0/0
msgctxt "Narrator"
msgid "Beau sets the scene for you with her hands, curling two fingers in the air like a pair of legs sneaking past."
msgstr "Beau plante le décor avec ses mains, recourbant deux doigts dans l'air comme une paire de jambes qui se faufile."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-0/8
msgctxt "Beau"
msgid "The goal is to sneeeeeaaakkk into the ship."
msgstr "Le but, c'est de se faufiiiiiilleeeer dans le navire."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-0/16
msgctxt "Beau"
msgid "Sneeeeaaaakkk past Jacques, who will probably be sitting on the deck, staring out at his plastic ocean."
msgstr "Se faufiiiiileeer devant Jacques, qui sera probablement assis sur le pont, à contempler son océan en plastique."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-0/24
msgctxt "Beau"
msgid "Then we snnneeeeea...."
msgstr "Et ensuite on se faufiiiiii...."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-0/32/s/0
msgctxt "Choix"
msgid "No no, lemme guess. We sneak."
msgstr "Non non, laisse-moi deviner. On se faufile."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-0/33/s/0
msgctxt "Choix"
msgid "I get it I get it, I'm ready! Let's go!"
msgstr "J'ai compris j'ai compris, je suis {{prêt|prête|prêt·e}} ! Allons-y !"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-0/c-2/7
msgctxt "Beau"
msgid "Yes! That's it!"
msgstr "Oui ! C'est ça !"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-1/0
msgctxt "Beau"
msgid "I love your enthusiasm! Ahhh going on a great quest with a great companion..."
msgstr "J'adore ton enthousiasme ! Ahhh partir pour une grande quête avec un grand compagnon..."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-1/8
msgctxt "Beau"
msgid "Oh, it's the best!"
msgstr "Oh, c'est le meilleur !"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-1/16
msgctxt "Beau"
msgid "Oh! Also... here. Take this."
msgstr "Oh ! Et aussi... tiens. Prends ça."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-1/27
msgctxt "Narrator"
msgid "She holds out an extension cord to you—it's wound in a circle, just like the whip Beau carries."
msgstr "Elle vous tend une rallonge électrique, enroulée en cercle, exactement comme le fouet que porte Beau."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-1/35/s/0
msgctxt "Choix"
msgid "Is that a whip?"
msgstr "C'est un fouet ?"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-1/36/s/0
msgctxt "Choix"
msgid "Oh my god, this is so cool, it's just like yours!"
msgstr "Oh mon dieu, c'est trop cool, c'est exactement comme le tien !"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-2/0
msgctxt "Beau"
msgid "I made it for you! I figured since we're going on the great quests, you're going to need some kind of a weapon!"
msgstr "Je l'ai fait pour toi ! Je me suis dit que puisqu'on part pour de grandes quêtes, il te faudrait une arme !"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-2/8
msgctxt "Beau"
msgid "And I figured that something that doubles as a tool would be useful. And also I don't know you well enough to trust you with a projectile. So! Extension cord whip it is!"
msgstr "Et je me suis dit que quelque chose qui sert aussi d'outil serait utile. Et puis je ne te connais pas assez pour te confier un projectile. Donc ! Fouet en rallonge !"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-2/16/s/0
msgctxt "Choix"
msgid "Lead on, then! What's the next step?"
msgstr "Alors ouvre la marche ! C'est quoi la prochaine étape ?"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-2/17/s/0
msgctxt "Choix"
msgid "So once we're down in the hold, what then?"
msgstr "Une fois dans la cale, on fait quoi ?"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-3/3
msgctxt "Beau"
msgid "We're looking for The Secret Sword. I have to be truthful with you that I only have anecdotal evidence for what it looks like."
msgstr "On cherche L'Épée Secrète. Je dois t'avouer que je n'ai que des preuves anecdotiques de son apparence."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-3/11
msgctxt "Beau"
msgid "I read in one source that it's massive and gold and has a great big tassel on the hilt."
msgstr "J'ai lu dans une source qu'elle est massive et dorée avec un énorme gland sur la poignée."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-3/19
msgctxt "Beau"
msgid "Then I read in another source that it's actually just a stick, a little piece of driftwood that washed around in some huge river for hundreds of years until it was worn small and straight and perfectly smooth."
msgstr "Puis j'ai lu dans une autre source que c'est en fait juste un bâton, un petit morceau de bois flotté qui a roulé dans un immense fleuve pendant des centaines d'années jusqu'à devenir petit, droit et parfaitement lisse."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-3/27
msgctxt "Beau"
msgid "All of the times that I've tried to get this thing for myself and I've only been in the hold once! It was there but Jacques had some sort of a tarp draped over it."
msgstr "Toutes les fois où j'ai essayé de me l'approprier, je n'ai été dans la cale qu'une seule fois ! Elle était là mais Jacques l'avait recouverte d'une sorte de bâche."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-3/35
msgctxt "Beau"
msgid "I think it was a cocktail napkin."
msgstr "Je crois que c'était une serviette à cocktail."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-3/43
msgctxt "Beau"
msgid "It had like a little neon pineapple on it."
msgstr "Il y avait un petit ananas fluo dessus."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-3/51/s/0
msgctxt "Choix"
msgid "So we don't even know what this thing looks like?"
msgstr "Donc on ne sait même pas à quoi ça ressemble ?"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-3/52/s/0
msgctxt "Choix"
msgid "Hm. This might be complicated."
msgstr "Hm. Ça risque d'être compliqué."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-4/0
msgctxt "Beau"
msgid "Oh it all adds to the fun! I can tell you for absolute certain, though... we will know it when we see it."
msgstr "Oh, ça ajoute au plaisir ! Mais je peux te dire avec une certitude absolue... qu'on la reconnaîtra en la voyant."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-4/8
msgctxt "Beau"
msgid "Whatever it looks like, it will be perfect and spectacular!"
msgstr "Quelle que soit son apparence, elle sera parfaite et spectaculaire !"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-4/16
msgctxt "Beau"
msgid "Ok, in we go..."
msgstr "Bon, on entre..."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-4/30
msgctxt "Narrator"
msgid "Jacques draws his cocktail sword with a snarl."
msgstr "Jacques dégaine son épée à cocktail avec un grondement."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-4/41
msgctxt "Jacques"
msgid "STOP"
msgstr "ARRÊTE"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-4/49
msgctxt "Jacques"
msgid "RIGHT"
msgstr "TOI"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-4/57
msgctxt "Jacques"
msgid "THERE."
msgstr "LÀ."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-4/65
msgctxt "Jacques"
msgid "You insolent, trespassing, repeat offender!"
msgstr "Insolente, intruse, récidiviste !"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-4/73
msgctxt "Jacques"
msgid "I draw my sword at you, I bite my thumb, and I express gaseous matter towards your position!"
msgstr "Je dégaine mon épée contre toi, je me mords le pouce, et j'exprime des gaz en direction de ta position !"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-4/81
msgctxt "Beau"
msgid "Well shit."
msgstr "Et merde."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-4/89/s/0
msgctxt "Choix"
msgid "Hey! Hey everyone, let's just calm down..."
msgstr "Hé ! Hé, tout le monde, calmons-nous..."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/0
msgctxt "Jacques"
msgid "Calm? Calm?! You dare open YOUR tag-along mouth to tell ME to be CALM??"
msgstr "Calme ? Calme ?! Tu oses ouvrir TA bouche de pique-assiette pour me dire d'être CALME ??"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/8
msgctxt "Jacques"
msgid "If you even knew the number of times this scalawag has invaded my ocean, boarded my ship and attempted to swipe my precious personal property right out from underneath me..."
msgstr "Si tu savais seulement combien de fois cette canaille a envahi mon océan, abordé mon navire et tenté de me faucher ma précieuse propriété personnelle sous mon nez..."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/16
msgctxt "Jacques"
msgid "...you would not be mashing your teeth together to form the repugnant, repulsive and ultimately unsatisfactory word of CALM!"
msgstr "...tu ne serais pas là à serrer les dents pour former le mot répugnant, repoussant et en définitive insatisfaisant de CALME !"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/24
msgctxt "Beau"
msgid "Yeah yeah yeah, you're angry, you're the fearsomest pirate of the seven seas and we should all bow and scrape to your terribleness."
msgstr "Oui oui oui, tu es en colère, tu es le plus redoutable pirate des sept mers et nous devrions tous nous prosterner devant ton atrocité."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/32
msgctxt "Beau"
msgid "Except for, let's face facts, you don't have seven seas, you have ONE. And it's not a sea it's a piece of molded plastic and the paint is chipping!"
msgstr "Sauf que, regardons les choses en face, tu n'as pas sept mers, tu en as UNE. Et ce n'est pas une mer, c'est un bout de plastique moulé et la peinture s'écaille !"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/40/s/0
msgctxt "Choix"
msgid "Beau, your whole outfit is made out of recycled cardboard."
msgstr "Beau, toute ta tenue est faite de carton recyclé."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/7
msgctxt "Beau"
msgid "Yeah but that's because I'm scrappy and crafty and cool!"
msgstr "Oui mais c'est parce que je suis débrouillarde, ingénieuse et cool !"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/15
msgctxt "Beau"
msgid "Jacques is delusional. There is a difference."
msgstr "Jacques, lui, est mégalomane. Il y a une différence."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/23
msgctxt "Jacques"
msgid "Delusional? De<w>LOOOOO</w>sional?? I will have you drawn and quartered, you black-hearted pretender!"
msgstr "Mégalo ? Méga<w>LOOOOO</w>mane ?? Je te ferai écarteler, prétendante au coeur noir !"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/31
msgctxt "Beau"
msgid "Oh yeah, by who? Your huge and loyal band of dust mites???"
msgstr "Ah ouais, par qui ? Ta grande et fidèle bande d'acariens ???"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/39
msgctxt "Jacques"
msgid "WHY YOU...!"
msgstr "COMMENT OSES-TU...!"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/0/s/0
msgctxt "Choix"
msgid "Guys! Come ON! Get it together and let's just talk!"
msgstr "Vous deux ! Allez ! Ressaisissez-vous et parlons, simplement !"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/1/s/0
msgctxt "Choix"
msgid "Fight! FIGHT TO THE DEATH!"
msgstr "Battez-vous ! BATTEZ-VOUS À MORT !"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-0/7
msgctxt "Beau"
msgid "This is what I've been trying to tell you!"
msgstr "C'est ce que j'essaie de te dire !"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-0/15
msgctxt "Beau"
msgid "There is no talking to this doofus, this is why I've just been trying to sneak past him and not deal with his NONSENSE!"
msgstr "On ne peut pas parler à cet idiot, c'est pour ça que j'essaie juste de me faufiler devant lui sans m'occuper de ses SORNETTES !"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-0/23
msgctxt "Jacques"
msgid "And you have failed every single time. That should be some sort of a clue for you about your ineptitude in the arts of subterfuge and knavery!"
msgstr "Et tu as échoué à chaque fois. Cela devrait t'indiquer ton ineptie dans les arts du subterfuge et de la fourberie !"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-0/31
msgctxt "Jacques"
msgid "You shall never have the sword!"
msgstr "Tu n'auras jamais l'épée !"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-0/39
msgctxt "Beau"
msgid "Oh I'll have it alright. If I have to hang your tiny butt from a miniature yardarm I'll have it!"
msgstr "Oh, je l'aurai, tu peux me croire. Même s'il faut pendre ton petit derrière à une vergue miniature, je l'aurai !"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-0/47/0/s/0
msgctxt "Choix"
msgid "Ok THAT'S IT. ENOUGH."
msgstr "Ok ÇA SUFFIT. ASSEZ."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-0/47/1/s/0
msgctxt "Choix"
msgid "Gotta admit, you two are fun to watch."
msgstr "Il faut avouer que vous êtes drôles à regarder, tous les deux."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-0/47/c-0/7
msgctxt "Beau"
msgid "You're right. We're never gonna get anywhere this way."
msgstr "Tu as raison. On n'ira jamais nulle part comme ça."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-0/47/c-0/15
msgctxt "Beau"
msgid "But I don't know what else to do with him!"
msgstr "Mais je ne sais pas quoi faire d'autre avec lui !"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-0/47/c-0/23
msgctxt "Beau"
msgid "Short of tying him up..."
msgstr "À part l'attacher..."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-0/47/c-0/31
msgctxt "Beau"
msgid "Is that an option?"
msgstr "C'est une option ?"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-0/47/c-0/39/1/s/0
msgctxt "Choix"
msgid "You're not helping yourself here, Beau."
msgstr "Tu ne t'aides pas, là, Beau."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-0/47/c-0/39/c-1/7
msgctxt "Beau"
msgid "Ugh. Fine. What do you suggest then?"
msgstr "Pff. Bon. Que suggères-tu alors ?"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-0/47/g-0/0
msgctxt "Jacques"
msgid "I feel compelled to warn both of you that whatever suggestion you make, be in reasonable or logic or even sure to succeed to bring glory to all parties..."
msgstr "Je me sens obligé de vous avertir tous les deux que toute suggestion que vous ferez, qu'elle soit raisonnable, logique, ou même certaine de couvrir de gloire toutes les parties..."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-0/47/g-0/8
msgctxt "Jacques"
msgid "I will probably say no."
msgstr "Je dirai probablement non."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-0/47/g-0/16
msgctxt "Beau"
msgid "Oh for god's sake."
msgstr "Oh, pour l'amour du ciel."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-0/47/g-0/24
msgctxt "Jacques"
msgid "You should be flattered I said ANYTHING!"
msgstr "Tu devrais être flattée que j'aie dit QUOI QUE CE SOIT !"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-0/47/g-0/32
msgctxt "Jacques"
msgid "I am under no moral obligation to volunteer information to interlopers."
msgstr "Je n'ai aucune obligation morale de fournir des informations à des intrus."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-0/47/g-0/40/0/s/0
msgctxt "Choix"
msgid "Fair point. That's a great first olive branch."
msgstr "Pas faux. C'est un excellent premier rameau d'olivier."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-0/47/g-0/40/1/s/0
msgctxt "Choix"
msgid "Beau, why don't you tell us why the sword is so important?"
msgstr "Beau, pourquoi tu ne nous dis pas pourquoi l'épée est si importante ?"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-0/47/g-0/40/c-0/7
msgctxt "Jacques"
msgid "DON'T CALL IT AN OLIVE BRANCH."
msgstr "NE L'APPELLE PAS RAMEAU D'OLIVIER."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-0/47/g-0/40/c-0/21
msgctxt "Jacques"
msgid "It is the lowered tip of a razor-edged sword, if anything."
msgstr "C'est plutôt la pointe baissée d'une lame au fil de rasoir."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-0/47/g-0/40/c-0/29
msgctxt "Jacques"
msgid "I hate olives."
msgstr "Je déteste les olives."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-0/47/g-0/40/c-0/37/0/s/0
msgctxt "Choix"
msgid "Fine. No olives."
msgstr "Bon. Pas d'olives."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-0/47/g-0/40/c-0/37/1/s/0
msgctxt "Choix"
msgid "Huh. Me, too. Weird."
msgstr "Tiens. Moi aussi. Bizarre."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-0/47/g-0/40/c-0/37/g-0/0
msgctxt "Beau"
msgid "Ok ok ok, I will meet ya halfway. Let's try... <i>gulp</i>... talking."
msgstr "Ok ok ok, je fais la moitié du chemin. Essayons... <i>gloups</i>... de parler."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-0/47/g-0/40/c-0/37/g-0/8
msgctxt "Beau"
msgid "I'll try to explain to you why I need the sword."
msgstr "Je vais essayer de t'expliquer pourquoi j'ai besoin de l'épée."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-1/11
msgctxt "Jacques"
msgid "Ha HA! And now we have the blessing of this young newcomer to do our damndest to destroy each other...."
msgstr "Ha HA ! Et nous voilà munis de la bénédiction de cette jeune recrue pour faire de notre mieux et nous détruire mutuellement...."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-1/19
msgctxt "Jacques"
msgid "What a lovely day this is turning out to be!"
msgstr "Quelle belle journée en perspective !"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-1/27
msgctxt "Beau"
msgid "Oh bring it on, pipsqueak!"
msgstr "Allez, viens, microbe !"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-1/35
msgctxt "Beau"
msgid "I hope at least I get a few fun shots in before I crush you by accident!"
msgstr "J'espère au moins placer quelques bons coups avant de t'écraser par accident !"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-1/43
msgctxt "Jacques"
msgid "HOW DARE YOU IMPUGN MY STATURE?!?!?"
msgstr "COMMENT OSES-TU CALOMNIER MA STATURE ?!?!?"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-1/54
msgctxt "Beau"
msgid "Yah, like I WASN'T going to go for the lowest hanging fruit in history."
msgstr "Ouais, comme si j'allais PAS viser la cible la plus facile de l'histoire."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-1/62
msgctxt "Beau"
msgid "I'm a rapscallion, not a moron."
msgstr "Je suis une canaille, pas une imbécile."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-1/70
msgctxt "Jacques"
msgid "POW! A blow to the ankles, SHRRIIIIK a slicing swing to the hip, debilitating you and bringing you crashing down to one knee!"
msgstr "POUF ! Un coup aux chevilles, SHRRIIIIK un balayage tranchant à la hanche, qui t'affaiblit et t'envoie t'écrouler sur un genou !"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-1/78
msgctxt "Jacques"
msgid "You pant, you beg, but I can see the fire of rebellion still burning in your eyes and so..."
msgstr "Tu halètes, tu supplies, mais je vois encore brûler le feu de la rébellion dans tes yeux et alors..."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-1/86
msgctxt "Jacques"
msgid "WHAM! A downthrust with the force of a hurricane rains upon your shoulders, pounding your one supporting knee further and further into the unforgiving wood of my deck!"
msgstr "BAM ! Une estocade d'ouragan s'abat sur tes épaules, enfonçant ton unique genou d'appui toujours plus profondément dans le bois impitoyable de mon pont !"

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-1/94
msgctxt "Narrator"
msgid "You and Beau share a look."
msgstr "Beau et vous échangez un regard."

# Traduction IA – à relire
#: jacques_ship/secret_sword/0/g-5/c-11/47/c-1/105/0/s/0
msgctxt "Choix"
msgid "Beau... has he noticed..."
msgstr "Beau... il a remarqué..."

#: jacques_ship/secret_sword/0/g-5/c-11/47/c-1/105/c-0/7
msgctxt "Beau"
msgid "That he's not actually doing anything to me?"
msgstr ""

#: jacques_ship/secret_sword/0/g-5/c-11/47/c-1/105/c-0/15/0/s/0
msgctxt "Choix"
msgid "You're not panting. Or begging."
msgstr ""

#: jacques_ship/secret_sword/0/g-5/c-11/47/c-1/105/c-0/15/1/s/0
msgctxt "Choix"
msgid "He's just talking to himself. You see that."
msgstr ""

#: jacques_ship/secret_sword/0/g-5/c-11/47/c-1/105/c-0/15/g-0/0
msgctxt "Beau"
msgid "Yep, I know."
msgstr ""

#: jacques_ship/secret_sword/0/g-5/c-11/47/c-1/105/c-0/15/g-0/8
msgctxt "Beau"
msgid "Best to just let him tire himself out, I think."
msgstr ""

#: jacques_ship/secret_sword/0/g-5/c-11/47/c-1/105/c-0/15/g-0/16
msgctxt "Narrator"
msgid "Jacques continues his little tirade, ranting mostly to himself at this point."
msgstr ""

#: jacques_ship/secret_sword/0/g-5/c-11/47/c-1/105/c-0/15/g-0/24
msgctxt "Jacques"
msgid "I dance around your prone and bloodied body, calling down the righteous rage of the gods upon this would-be thief, this erstwhile criminal..."
msgstr ""

#: jacques_ship/secret_sword/0/g-5/c-11/47/c-1/105/c-0/15/g-0/32
msgctxt "Jacques"
msgid "This embarrassment to the designation of Legitimate Illegitimates!"
msgstr ""

#: jacques_ship/secret_sword/0/g-5/c-11/47/c-1/105/c-0/15/g-0/40
msgctxt "Jacques"
msgid "I crush your fingers one by one under the heels of my shining boots! I bathe in the glory of your anguished moans!"
msgstr ""

#: jacques_ship/secret_sword/0/g-5/c-11/47/c-1/105/c-0/15/g-0/48/0/s/0
msgctxt "Choix"
msgid "This is escalating."
msgstr ""

#: jacques_ship/secret_sword/0/g-5/c-11/47/c-1/105/c-0/15/g-0/48/1/s/0
msgctxt "Choix"
msgid "Wow, he's really got a way with words."
msgstr ""

#: jacques_ship/secret_sword/0/g-5/c-11/47/c-1/105/c-0/15/g-0/48/g-0/0
msgctxt "Beau"
msgid "Y'know, I think I heard somewhere that he wrote a book of poetry at one point."
msgstr ""

#: jacques_ship/secret_sword/0/g-5/c-11/47/c-1/105/c-0/15/g-0/48/g-0/8
msgctxt "Beau"
msgid "Maybe once this quest is over we can try to find it and stick it up on the refrigerator in the kitchen."
msgstr ""

#: jacques_ship/secret_sword/0/g-6/0/s/0
msgctxt "Choix"
msgid "As fun as this is... we have places to be."
msgstr ""

#: jacques_ship/secret_sword/0/g-6/1/s/0
msgctxt "Choix"
msgid "We'd better stop him. Before he passes out."
msgstr ""

#: jacques_ship/secret_sword/0/g-7/0
msgctxt "Beau"
msgid "Yeah. Let's change the channel."
msgstr ""

#: jacques_ship/secret_sword/0/g-7/8
msgctxt "Beau"
msgid "Jacques?"
msgstr ""

#: jacques_ship/secret_sword/0/g-7/16
msgctxt "Beau"
msgid "Jacques?!"
msgstr ""

#: jacques_ship/secret_sword/0/g-7/26
msgctxt "Narrator"
msgid "Jacques pointedly ignores Beau, placing his hands over his ears."
msgstr ""

#: jacques_ship/secret_sword/0/g-7/37
msgctxt "Jacques"
msgid "I cannot hear you! All I hear is the cries of a defeated enemy. Ah, music to my ears!"
msgstr ""

#: jacques_ship/secret_sword/0/g-7/45/s/0
msgctxt "Choix"
msgid "Beau... Pretend to be defeated."
msgstr ""

#: jacques_ship/secret_sword/0/g-7/46/s/0
msgctxt "Choix"
msgid "Seriously??"
msgstr ""

#: jacques_ship/secret_sword/0/g-7/47/s/0
msgctxt "Choix"
msgid "The sword, Beau!"
msgstr ""

#: jacques_ship/secret_sword/0/g-7/c-14/7
msgctxt "Beau"
msgid "What??"
msgstr ""

#: jacques_ship/secret_sword/0/g-7/c-14/15/0/s/0
msgctxt "Choix"
msgid "Pretend you're defeated! Maybe if you play along, he'll listen!"
msgstr ""

#: jacques_ship/secret_sword/0/g-7/c-14/15/c-0/7
msgctxt "Beau"
msgid "That's... genius."
msgstr ""

#: jacques_ship/secret_sword/0/g-7/c-14/15/c-0/15
msgctxt "Beau"
msgid "I hate it, but it's genius."
msgstr ""

#: jacques_ship/secret_sword/0/g-7/c-14/15/c-0/23
msgctxt "Beau"
msgid "Jacques! O Mighty Villain, O Fearsome Predator of the Deep, you have indeed vanquished me!"
msgstr ""

#: jacques_ship/secret_sword/0/g-7/c-14/15/c-0/31
msgctxt "Beau"
msgid "I lie defeated, humbled and shrunken at your feet. I pray for nothing but the grace of your mercy upon this unworthy wretch!"
msgstr ""

#: jacques_ship/secret_sword/0/g-7/c-14/15/c-0/39
msgctxt "Beau"
msgid "Grant this cretin the boon of one last audience with your great awfulness!"
msgstr ""

#: jacques_ship/secret_sword/0/g-7/c-14/15/c-0/47/0/s/0
msgctxt "Choix"
msgid "Damn. Now who's a poet!"
msgstr ""

#: jacques_ship/secret_sword/0/g-7/c-14/15/c-0/47/1/s/0
msgctxt "Choix"
msgid "Gotta love this commitment, Beau."
msgstr ""

#: jacques_ship/secret_sword/0/g-7/c-14/15/c-0/47/c-0/7
msgctxt "Beau"
msgid "I mean, hey, if you're gonna do something, you might as well do it full out."
msgstr ""

#: jacques_ship/secret_sword/0/g-7/c-14/15/c-0/47/g-0/0
msgctxt "Jacques"
msgid "Yes. Yes. In my infinite wisdom and mercy, I hear your calls for amnesty."
msgstr ""

#: jacques_ship/secret_sword/0/g-7/c-14/15/c-0/47/g-0/8
msgctxt "Jacques"
msgid "I hear... and I choose to honor your pitiful begging. For the moment anyway."
msgstr ""

#: jacques_ship/secret_sword/0/g-7/c-14/15/c-0/47/g-0/16
msgctxt "Jacques"
msgid "Speak your piece, O One Who Has Lost."
msgstr ""

#: jacques_ship/secret_sword/0/g-8/0
msgctxt "Beau"
msgid "Right! Yes."
msgstr ""

#: jacques_ship/secret_sword/0/g-8/8
msgctxt "Beau"
msgid "Begging your indulgence, I'd like to tell you why I require..."
msgstr ""

#: jacques_ship/secret_sword/0/g-8/16
msgctxt "Beau"
msgid "Why I request the great gift of the loan of your Sword."
msgstr ""

#: jacques_ship/secret_sword/0/g-8/24
msgctxt "Jacques"
msgid "Hmph. I wait with bated breath."
msgstr ""

#: jacques_ship/why_I_need_it/0/0
msgctxt "Beau"
msgid "I'm sure you know the Sword is ancient."
msgstr ""

#: jacques_ship/why_I_need_it/0/8
msgctxt "Beau"
msgid "Nobody knows exactly when it was created or by whom... if I understand my research correctly, Jacques, it just showed up one day in your hold."
msgstr ""

#: jacques_ship/why_I_need_it/0/16
msgctxt "Jacques"
msgid "Since we are now discussing something about which I care, I will deign to answer you."
msgstr ""

#: jacques_ship/why_I_need_it/0/24
msgctxt "Jacques"
msgid "That is correct. One day I awoke to find the sword in my hold, gleaming and sparkling in the early morning ocean light."
msgstr ""

#: jacques_ship/why_I_need_it/0/32
msgctxt "Beau"
msgid "The sword, ancient and glorious as it is, is also the only known key to defeating the fearsome Isolde!"
msgstr ""

#: jacques_ship/why_I_need_it/0/40
msgctxt "Jacques"
msgid "Blow me down!"
msgstr ""

#: jacques_ship/why_I_need_it/0/48
msgctxt "Jacques"
msgid "You lie. You must lie. But why would you? I have already defeated you, there is no way you could win either physically or by trickery so you must be saying the truth."
msgstr ""

#: jacques_ship/why_I_need_it/0/56
msgctxt "Jacques"
msgid "Or at least your version of the truth."
msgstr ""

#: jacques_ship/why_I_need_it/0/64
msgctxt "Jacques"
msgid "Isolde... the Isolde?"
msgstr ""

#: jacques_ship/why_I_need_it/0/72/s/0
msgctxt "Choix"
msgid "Who is Isolde?"
msgstr ""

#: jacques_ship/why_I_need_it/0/73/s/0
msgctxt "Choix"
msgid "Jacques, you know about this legend too? It's not just a Beau thing?"
msgstr ""

#: jacques_ship/why_I_need_it/0/g-0/0
msgctxt "Jacques"
msgid "She is a mighty and intrepid thief."
msgstr ""

#: jacques_ship/why_I_need_it/0/g-0/8
msgctxt "Jacques"
msgid "She reigned over the house with unquestioned power years ago, until one day she just disappeared."
msgstr ""

#: jacques_ship/why_I_need_it/0/g-0/16
msgctxt "Jacques"
msgid "There were searches. I believe at one point even a quest to attempt to find her and bring her home but all to no avail."
msgstr ""

#: jacques_ship/why_I_need_it/0/g-0/24
msgctxt "Beau"
msgid "Yeah. There was a quest. It was me."
msgstr ""

#: jacques_ship/why_I_need_it/0/g-0/32/s/0
msgctxt "Choix"
msgid "No way!"
msgstr ""

#: jacques_ship/why_I_need_it/0/g-0/33/s/0
msgctxt "Choix"
msgid "Oh, Beau, this is personal for you, huh?"
msgstr ""

#: jacques_ship/why_I_need_it/0/g-1/0
msgctxt "Beau"
msgid "But that's not what we're talking about right now."
msgstr ""

#: jacques_ship/why_I_need_it/0/g-1/8
msgctxt "Beau"
msgid "Jacques, the sword is the key. Without that sword, I cannot fight her. I cannot return her quarry to its rightful place."
msgstr ""

#: jacques_ship/why_I_need_it/0/g-1/16
msgctxt "Beau"
msgid "To be honest, without that sword... the greatest adventure of my existence ends right here, on the deck of your ship."
msgstr ""

#: jacques_ship/why_I_need_it/0/g-1/24
msgctxt "Jacques"
msgid "...follow me."
msgstr ""

#: jacques_ship/why_I_need_it/0/g-1/32
msgctxt "Narrator"
msgid "Jacques doesn't even wait for your answer before pushing past you and Beau. He doesn't bother turning as you call after him."
msgstr ""

#: jacques_ship/why_I_need_it/0/g-1/43/s/0
msgctxt "Choix"
msgid "Follow you where?"
msgstr ""

#: jacques_ship/why_I_need_it/0/g-1/44/s/0
msgctxt "Choix"
msgid "You're not gonna take us somewhere else and kill us, right?"
msgstr ""

#: jacques_ship/why_I_need_it/0/g-1/c-5/7
msgctxt "Beau"
msgid "Oh, don't you worry. We are not in any danger. Never were."
msgstr ""

#: jacques_ship/why_I_need_it/0/g-1/c-5/15
msgctxt "Jacques"
msgid "I can only pretend so many times that I do not hear your insolence, you jumped-up shoebox."
msgstr ""

#: jacques_ship/why_I_need_it/0/g-1/c-5/23
msgctxt "Jacques"
msgid "And no, innocent."
msgstr ""

#: jacques_ship/why_I_need_it/0/g-2/0
msgctxt "Narrator"
msgid "Jacques finally stops, turning to look at the two of you from over his shoulder. His expression is quite serious."
msgstr ""

#: jacques_ship/why_I_need_it/0/g-2/11
msgctxt "Jacques"
msgid "We're going to the hold."
msgstr ""

#: jacques_ship/the_hold/0/0
msgctxt "Narrator"
msgid "Jacques leads you to a place deep within his ship, looking at you and Beau with a grave expression."
msgstr ""

#: jacques_ship/the_hold/0/11
msgctxt "Jacques"
msgid "This is my inner sanctum."
msgstr ""

#: jacques_ship/the_hold/0/19
msgctxt "Jacques"
msgid "As you can imagine, nobody comes here. Mostly because without the magic of those glasses you're wearing, nobody could fit."
msgstr ""

#: jacques_ship/the_hold/0/27
msgctxt "Jacques"
msgid "With two hands reverently on its sanctified cover, I slowly, dramatically, slide the silken fabric off of the altar..."
msgstr ""

#: jacques_ship/the_hold/0/38/s/0
msgctxt "Choix"
msgid "What the hell is it with him and narrating everything?"
msgstr ""

#: jacques_ship/the_hold/0/39/s/0
msgctxt "Choix"
msgid "And... then?"
msgstr ""

#: jacques_ship/the_hold/0/c-0/7
msgctxt "Beau"
msgid "You got me. A personality quirk, I guess."
msgstr ""

#: jacques_ship/the_hold/0/c-0/15
msgctxt "Beau"
msgid "Most people have personalities with quirks. He has quirks as a personality."
msgstr ""

#: jacques_ship/the_hold/0/c-0/23
msgctxt "Beau"
msgid "But I'm done being picky."
msgstr ""

#: jacques_ship/the_hold/0/g-0/0
msgctxt "Jacques"
msgid "I present to you... the Secret Sword."
msgstr ""

#: jacques_ship/the_hold/0/g-0/8
msgctxt "Narrator"
msgid "He lifts the sword from its altar, his expression reverent and his touch careful."
msgstr ""

#: jacques_ship/the_hold/0/g-0/22
msgctxt "Beau"
msgid "Oh Great Betsy..."
msgstr ""

#: jacques_ship/the_hold/0/g-0/33
msgctxt "Beau"
msgid "That's the most beautiful thing I've ever seen! Look at all the shimmering gems, and how slim and delicate it is!"
msgstr ""

#: jacques_ship/the_hold/0/g-0/41/0/s/0
msgctxt "Choix"
msgid "Oh, my god."
msgstr ""

#: jacques_ship/the_hold/0/g-0/41/1/s/0
msgctxt "Choix"
msgid "You've got to be kidding me."
msgstr ""

#: jacques_ship/the_hold/0/g-0/41/c-2/7
msgctxt "Beau"
msgid "What?"
msgstr ""

#: jacques_ship/the_hold/0/g-0/41/c-3/7
msgctxt "Jacques"
msgid "Generally no, there is no \"kidding\" aboard my ship."
msgstr ""

#: jacques_ship/the_hold/0/g-2/0/s/0
msgctxt "Choix"
msgid "I recognize that."
msgstr ""

#: jacques_ship/the_hold/0/g-2/1/s/0
msgctxt "Choix"
msgid "I know that sword..."
msgstr ""

#: jacques_ship/the_hold/0/g-2/c-4/7
msgctxt "Jacques"
msgid "Recognize what? The Sword? You've seen it before??"
msgstr ""

#: jacques_ship/the_hold/0/g-2/c-5/7
msgctxt "Beau"
msgid "Gasp!"
msgstr ""

#: jacques_ship/the_hold/0/g-3/0/s/0
msgctxt "Choix"
msgid "Yeah. I... made it. When I was a kid."
msgstr ""

#: jacques_ship/the_hold/0/g-3/1/s/0
msgctxt "Choix"
msgid "That was an old childhood crafting mission I did."
msgstr ""

#: jacques_ship/the_hold/0/g-4/0
msgctxt "Beau"
msgid "You MADE IT??"
msgstr ""

#: jacques_ship/the_hold/0/g-4/8/s/0
msgctxt "Choix"
msgid "Yeah. With a bejeweling kit."
msgstr ""

#: jacques_ship/the_hold/0/g-4/9/s/0
msgctxt "Choix"
msgid "It's a toothpick, dipped in glue, and covered in glitter."
msgstr ""

#: jacques_ship/the_hold/0/g-5/0
msgctxt "Narrator"
msgid "Jacques's face twists into a furious expression, his voice nearly cracking with the bubbling rage of your perceived insult."
msgstr ""

#: jacques_ship/the_hold/0/g-5/8
msgctxt "Jacques"
msgid "You lie! YOU LIE!!"
msgstr ""

#: jacques_ship/the_hold/0/g-5/19
msgctxt "Jacques"
msgid "This is a sacred and magical object that appeared here, in MY hold one day and I will protect it with my life!"
msgstr ""

#: jacques_ship/the_hold/0/g-5/27
msgctxt "Beau"
msgid "Damn right, Jacques, it IS sacred and special!"
msgstr ""

#: jacques_ship/the_hold/0/g-5/35
msgctxt "Beau"
msgid "Whoa. I think Jacques is right. That's unexpected."
msgstr ""

#: jacques_ship/the_hold/0/g-5/43/s/0
msgctxt "Choix"
msgid "You two are agreeing. That's... good progress!"
msgstr ""

#: jacques_ship/the_hold/0/g-5/44/s/0
msgctxt "Choix"
msgid "I see that your relationship with each other is progressing..."
msgstr ""

#: jacques_ship/the_hold/0/g-6/0
msgctxt "Beau"
msgid "I don't know that I'd call that progress."
msgstr ""

#: jacques_ship/the_hold/0/g-6/8
msgctxt "Beau"
msgid "That would imply that we had a goal toward progress... which we don't."
msgstr ""

#: jacques_ship/the_hold/0/g-6/16
msgctxt "Beau"
msgid "I don't think. He needs to agree to give me the sword for-"
msgstr ""

#: jacques_ship/the_hold/0/g-6/24
msgctxt "Jacques"
msgid "GIVE?? You said borrow! You said nothing about give at all, this was always a loan, a temporary state of affairs!"
msgstr ""

#: jacques_ship/the_hold/0/g-6/32
msgctxt "Jacques"
msgid "But fortunately, or unfortunately, depending on your perspective, it is not just a simple matter of loaning you my single most precious possession."
msgstr ""

#: jacques_ship/the_hold/0/g-6/40
msgctxt "Jacques"
msgid "You see..."
msgstr ""

#: jacques_ship/jacques_going_too/0/0
msgctxt "Jacques"
msgid "I... am going with you."
msgstr ""

#: jacques_ship/jacques_going_too/0/8
msgctxt "Beau"
msgid "What?!?!?"
msgstr ""

#: jacques_ship/jacques_going_too/0/19/s/0
msgctxt "Choix"
msgid "Ooohhh man, I don't think that's gonna work..."
msgstr ""

#: jacques_ship/jacques_going_too/0/20/s/0
msgctxt "Choix"
msgid "Ha! Of course! Love it!"
msgstr ""

#: jacques_ship/jacques_going_too/0/c-0/7
msgctxt "Jacques"
msgid "You'd better believe it will."
msgstr ""

#: jacques_ship/jacques_going_too/0/g-0/0
msgctxt "Jacques"
msgid "I desire adventure. Need it."
msgstr ""

#: jacques_ship/jacques_going_too/0/g-0/8
msgctxt "Jacques"
msgid "Even more than I detest your cardboard company."
msgstr ""

#: jacques_ship/jacques_going_too/0/g-0/16
msgctxt "Beau"
msgid "No the hell you're not!! Over my dead boxes!"
msgstr ""

#: jacques_ship/jacques_going_too/0/g-0/24
msgctxt "Beau"
msgid "No."
msgstr ""

#: jacques_ship/jacques_going_too/0/g-0/35/s/0
msgctxt "Choix"
msgid "C'mon Beau. It's fun to watch you two go at it."
msgstr ""

#: jacques_ship/jacques_going_too/0/g-0/36/s/0
msgctxt "Choix"
msgid "It seems this quest is bigger than both of you."
msgstr ""

#: jacques_ship/jacques_going_too/0/g-0/c-2/7
msgctxt "Jacques"
msgid "Then we'll meet up when we've all had a chance to prepare ourselves."
msgstr ""

#: jacques_ship/jacques_going_too/0/g-0/c-2/15
msgctxt "Beau"
msgid "Sounds good to me!"
msgstr ""

#: jacques_ship/jacques_going_too/0/g-0/c-2/23
msgctxt "Beau"
msgid "See you soon, questers...."
msgstr ""

#: jacques_ship/jacques_going_too/0/g-0/c-3/7
msgctxt "Jacques"
msgid "Child, you have no idea just how MUCH bottle I can be!"
msgstr ""

#: jacques_ship/jacques_going_too/0/g-0/c-3/15
msgctxt "Beau"
msgid "If it has to be... it has to be."
msgstr ""

#: jacques_ship/jacques_going_too/0/g-0/c-3/23
msgctxt "Beau"
msgid "I'm gonna go get my quips ready, though. Because this is the biggest adventure of my entire life and I'm sure as hell not gonna miss it."
msgstr ""

#: jacques_ship/jacques_going_too/0/g-0/c-3/31
msgctxt "Jacques"
msgid "Onward - to the boxes!"
msgstr ""

#: jacques_ship/jacques_no_quest_endings/0/0
msgctxt "Jacques"
msgid "Oh."
msgstr ""

#: jacques_ship/jacques_no_quest_endings/0/8
msgctxt "Jacques"
msgid "I see you're back. With no adventures."
msgstr ""

#: jacques_ship/jacques_no_quest_endings/0/32/s/0
msgctxt "Choix"
msgid "You mean, Beau?"
msgstr ""

#: jacques_ship/jacques_no_quest_endings/0/c-0/7
msgctxt "Jacques"
msgid "Aye."
msgstr ""

#: jacques_ship/jacques_no_quest_endings/0/c-0/15
msgctxt "Jacques"
msgid "I never was a fan of that one... but she did stir things up quite well."
msgstr ""

#: jacques_ship/jacques_realize_join/0/0
msgctxt "Jacques"
msgid "Sweet Poseidon's parasols WHAT DO YOU WANT??"
msgstr ""

#: jacques_ship/jacques_realize_join/0/8/s/0
msgctxt "Choix"
msgid "Um, wow, cool it, I'm actually here to give you a gift."
msgstr ""

#: jacques_ship/jacques_realize_join/0/9/s/0
msgctxt "Choix"
msgid "I'd like to Realize you."
msgstr ""

#: jacques_ship/jacques_realize_join/0/c-0/7
msgctxt "Jacques"
msgid "Gifts?? I hate gifts! How dare you!"
msgstr ""

#: jacques_ship/jacques_realize_join/0/c-0/15/0/s/0
msgctxt "Choix"
msgid "Do you really?"
msgstr ""

#: jacques_ship/jacques_realize_join/0/c-0/15/c-0/7
msgctxt "Jacques"
msgid "Oh alright alright no, not really, I don't hate gifts but I had excess vitriol to vent and now that's done so yes, give me the gift."
msgstr ""

#: jacques_ship/jacques_realize_join/0/c-0/15/c-0/15
msgctxt "Jacques"
msgid "And be quick about it!"
msgstr ""

#: jacques_ship/jacques_realize_join/0/c-1/15/0/s/0
msgctxt "Choix"
msgid "Jacques?"
msgstr ""

#: jacques_ship/jacques_realize_join/0/c-1/15/1/s/0
msgctxt "Choix"
msgid "You ok? You look... not great."
msgstr ""

#: jacques_ship/jacques_realize_join/0/g-0/0
msgctxt "Jacques"
msgid "Realize? As in... life. You want to bring me to life!"
msgstr ""

#: jacques_ship/jacques_realize_join/0/g-0/8/s/0
msgctxt "Choix"
msgid "Yep! You wanna?"
msgstr ""

#: jacques_ship/jacques_realize_join/0/g-0/c-2/7
msgctxt "Jacques"
msgid "By all that's blue and watery, YES!"
msgstr ""

#: jacques_ship/jacques_realize_join/0/g-0/c-2/15
msgctxt "Jacques"
msgid "Can we do it now? I mean right now?"
msgstr ""

#: jacques_ship/jacques_realize_join/0/g-0/c-2/32/0/s/0
msgctxt "Choix"
msgid "Yes, I've got everything we need!"
msgstr ""

#: jacques_ship/jacques_realize_join/0/g-0/c-2/32/1/s/0
msgctxt "Choix"
msgid "Not quite. I wanted to make sure you were into the idea first!"
msgstr ""

#: jacques_ship/jacques_realize_join/0/g-0/c-2/32/c-1/10
msgctxt "Jacques"
msgid "Well then congratulations, you've gotten me to display a strong opinion."
msgstr ""

#: jacques_ship/jacques_realize_join/0/g-0/c-2/32/c-1/18
msgctxt "Jacques"
msgid "YES I'M INTO THE IDEA."
msgstr ""

#: jacques_ship/jacques_realize_join/0/g-0/c-2/32/c-1/29
msgctxt "Jacques"
msgid "I'll wait right here. Planning all the conquering I'll be able to effect when I'm... human..."
msgstr ""

#: jacques_ship/jacques_realize_join/0/g-0/c-2/32/c-1/37
msgctxt "Jacques"
msgid "Oh Gravy Jones, I can hardly contain myself!"
msgstr ""

#: jacques_ship/jacques_realize_join/0/g-0/c-2/32/c-1/45
msgctxt "Jacques"
msgid "Hurry up!"
msgstr ""

#: jacques_ship/jacques_realize_return/0/0
msgctxt "Jacques"
msgid "You're back. Have you acquired the requisite treasure?"
msgstr ""

#: jacques_ship/jacques_realize_return/0/17/s/0
msgctxt "Choix"
msgid "Got it right here!"
msgstr ""

#: jacques_ship/jacques_realize_return/0/18/s/0
msgctxt "Choix"
msgid "Ah, not yet, sorry!"
msgstr ""

#: jacques_ship/jacques_realize_return/0/c-1/10
msgctxt "Jacques"
msgid "I know I said I wouldn't kill you."
msgstr ""

#: jacques_ship/jacques_realize_return/0/c-1/18
msgctxt "Jacques"
msgid "I may have to revisit that prohibition."
msgstr ""

#: jacques_ship/jacques_realize_return/0/c-1/26
msgctxt "Jacques"
msgid "On your merry way, little guppy..."
msgstr ""

#: jacques_ship/jacques_realize_begin/6/b/1
msgctxt "Skylar"
msgid "I'm not sure this Realization thing will work on someone as stubborn as Jacques..."
msgstr ""

#: jacques_ship/jacques_realize_begin/9
msgctxt "Skylar"
msgid "Captain Jacques, prepare to be boarded!"
msgstr ""

#: jacques_ship/jacques_realize_begin/20
msgctxt "Narrator"
msgid "The spectral energy flows through your dateviators, and what was once merely a ship in a bottle, becomes...."
msgstr ""

#: jacques_ship/jacques_realized/0/3
msgctxt "Jacques"
msgid "My god.... I AM!!"
msgstr ""

#: jacques_ship/jacques_realized/0/11
msgctxt "Jacques"
msgid "I'm FABULOUS."
msgstr ""

#: jacques_ship/jacques_realized/0/19
msgctxt "Jacques"
msgid "I'm fearsome and bearded and thank Poseidon I still have all me flesh!"
msgstr ""

#: jacques_ship/jacques_realized/0/27/s/0
msgctxt "Choix"
msgid "You look great, Jacques! Enjoy being alive. Can't wait to see what you get up to!"
msgstr ""

#: jacques_ship/jacques_realized/0/28/s/0
msgctxt "Choix"
msgid "I mean, damn. I thought you were hot before..."
msgstr ""

#: jacques_ship/jacques_love_divert/0/0
msgctxt "Jacques"
msgid "And now? Let me guess. You can't tear your sex-starved ogglers away from my crested, rolling, deep blue realness?"
msgstr ""

#: jacques_ship/jacques_love_divert/0/8/s/0
msgctxt "Choix"
msgid "Basically, yeah."
msgstr ""

#: jacques_ship/jacques_love_divert/0/9/s/0
msgctxt "Choix"
msgid "Right here, right now, real boy. Let's go."
msgstr ""

#: jacques_ship/jacques_love_divert/0/g-0/0
msgctxt "Jacques"
msgid "Then uh... enough prattle, as they say hehe. Into the steaming and plundering adventure we go!"
msgstr ""

#: jacques_ship/jacques_love_divert/0/g-0/8
msgctxt "Jacques"
msgid "There are so many new weapons in my arsenal..."
msgstr ""

#: jacques_ship/jacques_love_divert/0/g-0/16
msgctxt "Jacques"
msgid "I hope you're ready to be the primary target of my projectiles, if you know what I mean, eh? Ha ha ha, eh? Eh? No? Oh, alright."
msgstr ""

#: jacques_ship/jacques_love_divert/0/g-0/24/s/0
msgctxt "Choix"
msgid "Fire away, Captain Hotpants!"
msgstr ""

#: jacques_ship/jacques_love_divert/0/g-0/c-2/7
msgctxt "Narrator"
msgid "Let's just say, you've earned your grog and hardtack this night."
msgstr ""

#: jacques_ship/jacques_love_join/0
msgctxt "Narrator"
msgid "Jacques wasted no time making his imprint on the world at large. Being utterly unwilling to give up his life on the sea, he made his way immediately to the port and declared in a bloody-minded tone:"
msgstr ""

#: jacques_ship/jacques_love_join/8
msgctxt "Jacques"
msgid "The finest captain on this or any ocean seeks employment! Plunder, passion and pitilessness required!"
msgstr ""

#: jacques_ship/jacques_love_join/16
msgctxt "Narrator"
msgid "What Jacques did not realize was that, when combined with his flamboyantly colorful attire, the effect he produced was somewhat other than intended."
msgstr ""

#: jacques_ship/jacques_love_join/24
msgctxt "Narrator"
msgid "He was gleefully approached by the CEO of Fantasy Cruiselines who offered him a job as the captain of their flagship, the Brazen Belle."
msgstr ""

#: jacques_ship/jacques_love_join/32
msgctxt "Narrator"
msgid "The Belle was tasked with escorting guests around the old pirate haunts of the Caribbean, immersing them in the (fancied up, of course) life of piracy and bacchanalia that makes that moment in history so rich and seductive."
msgstr ""

#: jacques_ship/jacques_love_join/40
msgctxt "Jacques"
msgid "Allow me, if you will, sir, to understand you."
msgstr ""

#: jacques_ship/jacques_love_join/48
msgctxt "Jacques"
msgid "These people will board my ship willingly."
msgstr ""

#: jacques_ship/jacques_love_join/56
msgctxt "Narrator"
msgid "The CEO said yes."
msgstr ""

#: jacques_ship/jacques_love_join/64
msgctxt "Jacques"
msgid "They will bring money. And jewelry. Loose morals and a sense of inborn security that I do not have to work to produce. They will bring their own booty?"
msgstr ""

#: jacques_ship/jacques_love_join/72
msgctxt "Narrator"
msgid "Slightly more troubled, the CEO again said yes."
msgstr ""

#: jacques_ship/jacques_love_join/80
msgctxt "Jacques"
msgid "I'm going to take them to my favorite ports, my favorite whistle-wetters, the best wrecks and hunting sites, the sunsets that stir my soul, the beaches that bring tears and memories of great bloody deeds to my mind's eye."
msgstr ""

#: jacques_ship/jacques_love_join/88
msgctxt "Narrator"
msgid "Charmed now, the CEO nodded."
msgstr ""

#: jacques_ship/jacques_love_join/96
msgctxt "Jacques"
msgid "And you will pay me????"
msgstr ""

#: jacques_ship/jacques_love_join/104
msgctxt "Narrator"
msgid "As it turned out, they were going to pay him quite a lot."
msgstr ""

#: jacques_ship/jacques_love_join/112
msgctxt "Narrator"
msgid "The one proviso was that he was not, unfortunately, allowed to rob, maim or kill any of the guests."
msgstr ""

#: jacques_ship/jacques_love_join/120
msgctxt "Narrator"
msgid "Jacques grumbled, but tightened his sword belt and assented."
msgstr ""
