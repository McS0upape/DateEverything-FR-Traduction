#: tim_clock/timmy_worse/0/c-2/48/c-2/41/1/s/0
msgctxt "Choix"
msgid "Well..."
msgstr ""

#: tim_clock/timmy_worse/0/c-2/48/c-2/41/c-0/7
msgctxt "Timmy"
msgid "That's why Timmy likes you, nya."
