# Traduction IA – à relire
#: curtrod_curtain/13 curtrod_curtain/shade_gym/0/19 curtrod_curtain/shade_foyer/0/19 curtrod_curtain/shade_bedroom/0/16 curtrod_curtain/shade_piano_room/0/19 curtrod_curtain/shade_dining_room/0/19 curtrod_curtain/shade_kitchen/0/4 curtrod_curtain/shade_office/0/19 curtrod_curtain/shade_laundry/0/13
msgctxt "Tag Nom d'objet (MAJUSCULES)"
msgid "CURTAINS"
msgstr "RIDEAUX"

# Traduction IA – à relire
#: curtrod_curtain/curtrod_already_visited/0
msgctxt "Rod"
msgid "Oh, you trying to hang out right now?"
msgstr "Oh, tu veux traîner avec nous, là, maintenant ?"

# Traduction IA – à relire
#: curtrod_curtain/curtrod_already_visited/8/b/1
msgctxt "Curt"
msgid "Of course they are! We're the coolest duo in this house!"
msgstr "Bien sûr que oui ! On est le duo le plus cool de cette maison !"

# Traduction IA – à relire
#: curtrod_curtain/curtrod_already_visited/9/b/1
msgctxt "Curt"
msgid "Of course she is! We're the coolest duo in this house!"
msgstr "Bien sûr que oui ! On est le duo le plus cool de cette maison !"

# Traduction IA – à relire
#: curtrod_curtain/curtrod_already_visited/10/b/1
msgctxt "Curt"
msgid "Of course he is! We're the coolest duo in this house!"
msgstr "Bien sûr que oui ! On est le duo le plus cool de cette maison !"

# Traduction IA – à relire
#: curtrod_curtain/curtrod_already_visited/13
msgctxt "Rod"
msgid "There ain't much happening over here, though. But, check another window or something."
msgstr "Mais y a pas grand-chose qui se passe par ici. Va voir une autre fenêtre ou je sais pas quoi."

# Traduction IA – à relire
#: curtrod_curtain/curtrod_already_visited/21
msgctxt "Curt"
msgid "Something has to be poppin' off somewhere else. You know, besides Rod's mouth."
msgstr "Y a forcément un truc qui pète ailleurs. Je dis ça, c'est pas la bouche de Rod qui va te l'offrir."

# Traduction IA – à relire
#: curtrod_curtain/curtrod_already_visited/29 curtrod_curtain/shade_foyer/0/g-1/c-3/109 curtrod_curtain/shade_bedroom/0/g-1/c-7/88 curtrod_curtain/rod_chat/30
msgctxt "Curt and Rod"
msgid "Hahahaha!"
msgstr "Hahahaha !"

# Traduction IA – à relire
#: curtrod_curtain/curtrod_already_visited/46
msgctxt "Rod"
msgid "We'll see you at the new spot!"
msgstr "On se voit au nouveau spot !"

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/4
msgctxt "Narrator"
msgid "A charming, well-dressed duo stand with their backs to you, peering through the curtains and pointing at something outside that you can't see. They seem quite absorbed in their own conversation."
msgstr "Un duo charmant et bien sapé se tient dos à vous, scrutant la rue à travers les rideaux et pointant du doigt quelque chose que vous ne pouvez pas voir. Ils semblent tout absorbés par leur conversation."

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/15
msgctxt "Curt"
msgid "Look over there. Look at that. Across the street."
msgstr "Regarde là-bas. Regarde ça. De l'autre côté de la rue."

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/23
msgctxt "Rod"
msgid "What are we looking at?"
msgstr "On regarde quoi ?"

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/31
msgctxt "Curt"
msgid "What do you see, Rod?"
msgstr "Qu'est-ce que tu vois, Rod ?"

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/39
msgctxt "Rod"
msgid "I see a dog. I see a car that could use a wash."
msgstr "Je vois un chien. Je vois une caisse qui aurait bien besoin d'un lavage."

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/47/s/0
msgctxt "Choix"
msgid "Hey guys!"
msgstr "Salut les gars !"

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/48/s/0
msgctxt "Choix"
msgid "I have Awakened you two - speak to me... the Human!"
msgstr "Je vous ai Éveillés tous les deux, parlez à... {{l'Humain|l'Humaine|l'Humain·e}} !"

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/c-1/7
msgctxt "Rod"
msgid "... the fuck?"
msgstr "... c'est quoi ce bordel ?"

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-0/0
msgctxt "Narrator"
msgid "One of them turns to you, holding up a finger before turning back to his friend."
msgstr "L'un d'eux se tourne vers vous, lève un doigt, puis se retourne vers son ami."

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-0/8
msgctxt "Curt"
msgid "Hi, one second."
msgstr "Salut, une seconde."

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-0/16
msgctxt "Curt"
msgid "Now, why in the world do you think I'd care a single thread about an unwashed car."
msgstr "Maintenant, dis-moi pourquoi diable je me soucierais d'un fil de cette voiture pleine de crasse."

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-0/24
msgctxt "Rod"
msgid "I don't know what you want from life, Curt!"
msgstr "Je sais pas ce que tu veux de la vie, Curt !"

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-0/32
msgctxt "Curt"
msgid "The shoes, my dude! The shoes!"
msgstr "Les chaussures, mon pote ! Les chaussures !"

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-0/40
msgctxt "Rod"
msgid "Ooooo! You were looking at the neighbor's shoes."
msgstr "Ooooo ! Tu matais les pompes du voisin."

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-0/48
msgctxt "Rod"
msgid "Those are niiiiiice!"
msgstr "Elles sont troooop classes !"

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-0/56
msgctxt "Curt"
msgid "Right? That's what I'm saying."
msgstr "Pas vrai ? C'est ce que je dis."

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-0/64/s/0
msgctxt "Choix"
msgid "Hey there."
msgstr "Salut."

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-0/65/s/0
msgctxt "Choix"
msgid "Bruh."
msgstr "Wesh."

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-1/0
msgctxt "Rod"
msgid "Uhuh. Hold on."
msgstr "Ouais, ouais. Attends."

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-1/8
msgctxt "Rod"
msgid "Those are way better than those shoes we saw last week."
msgstr "Elles sont bien meilleures que celles qu'on a vues la semaine dernière."

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-1/16
msgctxt "Curt"
msgid "Ain't that the truth. Only time I wished Wyndolyn would have fogged up."
msgstr "Ça, c'est sûr. La seule fois où j'aurais voulu que Wyndolyn se couvre de buée."

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-1/27
msgctxt "Rod"
msgid "Those kicks could have kicked rocks!"
msgstr "Ces pompes, elles pouvaient aller se faire voir à pied !"

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-1/35 curtrod_curtain/curtrod_realize_friend_join/38
msgctxt "Curt and Rod"
msgid "Hahaha!"
msgstr "Hahaha !"

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-1/52/s/0
msgctxt "Choix"
msgid "Hellooooo!!!"
msgstr "Coucouuuu !!!"

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-1/53/s/0
msgctxt "Choix"
msgid "HAHAHAHAHAHAHA!!"
msgstr "HAHAHAHAHAHAHA !!"

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-2/0
msgctxt "Rod"
msgid "...what was that about?"
msgstr "... c'était quoi, ça ?"

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-2/11
msgctxt "Curt"
msgid "Rod! Don't be so rude!"
msgstr "Rod ! Sois pas si impoli !"

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-2/19
msgctxt "Rod"
msgid "I'm just giving what I was receiving."
msgstr "Je rends juste ce qu'on me donne."

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-2/27
msgctxt "Curt"
msgid "You'll have to excuse Rod. His tact leaves a lot to be desired."
msgstr "Excuse Rod. Son tact laisse sérieusement à désirer."

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-2/35
msgctxt "Rod"
msgid "There you go, talking about me like I'm not here."
msgstr "Voilà, tu parles de moi comme si j'étais pas là."

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-2/43
msgctxt "Curt"
msgid "Naw, I'm talking about you so you can hear. There's a difference."
msgstr "Nan, je parle de toi pour que tu m'entendes. C'est pas pareil."

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-2/51
msgctxt "Rod"
msgid "See, that's why your seams are unfinished!"
msgstr "Tu vois, c'est pour ça que tes coutures sont pas finies !"

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-2/62
msgctxt "Curt"
msgid "My seams are unfinished? MY seams are unfinished? Keep talking, see what happens."
msgstr "Mes coutures sont pas finies ? MES coutures sont pas finies ? Continue, tu vas voir."

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-2/73
msgctxt "Rod"
msgid "You ain't gonna do nothin'. You love me too much."
msgstr "Tu feras rien du tout. Tu m'aimes trop."

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-2/81
msgctxt "Curt"
msgid "Yeah, okay. Don't say that too loud. Everyone else might start believing it."
msgstr "Ouais, ok. Dis-le pas trop fort. Les autres pourraient finir par le croire."

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-2/92/s/0
msgctxt "Choix"
msgid "Are... you two okay?"
msgstr "Vous... vous allez bien, tous les deux ?"

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-2/93/s/0
msgctxt "Choix"
msgid "You both hate each other, don't you?"
msgstr "Vous vous détestez, c'est ça ?"

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-2/94/s/0
msgctxt "Choix"
msgid "How long have you two known each other?"
msgstr "Ça fait combien de temps que vous vous connaissez ?"

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-2/c-7/7
msgctxt "Curt"
msgid "What? Why would you think that? Rod's my best friend."
msgstr "Quoi ? Pourquoi tu penses ça ? Rod, c'est mon meilleur pote."

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-3/0
msgctxt "Rod"
msgid "Curt and I have been together forever."
msgstr "Curt et moi, on est ensemble depuis toujours."

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-3/11
msgctxt "Curt"
msgid "I'm like his brother."
msgstr "C'est comme mon frère."

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-3/19
msgctxt "Rod"
msgid "But not my brother."
msgstr "Mais pas mon frère."

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-3/27
msgctxt "Curt"
msgid "If we were related, you might actually be polished."
msgstr "Si on était de la famille, tu serais peut-être enfin poli."

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-3/35
msgctxt "Rod"
msgid "We both know you wouldn't look good unless you were next to me."
msgstr "On sait tous les deux que tu serais moche si t'étais pas à côté de moi."

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-3/43
msgctxt "Curt"
msgid "Who told you that lie?"
msgstr "Qui t'a sorti ce mensonge ?"

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-3/51
msgctxt "Curt"
msgid "Say. Who do you think looks better? Me or this delusional drape I call my friend?"
msgstr "Dis-moi. Qui est le plus beau, d'après toi ? Moi ou ce drapé délirant que j'appelle mon ami ?"

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-3/59/s/0
msgctxt "Choix"
msgid "Uhh... you both look good?"
msgstr "Euh... vous êtes beaux tous les deux ?"

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-3/60/s/0
msgctxt "Choix"
msgid "You know it's you, Curt."
msgstr "Tu sais bien que c'est toi, Curt."

# Traduction IA – à relire
#: curtrod_curtain/curtrod_intro/0/g-3/61/s/0
msgctxt "Choix"
msgid "Rod is rockin' it."
msgstr "Rod, il assure."

# Traduction IA – à relire
#: curtrod_curtain/Neutral_answer/0/0
msgctxt "Rod"
msgid "Pssssssssh!"
msgstr "Pfffffffff !"

# Traduction IA – à relire
#: curtrod_curtain/Neutral_answer/0/8
msgctxt "Curt"
msgid "Laaaaaame."
msgstr "Nuuuuul."

# Traduction IA – à relire
#: curtrod_curtain/Neutral_answer/0/16
msgctxt "Rod"
msgid "I know it's me. That's fine. It'll be our little secret."
msgstr "Je sais que c'est moi. C'est bon. Ça restera notre petit secret."

# Traduction IA – à relire
#: curtrod_curtain/Neutral_answer/0/24/b/1
msgctxt "Curt"
msgid "Don't even try to make them lie. They are just trying to make you feel good. I'm the fly one."
msgstr "Essaie même pas de lui faire dire un mensonge. Iel veut juste te faire plaisir. Le stylé, c'est moi."

# Traduction IA – à relire
#: curtrod_curtain/Neutral_answer/0/25/b/1
msgctxt "Curt"
msgid "Don't even try to make her lie. She is just trying to make you feel good. I'm the fly one."
msgstr "Essaie même pas de lui faire dire un mensonge. Elle veut juste te faire plaisir. Le stylé, c'est moi."

# Traduction IA – à relire
#: curtrod_curtain/Neutral_answer/0/26/b/1
msgctxt "Curt"
msgid "Don't even try to make him lie. He is just trying to make you feel good. I'm the fly one."
msgstr "Essaie même pas de lui faire dire un mensonge. Il veut juste te faire plaisir. Le stylé, c'est moi."

# Traduction IA – à relire
#: curtrod_curtain/Neutral_answer/0/29/s/0
msgctxt "Choix"
msgid "Why do you talk like you're from the 90s?"
msgstr "Pourquoi vous parlez comme si vous étiez des années 90 ?"

# Traduction IA – à relire
#: curtrod_curtain/Neutral_answer/0/30/s/0
msgctxt "Choix"
msgid "You're both fly! You don't have to be so mean."
msgstr "Vous êtes stylés tous les deux ! Pas la peine d'être aussi méchants."

# Traduction IA – à relire
#: curtrod_curtain/Neutral_answer/0/31/s/0
msgctxt "Choix"
msgid "You are, Curt!"
msgstr "C'est toi, Curt !"

# Traduction IA – à relire
#: curtrod_curtain/Neutral_answer/0/32/s/0
msgctxt "Choix"
msgid "I'm team Rod."
msgstr "Je suis team Rod."

# Traduction IA – à relire
#: curtrod_curtain/Neutral_answer/0/c-0/7
msgctxt "Rod"
msgid "Product of our time. That's when we were made. Solid thrift store find."
msgstr "Produits de notre époque. C'est là qu'on a été faits. Belle trouvaille de friperie."

# Traduction IA – à relire
#: curtrod_curtain/Neutral_answer/0/c-0/15
msgctxt "Curt"
msgid "The fact someone thought we were out of style... ridiculous."
msgstr "Que quelqu'un ait pu nous croire démodés... ridicule."

# Traduction IA – à relire
#: curtrod_curtain/Neutral_answer/0/c-0/23
msgctxt "Rod"
msgid "The last place we were? Busted."
msgstr "Le dernier endroit où on était ? Pourri."

# Traduction IA – à relire
#: curtrod_curtain/Neutral_answer/0/c-0/34
msgctxt "Curt"
msgid "Tore up from the floor up."
msgstr "Défoncé de la cave au grenier."

# Traduction IA – à relire
#: curtrod_curtain/Neutral_answer/0/c-0/45
msgctxt "Rod"
msgid "And it made you wanna throw up!"
msgstr "Et ça donnait envie de rendre son déjeuner !"

# Traduction IA – à relire
#: curtrod_curtain/Neutral_answer/0/c-0/53
msgctxt "Curt"
msgid "Hahahahaha! Solid landing."
msgstr "Hahahahaha ! Belle réception."

# Traduction IA – à relire
#: curtrod_curtain/Neutral_answer/0/c-0/61
msgctxt "Rod"
msgid "See? I've got the looks and the jokes."
msgstr "Tu vois ? J'ai le look et les blagues."

# Traduction IA – à relire
#: curtrod_curtain/Neutral_answer/0/c-0/69
msgctxt "Curt"
msgid "Only joke you got is what you've got on."
msgstr "La seule blague chez toi, c'est ce que t'as sur le dos."

# Traduction IA – à relire
#: curtrod_curtain/Neutral_answer/0/c-0/77/0/s/0
msgctxt "Choix"
msgid "You two are pretty mean to each other."
msgstr "Vous êtes assez méchants l'un avec l'autre."

# Traduction IA – à relire
#: curtrod_curtain/Neutral_answer/0/c-0/77/1/s/0
msgctxt "Choix"
msgid "That was a good one. It is a pretty ugly shirt."
msgstr "Celle-là était bonne. C'est vrai qu'elle est assez moche, cette chemise."

# Traduction IA – à relire
#: curtrod_curtain/Neutral_answer/0/c-0/77/c-0/7 curtrod_curtain/Neutral_answer/0/c-3/7
msgctxt "Curt"
msgid "Now, hold on a second."
msgstr "Attends une seconde."

# Traduction IA – à relire
#: curtrod_curtain/Neutral_answer/0/c-0/77/c-1/7
msgctxt "Curt"
msgid "Daaaamn! You didn't have to go that hard."
msgstr "Aïe aïe aïe ! T'avais pas besoin de taper aussi fort."

# Traduction IA – à relire
#: curtrod_curtain/Neutral_answer/0/g-0/0
msgctxt "Curt"
msgid "One thing you gotta realize is that we aren't mean to each other."
msgstr "Faut que tu comprennes un truc : on n'est pas méchants l'un avec l'autre."

# Traduction IA – à relire
#: curtrod_curtain/Neutral_answer/0/g-0/8
msgctxt "Rod"
msgid "Naw, this is my homie. For life."
msgstr "Nan, c'est mon poto. Pour la vie."

# Traduction IA – à relire
#: curtrod_curtain/Neutral_answer/0/g-0/16
msgctxt "Curt"
msgid "We're just a little shady."
msgstr "On chambre juste un peu."

# Traduction IA – à relire
#: curtrod_curtain/Neutral_answer/0/g-0/24/s/0
msgctxt "Choix"
msgid "Aren't they the same thing?"
msgstr "C'est pas la même chose ?"

# Traduction IA – à relire
#: curtrod_curtain/Neutral_answer/0/g-0/25/s/0
msgctxt "Choix"
msgid "I... I don't... what?"
msgstr "Je... je comprends pas... quoi ?"

# Traduction IA – à relire
#: curtrod_curtain/Neutral_answer/0/g-0/26/s/0
msgctxt "Choix"
msgid "If we're talking throwing shade, I'm all about it."
msgstr "Si on parle de chambrage, moi je suis à fond."

# Traduction IA – à relire
#: curtrod_curtain/Curt_answer/0/0
msgctxt "Rod"
msgid "Yoooo! What? Naw. I claim bias."
msgstr "Yoooo ! Quoi ? Nan. Je dénonce un parti pris."

# Traduction IA – à relire
#: curtrod_curtain/Curt_answer/0/8
msgctxt "Curt"
msgid "You don't even know what that means!"
msgstr "Tu sais même pas ce que ça veut dire !"

# Traduction IA – à relire
#: curtrod_curtain/Curt_answer/0/16/b/1
msgctxt "Rod"
msgid "You asked the question, so they sided with you! Bias!"
msgstr "C'est toi qui as posé la question, donc iel est de ton côté ! Parti pris !"

# Traduction IA – à relire
#: curtrod_curtain/Curt_answer/0/17/b/1
msgctxt "Rod"
msgid "You asked the question, so she sided with you! Bias!"
msgstr "C'est toi qui as posé la question, donc elle est de ton côté ! Parti pris !"

# Traduction IA – à relire
#: curtrod_curtain/Curt_answer/0/18/b/1
msgctxt "Rod"
msgid "You asked the question, so he sided with you! Bias!"
msgstr "C'est toi qui as posé la question, donc il est de ton côté ! Parti pris !"

# Traduction IA – à relire
#: curtrod_curtain/Curt_answer/0/21
msgctxt "Curt"
msgid "...okay, so you do know what the word means."
msgstr "... ok, donc tu sais ce que ça veut dire."

# Traduction IA – à relire
#: curtrod_curtain/Curt_answer/0/29
msgctxt "Rod"
msgid "I bet if I asked Wyndolyn, she would..."
msgstr "Je parie que si je demandais à Wyndolyn, elle..."

# Traduction IA – à relire
#: curtrod_curtain/Curt_answer/0/40
msgctxt "Curt"
msgid "You ain't 'bout to ask Wyndolyn nothing. Take the L and admit you just about as dusty as that car out front."
msgstr "Tu vas rien demander du tout à Wyndolyn. Prends ta claque et avoue que t'es aussi poussiéreux que la caisse là-devant."

# Traduction IA – à relire
#: curtrod_curtain/Curt_answer/0/48
msgctxt "Rod"
msgid "Oh, you got jokes!"
msgstr "Oh, tu fais des blagues !"

# Traduction IA – à relire
#: curtrod_curtain/Curt_answer/0/56
msgctxt "Curt"
msgid "And style. And charm. Thank you for paying attention."
msgstr "Et j'ai du style. Et du charme. Merci de ton attention."

# Traduction IA – à relire
#: curtrod_curtain/Curt_answer/0/64/s/0
msgctxt "Choix"
msgid "This is tough to listen to."
msgstr "C'est dur à écouter."

# Traduction IA – à relire
#: curtrod_curtain/Curt_answer/0/65/s/0
msgctxt "Choix"
msgid "You don't seem like friends. Like, at all."
msgstr "On dirait pas des amis. Genre, pas du tout."

# Traduction IA – à relire
#: curtrod_curtain/Curt_answer/0/66/s/0
msgctxt "Choix"
msgid "You guys have great chemistry together."
msgstr "Vous avez une super alchimie, tous les deux."

# Traduction IA – à relire
#: curtrod_curtain/Curt_answer/0/g-0/0
msgctxt "Curt"
msgid "Why is that? Because we pull each other's threads?"
msgstr "Pourquoi ça ? Parce qu'on se tire les fils ?"

# Traduction IA – à relire
#: curtrod_curtain/Curt_answer/0/g-0/8
msgctxt "Rod"
msgid "What good is a platonic life partner if you can't clown on 'em every now and then."
msgstr "À quoi ça sert, un meilleur pote, si on peut pas le charrier de temps en temps ?"

# Traduction IA – à relire
#: curtrod_curtain/Curt_answer/0/g-0/16
msgctxt "Curt"
msgid "And with a face like his, he makes it easy."
msgstr "Et avec une tête comme la sienne, il me facilite la tâche."

# Traduction IA – à relire
#: curtrod_curtain/Curt_answer/0/g-0/24
msgctxt "Rod"
msgid "At least my attitude ain't stank like yours."
msgstr "Au moins, mon caractère pue pas comme le tien."

# Traduction IA – à relire
#: curtrod_curtain/Curt_answer/0/g-0/32
msgctxt "Curt"
msgid "My attitude is great."
msgstr "Mon caractère est génial."

# Traduction IA – à relire
#: curtrod_curtain/Curt_answer/0/g-0/40
msgctxt "Rod"
msgid "Maaaaaan. If your personality had a scent, it would be mothballs with mildew."
msgstr "Maaaaan. Si ta personnalité avait une odeur, ce serait de la naphtaline avec de la moisissure."

# Traduction IA – à relire
#: curtrod_curtain/Curt_answer/0/g-0/48
msgctxt "Curt"
msgid "Okay, okay! That was a good one."
msgstr "Ok, ok ! Celle-là était bonne."

# Traduction IA – à relire
#: curtrod_curtain/Curt_answer/0/g-0/56/s/0
msgctxt "Choix"
msgid "Oooh, burn! You smell like mold!"
msgstr "Oooh, ça brûle ! Tu sens le moisi !"

# Traduction IA – à relire
#: curtrod_curtain/Curt_answer/0/g-0/57/s/0
msgctxt "Choix"
msgid "That was a bit harsh, don't you think so?"
msgstr "C'était un peu dur, tu trouves pas ?"

# Traduction IA – à relire
#: curtrod_curtain/Curt_answer/0/g-0/c-3/7
msgctxt "Rod"
msgid "Woah. Okay there. Calm down."
msgstr "Woah. Ok, doucement."

# Traduction IA – à relire
#: curtrod_curtain/Curt_answer/0/g-0/c-4/7
msgctxt "Rod"
msgid "I mean, there's an art to it."
msgstr "Je veux dire, il y a un art là-dedans."

# Traduction IA – à relire
#: curtrod_curtain/Curt_answer/0/g-1/0
msgctxt "Curt"
msgid "He's being shady, not mean."
msgstr "Il chambre, il est pas méchant."

# Traduction IA – à relire
#: curtrod_curtain/Curt_answer/0/g-1/8/s/0
msgctxt "Choix"
msgid "But... what's the difference?"
msgstr "Mais... c'est quoi la différence ?"

# Traduction IA – à relire
#: curtrod_curtain/Curt_answer/0/g-1/9/s/0
msgctxt "Choix"
msgid "What does the sun have to do with any of this?"
msgstr "Qu'est-ce que le soleil vient faire là-dedans ?"

# Traduction IA – à relire
#: curtrod_curtain/Curt_answer/0/g-1/10/s/0
msgctxt "Choix"
msgid "Ah, I gotcha."
msgstr "Ah, je vois."

# Traduction IA – à relire
#: curtrod_curtain/Rod_answer/0/0
msgctxt "Rod"
msgid "That's what I'm saying!"
msgstr "C'est ce que je dis !"

# Traduction IA – à relire
#: curtrod_curtain/Rod_answer/0/8
msgctxt "Rod"
msgid "You think I'm cute?"
msgstr "Tu me trouves mignon ?"

# Traduction IA – à relire
#: curtrod_curtain/Rod_answer/0/16/b/1
msgctxt "Rod"
msgid "You hear that, Curt? You hear what they said?"
msgstr "T'entends ça, Curt ? T'as entendu ce qu'iel a dit ?"

# Traduction IA – à relire
#: curtrod_curtain/Rod_answer/0/17/b/1
msgctxt "Rod"
msgid "You hear that, Curt? You hear what she said?"
msgstr "T'entends ça, Curt ? T'as entendu ce qu'elle a dit ?"

# Traduction IA – à relire
#: curtrod_curtain/Rod_answer/0/18/b/1
msgctxt "Rod"
msgid "You hear that, Curt? You hear what he said?"
msgstr "T'entends ça, Curt ? T'as entendu ce qu'il a dit ?"

# Traduction IA – à relire
#: curtrod_curtain/Rod_answer/0/21
msgctxt "Curt"
msgid "...yes."
msgstr "... oui."

# Traduction IA – à relire
#: curtrod_curtain/Rod_answer/0/29
msgctxt "Rod"
msgid "I'm the cute one! I stay shining!"
msgstr "Le mignon, c'est moi ! Je reste brillant !"

# Traduction IA – à relire
#: curtrod_curtain/Rod_answer/0/40/b/1
msgctxt "Curt"
msgid "They didn't say all that. I bet they're just being nice."
msgstr "Iel a pas dit tout ça. Je parie qu'iel est juste gentil·le."

# Traduction IA – à relire
#: curtrod_curtain/Rod_answer/0/41/b/1
msgctxt "Curt"
msgid "She didn't say all that. I bet she's just being nice."
msgstr "Elle a pas dit tout ça. Je parie qu'elle est juste gentille."

# Traduction IA – à relire
#: curtrod_curtain/Rod_answer/0/42/b/1
msgctxt "Curt"
msgid "He didn't say all that. I bet he's just being nice."
msgstr "Il a pas dit tout ça. Je parie qu'il est juste gentil."

# Traduction IA – à relire
#: curtrod_curtain/Rod_answer/0/45
msgctxt "Rod"
msgid "You should take notes."
msgstr "Tu devrais prendre des notes."

# Traduction IA – à relire
#: curtrod_curtain/Rod_answer/0/53
msgctxt "Curt"
msgid "Why? So I can school you later?"
msgstr "Pourquoi ? Pour te donner une leçon plus tard ?"

# Traduction IA – à relire
#: curtrod_curtain/Rod_answer/0/61
msgctxt "Rod"
msgid "Hahaha. Okay, I walked right into that one."
msgstr "Hahaha. Ok, là, je me suis jeté dans le piège tout seul."

# Traduction IA – à relire
#: curtrod_curtain/Rod_answer/0/69/s/0
msgctxt "Choix"
msgid "You shouldn't talk to each other like that."
msgstr "Vous devriez pas vous parler comme ça."

# Traduction IA – à relire
#: curtrod_curtain/Rod_answer/0/70/s/0
msgctxt "Choix"
msgid "Your attitude isn't making you any more attractive."
msgstr "Votre attitude vous rend pas plus séduisants."

# Traduction IA – à relire
#: curtrod_curtain/Rod_answer/0/c-0/7
msgctxt "Rod"
msgid "Don't you see what's going on?"
msgstr "Tu vois pas ce qui se passe ?"

# Traduction IA – à relire
#: curtrod_curtain/Rod_answer/0/c-1/7
msgctxt "Curt"
msgid "Woooah. Okay. You can calm that down."
msgstr "Woooah. Ok. Tu peux te calmer."

# Traduction IA – à relire
#: curtrod_curtain/Rod_answer/0/g-0/0
msgctxt "Rod"
msgid "We're just joking around."
msgstr "On plaisante, c'est tout."

# Traduction IA – à relire
#: curtrod_curtain/Rod_answer/0/g-0/8
msgctxt "Curt"
msgid "Joshin'."
msgstr "On taquine."

# Traduction IA – à relire
#: curtrod_curtain/Rod_answer/0/g-0/16
msgctxt "Rod"
msgid "Kidding."
msgstr "On rigole."

# Traduction IA – à relire
#: curtrod_curtain/Rod_answer/0/g-0/24
msgctxt "Curt"
msgid "Poking fun. Most of the time. Sometimes I have to tell Rod about himself."
msgstr "On se moque. La plupart du temps. Des fois, faut que je dise ses quatre vérités à Rod."

# Traduction IA – à relire
#: curtrod_curtain/Rod_answer/0/g-0/32
msgctxt "Rod"
msgid "Hahaha. Yeah, okay. You woke up on the wrong side of the pole today."
msgstr "Hahaha. Ouais, ok. Tu t'es levé du mauvais côté de la tringle aujourd'hui."

# Traduction IA – à relire
#: curtrod_curtain/Rod_answer/0/g-0/40
msgctxt "Curt"
msgid "You're right. I woke up next to you!"
msgstr "T'as raison. Je me suis réveillé à côté de toi !"

# Traduction IA – à relire
#: curtrod_curtain/Rod_answer/0/g-0/48/s/0
msgctxt "Choix"
msgid "Okay. Call a detective. There's been a murder!"
msgstr "Ok. Appelez un détective. Il y a eu un meurtre !"

# Traduction IA – à relire
#: curtrod_curtain/Rod_answer/0/g-0/49/s/0
msgctxt "Choix"
msgid "Yeah... that's just mean."
msgstr "Ouais... ça, c'est juste méchant."

# Traduction IA – à relire
#: curtrod_curtain/Rod_answer/0/g-0/c-2/7
msgctxt "Rod"
msgid "Yeah, that hit hard. Good job."
msgstr "Ouais, ça a fait mal. Bien joué."

# Traduction IA – à relire
#: curtrod_curtain/Rod_answer/0/g-0/c-3/7
msgctxt "Rod"
msgid "Nawwww. It's all in good fun."
msgstr "Nawwww. C'est pour rire."

# Traduction IA – à relire
#: curtrod_curtain/Rod_answer/0/g-1/0
msgctxt "Rod"
msgid "That's what I get for messing with the the King of Shade."
msgstr "Voilà ce que ça donne de s'en prendre au Roi du Chambrage."

# Traduction IA – à relire
#: curtrod_curtain/Rod_answer/0/g-1/8
msgctxt "Curt"
msgid "That's right! I'll take my crown any day now."
msgstr "Exactement ! Qu'on me donne ma couronne, c'est quand on veut."

# Traduction IA – à relire
#: curtrod_curtain/Rod_answer/0/g-1/16/s/0
msgctxt "Choix"
msgid "The King of Shade? What's that mean?"
msgstr "Le Roi du Chambrage ? Ça veut dire quoi ?"

# Traduction IA – à relire
#: curtrod_curtain/Rod_answer/0/g-1/17/s/0
msgctxt "Choix"
msgid "So you take pride in being rude?"
msgstr "Donc tu es fier d'être malpoli ?"

# Traduction IA – à relire
#: curtrod_curtain/Rod_answer/0/g-1/18/s/0
msgctxt "Choix"
msgid "You'll have to take it off my head first!"
msgstr "Faudra d'abord me l'arracher de la tête !"

# Traduction IA – à relire
#: curtrod_curtain/explain_shady/0/0
msgctxt "Curt"
msgid "Being shady isn't always a bad thing."
msgstr "Chambrer, c'est pas toujours mal."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady/0/8
msgctxt "Rod"
msgid "Oh, to the contrary. I'm shady all the time to Curt. Why? Because I love him."
msgstr "Oh, au contraire. Je chambre Curt tout le temps. Pourquoi ? Parce que je l'aime."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady/0/16/s/0
msgctxt "Choix"
msgid "Yeah... I still don't get it."
msgstr "Ouais... je pige toujours pas."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady/0/17/s/0
msgctxt "Choix"
msgid "Oh! So, it's like your love language?"
msgstr "Oh ! Donc c'est comme votre langage de l'amour ?"

# Traduction IA – à relire
#: curtrod_curtain/explain_shady/0/c-1/7
msgctxt "Curt"
msgid "I guess you could say that, yeah."
msgstr "On peut le dire comme ça, ouais."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady/0/c-1/15
msgctxt "Rod"
msgid "But we have rules."
msgstr "Mais on a des règles."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady/0/c-1/23
msgctxt "Curt"
msgid "Oh yeah. You must throw shade appropriately."
msgstr "Ah ouais. Faut chambrer comme il faut."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady/0/c-1/31/0/s/0
msgctxt "Choix"
msgid "What do you mean, rules?"
msgstr "Comment ça, des règles ?"

# Traduction IA – à relire
#: curtrod_curtain/explain_shady/0/c-1/31/1/s/0
msgctxt "Choix"
msgid "Yeah... I don't think I really care that much."
msgstr "Ouais... je crois que ça m'intéresse pas trop."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/0
msgctxt "Curt"
msgid "There are five rules to throwing shade. First off, you have to know the person."
msgstr "Il y a cinq règles pour bien chambrer. Primo, faut connaître la personne."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/8
msgctxt "Rod"
msgid "Sure, you can be shady to folks you don't know, but that IS just mean."
msgstr "Bien sûr, tu peux chambrer des gens que tu connais pas, mais là, c'est juste de la méchanceté."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/16
msgctxt "Curt"
msgid "Wait... we made fun of the new mail carrier just the other day..."
msgstr "Attends... on s'est moqués du nouveau facteur pas plus tard qu'avant-hier..."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/24
msgctxt "Rod"
msgid "That's because they were wearing that uniform with open toed sandals..."
msgstr "C'est parce qu'il portait cet uniforme avec des sandales ouvertes..."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/32
msgctxt "Rod"
msgid "With socks."
msgstr "Avec des chaussettes."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/40
msgctxt "Curt"
msgid "Oh yeah. They asked for that one."
msgstr "Ah ouais. Il l'avait cherché, celui-là."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/48
msgctxt "Rod"
msgid "This rule is one of those 'do as we say, not as we do' things."
msgstr "Cette règle fait partie des trucs du genre « faites ce qu'on dit, pas ce qu'on fait »."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/56
msgctxt "Curt"
msgid "Unless we ask you to do it with us. At which point, you better come correct."
msgstr "Sauf si on te demande de le faire avec nous. Là, t'as intérêt à assurer."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/64
msgctxt "Rod"
msgid "Which brings us to rule number two."
msgstr "Ce qui nous amène à la règle numéro deux."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/72
msgctxt "Curt"
msgid "If the roast ain't hot, you're toast."
msgstr "Si ton clash est pas brûlant, t'es grillé."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/80
msgctxt "Rod"
msgid "The shade is about the laugh at the end. Maybe even a strong guffaw."
msgstr "Le chambrage, c'est pour le rire à la fin. Voire un bon gros éclat."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/88
msgctxt "Curt"
msgid "A guffaw? Are you a cartoon dog-person? 'Cus if not, I best not hear a single guffaw out of you, Rod."
msgstr "Un éclat ? T'es un chien de dessin animé ? Parce que sinon, que j'entende pas un seul rire de Dingo sortir de toi, Rod."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/96
msgctxt "Rod"
msgid "Keep your aim true."
msgstr "Vise juste."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/104
msgctxt "Curt"
msgid "Never bring in secondary parties. Others shouldn't be collateral damage because you decided to mix patterns and it turned out unfortunate."
msgstr "Ne mêle jamais de tierces personnes. Les autres doivent pas être des dégâts collatéraux parce que t'as décidé de mixer les motifs et que ça a mal tourné."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/112
msgctxt "Rod"
msgid "I tried to throw shade on Curt's mom once..."
msgstr "Une fois, j'ai essayé de chambrer la mère de Curt..."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/120
msgctxt "Curt"
msgid "Mrs. Chaffon has never done anything and she will not be brought into this foolishness."
msgstr "Madame Chaffon n'a jamais rien fait et on ne la mêlera pas à ces bêtises."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/128
msgctxt "Rod"
msgid "Okay. Rule four."
msgstr "Ok. Règle quatre."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/136
msgctxt "Curt"
msgid "Read their body language as you read them down."
msgstr "Lis leur langage corporel pendant que tu les lis à voix haute."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/144
msgctxt "Rod"
msgid "Everyone has their line and their limit. Don't be so caught up in the goofs that you step on that line."
msgstr "Tout le monde a sa limite. Sois pas tellement emporté par les blagues que tu marches dessus."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/152
msgctxt "Curt"
msgid "It's easy to be on a roll and run right over your friend."
msgstr "C'est facile de s'emballer et de rouler sur son ami."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/160
msgctxt "Rod"
msgid "Which is why rule number one is important. If you don't know them, you don't know what might actually make them upset."
msgstr "C'est pour ça que la règle numéro un est importante. Si tu les connais pas, tu sais pas ce qui peut vraiment les vexer."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/168
msgctxt "Curt"
msgid "Right, like I don't talk about Rod's crush on the blinds at the last house."
msgstr "Exact, comme quand je parle pas du béguin de Rod pour les stores de l'ancienne maison."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/176
msgctxt "Rod"
msgid "Dude... not cool."
msgstr "Mec... pas cool."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/184
msgctxt "Curt"
msgid "Sorry! I was just giving an example."
msgstr "Pardon ! Je donnais juste un exemple."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/195/s/0
msgctxt "Choix"
msgid "You've really thought this out."
msgstr "Vous avez vraiment bien réfléchi à ça."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/196/s/0
msgctxt "Choix"
msgid "I didn't realize so much went into just talking smack."
msgstr "Je savais pas qu'il fallait autant d'efforts pour simplement se balancer des vannes."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/g-0/0
msgctxt "Rod"
msgid "It's an art form."
msgstr "C'est un art."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/g-0/8
msgctxt "Curt"
msgid "And there is one rule that you absolutely cannot break."
msgstr "Et il y a une règle que tu ne dois absolument pas enfreindre."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/g-0/16
msgctxt "Rod"
msgid "Oh yeah, the final rule."
msgstr "Ah ouais, la dernière règle."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/g-0/24
msgctxt "Curt"
msgid "Rule five is..."
msgstr "La règle cinq, c'est..."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/g-0/32
msgctxt "Rod"
msgid "If someone you know starts throwing shade on your friend?"
msgstr "Si quelqu'un que tu connais se met à chambrer ton pote ?"

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/g-0/40
msgctxt "Curt"
msgid "BAP BAP BAP You better prepare for war!"
msgstr "BAP BAP BAP T'as intérêt à te préparer à la guerre !"

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/g-0/48
msgctxt "Rod"
msgid "It is your duty to fire back."
msgstr "C'est ton devoir de riposter."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/g-0/56
msgctxt "Curt"
msgid "Verbal warfare has begun. Do what you gotta do."
msgstr "La guerre verbale est déclarée. Fais ce que tu dois faire."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/g-0/64
msgctxt "Rod"
msgid "And yeah, those are the rules of shade. You got 'em all?"
msgstr "Et voilà, ce sont les règles du chambrage. Tu les as toutes ?"

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/g-0/72/s/0
msgctxt "Choix"
msgid "Oh yeah... I sure as hell do."
msgstr "Oh ouais... carrément."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/g-0/73/s/0
msgctxt "Choix"
msgid "All five. Locked in."
msgstr "Les cinq. Enregistrées."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/g-0/74/s/0
msgctxt "Choix"
msgid "I wasn't really listening, could you say that again?"
msgstr "J'écoutais pas vraiment, tu peux répéter ?"

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/g-0/c-4/7
msgctxt "Curt"
msgid "Okay okay, I appreciate the honesty."
msgstr "Ok ok, j'apprécie l'honnêteté."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/confident_shade/0
msgctxt "Curt"
msgid "Okay. Confident. I like that in a person."
msgstr "Ok. Confiant. J'aime ça chez les gens."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/confident_shade/8
msgctxt "Rod"
msgid "If they breathe, Curt likes them."
msgstr "Du moment qu'ils respirent, Curt les aime bien."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/confident_shade/16
msgctxt "Curt"
msgid "You act like you're one to talk. The tree outside sways and you think it's flirting with you."
msgstr "Tu fais comme si t'étais bien placé pour parler. L'arbre dehors se balance et tu crois qu'il te drague."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/confident_shade/24
msgctxt "Rod"
msgid "How can you not be charmed? Have you seen those branches?"
msgstr "Comment tu peux ne pas être charmé ? T'as vu ces branches ?"

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/confident_shade/32/s/0
msgctxt "Choix"
msgid "And the grass is just playing hard to get?"
msgstr "Et l'herbe, elle fait juste la difficile ?"

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/confident_shade/33/s/0
msgctxt "Choix"
msgid "Yeah... I sure have!"
msgstr "Ouais... j'ai vu !"

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/confident_shade/c-6/7
msgctxt "Rod"
msgid "Was that... were you trying to..."
msgstr "C'était... t'essayais de..."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/confident_shade/c-6/15
msgctxt "Curt"
msgid "Listen. If that was your attempt at being shady..."
msgstr "Écoute. Si c'était ta tentative de chambrage..."

# Traduction IA – à relire
#: curtrod_curtain/explain_shady_a/0/confident_shade/c-6/23
msgctxt "Rod"
msgid "We might have a problem here."
msgstr "On a peut-être un problème."

# Traduction IA – à relire
#: curtrod_curtain/end_first_encounter_a/9
msgctxt "Curt"
msgid "ooooooOOOOOO!"
msgstr "ooooooOOOOOO !"

# Traduction IA – à relire
#: curtrod_curtain/end_first_encounter_a/17
msgctxt "Rod"
msgid "Alright, now. Calm down."
msgstr "Bon, allez. Calme-toi."

# Traduction IA – à relire
#: curtrod_curtain/end_first_encounter_a/25/b/1
msgctxt "Curt"
msgid "They said the grass."
msgstr "Iel a dit l'herbe."

# Traduction IA – à relire
#: curtrod_curtain/end_first_encounter_a/26/b/1
msgctxt "Curt"
msgid "She said the grass."
msgstr "Elle a dit l'herbe."

# Traduction IA – à relire
#: curtrod_curtain/end_first_encounter_a/27/b/1
msgctxt "Curt"
msgid "He said the grass."
msgstr "Il a dit l'herbe."

# Traduction IA – à relire
#: curtrod_curtain/end_first_encounter_a/38
msgctxt "Curt"
msgid "THE GRASS, ROD!"
msgstr "L'HERBE, ROD !"

# Traduction IA – à relire
#: curtrod_curtain/end_first_encounter_a/46
msgctxt "Curt"
msgid "Bahahahahahahaha!"
msgstr "Bahahahahahahaha !"

# Traduction IA – à relire
#: curtrod_curtain/end_first_encounter_a/57
msgctxt "Rod"
msgid "Oh! You can guffaw, but I can't?!"
msgstr "Oh ! Toi, t'as le droit de te marrer, mais pas moi ?!"

# Traduction IA – à relire
#: curtrod_curtain/end_first_encounter_a/65/b/1
msgctxt "Curt"
msgid "Okay, okay, okay. Fair. But damn! They got you!"
msgstr "Ok, ok, ok. C'est juste. Mais putain ! Iel t'a eu !"

# Traduction IA – à relire
#: curtrod_curtain/end_first_encounter_a/66/b/1
msgctxt "Curt"
msgid "Okay, okay, okay. Fair. But damn! She got you!"
msgstr "Ok, ok, ok. C'est juste. Mais putain ! Elle t'a eu !"

# Traduction IA – à relire
#: curtrod_curtain/end_first_encounter_a/67/b/1
msgctxt "Curt"
msgid "Okay, okay, okay. Fair. But damn! He got you!"
msgstr "Ok, ok, ok. C'est juste. Mais putain ! Il t'a eu !"

# Traduction IA – à relire
#: curtrod_curtain/end_first_encounter_a/70
msgctxt "Rod"
msgid "You right, you right. That was a good one."
msgstr "T'as raison, t'as raison. Elle était bonne."

# Traduction IA – à relire
#: curtrod_curtain/end_first_encounter_a/78
msgctxt "Rod"
msgid "You catch on quick."
msgstr "Tu piges vite."

# Traduction IA – à relire
#: curtrod_curtain/end_first_encounter_b/9
msgctxt "Curt"
msgid "Okay.. that was.. you tried."
msgstr "Ok.. c'était.. t'as essayé."

# Traduction IA – à relire
#: curtrod_curtain/end_first_encounter_b/17
msgctxt "Rod"
msgid "Yeah! That was like a... B? B minus?"
msgstr "Ouais ! C'était genre... un B ? B moins ?"

# Traduction IA – à relire
#: curtrod_curtain/end_first_encounter_b/25
msgctxt "Curt"
msgid "Naw... that was a D."
msgstr "Nan... c'était un D."

# Traduction IA – à relire
#: curtrod_curtain/end_first_encounter_b/33
msgctxt "Rod"
msgid "You right, you right."
msgstr "T'as raison, t'as raison."

# Traduction IA – à relire
#: curtrod_curtain/end_first_encounter_b/41
msgctxt "Curt"
msgid "But you tried. So, you know... A for effort."
msgstr "Mais t'as essayé. Donc, tu vois... A pour l'effort."

# Traduction IA – à relire
#: curtrod_curtain/end_first_encounter_b/49
msgctxt "Rod"
msgid "You'll get better in time."
msgstr "Tu t'amélioreras avec le temps."

# Traduction IA – à relire
#: curtrod_curtain/curt_rod_unsure/0
msgctxt "Curt"
msgid "Alright. I see you don't wanna learn the artform."
msgstr "Bon. Je vois que tu veux pas apprendre l'art."

# Traduction IA – à relire
#: curtrod_curtain/curt_rod_unsure/8
msgctxt "Rod"
msgid "You trust that you can crack a good joke without the rules?"
msgstr "Tu crois que tu peux sortir une bonne blague sans les règles ?"

# Traduction IA – à relire
#: curtrod_curtain/curt_rod_unsure/16
msgctxt "Curt"
msgid "You seem confident to me. We'll see how you stack up."
msgstr "T'as l'air confiant. On verra ce que ça donne."

# Traduction IA – à relire
#: curtrod_curtain/end_first_encounter_c/4
msgctxt "Curt"
msgid "Yo, Rod! That fashion student is getting off the bus."
msgstr "Yo, Rod ! L'étudiant en mode descend du bus."

# Traduction IA – à relire
#: curtrod_curtain/end_first_encounter_c/12
msgctxt "Rod"
msgid "Oooo, what are they wearing?"
msgstr "Oooo, il porte quoi ?"

# Traduction IA – à relire
#: curtrod_curtain/end_first_encounter_c/20
msgctxt "Curt"
msgid "I'm not sure, but it is fly as hell!"
msgstr "Je sais pas trop, mais c'est trop stylé !"

# Traduction IA – à relire
#: curtrod_curtain/end_first_encounter_c/28
msgctxt "Rod"
msgid "We've got some people watching to do. Swing on by soon."
msgstr "On a des gens à observer. Passe nous voir bientôt."

# Traduction IA – à relire
#: curtrod_curtain/end_first_encounter_c/36
msgctxt "Rod"
msgid "But, come holla at us at different places. Each window has a new thing to throw shade on."
msgstr "Mais viens nous parler à différents endroits. Chaque fenêtre a un nouveau truc à chambrer."

# Traduction IA – à relire
#: curtrod_curtain/end_first_encounter_c/44
msgctxt "Curt"
msgid "Variety is the spice of life, baby!"
msgstr "La variété, c'est le piment de la vie, bébé !"

# Traduction IA – à relire
#: curtrod_curtain/end_first_encounter_c/52
msgctxt "Curt"
msgid "Bring your jokes. We like to keep it lively here."
msgstr "Ramène tes blagues. Ici, on aime que ça pétille."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/46
msgctxt "Curt"
msgid "Oh, you liftin' now?"
msgstr "Oh, tu fais de la muscu maintenant ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/54
msgctxt "Rod"
msgid "Yo, chill."
msgstr "Yo, tranquille."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/62
msgctxt "Curt"
msgid "I'm just kidding! You're pumping iron. We love to see it!"
msgstr "Je plaisante ! Tu soulèves de la fonte. On adore voir ça !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/82
msgctxt "Fantina"
msgid "Oh my GOSH! I'm so excited that you are both here!"
msgstr "Oh mon DIEU ! Je suis tellement contente que vous soyez là tous les deux !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/97
msgctxt "Rod"
msgid "Hey, Fantina!"
msgstr "Salut, Fantina !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/105
msgctxt "Narrator"
msgid "Rod waves at Fantina, but Curt just gives her a tight-lipped smile."
msgstr "Rod fait un signe à Fantina, mais Curt se contente de lui adresser un sourire crispé."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/113
msgctxt "Fantina"
msgid "Ahhh! You remembered my name!"
msgstr "Ahhh ! Tu t'es souvenu de mon prénom !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/124
msgctxt "Curt"
msgid "...how could we forget?"
msgstr "... comment on pourrait l'oublier ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/132
msgctxt "Fantina"
msgid "You think I'm memorable? See, I knew you liked me."
msgstr "Tu me trouves mémorable ? Tu vois, je savais que tu m'aimais bien."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/140/s/0
msgctxt "Choix"
msgid "Curt? You like Fantina?"
msgstr "Curt ? Tu aimes bien Fantina ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/c-0/7
msgctxt "Fantina"
msgid "Oh, I sure hope so! I just enjoy them so much."
msgstr "Oh, j'espère bien ! Je les adore tellement."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/c-0/15
msgctxt "Fantina"
msgid "Did you know that Curt has this amazing wave dance move? It only happens when I brush up against him."
msgstr "Savais-tu que Curt a ce super mouvement de danse en vague ? Ça arrive seulement quand je le frôle."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/c-0/23
msgctxt "Curt"
msgid "Please, don't."
msgstr "S'il te plaît, non."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/c-0/34
msgctxt "Rod"
msgid "Are you too good to dance, now?"
msgstr "T'es trop bien pour danser, maintenant ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/c-0/42
msgctxt "Curt"
msgid "Why don't you dance, Rod??"
msgstr "Et toi, pourquoi tu danses pas, Rod ??"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/c-0/50
msgctxt "Fantina"
msgid "ANYWAY!"
msgstr "BREF !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/c-0/58
msgctxt "Fantina"
msgid "I really like it when you do it, Curt!"
msgstr "J'adore quand tu le fais, Curt !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-0/0/s/0
msgctxt "Choix"
msgid "I didn't know you dance, Curt!"
msgstr "Je savais pas que tu dansais, Curt !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-0/1/s/0
msgctxt "Choix"
msgid "You've got moves and you've been holding back?"
msgstr "T'as des moves et tu les gardais pour toi ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/0
msgctxt "Fantina"
msgid "Oh, you wouldn't believe how good they are. Really, there isn't anything like them."
msgstr "Oh, tu n'imagines pas à quel point ils sont bons. Franchement, il n'y a rien de pareil."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/8
msgctxt "Fantina"
msgid "You can do it, Curt! I believe in you!"
msgstr "Tu peux le faire, Curt ! Je crois en toi !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/19
msgctxt "Curt"
msgid "Naw, I'm good."
msgstr "Nan, ça va."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/27
msgctxt "Rod"
msgid "You can't do it, can you?"
msgstr "T'en es pas capable, hein ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/35
msgctxt "Fantina"
msgid "Curt can do anything!"
msgstr "Curt peut tout faire !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/43
msgctxt "Curt"
msgid "That's right! I can do anything!"
msgstr "Exactement ! Je peux tout faire !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/51
msgctxt "Curt"
msgid "I'm just... feeling a bit... Ummm..."
msgstr "C'est juste que... je me sens un peu... Euhhh..."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/62/s/0
msgctxt "Choix"
msgid "You sound like a scaredy-cat! Scaredy-cat! Scaredy-cat!"
msgstr "On dirait une poule mouillée ! Poule mouillée ! Poule mouillée !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/63/s/0
msgctxt "Choix"
msgid "Just admit you suck at it and move on!"
msgstr "Avoue que t'es nul et passe à autre chose !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/64/s/0
msgctxt "Choix"
msgid "I sure would love to see you do that dance!"
msgstr "J'adorerais te voir faire cette danse !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/65/s/0
msgctxt "Choix"
msgid "And here I thought Rod was the stiff, stubborn one."
msgstr "Et moi qui croyais que le raide et têtu, c'était Rod."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-3/16
msgctxt "Curt"
msgid "I'm not scared!"
msgstr "J'ai pas peur !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-3/24
msgctxt "Rod"
msgid "Sounding scared to me!"
msgstr "Ça ressemble à de la peur pour moi !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-3/32
msgctxt "Fantina"
msgid "Are you afraid, Curt? What can I do to help calm you down?"
msgstr "Tu as peur, Curt ? Que puis-je faire pour te calmer ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-3/40
msgctxt "Curt"
msgid "Nothing. I'm fine."
msgstr "Rien. Ça va."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-3/48
msgctxt "Fantina"
msgid "OH! I know! How about I start a little cheer for you!"
msgstr "OH ! Je sais ! Et si je lançais un petit chant d'encouragement pour toi !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-3/56
msgctxt "Curt"
msgid "Please... don't!"
msgstr "S'il te plaît... non !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-3/64
msgctxt "Rod"
msgid "Please, do!"
msgstr "S'il te plaît, si !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-3/72
msgctxt "Fantina"
msgid "Curt! Curt! CurtCurtCurt!"
msgstr "Curt ! Curt ! CurtCurtCurt !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-3/83/0/s/0
msgctxt "Choix"
msgid "Curt! Curt!"
msgstr "Curt ! Curt !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-3/83/c-0/7
msgctxt "Curt"
msgid "Not you, too!"
msgstr "Toi aussi !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-3/83/c-0/15
msgctxt "Rod"
msgid "Go Curt! Go Curt! You ain't got this! But do it anyway!"
msgstr "Allez Curt ! Allez Curt ! T'y arriveras pas ! Mais fais-le quand même !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-3/83/c-0/26
msgctxt "Curt"
msgid "Who's side are you on?"
msgstr "T'es dans quel camp ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-3/83/c-0/34
msgctxt "Rod"
msgid "The one that causes you the most stress, if I'm being real."
msgstr "Celui qui te stresse le plus, pour être honnête."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-4/16
msgctxt "Curt"
msgid "Hey now! Don't nobody suck at anything!"
msgstr "Eh ho ! Personne est nul à rien !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-4/27
msgctxt "Fantina"
msgid "That's not a very kind thing to say! Curt is awesome!"
msgstr "C'est pas très gentil de dire ça ! Curt est génial !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-4/38
msgctxt "Curt"
msgid "Yeah!"
msgstr "Ouais !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-4/46
msgctxt "Fantina"
msgid "Curt is fantastic at moving!"
msgstr "Curt est fantastique pour bouger !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-4/54
msgctxt "Curt"
msgid "The best you've ever seen!"
msgstr "Le meilleur que t'aies jamais vu !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-4/62
msgctxt "Fantina"
msgid "Curt is by far THE BEST thing to ever cover a window!"
msgstr "Curt est de loin LE MEILLEUR truc qui ait jamais couvert une fenêtre !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-4/70
msgctxt "Curt"
msgid "I'm good at my initial purpose and function!"
msgstr "Je suis bon dans ma fonction d'origine !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-4/78
msgctxt "Rod"
msgid "Don't gas him up too much. I have to deal with him after."
msgstr "Le gonfle pas trop. C'est moi qui me le tape après."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-5/16
msgctxt "Fantina"
msgid "See? Someone else would love to see you do it!"
msgstr "Tu vois ? Quelqu'un d'autre adorerait te voir le faire !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-5/24
msgctxt "Rod"
msgid "Is popcorn allowed in this room? Because, this is going to be entertaining."
msgstr "Le pop-corn est autorisé dans cette pièce ? Parce que ça va être divertissant."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-5/32
msgctxt "Curt"
msgid "I need your backup on this one, Rod."
msgstr "J'ai besoin de ton soutien sur ce coup, Rod."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-5/40
msgctxt "Rod"
msgid "Don't worry. I'll be back here. Laughin'."
msgstr "T'inquiète. Je serai là, au fond. À me marrer."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-5/48
msgctxt "Fantina"
msgid "YOU'VE GOT THIS, CURT!"
msgstr "TU PEUX Y ARRIVER, CURT !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-5/59/0/s/0
msgctxt "Choix"
msgid "She really believes in you."
msgstr "Elle croit vraiment en toi."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-5/59/1/s/0
msgctxt "Choix"
msgid "She is soooo intense."
msgstr "Elle est trooop intense."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-5/59/c-0/7
msgctxt "Fantina"
msgid "Of course I do! What's not to believe in."
msgstr "Évidemment ! Il n'y a aucune raison de ne pas croire en toi."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-5/59/c-0/15
msgctxt "Fantina"
msgid "I know greatness when I see it."
msgstr "Je reconnais la grandeur quand je la vois."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-5/59/c-0/23
msgctxt "Curt"
msgid "...you think I'm great?"
msgstr "... tu me trouves génial ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-5/59/c-0/31
msgctxt "Rod"
msgid "Bro, you so dense. That's all she been sayin'!"
msgstr "Frérot, t'es trop dur de la feuille. C'est tout ce qu'elle dit !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-5/59/c-1/7
msgctxt "Fantina"
msgid "I show unwavering support. What's wrong with that?"
msgstr "Je soutiens sans faillir. Qu'est-ce qu'il y a de mal ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-5/59/c-1/15
msgctxt "Fantina"
msgid "You might not think Curt has what it takes, but I KNOW he does!"
msgstr "Tu penses peut-être que Curt n'a pas ce qu'il faut, mais MOI, je SAIS que si !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-5/59/c-1/23
msgctxt "Rod"
msgid "I mean, you've gotta prove the naysayers wrong, Curt."
msgstr "Je veux dire, faut que tu prouves aux rabat-joie qu'ils ont tort, Curt."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-5/59/c-1/31
msgctxt "Rod"
msgid "Unless... you admit you ain't got the moves."
msgstr "À moins que... tu admettes que t'as pas les moves."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-5/59/c-1/39
msgctxt "Curt"
msgid "Didn't nobody say all that!"
msgstr "Personne a dit tout ça !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-5/59/c-1/47
msgctxt "Rod"
msgid "Actions speak louder, my man."
msgstr "Les actes parlent plus fort, mon gars."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-6/16
msgctxt "Curt"
msgid "Oh, daaaang! Hit us with the one-two combo!"
msgstr "Oh, ouaaais ! Nous sortir le un-deux !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-6/27
msgctxt "Rod"
msgid "Damn! How am I catching strays?"
msgstr "Putain ! Pourquoi c'est moi qui prends les balles perdues ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-6/35/b/1
msgctxt "Curt"
msgid "They've got those powers of observation. They know you don't have the moves!"
msgstr "Elle a le sens de l'observation. Elle sait que t'as pas les moves !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-6/36/b/1
msgctxt "Curt"
msgid "She's got those powers of observation. She knows you don't have the moves!"
msgstr "Elle a le sens de l'observation. Elle sait que t'as pas les moves !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-6/37/b/1
msgctxt "Curt"
msgid "He's got those powers of observation. He knows you don't have the moves!"
msgstr "Il a le sens de l'observation. Il sait que t'as pas les moves !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-6/40
msgctxt "Rod"
msgid "You don't know that."
msgstr "Tu peux pas savoir ça."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-6/48
msgctxt "Fantina"
msgid "Oh, Rod! You are good at other things!"
msgstr "Oh, Rod ! Tu es bon dans d'autres domaines !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-6/56
msgctxt "Rod"
msgid "Like what?"
msgstr "Comme quoi ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-6/64
msgctxt "Fantina"
msgid "...I'd like for us to keep our focus on Curt right now."
msgstr "... je voudrais qu'on reste concentrés sur Curt pour l'instant."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-6/72
msgctxt "Curt"
msgid "DAAAAAANG!"
msgstr "OUAAAAAIS !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-6/91
msgctxt "Curt"
msgid "Fantina, you are COLD!"
msgstr "Fantina, t'es GLACIALE !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-6/99
msgctxt "Fantina"
msgid "I am?! Did I... did I do \"the shade?\""
msgstr "Moi ?! J'ai... j'ai fait « le chambrage » ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-6/107
msgctxt "Curt"
msgid "Girl, you blew Rod AWAY!"
msgstr "Ma belle, t'as complètement ENVOYÉ Rod valser !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-6/115
msgctxt "Rod"
msgid "Okay. Calm down."
msgstr "Ok. Calmez-vous."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-6/123/0/s/0
msgctxt "Choix"
msgid "Naw, she got you."
msgstr "Nan, elle t'a eu."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-6/123/1/s/0
msgctxt "Choix"
msgid "Ooo, I felt that one."
msgstr "Ooo, celle-là, je l'ai sentie passer."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-6/123/c-1/7
msgctxt "Curt"
msgid "You know what, Fantina... you deserve to see the move."
msgstr "Tu sais quoi, Fantina... tu mérites de voir le move."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-1/c-6/123/c-1/15
msgctxt "Fantina"
msgid "Eeeeeeeee!!!! You are going to do it?!"
msgstr "Eeeeeeeee !!!! Tu vas le faire ?!"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-2/0
msgctxt "Curt"
msgid "You wanna see me bust out the move? I'll bust out the move."
msgstr "Tu veux me voir sortir le move ? Je sors le move."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-2/8
msgctxt "Fantina"
msgid "OH MY GOSH!!!!"
msgstr "OH MON DIEU !!!!"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-2/19
msgctxt "Curt"
msgid "But... under one condition."
msgstr "Mais... à une condition."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-2/27
msgctxt "Rod"
msgid "What's that?"
msgstr "Laquelle ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-2/35
msgctxt "Curt"
msgid "It's just you and me, Fantina."
msgstr "Ce sera juste toi et moi, Fantina."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-2/43
msgctxt "Fantina"
msgid "You mean..."
msgstr "Tu veux dire..."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-2/51
msgctxt "Curt"
msgid "That's right. A private dance session with just you."
msgstr "Exactement. Une séance de danse privée rien que pour toi."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-2/59
msgctxt "Curt"
msgid "What better way to pay back someone who has always believed in me."
msgstr "Quelle meilleure façon de remercier quelqu'un qui a toujours cru en moi."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-2/75
msgctxt "Fantina"
msgid "AHHHHHHHHHHHHHHHH! I'm so excited!"
msgstr "AHHHHHHHHHHHHHHHH ! Je suis trop excitée !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-2/89
msgctxt "Curt"
msgid "I'll call you over when I'm ready."
msgstr "Je t'appellerai quand je serai prêt."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-2/97
msgctxt "Fantina"
msgid "I can't wait!"
msgstr "J'ai hâte !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-2/111/s/0
msgctxt "Choix"
msgid "What was that about?"
msgstr "C'était quoi, ça ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-2/112/s/0
msgctxt "Choix"
msgid "Oo la la. A private dance!"
msgstr "Oh là là. Une danse privée !"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-3/3
msgctxt "Curt"
msgid "It's easier this way. With her, no matter how bad I do, she'll think it's the best thing ever."
msgstr "C'est plus simple comme ça. Avec elle, peu importe si je suis nul, elle trouvera que c'est la meilleure chose du monde."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-3/11
msgctxt "Rod"
msgid "Yup. She can be a bit obsessive."
msgstr "Ouaip. Elle peut être un peu obsessionnelle."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-3/19
msgctxt "Curt"
msgid "With me! She couldn't care less about you! She's got good taste."
msgstr "Avec moi ! Toi, elle s'en fiche complètement ! Elle a bon goût."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-3/27
msgctxt "Rod"
msgid "Maaaan. Hush up and get this over with. I don't wanna hear her scream with excitement anymore."
msgstr "Maaaan. Ferme-la et finissons-en. Je veux plus l'entendre crier d'excitation."

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-3/35
msgctxt "Fantina"
msgid "Ahhhhhhh!!!"
msgstr "Ahhhhhhh !!!"

# Traduction IA – à relire
#: curtrod_curtain/shade_gym/0/g-3/46
msgctxt "Curt"
msgid "Fine. I'll see you around. I've got a fan to knock over!"
msgstr "Bon. À plus tard. J'ai une fan à faire tomber à la renverse !"

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/46
msgctxt "Curt"
msgid "Oh! You showed up JUST in time."
msgstr "Oh ! T'arrives JUSTE à temps."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/54
msgctxt "Rod"
msgid "Curt, I don't think there is good material today."
msgstr "Curt, je crois qu'il y a rien de bon à se mettre sous la dent aujourd'hui."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/62
msgctxt "Curt"
msgid "No good material? Man, you must be rustin', 'cause this right here? Prime."
msgstr "Rien de bon ? Mec, t'es rouillé, ça se voit, parce que ça, là ? De premier choix."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/70/s/0 curtrod_curtain/shade_bedroom/0/65/s/0 curtrod_curtain/shade_dining_room/0/g-3/32/s/0
msgctxt "Choix"
msgid "What's going on?"
msgstr "Qu'est-ce qui se passe ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/71/s/0
msgctxt "Choix"
msgid "I don't see anything."
msgstr "Je vois rien."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/c-1/7
msgctxt "Rod"
msgid "That's because Curt is all up in the window."
msgstr "C'est parce que Curt est collé à la fenêtre."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/c-1/15
msgctxt "Curt"
msgid "It's just too goood! Look at him! Ha! Ridiculous!"
msgstr "C'est trop booon ! Regardez-le ! Ha ! Ridicule !"

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/c-1/23
msgctxt "Rod"
msgid "Move so other people can see! You all up in the way!"
msgstr "Bouge-toi pour que les autres voient ! Tu bouches la vue !"

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/c-1/31
msgctxt "Curt"
msgid "Okay, okayokayokayokay. Tell me when you see him."
msgstr "Ok, okokokokok. Dites-moi quand vous le voyez."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-0/0
msgctxt "Narrator"
msgid "Curt steps to the side, inviting you to look through the window. You can't really make out much..."
msgstr "Curt s'écarte et vous invite à regarder par la fenêtre. Vous ne distinguez pas grand-chose..."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-0/8/s/0
msgctxt "Choix"
msgid "What am I looking at?"
msgstr "Je regarde quoi, là ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-0/c-2/7
msgctxt "Curt"
msgid "That fool out there with the boombox over his head. Down the street."
msgstr "Cet abruti avec la chaîne stéréo au-dessus de la tête. En bas de la rue."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-0/c-2/15
msgctxt "Rod"
msgid "He's been out there for... how long now?"
msgstr "Ça fait combien de temps qu'il est là ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-0/c-2/23
msgctxt "Curt"
msgid "Hours! Playing the same song!"
msgstr "Des heures ! Avec la même chanson !"

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-0/c-2/31
msgctxt "Rod"
msgid "They ain't never gunna answer. Ol' dude ran out of pebbles awhile ago."
msgstr "Personne répondra jamais. Le vieux a plus de cailloux depuis un moment."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-0/c-2/39
msgctxt "Curt"
msgid "Wait... is he... is he out of batteries too?!"
msgstr "Attends... il est... il est aussi à court de piles ?!"

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-0/c-2/47
msgctxt "Curt"
msgid "HAHAHAHAHAHA. Look at him! Searchin' through his pockets!"
msgstr "HAHAHAHAHAHA. Regarde-le ! Il fouille ses poches !"

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-0/c-2/58
msgctxt "Rod"
msgid "Oh, poor guy. He really thought it would work."
msgstr "Oh, le pauvre. Il y croyait vraiment."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-0/c-2/66
msgctxt "Curt"
msgid "Whoever it's for, they haven't popped their heads out or nothing."
msgstr "Pour qui que ce soit, personne a même sorti la tête."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/0/s/0
msgctxt "Choix"
msgid "The 80s called, they want their technology back."
msgstr "Les années 80 ont appelé, elles veulent récupérer leur technologie."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/1/s/0
msgctxt "Choix"
msgid "If this is how he flirts, it's no wonder he's alone! Gonna be alone FOREVER!"
msgstr "Si c'est comme ça qu'il drague, pas étonnant qu'il soit seul ! Il sera seul POUR TOUJOURS !"

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/2/s/0
msgctxt "Choix"
msgid "The D in those batteries stands for desperate."
msgstr "Le D de ces piles, c'est pour Désespéré."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/3/s/0
msgctxt "Choix"
msgid "I think it's kinda precious."
msgstr "Je trouve ça plutôt touchant."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-3/16
msgctxt "Curt"
msgid "And the 90s want that joke back!"
msgstr "Et les années 90 veulent récupérer cette blague !"

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-3/24/b/1
msgctxt "Rod"
msgid "At least they are trying to be funny. You're up here just serving commentary."
msgstr "Au moins, lui, il essaie d'être drôle. Toi, t'es là à faire du commentaire."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-3/25/b/1
msgctxt "Rod"
msgid "At least she's trying to be funny. You're up here just serving commentary."
msgstr "Au moins, elle, elle essaie d'être drôle. Toi, t'es là à faire du commentaire."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-3/26/b/1
msgctxt "Rod"
msgid "At least he's trying to be funny. You're up here just serving commentary."
msgstr "Au moins, lui, il essaie d'être drôle. Toi, t'es là à faire du commentaire."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-3/29
msgctxt "Rod"
msgid "\"Oh! He ain't got no batteries!\""
msgstr "« Oh ! Il a plus de piles ! »"

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-3/37
msgctxt "Curt"
msgid "You just mad I got the gift."
msgstr "T'es juste vénère parce que j'ai le don."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-3/45
msgctxt "Rod"
msgid "What gift?"
msgstr "Quel don ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-3/53
msgctxt "Curt"
msgid "Of observational comedy."
msgstr "De la comédie d'observation."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-3/61
msgctxt "Rod"
msgid "Who told you that lie?"
msgstr "Qui t'a sorti ce mensonge ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-3/69
msgctxt "Curt"
msgid "You act like you don't laugh at my jokes."
msgstr "Tu fais comme si tu riais pas à mes blagues."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-3/77
msgctxt "Rod"
msgid "That's what friends do."
msgstr "C'est ce que font les amis."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-3/85
msgctxt "Curt"
msgid "Laugh at each other's jokes?"
msgstr "Rire des blagues de l'autre ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-3/93
msgctxt "Rod"
msgid "Naw."
msgstr "Nan."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-3/101
msgctxt "Rod"
msgid "Lie."
msgstr "Mentir."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-4/16
msgctxt "Rod"
msgid "Eesh! That was cold."
msgstr "Aïe ! Ça, c'était glacial."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-4/27
msgctxt "Curt"
msgid "Low blow, friend. Low blow."
msgstr "Coup bas, mon pote. Coup bas."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-4/35/b/1
msgctxt "Rod"
msgid "They out there tryin'. It ain't easy putting your heart out on your sleeve!"
msgstr "Il est là, il essaie. C'est pas facile de montrer son cœur à tout le monde !"

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-4/36/b/1
msgctxt "Rod"
msgid "She out there tryin'. It ain't easy putting your heart out on your sleeve!"
msgstr "Elle est là, elle essaie. C'est pas facile de montrer son cœur à tout le monde !"

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-4/37/b/1
msgctxt "Rod"
msgid "He out there tryin'. It ain't easy putting your heart out on your sleeve!"
msgstr "Il est là, il essaie. C'est pas facile de montrer son cœur à tout le monde !"

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-4/40
msgctxt "Curt"
msgid "Rod did it once."
msgstr "Rod l'a fait une fois."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-4/48
msgctxt "Rod"
msgid "This ain't about me and my skills."
msgstr "Là, il s'agit pas de moi et de mes talents."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-4/56
msgctxt "Curt"
msgid "See? That's the problem. You think you got skills in the first place!"
msgstr "Tu vois ? C'est ça, le problème. Tu crois que t'as des talents, déjà !"

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-4/64
msgctxt "Rod"
msgid "Bruh, I'm slick! Don't play."
msgstr "Mec, je suis habile ! Joue pas."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-4/72
msgctxt "Curt"
msgid "I'm glad you can count on yourself for your delusions."
msgstr "Heureux que tu puisses compter sur toi-même pour tes illusions."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-4/80
msgctxt "Curt and Rod"
msgid "Hahahaha."
msgstr "Hahahaha."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-5/16
msgctxt "Curt"
msgid "FOR REAL!"
msgstr "POUR DE VRAI !"

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-5/27
msgctxt "Rod"
msgid "Out here playing Taylor Gift like that's gonna do the trick."
msgstr "Là-bas à passer du Taylor Gift comme si ça allait faire l'affaire."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-5/35
msgctxt "Curt"
msgid "Even those batteries said, \"naw, this ain't it!\""
msgstr "Même les piles ont dit : « nan, c'est pas ça ! »"

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-5/43
msgctxt "Rod"
msgid "Ain't even got no flowers with him."
msgstr "Il a même pas de fleurs avec lui."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-5/51
msgctxt "Curt"
msgid "Didn't come correct in the FIRST place."
msgstr "Il s'est pas pointé comme il faut dès le DÉPART."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-5/59
msgctxt "Rod"
msgid "I bet they don't even listen to Taylor Gift."
msgstr "Je parie qu'ils écoutent même pas Taylor Gift."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-5/67
msgctxt "Curt"
msgid "And if they do, they don't anymore."
msgstr "Et s'ils l'écoutent, ils l'écoutent plus."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-5/75
msgctxt "Rod"
msgid "They're burning those posters right now."
msgstr "Ils sont en train de brûler les posters."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-5/83
msgctxt "Curt"
msgid "Deleting that playlist."
msgstr "De supprimer la playlist."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-5/91
msgctxt "Rod"
msgid "Unfollowing Taylor Gift as we speak."
msgstr "De se désabonner de Taylor Gift à l'instant même."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-5/99
msgctxt "Curt"
msgid "He tried so hard, he changed someone's taste in music."
msgstr "Il a tellement forcé qu'il a changé les goûts musicaux de quelqu'un."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-5/107
msgctxt "Curt and Rod"
msgid "Haahahahaha!"
msgstr "Haahahahaha !"

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-6/11
msgctxt "Curt"
msgid "...you're kidding right?"
msgstr "... tu plaisantes, là ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-6/19
msgctxt "Rod"
msgid "I don't think they are."
msgstr "Je crois pas."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-6/27
msgctxt "Curt"
msgid "Are you a hopeless romantic? Or just hopeless?"
msgstr "T'es un romantique désespéré ? Ou juste désespéré ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-6/35
msgctxt "Rod"
msgid "Because this situation out there? Not romantic."
msgstr "Parce que ce qui se passe là-bas ? Pas romantique."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-6/43
msgctxt "Curt"
msgid "Not at all. He watched a movie and said \"I'll try that.\""
msgstr "Pas du tout. Il a regardé un film et s'est dit « je vais essayer ça »."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-6/51
msgctxt "Rod"
msgid "He'll be slapping a cape on before we know it."
msgstr "Il va bientôt enfiler une cape."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-6/59
msgctxt "Curt"
msgid "The studios better watch out. That man out there is taking notes."
msgstr "Les studios feraient bien de se méfier. Ce type prend des notes."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-6/67
msgctxt "Rod"
msgid "But, if that's what you like, that's cool."
msgstr "Mais si c'est ce que tu aimes, c'est cool."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-6/75
msgctxt "Curt"
msgid "It's not really cool."
msgstr "C'est pas vraiment cool."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-6/83
msgctxt "Rod"
msgid "I mean... yeah, it ain't. But, the fact that you think that's cool... that's cool."
msgstr "Je veux dire... ouais, ça l'est pas. Mais le fait que tu trouves ça cool... c'est cool."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-6/91
msgctxt "Curt"
msgid "We all have flaws. Better to identify what it is. That's where the growth happens."
msgstr "On a tous des défauts. Mieux vaut les identifier. C'est là que la progression se fait."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-6/99
msgctxt "Rod"
msgid "You think boombox boy will learn?"
msgstr "Tu crois que le gars à la chaîne stéréo va apprendre ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-1/c-6/107
msgctxt "Curt"
msgid "Naw. But, kudos on him for buying physical media."
msgstr "Nan. Mais bravo à lui d'acheter des supports physiques."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-2/0
msgctxt "Curt"
msgid "Oh... is he?"
msgstr "Oh... c'est vrai ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-2/8
msgctxt "Rod"
msgid "He's walking away."
msgstr "Il s'en va."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-2/16
msgctxt "Curt"
msgid "Good try, my dude! Good try!"
msgstr "Bien essayé, mon pote ! Bien essayé !"

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-2/24/s/0
msgctxt "Choix"
msgid "I hope he can make it work with whoever it was."
msgstr "J'espère qu'il arrivera à s'arranger avec la personne en question."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-2/25/s/0
msgctxt "Choix"
msgid "Maybe they just weren't home."
msgstr "Peut-être qu'ils étaient juste pas chez eux."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-3/0
msgctxt "Rod"
msgid "I think he should just move on. Take a tip from me."
msgstr "Je pense qu'il devrait tourner la page. Qu'il suive mon exemple."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-3/8
msgctxt "Rod"
msgid "When someone wants ya, you shouldn't have to chase them down."
msgstr "Quand on te veut, tu devrais pas avoir à courir après."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-3/16
msgctxt "Curt"
msgid "He's better off without whoever he was trying to get."
msgstr "Il est mieux sans celui ou celle qu'il essayait de conquérir."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-3/24
msgctxt "Rod"
msgid "Unless he's not."
msgstr "À moins qu'il le soit pas."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-3/32
msgctxt "Curt"
msgid "You right, you right."
msgstr "T'as raison, t'as raison."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-3/40
msgctxt "Rod"
msgid "Yo, I'm tired. Looking at that guy made me tired."
msgstr "Yo, je suis crevé. Regarder ce type m'a crevé."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-3/48
msgctxt "Curt"
msgid "Alright, let's just hang."
msgstr "Bon, on traîne, c'est tout."

# Traduction IA – à relire
#: curtrod_curtain/shade_foyer/0/g-3/56
msgctxt "Rod"
msgid "That's for swingin' by. We'll see ya!"
msgstr "Merci d'être passé. À plus !"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/49
msgctxt "Rod"
msgid "Psst! Come here."
msgstr "Psst ! Viens ici."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/57
msgctxt "Narrator"
msgid "Rod waves you over, his voice low."
msgstr "Rod vous fait signe d'approcher, la voix basse."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/66/s/0
msgctxt "Choix"
msgid "Hey Rod!"
msgstr "Salut Rod !"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-0/0
msgctxt "Rod"
msgid "We gotta be quiet. Curt is sleepin'."
msgstr "Faut qu'on soit discrets. Curt dort."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-0/8/s/0
msgctxt "Choix"
msgid "Oh! I don't want to disturb him!"
msgstr "Oh ! Je veux pas le déranger !"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-0/9/s/0
msgctxt "Choix"
msgid "I'll come back some other time then!"
msgstr "Alors je reviendrai une autre fois !"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/0
msgctxt "Rod"
msgid "No, wait! He's talkin' in his sleep."
msgstr "Non, attends ! Il parle dans son sommeil."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/8
msgctxt "Curt"
msgid "<i>...yo! You silly!...</i>"
msgstr "<i>...yo ! T'es folle !...</i>"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/19
msgctxt "Rod"
msgid "He's been going on like this for like an hour!"
msgstr "Ça fait genre une heure qu'il est comme ça !"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/27
msgctxt "Curt"
msgid "<i>You know that textile looks GREAT on you! </i>"
msgstr "<i>Tu sais que ce textile te va SUPER bien ! </i>"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/38
msgctxt "Rod"
msgid "Nothing but lame pick up lines and giggles."
msgstr "Rien que des phrases d'accroche nulles et des gloussements."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/46
msgctxt "Curt"
msgid "<i>hehehehehe </i>"
msgstr "<i>hehehehehe </i>"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/57
msgctxt "Rod"
msgid "It's pretty hilarious if you ask me."
msgstr "C'est assez hilarant, si tu veux mon avis."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/65
msgctxt "Curt"
msgid "<i>Wait... what you mean you like Rod more? </i>"
msgstr "<i>Attends... comment ça, tu préfères Rod ? </i>"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/76
msgctxt "Curt"
msgid "<i>I'm cool! I'm like... really cool! </i>"
msgstr "<i>Je suis cool ! Je suis... vraiment cool ! </i>"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/87
msgctxt "Rod"
msgid "<i>Hehehehehe... </i>"
msgstr "<i>Hehehehehe... </i>"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/95
msgctxt "Curt"
msgid "<i>Wait! Come back! </i>"
msgstr "<i>Attends ! Reviens ! </i>"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/109
msgctxt "Curt"
msgid "WAIT! DON'T GO!"
msgstr "ATTENDS ! PARS PAS !"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/120
msgctxt "Narrator"
msgid "Curt snaps awake, looking at you and Rod for a few moments as he gets his bearings."
msgstr "Curt se réveille en sursaut, vous regarde, vous et Rod, quelques instants, le temps de reprendre ses esprits."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/139
msgctxt "Curt"
msgid "...I was doing it again, wasn't I?"
msgstr "... je l'ai refait, c'est ça ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/147
msgctxt "Rod"
msgid "Yep!"
msgstr "Ouaip !"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/155/s/0
msgctxt "Choix"
msgid "You can't even get the person of your dreams IN your dreams!"
msgstr "Tu arrives même pas à avoir la personne de tes rêves DANS tes rêves !"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/156/s/0
msgctxt "Choix"
msgid "You sounded like an idiot just now."
msgstr "Tu avais l'air d'un idiot, là."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/157/s/0
msgctxt "Choix"
msgid "I thought it was super cute. You dream of love!"
msgstr "Je trouve ça super mignon. Tu rêves d'amour !"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/158/s/0
msgctxt "Choix"
msgid "Sounds like you need to take some tips from Rod!"
msgstr "On dirait que t'as besoin de prendre des conseils auprès de Rod !"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-4/16
msgctxt "Rod"
msgid "Hahahaha. That's a good one!"
msgstr "Hahahaha. Celle-là est bonne !"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-4/27
msgctxt "Curt"
msgid "Oh! You got me good with that one!"
msgstr "Oh ! Tu m'as bien eu avec celle-là !"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-4/35
msgctxt "Rod"
msgid "I do like the fact that I've still got more game, even in your mind."
msgstr "J'aime bien l'idée d'avoir encore plus de répondant que toi, même dans ta tête."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-4/43
msgctxt "Curt"
msgid "Dreams don't mean anything."
msgstr "Les rêves ne veulent rien dire."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-4/51
msgctxt "Rod"
msgid "Yes they do! And this one meant that you know that I'm better than you!"
msgstr "Si, ils veulent dire quelque chose ! Et celui-là voulait dire que tu sais que je suis meilleur que toi !"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-4/59
msgctxt "Curt"
msgid "You know, I was awake the whole time."
msgstr "Tu sais, j'étais réveillé tout du long."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-4/67
msgctxt "Rod"
msgid "Oh, really?"
msgstr "Ah ouais ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-4/75
msgctxt "Curt"
msgid "Yeah! I let you think I was asleep and said all that stuff to make you feel better about yourself."
msgstr "Ouais ! Je t'ai laissé croire que je dormais et j'ai dit tout ça pour que tu te sentes mieux."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-4/86
msgctxt "Rod"
msgid "Yeah right. It's okay, buddy. I believe you."
msgstr "Ouais, c'est ça. C'est pas grave, mon vieux. Je te crois."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-4/94
msgctxt "Curt"
msgid "Really?"
msgstr "Vraiment ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-4/102
msgctxt "Rod"
msgid "Hell naw!"
msgstr "Putain, non !"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-5/16
msgctxt "Rod"
msgid "Hey hey hey now. It's all in good fun."
msgstr "Hé hé hé, du calme. C'est pour rire."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-5/24
msgctxt "Curt"
msgid "I can't help what I say in my sleep."
msgstr "Je suis pas responsable de ce que je dis en dormant."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-5/32
msgctxt "Rod"
msgid "Sure, Curt couldn't seal the deal in his dream, but that doesn't make him an idiot."
msgstr "Certes, Curt a pas réussi à conclure dans son rêve, mais ça fait pas de lui un idiot."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-5/40
msgctxt "Curt"
msgid "Exactly."
msgstr "Exactement."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-5/48
msgctxt "Rod"
msgid "It does put you in second place behind me, though."
msgstr "Ça te place en deuxième position derrière moi, par contre."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-5/56
msgctxt "Curt"
msgid "Real cute, Rod. Reeeal cute."
msgstr "Très mignon, Rod. Trèèès mignon."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-5/64
msgctxt "Rod"
msgid "It's okay to fail man! I mean, I wouldn't know anything about it, but that's what I've been told."
msgstr "C'est pas grave d'échouer, mec ! Enfin, je saurais pas, mais c'est ce qu'on m'a dit."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-6/11
msgctxt "Curt"
msgid "See? I'm cute!"
msgstr "Tu vois ? Je suis mignon !"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-6/19
msgctxt "Rod"
msgid "Yeah, yeah."
msgstr "Ouais, ouais."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-6/27/b/1
msgctxt "Curt"
msgid "They said it! They called me cute!"
msgstr "Iel l'a dit ! Iel m'a trouvé mignon !"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-6/28/b/1
msgctxt "Curt"
msgid "She said it! She called me cute!"
msgstr "Elle l'a dit ! Elle m'a trouvé mignon !"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-6/29/b/1
msgctxt "Curt"
msgid "He said it! He called me cute!"
msgstr "Il l'a dit ! Il m'a trouvé mignon !"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-6/32/b/1
msgctxt "Rod"
msgid "They were just being nice."
msgstr "Iel était juste gentil·le."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-6/33/b/1
msgctxt "Rod"
msgid "She was just being nice."
msgstr "Elle était juste gentille."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-6/34/b/1
msgctxt "Rod"
msgid "He was just being nice."
msgstr "Il était juste gentil."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-6/37
msgctxt "Curt"
msgid "Or honest. Because, honestly? I'm cute as hell."
msgstr "Ou honnête. Parce que franchement ? Je suis mignon à croquer."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-6/45
msgctxt "Rod"
msgid "Not cute enough for whoever you were dreaming about."
msgstr "Pas assez mignon pour la personne dont tu rêvais."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-6/53
msgctxt "Curt"
msgid "You don't know that. It was my dream."
msgstr "Tu peux pas savoir ça. C'était mon rêve."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-6/61
msgctxt "Rod"
msgid "Fine. I know that even you know, deeeep in the back of your brain, that I'm better looking."
msgstr "Bon. Je sais que même toi, tu sais, tout au fond de ton cerveau, que je suis plus beau."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-6/69
msgctxt "Curt"
msgid "Psh. My mind was just messing with me."
msgstr "Pfff. Mon esprit me faisait juste une blague."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-6/77
msgctxt "Rod"
msgid "Keep telling yourself that. We all heard the truth."
msgstr "Continue de te le répéter. On a tous entendu la vérité."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-7/16
msgctxt "Rod"
msgid "That's right! Line on up and get some schoolin'."
msgstr "C'est ça ! Mettez-vous en rang pour une bonne leçon !"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-7/24
msgctxt "Curt"
msgid "In your dreams."
msgstr "Dans tes rêves."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-7/32
msgctxt "Rod"
msgid "Naw, you ain't in there."
msgstr "Nan, t'y es pas."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-7/40
msgctxt "Curt"
msgid "You've never dreamed about me?"
msgstr "Tu as jamais rêvé de moi ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-7/48
msgctxt "Rod"
msgid "Sure I have."
msgstr "Si, bien sûr."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-7/56
msgctxt "Curt"
msgid "See?"
msgstr "Tu vois ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-7/64
msgctxt "Rod"
msgid "And you always a clown in them."
msgstr "Et t'es toujours un clown dedans."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-7/72
msgctxt "Curt"
msgid "A clown??"
msgstr "Un clown ??"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-1/c-7/80
msgctxt "Rod"
msgid "Yeah. Just like in real life!"
msgstr "Ouais. Comme dans la vraie vie !"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-2/0
msgctxt "Rod"
msgid "How about this. Let's get you back to bed and let you have another shot."
msgstr "Écoute. On te remet au lit et tu retentes ta chance."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-2/11/b/1 curtrod_curtain/shade_bedroom/0/g-2/12/b/1 curtrod_curtain/shade_bedroom/0/g-2/13/b/1
msgctxt "Curt"
msgid "You think they'll come back again?"
msgstr "Tu crois que la personne va revenir ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-2/16
msgctxt "Rod"
msgid "Oh no, you blew it. Even your mind knows it."
msgstr "Oh non, t'as tout gâché. Même ton esprit le sait."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-2/24
msgctxt "Rod"
msgid "Dream a new dream. One where you've got game!"
msgstr "Fais un nouveau rêve. Un où t'as du répondant !"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-2/32
msgctxt "Curt"
msgid "Hardy har!"
msgstr "Ha ha, très drôle !"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-2/40
msgctxt "Rod"
msgid "Let's let Curt get some shut-eye. And hope he's smoother next time."
msgstr "Laissons Curt dormir un peu. Et espérons qu'il sera plus doué la prochaine fois."

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-2/48
msgctxt "Curt"
msgid "Don't listen to me if I start talkin' in my sleep!"
msgstr "M'écoutez pas si je me mets à parler en dormant !"

# Traduction IA – à relire
#: curtrod_curtain/shade_bedroom/0/g-2/56
msgctxt "Rod"
msgid "No promises!"
msgstr "Je promets rien !"

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/46
msgctxt "Curt"
msgid "Yooo! Rod! Stop!"
msgstr "Yooo ! Rod ! Arrête !"

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/57
msgctxt "Narrator"
msgid "Rod is in the middle of a very loud, very off-key song."
msgstr "Rod est en plein milieu d'une chanson très bruyante et très fausse."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/65
msgctxt "Rod"
msgid "<w>♪ YOU KNOW YOU WANT ME, BABY! ♪</w>"
msgstr "<w>♪ TU SAIS QUE TU ME VEUX, BÉBÉ ! ♪</w>"

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/76
msgctxt "Curt"
msgid "This is torture. Pure torture."
msgstr "C'est de la torture. De la torture pure."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/87
msgctxt "Rod"
msgid "<w>♪ YOU JUST CAN'T HAVE MEEEE, BAAAABY!! ♪</w>"
msgstr "<w>♪ MAIS TU PEUX PAS M'AVOIIIIR, BÉÉÉÉBÉ !! ♪</w>"

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/98
msgctxt "Rod"
msgid "<w>♪ BECAUSE YOOOOOOOU BELONG TO SOMEONE ELSE!! ♪</w>"
msgstr "<w>♪ PARCE QUE TOOOOOOI, TU APPARTIENS À QUELQU'UN D'AUTRE !! ♪</w>"

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/109/s/0
msgctxt "Choix"
msgid "Bravo!"
msgstr "Bravo !"

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/110/s/0
msgctxt "Choix"
msgid "That was... interesting!"
msgstr "C'était... intéressant !"

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/111/s/0
msgctxt "Choix"
msgid "...what in the world was that?"
msgstr "... c'était quoi, ça ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/c-0/7
msgctxt "Curt"
msgid "Naw! Don't encourage him!"
msgstr "Nan ! L'encourage pas !"

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/c-1/7
msgctxt "Rod"
msgid "Thanks, I made it up myself."
msgstr "Merci, je l'ai inventée moi-même."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/c-2/7
msgctxt "Curt"
msgid "Rod has decided to give music a try."
msgstr "Rod a décidé de se mettre à la musique."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/0
msgctxt "Rod"
msgid "Something about having this piano nearby that just gets my creative juices flowing."
msgstr "Y a un truc dans le fait d'avoir ce piano à côté qui fait couler mon jus créatif."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/8
msgctxt "Curt"
msgid "Could they not flow, though? Like, what's the opposite of flow?"
msgstr "Il pourrait pas couler, ce jus ? Genre, c'est quoi le contraire de couler ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/16
msgctxt "Curt"
msgid "Whatever it is, can that be what the juices do?"
msgstr "Peu importe, est-ce que le jus peut faire ça ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/24
msgctxt "Rod"
msgid "You just jealous."
msgstr "T'es juste jaloux."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/32
msgctxt "Curt"
msgid "You tryin' to crack Wyndolyn with that singing?"
msgstr "Tu essaies de fendre Wyndolyn avec ce chant ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/46
msgctxt "Wyndolyn"
msgid "What are we talking about?"
msgstr "De quoi on parle ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/57
msgctxt "Curt"
msgid "Rod's singing."
msgstr "Du chant de Rod."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/65
msgctxt "Wyndolyn"
msgid "Oh! It wasn't that great."
msgstr "Oh ! C'était pas terrible."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/73
msgctxt "Rod"
msgid "You know you're lying."
msgstr "Tu sais que tu mens."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/81
msgctxt "Wyndolyn"
msgid "I'm not, cutie. But, I'll let you think that."
msgstr "Non, mon mignon. Mais je te laisse le croire."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/92
msgctxt "Narrator"
msgid "And with that, Wyndolyn takes her leave."
msgstr "Sur ce, Wyndolyn prend congé."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/100
msgctxt "Rod"
msgid "Y'all just haters."
msgstr "Vous êtes tous des rabat-joie."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/111/s/0
msgctxt "Choix"
msgid "Of you? No. That melody though...? Eeesh!"
msgstr "De toi ? Non. Mais cette mélodie...? Aïe aïe aïe !"

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/112/s/0
msgctxt "Choix"
msgid "Just suck less. That easy."
msgstr "Sois juste moins nul. C'est simple."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/113/s/0
msgctxt "Choix"
msgid "You have other talents! Lean on those!"
msgstr "T'as d'autres talents ! Appuie-toi dessus !"

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/114/s/0
msgctxt "Choix"
msgid "I think you sing like a meadowlark!"
msgstr "Je trouve que tu chantes comme un rossignol !"

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/c-3/16
msgctxt "Curt"
msgid "Hahahahaha!"
msgstr "Hahahahaha !"

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/c-3/27
msgctxt "Rod"
msgid "Oh, come on. You know it was a jam."
msgstr "Oh, allez. Vous savez que c'était un tube."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/c-3/35
msgctxt "Curt"
msgid "Made me wanna jam my head under a pillow!"
msgstr "Ça m'a donné envie de me fourrer la tête sous un oreiller !"

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/c-3/43
msgctxt "Rod"
msgid "You gonna be humming it all day."
msgstr "Tu vas la fredonner toute la journée."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/c-3/51
msgctxt "Curt"
msgid "Rod! Why would you wish something so mean upon our friend here."
msgstr "Rod ! Pourquoi tu souhaites un truc aussi méchant à notre ami ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/c-3/59
msgctxt "Curt"
msgid "I'm sorry that he has shown how much he doesn't care about you."
msgstr "Désolé qu'il ait montré à quel point il se fiche de toi."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/c-3/67
msgctxt "Rod"
msgid "You said I was a good singer."
msgstr "Tu as dit que je chantais bien."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/c-3/75
msgctxt "Curt"
msgid "Things lie all the time, Rod. I am things."
msgstr "Les objets mentent tout le temps, Rod. Je suis un objet."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/c-4/16
msgctxt "Curt"
msgid "Now, not everyone has musical talents."
msgstr "Bon, tout le monde n'a pas des talents musicaux."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/c-4/24
msgctxt "Rod"
msgid "And I just sing for fun, alright. I'm not gonna like, audition for American Maestro or anything."
msgstr "Et je chante juste pour le plaisir, ok. Je vais pas, genre, passer des auditions pour American Maestro ou je sais pas quoi."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/c-4/32
msgctxt "Curt"
msgid "Yeah, you shouldn't do that. You would get booed out of the judging room."
msgstr "Ouais, fais pas ça. Tu te ferais huer jusqu'à la sortie du jury."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/c-4/40
msgctxt "Rod"
msgid "I don't know about all that."
msgstr "Je sais pas si c'est vrai."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/c-4/48
msgctxt "Curt"
msgid "Cut in the first round. No's from every judge."
msgstr "Éliminé au premier tour. Des « non » de tous les jurés."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/c-4/56
msgctxt "Rod"
msgid "Okay, okay, I get it."
msgstr "Ok, ok, j'ai compris."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/c-4/64
msgctxt "Curt"
msgid "Buzzers. Red ones. Like, the big red ones? That make that really loud sound. But like... five of them."
msgstr "Des buzzers. Des rouges. Genre les gros rouges ? Qui font ce bruit super fort. Mais genre... cinq d'entre eux."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/c-4/72
msgctxt "Rod"
msgid "You know what?"
msgstr "Tu sais quoi ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/c-5/16
msgctxt "Curt"
msgid "That's code for, \"you can't sing.\""
msgstr "C'est le code pour « tu sais pas chanter »."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/c-5/24
msgctxt "Rod"
msgid "One of those talents could be song writing."
msgstr "L'un de ces talents pourrait être l'écriture de chansons."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/c-5/32
msgctxt "Curt"
msgid "Did you make up the lyrics you were singing?"
msgstr "Tu as inventé les paroles que tu chantais ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/c-5/40
msgctxt "Rod"
msgid "Yeah. It was a Rod original."
msgstr "Ouais. Un original de Rod."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/c-5/48
msgctxt "Curt"
msgid "Then that's a no from me, dawg."
msgstr "Alors c'est un non pour moi, mon pote."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/c-5/56
msgctxt "Rod"
msgid "I've never seen you try to write a song."
msgstr "Je t'ai jamais vu essayer d'écrire une chanson."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/c-5/64
msgctxt "Curt"
msgid "That's because I know my lane. Know thy self and all that stuff."
msgstr "C'est parce que je connais mon couloir. Connais-toi toi-même et tout ça."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/c-6/14
msgctxt "Curt"
msgid "See, that's so cold."
msgstr "Tu vois, c'est tellement glacial."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/c-6/22
msgctxt "Rod"
msgid "Why? That was a compliment."
msgstr "Pourquoi ? C'était un compliment."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/c-6/30
msgctxt "Curt"
msgid "It was a lie, is what it was. How you gonna sit up here and lie to this man like that."
msgstr "C'était un mensonge, voilà ce que c'était. Comment tu peux rester là à mentir à ce type comme ça."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/c-6/38
msgctxt "Rod"
msgid "I just think that you notice and appreciate talent."
msgstr "Je pense juste que tu remarques et apprécies le talent."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-0/c-6/46
msgctxt "Curt"
msgid "If you think that's music, I'm not giving you the aux anytime soon."
msgstr "Si tu penses que c'est de la musique, je te confie pas la sono de sitôt."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-1/3
msgctxt "Rod"
msgid "No matter what anyone says, I'mma sing."
msgstr "Quoi que dise quiconque, je chanterai."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-1/11
msgctxt "Curt"
msgid "Oh my goodness!"
msgstr "Mon Dieu !"

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-1/19
msgctxt "Rod"
msgid "So, plug your ears! Because I've got a song in my heart, damn it!"
msgstr "Alors bouchez-vous les oreilles ! Parce que j'ai une chanson dans le cœur, bordel !"

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-1/27
msgctxt "Curt"
msgid "And now I've got a pain in my side."
msgstr "Et moi, j'ai un point de côté."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-1/38
msgctxt "Curt"
msgid "You should get out of here before he starts belting a new song."
msgstr "Tu devrais filer avant qu'il se mette à beugler une nouvelle chanson."

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-1/46
msgctxt "Rod"
msgid "♪ I'VE GOT MUSIC IN MY BONES! ♪"
msgstr "♪ J'AI DE LA MUSIQUE DANS LES OS ! ♪"

# Traduction IA – à relire
#: curtrod_curtain/shade_piano_room/0/g-1/57
msgctxt "Curt"
msgid "Quick! Run! SAVE YOURSELF!"
msgstr "Vite ! Cours ! SAUVE-TOI !"

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/46
msgctxt "Rod"
msgid "What you're saying simply doesn't exist."
msgstr "Ce que tu dis n'existe tout simplement pas."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/54
msgctxt "Curt"
msgid "Yes it does! You know it does!"
msgstr "Si, ça existe ! Tu sais que ça existe !"

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/65
msgctxt "Rod"
msgid "I know it DOESN'T!"
msgstr "Je sais que ça n'EXISTE PAS !"

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/76
msgctxt "Curt"
msgid "You ain't got no romance in your heart."
msgstr "T'as aucune romance dans le cœur."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/84
msgctxt "Rod"
msgid "I'm full of romance. I'm just realistic."
msgstr "Je suis plein de romance. Je suis juste réaliste."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/92/s/0
msgctxt "Choix"
msgid "What's Rod going on about?"
msgstr "Qu'est-ce qui lui prend, à Rod ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/93/s/0
msgctxt "Choix"
msgid "Curt had an idea about something?"
msgstr "Curt a eu une idée sur quelque chose ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-0/0
msgctxt "Rod"
msgid "Go on. Say it out loud."
msgstr "Allez. Dis-le à voix haute."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-0/8
msgctxt "Curt"
msgid "Now that I'm on the spot, I don't want to."
msgstr "Maintenant que je suis sur la sellette, j'ai plus envie."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-0/16
msgctxt "Rod"
msgid "Because you KNOW it ain't real."
msgstr "Parce que tu SAIS que c'est pas vrai."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-0/24
msgctxt "Curt"
msgid "Fine. You gotta be the determining factor, okay?"
msgstr "Bon. Tu seras celui ou celle qui tranche, ok ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-0/32/s/0 curtrod_curtain/rod_toxic/0/g-1/16/s/0
msgctxt "Choix"
msgid "Of course!"
msgstr "Bien sûr !"

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-0/33/s/0
msgctxt "Choix"
msgid "I'll tell you the truth, don't worry."
msgstr "Je te dirai la vérité, t'inquiète."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/0
msgctxt "Curt"
msgid "Rod thinks I'm lame because I believe in love at first sight."
msgstr "Rod pense que je suis nul parce que je crois au coup de foudre."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/8
msgctxt "Rod"
msgid "There is no such thing!"
msgstr "Ça existe pas, un truc pareil !"

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/16
msgctxt "Curt"
msgid "Just because you've never experienced it, doesn't mean it ain't real!"
msgstr "Ce n'est pas parce que tu l'as jamais vécu que ça n'existe pas !"

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/24
msgctxt "Rod"
msgid "Curt is feeling nostalgic for these shutters that used to be next door."
msgstr "Curt est nostalgique de ces volets qui étaient à côté avant."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/32
msgctxt "Curt"
msgid "We had a connection!"
msgstr "On avait une connexion !"

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/40
msgctxt "Rod"
msgid "They didn't even know you existed!"
msgstr "Ils savaient même pas que t'existais !"

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/48
msgctxt "Curt"
msgid "You should have seen the way they waved at me."
msgstr "Il fallait voir comment ils me faisaient signe."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/56
msgctxt "Rod"
msgid "They got caught in the wind. They couldn't control it."
msgstr "Ils se sont fait prendre par le vent. Ils pouvaient pas le contrôler."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/64
msgctxt "Rod"
msgid "Every now and then, he thinks about those shutters and he becomes impossible."
msgstr "De temps en temps, il repense à ces volets et il devient impossible."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/72
msgctxt "Rod"
msgid "They never even spoke. Curt never even said a word to them."
msgstr "Ils se sont jamais parlé. Curt leur a même jamais dit un mot."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/80
msgctxt "Curt"
msgid "I didn't need to."
msgstr "J'en avais pas besoin."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/88
msgctxt "Rod"
msgid "You were scared."
msgstr "T'avais peur."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/96
msgctxt "Curt"
msgid "I was not!"
msgstr "Pas du tout !"

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/104
msgctxt "Rod"
msgid "You was a <i>bitch</i>."
msgstr "T'étais une <i>chochotte</i>."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/112/0/s/0
msgctxt "Choix"
msgid "You caught feelings when they didn't even catch your name!"
msgstr "Tu es tombé amoureux alors qu'ils connaissaient même pas ton nom !"

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/112/1/s/0
msgctxt "Choix"
msgid "I think that is super sweet."
msgstr "Je trouve ça super mignon."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/112/2/s/0
msgctxt "Choix"
msgid "Chasing someone who doesn't even know you? LOSER!"
msgstr "Courir après quelqu'un qui te connaît même pas ? PERDANT !"

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/112/3/s/0
msgctxt "Choix"
msgid "Scaredy wittle Curty-wurty."
msgstr "Ptit Curtounet trouillard."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/112/c-4/16
msgctxt "Rod"
msgid "Ha! You didn't even get a name, did you?"
msgstr "Ha ! T'as même pas eu un nom, hein ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/112/c-4/24
msgctxt "Curt"
msgid "...no."
msgstr "... non."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/112/c-4/32
msgctxt "Rod"
msgid "I totally forgot about that!"
msgstr "J'avais complètement oublié ça !"

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/112/c-4/40
msgctxt "Rod"
msgid "Those shutters don't even know who you are!"
msgstr "Ces volets savent même pas qui t'es !"

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/112/c-4/48
msgctxt "Curt"
msgid "And they never will!"
msgstr "Et ils le sauront jamais !"

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/112/c-4/56
msgctxt "Rod"
msgid "It's time to move on."
msgstr "Il est temps de tourner la page."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/112/c-4/64
msgctxt "Curt"
msgid "I can't move on!"
msgstr "Je peux pas tourner la page !"

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/112/c-4/72
msgctxt "Rod"
msgid "You can't tell me you actually still miss them."
msgstr "Tu peux pas me dire qu'ils te manquent encore pour de vrai."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/112/c-5/14
msgctxt "Curt"
msgid "Finally, a romantic."
msgstr "Enfin, un romantique."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/112/c-5/22
msgctxt "Rod"
msgid "There isn't anything romantic about longing for something you've never spoken to."
msgstr "Y a rien de romantique à désirer quelqu'un à qui t'as jamais parlé."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/112/c-5/30
msgctxt "Curt"
msgid "Words were not important! It was love, I'm telling you."
msgstr "Les mots étaient pas importants ! C'était de l'amour, je te dis."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/112/c-5/38
msgctxt "Rod"
msgid "They didn't even know your name."
msgstr "Ils savaient même pas ton nom."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/112/c-5/46
msgctxt "Curt"
msgid "What is a name when it comes to love?"
msgstr "C'est quoi, un nom, quand il s'agit d'amour ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/112/c-5/54
msgctxt "Rod"
msgid "Hella important!"
msgstr "Hyper important !"

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/112/c-5/62
msgctxt "Rod"
msgid "You've gotta let them go."
msgstr "Faut que tu les laisses partir."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/112/c-6/16
msgctxt "Rod"
msgid "Ay-ay-ay. Okay, you're coming in a bit too hot here."
msgstr "Aïe aïe aïe. Ok, là, tu y vas un peu fort."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/112/c-6/24
msgctxt "Curt"
msgid "My heart wants what it wants."
msgstr "Mon cœur veut ce qu'il veut."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/112/c-6/32
msgctxt "Rod"
msgid "I'll admit, I still don't see how it is possible to love them, but, you have the right to."
msgstr "J'avoue que je vois toujours pas comment on peut les aimer, mais t'as le droit."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/112/c-6/40
msgctxt "Curt"
msgid "It is better to have loved and... have them leave or... something like that."
msgstr "Mieux vaut avoir aimé et... qu'ils partent ou... un truc comme ça."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/112/c-6/48
msgctxt "Rod"
msgid "You can't even get the saying right."
msgstr "T'arrives même pas à citer le dicton correctement."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/112/c-6/56
msgctxt "Rod"
msgid "Look, I think it's time that you move on."
msgstr "Écoute, je pense qu'il est temps que tu passes à autre chose."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/112/c-7/16
msgctxt "Curt"
msgid "I wasn't scared! Just like... not super brave about it."
msgstr "J'avais pas peur ! C'est juste que... j'étais pas super courageux sur ce coup."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/112/c-7/27
msgctxt "Rod"
msgid "That's what scared is."
msgstr "C'est ça, avoir peur."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/112/c-7/35
msgctxt "Curt"
msgid "I mean, could I do a long distance relationship? I don't know if I was ready for that."
msgstr "Je veux dire, est-ce que j'aurais pu faire une relation à distance ? Je sais pas si j'étais prêt pour ça."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/112/c-7/43
msgctxt "Rod"
msgid "Given the circumstances, you would have seen them every day."
msgstr "Vu les circonstances, tu les aurais vus tous les jours."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/112/c-7/51
msgctxt "Curt"
msgid "But not at night! Imagine not being able to see your love every night."
msgstr "Mais pas la nuit ! Imagine ne pas pouvoir voir ton amour tous les soirs."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/112/c-7/59
msgctxt "Rod"
msgid "Sounds like it wasn't going to work out anyway. Best if you just move on."
msgstr "On dirait que ça aurait pas marché de toute façon. Le mieux, c'est de passer à autre chose."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-1/112/c-7/67
msgctxt "Curt"
msgid "I can't just move on!"
msgstr "Je peux pas passer à autre chose comme ça !"

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-3/0
msgctxt "Curt"
msgid "You can't control your heart!"
msgstr "On contrôle pas son cœur !"

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-3/8
msgctxt "Curt"
msgid "And when... they didn't survive the remodel..."
msgstr "Et quand... ils ont pas survécu aux travaux..."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-3/16
msgctxt "Rod"
msgid "Oh, no. Here we go."
msgstr "Oh non. C'est reparti."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-3/24
msgctxt "Curt"
msgid "I... I can't... I just miss them so much..."
msgstr "Je... je peux pas... ils me manquent tellement..."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-3/33/s/0
msgctxt "Choix"
msgid "Is Curt okay?"
msgstr "Curt va bien ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-4/0
msgctxt "Rod"
msgid "This is where he cries."
msgstr "C'est là qu'il pleure."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-4/8
msgctxt "Narrator"
msgid "As if on cue, Curt bursts into tears."
msgstr "Comme si c'était écrit, Curt éclate en sanglots."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-4/16
msgctxt "Curt"
msgid "THEY GAVE THE HOUSE SO MUCH CHARACTER!"
msgstr "ILS DONNAIENT TELLEMENT DE CARACTÈRE À LA MAISON !"

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-4/27
msgctxt "Rod"
msgid "I know, buddy."
msgstr "Je sais, mon vieux."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-4/35
msgctxt "Curt"
msgid "THEY SHOULD... THEY SHOULD BRING THEM BAAAAACK!"
msgstr "ILS DEVRAIENT... ILS DEVRAIENT LES REMETTRE !"

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-4/46
msgctxt "Rod"
msgid "He's gonna be like this for awhile."
msgstr "Il va rester comme ça un moment."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-4/54
msgctxt "Rod"
msgid "You won't want to be here for it."
msgstr "Tu voudras pas être là pour ça."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-4/62
msgctxt "Rod"
msgid "We'll see you around."
msgstr "À plus."

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-4/70
msgctxt "Curt"
msgid "THEY WERE SOOO CUUUUUUUUTE!"
msgstr "ILS ÉTAIENT TELLEMENT MIGNOOOOOONS !"

# Traduction IA – à relire
#: curtrod_curtain/shade_dining_room/0/g-4/81
msgctxt "Rod"
msgid "It's okay, Curt. It's okay."
msgstr "C'est bon, Curt. C'est bon."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/37
msgctxt "Cabrizzio"
msgid "Buongiorno, amici! I hear we are discussing passion! To discuss passion, it is... well, my passion."
msgstr "Buongiorno, amici ! J'ai entendu dire qu'on parlait de passion ! Parler de passion, c'est... eh bien, ma passion."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/45
msgctxt "Cabrizzio"
msgid "I must tell you truly, though, you two are as yet unschooled in the arts and sciences of this noble sensation!"
msgstr "Je dois pourtant vous dire la vérité : vous deux, vous êtes encore ignorants des arts et des sciences de ce noble sentiment !"

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/56
msgctxt "Curt"
msgid "See, I told you!"
msgstr "Tu vois, je te l'avais dit !"

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/64
msgctxt "Rod"
msgid "You paid him to say that."
msgstr "Tu l'as payé pour dire ça."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/72
msgctxt "Cabrizzio"
msgid "I can assure you, he did not. No payment for passion for Cabrizzio! I do this for love."
msgstr "Je peux vous assurer que non. Pas de paiement pour la passion chez Cabrizzio ! Je fais ça par amour."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/80
msgctxt "Cabrizzio"
msgid "Swagger is not a romantic skill, you see!"
msgstr "La frime n'est pas un talent romantique, voyez-vous !"

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/88
msgctxt "Cabrizzio"
msgid "You have much of one... and very little of the other. Tanto e poco, si?"
msgstr "Vous avez beaucoup de l'une... et très peu de l'autre. Tanto e poco, si ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/96
msgctxt "Cabrizzio"
msgid "That is why la bella Wyndolyn has rejected your advances with such a chilly sill."
msgstr "C'est pour ça que la bella Wyndolyn a repoussé vos avances avec un rebord si glacial."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/107/s/0
msgctxt "Choix"
msgid "Rod has a thing for Wyndolyn?"
msgstr "Rod en pince pour Wyndolyn ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/108/s/0
msgctxt "Choix"
msgid "Oooo, this sounds juicy!"
msgstr "Oooo, ça sent le croustillant !"

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/c-0/7
msgctxt "Rod"
msgid "I <i>had</i> a thing for her. Once."
msgstr "J'en <i>pinçais</i> pour elle. Il y a longtemps."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/c-1/7
msgctxt "Rod"
msgid "It's nothing to get all in a bunch about."
msgstr "Y a pas de quoi en faire tout un fromage."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-0/0
msgctxt "Curt"
msgid "Don't let him downplay it. Fool was head over heels."
msgstr "Le laisse pas minimiser. Le mec était fou amoureux."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-0/8
msgctxt "Cabrizzio"
msgid "Ah, si, I remember this... your heels were very much over your head, amico!"
msgstr "Ah, si, je m'en souviens... tes talons étaient bien par-dessus ta tête, amico !"

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-0/16
msgctxt "Rod"
msgid "Shh. Keep it down, yo."
msgstr "Chut. Plus bas, yo."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-0/24
msgctxt "Cabrizzio"
msgid "Nah cosi, but you should be proud! Shout your passion from the rooftops! We declare our love boldly!"
msgstr "Non così, mais vous devriez être fier ! Criez votre passion sur les toits ! Nous déclarons notre amour avec audace !"

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-0/35
msgctxt "Curt"
msgid "Except for when you fumble the ball as badly as Rod did."
msgstr "Sauf quand tu rates ton coup aussi lamentablement que Rod."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-0/43
msgctxt "Rod"
msgid "I didn't fumble anything."
msgstr "J'ai rien raté du tout."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-0/51
msgctxt "Curt"
msgid "Cabrizzio, do you remember Rod's line to her?"
msgstr "Cabrizzio, tu te souviens de la réplique de Rod à son intention ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-0/59
msgctxt "Cabrizzio"
msgid "Ah, naturally... even if we fail we should be proud... and you failed quite wonderfully, amico."
msgstr "Ah, naturellement... même si on échoue, on doit en être fier... et tu as échoué de façon tout à fait merveilleuse, amico."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-0/67
msgctxt "Rod"
msgid "Alright, settle down."
msgstr "Bon, calmez-vous."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-0/75/s/0
msgctxt "Choix"
msgid "It can't be that bad."
msgstr "Ça peut pas être si terrible."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-0/76/s/0
msgctxt "Choix"
msgid "Rod's so slick! I can't imagine him messing up a pickup line."
msgstr "Rod est si habile ! J'arrive pas à l'imaginer rater une phrase de drague."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/0
msgctxt "Cabrizzio"
msgid "Ah, il tuo ottimismo! It is a joy to see your faith in your friends."
msgstr "Ah, il tuo ottimismo ! C'est une joie de voir ta foi en tes amis."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/8
msgctxt "Curt"
msgid "Dude straight up said -"
msgstr "Le mec a carrément dit :"

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/16
msgctxt "Curt"
msgid "\"I can see our future through you, Wyndolyn! And it looks as clear as can be.\""
msgstr "« Je vois notre avenir à travers toi, Wyndolyn ! Et il est limpide. »"

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/24
msgctxt "Curt"
msgid "HAHAHAHAHA. LAAAAAAME!"
msgstr "HAHAHAHAHA. NUUUUUL !"

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/35
msgctxt "Rod"
msgid "It wasn't that bad."
msgstr "C'était pas si terrible."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/43
msgctxt "Cabrizzio"
msgid "Oh, si. It was bad. Again, nothing to be ashamed of!"
msgstr "Oh, si. C'était terrible. Encore une fois, il n'y a pas de quoi avoir honte !"

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/51
msgctxt "Cabrizzio"
msgid "But... si. Wear your, fumble, is it? With orgoglio!"
msgstr "Mais... si. Porte ta... bourde, c'est bien ça ? Avec orgoglio !"

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/59
msgctxt "Curt"
msgid "See? It was awful, right?"
msgstr "Tu vois ? C'était affreux, non ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/67/s/0
msgctxt "Choix"
msgid "Oh, Rod! That sounds super sweet! I would have loved to hear that."
msgstr "Oh, Rod ! Ça a l'air super mignon ! J'aurais adoré entendre ça."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/68/s/0
msgctxt "Choix"
msgid "They're right. You sounded more like Curt with that one."
msgstr "Ils ont raison. Avec celle-là, tu ressemblais plus à Curt."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/69/s/0
msgctxt "Choix"
msgid "I hope you picked your ego up after that one fell through!"
msgstr "J'espère que tu as ramassé ton ego après que celle-là est tombée à l'eau !"

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/70/s/0
msgctxt "Choix"
msgid "Did she laugh in your face? I would have laughed in your face. You are terrible."
msgstr "Elle t'a ri au nez ? Moi, je t'aurais ri au nez. T'es nul."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/c-4/11
msgctxt "Cabrizzio"
msgid "Amici. It breaks my hinges to hear that this is what you expect from a lover?"
msgstr "Amici. Ça me brise les charnières d'entendre que c'est ce que vous attendez d'un amant ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/c-4/22
msgctxt "Cabrizzio"
msgid "As much as I extoll our dear Rod to have a pride in himself... he is not without room for improvement."
msgstr "Autant j'exhorte notre cher Rod à avoir de la fierté... autant il n'est pas sans marge de progression."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/c-4/30
msgctxt "Cabrizzio"
msgid "And you, mi capolavoro, surely you know you deserve more."
msgstr "Et vous, mi capolavoro, vous savez sûrement que vous méritez mieux."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/c-4/38
msgctxt "Rod"
msgid "I knew you had taste. You know a solid pickup line when you hear it."
msgstr "Je savais que t'avais du goût. Tu reconnais une bonne phrase de drague quand tu en entends une."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/c-4/46
msgctxt "Curt"
msgid "It was a bad line. Categorically."
msgstr "C'était une mauvaise phrase. Catégoriquement."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/c-4/54
msgctxt "Rod"
msgid "You both just don't know skill when you see it."
msgstr "Vous deux, vous reconnaissez pas le talent quand vous le voyez."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/c-5/16
msgctxt "Rod"
msgid "Oh! Coming through with the classic backhanded compliment!"
msgstr "Oh ! Tu nous sors le classique compliment empoisonné !"

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/c-5/24
msgctxt "Curt"
msgid "That's two birds with one stone."
msgstr "Ça, c'est deux coups d'un seul pierre."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/c-5/32
msgctxt "Cabrizzio"
msgid "Ah, and a mischievous wit! Bene, quanto eccellente!"
msgstr "Ah, et un esprit malicieux ! Bene, quanto eccellente !"

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/c-5/40/b/1
msgctxt "Curt"
msgid "This is just proof that they haven't seen me in action enough."
msgstr "Ça prouve juste qu'ils m'ont pas assez vu en action."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/c-5/41/b/1
msgctxt "Curt"
msgid "This is just proof that she hasn't seen me in action enough."
msgstr "Ça prouve juste qu'elle m'a pas assez vu en action."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/c-5/42/b/1
msgctxt "Curt"
msgid "This is just proof that he hasn't seen me in action enough."
msgstr "Ça prouve juste qu'il m'a pas assez vu en action."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/c-5/45
msgctxt "Rod"
msgid "Or that they've seen all they need to."
msgstr "Ou qu'ils ont vu tout ce qu'il y avait à voir."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/c-5/53
msgctxt "Rod"
msgid "Give me another example."
msgstr "Donne-moi un autre exemple."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/c-5/61
msgctxt "Cabrizzio"
msgid "Outside of your mishap with Wyndolyn... I'm not sure I can."
msgstr "En dehors de ta mésaventure avec Wyndolyn... je ne suis pas sûr de pouvoir."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/c-5/69
msgctxt "Rod"
msgid "See?"
msgstr "Tu vois ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/c-6/16
msgctxt "Rod"
msgid "It wasn't even that serious. It became apparent that Wyndolyn and I were better off as friends."
msgstr "C'était même pas si sérieux. Il est devenu évident que Wyndolyn et moi, on était mieux en amis."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/c-6/24
msgctxt "Curt"
msgid "You got rejected. That's what happened, bro."
msgstr "Tu t'es fait rejeter. Voilà ce qui s'est passé, frérot."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/c-7/13
msgctxt "Cabrizzio"
msgid "Amici. We are being far too harsh. To confess your true feelings to another..."
msgstr "Amici. Nous sommes bien trop durs. Avouer ses vrais sentiments à quelqu'un..."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/c-7/21
msgctxt "Cabrizzio"
msgid "...it is an act of great courage. We all stumble when we set out to scale mountains of the heart!"
msgstr "... c'est un acte de grand courage. Nous trébuchons tous quand nous partons escalader les montagnes du cœur !"

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/c-7/29
msgctxt "Curt"
msgid "Yeah, I'm sure Rod was just nervous. I've seen him come up with better lines before."
msgstr "Ouais, je suis sûr que Rod était juste nerveux. Je l'ai déjà vu sortir de meilleures phrases."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/c-7/37
msgctxt "Rod"
msgid "Thank you!"
msgstr "Merci !"

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/c-7/45
msgctxt "Curt"
msgid "None of them were as memorable as this big 'ol mess up. But, he's done it before!"
msgstr "Aucune aussi mémorable que ce gros ratage. Mais il l'a déjà fait !"

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/c-7/53
msgctxt "Cabrizzio"
msgid "Veramente? Che emozione! I have never heard one of these \"better lines\"!"
msgstr "Veramente ? Che emozione ! Je n'ai jamais entendu une de ces « meilleures phrases » !"

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-1/c-7/61
msgctxt "Cabrizzio"
msgid "Please, Rod, do share one with us!"
msgstr "S'il te plaît, Rod, partage-en une avec nous !"

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-2/0
msgctxt "Rod"
msgid "I think it's funny how y'all both have to dig into the past to make fun of me. When Curt does ridiculous stuff on the daily."
msgstr "C'est marrant que vous deux, vous deviez fouiller dans le passé pour vous moquer de moi. Alors que Curt fait des trucs ridicules tous les jours."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-2/8
msgctxt "Curt"
msgid "Nice try, buddy."
msgstr "Joli essai, mon pote."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-2/16
msgctxt "Cabrizzio"
msgid "Ahh yes, an excellent point being made! Curt, you too, are very silly. \"Un piccolo sciocco,\" as mi Momma used to say!"
msgstr "Ahh oui, excellente remarque ! Curt, toi aussi, tu es très bête. « Un piccolo sciocco », comme disait mi Momma !"

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-2/24
msgctxt "Curt"
msgid "How did this get turned around on me?"
msgstr "Comment ça s'est retourné contre moi ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-2/35
msgctxt "Rod"
msgid "I can't help it if Cabrizzio agrees with me."
msgstr "C'est pas ma faute si Cabrizzio est d'accord avec moi."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-2/43
msgctxt "Cabrizzio"
msgid "You are both piccoli sciocci. Perhaps it is why you are such fast friends!"
msgstr "Vous êtes tous les deux des piccoli sciocci. C'est peut-être pour ça que vous êtes si vite devenus amis !"

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-2/51
msgctxt "Curt"
msgid "Ha! See! Both of us!"
msgstr "Ha ! Tu vois ! Tous les deux !"

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-2/59
msgctxt "Cabrizzio"
msgid "Perhaps one day, working together, you two may approach the romantic prowess that I possess."
msgstr "Peut-être qu'un jour, en travaillant ensemble, vous approcherez de la prouesse romantique que je possède."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-2/67
msgctxt "Rod"
msgid "You've got swagger?"
msgstr "Tu as de la classe ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-2/75
msgctxt "Cabrizzio"
msgid "You might say it is ingrained in me."
msgstr "On pourrait dire que c'est dans mon grain."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-2/86
msgctxt "Curt"
msgid "Oooo... I need to learn from you."
msgstr "Oooo... faut que j'apprenne de toi."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-2/94
msgctxt "Rod"
msgid "Yeah, that confidence was pretty boss."
msgstr "Ouais, cette confiance était plutôt géniale."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-2/102
msgctxt "Cabrizzio"
msgid "I am, amazingly when taken in the light of all my other gifts, also a generous teacher."
msgstr "Je suis, de façon étonnante au regard de tous mes autres dons, également un généreux professeur."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-2/110
msgctxt "Cabrizzio"
msgid "Come to me should you ever wish to practice the nuanced alchemy of passion!"
msgstr "Venez me voir si jamais vous voulez pratiquer la subtile alchimie de la passion !"

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-2/118
msgctxt "Curt"
msgid "Let's do this!"
msgstr "Allons-y !"

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-2/126
msgctxt "Rod"
msgid "We'll catch up to you later, human. I don't want to miss anything Cabrizzio has to say."
msgstr "On te rejoint plus tard. Je veux pas rater un mot de ce que Cabrizzio a à dire."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-2/134/s/0
msgctxt "Choix"
msgid "Okay... have fun!"
msgstr "Ok... amusez-vous bien !"

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-2/c-8/7
msgctxt "Cabrizzio"
msgid "Lezione uno. You two are quick and dexterous with the \"shade,\" as you say. But in romance, we must master..."
msgstr "Lezione uno. Vous êtes vifs et habiles avec le « chambrage », comme vous dites. Mais en amour, il faut maîtriser..."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-2/c-8/15
msgctxt "Cabrizzio"
msgid "...the Compliment."
msgstr "... le Compliment."

# Traduction IA – à relire
#: curtrod_curtain/shade_kitchen/0/g-2/c-8/23
msgctxt "Curt"
msgid "Ooo, this is the good stuff...."
msgstr "Ooo, c'est du bon..."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/46
msgctxt "Rod"
msgid "So... we couldn't help but notice you on your computer."
msgstr "Alors... on n'a pas pu s'empêcher de te remarquer sur ton ordinateur."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/54
msgctxt "Curt"
msgid "I mean, we weren't snoopin' or nothin'."
msgstr "Enfin, on fouinait pas ou quoi que ce soit."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/65
msgctxt "Rod"
msgid "Curt was."
msgstr "Curt, si."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/73
msgctxt "Curt"
msgid "Yeah, I was looking pretty hard."
msgstr "Ouais, je regardais pas mal."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/81
msgctxt "Rod"
msgid "But we see you signed up for a dating site... didn't ya?"
msgstr "Mais on a vu que tu t'es inscrit sur un site de rencontres... pas vrai ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/89
msgctxt "Curt"
msgid "You're trying to get some action, huh?"
msgstr "Tu cherches à avoir un peu d'action, hein ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/97/s/0
msgctxt "Choix"
msgid "You were reading my messages?"
msgstr "Vous lisiez mes messages ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/98/s/0
msgctxt "Choix"
msgid "Don't you think that's a little personal?"
msgstr "Vous trouvez pas que c'est un peu personnel ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-0/0
msgctxt "Rod"
msgid "We didn't mean to upset you."
msgstr "On voulait pas te vexer."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-0/8
msgctxt "Curt"
msgid "If anything, we were just concerned about you."
msgstr "Au contraire, on s'inquiétait juste pour toi."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-0/16
msgctxt "Rod"
msgid "Yeah. We know that trying to get someone to like you can be tough."
msgstr "Ouais. On sait que faire en sorte que quelqu'un t'apprécie, ça peut être dur."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-0/24
msgctxt "Curt"
msgid "Especially when you ain't as cool as we are."
msgstr "Surtout quand t'es pas aussi cool que nous."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-0/32
msgctxt "Rod"
msgid "I told you to leave that part out."
msgstr "Je t'avais dit de laisser cette partie de côté."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-0/40
msgctxt "Curt"
msgid "Oh, my bad. You're right."
msgstr "Oh, mon mauvais. Tu as raison."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-0/48
msgctxt "Curt"
msgid "What I meant to say was —"
msgstr "Ce que je voulais dire, c'est que..."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-0/56
msgctxt "Rod"
msgid "He didn't mean to say anything."
msgstr "Il voulait rien dire du tout."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-0/64
msgctxt "Curt"
msgid "No, let me make it up to you!"
msgstr "Non, laisse-moi me rattraper !"

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-0/75/s/0
msgctxt "Choix"
msgid "How are you going to do that?"
msgstr "Comment tu vas faire ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-0/76/s/0
msgctxt "Choix"
msgid "You'll have to do something major after being that rude."
msgstr "Faudra que tu fasses un truc énorme après avoir été aussi grossier."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/0
msgctxt "Curt"
msgid "What if I told you I can give you a surefire phrase to snatch some honey?"
msgstr "Et si je te disais que je peux te donner une phrase infaillible pour décrocher du miel ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/8/b/1
msgctxt "Rod"
msgid "Snatch honey? They aren't a bear, Curt!"
msgstr "Piquer du miel ? Iel est pas un ours, Curt !"

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/9/b/1
msgctxt "Rod"
msgid "Snatch honey? She ain't a bear, Curt!"
msgstr "Piquer du miel ? Elle est pas une ourse, Curt !"

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/10/b/1
msgctxt "Rod"
msgid "Snatch honey? He ain't a bear, Curt!"
msgstr "Piquer du miel ? Il est pas un ours, Curt !"

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/13
msgctxt "Curt"
msgid "Trust me. I'm good at this sorta stuff."
msgstr "Fais-moi confiance. Je me débrouille bien dans ce genre de trucs."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/0/s/0
msgctxt "Choix"
msgid "Not good enough to not be single!"
msgstr "Pas assez pour pas être célibataire !"

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/1/s/0
msgctxt "Choix"
msgid "You know, I'll take you up on that."
msgstr "Tu sais quoi, je te prends au mot."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/2/s/0
msgctxt "Choix"
msgid "You can't even catch a cold, let alone a date! Loser!"
msgstr "Tu pourrais même pas attraper un rhume, encore moins un rencard ! Perdant !"

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/3/s/0
msgctxt "Choix"
msgid "I dunno. You seem a little out of practice to me."
msgstr "Je sais pas. Tu me sembles un peu rouillé."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-4/16
msgctxt "Rod"
msgid "Roasted! Ab-so-lute-ly roasted!"
msgstr "Grillé ! Ab-so-lu-ment grillé !"

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-4/27
msgctxt "Curt"
msgid "You have that fire with you today."
msgstr "T'as le feu sacré aujourd'hui."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-4/35
msgctxt "Rod"
msgid "Call the fire department. The drapes are on fire!"
msgstr "Appelez les pompiers. Les rideaux sont en feu !"

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-4/43 curtrod_curtain/curt_flirt/0/c-1/16
msgctxt "Curt"
msgid "Hahahaha."
msgstr "Hahahaha."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-4/54
msgctxt "Rod"
msgid "See, that's what you get for being so nosey."
msgstr "Tu vois, c'est ce qu'on gagne à être aussi fouineur."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-4/62
msgctxt "Curt"
msgid "You're right. I shouldn't have been all up in yo' business."
msgstr "T'as raison. J'aurais pas dû fourrer mon nez dans tes affaires."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-4/70
msgctxt "Curt"
msgid "I still think I could help you out here."
msgstr "Je pense toujours que je pourrais t'aider là-dessus."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-4/78
msgctxt "Rod"
msgid "How do you do this, man?"
msgstr "Comment tu fais, mec ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-4/86
msgctxt "Curt"
msgid "What?"
msgstr "Quoi ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-4/94
msgctxt "Rod"
msgid "Not catch the hint? I think you dodge it on purpose."
msgstr "Pour pas saisir l'allusion ? Je pense que tu l'esquives exprès."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-5/11
msgctxt "Rod"
msgid "Don't do it! It will only end in disaster."
msgstr "Fais pas ça ! Ça finira en catastrophe."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-5/19
msgctxt "Curt"
msgid "You don't know that. He doesn't know that."
msgstr "Tu peux pas savoir ça. Il ne peut pas savoir ça."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-5/27
msgctxt "Rod"
msgid "I've known you long enough to know a mistake when you're about to make one."
msgstr "Je te connais depuis assez longtemps pour reconnaître une erreur quand tu t'apprêtes à en faire une."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-5/35
msgctxt "Rod"
msgid "And this, my filigreed friend, is a big ol' mistake."
msgstr "Et ça, mon ami filigrané, c'est une sacrée grosse erreur."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-5/43
msgctxt "Curt"
msgid "I promise I can help with this!"
msgstr "Je te promets que je peux aider !"

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-5/51
msgctxt "Rod"
msgid "Okay, say one thing you know about our human here."
msgstr "Ok, dis une seule chose que tu sais sur notre humain ici présent."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-5/59
msgctxt "Curt"
msgid "Well..."
msgstr "Eh bien..."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-5/67
msgctxt "Rod"
msgid "Besides their name."
msgstr "À part son nom."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-5/86
msgctxt "Rod"
msgid "Mmmhmm. That's what I thought."
msgstr "Mmmhmm. C'est ce que je pensais."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-6/16
msgctxt "Curt"
msgid "Hey now! I can too catch a cold."
msgstr "Eh ho ! Je peux très bien attraper un rhume."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-6/24
msgctxt "Curt"
msgid "Wash me and leave me out to air dry? I'll get a chill right down to my stitching."
msgstr "Me laver et me laisser sécher à l'air libre ? J'attrape la crève jusqu'aux coutures."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-6/32
msgctxt "Rod"
msgid "He might not have the word game on lock, but Curt does have a certain swagger."
msgstr "Il maîtrise peut-être pas les mots, mais Curt a une certaine classe."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-6/40
msgctxt "Curt"
msgid "Thank you."
msgstr "Merci."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-6/48
msgctxt "Rod"
msgid "I don't know who it works on, but some people fall for it."
msgstr "Je sais pas sur qui ça marche, mais certains tombent dans le panneau."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-6/56
msgctxt "Curt"
msgid "That was almost nice of you."
msgstr "C'était presque gentil de ta part."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-6/64
msgctxt "Rod"
msgid "Hahaha. Almost!"
msgstr "Hahaha. Presque !"

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-7/16/b/1
msgctxt "Rod"
msgid "They've got a point."
msgstr "Iel n'a pas tort."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-7/17/b/1
msgctxt "Rod"
msgid "She's got a point."
msgstr "Elle n'a pas tort."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-7/18/b/1
msgctxt "Rod"
msgid "He's got a point."
msgstr "Il n'a pas tort."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-7/21
msgctxt "Curt"
msgid "I mean, just because I haven't really tried to talk to anyone in awhile doesn't mean that I don't still have it!"
msgstr "Je veux dire, c'est pas parce que j'ai pas vraiment essayé de parler à quelqu'un depuis un moment que j'ai plus le truc !"

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-7/29
msgctxt "Rod"
msgid "Alright. Come up with a line."
msgstr "Bon. Trouve une phrase."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-7/37
msgctxt "Curt"
msgid "Right now?"
msgstr "Là, maintenant ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-7/48
msgctxt "Rod"
msgid "Right now! For the human. Since you still have it or whatever."
msgstr "Là, maintenant ! Pour l'humain. Puisque t'as toujours le truc ou je sais pas quoi."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-7/56
msgctxt "Curt"
msgid "Okay. How about this."
msgstr "Ok. Que dirais-tu de ça."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-7/64
msgctxt "Curt"
msgid "\"Hey. I really like your sentence structure. Can't wait to see your lips form those words.\""
msgstr "« Hé. J'adore ta construction de phrases. J'ai hâte de voir tes lèvres former ces mots. »"

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-7/91
msgctxt "Rod"
msgid "Never say that again."
msgstr "Ne redis jamais ça."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-7/102
msgctxt "Curt"
msgid "That bad?"
msgstr "C'est si nul ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-1/21/c-7/110
msgctxt "Rod"
msgid "That. Bad."
msgstr "C'est. Nul."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-3/0
msgctxt "Rod"
msgid "ANYWAY! The moral of the story is, we won't read your messages anymore."
msgstr "BREF ! La morale de l'histoire, c'est qu'on lira plus tes messages."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-3/8
msgctxt "Curt"
msgid "But, could you make the text smaller? It's just so easy to read."
msgstr "Mais tu pourrais écrire plus petit ? C'est juste tellement facile à lire."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-3/16
msgctxt "Rod"
msgid "Curt!"
msgstr "Curt !"

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-3/24
msgctxt "Curt"
msgid "It's like trying to ignore a billboard! Sometimes I just can't help it."
msgstr "C'est comme essayer d'ignorer un panneau publicitaire ! Parfois je peux pas m'en empêcher."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-3/32
msgctxt "Rod"
msgid "Ignore him. He puts his tassel in his mouth a few times a day."
msgstr "Ignore-le. Il se met son gland dans la bouche plusieurs fois par jour."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-3/40
msgctxt "Curt"
msgid "You tryin' to say I should stop?"
msgstr "Tu essaies de dire que je devrais arrêter ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-3/48
msgctxt "Rod"
msgid "That's what I've BEEN trying to say!"
msgstr "C'est ce que j'essaie de dire depuis le DÉBUT !"

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-3/56
msgctxt "Curt"
msgid "But I can't help-"
msgstr "Mais je peux pas m'en empêcher..."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-3/64
msgctxt "Rod"
msgid "Shhhh. You're done, buddy."
msgstr "Chhhhut. T'as fini, mon vieux."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-3/72
msgctxt "Curt"
msgid "But - !"
msgstr "Mais... !"

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-3/80
msgctxt "Rod"
msgid "You're done."
msgstr "T'as fini."

# Traduction IA – à relire
#: curtrod_curtain/shade_office/0/g-3/88
msgctxt "Rod"
msgid "We'll see you around. And he'll be better behaved next time."
msgstr "À plus. Et il sera plus sage la prochaine fois."

# Traduction IA – à relire
#: curtrod_curtain/shade_laundry/0/40
msgctxt "Curt"
msgid "I've been wondering when we would see you again."
msgstr "Je me demandais quand on te reverrait."

# Traduction IA – à relire
#: curtrod_curtain/shade_laundry/0/48
msgctxt "Rod"
msgid "Yeah, we were just talkin' about you."
msgstr "Ouais, justement, on parlait de toi."

# Traduction IA – à relire
#: curtrod_curtain/shade_laundry/0/56/s/0
msgctxt "Choix"
msgid "What were you saying?"
msgstr "Vous disiez quoi ?"

# Traduction IA – à relire
#: curtrod_curtain/shade_laundry/0/57/s/0
msgctxt "Choix"
msgid "Me? Nothing bad I hope."
msgstr "De moi ? Rien de mal, j'espère."

# Traduction IA – à relire
#: curtrod_curtain/shade_laundry/0/g-0/0
msgctxt "Rod"
msgid "All good stuff."
msgstr "Que du bon."

# Traduction IA – à relire
#: curtrod_curtain/shade_laundry/0/g-0/20
msgctxt "Wyndolyn"
msgid "They were talking about how good you look."
msgstr "Ils disaient à quel point tu en jettes."

# Traduction IA – à relire
#: curtrod_curtain/shade_laundry/0/g-0/31
msgctxt "Curt"
msgid "What are you doooing?"
msgstr "Qu'est-ce que tu fais ??"

# Traduction IA – à relire
#: curtrod_curtain/shade_laundry/0/g-0/39
msgctxt "Rod"
msgid "You ain't got NO chill!"
msgstr "T'as AUCUN sang-froid !"

#: curtrod_curtain/shade_laundry/0/g-0/47
msgctxt "Wyndolyn"
msgid "I'm just telling the truth!"
msgstr ""

#: curtrod_curtain/shade_laundry/0/g-0/55
msgctxt "Rod"
msgid "But you could be a little more coy about it!"
msgstr ""

#: curtrod_curtain/shade_laundry/0/g-0/63
msgctxt "Wyndolyn"
msgid "Oh hey! Look who's here! Weren't you two just talking about them?"
msgstr ""

#: curtrod_curtain/shade_laundry/0/g-0/71
msgctxt "Rod"
msgid "...yes, Wyndolyn."
msgstr ""

#: curtrod_curtain/shade_laundry/0/g-0/79
msgctxt "Wyndolyn"
msgid "They think you are just the cutiest thing ever. You should have heard what Curt said about you."
msgstr ""

#: curtrod_curtain/shade_laundry/0/g-0/87
msgctxt "Curt"
msgid "Okay, that's enough."
msgstr ""

#: curtrod_curtain/shade_laundry/0/g-0/95
msgctxt "Wyndolyn"
msgid "Look at them both. They look so embarrassed! I haven't seen Rod like this since he tried to hit on me!"
msgstr ""

#: curtrod_curtain/shade_laundry/0/g-0/103
msgctxt "Rod"
msgid "Oooookay! I think we're alll good."
msgstr ""

#: curtrod_curtain/shade_laundry/0/g-0/114
msgctxt "Wyndolyn"
msgid "Oh, wow! So flustered! This is pretty funny if you ask me."
msgstr ""

#: curtrod_curtain/shade_laundry/0/g-0/122
msgctxt "Curt"
msgid "It... it's not funny!"
msgstr ""

#: curtrod_curtain/shade_laundry/0/g-0/133
msgctxt "Rod"
msgid "Yeah. What Curt said."
msgstr ""

#: curtrod_curtain/shade_laundry/0/g-0/141/s/0
msgctxt "Choix"
msgid "I think it is awfully sweet that you two were talking about me."
msgstr ""

#: curtrod_curtain/shade_laundry/0/g-0/142/s/0
msgctxt "Choix"
msgid "Can't tell me you think I'm cute yourselves?"
msgstr ""

#: curtrod_curtain/shade_laundry/0/g-0/143/s/0
msgctxt "Choix"
msgid "You let Wyndolyn speak for you? You are both chumps!"
msgstr ""

#: curtrod_curtain/shade_laundry/0/g-0/144/s/0
msgctxt "Choix"
msgid "It's okay if you can't speak. We all have our own talents."
msgstr ""

#: curtrod_curtain/shade_laundry/0/g-0/c-2/16
msgctxt "Wyndolyn"
msgid "They were going on and on and on."
msgstr ""

#: curtrod_curtain/shade_laundry/0/g-0/c-2/24
msgctxt "Rod"
msgid "I didn't know Wyndolyn was listening that hard."
msgstr ""

#: curtrod_curtain/shade_laundry/0/g-0/c-2/32
msgctxt "Curt"
msgid "I mean, she is right there."
msgstr ""

#: curtrod_curtain/shade_laundry/0/g-0/c-2/40
msgctxt "Rod"
msgid "But still, a little privacy would be nice, man."
msgstr ""

#: curtrod_curtain/shade_laundry/0/g-0/c-2/48
msgctxt "Wyndolyn"
msgid "It would be. But, you won't get it from me."
msgstr ""

#: curtrod_curtain/shade_laundry/0/g-0/c-2/56
msgctxt "Curt"
msgid "Why don't you just act like you never found out we were talking about you."
msgstr ""

#: curtrod_curtain/shade_laundry/0/g-0/c-2/64
msgctxt "Wyndolyn"
msgid "Oh, can't unring that bell! That kinda thing sticks with ya."
msgstr ""

#: curtrod_curtain/shade_laundry/0/g-0/c-2/72
msgctxt "Curt"
msgid "This is a nightmare."
msgstr ""

#: curtrod_curtain/shade_laundry/0/g-0/c-3/16
msgctxt "Rod"
msgid "I mean, we could —"
msgstr ""

#: curtrod_curtain/shade_laundry/0/g-0/c-3/24
msgctxt "Curt"
msgid "But, you know, we were just talking about it between us."
msgstr ""

#: curtrod_curtain/shade_laundry/0/g-0/c-3/32
msgctxt "Rod"
msgid "We didn't know Wyndolyn was listening."
msgstr ""

#: curtrod_curtain/shade_laundry/0/g-0/c-3/40
msgctxt "Curt"
