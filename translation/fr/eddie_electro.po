#: eddie_electro/johnny_coda/0/6
msgctxt "Johnny"
msgid "My love - my sweet-smelling darling!"
msgstr ""

#: eddie_electro/johnny_coda/0/14
msgctxt "Johnny"
msgid "I think my singing days might be behind me..."
msgstr ""

#: eddie_electro/johnny_coda/0/22
msgctxt "Johnny"
msgid "What do you think?"
msgstr ""

#: eddie_electro/johnny_coda/0/30/s/0
