# Traduction IA – à relire
#: vaughn_mousetrap/1
msgctxt "Tag Nom d'objet (MAJUSCULES)"
msgid "RAT TRAP"
msgstr "PIÈGE À RATS"

# Traduction IA – à relire
#: vaughn_mousetrap/skylar_vaughn_content/0/3
msgctxt "Skylar"
msgid "Woah there! My Content Aware has given me a tickle!"
msgstr "Oh là ! Mon Alerte Contenu vient de me chatouiller !"

# Traduction IA – à relire
#: vaughn_mousetrap/skylar_vaughn_content/0/11
msgctxt "Skylar"
msgid "Vaughn is a rat trap. There's gonna be some content here about animal death."
msgstr "Vaughn est un piège à rats. Il va y avoir du contenu sur la mort d'animaux."

# Traduction IA – à relire
#: vaughn_mousetrap/skylar_vaughn_content/0/19
msgctxt "Skylar"
msgid "If that's something you don't want to hear or joke about, I'd recommend skipping."
msgstr "Si vous n'avez pas envie d'en entendre parler ni d'en rire, je vous conseille de passer."

# Traduction IA – à relire
#: vaughn_mousetrap/skylar_vaughn_content/0/27
msgctxt "Skylar"
msgid "You cool with that? Or you want to skip it?"
msgstr "Ça vous va ? Ou vous préférez passer ?"

# Traduction IA – à relire
#: vaughn_mousetrap/skylar_vaughn_content/0/35/s/0
msgctxt "Choix"
msgid "Let's skip this please!"
msgstr "Passons, s'il te plaît !"

# Traduction IA – à relire
#: vaughn_mousetrap/skylar_vaughn_content/0/36/s/0
msgctxt "Choix"
msgid "No, I'm okay with this type of stuff."
msgstr "Non, ce genre de truc ne me dérange pas."

# Traduction IA – à relire
#: vaughn_mousetrap/skylar_vaughn_content/0/c-0/26
msgctxt "Skylar"
msgid "No worries - hey, Vaughn!"
msgstr "Pas de souci. Hé, Vaughn !"

# Traduction IA – à relire
#: vaughn_mousetrap/skylar_vaughn_content/0/c-0/37
msgctxt "Narrator"
msgid "How would you like your relationship with Vaughn Trapp to resolve?"
msgstr "Comment souhaitez-vous que votre relation avec Vaughn Trapp se termine ?"

# Traduction IA – à relire
#: vaughn_mousetrap/skylar_vaughn_content/0/c-0/42/0/s/0
msgctxt "Choix"
msgid "Love!"
msgstr "L'amour !"

# Traduction IA – à relire
#: vaughn_mousetrap/skylar_vaughn_content/0/c-0/42/1/s/0
msgctxt "Choix"
msgid "Friendship!"
msgstr "L'amitié !"

# Traduction IA – à relire
#: vaughn_mousetrap/skylar_vaughn_content/0/c-0/42/2/s/0
msgctxt "Choix"
msgid "Hate!"
msgstr "La haine !"

# Traduction IA – à relire
#: vaughn_mousetrap/skylar_vaughn_content/0/c-0/42/c-0/7
msgctxt "Narrator"
msgid "This harmless little scamp has crawled his way into your heart! You and Vaughn are lovers!"
msgstr "Ce petit chenapan inoffensif s'est faufilé jusque dans votre cœur ! Vous et Vaughn êtes amants !"

# Traduction IA – à relire
#: vaughn_mousetrap/skylar_vaughn_content/0/c-0/42/c-0/15
msgctxt "Skylar"
msgid "It's love!"
msgstr "C'est l'amour !"

# Traduction IA – à relire
#: vaughn_mousetrap/skylar_vaughn_content/0/c-0/42/c-0/47 vaughn_mousetrap/skylar_vaughn_content/0/c-0/42/c-1/50 vaughn_mousetrap/skylar_vaughn_content/0/c-0/42/c-2/44
msgctxt "Skylar"
msgid "See you out there on the next one!"
msgstr "On se retrouve au prochain !"

# Traduction IA – à relire
#: vaughn_mousetrap/skylar_vaughn_content/0/c-0/42/c-1/7
msgctxt "Narrator"
msgid "Vaughn looks into your eyes with what could only be described as a manic friendship."
msgstr "Vaughn vous regarde droit dans les yeux avec ce qu'on ne peut décrire que comme une amitié maniaque."

# Traduction IA – à relire
#: vaughn_mousetrap/skylar_vaughn_content/0/c-0/42/c-1/15
msgctxt "Skylar"
msgid "Aww... friends forever."
msgstr "Aww... amis pour la vie."

# Traduction IA – à relire
#: vaughn_mousetrap/skylar_vaughn_content/0/c-0/42/c-2/7
msgctxt "Narrator"
msgid "Vaughn scowls and proclaims you sworn enemies, further solidifying his belief that he was meant to be put away in the crawlspace, away from everyone else."
msgstr "Vaughn fronce les sourcils et vous proclame ennemis jurés, ce qui renforce sa conviction qu'il était fait pour être rangé dans le vide sanitaire, loin de tout le monde."

# Traduction IA – à relire
#: vaughn_mousetrap/skylar_vaughn_content/0/c-0/42/c-2/15
msgctxt "Skylar"
msgid "Enjoy your... hateship."
msgstr "Profitez bien de votre... haimitié."

# Traduction IA – à relire
#: vaughn_mousetrap/skylar_vaughn_content/0/c-0/42/c-2/77 vaughn_mousetrap/vaughn_hate_path_live/0/g-2/65 vaughn_mousetrap/vaughn_hate_path_plush/0/g-2/94 vaughn_mousetrap/vaughn_hold_out/0/g-2/72
msgctxt "Reggie"
msgid "Edge the trap, wind up <i>snapped</i>."
msgstr "Chatouille le piège, tu finis <i>claqué</i>."

# Traduction IA – à relire
#: vaughn_mousetrap/skylar_vaughn_content/0/c-1/7
msgctxt "Skylar"
msgid "On with the show!"
msgstr "Place au spectacle !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_no_cheese/0
msgctxt "Vaughn Trapp"
msgid "C'mon, Where's the good stuff!"
msgstr "Allez, il est où, le bon truc !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_no_cheese/8
msgctxt "Vaughn Trapp"
msgid "I needs the cheese!"
msgstr "Y me faut du fromage !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_impatient_return/0
msgctxt "Vaughn Trapp"
msgid "I already TOLD YOU!!"
msgstr "J'te l'ai DÉJÀ DIT !!"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_impatient_return/8
msgctxt "Vaughn Trapp"
msgid "I'm not openin' up without some cheddar."
msgstr "J'm'ouvre pas sans un peu de cheddar."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_impatient_return/16
msgctxt "Vaughn Trapp"
msgid "Now get outta here! GGGRRRRR!!!"
msgstr "Maint'nant, dégage ! GGGRRRRR !!!"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_no_rats/0
msgctxt "Vaughn Trapp"
msgid "Don't bother me I got rats to snap."
msgstr "M'embête pas, j'ai des rats à claquer."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_no_rats/8
msgctxt "Vaughn Trapp"
msgid "Little CREEPS!! Wish it wasn't a one shot deal."
msgstr "Petites CRAPULES !! Dommage qu'on n'ait droit qu'à un seul coup."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_no_rats/16
msgctxt "Vaughn Trapp"
msgid "I'd love to just find one that I could snap over and over again. Couldn't you imagine that?"
msgstr "J'adorerais en trouver un que je pourrais claquer encore et encore. Tu t'imagines un peu ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_no_rats/27
msgctxt "Vaughn Trapp"
msgid "THAT'D TEACH 'EM!"
msgstr "ÇA LEUR APPRENDRAIT !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/6
msgctxt "Narrator"
msgid "An unholy amalgam of rat and trap stands before you. He regards you as you do him, with surprise and disgust. He holds his hands up to his chest in a distinctly rodent-like gesture, his nose twitching at intervals."
msgstr "Un amalgame impie de rat et de piège se dresse devant vous. Il vous observe comme vous l'observez, avec surprise et dégoût. Il tient ses mains contre sa poitrine dans un geste typiquement rongeur, le nez qui frétille par intermittence."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/14
msgctxt "Vaughn Trapp"
msgid "Holy frickin' shit!!"
msgstr "Putain de bordel de merde !!"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/22
msgctxt "Vaughn Trapp"
msgid "What am I lookin' at here?"
msgstr "C'est quoi, ce que j'ai sous les yeux ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/30
msgctxt "Vaughn Trapp"
msgid "A new face in the crawlspace?!"
msgstr "Une nouvelle tête dans le vide sanitaire ?!"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/38
msgctxt "Vaughn Trapp"
msgid "Are you real or what?"
msgstr "T'es réel ou quoi ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/46/s/0
msgctxt "Choix"
msgid "Real? Yeah, I mean... Yeah? Yes."
msgstr "Réel ? Ouais, enfin... Ouais ? Oui."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/47/s/0
msgctxt "Choix"
msgid "Can any of us say for sure?"
msgstr "Qui peut en être sûr ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/c-0/7
msgctxt "Vaughn Trapp"
msgid "What's wrong wit you?"
msgstr "T'as quoi, toi ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/c-1/7
msgctxt "Vaughn Trapp"
msgid "Oh we got a real thinker over here!"
msgstr "Oh, on a un vrai penseur, ici !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/c-1/15
msgctxt "Vaughn Trapp"
msgid "I'm real, you're real, shut the fuck up already! Waddaya want?"
msgstr "Je suis réel, t'es réel, ferme ta gueule une bonne fois ! Tu veux quoi ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/g-0/0/s/0
msgctxt "Choix"
msgid "I'm looking for love in all the wrong crawlspaces."
msgstr "Je cherche l'amour dans tous les mauvais vides sanitaires."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/g-0/1/s/0
msgctxt "Choix"
msgid "Nothing!"
msgstr "Rien !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/g-0/2/s/0
msgctxt "Choix"
msgid "Just dicking around."
msgstr "Je glande, c'est tout."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/g-0/c-2/7
msgctxt "Vaughn Trapp"
msgid "You ain't gonna find it here."
msgstr "Tu le trouveras pas ici."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/g-0/c-3/7
msgctxt "Vaughn Trapp"
msgid "You sure about that?"
msgstr "T'es sûr de ça ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/g-0/c-4/7
msgctxt "Vaughn Trapp"
msgid "You don't say!"
msgstr "Sans blague !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/g-1/0
msgctxt "Vaughn Trapp"
msgid "Hello, I'm Vaughn, I'm your rat trap!"
msgstr "Salut, moi c'est Vaughn, je suis ton piège à rats !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/g-1/8
msgctxt "Vaughn Trapp"
msgid "Bring in your little card, you'll see!"
msgstr "Amène ta p'tite carte, tu verras !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/g-1/19
msgctxt "Vaughn Trapp"
msgid "Yeah, right there!"
msgstr "Ouais, juste là !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/g-1/27/s/0
msgctxt "Choix"
msgid "Stop yelling at me!!"
msgstr "Arrête de me crier dessus !!"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/g-1/28/s/0
msgctxt "Choix"
msgid "How long have you been down here?"
msgstr "Ça fait combien de temps que t'es là-dessous ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/g-1/c-5/7
msgctxt "Vaughn Trapp"
msgid "Sorry pal I've been down here a long time, okay!?"
msgstr "Désolé {{mon pote|ma pote|mon pote}}, ça fait un bail que j'suis là, d'accord !?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/g-1/c-6/7
msgctxt "Vaughn Trapp"
msgid "Oh..."
msgstr "Oh..."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/g-1/c-6/15
msgctxt "Vaughn Trapp"
msgid "A long time, pally. A long friggin' time..."
msgstr "Un bail, {{mon pote|ma pote|mon pote}}. Un putain de bail..."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/g-2/6/0
msgctxt "Vaughn Trapp"
msgid "You eyeballing me or something? I can feel your gaze... lingering...."
msgstr "Tu me mates ou quoi ? Je sens ton regard... qui s'attarde...."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/g-2/6/8/s/0
msgctxt "Choix"
msgid "You seem a little... \"off\"."
msgstr "Tu as l'air un peu... « bizarre »."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/g-2/6/9/s/0
msgctxt "Choix"
msgid "I don't remember ever setting a mousetrap."
msgstr "Je ne me souviens pas d'avoir posé un piège à souris."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/g-2/6/10/s/0
msgctxt "Choix"
msgid "I'm so sorry for that. You're a lot to take in!"
msgstr "Désolé pour ça. T'es un sacré morceau à digérer !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/g-2/6/c-7/7
msgctxt "Vaughn Trapp"
msgid "Oh, so you're just the <w>PICTURE OF NORMAL</w> IS THAT IT?!?"
msgstr "Ah, alors toi t'es <w>L'IMAGE DE LA NORMALITÉ</w>, C'EST ÇA ?!?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/g-2/6/c-7/15 vaughn_mousetrap/vaughn_intro/0/g-2/6/c-8/15/c-1/23
msgctxt "Vaughn Trapp"
msgid "Well, fuck you too, buddy!"
msgstr "Ben va te faire voir aussi, {{mon pote|ma pote|mon pote}} !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/g-2/6/c-8/7
msgctxt "Vaughn Trapp"
msgid "<i>Rat</i>trap."
msgstr "Piège à <i>rats</i>."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/g-2/6/c-8/15/0/s/0
msgctxt "Choix"
msgid "I think if I had a rodent issue I'd be more of a no-kill trap kinda person."
msgstr "Je crois que si j'avais un problème de rongeurs, je serais plutôt du genre piège sans mise à mort."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/g-2/6/c-8/15/1/s/0
msgctxt "Choix"
msgid "So, you're like, a murderer, oooor?"
msgstr "Alors t'es genre un meurtrier, ou bien ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/g-2/6/c-8/15/2/s/0
msgctxt "Choix"
msgid "Rat trap, sorry."
msgstr "Piège à rats, pardon."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/g-2/6/c-8/15/c-0/7
msgctxt "Vaughn Trapp"
msgid "Oh, cuz you're just a <i>SAINT</i> are ya?!?! Too good for me?!"
msgstr "Oh, parce que toi t'es un <i>SAINT</i>, c'est ça ?!?! Je suis pas assez bien pour toi ?!"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/g-2/6/c-8/15/c-0/15 vaughn_mousetrap/vaughn_intro/0/g-2/6/c-8/15/c-1/15
msgctxt "Vaughn Trapp"
msgid "A VEGAN VIRTUE-SIGNALER, HUH?!??!"
msgstr "UN VÉGAN QUI FAIT LA LEÇON, HEIN ?!??!"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/g-2/6/c-8/15/c-0/26
msgctxt "Vaughn Trapp"
msgid "I can't help the way I'm made. The way I <i>kill</i>."
msgstr "J'y peux rien, j'suis fait comme ça. J'suis fait pour <i>tuer</i>."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/g-2/6/c-8/15/c-0/34
msgctxt "Vaughn Trapp"
msgid "Get outta here before I nip that nose!"
msgstr "Dégage avant que j'te croque le nez !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/g-2/6/c-8/15/c-0/42
msgctxt "Vaughn Trapp"
msgid "Oh, I just wanna put it right on a cracker and eat it!"
msgstr "Oh, j'ai juste envie de le poser sur un cracker et de le bouffer !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/g-2/6/c-8/15/c-1/7
msgctxt "Vaughn Trapp"
msgid "Oh, cuz you're just a <i>SAINT</i> are ya?!?! You're too good for me?!"
msgstr "Oh, parce que toi t'es un <i>SAINT</i>, c'est ça ?!?! T'es trop bien pour moi ?!"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/g-2/6/c-8/15/c-2/7 vaughn_mousetrap/vaughn_live_rats/0/g-0/c-2/7
msgctxt "Vaughn Trapp"
msgid "Thanks."
msgstr "Merci."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/g-2/6/c-9/7
msgctxt "Vaughn Trapp"
msgid "Ahhhhh, well... dats alright. I guess it isn't really your fault."
msgstr "Ahhhhh, bon... c'est pas grave. J'imagine que c'est pas vraiment ta faute."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_intro/0/g-2/6/c-9/15
msgctxt "Vaughn Trapp"
msgid "I do think of myself as a very well-defined character of a sort, so how do you do...?"
msgstr "Je me considère comme un personnage plutôt bien défini, dans son genre, alors comment ça va...?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/6
msgctxt "Narrator"
msgid "Vaughn stops for a moment, his nose twitching as he sniffs the air. He squints at you, suspicion in his gaze."
msgstr "Vaughn s'arrête un instant, le nez frémissant, et renifle l'air. Il vous dévisage en plissant les yeux, la méfiance au regard."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/14
msgctxt "Vaughn Trapp"
msgid "Hey."
msgstr "Hé."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/22
msgctxt "Vaughn Trapp"
msgid "Buddy, you got cheese on ya?"
msgstr "{{Mon pote|Ma pote|Mon pote}}, t'as du fromage sur toi ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/30/0/s/0
msgctxt "Choix"
msgid "No... Should I?"
msgstr "Non... Je devrais ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/30/1/s/0
msgctxt "Choix"
msgid "What? Why would I have cheese \"on me\"?"
msgstr "Quoi ? Pourquoi j'aurais du fromage « sur moi » ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/30/c-0/7
msgctxt "Vaughn Trapp"
msgid "Shouldn't you? Shouldn't you??"
msgstr "Tu devrais pas ? Tu devrais pas ??"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-1/0
msgctxt "Vaughn Trapp"
msgid "You come into my crawlspace and you got no cheese?"
msgstr "Tu débarques dans mon vide sanitaire et t'as pas de fromage ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-1/8
msgctxt "Vaughn Trapp"
msgid "<i>This friggin' shmuck... </i>"
msgstr "<i>Cette andouille de malheur... </i>"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-1/16
msgctxt "Vaughn Trapp"
msgid "LISTEN UP!"
msgstr "ÉCOUTE-MOI BIEN !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-1/24
msgctxt "Vaughn Trapp"
msgid "You seem like the fancy, outside-of-the-crawlspace, sort."
msgstr "Tu m'as l'air du genre chic, du genre qui vit en dehors du vide sanitaire."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-1/32
msgctxt "Vaughn Trapp"
msgid "That right?"
msgstr "C'est ça ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-1/40/0/s/0
msgctxt "Choix"
msgid "Uh... Yeah, pretty much."
msgstr "Euh... Ouais, en gros."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-1/40/1/s/0
msgctxt "Choix"
msgid "I don't live down here sooooo..."
msgstr "Je vis pas ici donc bon..."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-1/40/2/s/0
msgctxt "Choix"
msgid "I wouldn't say I'm \"fancy\"."
msgstr "Je dirais pas que je suis « chic »."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-1/40/c-2/7
msgctxt "Vaughn Trapp"
msgid "Yeah, dats what I thought."
msgstr "Ouais, c'est c'que j'pensais."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-1/40/c-3/7
msgctxt "Vaughn Trapp"
msgid "Yeah I woulda noticed you amongst all the detritus 'n such."
msgstr "Ouais, je t'aurais remarqué parmi tous ces détritus et compagnie."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-1/40/c-4/7
msgctxt "Vaughn Trapp"
msgid "Look at the way you talk. You've got no character!"
msgstr "Regarde comment tu parles. T'as aucun caractère !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-3/0
msgctxt "Vaughn Trapp"
msgid "So I'll let you in on a little somethin'..."
msgstr "Alors j'vais t'apprendre un truc..."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-3/8
msgctxt "Vaughn Trapp"
msgid "You wanna make a good impression?"
msgstr "Tu veux faire bonne impression ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-3/16/s/0
msgctxt "Choix"
msgid "Sure, why not."
msgstr "Oui, pourquoi pas."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-3/17/s/0
msgctxt "Choix"
msgid "Not really."
msgstr "Pas vraiment."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-3/c-5/7
msgctxt "Vaughn Trapp"
msgid "Then ya bring some frickin' <i>CHEESE</i> wit you!"
msgstr "Alors tu ramènes du putain de <i>FROMAGE</i> avec toi !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-3/c-5/15
msgctxt "Vaughn Trapp"
msgid "Dats a life lesson for you too, kid! In a metaphorical sense."
msgstr "C'est une leçon de vie aussi, {{gamin|gamine|gamin·e}} ! Au sens métaphorique."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-3/c-5/23
msgctxt "Vaughn Trapp"
msgid "Though in this particular instance, I mean it very literally."
msgstr "Mais dans le cas présent, je le dis au sens très littéral."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-3/c-6/7
msgctxt "Vaughn Trapp"
msgid "Yep. Seems like it."
msgstr "Ouais. On dirait bien."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-4/0
msgctxt "Vaughn Trapp"
msgid "GIMME DAT CHEESE, BABY!!!"
msgstr "FILE-MOI CE FROMAGE, BÉBÉ !!!"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-4/11
msgctxt "Vaughn Trapp"
msgid "I get some cheese, I start chattin', okay?"
msgstr "J'ai du fromage, je me mets à causer, d'accord ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-4/19
msgctxt "Vaughn Trapp"
msgid "Ya wanna know more, throw me a slice!"
msgstr "Tu veux en savoir plus ? Lance-moi une tranche !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-4/27/s/0
msgctxt "Choix"
msgid "Okay, yeah. I'll be back!"
msgstr "Bon, d'accord. Je reviens !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-4/28/s/0
msgctxt "Choix"
msgid "Cheese. Got it."
msgstr "Du fromage. Compris."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-4/29/s/0
msgctxt "Choix"
msgid "What do you need the cheese for?"
msgstr "Tu as besoin du fromage pour quoi faire ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-4/c-7/7 vaughn_mousetrap/vaughn_cheesefiend/0/g-4/c-8/7 vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/29/c-1/15/c-1/29/g-0/65/g-0/19/c-0/7 vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-13/7
msgctxt "Vaughn Trapp"
msgid "Check the fridge, slowpoke."
msgstr "Regarde dans le frigo, tortue."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-5/0
msgctxt "Vaughn Trapp"
msgid "What do I need cheese for?"
msgstr "J'ai besoin du fromage pour quoi ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-5/11
msgctxt "Narrator"
msgid "He throws his hands up in the air, laughing and gesturing to you for the benefit of some invisible audience."
msgstr "Il lève les mains au ciel en riant et vous désigne du geste, au bénéfice d'un public invisible."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-5/19/b/1
msgctxt "Vaughn Trapp"
msgid "What do I need cheese for, he asks me?!"
msgstr "J'ai besoin du fromage pour quoi, qu'il me demande ?!"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-5/20/b/1
msgctxt "Vaughn Trapp"
msgid "She looks at me and she asks me, what do I need cheese for?"
msgstr "Elle me regarde et elle me demande, j'ai besoin du fromage pour quoi ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-5/21/b/1
msgctxt "Vaughn Trapp"
msgid "What do I need cheese for, they ask me?!"
msgstr "J'ai besoin du fromage pour quoi, qu'iel me demande ?!"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-5/24
msgctxt "Vaughn Trapp"
msgid "NONE OF YOUR FRIGGIN' BUSINESS."
msgstr "ÇA VOUS REGARDE PAS, BORDEL."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-5/35
msgctxt "Vaughn Trapp"
msgid "Alright actually I need the cheese for the rats."
msgstr "Bon, en fait, j'ai besoin du fromage pour les rats."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-5/43
msgctxt "Vaughn Trapp"
msgid "I ain't got no cheese, I ain't got no rats!"
msgstr "Pas de fromage, pas de rats !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-5/51/s/0
msgctxt "Choix"
msgid "There are rats down here?!"
msgstr "Il y a des rats, là-dessous ?!"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-5/52/s/0
msgctxt "Choix"
msgid "Yous gots rats?"
msgstr "Y a d'z'rats, ici ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-5/c-10/7
msgctxt "Vaughn Trapp"
msgid "No."
msgstr "Non."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-5/c-10/15
msgctxt "Vaughn Trapp"
msgid "I ain't never caught a rat... How could I?"
msgstr "J'ai jamais attrapé un rat... Comment je pourrais ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-5/c-10/23
msgctxt "Vaughn Trapp"
msgid "I been sittin' in the dark like a <i>DUNCE</i> for longer than I can remember!!"
msgstr "J'suis assis dans le noir comme un <i>CRÉTIN</i> depuis plus longtemps que je m'en souviens !!"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-5/c-10/31
msgctxt "Vaughn Trapp"
msgid "My <i>darlin'</i> friggin' original benefactor stuffed me down here wit no bait."
msgstr "Mon <i>adorable</i> putain de premier bienfaiteur m'a fourré là-dessous sans appât."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-5/c-10/39
msgctxt "Vaughn Trapp"
msgid "No cheddar."
msgstr "Pas de cheddar."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-5/c-10/47
msgctxt "Vaughn Trapp"
msgid "NO CHEESE!!!"
msgstr "PAS DE FROMAGE !!!"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-5/c-10/58
msgctxt "Vaughn Trapp"
msgid "Bupkis! A big block a bupkis!"
msgstr "Que dalle ! Un gros bloc de que dalle !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-5/c-11/7
msgctxt "Vaughn Trapp"
msgid "Sorry what was that?"
msgstr "Pardon, c'était quoi ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-5/c-11/15/0/s/0
msgctxt "Choix"
msgid "Yous gots rats."
msgstr "Y a d'z'rats, ici."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-5/c-11/15/c-0/7
msgctxt "Vaughn Trapp"
msgid "I can't understand a word you are saying. You gotta be from the Bronx or something."
msgstr "J'comprends pas un mot de c'que tu dis. T'es du Bronx ou quoi."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-5/c-11/15/c-0/15
msgctxt "Vaughn Trapp"
msgid "I was constructed in Brooklyn so dat kinda accent trips me up."
msgstr "J'ai été fabriqué à Brooklyn, alors cet accent-là, ça me perd."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-5/c-11/15/c-0/23/0/s/0
msgctxt "Choix"
msgid "Sorry, thought it would be fun."
msgstr "Désolé, je pensais que ce serait marrant."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-5/c-11/15/c-0/23/c-0/7
msgctxt "Vaughn Trapp"
msgid "Yeah, fun. Fun like a rusty spring."
msgstr "Ouais, marrant. Marrant comme un ressort rouillé."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-5/c-11/15/c-0/23/c-0/15
msgctxt "Vaughn Trapp"
msgid "Like stepping on a tack. Yeah that's fun."
msgstr "Comme de marcher sur une punaise. Ouais, c'est marrant."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/0/s/0
msgctxt "Choix"
msgid "So you need the cheese as bait, or what?"
msgstr "Donc t'as besoin du fromage comme appât, c'est ça ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/1/s/0
msgctxt "Choix"
msgid "I think I got it. I'll be right back."
msgstr "Je crois que j'ai compris. Je reviens tout de suite."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/7
msgctxt "Vaughn Trapp"
msgid "Ringa-ding-ding, ya ding-a-ling! Yeah!"
msgstr "Ringa-ding-ding, mon p'tit dingo ! Ouais !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/21
msgctxt "Vaughn Trapp"
msgid "You bring me some cheese, I snap up a juicy fat rat, and I can finally die in peace."
msgstr "Tu m'ramènes du fromage, je claque un gros rat bien juteux, et je peux enfin mourir en paix."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/29/0/s/0
msgctxt "Choix"
msgid "Die?!"
msgstr "Mourir ?!"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/29/1/s/0
msgctxt "Choix"
msgid "I'm not getting you cheese."
msgstr "Je ne t'apporte pas de fromage."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/29/c-0/7
msgctxt "Vaughn Trapp"
msgid "I'm being overdramatic!"
msgstr "J'exagère !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/29/c-0/15
msgctxt "Vaughn Trapp"
msgid "I'm not gonna <i>immediately</i> die when I fulfill my purpose, but I <i>can</i> someday instead of being stuck in this pointless purgatory!"
msgstr "J'vais pas mourir <i>tout de suite</i> quand j'aurai rempli ma mission, mais je <i>pourrais</i> un jour, au lieu de rester coincé dans ce purgatoire sans intérêt !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/29/c-0/23
msgctxt "Vaughn Trapp"
msgid "Alright I got no clue what happens after I snap dat rat. I think I used to know..."
msgstr "Bon, j'ai aucune idée de ce qui se passe après que j'ai claqué ce rat. Je crois que je le savais..."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/29/c-0/31
msgctxt "Vaughn Trapp"
msgid "But I been down here so frickin' long..."
msgstr "Mais j'suis là depuis tellement longtemps..."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/29/c-0/39
msgctxt "Vaughn Trapp"
msgid "In the dark... no lights!"
msgstr "Dans le noir... pas de lumière !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/29/c-0/47
msgctxt "Vaughn Trapp"
msgid "Just me and Bodhi's muffled voice singin' da greatest hits of yesteryear. In the friggin' daaaaaark..."
msgstr "Juste moi et la voix étouffée de Bodhi qui chante les plus grands tubes d'antan. Dans le putain de nooooir..."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/29/c-0/58
msgctxt "Vaughn Trapp"
msgid "The daaaaaarrrrrkk..."
msgstr "Le nooooiiiirrr..."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/29/c-0/66/0/s/0
msgctxt "Choix"
msgid "Right... Well, I'm gonna take off."
msgstr "Bon... Moi, je vais y aller."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/29/c-0/66/1/s/0
msgctxt "Choix"
msgid "Seems like it's time to go."
msgstr "On dirait qu'il est temps de partir."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/29/c-0/66/g-0/0
msgctxt "Vaughn Trapp"
msgid "The daaaaaaaaaaaaaaaaaaarrrrrkk..."
msgstr "Le nooooooooooooooooooooiiiirrr..."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/29/c-1/7
msgctxt "Vaughn Trapp"
msgid "What? Why? Who chooses that?"
msgstr "Quoi ? Pourquoi ? Qui choisit ça ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/29/c-1/15/0/s/0
msgctxt "Choix"
msgid "I'm kind of a jerk."
msgstr "Je ne suis pas super sympa."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/29/c-1/15/1/s/0
msgctxt "Choix"
msgid "I'm vegan."
msgstr "Je suis végane."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/29/c-1/15/c-0/7
msgctxt "Vaughn Trapp"
msgid "Well, so am I, hotshot!"
msgstr "Ben moi aussi, vedette !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/29/c-1/15/c-0/15
msgctxt "Vaughn Trapp"
msgid "Let's see if you can out-jerk the jerk!"
msgstr "On va voir si tu peux être plus con que le con !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/29/c-1/15/c-0/23
msgctxt "Vaughn Trapp"
msgid "Why don't you get your own personality and then bring me dat <w>cheese</w>..."
msgstr "Tu devrais te trouver ta propre personnalité et ensuite m'apporter ce <w>fromage</w>..."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/29/c-1/15/c-1/13
msgctxt "Vaughn Trapp"
msgid "I guess you're not gonna like the fact that I <i>SNAP RATS</i> will ya?! You're not gonna eat it."
msgstr "Je parie que tu vas pas aimer que je <i>CLAQUE DES RATS</i>, hein ?! Tu vas pas en manger."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/29/c-1/15/c-1/21
msgctxt "Vaughn Trapp"
msgid "Ah I'm kidding!!! Why don't ya bring me some of dat cashew cheese then?"
msgstr "Ah, je rigole !!! Pourquoi tu m'apporterais pas du fromage de cajou, alors ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/29/c-1/15/c-1/29/0/s/0
msgctxt "Choix"
msgid "You're gonna do a murder, aren't you?"
msgstr "Tu vas commettre un meurtre, n'est-ce pas ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/29/c-1/15/c-1/29/1/s/0
msgctxt "Choix"
msgid "Are you still gonna use it to kill rats?"
msgstr "Tu vas quand même t'en servir pour tuer des rats ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/29/c-1/15/c-1/29/g-0/0
msgctxt "Vaughn Trapp"
msgid "Yes."
msgstr "Oui."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/29/c-1/15/c-1/29/g-0/8
msgctxt "Vaughn Trapp"
msgid "NO!!"
msgstr "NON !!"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/29/c-1/15/c-1/29/g-0/16
msgctxt "Vaughn Trapp"
msgid "AAAAAAAAHHHH!!"
msgstr "AAAAAAAAHHHH !!"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/29/c-1/15/c-1/29/g-0/27
msgctxt "Vaughn Trapp"
msgid "DO YOU KNOW HOW MANY GOPHERS, MICE, VOLES AND REPTILES THEY TILL UP TO PLANT YOUR SOY AND BABY CARROTS!?!? THERE IS NO GUILT FREE FOOD, YOU FOOL!!"
msgstr "TU SAIS COMBIEN DE TAUPES, DE SOURIS, DE CAMPAGNOLS ET DE REPTILES ILS LABOURENT POUR PLANTER TON SOJA ET TES PETITES CAROTTES !?!? Y A PAS DE NOURRITURE SANS CULPABILITÉ, ESPÈCE D'ANDOUILLE !!"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/29/c-1/15/c-1/29/g-0/38
msgctxt "Vaughn Trapp"
msgid "RATS ARE A PLAGUE!! LIFE CONSUMES LIIIIIIIFE!!!!!"
msgstr "LES RATS SONT UN FLÉAU !! LA VIE DÉVORE LA VIIIIIIIE !!!!!"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/29/c-1/15/c-1/29/g-0/49
msgctxt "Narrator"
msgid "Vaughn takes a breath, drawing his hand over his face. He stands up straighter, making himself look only slightly unhinged."
msgstr "Vaughn inspire un grand coup en se passant la main sur le visage. Il se redresse, s'arrangeant pour avoir l'air à peine déséquilibré."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/29/c-1/15/c-1/29/g-0/57
msgctxt "Vaughn Trapp"
msgid "All right, I'm sorry, I got a little worked up. I promise, just bring me some vegan cheese and I'll make it work."
msgstr "Bon, pardon, je me suis un peu emballé. Je te le promets, apporte-moi du fromage végétal et je me débrouillerai."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/29/c-1/15/c-1/29/g-0/65/0/s/0
msgctxt "Choix"
msgid "I don't believe you."
msgstr "Je ne te crois pas."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/29/c-1/15/c-1/29/g-0/65/1/s/0
msgctxt "Choix"
msgid "Really?"
msgstr "Vraiment ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/29/c-1/15/c-1/29/g-0/65/g-0/0
msgctxt "Vaughn Trapp"
msgid "I will <i>humanely</i> snap them to death. Pretty please?"
msgstr "Je les claquerai à mort de manière <i>humaine</i>. S'il te plaît ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/29/c-1/15/c-1/29/g-0/65/g-0/8
msgctxt "Narrator"
msgid "He bats his eyelashes at you."
msgstr "Il bat des cils à votre intention."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_cheesefiend/0/g-6/c-12/29/c-1/15/c-1/29/g-0/65/g-0/19/0/s/0
msgctxt "Choix"
msgid "Fine."
msgstr "Bon, d'accord."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/16
msgctxt "Narrator"
msgid "Vaughn sniffs once, twice, three times, each sniff bigger than the last. His nostrils flare cartoonishly."
msgstr "Vaughn renifle une fois, deux fois, trois fois, chaque reniflement plus grand que le précédent. Ses narines se dilatent de façon caricaturale."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/24
msgctxt "Vaughn Trapp"
msgid "What is this my nostrils detect?"
msgstr "Qu'est-ce que mes narines détectent là ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/35
msgctxt "Vaughn Trapp"
msgid "Oh, ho, ho, ho, YOU BROUGHT IT!!!"
msgstr "Oh, ho, ho, ho, TU L'AS APPORTÉ !!!"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/49/b/1
msgctxt "Vaughn Trapp"
msgid "You brought the <i>CHEDDAR</i>, baby!!!"
msgstr "Tu as apporté le <i>CHEDDAR</i>, bébé !!!"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/50/b/1
msgctxt "Vaughn Trapp"
msgid "You brought the <i>CASHEW CHEDDAR</i>, baby!!!"
msgstr "Tu as apporté le <i>CHEDDAR DE CAJOU</i>, bébé !!!"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/53/s/0
msgctxt "Choix"
msgid "Yeah, here you go."
msgstr "Ouais, tiens."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/54/s/0
msgctxt "Choix"
msgid "Is it Gouda-nough?"
msgstr "Alors, t'es Comté-nt ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/c-1/7
msgctxt "Vaughn Trapp"
msgid "I'm gonna PRETEND you didn't just try that."
msgstr "Je vais FAIRE COMME SI t'avais pas tenté ça."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/c-1/15
msgctxt "Vaughn Trapp"
msgid "Ech. Really? Puns? We're doin' this?"
msgstr "Pfff. Sérieux ? Des jeux de mots ? On en est là ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-0/0
msgctxt "Narrator"
msgid "Vaughn takes the cheese from you, bringing it in close and inhaling its scent in a manner so obscene, you're forced to look away."
msgstr "Vaughn vous prend le fromage, l'approche tout près et en hume l'odeur d'une façon si obscène que vous devez détourner les yeux."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-0/11
msgctxt "Vaughn Trapp"
msgid "Oh, yeah... oh yeah!"
msgstr "Oh, ouais... oh ouais !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-0/22
msgctxt "Vaughn Trapp"
msgid "This is the good stuff, I can tell!"
msgstr "C'est du bon, ça se sent !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-0/30
msgctxt "Vaughn Trapp"
msgid "Haha! Oh I'm gonna be <w>covered</w> in rats in <w>no time</w>!"
msgstr "Haha ! Oh, je vais être <w>couvert</w> de rats en <w>un rien de temps</w> !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-0/41/s/0
msgctxt "Choix"
msgid "Jesus..."
msgstr "Jésus..."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-0/42/s/0
msgctxt "Choix"
msgid "Are you okay? You seem even louder than normal."
msgstr "Ça va ? Tu as l'air encore plus bruyant que d'habitude."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-0/c-2/7
msgctxt "Vaughn Trapp"
msgid "I only worship <i>Cheesus</i>."
msgstr "Je ne vénère que <i>Fromagesus</i>."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-0/c-2/15
msgctxt "Vaughn Trapp"
msgid "And even <i>he</i> can't save them rodents now!!"
msgstr "Et même <i>lui</i> peut plus sauver ces rongeurs maint'nant !!"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-0/c-2/26
msgctxt "Vaughn Trapp"
msgid "Ain't no higher power in the crawlspace!"
msgstr "Y a pas de puissance supérieure dans le vide sanitaire !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-0/c-2/34
msgctxt "Vaughn Trapp"
msgid "Just darkness..."
msgstr "Rien que les ténèbres..."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-0/c-2/42
msgctxt "Vaughn Trapp"
msgid "And... Bodhi, I guess."
msgstr "Et... Bodhi, j'imagine."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-0/c-2/50
msgctxt "Vaughn Trapp"
msgid "But mostly... <w>darkness</w>."
msgstr "Mais surtout... les <w>ténèbres</w>."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-0/c-3/7
msgctxt "Vaughn Trapp"
msgid "<i>I'M LOUDER BECAUSE I'M HAPPY AND GLEEFUL!</i>"
msgstr "<i>JE SUIS PLUS BRUYANT PARCE QUE JE SUIS HEUREUX ET JOYEUX !</i>"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-0/c-3/21
msgctxt "Vaughn Trapp"
msgid "Stupid human couldn't even see 'glee' if it bit 'em in the tail."
msgstr "Ce crétin d'humain verrait pas la joie même si elle lui mordait la queue."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/0/s/0
msgctxt "Choix"
msgid "Is the, uh, \"lack of light\" down here bothering you?."
msgstr "Euh, le « manque de lumière », ça te gêne, ici ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/1/s/0
msgctxt "Choix"
msgid "You seem a little stressed, Vaughn."
msgstr "Tu as l'air un peu stressé, Vaughn."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/2/s/0
msgctxt "Choix"
msgid "I think, maybe, you've been in this crawlspace for too long."
msgstr "Je crois que, peut-être, ça fait trop longtemps que t'es dans ce vide sanitaire."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/3/s/0
msgctxt "Choix"
msgid "Sure. As long as you're keeping rats out of the house."
msgstr "Bien sûr. Tant que tu gardes les rats hors de la maison."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-4/7
msgctxt "Vaughn Trapp"
msgid "YOU SAYIN' I'M AFRAID OF THE DARK?"
msgstr "TU INSINUES QUE J'AI PEUR DU NOIR ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-4/18
msgctxt "Vaughn Trapp"
msgid "You don't know darkness like I do, buddy, okay?"
msgstr "Tu connais pas les ténèbres comme moi, {{mon pote|ma pote|mon pote}}, d'accord ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-4/26
msgctxt "Vaughn Trapp"
msgid "You ain't seen the things that come outta the infinite void after you stare into it too long!"
msgstr "T'as pas vu les trucs qui sortent du vide infini quand on le fixe trop longtemps !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-4/34
msgctxt "Vaughn Trapp"
msgid "Now, you're gonna leave me alone so I can do my job?"
msgstr "Maint'nant, tu vas me laisser tranquille pour que je fasse mon boulot ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-4/42
msgctxt "Vaughn Trapp"
msgid "Muuhah. Muuuhahaha.  MuuuuuuHAHAHAHAHAAHH!!!!!"
msgstr "Muuhah. Muuuhahaha.  MuuuuuuHAHAHAHAHAAHH !!!!!"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-4/50
msgctxt "Vaughn Trapp"
msgid "Goddamn it's dusty..."
msgstr "Bordel, qu'est-ce que c'est poussiéreux..."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-5/7
msgctxt "Vaughn Trapp"
msgid "Stressed? I AIN'T STRESSED!!!"
msgstr "Stressé ? J'SUIS PAS STRESSÉ !!!"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-5/15
msgctxt "Vaughn Trapp"
msgid "<i>...okay maybe maybe i'm a little stressed...</i>"
msgstr "<i>...bon d'accord peut-être que je suis un peu stressé...</i>"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-5/23
msgctxt "Vaughn Trapp"
msgid "But you'd be too if you had ONE JOB and no way of doing it?!"
msgstr "Mais toi aussi tu le serais si t'avais UN SEUL BOULOT et aucun moyen de le faire !?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-5/31/0/s/0
msgctxt "Choix"
msgid "I lost my job to an AI chat-bot. I'm stressed."
msgstr "J'ai perdu mon boulot à cause d'un chatbot IA. Je suis stressé."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-5/31/1/s/0
msgctxt "Choix"
msgid "I guess you're right."
msgstr "Je crois que tu as raison."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-5/31/c-0/11
msgctxt "Vaughn Trapp"
msgid "Hah! Sure, cuz we live in the 30th century, Puck Rogers."
msgstr "Hah ! Ouais, c'est ça, on est au 30e siècle, Flash Gordon."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-5/31/c-0/19
msgctxt "Vaughn Trapp"
msgid "Wait'll those bots try to take MY job!"
msgstr "Attends qu'ils essaient de prendre MON boulot, ces robots !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-5/31/c-0/27
msgctxt "Vaughn Trapp"
msgid "I'll snap 'em in half!"
msgstr "Je les casse en deux !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-5/31/c-0/35
msgctxt "Vaughn Trapp"
msgid "I got your AI right here."
msgstr "J'ai ton IA ici même."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-5/31/c-0/43
msgctxt "Vaughn Trapp"
msgid "SNAP SNAP SNAP"
msgstr "CLAC CLAC CLAC"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-5/31/c-0/51
msgctxt "Vaughn Trapp"
msgid "I say 'here ya come, here ya come ya little AI, c'mere ya little' SNAP! That's how I get 'em!"
msgstr "Je dis « viens ici, viens ici, p'tite IA, viens voir » CLAC ! C'est comme ça que je les chope !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-5/31/c-1/7
msgctxt "Vaughn Trapp"
msgid "But dat was then. Dis is now! Because YOU, you beautiful thing you, you brought me DIS GLORIOUS CHEESE!!!"
msgstr "Mais ça, c'était avant. Là, c'est maint'nant ! Parce que TOI, toi, espèce de merveille, tu m'as apporté CE GLORIEUX FROMAGE !!!"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-5/31/c-1/15
msgctxt "Vaughn Trapp"
msgid "Now, leave me alone so I can do my job."
msgstr "Maint'nant, laisse-moi tranquille pour que je fasse mon boulot."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-6/7
msgctxt "Vaughn Trapp"
msgid "What do you want?"
msgstr "Tu veux quoi ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-6/15
msgctxt "Vaughn Trapp"
msgid "You want me to go out there? IN THE HOUSE!??!"
msgstr "Tu veux que j'aille là-bas ? DANS LA MAISON !??!"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-6/23
msgctxt "Vaughn Trapp"
msgid "Not happenin'."
msgstr "Pas question."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-6/31/0/s/0
msgctxt "Choix"
msgid "What if I introduced you to everyone?"
msgstr "Et si je te présentais à tout le monde ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-6/31/1/s/0
msgctxt "Choix"
msgid "Okay, fine. See you around."
msgstr "Bon, d'accord. À plus."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-6/31/c-0/7
msgctxt "Vaughn Trapp"
msgid "Those goofy punks?"
msgstr "Ces bouffons ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-6/31/c-0/15
msgctxt "Vaughn Trapp"
msgid "Wit their meticulously crafted costumes?"
msgstr "Avec leurs costumes minutieusement conçus ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-6/31/c-0/23
msgctxt "Vaughn Trapp"
msgid "Nah, nah, nah... I ain't like them."
msgstr "Non, non, non... J'suis pas comme eux."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-6/31/c-0/31/0/s/0
msgctxt "Choix"
msgid "But you're beautiful!"
msgstr "Mais tu es beau !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-6/31/c-0/31/1/s/0
msgctxt "Choix"
msgid "Yeah, I guess you're right."
msgstr "Ouais, je crois que tu as raison."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-6/31/c-0/31/c-0/13
msgctxt "Vaughn Trapp"
msgid "Eh..."
msgstr "Euh..."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-6/31/c-0/31/c-1/7
msgctxt "Vaughn Trapp"
msgid "Uh huh."
msgstr "Mouais."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-6/31/c-0/31/g-0/0
msgctxt "Vaughn Trapp"
msgid "Now, get outta here! I got rats to snap!"
msgstr "Maint'nant, dégage ! J'ai des rats à claquer !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-6/31/c-0/31/g-0/8 vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-6/31/c-1/7
msgctxt "Vaughn Trapp"
msgid "And, uh..."
msgstr "Et, euh..."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-6/31/c-0/31/g-0/16
msgctxt "Vaughn Trapp"
msgid "Thanks for the offer... and the cheese!"
msgstr "Merci pour la proposition... et pour le fromage !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-6/31/c-0/31/g-0/27
msgctxt "Vaughn Trapp"
msgid "Yeah, the uh, the <i>cheese</i>. That's the most important thing... Absolutely."
msgstr "Ouais, le, euh, le <i>fromage</i>. C'est le plus important... Absolument."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-6/31/c-1/15
msgctxt "Vaughn Trapp"
msgid "Thanks for askin' about me... and the cheese!"
msgstr "Merci de t'intéresser à moi... et au fromage !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-6/31/c-1/26
msgctxt "Vaughn Trapp"
msgid "Yeah, the cheese is the most important thing. Totally."
msgstr "Ouais, le fromage, c'est le plus important. Totalement."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-6/31/c-1/34
msgctxt "Vaughn Trapp"
msgid "Now, get outta here! I got rats to snap! You little scoundrel, you."
msgstr "Maint'nant, dégage ! J'ai des rats à claquer ! Espèce de p'tite fripouille, va."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-7/7
msgctxt "Vaughn Trapp"
msgid "Look at me."
msgstr "Regarde-moi."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-7/15
msgctxt "Vaughn Trapp"
msgid "Look me in my frickin' eyes."
msgstr "Regarde-moi dans les yeux, putain."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-7/23
msgctxt "Vaughn Trapp"
msgid "You think for a second I'm gonna let one'a those adorable lil' bastards go un-snapped?"
msgstr "Tu crois une seconde que j'vais laisser filer un seul de ces adorables p'tits salauds sans le claquer ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-7/34/0/s/0
msgctxt "Choix"
msgid "Adorable?"
msgstr "Adorables ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-7/34/1/s/0
msgctxt "Choix"
msgid "Wait a minute... Do you <i>like</i> rats?"
msgstr "Attends une minute... Tu <i>aimes</i> les rats ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-7/34/2/s/0
msgctxt "Choix"
msgid "Wouldn't doubt you for a second."
msgstr "Je n'en douterais pas une seconde."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-7/34/c-0/7
msgctxt "Vaughn Trapp"
msgid "I meant. uh..."
msgstr "Je voulais dire, euh..."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-7/34/c-0/15
msgctxt "Vaughn Trapp"
msgid "Horrible."
msgstr "Horribles."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-7/34/c-0/23
msgctxt "Vaughn Trapp"
msgid "Now get outta here! Just... Shoo!"
msgstr "Maint'nant dégage ! Allez... ouste !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-7/34/c-1/7
msgctxt "Vaughn Trapp"
msgid "I like snappin' 'em up! Yes I do."
msgstr "J'aime les claquer ! Ouais, j'aime ça."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-7/34/c-1/15
msgctxt "Vaughn Trapp"
msgid "Dats what I like!"
msgstr "C'est ça que j'aime !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-7/34/c-1/23
msgctxt "Vaughn Trapp"
msgid "Now get outta here! Shoo!"
msgstr "Maint'nant dégage ! Ouste !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-7/34/c-2/7
msgctxt "Vaughn Trapp"
msgid "Never doubt me."
msgstr "Doute jamais de moi."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-7/34/c-2/15
msgctxt "Vaughn Trapp"
msgid "Always believe in me."
msgstr "Crois toujours en moi."

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_first_encounter/0/g-1/c-7/34/c-2/23
msgctxt "Vaughn Trapp"
msgid "Now get OUTTA here!"
msgstr "Maint'nant DÉGAGE !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_second_encounter/0/6
msgctxt "Vaughn Trapp"
msgid "... ahem... !"
msgstr "... hum... !"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_second_encounter/0/14/s/0
msgctxt "Choix"
msgid "Hey, are you okay?"
msgstr "Hé, ça va ?"

# Traduction IA – à relire
#: vaughn_mousetrap/vaughn_second_encounter/0/15/s/0
msgctxt "Choix"
msgid "... What?"
msgstr "... Quoi ?"

#: vaughn_mousetrap/vaughn_second_encounter/0/g-0/0
msgctxt "Vaughn Trapp"
msgid "I gotta tell ya..."
msgstr ""

#: vaughn_mousetrap/vaughn_second_encounter/0/g-0/8
msgctxt "Vaughn Trapp"
msgid "I been sittin' here this whole time wit this frickin' cheese in my craw..."
msgstr ""

#: vaughn_mousetrap/vaughn_second_encounter/0/g-0/16
msgctxt "Vaughn Trapp"
msgid "And I ain't seen no rats, pal!"
msgstr ""

#: vaughn_mousetrap/vaughn_second_encounter/0/g-0/24/s/0
msgctxt "Choix"
msgid "Sounds like the house is secure. Great!"
msgstr ""

#: vaughn_mousetrap/vaughn_second_encounter/0/g-0/25/s/0
msgctxt "Choix"
msgid "No rats is a great thing in my book."
msgstr ""

#: vaughn_mousetrap/vaughn_second_encounter/0/g-1/0/b/1
msgctxt "Vaughn Trapp"
msgid "Dats good, he says... \"great\"!"
msgstr ""

#: vaughn_mousetrap/vaughn_second_encounter/0/g-1/1/b/1
msgctxt "Vaughn Trapp"
msgid "Dats good, she says... \"great\"!"
msgstr ""

#: vaughn_mousetrap/vaughn_second_encounter/0/g-1/2/b/1
msgctxt "Vaughn Trapp"
msgid "Dats good, they say... \"great\"!"
msgstr ""

#: vaughn_mousetrap/vaughn_second_encounter/0/g-1/5
msgctxt "Vaughn Trapp"
msgid "Dats great..."
msgstr ""

#: vaughn_mousetrap/vaughn_second_encounter/0/g-1/13/b/1
msgctxt "Vaughn Trapp"
msgid "He."
msgstr ""

#: vaughn_mousetrap/vaughn_second_encounter/0/g-1/14/b/1
msgctxt "Vaughn Trapp"
msgid "She."
msgstr ""

#: vaughn_mousetrap/vaughn_second_encounter/0/g-1/15/b/1
msgctxt "Vaughn Trapp"
msgid "They."
msgstr ""

#: vaughn_mousetrap/vaughn_second_encounter/0/g-1/18/b/1
msgctxt "Vaughn Trapp"
msgid "Says."
msgstr ""

#: vaughn_mousetrap/vaughn_second_encounter/0/g-1/19/b/1
msgctxt "Vaughn Trapp"
msgid "Say."
msgstr ""

#: vaughn_mousetrap/vaughn_second_encounter/0/g-1/22
msgctxt "Vaughn Trapp"
msgid "DO YOU EVEN HEAR YOURSELF RIGHT NOW!?"
msgstr ""

#: vaughn_mousetrap/vaughn_second_encounter/0/g-1/36/s/0
msgctxt "Choix"
msgid "I know you wanted to snap a rat, but if there aren't any, then..."
msgstr ""

#: vaughn_mousetrap/vaughn_second_encounter/0/g-1/37/s/0
msgctxt "Choix"
msgid "I mean... Job well done?"
msgstr ""

#: vaughn_mousetrap/vaughn_second_encounter/0/g-2/0
msgctxt "Vaughn Trapp"
msgid "You son of a..."
msgstr ""

#: vaughn_mousetrap/vaughn_second_encounter/0/g-2/11 vaughn_mousetrap/vaughn_love_return_uptop/0/c-1/23/c-0/8/b/1
msgctxt "Vaughn Trapp"
msgid "<i>unintelligible</i>"
msgstr ""

#: vaughn_mousetrap/vaughn_second_encounter/0/g-2/19
msgctxt "Vaughn Trapp"
msgid "You must be new here, so I'm gonna cut you a break. You're lucky."
msgstr ""

#: vaughn_mousetrap/vaughn_second_encounter/0/g-2/27
msgctxt "Vaughn Trapp"
msgid "You gotta understand..."
msgstr ""

#: vaughn_mousetrap/vaughn_second_encounter/0/g-2/32
msgctxt "Vaughn Trapp"
msgid "Snappin' rats is what I <i>do</i>!!"
msgstr ""

#: vaughn_mousetrap/vaughn_second_encounter/0/g-2/40
msgctxt "Vaughn Trapp"
msgid "And if I ain't got no rats, den... den <i>WHAT AM I</i>?"
msgstr ""

#: vaughn_mousetrap/vaughn_second_encounter/0/g-2/48
msgctxt "Vaughn Trapp"
msgid "Some kinda fool just layin' in a crawlspace for my own amusements!?"
msgstr ""

#: vaughn_mousetrap/vaughn_second_encounter/0/g-2/56
msgctxt "Vaughn Trapp"
msgid "Do I look like a fool to you, huh? HUH?! Answer quick!"
msgstr ""

#: vaughn_mousetrap/vaughn_second_encounter/0/g-2/64/s/0
msgctxt "Choix"
msgid "No. Actually, I think you're kinda cute."
msgstr ""

#: vaughn_mousetrap/vaughn_second_encounter/0/g-2/65/s/0
msgctxt "Choix"
msgid "No, you don't look like a fool."
msgstr ""

#: vaughn_mousetrap/vaughn_second_encounter/0/g-2/66/s/0
msgctxt "Choix"
msgid "Come on. That can't be a real question..."
msgstr ""

#: vaughn_mousetrap/vaughn_like_a_fool/0/0/b/1
msgctxt "Narrator"
msgid "Vaughn is completely taken aback by your compliment. He fidgets with his tail, his pale cheeks reddening as he struggles to make sense of this."
msgstr ""

#: vaughn_mousetrap/vaughn_like_a_fool/0/0/b/9
msgctxt "Vaughn Trapp"
msgid "Woah... Well, uh... I mean, heh..."
msgstr ""

#: vaughn_mousetrap/vaughn_like_a_fool/0/0/b/17
msgctxt "Vaughn Trapp"
msgid "I, uh... Ah, geez."
msgstr ""

#: vaughn_mousetrap/vaughn_like_a_fool/0/0/b/28
msgctxt "Vaughn Trapp"
msgid "Dats..."
msgstr ""

#: vaughn_mousetrap/vaughn_like_a_fool/0/0/b/36
msgctxt "Vaughn Trapp"
msgid "Dats not important!"
msgstr ""

#: vaughn_mousetrap/vaughn_like_a_fool/0/1/b/1
msgctxt "Vaughn Trapp"
msgid "It doesn't matter!"
msgstr ""

#: vaughn_mousetrap/vaughn_like_a_fool/0/4
msgctxt "Vaughn Trapp"
msgid "If there's no rats, then what is there?"
msgstr ""

#: vaughn_mousetrap/vaughn_like_a_fool/0/12/s/0
msgctxt "Choix"
msgid "Are you going to say darkness?"
msgstr ""

#: vaughn_mousetrap/vaughn_like_a_fool/0/13/s/0
msgctxt "Choix"
msgid "Bodhi?"
msgstr ""

#: vaughn_mousetrap/vaughn_like_a_fool/0/14/s/0
msgctxt "Choix"
msgid "Cheese?"
msgstr ""

#: vaughn_mousetrap/vaughn_like_a_fool/0/c-0/7
msgctxt "Vaughn Trapp"
msgid "Darkness!!"
msgstr ""

#: vaughn_mousetrap/vaughn_like_a_fool/0/c-0/15
msgctxt "Vaughn Trapp"
msgid "Dats right."
msgstr ""

#: vaughn_mousetrap/vaughn_like_a_fool/0/c-0/23
msgctxt "Vaughn Trapp"
msgid "Hey. You got ears. I'll give you that."
msgstr ""

#: vaughn_mousetrap/vaughn_like_a_fool/0/c-1/7
msgctxt "Vaughn Trapp"
msgid "Nah, he may be a lovable idiot but he's still mostly an idiot."
msgstr ""

#: vaughn_mousetrap/vaughn_like_a_fool/0/c-1/15
msgctxt "Vaughn Trapp"
msgid "The truth is... I don't know anymore."
msgstr ""

#: vaughn_mousetrap/vaughn_like_a_fool/0/c-2/7
msgctxt "Vaughn Trapp"
msgid "The <i>cheese's</i> purpose is for the RATS!"
msgstr ""

#: vaughn_mousetrap/vaughn_like_a_fool/0/c-2/15
msgctxt "Vaughn Trapp"
msgid "<i>WITHOUT RATS THE CHEESE AINT GOT NO PURPOSE</i>"
msgstr ""

#: vaughn_mousetrap/vaughn_like_a_fool/0/g-0/0/s/0
msgctxt "Choix"
msgid "How can I help?"
msgstr ""

#: vaughn_mousetrap/vaughn_like_a_fool/0/g-0/c-3/7
msgctxt "Vaughn Trapp"
msgid "I dunno! Unless you're like the Pied Piper, we're hosed!"
msgstr ""

#: vaughn_mousetrap/vaughn_like_a_fool/0/g-0/c-3/15
msgctxt "Vaughn Trapp"
msgid "Ya can't get rats delivered like a friggin' <i>pizza</i>."
msgstr ""

#: vaughn_mousetrap/vaughn_like_a_fool/0/g-0/c-3/23/0/s/0
msgctxt "Choix"
msgid "What if I could do that? I can order things on the computer..."
msgstr ""

#: vaughn_mousetrap/vaughn_like_a_fool/0/g-0/c-3/23/1/s/0
msgctxt "Choix"
msgid "Me and Mac, we could fix this!"
msgstr ""

#: vaughn_mousetrap/vaughn_like_a_fool/0/g-1/0/b/1
msgctxt "Vaughn Trapp"
msgid "... alright dis sci-fi shit is makin' my wood warp."
msgstr ""

#: vaughn_mousetrap/vaughn_like_a_fool/0/g-1/3
msgctxt "Vaughn Trapp"
msgid "Look. I know I weren't no angel when you brought me that cheese."
msgstr ""

#: vaughn_mousetrap/vaughn_like_a_fool/0/g-1/11
msgctxt "Vaughn Trapp"
msgid "But I do 'preciate you helpin' me out."
msgstr ""

#: vaughn_mousetrap/vaughn_like_a_fool/0/g-1/22
msgctxt "Vaughn Trapp"
msgid "I think I just wanna... kinda be alone right now, okay?"
msgstr ""

#: vaughn_mousetrap/vaughn_like_a_fool/0/g-1/30
msgctxt "Vaughn Trapp"
msgid "We're probably scarin' the rats off wit all this jib-jabbin'."
msgstr ""

#: vaughn_mousetrap/vaughn_like_a_fool/0/g-1/38/s/0
msgctxt "Choix"
msgid "Yeah, sure, Vaughn... All the rats. See ya later, buddy."
msgstr ""

#: vaughn_mousetrap/vaughn_like_a_fool/0/g-1/39/s/0
msgctxt "Choix"
msgid "Want me to leave the door cracked for you?"
msgstr ""

#: vaughn_mousetrap/vaughn_like_a_fool/0/g-1/c-5/7
msgctxt "Vaughn Trapp"
msgid "Nah. I'm used to the <i>all consuming cold of shadow.</i>"
msgstr ""

#: vaughn_mousetrap/vaughn_like_a_fool/0/g-1/c-5/15
msgctxt "Vaughn Trapp"
msgid "Now get the fuck outta here, ya schmo!"
msgstr ""

#: vaughn_mousetrap/vaughn_third_encounter/0/0
msgctxt "Vaughn Trapp"
msgid "Heya top dweller... Whatcha- you uh..."
msgstr ""

#: vaughn_mousetrap/vaughn_third_encounter/0/8
msgctxt "Vaughn Trapp"
msgid "W-whatcha got there, hotshot?"
msgstr ""

#: vaughn_mousetrap/vaughn_third_encounter/0/19/s/0
msgctxt "Choix"
msgid "Me? Are you referring... to this rat?"
msgstr ""

#: vaughn_mousetrap/vaughn_third_encounter/0/c-0/7
msgctxt "Vaughn Trapp"
msgid "Don't you do this to me."
msgstr ""

#: vaughn_mousetrap/vaughn_third_encounter/0/c-0/15
msgctxt "Vaughn Trapp"
msgid "You know dat I know dat we BOTH know dat dats a rat."
msgstr ""

#: vaughn_mousetrap/vaughn_third_encounter/0/c-0/23/0/s/0
msgctxt "Choix"
msgid "Wassat? I can't really understand you if you're not yelling at me..."
msgstr ""

#: vaughn_mousetrap/vaughn_third_encounter/0/c-0/23/c-0/7
msgctxt "Vaughn Trapp"
msgid "<w>IZZAT A FRIGGIN' RAT?!?!?!</w>"
msgstr ""

#: vaughn_mousetrap/vaughn_third_encounter/0/g-0/0/s/0
msgctxt "Choix"
msgid "Well... it's certainly not a cat..."
msgstr ""

#: vaughn_mousetrap/vaughn_third_encounter/0/g-0/1/s/0
msgctxt "Choix"
msgid "Yuuuuup!"
msgstr ""

#: vaughn_mousetrap/vaughn_third_encounter/0/g-1/0
msgctxt "Vaughn Trapp"
msgid "Oooo, baby!! Come to Papa..."
msgstr ""

#: vaughn_mousetrap/vaughn_third_encounter/0/g-1/11
msgctxt "Vaughn Trapp"
msgid "Yeah let it go. LET IT GO!!!"
msgstr ""

#: vaughn_mousetrap/vaughn_third_encounter/0/g-1/19
msgctxt "Vaughn Trapp"
msgid "I got dis stinky-ass cheese and everything!"
msgstr ""

#: vaughn_mousetrap/vaughn_third_encounter/0/g-1/24/s/0
msgctxt "Choix"
msgid "Haha, okay Vaughn. Here you go!"
msgstr ""

#: vaughn_mousetrap/vaughn_third_encounter/0/g-1/25/s/0
msgctxt "Choix"
msgid "Get revenge for one third of 14th century, western Eurasia!!!"
msgstr ""

#: vaughn_mousetrap/vaughn_third_encounter/0/g-1/c-4/7
msgctxt "Vaughn Trapp"
msgid "AAAUGH REVENGE!"
msgstr ""

#: vaughn_mousetrap/vaughn_third_encounter/0/g-2/4/s/0
msgctxt "Choix"
msgid "Actually, on second though. I don't really think you should have this."
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/0
msgctxt "Narrator"
msgid "You look away from the grisly scene you've set up, unable to watch—but the telltale snap leaves little doubt as to what's happened."
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/11
msgctxt "Vaughn Trapp"
msgid "Yes! Yes, I did it!"
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/28
msgctxt "Vaughn Trapp"
msgid "Bahahaha! I snapped a rat!"
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/36
msgctxt "Vaughn Trapp"
msgid "I'm a real Trapp now!"
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/44
msgctxt "Vaughn Trapp"
msgid "Ya hear that Ma? Who's laughin' now?"
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/52
msgctxt "Vaughn Trapp"
msgid "How you like that?!"
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/57/s/0
msgctxt "Choix"
msgid "You did it!"
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/58/s/0
msgctxt "Choix"
msgid "So... how does it feel?"
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-0/0
msgctxt "Narrator"
msgid "Vaughn falls silent, looking at his prize with a nervous sort of disgust."
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-0/27
msgctxt "Vaughn Trapp"
msgid "What do I, uuhhh..."
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-0/35
msgctxt "Vaughn Trapp"
msgid "Do wit it now."
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-0/43/s/0
msgctxt "Choix"
msgid "I'll toss it out. It's chill."
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-0/44/s/0
msgctxt "Choix"
msgid "I dunno. Do you... <i>eat</i> it ooorrr..."
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-0/c-2/15
msgctxt "Vaughn Trapp"
msgid "I think?"
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-0/c-3/7
msgctxt "Vaughn Trapp"
msgid "What?!?! Cheesus, no."
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-0/c-3/15
msgctxt "Vaughn Trapp"
msgid "Blech. What's a matter with you? Disgusting."
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-1/0
msgctxt "Vaughn Trapp"
msgid "Huh..."
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-1/8
msgctxt "Vaughn Trapp"
msgid "Feels kinda..."
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-1/16
msgctxt "Vaughn Trapp"
msgid "Shouldn't I feel...?"
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-1/21/s/0
msgctxt "Choix"
msgid "Awesome!?"
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-1/22/s/0
msgctxt "Choix"
msgid "Different!?"
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-1/23/s/0
msgctxt "Choix"
msgid "Terrible!?"
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-1/c-4/7
msgctxt "Vaughn Trapp"
msgid "Yeah!"
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-1/c-4/15
msgctxt "Vaughn Trapp"
msgid "Like, frickin' <i>powerful</i> or somethin'?"
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-1/c-4/23
msgctxt "Vaughn Trapp"
msgid "All I feel's, y'know... bloodier."
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-1/c-5/7
msgctxt "Vaughn Trapp"
msgid "Right?! Changed. Transformed, even!"
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-1/c-5/15
msgctxt "Vaughn Trapp"
msgid "I fulfilled my purpose... but..."
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-1/c-5/20
msgctxt "Vaughn Trapp"
msgid "But I'm still just... just me."
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-1/c-6/7
msgctxt "Narrator"
msgid "Vaughn claps his hands to his head in horror."
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-1/c-6/15
msgctxt "Vaughn Trapp"
msgid "Holy friggin' shit..."
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-1/c-6/23
msgctxt "Vaughn Trapp"
msgid "What have I done?"
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-1/c-6/31
msgctxt "Vaughn Trapp"
msgid "I'm a killer!! <i>sobs</i>"
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-1/c-6/39
msgctxt "Vaughn Trapp"
msgid "And you WITNESSED it. <i>unintelligible</i> ... Don't tell Bodhi!"
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-2/0/s/0
msgctxt "Choix"
msgid "Are you okay?"
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-2/1/s/0
msgctxt "Choix"
msgid "Did I do the right thing bringing you the real rat?"
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-2/2/s/0
msgctxt "Choix"
msgid "I did a bad."
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-3/0
msgctxt "Vaughn Trapp"
msgid "Yeah... Yeah, y'know I guess."
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-3/8
msgctxt "Vaughn Trapp"
msgid "Ya know, you spend countless lifetimes in a frickin' hole, hopin' for somethin' and then you finally get it and..."
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-3/13
msgctxt "Vaughn Trapp"
msgid "... all you got's a bloody stain on your snapper and a weird feelin' in your heart."
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-3/21/s/0
msgctxt "Choix"
msgid "Countless lifetimes?"
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-3/22/s/0
msgctxt "Choix"
msgid "Let's get you cleaned up."
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-3/c-10/7
msgctxt "Vaughn Trapp"
msgid "Yeah, I'm sure some of the eggheads at D.I.R.T could count 'em."
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-3/c-10/15
msgctxt "Vaughn Trapp"
msgid "IT'S A THOUGHTFUL METAPHOR, ALRIGHT?!?!?"
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-3/c-11/7
msgctxt "Vaughn Trapp"
msgid "That old trick, huh? I've been down here for years, I can oil my own springs thank you very much."
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-3/c-11/15
msgctxt "Vaughn Trapp"
msgid "LET ME SIT WIT WHAT I'VE DONE!!"
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-3/c-11/23
msgctxt "Vaughn Trapp"
msgid "You can't wash off shame."
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-4/9/s/0
msgctxt "Choix"
msgid "So are you gonna fall in love with me or what?"
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-4/10/s/0
msgctxt "Choix"
msgid "Sorry Vaughn..."
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-5/0 vaughn_mousetrap/vaughn_hold_out/0/0
msgctxt "Vaughn Trapp"
msgid "What?"
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-5/8
msgctxt "Vaughn Trapp"
msgid "WHAT DO YOU WANT FROM ME!?"
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-5/19
msgctxt "Vaughn Trapp"
msgid "Look, I don't know a lotta humans, but regardless of how I feel about all this... you came through for me."
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-5/27
msgctxt "Vaughn Trapp"
msgid "And don't let nobody tell you Vaughn Trapp's some unappreciative goon."
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-5/32
msgctxt "Narrator"
msgid "He places a hand on your shoulder."
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-5/40
msgctxt "Vaughn Trapp"
msgid "You and me... we're pals."
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-5/48/s/0
msgctxt "Choix"
msgid "I hope I helped."
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-5/49/s/0
msgctxt "Choix"
msgid "I'm glad to be."
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-5/50/s/0
msgctxt "Choix"
msgid "But I wanted you to fall in love with me!"
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-5/c-15/7
msgctxt "Vaughn Trapp"
msgid "You did."
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-5/c-16/7
msgctxt "Vaughn Trapp"
msgid "Me too."
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-5/c-17/10
msgctxt "Vaughn Trapp"
msgid "Ha! In your dreams!"
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-6/0
msgctxt "Vaughn Trapp"
msgid "Guess I was hopin' for some kinda big come-to-Cheesus moment back there, but that ain't on you!"
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-6/8
msgctxt "Vaughn Trapp"
msgid "You're a good friend."
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-6/16/s/0
msgctxt "Choix"
msgid "Do you want to get out of the crawlspace and meet the others in the house?"
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-6/17/s/0
msgctxt "Choix"
msgid "Does that mean I can still come visit you sometimes?"
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-6/c-18/7
msgctxt "Vaughn Trapp"
msgid "Haha, those fashionable weirdos?! Not a chance!"
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-6/c-18/15 vaughn_mousetrap/vaughn_live_rats/0/g-6/c-19/29
msgctxt "Vaughn Trapp"
msgid "Rats or not, somebody's gotta keep an eye out down here, huh?"
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-6/c-18/23/0/s/0 vaughn_mousetrap/vaughn_live_rats/0/g-6/c-19/34/0/s/0
msgctxt "Choix"
msgid "Alright, well... I'll visit again soon."
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-6/c-18/23/c-0/7
msgctxt "Vaughn Trapp"
msgid "See ya 'round, pally!"
msgstr ""

#: vaughn_mousetrap/vaughn_live_rats/0/g-6/c-19/7
msgctxt "Vaughn Trapp"
msgid "Only if you bring that SWEET, SWEET CHEESE, BABY!!"
msgstr ""

