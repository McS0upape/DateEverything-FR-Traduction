#: beverly_beverage/beverly_hate_return/0/0
msgctxt "Narrator"
msgid "Beverly is hanging a sign across the bar when you walk up on her. She gives you the briefest of glances over her shoulder."
msgstr ""

#: beverly_beverage/beverly_hate_return/0/8
msgctxt "Beverly"
msgid "You see that sign?"
msgstr ""

#: beverly_beverage/beverly_hate_return/0/16
msgctxt "Beverly"
msgid "It says - \"Closing Down. Thank you for your business.\""
msgstr ""

#: beverly_beverage/beverly_hate_return/0/24/s/0
msgctxt "Choix"
msgid "Good."
msgstr ""

#: beverly_beverage/beverly_hate_return/0/25/s/0
msgctxt "Choix"
msgid "Look, I’m sorry."
msgstr ""

#: beverly_beverage/beverly_hate_return/0/26/s/0
msgctxt "Choix"
msgid "I learned how to make something just for you. (USE CHARM CANDY)"
