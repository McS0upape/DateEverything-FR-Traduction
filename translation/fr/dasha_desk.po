#: dasha_desk/crit_dasha_love_end/0/c-0/15/c-2/15
msgctxt "Dasha"
msgid "Please forgive me. Our conversations have given me much to think about."
msgstr ""

#: dasha_desk/crit_dasha_friend_end/0/6
msgctxt "Dasha"
msgid "You are in excellent shape to sail the seas of romance."
msgstr ""

#: dasha_desk/crit_dasha_friend_end/0/14
msgctxt "Dasha"
msgid "I know you will do well..."
msgstr ""

#: dasha_desk/crit_dasha_friend_end/0/22/s/0
msgctxt "Choix"
msgid "Are you alright?"
