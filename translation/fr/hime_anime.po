#: hime_anime/Hero_4/0/g-6/c-16/39/c-0/7
msgctxt "Hero-Hime"
msgid "Hmph."
msgstr ""

#: hime_anime/Hero_4/0/g-6/c-16/39/c-0/15
msgctxt "Hero-Hime"
msgid "I can't stop you. But it would be really bad of you to do that."
