msgid "I think she liked it..."
msgstr "Je crois qu'elle a aimé..."

# Traduction IA – à relire
#: DateADex/betty_dex_entry/97
msgctxt "Tag Date-A-Dex"
msgid "Feed Betty something from the heart."
msgstr "Donne à manger à Betty quelque chose qui vient du coeur."

