#: lucinda_lavish/second_loving/0/g-0/c-6/7
msgctxt "Lucinda Lacking"
msgid "Yeah."
msgstr ""

#: lucinda_lavish/second_loving/0/g-1/3
msgctxt "Lucinda Lacking"
msgid "You can't even talk to me whenever you want. You have to wait until I randomly appear."
